10 REM ULX3S BOARD INPUT VISUALIZER
20 REM BUTTONS: $BA9C  SWITCHES: $BA9D
30 MODE 1:COLOR 15,0:GCLS:CLS
40 DIM BX(6),BM(6),SX(3),SM(3)
50 FOR I=0 TO 6:READ BX(I),BM(I):NEXT I
60 FOR I=0 TO 3:READ SX(I),SM(I):NEXT I
70 DATA 10,1,54,2,98,4,142,8,186,16,230,32,274,64
80 DATA 42,1,104,2,166,4,228,8
90 GOSUB 1000:T=0:LB=-1:LS=-1:HB=0:HT=0
100 RB=PEEK($BA9C):S=PEEK($BA9D):B=RB
101 IF RB<>0 THEN 104
102 IF HT=0 THEN 105
103 B=HB:HT=HT-1:GOTO 105
104 HB=RB:HT=18
105 IF B<>LB THEN 110
106 IF S<>LS THEN 110
107 GOTO 140
110 FOR I=0 TO 6:X=BX(I):M=BM(I):Y=54:GOSUB 2000:NEXT I
120 FOR I=0 TO 3:X=SX(I):M=SM(I):Y=128:GOSUB 2200:NEXT I
130 COLOR 15,0:LOCATE 1,23:PRINT "RAW=";RB;"  SHOW=";B;"  SWITCHES=";S;"        ";
135 LB=B:LS=S
140 K=0:GET K:T=T+1
145 IF T>60 AND (K=81 OR K=113) THEN 900
150 VSYNC:GOTO 100
900 MODE 0:COLOR 15,0:CLS:END
1000 COLOR 15,0:CLS
1010 LOCATE 24,1:PRINT "ULX3S BOARD INPUTS"
1020 COLOR 11,0:LOCATE 13,3:PRINT "LIVE READS FROM $BA9C AND $BA9D"
1030 COLOR 15,0:LOCATE 2,5:PRINT "PWR    FIRE1  FIRE2  UP     DOWN   LEFT   RIGHT"
1040 COLOR 15,0:LOCATE 7,14:PRINT "SW1       SW2       SW3       SW4"
1050 COLOR 11,0:LOCATE 2,25:PRINT "Q EXITS.  PWR IS ALSO RESET ON ULX3S."
1060 RETURN
2000 A=0
2005 IF (B AND M)=0 THEN 2020
2010 A=1
2020 C=11
2025 IF A=0 THEN 2040
2030 C=13
2040 GCOLOR C:FILL X,Y,X+34,Y+24
2050 GCOLOR 15:RECT X,Y,X+34,Y+24
2060 IF A=0 THEN 2080
2070 GCOLOR 1:FILL X+12,Y+8,X+22,Y+16
2080 COLOR C,0:LOCATE INT(X/4)+1,10
2090 IF A=0 THEN 2110
2100 PRINT "ON ";:RETURN
2110 PRINT "OFF";:RETURN
2200 A=0
2205 IF (S AND M)=0 THEN 2220
2210 A=1
2220 C=11
2225 IF A=0 THEN 2240
2230 C=14
2240 GCOLOR C:FILL X,Y,X+48,Y+32
2250 GCOLOR 15:RECT X,Y,X+48,Y+32
2260 IF A=0 THEN 2280
2270 GCOLOR 7:FILL X+16,Y+10,X+32,Y+22
2280 COLOR C,0:LOCATE INT(X/4)+1,21
2290 IF A=0 THEN 2310
2300 PRINT "ON ";:RETURN
2310 PRINT "OFF";:RETURN
