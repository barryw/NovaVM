10 REM EIGHT BALL SPRITE BOUNCE - NOVABASIC
20 REM 8 HARDWARE SPRITES, 1/16 PIXEL MOTION + MATH COPRO COLLISIONS
30 MODE 3:COLOR 1,6:GCLS
40 DIM X(7),Y(7),U(7),V(7),F(7),P(7)
50 Z=16:MX=304*Z:MY=184*Z:D=16*Z:G=1:C=0:M=0
60 FOR I=0 TO 7:READ P(I):NEXT I
65 DATA 1,2,4,8,16,32,64,128
70 GOSUB 1000
75 FOR I=0 TO 7
80 READ XP,YP,U(I),V(I),F(I)
90 X(I)=XP*Z:Y(I)=YP*Z
100 SPRITESHAPE I,I:SPRITESET I,6,2:SPRITESET I,7,6
110 SPRITE I,XP,YP:SPRITE I,ON
120 NEXT I
130 DATA 12,18,13,-10,40,52,34,18,-18,52
140 DATA 92,52,-24,-26,64,132,72,30,-34,76
150 DATA 174,96,-35,-42,48,218,118,41,-50,72
160 DATA 260,140,-46,-22,60,300,160,51,-46,68
165 ON SPRITE COLLISION GOSUB 800
170 VSYNC
175 SPRITE COLLISION OFF:M=C:C=0:SPRITE COLLISION ON
176 IF M<>0 THEN GOSUB 500
180 GET K:IF K=81 OR K=113 THEN 900
190 FOR I=0 TO 7
200 V(I)=V(I)+G
210 X(I)=X(I)+U(I):Y(I)=Y(I)+V(I)
220 IF X(I)<0 THEN X(I)=-X(I):IF U(I)<0 THEN U(I)=-U(I)
230 IF X(I)>MX THEN X(I)=MX-(X(I)-MX):IF U(I)>0 THEN U(I)=-U(I)
240 IF Y(I)<0 THEN Y(I)=-Y(I):IF V(I)<0 THEN V(I)=-V(I)
250 IF Y(I)>MY THEN Y(I)=MY-(Y(I)-MY):IF V(I)>-F(I) THEN V(I)=-F(I) ELSE V(I)=-V(I)
260 NEXT I
270 REM COLLISIONS ARE LATCHED BY SPRITE IRQ
280 FOR I=0 TO 7:SPRITE I,INT(X(I)/Z),INT(Y(I)/Z):NEXT I
290 GOTO 170
500 REM IRQ-LATCHED BALL COLLISIONS
510 FOR A=0 TO 6
520 IF (M AND P(A))=0 THEN 760
530 FOR B=A+1 TO 7
540 IF (M AND P(B))=0 THEN 740
550 SX=INT((X(B)-X(A))/Z)
560 IF SX<0 THEN DX=-SX ELSE DX=SX
570 IF DX>=16 THEN 740
580 SY=INT((Y(B)-Y(A))/Z)
590 IF SY<0 THEN DY=-SY ELSE DY=SY
600 IF DY>=16 THEN 740
610 IF MLEN2(DX,DY)>=256 THEN 740
620 DI=MDIST(DX,DY):IF DI=0 THEN DI=1
630 OV=MDIV((16-DI)*Z,2)+1
635 RX=U(B)-U(A):RY=V(B)-V(A):RV=MDOTFX(RX*64,RY*64,SX*4,SY*4)
640 IF RV>=0 THEN 740
645 IF DX>DY THEN 680
650 IF SY>=0 THEN 655
651 Y(A)=Y(A)+OV:Y(B)=Y(B)-OV:GOTO 660
655 Y(A)=Y(A)-OV:Y(B)=Y(B)+OV
660 T=V(A):V(A)=V(B):V(B)=T
670 GOTO 740
680 IF SX>=0 THEN 685
681 X(A)=X(A)+OV:X(B)=X(B)-OV:GOTO 690
685 X(A)=X(A)-OV:X(B)=X(B)+OV
690 T=U(A):U(A)=U(B):U(B)=T
740 NEXT B
760 NEXT A:RETURN
800 C=C OR SPRCOLL
810 RETIRQ
900 FOR I=0 TO 7:SPRITE I,OFF:NEXT I
910 MODE 0:COLOR 1,0:CLS:END
