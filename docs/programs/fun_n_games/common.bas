60210 IF ZP=1 THEN ZW$="PRESS SPACE" ELSE ZW$="PRESS ENTER"
60220 ZL=LEN(ZW$):ZX=INT((320-ZL*8)/2):GCOLOR 15:GTEXT ZX,152,0,1,ZW$
