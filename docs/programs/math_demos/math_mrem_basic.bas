10 REM MATH DEMO MREM - BASIC
20 POKE 41189,15:MODE 3:COLOR 1,0:CLS:GCLS
30 GCOLOR 15:GTEXT 4,4,0,1,"MREM - BASIC LANES"
40 GOSUB 1000:T=0
50 FOR I=0 TO 7:SPRITESHAPE I,0:SPRITESET I,6,2:SPRITESET I,7,0:SPRITE I,20+I*40,96:SPRITE I,ON:NEXT I
60 VSYNC
70 T=T+2:IF T>255 THEN T=T-256
80 FOR I=0 TO 7
85 N=T+I*17:X=20+I*40
90 Y=32+MREM(N,72)*2:SPRITE I,X,Y:NEXT I
100 GET K:IF K=81 OR K=113 THEN 900
110 GOTO 60
900 FOR I=0 TO 7:SPRITE I,OFF:NEXT I:MODE 0:COLOR 1,0:CLS:END
1000 FOR R=0 TO 15
1010 SPRITEDATA 0,R,$55,$55,$DD,$DD,$DD,$DD,$55,$55
1020 NEXT R:RETURN
