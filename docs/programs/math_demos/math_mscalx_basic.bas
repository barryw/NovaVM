10 REM MATH DEMO MSCALX - BASIC
20 POKE 41189,15:MODE 3:COLOR 1,0:CLS:GCLS
30 GCOLOR 15:GTEXT 4,4,0,1,"MSCALX - BASIC X"
40 GOSUB 1000:T=0
50 FOR I=0 TO 7:SPRITESHAPE I,0:SPRITESET I,6,2:SPRITESET I,7,0:SPRITE I,152,36+I*20:SPRITE I,ON:NEXT I
60 VSYNC
70 T=T+4:IF T>255 THEN T=T-256
80 FOR I=0 TO 7:A=T+I*32:IF A>255 THEN A=A-256
90 S=MSIN(A)*2:O=MSCALX($7C00,0,S)/256:X=152+O:Y=36+I*20:SPRITE I,X,Y
100 NEXT I
110 GET K:IF K=81 OR K=113 THEN 900
120 GOTO 60
900 FOR I=0 TO 7:SPRITE I,OFF:NEXT I:MODE 0:COLOR 1,0:CLS:END
1000 FOR R=0 TO 15
1010 SPRITEDATA 0,R,$55,$55,$DD,$DD,$DD,$DD,$55,$55
1020 NEXT R:RETURN
