10 REM MATH DEMO MRND - BASIC
20 POKE 41189,15:MODE 3:COLOR 1,0:CLS:GCLS
30 GCOLOR 15:GTEXT 4,4,0,1,"MRND - BASIC RANDOM"
40 GOSUB 1000
50 FOR I=0 TO 7:SPRITESHAPE I,0:SPRITESET I,6,2:SPRITESET I,7,0:SPRITE I,32+I*36,96:SPRITE I,ON:NEXT I
60 VSYNC
70 FOR I=0 TO 7
80 R=MRND:IF R<0 THEN R=R+256
90 X=8+R+R/8
100 R=MRND:IF R<0 THEN R=R+256
110 Y=20+R/2+R/8
120 SPRITE I,X,Y:NEXT I
130 GET K:IF K=81 OR K=113 THEN 900
140 GOTO 60
900 FOR I=0 TO 7:SPRITE I,OFF:NEXT I:MODE 0:COLOR 1,0:CLS:END
1000 FOR R=0 TO 15
1010 SPRITEDATA 0,R,$55,$55,$DD,$DD,$DD,$DD,$55,$55
1020 NEXT R:RETURN
