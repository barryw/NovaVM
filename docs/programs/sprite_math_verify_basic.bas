10 REM MATH COPRO SPRITE VERIFY - BASIC
20 MODE 3:COLOR 1,0:GCLS
30 DIM P(10),X(10),D(10)
40 GOSUB 1000
50 FOR I=0 TO 10:X(I)=10+I*28:D(I)=1:SPRITESHAPE I,1:SPRITESET I,6,2:SPRITESET I,7,0:SPRITE I,X(I),136:SPRITE I,ON:NEXT I
60 GOSUB 500
70 FOR I=0 TO 10
72 IF P(I)=0 THEN 76
74 SPRITESHAPE I,0:SPRITE I,X(I),60:GOTO 80
76 SPRITESHAPE I,1:SPRITE I,X(I),136
80 NEXT I
90 VSYNC
100 FOR I=0 TO 10
110 X(I)=X(I)+D(I)
120 IF X(I)>304 THEN X(I)=304:D(I)=-1
130 IF X(I)<0 THEN X(I)=0:D(I)=1
140 IF P(I)=0 THEN 145
142 SPRITE I,X(I),60:GOTO 150
145 SPRITE I,X(I),136
150 NEXT I
160 GET K:IF K=81 OR K=113 THEN 180
170 GOTO 90
180 FOR I=0 TO 10:SPRITE I,OFF:NEXT I
190 MODE 0:COLOR 1,0:CLS:END
500 REM SINCOS
510 P(0)=0:IF MSIN(64)<>127 THEN 540
520 IF MCOS(0)<>127 THEN 540
530 IF MSIN(192)=-128 THEN P(0)=1
540 REM MMULFX
550 P(1)=0:IF MMULFX($0180,$0180)<>576 THEN 580
560 IF MMULFX(-256,512)=-512 THEN P(1)=1
580 REM MDIST
590 P(2)=0:IF MDIST(3,4)<>5 THEN 620
600 IF MDIST(-10,4)=12 THEN P(2)=1
620 REM MDIV/MREM
630 P(3)=0:IF MDIV(-100,7)<>-14 THEN 660
640 IF MREM(-100,7)=-2 THEN P(3)=1
660 REM MATAN2
670 P(4)=0:IF MATAN2(100,0)<>64 THEN 710
680 IF MATAN2(0,-100)<>128 THEN 710
690 IF MATAN2(-100,0)=192 THEN P(4)=1
710 REM MDOTFX
720 P(5)=0:IF MDOTFX($0180,$0100,$0200,-256)=512 THEN P(5)=1
740 REM MLEN2
750 P(6)=0:IF MLEN2(3,4)<>25 THEN 780
760 IF MLEN2(120,100)=24400 THEN P(6)=1
780 REM MSCALX/MSCALY
790 P(7)=0:IF MSCALX($0180,$0100,$0080)<>192 THEN 820
800 IF MSCALY($0180,$0100,$0080)=128 THEN P(7)=1
820 REM MRND RANGE
830 P(8)=0:A=MRND:IF A<0 THEN 860
840 IF A<=255 THEN P(8)=1
860 REM CAPS/VERSION REGISTERS
870 P(9)=0:IF PEEK($BB3F)<>2 THEN 910
880 IF PEEK($BB3C)<>127 THEN 910
890 IF PEEK($BB3D)=31 THEN P(9)=1
910 REM COMBINED FUNCTION PATH
920 P(10)=0:A=MATAN2(100,100)
930 IF A<>32 THEN 980
940 X=MSCALX(MCOS(A),MSIN(A),$0100)
950 Y=MSCALY(MCOS(A),MSIN(A),$0100)
960 IF MDIST(X,Y)>120 THEN P(10)=1
980 RETURN
