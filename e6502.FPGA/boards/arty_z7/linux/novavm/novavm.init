#!/bin/sh
### BEGIN INIT INFO
# Provides:          novavm
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: NovaVM host (loads ROM, boots the 6502 to NovaBASIC, serves FIO)
### END INIT INFO

DAEMON=/usr/bin/novavm
LOG=/var/log/novavm.log

case "$1" in
  start)
    echo "Starting NovaVM host..."
    setsid "$DAEMON" </dev/null >"$LOG" 2>&1 &
    ;;
  stop)
    echo "Stopping NovaVM host..."
    for p in $(pgrep novavm); do kill "$p" 2>/dev/null; done
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
