#!/bin/sh
### BEGIN INIT INFO
# Provides:          novavm
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: NovaVM host (loads ROM, boots the 6502 to NovaBASIC, serves FIO)
### END INIT INFO

DAEMON=/usr/bin/novavm
LOG=/run/novavm.log      # tmpfs: writable even while the rootfs is still read-only (early boot)

case "$1" in
  start)
    echo "Starting NovaVM host..."
    # CRITICAL: /dev/mem does NOT exist this early — udev only creates it during
    # its slow coldplug (which runs after us). Create the static node ourselves
    # (major 1, minor 1) so the hold-screen + 6502 boot happen NOW, not after the
    # ~50s coldplug. Harmless if it already exists.
    [ -c /dev/mem ] || mknod /dev/mem c 1 1 2>/dev/null
    echo "[$(cut -d. -f1 /proc/uptime)s] init mem=$([ -c /dev/mem ] && echo Y || echo N) rom=$([ -s /data/nova/roms/ehbasic.bin ] && echo Y || echo N)" >> /run/novavm-timing 2>/dev/null
    # Paint the "please hold" screen immediately (needs only /dev/mem + the PL).
    "$DAEMON" bootmsg 2>/dev/null
    echo "[$(cut -d. -f1 /proc/uptime)s] bootmsg done" >> /run/novavm-timing 2>/dev/null
    # Background a waiter so we never block the rc sequence: hold until /dev/mem +
    # the BASIC ROM exist, then launch. The USB keyboard enumerates later (udev
    # coldplug); nkbd re-scans /dev/input forever, so the early start is fine.
    ( n=0
      while [ ! -c /dev/mem ] || [ ! -s /data/nova/roms/ehbasic.bin ]; do
        n=$((n + 1)); [ "$n" -ge 240 ] && break; sleep 0.25
      done
      echo "[$(cut -d. -f1 /proc/uptime)s] launching novavm" >> /run/novavm-timing 2>/dev/null
      setsid "$DAEMON" </dev/null >"$LOG" 2>&1 ) &
    ;;
  stop)
    echo "Stopping NovaVM host..."
    for p in $(pgrep novavm); do kill "$p" 2>/dev/null; done
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
