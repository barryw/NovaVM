\ Shared Nova NDK libcall ABI constants for NovaForth libraries.

BASE @
DECIMAL

768 CONSTANT LIB-MOD-ID
769 CONSTANT LIB-FN-ID
770 CONSTANT LIB-STATUS
771 CONSTANT LIB-ARG0
775 CONSTANT LIB-ARG1
779 CONSTANT LIB-ARG2
783 CONSTANT LIB-ARG3
787 CONSTANT LIB-RESULT

1 CONSTANT MODULE-GRAPHICS
2 CONSTANT MODULE-SOUND
3 CONSTANT MODULE-SYSTEM
4 CONSTANT MODULE-FILES
5 CONSTANT MODULE-MEMORY
6 CONSTANT MODULE-NET
7 CONSTANT MODULE-TURTLE
8 CONSTANT MODULE-EDITOR

: NDK-CALL ( module fn -- ior )
  NOVA-LIBCALL ;

: NDK-BYTES! ( c-addr u arg -- )
  >R R@ 2 + ! R> ! ;

: NDK-BYTES8! ( c-addr u arg -- )
  >R R@ 2 + C! R> ! ;

: NDK-2BYTES! ( lo hi arg -- )
  >R R@ 1 + C! R> C! ;

: NDK-U24! ( lo hi arg -- )
  NDK-BYTES8! ;

: NDK-RESULT8 ( -- u )
  LIB-RESULT C@ ;

: NDK-RESULT16 ( -- u )
  LIB-RESULT @ ;

: NDK-RESULT24 ( -- lo hi )
  LIB-RESULT @ LIB-RESULT 2 + C@ ;

: NDK-RESULT32 ( -- lo hi )
  LIB-RESULT @ LIB-RESULT 2 + @ ;

BASE !
