\ NovaForth wrappers for the NDK NET module.

INCLUDE forth/lib/nova/ndk.4th

BASE @
DECIMAL

0 CONSTANT NET-FN-CONNECT
1 CONSTANT NET-FN-DISCONNECT
2 CONSTANT NET-FN-LISTEN
3 CONSTANT NET-FN-ACCEPT
4 CONSTANT NET-FN-SEND
5 CONSTANT NET-FN-RECV
6 CONSTANT NET-FN-STATUS
7 CONSTANT NET-FN-READY
8 CONSTANT NET-FN-LENGTH
9 CONSTANT NET-FN-NGS-INIT
10 CONSTANT NET-FN-NGS-SET-BUFFER
11 CONSTANT NET-FN-NGS-SET-STRING
12 CONSTANT NET-FN-NGS-CONNECT
13 CONSTANT NET-FN-NGS-CONNECT-DEFAULT
14 CONSTANT NET-FN-NGS-DISCONNECT
15 CONSTANT NET-FN-NGS-STATUS
16 CONSTANT NET-FN-NGS-READY
17 CONSTANT NET-FN-NGS-SET-TIMEOUT
18 CONSTANT NET-FN-NGS-KA-SET-INTERVAL
19 CONSTANT NET-FN-NGS-KEEPALIVE-RESET
20 CONSTANT NET-FN-NGS-KEEPALIVE-TICK
21 CONSTANT NET-FN-NGS-WAIT-CONNECTED
22 CONSTANT NET-FN-NGS-SEND-CURRENT
23 CONSTANT NET-FN-NGS-RECV-CURRENT
24 CONSTANT NET-FN-NGS-WAIT-MESSAGE
25 CONSTANT NET-FN-NGS-WAIT-KIND
26 CONSTANT NET-FN-NGS-PING-ROUNDTRIP
27 CONSTANT NET-FN-NGS-PARSE-ENVELOPE
28 CONSTANT NET-FN-BUILD-HELLO
29 CONSTANT NET-FN-BUILD-PING
30 CONSTANT NET-FN-BUILD-LOBBY-CHAT
31 CONSTANT NET-FN-BUILD-TABLE-CHAT
32 CONSTANT NET-FN-BUILD-USER-LIST-REQUEST
33 CONSTANT NET-FN-BUILD-GAME-LIST-REQUEST
34 CONSTANT NET-FN-BUILD-TABLE-LIST-REQUEST
35 CONSTANT NET-FN-BUILD-TABLE-CREATE
36 CONSTANT NET-FN-BUILD-TABLE-JOIN
37 CONSTANT NET-FN-BUILD-TABLE-OBSERVE
38 CONSTANT NET-FN-BUILD-TABLE-LEAVE
39 CONSTANT NET-FN-BUILD-PLAYER-ACTION
40 CONSTANT NET-FN-BUILD-STATE-REQUEST
41 CONSTANT NET-FN-BUILD-AI-LIST-REQUEST
42 CONSTANT NET-FN-BUILD-AI-ADD-TO-TABLE
43 CONSTANT NET-FN-BUILD-OPP-LIST-REQUEST
44 CONSTANT NET-FN-COUNT

: NET-CALL MODULE-NET SWAP NOVA-LIBCALL ;

: NET-CONNECT ( c-addr u rport slot -- ior )
  LIB-ARG3 C! LIB-ARG1 ! LIB-ARG0 NDK-BYTES8!
  NET-FN-CONNECT NET-CALL ;

: NET-DISCONNECT ( slot -- ior )
  LIB-ARG3 C!
  NET-FN-DISCONNECT NET-CALL ;

: NET-LISTEN ( lport slot -- ior )
  LIB-ARG3 C! LIB-ARG1 !
  NET-FN-LISTEN NET-CALL ;

: NET-ACCEPT ( slot -- ior )
  LIB-ARG3 C!
  NET-FN-ACCEPT NET-CALL ;

: NET-SEND ( c-addr u slot -- ior )
  LIB-ARG3 C! LIB-ARG0 NDK-BYTES8!
  NET-FN-SEND NET-CALL ;

: NET-RECV ( c-addr slot -- ior )
  LIB-ARG3 C! LIB-ARG0 !
  NET-FN-RECV NET-CALL ;

: NET-STATUS ( slot -- status ior )
  LIB-ARG3 C!
  NET-FN-STATUS NET-CALL NDK-RESULT8 SWAP ;

: NET-READY ( slot -- flag ior )
  LIB-ARG3 C!
  NET-FN-READY NET-CALL NDK-RESULT8 SWAP ;

: NET-LENGTH ( -- u ior )
  NET-FN-LENGTH NET-CALL NDK-RESULT8 SWAP ;

: NET-NGS-INIT ( -- ior )
  NET-FN-NGS-INIT NET-CALL ;

: NET-NGS-SET-BUFFER ( c-addr -- ior )
  LIB-ARG0 !
  NET-FN-NGS-SET-BUFFER NET-CALL ;

: NET-NGS-SET-STRING ( c-addr u -- ior )
  LIB-ARG0 NDK-BYTES8!
  NET-FN-NGS-SET-STRING NET-CALL ;

: NET-NGS-CONNECT ( -- ior )
  NET-FN-NGS-CONNECT NET-CALL ;

: NET-NGS-CONNECT-DEFAULT ( -- ior )
  NET-FN-NGS-CONNECT-DEFAULT NET-CALL ;

: NET-NGS-DISCONNECT ( -- ior )
  NET-FN-NGS-DISCONNECT NET-CALL ;

: NET-NGS-STATUS ( -- status ior )
  NET-FN-NGS-STATUS NET-CALL NDK-RESULT8 SWAP ;

: NET-NGS-READY ( -- flag ior )
  NET-FN-NGS-READY NET-CALL NDK-RESULT8 SWAP ;

: NET-NGS-SET-TIMEOUT ( frames -- ior )
  LIB-ARG0 !
  NET-FN-NGS-SET-TIMEOUT NET-CALL ;

: NET-NGS-KEEPALIVE-SET-INTERVAL ( frames -- ior )
  LIB-ARG0 !
  NET-FN-NGS-KA-SET-INTERVAL NET-CALL ;

: NET-NGS-KEEPALIVE-RESET ( -- ior )
  NET-FN-NGS-KEEPALIVE-RESET NET-CALL ;

: NET-NGS-KEEPALIVE-TICK ( -- ior )
  NET-FN-NGS-KEEPALIVE-TICK NET-CALL ;

: NET-NGS-WAIT-CONNECTED ( -- ior )
  NET-FN-NGS-WAIT-CONNECTED NET-CALL ;

: NET-NGS-SEND-CURRENT ( -- ior )
  NET-FN-NGS-SEND-CURRENT NET-CALL ;

: NET-NGS-RECV-CURRENT ( -- ior )
  NET-FN-NGS-RECV-CURRENT NET-CALL ;

: NET-NGS-WAIT-MESSAGE ( -- ior )
  NET-FN-NGS-WAIT-MESSAGE NET-CALL ;

: NET-NGS-WAIT-KIND ( kind -- ior )
  LIB-ARG0 C!
  NET-FN-NGS-WAIT-KIND NET-CALL ;

: NET-NGS-PING-ROUNDTRIP ( -- ior )
  NET-FN-NGS-PING-ROUNDTRIP NET-CALL ;

: NET-NGS-PARSE-ENVELOPE ( -- kind ior )
  NET-FN-NGS-PARSE-ENVELOPE NET-CALL NDK-RESULT8 SWAP ;

: NET-BUILD-HELLO ( cap major minor -- ior )
  LIB-ARG1 NDK-2BYTES! LIB-ARG0 !
  NET-FN-BUILD-HELLO NET-CALL ;

: NET-BUILD-PING ( -- ior )
  NET-FN-BUILD-PING NET-CALL ;

: NET-BUILD-LOBBY-CHAT ( -- ior )
  NET-FN-BUILD-LOBBY-CHAT NET-CALL ;

: NET-BUILD-TABLE-CHAT ( table -- ior )
  LIB-ARG0 !
  NET-FN-BUILD-TABLE-CHAT NET-CALL ;

: NET-BUILD-USER-LIST-REQUEST ( -- ior )
  NET-FN-BUILD-USER-LIST-REQUEST NET-CALL ;

: NET-BUILD-GAME-LIST-REQUEST ( -- ior )
  NET-FN-BUILD-GAME-LIST-REQUEST NET-CALL ;

: NET-BUILD-TABLE-LIST-REQUEST ( game -- ior )
  LIB-ARG0 !
  NET-FN-BUILD-TABLE-LIST-REQUEST NET-CALL ;

: NET-BUILD-TABLE-CREATE ( game major minor -- ior )
  LIB-ARG1 NDK-2BYTES! LIB-ARG0 !
  NET-FN-BUILD-TABLE-CREATE NET-CALL ;

: NET-BUILD-TABLE-JOIN ( table role -- ior )
  LIB-ARG1 C! LIB-ARG0 !
  NET-FN-BUILD-TABLE-JOIN NET-CALL ;

: NET-BUILD-TABLE-OBSERVE ( table -- ior )
  LIB-ARG0 !
  NET-FN-BUILD-TABLE-OBSERVE NET-CALL ;

: NET-BUILD-TABLE-LEAVE ( table -- ior )
  LIB-ARG0 !
  NET-FN-BUILD-TABLE-LEAVE NET-CALL ;

: NET-BUILD-PLAYER-ACTION ( table action -- ior )
  LIB-ARG1 C! LIB-ARG0 !
  NET-FN-BUILD-PLAYER-ACTION NET-CALL ;

: NET-BUILD-STATE-REQUEST ( table -- ior )
  LIB-ARG0 !
  NET-FN-BUILD-STATE-REQUEST NET-CALL ;

: NET-BUILD-AI-LIST-REQUEST ( game -- ior )
  LIB-ARG0 !
  NET-FN-BUILD-AI-LIST-REQUEST NET-CALL ;

: NET-BUILD-AI-ADD-TO-TABLE ( table provider -- ior )
  LIB-ARG1 ! LIB-ARG0 !
  NET-FN-BUILD-AI-ADD-TO-TABLE NET-CALL ;

: NET-BUILD-OPPONENT-LIST-REQUEST ( game -- ior )
  LIB-ARG0 !
  NET-FN-BUILD-OPP-LIST-REQUEST NET-CALL ;

BASE !
