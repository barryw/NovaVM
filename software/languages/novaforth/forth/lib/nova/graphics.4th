: GRAPHICS-CALL MODULE-GRAPHICS SWAP NOVA-LIBCALL ;

: GFX-CALL1 ( a0 fn -- ior )
  >R LIB-ARG0 ! R> GRAPHICS-CALL ;

: GFX-CALL2 ( a0 a1 fn -- ior )
  >R LIB-ARG1 ! LIB-ARG0 ! R> GRAPHICS-CALL ;

: GFX-CALL3 ( a0 a1 a2 fn -- ior )
  >R LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 ! R> GRAPHICS-CALL ;

: GFX-CALL4 ( a0 a1 a2 a3 fn -- ior )
  >R LIB-ARG3 ! LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 ! R> GRAPHICS-CALL ;

: GFX-REPORT8 ( ior -- u ior )
  NDK-RESULT8 SWAP ;

: GFX-REPORT16 ( ior -- u ior )
  NDK-RESULT16 SWAP ;

: GFX-REPORT24 ( ior -- lo hi ior )
  >R NDK-RESULT24 R> ;

: GFX-REPORT32 ( ior -- lo hi ior )
  >R NDK-RESULT32 R> ;

: GFX-GCLS ( -- ior )
  GFN-GCLS GRAPHICS-CALL ;

: GFX-GCOLOR ( color -- ior )
  LIB-ARG0 ! GFN-GCOLOR GRAPHICS-CALL ;

: GFX-PLOT ( x y -- ior )
  LIB-ARG1 ! LIB-ARG0 ! GFN-PLOT GRAPHICS-CALL ;

: GFX-UNPLOT ( x y -- ior )
  LIB-ARG1 ! LIB-ARG0 ! GFN-UNPLOT GRAPHICS-CALL ;

: GFX-LINE ( x0 y0 x1 y1 -- ior )
  LIB-ARG3 ! LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 !
  GFN-LINE GRAPHICS-CALL ;

: GFX-CIRCLE ( cx cy rx ry -- ior )
  LIB-ARG3 ! LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 !
  GFN-CIRCLE GRAPHICS-CALL ;

: GFX-RECT ( x0 y0 x1 y1 -- ior )
  LIB-ARG3 ! LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 !
  GFN-RECT GRAPHICS-CALL ;

: GFX-FILL ( x0 y0 x1 y1 -- ior )
  LIB-ARG3 ! LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 !
  GFN-FILL GRAPHICS-CALL ;

: GFX-PAINT ( x y -- ior )
  LIB-ARG1 ! LIB-ARG0 ! GFN-PAINT GRAPHICS-CALL ;

: GFX-MODE ( mode -- ior )
  LIB-ARG0 ! GFN-MODE GRAPHICS-CALL ;

: GFX-COLOR ( fg bg border -- ior )
  LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 !
  GFN-COLOR GRAPHICS-CALL ;

: GFX-LOCATE ( col row -- ior )
  LIB-ARG1 ! LIB-ARG0 ! GFN-LOCATE GRAPHICS-CALL ;

: GFX-CLS ( -- ior )
  GFN-CLS GRAPHICS-CALL ;

: GFX-GTEXT ( x y c-addr u -- ior )
  LIB-ARG2 NDK-BYTES!
  LIB-ARG1 ! LIB-ARG0 !
  GFN-GTEXT GRAPHICS-CALL ;

: GFX-FONT ( slot -- ior ) GFN-FONT GFX-CALL1 ;
: GFX-REVERSE ( -- ior ) GFN-REVERSE GRAPHICS-CALL ;
: GFX-REVERSEOFF ( -- ior ) GFN-REVERSEOFF GRAPHICS-CALL ;
: GFX-FLASH ( -- ior ) GFN-FLASH GRAPHICS-CALL ;
: GFX-FLASHOFF ( -- ior ) GFN-FLASHOFF GRAPHICS-CALL ;
: GFX-CLSWIN ( -- ior ) GFN-CLSWIN GRAPHICS-CALL ;
: GFX-DISPLAYON ( -- ior ) GFN-DISPLAYON GRAPHICS-CALL ;
: GFX-DISPLAYOFF ( -- ior ) GFN-DISPLAYOFF GRAPHICS-CALL ;

: GFX-SPR-DEFINE ( idx x y color -- ior )
  GFN-SPR-DEFINE GFX-CALL4 ;

: GFX-SPR-ROW ( idx row b01 b23 b45 b67 -- ior )
  LIB-ARG3 2 + ! LIB-ARG3 !
  LIB-ARG2 2 + ! LIB-ARG2 !
  LIB-ARG1 ! LIB-ARG0 !
  GFN-SPR-ROW GRAPHICS-CALL ;

: GFX-SPR-CLEAR ( idx -- ior ) GFN-SPR-CLEAR GFX-CALL1 ;
: GFX-SPR-COPY ( src dst -- ior ) GFN-SPR-COPY GFX-CALL2 ;
: GFX-SPR-POS ( idx x y -- ior ) GFN-SPR-POS GFX-CALL3 ;
: GFX-SPR-ENABLE ( idx -- ior ) GFN-SPR-ENABLE GFX-CALL1 ;
: GFX-SPR-DISABLE ( idx -- ior ) GFN-SPR-DISABLE GFX-CALL1 ;
: GFX-SPR-FLIP ( idx flags -- ior ) GFN-SPR-FLIP GFX-CALL2 ;
: GFX-SPR-PRIORITY ( idx pri -- ior ) GFN-SPR-PRIORITY GFX-CALL2 ;
: GFX-SPR-SHAPE ( idx shape -- ior ) GFN-SPR-SHAPE GFX-CALL2 ;
: GFX-SPR-SETREG ( idx field value -- ior ) GFN-SPR-SETREG GFX-CALL3 ;
: GFX-SPR-SETREG16 ( idx field value -- ior ) GFN-SPR-SETREG16 GFX-CALL3 ;
: GFX-SPR-GETX ( idx -- x ior ) GFN-SPR-GETX GFX-CALL1 GFX-REPORT16 ;
: GFX-SPR-GETY ( idx -- y ior ) GFN-SPR-GETY GFX-CALL1 GFX-REPORT8 ;

: GFX-SPR-COLL-STATUS ( -- status ior ) GFN-SPR-COLL-STATUS GRAPHICS-CALL GFX-REPORT8 ;
: GFX-SPR-COLL-MASK ( -- mask ior ) GFN-SPR-COLL-MASK GRAPHICS-CALL GFX-REPORT16 ;
: GFX-SPR-COLL-CLEAR ( -- ior ) GFN-SPR-COLL-CLEAR GRAPHICS-CALL ;
: GFX-SPR-COLL-READCLEAR ( -- mask ior ) GFN-SPR-COLL-READCLEAR GRAPHICS-CALL GFX-REPORT16 ;
: GFX-SPR-COLL-IRQON ( -- ior ) GFN-SPR-COLL-IRQON GRAPHICS-CALL ;
: GFX-SPR-COLL-IRQOFF ( -- ior ) GFN-SPR-COLL-IRQOFF GRAPHICS-CALL ;
: GFX-SPR-BG-STATUS ( -- status ior ) GFN-SPR-BG-STATUS GRAPHICS-CALL GFX-REPORT8 ;
: GFX-SPR-BG-MASK ( -- mask ior ) GFN-SPR-BG-MASK GRAPHICS-CALL GFX-REPORT16 ;
: GFX-SPR-BG-CLEAR ( -- ior ) GFN-SPR-BG-CLEAR GRAPHICS-CALL ;
: GFX-SPR-BG-READCLEAR ( -- mask ior ) GFN-SPR-BG-READCLEAR GRAPHICS-CALL GFX-REPORT16 ;
: GFX-SPR-BG-IRQON ( -- ior ) GFN-SPR-BG-IRQON GRAPHICS-CALL ;
: GFX-SPR-BG-IRQOFF ( -- ior ) GFN-SPR-BG-IRQOFF GRAPHICS-CALL ;

: GFX-COPPER-LIST ( idx -- ior ) GFN-COPPER-LIST GFX-CALL1 ;
: GFX-COPPER-ADD ( x y reg value -- ior ) GFN-COPPER-ADD GFX-CALL4 ;
: GFX-COPPER-CLEAR ( -- ior ) GFN-COPPER-CLEAR GRAPHICS-CALL ;
: GFX-COPPER-ON ( -- ior ) GFN-COPPER-ON GRAPHICS-CALL ;
: GFX-COPPER-OFF ( -- ior ) GFN-COPPER-OFF GRAPHICS-CALL ;
: GFX-COPPER-USE ( idx -- ior ) GFN-COPPER-USE GFX-CALL1 ;
: GFX-COPPER-END ( -- ior ) GFN-COPPER-END GRAPHICS-CALL ;
: GFX-COPPER-SPLIT ( idx split-y mode0 mode1 -- ior ) GFN-COPPER-SPLIT GFX-CALL4 ;

: GFX-COPPER-SET-REG ( x y reg value -- ior )
  GFN-COPPER-SET-REG GFX-CALL4 ;

: GFX-COPPER-SET-SPRITE-REG ( x y sprite field value -- ior )
  LIB-ARG3 !
  LIB-ARG2 NDK-2BYTES!
  LIB-ARG1 ! LIB-ARG0 !
  GFN-COPPER-SET-SPRITE-REG GRAPHICS-CALL ;

: GFX-WH! ( width height -- )
  LIB-ARG3 2 + ! LIB-ARG3 ! ;

: GFX-DMA-SPACES! ( src-space dst-space -- )
  LIB-ARG0 1 + C! LIB-ARG0 C! ;

: GFX-FILL-SPACE! ( dst-space fill-value -- )
  LIB-ARG0 2 + C! LIB-ARG0 C! ;

: GFX-BLITCOPY ( src-space dst-space src-lo src-hi dst-lo dst-hi width height -- ior )
  GFX-WH!
  LIB-ARG2 NDK-U24!
  LIB-ARG1 NDK-U24!
  GFX-DMA-SPACES!
  GFN-BLITCOPY GRAPHICS-CALL ;

: GFX-BLITFILL ( dst-space fill-value dst-lo dst-hi width height -- ior )
  GFX-WH!
  LIB-ARG2 NDK-U24!
  GFX-FILL-SPACE!
  GFN-BLITFILL GRAPHICS-CALL ;

: GFX-BLIT-START ( -- ior ) GFN-BLIT-START GRAPHICS-CALL ;
: GFX-BLIT-WAIT ( -- ior ) GFN-BLIT-WAIT GRAPHICS-CALL ;

: GFX-DMACOPY ( src-space dst-space src-lo src-hi dst-lo dst-hi len-lo len-hi -- ior )
  LIB-ARG3 NDK-U24!
  LIB-ARG2 NDK-U24!
  LIB-ARG1 NDK-U24!
  GFX-DMA-SPACES!
  GFN-DMACOPY GRAPHICS-CALL ;

: GFX-DMAFILL ( dst-space fill-value dst-lo dst-hi len-lo len-hi -- ior )
  LIB-ARG3 NDK-U24!
  LIB-ARG2 NDK-U24!
  GFX-FILL-SPACE!
  GFN-DMAFILL GRAPHICS-CALL ;

: GFX-BLIT-STATUS ( -- status ior ) GFN-BLIT-STATUS GRAPHICS-CALL GFX-REPORT8 ;
: GFX-BLIT-ERR ( -- err ior ) GFN-BLIT-ERR GRAPHICS-CALL GFX-REPORT8 ;
: GFX-BLIT-COUNT ( -- lo hi ior ) GFN-BLIT-COUNT GRAPHICS-CALL GFX-REPORT24 ;
: GFX-DMA-STATUS ( -- status ior ) GFN-DMA-STATUS GRAPHICS-CALL GFX-REPORT8 ;
: GFX-DMA-ERR ( -- err ior ) GFN-DMA-ERR GRAPHICS-CALL GFX-REPORT8 ;
: GFX-DMA-COUNT ( -- lo hi ior ) GFN-DMA-COUNT GRAPHICS-CALL GFX-REPORT24 ;
: GFX-BLIT-START-FILL ( -- ior ) GFN-BLIT-START-FILL GRAPHICS-CALL ;

: GFX-VS-CALL ( c-addr u fn -- ior )
  >R LIB-ARG0 NDK-BYTES! R> GRAPHICS-CALL ;

: GFX-VS-BLIT ( c-addr u -- ior ) GFN-VS-BLIT GFX-VS-CALL ;
: GFX-VS-BLIT-START ( c-addr u -- ior ) GFN-VS-BLIT-START GFX-VS-CALL ;
: GFX-VS-FILL ( c-addr u -- ior ) GFN-VS-FILL GFX-VS-CALL ;
: GFX-VS-USE-ORIGINAL ( c-addr u -- ior ) GFN-VS-USE-ORIGINAL GFX-VS-CALL ;
: GFX-VS-USE-ROTATED ( c-addr u -- ior ) GFN-VS-USE-ROTATED GFX-VS-CALL ;
: GFX-VS-ROTATE ( c-addr u -- ior ) GFN-VS-ROTATE GFX-VS-CALL ;
: GFX-VS-GFX-BLIT ( c-addr u -- ior ) GFN-VS-GFX-BLIT GFX-VS-CALL ;
: GFX-VS-GFX-BLIT-START ( c-addr u -- ior ) GFN-VS-GFX-BLIT-START GFX-VS-CALL ;
: GFX-VS-GFX-FILL ( c-addr u -- ior ) GFN-VS-GFX-FILL GFX-VS-CALL ;
: GFX-VS-GFX-SAVE-BG ( c-addr u -- ior ) GFN-VS-GFX-SAVE-BG GFX-VS-CALL ;
: GFX-VS-GFX-RESTORE-BG ( c-addr u -- ior ) GFN-VS-GFX-RESTORE-BG GFX-VS-CALL ;
: GFX-VS-GFX-ROTATE-BLIT ( c-addr u -- ior ) GFN-VS-GFX-ROTATE-BLIT GFX-VS-CALL ;
: GFX-VS-GFX-ROTATE-BLIT-KEYED ( c-addr u -- ior ) GFN-VS-GFX-ROTATE-BLIT-KEYED GFX-VS-CALL ;
: GFX-VS-GFX-ROTATE-BLIT-NOWAIT ( c-addr u -- ior ) GFN-VS-GFX-ROTATE-BLIT-NOWAIT GFX-VS-CALL ;
: GFX-VS-SCENE-BEGIN ( c-addr u -- ior ) GFN-VS-SCENE-BEGIN GFX-VS-CALL ;
: GFX-VS-SCENE-COMMIT ( c-addr u -- ior ) GFN-VS-SCENE-COMMIT GFX-VS-CALL ;
: GFX-VS-SCENE-DRAW ( c-addr u -- ior ) GFN-VS-SCENE-DRAW GFX-VS-CALL ;
: GFX-VS-SCENE-COMMIT-ATOMIC ( c-addr u -- ior ) GFN-VS-SCENE-COMMIT-ATOMIC GFX-VS-CALL ;

: GFX-MS-SPAWN ( c-addr u -- handle ior )
  LIB-ARG0 NDK-BYTES!
  GFN-MS-SPAWN GRAPHICS-CALL GFX-REPORT8 ;

: GFX-MS-DESTROY ( handle -- ior ) GFN-MS-DESTROY GFX-CALL1 ;
: GFX-MS-SHOW ( handle -- ior ) GFN-MS-SHOW GFX-CALL1 ;
: GFX-MS-HIDE ( handle -- ior ) GFN-MS-HIDE GFX-CALL1 ;
: GFX-MS-POS ( handle x y -- ior ) GFN-MS-POS GFX-CALL3 ;
: GFX-MS-FRAME ( handle frame -- ior ) GFN-MS-FRAME GFX-CALL2 ;

: GFX-MS-ANIM ( handle c-addr u -- ior )
  LIB-ARG1 NDK-BYTES! LIB-ARG0 !
  GFN-MS-ANIM GRAPHICS-CALL ;

: GFX-MS-PRIORITY ( handle pri -- ior ) GFN-MS-PRIORITY GFX-CALL2 ;
: GFX-MS-TRANSCOLOR ( handle color -- ior ) GFN-MS-TRANSCOLOR GFX-CALL2 ;
: GFX-MS-TICK ( -- ior ) GFN-MS-TICK GRAPHICS-CALL ;
: GFX-MS-COMMIT ( -- ior ) GFN-MS-COMMIT GRAPHICS-CALL ;
: GFX-MS-COMMIT-ONE ( handle -- ior ) GFN-MS-COMMIT-ONE GFX-CALL1 ;

: GFX-MEMREAD ( space addr -- u ior )
  GFN-MEMREAD GFX-CALL2 GFX-REPORT8 ;

: GFX-MEMWRITE ( space addr value -- ior )
  GFN-MEMWRITE GFX-CALL3 ;

: GFX-VPEEK ( offset -- u ior )
  GFN-VPEEK GFX-CALL1 GFX-REPORT8 ;

: GFX-VPOKE ( offset value -- ior )
  GFN-VPOKE GFX-CALL2 ;

: GFX-GSAVE ( space addr len c-addr u -- ior )
  LIB-ARG3 NDK-BYTES!
  LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 !
  GFN-GSAVE GRAPHICS-CALL ;

: GFX-GLOAD ( space addr len c-addr u -- ior )
  LIB-ARG3 NDK-BYTES!
  LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 !
  GFN-GLOAD GRAPHICS-CALL ;

: GFX-NVGLOAD ( c-addr u -- ior )
  LIB-ARG0 NDK-BYTES!
  GFN-NVGLOAD GRAPHICS-CALL ;

: GFX-NVGLOAD-AT ( c-addr u dest -- ior )
  LIB-ARG1 ! LIB-ARG0 NDK-BYTES!
  GFN-NVGLOAD-AT GRAPHICS-CALL ;

: GFX-NVGLOAD-NAMED ( c-addr u -- ior )
  LIB-ARG0 NDK-BYTES!
  GFN-NVGLOAD-NAMED GRAPHICS-CALL ;

: GFX-NVGLOAD-NAMED-AT ( c-addr u dest -- ior )
  LIB-ARG1 ! LIB-ARG0 NDK-BYTES!
  GFN-NVGLOAD-NAMED-AT GRAPHICS-CALL ;

: GFX-ANIM-INIT ( -- ior ) GFN-ANIM-INIT GRAPHICS-CALL ;

: GFX-ANIM-START ( c-addr u target type -- handle ior )
  LIB-ARG2 ! LIB-ARG1 ! LIB-ARG0 NDK-BYTES!
  GFN-ANIM-START GRAPHICS-CALL GFX-REPORT8 ;

: GFX-ANIM-STOP ( handle -- ior ) GFN-ANIM-STOP GFX-CALL1 ;
: GFX-ANIM-TICK ( -- ior ) GFN-ANIM-TICK GRAPHICS-CALL ;
: GFX-ANIM-TICK-ONE ( handle -- ior ) GFN-ANIM-TICK-ONE GFX-CALL1 ;
: GFX-ANIM-SET-FRAME ( handle frame -- ior ) GFN-ANIM-SET-FRAME GFX-CALL2 ;

: GFX-ANIM-LOAD-XRAM ( shape count xlo xhi -- ior )
  LIB-ARG2 NDK-U24!
  LIB-ARG1 ! LIB-ARG0 !
  GFN-ANIM-LOAD-XRAM GRAPHICS-CALL ;

: GFX-ANIM-LOAD-DISK ( shape count file-lo file-hi c-addr u -- ior )
  LIB-ARG3 NDK-BYTES!
  LIB-ARG2 NDK-U24!
  LIB-ARG1 ! LIB-ARG0 !
  GFN-ANIM-LOAD-DISK GRAPHICS-CALL ;

: GFX-TWEEN-ARGS! ( start end duration mode frame -- )
  LIB-ARG3 C!
  LIB-ARG2 NDK-2BYTES!
  LIB-ARG1 ! LIB-ARG0 ! ;

: GFX-TWEEN-RESULT ( ior -- value done progress ior )
  >R NDK-RESULT16 LIB-RESULT 2 + C@ LIB-RESULT 3 + C@ R> ;

: GFX-TWEEN-BEGIN ( start end duration -- value done progress ior )
  0 0 GFX-TWEEN-ARGS!
  GFN-TWEEN-BEGIN GRAPHICS-CALL GFX-TWEEN-RESULT ;

: GFX-TWEEN-EVAL ( start end duration mode frame -- value done progress ior )
  GFX-TWEEN-ARGS!
  GFN-TWEEN-EVAL GRAPHICS-CALL GFX-TWEEN-RESULT ;

: GFX-TWEEN-FIXED ( start end duration frame fn -- value done progress ior )
  >R 0 SWAP GFX-TWEEN-ARGS!
  R> GRAPHICS-CALL GFX-TWEEN-RESULT ;

: GFX-TWEEN-EVAL-LINEAR ( start end duration frame -- value done progress ior )
  GFN-TWEEN-EVAL-LINEAR GFX-TWEEN-FIXED ;

: GFX-TWEEN-EVAL-EASE-IN ( start end duration frame -- value done progress ior )
  GFN-TWEEN-EVAL-EASE-IN GFX-TWEEN-FIXED ;

: GFX-TWEEN-EVAL-EASE-OUT ( start end duration frame -- value done progress ior )
  GFN-TWEEN-EVAL-EASE-OUT GFX-TWEEN-FIXED ;

: GFX-TWEEN-EVAL-EASE-IN-OUT ( start end duration frame -- value done progress ior )
  GFN-TWEEN-EVAL-EASE-IN-OUT GFX-TWEEN-FIXED ;

: GFX-TWEEN-STEP ( start end duration mode frame -- value done progress ior )
  GFX-TWEEN-ARGS!
  GFN-TWEEN-STEP GRAPHICS-CALL GFX-TWEEN-RESULT ;

: GFX-TWEEN-STEP-LINEAR ( start end duration frame -- value done progress ior )
  GFN-TWEEN-STEP-LINEAR GFX-TWEEN-FIXED ;

: GFX-TWEEN-STEP-EASE-IN ( start end duration frame -- value done progress ior )
  GFN-TWEEN-STEP-EASE-IN GFX-TWEEN-FIXED ;

: GFX-TWEEN-STEP-EASE-OUT ( start end duration frame -- value done progress ior )
  GFN-TWEEN-STEP-EASE-OUT GFX-TWEEN-FIXED ;

: GFX-TWEEN-STEP-EASE-IN-OUT ( start end duration frame -- value done progress ior )
  GFN-TWEEN-STEP-EASE-IN-OUT GFX-TWEEN-FIXED ;

BASE !
