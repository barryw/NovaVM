NPP 2
MAIN MAIN.PAS
UNITPATH SYSTEM
UNITPATH USER
OUTPUT FIZZBUZZ.BIN
OPTIMIZE O2
CONFIG INLINE
MAP FIZZBUZZ.MAP
LABEL FIZZBUZZ.LBL
MEMORY {
    RAM: start = $8000, size = $0400, file = %O;
}

SEGMENTS {
    CODE: load = RAM, type = ro;
    RODATA: load = RAM, type = ro;
    BSS: load = RAM, type = bss;
}
