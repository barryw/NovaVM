NPP 2
MAIN MAIN.PAS
UNITPATH SYSTEM
UNITPATH USER
OUTPUT STARBURST.BIN
OPTIMIZE O2
DEFINE NOVA=1
CONFIG INLINE
MAP STARBURST.MAP
LABEL STARBURST.LBL
MEMORY {
    RAM: start = $0900, size = $9700, file = %O;
}

SEGMENTS {
    CODE: load = RAM, type = ro;
    RODATA: load = RAM, type = ro;
    BSS: load = RAM, type = bss;
}
