; Shared ABI between the resident NovaPascal shell and NPPROJ.BIN.

.ifndef NPPROJ_INC_INCLUDED
NPPROJ_INC_INCLUDED = 1

NPP_OP_PARSE       = $01
NPP_OP_NEW         = $02
NPP_OP_ADD_UNIT    = $03
NPP_OP_DEL_UNIT    = $04
NPP_OP_DEL_PROJECT = $05
NPP_OP_GET_UNIT    = $06
NPP_OP_COMBINE     = $07
NPP_OP_NEW_UNIT_PROJECT = $08

NPP_VERSION_1 = 1
NPP_VERSION_2 = 2

NPP_NAME_CAP = 64
NPP_UNIT_NAME_CAP = 16
NPP_UNIT_FILE_CAP = NPP_UNIT_NAME_CAP + 4
NPP_UNIT_CAP = 16
NPP_UNIT_PATH_CAP = 2
NPP_UNIT_PATH_SIZE = NPP_NAME_CAP + 1
NPP_OVERLAY_CAP = 8
NPP_OVERLAY_GROUP_CAP = 5
NPP_OVERLAY_FILE_CAP = 32

; The resident shell reserves this fixed project-plan mailbox at the start of
; its post-document BSS. NPPROJ fills it and the shell consumes it after the
; lower-RAM helper has returned.
NPP_PLAN_BASE = $1900

NPP_PLAN_OUTPUT_LEN = $0000
NPP_PLAN_OUTPUT     = $0001
NPP_PLAN_OBJECT_LEN = NPP_PLAN_OUTPUT + NPP_NAME_CAP
NPP_PLAN_OBJECT     = NPP_PLAN_OBJECT_LEN + 1
NPP_PLAN_DEFINE_LEN = NPP_PLAN_OBJECT + NPP_NAME_CAP
NPP_PLAN_DEFINE     = NPP_PLAN_DEFINE_LEN + 1
NPP_PLAN_CONFIG_LEN = NPP_PLAN_DEFINE + NPP_NAME_CAP
NPP_PLAN_CONFIG     = NPP_PLAN_CONFIG_LEN + 1
NPP_PLAN_MAP_LEN    = NPP_PLAN_CONFIG + NPP_NAME_CAP
NPP_PLAN_MAP        = NPP_PLAN_MAP_LEN + 1
NPP_PLAN_LABEL_LEN  = NPP_PLAN_MAP + NPP_NAME_CAP
NPP_PLAN_LABEL      = NPP_PLAN_LABEL_LEN + 1
NPP_PLAN_VERSION    = NPP_PLAN_LABEL + NPP_NAME_CAP
NPP_PLAN_UNIT_COUNT = NPP_PLAN_VERSION + 1
NPP_PLAN_OPTIMIZE   = NPP_PLAN_UNIT_COUNT + 1
NPP_PLAN_ASM        = NPP_PLAN_OPTIMIZE + 1
NPP_PLAN_INLINE     = NPP_PLAN_ASM + 1
NPP_PLAN_LOAD_LO    = NPP_PLAN_INLINE + 1
NPP_PLAN_LOAD_HI    = NPP_PLAN_LOAD_LO + 1
NPP_PLAN_UNIT_PATH_COUNT = NPP_PLAN_LOAD_HI + 1
NPP_PLAN_UNIT_PATHS = NPP_PLAN_UNIT_PATH_COUNT + 1
NPP_PLAN_TARGET     = NPP_PLAN_UNIT_PATHS + NPP_UNIT_PATH_CAP * NPP_UNIT_PATH_SIZE
NPP_PLAN_LOCAL_COUNT = NPP_PLAN_TARGET + 1
NPP_PLAN_LOCAL_HASHES = NPP_PLAN_LOCAL_COUNT + 1
NPP_PLAN_OVERLAY_COUNT = NPP_PLAN_LOCAL_HASHES + NPP_UNIT_CAP * 3
NPP_PLAN_OVERLAY_GROUPS = NPP_PLAN_OVERLAY_COUNT + 1
NPP_PLAN_OVERLAY_HASHES = NPP_PLAN_OVERLAY_GROUPS + NPP_OVERLAY_CAP
NPP_PLAN_SIZE       = NPP_PLAN_OVERLAY_HASHES + NPP_OVERLAY_CAP * 3

NPP_TARGET_PROGRAM = 0
NPP_TARGET_UNIT    = 1

NPP_DETAIL_INVALID      = $01
NPP_DETAIL_EXISTS       = $02
NPP_DETAIL_NOT_MEMBER   = $03
NPP_DETAIL_NESTED_DIR   = $04
NPP_DETAIL_TOO_MANY     = $05
NPP_DETAIL_VERSION      = $06

.endif
