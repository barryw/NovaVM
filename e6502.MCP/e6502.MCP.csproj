<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <SelfContained>true</SelfContained>
        <!-- Re-enable reflection-based JSON so tool types not in the MCP SDK's
             source-gen JsonContext (e.g. int[] in EmulatorTools.DrawPixels) can
             serialize. Without this, trimming disables reflection JSON and the MCP
             host throws "JsonTypeInfo metadata for type 'System.Int32[]' not provided"
             on startup -> the server dies -> Claude sees "Connection closed". -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" Version="1.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    </ItemGroup>

</Project>
