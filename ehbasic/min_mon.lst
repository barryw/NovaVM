00EE8E  2  C9 2C              CMP   #','
00EE90  2  F0 16              BEQ   @sv_raw
00EE92  2                     ; default: save BASIC program area
00EE92  2  A5 79              LDA   Smeml
00EE94  2  8D A4 B9           STA   FIO_SRCL
00EE97  2  A5 7A              LDA   Smemh
00EE99  2  8D A5 B9           STA   FIO_SRCH
