00EC47  3               .include "fio.s"
00EC47  4               ; Shared Nova File I/O helper routines.
00EC47  4               ;
00EC47  4               ; This file is BASIC-agnostic. BASIC is still responsible for parsing language
00EC47  4               ; expressions; assembly callers can load the FIO_ARG_* pseudo-registers and use
00EC47  4               ; these helpers directly.
00EC47  4               
00EC47  4               .include "fio.inc"
00EC47  5               ; Shared Nova File I/O helper declarations.
00EC47  5               ;
00EC47  5               ; Calling convention for pointer-based filename helpers:
00EC47  5               ;   FIO_ARG_NAMELEN      filename length, 1..63
00EC47  5               ;   FIO_ARG_NAMEPTR_L/H  CPU pointer to filename bytes
00EC47  5               ;
00EC47  5               ; Calling convention for XRAM streaming setup:
00EC47  5               ;   FIO_ARG_ADDRL/M/H    flat 24-bit XRAM address
00EC47  5               ;   FIO_ARG_LENL/H       transfer length; zero means full file for XLOAD
00EC47  5               ;
00EC47  5               ; Routines return A=0 on success and A=1 on error. Detailed status remains
00EC47  5               ; in the FIO_STATUS/FIO_ERRCODE hardware registers.
00EC47  5               
00EC47  5               .ifndef FIO_INC_INCLUDED
00EC47  5               FIO_INC_INCLUDED = 1
00EC47  5               
00EC47  5               .include "nova.inc"
00EC47  5               
00EC47  5               FIO_RESULT_OK    = $00
00EC47  5               FIO_RESULT_ERROR = $01
00EC47  5               FIO_NAME_LIMIT   = $3F
00EC47  5               
00EC47  5               ; Match the XRAM streaming ABI so xram_xload/xram_xsave can call directly.
00EC47  5               ; @label FIO.ARG_ADDRL
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_ADDRL
00EC47  5               ; @summary Low byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00EC47  5               FIO_ARG_ADDRL     = NVR0L
00EC47  5               ; @label FIO.ARG_ADDRM
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_ADDRM
00EC47  5               ; @summary Middle byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00EC47  5               FIO_ARG_ADDRM     = NVR0H
00EC47  5               ; @label FIO.ARG_ADDRH
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_ADDRH
00EC47  5               ; @summary High byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00EC47  5               FIO_ARG_ADDRH     = NVR1L
00EC47  5               ; @label FIO.ARG_LENL
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_LENL
00EC47  5               ; @summary Low byte of transfer length for FIO.PREPARE_XRAM_TRANSFER.
00EC47  5               FIO_ARG_LENL      = NVR3L
00EC47  5               ; @label FIO.ARG_LENH
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_LENH
00EC47  5               ; @summary High byte of transfer length for FIO.PREPARE_XRAM_TRANSFER.
00EC47  5               FIO_ARG_LENH      = NVR3H
00EC47  5               ; @label FIO.ARG_NAMELEN
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_NAMELEN
00EC47  5               ; @summary Filename length for FIO.COPY_NAME.
00EC47  5               FIO_ARG_NAMELEN   = NVR4L
00EC47  5               ; @label FIO.ARG_NAMEPTR_L
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_NAMEPTR_L
00EC47  5               ; @summary Low byte of filename pointer for FIO.COPY_NAME.
00EC47  5               FIO_ARG_NAMEPTR_L = NVR4H
00EC47  5               ; @label FIO.ARG_NAMEPTR_H
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_NAMEPTR_H
00EC47  5               ; @summary High byte of filename pointer for FIO.COPY_NAME.
00EC47  5               FIO_ARG_NAMEPTR_H = NVR5L
00EC47  5               
00EC47  5               .endif
00EC47  5               
00EC47  4               
00EC47  4               .ifndef FIO_IMPLEMENTATION_INCLUDED
00EC47  4               FIO_IMPLEMENTATION_INCLUDED = 1
00EC47  4               
00EC47  4                     .segment "CODE"
00EC47  4               
00EC47  4                     .export fio_issue
00EC47  4                     .export fio_check
00EC47  4                     .export fio_exec
00EC47  4                     .export fio_copy_name
00EC47  4                     .export fio_clear_error
00EC47  4                     .export fio_set_io_error
00EC47  4                     .export fio_save
00EC47  4                     .export fio_load
00EC47  4                     .export fio_dir_open
00EC47  4                     .export fio_dir_read
00EC47  4                     .export fio_delete
00EC47  4                     .export fio_gsave
00EC47  4                     .export fio_gload
00EC47  4                     .export fio_cd
00EC47  4                     .export fio_mkdir
00EC47  4                     .export fio_rmdir
00EC47  4                     .export fio_pwd
00EC47  4                     .export fio_load_runtime
00EC47  4                     .export fio_rng
00EC47  4               .ifndef FIO_NO_STREAMING
00EC47  4                     .export fio_run
00EC47  4                     .export fio_prepare_xram_transfer
00EC47  4               .endif
00EC47  4               
00EC47  4               ; Input: A = FIO command. Does not check completion/status.
00EC47  4               ; @label FIO.ISSUE
00EC47  4               ; @kind routine
00EC47  4               ; @symbol fio_issue
00EC47  4               ; @summary Issue a raw FIO command without waiting for completion.
00EC47  4               ; @in A: FIO command byte.
00EC47  4               fio_issue:
00EC47  4  8D A0 B9           STA   FIO_CMD
00EC4A  4  60                 RTS
00EC4B  4               
00EC4B  4               ; Check current FIO_STATUS.
00EC4B  4               ; @label FIO.CHECK
00EC4B  4               ; @kind routine
00EC4B  4               ; @symbol fio_check
00EC4B  4               ; @summary Convert the current FIO status register to the shared A=0/1 result.
00EC4B  4               ; @out A: 0 on success, 1 on error.
00EC4B  4               fio_check:
00EC4B  4  AD A1 B9           LDA   FIO_STATUS
00EC4E  4  C9 02              CMP   #FIO_OK
00EC50  4  F0 03              BEQ   @ok
00EC52  4  A9 01              LDA   #FIO_RESULT_ERROR
00EC54  4  60                 RTS
00EC55  4               @ok:
00EC55  4  A9 00              LDA   #FIO_RESULT_OK
00EC57  4  60                 RTS
00EC58  4               
00EC58  4               ; Input: A = FIO command. Issue, wait for completion, and check status.
00EC58  4               ; @label FIO.EXEC
00EC58  4               ; @kind routine
00EC58  4               ; @symbol fio_exec
00EC58  4               ; @summary Issue an FIO command, wait for completion, and return A=0/1 status.
00EC58  4               ; @in A: FIO command byte.
00EC58  4               ; @out A: 0 on success, 1 on error.
00EC58  4               fio_exec:
00EC58  4  48                 PHA
00EC59  4  9C A1 B9           STZ   FIO_STATUS
00EC5C  4  9C A2 B9           STZ   FIO_ERRCODE
00EC5F  4  68                 PLA
00EC60  4  8D A0 B9           STA   FIO_CMD
00EC63  4               @wait:
00EC63  4  AD A1 B9           LDA   FIO_STATUS
00EC66  4  F0 FB              BEQ   @wait
00EC68  4  4C 4B EC           JMP   fio_check
00EC6B  4               
00EC6B  4               ; Clear the host-visible FIO error/status latch.
00EC6B  4               ; @label FIO.CLEAR_ERROR
00EC6B  4               ; @kind routine
00EC6B  4               ; @symbol fio_clear_error
00EC6B  4               ; @summary Clear the host-visible FIO status and error latch.
00EC6B  4               ; @out A: 0 on success.
00EC6B  4               fio_clear_error:
00EC6B  4  A9 00              LDA   #FIO_ERR_NONE
00EC6D  4  8D A2 B9           STA   FIO_ERRCODE
00EC70  4  A9 02              LDA   #FIO_STATUS_OK
00EC72  4  8D A1 B9           STA   FIO_STATUS
00EC75  4  A9 27              LDA   #FIO_CMD_CLEARERR
00EC77  4  8D A0 B9           STA   FIO_CMD
00EC7A  4  A9 00              LDA   #FIO_RESULT_OK
00EC7C  4  60                 RTS
00EC7D  4               
00EC7D  4               ; Mark an argument/host I/O error in the hardware status registers.
00EC7D  4               ; @label FIO.SET_IO_ERROR
00EC7D  4               ; @kind routine
00EC7D  4               ; @symbol fio_set_io_error
00EC7D  4               ; @summary Set FIO_STATUS/FIO_ERRCODE to the shared I/O error state.
00EC7D  4               ; @out A: 1 on error.
00EC7D  4               fio_set_io_error:
00EC7D  4  A9 03              LDA   #FIO_STATUS_ERROR
00EC7F  4  8D A1 B9           STA   FIO_STATUS
00EC82  4  A9 02              LDA   #FIO_ERR_IO
00EC84  4  8D A2 B9           STA   FIO_ERRCODE
00EC87  4  A9 01              LDA   #FIO_RESULT_ERROR
00EC89  4  60                 RTS
00EC8A  4               
00EC8A  4               ; Copy filename from FIO_ARG_NAMEPTR_L/H into FIO_NAME.
00EC8A  4               ; @label FIO.COPY_NAME
00EC8A  4               ; @kind routine
00EC8A  4               ; @symbol fio_copy_name
00EC8A  4               ; @summary Copy a pointer-based filename into FIO.NAME/FIO.NAMELEN.
00EC8A  4               ; @requires FIO_ARG_NAMELEN FIO_ARG_NAMEPTR_L FIO_ARG_NAMEPTR_H
00EC8A  4               ; @out A: 0 on success, 1 on invalid name.
00EC8A  4               fio_copy_name:
00EC8A  4  A5 28              LDA   FIO_ARG_NAMELEN
00EC8C  4  F0 16              BEQ   @bad
00EC8E  4  C9 40              CMP   #FIO_NAME_LIMIT + 1
00EC90  4  B0 12              BCS   @bad
00EC92  4  8D A3 B9           STA   FIO_NAMELEN
00EC95  4  AA                 TAX
00EC96  4  A0 00              LDY   #$00
00EC98  4               @copy:
00EC98  4  B1 29              LDA   (FIO_ARG_NAMEPTR_L),Y
00EC9A  4  99 B0 B9           STA   FIO_NAME,Y
00EC9D  4  C8                 INY
00EC9E  4  CA                 DEX
00EC9F  4  D0 F7              BNE   @copy
00ECA1  4  A9 00              LDA   #FIO_RESULT_OK
00ECA3  4  60                 RTS
00ECA4  4               @bad:
00ECA4  4  4C 7D EC           JMP   fio_set_io_error
00ECA7  4               
00ECA7  4               ; @label FIO.SAVE
00ECA7  4               ; @kind routine
00ECA7  4               ; @symbol fio_save
00ECA7  4               ; @summary Save RAM using FIO.NAME plus FIO_SRCL/H and FIO_ENDL/H.
00ECA7  4               ; @requires FIO_NAME FIO_NAMELEN FIO_SRCL FIO_SRCH FIO_ENDL FIO_ENDH
00ECA7  4               fio_save:
00ECA7  4  A9 01              LDA   #FIO_CMD_SAVE
00ECA9  4  4C 58 EC           JMP   fio_exec
00ECAC  4               
00ECAC  4               ; @label FIO.LOAD
00ECAC  4               ; @kind routine
00ECAC  4               ; @symbol fio_load
00ECAC  4               ; @summary Load a BASIC or binary file using FIO.NAME and FIO_SRCL/H.
00ECAC  4               ; @requires FIO_NAME FIO_NAMELEN FIO_SRCL FIO_SRCH
00ECAC  4               fio_load:
00ECAC  4  A9 02              LDA   #FIO_CMD_LOAD
00ECAE  4  4C 58 EC           JMP   fio_exec
00ECB1  4               
00ECB1  4               ; @label FIO.DIR_OPEN
00ECB1  4               ; @kind routine
00ECB1  4               ; @symbol fio_dir_open
00ECB1  4               ; @summary Open a directory listing using optional FIO.NAME/FIO.NAMELEN filter.
00ECB1  4               fio_dir_open:
00ECB1  4  A9 03              LDA   #FIO_CMD_DIROPEN
00ECB3  4  4C 58 EC           JMP   fio_exec
00ECB6  4               
00ECB6  4               ; @label FIO.DIR_READ
00ECB6  4               ; @kind routine
00ECB6  4               ; @symbol fio_dir_read
00ECB6  4               ; @summary Read the next directory entry into the FIO directory result registers.
00ECB6  4               fio_dir_read:
00ECB6  4  A9 04              LDA   #FIO_CMD_DIRREAD
00ECB8  4  4C 58 EC           JMP   fio_exec
00ECBB  4               
00ECBB  4               ; @label FIO.DELETE
00ECBB  4               ; @kind routine
00ECBB  4               ; @symbol fio_delete
00ECBB  4               ; @summary Delete the file named by FIO.NAME/FIO.NAMELEN.
00ECBB  4               ; @requires FIO_NAME FIO_NAMELEN
00ECBB  4               fio_delete:
00ECBB  4  A9 05              LDA   #FIO_CMD_DELETE
00ECBD  4  4C 58 EC           JMP   fio_exec
00ECC0  4               
00ECC0  4               ; @label FIO.GSAVE
00ECC0  4               ; @kind routine
00ECC0  4               ; @symbol fio_gsave
00ECC0  4               ; @summary Save VGC/graphics memory using FIO graphics registers.
00ECC0  4               ; @requires FIO_NAME FIO_NAMELEN FIO_GSPACE FIO_GADDRL FIO_GADDRH FIO_GLENL FIO_GLENH
00ECC0  4               fio_gsave:
00ECC0  4  A9 06              LDA   #FIO_CMD_GSAVE
00ECC2  4  4C 58 EC           JMP   fio_exec
00ECC5  4               
00ECC5  4               ; @label FIO.GLOAD
00ECC5  4               ; @kind routine
00ECC5  4               ; @symbol fio_gload
00ECC5  4               ; @summary Load VGC/graphics memory using FIO graphics registers.
00ECC5  4               ; @requires FIO_NAME FIO_NAMELEN FIO_GSPACE FIO_GADDRL FIO_GADDRH FIO_GLENL FIO_GLENH
00ECC5  4               fio_gload:
00ECC5  4  A9 07              LDA   #FIO_CMD_GLOAD
00ECC7  4  4C 58 EC           JMP   fio_exec
00ECCA  4               
00ECCA  4               ; @label FIO.CD
00ECCA  4               ; @kind routine
00ECCA  4               ; @symbol fio_cd
00ECCA  4               ; @summary Change directory to FIO.NAME/FIO.NAMELEN.
00ECCA  4               ; @requires FIO_NAME FIO_NAMELEN
00ECCA  4               fio_cd:
00ECCA  4  A9 20              LDA   #FIO_CMD_CD
00ECCC  4  4C 58 EC           JMP   fio_exec
00ECCF  4               
00ECCF  4               ; @label FIO.MKDIR
00ECCF  4               ; @kind routine
00ECCF  4               ; @symbol fio_mkdir
00ECCF  4               ; @summary Create the directory named by FIO.NAME/FIO.NAMELEN.
00ECCF  4               ; @requires FIO_NAME FIO_NAMELEN
00ECCF  4               fio_mkdir:
00ECCF  4  A9 21              LDA   #FIO_CMD_MKDIR
00ECD1  4  4C 58 EC           JMP   fio_exec
00ECD4  4               
00ECD4  4               ; @label FIO.RMDIR
00ECD4  4               ; @kind routine
00ECD4  4               ; @symbol fio_rmdir
00ECD4  4               ; @summary Remove the directory named by FIO.NAME/FIO_NAMELEN.
00ECD4  4               ; @requires FIO_NAME FIO_NAMELEN
00ECD4  4               fio_rmdir:
00ECD4  4  A9 22              LDA   #FIO_CMD_RMDIR
00ECD6  4  4C 58 EC           JMP   fio_exec
00ECD9  4               
00ECD9  4               ; @label FIO.PWD
00ECD9  4               ; @kind routine
00ECD9  4               ; @symbol fio_pwd
00ECD9  4               ; @summary Read the current directory into FIO.NAME/FIO.NAMELEN.
00ECD9  4               fio_pwd:
00ECD9  4  A9 26              LDA   #FIO_CMD_PWD
00ECDB  4  4C 58 EC           JMP   fio_exec
00ECDE  4               
00ECDE  4               ; Load a 16K runtime ROM image into the primary $C000 bank.
00ECDE  4               ; This routine is meant for RAM-resident launchers. The host overwrites the
00ECDE  4               ; primary ROM bank while the command is in progress.
00ECDE  4               ; @label FIO.LOAD_RUNTIME
00ECDE  4               ; @kind routine
00ECDE  4               ; @symbol fio_load_runtime
00ECDE  4               ; @summary Load a 16K runtime ROM image named by FIO.NAME/FIO.NAMELEN into the primary runtime ROM bank.
00ECDE  4               ; @requires FIO_NAME FIO_NAMELEN
00ECDE  4               fio_load_runtime:
00ECDE  4  A9 28              LDA   #FIO_CMD_LOADRUNTIME
00ECE0  4  4C 58 EC           JMP   fio_exec
00ECE3  4               
00ECE3  4               ; Fetch 32 host-backed random bits into FIO_RNG0..3.
00ECE3  4               ; @label FIO.RNG
00ECE3  4               ; @kind routine
00ECE3  4               ; @symbol fio_rng
00ECE3  4               ; @summary Issue FIO.CMD_RNG and return random bytes in FIO_RNG0..3.
00ECE3  4               ; @out A: 0 on success, 1 on error.
00ECE3  4               ; @out FIO_RNG0 FIO_RNG1 FIO_RNG2 FIO_RNG3
00ECE3  4               fio_rng:
00ECE3  4  A9 2A              LDA   #FIO_CMD_RNG
00ECE5  4  4C 58 EC           JMP   fio_exec
00ECE8  4               
00ECE8  4               .ifndef FIO_NO_STREAMING
00ECE8  4               ; Compatibility alias for assembly callers that used the streaming name.
00ECE8  4               ; @label FIO.RUN
00ECE8  4               ; @kind routine
00ECE8  4               ; @symbol fio_run
00ECE8  4               ; @summary Compatibility alias for FIO.EXEC.
00ECE8  4               fio_run:
00ECE8  4                     JMP   fio_exec
00ECE8  4               
00ECE8  4               ; Prepare the FIO hardware registers for XLOAD/XSAVE-style direct XRAM I/O.
00ECE8  4               ; @label FIO.PREPARE_XRAM_TRANSFER
00ECE8  4               ; @kind routine
00ECE8  4               ; @symbol fio_prepare_xram_transfer
00ECE8  4               ; @summary Copy pointer filename and XRAM transfer arguments into FIO registers.
00ECE8  4               ; @requires FIO_ARG_NAMELEN FIO_ARG_NAMEPTR_L FIO_ARG_NAMEPTR_H FIO_ARG_ADDRL FIO_ARG_ADDRM FIO_ARG_ADDRH FIO_ARG_LENL FIO_ARG_LENH
00ECE8  4               fio_prepare_xram_transfer:
00ECE8  4                     JSR   fio_copy_name
00ECE8  4                     BNE   @done
00ECE8  4                     LDA   FIO_ARG_ADDRL
00ECE8  4                     STA   FIO_GADDRL
00ECE8  4                     LDA   FIO_ARG_ADDRM
00ECE8  4                     STA   FIO_GADDRH
00ECE8  4                     LDA   FIO_ARG_ADDRH
00ECE8  4                     STA   FIO_GSPACE
00ECE8  4                     LDA   FIO_ARG_LENL
00ECE8  4                     STA   FIO_GLENL
00ECE8  4                     LDA   FIO_ARG_LENH
00ECE8  4                     STA   FIO_GLENH
00ECE8  4                     LDA   #FIO_RESULT_OK
00ECE8  4               @done:
00ECE8  4                     RTS
00ECE8  4               .endif
00ECE8  4               
00ECE8  4               .endif
00ECE8  4               
00ECE8  3               
00ECE8  3               ; @label AUDIO.PLAY_SOUND
00ECE8  3               ; @kind routine
00ECE8  3               ; @symbol audio_play_sound
00ECE8  3               ; @abi register
00ECE8  3               ; @summary Play a one-shot note using A/X/Y register arguments.
00ECE8  3               ; @in A: MIDI note
00ECE8  3               ; @in X: Duration in 60 Hz frames
00ECE8  3               ; @in Y: Instrument slot
00ECE8  3               ; @out A: 0 on success, nonzero on error
00ECE8  3               audio_play_sound:
00ECE8  3  8D A4 B9           STA   AUDIO_NOTE
00ECEB  3  8E A5 B9           STX   AUDIO_DURATION
00ECEE  3  8C A6 B9           STY   AUDIO_INSTRUMENT
00ECF1  3  80 08              BRA   audio_sound
00ECF3  3               
00ECF3  3               ; @label AUDIO.SET_VOLUME
00ECF3  3               ; @kind routine
00ECF3  3               ; @symbol audio_set_volume
00ECF3  3               ; @abi register
00ECF3  3               ; @summary Set master or per-voice volume using A/X register arguments.
00ECF3  3               ; @in A: Volume level
00ECF3  3               ; @in X: Voice selector, 0=master
00ECF3  3               ; @out A: 0 on success, nonzero on error
00ECF3  3               audio_set_volume:
00ECF3  3  8D A4 B9           STA   AUDIO_VOLUME
00ECF6  3  8E A5 B9           STX   AUDIO_VOICE
00ECF9  3  80 05              BRA   audio_volume
00ECFB  3               
00ECFB  3               ; @label AUDIO.SOUND
00ECFB  3               ; @kind routine
00ECFB  3               ; @symbol audio_sound
00ECFB  3               ; @abi pseudo-register
00ECFB  3               ; @summary Play a one-shot note from AUDIO.NOTE, AUDIO.DURATION, and AUDIO.INSTRUMENT.
00ECFB  3               ; @requires AUDIO.NOTE AUDIO.DURATION AUDIO.INSTRUMENT
00ECFB  3               ; @out A: 0 on success, nonzero on error
00ECFB  3               audio_sound:
00ECFB  3  A9 0B              LDA   #FIO_CMD_SOUND
00ECFD  3  4C 58 EC           JMP   fio_exec
00ED00  3               
00ED00  3               ; @label AUDIO.VOLUME
00ED00  3               ; @kind routine
00ED00  3               ; @symbol audio_volume
00ED00  3               ; @abi pseudo-register
00ED00  3               ; @summary Set volume from AUDIO.VOLUME_LEVEL and AUDIO.VOICE.
00ED00  3               ; @requires AUDIO.VOLUME_LEVEL AUDIO.VOICE
00ED00  3               ; @out A: 0 on success, nonzero on error
00ED00  3               audio_volume:
00ED00  3  A9 0C              LDA   #FIO_CMD_VOLUME
00ED02  3  4C 58 EC           JMP   fio_exec
00ED05  3               
00ED05  3               ; @label AUDIO.INSTRUMENT_SET
00ED05  3               ; @kind routine
00ED05  3               ; @symbol audio_instrument
00ED05  3               ; @abi pseudo-register
00ED05  3               ; @summary Define an instrument envelope and waveform.
00ED05  3               ; @requires AUDIO.INST_ID AUDIO.WAVEFORM AUDIO.ATTACK AUDIO.DECAY AUDIO.SUSTAIN AUDIO.RELEASE
00ED05  3               ; @out A: 0 on success, nonzero on error
00ED05  3               audio_instrument:
00ED05  3  A9 0A              LDA   #FIO_CMD_INSTRUMENT
00ED07  3  4C 58 EC           JMP   fio_exec
00ED0A  3               
00ED0A  3               .if AUDIO_FILE_COMMANDS
00ED0A  3               ; @label AUDIO.SIDPLAY
00ED0A  3               ; @kind routine
00ED0A  3               ; @symbol audio_sidplay
00ED0A  3               ; @abi pseudo-register
00ED0A  3               ; @summary Play the SID file named by FIO.NAME/FIO.NAMELEN. AUDIO.NOTE is reused as the 1-based song number.
00ED0A  3               ; @requires FIO.NAME FIO.NAMELEN AUDIO.NOTE
00ED0A  3               ; @out A: 0 on success, nonzero on error
00ED0A  3               audio_sidplay:
00ED0A  3  A9 08              LDA   #FIO_CMD_SIDPLAY
00ED0C  3  20 58 EC           JSR   fio_exec
00ED0F  3  D0 01              BNE   @done
00ED11  3  58                 CLI                     ; playback needs timer IRQs active
00ED12  3               @done:
00ED12  3  60                 RTS
00ED13  3               
