00EDA2  3               ; @summary Set master or per-voice volume using A/X register arguments.
00EDA2  3               ; @in A: Volume level
00EDA2  3               ; @in X: Voice selector, 0=master
00EDA2  3               ; @out A: 0 on success, nonzero on error
00EDA2  3               audio_set_volume:
00EDA2  3  8D A4 B9           STA   AUDIO_VOLUME
00EDA5  3  8E A5 B9           STX   AUDIO_VOICE
00EDA8  3  80 05              BRA   audio_volume
00EDAA  3               
00EDAA  3               ; @label AUDIO.SOUND
00EDAA  3               ; @kind routine
00EDAA  3               ; @symbol audio_sound
00EDAA  3               ; @abi pseudo-register
00EDAA  3               ; @summary Play a one-shot note from AUDIO.NOTE, AUDIO.DURATION, and AUDIO.INSTRUMENT.
00EDAA  3               ; @requires AUDIO.NOTE AUDIO.DURATION AUDIO.INSTRUMENT
00EDAA  3               ; @out A: 0 on success, nonzero on error
00EDAA  3               audio_sound:
00EDAA  3  A9 0B              LDA   #FIO_CMD_SOUND
00EDAC  3  4C 0C ED           JMP   fio_exec
00EDAF  3               
