00ECFB  3               .include "fio.s"
00ECFB  4               ; Shared Nova File I/O helper routines.
00ECFB  4               ;
00ECFB  4               ; This file is BASIC-agnostic. BASIC is still responsible for parsing language
00ECFB  4               ; expressions; assembly callers can load the FIO_ARG_* pseudo-registers and use
00ECFB  4               ; these helpers directly.
00ECFB  4               
00ECFB  4               .include "fio.inc"
00ECFB  5               ; Shared Nova File I/O helper declarations.
00ECFB  5               ;
00ECFB  5               ; Calling convention for pointer-based filename helpers:
00ECFB  5               ;   FIO_ARG_NAMELEN      filename length, 1..63
00ECFB  5               ;   FIO_ARG_NAMEPTR_L/H  CPU pointer to filename bytes
00ECFB  5               ;
00ECFB  5               ; Calling convention for XRAM streaming setup:
00ECFB  5               ;   FIO_ARG_ADDRL/M/H    flat 24-bit XRAM address
00ECFB  5               ;   FIO_ARG_LENL/H       transfer length; zero means full file for XLOAD
00ECFB  5               ;
00ECFB  5               ; Routines return A=0 on success and A=1 on error. Detailed status remains
00ECFB  5               ; in the FIO_STATUS/FIO_ERRCODE hardware registers.
00ECFB  5               
00ECFB  5               .ifndef FIO_INC_INCLUDED
00ECFB  5               FIO_INC_INCLUDED = 1
00ECFB  5               
00ECFB  5               .include "nova.inc"
00ECFB  5               
00ECFB  5               FIO_RESULT_OK    = $00
00ECFB  5               FIO_RESULT_ERROR = $01
00ECFB  5               FIO_NAME_LIMIT   = $3F
00ECFB  5               
00ECFB  5               ; Match the XRAM streaming ABI so xram_xload/xram_xsave can call directly.
00ECFB  5               ; @label FIO.ARG_ADDRL
00ECFB  5               ; @kind zp
00ECFB  5               ; @symbol FIO_ARG_ADDRL
00ECFB  5               ; @summary Low byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00ECFB  5               FIO_ARG_ADDRL     = NVR0L
00ECFB  5               ; @label FIO.ARG_ADDRM
00ECFB  5               ; @kind zp
00ECFB  5               ; @symbol FIO_ARG_ADDRM
00ECFB  5               ; @summary Middle byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00ECFB  5               FIO_ARG_ADDRM     = NVR0H
00ECFB  5               ; @label FIO.ARG_ADDRH
00ECFB  5               ; @kind zp
00ECFB  5               ; @symbol FIO_ARG_ADDRH
00ECFB  5               ; @summary High byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00ECFB  5               FIO_ARG_ADDRH     = NVR1L
00ECFB  5               ; @label FIO.ARG_LENL
00ECFB  5               ; @kind zp
00ECFB  5               ; @symbol FIO_ARG_LENL
00ECFB  5               ; @summary Low byte of transfer length for FIO.PREPARE_XRAM_TRANSFER.
00ECFB  5               FIO_ARG_LENL      = NVR3L
00ECFB  5               ; @label FIO.ARG_LENH
00ECFB  5               ; @kind zp
00ECFB  5               ; @symbol FIO_ARG_LENH
00ECFB  5               ; @summary High byte of transfer length for FIO.PREPARE_XRAM_TRANSFER.
00ECFB  5               FIO_ARG_LENH      = NVR3H
00ECFB  5               ; @label FIO.ARG_NAMELEN
00ECFB  5               ; @kind zp
00ECFB  5               ; @symbol FIO_ARG_NAMELEN
00ECFB  5               ; @summary Filename length for FIO.COPY_NAME.
00ECFB  5               FIO_ARG_NAMELEN   = NVR4L
00ECFB  5               ; @label FIO.ARG_NAMEPTR_L
00ECFB  5               ; @kind zp
00ECFB  5               ; @symbol FIO_ARG_NAMEPTR_L
00ECFB  5               ; @summary Low byte of filename pointer for FIO.COPY_NAME.
00ECFB  5               FIO_ARG_NAMEPTR_L = NVR4H
00ECFB  5               ; @label FIO.ARG_NAMEPTR_H
00ECFB  5               ; @kind zp
00ECFB  5               ; @symbol FIO_ARG_NAMEPTR_H
00ECFB  5               ; @summary High byte of filename pointer for FIO.COPY_NAME.
00ECFB  5               FIO_ARG_NAMEPTR_H = NVR5L
00ECFB  5               
00ECFB  5               .endif
00ECFB  5               
00ECFB  4               
