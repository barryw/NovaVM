00EE4A  3               
00EE4A  3               ; @label AUDIO.MUSIC_PRIORITY
00EE4A  3               ; @kind routine
00EE4A  3               ; @symbol audio_music_priority
00EE4A  3               ; @abi pseudo-register
00EE4A  3               ; @summary Set voice-stealing priority from AUDIO.NOTE and following pseudo-register bytes.
00EE4A  3               ; @requires AUDIO.NOTE
00EE4A  3               ; @out A: 0 on success, nonzero on error
00EE4A  3               audio_music_priority:
