00ED69  5               NVR2H             = $25
00ED69  5               .endif
00ED69  5               .ifndef NVR3L
00ED69  5               NVR3L             = $26
00ED69  5               .endif
00ED69  5               .ifndef NVR3H
00ED69  5               NVR3H             = $27
00ED69  5               .endif
00ED69  5               .ifndef NVR4L
00ED69  5               NVR4L             = $28
00ED69  5               .endif
00ED69  5               .ifndef NVR4H
00ED69  5               NVR4H             = $29
00ED69  5               .endif
00ED69  5               .ifndef NVR5L
00ED69  5               NVR5L             = $2A
00ED69  5               .endif
00ED69  5               .ifndef NVR5H
00ED69  5               NVR5H             = $2B
00ED69  5               .endif
00ED69  5               .ifndef NVR6L
00ED69  5               NVR6L             = $2C
00ED69  5               .endif
00ED69  5               .ifndef NVR6H
00ED69  5               NVR6H             = $2D
00ED69  5               .endif
00ED69  5               .ifndef NVR7L
00ED69  5               NVR7L             = $2E
00ED69  5               .endif
00ED69  5               .ifndef NVR7H
00ED69  5               NVR7H             = $2F
00ED69  5               .endif
