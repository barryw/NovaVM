00E50D  2  CA                 DEX                     ; decrement bit pair count
00E50E  2  D0 A2              BNE   LAB_SQE1          ; loop if not all done
00E510  2               
00E510  2  38                 SEC                     ; set carry for subtract
00E511  2  A5 B3              LDA   FAC2_e            ; get exponent
00E513  2  E9 80              SBC   #$80              ; normalise
00E515  2  6A                 ROR                     ; /2 and re-bias to $80
00E516  2  69 00              ADC   #$00              ; add bit zero back in (allow for half shift)
00E518  2  85 AC              STA   FAC1_e            ; save it
00E51A  2  4C A1 DA           JMP   LAB_24D5          ; normalise FAC1 and return
00E51D  2               
00E51D  2               ; perform VARPTR()
00E51D  2               
00E51D  2               LAB_VARPTR
00E51D  2  20 BC 00           JSR   LAB_IGBY          ; increment and scan memory
00E520  2  20 AF D1           JSR   LAB_GVAR          ; get var address
00E523  2  20 F7 CD           JSR   LAB_1BFB          ; scan for ")" , else do syntax error then warm start
00E526  2  A4 95              LDY   Cvaral            ; get var address low byte
00E528  2  A5 96              LDA   Cvarah            ; get var address high byte
00E52A  2  4C 67 D4           JMP   LAB_AYFC          ; save and convert integer AY to FAC1 and return
00E52D  2               
00E52D  2               ; perform PI
00E52D  2               
00E52D  2               LAB_PI
00E52D  2  A9 C3              LDA   #<LAB_2C7C        ; set (2*pi) pointer low byte
00E52F  2  A0 F4              LDY   #>LAB_2C7C        ; set (2*pi) pointer high byte
00E531  2  20 E6 DC           JSR   LAB_UFAC          ; unpack memory (AY) into FAC1
00E534  2  C6 AC              DEC   FAC1_e            ; make result = PI
00E536  2  60                 RTS
00E537  2               
00E537  2               ; perform TWOPI
00E537  2               
00E537  2               LAB_TWOPI
00E537  2  A9 C3              LDA   #<LAB_2C7C        ; set (2*pi) pointer low byte
00E539  2  A0 F4              LDY   #>LAB_2C7C        ; set (2*pi) pointer high byte
00E53B  2  4C E6 DC           JMP   LAB_UFAC          ; unpack memory (AY) into FAC1 and return
