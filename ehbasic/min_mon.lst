00ECFB  4                     .export fio_check
00ECFB  4                     .export fio_exec
00ECFB  4                     .export fio_copy_name
00ECFB  4                     .export fio_clear_error
00ECFB  4                     .export fio_set_io_error
00ECFB  4                     .export fio_save
00ECFB  4                     .export fio_load
00ECFB  4                     .export fio_dir_open
00ECFB  4                     .export fio_dir_read
