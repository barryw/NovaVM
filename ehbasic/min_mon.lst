00E8BB  2                     .include "lib/sprite.s"
00E8BB  3               ; Shared Nova sprite helper routines.
00E8BB  3               ;
00E8BB  3               ; Assembly callers can load VGC_P* and call the command helpers, or use the
00E8BB  3               ; direct register helpers for the VGC sprite attribute block.
00E8BB  3               
00E8BB  3               .include "sprite.inc"
00E8BB  4               ; Shared Nova sprite helper declarations.
00E8BB  4               ;
00E8BB  4               ; Command helpers use VGC_P* registers directly. Direct sprite-register helpers
00E8BB  4               ; use the public sprite attribute register block at VGC_SPR_BASE.
00E8BB  4               
00E8BB  4               .ifndef SPRITE_INC_INCLUDED
00E8BB  4               SPRITE_INC_INCLUDED = 1
00E8BB  4               
00E8BB  4               .include "vgc.inc"
00E8BB  5               ; Shared Nova VGC helper declarations.
00E8BB  5               ;
00E8BB  5               ; The command helpers use the VGC hardware parameter registers directly:
00E8BB  5               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
00E8BB  5               ; Routines return through the hardware status model; command completion can be
00E8BB  5               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
00E8BB  5               
00E8BB  5               .ifndef VGC_INC_INCLUDED
00E8BB  5               VGC_INC_INCLUDED = 1
00E8BB  5               
00E8BB  5               .include "nova.inc"
00E8BB  5               
00E8BB  5               VGC_RESULT_OK    = $00
00E8BB  5               VGC_RESULT_ERROR = $01
00E8BB  5               
00E8BB  5               .endif
00E8BB  5               
00E8BB  4               
00E8BB  4               SPRITE_RESULT_OK    = $00
00E8BB  4               SPRITE_RESULT_ERROR = $01
00E8BB  4               
00E8BB  4               .endif
00E8BB  4               
00E8BB  3               
00E8BB  3               .ifndef SPRITE_IMPLEMENTATION_INCLUDED
00E8BB  3               SPRITE_IMPLEMENTATION_INCLUDED = 1
00E8BB  3               
00E8BB  3                     .segment "CODE"
00E8BB  3               
00E8BB  3                     .export sprite_command
00E8BB  3                     .export sprite_pos
00E8BB  3                     .export sprite_enable
00E8BB  3                     .export sprite_disable
00E8BB  3                     .export sprite_row
00E8BB  3               .ifndef SPRITE_NO_EXTRA
00E8BB  3                     .export sprite_clear
00E8BB  3                     .export sprite_copy
00E8BB  3                     .export sprite_flip
00E8BB  3                     .export sprite_priority
00E8BB  3               .endif
00E8BB  3                     .export sprite_reg_offset
00E8BB  3                     .export sprite_set_shape
00E8BB  3                     .export sprite_set_reg8
00E8BB  3                     .export sprite_set_reg16
00E8BB  3                     .export sprite_get_x
00E8BB  3                     .export sprite_get_y
00E8BB  3                     .export sprite_collision_status
00E8BB  3                     .export sprite_background_collision_status
00E8BB  3               
00E8BB  3               ; Input: A = sprite VGC command. Does not wait for completion.
00E8BB  3               ; @label SPRITE.COMMAND
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol sprite_command
00E8BB  3               ; @summary Issue a raw sprite VGC command without waiting for completion.
00E8BB  3               ; @in A: VGC sprite command byte.
00E8BB  3               sprite_command:
00E8BB  3  8D 10 A0           STA   VGC_CMD
00E8BE  3  60                 RTS
00E8BF  3               
00E8BF  3               ; Command wrappers. Callers load VGC_P* per the hardware command ABI.
00E8BF  3               ; @label SPRITE.POS
00E8BF  3               ; @kind routine
00E8BF  3               ; @symbol sprite_pos
00E8BF  3               ; @summary Move a sprite using VGC.P0=sprite, VGC.P1/P2=x, VGC.P3=y.
00E8BF  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E8BF  3               sprite_pos:
00E8BF  3  A9 14              LDA   #VCMD_SPRPOS
00E8C1  3  4C BB E8           JMP   sprite_command
00E8C4  3               
00E8C4  3               ; @label SPRITE.ENABLE
00E8C4  3               ; @kind routine
00E8C4  3               ; @symbol sprite_enable
00E8C4  3               ; @summary Enable the sprite in VGC.P0.
00E8C4  3               ; @requires VGC_P0
00E8C4  3               sprite_enable:
00E8C4  3  A9 15              LDA   #VCMD_SPRENA
00E8C6  3  4C BB E8           JMP   sprite_command
00E8C9  3               
00E8C9  3               ; @label SPRITE.DISABLE
00E8C9  3               ; @kind routine
00E8C9  3               ; @symbol sprite_disable
00E8C9  3               ; @summary Disable the sprite in VGC.P0.
00E8C9  3               ; @requires VGC_P0
00E8C9  3               sprite_disable:
00E8C9  3  A9 16              LDA   #VCMD_SPRDIS
00E8CB  3  4C BB E8           JMP   sprite_command
00E8CE  3               
00E8CE  3               ; @label SPRITE.ROW
00E8CE  3               ; @kind routine
00E8CE  3               ; @symbol sprite_row
00E8CE  3               ; @summary Write one sprite bitmap row using VGC.P0..VGC.P9.
00E8CE  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7 VGC_P8 VGC_P9
00E8CE  3               sprite_row:
00E8CE  3  A9 11              LDA   #VCMD_SPRROW
00E8D0  3  4C BB E8           JMP   sprite_command
00E8D3  3               
00E8D3  3               .ifndef SPRITE_NO_EXTRA
00E8D3  3               sprite_clear:
00E8D3  3                     LDA   #VCMD_SPRCLR
00E8D3  3                     JMP   sprite_command
00E8D3  3               
00E8D3  3               sprite_copy:
00E8D3  3                     LDA   #VCMD_SPRCOPY
00E8D3  3                     JMP   sprite_command
00E8D3  3               
00E8D3  3               sprite_flip:
00E8D3  3                     LDA   #VCMD_SPRFLIP
00E8D3  3                     JMP   sprite_command
00E8D3  3               
00E8D3  3               sprite_priority:
00E8D3  3                     LDA   #VCMD_SPRPRI
00E8D3  3                     JMP   sprite_command
00E8D3  3               .endif
00E8D3  3               
00E8D3  3               ; Input: X = sprite index, Y = sprite register field offset.
00E8D3  3               ; Output: Y = VGC_SPR_BASE-relative register offset.
00E8D3  3               ; Clobbers: A, NVR7L.
00E8D3  3               ; @label SPRITE.REG_OFFSET
00E8D3  3               ; @kind routine
00E8D3  3               ; @symbol sprite_reg_offset
00E8D3  3               ; @summary Compute the VGC sprite attribute block offset for a sprite field.
00E8D3  3               ; @in X: Sprite index.
00E8D3  3               ; @in Y: Sprite field offset.
00E8D3  3               ; @out Y: VGC_SPR_BASE-relative byte offset.
00E8D3  3               sprite_reg_offset:
00E8D3  3  84 2E              STY   NVR7L
00E8D5  3  8A                 TXA
00E8D6  3  0A                 ASL
00E8D7  3  0A                 ASL
00E8D8  3  0A                 ASL
00E8D9  3  18                 CLC
00E8DA  3  65 2E              ADC   NVR7L
00E8DC  3  A8                 TAY
00E8DD  3  60                 RTS
00E8DE  3               
00E8DE  3               ; Input: X = sprite index, A = shape.
00E8DE  3               ; @label SPRITE.SET_SHAPE
00E8DE  3               ; @kind routine
00E8DE  3               ; @symbol sprite_set_shape
00E8DE  3               ; @summary Set a sprite's shape index.
00E8DE  3               ; @in X: Sprite index.
00E8DE  3               ; @in A: Shape index.
00E8DE  3               sprite_set_shape:
00E8DE  3  A0 04              LDY   #VGC_SPR_SHAPE_OFF
00E8E0  3                     ; fall through
00E8E0  3               
00E8E0  3               ; Input: X = sprite index, Y = field offset, A = value.
00E8E0  3               ; Clobbers: A, Y, NVR7L/NVR7H.
00E8E0  3               ; @label SPRITE.SET_REG8
00E8E0  3               ; @kind routine
00E8E0  3               ; @symbol sprite_set_reg8
00E8E0  3               ; @summary Write one 8-bit sprite attribute field.
00E8E0  3               ; @in X: Sprite index.
00E8E0  3               ; @in Y: Sprite field offset.
00E8E0  3               ; @in A: Field value.
00E8E0  3               sprite_set_reg8:
00E8E0  3  85 2F              STA   NVR7H
00E8E2  3  20 D3 E8           JSR   sprite_reg_offset
00E8E5  3  A5 2F              LDA   NVR7H
00E8E7  3  99 40 A0           STA   VGC_SPR_BASE,Y
00E8EA  3  60                 RTS
00E8EB  3               
00E8EB  3               ; Input: X = sprite index, Y = field offset, NVR0L/NVR0H = little-endian value.
00E8EB  3               ; Clobbers: A, Y, NVR7L.
00E8EB  3               ; @label SPRITE.SET_REG16
00E8EB  3               ; @kind routine
00E8EB  3               ; @symbol sprite_set_reg16
00E8EB  3               ; @summary Write one 16-bit sprite attribute field.
00E8EB  3               ; @in X: Sprite index.
00E8EB  3               ; @in Y: Sprite field offset.
00E8EB  3               ; @in NVR0L: Low byte.
00E8EB  3               ; @in NVR0H: High byte.
00E8EB  3               sprite_set_reg16:
00E8EB  3  20 D3 E8           JSR   sprite_reg_offset
00E8EE  3  A5 20              LDA   NVR0L
00E8F0  3  99 40 A0           STA   VGC_SPR_BASE,Y
00E8F3  3  C8                 INY
00E8F4  3  A5 21              LDA   NVR0H
00E8F6  3  99 40 A0           STA   VGC_SPR_BASE,Y
00E8F9  3  60                 RTS
00E8FA  3               
00E8FA  3               ; Input: X = sprite index. Output: A = X high byte, Y = X low byte.
00E8FA  3               ; @label SPRITE.GET_X
00E8FA  3               ; @kind routine
00E8FA  3               ; @symbol sprite_get_x
00E8FA  3               ; @summary Read a sprite's 16-bit X coordinate.
00E8FA  3               ; @in X: Sprite index.
00E8FA  3               ; @out A: X high byte.
00E8FA  3               ; @out Y: X low byte.
00E8FA  3               sprite_get_x:
00E8FA  3  A0 00              LDY   #VGC_SPR_XL_OFF
00E8FC  3  20 D3 E8           JSR   sprite_reg_offset
00E8FF  3  B9 40 A0           LDA   VGC_SPR_BASE,Y
00E902  3  85 2E              STA   NVR7L
00E904  3  C8                 INY
00E905  3  B9 40 A0           LDA   VGC_SPR_BASE,Y
00E908  3  A4 2E              LDY   NVR7L
00E90A  3  60                 RTS
00E90B  3               
00E90B  3               ; Input: X = sprite index. Output: Y = Y low byte.
00E90B  3               ; @label SPRITE.GET_Y
00E90B  3               ; @kind routine
00E90B  3               ; @symbol sprite_get_y
00E90B  3               ; @summary Read a sprite's Y coordinate.
00E90B  3               ; @in X: Sprite index.
00E90B  3               ; @out Y: Y coordinate byte.
00E90B  3               sprite_get_y:
00E90B  3  A0 02              LDY   #VGC_SPR_YL_OFF
00E90D  3  20 D3 E8           JSR   sprite_reg_offset
00E910  3  B9 40 A0           LDA   VGC_SPR_BASE,Y
00E913  3  A8                 TAY
00E914  3  60                 RTS
00E915  3               
00E915  3               ; @label SPRITE.COLLISION_STATUS
00E915  3               ; @kind routine
00E915  3               ; @symbol sprite_collision_status
00E915  3               ; @summary Read the sprite-sprite collision status register.
00E915  3               ; @out A: Collision status byte.
00E915  3               sprite_collision_status:
00E915  3  AD 0B A0           LDA   VGC_COLLST
00E918  3  60                 RTS
00E919  3               
00E919  3               ; @label SPRITE.BACKGROUND_STATUS
00E919  3               ; @kind routine
00E919  3               ; @symbol sprite_background_collision_status
00E919  3               ; @summary Read the sprite-background collision status register.
00E919  3               ; @out A: Background collision status byte.
00E919  3               sprite_background_collision_status:
00E919  3  AD 0C A0           LDA   VGC_COLLBG
00E91C  3  60                 RTS
00E91D  3               
00E91D  3               .endif
00E91D  3               
00E91D  2               
00E91D  2               LAB_VGC_CMD_RTS = vgc_cmd
00E91D  2               LAB_VSYNC       = vgc_vsync
00E91D  2               
00E91D  2               ; perform CLS — clear screen, no arguments
00E91D  2               
00E91D  2               LAB_CLS
00E91D  2  4C 49 E8           JMP   vgc_cls
00E920  2               
00E920  2               ; perform COLOR fg [,bg [,border]]
00E920  2               
00E920  2               LAB_COLOR
00E920  2  20 45 D8           JSR   LAB_GTBY          ; get fg color byte in X
00E923  2  20 4F E8           JSR   vgc_set_fg        ; store foreground color
00E926  2  20 C2 00           JSR   LAB_GBYT          ; peek at current byte
00E929  2  C9 2C              CMP   #','              ; comma follows?
00E92B  2  D0 19              BNE   @done             ; no, just fg was given
00E92D  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00E930  2  20 45 D8           JSR   LAB_GTBY          ; get bg color byte in X
00E933  2  20 53 E8           JSR   vgc_set_bg        ; store background color
00E936  2  20 C2 00           JSR   LAB_GBYT          ; peek for optional border color
00E939  2  C9 2C              CMP   #','              ; second comma follows?
00E93B  2  D0 09              BNE   @done             ; no, fg/bg only
00E93D  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00E940  2  20 45 D8           JSR   LAB_GTBY          ; get border color byte in X
00E943  2  20 57 E8           JSR   vgc_set_border    ; store border color
00E946  2               @done
00E946  2  60                 RTS
00E947  2               
00E947  2               ; perform REVERSE [fg,bg]
00E947  2               
00E947  2               LAB_REVERSE
00E947  2  20 C2 00           JSR   LAB_GBYT          ; optional explicit reverse colours?
00E94A  2  F0 20              BEQ   @swap
00E94C  2  C9 3A              CMP   #':'              ; no args before next statement
00E94E  2  F0 1C              BEQ   @swap
00E950  2  20 45 D8           JSR   LAB_GTBY          ; reverse foreground in X
00E953  2  8A                 TXA
00E954  2  29 0F              AND   #$0F
00E956  2  48                 PHA
00E957  2  20 09 CE           JSR   LAB_1C01          ; comma
00E95A  2  20 45 D8           JSR   LAB_GTBY          ; reverse background in X
00E95D  2  8A                 TXA
00E95E  2  29 0F              AND   #$0F
00E960  2  0A                 ASL
00E961  2  0A                 ASL
00E962  2  0A                 ASL
00E963  2  0A                 ASL
00E964  2  85 78              STA   TempB
00E966  2  68                 PLA
00E967  2  05 78              ORA   TempB
00E969  2  4C 92 E8           JMP   vgc_reverse_explicit
00E96C  2               @swap
00E96C  2  4C 87 E8           JMP   vgc_reverse_default
00E96F  2               
00E96F  2               ; perform REVERSEOFF
00E96F  2               
00E96F  2               LAB_REVERSEOFF
00E96F  2  4C A0 E8           JMP   vgc_reverse_off
00E972  2               
00E972  2               ; perform FLASH
00E972  2               
00E972  2               LAB_FLASH
00E972  2  4C A9 E8           JMP   vgc_flash_on
00E975  2               
00E975  2               ; perform FLASHOFF
00E975  2               
00E975  2               LAB_FLASHOFF
00E975  2  4C B2 E8           JMP   vgc_flash_off
00E978  2               
00E978  2               ; perform VPOKE plane,addr,value — write a byte to VGC memory
00E978  2               
00E978  2               LAB_VPOKE
00E978  2  20 45 D8           JSR   LAB_GTBY
00E97B  2  8E 11 A0           STX   VGC_P0
00E97E  2  20 09 CE           JSR   LAB_1C01
00E981  2  20 33 D8           JSR   LAB_GTWRD
00E984  2  A5 AF              LDA   FAC1_3
00E986  2  8D 12 A0           STA   VGC_P1
00E989  2  A5 AE              LDA   FAC1_2
00E98B  2  8D 13 A0           STA   VGC_P2
00E98E  2  20 09 CE           JSR   LAB_1C01
00E991  2  20 45 D8           JSR   LAB_GTBY
00E994  2  8E 14 A0           STX   VGC_P3
00E997  2  9C 15 A0           STZ   VGC_P4
00E99A  2  4C 7F E8           JMP   vgc_mem_write
00E99D  2               
00E99D  2               ; perform LOCATE x, y
00E99D  2               
00E99D  2               LAB_LOCATE
00E99D  2  20 45 D8           JSR   LAB_GTBY          ; get x in X
00E9A0  2  8E 11 A0           STX   VGC_P0            ; store cursor X
00E9A3  2  20 09 CE           JSR   LAB_1C01          ; require comma
00E9A6  2  20 45 D8           JSR   LAB_GTBY          ; get y in X
00E9A9  2  8E 12 A0           STX   VGC_P1            ; store cursor Y
00E9AC  2  4C 67 E8           JMP   vgc_locate
00E9AF  2               
00E9AF  2               ; perform MODE n
00E9AF  2               
00E9AF  2               LAB_GMODE
00E9AF  2  20 45 D8           JSR   LAB_GTBY          ; get mode byte in X
00E9B2  2  4C 74 E8           JMP   vgc_set_mode
00E9B5  2               
00E9B5  2               ; perform FONT n — select active font slot (0-7)
00E9B5  2               
00E9B5  2               LAB_FONT
00E9B5  2  20 45 D8           JSR   LAB_GTBY          ; get font index byte (0-7) in X
00E9B8  2  4C 78 E8           JMP   vgc_set_font
00E9BB  2               
00E9BB  2               ; perform GCLS — clear the graphics bitmap layer
00E9BB  2               
00E9BB  2               LAB_GCLS
00E9BB  2  20 40 E8           JSR   LAB_VSYNC         ; BASIC hides visible VGC draw tearing
00E9BE  2  A9 07              LDA   #VCMD_GCLS        ; GCLS command
00E9C0  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00E9C3  2               
00E9C3  2               ; perform GCOLOR c — set graphics draw color (0-15)
00E9C3  2               
00E9C3  2               LAB_GCOLOR
00E9C3  2  20 45 D8           JSR   LAB_GTBY          ; get color byte in X
00E9C6  2  8E 11 A0           STX   VGC_P0             ; color in P0
00E9C9  2  9C 12 A0           STZ   VGC_P1             ; high byte = 0
00E9CC  2  A9 08              LDA   #VCMD_GCOLOR      ; GCOLOR command
00E9CE  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00E9D1  2               
00E9D1  2               ; shared: load x(word),y(byte) into VGC_P0-P3
00E9D1  2               
00E9D1  2               LAB_VGC_XY
00E9D1  2  20 33 D8           JSR   LAB_GTWRD         ; get x as 16-bit
00E9D4  2  A5 AF              LDA   FAC1_3
00E9D6  2  8D 11 A0           STA   VGC_P0             ; x low
00E9D9  2  A5 AE              LDA   FAC1_2
00E9DB  2  8D 12 A0           STA   VGC_P1             ; x high
00E9DE  2  20 09 CE           JSR   LAB_1C01          ; require comma
00E9E1  2  20 45 D8           JSR   LAB_GTBY          ; get y as byte
00E9E4  2  8E 13 A0           STX   VGC_P2             ; y low
00E9E7  2  9C 14 A0           STZ   VGC_P3             ; y high = 0
00E9EA  2  60                 RTS
00E9EB  2               
00E9EB  2               ; shared: load x0,y0,x1,y1 into VGC_P0-P7
00E9EB  2               
00E9EB  2               LAB_VGC_XYXY
00E9EB  2  20 D1 E9           JSR   LAB_VGC_XY        ; x0,y0 → P0-P3
00E9EE  2  20 09 CE           JSR   LAB_1C01          ; comma
00E9F1  2  20 33 D8           JSR   LAB_GTWRD         ; x1 as 16-bit
00E9F4  2  A5 AF              LDA   FAC1_3
00E9F6  2  8D 15 A0           STA   VGC_P4             ; x1 low
00E9F9  2  A5 AE              LDA   FAC1_2
00E9FB  2  8D 16 A0           STA   VGC_P5             ; x1 high
00E9FE  2  20 09 CE           JSR   LAB_1C01          ; comma
00EA01  2  20 45 D8           JSR   LAB_GTBY          ; y1
00EA04  2  8E 17 A0           STX   VGC_P6             ; y1 low
00EA07  2  9C 18 A0           STZ   VGC_P7             ; y1 high = 0
00EA0A  2  60                 RTS
00EA0B  2               
00EA0B  2               ; perform PLOT x, y
00EA0B  2               
00EA0B  2               LAB_PLOT
00EA0B  2  20 D1 E9           JSR   LAB_VGC_XY
00EA0E  2  20 40 E8           JSR   LAB_VSYNC         ; wait before visible graphics mutation
00EA11  2  A9 01              LDA   #VCMD_PLOT        ; PLOT command
00EA13  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00EA16  2               
00EA16  2               ; perform UNPLOT x, y
00EA16  2               
00EA16  2               LAB_UNPLOT
00EA16  2  20 D1 E9           JSR   LAB_VGC_XY
00EA19  2  20 40 E8           JSR   LAB_VSYNC
00EA1C  2  A9 02              LDA   #VCMD_UNPLOT      ; UNPLOT command
00EA1E  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00EA21  2               
00EA21  2               ; perform LINE x0, y0, x1, y1
00EA21  2               
00EA21  2               LAB_GLINE
00EA21  2  20 EB E9           JSR   LAB_VGC_XYXY
00EA24  2  20 40 E8           JSR   LAB_VSYNC
00EA27  2  A9 03              LDA   #VCMD_LINE        ; LINE command
00EA29  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00EA2C  2               
00EA2C  2               ; perform CIRCLE cx, cy, rx [, ry]
00EA2C  2               ; 3 args = circle (rx=ry), 4 args = ellipse
00EA2C  2               
00EA2C  2               LAB_CIRCLE
00EA2C  2  20 D1 E9           JSR   LAB_VGC_XY        ; cx,cy → P0-P3
00EA2F  2  20 09 CE           JSR   LAB_1C01          ; comma
00EA32  2  20 33 D8           JSR   LAB_GTWRD         ; rx as 16-bit
00EA35  2  A5 AF              LDA   FAC1_3
00EA37  2  8D 15 A0           STA   VGC_P4             ; rx low
00EA3A  2  A5 AE              LDA   FAC1_2
00EA3C  2  8D 16 A0           STA   VGC_P5             ; rx high
00EA3F  2  9C 17 A0           STZ   VGC_P6             ; ry low = 0 (circle)
00EA42  2  9C 18 A0           STZ   VGC_P7             ; ry high = 0
00EA45  2  20 C2 00           JSR   LAB_GBYT          ; peek next
00EA48  2  C9 2C              CMP   #','
00EA4A  2  D0 10              BNE   @circ_go
00EA4C  2  20 09 CE           JSR   LAB_1C01          ; consume comma
00EA4F  2  20 33 D8           JSR   LAB_GTWRD         ; ry as 16-bit
00EA52  2  A5 AF              LDA   FAC1_3
00EA54  2  8D 17 A0           STA   VGC_P6             ; ry low
00EA57  2  A5 AE              LDA   FAC1_2
00EA59  2  8D 18 A0           STA   VGC_P7             ; ry high
00EA5C  2               @circ_go
00EA5C  2  20 40 E8           JSR   LAB_VSYNC
00EA5F  2  A9 04              LDA   #VCMD_CIRCLE      ; CIRCLE command
00EA61  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00EA64  2               
00EA64  2               ; perform GTEXT x, y, font, scale, "string"
00EA64  2               
00EA64  2               LAB_GTEXT
00EA64  2  20 D1 E9           JSR   LAB_VGC_XY        ; x,y → P0-P3
00EA67  2  20 09 CE           JSR   LAB_1C01          ; comma
00EA6A  2  20 45 D8           JSR   LAB_GTBY          ; font (0-7) → X
00EA6D  2  8E 15 A0           STX   VGC_P4             ; P4 = font index
00EA70  2  20 09 CE           JSR   LAB_1C01          ; comma
00EA73  2  20 45 D8           JSR   LAB_GTBY          ; scale (1-8) → X
00EA76  2  8E 16 A0           STX   VGC_P5             ; P5 = scale
00EA79  2  20 09 CE           JSR   LAB_1C01          ; comma
00EA7C  2  20 4C F1           JSR   LAB_FIO_GETNAME   ; string → FIO_NAME/FIO_NAMELEN
00EA7F  2  20 40 E8           JSR   LAB_VSYNC
00EA82  2  A9 0A              LDA   #VCMD_GTEXT
00EA84  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00EA87  2               
00EA87  2               ; perform RECT x0, y0, x1, y1
00EA87  2               
00EA87  2               LAB_RECT
00EA87  2  20 EB E9           JSR   LAB_VGC_XYXY
00EA8A  2  20 40 E8           JSR   LAB_VSYNC
00EA8D  2  A9 05              LDA   #VCMD_RECT        ; RECT command
00EA8F  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00EA92  2               
00EA92  2               ; perform FILL x0, y0, x1, y1
00EA92  2               
00EA92  2               LAB_FILLRECT
00EA92  2  20 EB E9           JSR   LAB_VGC_XYXY
00EA95  2  20 40 E8           JSR   LAB_VSYNC
00EA98  2  A9 06              LDA   #VCMD_FILL        ; FILL command
00EA9A  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00EA9D  2               
00EA9D  2               ; perform PAINT x, y
00EA9D  2               
00EA9D  2               LAB_PAINT
00EA9D  2  20 D1 E9           JSR   LAB_VGC_XY
00EAA0  2  20 40 E8           JSR   LAB_VSYNC
00EAA3  2  A9 09              LDA   #VCMD_PAINT       ; PAINT command
00EAA5  2  4C 34 E8           JMP   LAB_VGC_CMD_RTS
00EAA8  2               
00EAA8  2               ; perform SPRITE n, ON/OFF  or  SPRITE n, x, y
00EAA8  2               ; sprite number 0-15, ON/OFF enables/disables, x,y sets position
00EAA8  2               ; Uses command-driven VGC interface:
00EAA8  2               ;   SPRENA ($15): P0=sprite
00EAA8  2               ;   SPRDIS ($16): P0=sprite
00EAA8  2               ;   SPRPOS ($14): P0=sprite, P1=x_low, P2=x_high, P3=y_low, P4 reserved
00EAA8  2               
00EAA8  2               LAB_SPRCMD
00EAA8  2  20 45 D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EAAB  2  86 11              STX   Itempl            ; save sprite number
00EAAD  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EAB0  2  20 C2 00           JSR   LAB_GBYT          ; peek at next token
00EAB3  2  C9 93              CMP   #TK_ON            ; is it ON?
00EAB5  2  F0 25              BEQ   @spr_on
00EAB7  2  C9 CB              CMP   #TK_OFF           ; is it OFF?
00EAB9  2  F0 2C              BEQ   @spr_off
00EABB  2                     ; not ON/OFF — parse x, y position
00EABB  2  A5 11              LDA   Itempl            ; get sprite number
00EABD  2  8D 11 A0           STA   VGC_P0             ; P0 = sprite index
00EAC0  2  20 33 D8           JSR   LAB_GTWRD         ; get unsigned x as 16-bit
00EAC3  2  A5 AF              LDA   FAC1_3
00EAC5  2  8D 12 A0           STA   VGC_P1             ; P1 = x low
00EAC8  2  A5 AE              LDA   FAC1_2
00EACA  2  8D 13 A0           STA   VGC_P2             ; P2 = x high
00EACD  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EAD0  2  20 45 D8           JSR   LAB_GTBY          ; get unsigned y byte
00EAD3  2  8E 14 A0           STX   VGC_P3             ; P3 = y
00EAD6  2  9C 15 A0           STZ   VGC_P4             ; P4 reserved
00EAD9  2  4C BF E8           JMP   sprite_pos         ; trigger and return
00EADC  2               
00EADC  2               @spr_on
00EADC  2  20 BC 00           JSR   LAB_IGBY          ; consume the ON token
00EADF  2  A5 11              LDA   Itempl            ; get sprite number
00EAE1  2  8D 11 A0           STA   VGC_P0             ; P0 = sprite index
00EAE4  2  4C C4 E8           JMP   sprite_enable      ; trigger and return
00EAE7  2               
00EAE7  2               @spr_off
00EAE7  2  20 BC 00           JSR   LAB_IGBY          ; consume the OFF token
00EAEA  2  A5 11              LDA   Itempl            ; get sprite number
00EAEC  2  8D 11 A0           STA   VGC_P0             ; P0 = sprite index
00EAEF  2  4C C9 E8           JMP   sprite_disable     ; trigger and return
00EAF2  2               
00EAF2  2               ; perform SPRITESHAPE n, shape
00EAF2  2               ; Writes shape index to sprite register VGC_SPR_SHAPE + n*8
00EAF2  2               
00EAF2  2               LAB_SPRSHAPE
00EAF2  2  20 45 D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EAF5  2  86 11              STX   Itempl
00EAF7  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EAFA  2  20 45 D8           JSR   LAB_GTBY          ; get shape index in X
00EAFD  2  8A                 TXA
00EAFE  2  A6 11              LDX   Itempl
00EB00  2  4C DE E8           JMP   sprite_set_shape
00EB03  2               
00EB03  2               ; perform SPRITESET sprite, field, value — set sprite register
00EB03  2               ; Field 0 (X) accepts an unsigned word and writes lo+hi bytes.
00EB03  2               ; Field 2 (Y) and all other fields accept a byte value.
00EB03  2               ; Hardware vblank-buffers sprite attribute writes; software writes immediately.
00EB03  2               
00EB03  2               LAB_SPRCOLOR
00EB03  2  20 45 D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EB06  2  86 11              STX   Itempl            ; save sprite number
00EB08  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EB0B  2  20 45 D8           JSR   LAB_GTBY          ; get field (0-7) in X
00EB0E  2  86 12              STX   Itemph            ; save field number
00EB10  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EB13  2  A5 12              LDA   Itemph            ; check field number
00EB15  2  F0 0B              BEQ   @word_val
00EB17  2                     ; --- byte field: parse byte value ---
00EB17  2  20 45 D8           JSR   LAB_GTBY          ; get value (0-255) in X
00EB1A  2  8A                 TXA                     ; A = value
00EB1B  2  A6 11              LDX   Itempl            ; X = sprite number
00EB1D  2  A4 12              LDY   Itemph            ; Y = field
00EB1F  2  4C E0 E8           JMP   sprite_set_reg8
00EB22  2               @word_val
00EB22  2                     ; --- word field: parse unsigned word, write lo+hi ---
00EB22  2  20 33 D8           JSR   LAB_GTWRD         ; get unsigned 16-bit value, lo in FAC1_3, hi in FAC1_2
00EB25  2  A5 AF              LDA   FAC1_3
00EB27  2  85 20              STA   NVR0L
00EB29  2  A5 AE              LDA   FAC1_2
00EB2B  2  85 21              STA   NVR0H
00EB2D  2  A6 11              LDX   Itempl            ; X = sprite number
00EB2F  2  A4 12              LDY   Itemph            ; Y = field
00EB31  2  4C EB E8           JMP   sprite_set_reg16
00EB34  2               
00EB34  2               ; perform SPRITEDATA sprite, row, b1, b2 [, b3 [, b4 [, b5 [, b6 [, b7 [, b8]]]]]]
00EB34  2               ; Uses CmdSprRow ($11): P0=sprite, P1=row, P2-P9=8 bytes of row data.
00EB34  2               ; Unprovided bytes are zeroed.
00EB34  2               
00EB34  2               LAB_SPRDATA
00EB34  2  20 45 D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EB37  2  8E 11 A0           STX   VGC_P0             ; P0 = sprite index
00EB3A  2  20 09 CE           JSR   LAB_1C01          ; comma
00EB3D  2  20 45 D8           JSR   LAB_GTBY          ; get row (0-15) in X
00EB40  2  8E 12 A0           STX   VGC_P1             ; P1 = row
00EB43  2                     ; zero all 8 data bytes first
00EB43  2  9C 13 A0           STZ   VGC_P2
00EB46  2  9C 14 A0           STZ   VGC_P3
00EB49  2  9C 15 A0           STZ   VGC_P4
00EB4C  2  9C 16 A0           STZ   VGC_P5
00EB4F  2  9C 17 A0           STZ   VGC_P6
00EB52  2  9C 18 A0           STZ   VGC_P7
00EB55  2  9C 19 A0           STZ   VGC_P8
00EB58  2  9C 1A A0           STZ   VGC_P9
00EB5B  2                     ; parse b1 (required)
00EB5B  2  20 09 CE           JSR   LAB_1C01          ; comma
00EB5E  2  20 45 D8           JSR   LAB_GTBY          ; b1 → X
00EB61  2  8E 13 A0           STX   VGC_P2
00EB64  2                     ; parse b2 (required)
00EB64  2  20 09 CE           JSR   LAB_1C01          ; comma
00EB67  2  20 45 D8           JSR   LAB_GTBY          ; b2 → X
00EB6A  2  8E 14 A0           STX   VGC_P3
00EB6D  2                     ; parse optional b3-b8
00EB6D  2  20 C2 00           JSR   LAB_GBYT
00EB70  2  C9 2C              CMP   #','
00EB72  2  D0 59              BNE   @sd_done
00EB74  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00EB77  2  20 45 D8           JSR   LAB_GTBY          ; b3 → X
00EB7A  2  8E 15 A0           STX   VGC_P4
00EB7D  2  20 C2 00           JSR   LAB_GBYT
00EB80  2  C9 2C              CMP   #','
00EB82  2  D0 49              BNE   @sd_done
00EB84  2  20 BC 00           JSR   LAB_IGBY
00EB87  2  20 45 D8           JSR   LAB_GTBY          ; b4 → X
00EB8A  2  8E 16 A0           STX   VGC_P5
00EB8D  2  20 C2 00           JSR   LAB_GBYT
00EB90  2  C9 2C              CMP   #','
00EB92  2  D0 39              BNE   @sd_done
00EB94  2  20 BC 00           JSR   LAB_IGBY
00EB97  2  20 45 D8           JSR   LAB_GTBY          ; b5 → X
00EB9A  2  8E 17 A0           STX   VGC_P6
00EB9D  2  20 C2 00           JSR   LAB_GBYT
00EBA0  2  C9 2C              CMP   #','
00EBA2  2  D0 29              BNE   @sd_done
00EBA4  2  20 BC 00           JSR   LAB_IGBY
00EBA7  2  20 45 D8           JSR   LAB_GTBY          ; b6 → X
00EBAA  2  8E 18 A0           STX   VGC_P7
00EBAD  2  20 C2 00           JSR   LAB_GBYT
00EBB0  2  C9 2C              CMP   #','
00EBB2  2  D0 19              BNE   @sd_done
00EBB4  2  20 BC 00           JSR   LAB_IGBY
00EBB7  2  20 45 D8           JSR   LAB_GTBY          ; b7 → X
00EBBA  2  8E 19 A0           STX   VGC_P8
00EBBD  2  20 C2 00           JSR   LAB_GBYT
00EBC0  2  C9 2C              CMP   #','
00EBC2  2  D0 09              BNE   @sd_done
00EBC4  2  20 BC 00           JSR   LAB_IGBY
00EBC7  2  20 45 D8           JSR   LAB_GTBY          ; b8 → X
00EBCA  2  8E 1A A0           STX   VGC_P9
00EBCD  2               @sd_done
00EBCD  2  4C CE E8           JMP   sprite_row         ; trigger and return
00EBD0  2               
00EBD0  2               ; perform SOUND note, duration [, instrument]
00EBD0  2               ; SOUND 60, 10          — MIDI note 60, 10 frames, default instrument 0
00EBD0  2               ; SOUND 60, 10, 3       — MIDI note 60, 10 frames, instrument 3
00EBD0  2               
00EBD0  2               LAB_SOUND
00EBD0  2  20 45 D8           JSR   LAB_GTBY          ; midi note → X
00EBD3  2  8E A4 B9           STX   AUDIO_NOTE
00EBD6  2  20 09 CE           JSR   LAB_1C01          ; comma
00EBD9  2  20 45 D8           JSR   LAB_GTBY          ; duration → X
00EBDC  2  8E A5 B9           STX   AUDIO_DURATION
00EBDF  2  9C A6 B9           STZ   AUDIO_INSTRUMENT  ; default instrument = 0
00EBE2  2  20 C2 00           JSR   LAB_GBYT          ; peek next token
00EBE5  2  C9 2C              CMP   #','
00EBE7  2  D0 09              BNE   @snd_go
00EBE9  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00EBEC  2  20 45 D8           JSR   LAB_GTBY          ; instrument id → X
00EBEF  2  8E A6 B9           STX   AUDIO_INSTRUMENT
00EBF2  2               @snd_go
00EBF2  2  4C FB EC           JMP   audio_sound
00EBF5  2               
00EBF5  2               ; perform VOLUME level (0-15)               — set master volume
00EBF5  2               ; perform VOLUME level, voice (0-255, 1-6)  — set per-voice volume
00EBF5  2               
00EBF5  2               LAB_VOLUME
00EBF5  2  20 45 D8           JSR   LAB_GTBY          ; level → X
00EBF8  2  8E A4 B9           STX   AUDIO_VOLUME
00EBFB  2  9C A5 B9           STZ   AUDIO_VOICE       ; default voice = 0 (master)
00EBFE  2  20 C2 00           JSR   LAB_GBYT          ; peek next token
00EC01  2  C9 2C              CMP   #','
00EC03  2  D0 09              BNE   @vol_go
00EC05  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00EC08  2  20 45 D8           JSR   LAB_GTBY          ; voice → X
00EC0B  2  8E A5 B9           STX   AUDIO_VOICE
00EC0E  2               @vol_go
00EC0E  2  4C 00 ED           JMP   audio_volume
00EC11  2               
00EC11  2               ; perform INSTRUMENT id, waveform, a, d, s, r
00EC11  2               ; Waveform: $10=TRI, $20=SAW, $40=PULSE, $80=NOISE
00EC11  2               ; INSTRUMENT 1, $40, 0, 9, 0, 0
00EC11  2               
00EC11  2               LAB_ENVELOPE
00EC11  2  20 45 D8           JSR   LAB_GTBY          ; id → X
00EC14  2  8E A4 B9           STX   AUDIO_INST_ID
00EC17  2  20 09 CE           JSR   LAB_1C01          ; comma
00EC1A  2  20 45 D8           JSR   LAB_GTBY          ; waveform → X
00EC1D  2  8E A5 B9           STX   AUDIO_WAVEFORM
00EC20  2  20 09 CE           JSR   LAB_1C01          ; comma
00EC23  2  20 45 D8           JSR   LAB_GTBY          ; attack → X
00EC26  2  8E A6 B9           STX   AUDIO_ATTACK
00EC29  2  20 09 CE           JSR   LAB_1C01          ; comma
00EC2C  2  20 45 D8           JSR   LAB_GTBY          ; decay → X
00EC2F  2  8E A7 B9           STX   AUDIO_DECAY
00EC32  2  20 09 CE           JSR   LAB_1C01          ; comma
00EC35  2  20 45 D8           JSR   LAB_GTBY          ; sustain → X
00EC38  2  8E A8 B9           STX   AUDIO_SUSTAIN
00EC3B  2  20 09 CE           JSR   LAB_1C01          ; comma
00EC3E  2  20 45 D8           JSR   LAB_GTBY          ; release → X
00EC41  2  8E A9 B9           STX   AUDIO_RELEASE
00EC44  2  4C 05 ED           JMP   audio_instrument
00EC47  2               
00EC47  2               FIO_NO_STREAMING = 1
00EC47  2               ; Primary ROM is tight. NIC server entry points are library concerns, so omit
00EC47  2               ; those helper shims from the BASIC ROM build.
00EC47  2               NIC_SERVER_COMMANDS = 0
00EC47  2                     .include "lib/audio.s"
00EC47  3               ; Shared Nova audio/music helper routines.
00EC47  3               ;
00EC47  3               ; These routines are BASIC-agnostic.  They wrap the FIO audio commands behind
00EC47  3               ; named entry points so BASIC, assembly programs, and future runtimes share one
00EC47  3               ; audio ABI.
00EC47  3               
00EC47  3               .include "audio.inc"
00EC47  4               ; Shared Nova audio/music runtime interface.
00EC47  4               ;
00EC47  4               ; BASIC parses language syntax and loads the argument registers; assembly
00EC47  4               ; callers can use the same register layout directly.
00EC47  4               ;
00EC47  4               ; Sound effect:
00EC47  4               ;   AUDIO_NOTE       MIDI note
00EC47  4               ;   AUDIO_DURATION   duration in 60 Hz frames
00EC47  4               ;   AUDIO_INSTRUMENT instrument slot
00EC47  4               ;
00EC47  4               ; Volume:
00EC47  4               ;   AUDIO_VOLUME     volume level
00EC47  4               ;   AUDIO_VOICE      0=master, 1..14=voice volume
00EC47  4               ;
00EC47  4               ; Instrument:
00EC47  4               ;   AUDIO_INST_ID    instrument slot
00EC47  4               ;   AUDIO_WAVEFORM   SID waveform/control byte
00EC47  4               ;   AUDIO_ATTACK     attack
00EC47  4               ;   AUDIO_DECAY      decay
00EC47  4               ;   AUDIO_SUSTAIN    sustain
00EC47  4               ;   AUDIO_RELEASE    release
00EC47  4               ;
00EC47  4               ; Music sequence:
00EC47  4               ;   AUDIO_VOICE      voice number, 1..14
00EC47  4               ;   AUDIO_STRLEN     MML byte length
00EC47  4               ;   AUDIO_STRL/H     pointer to MML bytes
00EC47  4               ;
00EC47  4               ; File-backed commands:
00EC47  4               ;   FIO_NAME/FIO_NAMELEN hold the filename.  Call fio_copy_name first when
00EC47  4               ;   using a pointer-based filename.
00EC47  4               ;
00EC47  4               ; Routines return A=0 on success and A=1 on error unless documented as a raw
00EC47  4               ; status query.
00EC47  4               
00EC47  4               .ifndef AUDIO_INC_INCLUDED
00EC47  4               AUDIO_INC_INCLUDED = 1
00EC47  4               
00EC47  4               .include "fio.inc"
00EC47  5               ; Shared Nova File I/O helper declarations.
00EC47  5               ;
00EC47  5               ; Calling convention for pointer-based filename helpers:
00EC47  5               ;   FIO_ARG_NAMELEN      filename length, 1..63
00EC47  5               ;   FIO_ARG_NAMEPTR_L/H  CPU pointer to filename bytes
00EC47  5               ;
00EC47  5               ; Calling convention for XRAM streaming setup:
00EC47  5               ;   FIO_ARG_ADDRL/M/H    flat 24-bit XRAM address
00EC47  5               ;   FIO_ARG_LENL/H       transfer length; zero means full file for XLOAD
00EC47  5               ;
00EC47  5               ; Routines return A=0 on success and A=1 on error. Detailed status remains
00EC47  5               ; in the FIO_STATUS/FIO_ERRCODE hardware registers.
00EC47  5               
00EC47  5               .ifndef FIO_INC_INCLUDED
00EC47  5               FIO_INC_INCLUDED = 1
00EC47  5               
00EC47  5               .include "nova.inc"
00EC47  6               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
00EC47  6               ;
00EC47  6               ; This include is deliberately guarded per symbol so it can coexist with older
00EC47  6               ; source files that still define a subset of these names locally.
00EC47  6               
00EC47  6               .ifndef NOVA_INC_INCLUDED
00EC47  6               NOVA_INC_INCLUDED = 1
00EC47  6               
00EC47  6               ; Nova pseudo-register mailbox. These bytes are available to callers and
00EC47  6               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
00EC47  6               ; clobber them unless its documentation explicitly says otherwise; persistent
00EC47  6               ; library state must be allocated in a linker segment such as BSS/ZEROPAGE.
00EC47  6               .ifndef NVR0L
00EC47  6               NVR0L             = $20
00EC47  6               .endif
00EC47  6               .ifndef NVR0H
00EC47  6               NVR0H             = $21
00EC47  6               .endif
00EC47  6               .ifndef NVR1L
00EC47  6               NVR1L             = $22
00EC47  6               .endif
00EC47  6               .ifndef NVR1H
00EC47  6               NVR1H             = $23
00EC47  6               .endif
00EC47  6               .ifndef NVR2L
00EC47  6               NVR2L             = $24
00EC47  6               .endif
00EC47  6               .ifndef NVR2H
00EC47  6               NVR2H             = $25
00EC47  6               .endif
00EC47  6               .ifndef NVR3L
00EC47  6               NVR3L             = $26
00EC47  6               .endif
00EC47  6               .ifndef NVR3H
00EC47  6               NVR3H             = $27
00EC47  6               .endif
00EC47  6               .ifndef NVR4L
00EC47  6               NVR4L             = $28
00EC47  6               .endif
00EC47  6               .ifndef NVR4H
00EC47  6               NVR4H             = $29
00EC47  6               .endif
00EC47  6               .ifndef NVR5L
00EC47  6               NVR5L             = $2A
00EC47  6               .endif
00EC47  6               .ifndef NVR5H
00EC47  6               NVR5H             = $2B
00EC47  6               .endif
00EC47  6               .ifndef NVR6L
00EC47  6               NVR6L             = $2C
00EC47  6               .endif
00EC47  6               .ifndef NVR6H
00EC47  6               NVR6H             = $2D
00EC47  6               .endif
00EC47  6               .ifndef NVR7L
00EC47  6               NVR7L             = $2E
00EC47  6               .endif
00EC47  6               .ifndef NVR7H
00EC47  6               NVR7H             = $2F
00EC47  6               .endif
00EC47  6               
00EC47  6               ; BASIC SYS register bridge. SYS addr[,A[,X[,Y]]] loads A/X/Y from these
00EC47  6               ; bytes before jumping and stores A/X/Y back here when the routine returns.
00EC47  6               ; @label SYS.REGA
00EC47  6               ; @kind u8
00EC47  6               ; @symbol SYS_REGA
00EC47  6               ; @summary Returned A register from the most recent SYS call.
00EC47  6               .ifndef SYS_REGA
00EC47  6               SYS_REGA          = $E7
00EC47  6               .endif
00EC47  6               ; @label SYS.REGX
00EC47  6               ; @kind u8
00EC47  6               ; @symbol SYS_REGX
00EC47  6               ; @summary Returned X register from the most recent SYS call.
00EC47  6               .ifndef SYS_REGX
00EC47  6               SYS_REGX          = $E8
00EC47  6               .endif
00EC47  6               ; @label SYS.REGY
00EC47  6               ; @kind u8
00EC47  6               ; @symbol SYS_REGY
00EC47  6               ; @summary Returned Y register from the most recent SYS call.
00EC47  6               .ifndef SYS_REGY
00EC47  6               SYS_REGY          = $E9
00EC47  6               .endif
00EC47  6               
