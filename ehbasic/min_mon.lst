00E301  2               LAB_FBA2
00E301  2  A2 DC              LDX   #NmiBase          ; set pointer to NMI values
00E303  2  20 0C E3           JSR   LAB_CKIN          ; go check interrupt
00E306  2  A2 DF              LDX   #IrqBase          ; set pointer to IRQ values
