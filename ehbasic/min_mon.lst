00F0BE  2               ; perform MUSIC subcommand
00F0BE  2               ; MUSIC voice, "mml"
00F0BE  2               ; MUSIC PLAY | STOP | TEMPO bpm | LOOP ON|OFF | PRIORITY v1[,v2[,v3]]
00F0BE  2               
00F0BE  2               LAB_MUSIC
00F0BE  2  20 C2 00           JSR   LAB_GBYT          ; peek next byte (after MUSIC token consumed)
00F0C1  2  C9 50              CMP   #'P'
00F0C3  2  F0 0F              BEQ   @m_chk_p
00F0C5  2  C9 92              CMP   #TK_STOP           ; STOP is tokenized by BASIC
00F0C7  2  F0 1A              BEQ   @m_stop_tok
00F0C9  2  C9 54              CMP   #'T'
00F0CB  2  F0 1C              BEQ   @m_tempo
00F0CD  2  C9 9E              CMP   #TK_LOOP           ; LOOP is tokenized by BASIC
00F0CF  2  F0 2D              BEQ   @m_loop_tok
00F0D1  2                     ; Not a subcommand — must be a number (voice 1-6)
00F0D1  2  4C 50 F1           JMP   @m_seq
00F0D4  2               
00F0D4  2               ; --- MUSIC PLAY or PRIORITY ---
00F0D4  2               @m_chk_p
00F0D4  2                     ; Consume P, then check next char to distinguish PLAY vs PRIORITY
00F0D4  2  20 BC 00           JSR   LAB_IGBY          ; consume P, A = next char
00F0D7  2  C9 52              CMP   #'R'              ; PRIORITY has R after P
00F0D9  2  F0 47              BEQ   @m_priority
00F0DB  2                     ; else PLAY — consume remaining "LAY" (3 chars, P already consumed)
00F0DB  2  A2 03              LDX   #3
00F0DD  2  20 B7 F0           JSR   LAB_SKIPX          ; LAY
00F0E0  2  4C 32 EE           JMP   audio_music_play
00F0E3  2               
00F0E3  2               ; --- MUSIC STOP (TK_STOP is a single token byte) ---
00F0E3  2               @m_stop_tok
00F0E3  2  20 BC 00           JSR   LAB_IGBY          ; consume TK_STOP token
00F0E6  2  4C 3B EE           JMP   audio_music_stop
00F0E9  2               
00F0E9  2               ; --- MUSIC TEMPO bpm ---
00F0E9  2               @m_tempo
00F0E9  2  A2 05              LDX   #5
00F0EB  2  20 B7 F0           JSR   LAB_SKIPX          ; TEMPO
00F0EE  2  20 9F D8           JSR   LAB_GTWRD         ; bpm as 16-bit → FAC1_3(lo), FAC1_2(hi)
00F0F1  2  A5 AF              LDA   FAC1_3
00F0F3  2  8D A4 B9           STA   FIO_SRCL
00F0F6  2  A5 AE              LDA   FAC1_2
00F0F8  2  8D A5 B9           STA   FIO_SRCH
00F0FB  2  4C 40 EE           JMP   audio_music_tempo
00F0FE  2               
00F0FE  2               ; --- MUSIC LOOP ON|OFF (TK_LOOP is a single token byte) ---
00F0FE  2               @m_loop_tok
00F0FE  2  20 BC 00           JSR   LAB_IGBY          ; consume TK_LOOP token
00F101  2  20 C2 00           JSR   LAB_GBYT          ; skip spaces, get TK_ON or TK_OFF
00F104  2  C9 93              CMP   #TK_ON
00F106  2  F0 07              BEQ   @m_loop_on
00F108  2  C9 CB              CMP   #TK_OFF
00F10A  2  F0 0D              BEQ   @m_loop_off
00F10C  2  4C EA C5           JMP   LAB_15D9          ; syntax error
00F10F  2               @m_loop_on
00F10F  2  20 BC 00           JSR   LAB_IGBY          ; consume ON token
00F112  2  A9 01              LDA   #$01
00F114  2  8D A4 B9           STA   FIO_SRCL
00F117  2  80 06              BRA   @m_loop_go
00F119  2               @m_loop_off
00F119  2  20 BC 00           JSR   LAB_IGBY          ; consume OFF token
00F11C  2  9C A4 B9           STZ   FIO_SRCL
00F11F  2               @m_loop_go
00F11F  2  4C 45 EE           JMP   audio_music_loop
00F122  2               
00F122  2               ; --- MUSIC PRIORITY v1[,v2[,v3[,v4[,v5[,v6]]]]] ---
00F122  2               @m_priority
00F122  2                     ; P already consumed by @m_chk_p.  Skip remaining keyword bytes.
00F122  2                     ; "RIORITY" is tokenized as R,I,TK_OR,I,T,Y (OR becomes a token),
00F122  2                     ; so we scan dynamically instead of using a fixed IGBY count.
00F122  2               @m_pri_skip
00F122  2  20 BC 00           JSR   LAB_IGBY          ; advance past current byte
00F125  2  C9 41              CMP   #'A'              ; letters ($41-$5A) and tokens ($80+) are >= 'A'
00F127  2  B0 F9              BCS   @m_pri_skip       ; keep skipping keyword chars and tokens
00F129  2                     ; A < 'A': hit a space or digit — keyword is consumed.
00F129  2                     ; pointer is at the space/digit; LAB_GTBY calls GBYT which skips spaces.
00F129  2                     ; Clear all 6 voice slots
00F129  2  A9 00              LDA   #$00
00F12B  2  A0 05              LDY   #$05
00F12D  2               @m_pri_clr
00F12D  2  99 A4 B9           STA   FIO_SRCL,Y
00F130  2  88                 DEY
00F131  2  10 FA              BPL   @m_pri_clr
00F133  2                     ; Parse up to 6 comma-separated voice values
00F133  2  A0 00              LDY   #$00              ; slot index
00F135  2               @m_pri_nxt
00F135  2  20 B1 D8           JSR   LAB_GTBY          ; get voice number → X
00F138  2  8A                 TXA
00F139  2  99 A4 B9           STA   FIO_SRCL,Y        ; store to slot
00F13C  2  C8                 INY
00F13D  2  C0 06              CPY   #$06
00F13F  2  B0 0C              BCS   @m_pri_go         ; all 6 parsed
