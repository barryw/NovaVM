00ED4D  3               .include "fio.s"
00ED4D  4               ; Shared Nova File I/O helper routines.
00ED4D  4               ;
00ED4D  4               ; This file is BASIC-agnostic. BASIC is still responsible for parsing language
00ED4D  4               ; expressions; assembly callers can load the FIO_ARG_* pseudo-registers and use
00ED4D  4               ; these helpers directly.
00ED4D  4               
00ED4D  4               .include "fio.inc"
00ED4D  5               ; Shared Nova File I/O helper declarations.
00ED4D  5               ;
00ED4D  5               ; Calling convention for pointer-based filename helpers:
00ED4D  5               ;   FIO_ARG_NAMELEN      filename length, 1..63
00ED4D  5               ;   FIO_ARG_NAMEPTR_L/H  CPU pointer to filename bytes
00ED4D  5               ;
00ED4D  5               ; Calling convention for XRAM streaming setup:
00ED4D  5               ;   FIO_ARG_ADDRL/M/H    flat 24-bit XRAM address
00ED4D  5               ;   FIO_ARG_LENL/H       transfer length; zero means full file for XLOAD
00ED4D  5               ;
00ED4D  5               ; Routines return A=0 on success and A=1 on error. Detailed status remains
00ED4D  5               ; in the FIO_STATUS/FIO_ERRCODE hardware registers.
00ED4D  5               
00ED4D  5               .ifndef FIO_INC_INCLUDED
00ED4D  5               FIO_INC_INCLUDED = 1
00ED4D  5               
00ED4D  5               .include "nova.inc"
00ED4D  5               
00ED4D  5               FIO_RESULT_OK    = $00
00ED4D  5               FIO_RESULT_ERROR = $01
00ED4D  5               FIO_NAME_LIMIT   = $3F
00ED4D  5               
00ED4D  5               ; Match the XRAM streaming ABI so xram_xload/xram_xsave can call directly.
00ED4D  5               ; @label FIO.ARG_ADDRL
00ED4D  5               ; @kind zp
00ED4D  5               ; @symbol FIO_ARG_ADDRL
00ED4D  5               ; @summary Low byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00ED4D  5               FIO_ARG_ADDRL     = NVR0L
00ED4D  5               ; @label FIO.ARG_ADDRM
00ED4D  5               ; @kind zp
00ED4D  5               ; @symbol FIO_ARG_ADDRM
00ED4D  5               ; @summary Middle byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00ED4D  5               FIO_ARG_ADDRM     = NVR0H
00ED4D  5               ; @label FIO.ARG_ADDRH
00ED4D  5               ; @kind zp
00ED4D  5               ; @symbol FIO_ARG_ADDRH
00ED4D  5               ; @summary High byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00ED4D  5               FIO_ARG_ADDRH     = NVR1L
00ED4D  5               ; @label FIO.ARG_LENL
00ED4D  5               ; @kind zp
00ED4D  5               ; @symbol FIO_ARG_LENL
00ED4D  5               ; @summary Low byte of transfer length for FIO.PREPARE_XRAM_TRANSFER.
00ED4D  5               FIO_ARG_LENL      = NVR3L
00ED4D  5               ; @label FIO.ARG_LENH
00ED4D  5               ; @kind zp
00ED4D  5               ; @symbol FIO_ARG_LENH
00ED4D  5               ; @summary High byte of transfer length for FIO.PREPARE_XRAM_TRANSFER.
00ED4D  5               FIO_ARG_LENH      = NVR3H
00ED4D  5               ; @label FIO.ARG_NAMELEN
00ED4D  5               ; @kind zp
00ED4D  5               ; @symbol FIO_ARG_NAMELEN
00ED4D  5               ; @summary Filename length for FIO.COPY_NAME.
00ED4D  5               FIO_ARG_NAMELEN   = NVR4L
00ED4D  5               ; @label FIO.ARG_NAMEPTR_L
00ED4D  5               ; @kind zp
00ED4D  5               ; @symbol FIO_ARG_NAMEPTR_L
00ED4D  5               ; @summary Low byte of filename pointer for FIO.COPY_NAME.
00ED4D  5               FIO_ARG_NAMEPTR_L = NVR4H
00ED4D  5               ; @label FIO.ARG_NAMEPTR_H
00ED4D  5               ; @kind zp
00ED4D  5               ; @symbol FIO_ARG_NAMEPTR_H
00ED4D  5               ; @summary High byte of filename pointer for FIO.COPY_NAME.
00ED4D  5               FIO_ARG_NAMEPTR_H = NVR5L
00ED4D  5               
00ED4D  5               .endif
00ED4D  5               
00ED4D  4               
00ED4D  4               .ifndef FIO_IMPLEMENTATION_INCLUDED
00ED4D  4               FIO_IMPLEMENTATION_INCLUDED = 1
00ED4D  4               
00ED4D  4                     .segment "CODE"
00ED4D  4               
00ED4D  4                     .export fio_issue
00ED4D  4                     .export fio_check
00ED4D  4                     .export fio_exec
00ED4D  4                     .export fio_copy_name
00ED4D  4                     .export fio_clear_error
00ED4D  4                     .export fio_set_io_error
00ED4D  4                     .export fio_save
00ED4D  4                     .export fio_load
00ED4D  4                     .export fio_dir_open
00ED4D  4                     .export fio_dir_read
00ED4D  4                     .export fio_delete
00ED4D  4                     .export fio_gsave
00ED4D  4                     .export fio_gload
00ED4D  4                     .export fio_cd
00ED4D  4                     .export fio_mkdir
00ED4D  4                     .export fio_rmdir
00ED4D  4                     .export fio_pwd
00ED4D  4                     .export fio_load_runtime
00ED4D  4                     .export fio_rng
00ED4D  4               .ifndef FIO_NO_STREAMING
00ED4D  4                     .export fio_run
00ED4D  4                     .export fio_prepare_xram_transfer
00ED4D  4               .endif
00ED4D  4               
00ED4D  4               ; Input: A = FIO command. Does not check completion/status.
00ED4D  4               ; @label FIO.ISSUE
00ED4D  4               ; @kind routine
00ED4D  4               ; @symbol fio_issue
00ED4D  4               ; @summary Issue a raw FIO command without waiting for completion.
00ED4D  4               ; @in A: FIO command byte.
00ED4D  4               fio_issue:
00ED4D  4  8D A0 B9           STA   FIO_CMD
00ED50  4  60                 RTS
00ED51  4               
00ED51  4               ; Check current FIO_STATUS.
00ED51  4               ; @label FIO.CHECK
00ED51  4               ; @kind routine
00ED51  4               ; @symbol fio_check
00ED51  4               ; @summary Convert the current FIO status register to the shared A=0/1 result.
00ED51  4               ; @out A: 0 on success, 1 on error.
00ED51  4               fio_check:
00ED51  4  AD A1 B9           LDA   FIO_STATUS
00ED54  4  C9 02              CMP   #FIO_OK
00ED56  4  F0 03              BEQ   @ok
00ED58  4  A9 01              LDA   #FIO_RESULT_ERROR
00ED5A  4  60                 RTS
00ED5B  4               @ok:
00ED5B  4  A9 00              LDA   #FIO_RESULT_OK
00ED5D  4  60                 RTS
00ED5E  4               
00ED5E  4               ; Input: A = FIO command. Issue, wait for completion, and check status.
00ED5E  4               ; @label FIO.EXEC
00ED5E  4               ; @kind routine
00ED5E  4               ; @symbol fio_exec
00ED5E  4               ; @summary Issue an FIO command, wait for completion, and return A=0/1 status.
00ED5E  4               ; @in A: FIO command byte.
00ED5E  4               ; @out A: 0 on success, 1 on error.
00ED5E  4               fio_exec:
00ED5E  4  48                 PHA
00ED5F  4  9C A1 B9           STZ   FIO_STATUS
00ED62  4  9C A2 B9           STZ   FIO_ERRCODE
00ED65  4  68                 PLA
00ED66  4  8D A0 B9           STA   FIO_CMD
00ED69  4               @wait:
00ED69  4  AD A1 B9           LDA   FIO_STATUS
00ED6C  4  F0 FB              BEQ   @wait
00ED6E  4  4C 51 ED           JMP   fio_check
00ED71  4               
00ED71  4               ; Clear the host-visible FIO error/status latch.
00ED71  4               ; @label FIO.CLEAR_ERROR
00ED71  4               ; @kind routine
00ED71  4               ; @symbol fio_clear_error
00ED71  4               ; @summary Clear the host-visible FIO status and error latch.
00ED71  4               ; @out A: 0 on success.
00ED71  4               fio_clear_error:
00ED71  4  A9 00              LDA   #FIO_ERR_NONE
00ED73  4  8D A2 B9           STA   FIO_ERRCODE
00ED76  4  A9 02              LDA   #FIO_STATUS_OK
00ED78  4  8D A1 B9           STA   FIO_STATUS
00ED7B  4  A9 27              LDA   #FIO_CMD_CLEARERR
00ED7D  4  8D A0 B9           STA   FIO_CMD
00ED80  4  A9 00              LDA   #FIO_RESULT_OK
00ED82  4  60                 RTS
00ED83  4               
00ED83  4               ; Mark an argument/host I/O error in the hardware status registers.
00ED83  4               ; @label FIO.SET_IO_ERROR
00ED83  4               ; @kind routine
00ED83  4               ; @symbol fio_set_io_error
00ED83  4               ; @summary Set FIO_STATUS/FIO_ERRCODE to the shared I/O error state.
00ED83  4               ; @out A: 1 on error.
00ED83  4               fio_set_io_error:
00ED83  4  A9 03              LDA   #FIO_STATUS_ERROR
00ED85  4  8D A1 B9           STA   FIO_STATUS
00ED88  4  A9 02              LDA   #FIO_ERR_IO
00ED8A  4  8D A2 B9           STA   FIO_ERRCODE
00ED8D  4  A9 01              LDA   #FIO_RESULT_ERROR
00ED8F  4  60                 RTS
00ED90  4               
00ED90  4               ; Copy filename from FIO_ARG_NAMEPTR_L/H into FIO_NAME.
00ED90  4               ; @label FIO.COPY_NAME
00ED90  4               ; @kind routine
00ED90  4               ; @symbol fio_copy_name
00ED90  4               ; @summary Copy a pointer-based filename into FIO.NAME/FIO.NAMELEN.
00ED90  4               ; @requires FIO_ARG_NAMELEN FIO_ARG_NAMEPTR_L FIO_ARG_NAMEPTR_H
00ED90  4               ; @out A: 0 on success, 1 on invalid name.
00ED90  4               fio_copy_name:
00ED90  4  A5 28              LDA   FIO_ARG_NAMELEN
00ED92  4  F0 16              BEQ   @bad
00ED94  4  C9 40              CMP   #FIO_NAME_LIMIT + 1
00ED96  4  B0 12              BCS   @bad
00ED98  4  8D A3 B9           STA   FIO_NAMELEN
00ED9B  4  AA                 TAX
00ED9C  4  A0 00              LDY   #$00
00ED9E  4               @copy:
00ED9E  4  B1 29              LDA   (FIO_ARG_NAMEPTR_L),Y
00EDA0  4  99 B0 B9           STA   FIO_NAME,Y
00EDA3  4  C8                 INY
00EDA4  4  CA                 DEX
00EDA5  4  D0 F7              BNE   @copy
00EDA7  4  A9 00              LDA   #FIO_RESULT_OK
00EDA9  4  60                 RTS
00EDAA  4               @bad:
00EDAA  4  4C 83 ED           JMP   fio_set_io_error
00EDAD  4               
00EDAD  4               ; @label FIO.SAVE
00EDAD  4               ; @kind routine
00EDAD  4               ; @symbol fio_save
