00F17D  2               LAB_RESET
00F17D  2  A9 1F              LDA   #VCMD_SYSRESET
00F17F  2  8D 10 A0           STA   VGC_CMD            ; trigger hardware reset
00F182  2  6C FC FF           JMP   ($FFFC)            ; jump through reset vector
