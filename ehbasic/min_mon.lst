00E2DD  2  C9 02              CMP   #$02              ; compare with max+1
00E2DF  2  90 E6              BCC   LAB_NXCH          ; branch exit if < 2
00E2E1  2               
00E2E1  2               LAB_EXCH
00E2E1  2  4C 24 DE           JMP   LAB_28F6          ; evaluate -ve flag and return
00E2E4  2               
00E2E4  2               ; ctrl-c check routine. includes limited "life" byte save for INGET routine
00E2E4  2               ; now also the code that checks to see if an interrupt has occurred
00E2E4  2               
00E2E4  2               CTRLC
00E2E4  2  AD 00 02           LDA   ccflag            ; get [CTRL-C] check flag
00E2E7  2  D0 18              BNE   LAB_FBA2          ; exit if inhibited
00E2E9  2               
00E2E9  2  20 AC E7           JSR   V_INPT            ; scan input device
00E2EC  2  90 0B              BCC   LAB_FBA0          ; exit if buffer empty
00E2EE  2               
00E2EE  2  8D 01 02           STA   ccbyte            ; save received byte
00E2F1  2  A2 20              LDX   #$20              ; "life" timer for bytes
00E2F3  2  8E 02 02           STX   ccnull            ; set countdown
00E2F6  2  4C 37 C7           JMP   LAB_1636          ; return to BASIC
00E2F9  2               
