00EFA7  2  9C A4 B9           STZ   FIO_SRCL          ; no explicit mapping; auto-select channels
00EFAA  2  20 18 ED           JSR   audio_midplay
00EFAD  2  D0 01              BNE   @mp_err
00EFAF  2  60                 RTS
00EFB0  2               @mp_err
00EFB0  2  4C 7A F1           JMP   LAB_FIO_ERRHND
