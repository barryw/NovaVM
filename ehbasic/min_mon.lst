00EC47  4               AUDIO_INST_ID    = FIO_SRCL
00EC47  4               ; @label AUDIO.WAVEFORM
00EC47  4               ; @kind u8
00EC47  4               ; @symbol AUDIO_WAVEFORM
00EC47  4               ; @summary SID waveform/control byte for AUDIO.INSTRUMENT_SET.
00EC47  4               AUDIO_WAVEFORM   = FIO_SRCH
00EC47  4               ; @label AUDIO.ATTACK
00EC47  4               ; @kind u8
00EC47  4               ; @symbol AUDIO_ATTACK
00EC47  4               ; @summary Attack nibble for AUDIO.INSTRUMENT_SET.
00EC47  4               AUDIO_ATTACK     = FIO_ENDL
00EC47  4               ; @label AUDIO.DECAY
00EC47  4               ; @kind u8
00EC47  4               ; @symbol AUDIO_DECAY
00EC47  4               ; @summary Decay nibble for AUDIO.INSTRUMENT_SET.
00EC47  4               AUDIO_DECAY      = FIO_ENDH
00EC47  4               ; @label AUDIO.SUSTAIN
00EC47  4               ; @kind u8
00EC47  4               ; @symbol AUDIO_SUSTAIN
00EC47  4               ; @summary Sustain nibble for AUDIO.INSTRUMENT_SET.
00EC47  4               AUDIO_SUSTAIN    = FIO_SIZEL
00EC47  4               ; @label AUDIO.RELEASE
00EC47  4               ; @kind u8
00EC47  4               ; @symbol AUDIO_RELEASE
00EC47  4               ; @summary Release nibble for AUDIO.INSTRUMENT_SET.
00EC47  4               AUDIO_RELEASE    = FIO_SIZEH
00EC47  4               
00EC47  4               ; @label AUDIO.STRL
00EC47  4               ; @kind u8
00EC47  4               ; @symbol AUDIO_STRL
00EC47  4               ; @summary Low byte of MML string pointer for AUDIO.MUSIC_SEQUENCE.
00EC47  4               AUDIO_STRL       = FIO_ENDL
00EC47  4               ; @label AUDIO.STRH
00EC47  4               ; @kind u8
00EC47  4               ; @symbol AUDIO_STRH
00EC47  4               ; @summary High byte of MML string pointer for AUDIO.MUSIC_SEQUENCE.
00EC47  4               AUDIO_STRH       = FIO_ENDH
00EC47  4               ; @label AUDIO.STRLEN
00EC47  4               ; @kind u8
00EC47  4               ; @symbol AUDIO_STRLEN
00EC47  4               ; @summary MML string length for AUDIO.MUSIC_SEQUENCE.
00EC47  4               AUDIO_STRLEN     = FIO_NAMELEN
00EC47  4               
00EC47  4               .endif
00EC47  4               
