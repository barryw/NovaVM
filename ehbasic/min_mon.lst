00E28F  2  8A                 TXA                     ; get byte back
00E290  2  4A                 LSR                     ; /2  shift high nibble to low nibble
00E291  2  4A                 LSR                     ; /4
00E292  2  4A                 LSR                     ; /8
00E293  2  4A                 LSR                     ; /16
00E294  2               LAB_AL2X
00E294  2  C9 0A              CMP   #$0A              ; set carry for +1 if >9
00E296  2               ; *** begin disable decimal mode patch ***
00E296  2               ; *** insert
00E296  2  90 02              BCC   LAB_AL20          ; skip adjust if <= 9
00E298  2  69 06              ADC   #$06              ; adjust for A to F
00E29A  2               LAB_AL20
00E29A  2               ; *** end   disable decimal mode patch ***
00E29A  2  69 30              ADC   #'0'              ; add ASCII "0"
00E29C  2  91 AD              STA   (str_pl),Y        ; save to temp string
00E29E  2  88                 DEY                     ; decrement counter
00E29F  2  60                 RTS
00E2A0  2               
00E2A0  2               LAB_NLTO
00E2A0  2  85 AC              STA   FAC1_e            ; save FAC1 exponent
