00E834  3                     .export vgc_rect
00E834  3                     .export vgc_fill
00E834  3                     .export vgc_paint
00E834  3               .endif
00E834  3               
00E834  3               ; Input: A = VGC command. Does not wait for completion.
00E834  3               ; @label VGC.COMMAND
00E834  3               ; @kind routine
00E834  3               ; @symbol vgc_cmd
00E834  3               ; @summary Issue a raw VGC command without waiting for completion.
00E834  3               ; @in A: VGC command byte.
00E834  3               vgc_cmd:
00E834  3  8D 10 A0           STA   VGC_CMD
00E837  3  60                 RTS
00E838  3               
00E838  3               ; Wait until the command busy bit clears.
00E838  3               ; @label VGC.WAIT_COMMAND
00E838  3               ; @kind routine
00E838  3               ; @symbol vgc_wait_cmd
00E838  3               ; @summary Wait for the active VGC command to complete.
00E838  3               vgc_wait_cmd:
00E838  3               @wait:
00E838  3  AD 10 A0           LDA   VGC_CMD
00E83B  3  29 01              AND   #$01
00E83D  3  D0 F9              BNE   @wait
00E83F  3  60                 RTS
00E840  3               
00E840  3               ; Input: A = VGC command. Issue and wait for completion.
00E840  3               .ifndef VGC_NO_EXEC
00E840  3               ; @label VGC.EXEC
00E840  3               ; @kind routine
00E840  3               ; @symbol vgc_exec
00E840  3               ; @summary Issue a raw VGC command and wait for completion.
00E840  3               ; @in A: VGC command byte.
00E840  3               vgc_exec:
00E840  3                     JSR   vgc_cmd
00E840  3                     JMP   vgc_wait_cmd
00E840  3               .endif
00E840  3               
00E840  3               ; Wait for the next frame counter tick.
00E840  3               ; @label VGC.VSYNC
00E840  3               ; @kind routine
00E840  3               ; @symbol vgc_vsync
00E840  3               ; @summary Wait until the VGC frame counter advances.
00E840  3               ; @out A: Last observed frame counter value.
00E840  3               vgc_vsync:
00E840  3  AD 08 A0           LDA   VGC_FRAME
00E843  3               @wait:
00E843  3  CD 08 A0           CMP   VGC_FRAME
00E846  3  F0 FB              BEQ   @wait
00E848  3  60                 RTS
00E849  3               
00E849  3               ; @label VGC.CLS
00E849  3               ; @kind routine
00E849  3               ; @symbol vgc_cls
00E849  3               ; @summary Clear the text screen through the VGC character output register.
00E849  3               vgc_cls:
00E849  3  A9 0C              LDA   #$0C
00E84B  3  8D 0E A0           STA   VGC_CHAROUT
00E84E  3  60                 RTS
00E84F  3               
00E84F  3               ; @label VGC.SET_FG
00E84F  3               ; @kind routine
00E84F  3               ; @symbol vgc_set_fg
00E84F  3               ; @summary Set the current text foreground colour.
00E84F  3               ; @in X: Foreground colour byte.
00E84F  3               vgc_set_fg:
00E84F  3  8E 02 A0           STX   VGC_FGCOL
00E852  3  60                 RTS
00E853  3               
00E853  3               ; @label VGC.SET_BG
00E853  3               ; @kind routine
00E853  3               ; @symbol vgc_set_bg
00E853  3               ; @summary Set the current text background colour.
00E853  3               ; @in X: Background colour byte.
00E853  3               vgc_set_bg:
00E853  3  8E 01 A0           STX   VGC_BGCOL
00E856  3  60                 RTS
00E857  3               
00E857  3               ; @label VGC.SET_BORDER
00E857  3               ; @kind routine
00E857  3               ; @symbol vgc_set_border
00E857  3               ; @summary Set the VGC border colour.
00E857  3               ; @in X: Border colour byte.
00E857  3               vgc_set_border:
00E857  3  8E 0D A0           STX   VGC_BORDER
00E85A  3  60                 RTS
00E85B  3               
00E85B  3               ; @label VGC.DISPLAY_ON
00E85B  3               ; @kind routine
00E85B  3               ; @symbol vgc_display_on
00E85B  3               ; @summary Restore full VGC output brightness.
00E85B  3               vgc_display_on:
00E85B  3  A9 0F              LDA   #$0F
00E85D  3  8D E5 A0           STA   VGC_DIMMER
00E860  3  60                 RTS
00E861  3               
00E861  3               ; @label VGC.DISPLAY_OFF
00E861  3               ; @kind routine
00E861  3               ; @symbol vgc_display_off
00E861  3               ; @summary Blank VGC output while keeping video timing active.
00E861  3               vgc_display_off:
00E861  3  A9 00              LDA   #$00
00E863  3  8D E5 A0           STA   VGC_DIMMER
00E866  3  60                 RTS
00E867  3               
00E867  3               ; @label VGC.LOCATE
00E867  3               ; @kind routine
00E867  3               ; @symbol vgc_locate
00E867  3               ; @summary Set the text cursor position from VGC.P0/VGC.P1.
00E867  3               ; @in VGC_P0: Cursor X column.
00E867  3               ; @in VGC_P1: Cursor Y row.
00E867  3               vgc_locate:
00E867  3  AD 11 A0           LDA   VGC_P0
00E86A  3  8D 03 A0           STA   VGC_CURSX
00E86D  3  AD 12 A0           LDA   VGC_P1
00E870  3  8D 04 A0           STA   VGC_CURSY
00E873  3  60                 RTS
00E874  3               
00E874  3               ; @label VGC.SET_MODE
00E874  3               ; @kind routine
00E874  3               ; @symbol vgc_set_mode
00E874  3               ; @summary Set the active VGC graphics/text mode.
00E874  3               ; @in X: Mode byte.
00E874  3               vgc_set_mode:
00E874  3  8E 00 A0           STX   VGC_MODE
00E877  3  60                 RTS
00E878  3               
00E878  3               ; @label VGC.SET_FONT
00E878  3               ; @kind routine
00E878  3               ; @symbol vgc_set_font
00E878  3               ; @summary Select the active text font slot.
00E878  3               ; @in X: Font slot, 0..7.
00E878  3               vgc_set_font:
00E878  3  8E 07 A0           STX   VGC_FONT
00E87B  3  60                 RTS
00E87C  3               
00E87C  3               ; @label VGC.MEM_READ
00E87C  3               ; @kind routine
00E87C  3               ; @symbol vgc_mem_read
00E87C  3               ; @summary Read one byte from VGC memory using VGC.P0..VGC.P4.
00E87C  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P4
00E87C  3               ; @out VGC_P3: Read byte.
00E87C  3               vgc_mem_read:
00E87C  3  A9 19              LDA   #VCMD_MEMREAD
00E87E  3  2C                 .byte $2C
00E87F  3               
00E87F  3               ; @label VGC.MEM_WRITE
00E87F  3               ; @kind routine
00E87F  3               ; @symbol vgc_mem_write
00E87F  3               ; @summary Write one byte to VGC memory using VGC.P0..VGC.P4.
00E87F  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4
00E87F  3               vgc_mem_write:
00E87F  3  A9 1A              LDA   #VCMD_MEMWRITE
00E881  3  8D 10 A0           STA   VGC_CMD
00E884  3  4C 38 E8           JMP   vgc_wait_cmd
00E887  3               
00E887  3               ; Enable reverse text by swapping the current foreground/background colours.
00E887  3               ; @label VGC.REVERSE
00E887  3               ; @kind routine
00E887  3               ; @symbol vgc_reverse_default
00E887  3               ; @summary Enable reverse text using the current foreground/background colours.
00E887  3               vgc_reverse_default:
00E887  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E88A  3  29 FC              AND   #$FC
00E88C  3  09 01              ORA   #VTXT_REV
00E88E  3  8D E6 A0           STA   VGC_TXTFLAGS
00E891  3  60                 RTS
00E892  3               
00E892  3               ; Input: A = packed reverse attribute, low nibble fg and high nibble bg.
00E892  3               ; @label VGC.REVERSE_EXPLICIT
00E892  3               ; @kind routine
00E892  3               ; @symbol vgc_reverse_explicit
00E892  3               ; @summary Enable reverse text with explicit packed foreground/background colours.
00E892  3               ; @in A: Packed reverse attribute, low nibble foreground and high nibble background.
00E892  3               vgc_reverse_explicit:
00E892  3  8D E7 A0           STA   VGC_TXTREVATTR
00E895  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E898  3  29 FC              AND   #$FC
00E89A  3  09 03              ORA   #(VTXT_REV | VTXT_REVEX)
00E89C  3  8D E6 A0           STA   VGC_TXTFLAGS
00E89F  3  60                 RTS
00E8A0  3               
00E8A0  3               ; @label VGC.REVERSE_OFF
00E8A0  3               ; @kind routine
00E8A0  3               ; @symbol vgc_reverse_off
00E8A0  3               ; @summary Disable reverse text.
00E8A0  3               vgc_reverse_off:
00E8A0  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E8A3  3  29 FC              AND   #$FC
00E8A5  3  8D E6 A0           STA   VGC_TXTFLAGS
00E8A8  3  60                 RTS
00E8A9  3               
00E8A9  3               ; @label VGC.FLASH_ON
00E8A9  3               ; @kind routine
00E8A9  3               ; @symbol vgc_flash_on
00E8A9  3               ; @summary Enable flashing text.
00E8A9  3               vgc_flash_on:
00E8A9  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E8AC  3  09 04              ORA   #VTXT_FLASH
00E8AE  3  8D E6 A0           STA   VGC_TXTFLAGS
00E8B1  3  60                 RTS
00E8B2  3               
00E8B2  3               ; @label VGC.FLASH_OFF
00E8B2  3               ; @kind routine
00E8B2  3               ; @symbol vgc_flash_off
00E8B2  3               ; @summary Disable flashing text.
00E8B2  3               vgc_flash_off:
00E8B2  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E8B5  3  29 FB              AND   #$FB
00E8B7  3  8D E6 A0           STA   VGC_TXTFLAGS
00E8BA  3  60                 RTS
00E8BB  3               
00E8BB  3               .ifndef VGC_NO_PRIMITIVES
00E8BB  3               ; @label VGC.GCLS
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_gcls
00E8BB  3               ; @summary Issue the VGC graphics clear command.
00E8BB  3               vgc_gcls:
00E8BB  3                     LDA   #VCMD_GCLS
00E8BB  3                     JMP   vgc_cmd
00E8BB  3               
00E8BB  3               ; @label VGC.GCOLOR
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_gcolor
00E8BB  3               ; @summary Issue the VGC graphics colour command using VGC.P0/P1.
00E8BB  3               ; @requires VGC_P0 VGC_P1
00E8BB  3               vgc_gcolor:
00E8BB  3                     LDA   #VCMD_GCOLOR
00E8BB  3                     JMP   vgc_cmd
00E8BB  3               
00E8BB  3               ; @label VGC.PLOT
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_plot
00E8BB  3               ; @summary Issue the VGC plot command using VGC.P0..VGC.P3.
00E8BB  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E8BB  3               vgc_plot:
00E8BB  3                     LDA   #VCMD_PLOT
00E8BB  3                     JMP   vgc_cmd
00E8BB  3               
00E8BB  3               ; @label VGC.UNPLOT
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_unplot
00E8BB  3               ; @summary Issue the VGC unplot command using VGC.P0..VGC.P3.
00E8BB  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E8BB  3               vgc_unplot:
00E8BB  3                     LDA   #VCMD_UNPLOT
00E8BB  3                     JMP   vgc_cmd
00E8BB  3               
00E8BB  3               ; @label VGC.LINE
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_line
00E8BB  3               ; @summary Issue the VGC line command using VGC.P0..VGC.P7.
00E8BB  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E8BB  3               vgc_line:
00E8BB  3                     LDA   #VCMD_LINE
00E8BB  3                     JMP   vgc_cmd
00E8BB  3               
00E8BB  3               ; @label VGC.CIRCLE
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_circle
00E8BB  3               ; @summary Issue the VGC circle/ellipse command using VGC.P0..VGC.P7.
00E8BB  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E8BB  3               vgc_circle:
00E8BB  3                     LDA   #VCMD_CIRCLE
00E8BB  3                     JMP   vgc_cmd
00E8BB  3               
00E8BB  3               ; @label VGC.GTEXT
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_gtext
00E8BB  3               ; @summary Issue the VGC graphics text command using VGC.P0..VGC.P5 and FIO.NAME.
00E8BB  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 FIO_NAME FIO_NAMELEN
00E8BB  3               vgc_gtext:
00E8BB  3                     LDA   #VCMD_GTEXT
00E8BB  3                     JMP   vgc_cmd
00E8BB  3               
00E8BB  3               ; @label VGC.RECT
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_rect
00E8BB  3               ; @summary Issue the VGC rectangle command using VGC.P0..VGC.P7.
00E8BB  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E8BB  3               vgc_rect:
00E8BB  3                     LDA   #VCMD_RECT
00E8BB  3                     JMP   vgc_cmd
00E8BB  3               
00E8BB  3               ; @label VGC.FILL
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_fill
00E8BB  3               ; @summary Issue the VGC filled rectangle command using VGC.P0..VGC.P7.
00E8BB  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E8BB  3               vgc_fill:
00E8BB  3                     LDA   #VCMD_FILL
00E8BB  3                     JMP   vgc_cmd
00E8BB  3               
00E8BB  3               ; @label VGC.PAINT
00E8BB  3               ; @kind routine
00E8BB  3               ; @symbol vgc_paint
00E8BB  3               ; @summary Issue the VGC paint command using VGC.P0..VGC.P3.
00E8BB  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E8BB  3               vgc_paint:
00E8BB  3                     LDA   #VCMD_PAINT
