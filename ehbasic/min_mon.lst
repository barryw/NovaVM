00EDE1  4  4C 5E ED           JMP   fio_exec
00EDE4  4               
00EDE4  4               ; Load a 16K runtime ROM image into the primary $C000 bank.
00EDE4  4               ; This routine is meant for RAM-resident launchers. The host overwrites the
00EDE4  4               ; primary ROM bank while the command is in progress.
00EDE4  4               ; @label FIO.LOAD_RUNTIME
00EDE4  4               ; @kind routine
00EDE4  4               ; @symbol fio_load_runtime
00EDE4  4               ; @summary Load a 16K runtime ROM image named by FIO.NAME/FIO.NAMELEN into the primary runtime ROM bank.
00EDE4  4               ; @requires FIO_NAME FIO_NAMELEN
00EDE4  4               fio_load_runtime:
00EDE4  4  A9 28              LDA   #FIO_CMD_LOADRUNTIME
00EDE6  4  4C 5E ED           JMP   fio_exec
00EDE9  4               
00EDE9  4               ; Fetch 32 host-backed random bits into FIO_RNG0..3.
00EDE9  4               ; @label FIO.RNG
00EDE9  4               ; @kind routine
00EDE9  4               ; @symbol fio_rng
00EDE9  4               ; @summary Issue FIO.CMD_RNG and return random bytes in FIO_RNG0..3.
00EDE9  4               ; @out A: 0 on success, 1 on error.
00EDE9  4               ; @out FIO_RNG0 FIO_RNG1 FIO_RNG2 FIO_RNG3
00EDE9  4               fio_rng:
00EDE9  4  A9 2A              LDA   #FIO_CMD_RNG
00EDEB  4  4C 5E ED           JMP   fio_exec
00EDEE  4               
00EDEE  4               .ifndef FIO_NO_STREAMING
00EDEE  4               ; Compatibility alias for assembly callers that used the streaming name.
00EDEE  4               ; @label FIO.RUN
00EDEE  4               ; @kind routine
00EDEE  4               ; @symbol fio_run
00EDEE  4               ; @summary Compatibility alias for FIO.EXEC.
00EDEE  4               fio_run:
00EDEE  4                     JMP   fio_exec
00EDEE  4               
00EDEE  4               ; Prepare the FIO hardware registers for XLOAD/XSAVE-style direct XRAM I/O.
00EDEE  4               ; @label FIO.PREPARE_XRAM_TRANSFER
00EDEE  4               ; @kind routine
00EDEE  4               ; @symbol fio_prepare_xram_transfer
00EDEE  4               ; @summary Copy pointer filename and XRAM transfer arguments into FIO registers.
00EDEE  4               ; @requires FIO_ARG_NAMELEN FIO_ARG_NAMEPTR_L FIO_ARG_NAMEPTR_H FIO_ARG_ADDRL FIO_ARG_ADDRM FIO_ARG_ADDRH FIO_ARG_LENL FIO_ARG_LENH
00EDEE  4               fio_prepare_xram_transfer:
00EDEE  4                     JSR   fio_copy_name
00EDEE  4                     BNE   @done
00EDEE  4                     LDA   FIO_ARG_ADDRL
00EDEE  4                     STA   FIO_GADDRL
00EDEE  4                     LDA   FIO_ARG_ADDRM
00EDEE  4                     STA   FIO_GADDRH
00EDEE  4                     LDA   FIO_ARG_ADDRH
00EDEE  4                     STA   FIO_GSPACE
00EDEE  4                     LDA   FIO_ARG_LENL
00EDEE  4                     STA   FIO_GLENL
00EDEE  4                     LDA   FIO_ARG_LENH
00EDEE  4                     STA   FIO_GLENH
00EDEE  4                     LDA   #FIO_RESULT_OK
00EDEE  4               @done:
00EDEE  4                     RTS
00EDEE  4               .endif
00EDEE  4               
00EDEE  4               .endif
00EDEE  4               
00EDEE  3               
00EDEE  3               ; @label AUDIO.PLAY_SOUND
00EDEE  3               ; @kind routine
00EDEE  3               ; @symbol audio_play_sound
00EDEE  3               ; @abi register
00EDEE  3               ; @summary Play a one-shot note using A/X/Y register arguments.
00EDEE  3               ; @in A: MIDI note
00EDEE  3               ; @in X: Duration in 60 Hz frames
00EDEE  3               ; @in Y: Instrument slot
00EDEE  3               ; @out A: 0 on success, nonzero on error
00EDEE  3               audio_play_sound:
00EDEE  3  8D A4 B9           STA   AUDIO_NOTE
00EDF1  3  8E A5 B9           STX   AUDIO_DURATION
00EDF4  3  8C A6 B9           STY   AUDIO_INSTRUMENT
00EDF7  3  80 08              BRA   audio_sound
00EDF9  3               
00EDF9  3               ; @label AUDIO.SET_VOLUME
00EDF9  3               ; @kind routine
00EDF9  3               ; @symbol audio_set_volume
00EDF9  3               ; @abi register
00EDF9  3               ; @summary Set master or per-voice volume using A/X register arguments.
00EDF9  3               ; @in A: Volume level
00EDF9  3               ; @in X: Voice selector, 0=master
00EDF9  3               ; @out A: 0 on success, nonzero on error
00EDF9  3               audio_set_volume:
00EDF9  3  8D A4 B9           STA   AUDIO_VOLUME
00EDFC  3  8E A5 B9           STX   AUDIO_VOICE
00EDFF  3  80 05              BRA   audio_volume
00EE01  3               
