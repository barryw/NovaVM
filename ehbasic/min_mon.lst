00ECFB  4               ; @symbol AUDIO_RELEASE
00ECFB  4               ; @summary Release nibble for AUDIO.INSTRUMENT_SET.
00ECFB  4               AUDIO_RELEASE    = FIO_SIZEH
00ECFB  4               
00ECFB  4               ; @label AUDIO.STRL
00ECFB  4               ; @kind u8
00ECFB  4               ; @symbol AUDIO_STRL
