00EDDB  3               ; @label AUDIO.MUSIC_PLAY
00EDDB  3               ; @kind routine
00EDDB  3               ; @symbol audio_music_play
00EDDB  3               ; @abi none
00EDDB  3               ; @summary Start queued music playback.
00EDDB  3               ; @out A: 0 on success, nonzero on error
00EDDB  3               audio_music_play:
00EDDB  3  A9 0E              LDA   #FIO_CMD_MPLAY
00EDDD  3  20 0C ED           JSR   fio_exec
00EDE0  3  D0 01              BNE   @done
00EDE2  3  58                 CLI                     ; playback needs timer IRQs active
00EDE3  3               @done:
00EDE3  3  60                 RTS
00EDE4  3               
00EDE4  3               ; @label AUDIO.MUSIC_STOP
00EDE4  3               ; @kind routine
00EDE4  3               ; @symbol audio_music_stop
00EDE4  3               ; @abi none
00EDE4  3               ; @summary Stop music playback.
00EDE4  3               ; @out A: 0 on success, nonzero on error
00EDE4  3               audio_music_stop:
00EDE4  3  A9 0F              LDA   #FIO_CMD_MSTOP
00EDE6  3  4C 0C ED           JMP   fio_exec
00EDE9  3               
00EDE9  3               ; @label AUDIO.MUSIC_TEMPO
00EDE9  3               ; @kind routine
00EDE9  3               ; @symbol audio_music_tempo
00EDE9  3               ; @abi pseudo-register
00EDE9  3               ; @summary Set music tempo from AUDIO.NOTE/AUDIO.DURATION as a 16-bit BPM value.
00EDE9  3               ; @requires AUDIO.NOTE AUDIO.DURATION
00EDE9  3               ; @out A: 0 on success, nonzero on error
00EDE9  3               audio_music_tempo:
00EDE9  3  A9 10              LDA   #FIO_CMD_MTEMPO
00EDEB  3  4C 0C ED           JMP   fio_exec
00EDEE  3               
00EDEE  3               ; @label AUDIO.MUSIC_LOOP
00EDEE  3               ; @kind routine
00EDEE  3               ; @symbol audio_music_loop
00EDEE  3               ; @abi pseudo-register
00EDEE  3               ; @summary Enable or disable music looping. AUDIO.NOTE is 0=off, nonzero=on.
00EDEE  3               ; @requires AUDIO.NOTE
00EDEE  3               ; @out A: 0 on success, nonzero on error
00EDEE  3               audio_music_loop:
00EDEE  3  A9 11              LDA   #FIO_CMD_MLOOP
00EDF0  3  4C 0C ED           JMP   fio_exec
00EDF3  3               
00EDF3  3               ; @label AUDIO.MUSIC_PRIORITY
00EDF3  3               ; @kind routine
00EDF3  3               ; @symbol audio_music_priority
00EDF3  3               ; @abi pseudo-register
00EDF3  3               ; @summary Set voice-stealing priority from AUDIO.NOTE and following pseudo-register bytes.
00EDF3  3               ; @requires AUDIO.NOTE
00EDF3  3               ; @out A: 0 on success, nonzero on error
00EDF3  3               audio_music_priority:
00EDF3  3  A9 12              LDA   #FIO_CMD_MPRI
00EDF5  3  4C 0C ED           JMP   fio_exec
00EDF8  3               
00EDF8  3               ; @label AUDIO.STATUS
00EDF8  3               ; @kind routine
00EDF8  3               ; @symbol audio_status
00EDF8  3               ; @abi none
00EDF8  3               ; @summary Return raw music status bits.
00EDF8  3               ; @out A: Raw MUSIC_STATUS byte
00EDF8  3               audio_status:
00EDF8  3  AD 50 BA           LDA   MUSIC_STATUS
00EDFB  3  60                 RTS
00EDFC  3               
00EDFC  3               ; @label AUDIO.SFX_PLAYING
00EDFC  3               ; @kind routine
00EDFC  3               ; @symbol audio_sfx_playing
00EDFC  3               ; @abi none
00EDFC  3               ; @summary Return nonzero if a sound effect is playing.
00EDFC  3               ; @out A: 1 if playing, 0 if idle
00EDFC  3               audio_sfx_playing:
00EDFC  3  AD 50 BA           LDA   MUSIC_STATUS
00EDFF  3  29 01              AND   #$01
00EE01  3  60                 RTS
00EE02  3               
00EE02  3               ; @label AUDIO.MUSIC_PLAYING
00EE02  3               ; @kind routine
00EE02  3               ; @symbol audio_music_playing
00EE02  3               ; @abi none
00EE02  3               ; @summary Return nonzero if music is playing.
00EE02  3               ; @out A: 1 if playing, 0 if idle
00EE02  3               audio_music_playing:
00EE02  3  AD 50 BA           LDA   MUSIC_STATUS
00EE05  3  29 02              AND   #$02
00EE07  3  F0 02              BEQ   @off
00EE09  3  A9 01              LDA   #$01
00EE0B  3               @off:
00EE0B  3  60                 RTS
00EE0C  3               
00EE0C  3               ; @label AUDIO.MUSIC_NOTE
00EE0C  3               ; @kind routine
00EE0C  3               ; @symbol audio_music_note
00EE0C  3               ; @abi register
00EE0C  3               ; @summary Return the current MIDI note for a music voice.
00EE0C  3               ; @in X: Voice number, 1..14
00EE0C  3               ; @out A: Current MIDI note, or 0 if out of range or silent
00EE0C  3               audio_music_note:
00EE0C  3  CA                 DEX
00EE0D  3  E0 0E              CPX   #$0E
00EE0F  3  B0 04              BCS   @bad
00EE11  3  BD 51 BA           LDA   MUSIC_NOTE1,X
00EE14  3  60                 RTS
00EE15  3               @bad:
00EE15  3  A9 00              LDA   #$00
00EE17  3  60                 RTS
00EE18  3               
00EE18  3               .endif
00EE18  3               
00EE18  2                     .include "lib/nic.s"
00EE18  3               ; Shared Nova NIC helper routines.
00EE18  3               
00EE18  3               .include "nic.inc"
00EE18  4               ; Shared Nova NIC runtime interface.
00EE18  4               ;
00EE18  4               ; BASIC handles string allocation/parsing.  Assembly callers can use these
00EE18  4               ; routines by loading the NIC MMIO registers directly.
00EE18  4               ;
00EE18  4               ; Connect:
00EE18  4               ;   NIC_SLOT      slot number
00EE18  4               ;   NIC_NAMEBUF   zero-terminated host name
00EE18  4               ;   NIC_RPORTL/H  remote port
00EE18  4               ;
00EE18  4               ; Listen:
00EE18  4               ;   NIC_SLOT      slot number
00EE18  4               ;   NIC_LPORTL/H  local port
00EE18  4               ;
00EE18  4               ; Send:
00EE18  4               ;   NIC_SLOT      slot number
00EE18  4               ;   NIC_DMAL/H    CPU pointer to bytes
00EE18  4               ;   NIC_DMALEN    byte count
00EE18  4               ;
00EE18  4               ; Receive:
00EE18  4               ;   NIC_SLOT      slot number
00EE18  4               ;   NIC_DMAL/H    CPU destination pointer
00EE18  4               ;   NIC_MSGLEN    byte count returned by hardware
00EE18  4               
00EE18  4               .ifndef NIC_INC_INCLUDED
00EE18  4               NIC_INC_INCLUDED = 1
00EE18  4               
00EE18  4               .include "nova.inc"
00EE18  5               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
00EE18  5               ;
00EE18  5               ; This include is deliberately guarded per symbol so it can coexist with older
00EE18  5               ; source files that still define a subset of these names locally.
00EE18  5               
00EE18  5               .ifndef NOVA_INC_INCLUDED
00EE18  5               NOVA_INC_INCLUDED = 1
00EE18  5               
00EE18  5               ; Nova pseudo-register mailbox. These bytes are available to callers and
00EE18  5               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
00EE18  5               ; clobber them unless its documentation explicitly says otherwise; persistent
00EE18  5               ; library state must be allocated in a linker segment such as BSS/ZEROPAGE.
00EE18  5               .ifndef NVR0L
00EE18  5               NVR0L             = $20
00EE18  5               .endif
00EE18  5               .ifndef NVR0H
00EE18  5               NVR0H             = $21
00EE18  5               .endif
00EE18  5               .ifndef NVR1L
