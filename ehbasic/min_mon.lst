00E898  2               ;     .word xxxx              ; non halting key input -     monitor to set this
00E898  2               ;     .word xxxx              ; output vector         -     monitor to set this
00E898  2               ;     .word xxxx              ; load vector           -     monitor to set this
00E898  2               ;     .word xxxx              ; save vector           -     monitor to set this
00E898  2               PG2_TABE
00E898  2               
00E898  2               ; --- Nova hardware constants live in lib/nova.inc ---
00E898  2               
00E898  2               ; --- VGC command handlers ---
00E898  2               
00E898  2               ; draw a text-only cold-start splash screen
00E898  2               
00E898  2               LAB_BOOT_SCREEN_CLEAR
00E898  2  9C 01 A0           STZ   VGC_BGCOL         ; black background
00E89B  2  A9 0F              LDA   #$0F              ; light grey text
00E89D  2  8D 02 A0           STA   VGC_FGCOL
00E8A0  2  A9 0B              LDA   #$0B              ; dark grey border
00E8A2  2  8D 0D A0           STA   VGC_BORDER
00E8A5  2  9C 00 A0           STZ   VGC_MODE          ; mode 0: text only
00E8A8  2               
00E8A8  2  A9 0C              LDA   #$0C              ; clear text layer and home cursor
00E8AA  2  20 8A E8           JSR   V_OUTP
00E8AD  2  60                 RTS
00E8AE  2               
00E8AE  2               LAB_SPLASH
00E8AE  2  20 98 E8           JSR   LAB_BOOT_SCREEN_CLEAR
00E8B1  2  A9 21              LDA   #$21              ; centered x for "NovaBASIC v1.0"
00E8B3  2  8D 03 A0           STA   VGC_CURSX
00E8B6  2  85 0E              STA   TPos
00E8B8  2  A9 01              LDA   #$01              ; leave breathing room on the first row
00E8BA  2  8D 04 A0           STA   VGC_CURSY
00E8BD  2  A9 E4              LDA   #<LAB_BNR1
00E8BF  2  A0 E8              LDY   #>LAB_BNR1
00E8C1  2  20 EC CA           JSR   LAB_18C3
00E8C4  2               
00E8C4  2  A9 1A              LDA   #$1A              ; centered x for "Derived from EhBASIC 2.22p5"
00E8C6  2  8D 03 A0           STA   VGC_CURSX
00E8C9  2  85 0E              STA   TPos
00E8CB  2  A9 03              LDA   #$03              ; one empty row between lines
00E8CD  2  8D 04 A0           STA   VGC_CURSY
00E8D0  2  A9 F3              LDA   #<LAB_BNR2
00E8D2  2  A0 E8              LDY   #>LAB_BNR2
00E8D4  2  20 EC CA           JSR   LAB_18C3
00E8D7  2               
00E8D7  2  A9 11              LDA   #$11              ; centered x for "xxxxx BASIC bytes free  xxxK expansion memory"
00E8D9  2  8D 03 A0           STA   VGC_CURSX
00E8DC  2  85 0E              STA   TPos
00E8DE  2  A9 05              LDA   #$05              ; one empty row between lines
00E8E0  2  8D 04 A0           STA   VGC_CURSY
00E8E3  2  60                 RTS
00E8E4  2               
00E8E4  2               LAB_BNR1
00E8E4  2  4E 6F 76 61        .byte "NovaBASIC v1.0",$00
00E8E8  2  42 41 53 49  
00E8EC  2  43 20 76 31  
00E8F3  2               LAB_BNR2
00E8F3  2  44 65 72 69        .byte "Derived from EhBASIC 2.22p5",$00
00E8F7  2  76 65 64 20  
00E8FB  2  66 72 6F 6D  
