00EF77  2               LAB_EXT_FCER
00EF77  2  20 21 02           JSR   EXT_vec
00EF7A  2  D0 01              BNE   @ext_bad
00EF7C  2  60                 RTS
00EF7D  2               @ext_bad
00EF7D  2  4C CE D2           JMP   LAB_FCER
00EF80  2               
00EF80  2               ; perform SIDPLAY "filename" [, song]
00EF80  2               
00EF80  2               LAB_SIDPLAY
00EF80  2  20 4C F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00EF83  2  A9 01              LDA   #$01              ; default song = 1
00EF85  2  8D A4 B9           STA   FIO_SRCL
00EF88  2  20 C2 00           JSR   LAB_GBYT          ; peek next token
00EF8B  2  C9 2C              CMP   #','
00EF8D  2  D0 09              BNE   @sp_go
00EF8F  2  20 09 CE           JSR   LAB_1C01          ; consume comma
00EF92  2  20 45 D8           JSR   LAB_GTBY          ; evaluate song number -> X
00EF95  2  8E A4 B9           STX   FIO_SRCL
00EF98  2               @sp_go
00EF98  2  20 0A ED           JSR   audio_sidplay
00EF9B  2  D0 01              BNE   @sp_err
