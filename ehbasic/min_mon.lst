00EE9E  2  8D A6 B9           STA   FIO_ENDL
00EEA1  2  A5 7C              LDA   Svarh
00EEA3  2  8D A7 B9           STA   FIO_ENDH
00EEA6  2  80 27              BRA   @sv_go
