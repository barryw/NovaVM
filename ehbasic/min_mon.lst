00ECFB  4               AUDIO_INSTRUMENT = FIO_ENDL
00ECFB  4               
00ECFB  4               ; @label AUDIO.VOLUME_LEVEL
00ECFB  4               ; @kind u8
00ECFB  4               ; @symbol AUDIO_VOLUME
00ECFB  4               ; @summary Volume level for AUDIO.VOLUME.
00ECFB  4               AUDIO_VOLUME     = FIO_SRCL
00ECFB  4               ; @label AUDIO.VOICE
00ECFB  4               ; @kind u8
00ECFB  4               ; @symbol AUDIO_VOICE
00ECFB  4               ; @summary Voice selector. Use 0 for master volume or 1..14 for music voices.
00ECFB  4               AUDIO_VOICE      = FIO_SRCH
00ECFB  4               
00ECFB  4               ; @label AUDIO.INST_ID
00ECFB  4               ; @kind u8
00ECFB  4               ; @symbol AUDIO_INST_ID
