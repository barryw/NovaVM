00F054  2  4C CC ED           JMP   audio_midstop
00F057  2               
00F057  2               ; common: issue FIO command in A, check status, error on fail
00F057  2               
00F057  2               LAB_FIO_EXEC
00F057  2  20 0C ED           JSR   fio_exec
00F05A  2  D0 01              BNE   @fio_chk_err
00F05C  2  60                 RTS
00F05D  2               @fio_chk_err
00F05D  2  4C 1B F2           JMP   LAB_FIO_ERRHND
00F060  2               
00F060  2               ; Skip X characters from BASIC input
00F060  2               LAB_SKIPX
00F060  2  20 BC 00           JSR   LAB_IGBY
00F063  2  CA                 DEX
00F064  2  D0 FA              BNE   LAB_SKIPX
00F066  2  60                 RTS
00F067  2               
00F067  2               ; perform MUSIC subcommand
00F067  2               ; MUSIC voice, "mml"
00F067  2               ; MUSIC PLAY | STOP | TEMPO bpm | LOOP ON|OFF | PRIORITY v1[,v2[,v3]]
00F067  2               
00F067  2               LAB_MUSIC
00F067  2  20 C2 00           JSR   LAB_GBYT          ; peek next byte (after MUSIC token consumed)
00F06A  2  C9 50              CMP   #'P'
00F06C  2  F0 0F              BEQ   @m_chk_p
00F06E  2  C9 92              CMP   #TK_STOP           ; STOP is tokenized by BASIC
00F070  2  F0 1A              BEQ   @m_stop_tok
00F072  2  C9 54              CMP   #'T'
00F074  2  F0 1C              BEQ   @m_tempo
00F076  2  C9 9E              CMP   #TK_LOOP           ; LOOP is tokenized by BASIC
00F078  2  F0 2D              BEQ   @m_loop_tok
00F07A  2                     ; Not a subcommand — must be a number (voice 1-6)
00F07A  2  4C F9 F0           JMP   @m_seq
00F07D  2               
00F07D  2               ; --- MUSIC PLAY or PRIORITY ---
00F07D  2               @m_chk_p
00F07D  2                     ; Consume P, then check next char to distinguish PLAY vs PRIORITY
00F07D  2  20 BC 00           JSR   LAB_IGBY          ; consume P, A = next char
00F080  2  C9 52              CMP   #'R'              ; PRIORITY has R after P
00F082  2  F0 47              BEQ   @m_priority
00F084  2                     ; else PLAY — consume remaining "LAY" (3 chars, P already consumed)
00F084  2  A2 03              LDX   #3
00F086  2  20 60 F0           JSR   LAB_SKIPX          ; LAY
00F089  2  4C DB ED           JMP   audio_music_play
00F08C  2               
00F08C  2               ; --- MUSIC STOP (TK_STOP is a single token byte) ---
00F08C  2               @m_stop_tok
00F08C  2  20 BC 00           JSR   LAB_IGBY          ; consume TK_STOP token
00F08F  2  4C E4 ED           JMP   audio_music_stop
00F092  2               
00F092  2               ; --- MUSIC TEMPO bpm ---
00F092  2               @m_tempo
00F092  2  A2 05              LDX   #5
00F094  2  20 60 F0           JSR   LAB_SKIPX          ; TEMPO
00F097  2  20 9C D8           JSR   LAB_GTWRD         ; bpm as 16-bit → FAC1_3(lo), FAC1_2(hi)
00F09A  2  A5 AF              LDA   FAC1_3
00F09C  2  8D A4 B9           STA   FIO_SRCL
00F09F  2  A5 AE              LDA   FAC1_2
00F0A1  2  8D A5 B9           STA   FIO_SRCH
00F0A4  2  4C E9 ED           JMP   audio_music_tempo
00F0A7  2               
00F0A7  2               ; --- MUSIC LOOP ON|OFF (TK_LOOP is a single token byte) ---
00F0A7  2               @m_loop_tok
00F0A7  2  20 BC 00           JSR   LAB_IGBY          ; consume TK_LOOP token
00F0AA  2  20 C2 00           JSR   LAB_GBYT          ; skip spaces, get TK_ON or TK_OFF
00F0AD  2  C9 93              CMP   #TK_ON
00F0AF  2  F0 07              BEQ   @m_loop_on
00F0B1  2  C9 CB              CMP   #TK_OFF
00F0B3  2  F0 0D              BEQ   @m_loop_off
00F0B5  2  4C E7 C5           JMP   LAB_15D9          ; syntax error
00F0B8  2               @m_loop_on
00F0B8  2  20 BC 00           JSR   LAB_IGBY          ; consume ON token
00F0BB  2  A9 01              LDA   #$01
00F0BD  2  8D A4 B9           STA   FIO_SRCL
00F0C0  2  80 06              BRA   @m_loop_go
00F0C2  2               @m_loop_off
00F0C2  2  20 BC 00           JSR   LAB_IGBY          ; consume OFF token
00F0C5  2  9C A4 B9           STZ   FIO_SRCL
00F0C8  2               @m_loop_go
00F0C8  2  4C EE ED           JMP   audio_music_loop
00F0CB  2               
00F0CB  2               ; --- MUSIC PRIORITY v1[,v2[,v3[,v4[,v5[,v6]]]]] ---
00F0CB  2               @m_priority
00F0CB  2                     ; P already consumed by @m_chk_p.  Skip remaining keyword bytes.
00F0CB  2                     ; "RIORITY" is tokenized as R,I,TK_OR,I,T,Y (OR becomes a token),
00F0CB  2                     ; so we scan dynamically instead of using a fixed IGBY count.
00F0CB  2               @m_pri_skip
00F0CB  2  20 BC 00           JSR   LAB_IGBY          ; advance past current byte
00F0CE  2  C9 41              CMP   #'A'              ; letters ($41-$5A) and tokens ($80+) are >= 'A'
00F0D0  2  B0 F9              BCS   @m_pri_skip       ; keep skipping keyword chars and tokens
00F0D2  2                     ; A < 'A': hit a space or digit — keyword is consumed.
00F0D2  2                     ; pointer is at the space/digit; LAB_GTBY calls GBYT which skips spaces.
00F0D2  2                     ; Clear all 6 voice slots
00F0D2  2  A9 00              LDA   #$00
00F0D4  2  A0 05              LDY   #$05
00F0D6  2               @m_pri_clr
00F0D6  2  99 A4 B9           STA   FIO_SRCL,Y
00F0D9  2  88                 DEY
00F0DA  2  10 FA              BPL   @m_pri_clr
00F0DC  2                     ; Parse up to 6 comma-separated voice values
00F0DC  2  A0 00              LDY   #$00              ; slot index
00F0DE  2               @m_pri_nxt
00F0DE  2  20 AE D8           JSR   LAB_GTBY          ; get voice number → X
00F0E1  2  8A                 TXA
00F0E2  2  99 A4 B9           STA   FIO_SRCL,Y        ; store to slot
00F0E5  2  C8                 INY
00F0E6  2  C0 06              CPY   #$06
00F0E8  2  B0 0C              BCS   @m_pri_go         ; all 6 parsed
00F0EA  2  20 C2 00           JSR   LAB_GBYT          ; peek next char
00F0ED  2  C9 2C              CMP   #','
00F0EF  2  D0 05              BNE   @m_pri_go         ; no more commas
00F0F1  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00F0F4  2  80 E8              BRA   @m_pri_nxt
00F0F6  2               @m_pri_go
