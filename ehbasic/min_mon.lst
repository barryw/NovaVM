00ED69  2                     .include "lib/nic.s"
00ED69  3               ; Shared Nova NIC helper routines.
00ED69  3               
00ED69  3               .include "nic.inc"
00ED69  4               ; Shared Nova NIC runtime interface.
00ED69  4               ;
00ED69  4               ; BASIC handles string allocation/parsing.  Assembly callers can use these
00ED69  4               ; routines by loading the NIC MMIO registers directly.
00ED69  4               ;
00ED69  4               ; Connect:
00ED69  4               ;   NIC_SLOT      slot number
00ED69  4               ;   NIC_NAMEBUF   zero-terminated host name
00ED69  4               ;   NIC_RPORTL/H  remote port
00ED69  4               ;
00ED69  4               ; Listen:
00ED69  4               ;   NIC_SLOT      slot number
00ED69  4               ;   NIC_LPORTL/H  local port
00ED69  4               ;
00ED69  4               ; Send:
00ED69  4               ;   NIC_SLOT      slot number
00ED69  4               ;   NIC_DMAL/H    CPU pointer to bytes
00ED69  4               ;   NIC_DMALEN    byte count
00ED69  4               ;
00ED69  4               ; Receive:
00ED69  4               ;   NIC_SLOT      slot number
00ED69  4               ;   NIC_DMAL/H    CPU destination pointer
00ED69  4               ;   NIC_MSGLEN    byte count returned by hardware
00ED69  4               ;
00ED69  4               ; NIC.COMMAND writes NIC_CMDSHADOW first, increments NIC_CMDSEQ, then writes
00ED69  4               ; NIC_CMD. NovaHost uses the pair to distinguish a fresh command from a delayed
00ED69  4               ; retry clear of the previous command byte, and to recover the command if that
00ED69  4               ; clear races with the new write.
00ED69  4               ;
00ED69  4               ; Hardware payload DMA:
00ED69  4               ;   NIC_CMD_SEND snapshots NIC_DMAL/H:NIC_DMALEN bytes into the FPGA NIC TX
00ED69  4               ;   buffer before NovaHost receives the event. NovaHost stages received bytes
00ED69  4               ;   into the FPGA NIC RX buffer, writes NIC_MSGLEN, then writes
00ED69  4               ;   NIC_HOSTCTRL_RX_START to copy the payload into NIC_DMAL/H.
00ED69  4               
00ED69  4               .ifndef NIC_INC_INCLUDED
00ED69  4               NIC_INC_INCLUDED = 1
00ED69  4               
00ED69  4               .include "nova.inc"
00ED69  5               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
00ED69  5               ;
00ED69  5               ; This include is deliberately guarded per symbol so it can coexist with older
00ED69  5               ; source files that still define a subset of these names locally.
00ED69  5               
00ED69  5               .ifndef NOVA_INC_INCLUDED
00ED69  5               NOVA_INC_INCLUDED = 1
00ED69  5               
00ED69  5               ; Nova pseudo-register mailbox. These bytes are available to callers and
00ED69  5               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
00ED69  5               ; clobber them unless its documentation explicitly says otherwise; persistent
00ED69  5               ; library state must be allocated in a linker segment such as BSS/ZEROPAGE.
00ED69  5               .ifndef NVR0L
00ED69  5               NVR0L             = $20
00ED69  5               .endif
00ED69  5               .ifndef NVR0H
00ED69  5               NVR0H             = $21
