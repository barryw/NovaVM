00EE6F  5               ; BASIC SYS register bridge. SYS addr[,A[,X[,Y]]] loads A/X/Y from these
00EE6F  5               ; bytes before jumping and stores A/X/Y back here when the routine returns.
00EE6F  5               ; @label SYS.REGA
00EE6F  5               ; @kind u8
00EE6F  5               ; @symbol SYS_REGA
00EE6F  5               ; @summary Returned A register from the most recent SYS call.
00EE6F  5               .ifndef SYS_REGA
00EE6F  5               SYS_REGA          = $E7
00EE6F  5               .endif
00EE6F  5               ; @label SYS.REGX
00EE6F  5               ; @kind u8
00EE6F  5               ; @symbol SYS_REGX
00EE6F  5               ; @summary Returned X register from the most recent SYS call.
00EE6F  5               .ifndef SYS_REGX
00EE6F  5               SYS_REGX          = $E8
00EE6F  5               .endif
00EE6F  5               ; @label SYS.REGY
00EE6F  5               ; @kind u8
00EE6F  5               ; @symbol SYS_REGY
00EE6F  5               ; @summary Returned Y register from the most recent SYS call.
00EE6F  5               .ifndef SYS_REGY
00EE6F  5               SYS_REGY          = $E9
00EE6F  5               .endif
