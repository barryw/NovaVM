00F03B  2  A0 00              LDY   #$00              ; slot index
00F03D  2               @m_pri_nxt
00F03D  2  20 45 D8           JSR   LAB_GTBY          ; get voice number → X
00F040  2  8A                 TXA
00F041  2  99 A4 B9           STA   FIO_SRCL,Y        ; store to slot
