00EFBC  2  A5 AE              LDA   FAC1_2
00EFBE  2  8D AC B9           STA   FIO_GADDRH
00EFC1  2  AD 0C BA           LDA   XMC_BANK
00EFC4  2  8D AA B9           STA   FIO_GSPACE
