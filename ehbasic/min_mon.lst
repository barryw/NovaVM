00ED8A  4  4C 0C ED           JMP   fio_exec
00ED8D  4               
00ED8D  4               ; @label FIO.PWD
00ED8D  4               ; @kind routine
00ED8D  4               ; @symbol fio_pwd
00ED8D  4               ; @summary Read the current directory into FIO.NAME/FIO.NAMELEN.
00ED8D  4               fio_pwd:
00ED8D  4  A9 26              LDA   #FIO_CMD_PWD
00ED8F  4  4C 0C ED           JMP   fio_exec
00ED92  4               
00ED92  4               ; Load a 16K runtime ROM image into the primary $C000 bank.
00ED92  4               ; This routine is meant for RAM-resident launchers. The host overwrites the
00ED92  4               ; primary ROM bank while the command is in progress.
00ED92  4               ; @label FIO.LOAD_RUNTIME
00ED92  4               ; @kind routine
00ED92  4               ; @symbol fio_load_runtime
00ED92  4               ; @summary Load a 16K runtime ROM image named by FIO.NAME/FIO.NAMELEN into the primary runtime ROM bank.
00ED92  4               ; @requires FIO_NAME FIO_NAMELEN
00ED92  4               fio_load_runtime:
00ED92  4  A9 28              LDA   #FIO_CMD_LOADRUNTIME
00ED94  4  4C 0C ED           JMP   fio_exec
00ED97  4               
00ED97  4               .ifndef FIO_NO_STREAMING
00ED97  4               ; Compatibility alias for assembly callers that used the streaming name.
00ED97  4               ; @label FIO.RUN
00ED97  4               ; @kind routine
00ED97  4               ; @symbol fio_run
00ED97  4               ; @summary Compatibility alias for FIO.EXEC.
00ED97  4               fio_run:
00ED97  4                     JMP   fio_exec
00ED97  4               
00ED97  4               ; Prepare the FIO hardware registers for XLOAD/XSAVE-style direct XRAM I/O.
00ED97  4               ; @label FIO.PREPARE_XRAM_TRANSFER
00ED97  4               ; @kind routine
00ED97  4               ; @symbol fio_prepare_xram_transfer
00ED97  4               ; @summary Copy pointer filename and XRAM transfer arguments into FIO registers.
00ED97  4               ; @requires FIO_ARG_NAMELEN FIO_ARG_NAMEPTR_L FIO_ARG_NAMEPTR_H FIO_ARG_ADDRL FIO_ARG_ADDRM FIO_ARG_ADDRH FIO_ARG_LENL FIO_ARG_LENH
00ED97  4               fio_prepare_xram_transfer:
00ED97  4                     JSR   fio_copy_name
00ED97  4                     BNE   @done
00ED97  4                     LDA   FIO_ARG_ADDRL
00ED97  4                     STA   FIO_GADDRL
00ED97  4                     LDA   FIO_ARG_ADDRM
00ED97  4                     STA   FIO_GADDRH
00ED97  4                     LDA   FIO_ARG_ADDRH
00ED97  4                     STA   FIO_GSPACE
00ED97  4                     LDA   FIO_ARG_LENL
00ED97  4                     STA   FIO_GLENL
00ED97  4                     LDA   FIO_ARG_LENH
00ED97  4                     STA   FIO_GLENH
00ED97  4                     LDA   #FIO_RESULT_OK
00ED97  4               @done:
00ED97  4                     RTS
00ED97  4               .endif
00ED97  4               
00ED97  4               .endif
00ED97  4               
00ED97  3               
00ED97  3               ; @label AUDIO.PLAY_SOUND
00ED97  3               ; @kind routine
00ED97  3               ; @symbol audio_play_sound
00ED97  3               ; @abi register
00ED97  3               ; @summary Play a one-shot note using A/X/Y register arguments.
00ED97  3               ; @in A: MIDI note
00ED97  3               ; @in X: Duration in 60 Hz frames
00ED97  3               ; @in Y: Instrument slot
00ED97  3               ; @out A: 0 on success, nonzero on error
00ED97  3               audio_play_sound:
00ED97  3  8D A4 B9           STA   AUDIO_NOTE
00ED9A  3  8E A5 B9           STX   AUDIO_DURATION
00ED9D  3  8C A6 B9           STY   AUDIO_INSTRUMENT
00EDA0  3  80 08              BRA   audio_sound
00EDA2  3               
00EDA2  3               ; @label AUDIO.SET_VOLUME
00EDA2  3               ; @kind routine
00EDA2  3               ; @symbol audio_set_volume
