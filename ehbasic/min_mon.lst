00EDB2  4               ; @requires FIO_NAME FIO_NAMELEN FIO_SRCL FIO_SRCH
00EDB2  4               fio_load:
00EDB2  4  A9 02              LDA   #FIO_CMD_LOAD
00EDB4  4  4C 5E ED           JMP   fio_exec
00EDB7  4               
00EDB7  4               ; @label FIO.DIR_OPEN
00EDB7  4               ; @kind routine
00EDB7  4               ; @symbol fio_dir_open
00EDB7  4               ; @summary Open a directory listing using optional FIO.NAME/FIO.NAMELEN filter.
00EDB7  4               fio_dir_open:
00EDB7  4  A9 03              LDA   #FIO_CMD_DIROPEN
00EDB9  4  4C 5E ED           JMP   fio_exec
00EDBC  4               
