00E1E3  2  4C 21 02           JMP   EXT_vec
00E1E6  2               
00E1E6  2               
00E1E6  2               ; perform BITTST(addr, mask) — returns -1 if ALL masked bits set, else 0
00E1E6  2               
00E1E6  2               LAB_BTST
00E1E6  2  20 BC 00           JSR   LAB_IGBY          ; increment BASIC pointer
00E1E9  2  20 8A D8           JSR   LAB_GADB          ; addr in Itempl/h, mask in X
00E1EC  2               
00E1EC  2  20 C2 00           JSR   LAB_GBYT          ; get next BASIC byte
00E1EF  2  C9 29              CMP   #')'              ; is next character ")"
00E1F1  2  F0 03              BEQ   TST_OK            ; if ")" go do rest of function
00E1F3  2               
00E1F3  2  4C 0D CE           JMP   LAB_SNER          ; do syntax error then warm start
00E1F6  2               
00E1F6  2               TST_OK
00E1F6  2  20 BC 00           JSR   LAB_IGBY          ; update BASIC execute pointer (past ")")
00E1F9  2  A0 00              LDY   #$00
00E1FB  2  8A                 TXA                     ; A = mask
00E1FC  2  31 11              AND   (Itempl),Y        ; AND with byte at addr
00E1FE  2  85 11              STA   Itempl            ; save result
00E200  2  E4 11              CPX   Itempl            ; compare with original mask (still in X)
00E202  2  D0 05              BNE   LAB_NOTT          ; not all bits set — return 0
00E204  2               
00E204  2  A9 FF              LDA   #$FF              ; all masked bits set — return -1
00E206  2  4C FA DC           JMP   LAB_27DB          ; go do SGN tail
00E209  2               
00E209  2               LAB_NOTT
00E209  2  A9 00              LDA   #$00              ; return 0
00E20B  2  4C FA DC           JMP   LAB_27DB          ; go do SGN tail
00E20E  2               
00E20E  2               ; perform BIN$()
00E20E  2               
00E20E  2               LAB_BINS
00E20E  2  E0 19              CPX   #$19              ; max + 1
00E210  2  B0 48              BCS   BinFErr           ; exit if too big ( > or = )
00E212  2               
00E212  2  86 78              STX   TempB             ; save # of characters ($00 = leading zero remove)
00E214  2  A9 18              LDA   #$18              ; need A byte long space
00E216  2  20 DD D4           JSR   LAB_MSSP          ; make string space A bytes long
00E219  2  A0 17              LDY   #$17              ; set index
00E21B  2  A2 18              LDX   #$18              ; character count
00E21D  2               NextB1
