00F102  2  20 E5 CC           JSR   LAB_EVEX          ; evaluate expression
00F105  2  20 4D D7           JSR   LAB_EVST          ; pop string: A=len, ut1_pl/ph=ptr
00F108  2  AA                 TAX
00F109  2  F0 13              BEQ   @m_seq_err        ; empty string = error
00F10B  2  8E A3 B9           STX   AUDIO_STRLEN      ; string length (1-255)
