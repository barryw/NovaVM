00EF91  2  9C AE B9           STZ   FIO_GLENH
00EF94  2  20 C2 00           JSR   LAB_GBYT          ; optional comma,length
00EF97  2  C9 2C              CMP   #','
00EF99  2  D0 10              BNE   @gl_go
00EF9B  2  20 06 CE           JSR   LAB_1C01
00EF9E  2  20 9C D8           JSR   LAB_GTWRD
00EFA1  2  A5 AF              LDA   FAC1_3
00EFA3  2  8D AD B9           STA   FIO_GLENL
