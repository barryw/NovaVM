00E7AC  2               
00E7AC  2               ; system dependant i/o vectors
00E7AC  2               ; these are in RAM and are set by the monitor at start-up
00E7AC  2               
00E7AC  2               V_INPT
00E7AC  2  6C 05 02           JMP   (VEC_IN)          ; non halting scan input device
00E7AF  2               V_OUTP
00E7AF  2  6C 07 02           JMP   (VEC_OUT)         ; send byte to output device
00E7B2  2               V_LOAD
00E7B2  2  6C 09 02           JMP   (VEC_LD)          ; load BASIC program
00E7B5  2               V_SAVE
00E7B5  2  6C 0B 02           JMP   (VEC_SV)          ; save BASIC program
00E7B8  2               
00E7B8  2               ; The rest are tables messages and code for RAM
00E7B8  2               
00E7B8  2               ; the rest of the code is tables and BASIC start-up code
00E7B8  2               
00E7B8  2               PG2_TABS
00E7B8  2  00                 .byte $00               ; ctrl-c flag           -     $00 = enabled
00E7B9  2  00                 .byte $00               ; ctrl-c byte           -     GET needs this
00E7BA  2  00                 .byte $00               ; ctrl-c byte timeout   -     GET needs this
00E7BB  2  E4 E2              .word CTRLC             ; ctrl c check vector
00E7BD  2               ;     .word xxxx              ; non halting key input -     monitor to set this
00E7BD  2               ;     .word xxxx              ; output vector         -     monitor to set this
00E7BD  2               ;     .word xxxx              ; load vector           -     monitor to set this
00E7BD  2               ;     .word xxxx              ; save vector           -     monitor to set this
00E7BD  2               PG2_TABE
00E7BD  2               
00E7BD  2               ; --- Nova hardware constants live in lib/nova.inc ---
00E7BD  2               
00E7BD  2               ; --- VGC command handlers ---
00E7BD  2               
00E7BD  2               ; draw a text-only cold-start splash screen
00E7BD  2               
00E7BD  2               LAB_BOOT_SCREEN_CLEAR
00E7BD  2  9C 01 A0           STZ   VGC_BGCOL         ; black background
00E7C0  2  A9 0F              LDA   #$0F              ; light grey text
00E7C2  2  8D 02 A0           STA   VGC_FGCOL
00E7C5  2  A9 0B              LDA   #$0B              ; dark grey border
00E7C7  2  8D 0D A0           STA   VGC_BORDER
00E7CA  2  9C 00 A0           STZ   VGC_MODE          ; mode 0: text only
00E7CD  2               
00E7CD  2  A9 0C              LDA   #$0C              ; clear text layer and home cursor
00E7CF  2  20 AF E7           JSR   V_OUTP
00E7D2  2  60                 RTS
00E7D3  2               
00E7D3  2               LAB_SPLASH
00E7D3  2  20 BD E7           JSR   LAB_BOOT_SCREEN_CLEAR
00E7D6  2  A9 21              LDA   #$21              ; centered x for "NovaBASIC v1.0"
00E7D8  2  8D 03 A0           STA   VGC_CURSX
00E7DB  2  85 0E              STA   TPos
00E7DD  2  A9 01              LDA   #$01              ; leave breathing room on the first row
00E7DF  2  8D 04 A0           STA   VGC_CURSY
00E7E2  2  A9 09              LDA   #<LAB_BNR1
00E7E4  2  A0 E8              LDY   #>LAB_BNR1
00E7E6  2  20 EC CA           JSR   LAB_18C3
00E7E9  2               
00E7E9  2  A9 1A              LDA   #$1A              ; centered x for "Derived from EhBASIC 2.22p5"
00E7EB  2  8D 03 A0           STA   VGC_CURSX
00E7EE  2  85 0E              STA   TPos
00E7F0  2  A9 03              LDA   #$03              ; one empty row between lines
00E7F2  2  8D 04 A0           STA   VGC_CURSY
00E7F5  2  A9 18              LDA   #<LAB_BNR2
00E7F7  2  A0 E8              LDY   #>LAB_BNR2
00E7F9  2  20 EC CA           JSR   LAB_18C3
00E7FC  2               
00E7FC  2  A9 11              LDA   #$11              ; centered x for "xxxxx BASIC bytes free  xxxK expansion memory"
00E7FE  2  8D 03 A0           STA   VGC_CURSX
00E801  2  85 0E              STA   TPos
00E803  2  A9 05              LDA   #$05              ; one empty row between lines
00E805  2  8D 04 A0           STA   VGC_CURSY
00E808  2  60                 RTS
00E809  2               
00E809  2               LAB_BNR1
00E809  2  4E 6F 76 61        .byte "NovaBASIC v1.0",$00
00E80D  2  42 41 53 49  
00E811  2  43 20 76 31  
00E818  2               LAB_BNR2
00E818  2  44 65 72 69        .byte "Derived from EhBASIC 2.22p5",$00
00E81C  2  76 65 64 20  
00E820  2  66 72 6F 6D  
