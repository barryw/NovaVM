00EE18  5               .endif
00EE18  5               .ifndef NVR1H
00EE18  5               NVR1H             = $23
00EE18  5               .endif
00EE18  5               .ifndef NVR2L
00EE18  5               NVR2L             = $24
00EE18  5               .endif
00EE18  5               .ifndef NVR2H
00EE18  5               NVR2H             = $25
00EE18  5               .endif
00EE18  5               .ifndef NVR3L
00EE18  5               NVR3L             = $26
00EE18  5               .endif
00EE18  5               .ifndef NVR3H
00EE18  5               NVR3H             = $27
00EE18  5               .endif
00EE18  5               .ifndef NVR4L
00EE18  5               NVR4L             = $28
00EE18  5               .endif
00EE18  5               .ifndef NVR4H
00EE18  5               NVR4H             = $29
00EE18  5               .endif
00EE18  5               .ifndef NVR5L
00EE18  5               NVR5L             = $2A
00EE18  5               .endif
00EE18  5               .ifndef NVR5H
00EE18  5               NVR5H             = $2B
00EE18  5               .endif
00EE18  5               .ifndef NVR6L
00EE18  5               NVR6L             = $2C
00EE18  5               .endif
00EE18  5               .ifndef NVR6H
00EE18  5               NVR6H             = $2D
00EE18  5               .endif
00EE18  5               .ifndef NVR7L
00EE18  5               NVR7L             = $2E
00EE18  5               .endif
00EE18  5               .ifndef NVR7H
00EE18  5               NVR7H             = $2F
00EE18  5               .endif
