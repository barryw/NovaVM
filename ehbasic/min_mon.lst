00ECFB  4               ; @symbol AUDIO_DURATION
00ECFB  4               ; @summary Duration in 60 Hz frames for AUDIO.SOUND.
00ECFB  4               AUDIO_DURATION   = FIO_SRCH
00ECFB  4               ; @label AUDIO.INSTRUMENT
00ECFB  4               ; @kind u8
00ECFB  4               ; @symbol AUDIO_INSTRUMENT
