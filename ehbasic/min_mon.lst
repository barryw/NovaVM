00EE01  3               ; @requires AUDIO.NOTE AUDIO.DURATION AUDIO.INSTRUMENT
00EE01  3               ; @out A: 0 on success, nonzero on error
00EE01  3               audio_sound:
00EE01  3  A9 0B              LDA   #FIO_CMD_SOUND
00EE03  3  4C 5E ED           JMP   fio_exec
00EE06  3               
