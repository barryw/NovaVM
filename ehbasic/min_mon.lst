00E90F  3               
00E90F  3               ; Input: A = VGC command. Does not wait for completion.
00E90F  3               ; @label VGC.COMMAND
00E90F  3               ; @kind routine
00E90F  3               ; @symbol vgc_cmd
00E90F  3               ; @summary Issue a raw VGC command without waiting for completion.
00E90F  3               ; @in A: VGC command byte.
00E90F  3               vgc_cmd:
00E90F  3  8D 10 A0           STA   VGC_CMD
00E912  3  60                 RTS
00E913  3               
00E913  3               ; Wait until the command busy bit clears.
00E913  3               ; @label VGC.WAIT_COMMAND
00E913  3               ; @kind routine
00E913  3               ; @symbol vgc_wait_cmd
00E913  3               ; @summary Wait for the active VGC command to complete.
00E913  3               vgc_wait_cmd:
00E913  3               @wait:
00E913  3  AD 10 A0           LDA   VGC_CMD
00E916  3  29 01              AND   #$01
00E918  3  D0 F9              BNE   @wait
00E91A  3  60                 RTS
00E91B  3               
00E91B  3               ; Input: A = VGC command. Issue and wait for completion.
00E91B  3               .ifndef VGC_NO_EXEC
00E91B  3               ; @label VGC.EXEC
00E91B  3               ; @kind routine
00E91B  3               ; @symbol vgc_exec
00E91B  3               ; @summary Issue a raw VGC command and wait for completion.
00E91B  3               ; @in A: VGC command byte.
00E91B  3               vgc_exec:
00E91B  3                     JSR   vgc_cmd
00E91B  3                     JMP   vgc_wait_cmd
00E91B  3               .endif
00E91B  3               
00E91B  3               ; Wait for the next frame counter tick.
00E91B  3               ; @label VGC.VSYNC
00E91B  3               ; @kind routine
00E91B  3               ; @symbol vgc_vsync
00E91B  3               ; @summary Wait until the VGC frame counter advances.
00E91B  3               ; @out A: Last observed frame counter value.
00E91B  3               vgc_vsync:
00E91B  3  AD 08 A0           LDA   VGC_FRAME
00E91E  3               @wait:
00E91E  3  CD 08 A0           CMP   VGC_FRAME
00E921  3  F0 FB              BEQ   @wait
00E923  3  60                 RTS
00E924  3               
00E924  3               ; @label VGC.CLS
00E924  3               ; @kind routine
00E924  3               ; @symbol vgc_cls
00E924  3               ; @summary Clear the text screen through the VGC character output register.
00E924  3               vgc_cls:
00E924  3  A9 0C              LDA   #$0C
00E926  3  8D 0E A0           STA   VGC_CHAROUT
00E929  3  60                 RTS
00E92A  3               
00E92A  3               ; @label VGC.SET_FG
00E92A  3               ; @kind routine
00E92A  3               ; @symbol vgc_set_fg
00E92A  3               ; @summary Set the current text foreground colour.
00E92A  3               ; @in X: Foreground colour byte.
00E92A  3               vgc_set_fg:
00E92A  3  8E 02 A0           STX   VGC_FGCOL
00E92D  3  60                 RTS
00E92E  3               
00E92E  3               ; @label VGC.SET_BG
00E92E  3               ; @kind routine
00E92E  3               ; @symbol vgc_set_bg
00E92E  3               ; @summary Set the current text background colour.
00E92E  3               ; @in X: Background colour byte.
00E92E  3               vgc_set_bg:
00E92E  3  8E 01 A0           STX   VGC_BGCOL
00E931  3  60                 RTS
00E932  3               
00E932  3               ; @label VGC.SET_BORDER
00E932  3               ; @kind routine
00E932  3               ; @symbol vgc_set_border
00E932  3               ; @summary Set the VGC border colour.
00E932  3               ; @in X: Border colour byte.
00E932  3               vgc_set_border:
00E932  3  8E 0D A0           STX   VGC_BORDER
00E935  3  60                 RTS
00E936  3               
00E936  3               ; @label VGC.LOCATE
00E936  3               ; @kind routine
00E936  3               ; @symbol vgc_locate
00E936  3               ; @summary Set the text cursor position from VGC.P0/VGC.P1.
00E936  3               ; @in VGC_P0: Cursor X column.
00E936  3               ; @in VGC_P1: Cursor Y row.
00E936  3               vgc_locate:
00E936  3  AD 11 A0           LDA   VGC_P0
00E939  3  8D 03 A0           STA   VGC_CURSX
00E93C  3  AD 12 A0           LDA   VGC_P1
00E93F  3  8D 04 A0           STA   VGC_CURSY
00E942  3  60                 RTS
00E943  3               
00E943  3               ; @label VGC.SET_MODE
00E943  3               ; @kind routine
00E943  3               ; @symbol vgc_set_mode
00E943  3               ; @summary Set the active VGC graphics/text mode.
00E943  3               ; @in X: Mode byte.
00E943  3               vgc_set_mode:
00E943  3  8E 00 A0           STX   VGC_MODE
00E946  3  60                 RTS
00E947  3               
00E947  3               ; @label VGC.SET_FONT
00E947  3               ; @kind routine
00E947  3               ; @symbol vgc_set_font
00E947  3               ; @summary Select the active text font slot.
00E947  3               ; @in X: Font slot, 0..7.
00E947  3               vgc_set_font:
00E947  3  8E 07 A0           STX   VGC_FONT
00E94A  3  60                 RTS
00E94B  3               
00E94B  3               ; @label VGC.MEM_READ
00E94B  3               ; @kind routine
00E94B  3               ; @symbol vgc_mem_read
00E94B  3               ; @summary Read one byte from VGC memory using VGC.P0..VGC.P4.
00E94B  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P4
00E94B  3               ; @out VGC_P3: Read byte.
00E94B  3               vgc_mem_read:
00E94B  3  A9 19              LDA   #VCMD_MEMREAD
00E94D  3  2C                 .byte $2C
00E94E  3               
00E94E  3               ; @label VGC.MEM_WRITE
00E94E  3               ; @kind routine
00E94E  3               ; @symbol vgc_mem_write
00E94E  3               ; @summary Write one byte to VGC memory using VGC.P0..VGC.P4.
00E94E  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4
00E94E  3               vgc_mem_write:
00E94E  3  A9 1A              LDA   #VCMD_MEMWRITE
00E950  3  8D 10 A0           STA   VGC_CMD
00E953  3  4C 13 E9           JMP   vgc_wait_cmd
00E956  3               
00E956  3               ; Enable reverse text by swapping the current foreground/background colours.
00E956  3               ; @label VGC.REVERSE
00E956  3               ; @kind routine
00E956  3               ; @symbol vgc_reverse_default
00E956  3               ; @summary Enable reverse text using the current foreground/background colours.
00E956  3               vgc_reverse_default:
00E956  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E959  3  29 FC              AND   #$FC
00E95B  3  09 01              ORA   #VTXT_REV
00E95D  3  8D E6 A0           STA   VGC_TXTFLAGS
00E960  3  60                 RTS
00E961  3               
00E961  3               ; Input: A = packed reverse attribute, low nibble fg and high nibble bg.
00E961  3               ; @label VGC.REVERSE_EXPLICIT
00E961  3               ; @kind routine
00E961  3               ; @symbol vgc_reverse_explicit
00E961  3               ; @summary Enable reverse text with explicit packed foreground/background colours.
00E961  3               ; @in A: Packed reverse attribute, low nibble foreground and high nibble background.
00E961  3               vgc_reverse_explicit:
00E961  3  8D E7 A0           STA   VGC_TXTREVATTR
00E964  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E967  3  29 FC              AND   #$FC
00E969  3  09 03              ORA   #(VTXT_REV | VTXT_REVEX)
00E96B  3  8D E6 A0           STA   VGC_TXTFLAGS
00E96E  3  60                 RTS
00E96F  3               
00E96F  3               ; @label VGC.REVERSE_OFF
00E96F  3               ; @kind routine
00E96F  3               ; @symbol vgc_reverse_off
00E96F  3               ; @summary Disable reverse text.
00E96F  3               vgc_reverse_off:
00E96F  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E972  3  29 FC              AND   #$FC
00E974  3  8D E6 A0           STA   VGC_TXTFLAGS
00E977  3  60                 RTS
00E978  3               
00E978  3               ; @label VGC.FLASH_ON
00E978  3               ; @kind routine
00E978  3               ; @symbol vgc_flash_on
00E978  3               ; @summary Enable flashing text.
00E978  3               vgc_flash_on:
00E978  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E97B  3  09 04              ORA   #VTXT_FLASH
00E97D  3  8D E6 A0           STA   VGC_TXTFLAGS
00E980  3  60                 RTS
00E981  3               
00E981  3               ; @label VGC.FLASH_OFF
00E981  3               ; @kind routine
00E981  3               ; @symbol vgc_flash_off
00E981  3               ; @summary Disable flashing text.
00E981  3               vgc_flash_off:
00E981  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E984  3  29 FB              AND   #$FB
00E986  3  8D E6 A0           STA   VGC_TXTFLAGS
00E989  3  60                 RTS
00E98A  3               
00E98A  3               .ifndef VGC_NO_PRIMITIVES
00E98A  3               ; @label VGC.GCLS
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_gcls
00E98A  3               ; @summary Issue the VGC graphics clear command.
00E98A  3               vgc_gcls:
00E98A  3                     LDA   #VCMD_GCLS
00E98A  3                     JMP   vgc_cmd
00E98A  3               
00E98A  3               ; @label VGC.GCOLOR
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_gcolor
00E98A  3               ; @summary Issue the VGC graphics colour command using VGC.P0/P1.
00E98A  3               ; @requires VGC_P0 VGC_P1
00E98A  3               vgc_gcolor:
00E98A  3                     LDA   #VCMD_GCOLOR
00E98A  3                     JMP   vgc_cmd
00E98A  3               
00E98A  3               ; @label VGC.PLOT
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_plot
00E98A  3               ; @summary Issue the VGC plot command using VGC.P0..VGC.P3.
00E98A  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E98A  3               vgc_plot:
00E98A  3                     LDA   #VCMD_PLOT
00E98A  3                     JMP   vgc_cmd
00E98A  3               
00E98A  3               ; @label VGC.UNPLOT
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_unplot
00E98A  3               ; @summary Issue the VGC unplot command using VGC.P0..VGC.P3.
00E98A  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E98A  3               vgc_unplot:
00E98A  3                     LDA   #VCMD_UNPLOT
00E98A  3                     JMP   vgc_cmd
00E98A  3               
00E98A  3               ; @label VGC.LINE
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_line
00E98A  3               ; @summary Issue the VGC line command using VGC.P0..VGC.P7.
00E98A  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E98A  3               vgc_line:
00E98A  3                     LDA   #VCMD_LINE
00E98A  3                     JMP   vgc_cmd
00E98A  3               
00E98A  3               ; @label VGC.CIRCLE
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_circle
00E98A  3               ; @summary Issue the VGC circle/ellipse command using VGC.P0..VGC.P7.
00E98A  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E98A  3               vgc_circle:
00E98A  3                     LDA   #VCMD_CIRCLE
00E98A  3                     JMP   vgc_cmd
00E98A  3               
00E98A  3               ; @label VGC.GTEXT
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_gtext
00E98A  3               ; @summary Issue the VGC graphics text command using VGC.P0..VGC.P5 and FIO.NAME.
00E98A  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 FIO_NAME FIO_NAMELEN
00E98A  3               vgc_gtext:
00E98A  3                     LDA   #VCMD_GTEXT
00E98A  3                     JMP   vgc_cmd
00E98A  3               
00E98A  3               ; @label VGC.RECT
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_rect
00E98A  3               ; @summary Issue the VGC rectangle command using VGC.P0..VGC.P7.
00E98A  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E98A  3               vgc_rect:
00E98A  3                     LDA   #VCMD_RECT
00E98A  3                     JMP   vgc_cmd
00E98A  3               
00E98A  3               ; @label VGC.FILL
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_fill
00E98A  3               ; @summary Issue the VGC filled rectangle command using VGC.P0..VGC.P7.
00E98A  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E98A  3               vgc_fill:
00E98A  3                     LDA   #VCMD_FILL
00E98A  3                     JMP   vgc_cmd
00E98A  3               
00E98A  3               ; @label VGC.PAINT
00E98A  3               ; @kind routine
00E98A  3               ; @symbol vgc_paint
00E98A  3               ; @summary Issue the VGC paint command using VGC.P0..VGC.P3.
00E98A  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E98A  3               vgc_paint:
00E98A  3                     LDA   #VCMD_PAINT
00E98A  3                     JMP   vgc_cmd
00E98A  3               .endif
00E98A  3               
00E98A  3               .endif
00E98A  3               
00E98A  2                     .include "lib/sprite.s"
00E98A  3               ; Shared Nova sprite helper routines.
00E98A  3               ;
00E98A  3               ; Assembly callers can load VGC_P* and call the command helpers, or use the
00E98A  3               ; direct register helpers for the VGC sprite attribute block.
00E98A  3               
00E98A  3               .include "sprite.inc"
00E98A  4               ; Shared Nova sprite helper declarations.
00E98A  4               ;
00E98A  4               ; Command helpers use VGC_P* registers directly. Direct sprite-register helpers
00E98A  4               ; use the public sprite attribute register block at VGC_SPR_BASE.
00E98A  4               
00E98A  4               .ifndef SPRITE_INC_INCLUDED
00E98A  4               SPRITE_INC_INCLUDED = 1
00E98A  4               
00E98A  4               .include "vgc.inc"
00E98A  5               ; Shared Nova VGC helper declarations.
00E98A  5               ;
00E98A  5               ; The command helpers use the VGC hardware parameter registers directly:
00E98A  5               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
00E98A  5               ; Routines return through the hardware status model; command completion can be
00E98A  5               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
00E98A  5               
00E98A  5               .ifndef VGC_INC_INCLUDED
00E98A  5               VGC_INC_INCLUDED = 1
00E98A  5               
00E98A  5               .include "nova.inc"
00E98A  5               
00E98A  5               VGC_RESULT_OK    = $00
00E98A  5               VGC_RESULT_ERROR = $01
00E98A  5               
00E98A  5               .endif
00E98A  5               
00E98A  4               
00E98A  4               SPRITE_RESULT_OK    = $00
00E98A  4               SPRITE_RESULT_ERROR = $01
00E98A  4               
00E98A  4               .endif
00E98A  4               
00E98A  3               
00E98A  3               .ifndef SPRITE_IMPLEMENTATION_INCLUDED
00E98A  3               SPRITE_IMPLEMENTATION_INCLUDED = 1
00E98A  3               
00E98A  3                     .segment "CODE"
00E98A  3               
00E98A  3                     .export sprite_command
00E98A  3                     .export sprite_pos
00E98A  3                     .export sprite_enable
00E98A  3                     .export sprite_disable
00E98A  3                     .export sprite_row
00E98A  3               .ifndef SPRITE_NO_EXTRA
00E98A  3                     .export sprite_clear
00E98A  3                     .export sprite_copy
00E98A  3                     .export sprite_flip
00E98A  3                     .export sprite_priority
00E98A  3               .endif
00E98A  3                     .export sprite_reg_offset
00E98A  3                     .export sprite_set_shape
00E98A  3                     .export sprite_set_reg8
00E98A  3                     .export sprite_set_reg16
00E98A  3                     .export sprite_get_x
00E98A  3                     .export sprite_get_y
00E98A  3                     .export sprite_collision_status
00E98A  3                     .export sprite_background_collision_status
00E98A  3               
00E98A  3               ; Input: A = sprite VGC command. Does not wait for completion.
00E98A  3               ; @label SPRITE.COMMAND
00E98A  3               ; @kind routine
00E98A  3               ; @symbol sprite_command
00E98A  3               ; @summary Issue a raw sprite VGC command without waiting for completion.
00E98A  3               ; @in A: VGC sprite command byte.
00E98A  3               sprite_command:
00E98A  3  8D 10 A0           STA   VGC_CMD
00E98D  3  60                 RTS
00E98E  3               
00E98E  3               ; Command wrappers. Callers load VGC_P* per the hardware command ABI.
00E98E  3               ; @label SPRITE.POS
00E98E  3               ; @kind routine
00E98E  3               ; @symbol sprite_pos
00E98E  3               ; @summary Move a sprite using VGC.P0=sprite, VGC.P1/P2=x, VGC.P3=y.
00E98E  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E98E  3               sprite_pos:
00E98E  3  A9 14              LDA   #VCMD_SPRPOS
00E990  3  4C 8A E9           JMP   sprite_command
00E993  3               
00E993  3               ; @label SPRITE.ENABLE
00E993  3               ; @kind routine
00E993  3               ; @symbol sprite_enable
00E993  3               ; @summary Enable the sprite in VGC.P0.
00E993  3               ; @requires VGC_P0
00E993  3               sprite_enable:
00E993  3  A9 15              LDA   #VCMD_SPRENA
00E995  3  4C 8A E9           JMP   sprite_command
00E998  3               
00E998  3               ; @label SPRITE.DISABLE
00E998  3               ; @kind routine
00E998  3               ; @symbol sprite_disable
00E998  3               ; @summary Disable the sprite in VGC.P0.
00E998  3               ; @requires VGC_P0
00E998  3               sprite_disable:
00E998  3  A9 16              LDA   #VCMD_SPRDIS
00E99A  3  4C 8A E9           JMP   sprite_command
00E99D  3               
00E99D  3               ; @label SPRITE.ROW
00E99D  3               ; @kind routine
00E99D  3               ; @symbol sprite_row
00E99D  3               ; @summary Write one sprite bitmap row using VGC.P0..VGC.P9.
00E99D  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7 VGC_P8 VGC_P9
00E99D  3               sprite_row:
00E99D  3  A9 11              LDA   #VCMD_SPRROW
00E99F  3  4C 8A E9           JMP   sprite_command
00E9A2  3               
00E9A2  3               .ifndef SPRITE_NO_EXTRA
00E9A2  3               sprite_clear:
00E9A2  3                     LDA   #VCMD_SPRCLR
00E9A2  3                     JMP   sprite_command
00E9A2  3               
00E9A2  3               sprite_copy:
00E9A2  3                     LDA   #VCMD_SPRCOPY
00E9A2  3                     JMP   sprite_command
00E9A2  3               
00E9A2  3               sprite_flip:
00E9A2  3                     LDA   #VCMD_SPRFLIP
00E9A2  3                     JMP   sprite_command
00E9A2  3               
00E9A2  3               sprite_priority:
00E9A2  3                     LDA   #VCMD_SPRPRI
00E9A2  3                     JMP   sprite_command
00E9A2  3               .endif
00E9A2  3               
00E9A2  3               ; Input: X = sprite index, Y = sprite register field offset.
00E9A2  3               ; Output: Y = VGC_SPR_BASE-relative register offset.
00E9A2  3               ; Clobbers: A, NVR7L.
00E9A2  3               ; @label SPRITE.REG_OFFSET
00E9A2  3               ; @kind routine
00E9A2  3               ; @symbol sprite_reg_offset
00E9A2  3               ; @summary Compute the VGC sprite attribute block offset for a sprite field.
00E9A2  3               ; @in X: Sprite index.
00E9A2  3               ; @in Y: Sprite field offset.
00E9A2  3               ; @out Y: VGC_SPR_BASE-relative byte offset.
00E9A2  3               sprite_reg_offset:
00E9A2  3  84 2E              STY   NVR7L
00E9A4  3  8A                 TXA
00E9A5  3  0A                 ASL
00E9A6  3  0A                 ASL
00E9A7  3  0A                 ASL
00E9A8  3  18                 CLC
00E9A9  3  65 2E              ADC   NVR7L
00E9AB  3  A8                 TAY
00E9AC  3  60                 RTS
00E9AD  3               
00E9AD  3               ; Input: X = sprite index, A = shape.
00E9AD  3               ; @label SPRITE.SET_SHAPE
00E9AD  3               ; @kind routine
00E9AD  3               ; @symbol sprite_set_shape
00E9AD  3               ; @summary Set a sprite's shape index.
00E9AD  3               ; @in X: Sprite index.
00E9AD  3               ; @in A: Shape index.
00E9AD  3               sprite_set_shape:
00E9AD  3  A0 04              LDY   #VGC_SPR_SHAPE_OFF
00E9AF  3                     ; fall through
00E9AF  3               
00E9AF  3               ; Input: X = sprite index, Y = field offset, A = value.
00E9AF  3               ; Clobbers: A, Y, NVR7L/NVR7H.
00E9AF  3               ; @label SPRITE.SET_REG8
00E9AF  3               ; @kind routine
00E9AF  3               ; @symbol sprite_set_reg8
00E9AF  3               ; @summary Write one 8-bit sprite attribute field.
00E9AF  3               ; @in X: Sprite index.
00E9AF  3               ; @in Y: Sprite field offset.
00E9AF  3               ; @in A: Field value.
00E9AF  3               sprite_set_reg8:
00E9AF  3  85 2F              STA   NVR7H
00E9B1  3  20 A2 E9           JSR   sprite_reg_offset
00E9B4  3  A5 2F              LDA   NVR7H
00E9B6  3  99 40 A0           STA   VGC_SPR_BASE,Y
00E9B9  3  60                 RTS
00E9BA  3               
00E9BA  3               ; Input: X = sprite index, Y = field offset, NVR0L/NVR0H = little-endian value.
00E9BA  3               ; Clobbers: A, Y, NVR7L.
00E9BA  3               ; @label SPRITE.SET_REG16
00E9BA  3               ; @kind routine
00E9BA  3               ; @symbol sprite_set_reg16
00E9BA  3               ; @summary Write one 16-bit sprite attribute field.
00E9BA  3               ; @in X: Sprite index.
00E9BA  3               ; @in Y: Sprite field offset.
00E9BA  3               ; @in NVR0L: Low byte.
00E9BA  3               ; @in NVR0H: High byte.
00E9BA  3               sprite_set_reg16:
00E9BA  3  20 A2 E9           JSR   sprite_reg_offset
00E9BD  3  A5 20              LDA   NVR0L
00E9BF  3  99 40 A0           STA   VGC_SPR_BASE,Y
00E9C2  3  C8                 INY
00E9C3  3  A5 21              LDA   NVR0H
00E9C5  3  99 40 A0           STA   VGC_SPR_BASE,Y
00E9C8  3  60                 RTS
00E9C9  3               
00E9C9  3               ; Input: X = sprite index. Output: A = X high byte, Y = X low byte.
00E9C9  3               ; @label SPRITE.GET_X
00E9C9  3               ; @kind routine
00E9C9  3               ; @symbol sprite_get_x
00E9C9  3               ; @summary Read a sprite's 16-bit X coordinate.
00E9C9  3               ; @in X: Sprite index.
00E9C9  3               ; @out A: X high byte.
00E9C9  3               ; @out Y: X low byte.
00E9C9  3               sprite_get_x:
00E9C9  3  A0 00              LDY   #VGC_SPR_XL_OFF
00E9CB  3  20 A2 E9           JSR   sprite_reg_offset
00E9CE  3  B9 40 A0           LDA   VGC_SPR_BASE,Y
00E9D1  3  85 2E              STA   NVR7L
00E9D3  3  C8                 INY
00E9D4  3  B9 40 A0           LDA   VGC_SPR_BASE,Y
00E9D7  3  A4 2E              LDY   NVR7L
00E9D9  3  60                 RTS
00E9DA  3               
00E9DA  3               ; Input: X = sprite index. Output: Y = Y low byte.
00E9DA  3               ; @label SPRITE.GET_Y
00E9DA  3               ; @kind routine
00E9DA  3               ; @symbol sprite_get_y
00E9DA  3               ; @summary Read a sprite's Y coordinate.
00E9DA  3               ; @in X: Sprite index.
00E9DA  3               ; @out Y: Y coordinate byte.
00E9DA  3               sprite_get_y:
00E9DA  3  A0 02              LDY   #VGC_SPR_YL_OFF
00E9DC  3  20 A2 E9           JSR   sprite_reg_offset
00E9DF  3  B9 40 A0           LDA   VGC_SPR_BASE,Y
00E9E2  3  A8                 TAY
00E9E3  3  60                 RTS
00E9E4  3               
00E9E4  3               ; @label SPRITE.COLLISION_STATUS
00E9E4  3               ; @kind routine
00E9E4  3               ; @symbol sprite_collision_status
00E9E4  3               ; @summary Read the sprite-sprite collision status register.
00E9E4  3               ; @out A: Collision status byte.
00E9E4  3               sprite_collision_status:
00E9E4  3  AD 0B A0           LDA   VGC_COLLST
00E9E7  3  60                 RTS
00E9E8  3               
00E9E8  3               ; @label SPRITE.BACKGROUND_STATUS
00E9E8  3               ; @kind routine
00E9E8  3               ; @symbol sprite_background_collision_status
00E9E8  3               ; @summary Read the sprite-background collision status register.
00E9E8  3               ; @out A: Background collision status byte.
00E9E8  3               sprite_background_collision_status:
00E9E8  3  AD 0C A0           LDA   VGC_COLLBG
00E9EB  3  60                 RTS
00E9EC  3               
00E9EC  3               .endif
00E9EC  3               
00E9EC  2               
00E9EC  2               LAB_VGC_CMD_RTS = vgc_cmd
00E9EC  2               LAB_VSYNC       = vgc_vsync
00E9EC  2               
00E9EC  2               ; perform CLS — clear screen, no arguments
00E9EC  2               
00E9EC  2               LAB_CLS
00E9EC  2  4C 24 E9           JMP   vgc_cls
00E9EF  2               
00E9EF  2               ; perform COLOR fg [,bg [,border]]
00E9EF  2               
00E9EF  2               LAB_COLOR
00E9EF  2  20 B1 D8           JSR   LAB_GTBY          ; get fg color byte in X
00E9F2  2  20 2A E9           JSR   vgc_set_fg        ; store foreground color
00E9F5  2  20 C2 00           JSR   LAB_GBYT          ; peek at current byte
00E9F8  2  C9 2C              CMP   #','              ; comma follows?
00E9FA  2  D0 19              BNE   @done             ; no, just fg was given
00E9FC  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00E9FF  2  20 B1 D8           JSR   LAB_GTBY          ; get bg color byte in X
00EA02  2  20 2E E9           JSR   vgc_set_bg        ; store background color
00EA05  2  20 C2 00           JSR   LAB_GBYT          ; peek for optional border color
00EA08  2  C9 2C              CMP   #','              ; second comma follows?
00EA0A  2  D0 09              BNE   @done             ; no, fg/bg only
00EA0C  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00EA0F  2  20 B1 D8           JSR   LAB_GTBY          ; get border color byte in X
00EA12  2  20 32 E9           JSR   vgc_set_border    ; store border color
00EA15  2               @done
00EA15  2  60                 RTS
00EA16  2               
00EA16  2               ; perform REVERSE [fg,bg]
00EA16  2               
00EA16  2               LAB_REVERSE
00EA16  2  20 C2 00           JSR   LAB_GBYT          ; optional explicit reverse colours?
00EA19  2  F0 20              BEQ   @swap
00EA1B  2  C9 3A              CMP   #':'              ; no args before next statement
00EA1D  2  F0 1C              BEQ   @swap
00EA1F  2  20 B1 D8           JSR   LAB_GTBY          ; reverse foreground in X
00EA22  2  8A                 TXA
00EA23  2  29 0F              AND   #$0F
00EA25  2  48                 PHA
00EA26  2  20 09 CE           JSR   LAB_1C01          ; comma
00EA29  2  20 B1 D8           JSR   LAB_GTBY          ; reverse background in X
00EA2C  2  8A                 TXA
00EA2D  2  29 0F              AND   #$0F
00EA2F  2  0A                 ASL
00EA30  2  0A                 ASL
00EA31  2  0A                 ASL
00EA32  2  0A                 ASL
00EA33  2  85 78              STA   TempB
00EA35  2  68                 PLA
00EA36  2  05 78              ORA   TempB
00EA38  2  4C 61 E9           JMP   vgc_reverse_explicit
00EA3B  2               @swap
00EA3B  2  4C 56 E9           JMP   vgc_reverse_default
00EA3E  2               
00EA3E  2               ; perform REVERSEOFF
00EA3E  2               
00EA3E  2               LAB_REVERSEOFF
00EA3E  2  4C 6F E9           JMP   vgc_reverse_off
00EA41  2               
00EA41  2               ; perform FLASH
00EA41  2               
00EA41  2               LAB_FLASH
00EA41  2  4C 78 E9           JMP   vgc_flash_on
00EA44  2               
00EA44  2               ; perform FLASHOFF
00EA44  2               
00EA44  2               LAB_FLASHOFF
00EA44  2  4C 81 E9           JMP   vgc_flash_off
00EA47  2               
00EA47  2               ; perform VPOKE plane,addr,value — write a byte to VGC memory
00EA47  2               
00EA47  2               LAB_VPOKE
00EA47  2  20 B1 D8           JSR   LAB_GTBY
00EA4A  2  8E 11 A0           STX   VGC_P0
00EA4D  2  20 09 CE           JSR   LAB_1C01
00EA50  2  20 9F D8           JSR   LAB_GTWRD
00EA53  2  A5 AF              LDA   FAC1_3
00EA55  2  8D 12 A0           STA   VGC_P1
00EA58  2  A5 AE              LDA   FAC1_2
00EA5A  2  8D 13 A0           STA   VGC_P2
00EA5D  2  20 09 CE           JSR   LAB_1C01
00EA60  2  20 B1 D8           JSR   LAB_GTBY
00EA63  2  8E 14 A0           STX   VGC_P3
00EA66  2  9C 15 A0           STZ   VGC_P4
00EA69  2  4C 4E E9           JMP   vgc_mem_write
00EA6C  2               
00EA6C  2               ; perform LOCATE x, y
00EA6C  2               
00EA6C  2               LAB_LOCATE
00EA6C  2  20 B1 D8           JSR   LAB_GTBY          ; get x in X
00EA6F  2  8E 11 A0           STX   VGC_P0            ; store cursor X
00EA72  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EA75  2  20 B1 D8           JSR   LAB_GTBY          ; get y in X
00EA78  2  8E 12 A0           STX   VGC_P1            ; store cursor Y
00EA7B  2  4C 36 E9           JMP   vgc_locate
00EA7E  2               
00EA7E  2               ; perform MODE n
00EA7E  2               
00EA7E  2               LAB_GMODE
00EA7E  2  20 B1 D8           JSR   LAB_GTBY          ; get mode byte in X
00EA81  2  4C 43 E9           JMP   vgc_set_mode
00EA84  2               
00EA84  2               ; perform FONT n — select active font slot (0-7)
00EA84  2               
00EA84  2               LAB_FONT
00EA84  2  20 B1 D8           JSR   LAB_GTBY          ; get font index byte (0-7) in X
00EA87  2  4C 47 E9           JMP   vgc_set_font
00EA8A  2               
00EA8A  2               ; perform GCLS — clear the graphics bitmap layer
00EA8A  2               
00EA8A  2               LAB_GCLS
00EA8A  2  20 1B E9           JSR   LAB_VSYNC         ; BASIC hides visible VGC draw tearing
00EA8D  2  A9 07              LDA   #VCMD_GCLS        ; GCLS command
00EA8F  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EA92  2               
00EA92  2               ; perform GCOLOR c — set graphics draw color (0-15)
00EA92  2               
00EA92  2               LAB_GCOLOR
00EA92  2  20 B1 D8           JSR   LAB_GTBY          ; get color byte in X
00EA95  2  8E 11 A0           STX   VGC_P0             ; color in P0
00EA98  2  9C 12 A0           STZ   VGC_P1             ; high byte = 0
00EA9B  2  A9 08              LDA   #VCMD_GCOLOR      ; GCOLOR command
00EA9D  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EAA0  2               
00EAA0  2               ; shared: load x(word),y(byte) into VGC_P0-P3
00EAA0  2               
00EAA0  2               LAB_VGC_XY
00EAA0  2  20 9F D8           JSR   LAB_GTWRD         ; get x as 16-bit
00EAA3  2  A5 AF              LDA   FAC1_3
00EAA5  2  8D 11 A0           STA   VGC_P0             ; x low
00EAA8  2  A5 AE              LDA   FAC1_2
00EAAA  2  8D 12 A0           STA   VGC_P1             ; x high
00EAAD  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EAB0  2  20 B1 D8           JSR   LAB_GTBY          ; get y as byte
00EAB3  2  8E 13 A0           STX   VGC_P2             ; y low
00EAB6  2  9C 14 A0           STZ   VGC_P3             ; y high = 0
00EAB9  2  60                 RTS
00EABA  2               
00EABA  2               ; shared: load x0,y0,x1,y1 into VGC_P0-P7
00EABA  2               
00EABA  2               LAB_VGC_XYXY
00EABA  2  20 A0 EA           JSR   LAB_VGC_XY        ; x0,y0 → P0-P3
00EABD  2  20 09 CE           JSR   LAB_1C01          ; comma
00EAC0  2  20 9F D8           JSR   LAB_GTWRD         ; x1 as 16-bit
00EAC3  2  A5 AF              LDA   FAC1_3
00EAC5  2  8D 15 A0           STA   VGC_P4             ; x1 low
00EAC8  2  A5 AE              LDA   FAC1_2
00EACA  2  8D 16 A0           STA   VGC_P5             ; x1 high
00EACD  2  20 09 CE           JSR   LAB_1C01          ; comma
00EAD0  2  20 B1 D8           JSR   LAB_GTBY          ; y1
00EAD3  2  8E 17 A0           STX   VGC_P6             ; y1 low
00EAD6  2  9C 18 A0           STZ   VGC_P7             ; y1 high = 0
00EAD9  2  60                 RTS
00EADA  2               
00EADA  2               ; perform PLOT x, y
00EADA  2               
00EADA  2               LAB_PLOT
00EADA  2  20 A0 EA           JSR   LAB_VGC_XY
00EADD  2  20 1B E9           JSR   LAB_VSYNC         ; wait before visible graphics mutation
00EAE0  2  A9 01              LDA   #VCMD_PLOT        ; PLOT command
00EAE2  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EAE5  2               
00EAE5  2               ; perform UNPLOT x, y
00EAE5  2               
00EAE5  2               LAB_UNPLOT
00EAE5  2  20 A0 EA           JSR   LAB_VGC_XY
00EAE8  2  20 1B E9           JSR   LAB_VSYNC
00EAEB  2  A9 02              LDA   #VCMD_UNPLOT      ; UNPLOT command
00EAED  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EAF0  2               
00EAF0  2               ; perform LINE x0, y0, x1, y1
00EAF0  2               
00EAF0  2               LAB_GLINE
00EAF0  2  20 BA EA           JSR   LAB_VGC_XYXY
00EAF3  2  20 1B E9           JSR   LAB_VSYNC
00EAF6  2  A9 03              LDA   #VCMD_LINE        ; LINE command
00EAF8  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EAFB  2               
00EAFB  2               ; perform CIRCLE cx, cy, rx [, ry]
00EAFB  2               ; 3 args = circle (rx=ry), 4 args = ellipse
00EAFB  2               
00EAFB  2               LAB_CIRCLE
00EAFB  2  20 A0 EA           JSR   LAB_VGC_XY        ; cx,cy → P0-P3
00EAFE  2  20 09 CE           JSR   LAB_1C01          ; comma
00EB01  2  20 9F D8           JSR   LAB_GTWRD         ; rx as 16-bit
00EB04  2  A5 AF              LDA   FAC1_3
00EB06  2  8D 15 A0           STA   VGC_P4             ; rx low
00EB09  2  A5 AE              LDA   FAC1_2
00EB0B  2  8D 16 A0           STA   VGC_P5             ; rx high
00EB0E  2  9C 17 A0           STZ   VGC_P6             ; ry low = 0 (circle)
00EB11  2  9C 18 A0           STZ   VGC_P7             ; ry high = 0
00EB14  2  20 C2 00           JSR   LAB_GBYT          ; peek next
00EB17  2  C9 2C              CMP   #','
00EB19  2  D0 10              BNE   @circ_go
00EB1B  2  20 09 CE           JSR   LAB_1C01          ; consume comma
00EB1E  2  20 9F D8           JSR   LAB_GTWRD         ; ry as 16-bit
00EB21  2  A5 AF              LDA   FAC1_3
00EB23  2  8D 17 A0           STA   VGC_P6             ; ry low
00EB26  2  A5 AE              LDA   FAC1_2
00EB28  2  8D 18 A0           STA   VGC_P7             ; ry high
00EB2B  2               @circ_go
00EB2B  2  20 1B E9           JSR   LAB_VSYNC
00EB2E  2  A9 04              LDA   #VCMD_CIRCLE      ; CIRCLE command
00EB30  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EB33  2               
00EB33  2               ; perform GTEXT x, y, font, scale, "string"
00EB33  2               
00EB33  2               LAB_GTEXT
00EB33  2  20 A0 EA           JSR   LAB_VGC_XY        ; x,y → P0-P3
00EB36  2  20 09 CE           JSR   LAB_1C01          ; comma
00EB39  2  20 B1 D8           JSR   LAB_GTBY          ; font (0-7) → X
00EB3C  2  8E 15 A0           STX   VGC_P4             ; P4 = font index
00EB3F  2  20 09 CE           JSR   LAB_1C01          ; comma
00EB42  2  20 B1 D8           JSR   LAB_GTBY          ; scale (1-8) → X
00EB45  2  8E 16 A0           STX   VGC_P5             ; P5 = scale
00EB48  2  20 09 CE           JSR   LAB_1C01          ; comma
00EB4B  2  20 44 F2           JSR   LAB_FIO_GETNAME   ; string → FIO_NAME/FIO_NAMELEN
00EB4E  2  20 1B E9           JSR   LAB_VSYNC
00EB51  2  A9 0A              LDA   #VCMD_GTEXT
00EB53  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EB56  2               
00EB56  2               ; ── Tile engine BASIC commands ────────────────────────────────
00EB56  2               ; Full tile command parsing lives in the extension ROM and dispatches through
00EB56  2               ; the shared tile library.
00EB56  2               
00EB56  2               LAB_TILESIZE
00EB56  2  A9 11              LDA   #EXT_CMD_TILESIZE
00EB58  2  4C 21 02           JMP   EXT_vec
00EB5B  2               LAB_MIRROR
00EB5B  2  A9 12              LDA   #EXT_CMD_TMIRROR
00EB5D  2  4C 21 02           JMP   EXT_vec
00EB60  2               LAB_TTRANS
00EB60  2  A9 13              LDA   #EXT_CMD_TTRANS
00EB62  2  4C 21 02           JMP   EXT_vec
00EB65  2               LAB_TDEF
00EB65  2  A9 14              LDA   #EXT_CMD_TDEF
00EB67  2  4C 21 02           JMP   EXT_vec
00EB6A  2               LAB_TPUT
00EB6A  2  A9 15              LDA   #EXT_CMD_TPUT
00EB6C  2  4C 21 02           JMP   EXT_vec
00EB6F  2               LAB_TATTR
00EB6F  2  A9 16              LDA   #EXT_CMD_TATTR
00EB71  2  4C 21 02           JMP   EXT_vec
00EB74  2               LAB_TFILL
00EB74  2  A9 17              LDA   #EXT_CMD_TFILL
00EB76  2  4C 21 02           JMP   EXT_vec
00EB79  2               LAB_TCLS
00EB79  2  A9 1B              LDA   #EXT_CMD_TCLS
00EB7B  2  4C 21 02           JMP   EXT_vec
00EB7E  2               LAB_TSCROLL
00EB7E  2  A9 20              LDA   #EXT_CMD_TSCROLL
00EB80  2  4C 21 02           JMP   EXT_vec
00EB83  2               LAB_TPAL
00EB83  2  A9 21              LDA   #EXT_CMD_TPAL
00EB85  2  4C 21 02           JMP   EXT_vec
00EB88  2               LAB_TPALC
00EB88  2  A9 22              LDA   #EXT_CMD_TPALC
00EB8A  2  4C 21 02           JMP   EXT_vec
00EB8D  2               
00EB8D  2               ; perform RECT x0, y0, x1, y1
00EB8D  2               
00EB8D  2               LAB_RECT
00EB8D  2  20 BA EA           JSR   LAB_VGC_XYXY
00EB90  2  20 1B E9           JSR   LAB_VSYNC
00EB93  2  A9 05              LDA   #VCMD_RECT        ; RECT command
00EB95  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EB98  2               
00EB98  2               ; perform FILL x0, y0, x1, y1
00EB98  2               
00EB98  2               LAB_FILLRECT
00EB98  2  20 BA EA           JSR   LAB_VGC_XYXY
00EB9B  2  20 1B E9           JSR   LAB_VSYNC
00EB9E  2  A9 06              LDA   #VCMD_FILL        ; FILL command
00EBA0  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EBA3  2               
00EBA3  2               ; perform PAINT x, y
00EBA3  2               
00EBA3  2               LAB_PAINT
00EBA3  2  20 A0 EA           JSR   LAB_VGC_XY
00EBA6  2  20 1B E9           JSR   LAB_VSYNC
00EBA9  2  A9 09              LDA   #VCMD_PAINT       ; PAINT command
00EBAB  2  4C 0F E9           JMP   LAB_VGC_CMD_RTS
00EBAE  2               
00EBAE  2               ; perform SPRITE n, ON/OFF  or  SPRITE n, x, y
00EBAE  2               ; sprite number 0-15, ON/OFF enables/disables, x,y sets position
00EBAE  2               ; Uses command-driven VGC interface:
00EBAE  2               ;   SPRENA ($15): P0=sprite
00EBAE  2               ;   SPRDIS ($16): P0=sprite
00EBAE  2               ;   SPRPOS ($14): P0=sprite, P1=x_low, P2=x_high, P3=y_low, P4 reserved
00EBAE  2               
00EBAE  2               LAB_SPRCMD
00EBAE  2  20 B1 D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EBB1  2  86 11              STX   Itempl            ; save sprite number
00EBB3  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EBB6  2  20 C2 00           JSR   LAB_GBYT          ; peek at next token
00EBB9  2  C9 93              CMP   #TK_ON            ; is it ON?
00EBBB  2  F0 25              BEQ   @spr_on
00EBBD  2  C9 CB              CMP   #TK_OFF           ; is it OFF?
00EBBF  2  F0 2C              BEQ   @spr_off
00EBC1  2                     ; not ON/OFF — parse x, y position
00EBC1  2  A5 11              LDA   Itempl            ; get sprite number
00EBC3  2  8D 11 A0           STA   VGC_P0             ; P0 = sprite index
00EBC6  2  20 9F D8           JSR   LAB_GTWRD         ; get unsigned x as 16-bit
00EBC9  2  A5 AF              LDA   FAC1_3
00EBCB  2  8D 12 A0           STA   VGC_P1             ; P1 = x low
00EBCE  2  A5 AE              LDA   FAC1_2
00EBD0  2  8D 13 A0           STA   VGC_P2             ; P2 = x high
00EBD3  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EBD6  2  20 B1 D8           JSR   LAB_GTBY          ; get unsigned y byte
00EBD9  2  8E 14 A0           STX   VGC_P3             ; P3 = y
00EBDC  2  9C 15 A0           STZ   VGC_P4             ; P4 reserved
00EBDF  2  4C 8E E9           JMP   sprite_pos         ; trigger and return
00EBE2  2               
00EBE2  2               @spr_on
00EBE2  2  20 BC 00           JSR   LAB_IGBY          ; consume the ON token
00EBE5  2  A5 11              LDA   Itempl            ; get sprite number
00EBE7  2  8D 11 A0           STA   VGC_P0             ; P0 = sprite index
00EBEA  2  4C 93 E9           JMP   sprite_enable      ; trigger and return
00EBED  2               
00EBED  2               @spr_off
00EBED  2  20 BC 00           JSR   LAB_IGBY          ; consume the OFF token
00EBF0  2  A5 11              LDA   Itempl            ; get sprite number
00EBF2  2  8D 11 A0           STA   VGC_P0             ; P0 = sprite index
00EBF5  2  4C 98 E9           JMP   sprite_disable     ; trigger and return
00EBF8  2               
00EBF8  2               ; perform SPRITESHAPE n, shape
00EBF8  2               ; Writes shape index to sprite register VGC_SPR_SHAPE + n*8
00EBF8  2               
00EBF8  2               LAB_SPRSHAPE
00EBF8  2  20 B1 D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EBFB  2  86 11              STX   Itempl
00EBFD  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EC00  2  20 B1 D8           JSR   LAB_GTBY          ; get shape index in X
00EC03  2  8A                 TXA
00EC04  2  A6 11              LDX   Itempl
00EC06  2  4C AD E9           JMP   sprite_set_shape
00EC09  2               
00EC09  2               ; perform SPRITESET sprite, field, value — set sprite register
00EC09  2               ; Field 0 (X) accepts an unsigned word and writes lo+hi bytes.
00EC09  2               ; Field 2 (Y) and all other fields accept a byte value.
00EC09  2               ; Hardware vblank-buffers sprite attribute writes; software writes immediately.
00EC09  2               
00EC09  2               LAB_SPRCOLOR
00EC09  2  20 B1 D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EC0C  2  86 11              STX   Itempl            ; save sprite number
00EC0E  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EC11  2  20 B1 D8           JSR   LAB_GTBY          ; get field (0-7) in X
00EC14  2  86 12              STX   Itemph            ; save field number
00EC16  2  20 09 CE           JSR   LAB_1C01          ; require comma
00EC19  2  A5 12              LDA   Itemph            ; check field number
00EC1B  2  F0 0B              BEQ   @word_val
00EC1D  2                     ; --- byte field: parse byte value ---
00EC1D  2  20 B1 D8           JSR   LAB_GTBY          ; get value (0-255) in X
00EC20  2  8A                 TXA                     ; A = value
00EC21  2  A6 11              LDX   Itempl            ; X = sprite number
00EC23  2  A4 12              LDY   Itemph            ; Y = field
00EC25  2  4C AF E9           JMP   sprite_set_reg8
00EC28  2               @word_val
00EC28  2                     ; --- word field: parse unsigned word, write lo+hi ---
00EC28  2  20 9F D8           JSR   LAB_GTWRD         ; get unsigned 16-bit value, lo in FAC1_3, hi in FAC1_2
00EC2B  2  A5 AF              LDA   FAC1_3
00EC2D  2  85 20              STA   NVR0L
00EC2F  2  A5 AE              LDA   FAC1_2
00EC31  2  85 21              STA   NVR0H
00EC33  2  A6 11              LDX   Itempl            ; X = sprite number
00EC35  2  A4 12              LDY   Itemph            ; Y = field
00EC37  2  4C BA E9           JMP   sprite_set_reg16
00EC3A  2               
00EC3A  2               ; perform SPRITEDATA sprite, row, b1, b2 [, b3 [, b4 [, b5 [, b6 [, b7 [, b8]]]]]]
00EC3A  2               ; Uses CmdSprRow ($11): P0=sprite, P1=row, P2-P9=8 bytes of row data.
00EC3A  2               ; Unprovided bytes are zeroed.
00EC3A  2               
00EC3A  2               LAB_SPRDATA
00EC3A  2  20 B1 D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EC3D  2  8E 11 A0           STX   VGC_P0             ; P0 = sprite index
00EC40  2  20 09 CE           JSR   LAB_1C01          ; comma
00EC43  2  20 B1 D8           JSR   LAB_GTBY          ; get row (0-15) in X
00EC46  2  8E 12 A0           STX   VGC_P1             ; P1 = row
00EC49  2                     ; zero all 8 data bytes first
00EC49  2  9C 13 A0           STZ   VGC_P2
00EC4C  2  9C 14 A0           STZ   VGC_P3
00EC4F  2  9C 15 A0           STZ   VGC_P4
00EC52  2  9C 16 A0           STZ   VGC_P5
00EC55  2  9C 17 A0           STZ   VGC_P6
00EC58  2  9C 18 A0           STZ   VGC_P7
00EC5B  2  9C 19 A0           STZ   VGC_P8
00EC5E  2  9C 1A A0           STZ   VGC_P9
00EC61  2                     ; parse b1 (required)
00EC61  2  20 09 CE           JSR   LAB_1C01          ; comma
00EC64  2  20 B1 D8           JSR   LAB_GTBY          ; b1 → X
00EC67  2  8E 13 A0           STX   VGC_P2
00EC6A  2                     ; parse b2 (required)
00EC6A  2  20 09 CE           JSR   LAB_1C01          ; comma
00EC6D  2  20 B1 D8           JSR   LAB_GTBY          ; b2 → X
00EC70  2  8E 14 A0           STX   VGC_P3
00EC73  2                     ; parse optional b3-b8
00EC73  2  20 C2 00           JSR   LAB_GBYT
00EC76  2  C9 2C              CMP   #','
00EC78  2  D0 59              BNE   @sd_done
00EC7A  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00EC7D  2  20 B1 D8           JSR   LAB_GTBY          ; b3 → X
00EC80  2  8E 15 A0           STX   VGC_P4
00EC83  2  20 C2 00           JSR   LAB_GBYT
00EC86  2  C9 2C              CMP   #','
00EC88  2  D0 49              BNE   @sd_done
00EC8A  2  20 BC 00           JSR   LAB_IGBY
00EC8D  2  20 B1 D8           JSR   LAB_GTBY          ; b4 → X
00EC90  2  8E 16 A0           STX   VGC_P5
00EC93  2  20 C2 00           JSR   LAB_GBYT
00EC96  2  C9 2C              CMP   #','
00EC98  2  D0 39              BNE   @sd_done
00EC9A  2  20 BC 00           JSR   LAB_IGBY
00EC9D  2  20 B1 D8           JSR   LAB_GTBY          ; b5 → X
00ECA0  2  8E 17 A0           STX   VGC_P6
00ECA3  2  20 C2 00           JSR   LAB_GBYT
00ECA6  2  C9 2C              CMP   #','
00ECA8  2  D0 29              BNE   @sd_done
00ECAA  2  20 BC 00           JSR   LAB_IGBY
00ECAD  2  20 B1 D8           JSR   LAB_GTBY          ; b6 → X
00ECB0  2  8E 18 A0           STX   VGC_P7
00ECB3  2  20 C2 00           JSR   LAB_GBYT
00ECB6  2  C9 2C              CMP   #','
00ECB8  2  D0 19              BNE   @sd_done
00ECBA  2  20 BC 00           JSR   LAB_IGBY
00ECBD  2  20 B1 D8           JSR   LAB_GTBY          ; b7 → X
00ECC0  2  8E 19 A0           STX   VGC_P8
00ECC3  2  20 C2 00           JSR   LAB_GBYT
00ECC6  2  C9 2C              CMP   #','
00ECC8  2  D0 09              BNE   @sd_done
00ECCA  2  20 BC 00           JSR   LAB_IGBY
00ECCD  2  20 B1 D8           JSR   LAB_GTBY          ; b8 → X
00ECD0  2  8E 1A A0           STX   VGC_P9
00ECD3  2               @sd_done
00ECD3  2  4C 9D E9           JMP   sprite_row         ; trigger and return
00ECD6  2               
00ECD6  2               ; perform SOUND note, duration [, instrument]
00ECD6  2               ; SOUND 60, 10          — MIDI note 60, 10 frames, default instrument 0
00ECD6  2               ; SOUND 60, 10, 3       — MIDI note 60, 10 frames, instrument 3
00ECD6  2               
00ECD6  2               LAB_SOUND
00ECD6  2  20 B1 D8           JSR   LAB_GTBY          ; midi note → X
00ECD9  2  8E A4 B9           STX   AUDIO_NOTE
00ECDC  2  20 09 CE           JSR   LAB_1C01          ; comma
00ECDF  2  20 B1 D8           JSR   LAB_GTBY          ; duration → X
00ECE2  2  8E A5 B9           STX   AUDIO_DURATION
00ECE5  2  9C A6 B9           STZ   AUDIO_INSTRUMENT  ; default instrument = 0
00ECE8  2  20 C2 00           JSR   LAB_GBYT          ; peek next token
00ECEB  2  C9 2C              CMP   #','
00ECED  2  D0 09              BNE   @snd_go
00ECEF  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00ECF2  2  20 B1 D8           JSR   LAB_GTBY          ; instrument id → X
00ECF5  2  8E A6 B9           STX   AUDIO_INSTRUMENT
00ECF8  2               @snd_go
00ECF8  2  4C 01 EE           JMP   audio_sound
00ECFB  2               
00ECFB  2               ; perform VOLUME level (0-15)               — set master volume
00ECFB  2               ; perform VOLUME level, voice (0-255, 1-6)  — set per-voice volume
00ECFB  2               
00ECFB  2               LAB_VOLUME
00ECFB  2  20 B1 D8           JSR   LAB_GTBY          ; level → X
00ECFE  2  8E A4 B9           STX   AUDIO_VOLUME
00ED01  2  9C A5 B9           STZ   AUDIO_VOICE       ; default voice = 0 (master)
00ED04  2  20 C2 00           JSR   LAB_GBYT          ; peek next token
00ED07  2  C9 2C              CMP   #','
00ED09  2  D0 09              BNE   @vol_go
00ED0B  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00ED0E  2  20 B1 D8           JSR   LAB_GTBY          ; voice → X
00ED11  2  8E A5 B9           STX   AUDIO_VOICE
00ED14  2               @vol_go
00ED14  2  4C 06 EE           JMP   audio_volume
00ED17  2               
00ED17  2               ; perform INSTRUMENT id, waveform, a, d, s, r
00ED17  2               ; Waveform: $10=TRI, $20=SAW, $40=PULSE, $80=NOISE
00ED17  2               ; INSTRUMENT 1, $40, 0, 9, 0, 0
00ED17  2               
00ED17  2               LAB_ENVELOPE
00ED17  2  20 B1 D8           JSR   LAB_GTBY          ; id → X
00ED1A  2  8E A4 B9           STX   AUDIO_INST_ID
00ED1D  2  20 09 CE           JSR   LAB_1C01          ; comma
00ED20  2  20 B1 D8           JSR   LAB_GTBY          ; waveform → X
00ED23  2  8E A5 B9           STX   AUDIO_WAVEFORM
00ED26  2  20 09 CE           JSR   LAB_1C01          ; comma
00ED29  2  20 B1 D8           JSR   LAB_GTBY          ; attack → X
00ED2C  2  8E A6 B9           STX   AUDIO_ATTACK
00ED2F  2  20 09 CE           JSR   LAB_1C01          ; comma
00ED32  2  20 B1 D8           JSR   LAB_GTBY          ; decay → X
00ED35  2  8E A7 B9           STX   AUDIO_DECAY
00ED38  2  20 09 CE           JSR   LAB_1C01          ; comma
00ED3B  2  20 B1 D8           JSR   LAB_GTBY          ; sustain → X
00ED3E  2  8E A8 B9           STX   AUDIO_SUSTAIN
00ED41  2  20 09 CE           JSR   LAB_1C01          ; comma
00ED44  2  20 B1 D8           JSR   LAB_GTBY          ; release → X
00ED47  2  8E A9 B9           STX   AUDIO_RELEASE
00ED4A  2  4C 0B EE           JMP   audio_instrument
00ED4D  2               
00ED4D  2               FIO_NO_STREAMING = 1
00ED4D  2               ; Primary ROM is tight. NIC server entry points are library concerns, so omit
00ED4D  2               ; those helper shims from the BASIC ROM build.
00ED4D  2               NIC_SERVER_COMMANDS = 0
00ED4D  2                     .include "lib/audio.s"
00ED4D  3               ; Shared Nova audio/music helper routines.
00ED4D  3               ;
00ED4D  3               ; These routines are BASIC-agnostic.  They wrap the FIO audio commands behind
00ED4D  3               ; named entry points so BASIC, assembly programs, and future runtimes share one
00ED4D  3               ; audio ABI.
00ED4D  3               
00ED4D  3               .include "audio.inc"
00ED4D  4               ; Shared Nova audio/music runtime interface.
00ED4D  4               ;
00ED4D  4               ; BASIC parses language syntax and loads the argument registers; assembly
00ED4D  4               ; callers can use the same register layout directly.
00ED4D  4               ;
00ED4D  4               ; Sound effect:
00ED4D  4               ;   AUDIO_NOTE       MIDI note
00ED4D  4               ;   AUDIO_DURATION   duration in 60 Hz frames
00ED4D  4               ;   AUDIO_INSTRUMENT instrument slot
00ED4D  4               ;
00ED4D  4               ; Volume:
00ED4D  4               ;   AUDIO_VOLUME     volume level
00ED4D  4               ;   AUDIO_VOICE      0=master, 1..14=voice volume
00ED4D  4               ;
00ED4D  4               ; Instrument:
00ED4D  4               ;   AUDIO_INST_ID    instrument slot
00ED4D  4               ;   AUDIO_WAVEFORM   SID waveform/control byte
00ED4D  4               ;   AUDIO_ATTACK     attack
00ED4D  4               ;   AUDIO_DECAY      decay
00ED4D  4               ;   AUDIO_SUSTAIN    sustain
00ED4D  4               ;   AUDIO_RELEASE    release
00ED4D  4               ;
00ED4D  4               ; Music sequence:
00ED4D  4               ;   AUDIO_VOICE      voice number, 1..14
00ED4D  4               ;   AUDIO_STRLEN     MML byte length
00ED4D  4               ;   AUDIO_STRL/H     pointer to MML bytes
00ED4D  4               ;
00ED4D  4               ; File-backed commands:
00ED4D  4               ;   FIO_NAME/FIO_NAMELEN hold the filename.  Call fio_copy_name first when
00ED4D  4               ;   using a pointer-based filename.
00ED4D  4               ;
00ED4D  4               ; Routines return A=0 on success and A=1 on error unless documented as a raw
00ED4D  4               ; status query.
00ED4D  4               
00ED4D  4               .ifndef AUDIO_INC_INCLUDED
00ED4D  4               AUDIO_INC_INCLUDED = 1
00ED4D  4               
00ED4D  4               .include "fio.inc"
00ED4D  5               ; Shared Nova File I/O helper declarations.
00ED4D  5               ;
00ED4D  5               ; Calling convention for pointer-based filename helpers:
00ED4D  5               ;   FIO_ARG_NAMELEN      filename length, 1..63
00ED4D  5               ;   FIO_ARG_NAMEPTR_L/H  CPU pointer to filename bytes
00ED4D  5               ;
00ED4D  5               ; Calling convention for XRAM streaming setup:
00ED4D  5               ;   FIO_ARG_ADDRL/M/H    flat 24-bit XRAM address
00ED4D  5               ;   FIO_ARG_LENL/H       transfer length; zero means full file for XLOAD
00ED4D  5               ;
00ED4D  5               ; Routines return A=0 on success and A=1 on error. Detailed status remains
00ED4D  5               ; in the FIO_STATUS/FIO_ERRCODE hardware registers.
00ED4D  5               
00ED4D  5               .ifndef FIO_INC_INCLUDED
00ED4D  5               FIO_INC_INCLUDED = 1
00ED4D  5               
00ED4D  5               .include "nova.inc"
00ED4D  6               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
00ED4D  6               ;
00ED4D  6               ; This include is deliberately guarded per symbol so it can coexist with older
00ED4D  6               ; source files that still define a subset of these names locally.
00ED4D  6               
00ED4D  6               .ifndef NOVA_INC_INCLUDED
00ED4D  6               NOVA_INC_INCLUDED = 1
00ED4D  6               
00ED4D  6               ; Nova pseudo-register mailbox. These bytes are available to callers and
00ED4D  6               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
00ED4D  6               ; clobber them unless its documentation explicitly says otherwise; persistent
00ED4D  6               ; library state must be allocated in a linker segment such as BSS/ZEROPAGE.
00ED4D  6               .ifndef NVR0L
00ED4D  6               NVR0L             = $20
00ED4D  6               .endif
00ED4D  6               .ifndef NVR0H
00ED4D  6               NVR0H             = $21
00ED4D  6               .endif
00ED4D  6               .ifndef NVR1L
00ED4D  6               NVR1L             = $22
00ED4D  6               .endif
00ED4D  6               .ifndef NVR1H
00ED4D  6               NVR1H             = $23
00ED4D  6               .endif
00ED4D  6               .ifndef NVR2L
00ED4D  6               NVR2L             = $24
00ED4D  6               .endif
00ED4D  6               .ifndef NVR2H
00ED4D  6               NVR2H             = $25
00ED4D  6               .endif
00ED4D  6               .ifndef NVR3L
00ED4D  6               NVR3L             = $26
00ED4D  6               .endif
00ED4D  6               .ifndef NVR3H
00ED4D  6               NVR3H             = $27
00ED4D  6               .endif
00ED4D  6               .ifndef NVR4L
00ED4D  6               NVR4L             = $28
00ED4D  6               .endif
00ED4D  6               .ifndef NVR4H
00ED4D  6               NVR4H             = $29
00ED4D  6               .endif
00ED4D  6               .ifndef NVR5L
00ED4D  6               NVR5L             = $2A
00ED4D  6               .endif
00ED4D  6               .ifndef NVR5H
00ED4D  6               NVR5H             = $2B
00ED4D  6               .endif
00ED4D  6               .ifndef NVR6L
00ED4D  6               NVR6L             = $2C
00ED4D  6               .endif
00ED4D  6               .ifndef NVR6H
00ED4D  6               NVR6H             = $2D
00ED4D  6               .endif
00ED4D  6               .ifndef NVR7L
00ED4D  6               NVR7L             = $2E
00ED4D  6               .endif
00ED4D  6               .ifndef NVR7H
00ED4D  6               NVR7H             = $2F
00ED4D  6               .endif
00ED4D  6               
00ED4D  6               ; BASIC SYS register bridge. SYS addr[,A[,X[,Y]]] loads A/X/Y from these
00ED4D  6               ; bytes before jumping and stores A/X/Y back here when the routine returns.
00ED4D  6               ; @label SYS.REGA
00ED4D  6               ; @kind u8
00ED4D  6               ; @symbol SYS_REGA
00ED4D  6               ; @summary Returned A register from the most recent SYS call.
00ED4D  6               .ifndef SYS_REGA
00ED4D  6               SYS_REGA          = $E7
00ED4D  6               .endif
00ED4D  6               ; @label SYS.REGX
00ED4D  6               ; @kind u8
00ED4D  6               ; @symbol SYS_REGX
00ED4D  6               ; @summary Returned X register from the most recent SYS call.
00ED4D  6               .ifndef SYS_REGX
00ED4D  6               SYS_REGX          = $E8
00ED4D  6               .endif
00ED4D  6               ; @label SYS.REGY
00ED4D  6               ; @kind u8
00ED4D  6               ; @symbol SYS_REGY
00ED4D  6               ; @summary Returned Y register from the most recent SYS call.
00ED4D  6               .ifndef SYS_REGY
00ED4D  6               SYS_REGY          = $E9
00ED4D  6               .endif
00ED4D  6               
00ED4D  6               ; Extension ROM argument mailbox used by small BASIC stubs that parse
00ED4D  6               ; BASIC-owned data before calling an extension handler.
00ED4D  6               .ifndef EXT_ARG_LEN
00ED4D  6               EXT_ARG_LEN       = $EA
00ED4D  6               .endif
00ED4D  6               .ifndef EXT_ARG_PTRL
00ED4D  6               EXT_ARG_PTRL      = $EB
00ED4D  6               .endif
00ED4D  6               .ifndef EXT_ARG_PTRH
00ED4D  6               EXT_ARG_PTRH      = $EC
00ED4D  6               .endif
00ED4D  6               
00ED4D  6               .ifndef NOVA_SCREEN_COLS
00ED4D  6               NOVA_SCREEN_COLS  = 80
00ED4D  6               .endif
00ED4D  6               .ifndef NOVA_SCREEN_ROWS
00ED4D  6               NOVA_SCREEN_ROWS  = 50
00ED4D  6               .endif
00ED4D  6               .ifndef NOVA_SCREEN_SIZE
00ED4D  6               NOVA_SCREEN_SIZE  = NOVA_SCREEN_COLS * NOVA_SCREEN_ROWS
00ED4D  6               .endif
