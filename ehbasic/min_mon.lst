00E8BD  3               
00E8BD  3               ; Input: A = VGC command. Does not wait for completion.
00E8BD  3               ; @label VGC.COMMAND
00E8BD  3               ; @kind routine
00E8BD  3               ; @symbol vgc_cmd
00E8BD  3               ; @summary Issue a raw VGC command without waiting for completion.
00E8BD  3               ; @in A: VGC command byte.
00E8BD  3               vgc_cmd:
00E8BD  3  8D 10 A0           STA   VGC_CMD
00E8C0  3  60                 RTS
00E8C1  3               
00E8C1  3               ; Wait until the command busy bit clears.
00E8C1  3               ; @label VGC.WAIT_COMMAND
00E8C1  3               ; @kind routine
00E8C1  3               ; @symbol vgc_wait_cmd
00E8C1  3               ; @summary Wait for the active VGC command to complete.
00E8C1  3               vgc_wait_cmd:
00E8C1  3               @wait:
00E8C1  3  AD 10 A0           LDA   VGC_CMD
00E8C4  3  29 01              AND   #$01
00E8C6  3  D0 F9              BNE   @wait
00E8C8  3  60                 RTS
00E8C9  3               
00E8C9  3               ; Input: A = VGC command. Issue and wait for completion.
00E8C9  3               .ifndef VGC_NO_EXEC
00E8C9  3               ; @label VGC.EXEC
00E8C9  3               ; @kind routine
00E8C9  3               ; @symbol vgc_exec
00E8C9  3               ; @summary Issue a raw VGC command and wait for completion.
00E8C9  3               ; @in A: VGC command byte.
00E8C9  3               vgc_exec:
00E8C9  3                     JSR   vgc_cmd
00E8C9  3                     JMP   vgc_wait_cmd
00E8C9  3               .endif
00E8C9  3               
00E8C9  3               ; Wait for the next frame counter tick.
00E8C9  3               ; @label VGC.VSYNC
00E8C9  3               ; @kind routine
00E8C9  3               ; @symbol vgc_vsync
00E8C9  3               ; @summary Wait until the VGC frame counter advances.
00E8C9  3               ; @out A: Last observed frame counter value.
00E8C9  3               vgc_vsync:
00E8C9  3  AD 08 A0           LDA   VGC_FRAME
00E8CC  3               @wait:
00E8CC  3  CD 08 A0           CMP   VGC_FRAME
00E8CF  3  F0 FB              BEQ   @wait
00E8D1  3  60                 RTS
00E8D2  3               
00E8D2  3               ; @label VGC.CLS
00E8D2  3               ; @kind routine
00E8D2  3               ; @symbol vgc_cls
00E8D2  3               ; @summary Clear the text screen through the VGC character output register.
00E8D2  3               vgc_cls:
00E8D2  3  A9 0C              LDA   #$0C
00E8D4  3  8D 0E A0           STA   VGC_CHAROUT
00E8D7  3  60                 RTS
00E8D8  3               
00E8D8  3               ; @label VGC.SET_FG
00E8D8  3               ; @kind routine
00E8D8  3               ; @symbol vgc_set_fg
00E8D8  3               ; @summary Set the current text foreground colour.
00E8D8  3               ; @in X: Foreground colour byte.
00E8D8  3               vgc_set_fg:
00E8D8  3  8E 02 A0           STX   VGC_FGCOL
00E8DB  3  60                 RTS
00E8DC  3               
00E8DC  3               ; @label VGC.SET_BG
00E8DC  3               ; @kind routine
00E8DC  3               ; @symbol vgc_set_bg
00E8DC  3               ; @summary Set the current text background colour.
00E8DC  3               ; @in X: Background colour byte.
00E8DC  3               vgc_set_bg:
00E8DC  3  8E 01 A0           STX   VGC_BGCOL
00E8DF  3  60                 RTS
00E8E0  3               
00E8E0  3               ; @label VGC.SET_BORDER
00E8E0  3               ; @kind routine
00E8E0  3               ; @symbol vgc_set_border
00E8E0  3               ; @summary Set the VGC border colour.
00E8E0  3               ; @in X: Border colour byte.
00E8E0  3               vgc_set_border:
00E8E0  3  8E 0D A0           STX   VGC_BORDER
00E8E3  3  60                 RTS
00E8E4  3               
00E8E4  3               ; @label VGC.LOCATE
00E8E4  3               ; @kind routine
00E8E4  3               ; @symbol vgc_locate
00E8E4  3               ; @summary Set the text cursor position from VGC.P0/VGC.P1.
00E8E4  3               ; @in VGC_P0: Cursor X column.
00E8E4  3               ; @in VGC_P1: Cursor Y row.
00E8E4  3               vgc_locate:
00E8E4  3  AD 11 A0           LDA   VGC_P0
00E8E7  3  8D 03 A0           STA   VGC_CURSX
00E8EA  3  AD 12 A0           LDA   VGC_P1
00E8ED  3  8D 04 A0           STA   VGC_CURSY
00E8F0  3  60                 RTS
00E8F1  3               
00E8F1  3               ; @label VGC.SET_MODE
00E8F1  3               ; @kind routine
00E8F1  3               ; @symbol vgc_set_mode
00E8F1  3               ; @summary Set the active VGC graphics/text mode.
00E8F1  3               ; @in X: Mode byte.
00E8F1  3               vgc_set_mode:
00E8F1  3  8E 00 A0           STX   VGC_MODE
00E8F4  3  60                 RTS
00E8F5  3               
00E8F5  3               ; @label VGC.SET_FONT
00E8F5  3               ; @kind routine
00E8F5  3               ; @symbol vgc_set_font
00E8F5  3               ; @summary Select the active text font slot.
00E8F5  3               ; @in X: Font slot, 0..7.
00E8F5  3               vgc_set_font:
00E8F5  3  8E 07 A0           STX   VGC_FONT
00E8F8  3  60                 RTS
00E8F9  3               
00E8F9  3               ; @label VGC.MEM_READ
00E8F9  3               ; @kind routine
00E8F9  3               ; @symbol vgc_mem_read
00E8F9  3               ; @summary Read one byte from VGC memory using VGC.P0..VGC.P4.
00E8F9  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P4
00E8F9  3               ; @out VGC_P3: Read byte.
00E8F9  3               vgc_mem_read:
00E8F9  3  A9 19              LDA   #VCMD_MEMREAD
00E8FB  3  2C                 .byte $2C
00E8FC  3               
00E8FC  3               ; @label VGC.MEM_WRITE
00E8FC  3               ; @kind routine
00E8FC  3               ; @symbol vgc_mem_write
00E8FC  3               ; @summary Write one byte to VGC memory using VGC.P0..VGC.P4.
00E8FC  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4
00E8FC  3               vgc_mem_write:
00E8FC  3  A9 1A              LDA   #VCMD_MEMWRITE
00E8FE  3  8D 10 A0           STA   VGC_CMD
00E901  3  4C C1 E8           JMP   vgc_wait_cmd
00E904  3               
00E904  3               ; Enable reverse text by swapping the current foreground/background colours.
00E904  3               ; @label VGC.REVERSE
00E904  3               ; @kind routine
00E904  3               ; @symbol vgc_reverse_default
00E904  3               ; @summary Enable reverse text using the current foreground/background colours.
00E904  3               vgc_reverse_default:
00E904  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E907  3  29 FC              AND   #$FC
00E909  3  09 01              ORA   #VTXT_REV
00E90B  3  8D E6 A0           STA   VGC_TXTFLAGS
00E90E  3  60                 RTS
00E90F  3               
00E90F  3               ; Input: A = packed reverse attribute, low nibble fg and high nibble bg.
00E90F  3               ; @label VGC.REVERSE_EXPLICIT
00E90F  3               ; @kind routine
00E90F  3               ; @symbol vgc_reverse_explicit
00E90F  3               ; @summary Enable reverse text with explicit packed foreground/background colours.
00E90F  3               ; @in A: Packed reverse attribute, low nibble foreground and high nibble background.
00E90F  3               vgc_reverse_explicit:
00E90F  3  8D E7 A0           STA   VGC_TXTREVATTR
00E912  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E915  3  29 FC              AND   #$FC
00E917  3  09 03              ORA   #(VTXT_REV | VTXT_REVEX)
00E919  3  8D E6 A0           STA   VGC_TXTFLAGS
00E91C  3  60                 RTS
00E91D  3               
00E91D  3               ; @label VGC.REVERSE_OFF
00E91D  3               ; @kind routine
00E91D  3               ; @symbol vgc_reverse_off
00E91D  3               ; @summary Disable reverse text.
00E91D  3               vgc_reverse_off:
00E91D  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E920  3  29 FC              AND   #$FC
00E922  3  8D E6 A0           STA   VGC_TXTFLAGS
00E925  3  60                 RTS
00E926  3               
00E926  3               ; @label VGC.FLASH_ON
00E926  3               ; @kind routine
00E926  3               ; @symbol vgc_flash_on
00E926  3               ; @summary Enable flashing text.
00E926  3               vgc_flash_on:
00E926  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E929  3  09 04              ORA   #VTXT_FLASH
00E92B  3  8D E6 A0           STA   VGC_TXTFLAGS
00E92E  3  60                 RTS
00E92F  3               
00E92F  3               ; @label VGC.FLASH_OFF
00E92F  3               ; @kind routine
00E92F  3               ; @symbol vgc_flash_off
00E92F  3               ; @summary Disable flashing text.
00E92F  3               vgc_flash_off:
00E92F  3  AD E6 A0           LDA   VGC_TXTFLAGS
00E932  3  29 FB              AND   #$FB
00E934  3  8D E6 A0           STA   VGC_TXTFLAGS
00E937  3  60                 RTS
00E938  3               
00E938  3               .ifndef VGC_NO_PRIMITIVES
00E938  3               ; @label VGC.GCLS
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_gcls
00E938  3               ; @summary Issue the VGC graphics clear command.
00E938  3               vgc_gcls:
00E938  3                     LDA   #VCMD_GCLS
00E938  3                     JMP   vgc_cmd
00E938  3               
00E938  3               ; @label VGC.GCOLOR
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_gcolor
00E938  3               ; @summary Issue the VGC graphics colour command using VGC.P0/P1.
00E938  3               ; @requires VGC_P0 VGC_P1
00E938  3               vgc_gcolor:
00E938  3                     LDA   #VCMD_GCOLOR
00E938  3                     JMP   vgc_cmd
00E938  3               
00E938  3               ; @label VGC.PLOT
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_plot
00E938  3               ; @summary Issue the VGC plot command using VGC.P0..VGC.P3.
00E938  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E938  3               vgc_plot:
00E938  3                     LDA   #VCMD_PLOT
00E938  3                     JMP   vgc_cmd
00E938  3               
00E938  3               ; @label VGC.UNPLOT
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_unplot
00E938  3               ; @summary Issue the VGC unplot command using VGC.P0..VGC.P3.
00E938  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E938  3               vgc_unplot:
00E938  3                     LDA   #VCMD_UNPLOT
00E938  3                     JMP   vgc_cmd
00E938  3               
00E938  3               ; @label VGC.LINE
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_line
00E938  3               ; @summary Issue the VGC line command using VGC.P0..VGC.P7.
00E938  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E938  3               vgc_line:
00E938  3                     LDA   #VCMD_LINE
00E938  3                     JMP   vgc_cmd
00E938  3               
00E938  3               ; @label VGC.CIRCLE
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_circle
00E938  3               ; @summary Issue the VGC circle/ellipse command using VGC.P0..VGC.P7.
00E938  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E938  3               vgc_circle:
00E938  3                     LDA   #VCMD_CIRCLE
00E938  3                     JMP   vgc_cmd
00E938  3               
00E938  3               ; @label VGC.GTEXT
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_gtext
00E938  3               ; @summary Issue the VGC graphics text command using VGC.P0..VGC.P5 and FIO.NAME.
00E938  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 FIO_NAME FIO_NAMELEN
00E938  3               vgc_gtext:
00E938  3                     LDA   #VCMD_GTEXT
00E938  3                     JMP   vgc_cmd
00E938  3               
00E938  3               ; @label VGC.RECT
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_rect
00E938  3               ; @summary Issue the VGC rectangle command using VGC.P0..VGC.P7.
00E938  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E938  3               vgc_rect:
00E938  3                     LDA   #VCMD_RECT
00E938  3                     JMP   vgc_cmd
00E938  3               
00E938  3               ; @label VGC.FILL
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_fill
00E938  3               ; @summary Issue the VGC filled rectangle command using VGC.P0..VGC.P7.
00E938  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
00E938  3               vgc_fill:
00E938  3                     LDA   #VCMD_FILL
00E938  3                     JMP   vgc_cmd
00E938  3               
00E938  3               ; @label VGC.PAINT
00E938  3               ; @kind routine
00E938  3               ; @symbol vgc_paint
00E938  3               ; @summary Issue the VGC paint command using VGC.P0..VGC.P3.
00E938  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E938  3               vgc_paint:
00E938  3                     LDA   #VCMD_PAINT
00E938  3                     JMP   vgc_cmd
00E938  3               .endif
00E938  3               
00E938  3               .endif
00E938  3               
00E938  2                     .include "lib/sprite.s"
00E938  3               ; Shared Nova sprite helper routines.
00E938  3               ;
00E938  3               ; Assembly callers can load VGC_P* and call the command helpers, or use the
00E938  3               ; direct register helpers for the VGC sprite attribute block.
00E938  3               
00E938  3               .include "sprite.inc"
00E938  4               ; Shared Nova sprite helper declarations.
00E938  4               ;
00E938  4               ; Command helpers use VGC_P* registers directly. Direct sprite-register helpers
00E938  4               ; use the public sprite attribute register block at VGC_SPR_BASE.
00E938  4               
00E938  4               .ifndef SPRITE_INC_INCLUDED
00E938  4               SPRITE_INC_INCLUDED = 1
00E938  4               
00E938  4               .include "vgc.inc"
00E938  5               ; Shared Nova VGC helper declarations.
00E938  5               ;
00E938  5               ; The command helpers use the VGC hardware parameter registers directly:
00E938  5               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
00E938  5               ; Routines return through the hardware status model; command completion can be
00E938  5               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
00E938  5               
00E938  5               .ifndef VGC_INC_INCLUDED
00E938  5               VGC_INC_INCLUDED = 1
00E938  5               
00E938  5               .include "nova.inc"
00E938  5               
00E938  5               VGC_RESULT_OK    = $00
00E938  5               VGC_RESULT_ERROR = $01
00E938  5               
00E938  5               .endif
00E938  5               
00E938  4               
00E938  4               SPRITE_RESULT_OK    = $00
00E938  4               SPRITE_RESULT_ERROR = $01
00E938  4               
00E938  4               .endif
00E938  4               
00E938  3               
00E938  3               .ifndef SPRITE_IMPLEMENTATION_INCLUDED
00E938  3               SPRITE_IMPLEMENTATION_INCLUDED = 1
00E938  3               
00E938  3                     .segment "CODE"
00E938  3               
00E938  3                     .export sprite_command
00E938  3                     .export sprite_pos
00E938  3                     .export sprite_enable
00E938  3                     .export sprite_disable
00E938  3                     .export sprite_row
00E938  3               .ifndef SPRITE_NO_EXTRA
00E938  3                     .export sprite_clear
00E938  3                     .export sprite_copy
00E938  3                     .export sprite_flip
00E938  3                     .export sprite_priority
00E938  3               .endif
00E938  3                     .export sprite_reg_offset
00E938  3                     .export sprite_set_shape
00E938  3                     .export sprite_set_reg8
00E938  3                     .export sprite_set_reg16
00E938  3                     .export sprite_get_x
00E938  3                     .export sprite_get_y
00E938  3                     .export sprite_collision_status
00E938  3                     .export sprite_background_collision_status
00E938  3               
00E938  3               ; Input: A = sprite VGC command. Does not wait for completion.
00E938  3               ; @label SPRITE.COMMAND
00E938  3               ; @kind routine
00E938  3               ; @symbol sprite_command
00E938  3               ; @summary Issue a raw sprite VGC command without waiting for completion.
00E938  3               ; @in A: VGC sprite command byte.
00E938  3               sprite_command:
00E938  3  8D 10 A0           STA   VGC_CMD
00E93B  3  60                 RTS
00E93C  3               
00E93C  3               ; Command wrappers. Callers load VGC_P* per the hardware command ABI.
00E93C  3               ; @label SPRITE.POS
00E93C  3               ; @kind routine
00E93C  3               ; @symbol sprite_pos
00E93C  3               ; @summary Move a sprite using VGC.P0=sprite, VGC.P1/P2=x, VGC.P3=y.
00E93C  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
00E93C  3               sprite_pos:
00E93C  3  A9 14              LDA   #VCMD_SPRPOS
00E93E  3  4C 38 E9           JMP   sprite_command
00E941  3               
00E941  3               ; @label SPRITE.ENABLE
00E941  3               ; @kind routine
00E941  3               ; @symbol sprite_enable
00E941  3               ; @summary Enable the sprite in VGC.P0.
00E941  3               ; @requires VGC_P0
00E941  3               sprite_enable:
00E941  3  A9 15              LDA   #VCMD_SPRENA
00E943  3  4C 38 E9           JMP   sprite_command
00E946  3               
00E946  3               ; @label SPRITE.DISABLE
00E946  3               ; @kind routine
00E946  3               ; @symbol sprite_disable
00E946  3               ; @summary Disable the sprite in VGC.P0.
00E946  3               ; @requires VGC_P0
00E946  3               sprite_disable:
00E946  3  A9 16              LDA   #VCMD_SPRDIS
00E948  3  4C 38 E9           JMP   sprite_command
00E94B  3               
00E94B  3               ; @label SPRITE.ROW
00E94B  3               ; @kind routine
00E94B  3               ; @symbol sprite_row
00E94B  3               ; @summary Write one sprite bitmap row using VGC.P0..VGC.P9.
00E94B  3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7 VGC_P8 VGC_P9
00E94B  3               sprite_row:
00E94B  3  A9 11              LDA   #VCMD_SPRROW
00E94D  3  4C 38 E9           JMP   sprite_command
00E950  3               
00E950  3               .ifndef SPRITE_NO_EXTRA
00E950  3               sprite_clear:
00E950  3                     LDA   #VCMD_SPRCLR
00E950  3                     JMP   sprite_command
00E950  3               
00E950  3               sprite_copy:
00E950  3                     LDA   #VCMD_SPRCOPY
00E950  3                     JMP   sprite_command
00E950  3               
00E950  3               sprite_flip:
00E950  3                     LDA   #VCMD_SPRFLIP
00E950  3                     JMP   sprite_command
00E950  3               
00E950  3               sprite_priority:
00E950  3                     LDA   #VCMD_SPRPRI
00E950  3                     JMP   sprite_command
00E950  3               .endif
00E950  3               
00E950  3               ; Input: X = sprite index, Y = sprite register field offset.
00E950  3               ; Output: Y = VGC_SPR_BASE-relative register offset.
00E950  3               ; Clobbers: A, NVR7L.
00E950  3               ; @label SPRITE.REG_OFFSET
00E950  3               ; @kind routine
00E950  3               ; @symbol sprite_reg_offset
00E950  3               ; @summary Compute the VGC sprite attribute block offset for a sprite field.
00E950  3               ; @in X: Sprite index.
00E950  3               ; @in Y: Sprite field offset.
00E950  3               ; @out Y: VGC_SPR_BASE-relative byte offset.
00E950  3               sprite_reg_offset:
00E950  3  84 2E              STY   NVR7L
00E952  3  8A                 TXA
00E953  3  0A                 ASL
00E954  3  0A                 ASL
00E955  3  0A                 ASL
00E956  3  18                 CLC
00E957  3  65 2E              ADC   NVR7L
00E959  3  A8                 TAY
00E95A  3  60                 RTS
00E95B  3               
00E95B  3               ; Input: X = sprite index, A = shape.
00E95B  3               ; @label SPRITE.SET_SHAPE
00E95B  3               ; @kind routine
00E95B  3               ; @symbol sprite_set_shape
00E95B  3               ; @summary Set a sprite's shape index.
00E95B  3               ; @in X: Sprite index.
00E95B  3               ; @in A: Shape index.
00E95B  3               sprite_set_shape:
00E95B  3  A0 04              LDY   #VGC_SPR_SHAPE_OFF
00E95D  3                     ; fall through
00E95D  3               
00E95D  3               ; Input: X = sprite index, Y = field offset, A = value.
00E95D  3               ; Clobbers: A, Y, NVR7L/NVR7H.
00E95D  3               ; @label SPRITE.SET_REG8
00E95D  3               ; @kind routine
00E95D  3               ; @symbol sprite_set_reg8
00E95D  3               ; @summary Write one 8-bit sprite attribute field.
00E95D  3               ; @in X: Sprite index.
00E95D  3               ; @in Y: Sprite field offset.
00E95D  3               ; @in A: Field value.
00E95D  3               sprite_set_reg8:
00E95D  3  85 2F              STA   NVR7H
00E95F  3  20 50 E9           JSR   sprite_reg_offset
00E962  3  A5 2F              LDA   NVR7H
00E964  3  99 40 A0           STA   VGC_SPR_BASE,Y
00E967  3  60                 RTS
00E968  3               
00E968  3               ; Input: X = sprite index, Y = field offset, NVR0L/NVR0H = little-endian value.
00E968  3               ; Clobbers: A, Y, NVR7L.
00E968  3               ; @label SPRITE.SET_REG16
00E968  3               ; @kind routine
00E968  3               ; @symbol sprite_set_reg16
00E968  3               ; @summary Write one 16-bit sprite attribute field.
00E968  3               ; @in X: Sprite index.
00E968  3               ; @in Y: Sprite field offset.
00E968  3               ; @in NVR0L: Low byte.
00E968  3               ; @in NVR0H: High byte.
00E968  3               sprite_set_reg16:
00E968  3  20 50 E9           JSR   sprite_reg_offset
00E96B  3  A5 20              LDA   NVR0L
00E96D  3  99 40 A0           STA   VGC_SPR_BASE,Y
00E970  3  C8                 INY
00E971  3  A5 21              LDA   NVR0H
00E973  3  99 40 A0           STA   VGC_SPR_BASE,Y
00E976  3  60                 RTS
00E977  3               
00E977  3               ; Input: X = sprite index. Output: A = X high byte, Y = X low byte.
00E977  3               ; @label SPRITE.GET_X
00E977  3               ; @kind routine
00E977  3               ; @symbol sprite_get_x
00E977  3               ; @summary Read a sprite's 16-bit X coordinate.
00E977  3               ; @in X: Sprite index.
00E977  3               ; @out A: X high byte.
00E977  3               ; @out Y: X low byte.
00E977  3               sprite_get_x:
00E977  3  A0 00              LDY   #VGC_SPR_XL_OFF
00E979  3  20 50 E9           JSR   sprite_reg_offset
00E97C  3  B9 40 A0           LDA   VGC_SPR_BASE,Y
00E97F  3  85 2E              STA   NVR7L
00E981  3  C8                 INY
00E982  3  B9 40 A0           LDA   VGC_SPR_BASE,Y
00E985  3  A4 2E              LDY   NVR7L
00E987  3  60                 RTS
00E988  3               
00E988  3               ; Input: X = sprite index. Output: Y = Y low byte.
00E988  3               ; @label SPRITE.GET_Y
00E988  3               ; @kind routine
00E988  3               ; @symbol sprite_get_y
00E988  3               ; @summary Read a sprite's Y coordinate.
00E988  3               ; @in X: Sprite index.
00E988  3               ; @out Y: Y coordinate byte.
00E988  3               sprite_get_y:
00E988  3  A0 02              LDY   #VGC_SPR_YL_OFF
00E98A  3  20 50 E9           JSR   sprite_reg_offset
00E98D  3  B9 40 A0           LDA   VGC_SPR_BASE,Y
00E990  3  A8                 TAY
00E991  3  60                 RTS
00E992  3               
00E992  3               ; @label SPRITE.COLLISION_STATUS
00E992  3               ; @kind routine
00E992  3               ; @symbol sprite_collision_status
00E992  3               ; @summary Read the sprite-sprite collision status register.
00E992  3               ; @out A: Collision status byte.
00E992  3               sprite_collision_status:
00E992  3  AD 0B A0           LDA   VGC_COLLST
00E995  3  60                 RTS
00E996  3               
00E996  3               ; @label SPRITE.BACKGROUND_STATUS
00E996  3               ; @kind routine
00E996  3               ; @symbol sprite_background_collision_status
00E996  3               ; @summary Read the sprite-background collision status register.
00E996  3               ; @out A: Background collision status byte.
00E996  3               sprite_background_collision_status:
00E996  3  AD 0C A0           LDA   VGC_COLLBG
00E999  3  60                 RTS
00E99A  3               
00E99A  3               .endif
00E99A  3               
00E99A  2               
00E99A  2               LAB_VGC_CMD_RTS = vgc_cmd
00E99A  2               LAB_VSYNC       = vgc_vsync
00E99A  2               
00E99A  2               ; perform CLS — clear screen, no arguments
00E99A  2               
00E99A  2               LAB_CLS
00E99A  2  4C D2 E8           JMP   vgc_cls
00E99D  2               
00E99D  2               ; perform COLOR fg [,bg [,border]]
00E99D  2               
00E99D  2               LAB_COLOR
00E99D  2  20 AE D8           JSR   LAB_GTBY          ; get fg color byte in X
00E9A0  2  20 D8 E8           JSR   vgc_set_fg        ; store foreground color
00E9A3  2  20 C2 00           JSR   LAB_GBYT          ; peek at current byte
00E9A6  2  C9 2C              CMP   #','              ; comma follows?
00E9A8  2  D0 19              BNE   @done             ; no, just fg was given
00E9AA  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00E9AD  2  20 AE D8           JSR   LAB_GTBY          ; get bg color byte in X
00E9B0  2  20 DC E8           JSR   vgc_set_bg        ; store background color
00E9B3  2  20 C2 00           JSR   LAB_GBYT          ; peek for optional border color
00E9B6  2  C9 2C              CMP   #','              ; second comma follows?
00E9B8  2  D0 09              BNE   @done             ; no, fg/bg only
00E9BA  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00E9BD  2  20 AE D8           JSR   LAB_GTBY          ; get border color byte in X
00E9C0  2  20 E0 E8           JSR   vgc_set_border    ; store border color
00E9C3  2               @done
00E9C3  2  60                 RTS
00E9C4  2               
00E9C4  2               ; perform REVERSE [fg,bg]
00E9C4  2               
00E9C4  2               LAB_REVERSE
00E9C4  2  20 C2 00           JSR   LAB_GBYT          ; optional explicit reverse colours?
00E9C7  2  F0 20              BEQ   @swap
00E9C9  2  C9 3A              CMP   #':'              ; no args before next statement
00E9CB  2  F0 1C              BEQ   @swap
00E9CD  2  20 AE D8           JSR   LAB_GTBY          ; reverse foreground in X
00E9D0  2  8A                 TXA
00E9D1  2  29 0F              AND   #$0F
00E9D3  2  48                 PHA
00E9D4  2  20 06 CE           JSR   LAB_1C01          ; comma
00E9D7  2  20 AE D8           JSR   LAB_GTBY          ; reverse background in X
00E9DA  2  8A                 TXA
00E9DB  2  29 0F              AND   #$0F
00E9DD  2  0A                 ASL
00E9DE  2  0A                 ASL
00E9DF  2  0A                 ASL
00E9E0  2  0A                 ASL
00E9E1  2  85 78              STA   TempB
00E9E3  2  68                 PLA
00E9E4  2  05 78              ORA   TempB
00E9E6  2  4C 0F E9           JMP   vgc_reverse_explicit
00E9E9  2               @swap
00E9E9  2  4C 04 E9           JMP   vgc_reverse_default
00E9EC  2               
00E9EC  2               ; perform REVERSEOFF
00E9EC  2               
00E9EC  2               LAB_REVERSEOFF
00E9EC  2  4C 1D E9           JMP   vgc_reverse_off
00E9EF  2               
00E9EF  2               ; perform FLASH
00E9EF  2               
00E9EF  2               LAB_FLASH
00E9EF  2  4C 26 E9           JMP   vgc_flash_on
00E9F2  2               
00E9F2  2               ; perform FLASHOFF
00E9F2  2               
00E9F2  2               LAB_FLASHOFF
00E9F2  2  4C 2F E9           JMP   vgc_flash_off
00E9F5  2               
00E9F5  2               ; perform VPOKE plane,addr,value — write a byte to VGC memory
00E9F5  2               
00E9F5  2               LAB_VPOKE
00E9F5  2  20 AE D8           JSR   LAB_GTBY
00E9F8  2  8E 11 A0           STX   VGC_P0
00E9FB  2  20 06 CE           JSR   LAB_1C01
00E9FE  2  20 9C D8           JSR   LAB_GTWRD
00EA01  2  A5 AF              LDA   FAC1_3
00EA03  2  8D 12 A0           STA   VGC_P1
00EA06  2  A5 AE              LDA   FAC1_2
00EA08  2  8D 13 A0           STA   VGC_P2
00EA0B  2  20 06 CE           JSR   LAB_1C01
00EA0E  2  20 AE D8           JSR   LAB_GTBY
00EA11  2  8E 14 A0           STX   VGC_P3
00EA14  2  9C 15 A0           STZ   VGC_P4
00EA17  2  4C FC E8           JMP   vgc_mem_write
00EA1A  2               
00EA1A  2               ; perform LOCATE x, y
00EA1A  2               
00EA1A  2               LAB_LOCATE
00EA1A  2  20 AE D8           JSR   LAB_GTBY          ; get x in X
00EA1D  2  8E 11 A0           STX   VGC_P0            ; store cursor X
00EA20  2  20 06 CE           JSR   LAB_1C01          ; require comma
00EA23  2  20 AE D8           JSR   LAB_GTBY          ; get y in X
00EA26  2  8E 12 A0           STX   VGC_P1            ; store cursor Y
00EA29  2  4C E4 E8           JMP   vgc_locate
00EA2C  2               
00EA2C  2               ; perform MODE n
00EA2C  2               
00EA2C  2               LAB_GMODE
00EA2C  2  20 AE D8           JSR   LAB_GTBY          ; get mode byte in X
00EA2F  2  4C F1 E8           JMP   vgc_set_mode
00EA32  2               
00EA32  2               ; perform FONT n — select active font slot (0-7)
00EA32  2               
00EA32  2               LAB_FONT
00EA32  2  20 AE D8           JSR   LAB_GTBY          ; get font index byte (0-7) in X
00EA35  2  4C F5 E8           JMP   vgc_set_font
00EA38  2               
00EA38  2               ; perform GCLS — clear the graphics bitmap layer
00EA38  2               
00EA38  2               LAB_GCLS
00EA38  2  20 C9 E8           JSR   LAB_VSYNC         ; BASIC hides visible VGC draw tearing
00EA3B  2  A9 07              LDA   #VCMD_GCLS        ; GCLS command
00EA3D  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EA40  2               
00EA40  2               ; perform GCOLOR c — set graphics draw color (0-15)
00EA40  2               
00EA40  2               LAB_GCOLOR
00EA40  2  20 AE D8           JSR   LAB_GTBY          ; get color byte in X
00EA43  2  8E 11 A0           STX   VGC_P0             ; color in P0
00EA46  2  9C 12 A0           STZ   VGC_P1             ; high byte = 0
00EA49  2  A9 08              LDA   #VCMD_GCOLOR      ; GCOLOR command
00EA4B  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EA4E  2               
00EA4E  2               ; shared: load x(word),y(byte) into VGC_P0-P3
00EA4E  2               
00EA4E  2               LAB_VGC_XY
00EA4E  2  20 9C D8           JSR   LAB_GTWRD         ; get x as 16-bit
00EA51  2  A5 AF              LDA   FAC1_3
00EA53  2  8D 11 A0           STA   VGC_P0             ; x low
00EA56  2  A5 AE              LDA   FAC1_2
00EA58  2  8D 12 A0           STA   VGC_P1             ; x high
00EA5B  2  20 06 CE           JSR   LAB_1C01          ; require comma
00EA5E  2  20 AE D8           JSR   LAB_GTBY          ; get y as byte
00EA61  2  8E 13 A0           STX   VGC_P2             ; y low
00EA64  2  9C 14 A0           STZ   VGC_P3             ; y high = 0
00EA67  2  60                 RTS
00EA68  2               
00EA68  2               ; shared: load x0,y0,x1,y1 into VGC_P0-P7
00EA68  2               
00EA68  2               LAB_VGC_XYXY
00EA68  2  20 4E EA           JSR   LAB_VGC_XY        ; x0,y0 → P0-P3
00EA6B  2  20 06 CE           JSR   LAB_1C01          ; comma
00EA6E  2  20 9C D8           JSR   LAB_GTWRD         ; x1 as 16-bit
00EA71  2  A5 AF              LDA   FAC1_3
00EA73  2  8D 15 A0           STA   VGC_P4             ; x1 low
00EA76  2  A5 AE              LDA   FAC1_2
00EA78  2  8D 16 A0           STA   VGC_P5             ; x1 high
00EA7B  2  20 06 CE           JSR   LAB_1C01          ; comma
00EA7E  2  20 AE D8           JSR   LAB_GTBY          ; y1
00EA81  2  8E 17 A0           STX   VGC_P6             ; y1 low
00EA84  2  9C 18 A0           STZ   VGC_P7             ; y1 high = 0
00EA87  2  60                 RTS
00EA88  2               
00EA88  2               ; perform PLOT x, y
00EA88  2               
00EA88  2               LAB_PLOT
00EA88  2  20 4E EA           JSR   LAB_VGC_XY
00EA8B  2  20 C9 E8           JSR   LAB_VSYNC         ; wait before visible graphics mutation
00EA8E  2  A9 01              LDA   #VCMD_PLOT        ; PLOT command
00EA90  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EA93  2               
00EA93  2               ; perform UNPLOT x, y
00EA93  2               
00EA93  2               LAB_UNPLOT
00EA93  2  20 4E EA           JSR   LAB_VGC_XY
00EA96  2  20 C9 E8           JSR   LAB_VSYNC
00EA99  2  A9 02              LDA   #VCMD_UNPLOT      ; UNPLOT command
00EA9B  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EA9E  2               
00EA9E  2               ; perform LINE x0, y0, x1, y1
00EA9E  2               
00EA9E  2               LAB_GLINE
00EA9E  2  20 68 EA           JSR   LAB_VGC_XYXY
00EAA1  2  20 C9 E8           JSR   LAB_VSYNC
00EAA4  2  A9 03              LDA   #VCMD_LINE        ; LINE command
00EAA6  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EAA9  2               
00EAA9  2               ; perform CIRCLE cx, cy, rx [, ry]
00EAA9  2               ; 3 args = circle (rx=ry), 4 args = ellipse
00EAA9  2               
00EAA9  2               LAB_CIRCLE
00EAA9  2  20 4E EA           JSR   LAB_VGC_XY        ; cx,cy → P0-P3
00EAAC  2  20 06 CE           JSR   LAB_1C01          ; comma
00EAAF  2  20 9C D8           JSR   LAB_GTWRD         ; rx as 16-bit
00EAB2  2  A5 AF              LDA   FAC1_3
00EAB4  2  8D 15 A0           STA   VGC_P4             ; rx low
00EAB7  2  A5 AE              LDA   FAC1_2
00EAB9  2  8D 16 A0           STA   VGC_P5             ; rx high
00EABC  2  9C 17 A0           STZ   VGC_P6             ; ry low = 0 (circle)
00EABF  2  9C 18 A0           STZ   VGC_P7             ; ry high = 0
00EAC2  2  20 C2 00           JSR   LAB_GBYT          ; peek next
00EAC5  2  C9 2C              CMP   #','
00EAC7  2  D0 10              BNE   @circ_go
00EAC9  2  20 06 CE           JSR   LAB_1C01          ; consume comma
00EACC  2  20 9C D8           JSR   LAB_GTWRD         ; ry as 16-bit
00EACF  2  A5 AF              LDA   FAC1_3
00EAD1  2  8D 17 A0           STA   VGC_P6             ; ry low
00EAD4  2  A5 AE              LDA   FAC1_2
00EAD6  2  8D 18 A0           STA   VGC_P7             ; ry high
00EAD9  2               @circ_go
00EAD9  2  20 C9 E8           JSR   LAB_VSYNC
00EADC  2  A9 04              LDA   #VCMD_CIRCLE      ; CIRCLE command
00EADE  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EAE1  2               
00EAE1  2               ; perform GTEXT x, y, font, scale, "string"
00EAE1  2               
00EAE1  2               LAB_GTEXT
00EAE1  2  20 4E EA           JSR   LAB_VGC_XY        ; x,y → P0-P3
00EAE4  2  20 06 CE           JSR   LAB_1C01          ; comma
00EAE7  2  20 AE D8           JSR   LAB_GTBY          ; font (0-7) → X
00EAEA  2  8E 15 A0           STX   VGC_P4             ; P4 = font index
00EAED  2  20 06 CE           JSR   LAB_1C01          ; comma
00EAF0  2  20 AE D8           JSR   LAB_GTBY          ; scale (1-8) → X
00EAF3  2  8E 16 A0           STX   VGC_P5             ; P5 = scale
00EAF6  2  20 06 CE           JSR   LAB_1C01          ; comma
00EAF9  2  20 ED F1           JSR   LAB_FIO_GETNAME   ; string → FIO_NAME/FIO_NAMELEN
00EAFC  2  20 C9 E8           JSR   LAB_VSYNC
00EAFF  2  A9 0A              LDA   #VCMD_GTEXT
00EB01  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EB04  2               
00EB04  2               ; ── Tile engine BASIC commands ────────────────────────────────
00EB04  2               ; Full tile command parsing lives in the extension ROM and dispatches through
00EB04  2               ; the shared tile library.
00EB04  2               
00EB04  2               LAB_TILESIZE
00EB04  2  A9 11              LDA   #EXT_CMD_TILESIZE
00EB06  2  4C 21 02           JMP   EXT_vec
00EB09  2               LAB_MIRROR
00EB09  2  A9 12              LDA   #EXT_CMD_TMIRROR
00EB0B  2  4C 21 02           JMP   EXT_vec
00EB0E  2               LAB_TTRANS
00EB0E  2  A9 13              LDA   #EXT_CMD_TTRANS
00EB10  2  4C 21 02           JMP   EXT_vec
00EB13  2               LAB_TDEF
00EB13  2  A9 14              LDA   #EXT_CMD_TDEF
00EB15  2  4C 21 02           JMP   EXT_vec
00EB18  2               LAB_TPUT
00EB18  2  A9 15              LDA   #EXT_CMD_TPUT
00EB1A  2  4C 21 02           JMP   EXT_vec
00EB1D  2               LAB_TATTR
00EB1D  2  A9 16              LDA   #EXT_CMD_TATTR
00EB1F  2  4C 21 02           JMP   EXT_vec
00EB22  2               LAB_TFILL
00EB22  2  A9 17              LDA   #EXT_CMD_TFILL
00EB24  2  4C 21 02           JMP   EXT_vec
00EB27  2               LAB_TCLS
00EB27  2  A9 1B              LDA   #EXT_CMD_TCLS
00EB29  2  4C 21 02           JMP   EXT_vec
00EB2C  2               LAB_TSCROLL
00EB2C  2  A9 20              LDA   #EXT_CMD_TSCROLL
00EB2E  2  4C 21 02           JMP   EXT_vec
00EB31  2               LAB_TPAL
00EB31  2  A9 21              LDA   #EXT_CMD_TPAL
00EB33  2  4C 21 02           JMP   EXT_vec
00EB36  2               LAB_TPALC
00EB36  2  A9 22              LDA   #EXT_CMD_TPALC
00EB38  2  4C 21 02           JMP   EXT_vec
00EB3B  2               
00EB3B  2               ; perform RECT x0, y0, x1, y1
00EB3B  2               
00EB3B  2               LAB_RECT
00EB3B  2  20 68 EA           JSR   LAB_VGC_XYXY
00EB3E  2  20 C9 E8           JSR   LAB_VSYNC
00EB41  2  A9 05              LDA   #VCMD_RECT        ; RECT command
00EB43  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EB46  2               
00EB46  2               ; perform FILL x0, y0, x1, y1
00EB46  2               
00EB46  2               LAB_FILLRECT
00EB46  2  20 68 EA           JSR   LAB_VGC_XYXY
00EB49  2  20 C9 E8           JSR   LAB_VSYNC
00EB4C  2  A9 06              LDA   #VCMD_FILL        ; FILL command
00EB4E  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EB51  2               
00EB51  2               ; perform PAINT x, y
00EB51  2               
00EB51  2               LAB_PAINT
00EB51  2  20 4E EA           JSR   LAB_VGC_XY
00EB54  2  20 C9 E8           JSR   LAB_VSYNC
00EB57  2  A9 09              LDA   #VCMD_PAINT       ; PAINT command
00EB59  2  4C BD E8           JMP   LAB_VGC_CMD_RTS
00EB5C  2               
00EB5C  2               ; perform SPRITE n, ON/OFF  or  SPRITE n, x, y
00EB5C  2               ; sprite number 0-15, ON/OFF enables/disables, x,y sets position
00EB5C  2               ; Uses command-driven VGC interface:
00EB5C  2               ;   SPRENA ($15): P0=sprite
00EB5C  2               ;   SPRDIS ($16): P0=sprite
00EB5C  2               ;   SPRPOS ($14): P0=sprite, P1=x_low, P2=x_high, P3=y_low, P4 reserved
00EB5C  2               
00EB5C  2               LAB_SPRCMD
00EB5C  2  20 AE D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EB5F  2  86 11              STX   Itempl            ; save sprite number
00EB61  2  20 06 CE           JSR   LAB_1C01          ; require comma
00EB64  2  20 C2 00           JSR   LAB_GBYT          ; peek at next token
00EB67  2  C9 93              CMP   #TK_ON            ; is it ON?
00EB69  2  F0 25              BEQ   @spr_on
00EB6B  2  C9 CB              CMP   #TK_OFF           ; is it OFF?
00EB6D  2  F0 2C              BEQ   @spr_off
00EB6F  2                     ; not ON/OFF — parse x, y position
00EB6F  2  A5 11              LDA   Itempl            ; get sprite number
00EB71  2  8D 11 A0           STA   VGC_P0             ; P0 = sprite index
00EB74  2  20 9C D8           JSR   LAB_GTWRD         ; get unsigned x as 16-bit
00EB77  2  A5 AF              LDA   FAC1_3
00EB79  2  8D 12 A0           STA   VGC_P1             ; P1 = x low
00EB7C  2  A5 AE              LDA   FAC1_2
00EB7E  2  8D 13 A0           STA   VGC_P2             ; P2 = x high
00EB81  2  20 06 CE           JSR   LAB_1C01          ; require comma
00EB84  2  20 AE D8           JSR   LAB_GTBY          ; get unsigned y byte
00EB87  2  8E 14 A0           STX   VGC_P3             ; P3 = y
00EB8A  2  9C 15 A0           STZ   VGC_P4             ; P4 reserved
00EB8D  2  4C 3C E9           JMP   sprite_pos         ; trigger and return
00EB90  2               
00EB90  2               @spr_on
00EB90  2  20 BC 00           JSR   LAB_IGBY          ; consume the ON token
00EB93  2  A5 11              LDA   Itempl            ; get sprite number
00EB95  2  8D 11 A0           STA   VGC_P0             ; P0 = sprite index
00EB98  2  4C 41 E9           JMP   sprite_enable      ; trigger and return
00EB9B  2               
00EB9B  2               @spr_off
00EB9B  2  20 BC 00           JSR   LAB_IGBY          ; consume the OFF token
00EB9E  2  A5 11              LDA   Itempl            ; get sprite number
00EBA0  2  8D 11 A0           STA   VGC_P0             ; P0 = sprite index
00EBA3  2  4C 46 E9           JMP   sprite_disable     ; trigger and return
00EBA6  2               
00EBA6  2               ; perform SPRITESHAPE n, shape
00EBA6  2               ; Writes shape index to sprite register VGC_SPR_SHAPE + n*8
00EBA6  2               
00EBA6  2               LAB_SPRSHAPE
00EBA6  2  20 AE D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EBA9  2  86 11              STX   Itempl
00EBAB  2  20 06 CE           JSR   LAB_1C01          ; require comma
00EBAE  2  20 AE D8           JSR   LAB_GTBY          ; get shape index in X
00EBB1  2  8A                 TXA
00EBB2  2  A6 11              LDX   Itempl
00EBB4  2  4C 5B E9           JMP   sprite_set_shape
00EBB7  2               
00EBB7  2               ; perform SPRITESET sprite, field, value — set sprite register
00EBB7  2               ; Field 0 (X) accepts an unsigned word and writes lo+hi bytes.
00EBB7  2               ; Field 2 (Y) and all other fields accept a byte value.
00EBB7  2               ; Hardware vblank-buffers sprite attribute writes; software writes immediately.
00EBB7  2               
00EBB7  2               LAB_SPRCOLOR
00EBB7  2  20 AE D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EBBA  2  86 11              STX   Itempl            ; save sprite number
00EBBC  2  20 06 CE           JSR   LAB_1C01          ; require comma
00EBBF  2  20 AE D8           JSR   LAB_GTBY          ; get field (0-7) in X
00EBC2  2  86 12              STX   Itemph            ; save field number
00EBC4  2  20 06 CE           JSR   LAB_1C01          ; require comma
00EBC7  2  A5 12              LDA   Itemph            ; check field number
00EBC9  2  F0 0B              BEQ   @word_val
00EBCB  2                     ; --- byte field: parse byte value ---
00EBCB  2  20 AE D8           JSR   LAB_GTBY          ; get value (0-255) in X
00EBCE  2  8A                 TXA                     ; A = value
00EBCF  2  A6 11              LDX   Itempl            ; X = sprite number
00EBD1  2  A4 12              LDY   Itemph            ; Y = field
00EBD3  2  4C 5D E9           JMP   sprite_set_reg8
00EBD6  2               @word_val
00EBD6  2                     ; --- word field: parse unsigned word, write lo+hi ---
00EBD6  2  20 9C D8           JSR   LAB_GTWRD         ; get unsigned 16-bit value, lo in FAC1_3, hi in FAC1_2
00EBD9  2  A5 AF              LDA   FAC1_3
00EBDB  2  85 20              STA   NVR0L
00EBDD  2  A5 AE              LDA   FAC1_2
00EBDF  2  85 21              STA   NVR0H
00EBE1  2  A6 11              LDX   Itempl            ; X = sprite number
00EBE3  2  A4 12              LDY   Itemph            ; Y = field
00EBE5  2  4C 68 E9           JMP   sprite_set_reg16
00EBE8  2               
00EBE8  2               ; perform SPRITEDATA sprite, row, b1, b2 [, b3 [, b4 [, b5 [, b6 [, b7 [, b8]]]]]]
00EBE8  2               ; Uses CmdSprRow ($11): P0=sprite, P1=row, P2-P9=8 bytes of row data.
00EBE8  2               ; Unprovided bytes are zeroed.
00EBE8  2               
00EBE8  2               LAB_SPRDATA
00EBE8  2  20 AE D8           JSR   LAB_GTBY          ; get sprite number (0-15) in X
00EBEB  2  8E 11 A0           STX   VGC_P0             ; P0 = sprite index
00EBEE  2  20 06 CE           JSR   LAB_1C01          ; comma
00EBF1  2  20 AE D8           JSR   LAB_GTBY          ; get row (0-15) in X
00EBF4  2  8E 12 A0           STX   VGC_P1             ; P1 = row
00EBF7  2                     ; zero all 8 data bytes first
00EBF7  2  9C 13 A0           STZ   VGC_P2
00EBFA  2  9C 14 A0           STZ   VGC_P3
00EBFD  2  9C 15 A0           STZ   VGC_P4
00EC00  2  9C 16 A0           STZ   VGC_P5
00EC03  2  9C 17 A0           STZ   VGC_P6
00EC06  2  9C 18 A0           STZ   VGC_P7
00EC09  2  9C 19 A0           STZ   VGC_P8
00EC0C  2  9C 1A A0           STZ   VGC_P9
00EC0F  2                     ; parse b1 (required)
00EC0F  2  20 06 CE           JSR   LAB_1C01          ; comma
00EC12  2  20 AE D8           JSR   LAB_GTBY          ; b1 → X
00EC15  2  8E 13 A0           STX   VGC_P2
00EC18  2                     ; parse b2 (required)
00EC18  2  20 06 CE           JSR   LAB_1C01          ; comma
00EC1B  2  20 AE D8           JSR   LAB_GTBY          ; b2 → X
00EC1E  2  8E 14 A0           STX   VGC_P3
00EC21  2                     ; parse optional b3-b8
00EC21  2  20 C2 00           JSR   LAB_GBYT
00EC24  2  C9 2C              CMP   #','
00EC26  2  D0 59              BNE   @sd_done
00EC28  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00EC2B  2  20 AE D8           JSR   LAB_GTBY          ; b3 → X
00EC2E  2  8E 15 A0           STX   VGC_P4
00EC31  2  20 C2 00           JSR   LAB_GBYT
00EC34  2  C9 2C              CMP   #','
00EC36  2  D0 49              BNE   @sd_done
00EC38  2  20 BC 00           JSR   LAB_IGBY
00EC3B  2  20 AE D8           JSR   LAB_GTBY          ; b4 → X
00EC3E  2  8E 16 A0           STX   VGC_P5
00EC41  2  20 C2 00           JSR   LAB_GBYT
00EC44  2  C9 2C              CMP   #','
00EC46  2  D0 39              BNE   @sd_done
00EC48  2  20 BC 00           JSR   LAB_IGBY
00EC4B  2  20 AE D8           JSR   LAB_GTBY          ; b5 → X
00EC4E  2  8E 17 A0           STX   VGC_P6
00EC51  2  20 C2 00           JSR   LAB_GBYT
00EC54  2  C9 2C              CMP   #','
00EC56  2  D0 29              BNE   @sd_done
00EC58  2  20 BC 00           JSR   LAB_IGBY
00EC5B  2  20 AE D8           JSR   LAB_GTBY          ; b6 → X
00EC5E  2  8E 18 A0           STX   VGC_P7
00EC61  2  20 C2 00           JSR   LAB_GBYT
00EC64  2  C9 2C              CMP   #','
00EC66  2  D0 19              BNE   @sd_done
00EC68  2  20 BC 00           JSR   LAB_IGBY
00EC6B  2  20 AE D8           JSR   LAB_GTBY          ; b7 → X
00EC6E  2  8E 19 A0           STX   VGC_P8
00EC71  2  20 C2 00           JSR   LAB_GBYT
00EC74  2  C9 2C              CMP   #','
00EC76  2  D0 09              BNE   @sd_done
00EC78  2  20 BC 00           JSR   LAB_IGBY
00EC7B  2  20 AE D8           JSR   LAB_GTBY          ; b8 → X
00EC7E  2  8E 1A A0           STX   VGC_P9
00EC81  2               @sd_done
00EC81  2  4C 4B E9           JMP   sprite_row         ; trigger and return
00EC84  2               
00EC84  2               ; perform SOUND note, duration [, instrument]
00EC84  2               ; SOUND 60, 10          — MIDI note 60, 10 frames, default instrument 0
00EC84  2               ; SOUND 60, 10, 3       — MIDI note 60, 10 frames, instrument 3
00EC84  2               
00EC84  2               LAB_SOUND
00EC84  2  20 AE D8           JSR   LAB_GTBY          ; midi note → X
00EC87  2  8E A4 B9           STX   AUDIO_NOTE
00EC8A  2  20 06 CE           JSR   LAB_1C01          ; comma
00EC8D  2  20 AE D8           JSR   LAB_GTBY          ; duration → X
00EC90  2  8E A5 B9           STX   AUDIO_DURATION
00EC93  2  9C A6 B9           STZ   AUDIO_INSTRUMENT  ; default instrument = 0
00EC96  2  20 C2 00           JSR   LAB_GBYT          ; peek next token
00EC99  2  C9 2C              CMP   #','
00EC9B  2  D0 09              BNE   @snd_go
00EC9D  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00ECA0  2  20 AE D8           JSR   LAB_GTBY          ; instrument id → X
00ECA3  2  8E A6 B9           STX   AUDIO_INSTRUMENT
00ECA6  2               @snd_go
00ECA6  2  4C AA ED           JMP   audio_sound
00ECA9  2               
00ECA9  2               ; perform VOLUME level (0-15)               — set master volume
00ECA9  2               ; perform VOLUME level, voice (0-255, 1-6)  — set per-voice volume
00ECA9  2               
00ECA9  2               LAB_VOLUME
00ECA9  2  20 AE D8           JSR   LAB_GTBY          ; level → X
00ECAC  2  8E A4 B9           STX   AUDIO_VOLUME
00ECAF  2  9C A5 B9           STZ   AUDIO_VOICE       ; default voice = 0 (master)
00ECB2  2  20 C2 00           JSR   LAB_GBYT          ; peek next token
00ECB5  2  C9 2C              CMP   #','
00ECB7  2  D0 09              BNE   @vol_go
00ECB9  2  20 BC 00           JSR   LAB_IGBY          ; skip comma
00ECBC  2  20 AE D8           JSR   LAB_GTBY          ; voice → X
00ECBF  2  8E A5 B9           STX   AUDIO_VOICE
00ECC2  2               @vol_go
00ECC2  2  4C AF ED           JMP   audio_volume
00ECC5  2               
00ECC5  2               ; perform INSTRUMENT id, waveform, a, d, s, r
00ECC5  2               ; Waveform: $10=TRI, $20=SAW, $40=PULSE, $80=NOISE
00ECC5  2               ; INSTRUMENT 1, $40, 0, 9, 0, 0
00ECC5  2               
00ECC5  2               LAB_ENVELOPE
00ECC5  2  20 AE D8           JSR   LAB_GTBY          ; id → X
00ECC8  2  8E A4 B9           STX   AUDIO_INST_ID
00ECCB  2  20 06 CE           JSR   LAB_1C01          ; comma
00ECCE  2  20 AE D8           JSR   LAB_GTBY          ; waveform → X
00ECD1  2  8E A5 B9           STX   AUDIO_WAVEFORM
00ECD4  2  20 06 CE           JSR   LAB_1C01          ; comma
00ECD7  2  20 AE D8           JSR   LAB_GTBY          ; attack → X
00ECDA  2  8E A6 B9           STX   AUDIO_ATTACK
00ECDD  2  20 06 CE           JSR   LAB_1C01          ; comma
00ECE0  2  20 AE D8           JSR   LAB_GTBY          ; decay → X
00ECE3  2  8E A7 B9           STX   AUDIO_DECAY
00ECE6  2  20 06 CE           JSR   LAB_1C01          ; comma
00ECE9  2  20 AE D8           JSR   LAB_GTBY          ; sustain → X
00ECEC  2  8E A8 B9           STX   AUDIO_SUSTAIN
00ECEF  2  20 06 CE           JSR   LAB_1C01          ; comma
00ECF2  2  20 AE D8           JSR   LAB_GTBY          ; release → X
00ECF5  2  8E A9 B9           STX   AUDIO_RELEASE
00ECF8  2  4C B4 ED           JMP   audio_instrument
00ECFB  2               
00ECFB  2               FIO_NO_STREAMING = 1
00ECFB  2               ; Primary ROM is tight. NIC server entry points are library concerns, so omit
00ECFB  2               ; those helper shims from the BASIC ROM build.
00ECFB  2               NIC_SERVER_COMMANDS = 0
00ECFB  2                     .include "lib/audio.s"
00ECFB  3               ; Shared Nova audio/music helper routines.
00ECFB  3               ;
00ECFB  3               ; These routines are BASIC-agnostic.  They wrap the FIO audio commands behind
00ECFB  3               ; named entry points so BASIC, assembly programs, and future runtimes share one
00ECFB  3               ; audio ABI.
00ECFB  3               
00ECFB  3               .include "audio.inc"
00ECFB  4               ; Shared Nova audio/music runtime interface.
00ECFB  4               ;
00ECFB  4               ; BASIC parses language syntax and loads the argument registers; assembly
00ECFB  4               ; callers can use the same register layout directly.
00ECFB  4               ;
00ECFB  4               ; Sound effect:
00ECFB  4               ;   AUDIO_NOTE       MIDI note
00ECFB  4               ;   AUDIO_DURATION   duration in 60 Hz frames
00ECFB  4               ;   AUDIO_INSTRUMENT instrument slot
00ECFB  4               ;
00ECFB  4               ; Volume:
00ECFB  4               ;   AUDIO_VOLUME     volume level
00ECFB  4               ;   AUDIO_VOICE      0=master, 1..14=voice volume
00ECFB  4               ;
00ECFB  4               ; Instrument:
00ECFB  4               ;   AUDIO_INST_ID    instrument slot
00ECFB  4               ;   AUDIO_WAVEFORM   SID waveform/control byte
00ECFB  4               ;   AUDIO_ATTACK     attack
00ECFB  4               ;   AUDIO_DECAY      decay
00ECFB  4               ;   AUDIO_SUSTAIN    sustain
00ECFB  4               ;   AUDIO_RELEASE    release
00ECFB  4               ;
00ECFB  4               ; Music sequence:
00ECFB  4               ;   AUDIO_VOICE      voice number, 1..14
00ECFB  4               ;   AUDIO_STRLEN     MML byte length
00ECFB  4               ;   AUDIO_STRL/H     pointer to MML bytes
00ECFB  4               ;
00ECFB  4               ; File-backed commands:
00ECFB  4               ;   FIO_NAME/FIO_NAMELEN hold the filename.  Call fio_copy_name first when
00ECFB  4               ;   using a pointer-based filename.
00ECFB  4               ;
00ECFB  4               ; Routines return A=0 on success and A=1 on error unless documented as a raw
00ECFB  4               ; status query.
00ECFB  4               
00ECFB  4               .ifndef AUDIO_INC_INCLUDED
00ECFB  4               AUDIO_INC_INCLUDED = 1
00ECFB  4               
00ECFB  4               .include "fio.inc"
00ECFB  5               ; Shared Nova File I/O helper declarations.
00ECFB  5               ;
00ECFB  5               ; Calling convention for pointer-based filename helpers:
00ECFB  5               ;   FIO_ARG_NAMELEN      filename length, 1..63
00ECFB  5               ;   FIO_ARG_NAMEPTR_L/H  CPU pointer to filename bytes
00ECFB  5               ;
00ECFB  5               ; Calling convention for XRAM streaming setup:
00ECFB  5               ;   FIO_ARG_ADDRL/M/H    flat 24-bit XRAM address
00ECFB  5               ;   FIO_ARG_LENL/H       transfer length; zero means full file for XLOAD
00ECFB  5               ;
00ECFB  5               ; Routines return A=0 on success and A=1 on error. Detailed status remains
00ECFB  5               ; in the FIO_STATUS/FIO_ERRCODE hardware registers.
00ECFB  5               
00ECFB  5               .ifndef FIO_INC_INCLUDED
00ECFB  5               FIO_INC_INCLUDED = 1
00ECFB  5               
00ECFB  5               .include "nova.inc"
00ECFB  6               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
00ECFB  6               ;
00ECFB  6               ; This include is deliberately guarded per symbol so it can coexist with older
00ECFB  6               ; source files that still define a subset of these names locally.
00ECFB  6               
00ECFB  6               .ifndef NOVA_INC_INCLUDED
00ECFB  6               NOVA_INC_INCLUDED = 1
00ECFB  6               
00ECFB  6               ; Nova pseudo-register mailbox. These bytes are available to callers and
00ECFB  6               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
