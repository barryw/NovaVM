00E26A  2  A5 13              LDA   nums_3            ; get lowest byte
00E26C  2  20 89 E2           JSR   LAB_A2HX          ; convert A to ASCII hex byte and output
00E26F  2  A5 12              LDA   nums_2            ; get middle byte
00E271  2  20 89 E2           JSR   LAB_A2HX          ; convert A to ASCII hex byte and output
00E274  2  A5 11              LDA   nums_1            ; get highest byte
00E276  2  20 89 E2           JSR   LAB_A2HX          ; convert A to ASCII hex byte and output
00E279  2               ; *** disable decimal mode patch - comment next line ***
00E279  2               ;      CLD                     ; back to binary
00E279  2               
00E279  2  A2 06              LDX   #$06              ; character count
00E27B  2  A5 78              LDA   TempB             ; get # of characters
00E27D  2  F0 B9              BEQ   EndBHS            ; branch if truncate
00E27F  2               
00E27F  2  AA                 TAX                     ; copy length to X
00E280  2  38                 SEC                     ; set carry for add !
00E281  2  49 FF              EOR   #$FF              ; 1's complement
00E283  2  69 06              ADC   #$06              ; add 6d
00E285  2  F0 CB              BEQ   GoPr2             ; if zero print whole string
00E287  2               
00E287  2  D0 BE              BNE   GoPr1             ; else go make output string (branch always)
00E289  2               
00E289  2               ; convert A to ASCII hex byte and output .. note set decimal mode before calling
00E289  2               
00E289  2               LAB_A2HX
00E289  2  AA                 TAX                     ; save byte
00E28A  2  29 0F              AND   #$0F              ; mask off top bits
