00ECFB  4               
00ECFB  4               ; Input: A = FIO command. Does not check completion/status.
00ECFB  4               ; @label FIO.ISSUE
00ECFB  4               ; @kind routine
00ECFB  4               ; @symbol fio_issue
00ECFB  4               ; @summary Issue a raw FIO command without waiting for completion.
00ECFB  4               ; @in A: FIO command byte.
00ECFB  4               fio_issue:
00ECFB  4  8D A0 B9           STA   FIO_CMD
00ECFE  4  60                 RTS
00ECFF  4               
00ECFF  4               ; Check current FIO_STATUS.
00ECFF  4               ; @label FIO.CHECK
00ECFF  4               ; @kind routine
00ECFF  4               ; @symbol fio_check
00ECFF  4               ; @summary Convert the current FIO status register to the shared A=0/1 result.
00ECFF  4               ; @out A: 0 on success, 1 on error.
00ECFF  4               fio_check:
00ECFF  4  AD A1 B9           LDA   FIO_STATUS
00ED02  4  C9 02              CMP   #FIO_OK
00ED04  4  F0 03              BEQ   @ok
00ED06  4  A9 01              LDA   #FIO_RESULT_ERROR
00ED08  4  60                 RTS
00ED09  4               @ok:
00ED09  4  A9 00              LDA   #FIO_RESULT_OK
00ED0B  4  60                 RTS
00ED0C  4               
00ED0C  4               ; Input: A = FIO command. Issue, wait for completion, and check status.
00ED0C  4               ; @label FIO.EXEC
00ED0C  4               ; @kind routine
00ED0C  4               ; @symbol fio_exec
00ED0C  4               ; @summary Issue an FIO command, wait for completion, and return A=0/1 status.
00ED0C  4               ; @in A: FIO command byte.
00ED0C  4               ; @out A: 0 on success, 1 on error.
00ED0C  4               fio_exec:
00ED0C  4  48                 PHA
00ED0D  4  9C A1 B9           STZ   FIO_STATUS
00ED10  4  9C A2 B9           STZ   FIO_ERRCODE
00ED13  4  68                 PLA
00ED14  4  8D A0 B9           STA   FIO_CMD
00ED17  4               @wait:
00ED17  4  AD A1 B9           LDA   FIO_STATUS
00ED1A  4  F0 FB              BEQ   @wait
00ED1C  4  4C FF EC           JMP   fio_check
00ED1F  4               
00ED1F  4               ; Clear the host-visible FIO error/status latch.
00ED1F  4               ; @label FIO.CLEAR_ERROR
00ED1F  4               ; @kind routine
00ED1F  4               ; @symbol fio_clear_error
00ED1F  4               ; @summary Clear the host-visible FIO status and error latch.
00ED1F  4               ; @out A: 0 on success.
00ED1F  4               fio_clear_error:
00ED1F  4  A9 00              LDA   #FIO_ERR_NONE
00ED21  4  8D A2 B9           STA   FIO_ERRCODE
00ED24  4  A9 02              LDA   #FIO_STATUS_OK
00ED26  4  8D A1 B9           STA   FIO_STATUS
00ED29  4  A9 27              LDA   #FIO_CMD_CLEARERR
00ED2B  4  8D A0 B9           STA   FIO_CMD
00ED2E  4  A9 00              LDA   #FIO_RESULT_OK
00ED30  4  60                 RTS
00ED31  4               
00ED31  4               ; Mark an argument/host I/O error in the hardware status registers.
00ED31  4               ; @label FIO.SET_IO_ERROR
00ED31  4               ; @kind routine
00ED31  4               ; @symbol fio_set_io_error
00ED31  4               ; @summary Set FIO_STATUS/FIO_ERRCODE to the shared I/O error state.
00ED31  4               ; @out A: 1 on error.
00ED31  4               fio_set_io_error:
00ED31  4  A9 03              LDA   #FIO_STATUS_ERROR
00ED33  4  8D A1 B9           STA   FIO_STATUS
00ED36  4  A9 02              LDA   #FIO_ERR_IO
00ED38  4  8D A2 B9           STA   FIO_ERRCODE
00ED3B  4  A9 01              LDA   #FIO_RESULT_ERROR
00ED3D  4  60                 RTS
00ED3E  4               
00ED3E  4               ; Copy filename from FIO_ARG_NAMEPTR_L/H into FIO_NAME.
00ED3E  4               ; @label FIO.COPY_NAME
00ED3E  4               ; @kind routine
00ED3E  4               ; @symbol fio_copy_name
00ED3E  4               ; @summary Copy a pointer-based filename into FIO.NAME/FIO.NAMELEN.
00ED3E  4               ; @requires FIO_ARG_NAMELEN FIO_ARG_NAMEPTR_L FIO_ARG_NAMEPTR_H
00ED3E  4               ; @out A: 0 on success, 1 on invalid name.
00ED3E  4               fio_copy_name:
00ED3E  4  A5 28              LDA   FIO_ARG_NAMELEN
00ED40  4  F0 16              BEQ   @bad
00ED42  4  C9 40              CMP   #FIO_NAME_LIMIT + 1
00ED44  4  B0 12              BCS   @bad
00ED46  4  8D A3 B9           STA   FIO_NAMELEN
00ED49  4  AA                 TAX
00ED4A  4  A0 00              LDY   #$00
00ED4C  4               @copy:
00ED4C  4  B1 29              LDA   (FIO_ARG_NAMEPTR_L),Y
00ED4E  4  99 B0 B9           STA   FIO_NAME,Y
00ED51  4  C8                 INY
00ED52  4  CA                 DEX
00ED53  4  D0 F7              BNE   @copy
00ED55  4  A9 00              LDA   #FIO_RESULT_OK
00ED57  4  60                 RTS
00ED58  4               @bad:
00ED58  4  4C 31 ED           JMP   fio_set_io_error
00ED5B  4               
00ED5B  4               ; @label FIO.SAVE
00ED5B  4               ; @kind routine
00ED5B  4               ; @symbol fio_save
00ED5B  4               ; @summary Save RAM using FIO.NAME plus FIO_SRCL/H and FIO_ENDL/H.
00ED5B  4               ; @requires FIO_NAME FIO_NAMELEN FIO_SRCL FIO_SRCH FIO_ENDL FIO_ENDH
00ED5B  4               fio_save:
00ED5B  4  A9 01              LDA   #FIO_CMD_SAVE
00ED5D  4  4C 0C ED           JMP   fio_exec
00ED60  4               
00ED60  4               ; @label FIO.LOAD
00ED60  4               ; @kind routine
00ED60  4               ; @symbol fio_load
00ED60  4               ; @summary Load a BASIC or binary file using FIO.NAME and FIO_SRCL/H.
00ED60  4               ; @requires FIO_NAME FIO_NAMELEN FIO_SRCL FIO_SRCH
00ED60  4               fio_load:
00ED60  4  A9 02              LDA   #FIO_CMD_LOAD
00ED62  4  4C 0C ED           JMP   fio_exec
00ED65  4               
00ED65  4               ; @label FIO.DIR_OPEN
00ED65  4               ; @kind routine
00ED65  4               ; @symbol fio_dir_open
00ED65  4               ; @summary Open a directory listing using optional FIO.NAME/FIO.NAMELEN filter.
00ED65  4               fio_dir_open:
00ED65  4  A9 03              LDA   #FIO_CMD_DIROPEN
00ED67  4  4C 0C ED           JMP   fio_exec
00ED6A  4               
00ED6A  4               ; @label FIO.DIR_READ
00ED6A  4               ; @kind routine
00ED6A  4               ; @symbol fio_dir_read
00ED6A  4               ; @summary Read the next directory entry into the FIO directory result registers.
00ED6A  4               fio_dir_read:
00ED6A  4  A9 04              LDA   #FIO_CMD_DIRREAD
00ED6C  4  4C 0C ED           JMP   fio_exec
00ED6F  4               
00ED6F  4               ; @label FIO.DELETE
00ED6F  4               ; @kind routine
00ED6F  4               ; @symbol fio_delete
00ED6F  4               ; @summary Delete the file named by FIO.NAME/FIO.NAMELEN.
00ED6F  4               ; @requires FIO_NAME FIO_NAMELEN
00ED6F  4               fio_delete:
00ED6F  4  A9 05              LDA   #FIO_CMD_DELETE
00ED71  4  4C 0C ED           JMP   fio_exec
00ED74  4               
00ED74  4               ; @label FIO.GSAVE
00ED74  4               ; @kind routine
00ED74  4               ; @symbol fio_gsave
00ED74  4               ; @summary Save VGC/graphics memory using FIO graphics registers.
00ED74  4               ; @requires FIO_NAME FIO_NAMELEN FIO_GSPACE FIO_GADDRL FIO_GADDRH FIO_GLENL FIO_GLENH
00ED74  4               fio_gsave:
00ED74  4  A9 06              LDA   #FIO_CMD_GSAVE
00ED76  4  4C 0C ED           JMP   fio_exec
00ED79  4               
00ED79  4               ; @label FIO.GLOAD
00ED79  4               ; @kind routine
00ED79  4               ; @symbol fio_gload
00ED79  4               ; @summary Load VGC/graphics memory using FIO graphics registers.
00ED79  4               ; @requires FIO_NAME FIO_NAMELEN FIO_GSPACE FIO_GADDRL FIO_GADDRH FIO_GLENL FIO_GLENH
00ED79  4               fio_gload:
00ED79  4  A9 07              LDA   #FIO_CMD_GLOAD
00ED7B  4  4C 0C ED           JMP   fio_exec
00ED7E  4               
00ED7E  4               ; @label FIO.CD
00ED7E  4               ; @kind routine
00ED7E  4               ; @symbol fio_cd
00ED7E  4               ; @summary Change directory to FIO.NAME/FIO.NAMELEN.
00ED7E  4               ; @requires FIO_NAME FIO_NAMELEN
00ED7E  4               fio_cd:
00ED7E  4  A9 20              LDA   #FIO_CMD_CD
00ED80  4  4C 0C ED           JMP   fio_exec
00ED83  4               
00ED83  4               ; @label FIO.MKDIR
00ED83  4               ; @kind routine
00ED83  4               ; @symbol fio_mkdir
00ED83  4               ; @summary Create the directory named by FIO.NAME/FIO.NAMELEN.
00ED83  4               ; @requires FIO_NAME FIO_NAMELEN
00ED83  4               fio_mkdir:
00ED83  4  A9 21              LDA   #FIO_CMD_MKDIR
00ED85  4  4C 0C ED           JMP   fio_exec
00ED88  4               
00ED88  4               ; @label FIO.RMDIR
00ED88  4               ; @kind routine
00ED88  4               ; @symbol fio_rmdir
00ED88  4               ; @summary Remove the directory named by FIO.NAME/FIO_NAMELEN.
00ED88  4               ; @requires FIO_NAME FIO_NAMELEN
00ED88  4               fio_rmdir:
