00E90F  5               .ifndef EXT_ARG_PTRL
00E90F  5               EXT_ARG_PTRL      = $EB
00E90F  5               .endif
00E90F  5               .ifndef EXT_ARG_PTRH
00E90F  5               EXT_ARG_PTRH      = $EC
00E90F  5               .endif
