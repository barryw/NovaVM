00E2B7  2  69 0A              ADC   #$0A              ; convert to nibble
00E2B9  2               LAB_ISHN
00E2B9  2  29 0F              AND   #$0F              ; convert to binary
00E2BB  2  AA                 TAX                     ; save nibble
00E2BC  2  A5 AC              LDA   FAC1_e            ; get FAC1 exponent
00E2BE  2  F0 E4              BEQ   LAB_MLTE          ; skip multiply if zero
00E2C0  2               
00E2C0  2  69 04              ADC   #$04              ; add four to exponent (*16 - carry clear here)
00E2C2  2  90 DC              BCC   LAB_NLTO          ; if no overflow do evaluate digit
00E2C4  2               
00E2C4  2               LAB_MLTO
