00EE6F  2                     .include "lib/nic.s"
00EE6F  3               ; Shared Nova NIC helper routines.
00EE6F  3               
00EE6F  3               .include "nic.inc"
00EE6F  4               ; Shared Nova NIC runtime interface.
00EE6F  4               ;
00EE6F  4               ; BASIC handles string allocation/parsing.  Assembly callers can use these
00EE6F  4               ; routines by loading the NIC MMIO registers directly.
00EE6F  4               ;
00EE6F  4               ; Connect:
00EE6F  4               ;   NIC_SLOT      slot number
00EE6F  4               ;   NIC_NAMEBUF   zero-terminated host name
00EE6F  4               ;   NIC_RPORTL/H  remote port
00EE6F  4               ;
00EE6F  4               ; Listen:
00EE6F  4               ;   NIC_SLOT      slot number
00EE6F  4               ;   NIC_LPORTL/H  local port
00EE6F  4               ;
00EE6F  4               ; Send:
00EE6F  4               ;   NIC_SLOT      slot number
00EE6F  4               ;   NIC_DMAL/H    CPU pointer to bytes
00EE6F  4               ;   NIC_DMALEN    byte count
00EE6F  4               ;
00EE6F  4               ; Receive:
00EE6F  4               ;   NIC_SLOT      slot number
00EE6F  4               ;   NIC_DMAL/H    CPU destination pointer
00EE6F  4               ;   NIC_MSGLEN    byte count returned by hardware
00EE6F  4               
00EE6F  4               .ifndef NIC_INC_INCLUDED
00EE6F  4               NIC_INC_INCLUDED = 1
00EE6F  4               
00EE6F  4               .include "nova.inc"
00EE6F  5               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
00EE6F  5               ;
00EE6F  5               ; This include is deliberately guarded per symbol so it can coexist with older
00EE6F  5               ; source files that still define a subset of these names locally.
00EE6F  5               
00EE6F  5               .ifndef NOVA_INC_INCLUDED
00EE6F  5               NOVA_INC_INCLUDED = 1
00EE6F  5               
00EE6F  5               ; Nova pseudo-register mailbox. These bytes are available to callers and
00EE6F  5               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
00EE6F  5               ; clobber them unless its documentation explicitly says otherwise; persistent
00EE6F  5               ; library state must be allocated in a linker segment such as BSS/ZEROPAGE.
00EE6F  5               .ifndef NVR0L
00EE6F  5               NVR0L             = $20
00EE6F  5               .endif
