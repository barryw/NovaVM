00F045  2               
00F045  2               LAB_MIDPLAY
00F045  2  20 ED F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00F048  2  9C A4 B9           STZ   FIO_SRCL          ; no explicit mapping; auto-select channels
00F04B  2  20 C7 ED           JSR   audio_midplay
00F04E  2  D0 01              BNE   @mp_err
00F050  2  60                 RTS
00F051  2               @mp_err
