00EF72  2               
00EF72  2               LAB_GLOAD
00EF72  2  20 ED F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00EF75  2  20 06 CE           JSR   LAB_1C01          ; comma
00EF78  2  20 AE D8           JSR   LAB_GTBY          ; graphics space id
00EF7B  2  8E AA B9           STX   FIO_GSPACE
00EF7E  2  20 06 CE           JSR   LAB_1C01          ; comma
00EF81  2  20 9C D8           JSR   LAB_GTWRD         ; graphics offset
00EF84  2  A5 AF              LDA   FAC1_3
00EF86  2  8D AB B9           STA   FIO_GADDRL
00EF89  2  A5 AE              LDA   FAC1_2
00EF8B  2  8D AC B9           STA   FIO_GADDRH
