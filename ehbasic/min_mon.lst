00EDCD  4  4C 5E ED           JMP   fio_exec
00EDD0  4               
00EDD0  4               ; @label FIO.CD
00EDD0  4               ; @kind routine
00EDD0  4               ; @symbol fio_cd
00EDD0  4               ; @summary Change directory to FIO.NAME/FIO.NAMELEN.
