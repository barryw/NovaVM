00F150  2               ; --- MUSIC voice, "mml" ---
00F150  2               ; Pass string via pointer (ut1_pl/ph) so MML strings can exceed 63 bytes.
00F150  2               ; FIO_SRCL = voice, FIO_ENDL/ENDH = string pointer, FIO_NAMELEN = length.
00F150  2               @m_seq
00F150  2  20 B1 D8           JSR   LAB_GTBY          ; voice number (1-14) → X
00F153  2  8E A5 B9           STX   AUDIO_VOICE       ; store voice
00F156  2  20 09 CE           JSR   LAB_1C01          ; comma
00F159  2  20 E8 CC           JSR   LAB_EVEX          ; evaluate expression
00F15C  2  20 50 D7           JSR   LAB_EVST          ; pop string: A=len, ut1_pl/ph=ptr
00F15F  2  AA                 TAX
00F160  2  F0 13              BEQ   @m_seq_err        ; empty string = error
00F162  2  8E A3 B9           STX   AUDIO_STRLEN      ; string length (1-255)
00F165  2  A5 71              LDA   ut1_pl
00F167  2  8D A6 B9           STA   AUDIO_STRL        ; string pointer low
00F16A  2  A5 72              LDA   ut1_ph
