00EE10  3               
00EE10  3               .if AUDIO_FILE_COMMANDS
00EE10  3               ; @label AUDIO.SIDPLAY
00EE10  3               ; @kind routine
00EE10  3               ; @symbol audio_sidplay
00EE10  3               ; @abi pseudo-register
00EE10  3               ; @summary Play the SID file named by FIO.NAME/FIO.NAMELEN. AUDIO.NOTE is reused as the 1-based song number.
00EE10  3               ; @requires FIO.NAME FIO.NAMELEN AUDIO.NOTE
00EE10  3               ; @out A: 0 on success, nonzero on error
00EE10  3               audio_sidplay:
00EE10  3  A9 08              LDA   #FIO_CMD_SIDPLAY
00EE12  3  20 5E ED           JSR   fio_exec
00EE15  3  D0 01              BNE   @done
00EE17  3  58                 CLI                     ; playback needs timer IRQs active
00EE18  3               @done:
00EE18  3  60                 RTS
00EE19  3               
