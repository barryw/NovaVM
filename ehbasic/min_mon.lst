00EDC3  2               
00EDC3  2               ; --- VGC function handlers ---
00EDC3  2               
00EDC3  2               ; perform SPRITEX(n) — return X position of sprite n as unsigned word
00EDC3  2               
00EDC3  2               LAB_SPRITEX
00EDC3  2  20 A3 D8           JSR   LAB_F2FX          ; convert FAC1 to integer, low byte in Itempl
00EDC6  2  A6 11              LDX   Itempl            ; get sprite number
00EDC8  2  20 FA E8           JSR   sprite_get_x      ; Y = X low byte, A = X high byte
00EDCB  2  4C FE D3           JMP   LAB_AYFC          ; return AY as numeric value
00EDCE  2               
00EDCE  2               ; perform SPRITEY(n) — return Y position of sprite n as unsigned byte
00EDCE  2               
00EDCE  2               LAB_SPRITEY
00EDCE  2  20 A3 D8           JSR   LAB_F2FX          ; convert FAC1 to integer, low byte in Itempl
00EDD1  2  A6 11              LDX   Itempl            ; get sprite number
00EDD3  2  20 0B E9           JSR   sprite_get_y      ; Y = Y position
00EDD6  2  4C 32 D1           JMP   LAB_RET_0AY       ; return AY as numeric value
00EDD9  2               
00EDD9  2               ; perform COLLISION(n) — return sprite-sprite collision register
00EDD9  2               ; argument already consumed by preprocessor
00EDD9  2               
00EDD9  2               LAB_COLLISION
00EDD9  2  20 15 E9           JSR   sprite_collision_status
00EDDC  2  A8                 TAY
00EDDD  2  4C 32 D1           JMP   LAB_RET_0AY
00EDE0  2               
00EDE0  2               ; perform BUMPED(n) — return sprite-background collision register
00EDE0  2               
00EDE0  2               LAB_BUMPED
00EDE0  2  20 19 E9           JSR   sprite_background_collision_status
00EDE3  2  A8                 TAY
00EDE4  2  4C 32 D1           JMP   LAB_RET_0AY
00EDE7  2               
00EDE7  2               ; --- File I/O command handlers ---
00EDE7  2               
00EDE7  2               ; perform SAVE "filename"                     (program save)
00EDE7  2               ; or      SAVE "filename", address, length    (raw block save)
00EDE7  2               
00EDE7  2               LAB_FSAVE
00EDE7  2  20 4C F1           JSR   LAB_FIO_GETNAME   ; parse filename into FIO_NAME (errors internally)
00EDEA  2  20 C2 00           JSR   LAB_GBYT          ; peek at next token
00EDED  2  C9 2C              CMP   #','
00EDEF  2  F0 16              BEQ   @sv_raw
00EDF1  2                     ; default: save BASIC program area
00EDF1  2  A5 79              LDA   Smeml
00EDF3  2  8D A4 B9           STA   FIO_SRCL
00EDF6  2  A5 7A              LDA   Smemh
00EDF8  2  8D A5 B9           STA   FIO_SRCH
00EDFB  2  A5 7B              LDA   Svarl
00EDFD  2  8D A6 B9           STA   FIO_ENDL
00EE00  2  A5 7C              LDA   Svarh
00EE02  2  8D A7 B9           STA   FIO_ENDH
00EE05  2  80 27              BRA   @sv_go
00EE07  2               @sv_raw
00EE07  2  20 09 CE           JSR   LAB_1C01          ; comma
00EE0A  2  20 33 D8           JSR   LAB_GTWRD         ; source address
00EE0D  2  A5 AF              LDA   FAC1_3
00EE0F  2  8D A4 B9           STA   FIO_SRCL
00EE12  2  A5 AE              LDA   FAC1_2
00EE14  2  8D A5 B9           STA   FIO_SRCH
00EE17  2  20 09 CE           JSR   LAB_1C01          ; comma
00EE1A  2  20 33 D8           JSR   LAB_GTWRD         ; length
00EE1D  2  18                 CLC
00EE1E  2  AD A4 B9           LDA   FIO_SRCL
00EE21  2  65 AF              ADC   FAC1_3
00EE23  2  8D A6 B9           STA   FIO_ENDL
00EE26  2  AD A5 B9           LDA   FIO_SRCH
00EE29  2  65 AE              ADC   FAC1_2
00EE2B  2  8D A7 B9           STA   FIO_ENDH
00EE2E  2               @sv_go
00EE2E  2  20 A7 EC           JSR   fio_save
00EE31  2  F0 03              BEQ   @sv_ok
00EE33  2  4C 81 F1           JMP   LAB_FIO_ERRIO
00EE36  2               @sv_ok
00EE36  2  60                 RTS
00EE37  2               
00EE37  2               ; perform LOAD "filename"
00EE37  2               ; File type is auto-detected by extension:
00EE37  2               ;   .bas — loaded into BASIC program space, pointers updated
00EE37  2               ;   .bin — loaded at embedded address (from 2-byte file header)
00EE37  2               
00EE37  2               LAB_FLOAD
00EE37  2  20 4C F1           JSR   LAB_FIO_GETNAME   ; parse filename into FIO_NAME (errors internally)
00EE3A  2                     ; set default load address to BASIC program start
00EE3A  2  A5 79              LDA   Smeml
00EE3C  2  8D A4 B9           STA   FIO_SRCL
00EE3F  2  A5 7A              LDA   Smemh
00EE41  2  8D A5 B9           STA   FIO_SRCH
00EE44  2  20 AC EC           JSR   fio_load
00EE47  2  D0 42              BNE   @ld_chk_err
00EE49  2                     ; check file type — host sets FIO_DIRTYPE after load
00EE49  2  AD AF B9           LDA   FIO_DIRTYPE
00EE4C  2  C9 02              CMP   #$02              ; .bin file?
00EE4E  2  F0 1E              BEQ   @ld_bin_ok
00EE50  2                     ; .bas file — update Svarl/Svarh = Smeml + FIO_SIZE
00EE50  2  18                 CLC
00EE51  2  A5 79              LDA   Smeml
00EE53  2  6D A8 B9           ADC   FIO_SIZEL
00EE56  2  85 7B              STA   Svarl
00EE58  2  A5 7A              LDA   Smemh
00EE5A  2  6D A9 B9           ADC   FIO_SIZEH
00EE5D  2  85 7C              STA   Svarh
00EE5F  2                     ; reset array/var pointers so LIST works correctly
00EE5F  2  A5 7B              LDA   Svarl
00EE61  2  85 7D              STA   Sarryl
00EE63  2  85 7F              STA   Earryl
00EE65  2  A5 7C              LDA   Svarh
00EE67  2  85 7E              STA   Sarryh
00EE69  2  85 80              STA   Earryh
00EE6B  2  4C 7D C1           JMP   LAB_1274          ; print Ready, return to command loop
00EE6E  2               @ld_bin_ok
00EE6E  2                     ; In program mode, silently continue; in immediate mode, print address
00EE6E  2  A5 88              LDA   Clineh
00EE70  2  C9 FF              CMP   #$FF
00EE72  2  D0 16              BNE   @ld_bin_done      ; running from a program — just return
00EE74  2  A9 8E              LDA   #<@s_loaded
00EE76  2  A0 EE              LDY   #>@s_loaded
00EE78  2  20 EC CA           JSR   LAB_18C3          ; print string
00EE7B  2  AD A5 B9           LDA   FIO_SRCH          ; high byte of load address
00EE7E  2  20 64 F1           JSR   LAB_PRHEX
00EE81  2  AD A4 B9           LDA   FIO_SRCL          ; low byte
00EE84  2  20 64 F1           JSR   LAB_PRHEX
00EE87  2  4C 7D C1           JMP   LAB_1274          ; print Ready, return to command loop
00EE8A  2               @ld_bin_done
00EE8A  2  60                 RTS
00EE8B  2               @ld_chk_err
00EE8B  2  4C 7A F1           JMP   LAB_FIO_ERRHND
00EE8E  2  0D 0A 4C 6F  @s_loaded .byte $0D,$0A,"Loaded at $",0
00EE92  2  61 64 65 64  
00EE96  2  20 61 74 20  
00EE9C  2               
00EE9C  2               ; perform GSAVE "filename", space, offset, length
00EE9C  2               
00EE9C  2               LAB_GSAVE
00EE9C  2  20 4C F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00EE9F  2  20 09 CE           JSR   LAB_1C01          ; comma
00EEA2  2  20 45 D8           JSR   LAB_GTBY          ; graphics space id
00EEA5  2  8E AA B9           STX   FIO_GSPACE
00EEA8  2  20 09 CE           JSR   LAB_1C01          ; comma
00EEAB  2  20 33 D8           JSR   LAB_GTWRD         ; graphics offset
00EEAE  2  A5 AF              LDA   FAC1_3
00EEB0  2  8D AB B9           STA   FIO_GADDRL
00EEB3  2  A5 AE              LDA   FAC1_2
00EEB5  2  8D AC B9           STA   FIO_GADDRH
00EEB8  2  20 09 CE           JSR   LAB_1C01          ; comma
00EEBB  2  20 33 D8           JSR   LAB_GTWRD         ; graphics length
00EEBE  2  A5 AF              LDA   FAC1_3
00EEC0  2  8D AD B9           STA   FIO_GLENL
00EEC3  2  A5 AE              LDA   FAC1_2
