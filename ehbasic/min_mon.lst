00EFB6  2               LAB_FIO_EXEC
00EFB6  2  20 58 EC           JSR   fio_exec
00EFB9  2  D0 01              BNE   @fio_chk_err
00EFBB  2  60                 RTS
00EFBC  2               @fio_chk_err
00EFBC  2  4C 7A F1           JMP   LAB_FIO_ERRHND
00EFBF  2               
00EFBF  2               ; Skip X characters from BASIC input
00EFBF  2               LAB_SKIPX
00EFBF  2  20 BC 00           JSR   LAB_IGBY
00EFC2  2  CA                 DEX
00EFC3  2  D0 FA              BNE   LAB_SKIPX
00EFC5  2  60                 RTS
00EFC6  2               
00EFC6  2               ; perform MUSIC subcommand
00EFC6  2               ; MUSIC voice, "mml"
00EFC6  2               ; MUSIC PLAY | STOP | TEMPO bpm | LOOP ON|OFF | PRIORITY v1[,v2[,v3]]
00EFC6  2               
00EFC6  2               LAB_MUSIC
00EFC6  2  20 C2 00           JSR   LAB_GBYT          ; peek next byte (after MUSIC token consumed)
00EFC9  2  C9 50              CMP   #'P'
00EFCB  2  F0 0F              BEQ   @m_chk_p
00EFCD  2  C9 92              CMP   #TK_STOP           ; STOP is tokenized by BASIC
00EFCF  2  F0 1A              BEQ   @m_stop_tok
00EFD1  2  C9 54              CMP   #'T'
00EFD3  2  F0 1C              BEQ   @m_tempo
00EFD5  2  C9 9E              CMP   #TK_LOOP           ; LOOP is tokenized by BASIC
00EFD7  2  F0 2D              BEQ   @m_loop_tok
00EFD9  2                     ; Not a subcommand — must be a number (voice 1-6)
00EFD9  2  4C 58 F0           JMP   @m_seq
00EFDC  2               
00EFDC  2               ; --- MUSIC PLAY or PRIORITY ---
00EFDC  2               @m_chk_p
00EFDC  2                     ; Consume P, then check next char to distinguish PLAY vs PRIORITY
00EFDC  2  20 BC 00           JSR   LAB_IGBY          ; consume P, A = next char
00EFDF  2  C9 52              CMP   #'R'              ; PRIORITY has R after P
00EFE1  2  F0 47              BEQ   @m_priority
00EFE3  2                     ; else PLAY — consume remaining "LAY" (3 chars, P already consumed)
00EFE3  2  A2 03              LDX   #3
00EFE5  2  20 BF EF           JSR   LAB_SKIPX          ; LAY
00EFE8  2  4C 2C ED           JMP   audio_music_play
00EFEB  2               
00EFEB  2               ; --- MUSIC STOP (TK_STOP is a single token byte) ---
00EFEB  2               @m_stop_tok
00EFEB  2  20 BC 00           JSR   LAB_IGBY          ; consume TK_STOP token
00EFEE  2  4C 35 ED           JMP   audio_music_stop
00EFF1  2               
00EFF1  2               ; --- MUSIC TEMPO bpm ---
00EFF1  2               @m_tempo
00EFF1  2  A2 05              LDX   #5
00EFF3  2  20 BF EF           JSR   LAB_SKIPX          ; TEMPO
00EFF6  2  20 33 D8           JSR   LAB_GTWRD         ; bpm as 16-bit → FAC1_3(lo), FAC1_2(hi)
00EFF9  2  A5 AF              LDA   FAC1_3
00EFFB  2  8D A4 B9           STA   FIO_SRCL
00EFFE  2  A5 AE              LDA   FAC1_2
00F000  2  8D A5 B9           STA   FIO_SRCH
00F003  2  4C 3A ED           JMP   audio_music_tempo
00F006  2               
00F006  2               ; --- MUSIC LOOP ON|OFF (TK_LOOP is a single token byte) ---
00F006  2               @m_loop_tok
00F006  2  20 BC 00           JSR   LAB_IGBY          ; consume TK_LOOP token
00F009  2  20 C2 00           JSR   LAB_GBYT          ; skip spaces, get TK_ON or TK_OFF
00F00C  2  C9 93              CMP   #TK_ON
00F00E  2  F0 07              BEQ   @m_loop_on
00F010  2  C9 CB              CMP   #TK_OFF
00F012  2  F0 0D              BEQ   @m_loop_off
00F014  2  4C EA C5           JMP   LAB_15D9          ; syntax error
00F017  2               @m_loop_on
00F017  2  20 BC 00           JSR   LAB_IGBY          ; consume ON token
00F01A  2  A9 01              LDA   #$01
00F01C  2  8D A4 B9           STA   FIO_SRCL
00F01F  2  80 06              BRA   @m_loop_go
00F021  2               @m_loop_off
00F021  2  20 BC 00           JSR   LAB_IGBY          ; consume OFF token
00F024  2  9C A4 B9           STZ   FIO_SRCL
00F027  2               @m_loop_go
00F027  2  4C 3F ED           JMP   audio_music_loop
00F02A  2               
00F02A  2               ; --- MUSIC PRIORITY v1[,v2[,v3[,v4[,v5[,v6]]]]] ---
00F02A  2               @m_priority
00F02A  2                     ; P already consumed by @m_chk_p.  Skip remaining keyword bytes.
00F02A  2                     ; "RIORITY" is tokenized as R,I,TK_OR,I,T,Y (OR becomes a token),
00F02A  2                     ; so we scan dynamically instead of using a fixed IGBY count.
00F02A  2               @m_pri_skip
00F02A  2  20 BC 00           JSR   LAB_IGBY          ; advance past current byte
