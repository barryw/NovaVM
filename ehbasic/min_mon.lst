00EFC8  2               
00EFC8  2               ; perform XLOAD "filename", offset [,length]
00EFC8  2               
00EFC8  2               LAB_XLOAD
00EFC8  2  20 ED F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00EFCB  2  20 06 CE           JSR   LAB_1C01          ; comma
00EFCE  2  20 B4 EF           JSR   LAB_XFIO_SETOFF   ; XRAM destination offset + bank
00EFD1  2  9C AD B9           STZ   FIO_GLENL         ; default: load full file
00EFD4  2  9C AE B9           STZ   FIO_GLENH
00EFD7  2  20 C2 00           JSR   LAB_GBYT          ; optional comma,length
00EFDA  2  C9 2C              CMP   #','
00EFDC  2  D0 10              BNE   @xl_go
00EFDE  2  20 06 CE           JSR   LAB_1C01
00EFE1  2  20 9C D8           JSR   LAB_GTWRD
00EFE4  2  A5 AF              LDA   FAC1_3
00EFE6  2  8D AD B9           STA   FIO_GLENL
00EFE9  2  A5 AE              LDA   FAC1_2
00EFEB  2  8D AE B9           STA   FIO_GLENH
00EFEE  2               @xl_go
00EFEE  2  A9 0D              LDA   #EXT_CMD_XLOAD
00EFF0  2  80 1D              BRA   LAB_XFIO_EXEC     ; issue command through shared XRAM runtime
00EFF2  2               
00EFF2  2               ; perform XSAVE "filename", offset, length
00EFF2  2               
00EFF2  2               LAB_XSAVE
00EFF2  2  20 ED F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00EFF5  2  20 06 CE           JSR   LAB_1C01          ; comma
00EFF8  2  20 B4 EF           JSR   LAB_XFIO_SETOFF   ; XRAM source offset + bank
00EFFB  2  20 06 CE           JSR   LAB_1C01          ; comma
00EFFE  2  20 9C D8           JSR   LAB_GTWRD
00F001  2  A5 AF              LDA   FAC1_3
00F003  2  8D AD B9           STA   FIO_GLENL
00F006  2  A5 AE              LDA   FAC1_2
00F008  2  8D AE B9           STA   FIO_GLENH
00F00B  2  A9 0E              LDA   #EXT_CMD_XSAVE
00F00D  2  80 00              BRA   LAB_XFIO_EXEC     ; issue command through shared XRAM runtime
00F00F  2               
00F00F  2               LAB_XFIO_EXEC
00F00F  2  20 21 02           JSR   EXT_vec
00F012  2  D0 01              BNE   @xerr
00F014  2  60                 RTS
00F015  2               @xerr
00F015  2  4C 1B F2           JMP   LAB_FIO_ERRHND
00F018  2               
00F018  2               ; common: call extension command in A and raise Function Call Error on A!=0
00F018  2               LAB_EXT_FCER
00F018  2  20 21 02           JSR   EXT_vec
00F01B  2  D0 01              BNE   @ext_bad
00F01D  2  60                 RTS
00F01E  2               @ext_bad
