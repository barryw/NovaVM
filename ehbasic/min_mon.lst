00ECFB  4               ; @symbol AUDIO_ATTACK
00ECFB  4               ; @summary Attack nibble for AUDIO.INSTRUMENT_SET.
00ECFB  4               AUDIO_ATTACK     = FIO_ENDL
00ECFB  4               ; @label AUDIO.DECAY
00ECFB  4               ; @kind u8
00ECFB  4               ; @symbol AUDIO_DECAY
00ECFB  4               ; @summary Decay nibble for AUDIO.INSTRUMENT_SET.
00ECFB  4               AUDIO_DECAY      = FIO_ENDH
00ECFB  4               ; @label AUDIO.SUSTAIN
00ECFB  4               ; @kind u8
00ECFB  4               ; @symbol AUDIO_SUSTAIN
00ECFB  4               ; @summary Sustain nibble for AUDIO.INSTRUMENT_SET.
00ECFB  4               AUDIO_SUSTAIN    = FIO_SIZEL
00ECFB  4               ; @label AUDIO.RELEASE
