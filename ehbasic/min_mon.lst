00E90F  3               ; Shared Nova VGC helper routines.
00E90F  3               ;
00E90F  3               ; BASIC should parse language syntax and load VGC registers; assembly callers
00E90F  3               ; can use the same routines directly after setting VGC_P* arguments.
00E90F  3               
00E90F  3               .include "vgc.inc"
00E90F  4               ; Shared Nova VGC helper declarations.
00E90F  4               ;
00E90F  4               ; The command helpers use the VGC hardware parameter registers directly:
00E90F  4               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
00E90F  4               ; Routines return through the hardware status model; command completion can be
00E90F  4               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
00E90F  4               
00E90F  4               .ifndef VGC_INC_INCLUDED
00E90F  4               VGC_INC_INCLUDED = 1
00E90F  4               
00E90F  4               .include "nova.inc"
00E90F  5               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
00E90F  5               ;
00E90F  5               ; This include is deliberately guarded per symbol so it can coexist with older
00E90F  5               ; source files that still define a subset of these names locally.
00E90F  5               
00E90F  5               .ifndef NOVA_INC_INCLUDED
00E90F  5               NOVA_INC_INCLUDED = 1
00E90F  5               
00E90F  5               ; Nova pseudo-register mailbox. These bytes are available to callers and
00E90F  5               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
00E90F  5               ; clobber them unless its documentation explicitly says otherwise; persistent
00E90F  5               ; library state must be allocated in a linker segment such as BSS/ZEROPAGE.
00E90F  5               .ifndef NVR0L
00E90F  5               NVR0L             = $20
00E90F  5               .endif
00E90F  5               .ifndef NVR0H
00E90F  5               NVR0H             = $21
00E90F  5               .endif
00E90F  5               .ifndef NVR1L
00E90F  5               NVR1L             = $22
00E90F  5               .endif
00E90F  5               .ifndef NVR1H
00E90F  5               NVR1H             = $23
00E90F  5               .endif
00E90F  5               .ifndef NVR2L
00E90F  5               NVR2L             = $24
00E90F  5               .endif
00E90F  5               .ifndef NVR2H
00E90F  5               NVR2H             = $25
00E90F  5               .endif
00E90F  5               .ifndef NVR3L
00E90F  5               NVR3L             = $26
00E90F  5               .endif
00E90F  5               .ifndef NVR3H
00E90F  5               NVR3H             = $27
00E90F  5               .endif
00E90F  5               .ifndef NVR4L
00E90F  5               NVR4L             = $28
00E90F  5               .endif
00E90F  5               .ifndef NVR4H
00E90F  5               NVR4H             = $29
00E90F  5               .endif
00E90F  5               .ifndef NVR5L
00E90F  5               NVR5L             = $2A
00E90F  5               .endif
00E90F  5               .ifndef NVR5H
00E90F  5               NVR5H             = $2B
00E90F  5               .endif
00E90F  5               .ifndef NVR6L
00E90F  5               NVR6L             = $2C
00E90F  5               .endif
00E90F  5               .ifndef NVR6H
00E90F  5               NVR6H             = $2D
00E90F  5               .endif
00E90F  5               .ifndef NVR7L
00E90F  5               NVR7L             = $2E
00E90F  5               .endif
00E90F  5               .ifndef NVR7H
00E90F  5               NVR7H             = $2F
00E90F  5               .endif
00E90F  5               
00E90F  5               ; BASIC SYS register bridge. SYS addr[,A[,X[,Y]]] loads A/X/Y from these
00E90F  5               ; bytes before jumping and stores A/X/Y back here when the routine returns.
00E90F  5               ; @label SYS.REGA
00E90F  5               ; @kind u8
00E90F  5               ; @symbol SYS_REGA
00E90F  5               ; @summary Returned A register from the most recent SYS call.
00E90F  5               .ifndef SYS_REGA
00E90F  5               SYS_REGA          = $E7
00E90F  5               .endif
00E90F  5               ; @label SYS.REGX
00E90F  5               ; @kind u8
00E90F  5               ; @symbol SYS_REGX
00E90F  5               ; @summary Returned X register from the most recent SYS call.
00E90F  5               .ifndef SYS_REGX
00E90F  5               SYS_REGX          = $E8
00E90F  5               .endif
00E90F  5               ; @label SYS.REGY
00E90F  5               ; @kind u8
00E90F  5               ; @symbol SYS_REGY
00E90F  5               ; @summary Returned Y register from the most recent SYS call.
00E90F  5               .ifndef SYS_REGY
00E90F  5               SYS_REGY          = $E9
00E90F  5               .endif
00E90F  5               
