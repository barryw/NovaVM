00EE4C  3  4C 5E ED           JMP   fio_exec
00EE4F  3               
00EE4F  3               ; @label AUDIO.STATUS
00EE4F  3               ; @kind routine
00EE4F  3               ; @symbol audio_status
00EE4F  3               ; @abi none
00EE4F  3               ; @summary Return raw music status bits.
00EE4F  3               ; @out A: Raw MUSIC_STATUS byte
00EE4F  3               audio_status:
00EE4F  3  AD 50 BA           LDA   MUSIC_STATUS
00EE52  3  60                 RTS
00EE53  3               
00EE53  3               ; @label AUDIO.SFX_PLAYING
00EE53  3               ; @kind routine
00EE53  3               ; @symbol audio_sfx_playing
00EE53  3               ; @abi none
00EE53  3               ; @summary Return nonzero if a sound effect is playing.
00EE53  3               ; @out A: 1 if playing, 0 if idle
00EE53  3               audio_sfx_playing:
00EE53  3  AD 50 BA           LDA   MUSIC_STATUS
00EE56  3  29 01              AND   #$01
00EE58  3  60                 RTS
00EE59  3               
00EE59  3               ; @label AUDIO.MUSIC_PLAYING
00EE59  3               ; @kind routine
00EE59  3               ; @symbol audio_music_playing
00EE59  3               ; @abi none
00EE59  3               ; @summary Return nonzero if music is playing.
00EE59  3               ; @out A: 1 if playing, 0 if idle
00EE59  3               audio_music_playing:
00EE59  3  AD 50 BA           LDA   MUSIC_STATUS
00EE5C  3  29 02              AND   #$02
00EE5E  3  F0 02              BEQ   @off
00EE60  3  A9 01              LDA   #$01
00EE62  3               @off:
00EE62  3  60                 RTS
00EE63  3               
00EE63  3               ; @label AUDIO.MUSIC_NOTE
00EE63  3               ; @kind routine
00EE63  3               ; @symbol audio_music_note
00EE63  3               ; @abi register
00EE63  3               ; @summary Return the current MIDI note for a music voice.
00EE63  3               ; @in X: Voice number, 1..14
00EE63  3               ; @out A: Current MIDI note, or 0 if out of range or silent
00EE63  3               audio_music_note:
00EE63  3  CA                 DEX
00EE64  3  E0 0E              CPX   #$0E
00EE66  3  B0 04              BCS   @bad
00EE68  3  BD 51 BA           LDA   MUSIC_NOTE1,X
00EE6B  3  60                 RTS
00EE6C  3               @bad:
00EE6C  3  A9 00              LDA   #$00
00EE6E  3  60                 RTS
00EE6F  3               
00EE6F  3               .endif
