00F031  2                     ; pointer is at the space/digit; LAB_GTBY calls GBYT which skips spaces.
00F031  2                     ; Clear all 6 voice slots
00F031  2  A9 00              LDA   #$00
00F033  2  A0 05              LDY   #$05
00F035  2               @m_pri_clr
