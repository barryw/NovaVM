00E2CC  2               
00E2CC  2  E6 AC              INC   FAC1_e            ; increment FAC1 exponent (*2)
00E2CE  2  F0 F4              BEQ   LAB_MLTO          ; do overflow error if = $00
00E2D0  2               
00E2D0  2  A9 00              LDA   #$00              ; clear sign compare
00E2D2  2               LAB_MLBT
00E2D2  2  85 B8              STA   FAC_sc            ; save sign compare (FAC1 EOR FAC2)
00E2D4  2  8A                 TXA                     ; restore bit
00E2D5  2  20 3E DE           JSR   LAB_2912          ; evaluate new ASCII digit
00E2D8  2               
00E2D8  2               ; gets here if the first character was  "%" for binary
00E2D8  2               ; get binary number
00E2D8  2               
00E2D8  2               LAB_CBIN
00E2D8  2  20 BC 00           JSR   LAB_IGBY          ; increment and scan memory
