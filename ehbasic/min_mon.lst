00EED1  2               
00EED1  2               ; perform GLOAD "filename", space, offset [,length]
00EED1  2               
00EED1  2               LAB_GLOAD
00EED1  2  20 4C F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00EED4  2  20 09 CE           JSR   LAB_1C01          ; comma
00EED7  2  20 45 D8           JSR   LAB_GTBY          ; graphics space id
00EEDA  2  8E AA B9           STX   FIO_GSPACE
00EEDD  2  20 09 CE           JSR   LAB_1C01          ; comma
00EEE0  2  20 33 D8           JSR   LAB_GTWRD         ; graphics offset
00EEE3  2  A5 AF              LDA   FAC1_3
00EEE5  2  8D AB B9           STA   FIO_GADDRL
00EEE8  2  A5 AE              LDA   FAC1_2
00EEEA  2  8D AC B9           STA   FIO_GADDRH
00EEED  2  9C AD B9           STZ   FIO_GLENL         ; default: load full file
00EEF0  2  9C AE B9           STZ   FIO_GLENH
00EEF3  2  20 C2 00           JSR   LAB_GBYT          ; optional comma,length
00EEF6  2  C9 2C              CMP   #','
00EEF8  2  D0 10              BNE   @gl_go
00EEFA  2  20 09 CE           JSR   LAB_1C01
00EEFD  2  20 33 D8           JSR   LAB_GTWRD
00EF00  2  A5 AF              LDA   FAC1_3
00EF02  2  8D AD B9           STA   FIO_GLENL
00EF05  2  A5 AE              LDA   FAC1_2
00EF07  2  8D AE B9           STA   FIO_GLENH
00EF0A  2               @gl_go
00EF0A  2  20 C5 EC           JSR   fio_gload
00EF0D  2  F0 03              BEQ   @gl_ok
00EF0F  2  4C 7A F1           JMP   LAB_FIO_ERRHND
00EF12  2               @gl_ok
00EF12  2  60                 RTS
00EF13  2               
00EF13  2               ; parse 16-bit XRAM offset into FIO flat-address registers
00EF13  2               ; BASIC supplies the high byte through current XBANK.
00EF13  2               
00EF13  2               LAB_XFIO_SETOFF
00EF13  2  20 33 D8           JSR   LAB_GTWRD
00EF16  2  A5 AF              LDA   FAC1_3
00EF18  2  8D AB B9           STA   FIO_GADDRL
00EF1B  2  A5 AE              LDA   FAC1_2
00EF1D  2  8D AC B9           STA   FIO_GADDRH
00EF20  2  AD 0C BA           LDA   XMC_BANK
00EF23  2  8D AA B9           STA   FIO_GSPACE
00EF26  2  60                 RTS
00EF27  2               
00EF27  2               ; perform XLOAD "filename", offset [,length]
00EF27  2               
00EF27  2               LAB_XLOAD
00EF27  2  20 4C F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00EF2A  2  20 09 CE           JSR   LAB_1C01          ; comma
00EF2D  2  20 13 EF           JSR   LAB_XFIO_SETOFF   ; XRAM destination offset + bank
00EF30  2  9C AD B9           STZ   FIO_GLENL         ; default: load full file
00EF33  2  9C AE B9           STZ   FIO_GLENH
00EF36  2  20 C2 00           JSR   LAB_GBYT          ; optional comma,length
00EF39  2  C9 2C              CMP   #','
00EF3B  2  D0 10              BNE   @xl_go
00EF3D  2  20 09 CE           JSR   LAB_1C01
00EF40  2  20 33 D8           JSR   LAB_GTWRD
00EF43  2  A5 AF              LDA   FAC1_3
00EF45  2  8D AD B9           STA   FIO_GLENL
00EF48  2  A5 AE              LDA   FAC1_2
00EF4A  2  8D AE B9           STA   FIO_GLENH
00EF4D  2               @xl_go
00EF4D  2  A9 0D              LDA   #EXT_CMD_XLOAD
00EF4F  2  80 1D              BRA   LAB_XFIO_EXEC     ; issue command through shared XRAM runtime
00EF51  2               
00EF51  2               ; perform XSAVE "filename", offset, length
00EF51  2               
00EF51  2               LAB_XSAVE
00EF51  2  20 4C F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00EF54  2  20 09 CE           JSR   LAB_1C01          ; comma
00EF57  2  20 13 EF           JSR   LAB_XFIO_SETOFF   ; XRAM source offset + bank
00EF5A  2  20 09 CE           JSR   LAB_1C01          ; comma
00EF5D  2  20 33 D8           JSR   LAB_GTWRD
00EF60  2  A5 AF              LDA   FAC1_3
00EF62  2  8D AD B9           STA   FIO_GLENL
00EF65  2  A5 AE              LDA   FAC1_2
00EF67  2  8D AE B9           STA   FIO_GLENH
00EF6A  2  A9 0E              LDA   #EXT_CMD_XSAVE
00EF6C  2  80 00              BRA   LAB_XFIO_EXEC     ; issue command through shared XRAM runtime
00EF6E  2               
00EF6E  2               LAB_XFIO_EXEC
00EF6E  2  20 21 02           JSR   EXT_vec
00EF71  2  D0 01              BNE   @xerr
00EF73  2  60                 RTS
00EF74  2               @xerr
00EF74  2  4C 7A F1           JMP   LAB_FIO_ERRHND
00EF77  2               
