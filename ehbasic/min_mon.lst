00EC47  5               ; @label FIO.ARG_ADDRM
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_ADDRM
00EC47  5               ; @summary Middle byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00EC47  5               FIO_ARG_ADDRM     = NVR0H
00EC47  5               ; @label FIO.ARG_ADDRH
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_ADDRH
00EC47  5               ; @summary High byte of XRAM address argument for FIO.PREPARE_XRAM_TRANSFER.
00EC47  5               FIO_ARG_ADDRH     = NVR1L
00EC47  5               ; @label FIO.ARG_LENL
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_LENL
00EC47  5               ; @summary Low byte of transfer length for FIO.PREPARE_XRAM_TRANSFER.
00EC47  5               FIO_ARG_LENL      = NVR3L
00EC47  5               ; @label FIO.ARG_LENH
00EC47  5               ; @kind zp
00EC47  5               ; @symbol FIO_ARG_LENH
00EC47  5               ; @summary High byte of transfer length for FIO.PREPARE_XRAM_TRANSFER.
00EC47  5               FIO_ARG_LENH      = NVR3H
00EC47  5               ; @label FIO.ARG_NAMELEN
