00ED3F  3               audio_music_loop:
00ED3F  3  A9 11              LDA   #FIO_CMD_MLOOP
00ED41  3  4C 58 EC           JMP   fio_exec
00ED44  3               
00ED44  3               ; @label AUDIO.MUSIC_PRIORITY
00ED44  3               ; @kind routine
00ED44  3               ; @symbol audio_music_priority
00ED44  3               ; @abi pseudo-register
00ED44  3               ; @summary Set voice-stealing priority from AUDIO.NOTE and following pseudo-register bytes.
00ED44  3               ; @requires AUDIO.NOTE
00ED44  3               ; @out A: 0 on success, nonzero on error
00ED44  3               audio_music_priority:
00ED44  3  A9 12              LDA   #FIO_CMD_MPRI
00ED46  3  4C 58 EC           JMP   fio_exec
00ED49  3               
00ED49  3               ; @label AUDIO.STATUS
00ED49  3               ; @kind routine
00ED49  3               ; @symbol audio_status
00ED49  3               ; @abi none
00ED49  3               ; @summary Return raw music status bits.
00ED49  3               ; @out A: Raw MUSIC_STATUS byte
00ED49  3               audio_status:
00ED49  3  AD 50 BA           LDA   MUSIC_STATUS
00ED4C  3  60                 RTS
00ED4D  3               
00ED4D  3               ; @label AUDIO.SFX_PLAYING
00ED4D  3               ; @kind routine
00ED4D  3               ; @symbol audio_sfx_playing
00ED4D  3               ; @abi none
00ED4D  3               ; @summary Return nonzero if a sound effect is playing.
00ED4D  3               ; @out A: 1 if playing, 0 if idle
00ED4D  3               audio_sfx_playing:
00ED4D  3  AD 50 BA           LDA   MUSIC_STATUS
00ED50  3  29 01              AND   #$01
00ED52  3  60                 RTS
00ED53  3               
00ED53  3               ; @label AUDIO.MUSIC_PLAYING
00ED53  3               ; @kind routine
00ED53  3               ; @symbol audio_music_playing
00ED53  3               ; @abi none
00ED53  3               ; @summary Return nonzero if music is playing.
00ED53  3               ; @out A: 1 if playing, 0 if idle
00ED53  3               audio_music_playing:
00ED53  3  AD 50 BA           LDA   MUSIC_STATUS
00ED56  3  29 02              AND   #$02
00ED58  3  F0 02              BEQ   @off
00ED5A  3  A9 01              LDA   #$01
00ED5C  3               @off:
00ED5C  3  60                 RTS
00ED5D  3               
00ED5D  3               ; @label AUDIO.MUSIC_NOTE
00ED5D  3               ; @kind routine
00ED5D  3               ; @symbol audio_music_note
00ED5D  3               ; @abi register
00ED5D  3               ; @summary Return the current MIDI note for a music voice.
00ED5D  3               ; @in X: Voice number, 1..14
00ED5D  3               ; @out A: Current MIDI note, or 0 if out of range or silent
00ED5D  3               audio_music_note:
00ED5D  3  CA                 DEX
00ED5E  3  E0 0E              CPX   #$0E
00ED60  3  B0 04              BCS   @bad
00ED62  3  BD 51 BA           LDA   MUSIC_NOTE1,X
00ED65  3  60                 RTS
00ED66  3               @bad:
00ED66  3  A9 00              LDA   #$00
00ED68  3  60                 RTS
00ED69  3               
00ED69  3               .endif
