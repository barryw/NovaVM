00E2A4  2               LAB_MLTE
00E2A4  2  85 B8              STA   FAC_sc            ; save sign compare (FAC1 EOR FAC2)
00E2A6  2  8A                 TXA                     ; restore character
00E2A7  2  20 3E DE           JSR   LAB_2912          ; evaluate new ASCII digit
00E2AA  2               
00E2AA  2               ; gets here if the first character was "$" for hex
00E2AA  2               ; get hex number
00E2AA  2               
00E2AA  2               LAB_CHEX
00E2AA  2  20 BC 00           JSR   LAB_IGBY          ; increment and scan memory
00E2AD  2  90 0A              BCC   LAB_ISHN          ; branch if numeric character
00E2AF  2               
00E2AF  2  09 20              ORA   #$20              ; case convert, allow "A" to "F" and "a" to "f"
00E2B1  2  E9 61              SBC   #'a'              ; subtract "a" (carry set here)
00E2B3  2  C9 06              CMP   #$06              ; compare normalised with $06 (max+1)
