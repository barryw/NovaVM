00E250  2  85 AE              STA   str_ph            ; save high address
00E252  2               GoPr2
00E252  2  86 AC              STX   str_ln            ; X holds string length
00E254  2  20 BC 00           JSR   LAB_IGBY          ; update BASIC execute pointer (to character past ")")
00E257  2  4C 2A D5           JMP   LAB_RTST          ; check for space on descriptor stack then put address
00E25A  2                                             ; and length on descriptor stack and update stack pointers
00E25A  2               
00E25A  2               BinFErr
00E25A  2  4C CE D2           JMP   LAB_FCER          ; do function call error then warm start
00E25D  2               
00E25D  2               ; perform HEX$()
