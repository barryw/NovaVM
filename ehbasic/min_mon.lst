00EEAB  2  20 9C D8           JSR   LAB_GTWRD         ; source address
00EEAE  2  A5 AF              LDA   FAC1_3
00EEB0  2  8D A4 B9           STA   FIO_SRCL
00EEB3  2  A5 AE              LDA   FAC1_2
00EEB5  2  8D A5 B9           STA   FIO_SRCH
00EEB8  2  20 06 CE           JSR   LAB_1C01          ; comma
00EEBB  2  20 9C D8           JSR   LAB_GTWRD         ; length
00EEBE  2  18                 CLC
00EEBF  2  AD A4 B9           LDA   FIO_SRCL
00EEC2  2  65 AF              ADC   FAC1_3
00EEC4  2  8D A6 B9           STA   FIO_ENDL
00EEC7  2  AD A5 B9           LDA   FIO_SRCH
00EECA  2  65 AE              ADC   FAC1_2
00EECC  2  8D A7 B9           STA   FIO_ENDH
00EECF  2               @sv_go
00EECF  2  20 5B ED           JSR   fio_save
00EED2  2  F0 03              BEQ   @sv_ok
00EED4  2  4C 22 F2           JMP   LAB_FIO_ERRIO
00EED7  2               @sv_ok
00EED7  2  60                 RTS
00EED8  2               
00EED8  2               ; perform LOAD "filename"
00EED8  2               ; File type is auto-detected by extension:
00EED8  2               ;   .bas — loaded into BASIC program space, pointers updated
00EED8  2               ;   .bin — loaded at embedded address (from 2-byte file header)
00EED8  2               
00EED8  2               LAB_FLOAD
00EED8  2  20 ED F1           JSR   LAB_FIO_GETNAME   ; parse filename into FIO_NAME (errors internally)
00EEDB  2                     ; set default load address to BASIC program start
00EEDB  2  A5 79              LDA   Smeml
00EEDD  2  8D A4 B9           STA   FIO_SRCL
00EEE0  2  A5 7A              LDA   Smemh
00EEE2  2  8D A5 B9           STA   FIO_SRCH
00EEE5  2  20 60 ED           JSR   fio_load
00EEE8  2  D0 42              BNE   @ld_chk_err
00EEEA  2                     ; check file type — host sets FIO_DIRTYPE after load
00EEEA  2  AD AF B9           LDA   FIO_DIRTYPE
00EEED  2  C9 02              CMP   #$02              ; .bin file?
00EEEF  2  F0 1E              BEQ   @ld_bin_ok
00EEF1  2                     ; .bas file — update Svarl/Svarh = Smeml + FIO_SIZE
00EEF1  2  18                 CLC
00EEF2  2  A5 79              LDA   Smeml
00EEF4  2  6D A8 B9           ADC   FIO_SIZEL
00EEF7  2  85 7B              STA   Svarl
00EEF9  2  A5 7A              LDA   Smemh
00EEFB  2  6D A9 B9           ADC   FIO_SIZEH
00EEFE  2  85 7C              STA   Svarh
00EF00  2                     ; reset array/var pointers so LIST works correctly
00EF00  2  A5 7B              LDA   Svarl
00EF02  2  85 7D              STA   Sarryl
00EF04  2  85 7F              STA   Earryl
00EF06  2  A5 7C              LDA   Svarh
00EF08  2  85 7E              STA   Sarryh
00EF0A  2  85 80              STA   Earryh
00EF0C  2  4C 7A C1           JMP   LAB_1274          ; print Ready, return to command loop
00EF0F  2               @ld_bin_ok
00EF0F  2                     ; In program mode, silently continue; in immediate mode, print address
00EF0F  2  A5 88              LDA   Clineh
00EF11  2  C9 FF              CMP   #$FF
00EF13  2  D0 16              BNE   @ld_bin_done      ; running from a program — just return
00EF15  2  A9 2F              LDA   #<@s_loaded
00EF17  2  A0 EF              LDY   #>@s_loaded
00EF19  2  20 E9 CA           JSR   LAB_18C3          ; print string
00EF1C  2  AD A5 B9           LDA   FIO_SRCH          ; high byte of load address
00EF1F  2  20 05 F2           JSR   LAB_PRHEX
00EF22  2  AD A4 B9           LDA   FIO_SRCL          ; low byte
00EF25  2  20 05 F2           JSR   LAB_PRHEX
00EF28  2  4C 7A C1           JMP   LAB_1274          ; print Ready, return to command loop
00EF2B  2               @ld_bin_done
00EF2B  2  60                 RTS
00EF2C  2               @ld_chk_err
00EF2C  2  4C 1B F2           JMP   LAB_FIO_ERRHND
