00E8BD  5               NVR1H             = $23
00E8BD  5               .endif
00E8BD  5               .ifndef NVR2L
00E8BD  5               NVR2L             = $24
00E8BD  5               .endif
00E8BD  5               .ifndef NVR2H
00E8BD  5               NVR2H             = $25
00E8BD  5               .endif
00E8BD  5               .ifndef NVR3L
00E8BD  5               NVR3L             = $26
00E8BD  5               .endif
00E8BD  5               .ifndef NVR3H
00E8BD  5               NVR3H             = $27
00E8BD  5               .endif
00E8BD  5               .ifndef NVR4L
00E8BD  5               NVR4L             = $28
00E8BD  5               .endif
00E8BD  5               .ifndef NVR4H
00E8BD  5               NVR4H             = $29
00E8BD  5               .endif
00E8BD  5               .ifndef NVR5L
00E8BD  5               NVR5L             = $2A
00E8BD  5               .endif
00E8BD  5               .ifndef NVR5H
00E8BD  5               NVR5H             = $2B
00E8BD  5               .endif
00E8BD  5               .ifndef NVR6L
00E8BD  5               NVR6L             = $2C
00E8BD  5               .endif
00E8BD  5               .ifndef NVR6H
00E8BD  5               NVR6H             = $2D
00E8BD  5               .endif
00E8BD  5               .ifndef NVR7L
00E8BD  5               NVR7L             = $2E
00E8BD  5               .endif
00E8BD  5               .ifndef NVR7H
