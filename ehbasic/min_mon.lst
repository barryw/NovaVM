00F021  2               LAB_SIDPLAY
00F021  2  20 ED F1           JSR   LAB_FIO_GETNAME   ; parse filename (errors internally)
00F024  2  A9 01              LDA   #$01              ; default song = 1
00F026  2  8D A4 B9           STA   FIO_SRCL
00F029  2  20 C2 00           JSR   LAB_GBYT          ; peek next token
00F02C  2  C9 2C              CMP   #','
00F02E  2  D0 09              BNE   @sp_go
00F030  2  20 06 CE           JSR   LAB_1C01          ; consume comma
00F033  2  20 AE D8           JSR   LAB_GTBY          ; evaluate song number -> X
00F036  2  8E A4 B9           STX   FIO_SRCL
00F039  2               @sp_go
