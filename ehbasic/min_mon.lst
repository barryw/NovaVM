00EE18  4               
00EE18  4               ; @label NIC.ARG_NAMELEN
00EE18  4               ; @kind zp
00EE18  4               ; @symbol NIC_ARG_NAMELEN
00EE18  4               ; @summary Hostname length for NIC.COPY_NAME.
00EE18  4               NIC_ARG_NAMELEN   = NVR0L
00EE18  4               ; @label NIC.ARG_NAMEPTR_L
00EE18  4               ; @kind zp
00EE18  4               ; @symbol NIC_ARG_NAMEPTR_L
00EE18  4               ; @summary Low byte of hostname pointer for NIC.COPY_NAME.
00EE18  4               NIC_ARG_NAMEPTR_L = NVR0H
00EE18  4               ; @label NIC.ARG_NAMEPTR_H
00EE18  4               ; @kind zp
00EE18  4               ; @symbol NIC_ARG_NAMEPTR_H
00EE18  4               ; @summary High byte of hostname pointer for NIC.COPY_NAME.
00EE18  4               NIC_ARG_NAMEPTR_H = NVR1L
