00E21F  2  66 12              ROR   nums_2            ; shift middle byte
00E221  2  66 13              ROR   nums_3            ; shift lowest byte bit 0 to carry
00E223  2  8A                 TXA                     ; load with "0"/2
00E224  2  2A                 ROL                     ; shift in carry
00E225  2  91 AD              STA   (str_pl),Y        ; save to temp string + index
00E227  2  88                 DEY                     ; decrement index
00E228  2  10 F3              BPL   NextB1            ; loop if not done
00E22A  2               
00E22A  2  A5 78              LDA   TempB             ; get # of characters
00E22C  2  F0 0A              BEQ   EndBHS            ; branch if truncate
00E22E  2               
00E22E  2  AA                 TAX                     ; copy length to X
00E22F  2  38                 SEC                     ; set carry for add !
00E230  2  49 FF              EOR   #$FF              ; 1's complement
00E232  2  69 18              ADC   #$18              ; add 24d
00E234  2  F0 1C              BEQ   GoPr2             ; if zero print whole string
00E236  2               
00E236  2  D0 0F              BNE   GoPr1             ; else go make output string
00E238  2               
00E238  2               ; this is the exit code and is also used by HEX$()
00E238  2               ; truncate string to remove leading "0"s
00E238  2               
00E238  2               EndBHS
00E238  2  A8                 TAY                     ; clear index (A=0, X=length here)
00E239  2               NextB2
00E239  2  B1 AD              LDA   (str_pl),Y        ; get character from string
00E23B  2  C9 30              CMP   #'0'              ; compare with "0"
00E23D  2  D0 07              BNE   GoPr              ; if not "0" then go print string from here
00E23F  2               
00E23F  2  CA                 DEX                     ; decrement character count
00E240  2  F0 03              BEQ   GoPr3             ; if zero then end of string so go print it
00E242  2               
00E242  2  C8                 INY                     ; else increment index
00E243  2  10 F4              BPL   NextB2            ; loop always
00E245  2               
00E245  2               ; make fixed length output string - ignore overflows!
00E245  2               
00E245  2               GoPr3
00E245  2  E8                 INX                     ; need at least 1 character
00E246  2               GoPr
00E246  2  98                 TYA                     ; copy result
00E247  2               GoPr1
