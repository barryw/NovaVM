00EE6F  3               
00EE6F  3               .ifndef NIC_IMPLEMENTATION_INCLUDED
00EE6F  3               NIC_IMPLEMENTATION_INCLUDED = 1
00EE6F  3               
00EE6F  3               .ifndef NIC_SERVER_COMMANDS
00EE6F  3               NIC_SERVER_COMMANDS = 1
00EE6F  3               .endif
00EE6F  3               
00EE6F  3                     .segment "CODE"
00EE6F  3               
00EE6F  3                     .export nic_command
00EE6F  3                     .export nic_connect
00EE6F  3                     .export nic_disconnect
00EE6F  3               .if NIC_SERVER_COMMANDS
00EE6F  3                     .export nic_listen
00EE6F  3                     .export nic_accept
00EE6F  3               .endif
00EE6F  3                     .export nic_send
00EE6F  3                     .export nic_recv
00EE6F  3                     .export nic_status
00EE6F  3                     .export nic_ready
00EE6F  3                     .export nic_length
00EE6F  3                     .export nic_copy_name
00EE6F  3               
00EE6F  3               ; Input: A = NIC command.
00EE6F  3               ; @label NIC.COMMAND
00EE6F  3               ; @kind routine
00EE6F  3               ; @symbol nic_command
00EE6F  3               ; @summary Issue a raw NIC command.
00EE6F  3               ; @in A: NIC command byte.
00EE6F  3               nic_command:
00EE6F  3  8D 00 A1           STA   NIC_CMD
00EE72  3  60                 RTS
00EE73  3               
00EE73  3               ; @label NIC.CONNECT
00EE73  3               ; @kind routine
00EE73  3               ; @symbol nic_connect
00EE73  3               ; @summary Connect NIC_SLOT to NIC_NAMEBUF:NIC_RPORTL/H.
00EE73  3               ; @requires NIC_SLOT NIC_NAMEBUF NIC_RPORTL NIC_RPORTH
00EE73  3               nic_connect:
00EE73  3  A9 01              LDA   #NIC_CMD_CONNECT
00EE75  3  80 F8              BRA   nic_command
00EE77  3               
00EE77  3               ; @label NIC.DISCONNECT
00EE77  3               ; @kind routine
00EE77  3               ; @symbol nic_disconnect
00EE77  3               ; @summary Disconnect NIC_SLOT.
00EE77  3               ; @requires NIC_SLOT
00EE77  3               nic_disconnect:
00EE77  3  A9 02              LDA   #NIC_CMD_DISCONNECT
00EE79  3  80 F4              BRA   nic_command
00EE7B  3               
00EE7B  3               .if NIC_SERVER_COMMANDS
00EE7B  3               ; @label NIC.LISTEN
00EE7B  3               ; @kind routine
00EE7B  3               ; @symbol nic_listen
00EE7B  3               ; @summary Listen on NIC_SLOT using NIC_LPORTL/H.
00EE7B  3               nic_listen:
00EE7B  3                     LDA   #NIC_CMD_LISTEN
00EE7B  3                     BRA   nic_command
00EE7B  3               
00EE7B  3               ; @label NIC.ACCEPT
00EE7B  3               ; @kind routine
00EE7B  3               ; @symbol nic_accept
00EE7B  3               ; @summary Accept a pending connection for NIC_SLOT.
00EE7B  3               nic_accept:
00EE7B  3                     LDA   #NIC_CMD_ACCEPT
00EE7B  3                     BRA   nic_command
00EE7B  3               .endif
00EE7B  3               
00EE7B  3               ; @label NIC.SEND
00EE7B  3               ; @kind routine
00EE7B  3               ; @symbol nic_send
00EE7B  3               ; @summary Send NIC_DMALEN bytes from NIC_DMAL/H on NIC_SLOT.
00EE7B  3               ; @requires NIC_SLOT NIC_DMAL NIC_DMAH NIC_DMALEN
00EE7B  3               nic_send:
00EE7B  3  A9 03              LDA   #NIC_CMD_SEND
00EE7D  3  80 F0              BRA   nic_command
00EE7F  3               
00EE7F  3               ; @label NIC.RECV
00EE7F  3               ; @kind routine
00EE7F  3               ; @symbol nic_recv
00EE7F  3               ; @summary Receive data for NIC_SLOT into NIC_DMAL/H.
00EE7F  3               ; @requires NIC_SLOT NIC_DMAL NIC_DMAH
00EE7F  3               nic_recv:
00EE7F  3  A9 04              LDA   #NIC_CMD_RECV
00EE81  3  80 EC              BRA   nic_command
00EE83  3               
00EE83  3               ; Input: X = slot.  Returns A = clamped slot status.
00EE83  3               ; @label NIC.STATUS
00EE83  3               ; @kind routine
00EE83  3               ; @symbol nic_status
00EE83  3               ; @summary Read clamped NIC slot status.
00EE83  3               ; @in X: Slot number.
00EE83  3               ; @out A: Slot status byte.
00EE83  3               nic_status:
00EE83  3  8A                 TXA
00EE84  3  29 03              AND   #$03
00EE86  3  AA                 TAX
00EE87  3  BD 18 A1           LDA   NIC_SLOTST0,X
00EE8A  3  60                 RTS
00EE8B  3               
00EE8B  3               ; Input: X = slot.  Returns A = 1 if data/accept is ready, otherwise 0.
00EE8B  3               ; @label NIC.READY
00EE8B  3               ; @kind routine
00EE8B  3               ; @symbol nic_ready
00EE8B  3               ; @summary Return 1 when NIC_SLOT has data/accept readiness, otherwise 0.
00EE8B  3               ; @in X: Slot number.
00EE8B  3               ; @out A: 1 when ready, 0 otherwise.
00EE8B  3               nic_ready:
00EE8B  3  20 83 EE           JSR   nic_status
00EE8E  3  29 02              AND   #NIC_ST_DATAREADY
00EE90  3  F0 02              BEQ   @not_ready
00EE92  3  A9 01              LDA   #$01
00EE94  3               @not_ready:
00EE94  3  60                 RTS
00EE95  3               
00EE95  3               ; @label NIC.LENGTH
00EE95  3               ; @kind routine
00EE95  3               ; @symbol nic_length
00EE95  3               ; @summary Read the most recent NIC message length.
00EE95  3               ; @out A: Message length byte.
00EE95  3               nic_length:
00EE95  3  AD 13 A1           LDA   NIC_MSGLEN
00EE98  3  60                 RTS
00EE99  3               
00EE99  3               ; Copy a host name from NIC_ARG_NAMEPTR_L/H into NIC_NAMEBUF and append NUL.
00EE99  3               ; Returns A=0 on success, A=1 on invalid length.
00EE99  3               ; @label NIC.COPY_NAME
00EE99  3               ; @kind routine
00EE99  3               ; @symbol nic_copy_name
00EE99  3               ; @summary Copy a pointer-based host name to NIC_NAMEBUF and append NUL.
00EE99  3               ; @requires NIC_ARG_NAMELEN NIC_ARG_NAMEPTR_L NIC_ARG_NAMEPTR_H
00EE99  3               ; @out A: 0 on success, 1 on invalid length.
00EE99  3               nic_copy_name:
00EE99  3  A5 20              LDA   NIC_ARG_NAMELEN
00EE9B  3  F0 18              BEQ   @bad
00EE9D  3  C9 20              CMP   #NIC_NAME_LIMIT + 1
00EE9F  3  B0 14              BCS   @bad
00EEA1  3  AA                 TAX
00EEA2  3  A0 00              LDY   #$00
00EEA4  3               @copy:
00EEA4  3  B1 21              LDA   (NIC_ARG_NAMEPTR_L),Y
00EEA6  3  99 20 A1           STA   NIC_NAMEBUF,Y
00EEA9  3  C8                 INY
00EEAA  3  CA                 DEX
00EEAB  3  D0 F7              BNE   @copy
00EEAD  3  A9 00              LDA   #$00
00EEAF  3  99 20 A1           STA   NIC_NAMEBUF,Y
00EEB2  3  A9 00              LDA   #NIC_RESULT_OK
00EEB4  3  60                 RTS
00EEB5  3               @bad:
00EEB5  3  A9 01              LDA   #NIC_RESULT_ERROR
00EEB7  3  60                 RTS
00EEB8  3               
00EEB8  3               .endif
00EEB8  3               
00EEB8  2               
00EEB8  2               LAB_FIO_CMD_RTS = fio_issue
00EEB8  2               
