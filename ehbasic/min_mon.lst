00ED69  3               
00ED69  3               .ifndef NIC_IMPLEMENTATION_INCLUDED
00ED69  3               NIC_IMPLEMENTATION_INCLUDED = 1
00ED69  3               
00ED69  3               .ifndef NIC_SERVER_COMMANDS
00ED69  3               NIC_SERVER_COMMANDS = 1
00ED69  3               .endif
00ED69  3               
00ED69  3                     .segment "CODE"
00ED69  3               
00ED69  3                     .export nic_command
00ED69  3                     .export nic_connect
00ED69  3                     .export nic_disconnect
00ED69  3               .if NIC_SERVER_COMMANDS
00ED69  3                     .export nic_listen
00ED69  3                     .export nic_accept
00ED69  3               .endif
00ED69  3                     .export nic_send
00ED69  3                     .export nic_recv
00ED69  3                     .export nic_status
00ED69  3                     .export nic_ready
00ED69  3                     .export nic_length
00ED69  3                     .export nic_copy_name
00ED69  3               
00ED69  3               ; Input: A = NIC command.
00ED69  3               ; @label NIC.COMMAND
00ED69  3               ; @kind routine
00ED69  3               ; @symbol nic_command
00ED69  3               ; @summary Issue a raw NIC command.
00ED69  3               ; @in A: NIC command byte.
00ED69  3               nic_command:
00ED69  3  8D 06 A1           STA   NIC_CMDSHADOW
00ED6C  3  9C 00 A1           STZ   NIC_CMD
00ED6F  3  EE 05 A1           INC   NIC_CMDSEQ
00ED72  3  D0 03              BNE   @seq_ok
00ED74  3  EE 05 A1           INC   NIC_CMDSEQ
00ED77  3               @seq_ok:
00ED77  3  8D 00 A1           STA   NIC_CMD
00ED7A  3  60                 RTS
00ED7B  3               
00ED7B  3               ; @label NIC.CONNECT
00ED7B  3               ; @kind routine
00ED7B  3               ; @symbol nic_connect
00ED7B  3               ; @summary Connect NIC_SLOT to NIC_NAMEBUF:NIC_RPORTL/H.
00ED7B  3               ; @requires NIC_SLOT NIC_NAMEBUF NIC_RPORTL NIC_RPORTH
00ED7B  3               nic_connect:
00ED7B  3  A9 01              LDA   #NIC_CMD_CONNECT
00ED7D  3  80 EA              BRA   nic_command
00ED7F  3               
00ED7F  3               ; @label NIC.DISCONNECT
00ED7F  3               ; @kind routine
00ED7F  3               ; @symbol nic_disconnect
00ED7F  3               ; @summary Disconnect NIC_SLOT.
00ED7F  3               ; @requires NIC_SLOT
00ED7F  3               nic_disconnect:
00ED7F  3  A9 02              LDA   #NIC_CMD_DISCONNECT
00ED81  3  80 E6              BRA   nic_command
00ED83  3               
00ED83  3               .if NIC_SERVER_COMMANDS
00ED83  3               ; @label NIC.LISTEN
00ED83  3               ; @kind routine
00ED83  3               ; @symbol nic_listen
00ED83  3               ; @summary Listen on NIC_SLOT using NIC_LPORTL/H.
00ED83  3               nic_listen:
00ED83  3                     LDA   #NIC_CMD_LISTEN
00ED83  3                     BRA   nic_command
00ED83  3               
00ED83  3               ; @label NIC.ACCEPT
00ED83  3               ; @kind routine
00ED83  3               ; @symbol nic_accept
00ED83  3               ; @summary Accept a pending connection for NIC_SLOT.
00ED83  3               nic_accept:
00ED83  3                     LDA   #NIC_CMD_ACCEPT
00ED83  3                     BRA   nic_command
00ED83  3               .endif
00ED83  3               
00ED83  3               ; @label NIC.SEND
00ED83  3               ; @kind routine
00ED83  3               ; @symbol nic_send
00ED83  3               ; @summary Send NIC_DMALEN bytes from NIC_DMAL/H on NIC_SLOT.
00ED83  3               ; @requires NIC_SLOT NIC_DMAL NIC_DMAH NIC_DMALEN
00ED83  3               nic_send:
00ED83  3  A9 03              LDA   #NIC_CMD_SEND
00ED85  3  80 E2              BRA   nic_command
00ED87  3               
00ED87  3               ; @label NIC.RECV
00ED87  3               ; @kind routine
00ED87  3               ; @symbol nic_recv
00ED87  3               ; @summary Receive data for NIC_SLOT into NIC_DMAL/H.
00ED87  3               ; @requires NIC_SLOT NIC_DMAL NIC_DMAH
00ED87  3               nic_recv:
00ED87  3  A9 04              LDA   #NIC_CMD_RECV
00ED89  3  80 DE              BRA   nic_command
00ED8B  3               
00ED8B  3               ; Input: X = slot.  Returns A = clamped slot status.
00ED8B  3               ; @label NIC.STATUS
00ED8B  3               ; @kind routine
00ED8B  3               ; @symbol nic_status
00ED8B  3               ; @summary Read clamped NIC slot status.
00ED8B  3               ; @in X: Slot number.
00ED8B  3               ; @out A: Slot status byte.
00ED8B  3               nic_status:
00ED8B  3  8A                 TXA
00ED8C  3  29 03              AND   #$03
00ED8E  3  AA                 TAX
00ED8F  3  BD 18 A1           LDA   NIC_SLOTST0,X
00ED92  3  60                 RTS
00ED93  3               
00ED93  3               ; Input: X = slot.  Returns A = 1 if data/accept is ready, otherwise 0.
00ED93  3               ; @label NIC.READY
00ED93  3               ; @kind routine
00ED93  3               ; @symbol nic_ready
00ED93  3               ; @summary Return 1 when NIC_SLOT has data/accept readiness, otherwise 0.
00ED93  3               ; @in X: Slot number.
00ED93  3               ; @out A: 1 when ready, 0 otherwise.
00ED93  3               nic_ready:
00ED93  3  20 8B ED           JSR   nic_status
00ED96  3  29 02              AND   #NIC_ST_DATAREADY
00ED98  3  F0 02              BEQ   @not_ready
00ED9A  3  A9 01              LDA   #$01
00ED9C  3               @not_ready:
00ED9C  3  60                 RTS
00ED9D  3               
00ED9D  3               ; @label NIC.LENGTH
00ED9D  3               ; @kind routine
00ED9D  3               ; @symbol nic_length
00ED9D  3               ; @summary Read the most recent NIC message length.
00ED9D  3               ; @out A: Message length byte.
00ED9D  3               nic_length:
00ED9D  3  AD 13 A1           LDA   NIC_MSGLEN
00EDA0  3  60                 RTS
00EDA1  3               
00EDA1  3               ; Copy a host name from NIC_ARG_NAMEPTR_L/H into NIC_NAMEBUF and append NUL.
00EDA1  3               ; Returns A=0 on success, A=1 on invalid length.
00EDA1  3               ; @label NIC.COPY_NAME
00EDA1  3               ; @kind routine
00EDA1  3               ; @symbol nic_copy_name
00EDA1  3               ; @summary Copy a pointer-based host name to NIC_NAMEBUF and append NUL.
00EDA1  3               ; @requires NIC_ARG_NAMELEN NIC_ARG_NAMEPTR_L NIC_ARG_NAMEPTR_H
00EDA1  3               ; @out A: 0 on success, 1 on invalid length.
00EDA1  3               nic_copy_name:
00EDA1  3  A5 20              LDA   NIC_ARG_NAMELEN
00EDA3  3  F0 18              BEQ   @bad
00EDA5  3  C9 20              CMP   #NIC_NAME_LIMIT + 1
00EDA7  3  B0 14              BCS   @bad
00EDA9  3  AA                 TAX
00EDAA  3  A0 00              LDY   #$00
00EDAC  3               @copy:
00EDAC  3  B1 21              LDA   (NIC_ARG_NAMEPTR_L),Y
00EDAE  3  99 20 A1           STA   NIC_NAMEBUF,Y
00EDB1  3  C8                 INY
00EDB2  3  CA                 DEX
00EDB3  3  D0 F7              BNE   @copy
00EDB5  3  A9 00              LDA   #$00
00EDB7  3  99 20 A1           STA   NIC_NAMEBUF,Y
00EDBA  3  A9 00              LDA   #NIC_RESULT_OK
00EDBC  3  60                 RTS
00EDBD  3               @bad:
00EDBD  3  A9 01              LDA   #NIC_RESULT_ERROR
00EDBF  3  60                 RTS
00EDC0  3               
00EDC0  3               .endif
00EDC0  3               
00EDC0  2               
00EDC0  2               LAB_FIO_CMD_RTS = fio_issue
00EDC0  2               
