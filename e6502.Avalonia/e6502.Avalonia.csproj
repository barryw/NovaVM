<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="e6502UnitTests" />
    </ItemGroup>

    <!-- Preserve Dock types from trimming (no official AOT annotations yet) -->
    <ItemGroup>
        <TrimmerRootAssembly Include="Dock.Avalonia" />
        <TrimmerRootAssembly Include="Dock.Model" />
        <TrimmerRootAssembly Include="Dock.Model.Mvvm" />
        <TrimmerRootAssembly Include="Dock.Avalonia.Themes.Fluent" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
        <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
        <PackageReference Include="Dock.Model.Mvvm" Version="11.3.11.22" />
        <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.1" />
        <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\e6502\e6502.csproj" />
        <ProjectReference Include="..\e6502.Storage\e6502.Storage.csproj" />
        <ProjectReference Include="..\e6502.Nova\e6502.Nova.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- POSIX tool validation (macOS / Linux) -->
    <Target Name="ValidateTools" BeforeTargets="AssembleRom" Condition="!$([MSBuild]::IsOSPlatform('Windows')) AND '$(SkipRomBuild)' != 'true'">
        <Exec Command="command -v ca65 &gt; /dev/null 2&gt;&amp;1 || (echo 'ERROR: ca65 not found. Install cc65: brew install cc65' &amp;&amp; exit 1)" StandardOutputImportance="low" IgnoreStandardErrorWarningFormat="true" />
        <Exec Command="command -v ld65 &gt; /dev/null 2&gt;&amp;1 || (echo 'ERROR: ld65 not found. Install cc65: brew install cc65' &amp;&amp; exit 1)" StandardOutputImportance="low" IgnoreStandardErrorWarningFormat="true" />
        <Exec Command="command -v pandoc &gt; /dev/null 2&gt;&amp;1 || echo 'WARN: pandoc not found; PDF user-guide generation will be skipped (ROM build does not need it)'" StandardOutputImportance="low" IgnoreStandardErrorWarningFormat="true" />
        <Exec Command="command -v latexmk &gt; /dev/null 2&gt;&amp;1 || echo 'WARN: latexmk not found; PDF user-guide generation will be skipped (ROM build does not need it)'" StandardOutputImportance="low" IgnoreStandardErrorWarningFormat="true" />
    </Target>

    <!-- Windows tool validation -->
    <Target Name="ValidateToolsWindows" BeforeTargets="AssembleRomWindows" Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(SkipRomBuild)' != 'true'">
        <Exec Command="where.exe ca65 &gt;nul 2&gt;&amp;1 || (echo ERROR: ca65 not found. Install cc65: choco install cc65 &amp;&amp; exit 1)" StandardOutputImportance="low" IgnoreStandardErrorWarningFormat="true" />
        <Exec Command="where.exe ld65 &gt;nul 2&gt;&amp;1 || (echo ERROR: ld65 not found. Install cc65: choco install cc65 &amp;&amp; exit 1)" StandardOutputImportance="low" IgnoreStandardErrorWarningFormat="true" />
        <Exec Command="where.exe pandoc &gt;nul 2&gt;&amp;1 || (echo ERROR: pandoc not found. Install: choco install pandoc &amp;&amp; exit 1)" StandardOutputImportance="low" IgnoreStandardErrorWarningFormat="true" />
        <Exec Command="where.exe pdflatex &gt;nul 2&gt;&amp;1 || (echo ERROR: pdflatex not found. Install MiKTeX: choco install miktex &amp;&amp; exit 1)" StandardOutputImportance="low" IgnoreStandardErrorWarningFormat="true" />
    </Target>

    <!-- Assemble the EhBASIC ROM + keyboard viewer from source (POSIX) -->
    <Target Name="AssembleRom" BeforeTargets="PreBuildEvent" DependsOnTargets="ValidateTools" Condition="!$([MSBuild]::IsOSPlatform('Windows')) AND '$(SkipRomBuild)' != 'true'">
        <Exec Command="make -C $(ProjectDir)../software/languages/ehbasic basic.bin extension.bin" />
        <Exec Command="make -C $(ProjectDir)../software/runtime/asm install" />
        <Copy SourceFiles="$(ProjectDir)../software/languages/ehbasic/basic.bin" DestinationFiles="$(ProjectDir)Resources/ehbasic.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/languages/ehbasic/extension.bin" DestinationFiles="$(ProjectDir)Resources/extension.bin" />
        <!-- Shared-library modules: rebuild + stage their 16K images into Resources so
             CompositeBusDevice pre-stages them into the XRAM shelf at boot. -->
        <Exec Command="make -C $(ProjectDir)../software/modules/graphics graphics.bin" />
        <Exec Command="make -C $(ProjectDir)../software/modules/system system.bin" />
        <Exec Command="make -C $(ProjectDir)../software/modules/editor editor.bin" />
        <Exec Command="make -C $(ProjectDir)../software/modules/sound sound.bin" />
        <Exec Command="make -C $(ProjectDir)../software/modules/files files.bin" />
        <Exec Command="make -C $(ProjectDir)../software/modules/memory memory.bin" />
        <Exec Command="make -C $(ProjectDir)../software/modules/net net.bin" />
        <Exec Command="make -C $(ProjectDir)../software/modules/turtle turtle.bin" />
        <Exec Command="make -C $(ProjectDir)../software/modules/langrt langrt.bin" />
        <Exec Command="make -C $(ProjectDir)../software/assembly editbuf-demo" />
        <Exec Command="make -C $(ProjectDir)../software/languages/novaforth" />
        <Exec Command="make -C $(ProjectDir)../software/languages/novalogo" />
        <Copy SourceFiles="$(ProjectDir)../software/modules/graphics/graphics.bin" DestinationFiles="$(ProjectDir)Resources/graphics.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/modules/system/system.bin" DestinationFiles="$(ProjectDir)Resources/system.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/modules/editor/editor.bin" DestinationFiles="$(ProjectDir)Resources/editor.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/modules/sound/sound.bin" DestinationFiles="$(ProjectDir)Resources/sound.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/modules/files/files.bin" DestinationFiles="$(ProjectDir)Resources/files.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/modules/memory/memory.bin" DestinationFiles="$(ProjectDir)Resources/memory.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/modules/net/net.bin" DestinationFiles="$(ProjectDir)Resources/net.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/modules/turtle/turtle.bin" DestinationFiles="$(ProjectDir)Resources/turtle.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/modules/langrt/langrt.bin" DestinationFiles="$(ProjectDir)Resources/langrt.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/assembly/apps/editbuf_demo/editbuf_demo.bin" DestinationFiles="$(ProjectDir)Resources/editbuf_demo.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/languages/novaforth/novaforth.bin" DestinationFiles="$(ProjectDir)Resources/novaforth.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/languages/novalogo/novalogo.bin" DestinationFiles="$(ProjectDir)Resources/novalogo.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/languages/novalogo/LOGOHK.BIN" DestinationFiles="$(ProjectDir)Resources/LOGOHK.BIN" />
    </Target>

    <!-- Assemble the EhBASIC ROM + keyboard viewer from source (Windows) -->
    <Target Name="AssembleRomWindows" BeforeTargets="PreBuildEvent" DependsOnTargets="ValidateToolsWindows" Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(SkipRomBuild)' != 'true'">
        <Exec Command="cd $(ProjectDir)..\software\languages\ehbasic &amp;&amp; ca65 --cpu 65c02 -I ..\..\runtime\asm -g -l min_mon.lst --feature labels_without_colons -o basic.o min_mon.asm &amp;&amp; ld65 -C ehbasic.cfg -vm -m basic.map -Ln basic.sym -o basic.bin basic.o" />
        <Exec Command="cd $(ProjectDir)..\software\runtime\asm &amp;&amp; ca65 libcall.s -o libcall.o &amp;&amp; ld65 -C libcall_resident.cfg -m libcall.map -o libcall.bin libcall.o" />
        <Exec Command="cd $(ProjectDir)..\software\languages\ehbasic &amp;&amp; dotnet run --project ..\..\..\e6502.Nova -c Release -- codegen novavm-inc ..\..\..\e6502.Avalonia\Hardware\VgcConstants.cs basic.sym -o ..\..\runtime\asm\novavm.inc" />
        <Exec Command="cd $(ProjectDir)..\software\languages\ehbasic &amp;&amp; dotnet run --project ..\..\..\e6502.Nova -c Release -- codegen runtime-abi ..\..\runtime\asm\nova.inc ..\..\runtime\asm\fio.inc ..\..\runtime\asm\fio.s ..\..\runtime\asm\audio.inc ..\..\runtime\asm\audio.s ..\..\runtime\asm\nic.inc ..\..\runtime\asm\nic.s ..\..\runtime\asm\vgc.inc ..\..\runtime\asm\vgc.s ..\..\runtime\asm\sprite.inc ..\..\runtime\asm\sprite.s ..\..\runtime\asm\dma.inc ..\..\runtime\asm\dma.s ..\..\runtime\asm\blitter.inc ..\..\runtime\asm\blitter.s ..\..\runtime\asm\copper.inc ..\..\runtime\asm\copper.s ..\..\runtime\asm\xram.inc ..\..\runtime\asm\xram.s ..\..\runtime\asm\pager.inc ..\..\runtime\asm\pager.s ..\..\runtime\asm\rng.inc ..\..\runtime\asm\rng.s ..\..\runtime\asm\xmc.s --sym basic.sym --json runtime_labels.json --md ..\..\..\docs\assembly\runtime-labels.md --asm ..\..\runtime\asm\runtime_labels.inc" />
        <Exec Command="cd $(ProjectDir)..\software\assembly &amp;&amp; ca65 --cpu 65c02 -I ..\runtime\asm apps\keyboard\keyboard.s -o apps\keyboard\keyboard.o &amp;&amp; ld65 -C apps\keyboard\keyboard.cfg -o apps\keyboard\keyboard.bin apps\keyboard\keyboard.o" />
        <Exec Command="cd $(ProjectDir)..\software\languages\ehbasic &amp;&amp; ca65 --cpu 65c02 -I ..\..\runtime\asm extension.s -o extension.o &amp;&amp; ld65 -C extension.cfg -o extension.bin extension.o" />
        <Exec Command="cd $(ProjectDir)..\software\languages\novaforth &amp;&amp; ca65 --cpu 65c02 -I ..\..\runtime\asm -l novaforth.lst -o novaforth.o novaforth.s &amp;&amp; ld65 -C novaforth.cfg -m novaforth.map -o novaforth.bin novaforth.o" />
        <Copy SourceFiles="$(ProjectDir)../software/languages/ehbasic/basic.bin" DestinationFiles="$(ProjectDir)Resources/ehbasic.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/languages/ehbasic/extension.bin" DestinationFiles="$(ProjectDir)Resources/extension.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/languages/novaforth/novaforth.bin" DestinationFiles="$(ProjectDir)Resources/novaforth.bin" />
        <Copy SourceFiles="$(ProjectDir)../software/runtime/asm/libcall.bin" DestinationFiles="$(ProjectDir)Resources/libcall.bin" />
    </Target>

    <!-- Generate the PDF user guide (POSIX) -->
    <Target Name="GeneratePdf" AfterTargets="Build" Condition="!$([MSBuild]::IsOSPlatform('Windows')) AND '$(SkipRomBuild)' != 'true'">
        <Exec Command="dotnet run --no-build --project ../e6502.Nova -c $(Configuration) -- docs basic-user-guide --repo .." />
    </Target>

    <!-- Generate the PDF user guide (Windows) -->
    <Target Name="GeneratePdfWindows" BeforeTargets="PreBuildEvent" DependsOnTargets="AssembleRomWindows" Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(SkipRomBuild)' != 'true'">
        <Exec Command="dotnet run --project ../e6502.Nova -c Release -- docs basic-user-guide --repo .." />
    </Target>

    <Target Name="CopyEhBasicToOutput" AfterTargets="Build">
        <MakeDir Directories="$(OutputPath)Resources" />
        <Copy SourceFiles="Resources/ehbasic.bin" DestinationFolder="$(OutputPath)Resources" />
        <Copy SourceFiles="Resources/extension.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/extension.bin')" />
        <Copy SourceFiles="Resources/novalogo.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/novalogo.bin')" />
        <Copy SourceFiles="Resources/LOGOHK.BIN" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/LOGOHK.BIN')" />
        <Copy SourceFiles="Resources/novaforth.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/novaforth.bin')" />
        <Copy SourceFiles="Resources/libcall.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/libcall.bin')" />
        <Copy SourceFiles="Resources/graphics.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/graphics.bin')" />
        <Copy SourceFiles="Resources/system.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/system.bin')" />
        <Copy SourceFiles="Resources/editor.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/editor.bin')" />
        <Copy SourceFiles="Resources/sound.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/sound.bin')" />
        <Copy SourceFiles="Resources/files.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/files.bin')" />
        <Copy SourceFiles="Resources/memory.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/memory.bin')" />
        <Copy SourceFiles="Resources/net.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/net.bin')" />
        <Copy SourceFiles="Resources/turtle.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/turtle.bin')" />
        <Copy SourceFiles="Resources/langrt.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/langrt.bin')" />
        <Copy SourceFiles="Resources/editbuf_demo.bin" DestinationFolder="$(OutputPath)Resources" Condition="Exists('Resources/editbuf_demo.bin')" />
    </Target>

    <ItemGroup>
        <Folder Include="Resources\" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Resources\ehbasic.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\cp437.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\petscii_upper.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\petscii_lower.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\extension.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\novalogo.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\novaforth.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\libcall.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\graphics.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\system.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\editor.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\sound.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\files.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\memory.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\net.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\turtle.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\langrt.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\editbuf_demo.bin">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Copy help content Markdown files to output for HelpContentLoader -->
    <ItemGroup>
        <Content Include="../docs/help/guides/*.md" Link="help/guides/%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="../docs/help/reference/commands/*.md" Link="help/reference/commands/%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="../docs/help/reference/functions/*.md" Link="help/reference/functions/%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
