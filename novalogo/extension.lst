0016DDr 3  20 rr rr           JSR   vtext_blt_copy_up_plane
0016E0r 3  D0 4D              BNE   @done
0016E2r 3  A9 07              LDA   #VTEXT_PLANE_TEXTATTR
0016E4r 3  20 rr rr           JSR   vtext_blt_copy_up_plane
0016E7r 3  D0 46              BNE   @done
0016E9r 3               
0016E9r 3  AD rr rr           LDA   VTEXT_CURX
0016ECr 3  48                 PHA
0016EDr 3  AD rr rr           LDA   VTEXT_CURY
0016F0r 3  48                 PHA
0016F1r 3  9C rr rr           STZ   VTEXT_CURX
0016F4r 3  AD rr rr           LDA   VTEXT_HEIGHT
0016F7r 3  38                 SEC
0016F8r 3  E9 01              SBC   #$01
0016FAr 3  8D rr rr           STA   VTEXT_CURY
0016FDr 3  20 rr rr           JSR   vtext_calc_addr
001700r 3  68                 PLA
001701r 3  8D rr rr           STA   VTEXT_CURY
001704r 3  68                 PLA
001705r 3  8D rr rr           STA   VTEXT_CURX
001708r 3               
001708r 3  A9 20              LDA   #$20
00170Ar 3  85 rr              STA   VTEXT_TMP
00170Cr 3  A2 01              LDX   #$01
00170Er 3  A9 01              LDA   #VTEXT_PLANE_CHAR
001710r 3  20 rr rr           JSR   vtext_blt_fill_plane
001713r 3  D0 1A              BNE   @done
001715r 3               
001715r 3  AD rr rr           LDA   VTEXT_COLOR
001718r 3  85 rr              STA   VTEXT_TMP
00171Ar 3  A2 01              LDX   #$01
00171Cr 3  A9 02              LDA   #VTEXT_PLANE_COLOR
00171Er 3  20 rr rr           JSR   vtext_blt_fill_plane
001721r 3  D0 0C              BNE   @done
001723r 3               
