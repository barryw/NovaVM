001865r 2  AD rr rr           LDA   EDITUI_FILLROW
001868r 2  8D rr rr           STA   VTEXT_TOP
00186Br 2  A9 01              LDA   #1
00186Dr 2  8D rr rr           STA   VTEXT_HEIGHT
001870r 2  9C rr rr           STZ   VTEXT_CURX
001873r 2  9C rr rr           STZ   VTEXT_CURY
001876r 2  A9 20              LDA   #' '
001878r 2  8D rr rr           STA   VTEXT_CHAR
00187Br 2  4C rr rr           JMP   vtext_clear_region
00187Er 2               
