00150Er 3  64 rr              STZ   VTEXT_ADDRH
001510r 3               
001510r 3  06 rr              ASL   VTEXT_ADDRL
001512r 3  26 rr              ROL   VTEXT_ADDRH
001514r 3  06 rr              ASL   VTEXT_ADDRL
001516r 3  26 rr              ROL   VTEXT_ADDRH
