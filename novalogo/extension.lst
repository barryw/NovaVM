0019E8r 2  8D rr rr           STA   EDITUI_MENU_COUNT
0019EBr 2  9C rr rr           STZ   EDITUI_MENU_INDEX
0019EEr 2  A9 02              LDA   #2
0019F0r 2  8D rr rr           STA   EDITUI_MENU_X
