001842r 2               
001842r 2               editui_shutdown:
001842r 2  A9 0C              LDA   #$0C
001844r 2  8D 0E A0           STA   VGC_CHAROUT
001847r 2               @wait:
001847r 2  AD 10 A0           LDA   VGC_CMD
00184Ar 2  29 01              AND   #$01
00184Cr 2  D0 F9              BNE   @wait
00184Er 2  9C 03 A0           STZ   VGC_CURSX
001851r 2  9C 04 A0           STZ   VGC_CURSY
001854r 2  A9 01              LDA   #$01
