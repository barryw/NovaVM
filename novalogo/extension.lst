001730r 3  8D 87 BA           STA   BLT_DSTSPACE
001733r 3  9C 86 BA           STZ   BLT_SRCSPACE
001736r 3  9C 88 BA           STZ   BLT_SRCL
001739r 3  9C 89 BA           STZ   BLT_SRCM
00173Cr 3  9C 8A BA           STZ   BLT_SRCH
00173Fr 3  9C 92 BA           STZ   BLT_SRCSTRL
