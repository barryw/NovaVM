000000r 1                     .include "vgc.inc"
000000r 2               ; Shared Nova VGC helper declarations.
000000r 2               ;
000000r 2               ; The command helpers use the VGC hardware parameter registers directly:
000000r 2               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
000000r 2               ; Routines return through the hardware status model; command completion can be
000000r 2               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
000000r 2               
000000r 2               .ifndef VGC_INC_INCLUDED
000000r 2               VGC_INC_INCLUDED = 1
000000r 2               
000000r 2               .include "nova.inc"
000000r 3               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
000000r 3               ;
000000r 3               ; This include is deliberately guarded per symbol so it can coexist with older
000000r 3               ; source files that still define a subset of these names locally.
000000r 3               
000000r 3               .ifndef NOVA_INC_INCLUDED
000000r 3               NOVA_INC_INCLUDED = 1
