00249Er 2  A0 00              LDY   #0
0024A0r 2  B1 rr              LDA   (EB_PL),Y
0024A2r 2  85 rr              STA   EB_T1                 ; removed char
0024A4r 2                     ; close gap of 1 at cursor
0024A4r 2  AD rr rr           LDA   EDITBUF_CURL
0024A7r 2  8D rr rr           STA   EB_SCRATCHL
0024AAr 2  AD rr rr           LDA   EDITBUF_CURH
0024ADr 2  8D rr rr           STA   EB_SCRATCHH
0024B0r 2  A9 01              LDA   #1
0024B2r 2  85 rr              STA   EDITBUF_CNTL
0024B4r 2  64 rr              STZ   EDITBUF_CNTH
