000C6Ar 3               .global VSPRITE_SRCADDRM
000C6Ar 3               ; @label VSPRITE.SRCADDRH
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SRCADDRH
000C6Ar 3               ; @summary High byte of the virtual-sprite source address.
000C6Ar 3               .global VSPRITE_SRCADDRH
000C6Ar 3               ; @label VSPRITE.DSTADDRL
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_DSTADDRL
000C6Ar 3               ; @summary Low byte of the virtual-sprite destination address. VSPRITE.GFX_* routines compute this from VSPRITE.X/Y.
000C6Ar 3               .global VSPRITE_DSTADDRL
000C6Ar 3               ; @label VSPRITE.DSTADDRM
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_DSTADDRM
000C6Ar 3               ; @summary Middle byte of the virtual-sprite destination address. VSPRITE.GFX_* routines compute this from VSPRITE.X/Y.
000C6Ar 3               .global VSPRITE_DSTADDRM
000C6Ar 3               ; @label VSPRITE.DSTADDRH
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_DSTADDRH
000C6Ar 3               ; @summary High byte of the virtual-sprite destination address. VSPRITE.GFX_* routines compute this from VSPRITE.X/Y.
000C6Ar 3               .global VSPRITE_DSTADDRH
000C6Ar 3               ; @label VSPRITE.WIDTHL
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_WIDTHL
000C6Ar 3               ; @summary Low byte of the rectangle width in pixels/bytes.
000C6Ar 3               .global VSPRITE_WIDTHL
000C6Ar 3               ; @label VSPRITE.WIDTHH
000C6Ar 3               ; @kind u8
