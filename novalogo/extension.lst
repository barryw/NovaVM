000092r 3               
000092r 2               
000092r 2               .ifndef EDITBUF_IMPLEMENTATION_INCLUDED
000092r 2               EDITBUF_IMPLEMENTATION_INCLUDED = 1
000092r 2               
000092r 2               ; =====================================================================
000092r 2               ; ZEROPAGE — editor working pointers
000092r 2               ; =====================================================================
000092r 2                     .segment "ZEROPAGE"
00000Br 2               
00000Br 2  xx           EB_SRCL:        .res 1
00000Cr 2  xx           EB_SRCH:        .res 1
00000Dr 2  xx           EB_DSTL:        .res 1
00000Er 2  xx           EB_DSTH:        .res 1
00000Fr 2  xx           EDITBUF_CNTL:   .res 1
000010r 2  xx           EDITBUF_CNTH:   .res 1
000011r 2  xx           EB_PL:          .res 1
000012r 2  xx           EB_PH:          .res 1
000013r 2  xx xx        EDITBUF_HL_PTR: .res 2
000015r 2  xx           EB_T0:          .res 1
000016r 2  xx           EB_T1:          .res 1
000017r 2  xx           EB_RUNL:        .res 1       ; VRAM-port run pointer (render_row)
000018r 2  xx           EB_RUNH:        .res 1
000019r 2               
000019r 2               ; =====================================================================
000019r 2               ; BSS — config, state, buffers
000019r 2               ; =====================================================================
000019r 2                     .segment "BSS"
000053r 2               
000053r 2               ; --- config (host-set) ---
000053r 2  xx           EDITBUF_BUFL:       .res 1
000054r 2  xx           EDITBUF_BUFH:       .res 1
000055r 2  xx           EDITBUF_CAPL:       .res 1
000056r 2  xx           EDITBUF_CAPH:       .res 1
000057r 2  xx           EDITBUF_LENL:       .res 1
000058r 2  xx           EDITBUF_LENH:       .res 1
000059r 2  xx           EDITBUF_TITLEL:     .res 1
00005Ar 2  xx           EDITBUF_TITLEH:     .res 1
00005Br 2  xx           EDITBUF_STATUSL:    .res 1
00005Cr 2  xx           EDITBUF_STATUSH:    .res 1
00005Dr 2  xx           EDITBUF_SAVE_VECL:  .res 1
00005Er 2  xx           EDITBUF_SAVE_VECH:  .res 1
00005Fr 2  xx           EDITBUF_INDENT_VECL:.res 1
000060r 2  xx           EDITBUF_INDENT_VECH:.res 1
000061r 2  xx           EDITBUF_HILITE_VECL:.res 1
000062r 2  xx           EDITBUF_HILITE_VECH:.res 1
000063r 2  xx           EDITBUF_MENU_VECL:  .res 1
000064r 2  xx           EDITBUF_MENU_VECH:  .res 1
000065r 2               
000065r 2               ; --- state ---
000065r 2  xx           EDITBUF_RESULT:     .res 1
000066r 2  xx           EDITBUF_CURL:       .res 1       ; cursor byte offset (16-bit)
000067r 2  xx           EDITBUF_CURH:       .res 1
000068r 2  xx           EB_TOPLINEL:        .res 1       ; first visible line (16-bit)
000069r 2  xx           EB_TOPLINEH:        .res 1
00006Ar 2  xx           EB_LEFTCOL:         .res 1       ; first visible column (h-scroll)
00006Br 2  xx           EB_SELL:            .res 1       ; selection anchor offset (16-bit)
00006Cr 2  xx           EB_SELH:            .res 1
00006Dr 2  xx           EDITBUF_SELACT:     .res 1       ; selection active flag
00006Er 2  xx           EB_GOALCOL:         .res 1       ; sticky column for up/down
00006Fr 2  xx           EB_CURLINEL:        .res 1       ; computed cursor line (16-bit)
000070r 2  xx           EB_CURLINEH:        .res 1
000071r 2  xx           EB_CURCOL:          .res 1       ; computed cursor column
000072r 2               
000072r 2               ; --- render / nav scratch ---
000072r 2  xx           EB_ROW:             .res 1
000073r 2  xx           EB_COL:             .res 1
000074r 2  xx           EB_PAINTSTART:      .res 1       ; first column painted by editbuf_render_row (0 = full)
000075r 2  xx           EB_EDITDELTA:       .res 1       ; cols left of cursor where an inline edit's changed run begins
000076r 2  xx           EB_LINEOFFL:        .res 1       ; offset of current line start (16-bit)
000077r 2  xx           EB_LINEOFFH:        .res 1
000078r 2  xx           EB_LINELEN:         .res 1       ; current line length (chars before \n)
000079r 2  xx           EB_VISLINEL:        .res 1       ; line number being rendered (16-bit)
00007Ar 2  xx           EB_VISLINEH:        .res 1
00007Br 2  xx           EB_SELSTARTL:       .res 1       ; normalized selection start (16-bit)
00007Cr 2  xx           EB_SELSTARTH:       .res 1
00007Dr 2  xx           EB_SELENDL:         .res 1       ; normalized selection end (16-bit)
00007Er 2  xx           EB_SELENDH:         .res 1
00007Fr 2  xx           EB_DLGSEL:          .res 1       ; dialog selected button
000080r 2  xx           EB_SCRATCHL:        .res 1
000081r 2  xx           EB_SCRATCHH:        .res 1
000082r 2  xx           EB_PREVTOPL:        .res 1       ; scroll snapshot for single-line repaint
000083r 2  xx           EB_PREVTOPH:        .res 1
000084r 2  xx           EB_PREVLEFT:        .res 1
000085r 2  xx           EB_PREVSEL:         .res 1       ; was a selection active before a cursor move
000086r 2  xx           EB_CELLL:           .res 1       ; plane offset of first painted cell (16-bit)
000087r 2  xx           EB_CELLH:           .res 1
000088r 2               
000088r 2               ; --- HILITE hook scratch ---
000088r 2  xx           EDITBUF_HL_LEN:     .res 1
000089r 2  xx xx xx xx  EDITBUF_HL_COLORS:  .res 80
00008Dr 2  xx xx xx xx  
000091r 2  xx xx xx xx  
0000D9r 2               
0000D9r 2               ; --- clipboard ---
0000D9r 2  xx           EDITBUF_CLIPLENL:   .res 1
0000DAr 2  xx           EDITBUF_CLIPLENH:   .res 1
0000DBr 2  xx xx xx xx  EDITBUF_CLIP:       .res EDITBUF_CLIP_CAP
0000DFr 2  xx xx xx xx  
0000E3r 2  xx xx xx xx  
0001DBr 2               
0001DBr 2               ; =====================================================================
0001DBr 2               ; CODE
0001DBr 2               ; =====================================================================
0001DBr 2                     .segment "CODE"
0010D2r 2               
0010D2r 2                     .export editbuf_run
0010D2r 2                     .export editbuf_reset_state
0010D2r 2                     .export editbuf_dialog3
0010D2r 2               
0010D2r 2               ; ---------------------------------------------------------------------
0010D2r 2               ; editbuf_reset_state — clear cursor/scroll/selection for a new session.
0010D2r 2               ; Leaves the buffer text and EDITBUF_LEN untouched.
0010D2r 2               ; ---------------------------------------------------------------------
0010D2r 2               editbuf_reset_state:
0010D2r 2  9C rr rr           STZ   EDITBUF_CURL
0010D5r 2  9C rr rr           STZ   EDITBUF_CURH
0010D8r 2  9C rr rr           STZ   EB_TOPLINEL
0010DBr 2  9C rr rr           STZ   EB_TOPLINEH
0010DEr 2  9C rr rr           STZ   EB_LEFTCOL
0010E1r 2  9C rr rr           STZ   EB_SELL
0010E4r 2  9C rr rr           STZ   EB_SELH
0010E7r 2  9C rr rr           STZ   EDITBUF_SELACT
0010EAr 2  9C rr rr           STZ   EB_GOALCOL
0010EDr 2  60                 RTS
0010EEr 2               
0010EEr 2               ; ---------------------------------------------------------------------
0010EEr 2               ; editbuf_run — run the modal editor. Returns A = EDITBUF_RESULT.
0010EEr 2               ; ---------------------------------------------------------------------
0010EEr 2               editbuf_run:
0010EEr 2  20 rr rr           JSR   editbuf_init_vectors
0010F1r 2  20 rr rr           JSR   editui_init
0010F4r 2  20 rr rr           JSR   editbuf_call_menu          ; host customizes the menu for its runtime
0010F7r 2               
0010F7r 2                     ; Wire the EDITUI chrome to our title / help / status.
0010F7r 2  AD rr rr           LDA   EDITBUF_TITLEL
0010FAr 2  8D rr rr           STA   EDITUI_TITLEL
0010FDr 2  AD rr rr           LDA   EDITBUF_TITLEH
001100r 2  8D rr rr           STA   EDITUI_TITLEH
001103r 2  A9 rr              LDA   #<editbuf_help_text
001105r 2  8D rr rr           STA   EDITUI_HELPL
001108r 2  A9 rr              LDA   #>editbuf_help_text
00110Ar 2  8D rr rr           STA   EDITUI_HELPH
00110Dr 2  20 rr rr           JSR   editbuf_apply_status
001110r 2               
001110r 2                     ; Derive line/col + scroll from the host-provided initial cursor offset so
001110r 2                     ; the first render places the cursor correctly (EDITBUF_CUR may be nonzero;
001110r 2                     ; reset_state does not recompute EB_CURLINE/EB_CURCOL).
001110r 2  20 rr rr           JSR   editbuf_compute_linecol
001113r 2  20 rr rr           JSR   editbuf_adjust_scroll
001116r 2               
001116r 2  20 rr rr           JSR   editui_draw_shell
001119r 2  20 rr rr           JSR   editbuf_render
00111Cr 2               
00111Cr 2               @loop:
00111Cr 2  AD 0F A0           LDA   VGC_CHARIN
00111Fr 2  F0 FB              BEQ   @loop
001121r 2  20 rr rr           JSR   editbuf_dispatch_key
001124r 2  90 F6              BCC   @loop
001126r 2  AD rr rr           LDA   EDITBUF_RESULT
001129r 2  60                 RTS
00112Ar 2               
00112Ar 2               ; editbuf_dispatch_key — handle key in A. Returns carry set to exit the editor.
00112Ar 2               editbuf_dispatch_key:
00112Ar 2  C9 13              CMP   #EDITUI_KEY_CTRL_S
00112Cr 2  D0 05              BNE   :+
00112Er 2  20 rr rr           JSR   editbuf_do_save
001131r 2  18                 CLC
001132r 2  60                 RTS
001133r 2  C9 11        :     CMP   #EDITUI_KEY_CTRL_Q
001135r 2  D0 03              BNE   :+
001137r 2  4C rr rr           JMP   editbuf_do_quit          ; propagates carry (set = exit)
00113Ar 2  C9 03        :     CMP   #EDITUI_KEY_CTRL_C
00113Cr 2  D0 05              BNE   :+
00113Er 2  20 rr rr           JSR   editbuf_copy
001141r 2  18                 CLC
001142r 2  60                 RTS
001143r 2  C9 18        :     CMP   #EDITUI_KEY_CTRL_X
001145r 2  D0 05              BNE   :+
001147r 2  20 rr rr           JSR   editbuf_cut
00114Ar 2  18                 CLC
00114Br 2  60                 RTS
00114Cr 2  C9 16        :     CMP   #EDITUI_KEY_CTRL_V
00114Er 2  D0 05              BNE   :+
001150r 2  20 rr rr           JSR   editbuf_paste
001153r 2  18                 CLC
001154r 2  60                 RTS
001155r 2  C9 01        :     CMP   #EDITUI_KEY_CTRL_A
001157r 2  D0 05              BNE   :+
001159r 2  20 rr rr           JSR   editbuf_select_all
00115Cr 2  18                 CLC
00115Dr 2  60                 RTS
00115Er 2  C9 1C        :     CMP   #EDITUI_KEY_LEFT
001160r 2  D0 05              BNE   :+
001162r 2  20 rr rr           JSR   editbuf_move_left
001165r 2  18                 CLC
001166r 2  60                 RTS
001167r 2  C9 1D        :     CMP   #EDITUI_KEY_RIGHT
001169r 2  D0 05              BNE   :+
00116Br 2  20 rr rr           JSR   editbuf_move_right
00116Er 2  18                 CLC
00116Fr 2  60                 RTS
001170r 2  C9 1E        :     CMP   #EDITUI_KEY_UP
001172r 2  D0 05              BNE   :+
001174r 2  20 rr rr           JSR   editbuf_move_up
001177r 2  18                 CLC
001178r 2  60                 RTS
001179r 2  C9 1F        :     CMP   #EDITUI_KEY_DOWN
00117Br 2  D0 05              BNE   :+
00117Dr 2  20 rr rr           JSR   editbuf_move_down
001180r 2  18                 CLC
001181r 2  60                 RTS
001182r 2  C9 02        :     CMP   #EDITUI_KEY_HOME
001184r 2  D0 05              BNE   :+
001186r 2  20 rr rr           JSR   editbuf_move_home
001189r 2  18                 CLC
00118Ar 2  60                 RTS
00118Br 2  C9 05        :     CMP   #EDITUI_KEY_END
00118Dr 2  D0 05              BNE   :+
00118Fr 2  20 rr rr           JSR   editbuf_move_end
001192r 2  18                 CLC
001193r 2  60                 RTS
001194r 2  C9 10        :     CMP   #EDITUI_KEY_PGUP
001196r 2  D0 05              BNE   :+
001198r 2  20 rr rr           JSR   editbuf_page_up
00119Br 2  18                 CLC
00119Cr 2  60                 RTS
00119Dr 2  C9 12        :     CMP   #EDITUI_KEY_PGDN
00119Fr 2  D0 05              BNE   :+
0011A1r 2  20 rr rr           JSR   editbuf_page_down
0011A4r 2  18                 CLC
0011A5r 2  60                 RTS
0011A6r 2  C9 0D        :     CMP   #EDITUI_KEY_ENTER
0011A8r 2  D0 05              BNE   :+
0011AAr 2  20 rr rr           JSR   editbuf_newline
0011ADr 2  18                 CLC
0011AEr 2  60                 RTS
0011AFr 2  C9 08        :     CMP   #EDITUI_KEY_BACKSPACE
0011B1r 2  F0 04              BEQ   @bs
0011B3r 2  C9 14              CMP   #$14
0011B5r 2  D0 05              BNE   :+
0011B7r 2  20 rr rr     @bs:  JSR   editbuf_backspace
0011BAr 2  18                 CLC
0011BBr 2  60                 RTS
0011BCr 2  C9 7F        :     CMP   #EDITUI_KEY_DELETE
0011BEr 2  D0 05              BNE   :+
0011C0r 2  20 rr rr           JSR   editbuf_delete
0011C3r 2  18                 CLC
0011C4r 2  60                 RTS
0011C5r 2  C9 20        :     CMP   #$20
0011C7r 2  90 07              BCC   @ignore
0011C9r 2  C9 7F              CMP   #$7F
0011CBr 2  B0 03              BCS   @ignore
0011CDr 2  20 rr rr           JSR   editbuf_insert_char
0011D0r 2               @ignore:
0011D0r 2  18                 CLC
0011D1r 2  60                 RTS
0011D2r 2               
0011D2r 2               ; ---------------------------------------------------------------------
0011D2r 2               ; editbuf_apply_status — point EDITUI status at host string, or default to the
0011D2r 2               ; key-hint help text (the status bar is where help now lives).
0011D2r 2               ; ---------------------------------------------------------------------
0011D2r 2               editbuf_apply_status:
0011D2r 2  AD rr rr           LDA   EDITBUF_STATUSL
0011D5r 2  0D rr rr           ORA   EDITBUF_STATUSH
0011D8r 2  D0 0B              BNE   @host
0011DAr 2  A9 rr              LDA   #<editbuf_help_text
0011DCr 2  8D rr rr           STA   EDITUI_STATUSL
0011DFr 2  A9 rr              LDA   #>editbuf_help_text
0011E1r 2  8D rr rr           STA   EDITUI_STATUSH
0011E4r 2  60                 RTS
0011E5r 2               @host:
0011E5r 2  AD rr rr           LDA   EDITBUF_STATUSL
0011E8r 2  8D rr rr           STA   EDITUI_STATUSL
0011EBr 2  AD rr rr           LDA   EDITBUF_STATUSH
0011EEr 2  8D rr rr           STA   EDITUI_STATUSH
0011F1r 2  60                 RTS
0011F2r 2               
0011F2r 2               ; =====================================================================
0011F2r 2               ; 16-bit pointer helpers
0011F2r 2               ; =====================================================================
0011F2r 2               
0011F2r 2               ; EB_PL/H = EDITBUF_BUF + (A:X)  where X=lo, A=hi offset
0011F2r 2               ; Input: X=offset lo, A=offset hi
0011F2r 2               editbuf_ptr_from_off:
0011F2r 2  48                 PHA
0011F3r 2  8A                 TXA
0011F4r 2  18                 CLC
0011F5r 2  6D rr rr           ADC   EDITBUF_BUFL
0011F8r 2  85 rr              STA   EB_PL
0011FAr 2  68                 PLA
0011FBr 2  6D rr rr           ADC   EDITBUF_BUFH
0011FEr 2  85 rr              STA   EB_PH
001200r 2  60                 RTS
001201r 2               
001201r 2               ; EB_SRC = EDITBUF_BUF + EB_SCRATCH(16)
001201r 2               editbuf_src_from_scratch:
001201r 2  18                 CLC
001202r 2  AD rr rr           LDA   EDITBUF_BUFL
001205r 2  6D rr rr           ADC   EB_SCRATCHL
001208r 2  85 rr              STA   EB_SRCL
00120Ar 2  AD rr rr           LDA   EDITBUF_BUFH
00120Dr 2  6D rr rr           ADC   EB_SCRATCHH
001210r 2  85 rr              STA   EB_SRCH
001212r 2  60                 RTS
001213r 2               
001213r 2               ; =====================================================================
001213r 2               ; Buffer mutation: make_gap / close_gap
001213r 2               ; =====================================================================
001213r 2               
001213r 2               ; editbuf_make_gap — open a gap of (EB_CNTL/H) bytes at cursor (EDITBUF_CUR),
001213r 2               ; shifting the tail [cur,len) upward. Assumes len+cnt <= cap (checked by caller).
001213r 2               ; After: EDITBUF_LEN += cnt. Bytes in the gap are left as-is (caller fills).
001213r 2               editbuf_make_gap:
001213r 2                     ; tailcount = LEN - CUR  -> EB_SCRATCH
001213r 2  38                 SEC
001214r 2  AD rr rr           LDA   EDITBUF_LENL
001217r 2  ED rr rr           SBC   EDITBUF_CURL
00121Ar 2  8D rr rr           STA   EB_SCRATCHL
00121Dr 2  AD rr rr           LDA   EDITBUF_LENH
001220r 2  ED rr rr           SBC   EDITBUF_CURH
001223r 2  8D rr rr           STA   EB_SCRATCHH
001226r 2                     ; if tailcount == 0, nothing to move
001226r 2  AD rr rr           LDA   EB_SCRATCHL
001229r 2  0D rr rr           ORA   EB_SCRATCHH
00122Cr 2  F0 63              BEQ   @grow
00122Er 2                     ; src = BUF + (LEN-1); dst = BUF + (LEN-1+cnt); copy backwards tailcount bytes
00122Er 2                     ; src offset = LEN-1
00122Er 2  38                 SEC
00122Fr 2  AD rr rr           LDA   EDITBUF_LENL
001232r 2  E9 01              SBC   #1
001234r 2  85 rr              STA   EB_T0
001236r 2  AD rr rr           LDA   EDITBUF_LENH
001239r 2  E9 00              SBC   #0
00123Br 2  85 rr              STA   EB_T1
00123Dr 2                     ; EB_SRC = BUF + (EB_T1:EB_T0)
00123Dr 2  18                 CLC
00123Er 2  AD rr rr           LDA   EDITBUF_BUFL
001241r 2  65 rr              ADC   EB_T0
001243r 2  85 rr              STA   EB_SRCL
001245r 2  AD rr rr           LDA   EDITBUF_BUFH
001248r 2  65 rr              ADC   EB_T1
00124Ar 2  85 rr              STA   EB_SRCH
00124Cr 2                     ; dst offset = LEN-1+cnt
00124Cr 2  18                 CLC
00124Dr 2  A5 rr              LDA   EB_T0
00124Fr 2  65 rr              ADC   EDITBUF_CNTL
001251r 2  85 rr              STA   EB_DSTL
001253r 2  A5 rr              LDA   EB_T1
001255r 2  65 rr              ADC   EDITBUF_CNTH
001257r 2  85 rr              STA   EB_DSTH
001259r 2  18                 CLC
00125Ar 2  AD rr rr           LDA   EDITBUF_BUFL
00125Dr 2  65 rr              ADC   EB_DSTL
00125Fr 2  85 rr              STA   EB_DSTL
001261r 2  AD rr rr           LDA   EDITBUF_BUFH
001264r 2  65 rr              ADC   EB_DSTH
001266r 2  85 rr              STA   EB_DSTH
001268r 2               @bloop:
001268r 2  A0 00              LDY   #0
00126Ar 2  B1 rr              LDA   (EB_SRCL),Y
00126Cr 2  91 rr              STA   (EB_DSTL),Y
00126Er 2                     ; dec src, dst ptrs
00126Er 2  A5 rr              LDA   EB_SRCL
001270r 2  D0 02              BNE   :+
001272r 2  C6 rr              DEC   EB_SRCH
001274r 2  C6 rr        :     DEC   EB_SRCL
001276r 2  A5 rr              LDA   EB_DSTL
001278r 2  D0 02              BNE   :+
00127Ar 2  C6 rr              DEC   EB_DSTH
00127Cr 2  C6 rr        :     DEC   EB_DSTL
00127Er 2                     ; dec tailcount
00127Er 2  AD rr rr           LDA   EB_SCRATCHL
001281r 2  D0 03              BNE   :+
001283r 2  CE rr rr           DEC   EB_SCRATCHH
001286r 2  CE rr rr     :     DEC   EB_SCRATCHL
001289r 2  AD rr rr           LDA   EB_SCRATCHL
00128Cr 2  0D rr rr           ORA   EB_SCRATCHH
00128Fr 2  D0 D7              BNE   @bloop
001291r 2               @grow:
001291r 2  18                 CLC
001292r 2  AD rr rr           LDA   EDITBUF_LENL
001295r 2  65 rr              ADC   EDITBUF_CNTL
001297r 2  8D rr rr           STA   EDITBUF_LENL
00129Ar 2  AD rr rr           LDA   EDITBUF_LENH
00129Dr 2  65 rr              ADC   EDITBUF_CNTH
00129Fr 2  8D rr rr           STA   EDITBUF_LENH
0012A2r 2  60                 RTS
0012A3r 2               
0012A3r 2               ; editbuf_close_gap — remove (EB_CNTL/H) bytes starting at offset EB_SCRATCH,
0012A3r 2               ; shifting the tail down. After: EDITBUF_LEN -= cnt.
0012A3r 2               ; Input: EB_SCRATCH = start offset; EB_CNT = count to remove.
0012A3r 2               editbuf_close_gap:
0012A3r 2                     ; dst = BUF + start ; src = BUF + start + cnt
0012A3r 2  AD rr rr           LDA   EDITBUF_BUFL
0012A6r 2  18                 CLC
0012A7r 2  6D rr rr           ADC   EB_SCRATCHL
0012AAr 2  85 rr              STA   EB_DSTL
0012ACr 2  AD rr rr           LDA   EDITBUF_BUFH
0012AFr 2  6D rr rr           ADC   EB_SCRATCHH
0012B2r 2  85 rr              STA   EB_DSTH
0012B4r 2  18                 CLC
0012B5r 2  A5 rr              LDA   EB_DSTL
0012B7r 2  65 rr              ADC   EDITBUF_CNTL
0012B9r 2  85 rr              STA   EB_SRCL
0012BBr 2  A5 rr              LDA   EB_DSTH
0012BDr 2  65 rr              ADC   EDITBUF_CNTH
0012BFr 2  85 rr              STA   EB_SRCH
0012C1r 2                     ; movecount = LEN - (start + cnt)
0012C1r 2  18                 CLC
0012C2r 2  AD rr rr           LDA   EB_SCRATCHL
0012C5r 2  65 rr              ADC   EDITBUF_CNTL
0012C7r 2  85 rr              STA   EB_T0
0012C9r 2  AD rr rr           LDA   EB_SCRATCHH
0012CCr 2  65 rr              ADC   EDITBUF_CNTH
0012CEr 2  85 rr              STA   EB_T1
0012D0r 2  38                 SEC
0012D1r 2  AD rr rr           LDA   EDITBUF_LENL
0012D4r 2  E5 rr              SBC   EB_T0
0012D6r 2  8D rr rr           STA   EB_SCRATCHL          ; reuse scratch as movecount
0012D9r 2  AD rr rr           LDA   EDITBUF_LENH
0012DCr 2  E5 rr              SBC   EB_T1
0012DEr 2  8D rr rr           STA   EB_SCRATCHH
0012E1r 2  AD rr rr           LDA   EB_SCRATCHL
0012E4r 2  0D rr rr           ORA   EB_SCRATCHH
0012E7r 2  F0 25              BEQ   @shrink
0012E9r 2               @floop:
0012E9r 2  A0 00              LDY   #0
0012EBr 2  B1 rr              LDA   (EB_SRCL),Y
0012EDr 2  91 rr              STA   (EB_DSTL),Y
0012EFr 2  E6 rr              INC   EB_SRCL
0012F1r 2  D0 02              BNE   :+
0012F3r 2  E6 rr              INC   EB_SRCH
0012F5r 2  E6 rr        :     INC   EB_DSTL
0012F7r 2  D0 02              BNE   :+
0012F9r 2  E6 rr              INC   EB_DSTH
0012FBr 2  AD rr rr     :     LDA   EB_SCRATCHL
0012FEr 2  D0 03              BNE   :+
001300r 2  CE rr rr           DEC   EB_SCRATCHH
001303r 2  CE rr rr     :     DEC   EB_SCRATCHL
001306r 2  AD rr rr           LDA   EB_SCRATCHL
001309r 2  0D rr rr           ORA   EB_SCRATCHH
00130Cr 2  D0 DB              BNE   @floop
00130Er 2               @shrink:
00130Er 2  38                 SEC
00130Fr 2  AD rr rr           LDA   EDITBUF_LENL
001312r 2  E5 rr              SBC   EDITBUF_CNTL
001314r 2  8D rr rr           STA   EDITBUF_LENL
001317r 2  AD rr rr           LDA   EDITBUF_LENH
00131Ar 2  E5 rr              SBC   EDITBUF_CNTH
00131Cr 2  8D rr rr           STA   EDITBUF_LENH
00131Fr 2  60                 RTS
001320r 2               
001320r 2               ; =====================================================================
001320r 2               ; Editing operations
001320r 2               ; =====================================================================
001320r 2               
001320r 2               ; editbuf_insert_char — insert A at cursor (if room). Marks dirty, re-renders.
001320r 2               editbuf_insert_char:
001320r 2  48                 PHA
001321r 2  20 rr rr           JSR   editbuf_clear_selection
001324r 2                     ; room? LEN < CAP
001324r 2  20 rr rr           JSR   editbuf_has_room
001327r 2  90 25              BCC   @full
001329r 2  A9 01              LDA   #1
00132Br 2  85 rr              STA   EDITBUF_CNTL
00132Dr 2  64 rr              STZ   EDITBUF_CNTH
00132Fr 2  20 rr rr           JSR   editbuf_make_gap
001332r 2                     ; store char at cursor
001332r 2  AE rr rr           LDX   EDITBUF_CURL
001335r 2  AD rr rr           LDA   EDITBUF_CURH
001338r 2  20 rr rr           JSR   editbuf_ptr_from_off
00133Br 2  68                 PLA
00133Cr 2  A0 00              LDY   #0
00133Er 2  91 rr              STA   (EB_PL),Y
001340r 2                     ; cursor++
001340r 2  20 rr rr           JSR   editbuf_cursor_inc
001343r 2  20 rr rr           JSR   editbuf_mark_dirty
001346r 2  A9 01              LDA   #1                     ; insert: changed run starts one col left of cursor
001348r 2  8D rr rr           STA   EB_EDITDELTA
00134Br 2  4C rr rr           JMP   editbuf_after_inline_edit
00134Er 2               @full:
00134Er 2  68                 PLA
00134Fr 2  60                 RTS
001350r 2               
001350r 2               ; editbuf_newline — insert a \n at cursor, then auto-indent via hook.
001350r 2               editbuf_newline:
001350r 2  20 rr rr           JSR   editbuf_clear_selection
001353r 2  20 rr rr           JSR   editbuf_has_room
001356r 2  90 4C              BCC   @full
001358r 2  A9 01              LDA   #1
00135Ar 2  85 rr              STA   EDITBUF_CNTL
00135Cr 2  64 rr              STZ   EDITBUF_CNTH
00135Er 2  20 rr rr           JSR   editbuf_make_gap
001361r 2  AE rr rr           LDX   EDITBUF_CURL
001364r 2  AD rr rr           LDA   EDITBUF_CURH
001367r 2  20 rr rr           JSR   editbuf_ptr_from_off
00136Ar 2  A9 0A              LDA   #$0A
00136Cr 2  A0 00              LDY   #0
00136Er 2  91 rr              STA   (EB_PL),Y
001370r 2  20 rr rr           JSR   editbuf_cursor_inc
001373r 2  20 rr rr           JSR   editbuf_mark_dirty
001376r 2                     ; auto-indent: ask hook how many spaces
001376r 2  20 rr rr           JSR   editbuf_call_indent       ; A = count
001379r 2  AA                 TAX
00137Ar 2  F0 25              BEQ   @done
00137Cr 2               @indent:
00137Cr 2  20 rr rr           JSR   editbuf_has_room
00137Fr 2  90 20              BCC   @done
001381r 2  DA                 PHX
001382r 2  A9 01              LDA   #1
001384r 2  85 rr              STA   EDITBUF_CNTL
001386r 2  64 rr              STZ   EDITBUF_CNTH
001388r 2  20 rr rr           JSR   editbuf_make_gap
00138Br 2  AE rr rr           LDX   EDITBUF_CURL
00138Er 2  AD rr rr           LDA   EDITBUF_CURH
001391r 2  20 rr rr           JSR   editbuf_ptr_from_off
001394r 2  A9 20              LDA   #' '
001396r 2  A0 00              LDY   #0
001398r 2  91 rr              STA   (EB_PL),Y
00139Ar 2  20 rr rr           JSR   editbuf_cursor_inc
00139Dr 2  FA                 PLX
00139Er 2  CA                 DEX
00139Fr 2  D0 DB              BNE   @indent
0013A1r 2               @done:
0013A1r 2  4C rr rr           JMP   editbuf_after_change_down   ; newline shifts lines below it down
0013A4r 2               @full:
0013A4r 2  60                 RTS
0013A5r 2               
0013A5r 2               ; editbuf_backspace — delete char before cursor.
0013A5r 2               editbuf_backspace:
0013A5r 2  AD rr rr           LDA   EDITBUF_SELACT
0013A8r 2  F0 06              BEQ   @nosel
0013AAr 2  20 rr rr           JSR   editbuf_delete_selection
0013ADr 2  4C rr rr           JMP   editbuf_after_change
0013B0r 2               @nosel:
0013B0r 2  AD rr rr           LDA   EDITBUF_CURL
0013B3r 2  0D rr rr           ORA   EDITBUF_CURH
0013B6r 2  F0 39              BEQ   @done                 ; at start
0013B8r 2  20 rr rr           JSR   editbuf_cursor_dec
0013BBr 2                     ; peek the byte about to be removed (now at the cursor) to tell a line
0013BBr 2                     ; join (\n) from an in-line delete.
0013BBr 2  AE rr rr           LDX   EDITBUF_CURL
0013BEr 2  AD rr rr           LDA   EDITBUF_CURH
0013C1r 2  20 rr rr           JSR   editbuf_ptr_from_off
0013C4r 2  A0 00              LDY   #0
0013C6r 2  B1 rr              LDA   (EB_PL),Y
0013C8r 2  85 rr              STA   EB_T1                 ; removed char
0013CAr 2                     ; close gap of 1 at cursor
0013CAr 2  AD rr rr           LDA   EDITBUF_CURL
0013CDr 2  8D rr rr           STA   EB_SCRATCHL
0013D0r 2  AD rr rr           LDA   EDITBUF_CURH
0013D3r 2  8D rr rr           STA   EB_SCRATCHH
0013D6r 2  A9 01              LDA   #1
0013D8r 2  85 rr              STA   EDITBUF_CNTL
0013DAr 2  64 rr              STZ   EDITBUF_CNTH
0013DCr 2  20 rr rr           JSR   editbuf_close_gap
0013DFr 2  20 rr rr           JSR   editbuf_mark_dirty
0013E2r 2  A5 rr              LDA   EB_T1
0013E4r 2  C9 0A              CMP   #$0A
0013E6r 2  D0 03              BNE   @inline
0013E8r 2  4C rr rr           JMP   editbuf_after_change_down      ; joined two lines -> vertical repaint
0013EBr 2               @inline:
0013EBr 2  9C rr rr           STZ   EB_EDITDELTA                   ; in-line delete: run starts at the cursor
0013EEr 2  4C rr rr           JMP   editbuf_after_inline_edit
0013F1r 2               @done:
0013F1r 2  60                 RTS
0013F2r 2               
0013F2r 2               ; editbuf_delete — delete char at cursor.
0013F2r 2               editbuf_delete:
0013F2r 2  AD rr rr           LDA   EDITBUF_SELACT
0013F5r 2  F0 06              BEQ   @nosel
0013F7r 2  20 rr rr           JSR   editbuf_delete_selection
0013FAr 2  4C rr rr           JMP   editbuf_after_change
0013FDr 2               @nosel:
0013FDr 2                     ; cursor < len ?
0013FDr 2  AD rr rr           LDA   EDITBUF_CURL
001400r 2  CD rr rr           CMP   EDITBUF_LENL
001403r 2  AD rr rr           LDA   EDITBUF_CURH
001406r 2  ED rr rr           SBC   EDITBUF_LENH
001409r 2  B0 36              BCS   @done                 ; cursor >= len
00140Br 2                     ; peek the byte at the cursor to tell a line join (\n) from an in-line delete.
00140Br 2  AE rr rr           LDX   EDITBUF_CURL
00140Er 2  AD rr rr           LDA   EDITBUF_CURH
001411r 2  20 rr rr           JSR   editbuf_ptr_from_off
001414r 2  A0 00              LDY   #0
001416r 2  B1 rr              LDA   (EB_PL),Y
001418r 2  85 rr              STA   EB_T1                 ; removed char
00141Ar 2  AD rr rr           LDA   EDITBUF_CURL
00141Dr 2  8D rr rr           STA   EB_SCRATCHL
001420r 2  AD rr rr           LDA   EDITBUF_CURH
001423r 2  8D rr rr           STA   EB_SCRATCHH
001426r 2  A9 01              LDA   #1
001428r 2  85 rr              STA   EDITBUF_CNTL
00142Ar 2  64 rr              STZ   EDITBUF_CNTH
00142Cr 2  20 rr rr           JSR   editbuf_close_gap
00142Fr 2  20 rr rr           JSR   editbuf_mark_dirty
001432r 2  A5 rr              LDA   EB_T1
001434r 2  C9 0A              CMP   #$0A
001436r 2  D0 03              BNE   @inline
001438r 2  4C rr rr           JMP   editbuf_after_change_down      ; deleted a newline -> vertical repaint
00143Br 2               @inline:
00143Br 2  9C rr rr           STZ   EB_EDITDELTA                   ; in-line delete: run starts at the cursor
00143Er 2  4C rr rr           JMP   editbuf_after_inline_edit
001441r 2               @done:
001441r 2  60                 RTS
001442r 2               
001442r 2               ; editbuf_has_room — carry set if LEN < CAP (room for at least one byte).
001442r 2               editbuf_has_room:
001442r 2  AD rr rr           LDA   EDITBUF_LENL
001445r 2  CD rr rr           CMP   EDITBUF_CAPL
001448r 2  AD rr rr           LDA   EDITBUF_LENH
00144Br 2  ED rr rr           SBC   EDITBUF_CAPH
00144Er 2  90 02              BCC   @yes                  ; LEN < CAP
001450r 2  18                 CLC
001451r 2  60                 RTS
001452r 2               @yes:
001452r 2  38                 SEC
001453r 2  60                 RTS
001454r 2               
001454r 2               editbuf_cursor_inc:
001454r 2  EE rr rr           INC   EDITBUF_CURL
001457r 2  D0 03              BNE   @done
001459r 2  EE rr rr           INC   EDITBUF_CURH
00145Cr 2               @done:
00145Cr 2  60                 RTS
00145Dr 2               
00145Dr 2               editbuf_cursor_dec:
00145Dr 2  AD rr rr           LDA   EDITBUF_CURL
001460r 2  D0 03              BNE   @done
001462r 2  CE rr rr           DEC   EDITBUF_CURH
001465r 2               @done:
001465r 2  CE rr rr           DEC   EDITBUF_CURL
001468r 2  60                 RTS
001469r 2               
001469r 2               ; =====================================================================
001469r 2               ; Selection / clipboard
001469r 2               ; =====================================================================
001469r 2               
001469r 2               editbuf_clear_selection:
001469r 2  AD rr rr           LDA   EDITBUF_SELACT
00146Cr 2  F0 03              BEQ   @done
00146Er 2                     ; If a selection is active, replace it (delete) before inserting.
00146Er 2  20 rr rr           JSR   editbuf_delete_selection
001471r 2               @done:
001471r 2  9C rr rr           STZ   EDITBUF_SELACT
001474r 2  60                 RTS
001475r 2               
001475r 2               ; Normalize selection -> EB_SELSTART (min) .. EB_SELEND (max)
001475r 2               editbuf_normalize_selection:
001475r 2  AD rr rr           LDA   EB_SELL
001478r 2  CD rr rr           CMP   EDITBUF_CURL
00147Br 2  AD rr rr           LDA   EB_SELH
00147Er 2  ED rr rr           SBC   EDITBUF_CURH
001481r 2  90 19              BCC   @anchor_lt            ; anchor < cursor
001483r 2                     ; cursor <= anchor
001483r 2  AD rr rr           LDA   EDITBUF_CURL
001486r 2  8D rr rr           STA   EB_SELSTARTL
001489r 2  AD rr rr           LDA   EDITBUF_CURH
00148Cr 2  8D rr rr           STA   EB_SELSTARTH
00148Fr 2  AD rr rr           LDA   EB_SELL
001492r 2  8D rr rr           STA   EB_SELENDL
001495r 2  AD rr rr           LDA   EB_SELH
001498r 2  8D rr rr           STA   EB_SELENDH
00149Br 2  60                 RTS
00149Cr 2               @anchor_lt:
00149Cr 2  AD rr rr           LDA   EB_SELL
00149Fr 2  8D rr rr           STA   EB_SELSTARTL
0014A2r 2  AD rr rr           LDA   EB_SELH
0014A5r 2  8D rr rr           STA   EB_SELSTARTH
0014A8r 2  AD rr rr           LDA   EDITBUF_CURL
0014ABr 2  8D rr rr           STA   EB_SELENDL
0014AEr 2  AD rr rr           LDA   EDITBUF_CURH
0014B1r 2  8D rr rr           STA   EB_SELENDH
0014B4r 2  60                 RTS
0014B5r 2               
0014B5r 2               editbuf_delete_selection:
0014B5r 2  20 rr rr           JSR   editbuf_normalize_selection
0014B8r 2                     ; count = end - start
0014B8r 2  38                 SEC
0014B9r 2  AD rr rr           LDA   EB_SELENDL
0014BCr 2  ED rr rr           SBC   EB_SELSTARTL
0014BFr 2  85 rr              STA   EDITBUF_CNTL
0014C1r 2  AD rr rr           LDA   EB_SELENDH
0014C4r 2  ED rr rr           SBC   EB_SELSTARTH
0014C7r 2  85 rr              STA   EDITBUF_CNTH
0014C9r 2  A5 rr              LDA   EDITBUF_CNTL
0014CBr 2  05 rr              ORA   EDITBUF_CNTH
0014CDr 2  F0 1E              BEQ   @done
0014CFr 2  AD rr rr           LDA   EB_SELSTARTL
0014D2r 2  8D rr rr           STA   EB_SCRATCHL
0014D5r 2  AD rr rr           LDA   EB_SELSTARTH
0014D8r 2  8D rr rr           STA   EB_SCRATCHH
0014DBr 2  20 rr rr           JSR   editbuf_close_gap
0014DEr 2                     ; cursor = start
0014DEr 2  AD rr rr           LDA   EB_SELSTARTL
0014E1r 2  8D rr rr           STA   EDITBUF_CURL
0014E4r 2  AD rr rr           LDA   EB_SELSTARTH
0014E7r 2  8D rr rr           STA   EDITBUF_CURH
0014EAr 2  20 rr rr           JSR   editbuf_mark_dirty
0014EDr 2               @done:
0014EDr 2  9C rr rr           STZ   EDITBUF_SELACT
0014F0r 2  60                 RTS
0014F1r 2               
0014F1r 2               ; editbuf_select_all — anchor at 0, cursor at end.
0014F1r 2               editbuf_select_all:
0014F1r 2  9C rr rr           STZ   EB_SELL
0014F4r 2  9C rr rr           STZ   EB_SELH
0014F7r 2  A9 01              LDA   #1
0014F9r 2  8D rr rr           STA   EDITBUF_SELACT
0014FCr 2  AD rr rr           LDA   EDITBUF_LENL
0014FFr 2  8D rr rr           STA   EDITBUF_CURL
001502r 2  AD rr rr           LDA   EDITBUF_LENH
001505r 2  8D rr rr           STA   EDITBUF_CURH
001508r 2  4C rr rr           JMP   editbuf_after_change
00150Br 2               
00150Br 2               ; editbuf_copy — copy selection (or nothing) into clipboard.
00150Br 2               editbuf_copy:
00150Br 2  AD rr rr           LDA   EDITBUF_SELACT
00150Er 2  F0 4E              BEQ   @done
001510r 2  20 rr rr           JSR   editbuf_normalize_selection
001513r 2                     ; count = end - start, clamp to clip cap
001513r 2  38                 SEC
001514r 2  AD rr rr           LDA   EB_SELENDL
001517r 2  ED rr rr           SBC   EB_SELSTARTL
00151Ar 2  8D rr rr           STA   EDITBUF_CLIPLENL
00151Dr 2  AD rr rr           LDA   EB_SELENDH
001520r 2  ED rr rr           SBC   EB_SELSTARTH
001523r 2  8D rr rr           STA   EDITBUF_CLIPLENH
001526r 2                     ; clamp cliplen to 255 (copy/paste iterate with an 8-bit index)
001526r 2  AD rr rr           LDA   EDITBUF_CLIPLENH
001529r 2  F0 08              BEQ   @copy
00152Br 2  A9 FF              LDA   #255
00152Dr 2  8D rr rr           STA   EDITBUF_CLIPLENL
001530r 2  9C rr rr           STZ   EDITBUF_CLIPLENH
001533r 2               @copy:
001533r 2                     ; src ptr = BUF + selstart
001533r 2  AD rr rr           LDA   EB_SELSTARTL
001536r 2  8D rr rr           STA   EB_SCRATCHL
001539r 2  AD rr rr           LDA   EB_SELSTARTH
00153Cr 2  8D rr rr           STA   EB_SCRATCHH
00153Fr 2  20 rr rr           JSR   editbuf_src_from_scratch
001542r 2  A2 00              LDX   #0                    ; clip index (<=256)
001544r 2               @cl:
001544r 2  EC rr rr           CPX   EDITBUF_CLIPLENL
001547r 2  D0 05              BNE   :+
001549r 2  AD rr rr           LDA   EDITBUF_CLIPLENH
00154Cr 2  F0 10              BEQ   @done
00154Er 2  A0 00        :     LDY   #0
001550r 2  B1 rr              LDA   (EB_SRCL),Y
001552r 2  9D rr rr           STA   EDITBUF_CLIP,X
001555r 2  E6 rr              INC   EB_SRCL
001557r 2  D0 02              BNE   :+
001559r 2  E6 rr              INC   EB_SRCH
00155Br 2  E8           :     INX
00155Cr 2  D0 E6              BNE   @cl
00155Er 2               @done:
00155Er 2  60                 RTS
00155Fr 2               
00155Fr 2               editbuf_cut:
00155Fr 2  AD rr rr           LDA   EDITBUF_SELACT
001562r 2  F0 09              BEQ   @done
001564r 2  20 rr rr           JSR   editbuf_copy
001567r 2  20 rr rr           JSR   editbuf_delete_selection
00156Ar 2  4C rr rr           JMP   editbuf_after_change
00156Dr 2               @done:
00156Dr 2  60                 RTS
00156Er 2               
00156Er 2               ; editbuf_paste — insert clipboard bytes at cursor.
00156Er 2               editbuf_paste:
00156Er 2  20 rr rr           JSR   editbuf_clear_selection
001571r 2  AD rr rr           LDA   EDITBUF_CLIPLENL
001574r 2  0D rr rr           ORA   EDITBUF_CLIPLENH
001577r 2  F0 7C              BEQ   @done
001579r 2                     ; room? LEN + cliplen <= CAP
001579r 2  18                 CLC
00157Ar 2  AD rr rr           LDA   EDITBUF_LENL
00157Dr 2  6D rr rr           ADC   EDITBUF_CLIPLENL
001580r 2  85 rr              STA   EB_T0
001582r 2  AD rr rr           LDA   EDITBUF_LENH
001585r 2  6D rr rr           ADC   EDITBUF_CLIPLENH
001588r 2  85 rr              STA   EB_T1
00158Ar 2  A5 rr              LDA   EB_T0
00158Cr 2  CD rr rr           CMP   EDITBUF_CAPL
00158Fr 2  A5 rr              LDA   EB_T1
001591r 2  ED rr rr           SBC   EDITBUF_CAPH
001594r 2  B0 5F              BCS   @done                 ; would overflow cap
001596r 2                     ; make gap of cliplen at cursor
001596r 2  AD rr rr           LDA   EDITBUF_CLIPLENL
001599r 2  85 rr              STA   EDITBUF_CNTL
00159Br 2  AD rr rr           LDA   EDITBUF_CLIPLENH
00159Er 2  85 rr              STA   EDITBUF_CNTH
0015A0r 2  20 rr rr           JSR   editbuf_make_gap
0015A3r 2                     ; dst ptr = BUF + cursor
0015A3r 2  AD rr rr           LDA   EDITBUF_CURL
0015A6r 2  8D rr rr           STA   EB_SCRATCHL
0015A9r 2  AD rr rr           LDA   EDITBUF_CURH
0015ACr 2  8D rr rr           STA   EB_SCRATCHH
0015AFr 2  AD rr rr           LDA   EDITBUF_BUFL
0015B2r 2  18                 CLC
0015B3r 2  6D rr rr           ADC   EB_SCRATCHL
0015B6r 2  85 rr              STA   EB_DSTL
0015B8r 2  AD rr rr           LDA   EDITBUF_BUFH
0015BBr 2  6D rr rr           ADC   EB_SCRATCHH
0015BEr 2  85 rr              STA   EB_DSTH
0015C0r 2  A2 00              LDX   #0
0015C2r 2               @pl:
0015C2r 2  EC rr rr           CPX   EDITBUF_CLIPLENL
0015C5r 2  D0 05              BNE   :+
0015C7r 2  AD rr rr           LDA   EDITBUF_CLIPLENH
0015CAr 2  F0 10              BEQ   @adv
0015CCr 2  BD rr rr     :     LDA   EDITBUF_CLIP,X
0015CFr 2  A0 00              LDY   #0
0015D1r 2  91 rr              STA   (EB_DSTL),Y
0015D3r 2  E6 rr              INC   EB_DSTL
0015D5r 2  D0 02              BNE   :+
0015D7r 2  E6 rr              INC   EB_DSTH
0015D9r 2  E8           :     INX
0015DAr 2  D0 E6              BNE   @pl
0015DCr 2               @adv:
0015DCr 2                     ; cursor += cliplen
0015DCr 2  18                 CLC
0015DDr 2  AD rr rr           LDA   EDITBUF_CURL
0015E0r 2  6D rr rr           ADC   EDITBUF_CLIPLENL
0015E3r 2  8D rr rr           STA   EDITBUF_CURL
0015E6r 2  AD rr rr           LDA   EDITBUF_CURH
0015E9r 2  6D rr rr           ADC   EDITBUF_CLIPLENH
0015ECr 2  8D rr rr           STA   EDITBUF_CURH
0015EFr 2  20 rr rr           JSR   editbuf_mark_dirty
0015F2r 2  4C rr rr           JMP   editbuf_after_change
0015F5r 2               @done:
0015F5r 2  60                 RTS
0015F6r 2               
0015F6r 2               ; =====================================================================
0015F6r 2               ; Cursor navigation
0015F6r 2               ; =====================================================================
0015F6r 2               
0015F6r 2               editbuf_move_left:
0015F6r 2  20 rr rr           JSR   editbuf_begin_move
0015F9r 2  AD rr rr           LDA   EDITBUF_CURL
0015FCr 2  0D rr rr           ORA   EDITBUF_CURH
0015FFr 2  F0 09              BEQ   @done
001601r 2  20 rr rr           JSR   editbuf_cursor_dec
001604r 2  20 rr rr           JSR   editbuf_update_goalcol
001607r 2  4C rr rr           JMP   editbuf_after_move
00160Ar 2               @done:
00160Ar 2  60                 RTS
00160Br 2               
00160Br 2               editbuf_move_right:
00160Br 2  20 rr rr           JSR   editbuf_begin_move
00160Er 2  AD rr rr           LDA   EDITBUF_CURL
001611r 2  CD rr rr           CMP   EDITBUF_LENL
001614r 2  AD rr rr           LDA   EDITBUF_CURH
001617r 2  ED rr rr           SBC   EDITBUF_LENH
00161Ar 2  B0 09              BCS   @done                 ; cursor >= len
00161Cr 2  20 rr rr           JSR   editbuf_cursor_inc
00161Fr 2  20 rr rr           JSR   editbuf_update_goalcol
001622r 2  4C rr rr           JMP   editbuf_after_move
001625r 2               @done:
001625r 2  60                 RTS
001626r 2               
001626r 2               editbuf_move_home:
001626r 2  20 rr rr           JSR   editbuf_begin_move
001629r 2  20 rr rr           JSR   editbuf_compute_linecol
00162Cr 2                     ; cursor = cursor - curcol
00162Cr 2  38                 SEC
00162Dr 2  AD rr rr           LDA   EDITBUF_CURL
001630r 2  ED rr rr           SBC   EB_CURCOL
001633r 2  8D rr rr           STA   EDITBUF_CURL
001636r 2  AD rr rr           LDA   EDITBUF_CURH
001639r 2  E9 00              SBC   #0
00163Br 2  8D rr rr           STA   EDITBUF_CURH
00163Er 2  9C rr rr           STZ   EB_GOALCOL
001641r 2  4C rr rr           JMP   editbuf_after_move
001644r 2               
001644r 2               editbuf_move_end:
001644r 2  20 rr rr           JSR   editbuf_begin_move
001647r 2  20 rr rr           JSR   editbuf_compute_linecol
00164Ar 2                     ; advance cursor to end of current line (until \n or buffer end)
00164Ar 2               @scan:
00164Ar 2  AD rr rr           LDA   EDITBUF_CURL
00164Dr 2  CD rr rr           CMP   EDITBUF_LENL
001650r 2  AD rr rr           LDA   EDITBUF_CURH
001653r 2  ED rr rr           SBC   EDITBUF_LENH
001656r 2  B0 16              BCS   @done                 ; at end of buffer
001658r 2  AE rr rr           LDX   EDITBUF_CURL
00165Br 2  AD rr rr           LDA   EDITBUF_CURH
00165Er 2  20 rr rr           JSR   editbuf_ptr_from_off
001661r 2  A0 00              LDY   #0
001663r 2  B1 rr              LDA   (EB_PL),Y
001665r 2  C9 0A              CMP   #$0A
001667r 2  F0 05              BEQ   @done
001669r 2  20 rr rr           JSR   editbuf_cursor_inc
00166Cr 2  80 DC              BRA   @scan
00166Er 2               @done:
00166Er 2  20 rr rr           JSR   editbuf_update_goalcol
001671r 2  4C rr rr           JMP   editbuf_after_move
001674r 2               
001674r 2               editbuf_move_up:
001674r 2  20 rr rr           JSR   editbuf_begin_move
001677r 2  20 rr rr           JSR   editbuf_compute_linecol
00167Ar 2  AD rr rr           LDA   EB_CURLINEL
00167Dr 2  0D rr rr           ORA   EB_CURLINEH
001680r 2  F0 1D              BEQ   @done                 ; already on first line
001682r 2                     ; target line = curline - 1
001682r 2  AD rr rr           LDA   EB_CURLINEL
001685r 2  8D rr rr           STA   EB_SCRATCHL
001688r 2  AD rr rr           LDA   EB_CURLINEH
00168Br 2  8D rr rr           STA   EB_SCRATCHH
00168Er 2  AD rr rr           LDA   EB_SCRATCHL
001691r 2  D0 03              BNE   :+
001693r 2  CE rr rr           DEC   EB_SCRATCHH
001696r 2  CE rr rr     :     DEC   EB_SCRATCHL
001699r 2  20 rr rr           JSR   editbuf_goto_line_col
00169Cr 2  4C rr rr           JMP   editbuf_after_move
00169Fr 2               @done:
00169Fr 2  60                 RTS
0016A0r 2               
0016A0r 2               editbuf_move_down:
0016A0r 2  20 rr rr           JSR   editbuf_begin_move
0016A3r 2  20 rr rr           JSR   editbuf_compute_linecol  ; CURLINE (clobbers EB_SCRATCH)
0016A6r 2  20 rr rr           JSR   editbuf_count_lines      ; EB_T0:EB_T1 = total (clobbers EB_SCRATCH)
0016A9r 2                     ; target line = curline + 1 (set EB_SCRATCH last; both helpers above use it)
0016A9r 2  AD rr rr           LDA   EB_CURLINEL
0016ACr 2  8D rr rr           STA   EB_SCRATCHL
0016AFr 2  AD rr rr           LDA   EB_CURLINEH
0016B2r 2  8D rr rr           STA   EB_SCRATCHH
0016B5r 2  EE rr rr           INC   EB_SCRATCHL
0016B8r 2  D0 03              BNE   :+
0016BAr 2  EE rr rr           INC   EB_SCRATCHH
0016BDr 2  AD rr rr     :     LDA   EB_SCRATCHL
0016C0r 2  C5 rr              CMP   EB_T0
0016C2r 2  AD rr rr           LDA   EB_SCRATCHH
0016C5r 2  E5 rr              SBC   EB_T1
0016C7r 2  B0 06              BCS   @done                 ; target >= total -> no line below
0016C9r 2  20 rr rr           JSR   editbuf_goto_line_col
0016CCr 2  4C rr rr           JMP   editbuf_after_move
0016CFr 2               @done:
0016CFr 2  60                 RTS
0016D0r 2               
0016D0r 2               editbuf_page_up:
0016D0r 2  20 rr rr           JSR   editbuf_begin_move
0016D3r 2  20 rr rr           JSR   editbuf_compute_linecol
0016D6r 2                     ; target = curline - VIEW_ROWS (clamp 0)
0016D6r 2  AD rr rr           LDA   EB_CURLINEL
0016D9r 2  38                 SEC
0016DAr 2  E9 30              SBC   #EDITBUF_VIEW_ROWS
0016DCr 2  8D rr rr           STA   EB_SCRATCHL
0016DFr 2  AD rr rr           LDA   EB_CURLINEH
0016E2r 2  E9 00              SBC   #0
0016E4r 2  8D rr rr           STA   EB_SCRATCHH
0016E7r 2  B0 06              BCS   @ok
0016E9r 2  9C rr rr           STZ   EB_SCRATCHL
0016ECr 2  9C rr rr           STZ   EB_SCRATCHH
0016EFr 2               @ok:
0016EFr 2  20 rr rr           JSR   editbuf_goto_line_col
0016F2r 2  4C rr rr           JMP   editbuf_after_move
0016F5r 2               
0016F5r 2               editbuf_page_down:
0016F5r 2  20 rr rr           JSR   editbuf_begin_move
0016F8r 2  20 rr rr           JSR   editbuf_compute_linecol  ; CURLINE (clobbers EB_SCRATCH)
0016FBr 2  20 rr rr           JSR   editbuf_count_lines      ; EB_T0:EB_T1 = total (clobbers EB_SCRATCH)
0016FEr 2                     ; clamp total to total-1 in EB_T0:EB_T1 (last visible line index)
0016FEr 2  A5 rr              LDA   EB_T0
001700r 2  D0 02              BNE   :+
001702r 2  C6 rr              DEC   EB_T1
001704r 2  C6 rr        :     DEC   EB_T0
001706r 2                     ; target = curline + VIEW_ROWS (set EB_SCRATCH after the helpers)
001706r 2  AD rr rr           LDA   EB_CURLINEL
001709r 2  18                 CLC
00170Ar 2  69 30              ADC   #EDITBUF_VIEW_ROWS
00170Cr 2  8D rr rr           STA   EB_SCRATCHL
00170Fr 2  AD rr rr           LDA   EB_CURLINEH
001712r 2  69 00              ADC   #0
001714r 2  8D rr rr           STA   EB_SCRATCHH
001717r 2  AD rr rr           LDA   EB_SCRATCHL
00171Ar 2  C5 rr              CMP   EB_T0
00171Cr 2  AD rr rr           LDA   EB_SCRATCHH
00171Fr 2  E5 rr              SBC   EB_T1
001721r 2  90 0A              BCC   @ok
001723r 2  A5 rr              LDA   EB_T0
001725r 2  8D rr rr           STA   EB_SCRATCHL
001728r 2  A5 rr              LDA   EB_T1
00172Ar 2  8D rr rr           STA   EB_SCRATCHH
00172Dr 2               @ok:
00172Dr 2  20 rr rr           JSR   editbuf_goto_line_col
001730r 2  4C rr rr           JMP   editbuf_after_move
001733r 2               
001733r 2               ; editbuf_goto_line_col — set cursor to (line=EB_SCRATCH, col=EB_GOALCOL),
001733r 2               ; clamped to the line's length.
001733r 2               editbuf_goto_line_col:
001733r 2  20 rr rr           JSR   editbuf_offset_of_line   ; EB_LINEOFF = start offset of EB_SCRATCH line
001736r 2                     ; cursor = lineoff
001736r 2  AD rr rr           LDA   EB_LINEOFFL
001739r 2  8D rr rr           STA   EDITBUF_CURL
00173Cr 2  AD rr rr           LDA   EB_LINEOFFH
00173Fr 2  8D rr rr           STA   EDITBUF_CURH
001742r 2                     ; advance up to GOALCOL chars, stopping at \n / buffer end
001742r 2  AE rr rr           LDX   EB_GOALCOL
001745r 2  F0 27              BEQ   @done
001747r 2               @adv:
001747r 2  AD rr rr           LDA   EDITBUF_CURL
00174Ar 2  CD rr rr           CMP   EDITBUF_LENL
00174Dr 2  AD rr rr           LDA   EDITBUF_CURH
001750r 2  ED rr rr           SBC   EDITBUF_LENH
001753r 2  B0 19              BCS   @done
001755r 2  DA                 PHX
001756r 2  AE rr rr           LDX   EDITBUF_CURL
001759r 2  AD rr rr           LDA   EDITBUF_CURH
00175Cr 2  20 rr rr           JSR   editbuf_ptr_from_off
00175Fr 2  A0 00              LDY   #0
001761r 2  B1 rr              LDA   (EB_PL),Y
001763r 2  FA                 PLX
001764r 2  C9 0A              CMP   #$0A
001766r 2  F0 06              BEQ   @done
001768r 2  20 rr rr           JSR   editbuf_cursor_inc
00176Br 2  CA                 DEX
00176Cr 2  D0 D9              BNE   @adv
00176Er 2               @done:
00176Er 2  60                 RTS
00176Fr 2               
00176Fr 2               editbuf_update_goalcol:
00176Fr 2  20 rr rr           JSR   editbuf_compute_linecol
001772r 2  AD rr rr           LDA   EB_CURCOL
001775r 2  8D rr rr           STA   EB_GOALCOL
001778r 2  60                 RTS
001779r 2               
001779r 2               ; =====================================================================
001779r 2               ; Line/column computation
001779r 2               ; =====================================================================
001779r 2               
001779r 2               ; editbuf_compute_linecol — scan [0,cursor) counting newlines.
001779r 2               ;   Sets EB_CURLINE (16) and EB_CURCOL (8, clamped 255), and EB_LINEOFF =
001779r 2               ;   offset of the current line's first byte.
001779r 2               editbuf_compute_linecol:
001779r 2  9C rr rr           STZ   EB_CURLINEL
00177Cr 2  9C rr rr           STZ   EB_CURLINEH
00177Fr 2  9C rr rr           STZ   EB_CURCOL
001782r 2  9C rr rr           STZ   EB_LINEOFFL
001785r 2  9C rr rr           STZ   EB_LINEOFFH
001788r 2                     ; iterate offset 0..cursor-1
001788r 2  9C rr rr           STZ   EB_SCRATCHL
00178Br 2  9C rr rr           STZ   EB_SCRATCHH
00178Er 2               @loop:
00178Er 2  AD rr rr           LDA   EB_SCRATCHL
001791r 2  CD rr rr           CMP   EDITBUF_CURL
001794r 2  AD rr rr           LDA   EB_SCRATCHH
001797r 2  ED rr rr           SBC   EDITBUF_CURH
00179Ar 2  B0 3D              BCS   @done                 ; scratch >= cursor
00179Cr 2  20 rr rr           JSR   editbuf_src_from_scratch
00179Fr 2  A0 00              LDY   #0
0017A1r 2  B1 rr              LDA   (EB_SRCL),Y
0017A3r 2  C9 0A              CMP   #$0A
0017A5r 2  D0 1E              BNE   @notnl
0017A7r 2                     ; newline: line++, col=0, lineoff = scratch+1
0017A7r 2  EE rr rr           INC   EB_CURLINEL
0017AAr 2  D0 03              BNE   :+
0017ACr 2  EE rr rr           INC   EB_CURLINEH
0017AFr 2  9C rr rr     :     STZ   EB_CURCOL
0017B2r 2  18                 CLC
0017B3r 2  AD rr rr           LDA   EB_SCRATCHL
0017B6r 2  69 01              ADC   #1
0017B8r 2  8D rr rr           STA   EB_LINEOFFL
0017BBr 2  AD rr rr           LDA   EB_SCRATCHH
0017BEr 2  69 00              ADC   #0
0017C0r 2  8D rr rr           STA   EB_LINEOFFH
0017C3r 2  80 0A              BRA   @next
0017C5r 2               @notnl:
0017C5r 2  AD rr rr           LDA   EB_CURCOL
0017C8r 2  C9 FF              CMP   #255
0017CAr 2  B0 03              BCS   @next
0017CCr 2  EE rr rr           INC   EB_CURCOL
0017CFr 2               @next:
0017CFr 2  EE rr rr           INC   EB_SCRATCHL
0017D2r 2  D0 BA              BNE   @loop
0017D4r 2  EE rr rr           INC   EB_SCRATCHH
0017D7r 2  80 B5              BRA   @loop
0017D9r 2               @done:
0017D9r 2  60                 RTS
0017DAr 2               
0017DAr 2               ; editbuf_offset_of_line — find first-byte offset of line number EB_SCRATCH.
0017DAr 2               ;   Output: EB_LINEOFF.
0017DAr 2               editbuf_offset_of_line:
0017DAr 2                     ; if line 0 -> offset 0
0017DAr 2  AD rr rr           LDA   EB_SCRATCHL
0017DDr 2  0D rr rr           ORA   EB_SCRATCHH
0017E0r 2  D0 07              BNE   @scan
0017E2r 2  9C rr rr           STZ   EB_LINEOFFL
0017E5r 2  9C rr rr           STZ   EB_LINEOFFH
0017E8r 2  60                 RTS
0017E9r 2               @scan:
0017E9r 2                     ; walk buffer counting newlines until we've passed EB_SCRATCH of them
0017E9r 2  9C rr rr           STZ   EB_LINEOFFL           ; reuse as running offset
0017ECr 2  9C rr rr           STZ   EB_LINEOFFH
0017EFr 2  64 rr              STZ   EB_T0                 ; newline count lo
0017F1r 2  64 rr              STZ   EB_T1                 ; newline count hi
0017F3r 2               @loop:
0017F3r 2                     ; offset >= len? then return current offset (line past end -> end)
0017F3r 2  AD rr rr           LDA   EB_LINEOFFL
0017F6r 2  CD rr rr           CMP   EDITBUF_LENL
0017F9r 2  AD rr rr           LDA   EB_LINEOFFH
0017FCr 2  ED rr rr           SBC   EDITBUF_LENH
0017FFr 2  B0 35              BCS   @done
001801r 2                     ; read byte at offset
001801r 2  AD rr rr           LDA   EDITBUF_BUFL
001804r 2  18                 CLC
001805r 2  6D rr rr           ADC   EB_LINEOFFL
001808r 2  85 rr              STA   EB_SRCL
00180Ar 2  AD rr rr           LDA   EDITBUF_BUFH
00180Dr 2  6D rr rr           ADC   EB_LINEOFFH
001810r 2  85 rr              STA   EB_SRCH
001812r 2  A0 00              LDY   #0
001814r 2  B1 rr              LDA   (EB_SRCL),Y
001816r 2                     ; advance offset
001816r 2  EE rr rr           INC   EB_LINEOFFL
001819r 2  D0 03              BNE   :+
00181Br 2  EE rr rr           INC   EB_LINEOFFH
00181Er 2  C9 0A        :     CMP   #$0A
001820r 2  D0 D1              BNE   @loop
001822r 2                     ; counted a newline
001822r 2  E6 rr              INC   EB_T0
001824r 2  D0 02              BNE   :+
001826r 2  E6 rr              INC   EB_T1
001828r 2               :     ; reached target? (newline count == target line)
001828r 2  A5 rr              LDA   EB_T0
00182Ar 2  CD rr rr           CMP   EB_SCRATCHL
00182Dr 2  D0 C4              BNE   @loop
00182Fr 2  A5 rr              LDA   EB_T1
001831r 2  CD rr rr           CMP   EB_SCRATCHH
001834r 2  D0 BD              BNE   @loop
001836r 2                     ; EB_LINEOFF now points just past the Nth newline = line start
001836r 2               @done:
001836r 2  60                 RTS
001837r 2               
001837r 2               ; editbuf_count_lines — total line count = (newlines in buffer)+1 -> EB_T0:EB_T1
001837r 2               editbuf_count_lines:
001837r 2  A9 01              LDA   #1
001839r 2  85 rr              STA   EB_T0
00183Br 2  64 rr              STZ   EB_T1
00183Dr 2  9C rr rr           STZ   EB_SCRATCHL
001840r 2  9C rr rr           STZ   EB_SCRATCHH
001843r 2               @loop:
001843r 2  AD rr rr           LDA   EB_SCRATCHL
001846r 2  CD rr rr           CMP   EDITBUF_LENL
001849r 2  AD rr rr           LDA   EB_SCRATCHH
00184Cr 2  ED rr rr           SBC   EDITBUF_LENH
00184Fr 2  B0 1B              BCS   @done
001851r 2  20 rr rr           JSR   editbuf_src_from_scratch
001854r 2  A0 00              LDY   #0
001856r 2  B1 rr              LDA   (EB_SRCL),Y
001858r 2  C9 0A              CMP   #$0A
00185Ar 2  D0 06              BNE   @next
00185Cr 2  E6 rr              INC   EB_T0
00185Er 2  D0 02              BNE   @next
001860r 2  E6 rr              INC   EB_T1
001862r 2               @next:
001862r 2  EE rr rr           INC   EB_SCRATCHL
001865r 2  D0 DC              BNE   @loop
001867r 2  EE rr rr           INC   EB_SCRATCHH
00186Ar 2  80 D7              BRA   @loop
00186Cr 2               @done:
00186Cr 2  60                 RTS
00186Dr 2               
00186Dr 2               ; =====================================================================
00186Dr 2               ; After-change: recompute, adjust scroll, re-render, place cursor.
00186Dr 2               ; =====================================================================
00186Dr 2               editbuf_after_change:
00186Dr 2  20 rr rr           JSR   editbuf_compute_linecol
001870r 2  20 rr rr           JSR   editbuf_adjust_scroll
001873r 2  20 rr rr           JSR   editbuf_render
001876r 2  60                 RTS
001877r 2               
001877r 2               ; editbuf_begin_move — start a cursor move: remember whether a selection was
001877r 2               ; active (so its highlight can be cleared on the next repaint), then drop it.
001877r 2               editbuf_begin_move:
001877r 2  AD rr rr           LDA   EDITBUF_SELACT
00187Ar 2  8D rr rr           STA   EB_PREVSEL
00187Dr 2  9C rr rr           STZ   EDITBUF_SELACT
001880r 2  60                 RTS
001881r 2               
001881r 2               ; editbuf_after_move — finish a cursor move. The buffer didn't change, so when
001881r 2               ; the scroll didn't move and no selection highlight needs clearing, just reposition
001881r 2               ; the hardware cursor — no body repaint (this is what made arrowing smear).
001881r 2               editbuf_after_move:
001881r 2  20 rr rr           JSR   editbuf_compute_linecol
001884r 2  AD rr rr           LDA   EB_TOPLINEL
001887r 2  8D rr rr           STA   EB_PREVTOPL
00188Ar 2  AD rr rr           LDA   EB_TOPLINEH
00188Dr 2  8D rr rr           STA   EB_PREVTOPH
001890r 2  AD rr rr           LDA   EB_LEFTCOL
001893r 2  8D rr rr           STA   EB_PREVLEFT
001896r 2  20 rr rr           JSR   editbuf_adjust_scroll
001899r 2  AD rr rr           LDA   EB_PREVSEL                ; had a selection -> repaint to clear it
00189Cr 2  D0 1B              BNE   @full
00189Er 2  AD rr rr           LDA   EB_TOPLINEL
0018A1r 2  CD rr rr           CMP   EB_PREVTOPL
0018A4r 2  D0 13              BNE   @full
0018A6r 2  AD rr rr           LDA   EB_TOPLINEH
0018A9r 2  CD rr rr           CMP   EB_PREVTOPH
0018ACr 2  D0 0B              BNE   @full
0018AEr 2  AD rr rr           LDA   EB_LEFTCOL
0018B1r 2  CD rr rr           CMP   EB_PREVLEFT
0018B4r 2  D0 03              BNE   @full
0018B6r 2  4C rr rr           JMP   editbuf_place_cursor
0018B9r 2               @full:
0018B9r 2  4C rr rr           JMP   editbuf_render
0018BCr 2               
0018BCr 2               ; editbuf_after_inline_edit — for edits confined to the cursor's line (printable
0018BCr 2               ; insert, mid-line delete/backspace). EB_EDITDELTA holds how many columns left of
0018BCr 2               ; the cursor the changed run begins (1 after an insert, 0 after a delete). When
0018BCr 2               ; the scroll didn't move, repaint ONLY the changed run [start..VIEW_COLS) of the
0018BCr 2               ; cursor's row; otherwise a full repaint.
0018BCr 2               editbuf_after_inline_edit:
0018BCr 2  20 rr rr           JSR   editbuf_compute_linecol
0018BFr 2  AD rr rr           LDA   EB_TOPLINEL
0018C2r 2  8D rr rr           STA   EB_PREVTOPL
0018C5r 2  AD rr rr           LDA   EB_TOPLINEH
0018C8r 2  8D rr rr           STA   EB_PREVTOPH
0018CBr 2  AD rr rr           LDA   EB_LEFTCOL
0018CEr 2  8D rr rr           STA   EB_PREVLEFT
0018D1r 2  20 rr rr           JSR   editbuf_adjust_scroll
0018D4r 2  AD rr rr           LDA   EB_TOPLINEL
0018D7r 2  CD rr rr           CMP   EB_PREVTOPL
0018DAr 2  D0 25              BNE   @full
0018DCr 2  AD rr rr           LDA   EB_TOPLINEH
0018DFr 2  CD rr rr           CMP   EB_PREVTOPH
0018E2r 2  D0 1D              BNE   @full
0018E4r 2  AD rr rr           LDA   EB_LEFTCOL
0018E7r 2  CD rr rr           CMP   EB_PREVLEFT
0018EAr 2  D0 15              BNE   @full
0018ECr 2                     ; first changed screen col = (curcol - EDITDELTA) - leftcol, clamped to 0.
0018ECr 2  38                 SEC
0018EDr 2  AD rr rr           LDA   EB_CURCOL
0018F0r 2  ED rr rr           SBC   EB_EDITDELTA
0018F3r 2  38                 SEC
0018F4r 2  ED rr rr           SBC   EB_LEFTCOL
0018F7r 2  B0 02              BCS   @setstart
0018F9r 2  A9 00              LDA   #0
0018FBr 2               @setstart:
0018FBr 2  8D rr rr           STA   EB_PAINTSTART
0018FEr 2  4C rr rr           JMP   editbuf_render_current_line
001901r 2               @full:
001901r 2  9C rr rr           STZ   EB_PAINTSTART
001904r 2  4C rr rr           JMP   editbuf_render
001907r 2               
001907r 2               ; editbuf_render_current_line — repaint the cursor's visible row from column
001907r 2               ; EB_PAINTSTART (caller sets it) to the right edge of the view.
001907r 2               editbuf_render_current_line:
001907r 2                     ; single-char edits clear the selection: render with an empty range.
001907r 2  9C rr rr           STZ   EB_SELSTARTL
00190Ar 2  9C rr rr           STZ   EB_SELSTARTH
00190Dr 2  9C rr rr           STZ   EB_SELENDL
001910r 2  9C rr rr           STZ   EB_SELENDH
001913r 2                     ; screen row = curline - topline (cursor is on-screen, so < VIEW_ROWS)
001913r 2  38                 SEC
001914r 2  AD rr rr           LDA   EB_CURLINEL
001917r 2  ED rr rr           SBC   EB_TOPLINEL
00191Ar 2  8D rr rr           STA   EB_ROW
00191Dr 2                     ; running offset = first byte of the current line
00191Dr 2  AD rr rr           LDA   EB_CURLINEL
001920r 2  8D rr rr           STA   EB_SCRATCHL
001923r 2  AD rr rr           LDA   EB_CURLINEH
001926r 2  8D rr rr           STA   EB_SCRATCHH
001929r 2  20 rr rr           JSR   editbuf_offset_of_line
00192Cr 2  AD rr rr           LDA   EB_LINEOFFL
00192Fr 2  8D rr rr           STA   EB_VISLINEL
001932r 2  AD rr rr           LDA   EB_LINEOFFH
001935r 2  8D rr rr           STA   EB_VISLINEH
001938r 2  20 rr rr           JSR   editbuf_render_row
00193Br 2  4C rr rr           JMP   editbuf_place_cursor
00193Er 2               
00193Er 2               ; editbuf_after_change_down — for edits that shift text vertically (newline,
00193Er 2               ; line-join delete/backspace): repaint from the changed line to the bottom of
00193Er 2               ; the view (a "local" repaint, not the whole screen), or full-repaint if the
00193Er 2               ; scroll moved.
00193Er 2               editbuf_after_change_down:
00193Er 2  20 rr rr           JSR   editbuf_compute_linecol
001941r 2  AD rr rr           LDA   EB_TOPLINEL
001944r 2  8D rr rr           STA   EB_PREVTOPL
001947r 2  AD rr rr           LDA   EB_TOPLINEH
00194Ar 2  8D rr rr           STA   EB_PREVTOPH
00194Dr 2  AD rr rr           LDA   EB_LEFTCOL
001950r 2  8D rr rr           STA   EB_PREVLEFT
001953r 2  20 rr rr           JSR   editbuf_adjust_scroll
001956r 2  AD rr rr           LDA   EB_TOPLINEL
001959r 2  CD rr rr           CMP   EB_PREVTOPL
00195Cr 2  D0 39              BNE   @full
00195Er 2  AD rr rr           LDA   EB_TOPLINEH
001961r 2  CD rr rr           CMP   EB_PREVTOPH
001964r 2  D0 31              BNE   @full
001966r 2  AD rr rr           LDA   EB_LEFTCOL
001969r 2  CD rr rr           CMP   EB_PREVLEFT
00196Cr 2  D0 29              BNE   @full
00196Er 2                     ; start row = (curline - 1) - topline, clamped to the top of the view.
00196Er 2                     ; curline-1 covers both the split line (newline) and the joined line
00196Er 2                     ; (delete); repainting one extra unchanged row above is harmless.
00196Er 2  AD rr rr           LDA   EB_CURLINEL
001971r 2  38                 SEC
001972r 2  E9 01              SBC   #1
001974r 2  8D rr rr           STA   EB_SCRATCHL
001977r 2  AD rr rr           LDA   EB_CURLINEH
00197Ar 2  E9 00              SBC   #0
00197Cr 2  8D rr rr           STA   EB_SCRATCHH
00197Fr 2  38                 SEC
001980r 2  AD rr rr           LDA   EB_SCRATCHL
001983r 2  ED rr rr           SBC   EB_TOPLINEL
001986r 2  8D rr rr           STA   EB_ROW
001989r 2  AD rr rr           LDA   EB_SCRATCHH
00198Cr 2  ED rr rr           SBC   EB_TOPLINEH
00198Fr 2  B0 03              BCS   @render                    ; (curline-1) >= topline -> EB_ROW valid
001991r 2  9C rr rr           STZ   EB_ROW                     ; clamp to the top visible row
001994r 2               @render:
001994r 2  4C rr rr           JMP   editbuf_render_from_row
001997r 2               @full:
001997r 2  4C rr rr           JMP   editbuf_render
00199Ar 2               
00199Ar 2               ; editbuf_render_from_row — repaint rows [EB_ROW .. VIEW_ROWS): the line at
00199Ar 2               ; (topline + EB_ROW) down to the bottom of the view.
00199Ar 2               editbuf_render_from_row:
00199Ar 2  9C rr rr           STZ   EB_SELSTARTL
00199Dr 2  9C rr rr           STZ   EB_SELSTARTH
0019A0r 2  9C rr rr           STZ   EB_SELENDL
0019A3r 2  9C rr rr           STZ   EB_SELENDH
0019A6r 2  18                 CLC
0019A7r 2  AD rr rr           LDA   EB_TOPLINEL
0019AAr 2  6D rr rr           ADC   EB_ROW
0019ADr 2  8D rr rr           STA   EB_SCRATCHL
0019B0r 2  AD rr rr           LDA   EB_TOPLINEH
0019B3r 2  69 00              ADC   #0
0019B5r 2  8D rr rr           STA   EB_SCRATCHH
0019B8r 2  20 rr rr           JSR   editbuf_offset_of_line
0019BBr 2  AD rr rr           LDA   EB_LINEOFFL
0019BEr 2  8D rr rr           STA   EB_VISLINEL
0019C1r 2  AD rr rr           LDA   EB_LINEOFFH
0019C4r 2  8D rr rr           STA   EB_VISLINEH
0019C7r 2  9C rr rr           STZ   EB_PAINTSTART
0019CAr 2               @loop:
0019CAr 2  AD rr rr           LDA   EB_ROW
0019CDr 2  C9 30              CMP   #EDITBUF_VIEW_ROWS
0019CFr 2  B0 08              BCS   @done
0019D1r 2  20 rr rr           JSR   editbuf_render_row
0019D4r 2  EE rr rr           INC   EB_ROW
0019D7r 2  80 F1              BRA   @loop
0019D9r 2               @done:
0019D9r 2  4C rr rr           JMP   editbuf_place_cursor
0019DCr 2               
0019DCr 2               editbuf_adjust_scroll:
0019DCr 2                     ; vertical: if curline < topline -> topline = curline
0019DCr 2  AD rr rr           LDA   EB_CURLINEL
0019DFr 2  CD rr rr           CMP   EB_TOPLINEL
0019E2r 2  AD rr rr           LDA   EB_CURLINEH
0019E5r 2  ED rr rr           SBC   EB_TOPLINEH
0019E8r 2  B0 0E              BCS   @check_bottom
0019EAr 2  AD rr rr           LDA   EB_CURLINEL
0019EDr 2  8D rr rr           STA   EB_TOPLINEL
0019F0r 2  AD rr rr           LDA   EB_CURLINEH
0019F3r 2  8D rr rr           STA   EB_TOPLINEH
0019F6r 2  80 2C              BRA   @horizontal
0019F8r 2               @check_bottom:
0019F8r 2                     ; if curline >= topline + VIEW_ROWS -> topline = curline - VIEW_ROWS + 1
0019F8r 2  18                 CLC
0019F9r 2  AD rr rr           LDA   EB_TOPLINEL
0019FCr 2  69 30              ADC   #EDITBUF_VIEW_ROWS
0019FEr 2  85 rr              STA   EB_T0
001A00r 2  AD rr rr           LDA   EB_TOPLINEH
001A03r 2  69 00              ADC   #0
001A05r 2  85 rr              STA   EB_T1
001A07r 2  AD rr rr           LDA   EB_CURLINEL
001A0Ar 2  C5 rr              CMP   EB_T0
001A0Cr 2  AD rr rr           LDA   EB_CURLINEH
001A0Fr 2  E5 rr              SBC   EB_T1
001A11r 2  90 11              BCC   @horizontal
001A13r 2                     ; topline = curline - (VIEW_ROWS-1)
001A13r 2  38                 SEC
001A14r 2  AD rr rr           LDA   EB_CURLINEL
001A17r 2  E9 2F              SBC   #EDITBUF_VIEW_ROWS-1
001A19r 2  8D rr rr           STA   EB_TOPLINEL
001A1Cr 2  AD rr rr           LDA   EB_CURLINEH
001A1Fr 2  E9 00              SBC   #0
001A21r 2  8D rr rr           STA   EB_TOPLINEH
001A24r 2               @horizontal:
001A24r 2                     ; if curcol < leftcol -> leftcol = curcol
001A24r 2  AD rr rr           LDA   EB_CURCOL
001A27r 2  CD rr rr           CMP   EB_LEFTCOL
001A2Ar 2  B0 04              BCS   @right
001A2Cr 2  8D rr rr           STA   EB_LEFTCOL
001A2Fr 2  60                 RTS
001A30r 2               @right:
001A30r 2                     ; if curcol >= leftcol + VIEW_COLS -> leftcol = curcol - VIEW_COLS + 1
001A30r 2  AD rr rr           LDA   EB_LEFTCOL
001A33r 2  18                 CLC
001A34r 2  69 50              ADC   #EDITBUF_VIEW_COLS
001A36r 2  85 rr              STA   EB_T0
001A38r 2  AD rr rr           LDA   EB_CURCOL
001A3Br 2  C5 rr              CMP   EB_T0
001A3Dr 2  90 09              BCC   @done
001A3Fr 2  AD rr rr           LDA   EB_CURCOL
001A42r 2  38                 SEC
001A43r 2  E9 4F              SBC   #EDITBUF_VIEW_COLS-1
001A45r 2  8D rr rr           STA   EB_LEFTCOL
001A48r 2               @done:
001A48r 2  60                 RTS
001A49r 2               
001A49r 2               ; =====================================================================
001A49r 2               ; Render the visible text into the body region.
001A49r 2               ; =====================================================================
001A49r 2               editbuf_render:
001A49r 2                     ; normalize selection once for cell tests
001A49r 2  AD rr rr           LDA   EDITBUF_SELACT
001A4Cr 2  F0 05              BEQ   @nosel
001A4Er 2  20 rr rr           JSR   editbuf_normalize_selection
001A51r 2  80 0C              BRA   @start
001A53r 2               @nosel:
001A53r 2                     ; empty selection range
001A53r 2  9C rr rr           STZ   EB_SELSTARTL
001A56r 2  9C rr rr           STZ   EB_SELSTARTH
001A59r 2  9C rr rr           STZ   EB_SELENDL
001A5Cr 2  9C rr rr           STZ   EB_SELENDH
001A5Fr 2               @start:
001A5Fr 2                     ; line being rendered = topline ; its offset:
001A5Fr 2  AD rr rr           LDA   EB_TOPLINEL
001A62r 2  8D rr rr           STA   EB_SCRATCHL
001A65r 2  AD rr rr           LDA   EB_TOPLINEH
001A68r 2  8D rr rr           STA   EB_SCRATCHH
001A6Br 2  20 rr rr           JSR   editbuf_offset_of_line
001A6Er 2  AD rr rr           LDA   EB_LINEOFFL
001A71r 2  8D rr rr           STA   EB_VISLINEL           ; reuse EB_VISLINE as running offset
001A74r 2  AD rr rr           LDA   EB_LINEOFFH
001A77r 2  8D rr rr           STA   EB_VISLINEH
001A7Ar 2  9C rr rr           STZ   EB_ROW
001A7Dr 2  9C rr rr           STZ   EB_PAINTSTART
001A80r 2               @rowloop:
001A80r 2  AD rr rr           LDA   EB_ROW
001A83r 2  C9 30              CMP   #EDITBUF_VIEW_ROWS
001A85r 2  B0 08              BCS   @donerows
001A87r 2  20 rr rr           JSR   editbuf_render_row
001A8Ar 2  EE rr rr           INC   EB_ROW
001A8Dr 2  80 F1              BRA   @rowloop
001A8Fr 2               @donerows:
001A8Fr 2  4C rr rr           JMP   editbuf_place_cursor
001A92r 2               
001A92r 2               ; editbuf_render_row — render screen row EB_ROW, painting columns
001A92r 2               ; [EB_PAINTSTART .. VIEW_COLS) from the document. EB_VISLINE = offset of this
001A92r 2               ; line's first byte; on exit it points to the next line's first byte.
001A92r 2               ;
001A92r 2               ; Cells are written through the VGC direct screen window one plane at a time:
001A92r 2               ; the row's base cell offset is computed ONCE (no per-cell multiply, no per-cell
001A92r 2               ; cursor sync the way vtext_put_char does), the plane is selected via $B1A0, and
001A92r 2               ; each pass walks a plain (zp),Y store pointer through the window ($A200+off) —
001A92r 2               ; one store per cell instead of the VRAM port's address+data handshake.
001A92r 2               editbuf_render_row:
001A92r 2                     ; Determine line length (chars before \n or buffer end), and fill colors.
001A92r 2  20 rr rr           JSR   editbuf_measure_line   ; EB_LINELEN set; HL colors filled
001A95r 2                     ; EB_CELL = plane offset of the first painted cell:
001A95r 2                     ;   (VIEW_TOP + EB_ROW) * 80 + VIEW_LEFT + EB_PAINTSTART
001A95r 2  A9 01              LDA   #EDITBUF_VIEW_TOP
001A97r 2  18                 CLC
001A98r 2  6D rr rr           ADC   EB_ROW
001A9Br 2  85 rr              STA   EB_T0                 ; absolute screen row (<= 47)
001A9Dr 2  0A                 ASL
001A9Er 2  0A                 ASL
001A9Fr 2  18                 CLC
001AA0r 2  65 rr              ADC   EB_T0                 ; row * 5 (<= 235, fits 8 bits)
001AA2r 2  8D rr rr           STA   EB_CELLL
001AA5r 2  9C rr rr           STZ   EB_CELLH
001AA8r 2  0E rr rr           ASL   EB_CELLL
001AABr 2  2E rr rr           ROL   EB_CELLH
001AAEr 2  0E rr rr           ASL   EB_CELLL
001AB1r 2  2E rr rr           ROL   EB_CELLH
001AB4r 2  0E rr rr           ASL   EB_CELLL
001AB7r 2  2E rr rr           ROL   EB_CELLH
001ABAr 2  0E rr rr           ASL   EB_CELLL
001ABDr 2  2E rr rr           ROL   EB_CELLH              ; row * 80
001AC0r 2  A9 00              LDA   #EDITBUF_VIEW_LEFT
001AC2r 2  18                 CLC
001AC3r 2  6D rr rr           ADC   EB_PAINTSTART
001AC6r 2  18                 CLC
001AC7r 2  6D rr rr           ADC   EB_CELLL
001ACAr 2  8D rr rr           STA   EB_CELLL
001ACDr 2  90 03              BCC   :+
001ACFr 2  EE rr rr           INC   EB_CELLH
001AD2r 2               :
001AD2r 2                     ; ---- char plane ----
001AD2r 2  A9 00              LDA   #VGC_SCREENWIN_CHAR
001AD4r 2  20 rr rr           JSR   editbuf_win_begin      ; select window plane, point run ptr at EB_CELL
001AD7r 2  AD rr rr           LDA   EB_PAINTSTART
001ADAr 2  8D rr rr           STA   EB_COL
001ADDr 2               @charloop:
001ADDr 2  AD rr rr           LDA   EB_COL
001AE0r 2  C9 50              CMP   #EDITBUF_VIEW_COLS
001AE2r 2  B0 3C              BCS   @colorpass
001AE4r 2  AD rr rr           LDA   EB_LEFTCOL
001AE7r 2  18                 CLC
001AE8r 2  6D rr rr           ADC   EB_COL
001AEBr 2  85 rr              STA   EB_T0                 ; src col
001AEDr 2  CD rr rr           CMP   EB_LINELEN
001AF0r 2  B0 24              BCS   @charblank
001AF2r 2                     ; char = BUF[EB_VISLINE + srccol]
001AF2r 2  AD rr rr           LDA   EB_VISLINEL
001AF5r 2  18                 CLC
001AF6r 2  65 rr              ADC   EB_T0
001AF8r 2  85 rr              STA   EB_PL
001AFAr 2  AD rr rr           LDA   EB_VISLINEH
001AFDr 2  69 00              ADC   #0
001AFFr 2  85 rr              STA   EB_PH
001B01r 2  AD rr rr           LDA   EDITBUF_BUFL
001B04r 2  18                 CLC
001B05r 2  65 rr              ADC   EB_PL
001B07r 2  85 rr              STA   EB_PL
001B09r 2  AD rr rr           LDA   EDITBUF_BUFH
001B0Cr 2  65 rr              ADC   EB_PH
001B0Er 2  85 rr              STA   EB_PH
001B10r 2  A0 00              LDY   #0
001B12r 2  B1 rr              LDA   (EB_PL),Y
001B14r 2  80 02              BRA   @charput
001B16r 2               @charblank:
001B16r 2  A9 20              LDA   #' '
001B18r 2               @charput:
001B18r 2  20 rr rr           JSR   editbuf_win_put        ; store A at the window cell, advance run ptr
001B1Br 2  EE rr rr           INC   EB_COL
001B1Er 2  80 BD              BRA   @charloop
001B20r 2               
001B20r 2                     ; ---- color plane ----
001B20r 2               @colorpass:
001B20r 2  A9 01              LDA   #VGC_SCREENWIN_COLOR
001B22r 2  20 rr rr           JSR   editbuf_win_begin
001B25r 2  AD rr rr           LDA   EB_PAINTSTART
001B28r 2  8D rr rr           STA   EB_COL
001B2Br 2               @colorloop:
001B2Br 2  AD rr rr           LDA   EB_COL
001B2Er 2  C9 50              CMP   #EDITBUF_VIEW_COLS
001B30r 2  B0 37              BCS   @attrpass
001B32r 2  AD rr rr           LDA   EB_LEFTCOL
001B35r 2  18                 CLC
001B36r 2  6D rr rr           ADC   EB_COL
001B39r 2  85 rr              STA   EB_T0                 ; src col
001B3Br 2  CD rr rr           CMP   EB_LINELEN
001B3Er 2  B0 1F              BCS   @colorblank
001B40r 2                     ; abs offset = EB_VISLINE + srccol -> EB_SRC (for selection test)
001B40r 2  AD rr rr           LDA   EB_VISLINEL
001B43r 2  18                 CLC
001B44r 2  65 rr              ADC   EB_T0
001B46r 2  85 rr              STA   EB_SRCL
001B48r 2  AD rr rr           LDA   EB_VISLINEH
001B4Br 2  69 00              ADC   #0
001B4Dr 2  85 rr              STA   EB_SRCH
001B4Fr 2  20 rr rr           JSR   editbuf_cell_in_selection   ; carry set if in selection
001B52r 2  90 04              BCC   @colornormal
001B54r 2  A9 1F              LDA   #EDITBUF_COLOR_SEL
001B56r 2  80 09              BRA   @colorput
001B58r 2               @colornormal:
001B58r 2  A6 rr              LDX   EB_T0
001B5Ar 2  BD rr rr           LDA   EDITBUF_HL_COLORS,X
001B5Dr 2  80 02              BRA   @colorput
001B5Fr 2               @colorblank:
001B5Fr 2  A9 01              LDA   #EDITBUF_COLOR_TEXT
001B61r 2               @colorput:
001B61r 2  20 rr rr           JSR   editbuf_win_put
001B64r 2  EE rr rr           INC   EB_COL
001B67r 2  80 C2              BRA   @colorloop
001B69r 2               
001B69r 2                     ; ---- attribute plane (always 0 in the body) ----
001B69r 2               @attrpass:
001B69r 2  A9 02              LDA   #VGC_SCREENWIN_ATTR
001B6Br 2  20 rr rr           JSR   editbuf_win_begin
001B6Er 2  AD rr rr           LDA   EB_PAINTSTART
001B71r 2  8D rr rr           STA   EB_COL
001B74r 2               @attrloop:
001B74r 2  AD rr rr           LDA   EB_COL
001B77r 2  C9 50              CMP   #EDITBUF_VIEW_COLS
001B79r 2  B0 0A              BCS   @done
001B7Br 2  A9 00              LDA   #0
001B7Dr 2  20 rr rr           JSR   editbuf_win_put
001B80r 2  EE rr rr           INC   EB_COL
001B83r 2  80 EF              BRA   @attrloop
001B85r 2               @done:
001B85r 2                     ; advance EB_VISLINE to next line: skip to and over the \n (if any)
001B85r 2  20 rr rr           JSR   editbuf_advance_to_next_line
001B88r 2  60                 RTS
001B89r 2               
001B89r 2               ; editbuf_win_begin — select window plane A ($B1A0: 0=char/1=color/2=attr) and
001B89r 2               ; seed the zero-page run pointer EB_RUN at the window address of the row's first
001B89r 2               ; painted cell (VGC_SCREENWIN + EB_CELL). editbuf_win_put then writes one cell.
001B89r 2               editbuf_win_begin:
001B89r 2  8D A0 B1           STA   VGC_SCREENWIN_PLANE
001B8Cr 2  AD rr rr           LDA   EB_CELLL
001B8Fr 2  18                 CLC
001B90r 2  69 00              ADC   #<VGC_SCREENWIN
001B92r 2  85 rr              STA   EB_RUNL
001B94r 2  AD rr rr           LDA   EB_CELLH
001B97r 2  69 A2              ADC   #>VGC_SCREENWIN
001B99r 2  85 rr              STA   EB_RUNH
001B9Br 2  60                 RTS
001B9Cr 2               
001B9Cr 2               ; editbuf_win_put — store A at the window cell EB_RUN points to (a plain store,
001B9Cr 2               ; no port handshake), then advance EB_RUN by one. A is preserved.
001B9Cr 2               editbuf_win_put:
001B9Cr 2  A0 00              LDY   #0
001B9Er 2  91 rr              STA   (EB_RUNL),Y
001BA0r 2  E6 rr              INC   EB_RUNL
001BA2r 2  D0 02              BNE   :+
001BA4r 2  E6 rr              INC   EB_RUNH
001BA6r 2  60           :     RTS
001BA7r 2               
001BA7r 2               ; editbuf_cell_in_selection — EB_SRC = absolute offset of cell.
001BA7r 2               ;   carry set if SELSTART <= off < SELEND (and selection active).
001BA7r 2               editbuf_cell_in_selection:
001BA7r 2  AD rr rr           LDA   EDITBUF_SELACT
001BAAr 2  D0 02              BNE   :+
001BACr 2  18                 CLC
001BADr 2  60                 RTS
001BAEr 2               :     ; off >= selstart ?
001BAEr 2  A5 rr              LDA   EB_SRCL
001BB0r 2  CD rr rr           CMP   EB_SELSTARTL
001BB3r 2  A5 rr              LDA   EB_SRCH
001BB5r 2  ED rr rr           SBC   EB_SELSTARTH
001BB8r 2  90 0C              BCC   @no                   ; off < start
001BBAr 2                     ; off < selend ?
001BBAr 2  A5 rr              LDA   EB_SRCL
001BBCr 2  CD rr rr           CMP   EB_SELENDL
001BBFr 2  A5 rr              LDA   EB_SRCH
001BC1r 2  ED rr rr           SBC   EB_SELENDH
001BC4r 2  90 02              BCC   @yes                  ; off < end
001BC6r 2               @no:
001BC6r 2  18                 CLC
001BC7r 2  60                 RTS
001BC8r 2               @yes:
001BC8r 2  38                 SEC
001BC9r 2  60                 RTS
001BCAr 2               
001BCAr 2               ; editbuf_measure_line — measure current line (offset EB_VISLINE): set EB_LINELEN
001BCAr 2               ;   to chars before \n (clamped 80), pre-fill HL_COLORS with default, then call
001BCAr 2               ;   the HILITE hook.
001BCAr 2               editbuf_measure_line:
001BCAr 2                     ; pre-fill colors with default
001BCAr 2  A2 4F              LDX   #79
001BCCr 2  A9 01              LDA   #EDITBUF_COLOR_TEXT
001BCEr 2  9D rr rr     :     STA   EDITBUF_HL_COLORS,X
001BD1r 2  CA                 DEX
001BD2r 2  10 FA              BPL   :-
001BD4r 2                     ; scan line length
001BD4r 2  AD rr rr           LDA   EB_VISLINEL
001BD7r 2  8D rr rr           STA   EB_SCRATCHL
001BDAr 2  AD rr rr           LDA   EB_VISLINEH
001BDDr 2  8D rr rr           STA   EB_SCRATCHH
001BE0r 2  A2 00              LDX   #0
001BE2r 2               @scan:
001BE2r 2                     ; offset >= len ?
001BE2r 2  AD rr rr           LDA   EB_SCRATCHL
001BE5r 2  CD rr rr           CMP   EDITBUF_LENL
001BE8r 2  AD rr rr           LDA   EB_SCRATCHH
001BEBr 2  ED rr rr           SBC   EDITBUF_LENH
001BEEr 2  B0 1A              BCS   @done
001BF0r 2  20 rr rr           JSR   editbuf_src_from_scratch
001BF3r 2  A0 00              LDY   #0
001BF5r 2  B1 rr              LDA   (EB_SRCL),Y
001BF7r 2  C9 0A              CMP   #$0A
001BF9r 2  F0 0F              BEQ   @done
001BFBr 2  E8                 INX
001BFCr 2  E0 50              CPX   #80
001BFEr 2  B0 0A              BCS   @done
001C00r 2  EE rr rr           INC   EB_SCRATCHL
001C03r 2  D0 DD              BNE   @scan
001C05r 2  EE rr rr           INC   EB_SCRATCHH
001C08r 2  80 D8              BRA   @scan
001C0Ar 2               @done:
001C0Ar 2  8E rr rr           STX   EB_LINELEN
001C0Dr 2                     ; set HL hook inputs
001C0Dr 2  AD rr rr           LDA   EDITBUF_BUFL
001C10r 2  18                 CLC
001C11r 2  6D rr rr           ADC   EB_VISLINEL
001C14r 2  85 rr              STA   EDITBUF_HL_PTR
001C16r 2  AD rr rr           LDA   EDITBUF_BUFH
001C19r 2  6D rr rr           ADC   EB_VISLINEH
001C1Cr 2  85 rr              STA   EDITBUF_HL_PTR+1
001C1Er 2  AD rr rr           LDA   EB_LINELEN
001C21r 2  8D rr rr           STA   EDITBUF_HL_LEN
001C24r 2  4C rr rr           JMP   editbuf_call_hilite
001C27r 2               
001C27r 2               ; editbuf_advance_to_next_line — move EB_VISLINE past the current line's \n.
001C27r 2               editbuf_advance_to_next_line:
001C27r 2               @scan:
001C27r 2  AD rr rr           LDA   EB_VISLINEL
001C2Ar 2  CD rr rr           CMP   EDITBUF_LENL
001C2Dr 2  AD rr rr           LDA   EB_VISLINEH
001C30r 2  ED rr rr           SBC   EDITBUF_LENH
001C33r 2  B0 1F              BCS   @done                 ; at end
001C35r 2  AD rr rr           LDA   EB_VISLINEL
001C38r 2  8D rr rr           STA   EB_SCRATCHL
001C3Br 2  AD rr rr           LDA   EB_VISLINEH
001C3Er 2  8D rr rr           STA   EB_SCRATCHH
001C41r 2  20 rr rr           JSR   editbuf_src_from_scratch
001C44r 2  A0 00              LDY   #0
001C46r 2  B1 rr              LDA   (EB_SRCL),Y
001C48r 2                     ; advance
001C48r 2  EE rr rr           INC   EB_VISLINEL
001C4Br 2  D0 03              BNE   :+
001C4Dr 2  EE rr rr           INC   EB_VISLINEH
001C50r 2  C9 0A        :     CMP   #$0A
001C52r 2  D0 D3              BNE   @scan
001C54r 2               @done:
001C54r 2  60                 RTS
001C55r 2               
001C55r 2               ; editbuf_place_cursor — set hw cursor at the on-screen cursor position.
001C55r 2               editbuf_place_cursor:
001C55r 2                     ; screen x = VIEW_LEFT + (curcol - leftcol)
001C55r 2  AD rr rr           LDA   EB_CURCOL
001C58r 2  38                 SEC
001C59r 2  ED rr rr           SBC   EB_LEFTCOL
001C5Cr 2  18                 CLC
001C5Dr 2  69 00              ADC   #EDITBUF_VIEW_LEFT
001C5Fr 2  8D 03 A0           STA   VGC_CURSX
001C62r 2                     ; screen y = VIEW_TOP + (curline - topline)
001C62r 2  38                 SEC
001C63r 2  AD rr rr           LDA   EB_CURLINEL
001C66r 2  ED rr rr           SBC   EB_TOPLINEL
001C69r 2                     ; (assume within view; high bytes equal after scroll adjust)
001C69r 2  18                 CLC
001C6Ar 2  69 01              ADC   #EDITBUF_VIEW_TOP
001C6Cr 2  8D 04 A0           STA   VGC_CURSY
001C6Fr 2  A9 01              LDA   #1
001C71r 2  8D 0A A0           STA   VGC_CURSEN
001C74r 2  60                 RTS
001C75r 2               
001C75r 2               ; =====================================================================
001C75r 2               ; Dirty handling
001C75r 2               ; =====================================================================
001C75r 2               editbuf_mark_dirty:
001C75r 2  AD rr rr           LDA   EDITUI_DIRTY
001C78r 2  D0 08              BNE   @done
001C7Ar 2  A9 01              LDA   #1
001C7Cr 2  8D rr rr           STA   EDITUI_DIRTY
001C7Fr 2  20 rr rr           JSR   editui_refresh_dirty
001C82r 2               @done:
001C82r 2  60                 RTS
001C83r 2               
001C83r 2               ; =====================================================================
001C83r 2               ; Save / quit
001C83r 2               ; =====================================================================
001C83r 2               editbuf_do_save:
001C83r 2  20 rr rr           JSR   editbuf_call_save        ; A = status
001C86r 2  C9 00              CMP   #EDITBUF_SAVE_OK
001C88r 2  D0 06              BNE   @notok
001C8Ar 2  9C rr rr           STZ   EDITUI_DIRTY
001C8Dr 2  20 rr rr           JSR   editui_refresh_dirty
001C90r 2               @notok:
001C90r 2  20 rr rr           JSR   editbuf_apply_status
001C93r 2  20 rr rr           JSR   editui_draw_status
001C96r 2  4C rr rr           JMP   editbuf_place_cursor
001C99r 2               
001C99r 2               ; editbuf_do_quit — returns carry set to exit the editor, clear to stay.
001C99r 2               editbuf_do_quit:
001C99r 2  AD rr rr           LDA   EDITUI_DIRTY
001C9Cr 2  D0 07              BNE   @dirty
001C9Er 2  A9 00              LDA   #EDITBUF_EXIT_QUIT
001CA0r 2  8D rr rr           STA   EDITBUF_RESULT
001CA3r 2  38                 SEC
001CA4r 2  60                 RTS
001CA5r 2               @dirty:
001CA5r 2  20 rr rr           JSR   editbuf_dialog3          ; A = 0 exit / 1 save / 2 cancel
001CA8r 2  C9 02              CMP   #EDITBUF_DLG_CANCEL
001CAAr 2  F0 2A              BEQ   @stay
001CACr 2  C9 01              CMP   #EDITBUF_DLG_SAVE
001CAEr 2  F0 07              BEQ   @savefirst
001CB0r 2                     ; exit anyway
001CB0r 2  A9 02              LDA   #EDITBUF_EXIT_DISCARD
001CB2r 2  8D rr rr           STA   EDITBUF_RESULT
001CB5r 2  38                 SEC
001CB6r 2  60                 RTS
001CB7r 2               @savefirst:
001CB7r 2  20 rr rr           JSR   editbuf_call_save
001CBAr 2  C9 00              CMP   #EDITBUF_SAVE_OK
001CBCr 2  D0 0A              BNE   @save_failed
001CBEr 2  9C rr rr           STZ   EDITUI_DIRTY
001CC1r 2  A9 01              LDA   #EDITBUF_EXIT_SAVED
001CC3r 2  8D rr rr           STA   EDITBUF_RESULT
001CC6r 2  38                 SEC
001CC7r 2  60                 RTS
001CC8r 2               @save_failed:
001CC8r 2                     ; stay in editor showing the host's status message
001CC8r 2  20 rr rr           JSR   editbuf_redraw_all
001CCBr 2  20 rr rr           JSR   editbuf_apply_status
001CCEr 2  20 rr rr           JSR   editui_draw_status
001CD1r 2  20 rr rr           JSR   editbuf_place_cursor
001CD4r 2  18                 CLC
001CD5r 2  60                 RTS
001CD6r 2               @stay:
001CD6r 2  20 rr rr           JSR   editbuf_redraw_all
001CD9r 2  18                 CLC
001CDAr 2  60                 RTS
001CDBr 2               
001CDBr 2               ; editbuf_redraw_all — full repaint after a dialog (chrome + body + cursor).
001CDBr 2               editbuf_redraw_all:
001CDBr 2  20 rr rr           JSR   editui_draw_shell
001CDEr 2  4C rr rr           JMP   editbuf_render
001CE1r 2               
001CE1r 2               ; =====================================================================
001CE1r 2               ; Three-choice modal dialog (restore-under). Returns A = 0/1/2.
001CE1r 2               ; =====================================================================
001CE1r 2               EB_DLG_X     = 15
001CE1r 2               EB_DLG_Y     = 20
001CE1r 2               EB_DLG_W     = 50
001CE1r 2               EB_DLG_H     = 9
001CE1r 2               
001CE1r 2               editbuf_dialog3:
001CE1r 2  9C rr rr           STZ   EB_DLGSEL
001CE4r 2                     ; set save-under region to the dialog rect and capture it
001CE4r 2  A9 0F              LDA   #EB_DLG_X
001CE6r 2  8D rr rr           STA   EDITUI_MENU_SAVE_X
001CE9r 2  A9 14              LDA   #EB_DLG_Y
001CEBr 2  8D rr rr           STA   EDITUI_MENU_SAVE_Y
001CEEr 2  A9 32              LDA   #EB_DLG_W
001CF0r 2  8D rr rr           STA   EDITUI_MENU_SAVE_W
001CF3r 2  A9 09              LDA   #EB_DLG_H
001CF5r 2  8D rr rr           STA   EDITUI_MENU_SAVE_H
001CF8r 2  20 rr rr           JSR   editui_save_under
001CFBr 2                     ; draw dialog frame
001CFBr 2  A9 0F              LDA   #EB_DLG_X
001CFDr 2  8D rr rr           STA   EDITUI_BOXX
001D00r 2  A9 14              LDA   #EB_DLG_Y
001D02r 2  8D rr rr           STA   EDITUI_BOXY
001D05r 2  A9 32              LDA   #EB_DLG_W
001D07r 2  8D rr rr           STA   EDITUI_BOXW
001D0Ar 2  A9 09              LDA   #EB_DLG_H
001D0Cr 2  8D rr rr           STA   EDITUI_BOXH
001D0Fr 2  A9 01              LDA   #EDITUI_BOX_DOUBLE
001D11r 2  8D rr rr           STA   EDITUI_BOX_STYLE
001D14r 2  A9 rr              LDA   #<editbuf_dlg_title
001D16r 2  8D rr rr           STA   EDITUI_BOX_TITLEL
001D19r 2  A9 rr              LDA   #>editbuf_dlg_title
001D1Br 2  8D rr rr           STA   EDITUI_BOX_TITLEH
001D1Er 2  20 rr rr           JSR   editui_draw_box
001D21r 2                     ; clear the dialog interior (box vars still hold the dialog rect)
001D21r 2  20 rr rr           JSR   editui_select_box_body
001D24r 2  A9 0F              LDA   #EDITUI_COLOR_PANEL
001D26r 2  8D rr rr           STA   VTEXT_COLOR
001D29r 2  9C rr rr           STZ   VTEXT_ATTR
001D2Cr 2  A9 20              LDA   #' '
001D2Er 2  8D rr rr           STA   VTEXT_CHAR
001D31r 2  20 rr rr           JSR   vtext_clear_region
001D34r 2                     ; message line
001D34r 2  A9 rr              LDA   #<editbuf_dlg_msg
001D36r 2  8D rr rr           STA   EDITUI_PRINTL
001D39r 2  A9 rr              LDA   #>editbuf_dlg_msg
001D3Br 2  8D rr rr           STA   EDITUI_PRINTH
001D3Er 2  A9 12              LDA   #EB_DLG_X+3
001D40r 2  8D rr rr           STA   EDITUI_PRINTX
001D43r 2  A9 16              LDA   #EB_DLG_Y+2
001D45r 2  8D rr rr           STA   EDITUI_PRINTY
001D48r 2  A9 01              LDA   #EDITUI_COLOR_TITLE
001D4Ar 2  8D rr rr           STA   VTEXT_COLOR
001D4Dr 2  20 rr rr           JSR   editui_print_ptr
001D50r 2  20 rr rr           JSR   editbuf_dialog_draw_buttons
001D53r 2               @wait:
001D53r 2  AD 0F A0           LDA   VGC_CHARIN
001D56r 2  F0 FB              BEQ   @wait
001D58r 2  C9 1C              CMP   #EDITUI_KEY_LEFT
001D5Ar 2  F0 31              BEQ   @left
001D5Cr 2  C9 1D              CMP   #EDITUI_KEY_RIGHT
001D5Er 2  F0 3D              BEQ   @right
001D60r 2  C9 09              CMP   #EDITUI_KEY_TAB
001D62r 2  F0 39              BEQ   @right
001D64r 2  C9 0D              CMP   #EDITUI_KEY_ENTER
001D66r 2  F0 4C              BEQ   @choose
001D68r 2  C9 1B              CMP   #EDITUI_KEY_ESC
001D6Ar 2  F0 43              BEQ   @cancel
001D6Cr 2                     ; hotkeys: e/s/c (and upper)
001D6Cr 2  09 20              ORA   #$20
001D6Er 2  C9 65              CMP   #'e'
001D70r 2  D0 05              BNE   :+
001D72r 2  9C rr rr           STZ   EB_DLGSEL
001D75r 2  80 3D              BRA   @choose
001D77r 2  C9 73        :     CMP   #'s'
001D79r 2  D0 07              BNE   :+
001D7Br 2  A9 01              LDA   #1
001D7Dr 2  8D rr rr           STA   EB_DLGSEL
001D80r 2  80 32              BRA   @choose
001D82r 2  C9 63        :     CMP   #'c'
001D84r 2  D0 CD              BNE   @wait
001D86r 2  A9 02              LDA   #2
001D88r 2  8D rr rr           STA   EB_DLGSEL
001D8Br 2  80 27              BRA   @choose
001D8Dr 2               @left:
001D8Dr 2  AD rr rr           LDA   EB_DLGSEL
001D90r 2  D0 02              BNE   :+
001D92r 2  A9 03              LDA   #3
001D94r 2  3A           :     DEC   A
001D95r 2  8D rr rr           STA   EB_DLGSEL
001D98r 2  20 rr rr           JSR   editbuf_dialog_draw_buttons
001D9Br 2  80 B6              BRA   @wait
001D9Dr 2               @right:
001D9Dr 2  AD rr rr           LDA   EB_DLGSEL
001DA0r 2  1A                 INC   A
001DA1r 2  C9 03              CMP   #3
001DA3r 2  90 02              BCC   :+
001DA5r 2  A9 00              LDA   #0
001DA7r 2  8D rr rr     :     STA   EB_DLGSEL
001DAAr 2  20 rr rr           JSR   editbuf_dialog_draw_buttons
001DADr 2  80 A4              BRA   @wait
001DAFr 2               @cancel:
001DAFr 2  A9 02              LDA   #2
001DB1r 2  8D rr rr           STA   EB_DLGSEL
001DB4r 2               @choose:
001DB4r 2  20 rr rr           JSR   editui_restore_under
001DB7r 2  AD rr rr           LDA   EB_DLGSEL
001DBAr 2  60                 RTS
001DBBr 2               
001DBBr 2               ; Draw the three buttons, highlighting EB_DLGSEL.
001DBBr 2               editbuf_dialog_draw_buttons:
001DBBr 2  A9 00              LDA   #0
001DBDr 2  85 rr              STA   EB_T0                 ; button index
001DBFr 2  A9 rr              LDA   #<editbuf_dlg_btn0
001DC1r 2  85 rr              STA   EB_PL
001DC3r 2  A9 rr              LDA   #>editbuf_dlg_btn0
001DC5r 2  85 rr              STA   EB_PH
001DC7r 2               @draw:
001DC7r 2                     ; X position per button
001DC7r 2  A6 rr              LDX   EB_T0
001DC9r 2  BD rr rr           LDA   editbuf_dlg_btn_x,X
001DCCr 2  8D rr rr           STA   EDITUI_PRINTX
001DCFr 2  A9 19              LDA   #EB_DLG_Y+5
001DD1r 2  8D rr rr           STA   EDITUI_PRINTY
001DD4r 2                     ; color: selected?
001DD4r 2  A5 rr              LDA   EB_T0
001DD6r 2  CD rr rr           CMP   EB_DLGSEL
001DD9r 2  D0 04              BNE   @normal
001DDBr 2  A9 1F              LDA   #EDITUI_COLOR_MENU_SEL
001DDDr 2  80 02              BRA   @setc
001DDFr 2               @normal:
001DDFr 2  A9 0C              LDA   #EDITUI_COLOR_DIM
001DE1r 2               @setc:
001DE1r 2  8D rr rr           STA   VTEXT_COLOR
001DE4r 2                     ; print label (split low/high byte pointer tables, indexed by button #)
001DE4r 2  A6 rr              LDX   EB_T0
001DE6r 2  BD rr rr           LDA   editbuf_dlg_btn_lo,X
001DE9r 2  8D rr rr           STA   EDITUI_PRINTL
001DECr 2  BD rr rr           LDA   editbuf_dlg_btn_hi,X
001DEFr 2  8D rr rr           STA   EDITUI_PRINTH
001DF2r 2  20 rr rr           JSR   editui_print_ptr
001DF5r 2  E6 rr              INC   EB_T0
001DF7r 2  A5 rr              LDA   EB_T0
001DF9r 2  C9 03              CMP   #3
001DFBr 2  90 CA              BCC   @draw
001DFDr 2  60                 RTS
001DFEr 2               
001DFEr 2               ; =====================================================================
001DFEr 2               ; Hook invocation (indirect JSR via vector; default no-ops)
001DFEr 2               ; =====================================================================
001DFEr 2               ; editbuf_init_vectors — default any unset hook vector to a no-op.
001DFEr 2               editbuf_init_vectors:
001DFEr 2  AD rr rr           LDA   EDITBUF_SAVE_VECL
001E01r 2  0D rr rr           ORA   EDITBUF_SAVE_VECH
001E04r 2  D0 0A              BNE   :+
