0015E1r 3               ; @label VTEXT.PUTS
0015E1r 3               ; @kind routine
0015E1r 3               ; @symbol vtext_puts
0015E1r 3               ; @summary Print a zero-terminated string into the current VTEXT region.
0015E1r 3               ; @in A/Y: Pointer to the zero-terminated string, low byte in A and high byte in Y.
0015E1r 3               ; @requires VTEXT_LEFT VTEXT_TOP VTEXT_WIDTH VTEXT_HEIGHT VTEXT_CURX VTEXT_CURY VTEXT_COLOR VTEXT_ATTR
0015E1r 3               ; @out A: 0 on success, 1 on error.
0015E1r 3               vtext_puts:
0015E1r 3  85 rr              STA   VTEXT_STRL
0015E3r 3  84 rr              STY   VTEXT_STRH
0015E5r 3               @loop:
0015E5r 3  A0 00              LDY   #$00
0015E7r 3  B1 rr              LDA   (VTEXT_STRL),Y
0015E9r 3  F0 10              BEQ   @ok
0015EBr 3  8D rr rr           STA   VTEXT_CHAR
0015EEr 3  20 rr rr           JSR   vtext_put_char
0015F1r 3  D0 0A              BNE   @done
0015F3r 3  E6 rr              INC   VTEXT_STRL
0015F5r 3  D0 EE              BNE   @loop
0015F7r 3  E6 rr              INC   VTEXT_STRH
0015F9r 3  80 EA              BRA   @loop
0015FBr 3               @ok:
0015FBr 3  A9 00              LDA   #VTEXT_OK
0015FDr 3               @done:
0015FDr 3  60                 RTS
0015FEr 3               
0015FEr 3               ; @label VTEXT.PUT_HEX_NIBBLE
0015FEr 3               ; @kind routine
0015FEr 3               ; @symbol vtext_put_hex_nibble
0015FEr 3               ; @summary Print the low nibble of A as one uppercase hexadecimal digit.
0015FEr 3               ; @in A: Value whose low nibble should be printed.
0015FEr 3               ; @requires Current VTEXT region and cursor.
0015FEr 3               ; @out A: 0 on success, 1 on error.
0015FEr 3               vtext_put_hex_nibble:
0015FEr 3  29 0F              AND   #$0F
001600r 3  AA                 TAX
001601r 3  BD rr rr           LDA   vtext_hex_digits,X
001604r 3  8D rr rr           STA   VTEXT_CHAR
001607r 3  4C rr rr           JMP   vtext_put_char
00160Ar 3               
00160Ar 3               ; @label VTEXT.PUT_HEX_BYTE
00160Ar 3               ; @kind routine
00160Ar 3               ; @symbol vtext_put_hex_byte
00160Ar 3               ; @summary Print A as two uppercase hexadecimal digits.
00160Ar 3               ; @in A: Byte value to print.
00160Ar 3               ; @requires Current VTEXT region and cursor.
00160Ar 3               ; @out A: 0 on success, 1 on error.
00160Ar 3               vtext_put_hex_byte:
00160Ar 3  48                 PHA
00160Br 3  4A                 LSR
00160Cr 3  4A                 LSR
00160Dr 3  4A                 LSR
00160Er 3  4A                 LSR
00160Fr 3  20 rr rr           JSR   vtext_put_hex_nibble
001612r 3  D0 04              BNE   @fail
001614r 3  68                 PLA
001615r 3  4C rr rr           JMP   vtext_put_hex_nibble
001618r 3               @fail:
001618r 3  68                 PLA
001619r 3  A9 01              LDA   #VTEXT_ERR
00161Br 3  60                 RTS
