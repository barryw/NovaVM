000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; Editor body geometry. Minimal full-screen layout (no frame, no title band):
000000r 2               ;   row 0          : menu bar (File/Edit/Help + title + dirty marker)
000000r 2               ;   rows 1..N-2    : editable body, full 80 columns
000000r 2               ;   row N-1        : status bar (help / status message)
000000r 2               ; ---------------------------------------------------------------------
000000r 2               EDITBUF_VIEW_LEFT   = 0                               ; first text column
000000r 2               EDITBUF_VIEW_TOP    = 1                               ; first text row (below menu bar)
000000r 2               EDITBUF_VIEW_COLS   = EDITUI_SCREEN_COLS              ; 80 visible columns
000000r 2               EDITBUF_VIEW_ROWS   = EDITUI_SCREEN_ROWS - 2          ; 48 (menu bar + status bar reserved)
000000r 2               
000000r 2               ; Clipboard capacity (bytes). Lives in editbuf BSS.
000000r 2               EDITBUF_CLIP_CAP    = 256
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; Exit reason returned in A by editbuf_run (also stored in EDITBUF_RESULT).
000000r 2               ; ---------------------------------------------------------------------
000000r 2               EDITBUF_EXIT_QUIT    = $00      ; Ctrl-Q while clean
000000r 2               EDITBUF_EXIT_SAVED   = $01      ; left via dialog "Save First" after a clean save
000000r 2               EDITBUF_EXIT_DISCARD = $02      ; left via dialog "Exit Anyway" (draft preserved)
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; SAVE hook contract.
000000r 2               ;   Called with no arguments (current text is in EDITBUF_BUF / EDITBUF_LEN).
000000r 2               ;   Returns status in A:
000000r 2               ; ---------------------------------------------------------------------
000000r 2               EDITBUF_SAVE_OK      = $00      ; saved + installed: clears dirty
000000r 2               EDITBUF_SAVE_DRAFT   = $01      ; draft kept but not usable: stays "dirty"-ish
000000r 2               EDITBUF_SAVE_ERROR   = $02      ; rejected: stays dirty
000000r 2               ; The host may point EDITBUF_STATUS at a message string before returning; the
000000r 2               ; editor redraws the status bar with it.
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; INDENT hook contract.
000000r 2               ;   Called after a newline is inserted. The cursor sits at the start of the
000000r 2               ;   freshly created line. Returns in A the number of leading spaces to insert
000000r 2               ;   (0 = no auto-indent). editbuf inserts that many spaces.
000000r 2               ; ---------------------------------------------------------------------
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; HILITE hook contract.
000000r 2               ;   Called once per visible line before it is drawn.
000000r 2               ;     EDITBUF_HL_PTR (zp) -> first byte of the line text (in EDITBUF_BUF)
000000r 2               ;     EDITBUF_HL_LEN       = line length in bytes (0..255, excludes the \n)
000000r 2               ;     EDITBUF_HL_COLORS    = 80-byte buffer the hook fills with one VGC color
000000r 2               ;                            byte per character. Pre-filled with the default
000000r 2               ;                            text color; the hook overwrites as needed.
000000r 2               ;   The hook returns nothing. If unset, the default color is used for all.
000000r 2               ; ---------------------------------------------------------------------
000000r 2               
000000r 2               ; Default editor colors (bg = high nibble, fg = low nibble; palette mode 0).
000000r 2               EDITBUF_COLOR_TEXT   = $01      ; white on black body
000000r 2               EDITBUF_COLOR_SEL    = $1F      ; selection: white bg, grey text
000000r 2               
000000r 2               ; --- Config (host sets before editbuf_run) -------------------------------
000000r 2               .global EDITBUF_BUFL          ; pointer to text buffer
000000r 2               .global EDITBUF_BUFH
000000r 2               .global EDITBUF_CAPL          ; capacity in bytes (16-bit)
000000r 2               .global EDITBUF_CAPH
000000r 2               .global EDITBUF_LENL          ; current length in bytes (16-bit)
000000r 2               .global EDITBUF_LENH
000000r 2               .global EDITBUF_TITLEL        ; NUL-terminated title string
000000r 2               .global EDITBUF_TITLEH
000000r 2               .global EDITBUF_STATUSL       ; NUL-terminated status message (may be 0)
000000r 2               .global EDITBUF_STATUSH
000000r 2               .global EDITBUF_SAVE_VECL     ; SAVE hook vector
000000r 2               .global EDITBUF_SAVE_VECH
000000r 2               .global EDITBUF_INDENT_VECL   ; INDENT hook vector
000000r 2               .global EDITBUF_INDENT_VECH
000000r 2               .global EDITBUF_HILITE_VECL   ; HILITE hook vector
000000r 2               .global EDITBUF_HILITE_VECH
000000r 2               .global EDITBUF_MENU_VECL     ; MENU-config hook vector
000000r 2               .global EDITBUF_MENU_VECH
000000r 2               
000000r 2               ; --- Result / observable state ------------------------------------------
000000r 2               .global EDITBUF_RESULT
000000r 2               .global EDITBUF_CURL          ; cursor byte offset (16-bit)
000000r 2               .global EDITBUF_CURH
000000r 2               
000000r 2               ; --- HILITE hook scratch (zp pointer + buffers) -------------------------
000000r 2               .global EDITBUF_HL_PTR        ; zp, 2 bytes
000000r 2               .global EDITBUF_HL_LEN
000000r 2               .global EDITBUF_HL_COLORS     ; 80-byte color buffer
000000r 2               
000000r 2               ; --- Entry points -------------------------------------------------------
000000r 2               .global editbuf_run           ; run the modal editor
000000r 2               .global editbuf_reset_state   ; reset cursor/scroll/selection/dirty for a new session
000000r 2               .global editbuf_dialog3       ; three-choice restore-under modal (A=result 0/1/2)
000000r 2               
000000r 2               ; Dialog choice result codes (returned by editbuf_dialog3 in A).
000000r 2               EDITBUF_DLG_EXIT   = $00       ; first button  (Exit Anyway)
000000r 2               EDITBUF_DLG_SAVE   = $01       ; second button (Save First)
000000r 2               EDITBUF_DLG_CANCEL = $02       ; third button  (Cancel)
000000r 2               
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               ; Editor display colors. The shared editor no longer dictates the global
000000r 1               ; background/border/foreground — this runtime owns them. Change these to
000000r 1               ; restyle the NovaLogo editor. (Palette mode 0: 0=black, 1=white, 15=grey-light.)
000000r 1               EDITOR_BGCOL      = $00        ; black background
000000r 1               EDITOR_BORDER     = $00        ; black border
000000r 1               EDITOR_FGCOL      = $01        ; white text (cursor is an inverted cell -> white)
000000r 1               
000000r 1                     .segment "CODE"
000000r 1               
000000r 1               ; =====================================================================
000000r 1               ; Extension entry point — called via JSR $C000 from RAM trampoline
000000r 1               ; =====================================================================
000000r 1               ext_entry:
000000r 1  D8                 CLD                       ; all extension math is binary, never BCD
000001r 1  A5 80              LDA   EXT_CMD
000003r 1  0A                 ASL                       ; * 2 for word-sized table
000004r 1  AA                 TAX
000005r 1  BD rr rr           LDA   ext_dispatch+1,X   ; high byte of handler-1
000008r 1  48                 PHA
000009r 1  BD rr rr           LDA   ext_dispatch,X     ; low byte of handler-1
00000Cr 1  48                 PHA
00000Dr 1  60                 RTS                       ; dispatch via RTS trick
00000Er 1               
00000Er 1               ; --- Dispatch table (entries are handler_address - 1) ---
00000Er 1               ext_dispatch:
00000Er 1  rr rr              .word ext_unsupported-1   ; cmd $00: reserved
000010r 1  rr rr              .word ext_test-1          ; cmd $01: EXT.TEST
000012r 1  rr rr              .word ext_unsupported-1   ; cmd $02
000014r 1  rr rr              .word ext_unsupported-1   ; cmd $03
000016r 1  rr rr              .word ext_unsupported-1   ; cmd $04
000018r 1  rr rr              .word ext_unsupported-1   ; cmd $05
00001Ar 1  rr rr              .word ext_unsupported-1   ; cmd $06
00001Cr 1  rr rr              .word ext_unsupported-1   ; cmd $07
00001Er 1  rr rr              .word ext_unsupported-1   ; cmd $08
000020r 1  rr rr              .word ext_unsupported-1   ; cmd $09
000022r 1  rr rr              .word ext_unsupported-1   ; cmd $0A
000024r 1  rr rr              .word ext_unsupported-1   ; cmd $0B
000026r 1  rr rr              .word ext_unsupported-1   ; cmd $0C
000028r 1  rr rr              .word ext_unsupported-1   ; cmd $0D
00002Ar 1  rr rr              .word ext_unsupported-1   ; cmd $0E
00002Cr 1  rr rr              .word ext_unsupported-1   ; cmd $0F
00002Er 1                     ; cmds $10-$44: turtle, VGC graphics + sprite commands. These now live in
00002Er 1                     ; the GRAPHICS module; the FOUNDATION routes them there (ext_cmd_table
00002Er 1                     ; MODULE_ID_TURTLE/GRAPHICS/GFXADAPTER), never via this legacy trampoline.
00002Er 1                     ; The drivers were deleted from this extension (4c.2-3-iii); these slots are
00002Er 1                     ; unreachable at runtime and point at ext_unsupported so the table stays
00002Er 1                     ; dense and every symbol resolves.
00002Er 1  rr rr              .word ext_unsupported-1   ; cmd $10: FD            (module)
000030r 1  rr rr              .word ext_unsupported-1   ; cmd $11: BK            (module)
000032r 1  rr rr              .word ext_unsupported-1   ; cmd $12: RT            (module)
000034r 1  rr rr              .word ext_unsupported-1   ; cmd $13: LT            (module)
000036r 1  rr rr              .word ext_unsupported-1   ; cmd $14: CS            (module)
000038r 1  rr rr              .word ext_unsupported-1   ; cmd $15: PU            (module)
00003Ar 1  rr rr              .word ext_unsupported-1   ; cmd $16: PD            (module)
00003Cr 1  rr rr              .word ext_unsupported-1   ; cmd $17: ST            (module)
00003Er 1  rr rr              .word ext_unsupported-1   ; cmd $18: HT            (module)
000040r 1  rr rr              .word ext_unsupported-1   ; cmd $19: HOME          (module)
000042r 1  rr rr              .word ext_unsupported-1   ; cmd $1A: TEXTSCREEN    (module)
000044r 1  rr rr              .word ext_unsupported-1   ; cmd $1B: SPLITSCREEN   (module)
000046r 1  rr rr              .word ext_unsupported-1   ; cmd $1C: FULLSCREEN    (module)
000048r 1  rr rr              .word ext_unsupported-1   ; cmd $1D: SETXY         (module)
00004Ar 1  rr rr              .word ext_unsupported-1   ; cmd $1E: SETX          (module)
00004Cr 1  rr rr              .word ext_unsupported-1   ; cmd $1F: SETY          (module)
00004Er 1  rr rr              .word ext_unsupported-1   ; cmd $20: SETHEADING    (module)
000050r 1  rr rr              .word ext_unsupported-1   ; cmd $21: XCOR          (module)
000052r 1  rr rr              .word ext_unsupported-1   ; cmd $22: YCOR          (module)
000054r 1  rr rr              .word ext_unsupported-1   ; cmd $23: HEADING       (module)
000056r 1  rr rr              .word ext_unsupported-1   ; cmd $24: PENDOWN?      (module)
000058r 1  rr rr              .word ext_unsupported-1   ; cmd $25: SHOWN?        (module)
00005Ar 1  rr rr              .word ext_unsupported-1   ; cmd $26: SETPC         (module)
00005Cr 1  rr rr              .word ext_unsupported-1   ; cmd $27: SETBG         (module)
00005Er 1  rr rr              .word ext_unsupported-1   ; cmd $28: TOWARDS       (module)
000060r 1  rr rr              .word ext_unsupported-1   ; cmd $29: SETPOS        (module)
000062r 1  rr rr              .word ext_unsupported-1   ; cmd $2A
000064r 1  rr rr              .word ext_unsupported-1   ; cmd $2B
000066r 1  rr rr              .word ext_unsupported-1   ; cmd $2C
000068r 1  rr rr              .word ext_unsupported-1   ; cmd $2D
00006Ar 1  rr rr              .word ext_unsupported-1   ; cmd $2E
00006Cr 1  rr rr              .word ext_unsupported-1   ; cmd $2F
00006Er 1  rr rr              .word ext_unsupported-1   ; cmd $30: SETCOLOR      (module)
000070r 1  rr rr              .word ext_unsupported-1   ; cmd $31: PLOT          (module)
000072r 1  rr rr              .word ext_unsupported-1   ; cmd $32: UNPLOT        (module)
000074r 1  rr rr              .word ext_unsupported-1   ; cmd $33: LINE          (module)
000076r 1  rr rr              .word ext_unsupported-1   ; cmd $34: CIRCLE        (module)
000078r 1  rr rr              .word ext_unsupported-1   ; cmd $35: RECT          (module)
00007Ar 1  rr rr              .word ext_unsupported-1   ; cmd $36: FILL          (module)
00007Cr 1  rr rr              .word ext_unsupported-1   ; cmd $37: PAINT         (module)
00007Er 1  rr rr              .word ext_unsupported-1   ; cmd $38
000080r 1  rr rr              .word ext_unsupported-1   ; cmd $39
000082r 1  rr rr              .word ext_unsupported-1   ; cmd $3A
000084r 1  rr rr              .word ext_unsupported-1   ; cmd $3B
000086r 1  rr rr              .word ext_unsupported-1   ; cmd $3C
000088r 1  rr rr              .word ext_unsupported-1   ; cmd $3D
00008Ar 1  rr rr              .word ext_unsupported-1   ; cmd $3E
00008Cr 1  rr rr              .word ext_unsupported-1   ; cmd $3F
00008Er 1  rr rr              .word ext_unsupported-1   ; cmd $40: SPRITE        (module)
000090r 1  rr rr              .word ext_unsupported-1   ; cmd $41: SPRITEPOS     (module)
000092r 1  rr rr              .word ext_unsupported-1   ; cmd $42: SPRITEON      (module)
000094r 1  rr rr              .word ext_unsupported-1   ; cmd $43: SPRITEOFF     (module)
000096r 1  rr rr              .word ext_unsupported-1   ; cmd $44: SPRITECOLLISION? (module)
000098r 1  rr rr              .word ext_tone-1          ; cmd $45: TONE
00009Ar 1  rr rr              .word ext_noise-1         ; cmd $46: NOISE
00009Cr 1  rr rr              .word ext_volume-1        ; cmd $47: VOLUME
00009Er 1  rr rr              .word ext_wait-1          ; cmd $48: WAIT
0000A0r 1  rr rr              .word ext_waitvbl-1       ; cmd $49: WAITVBL
0000A2r 1  rr rr              .word ext_timer-1         ; cmd $4A: TIMER
0000A4r 1  rr rr              .word ext_edit-1          ; cmd $4B: EDIT (shared editor)
0000A6r 1               
0000A6r 1               ; =====================================================================
0000A6r 1               ; ext_unsupported — unknown command, just return
0000A6r 1               ; =====================================================================
0000A6r 1               ext_unsupported:
0000A6r 1  60                 RTS
0000A7r 1               
0000A7r 1               ; =====================================================================
0000A7r 1               ; ext_test — test command: returns arg0 + 1
0000A7r 1               ; =====================================================================
0000A7r 1               ext_test:
0000A7r 1  18                 CLC
0000A8r 1  A5 84              LDA   EXT_ARG0_LO
0000AAr 1  69 01              ADC   #1
0000ACr 1  85 90              STA   EXT_RESULT_LO
0000AEr 1  A5 83              LDA   EXT_ARG0_HI
0000B0r 1  69 00              ADC   #0
0000B2r 1  85 8F              STA   EXT_RESULT_HI
0000B4r 1  A5 85              LDA   EXT_ARG0_FRAC
0000B6r 1  85 91              STA   EXT_RESULT_FRAC
0000B8r 1  64 8E              STZ   EXT_RESULT_TYPE    ; VAL_NUMBER
0000BAr 1  60                 RTS
0000BBr 1               
0000BBr 1               ; =====================================================================
0000BBr 1               ; ext_edit — run the shared EDITUI/EDITBUF editor on a RAM text buffer.
0000BBr 1               ;   The base ROM passes a buffer ptr/len/cap and a title in the mailbox
0000BBr 1               ;   (see EXT_CMD_EDIT in ext_iface.inc). We snapshot the VGC display state,
0000BBr 1               ;   switch to full-screen text (the editor owns the whole screen), run the
0000BBr 1               ;   modal editor, then restore the display EXACTLY — graphics/turtle are
0000BBr 1               ;   never cleared. A nonzero RESULT_HI means the user asked to save.
0000BBr 1               ; =====================================================================
0000BBr 1               ext_edit:
0000BBr 1                     ; --- snapshot the display registers editui_init will clobber ---
0000BBr 1  AD 00 A0           LDA   VGC_MODE
0000BEr 1  8D rr rr           STA   ee_saved_mode
0000C1r 1  AD E9 A0           LDA   VGC_PALETTE
0000C4r 1  8D rr rr           STA   ee_saved_palette
0000C7r 1  AD 01 A0           LDA   VGC_BGCOL
0000CAr 1  8D rr rr           STA   ee_saved_bgcol
0000CDr 1  AD 0D A0           LDA   VGC_BORDER
0000D0r 1  8D rr rr           STA   ee_saved_border
0000D3r 1  AD 02 A0           LDA   VGC_FGCOL
0000D6r 1  8D rr rr           STA   ee_saved_fgcol
0000D9r 1  AD 03 A0           LDA   VGC_CURSX
0000DCr 1  8D rr rr           STA   ee_saved_cursx
0000DFr 1  AD 04 A0           LDA   VGC_CURSY
0000E2r 1  8D rr rr           STA   ee_saved_cursy
0000E5r 1  AD 0A A0           LDA   VGC_CURSEN
0000E8r 1  8D rr rr           STA   ee_saved_cursen
0000EBr 1               
0000EBr 1                     ; --- the editor owns the whole screen: copper off, full text window ---
0000EBr 1  20 rr rr           JSR   copper_off
0000EEr 1  9C F2 B9           STZ   TEXTWIN_LEFT
0000F1r 1  9C F3 B9           STZ   TEXTWIN_TOP
0000F4r 1  A9 50              LDA   #80
0000F6r 1  8D F4 B9           STA   TEXTWIN_WIDTH
0000F9r 1  A9 19              LDA   #25
0000FBr 1  8D F5 B9           STA   TEXTWIN_HEIGHT
0000FEr 1               
0000FEr 1                     ; --- runtime-chosen editor colors (the engine no longer sets these) ---
0000FEr 1  A9 00              LDA   #EDITOR_BGCOL
000100r 1  8D 01 A0           STA   VGC_BGCOL
000103r 1  A9 00              LDA   #EDITOR_BORDER
000105r 1  8D 0D A0           STA   VGC_BORDER
000108r 1  A9 01              LDA   #EDITOR_FGCOL
00010Ar 1  8D 02 A0           STA   VGC_FGCOL
00010Dr 1               
00010Dr 1                     ; --- editbuf config from the mailbox ---
00010Dr 1  A5 84              LDA   EXT_ARG0_LO
00010Fr 1  8D rr rr           STA   EDITBUF_BUFL
000112r 1  A5 83              LDA   EXT_ARG0_HI
000114r 1  8D rr rr           STA   EDITBUF_BUFH
000117r 1  A5 8C              LDA   EXT_ARG2_LO
000119r 1  8D rr rr           STA   EDITBUF_CAPL
00011Cr 1  A5 8B              LDA   EXT_ARG2_HI
00011Er 1  8D rr rr           STA   EDITBUF_CAPH
000121r 1  A5 88              LDA   EXT_ARG1_LO
000123r 1  8D rr rr           STA   EDITBUF_LENL
000126r 1  A5 87              LDA   EXT_ARG1_HI
000128r 1  8D rr rr           STA   EDITBUF_LENH
00012Br 1  A5 A1              LDA   EXT_ARG3_LO
00012Dr 1  8D rr rr           STA   EDITBUF_TITLEL
000130r 1  A5 A0              LDA   EXT_ARG3_HI
000132r 1  8D rr rr           STA   EDITBUF_TITLEH
000135r 1  9C rr rr           STZ   EDITBUF_STATUSL
000138r 1  9C rr rr           STZ   EDITBUF_STATUSH
00013Br 1               
00013Br 1                     ; --- install hooks explicitly (BSS is not zeroed between sessions) ---
00013Br 1  A9 rr              LDA   #<ext_edit_save_hook
00013Dr 1  8D rr rr           STA   EDITBUF_SAVE_VECL
000140r 1  A9 rr              LDA   #>ext_edit_save_hook
000142r 1  8D rr rr           STA   EDITBUF_SAVE_VECH
000145r 1  9C rr rr           STZ   EDITBUF_INDENT_VECL    ; 0 => editbuf installs its no-op default
000148r 1  9C rr rr           STZ   EDITBUF_INDENT_VECH
00014Br 1  9C rr rr           STZ   EDITBUF_HILITE_VECL
00014Er 1  9C rr rr           STZ   EDITBUF_HILITE_VECH
000151r 1  9C rr rr           STZ   EDITBUF_MENU_VECL      ; keep EDITUI's default menus for now
000154r 1  9C rr rr           STZ   EDITBUF_MENU_VECH
000157r 1               
000157r 1                     ; --- run the modal editor ---
000157r 1  9C rr rr           STZ   ee_saved_flag
00015Ar 1  20 rr rr           JSR   editbuf_reset_state
00015Dr 1                     ; Place the cursor where the host asked (start of the body line), instead
00015Dr 1                     ; of the default offset 0. Cursor offset rides in the ARG FRAC bytes.
00015Dr 1  A5 8D              LDA   EXT_ARG2_FRAC
00015Fr 1  8D rr rr           STA   EDITBUF_CURL
000162r 1  A5 A2              LDA   EXT_ARG3_FRAC
000164r 1  8D rr rr           STA   EDITBUF_CURH
000167r 1  20 rr rr           JSR   editbuf_run            ; A = exit reason
00016Ar 1               
00016Ar 1                     ; --- publish results to the mailbox ---
00016Ar 1  85 90              STA   EXT_RESULT_LO          ; editbuf exit reason
00016Cr 1  AD rr rr           LDA   ee_saved_flag
00016Fr 1  85 8F              STA   EXT_RESULT_HI          ; nonzero => save requested
000171r 1  AD rr rr           LDA   EDITBUF_LENL
000174r 1  85 88              STA   EXT_ARG1_LO            ; final length back to the host
000176r 1  AD rr rr           LDA   EDITBUF_LENH
000179r 1  85 87              STA   EXT_ARG1_HI
00017Br 1               
00017Br 1                     ; --- restore the display exactly (never clear graphics) ---
00017Br 1                     ; Restore the host's palette + colors FIRST: the form-feed clear below
00017Br 1                     ; fills color RAM with the *current* text color, so the host's colors
00017Br 1                     ; must be back in place before we clear, or the editor's panel color
00017Br 1                     ; leaks into the restored text area.
00017Br 1  AD rr rr           LDA   ee_saved_palette
00017Er 1  8D E9 A0           STA   VGC_PALETTE
000181r 1  AD rr rr           LDA   ee_saved_bgcol
000184r 1  8D 01 A0           STA   VGC_BGCOL
000187r 1  AD rr rr           LDA   ee_saved_border
00018Ar 1  8D 0D A0           STA   VGC_BORDER
00018Dr 1  AD rr rr           LDA   ee_saved_fgcol
000190r 1  8D 02 A0           STA   VGC_FGCOL
000193r 1               
000193r 1                     ; Plain full-text restore: clear the editor chrome and restore the saved
000193r 1                     ; display registers. The turtle now lives in the GRAPHICS module, so the
000193r 1                     ; extension no longer owns the split-screen rebuild — when graphics were
000193r 1                     ; active, restoring ee_saved_mode brings the gfx layer back, and the
000193r 1                     ; foundation re-applies the split text window on the next turtle op
000193r 1                     ; (logo_turtle_textwin, keyed off the module's TURTLE_GFX_VISIBLE flag).
000193r 1  9C F2 B9           STZ   TEXTWIN_LEFT
000196r 1  9C F3 B9           STZ   TEXTWIN_TOP
000199r 1  A9 50              LDA   #80
00019Br 1  8D F4 B9           STA   TEXTWIN_WIDTH
00019Er 1  A9 19              LDA   #25
0001A0r 1  8D F5 B9           STA   TEXTWIN_HEIGHT
0001A3r 1  A9 0C              LDA   #$0C                   ; form feed: clear text plane only
0001A5r 1  8D 0E A0           STA   VGC_CHAROUT
0001A8r 1  AD rr rr           LDA   ee_saved_mode
0001ABr 1  8D 00 A0           STA   VGC_MODE
0001AEr 1  AD rr rr           LDA   ee_saved_cursx
0001B1r 1  8D 03 A0           STA   VGC_CURSX
0001B4r 1  AD rr rr           LDA   ee_saved_cursy
0001B7r 1  8D 04 A0           STA   VGC_CURSY
0001BAr 1  AD rr rr           LDA   ee_saved_cursen
0001BDr 1  8D 0A A0           STA   VGC_CURSEN
0001C0r 1  60                 RTS
0001C1r 1               
0001C1r 1               ; ext_edit_save_hook — SAVE hook while the editor runs. For now it just records
0001C1r 1               ; that the user asked to save and reports success; the base ROM builds the
0001C1r 1               ; procedure record from the final buffer when the editor exits. (Cross-bank
0001C1r 1               ; live validation is the next increment.)
0001C1r 1               ext_edit_save_hook:
0001C1r 1  A9 01              LDA   #1
0001C3r 1  8D rr rr           STA   ee_saved_flag
0001C6r 1  A9 00              LDA   #EDITBUF_SAVE_OK
0001C8r 1  60                 RTS
0001C9r 1               
0001C9r 1                     .segment "BSS"
000000r 1  xx           ee_saved_mode:    .res 1
000001r 1  xx           ee_saved_palette: .res 1
000002r 1  xx           ee_saved_bgcol:   .res 1
000003r 1  xx           ee_saved_border:  .res 1
000004r 1  xx           ee_saved_fgcol:   .res 1
000005r 1  xx           ee_saved_cursx:   .res 1
000006r 1  xx           ee_saved_cursy:   .res 1
000007r 1  xx           ee_saved_cursen:  .res 1
000008r 1  xx           ee_saved_flag:    .res 1          ; nonzero once the SAVE hook fires
000009r 1                     .segment "CODE"
0001C9r 1               
0001C9r 1               ; =====================================================================
0001C9r 1               ; ext_tone — TONE freq dur: play a tone on SID voice 0
0001C9r 1               ;   ARG0 = frequency (16-bit SID freq word), ARG1 = duration (frames)
0001C9r 1               ; =====================================================================
0001C9r 1               ext_tone:
0001C9r 1                     ; Set SID master volume to max
0001C9r 1  A9 0F              LDA   #$0F
0001CBr 1  8D 18 D4           STA   SID_BASE + $18         ; $D418 filter/volume, bits 0-3 = volume
0001CEr 1                     ; Set frequency
0001CEr 1  A5 84              LDA   EXT_ARG0_LO
0001D0r 1  8D 00 D4           STA   SID_BASE + $00         ; freq lo
0001D3r 1  A5 83              LDA   EXT_ARG0_HI
0001D5r 1  8D 01 D4           STA   SID_BASE + $01         ; freq hi
0001D8r 1                     ; Set ADSR: attack=0, decay=9, sustain=$A, release=0
0001D8r 1  A9 09              LDA   #$09
0001DAr 1  8D 05 D4           STA   SID_BASE + $05         ; attack/decay
0001DDr 1  A9 A0              LDA   #$A0
0001DFr 1  8D 06 D4           STA   SID_BASE + $06         ; sustain/release
0001E2r 1                     ; Gate on with sawtooth waveform
0001E2r 1  A9 21              LDA   #$21                   ; sawtooth ($20) + gate ($01)
0001E4r 1  8D 04 D4           STA   SID_BASE + $04         ; control register
0001E7r 1                     ; Wait duration frames
0001E7r 1  A5 88              LDA   EXT_ARG1_LO
0001E9r 1  20 rr rr           JSR   wait_frames
0001ECr 1                     ; Gate off
0001ECr 1  A9 20              LDA   #$20                   ; sawtooth, no gate
0001EEr 1  8D 04 D4           STA   SID_BASE + $04
0001F1r 1  60                 RTS
0001F2r 1               
0001F2r 1               ; =====================================================================
0001F2r 1               ; ext_noise — NOISE dur: noise burst on SID voice 0
0001F2r 1               ;   ARG0 = duration (frames)
0001F2r 1               ; =====================================================================
0001F2r 1               ext_noise:
0001F2r 1                     ; Set SID master volume to max
0001F2r 1  A9 0F              LDA   #$0F
0001F4r 1  8D 18 D4           STA   SID_BASE + $18
0001F7r 1                     ; Set a mid-range frequency for noise
0001F7r 1  A9 00              LDA   #$00
0001F9r 1  8D 00 D4           STA   SID_BASE + $00
0001FCr 1  A9 20              LDA   #$20
0001FEr 1  8D 01 D4           STA   SID_BASE + $01
000201r 1                     ; ADSR: fast attack, medium sustain
000201r 1  A9 09              LDA   #$09
000203r 1  8D 05 D4           STA   SID_BASE + $05
000206r 1  A9 A0              LDA   #$A0
000208r 1  8D 06 D4           STA   SID_BASE + $06
00020Br 1                     ; Gate on with noise waveform
00020Br 1  A9 81              LDA   #$81                   ; noise ($80) + gate ($01)
00020Dr 1  8D 04 D4           STA   SID_BASE + $04
000210r 1                     ; Wait duration frames
000210r 1  A5 84              LDA   EXT_ARG0_LO
000212r 1  20 rr rr           JSR   wait_frames
000215r 1                     ; Gate off
000215r 1  A9 80              LDA   #$80                   ; noise, no gate
000217r 1  8D 04 D4           STA   SID_BASE + $04
00021Ar 1  60                 RTS
00021Br 1               
00021Br 1               ; =====================================================================
00021Br 1               ; ext_volume — VOLUME vol: set SID master volume (0-15)
00021Br 1               ;   ARG0 = volume
00021Br 1               ; =====================================================================
00021Br 1               ext_volume:
00021Br 1  A5 84              LDA   EXT_ARG0_LO
00021Dr 1  29 0F              AND   #$0F                   ; clamp to 0-15
00021Fr 1  8D 18 D4           STA   SID_BASE + $18
000222r 1  60                 RTS
000223r 1               
000223r 1               ; =====================================================================
000223r 1               ; ext_wait — WAIT n: wait N video frames
000223r 1               ;   ARG0 = count
000223r 1               ; =====================================================================
000223r 1               ext_wait:
000223r 1  A5 84              LDA   EXT_ARG0_LO
000225r 1  20 rr rr           JSR   wait_frames
000228r 1  60                 RTS
000229r 1               
000229r 1               ; =====================================================================
000229r 1               ; ext_waitvbl — WAITVBL: wait for next vertical blank (1 frame)
000229r 1               ; =====================================================================
000229r 1               ext_waitvbl:
000229r 1  AD 08 A0           LDA   VGC_FRAME
00022Cr 1  CD 08 A0     @w:   CMP   VGC_FRAME
00022Fr 1  F0 FB              BEQ   @w
000231r 1  60                 RTS
000232r 1               
000232r 1               ; =====================================================================
000232r 1               ; ext_timer — TIMER: return current frame counter (8-bit)
000232r 1               ; =====================================================================
000232r 1               ext_timer:
000232r 1  AD 08 A0           LDA   VGC_FRAME
000235r 1  85 90              STA   EXT_RESULT_LO
000237r 1  64 8F              STZ   EXT_RESULT_HI
000239r 1  64 91              STZ   EXT_RESULT_FRAC
00023Br 1  64 8E              STZ   EXT_RESULT_TYPE
00023Dr 1  60                 RTS
00023Er 1               
00023Er 1               ; =====================================================================
00023Er 1               ; wait_frames — wait A video frames. Reused by TONE, NOISE, WAIT.
00023Er 1               ; =====================================================================
00023Er 1               wait_frames:
00023Er 1  AA                 TAX
00023Fr 1  F0 0E              BEQ   @done
000241r 1  AD 08 A0           LDA   VGC_FRAME
000244r 1               @wait:
000244r 1  CD 08 A0           CMP   VGC_FRAME
000247r 1  F0 FB              BEQ   @wait
000249r 1  AD 08 A0           LDA   VGC_FRAME
00024Cr 1  CA                 DEX
00024Dr 1  D0 F5              BNE   @wait
00024Fr 1               @done:
00024Fr 1  60                 RTS
000250r 1               
000250r 1                     .include "copper.s"
000250r 2               ; Shared Nova copper helper routines.
000250r 2               ;
000250r 2               ; Assembly ABI:
000250r 2               ;   copper_add expects VGC_P0/P1=x, VGC_P2=y, VGC_P3/P4=register/index,
000250r 2               ;   VGC_P5=value. COPPER_REG_* constants cover common VGC register indices.
000250r 2               
000250r 2               .include "copper.inc"
000250r 3               ; Shared Nova copper helper declarations.
000250r 3               
000250r 3               .ifndef COPPER_INC_INCLUDED
000250r 3               COPPER_INC_INCLUDED = 1
000250r 3               
000250r 3               .include "vgc.inc"
000250r 4               ; Shared Nova VGC helper declarations.
000250r 4               ;
000250r 4               ; The command helpers use the VGC hardware parameter registers directly:
000250r 4               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
000250r 4               ; Routines return through the hardware status model; command completion can be
000250r 4               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
000250r 4               
000250r 4               .ifndef VGC_INC_INCLUDED
000250r 4               VGC_INC_INCLUDED = 1
000250r 4               
000250r 4               .include "nova.inc"
000250r 4               
000250r 4               VGC_RESULT_OK    = $00
000250r 4               VGC_RESULT_ERROR = $01
000250r 4               
000250r 4               .endif
000250r 4               
000250r 3               
000250r 3               COPPER_RESULT_OK    = $00
000250r 3               COPPER_RESULT_ERROR = $01
000250r 3               
000250r 3               COPPER_REG_MODE     = $00
000250r 3               COPPER_REG_BGCOL    = $01
000250r 3               COPPER_REG_SCROLLX  = $05
000250r 3               COPPER_REG_SCROLLY  = $06
000250r 3               
000250r 3               .endif
000250r 3               
000250r 2               
000250r 2               .ifndef COPPER_IMPLEMENTATION_INCLUDED
000250r 2               COPPER_IMPLEMENTATION_INCLUDED = 1
000250r 2               
000250r 2                     .segment "CODE"
000250r 2               
000250r 2                     .export copper_command
000250r 2                     .export copper_clear
000250r 2                     .export copper_on
000250r 2                     .export copper_off
000250r 2                     .export copper_list
000250r 2                     .export copper_list_end
000250r 2                     .export copper_use
000250r 2                     .export copper_add
000250r 2                     .export copper_set_reg_index
000250r 2                     .export copper_set_sprite_reg
000250r 2               
000250r 2               ; Input: A = copper VGC command. Does not wait for completion.
000250r 2               ; @label COPPER.COMMAND
000250r 2               ; @kind routine
000250r 2               ; @symbol copper_command
000250r 2               ; @summary Issue a raw copper VGC command.
000250r 2               ; @in A: Copper VGC command byte.
000250r 2               copper_command:
000250r 2  8D 10 A0           STA   VGC_CMD
000253r 2  A9 00              LDA   #COPPER_RESULT_OK
000255r 2  60                 RTS
000256r 2               
000256r 2               ; @label COPPER.CLEAR
000256r 2               ; @kind routine
000256r 2               ; @symbol copper_clear
000256r 2               ; @summary Clear the active copper list.
000256r 2               copper_clear:
000256r 2  A9 1C              LDA   #VCMD_COPPERCLR
000258r 2  4C rr rr           JMP   copper_command
00025Br 2               
00025Br 2               ; @label COPPER.ON
00025Br 2               ; @kind routine
00025Br 2               ; @symbol copper_on
00025Br 2               ; @summary Enable copper execution.
00025Br 2               copper_on:
00025Br 2  A9 1D              LDA   #VCMD_COPPERENA
00025Dr 2  4C rr rr           JMP   copper_command
000260r 2               
000260r 2               ; @label COPPER.OFF
000260r 2               ; @kind routine
000260r 2               ; @symbol copper_off
000260r 2               ; @summary Disable copper execution.
000260r 2               copper_off:
000260r 2  A9 1E              LDA   #VCMD_COPPERDIS
000262r 2  4C rr rr           JMP   copper_command
000265r 2               
000265r 2               ; @label COPPER.LIST
000265r 2               ; @kind routine
000265r 2               ; @symbol copper_list
000265r 2               ; @summary Select a copper list using VGC.P0.
000265r 2               ; @requires VGC_P0
000265r 2               copper_list:
000265r 2  A9 20              LDA   #VCMD_COPPERLIST
000267r 2  4C rr rr           JMP   copper_command
00026Ar 2               
00026Ar 2               ; @label COPPER.LIST_END
00026Ar 2               ; @kind routine
00026Ar 2               ; @symbol copper_list_end
00026Ar 2               ; @summary Finish the current copper list.
00026Ar 2               copper_list_end:
00026Ar 2  A9 22              LDA   #VCMD_COPPEREND
00026Cr 2  4C rr rr           JMP   copper_command
00026Fr 2               
00026Fr 2               ; @label COPPER.USE
00026Fr 2               ; @kind routine
00026Fr 2               ; @symbol copper_use
00026Fr 2               ; @summary Activate a copper list using VGC.P0.
00026Fr 2               ; @requires VGC_P0
00026Fr 2               copper_use:
00026Fr 2  A9 21              LDA   #VCMD_COPPERUSE
000271r 2  4C rr rr           JMP   copper_command
000274r 2               
000274r 2               ; @label COPPER.ADD
000274r 2               ; @kind routine
000274r 2               ; @symbol copper_add
000274r 2               ; @summary Add a copper operation using VGC.P0..VGC.P5.
000274r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5
000274r 2               copper_add:
000274r 2  A9 1B              LDA   #VCMD_COPPERADD
000276r 2  4C rr rr           JMP   copper_command
000279r 2               
000279r 2               ; Input: A = direct VGC register index. Output: VGC_P3/P4 updated.
000279r 2               ; @label COPPER.SET_REG_INDEX
000279r 2               ; @kind routine
000279r 2               ; @symbol copper_set_reg_index
000279r 2               ; @summary Set VGC.P3/P4 to a direct VGC register index.
000279r 2               ; @in A: VGC register index.
000279r 2               copper_set_reg_index:
000279r 2  8D 14 A0           STA   VGC_P3
00027Cr 2  9C 15 A0           STZ   VGC_P4
00027Fr 2  60                 RTS
000280r 2               
000280r 2               ; Input: X = sprite index, A = VGC_SPR_*_OFF field.
000280r 2               ; Output: VGC_P3/P4 = absolute sprite register address.
000280r 2               ; Clobbers: A, NVR7L.
000280r 2               ; @label COPPER.SET_SPRITE_REG
000280r 2               ; @kind routine
000280r 2               ; @symbol copper_set_sprite_reg
000280r 2               ; @summary Set VGC.P3/P4 to a sprite attribute register address.
000280r 2               ; @in X: Sprite index.
000280r 2               ; @in A: Sprite field offset.
000280r 2               copper_set_sprite_reg:
000280r 2  85 2E              STA   NVR7L
000282r 2  8A                 TXA
000283r 2  0A                 ASL
000284r 2  0A                 ASL
000285r 2  0A                 ASL
000286r 2  18                 CLC
000287r 2  65 2E              ADC   NVR7L
000289r 2  18                 CLC
00028Ar 2  69 40              ADC   #<VGC_SPR_BASE
00028Cr 2  8D 14 A0           STA   VGC_P3
00028Fr 2  A9 A0              LDA   #>VGC_SPR_BASE
000291r 2  69 00              ADC   #$00
000293r 2  8D 15 A0           STA   VGC_P4
000296r 2  60                 RTS
000297r 2               
000297r 2               .endif
000297r 2               
000297r 1                     ; Shared text editor (pulls vtext.s + blitter.s, all include-guarded).
