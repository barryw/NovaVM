000192r 1                     .include "editbuf.s"
000192r 2               ; editbuf.s — shared text-editing engine for Nova native tools.
000192r 2               ; See editbuf.inc for the public ABI and hook contracts. This module is
000192r 2               ; language-neutral; all host behavior arrives through the hook vectors.
000192r 2               
000192r 2               .include "editbuf.inc"
000192r 3               ; editbuf.inc — shared text-editing engine for Nova native tools.
000192r 3               ;
000192r 3               ; editbuf layers a real editable text buffer (cursor movement, insert/delete,
000192r 3               ; line navigation, selection, cut/copy/paste, scrolling) and a three-choice
000192r 3               ; modal dialog on top of the EDITUI chrome shell. It is intentionally
000192r 3               ; LANGUAGE-NEUTRAL: it knows nothing about Logo, BASIC, or any document model.
000192r 3               ;
000192r 3               ; Anything language-specific is supplied by the host through HOOK VECTORS:
000192r 3               ;   - SAVE hook   : invoked on Ctrl-S (and the dialog "Save First" choice).
000192r 3               ;                   The host validates/saves/installs and returns a status.
000192r 3               ;   - INDENT hook : invoked after Enter. The host returns how many leading
000192r 3               ;                   spaces the new line should start with (auto-indent).
000192r 3               ;   - HILITE hook : invoked per visible line during render. The host fills a
000192r 3               ;                   per-character color buffer (syntax highlighting).
000192r 3               ; Every hook defaults to a no-op, so editbuf works as a plain editor with no
000192r 3               ; host wiring at all.
000192r 3               ;
000192r 3               ; Calling convention: the host populates the EDITBUF_* config bytes below, then
000192r 3               ; calls editbuf_run. editbuf_run blocks until the user exits and returns the
000192r 3               ; exit reason in A (also EDITBUF_RESULT). The buffer text and EDITBUF_LEN are
000192r 3               ; left in place so the host can inspect / re-open the draft.
000192r 3               
000192r 3               .ifndef EDITBUF_INC_INCLUDED
000192r 3               EDITBUF_INC_INCLUDED = 1
000192r 3               
000192r 3               .include "editui.inc"
000192r 3               
000192r 3               ; ---------------------------------------------------------------------
000192r 3               ; Editor body geometry. Minimal full-screen layout (no frame, no title band):
000192r 3               ;   row 0          : menu bar (File/Edit/Help + title + dirty marker)
000192r 3               ;   rows 1..N-2    : editable body, full 80 columns
000192r 3               ;   row N-1        : status bar (help / status message)
000192r 3               ; ---------------------------------------------------------------------
000192r 3               EDITBUF_VIEW_LEFT   = 0                               ; first text column
000192r 3               EDITBUF_VIEW_TOP    = 1                               ; first text row (below menu bar)
000192r 3               EDITBUF_VIEW_COLS   = EDITUI_SCREEN_COLS              ; 80 visible columns
000192r 3               EDITBUF_VIEW_ROWS   = EDITUI_SCREEN_ROWS - 2          ; 48 (menu bar + status bar reserved)
000192r 3               
000192r 3               ; Clipboard capacity (bytes). Lives in editbuf BSS.
000192r 3               EDITBUF_CLIP_CAP    = 256
000192r 3               
000192r 3               ; ---------------------------------------------------------------------
000192r 3               ; Exit reason returned in A by editbuf_run (also stored in EDITBUF_RESULT).
000192r 3               ; ---------------------------------------------------------------------
000192r 3               EDITBUF_EXIT_QUIT    = $00      ; Ctrl-Q while clean
000192r 3               EDITBUF_EXIT_SAVED   = $01      ; left via dialog "Save First" after a clean save
000192r 3               EDITBUF_EXIT_DISCARD = $02      ; left via dialog "Exit Anyway" (draft preserved)
000192r 3               
000192r 3               ; ---------------------------------------------------------------------
000192r 3               ; SAVE hook contract.
000192r 3               ;   Called with no arguments (current text is in EDITBUF_BUF / EDITBUF_LEN).
000192r 3               ;   Returns status in A:
000192r 3               ; ---------------------------------------------------------------------
000192r 3               EDITBUF_SAVE_OK      = $00      ; saved + installed: clears dirty
000192r 3               EDITBUF_SAVE_DRAFT   = $01      ; draft kept but not usable: stays "dirty"-ish
000192r 3               EDITBUF_SAVE_ERROR   = $02      ; rejected: stays dirty
000192r 3               ; The host may point EDITBUF_STATUS at a message string before returning; the
000192r 3               ; editor redraws the status bar with it.
000192r 3               
000192r 3               ; ---------------------------------------------------------------------
000192r 3               ; INDENT hook contract.
000192r 3               ;   Called after a newline is inserted. The cursor sits at the start of the
000192r 3               ;   freshly created line. Returns in A the number of leading spaces to insert
000192r 3               ;   (0 = no auto-indent). editbuf inserts that many spaces.
000192r 3               ; ---------------------------------------------------------------------
000192r 3               
000192r 3               ; ---------------------------------------------------------------------
000192r 3               ; HILITE hook contract.
000192r 3               ;   Called once per visible line before it is drawn.
000192r 3               ;     EDITBUF_HL_PTR (zp) -> first byte of the line text (in EDITBUF_BUF)
000192r 3               ;     EDITBUF_HL_LEN       = line length in bytes (0..255, excludes the \n)
000192r 3               ;     EDITBUF_HL_COLORS    = 80-byte buffer the hook fills with one VGC color
000192r 3               ;                            byte per character. Pre-filled with the default
000192r 3               ;                            text color; the hook overwrites as needed.
000192r 3               ;   The hook returns nothing. If unset, the default color is used for all.
000192r 3               ; ---------------------------------------------------------------------
000192r 3               
000192r 3               ; Default editor colors (bg = high nibble, fg = low nibble; palette mode 0).
000192r 3               EDITBUF_COLOR_TEXT   = $01      ; white on black body
000192r 3               EDITBUF_COLOR_SEL    = $1F      ; selection: white bg, grey text
000192r 3               
000192r 3               ; --- Config (host sets before editbuf_run) -------------------------------
000192r 3               .global EDITBUF_BUFL          ; pointer to text buffer
000192r 3               .global EDITBUF_BUFH
000192r 3               .global EDITBUF_CAPL          ; capacity in bytes (16-bit)
000192r 3               .global EDITBUF_CAPH
000192r 3               .global EDITBUF_LENL          ; current length in bytes (16-bit)
000192r 3               .global EDITBUF_LENH
000192r 3               .global EDITBUF_TITLEL        ; NUL-terminated title string
000192r 3               .global EDITBUF_TITLEH
000192r 3               .global EDITBUF_STATUSL       ; NUL-terminated status message (may be 0)
000192r 3               .global EDITBUF_STATUSH
000192r 3               .global EDITBUF_SAVE_VECL     ; SAVE hook vector
000192r 3               .global EDITBUF_SAVE_VECH
000192r 3               .global EDITBUF_INDENT_VECL   ; INDENT hook vector
000192r 3               .global EDITBUF_INDENT_VECH
000192r 3               .global EDITBUF_HILITE_VECL   ; HILITE hook vector
000192r 3               .global EDITBUF_HILITE_VECH
000192r 3               .global EDITBUF_MENU_VECL     ; MENU-config hook vector
000192r 3               .global EDITBUF_MENU_VECH
000192r 3               
000192r 3               ; --- Result / observable state ------------------------------------------
000192r 3               .global EDITBUF_RESULT
000192r 3               .global EDITBUF_CURL          ; cursor byte offset (16-bit)
000192r 3               .global EDITBUF_CURH
000192r 3               
000192r 3               ; --- HILITE hook scratch (zp pointer + buffers) -------------------------
000192r 3               .global EDITBUF_HL_PTR        ; zp, 2 bytes
000192r 3               .global EDITBUF_HL_LEN
000192r 3               .global EDITBUF_HL_COLORS     ; 80-byte color buffer
000192r 3               
000192r 3               ; --- Entry points -------------------------------------------------------
000192r 3               .global editbuf_run           ; run the modal editor
000192r 3               .global editbuf_reset_state   ; reset cursor/scroll/selection/dirty for a new session
000192r 3               .global editbuf_dialog3       ; three-choice restore-under modal (A=result 0/1/2)
000192r 3               
000192r 3               ; Dialog choice result codes (returned by editbuf_dialog3 in A).
000192r 3               EDITBUF_DLG_EXIT   = $00       ; first button  (Exit Anyway)
000192r 3               EDITBUF_DLG_SAVE   = $01       ; second button (Save First)
000192r 3               EDITBUF_DLG_CANCEL = $02       ; third button  (Cancel)
000192r 3               
000192r 3               .endif
000192r 3               
000192r 2               .include "editui.inc"
000192r 3               ; Shared Nova editor-shell UI declarations.
000192r 3               ;
000192r 3               ; EDITUI is a small text-mode shell for native tools: menu bar, title/help
000192r 3               ; rows, framed panels, and status lines. Applications own input dispatch,
000192r 3               ; document state, and editor-specific drawing.
000192r 3               
000192r 3               .ifndef EDITUI_INC_INCLUDED
000192r 3               EDITUI_INC_INCLUDED = 1
000192r 3               
000192r 3               .include "vtext.inc"
000192r 3               
000192r 3               EDITUI_OK  = $00
000192r 3               EDITUI_ERR = $01
000192r 3               
000192r 3               EDITUI_SCREEN_COLS = VTEXT_SCREEN_COLS
000192r 3               EDITUI_SCREEN_ROWS = VTEXT_SCREEN_ROWS
000192r 3               
000192r 3               ; Black background with light-grey bars. bg = high nibble, fg = low nibble.
000192r 3               ; Palette mode 0: 0=black, 1=white, 2=red, 12=grey-med, 15=grey-light.
000192r 3               EDITUI_PALETTE_MODE     = $00
000192r 3               EDITUI_COLOR_BG         = $00      ; black
000192r 3               EDITUI_COLOR_FG         = $01      ; white
000192r 3               EDITUI_COLOR_SHELL      = $0F      ; editor background (black bg)
000192r 3               EDITUI_COLOR_TITLE      = $01      ; title text: white on black
000192r 3               EDITUI_COLOR_MENU       = $F0      ; light-grey menu bar, black text
000192r 3               EDITUI_COLOR_MENU_HOT   = $F2      ; light-grey bar, red hotkey
000192r 3               EDITUI_COLOR_FRAME      = $0F      ; grey frame lines on black
000192r 3               EDITUI_COLOR_DIM        = $0C      ; grey-med dim text on black
000192r 3               EDITUI_COLOR_MENU_SEL   = $1F      ; selected dropdown item: white bg
000192r 3               EDITUI_COLOR_MENU_SEL_HOT = $12    ; selected item hotkey
000192r 3               EDITUI_COLOR_STATUS     = $F0      ; light-grey status bar
000192r 3               EDITUI_COLOR_STATUS_HOT = $F6      ; status bar accent
000192r 3               EDITUI_COLOR_PANEL      = $0F      ; dialog panel: black bg
000192r 3               
000192r 3               EDITUI_STATUS_ROW = EDITUI_SCREEN_ROWS - 1
000192r 3               ; Dirty marker ('*') cell on the menu bar (right side). The title is drawn just
000192r 3               ; to its left; toggling the marker is a single-cell write.
000192r 3               EDITUI_DIRTY_COL  = EDITUI_SCREEN_COLS - 2
000192r 3               
000192r 3               EDITUI_BOX_SINGLE = $00
000192r 3               EDITUI_BOX_DOUBLE = $01
000192r 3               
000192r 3               ; CP437 box-drawing characters from Nova's default font.
000192r 3               EDITUI_CH_SINGLE_TL = $DA
000192r 3               EDITUI_CH_SINGLE_TR = $BF
000192r 3               EDITUI_CH_SINGLE_BL = $C0
000192r 3               EDITUI_CH_SINGLE_BR = $D9
000192r 3               EDITUI_CH_SINGLE_H  = $C4
000192r 3               EDITUI_CH_SINGLE_V  = $B3
000192r 3               EDITUI_CH_SINGLE_TITLE_L = $B4
000192r 3               EDITUI_CH_SINGLE_TITLE_R = $C3
000192r 3               EDITUI_CH_DOUBLE_TL = $C9
000192r 3               EDITUI_CH_DOUBLE_TR = $BB
000192r 3               EDITUI_CH_DOUBLE_BL = $C8
000192r 3               EDITUI_CH_DOUBLE_BR = $BC
000192r 3               EDITUI_CH_DOUBLE_H  = $CD
000192r 3               EDITUI_CH_DOUBLE_V  = $BA
000192r 3               EDITUI_CH_DOUBLE_TITLE_L = $B9
000192r 3               EDITUI_CH_DOUBLE_TITLE_R = $CC
000192r 3               EDITUI_CH_DOT       = $FA
000192r 3               
000192r 3               EDITUI_KEY_BACKSPACE = $08
000192r 3               EDITUI_KEY_TAB       = $09
000192r 3               EDITUI_KEY_ENTER     = $0D
000192r 3               EDITUI_KEY_ESC       = $1B
000192r 3               EDITUI_KEY_LEFT      = $1C
000192r 3               EDITUI_KEY_RIGHT     = $1D
000192r 3               EDITUI_KEY_UP        = $1E
000192r 3               EDITUI_KEY_DOWN      = $1F
000192r 3               EDITUI_KEY_DELETE    = $7F
000192r 3               EDITUI_KEY_ALT_PREFIX = EDITUI_KEY_ESC
000192r 3               
000192r 3               EDITUI_KEY_CTRL_A    = $01
000192r 3               EDITUI_KEY_CTRL_C    = $03
000192r 3               EDITUI_KEY_CTRL_N    = $0E
000192r 3               EDITUI_KEY_CTRL_O    = $0F
000192r 3               EDITUI_KEY_CTRL_Q    = $11
000192r 3               EDITUI_KEY_CTRL_S    = $13
000192r 3               EDITUI_KEY_CTRL_V    = $16
000192r 3               EDITUI_KEY_CTRL_W    = $17
000192r 3               EDITUI_KEY_CTRL_X    = $18
000192r 3               EDITUI_KEY_CTRL_Z    = $1A
000192r 3               
000192r 3               ; Editing navigation keys (defined by Nova; the host keyboard maps physical
000192r 3               ; Home/End/PgUp/PgDn to these bytes).
000192r 3               EDITUI_KEY_HOME      = $02
000192r 3               EDITUI_KEY_END       = $05
000192r 3               EDITUI_KEY_PGUP      = $10
000192r 3               EDITUI_KEY_PGDN      = $12
000192r 3               
000192r 3               EDITUI_CMD_NONE      = $00
000192r 3               EDITUI_CMD_NEW       = $01
000192r 3               EDITUI_CMD_OPEN      = $02
000192r 3               EDITUI_CMD_SAVE      = $03
000192r 3               EDITUI_CMD_SAVE_AS   = $04
000192r 3               EDITUI_CMD_QUIT      = $05
000192r 3               EDITUI_CMD_UNDO      = $06
000192r 3               EDITUI_CMD_CUT       = $07
000192r 3               EDITUI_CMD_COPY      = $08
000192r 3               EDITUI_CMD_PASTE     = $09
000192r 3               EDITUI_CMD_CLOSE     = $0A
000192r 3               EDITUI_CMD_HELP      = $0B
000192r 3               EDITUI_CMD_ABOUT     = $0C
000192r 3               
000192r 3               EDITUI_MENU_ENTRY_SIZE = 6
000192r 3               EDITUI_MENU_ITEM_SIZE  = 4
000192r 3               
000192r 3               .global EDITUI_TITLEL
000192r 3               .global EDITUI_TITLEH
000192r 3               .global EDITUI_MENUL
000192r 3               .global EDITUI_MENUH
000192r 3               .global EDITUI_MENUSL
000192r 3               .global EDITUI_MENUSH
000192r 3               .global EDITUI_HELPL
000192r 3               .global EDITUI_HELPH
000192r 3               .global EDITUI_STATUSL
000192r 3               .global EDITUI_STATUSH
000192r 3               .global EDITUI_DIRTY
000192r 3               .global EDITUI_BOXX
000192r 3               .global EDITUI_BOXY
000192r 3               .global EDITUI_BOXW
000192r 3               .global EDITUI_BOXH
000192r 3               .global EDITUI_BOX_TITLEL
000192r 3               .global EDITUI_BOX_TITLEH
000192r 3               .global EDITUI_BOX_STYLE
000192r 3               .global EDITUI_PRINTL
000192r 3               .global EDITUI_PRINTH
000192r 3               .global EDITUI_PRINTX
000192r 3               .global EDITUI_PRINTY
000192r 3               .global EDITUI_PRINT_COLOR
000192r 3               .global EDITUI_HOT_COLOR
000192r 3               .global EDITUI_MENU_CMD
000192r 3               .global EDITUI_MENU_SELECTED
000192r 3               
000192r 3               ; Save-under region rectangle (generic overlay save/restore for dialogs).
000192r 3               .global EDITUI_MENU_SAVE_X
000192r 3               .global EDITUI_MENU_SAVE_Y
000192r 3               .global EDITUI_MENU_SAVE_W
000192r 3               .global EDITUI_MENU_SAVE_H
000192r 3               
000192r 3               .global editui_init
000192r 3               .global editui_full_region
000192r 3               .global editui_clear_screen
000192r 3               .global editui_shutdown
000192r 3               .global editui_draw_shell
000192r 3               .global editui_draw_title_band
000192r 3               .global editui_refresh_dirty
000192r 3               .global editui_draw_status
000192r 3               .global editui_draw_box
000192r 3               .global editui_select_box_body
000192r 3               .global editui_print_ptr
000192r 3               .global editui_print_marked
000192r 3               .global editui_menu_open_hotkey
000192r 3               .global editui_set_menus
000192r 3               .global editui_save_under
000192r 3               .global editui_restore_under
000192r 3               
000192r 3               .global editui_default_menus
000192r 3               
000192r 3               .endif
000192r 3               
000192r 2               
000192r 2               .ifndef EDITBUF_IMPLEMENTATION_INCLUDED
000192r 2               EDITBUF_IMPLEMENTATION_INCLUDED = 1
000192r 2               
000192r 2               ; =====================================================================
000192r 2               ; ZEROPAGE — editor working pointers
000192r 2               ; =====================================================================
000192r 2                     .segment "ZEROPAGE"
00000Er 2               
00000Er 2  xx           EB_SRCL:        .res 1
00000Fr 2  xx           EB_SRCH:        .res 1
000010r 2  xx           EB_DSTL:        .res 1
000011r 2  xx           EB_DSTH:        .res 1
000012r 2  xx           EDITBUF_CNTL:   .res 1
000013r 2  xx           EDITBUF_CNTH:   .res 1
000014r 2  xx           EB_PL:          .res 1
000015r 2  xx           EB_PH:          .res 1
000016r 2  xx xx        EDITBUF_HL_PTR: .res 2
000018r 2  xx           EB_T0:          .res 1
000019r 2  xx           EB_T1:          .res 1
00001Ar 2  xx           EB_RUNL:        .res 1       ; VRAM-port run pointer (render_row)
00001Br 2  xx           EB_RUNH:        .res 1
00001Cr 2               
00001Cr 2               ; =====================================================================
00001Cr 2               ; BSS — config, state, buffers
00001Cr 2               ; =====================================================================
00001Cr 2                     .segment "BSS"
00008Fr 2               
00008Fr 2               ; --- config (host-set) ---
00008Fr 2  xx           EDITBUF_BUFL:       .res 1
000090r 2  xx           EDITBUF_BUFH:       .res 1
000091r 2  xx           EDITBUF_CAPL:       .res 1
000092r 2  xx           EDITBUF_CAPH:       .res 1
000093r 2  xx           EDITBUF_LENL:       .res 1
000094r 2  xx           EDITBUF_LENH:       .res 1
000095r 2  xx           EDITBUF_TITLEL:     .res 1
000096r 2  xx           EDITBUF_TITLEH:     .res 1
000097r 2  xx           EDITBUF_STATUSL:    .res 1
000098r 2  xx           EDITBUF_STATUSH:    .res 1
000099r 2  xx           EDITBUF_SAVE_VECL:  .res 1
00009Ar 2  xx           EDITBUF_SAVE_VECH:  .res 1
00009Br 2  xx           EDITBUF_INDENT_VECL:.res 1
00009Cr 2  xx           EDITBUF_INDENT_VECH:.res 1
00009Dr 2  xx           EDITBUF_HILITE_VECL:.res 1
00009Er 2  xx           EDITBUF_HILITE_VECH:.res 1
00009Fr 2  xx           EDITBUF_MENU_VECL:  .res 1
0000A0r 2  xx           EDITBUF_MENU_VECH:  .res 1
0000A1r 2               
0000A1r 2               ; --- state ---
0000A1r 2  xx           EDITBUF_RESULT:     .res 1
0000A2r 2  xx           EDITBUF_CURL:       .res 1       ; cursor byte offset (16-bit)
0000A3r 2  xx           EDITBUF_CURH:       .res 1
0000A4r 2  xx           EB_TOPLINEL:        .res 1       ; first visible line (16-bit)
0000A5r 2  xx           EB_TOPLINEH:        .res 1
0000A6r 2  xx           EB_LEFTCOL:         .res 1       ; first visible column (h-scroll)
0000A7r 2  xx           EB_SELL:            .res 1       ; selection anchor offset (16-bit)
0000A8r 2  xx           EB_SELH:            .res 1
0000A9r 2  xx           EDITBUF_SELACT:     .res 1       ; selection active flag
0000AAr 2  xx           EB_GOALCOL:         .res 1       ; sticky column for up/down
0000ABr 2  xx           EB_CURLINEL:        .res 1       ; computed cursor line (16-bit)
0000ACr 2  xx           EB_CURLINEH:        .res 1
0000ADr 2  xx           EB_CURCOL:          .res 1       ; computed cursor column
0000AEr 2               
0000AEr 2               ; --- render / nav scratch ---
0000AEr 2  xx           EB_ROW:             .res 1
0000AFr 2  xx           EB_COL:             .res 1
0000B0r 2  xx           EB_PAINTSTART:      .res 1       ; first column painted by editbuf_render_row (0 = full)
0000B1r 2  xx           EB_EDITDELTA:       .res 1       ; cols left of cursor where an inline edit's changed run begins
0000B2r 2  xx           EB_LINEOFFL:        .res 1       ; offset of current line start (16-bit)
0000B3r 2  xx           EB_LINEOFFH:        .res 1
0000B4r 2  xx           EB_LINELEN:         .res 1       ; current line length (chars before \n)
0000B5r 2  xx           EB_VISLINEL:        .res 1       ; line number being rendered (16-bit)
0000B6r 2  xx           EB_VISLINEH:        .res 1
0000B7r 2  xx           EB_SELSTARTL:       .res 1       ; normalized selection start (16-bit)
0000B8r 2  xx           EB_SELSTARTH:       .res 1
0000B9r 2  xx           EB_SELENDL:         .res 1       ; normalized selection end (16-bit)
0000BAr 2  xx           EB_SELENDH:         .res 1
0000BBr 2  xx           EB_DLGSEL:          .res 1       ; dialog selected button
0000BCr 2  xx           EB_SCRATCHL:        .res 1
0000BDr 2  xx           EB_SCRATCHH:        .res 1
0000BEr 2  xx           EB_PREVTOPL:        .res 1       ; scroll snapshot for single-line repaint
0000BFr 2  xx           EB_PREVTOPH:        .res 1
0000C0r 2  xx           EB_PREVLEFT:        .res 1
0000C1r 2  xx           EB_PREVSEL:         .res 1       ; was a selection active before a cursor move
0000C2r 2  xx           EB_CELLL:           .res 1       ; plane offset of first painted cell (16-bit)
0000C3r 2  xx           EB_CELLH:           .res 1
0000C4r 2               
0000C4r 2               ; --- HILITE hook scratch ---
0000C4r 2  xx           EDITBUF_HL_LEN:     .res 1
0000C5r 2  xx xx xx xx  EDITBUF_HL_COLORS:  .res 80
0000C9r 2  xx xx xx xx  
0000CDr 2  xx xx xx xx  
000115r 2               
000115r 2               ; --- clipboard ---
000115r 2  xx           EDITBUF_CLIPLENL:   .res 1
000116r 2  xx           EDITBUF_CLIPLENH:   .res 1
000117r 2  xx xx xx xx  EDITBUF_CLIP:       .res EDITBUF_CLIP_CAP
00011Br 2  xx xx xx xx  
00011Fr 2  xx xx xx xx  
000217r 2               
000217r 2               ; =====================================================================
000217r 2               ; CODE
000217r 2               ; =====================================================================
000217r 2                     .segment "CODE"
0021ACr 2               
0021ACr 2                     .export editbuf_run
0021ACr 2                     .export editbuf_reset_state
0021ACr 2                     .export editbuf_dialog3
0021ACr 2               
0021ACr 2               ; ---------------------------------------------------------------------
0021ACr 2               ; editbuf_reset_state — clear cursor/scroll/selection for a new session.
0021ACr 2               ; Leaves the buffer text and EDITBUF_LEN untouched.
0021ACr 2               ; ---------------------------------------------------------------------
0021ACr 2               editbuf_reset_state:
0021ACr 2  9C rr rr           STZ   EDITBUF_CURL
0021AFr 2  9C rr rr           STZ   EDITBUF_CURH
0021B2r 2  9C rr rr           STZ   EB_TOPLINEL
0021B5r 2  9C rr rr           STZ   EB_TOPLINEH
0021B8r 2  9C rr rr           STZ   EB_LEFTCOL
0021BBr 2  9C rr rr           STZ   EB_SELL
0021BEr 2  9C rr rr           STZ   EB_SELH
0021C1r 2  9C rr rr           STZ   EDITBUF_SELACT
0021C4r 2  9C rr rr           STZ   EB_GOALCOL
0021C7r 2  60                 RTS
0021C8r 2               
0021C8r 2               ; ---------------------------------------------------------------------
0021C8r 2               ; editbuf_run — run the modal editor. Returns A = EDITBUF_RESULT.
0021C8r 2               ; ---------------------------------------------------------------------
0021C8r 2               editbuf_run:
0021C8r 2  20 rr rr           JSR   editbuf_init_vectors
0021CBr 2  20 rr rr           JSR   editui_init
0021CEr 2  20 rr rr           JSR   editbuf_call_menu          ; host customizes the menu for its runtime
0021D1r 2               
0021D1r 2                     ; Wire the EDITUI chrome to our title / help / status.
0021D1r 2  AD rr rr           LDA   EDITBUF_TITLEL
0021D4r 2  8D rr rr           STA   EDITUI_TITLEL
0021D7r 2  AD rr rr           LDA   EDITBUF_TITLEH
0021DAr 2  8D rr rr           STA   EDITUI_TITLEH
0021DDr 2  A9 rr              LDA   #<editbuf_help_text
0021DFr 2  8D rr rr           STA   EDITUI_HELPL
0021E2r 2  A9 rr              LDA   #>editbuf_help_text
0021E4r 2  8D rr rr           STA   EDITUI_HELPH
0021E7r 2  20 rr rr           JSR   editbuf_apply_status
0021EAr 2               
0021EAr 2                     ; Derive line/col + scroll from the host-provided initial cursor offset so
0021EAr 2                     ; the first render places the cursor correctly (EDITBUF_CUR may be nonzero;
0021EAr 2                     ; reset_state does not recompute EB_CURLINE/EB_CURCOL).
0021EAr 2  20 rr rr           JSR   editbuf_compute_linecol
0021EDr 2  20 rr rr           JSR   editbuf_adjust_scroll
0021F0r 2               
0021F0r 2  20 rr rr           JSR   editui_draw_shell
0021F3r 2  20 rr rr           JSR   editbuf_render
0021F6r 2               
0021F6r 2               @loop:
0021F6r 2  AD 0F A0           LDA   VGC_CHARIN
0021F9r 2  F0 FB              BEQ   @loop
0021FBr 2  20 rr rr           JSR   editbuf_dispatch_key
0021FEr 2  90 F6              BCC   @loop
002200r 2  AD rr rr           LDA   EDITBUF_RESULT
002203r 2  60                 RTS
002204r 2               
002204r 2               ; editbuf_dispatch_key — handle key in A. Returns carry set to exit the editor.
002204r 2               editbuf_dispatch_key:
002204r 2  C9 13              CMP   #EDITUI_KEY_CTRL_S
002206r 2  D0 05              BNE   :+
002208r 2  20 rr rr           JSR   editbuf_do_save
00220Br 2  18                 CLC
00220Cr 2  60                 RTS
00220Dr 2  C9 11        :     CMP   #EDITUI_KEY_CTRL_Q
00220Fr 2  D0 03              BNE   :+
002211r 2  4C rr rr           JMP   editbuf_do_quit          ; propagates carry (set = exit)
002214r 2  C9 03        :     CMP   #EDITUI_KEY_CTRL_C
002216r 2  D0 05              BNE   :+
002218r 2  20 rr rr           JSR   editbuf_copy
00221Br 2  18                 CLC
00221Cr 2  60                 RTS
00221Dr 2  C9 18        :     CMP   #EDITUI_KEY_CTRL_X
00221Fr 2  D0 05              BNE   :+
002221r 2  20 rr rr           JSR   editbuf_cut
002224r 2  18                 CLC
002225r 2  60                 RTS
002226r 2  C9 16        :     CMP   #EDITUI_KEY_CTRL_V
002228r 2  D0 05              BNE   :+
00222Ar 2  20 rr rr           JSR   editbuf_paste
00222Dr 2  18                 CLC
00222Er 2  60                 RTS
00222Fr 2  C9 01        :     CMP   #EDITUI_KEY_CTRL_A
002231r 2  D0 05              BNE   :+
002233r 2  20 rr rr           JSR   editbuf_select_all
002236r 2  18                 CLC
002237r 2  60                 RTS
002238r 2  C9 1C        :     CMP   #EDITUI_KEY_LEFT
00223Ar 2  D0 05              BNE   :+
00223Cr 2  20 rr rr           JSR   editbuf_move_left
00223Fr 2  18                 CLC
002240r 2  60                 RTS
002241r 2  C9 1D        :     CMP   #EDITUI_KEY_RIGHT
002243r 2  D0 05              BNE   :+
002245r 2  20 rr rr           JSR   editbuf_move_right
002248r 2  18                 CLC
002249r 2  60                 RTS
00224Ar 2  C9 1E        :     CMP   #EDITUI_KEY_UP
00224Cr 2  D0 05              BNE   :+
00224Er 2  20 rr rr           JSR   editbuf_move_up
002251r 2  18                 CLC
002252r 2  60                 RTS
002253r 2  C9 1F        :     CMP   #EDITUI_KEY_DOWN
002255r 2  D0 05              BNE   :+
002257r 2  20 rr rr           JSR   editbuf_move_down
00225Ar 2  18                 CLC
00225Br 2  60                 RTS
00225Cr 2  C9 02        :     CMP   #EDITUI_KEY_HOME
00225Er 2  D0 05              BNE   :+
002260r 2  20 rr rr           JSR   editbuf_move_home
002263r 2  18                 CLC
002264r 2  60                 RTS
002265r 2  C9 05        :     CMP   #EDITUI_KEY_END
002267r 2  D0 05              BNE   :+
002269r 2  20 rr rr           JSR   editbuf_move_end
00226Cr 2  18                 CLC
00226Dr 2  60                 RTS
00226Er 2  C9 10        :     CMP   #EDITUI_KEY_PGUP
002270r 2  D0 05              BNE   :+
002272r 2  20 rr rr           JSR   editbuf_page_up
002275r 2  18                 CLC
002276r 2  60                 RTS
002277r 2  C9 12        :     CMP   #EDITUI_KEY_PGDN
002279r 2  D0 05              BNE   :+
00227Br 2  20 rr rr           JSR   editbuf_page_down
00227Er 2  18                 CLC
00227Fr 2  60                 RTS
002280r 2  C9 0D        :     CMP   #EDITUI_KEY_ENTER
002282r 2  D0 05              BNE   :+
002284r 2  20 rr rr           JSR   editbuf_newline
002287r 2  18                 CLC
002288r 2  60                 RTS
002289r 2  C9 08        :     CMP   #EDITUI_KEY_BACKSPACE
00228Br 2  F0 04              BEQ   @bs
00228Dr 2  C9 14              CMP   #$14
00228Fr 2  D0 05              BNE   :+
002291r 2  20 rr rr     @bs:  JSR   editbuf_backspace
002294r 2  18                 CLC
002295r 2  60                 RTS
002296r 2  C9 7F        :     CMP   #EDITUI_KEY_DELETE
002298r 2  D0 05              BNE   :+
00229Ar 2  20 rr rr           JSR   editbuf_delete
00229Dr 2  18                 CLC
00229Er 2  60                 RTS
00229Fr 2  C9 20        :     CMP   #$20
0022A1r 2  90 07              BCC   @ignore
0022A3r 2  C9 7F              CMP   #$7F
0022A5r 2  B0 03              BCS   @ignore
0022A7r 2  20 rr rr           JSR   editbuf_insert_char
0022AAr 2               @ignore:
0022AAr 2  18                 CLC
0022ABr 2  60                 RTS
0022ACr 2               
0022ACr 2               ; ---------------------------------------------------------------------
0022ACr 2               ; editbuf_apply_status — point EDITUI status at host string, or default to the
0022ACr 2               ; key-hint help text (the status bar is where help now lives).
0022ACr 2               ; ---------------------------------------------------------------------
0022ACr 2               editbuf_apply_status:
0022ACr 2  AD rr rr           LDA   EDITBUF_STATUSL
0022AFr 2  0D rr rr           ORA   EDITBUF_STATUSH
0022B2r 2  D0 0B              BNE   @host
0022B4r 2  A9 rr              LDA   #<editbuf_help_text
0022B6r 2  8D rr rr           STA   EDITUI_STATUSL
0022B9r 2  A9 rr              LDA   #>editbuf_help_text
0022BBr 2  8D rr rr           STA   EDITUI_STATUSH
0022BEr 2  60                 RTS
0022BFr 2               @host:
0022BFr 2  AD rr rr           LDA   EDITBUF_STATUSL
0022C2r 2  8D rr rr           STA   EDITUI_STATUSL
0022C5r 2  AD rr rr           LDA   EDITBUF_STATUSH
0022C8r 2  8D rr rr           STA   EDITUI_STATUSH
0022CBr 2  60                 RTS
0022CCr 2               
0022CCr 2               ; =====================================================================
0022CCr 2               ; 16-bit pointer helpers
0022CCr 2               ; =====================================================================
0022CCr 2               
0022CCr 2               ; EB_PL/H = EDITBUF_BUF + (A:X)  where X=lo, A=hi offset
0022CCr 2               ; Input: X=offset lo, A=offset hi
0022CCr 2               editbuf_ptr_from_off:
0022CCr 2  48                 PHA
0022CDr 2  8A                 TXA
0022CEr 2  18                 CLC
0022CFr 2  6D rr rr           ADC   EDITBUF_BUFL
0022D2r 2  85 rr              STA   EB_PL
0022D4r 2  68                 PLA
0022D5r 2  6D rr rr           ADC   EDITBUF_BUFH
0022D8r 2  85 rr              STA   EB_PH
0022DAr 2  60                 RTS
0022DBr 2               
0022DBr 2               ; EB_SRC = EDITBUF_BUF + EB_SCRATCH(16)
0022DBr 2               editbuf_src_from_scratch:
0022DBr 2  18                 CLC
0022DCr 2  AD rr rr           LDA   EDITBUF_BUFL
0022DFr 2  6D rr rr           ADC   EB_SCRATCHL
0022E2r 2  85 rr              STA   EB_SRCL
0022E4r 2  AD rr rr           LDA   EDITBUF_BUFH
0022E7r 2  6D rr rr           ADC   EB_SCRATCHH
0022EAr 2  85 rr              STA   EB_SRCH
0022ECr 2  60                 RTS
0022EDr 2               
0022EDr 2               ; =====================================================================
0022EDr 2               ; Buffer mutation: make_gap / close_gap
0022EDr 2               ; =====================================================================
0022EDr 2               
0022EDr 2               ; editbuf_make_gap — open a gap of (EB_CNTL/H) bytes at cursor (EDITBUF_CUR),
0022EDr 2               ; shifting the tail [cur,len) upward. Assumes len+cnt <= cap (checked by caller).
0022EDr 2               ; After: EDITBUF_LEN += cnt. Bytes in the gap are left as-is (caller fills).
0022EDr 2               editbuf_make_gap:
0022EDr 2                     ; tailcount = LEN - CUR  -> EB_SCRATCH
0022EDr 2  38                 SEC
0022EEr 2  AD rr rr           LDA   EDITBUF_LENL
0022F1r 2  ED rr rr           SBC   EDITBUF_CURL
0022F4r 2  8D rr rr           STA   EB_SCRATCHL
0022F7r 2  AD rr rr           LDA   EDITBUF_LENH
0022FAr 2  ED rr rr           SBC   EDITBUF_CURH
0022FDr 2  8D rr rr           STA   EB_SCRATCHH
002300r 2                     ; if tailcount == 0, nothing to move
002300r 2  AD rr rr           LDA   EB_SCRATCHL
002303r 2  0D rr rr           ORA   EB_SCRATCHH
002306r 2  F0 63              BEQ   @grow
002308r 2                     ; src = BUF + (LEN-1); dst = BUF + (LEN-1+cnt); copy backwards tailcount bytes
002308r 2                     ; src offset = LEN-1
002308r 2  38                 SEC
002309r 2  AD rr rr           LDA   EDITBUF_LENL
00230Cr 2  E9 01              SBC   #1
00230Er 2  85 rr              STA   EB_T0
002310r 2  AD rr rr           LDA   EDITBUF_LENH
002313r 2  E9 00              SBC   #0
002315r 2  85 rr              STA   EB_T1
002317r 2                     ; EB_SRC = BUF + (EB_T1:EB_T0)
002317r 2  18                 CLC
002318r 2  AD rr rr           LDA   EDITBUF_BUFL
00231Br 2  65 rr              ADC   EB_T0
00231Dr 2  85 rr              STA   EB_SRCL
00231Fr 2  AD rr rr           LDA   EDITBUF_BUFH
002322r 2  65 rr              ADC   EB_T1
002324r 2  85 rr              STA   EB_SRCH
002326r 2                     ; dst offset = LEN-1+cnt
002326r 2  18                 CLC
002327r 2  A5 rr              LDA   EB_T0
002329r 2  65 rr              ADC   EDITBUF_CNTL
00232Br 2  85 rr              STA   EB_DSTL
00232Dr 2  A5 rr              LDA   EB_T1
00232Fr 2  65 rr              ADC   EDITBUF_CNTH
002331r 2  85 rr              STA   EB_DSTH
002333r 2  18                 CLC
002334r 2  AD rr rr           LDA   EDITBUF_BUFL
002337r 2  65 rr              ADC   EB_DSTL
002339r 2  85 rr              STA   EB_DSTL
00233Br 2  AD rr rr           LDA   EDITBUF_BUFH
00233Er 2  65 rr              ADC   EB_DSTH
002340r 2  85 rr              STA   EB_DSTH
002342r 2               @bloop:
002342r 2  A0 00              LDY   #0
002344r 2  B1 rr              LDA   (EB_SRCL),Y
002346r 2  91 rr              STA   (EB_DSTL),Y
002348r 2                     ; dec src, dst ptrs
002348r 2  A5 rr              LDA   EB_SRCL
00234Ar 2  D0 02              BNE   :+
00234Cr 2  C6 rr              DEC   EB_SRCH
00234Er 2  C6 rr        :     DEC   EB_SRCL
002350r 2  A5 rr              LDA   EB_DSTL
002352r 2  D0 02              BNE   :+
002354r 2  C6 rr              DEC   EB_DSTH
002356r 2  C6 rr        :     DEC   EB_DSTL
002358r 2                     ; dec tailcount
002358r 2  AD rr rr           LDA   EB_SCRATCHL
00235Br 2  D0 03              BNE   :+
00235Dr 2  CE rr rr           DEC   EB_SCRATCHH
002360r 2  CE rr rr     :     DEC   EB_SCRATCHL
002363r 2  AD rr rr           LDA   EB_SCRATCHL
002366r 2  0D rr rr           ORA   EB_SCRATCHH
002369r 2  D0 D7              BNE   @bloop
00236Br 2               @grow:
00236Br 2  18                 CLC
00236Cr 2  AD rr rr           LDA   EDITBUF_LENL
00236Fr 2  65 rr              ADC   EDITBUF_CNTL
002371r 2  8D rr rr           STA   EDITBUF_LENL
002374r 2  AD rr rr           LDA   EDITBUF_LENH
002377r 2  65 rr              ADC   EDITBUF_CNTH
002379r 2  8D rr rr           STA   EDITBUF_LENH
00237Cr 2  60                 RTS
00237Dr 2               
00237Dr 2               ; editbuf_close_gap — remove (EB_CNTL/H) bytes starting at offset EB_SCRATCH,
00237Dr 2               ; shifting the tail down. After: EDITBUF_LEN -= cnt.
00237Dr 2               ; Input: EB_SCRATCH = start offset; EB_CNT = count to remove.
00237Dr 2               editbuf_close_gap:
00237Dr 2                     ; dst = BUF + start ; src = BUF + start + cnt
00237Dr 2  AD rr rr           LDA   EDITBUF_BUFL
002380r 2  18                 CLC
002381r 2  6D rr rr           ADC   EB_SCRATCHL
002384r 2  85 rr              STA   EB_DSTL
002386r 2  AD rr rr           LDA   EDITBUF_BUFH
002389r 2  6D rr rr           ADC   EB_SCRATCHH
00238Cr 2  85 rr              STA   EB_DSTH
00238Er 2  18                 CLC
00238Fr 2  A5 rr              LDA   EB_DSTL
002391r 2  65 rr              ADC   EDITBUF_CNTL
002393r 2  85 rr              STA   EB_SRCL
002395r 2  A5 rr              LDA   EB_DSTH
002397r 2  65 rr              ADC   EDITBUF_CNTH
002399r 2  85 rr              STA   EB_SRCH
00239Br 2                     ; movecount = LEN - (start + cnt)
00239Br 2  18                 CLC
00239Cr 2  AD rr rr           LDA   EB_SCRATCHL
00239Fr 2  65 rr              ADC   EDITBUF_CNTL
0023A1r 2  85 rr              STA   EB_T0
0023A3r 2  AD rr rr           LDA   EB_SCRATCHH
0023A6r 2  65 rr              ADC   EDITBUF_CNTH
0023A8r 2  85 rr              STA   EB_T1
0023AAr 2  38                 SEC
0023ABr 2  AD rr rr           LDA   EDITBUF_LENL
0023AEr 2  E5 rr              SBC   EB_T0
0023B0r 2  8D rr rr           STA   EB_SCRATCHL          ; reuse scratch as movecount
0023B3r 2  AD rr rr           LDA   EDITBUF_LENH
0023B6r 2  E5 rr              SBC   EB_T1
0023B8r 2  8D rr rr           STA   EB_SCRATCHH
0023BBr 2  AD rr rr           LDA   EB_SCRATCHL
0023BEr 2  0D rr rr           ORA   EB_SCRATCHH
0023C1r 2  F0 25              BEQ   @shrink
0023C3r 2               @floop:
0023C3r 2  A0 00              LDY   #0
0023C5r 2  B1 rr              LDA   (EB_SRCL),Y
0023C7r 2  91 rr              STA   (EB_DSTL),Y
0023C9r 2  E6 rr              INC   EB_SRCL
0023CBr 2  D0 02              BNE   :+
0023CDr 2  E6 rr              INC   EB_SRCH
0023CFr 2  E6 rr        :     INC   EB_DSTL
0023D1r 2  D0 02              BNE   :+
0023D3r 2  E6 rr              INC   EB_DSTH
0023D5r 2  AD rr rr     :     LDA   EB_SCRATCHL
0023D8r 2  D0 03              BNE   :+
0023DAr 2  CE rr rr           DEC   EB_SCRATCHH
0023DDr 2  CE rr rr     :     DEC   EB_SCRATCHL
0023E0r 2  AD rr rr           LDA   EB_SCRATCHL
0023E3r 2  0D rr rr           ORA   EB_SCRATCHH
0023E6r 2  D0 DB              BNE   @floop
0023E8r 2               @shrink:
0023E8r 2  38                 SEC
0023E9r 2  AD rr rr           LDA   EDITBUF_LENL
0023ECr 2  E5 rr              SBC   EDITBUF_CNTL
0023EEr 2  8D rr rr           STA   EDITBUF_LENL
0023F1r 2  AD rr rr           LDA   EDITBUF_LENH
0023F4r 2  E5 rr              SBC   EDITBUF_CNTH
0023F6r 2  8D rr rr           STA   EDITBUF_LENH
0023F9r 2  60                 RTS
0023FAr 2               
0023FAr 2               ; =====================================================================
0023FAr 2               ; Editing operations
0023FAr 2               ; =====================================================================
0023FAr 2               
0023FAr 2               ; editbuf_insert_char — insert A at cursor (if room). Marks dirty, re-renders.
0023FAr 2               editbuf_insert_char:
0023FAr 2  48                 PHA
0023FBr 2  20 rr rr           JSR   editbuf_clear_selection
0023FEr 2                     ; room? LEN < CAP
0023FEr 2  20 rr rr           JSR   editbuf_has_room
002401r 2  90 25              BCC   @full
002403r 2  A9 01              LDA   #1
002405r 2  85 rr              STA   EDITBUF_CNTL
002407r 2  64 rr              STZ   EDITBUF_CNTH
002409r 2  20 rr rr           JSR   editbuf_make_gap
00240Cr 2                     ; store char at cursor
00240Cr 2  AE rr rr           LDX   EDITBUF_CURL
00240Fr 2  AD rr rr           LDA   EDITBUF_CURH
002412r 2  20 rr rr           JSR   editbuf_ptr_from_off
002415r 2  68                 PLA
002416r 2  A0 00              LDY   #0
002418r 2  91 rr              STA   (EB_PL),Y
00241Ar 2                     ; cursor++
00241Ar 2  20 rr rr           JSR   editbuf_cursor_inc
00241Dr 2  20 rr rr           JSR   editbuf_mark_dirty
002420r 2  A9 01              LDA   #1                     ; insert: changed run starts one col left of cursor
002422r 2  8D rr rr           STA   EB_EDITDELTA
002425r 2  4C rr rr           JMP   editbuf_after_inline_edit
002428r 2               @full:
002428r 2  68                 PLA
002429r 2  60                 RTS
00242Ar 2               
00242Ar 2               ; editbuf_newline — insert a \n at cursor, then auto-indent via hook.
00242Ar 2               editbuf_newline:
00242Ar 2  20 rr rr           JSR   editbuf_clear_selection
00242Dr 2  20 rr rr           JSR   editbuf_has_room
002430r 2  90 4C              BCC   @full
002432r 2  A9 01              LDA   #1
002434r 2  85 rr              STA   EDITBUF_CNTL
002436r 2  64 rr              STZ   EDITBUF_CNTH
002438r 2  20 rr rr           JSR   editbuf_make_gap
00243Br 2  AE rr rr           LDX   EDITBUF_CURL
00243Er 2  AD rr rr           LDA   EDITBUF_CURH
002441r 2  20 rr rr           JSR   editbuf_ptr_from_off
002444r 2  A9 0A              LDA   #$0A
002446r 2  A0 00              LDY   #0
002448r 2  91 rr              STA   (EB_PL),Y
00244Ar 2  20 rr rr           JSR   editbuf_cursor_inc
00244Dr 2  20 rr rr           JSR   editbuf_mark_dirty
