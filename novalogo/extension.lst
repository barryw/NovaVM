0013B8r 3               EDITUI_KEY_CTRL_Z    = $1A
0013B8r 3               
0013B8r 3               ; Editing navigation keys (defined by Nova; the host keyboard maps physical
0013B8r 3               ; Home/End/PgUp/PgDn to these bytes).
0013B8r 3               EDITUI_KEY_HOME      = $02
