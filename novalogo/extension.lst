000000r 1               ; extension.s — NovaLogo extension ROM
000000r 1               ; Loaded at $C000 when swapped via REG_ROMSWAP = ROMSWAP_EXTENSION ($04).
000000r 1               ;
000000r 1               ; Entry point at $C000: reads EXT_CMD from zero page and dispatches.
000000r 1               ; Handlers receive pre-evaluated arguments in EXT_ARG0..2 and return
000000r 1               ; results in EXT_RESULT. No callbacks into the base ROM interpreter.
000000r 1               
000000r 1                     .include "nova.inc"
000000r 2               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
000000r 2               ;
000000r 2               ; This include is deliberately guarded per symbol so it can coexist with older
000000r 2               ; source files that still define a subset of these names locally.
000000r 2               
000000r 2               .ifndef NOVA_INC_INCLUDED
000000r 2               NOVA_INC_INCLUDED = 1
000000r 2               
000000r 2               ; Nova pseudo-register mailbox. These bytes are available to callers and
000000r 2               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
000000r 2               ; clobber them unless its documentation explicitly says otherwise; persistent
000000r 2               ; library state must be allocated in a linker segment such as BSS/ZEROPAGE.
000000r 2               .ifndef NVR0L
000000r 2               NVR0L             = $20
000000r 2               .endif
000000r 2               .ifndef NVR0H
000000r 2               NVR0H             = $21
000000r 2               .endif
