001745r 3  9C 98 BA           STZ   BLT_CKEY
001748r 3  A5 rr              LDA   VTEXT_ADDRL
00174Ar 3  8D 8B BA           STA   BLT_DSTL
00174Dr 3  A5 rr              LDA   VTEXT_ADDRH
00174Fr 3  8D 8C BA           STA   BLT_DSTM
001752r 3  9C 8D BA           STZ   BLT_DSTH
001755r 3  AD rr rr           LDA   VTEXT_WIDTH
001758r 3  8D 8E BA           STA   BLT_WIDTHL
00175Br 3  9C 8F BA           STZ   BLT_WIDTHH
00175Er 3  8E 90 BA           STX   BLT_HEIGHTL
001761r 3  9C 91 BA           STZ   BLT_HEIGHTH
001764r 3  A9 50              LDA   #<VTEXT_SCREEN_COLS
001766r 3  8D 94 BA           STA   BLT_DSTSTRL
001769r 3  A9 00              LDA   #>VTEXT_SCREEN_COLS
00176Br 3  8D 95 BA           STA   BLT_DSTSTRH
00176Er 3  A5 rr              LDA   VTEXT_TMP
001770r 3  8D 97 BA           STA   BLT_FILLVALUE
001773r 3  20 rr rr           JSR   blitter_start_fill
001776r 3  4C rr rr           JMP   vtext_blitter_result
001779r 3               
