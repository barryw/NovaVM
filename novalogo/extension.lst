000C6Ar 3               .global VSPRITE_SCENE_XL
000C6Ar 3               ; @label VSPRITE.SCENE_XH
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_XH
000C6Ar 3               ; @summary High byte of the graphics-plane dirty rectangle X coordinate for atomic scene commits.
000C6Ar 3               .global VSPRITE_SCENE_XH
000C6Ar 3               ; @label VSPRITE.SCENE_Y
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_Y
000C6Ar 3               ; @summary Graphics-plane dirty rectangle Y coordinate for atomic scene commits.
000C6Ar 3               .global VSPRITE_SCENE_Y
000C6Ar 3               ; @label VSPRITE.SCENE_WIDTHL
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_WIDTHL
000C6Ar 3               ; @summary Low byte of the dirty rectangle width for atomic scene commits.
000C6Ar 3               .global VSPRITE_SCENE_WIDTHL
000C6Ar 3               ; @label VSPRITE.SCENE_WIDTHH
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_WIDTHH
000C6Ar 3               ; @summary High byte of the dirty rectangle width for atomic scene commits.
000C6Ar 3               .global VSPRITE_SCENE_WIDTHH
000C6Ar 3               ; @label VSPRITE.SCENE_HEIGHTL
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_HEIGHTL
000C6Ar 3               ; @summary Low byte of the dirty rectangle height for atomic scene commits.
000C6Ar 3               .global VSPRITE_SCENE_HEIGHTL
000C6Ar 3               ; @label VSPRITE.SCENE_HEIGHTH
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_HEIGHTH
000C6Ar 3               ; @summary High byte of the dirty rectangle height for atomic scene commits.
000C6Ar 3               .global VSPRITE_SCENE_HEIGHTH
000C6Ar 3               ; @label VSPRITE.SCENE_WORKSPACE
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_WORKSPACE
000C6Ar 3               ; @summary Blitter memory space for the atomic scene work buffer.
000C6Ar 3               .global VSPRITE_SCENE_WORKSPACE
000C6Ar 3               ; @label VSPRITE.SCENE_WORKADDRL
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_WORKADDRL
000C6Ar 3               ; @summary Low byte of the atomic scene work buffer address.
