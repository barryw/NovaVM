000E7Dr 2                     ; fall through
000E7Dr 2               
000E7Dr 2               ; editui_save_under — capture the three text planes under the rectangle in
000E7Dr 2               ; EDITUI_MENU_SAVE_X/Y/W/H into the save buffers; sets EDITUI_MENU_SAVE_VALID.
000E7Dr 2               ; Reusable by dialogs and any overlapping overlay, not just menus.
000E7Dr 2               editui_save_under:
000E7Dr 2  9C rr rr           STZ   EDITUI_MENU_SAVE_VALID
000E80r 2  AD rr rr           LDA   EDITUI_MENU_SAVE_W
000E83r 2  F0 35              BEQ   @done
