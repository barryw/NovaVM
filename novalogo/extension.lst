000A67r 3               
000A67r 2               .include "copper.s"
000A67r 3               ; Shared Nova copper helper routines.
000A67r 3               ;
000A67r 3               ; Assembly ABI:
000A67r 3               ;   copper_add expects VGC_P0/P1=x, VGC_P2=y, VGC_P3/P4=register/index,
000A67r 3               ;   VGC_P5=value. COPPER_REG_* constants cover common VGC register indices.
000A67r 3               
000A67r 3               .include "copper.inc"
000A67r 4               ; Shared Nova copper helper declarations.
000A67r 4               
000A67r 4               .ifndef COPPER_INC_INCLUDED
000A67r 4               COPPER_INC_INCLUDED = 1
000A67r 4               
000A67r 4               .include "vgc.inc"
000A67r 4               
000A67r 4               COPPER_RESULT_OK    = $00
000A67r 4               COPPER_RESULT_ERROR = $01
000A67r 4               
000A67r 4               COPPER_REG_MODE     = $00
000A67r 4               COPPER_REG_BGCOL    = $01
000A67r 4               COPPER_REG_SCROLLX  = $05
000A67r 4               COPPER_REG_SCROLLY  = $06
000A67r 4               
000A67r 4               .endif
000A67r 4               
000A67r 3               
000A67r 3               .ifndef COPPER_IMPLEMENTATION_INCLUDED
000A67r 3               COPPER_IMPLEMENTATION_INCLUDED = 1
000A67r 3               
000A67r 3                     .segment "CODE"
000A67r 3               
000A67r 3                     .export copper_command
000A67r 3                     .export copper_clear
000A67r 3                     .export copper_on
000A67r 3                     .export copper_off
000A67r 3                     .export copper_list
000A67r 3                     .export copper_list_end
000A67r 3                     .export copper_use
000A67r 3                     .export copper_add
000A67r 3                     .export copper_set_reg_index
000A67r 3                     .export copper_set_sprite_reg
000A67r 3               
000A67r 3               ; Input: A = copper VGC command. Does not wait for completion.
000A67r 3               ; @label COPPER.COMMAND
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_command
000A67r 3               ; @summary Issue a raw copper VGC command.
000A67r 3               ; @in A: Copper VGC command byte.
000A67r 3               copper_command:
000A67r 3                     STA   VGC_CMD
000A67r 3                     LDA   #COPPER_RESULT_OK
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label COPPER.CLEAR
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_clear
000A67r 3               ; @summary Clear the active copper list.
000A67r 3               copper_clear:
000A67r 3                     LDA   #VCMD_COPPERCLR
000A67r 3                     JMP   copper_command
000A67r 3               
000A67r 3               ; @label COPPER.ON
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_on
000A67r 3               ; @summary Enable copper execution.
000A67r 3               copper_on:
000A67r 3                     LDA   #VCMD_COPPERENA
000A67r 3                     JMP   copper_command
000A67r 3               
000A67r 3               ; @label COPPER.OFF
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_off
000A67r 3               ; @summary Disable copper execution.
000A67r 3               copper_off:
000A67r 3                     LDA   #VCMD_COPPERDIS
000A67r 3                     JMP   copper_command
000A67r 3               
000A67r 3               ; @label COPPER.LIST
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_list
000A67r 3               ; @summary Select a copper list using VGC.P0.
000A67r 3               ; @requires VGC_P0
000A67r 3               copper_list:
000A67r 3                     LDA   #VCMD_COPPERLIST
000A67r 3                     JMP   copper_command
000A67r 3               
000A67r 3               ; @label COPPER.LIST_END
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_list_end
000A67r 3               ; @summary Finish the current copper list.
000A67r 3               copper_list_end:
000A67r 3                     LDA   #VCMD_COPPEREND
000A67r 3                     JMP   copper_command
000A67r 3               
000A67r 3               ; @label COPPER.USE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_use
000A67r 3               ; @summary Activate a copper list using VGC.P0.
000A67r 3               ; @requires VGC_P0
000A67r 3               copper_use:
000A67r 3                     LDA   #VCMD_COPPERUSE
000A67r 3                     JMP   copper_command
000A67r 3               
000A67r 3               ; @label COPPER.ADD
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_add
000A67r 3               ; @summary Add a copper operation using VGC.P0..VGC.P5.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5
000A67r 3               copper_add:
000A67r 3                     LDA   #VCMD_COPPERADD
000A67r 3                     JMP   copper_command
000A67r 3               
000A67r 3               ; Input: A = direct VGC register index. Output: VGC_P3/P4 updated.
000A67r 3               ; @label COPPER.SET_REG_INDEX
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_set_reg_index
000A67r 3               ; @summary Set VGC.P3/P4 to a direct VGC register index.
000A67r 3               ; @in A: VGC register index.
000A67r 3               copper_set_reg_index:
000A67r 3                     STA   VGC_P3
000A67r 3                     STZ   VGC_P4
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; Input: X = sprite index, A = VGC_SPR_*_OFF field.
000A67r 3               ; Output: VGC_P3/P4 = absolute sprite register address.
000A67r 3               ; Clobbers: A, NVR7L.
000A67r 3               ; @label COPPER.SET_SPRITE_REG
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_set_sprite_reg
000A67r 3               ; @summary Set VGC.P3/P4 to a sprite attribute register address.
000A67r 3               ; @in X: Sprite index.
000A67r 3               ; @in A: Sprite field offset.
000A67r 3               copper_set_sprite_reg:
000A67r 3                     STA   NVR7L
000A67r 3                     TXA
000A67r 3                     ASL
000A67r 3                     ASL
000A67r 3                     ASL
000A67r 3                     CLC
000A67r 3                     ADC   NVR7L
000A67r 3                     CLC
000A67r 3                     ADC   #<VGC_SPR_BASE
000A67r 3                     STA   VGC_P3
000A67r 3                     LDA   #>VGC_SPR_BASE
000A67r 3                     ADC   #$00
000A67r 3                     STA   VGC_P4
000A67r 3                     RTS
000A67r 3               
000A67r 3               .endif
000A67r 3               
000A67r 2               
000A67r 2               .ifndef COPPER_SPLIT_IMPLEMENTATION_INCLUDED
000A67r 2               COPPER_SPLIT_IMPLEMENTATION_INCLUDED = 1
000A67r 2               
000A67r 2                     .segment "CODE"
000A67r 2               
000A67r 2                     .export copper_split_mode
000A67r 2               
000A67r 2               ; Configure one copper list with two VGC_MODE rules:
000A67r 2               ;   line 0       -> VGC_P2 mode
000A67r 2               ;   VGC_P1 line -> VGC_P3 mode
000A67r 2               ; Clobbers A and NVR4L..NVR5H.
000A67r 2               copper_split_mode:
000A67r 2  AD 11 A0           LDA   VGC_P0
000A6Ar 2  85 28              STA   NVR4L
000A6Cr 2  AD 12 A0           LDA   VGC_P1
000A6Fr 2  85 29              STA   NVR4H
000A71r 2  AD 13 A0           LDA   VGC_P2
000A74r 2  85 2A              STA   NVR5L
000A76r 2  AD 14 A0           LDA   VGC_P3
000A79r 2  85 2B              STA   NVR5H
000A7Br 2               
000A7Br 2  20 rr rr           JSR   vgc_wait_cmd
000A7Er 2  20 rr rr           JSR   copper_off
000A81r 2               
000A81r 2  20 rr rr           JSR   vgc_wait_cmd
000A84r 2  A5 28              LDA   NVR4L
000A86r 2  8D 11 A0           STA   VGC_P0
000A89r 2  20 rr rr           JSR   copper_list
000A8Cr 2               
000A8Cr 2  20 rr rr           JSR   vgc_wait_cmd
000A8Fr 2  20 rr rr           JSR   copper_clear
000A92r 2               
000A92r 2  9C 11 A0           STZ   VGC_P0
000A95r 2  9C 12 A0           STZ   VGC_P1
000A98r 2  9C 13 A0           STZ   VGC_P2
000A9Br 2  A9 00              LDA   #COPPER_REG_MODE
000A9Dr 2  20 rr rr           JSR   copper_set_reg_index
000AA0r 2  A5 2A              LDA   NVR5L
000AA2r 2  8D 16 A0           STA   VGC_P5
000AA5r 2  20 rr rr           JSR   vgc_wait_cmd
000AA8r 2  20 rr rr           JSR   copper_add
000AABr 2               
000AABr 2  9C 11 A0           STZ   VGC_P0
000AAEr 2  9C 12 A0           STZ   VGC_P1
000AB1r 2  A5 29              LDA   NVR4H
000AB3r 2  8D 13 A0           STA   VGC_P2
000AB6r 2  A9 00              LDA   #COPPER_REG_MODE
000AB8r 2  20 rr rr           JSR   copper_set_reg_index
000ABBr 2  A5 2B              LDA   NVR5H
000ABDr 2  8D 16 A0           STA   VGC_P5
000AC0r 2  20 rr rr           JSR   vgc_wait_cmd
000AC3r 2  20 rr rr           JSR   copper_add
000AC6r 2               
000AC6r 2  20 rr rr           JSR   vgc_wait_cmd
000AC9r 2  A5 28              LDA   NVR4L
000ACBr 2  8D 11 A0           STA   VGC_P0
000ACEr 2  20 rr rr           JSR   copper_use
000AD1r 2               
000AD1r 2  20 rr rr           JSR   vgc_wait_cmd
000AD4r 2  20 rr rr           JSR   copper_on
000AD7r 2  A9 00              LDA   #COPPER_SPLIT_RESULT_OK
000AD9r 2  60                 RTS
000ADAr 2               
000ADAr 2               .endif
000ADAr 2               
000ADAr 1                     .include "vsprite.s"
000ADAr 2               ; Shared Nova virtual-sprite helper routines.
000ADAr 2               ;
000ADAr 2               ; The helpers intentionally expose a small blitter-shaped ABI. Runtimes can use
000ADAr 2               ; them for games, cursors, software sprites, board pieces, and any other
000ADAr 2               ; rectangular graphic that should not consume scarce hardware sprite slots.
000ADAr 2               ;
000ADAr 2               ; Moving virtual sprites should use the saved-background helpers instead of
000ADAr 2               ; redrawing their whole scene every frame. Save the graphics-plane rectangle
000ADAr 2               ; under the object, draw the object, restore the saved rectangle before moving,
000ADAr 2               ; then repeat at the new position.
000ADAr 2               
000ADAr 2               .include "vsprite.inc"
000ADAr 3               ; Shared Nova virtual-sprite helper declarations.
000ADAr 3               ;
000ADAr 3               ; A virtual sprite is a caller-owned rectangular pixel stamp copied by the
000ADAr 3               ; blitter into a VGC memory space. Unlike hardware sprites, the count is limited
000ADAr 3               ; by memory and redraw cost rather than VGC sprite registers.
000ADAr 3               ;
000ADAr 3               ; Transparency is split into two explicit layers:
000ADAr 3               ; - VSPRITE_COLORKEY controls which source byte VSPRITE.BLIT skips.
000ADAr 3               ; - VGC_GFXTRANS controls which color in the VGC graphics plane is transparent
000ADAr 3               ;   during final display composition.
000ADAr 3               ;
000ADAr 3               ; The default for both is 0. If a runtime needs visible black graphics-plane
000ADAr 3               ; pixels, choose another unused color as the transparent color, store it in
000ADAr 3               ; VGC_GFXTRANS, write that value into transparent source pixels, and set
000ADAr 3               ; VSPRITE_COLORKEY to the same value before a color-keyed blit.
000ADAr 3               ;
000ADAr 3               ; For moving objects, use the graphics-plane saved-background helpers in the
000ADAr 3               ; same style as an Amiga BOB:
000ADAr 3               ; 1. Set VSPRITE.X/Y, VSPRITE.WIDTH/HEIGHT, and VSPRITE.BG* to caller-owned RAM.
000ADAr 3               ; 2. Call VSPRITE.GFX_SAVE_BG before drawing the object.
000ADAr 3               ; 3. Draw with VSPRITE.GFX_BLIT.
000ADAr 3               ; 4. Before the next frame, call VSPRITE.GFX_RESTORE_BG at the saved X/Y, move
000ADAr 3               ;    the object, save the new background, and draw again.
000ADAr 3               ; Static objects that were not first drawn with a saved background must be
000ADAr 3               ; erased by the caller before entering this loop.
000ADAr 3               ;
000ADAr 3               ; For multiple moving virtual sprites, use the scene helpers instead of calling
000ADAr 3               ; the single-sprite save/restore loop for each object. A scene descriptor list
000ADAr 3               ; restores every old background first, lets the caller update positions, saves
000ADAr 3               ; every new background from the clean playfield, then draws the list in order.
000ADAr 3               ; List order is z-order: later descriptors draw in front of earlier ones.
000ADAr 3               ;
000ADAr 3               ; For scenes where multiple virtual sprites overlap or cross paths, use
000ADAr 3               ; VSPRITE.SCENE_COMMIT_ATOMIC. The caller supplies a dirty graphics rectangle
000ADAr 3               ; and a work buffer. The helper composes the clean old backgrounds and new
000ADAr 3               ; sprites into that offscreen buffer, then copies the completed rectangle to
000ADAr 3               ; the graphics plane as one visible blit. For a truly atomic visual update, the
000ADAr 3               ; final dirty rectangle must be small enough to fit in one vblank window.
000ADAr 3               ;
000ADAr 3               ; For in-place rotated virtual sprites on the transparent graphics plane, use
000ADAr 3               ; VSPRITE.GFX_ROTATE_BLIT. It rotates into VSPRITE.ROT* offscreen, then copies
000ADAr 3               ; the full rotated rectangle to graphics memory in one blit so old pixels are
000ADAr 3               ; cleared without a separate visible erase.
000ADAr 3               
000ADAr 3               .ifndef VSPRITE_INC_INCLUDED
000ADAr 3               VSPRITE_INC_INCLUDED = 1
000ADAr 3               
000ADAr 3               .include "blitter.inc"
000ADAr 3               .include "nova.inc"
000ADAr 3               
000ADAr 3               VSPRITE_RESULT_OK        = BLITTER_RESULT_OK
000ADAr 3               VSPRITE_RESULT_ERROR     = BLITTER_RESULT_ERROR
000ADAr 3               
000ADAr 3               ; @label VSPRITE.FLAG_COLORKEY
000ADAr 3               ; @kind const
000ADAr 3               ; @symbol VSPRITE_FLAG_COLORKEY
000ADAr 3               ; @summary Enable source color-key transparency for VSPRITE.BLIT and VSPRITE.GFX_BLIT.
000ADAr 3               VSPRITE_FLAG_COLORKEY    = $01
000ADAr 3               
000ADAr 3               ; @label VSPRITE.DESC_FLAG_COLORKEY
000ADAr 3               ; @kind const
000ADAr 3               ; @symbol VSPRITE_DESC_FLAG_COLORKEY
000ADAr 3               ; @summary Descriptor flag enabling source color-key transparency.
000ADAr 3               VSPRITE_DESC_FLAG_COLORKEY = VSPRITE_FLAG_COLORKEY
000ADAr 3               
000ADAr 3               ; @label VSPRITE.DESC_SAVED
000ADAr 3               ; @kind const
000ADAr 3               ; @symbol VSPRITE_DESC_SAVED
000ADAr 3               ; @summary Internal descriptor flag set when old X/Y has a saved background to restore.
000ADAr 3               VSPRITE_DESC_SAVED       = $40
000ADAr 3               
000ADAr 3               ; @label VSPRITE.DESC_VISIBLE
000ADAr 3               ; @kind const
000ADAr 3               ; @symbol VSPRITE_DESC_VISIBLE
000ADAr 3               ; @summary Descriptor flag enabling scene save/draw for this virtual sprite.
000ADAr 3               VSPRITE_DESC_VISIBLE     = $80
000ADAr 3               
000ADAr 3               VSPRITE_GFX_STRIDE       = 320
000ADAr 3               
000ADAr 3               ; Scene descriptor layout. Descriptors are caller-owned RAM because scene
000ADAr 3               ; helpers update OLD_* and SAVED as part of the frame protocol.
000ADAr 3               VSPRITE_DESC_FLAGS       = $00
000ADAr 3               VSPRITE_DESC_XL          = $01
000ADAr 3               VSPRITE_DESC_XH          = $02
000ADAr 3               VSPRITE_DESC_Y           = $03
000ADAr 3               VSPRITE_DESC_OLD_XL      = $04
000ADAr 3               VSPRITE_DESC_OLD_XH      = $05
000ADAr 3               VSPRITE_DESC_OLD_Y       = $06
000ADAr 3               VSPRITE_DESC_WIDTHL      = $07
000ADAr 3               VSPRITE_DESC_WIDTHH      = $08
000ADAr 3               VSPRITE_DESC_HEIGHTL     = $09
000ADAr 3               VSPRITE_DESC_HEIGHTH     = $0A
000ADAr 3               VSPRITE_DESC_SRCSPACE    = $0B
000ADAr 3               VSPRITE_DESC_SRCADDRL    = $0C
000ADAr 3               VSPRITE_DESC_SRCADDRM    = $0D
000ADAr 3               VSPRITE_DESC_SRCADDRH    = $0E
000ADAr 3               VSPRITE_DESC_SRCSTRL     = $0F
000ADAr 3               VSPRITE_DESC_SRCSTRH     = $10
000ADAr 3               VSPRITE_DESC_BGSPACE     = $11
000ADAr 3               VSPRITE_DESC_BGADDRL     = $12
000ADAr 3               VSPRITE_DESC_BGADDRM     = $13
000ADAr 3               VSPRITE_DESC_BGADDRH     = $14
000ADAr 3               VSPRITE_DESC_BGSTRL      = $15
000ADAr 3               VSPRITE_DESC_BGSTRH      = $16
000ADAr 3               VSPRITE_DESC_COLORKEY    = $17
000ADAr 3               VSPRITE_DESC_SIZE        = $18
000ADAr 3               
000ADAr 3               ; Assembly-facing state ABI. Callers set these before invoking the helpers.
000ADAr 3               ; @label VSPRITE.SRCSPACE
000ADAr 3               ; @kind u8
000ADAr 3               ; @symbol VSPRITE_SRCSPACE
000ADAr 3               ; @summary Blitter memory space for the virtual-sprite source rectangle.
000ADAr 3               .global VSPRITE_SRCSPACE
000ADAr 3               ; @label VSPRITE.DSTSPACE
000ADAr 3               ; @kind u8
000ADAr 3               ; @symbol VSPRITE_DSTSPACE
000ADAr 3               ; @summary Blitter memory space for the virtual-sprite destination rectangle.
000ADAr 3               .global VSPRITE_DSTSPACE
000ADAr 3               ; @label VSPRITE.SRCADDRL
