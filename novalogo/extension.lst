001923r 2               editui_center_ptr:
001923r 2  20 rr rr           JSR   editui_strlen
001926r 2  8D rr rr           STA   EDITUI_TMP
001929r 2  A9 50              LDA   #EDITUI_SCREEN_COLS
00192Br 2  38                 SEC
00192Cr 2  ED rr rr           SBC   EDITUI_TMP
00192Fr 2  4A                 LSR
001930r 2  8D rr rr           STA   EDITUI_PRINTX
001933r 2  4C rr rr           JMP   editui_print_ptr
001936r 2               
001936r 2               editui_print_at_2:
001936r 2  A9 02              LDA   #2
001938r 2  8D rr rr           STA   EDITUI_PRINTX
00193Br 2  4C rr rr           JMP   editui_print_ptr
00193Er 2               
00193Er 2               editui_draw_shell:
00193Er 2  20 rr rr           JSR   editui_clear_screen
001941r 2  20 rr rr           JSR   editui_draw_menu
001944r 2  4C rr rr           JMP   editui_draw_status
001947r 2               
