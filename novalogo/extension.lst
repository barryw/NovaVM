000092r 2               
000092r 1                     .include "editbuf.s"
000092r 2               ; editbuf.s — shared text-editing engine for Nova native tools.
000092r 2               ; See editbuf.inc for the public ABI and hook contracts. This module is
000092r 2               ; language-neutral; all host behavior arrives through the hook vectors.
000092r 2               
000092r 2               .include "editbuf.inc"
000092r 3               ; editbuf.inc — shared text-editing engine for Nova native tools.
000092r 3               ;
000092r 3               ; editbuf layers a real editable text buffer (cursor movement, insert/delete,
000092r 3               ; line navigation, selection, cut/copy/paste, scrolling) and a three-choice
000092r 3               ; modal dialog on top of the EDITUI chrome shell. It is intentionally
000092r 3               ; LANGUAGE-NEUTRAL: it knows nothing about Logo, BASIC, or any document model.
000092r 3               ;
000092r 3               ; Anything language-specific is supplied by the host through HOOK VECTORS:
000092r 3               ;   - SAVE hook   : invoked on Ctrl-S (and the dialog "Save First" choice).
000092r 3               ;                   The host validates/saves/installs and returns a status.
000092r 3               ;   - INDENT hook : invoked after Enter. The host returns how many leading
000092r 3               ;                   spaces the new line should start with (auto-indent).
000092r 3               ;   - HILITE hook : invoked per visible line during render. The host fills a
000092r 3               ;                   per-character color buffer (syntax highlighting).
000092r 3               ; Every hook defaults to a no-op, so editbuf works as a plain editor with no
000092r 3               ; host wiring at all.
000092r 3               ;
000092r 3               ; Calling convention: the host populates the EDITBUF_* config bytes below, then
000092r 3               ; calls editbuf_run. editbuf_run blocks until the user exits and returns the
000092r 3               ; exit reason in A (also EDITBUF_RESULT). The buffer text and EDITBUF_LEN are
000092r 3               ; left in place so the host can inspect / re-open the draft.
000092r 3               
000092r 3               .ifndef EDITBUF_INC_INCLUDED
000092r 3               EDITBUF_INC_INCLUDED = 1
000092r 3               
000092r 3               .include "editui.inc"
000092r 3               
000092r 3               ; ---------------------------------------------------------------------
000092r 3               ; Editor body geometry. Minimal full-screen layout (no frame, no title band):
000092r 3               ;   row 0          : menu bar (File/Edit/Help + title + dirty marker)
000092r 3               ;   rows 1..N-2    : editable body, full 80 columns
000092r 3               ;   row N-1        : status bar (help / status message)
000092r 3               ; ---------------------------------------------------------------------
000092r 3               EDITBUF_VIEW_LEFT   = 0                               ; first text column
000092r 3               EDITBUF_VIEW_TOP    = 1                               ; first text row (below menu bar)
000092r 3               EDITBUF_VIEW_COLS   = EDITUI_SCREEN_COLS              ; 80 visible columns
000092r 3               EDITBUF_VIEW_ROWS   = EDITUI_SCREEN_ROWS - 2          ; 48 (menu bar + status bar reserved)
000092r 3               
000092r 3               ; Clipboard capacity (bytes). Lives in editbuf BSS.
000092r 3               EDITBUF_CLIP_CAP    = 256
000092r 3               
000092r 3               ; ---------------------------------------------------------------------
000092r 3               ; Exit reason returned in A by editbuf_run (also stored in EDITBUF_RESULT).
000092r 3               ; ---------------------------------------------------------------------
000092r 3               EDITBUF_EXIT_QUIT    = $00      ; Ctrl-Q while clean
000092r 3               EDITBUF_EXIT_SAVED   = $01      ; left via dialog "Save First" after a clean save
000092r 3               EDITBUF_EXIT_DISCARD = $02      ; left via dialog "Exit Anyway" (draft preserved)
000092r 3               
000092r 3               ; ---------------------------------------------------------------------
000092r 3               ; SAVE hook contract.
000092r 3               ;   Called with no arguments (current text is in EDITBUF_BUF / EDITBUF_LEN).
000092r 3               ;   Returns status in A:
000092r 3               ; ---------------------------------------------------------------------
000092r 3               EDITBUF_SAVE_OK      = $00      ; saved + installed: clears dirty
000092r 3               EDITBUF_SAVE_DRAFT   = $01      ; draft kept but not usable: stays "dirty"-ish
000092r 3               EDITBUF_SAVE_ERROR   = $02      ; rejected: stays dirty
000092r 3               ; The host may point EDITBUF_STATUS at a message string before returning; the
000092r 3               ; editor redraws the status bar with it.
000092r 3               
000092r 3               ; ---------------------------------------------------------------------
000092r 3               ; INDENT hook contract.
000092r 3               ;   Called after a newline is inserted. The cursor sits at the start of the
000092r 3               ;   freshly created line. Returns in A the number of leading spaces to insert
000092r 3               ;   (0 = no auto-indent). editbuf inserts that many spaces.
000092r 3               ; ---------------------------------------------------------------------
000092r 3               
000092r 3               ; ---------------------------------------------------------------------
000092r 3               ; HILITE hook contract.
000092r 3               ;   Called once per visible line before it is drawn.
000092r 3               ;     EDITBUF_HL_PTR (zp) -> first byte of the line text (in EDITBUF_BUF)
000092r 3               ;     EDITBUF_HL_LEN       = line length in bytes (0..255, excludes the \n)
000092r 3               ;     EDITBUF_HL_COLORS    = 80-byte buffer the hook fills with one VGC color
000092r 3               ;                            byte per character. Pre-filled with the default
000092r 3               ;                            text color; the hook overwrites as needed.
000092r 3               ;   The hook returns nothing. If unset, the default color is used for all.
000092r 3               ; ---------------------------------------------------------------------
000092r 3               
000092r 3               ; Default editor colors (bg = high nibble, fg = low nibble; palette mode 0).
000092r 3               EDITBUF_COLOR_TEXT   = $01      ; white on black body
000092r 3               EDITBUF_COLOR_SEL    = $1F      ; selection: white bg, grey text
000092r 3               
000092r 3               ; --- Config (host sets before editbuf_run) -------------------------------
000092r 3               .global EDITBUF_BUFL          ; pointer to text buffer
000092r 3               .global EDITBUF_BUFH
000092r 3               .global EDITBUF_CAPL          ; capacity in bytes (16-bit)
000092r 3               .global EDITBUF_CAPH
000092r 3               .global EDITBUF_LENL          ; current length in bytes (16-bit)
000092r 3               .global EDITBUF_LENH
000092r 3               .global EDITBUF_TITLEL        ; NUL-terminated title string
000092r 3               .global EDITBUF_TITLEH
000092r 3               .global EDITBUF_STATUSL       ; NUL-terminated status message (may be 0)
000092r 3               .global EDITBUF_STATUSH
000092r 3               .global EDITBUF_SAVE_VECL     ; SAVE hook vector
000092r 3               .global EDITBUF_SAVE_VECH
000092r 3               .global EDITBUF_INDENT_VECL   ; INDENT hook vector
000092r 3               .global EDITBUF_INDENT_VECH
000092r 3               .global EDITBUF_HILITE_VECL   ; HILITE hook vector
000092r 3               .global EDITBUF_HILITE_VECH
000092r 3               .global EDITBUF_MENU_VECL     ; MENU-config hook vector
000092r 3               .global EDITBUF_MENU_VECH
000092r 3               
000092r 3               ; --- Result / observable state ------------------------------------------
000092r 3               .global EDITBUF_RESULT
000092r 3               .global EDITBUF_CURL          ; cursor byte offset (16-bit)
000092r 3               .global EDITBUF_CURH
000092r 3               
000092r 3               ; --- HILITE hook scratch (zp pointer + buffers) -------------------------
000092r 3               .global EDITBUF_HL_PTR        ; zp, 2 bytes
000092r 3               .global EDITBUF_HL_LEN
000092r 3               .global EDITBUF_HL_COLORS     ; 80-byte color buffer
000092r 3               
000092r 3               ; --- Entry points -------------------------------------------------------
000092r 3               .global editbuf_run           ; run the modal editor
000092r 3               .global editbuf_reset_state   ; reset cursor/scroll/selection/dirty for a new session
000092r 3               .global editbuf_dialog3       ; three-choice restore-under modal (A=result 0/1/2)
000092r 3               
000092r 3               ; Dialog choice result codes (returned by editbuf_dialog3 in A).
000092r 3               EDITBUF_DLG_EXIT   = $00       ; first button  (Exit Anyway)
000092r 3               EDITBUF_DLG_SAVE   = $01       ; second button (Save First)
000092r 3               EDITBUF_DLG_CANCEL = $02       ; third button  (Cancel)
000092r 3               
000092r 3               .endif
000092r 3               
000092r 2               .include "editui.inc"
000092r 3               ; Shared Nova editor-shell UI declarations.
000092r 3               ;
000092r 3               ; EDITUI is a small text-mode shell for native tools: menu bar, title/help
000092r 3               ; rows, framed panels, and status lines. Applications own input dispatch,
000092r 3               ; document state, and editor-specific drawing.
000092r 3               
000092r 3               .ifndef EDITUI_INC_INCLUDED
000092r 3               EDITUI_INC_INCLUDED = 1
000092r 3               
000092r 3               .include "vtext.inc"
000092r 3               
000092r 3               EDITUI_OK  = $00
000092r 3               EDITUI_ERR = $01
000092r 3               
000092r 3               EDITUI_SCREEN_COLS = VTEXT_SCREEN_COLS
000092r 3               EDITUI_SCREEN_ROWS = VTEXT_SCREEN_ROWS
000092r 3               
000092r 3               ; Black background with light-grey bars. bg = high nibble, fg = low nibble.
000092r 3               ; Palette mode 0: 0=black, 1=white, 2=red, 12=grey-med, 15=grey-light.
000092r 3               EDITUI_PALETTE_MODE     = $00
000092r 3               EDITUI_COLOR_BG         = $00      ; black
000092r 3               EDITUI_COLOR_FG         = $01      ; white
000092r 3               EDITUI_COLOR_SHELL      = $0F      ; editor background (black bg)
000092r 3               EDITUI_COLOR_TITLE      = $01      ; title text: white on black
000092r 3               EDITUI_COLOR_MENU       = $F0      ; light-grey menu bar, black text
000092r 3               EDITUI_COLOR_MENU_HOT   = $F2      ; light-grey bar, red hotkey
000092r 3               EDITUI_COLOR_FRAME      = $0F      ; grey frame lines on black
000092r 3               EDITUI_COLOR_DIM        = $0C      ; grey-med dim text on black
000092r 3               EDITUI_COLOR_MENU_SEL   = $1F      ; selected dropdown item: white bg
000092r 3               EDITUI_COLOR_MENU_SEL_HOT = $12    ; selected item hotkey
000092r 3               EDITUI_COLOR_STATUS     = $F0      ; light-grey status bar
000092r 3               EDITUI_COLOR_STATUS_HOT = $F6      ; status bar accent
000092r 3               EDITUI_COLOR_PANEL      = $0F      ; dialog panel: black bg
000092r 3               
000092r 3               EDITUI_STATUS_ROW = EDITUI_SCREEN_ROWS - 1
000092r 3               ; Dirty marker ('*') cell on the menu bar (right side). The title is drawn just
000092r 3               ; to its left; toggling the marker is a single-cell write.
000092r 3               EDITUI_DIRTY_COL  = EDITUI_SCREEN_COLS - 2
000092r 3               
000092r 3               EDITUI_BOX_SINGLE = $00
000092r 3               EDITUI_BOX_DOUBLE = $01
000092r 3               
000092r 3               ; CP437 box-drawing characters from Nova's default font.
000092r 3               EDITUI_CH_SINGLE_TL = $DA
000092r 3               EDITUI_CH_SINGLE_TR = $BF
000092r 3               EDITUI_CH_SINGLE_BL = $C0
000092r 3               EDITUI_CH_SINGLE_BR = $D9
000092r 3               EDITUI_CH_SINGLE_H  = $C4
000092r 3               EDITUI_CH_SINGLE_V  = $B3
000092r 3               EDITUI_CH_SINGLE_TITLE_L = $B4
000092r 3               EDITUI_CH_SINGLE_TITLE_R = $C3
000092r 3               EDITUI_CH_DOUBLE_TL = $C9
000092r 3               EDITUI_CH_DOUBLE_TR = $BB
000092r 3               EDITUI_CH_DOUBLE_BL = $C8
000092r 3               EDITUI_CH_DOUBLE_BR = $BC
000092r 3               EDITUI_CH_DOUBLE_H  = $CD
000092r 3               EDITUI_CH_DOUBLE_V  = $BA
000092r 3               EDITUI_CH_DOUBLE_TITLE_L = $B9
000092r 3               EDITUI_CH_DOUBLE_TITLE_R = $CC
000092r 3               EDITUI_CH_DOT       = $FA
000092r 3               
000092r 3               EDITUI_KEY_BACKSPACE = $08
000092r 3               EDITUI_KEY_TAB       = $09
000092r 3               EDITUI_KEY_ENTER     = $0D
000092r 3               EDITUI_KEY_ESC       = $1B
000092r 3               EDITUI_KEY_LEFT      = $1C
000092r 3               EDITUI_KEY_RIGHT     = $1D
000092r 3               EDITUI_KEY_UP        = $1E
000092r 3               EDITUI_KEY_DOWN      = $1F
000092r 3               EDITUI_KEY_DELETE    = $7F
000092r 3               EDITUI_KEY_ALT_PREFIX = EDITUI_KEY_ESC
000092r 3               
000092r 3               EDITUI_KEY_CTRL_A    = $01
000092r 3               EDITUI_KEY_CTRL_C    = $03
000092r 3               EDITUI_KEY_CTRL_N    = $0E
000092r 3               EDITUI_KEY_CTRL_O    = $0F
000092r 3               EDITUI_KEY_CTRL_Q    = $11
000092r 3               EDITUI_KEY_CTRL_S    = $13
000092r 3               EDITUI_KEY_CTRL_V    = $16
000092r 3               EDITUI_KEY_CTRL_W    = $17
000092r 3               EDITUI_KEY_CTRL_X    = $18
000092r 3               EDITUI_KEY_CTRL_Z    = $1A
000092r 3               
000092r 3               ; Editing navigation keys (defined by Nova; the host keyboard maps physical
000092r 3               ; Home/End/PgUp/PgDn to these bytes).
000092r 3               EDITUI_KEY_HOME      = $02
000092r 3               EDITUI_KEY_END       = $05
000092r 3               EDITUI_KEY_PGUP      = $10
000092r 3               EDITUI_KEY_PGDN      = $12
000092r 3               
000092r 3               EDITUI_CMD_NONE      = $00
000092r 3               EDITUI_CMD_NEW       = $01
000092r 3               EDITUI_CMD_OPEN      = $02
000092r 3               EDITUI_CMD_SAVE      = $03
000092r 3               EDITUI_CMD_SAVE_AS   = $04
000092r 3               EDITUI_CMD_QUIT      = $05
000092r 3               EDITUI_CMD_UNDO      = $06
000092r 3               EDITUI_CMD_CUT       = $07
000092r 3               EDITUI_CMD_COPY      = $08
