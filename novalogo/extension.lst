000000r 3               ; Black background with light-grey bars. bg = high nibble, fg = low nibble.
000000r 3               ; Palette mode 0: 0=black, 1=white, 2=red, 12=grey-med, 15=grey-light.
000000r 3               EDITUI_PALETTE_MODE     = $00
000000r 3               EDITUI_COLOR_BG         = $00      ; black
000000r 3               EDITUI_COLOR_FG         = $01      ; white
000000r 3               EDITUI_COLOR_SHELL      = $0F      ; editor background (black bg)
000000r 3               EDITUI_COLOR_TITLE      = $01      ; title text: white on black
000000r 3               EDITUI_COLOR_MENU       = $F0      ; light-grey menu bar, black text
000000r 3               EDITUI_COLOR_MENU_HOT   = $F2      ; light-grey bar, red hotkey
000000r 3               EDITUI_COLOR_FRAME      = $0F      ; grey frame lines on black
000000r 3               EDITUI_COLOR_DIM        = $0C      ; grey-med dim text on black
000000r 3               EDITUI_COLOR_MENU_SEL   = $1F      ; selected dropdown item: white bg
000000r 3               EDITUI_COLOR_MENU_SEL_HOT = $12    ; selected item hotkey
000000r 3               EDITUI_COLOR_STATUS     = $F0      ; light-grey status bar
000000r 3               EDITUI_COLOR_STATUS_HOT = $F6      ; status bar accent
000000r 3               EDITUI_COLOR_PANEL      = $0F      ; dialog panel: black bg
000000r 3               
000000r 3               EDITUI_STATUS_ROW = EDITUI_SCREEN_ROWS - 1
000000r 3               ; Dirty marker ('*') cell on the menu bar (right side). The title is drawn just
000000r 3               ; to its left; toggling the marker is a single-cell write.
000000r 3               EDITUI_DIRTY_COL  = EDITUI_SCREEN_COLS - 2
000000r 3               
000000r 3               EDITUI_BOX_SINGLE = $00
000000r 3               EDITUI_BOX_DOUBLE = $01
