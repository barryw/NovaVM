000297r 2               .include "vtext.s"
000297r 3               ; Shared NovaVM text-region runtime.
000297r 3               ;
000297r 3               ; Provides small rectangular text regions over the VGC char/color/attribute
000297r 3               ; planes. Domain runtimes such as NovaZ decide what a region means; this code
000297r 3               ; only clips, clears, writes, and scrolls rectangular text areas.
000297r 3               
000297r 3               .include "vtext.inc"
000297r 4               ; NovaVM shared text-region runtime interface.
000297r 4               ;
000297r 4               ; This layer is intentionally language-neutral. It knows about rectangular
000297r 4               ; regions over the VGC text planes, but not about BASIC, NovaZ, or Z-machine
000297r 4               ; window semantics.
000297r 4               ;
000297r 4               ; Calling convention:
000297r 4               ;   Region:      VTEXT_LEFT/TOP/WIDTH/HEIGHT state bytes
000297r 4               ;   Cursor:      VTEXT_CURX/CURY state bytes, relative to the current region.
000297r 4               ;                vtext_set_cursor and character output mirror this to the
000297r 4               ;                absolute VGC visible cursor registers.
000297r 4               ;   Cell attrs:  VTEXT_COLOR (packed bg/fg), VTEXT_ATTR (style bits)
000297r 4               ;   Character:   VTEXT_CHAR input byte
000297r 4               ;   Flags:       VTEXT_FLAGS state byte (wrap/scroll)
000297r 4               ;
000297r 4               ; Routines return A=0 on success and A=1 on error. X/Y are scratch unless a
000297r 4               ; routine explicitly documents otherwise.
000297r 4               
000297r 4               .ifndef VTEXT_INC_INCLUDED
000297r 4               VTEXT_INC_INCLUDED = 1
000297r 4               
000297r 4               .include "nova.inc"
000297r 4               
000297r 4               VTEXT_SCREEN_COLS = NOVA_SCREEN_COLS
000297r 4               VTEXT_SCREEN_ROWS = NOVA_SCREEN_ROWS
000297r 4               
000297r 4               VTEXT_PLANE_CHAR = VGC_PLANE_CHAR
000297r 4               VTEXT_PLANE_COLOR = VGC_PLANE_COLOR
000297r 4               VTEXT_PLANE_TEXTATTR = VGC_PLANE_TEXTATTR
000297r 4               
000297r 4               VTEXT_VRAM_AUTOINC = VGC_VRAM_AUTOINC
000297r 4               
000297r 4               VTEXT_FLAG_WRAP = $01
000297r 4               VTEXT_FLAG_SCROLL = $02
000297r 4               
000297r 4               VTEXT_ATTR_NONE = $00
000297r 4               VTEXT_ATTR_FLASH = VTXT_ATTR_FLASH
000297r 4               
000297r 4               VTEXT_OK = $00
000297r 4               VTEXT_ERR = $01
000297r 4               
000297r 4               ; Assembly-facing state ABI. These are linker-owned storage symbols defined by
000297r 4               ; vtext.s, not shared NVR pseudo-registers. NVR remains caller scratch/mailbox.
000297r 4               .global VTEXT_LEFT
000297r 4               .global VTEXT_TOP
000297r 4               .global VTEXT_WIDTH
000297r 4               .global VTEXT_HEIGHT
000297r 4               .global VTEXT_CURX
000297r 4               .global VTEXT_CURY
000297r 4               .global VTEXT_COLOR
000297r 4               .global VTEXT_ATTR
000297r 4               .global VTEXT_CHAR
000297r 4               .global VTEXT_FLAGS
000297r 4               
000297r 4               ; Optional region-table ABI. Callers own the table storage and set these state
000297r 4               ; bytes before define/select/store.
000297r 4               .global VTEXT_TABLEL
000297r 4               .global VTEXT_TABLEH
000297r 4               .global VTEXT_REGION_ID
000297r 4               
000297r 4               VTEXT_REGION_LEFT = 0
000297r 4               VTEXT_REGION_TOP = 1
000297r 4               VTEXT_REGION_WIDTH = 2
000297r 4               VTEXT_REGION_HEIGHT = 3
000297r 4               VTEXT_REGION_CURX = 4
000297r 4               VTEXT_REGION_CURY = 5
000297r 4               VTEXT_REGION_COLOR = 6
000297r 4               VTEXT_REGION_ATTR = 7
000297r 4               VTEXT_REGION_FLAGS = 8
000297r 4               VTEXT_REGION_RESERVED = 9
000297r 4               VTEXT_REGION_SIZE = 10
000297r 4               
000297r 4               ; Public helper routines.
000297r 4               .global vtext_define_region
000297r 4               .global vtext_select_region
000297r 4               .global vtext_store_region
000297r 4               .global vtext_validate_region
000297r 4               .global vtext_set_cursor
000297r 4               .global vtext_sync_cursor
000297r 4               .global vtext_home
000297r 4               .global vtext_put_char
000297r 4               .global vtext_puts
000297r 4               .global vtext_put_hex_nibble
000297r 4               .global vtext_put_hex_byte
000297r 4               .global vtext_newline
000297r 4               .global vtext_clear_region
000297r 4               .global vtext_clear_line
000297r 4               .global vtext_scroll_up
000297r 4               .global vtext_wait_blitter
000297r 4               
000297r 4               .endif
000297r 4               
000297r 3               .include "blitter.s"
000297r 4               ; Shared Nova blitter helper routines.
000297r 4               ;
000297r 4               ; Callers load the BLT hardware registers, then call blitter_start_copy or
000297r 4               ; blitter_start_fill. Routines return A=0 on success and A=1 on error; detailed
000297r 4               ; errors remain in BLT_ERRCODE_REG.
000297r 4               
000297r 4               .include "blitter.inc"
000297r 5               ; Shared Nova blitter helper declarations.
000297r 5               
000297r 5               .ifndef BLITTER_INC_INCLUDED
000297r 5               BLITTER_INC_INCLUDED = 1
000297r 5               
000297r 5               .include "nova.inc"
000297r 6               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
000297r 6               ;
000297r 6               ; This include is deliberately guarded per symbol so it can coexist with older
000297r 6               ; source files that still define a subset of these names locally.
000297r 6               
000297r 6               .ifndef NOVA_INC_INCLUDED
000297r 6               NOVA_INC_INCLUDED = 1
000297r 6               
000297r 6               ; Nova pseudo-register mailbox. These bytes are available to callers and
000297r 6               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
000297r 6               ; clobber them unless its documentation explicitly says otherwise; persistent
000297r 6               ; library state must be allocated in a linker segment such as BSS/ZEROPAGE.
000297r 6               .ifndef NVR0L
000297r 6               NVR0L             = $20
000297r 6               .endif
000297r 6               .ifndef NVR0H
000297r 6               NVR0H             = $21
000297r 6               .endif
000297r 6               .ifndef NVR1L
000297r 6               NVR1L             = $22
000297r 6               .endif
000297r 6               .ifndef NVR1H
000297r 6               NVR1H             = $23
000297r 6               .endif
000297r 6               .ifndef NVR2L
000297r 6               NVR2L             = $24
000297r 6               .endif
000297r 6               .ifndef NVR2H
000297r 6               NVR2H             = $25
000297r 6               .endif
000297r 6               .ifndef NVR3L
000297r 6               NVR3L             = $26
000297r 6               .endif
000297r 6               .ifndef NVR3H
000297r 6               NVR3H             = $27
000297r 6               .endif
000297r 6               .ifndef NVR4L
000297r 6               NVR4L             = $28
000297r 6               .endif
000297r 6               .ifndef NVR4H
000297r 6               NVR4H             = $29
000297r 6               .endif
000297r 6               .ifndef NVR5L
000297r 6               NVR5L             = $2A
000297r 6               .endif
000297r 6               .ifndef NVR5H
000297r 6               NVR5H             = $2B
000297r 6               .endif
000297r 6               .ifndef NVR6L
000297r 6               NVR6L             = $2C
000297r 6               .endif
000297r 6               .ifndef NVR6H
000297r 6               NVR6H             = $2D
000297r 6               .endif
000297r 6               .ifndef NVR7L
000297r 6               NVR7L             = $2E
000297r 6               .endif
000297r 6               .ifndef NVR7H
000297r 6               NVR7H             = $2F
000297r 6               .endif
000297r 6               
000297r 6               ; BASIC SYS register bridge. SYS addr[,A[,X[,Y]]] loads A/X/Y from these
000297r 6               ; bytes before jumping and stores A/X/Y back here when the routine returns.
000297r 6               ; @label SYS.REGA
000297r 6               ; @kind u8
000297r 6               ; @symbol SYS_REGA
000297r 6               ; @summary Returned A register from the most recent SYS call.
000297r 6               .ifndef SYS_REGA
000297r 6               SYS_REGA          = $E7
000297r 6               .endif
000297r 6               ; @label SYS.REGX
000297r 6               ; @kind u8
000297r 6               ; @symbol SYS_REGX
000297r 6               ; @summary Returned X register from the most recent SYS call.
000297r 6               .ifndef SYS_REGX
000297r 6               SYS_REGX          = $E8
000297r 6               .endif
000297r 6               ; @label SYS.REGY
000297r 6               ; @kind u8
000297r 6               ; @symbol SYS_REGY
000297r 6               ; @summary Returned Y register from the most recent SYS call.
000297r 6               .ifndef SYS_REGY
000297r 6               SYS_REGY          = $E9
000297r 6               .endif
000297r 6               
000297r 6               ; Extension ROM argument mailbox used by small BASIC stubs that parse
000297r 6               ; BASIC-owned data before calling an extension handler.
000297r 6               .ifndef EXT_ARG_LEN
000297r 6               EXT_ARG_LEN       = $EA
000297r 6               .endif
000297r 6               .ifndef EXT_ARG_PTRL
000297r 6               EXT_ARG_PTRL      = $EB
000297r 6               .endif
000297r 6               .ifndef EXT_ARG_PTRH
000297r 6               EXT_ARG_PTRH      = $EC
000297r 6               .endif
000297r 6               
000297r 6               .ifndef NOVA_SCREEN_COLS
000297r 6               NOVA_SCREEN_COLS  = 80
000297r 6               .endif
000297r 6               .ifndef NOVA_SCREEN_ROWS
000297r 6               NOVA_SCREEN_ROWS  = 50
000297r 6               .endif
000297r 6               .ifndef NOVA_SCREEN_SIZE
000297r 6               NOVA_SCREEN_SIZE  = NOVA_SCREEN_COLS * NOVA_SCREEN_ROWS
000297r 6               .endif
000297r 6               
000297r 6               ; ---------------------------------------------------------------------
000297r 6               ; 6502 hardware vectors.
000297r 6               ; ---------------------------------------------------------------------
000297r 6               .ifndef CPU_NMI_VECTOR
000297r 6               CPU_NMI_VECTOR    = $FFFA
000297r 6               .endif
000297r 6               .ifndef CPU_RESET_VECTOR
000297r 6               CPU_RESET_VECTOR  = $FFFC
000297r 6               .endif
000297r 6               .ifndef CPU_IRQ_VECTOR
000297r 6               CPU_IRQ_VECTOR    = $FFFE
000297r 6               .endif
000297r 6               
000297r 6               ; ---------------------------------------------------------------------
000297r 6               ; VGC core and text/VRAM port registers.
000297r 6               ; ---------------------------------------------------------------------
000297r 6               .ifndef VGC_MODE
000297r 6               VGC_MODE          = $A000
000297r 6               .endif
000297r 6               .ifndef VGC_BGCOL
000297r 6               VGC_BGCOL         = $A001
000297r 6               .endif
000297r 6               .ifndef VGC_FGCOL
000297r 6               VGC_FGCOL         = $A002
000297r 6               .endif
000297r 6               .ifndef VGC_CURSX
000297r 6               VGC_CURSX         = $A003
000297r 6               .endif
000297r 6               .ifndef VGC_CURSY
000297r 6               VGC_CURSY         = $A004
000297r 6               .endif
000297r 6               .ifndef VGC_SCROLLX
000297r 6               VGC_SCROLLX       = $A005
000297r 6               .endif
000297r 6               .ifndef VGC_SCROLLY
000297r 6               VGC_SCROLLY       = $A006
000297r 6               .endif
000297r 6               .ifndef VGC_FONT
000297r 6               VGC_FONT          = $A007
000297r 6               .endif
000297r 6               .ifndef VGC_FRAME
000297r 6               VGC_FRAME         = $A008
000297r 6               .endif
000297r 6               .ifndef VGC_STATUS
000297r 6               VGC_STATUS        = $A008
000297r 6               .endif
000297r 6               .ifndef VGC_SPRCOUNT
000297r 6               VGC_SPRCOUNT      = $A009
000297r 6               .endif
000297r 6               .ifndef VGC_CURSEN
000297r 6               VGC_CURSEN        = $A00A
