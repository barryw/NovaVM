000000r 2               
000000r 1                     .include "editbuf.inc"
000000r 2               ; editbuf.inc — shared text-editing engine for Nova native tools.
000000r 2               ;
000000r 2               ; editbuf layers a real editable text buffer (cursor movement, insert/delete,
000000r 2               ; line navigation, selection, cut/copy/paste, scrolling) and a three-choice
000000r 2               ; modal dialog on top of the EDITUI chrome shell. It is intentionally
000000r 2               ; LANGUAGE-NEUTRAL: it knows nothing about Logo, BASIC, or any document model.
000000r 2               ;
000000r 2               ; Anything language-specific is supplied by the host through HOOK VECTORS:
000000r 2               ;   - SAVE hook   : invoked on Ctrl-S (and the dialog "Save First" choice).
000000r 2               ;                   The host validates/saves/installs and returns a status.
000000r 2               ;   - INDENT hook : invoked after Enter. The host returns how many leading
000000r 2               ;                   spaces the new line should start with (auto-indent).
000000r 2               ;   - HILITE hook : invoked per visible line during render. The host fills a
000000r 2               ;                   per-character color buffer (syntax highlighting).
000000r 2               ; Every hook defaults to a no-op, so editbuf works as a plain editor with no
000000r 2               ; host wiring at all.
000000r 2               ;
000000r 2               ; Calling convention: the host populates the EDITBUF_* config bytes below, then
000000r 2               ; calls editbuf_run. editbuf_run blocks until the user exits and returns the
000000r 2               ; exit reason in A (also EDITBUF_RESULT). The buffer text and EDITBUF_LEN are
000000r 2               ; left in place so the host can inspect / re-open the draft.
000000r 2               
000000r 2               .ifndef EDITBUF_INC_INCLUDED
000000r 2               EDITBUF_INC_INCLUDED = 1
000000r 2               
000000r 2               .include "editui.inc"
000000r 3               ; Shared Nova editor-shell UI declarations.
000000r 3               ;
000000r 3               ; EDITUI is a small text-mode shell for native tools: menu bar, title/help
000000r 3               ; rows, framed panels, and status lines. Applications own input dispatch,
000000r 3               ; document state, and editor-specific drawing.
000000r 3               
000000r 3               .ifndef EDITUI_INC_INCLUDED
000000r 3               EDITUI_INC_INCLUDED = 1
000000r 3               
000000r 3               .include "vtext.inc"
000000r 4               ; NovaVM shared text-region runtime interface.
000000r 4               ;
000000r 4               ; This layer is intentionally language-neutral. It knows about rectangular
000000r 4               ; regions over the VGC text planes, but not about BASIC, NovaZ, or Z-machine
000000r 4               ; window semantics.
000000r 4               ;
000000r 4               ; Calling convention:
000000r 4               ;   Region:      VTEXT_LEFT/TOP/WIDTH/HEIGHT state bytes
000000r 4               ;   Cursor:      VTEXT_CURX/CURY state bytes, relative to the current region.
000000r 4               ;                vtext_set_cursor and character output mirror this to the
000000r 4               ;                absolute VGC visible cursor registers.
000000r 4               ;   Cell attrs:  VTEXT_COLOR (packed bg/fg), VTEXT_ATTR (style bits)
000000r 4               ;   Character:   VTEXT_CHAR input byte
000000r 4               ;   Flags:       VTEXT_FLAGS state byte (wrap/scroll)
000000r 4               ;
000000r 4               ; Routines return A=0 on success and A=1 on error. X/Y are scratch unless a
000000r 4               ; routine explicitly documents otherwise.
000000r 4               
000000r 4               .ifndef VTEXT_INC_INCLUDED
000000r 4               VTEXT_INC_INCLUDED = 1
000000r 4               
000000r 4               .include "nova.inc"
000000r 5               ; Shared Nova hardware constants for BASIC, assembly, and runtime libraries.
000000r 5               ;
000000r 5               ; This include is deliberately guarded per symbol so it can coexist with older
000000r 5               ; source files that still define a subset of these names locally.
000000r 5               
000000r 5               .ifndef NOVA_INC_INCLUDED
000000r 5               NOVA_INC_INCLUDED = 1
000000r 5               
000000r 5               ; Nova pseudo-register mailbox. These bytes are available to callers and
000000r 5               ; runtime helpers as ephemeral argument/scratch storage only. A routine may
000000r 5               ; clobber them unless its documentation explicitly says otherwise; persistent
000000r 5               ; library state must be allocated in a linker segment such as BSS/ZEROPAGE.
000000r 5               .ifndef NVR0L
