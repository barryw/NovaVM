000C6Ar 3               ; @label VSPRITE.SCENE_WORKADDRM
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_WORKADDRM
000C6Ar 3               ; @summary Middle byte of the atomic scene work buffer address.
000C6Ar 3               .global VSPRITE_SCENE_WORKADDRM
000C6Ar 3               ; @label VSPRITE.SCENE_WORKADDRH
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_WORKADDRH
000C6Ar 3               ; @summary High byte of the atomic scene work buffer address.
000C6Ar 3               .global VSPRITE_SCENE_WORKADDRH
000C6Ar 3               ; @label VSPRITE.SCENE_WORKSTRL
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SCENE_WORKSTRL
000C6Ar 3               ; @summary Low byte of the atomic scene work buffer row stride.
