0017E2r 2               editui_ok:
0017E2r 2  A9 00              LDA   #EDITUI_OK
0017E4r 2  60                 RTS
0017E5r 2               
0017E5r 2               editui_init:
0017E5r 2  A9 00              LDA   #$00
0017E7r 2  8D 00 A0           STA   VGC_MODE
0017EAr 2                     ; The editor paints every cell via per-cell color RAM, so it does NOT
0017EAr 2                     ; dictate the global background/border/foreground — the host runtime owns
0017EAr 2                     ; those (and is responsible for restoring them on exit). We only set the
0017EAr 2                     ; palette mode the editor's color constants are authored against.
0017EAr 2  A9 00              LDA   #EDITUI_PALETTE_MODE
0017ECr 2  8D E9 A0           STA   VGC_PALETTE
0017EFr 2  9C 0A A0           STZ   VGC_CURSEN
0017F2r 2  9C rr rr           STZ   EDITUI_BOX_STYLE
0017F5r 2  9C rr rr           STZ   EDITUI_MENUL
0017F8r 2  9C rr rr           STZ   EDITUI_MENUH
0017FBr 2  9C rr rr           STZ   EDITUI_DIRTY
0017FEr 2  9C rr rr           STZ   EDITUI_MENU_SAVE_VALID
001801r 2  A9 rr              LDA   #<editui_default_menus
001803r 2  8D rr rr           STA   EDITUI_MENUSL
001806r 2  A9 rr              LDA   #>editui_default_menus
001808r 2  8D rr rr           STA   EDITUI_MENUSH
00180Br 2  4C rr rr           JMP   editui_ok
00180Er 2               
00180Er 2               ; editui_set_menus — A = menu-table ptr low byte, Y = high byte. Point the menu
00180Er 2               ; bar at a host-supplied table. Editor-owned menu-management entry point so a
00180Er 2               ; runtime can install a tailored ("dumb") menu instead of the File/Edit/Help
00180Er 2               ; default. Pass A=Y=0 to fall back to editui_default_menus.
00180Er 2               editui_set_menus:
00180Er 2  8D rr rr           STA   EDITUI_MENUSL
001811r 2  8C rr rr           STY   EDITUI_MENUSH
001814r 2  60                 RTS
001815r 2               
001815r 2               editui_full_region:
001815r 2  9C rr rr           STZ   VTEXT_LEFT
001818r 2  9C rr rr           STZ   VTEXT_TOP
00181Br 2  A9 50              LDA   #EDITUI_SCREEN_COLS
00181Dr 2  8D rr rr           STA   VTEXT_WIDTH
001820r 2  A9 32              LDA   #EDITUI_SCREEN_ROWS
001822r 2  8D rr rr           STA   VTEXT_HEIGHT
001825r 2  9C rr rr           STZ   VTEXT_CURX
001828r 2  9C rr rr           STZ   VTEXT_CURY
00182Br 2  A9 0F              LDA   #EDITUI_COLOR_SHELL
00182Dr 2  8D rr rr           STA   VTEXT_COLOR
001830r 2  9C rr rr           STZ   VTEXT_ATTR
001833r 2  9C rr rr           STZ   VTEXT_FLAGS
001836r 2  60                 RTS
001837r 2               
