00194Fr 2  20 rr rr           JSR   editui_fill_row
001952r 2  AD rr rr           LDA   EDITUI_MENUSL
001955r 2  0D rr rr           ORA   EDITUI_MENUSH
001958r 2  F0 05              BEQ   @legacy
00195Ar 2  20 rr rr           JSR   editui_draw_menu_table
00195Dr 2  80 29              BRA   @title
00195Fr 2               @legacy:
00195Fr 2  AD rr rr           LDA   EDITUI_MENUL
001962r 2  0D rr rr           ORA   EDITUI_MENUH
001965r 2  F0 21              BEQ   @title
001967r 2  AD rr rr           LDA   EDITUI_MENUL
00196Ar 2  8D rr rr           STA   EDITUI_PRINTL
