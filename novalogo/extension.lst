000000r 2               ; @label VSPRITE.FLAG_COLORKEY
000000r 2               ; @kind const
000000r 2               ; @symbol VSPRITE_FLAG_COLORKEY
000000r 2               ; @summary Enable source color-key transparency for VSPRITE.BLIT and VSPRITE.GFX_BLIT.
000000r 2               VSPRITE_FLAG_COLORKEY    = $01
000000r 2               
000000r 2               ; @label VSPRITE.DESC_FLAG_COLORKEY
000000r 2               ; @kind const
000000r 2               ; @symbol VSPRITE_DESC_FLAG_COLORKEY
000000r 2               ; @summary Descriptor flag enabling source color-key transparency.
000000r 2               VSPRITE_DESC_FLAG_COLORKEY = VSPRITE_FLAG_COLORKEY
000000r 2               
000000r 2               ; @label VSPRITE.DESC_SAVED
000000r 2               ; @kind const
000000r 2               ; @symbol VSPRITE_DESC_SAVED
000000r 2               ; @summary Internal descriptor flag set when old X/Y has a saved background to restore.
000000r 2               VSPRITE_DESC_SAVED       = $40
000000r 2               
000000r 2               ; @label VSPRITE.DESC_VISIBLE
000000r 2               ; @kind const
000000r 2               ; @symbol VSPRITE_DESC_VISIBLE
000000r 2               ; @summary Descriptor flag enabling scene save/draw for this virtual sprite.
000000r 2               VSPRITE_DESC_VISIBLE     = $80
000000r 2               
000000r 2               VSPRITE_GFX_STRIDE       = 320
000000r 2               
000000r 2               ; Scene descriptor layout. Descriptors are caller-owned RAM because scene
000000r 2               ; helpers update OLD_* and SAVED as part of the frame protocol.
