001898r 2  AD rr rr           LDA   EDITUI_PRINTL
00189Br 2  AC rr rr           LDY   EDITUI_PRINTH
00189Er 2  4C rr rr           JMP   vtext_puts
0018A1r 2               
0018A1r 2               editui_print_marked:
0018A1r 2  AD rr rr           LDA   EDITUI_PRINTL
0018A4r 2  85 rr              STA   EDITUI_SCANL
0018A6r 2  AD rr rr           LDA   EDITUI_PRINTH
0018A9r 2  85 rr              STA   EDITUI_SCANH
0018ABr 2  20 rr rr           JSR   editui_full_region
0018AEr 2  AD rr rr           LDA   EDITUI_PRINT_COLOR
0018B1r 2  8D rr rr           STA   VTEXT_COLOR
0018B4r 2  AD rr rr           LDA   EDITUI_PRINTX
0018B7r 2  8D rr rr           STA   VTEXT_CURX
0018BAr 2  AD rr rr           LDA   EDITUI_PRINTY
0018BDr 2  8D rr rr           STA   VTEXT_CURY
0018C0r 2  20 rr rr           JSR   vtext_set_cursor
0018C3r 2               @loop:
0018C3r 2  A0 00              LDY   #$00
0018C5r 2  B1 rr              LDA   (EDITUI_SCANL),Y
0018C7r 2  F0 2F              BEQ   @done
0018C9r 2  C9 26              CMP   #'&'
0018CBr 2  D0 20              BNE   @normal
0018CDr 2  20 rr rr           JSR   editui_inc_scan
0018D0r 2  A0 00              LDY   #$00
0018D2r 2  B1 rr              LDA   (EDITUI_SCANL),Y
0018D4r 2  F0 22              BEQ   @done
0018D6r 2  8D rr rr           STA   VTEXT_CHAR
0018D9r 2  AD rr rr           LDA   EDITUI_HOT_COLOR
0018DCr 2  8D rr rr           STA   VTEXT_COLOR
0018DFr 2  20 rr rr           JSR   vtext_put_char
0018E2r 2  AD rr rr           LDA   EDITUI_PRINT_COLOR
0018E5r 2  8D rr rr           STA   VTEXT_COLOR
0018E8r 2  20 rr rr           JSR   editui_inc_scan
0018EBr 2  80 D6              BRA   @loop
0018EDr 2               @normal:
0018EDr 2  8D rr rr           STA   VTEXT_CHAR
0018F0r 2  20 rr rr           JSR   vtext_put_char
0018F3r 2  20 rr rr           JSR   editui_inc_scan
0018F6r 2  80 CB              BRA   @loop
0018F8r 2               @done:
0018F8r 2  60                 RTS
0018F9r 2               
0018F9r 2               editui_inc_scan:
0018F9r 2  E6 rr              INC   EDITUI_SCANL
0018FBr 2  D0 02              BNE   @done
0018FDr 2  E6 rr              INC   EDITUI_SCANH
0018FFr 2               @done:
0018FFr 2  60                 RTS
001900r 2               
001900r 2               editui_strlen:
