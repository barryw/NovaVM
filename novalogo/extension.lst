000000r 5               .endif
000000r 5               ; @label FIO.RNG3
000000r 5               ; @kind u8
000000r 5               ; @symbol FIO_RNG3
000000r 5               ; @summary High byte returned by FIO.CMD_RNG.
000000r 5               .ifndef FIO_RNG3
000000r 5               FIO_RNG3         = FIO_ENDH
000000r 5               .endif
000000r 5               
