0025A3r 2  A5 rr              LDA   EDITBUF_CNTL
0025A5r 2  05 rr              ORA   EDITBUF_CNTH
0025A7r 2  F0 1E              BEQ   @done
0025A9r 2  AD rr rr           LDA   EB_SELSTARTL
