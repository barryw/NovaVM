00190Fr 2  B1 rr              LDA   (EDITUI_SCANL),Y
001911r 2  F0 0C              BEQ   @done
001913r 2  C9 26              CMP   #'&'
001915r 2  F0 03              BEQ   @skip
001917r 2  EE rr rr           INC   EDITUI_LEN
00191Ar 2               @skip:
00191Ar 2  20 rr rr           JSR   editui_inc_scan
00191Dr 2  80 EE              BRA   @loop
00191Fr 2               @done:
00191Fr 2  AD rr rr           LDA   EDITUI_LEN
001922r 2  60                 RTS
