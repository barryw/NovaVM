0017B1r 3  8D 92 BA           STA   BLT_SRCSTRL
0017B4r 3  8D 94 BA           STA   BLT_DSTSTRL
0017B7r 3  A9 00              LDA   #>VTEXT_SCREEN_COLS
0017B9r 3  8D 93 BA           STA   BLT_SRCSTRH
0017BCr 3  8D 95 BA           STA   BLT_DSTSTRH
0017BFr 3  20 rr rr           JSR   blitter_start_copy
0017C2r 3  4C rr rr           JMP   vtext_blitter_result
0017C5r 3               
