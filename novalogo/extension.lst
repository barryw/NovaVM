000000r 1                     .include "vsprite.inc"
000000r 2               ; Shared Nova virtual-sprite helper declarations.
000000r 2               ;
000000r 2               ; A virtual sprite is a caller-owned rectangular pixel stamp copied by the
000000r 2               ; blitter into a VGC memory space. Unlike hardware sprites, the count is limited
000000r 2               ; by memory and redraw cost rather than VGC sprite registers.
000000r 2               ;
000000r 2               ; Transparency is split into two explicit layers:
000000r 2               ; - VSPRITE_COLORKEY controls which source byte VSPRITE.BLIT skips.
000000r 2               ; - VGC_GFXTRANS controls which color in the VGC graphics plane is transparent
000000r 2               ;   during final display composition.
000000r 2               ;
000000r 2               ; The default for both is 0. If a runtime needs visible black graphics-plane
000000r 2               ; pixels, choose another unused color as the transparent color, store it in
000000r 2               ; VGC_GFXTRANS, write that value into transparent source pixels, and set
000000r 2               ; VSPRITE_COLORKEY to the same value before a color-keyed blit.
000000r 2               ;
000000r 2               ; For moving objects, use the graphics-plane saved-background helpers in the
000000r 2               ; same style as an Amiga BOB:
000000r 2               ; 1. Set VSPRITE.X/Y, VSPRITE.WIDTH/HEIGHT, and VSPRITE.BG* to caller-owned RAM.
000000r 2               ; 2. Call VSPRITE.GFX_SAVE_BG before drawing the object.
000000r 2               ; 3. Draw with VSPRITE.GFX_BLIT.
000000r 2               ; 4. Before the next frame, call VSPRITE.GFX_RESTORE_BG at the saved X/Y, move
000000r 2               ;    the object, save the new background, and draw again.
000000r 2               ; Static objects that were not first drawn with a saved background must be
000000r 2               ; erased by the caller before entering this loop.
000000r 2               ;
000000r 2               ; For multiple moving virtual sprites, use the scene helpers instead of calling
000000r 2               ; the single-sprite save/restore loop for each object. A scene descriptor list
000000r 2               ; restores every old background first, lets the caller update positions, saves
000000r 2               ; every new background from the clean playfield, then draws the list in order.
000000r 2               ; List order is z-order: later descriptors draw in front of earlier ones.
000000r 2               ;
000000r 2               ; For scenes where multiple virtual sprites overlap or cross paths, use
000000r 2               ; VSPRITE.SCENE_COMMIT_ATOMIC. The caller supplies a dirty graphics rectangle
000000r 2               ; and a work buffer. The helper composes the clean old backgrounds and new
000000r 2               ; sprites into that offscreen buffer, then copies the completed rectangle to
000000r 2               ; the graphics plane as one visible blit. For a truly atomic visual update, the
000000r 2               ; final dirty rectangle must be small enough to fit in one vblank window.
000000r 2               ;
000000r 2               ; For in-place rotated virtual sprites on the transparent graphics plane, use
000000r 2               ; VSPRITE.GFX_ROTATE_BLIT. It rotates into VSPRITE.ROT* offscreen, then copies
000000r 2               ; the full rotated rectangle to graphics memory in one blit so old pixels are
000000r 2               ; cleared without a separate visible erase.
000000r 2               
000000r 2               .ifndef VSPRITE_INC_INCLUDED
000000r 2               VSPRITE_INC_INCLUDED = 1
000000r 2               
000000r 2               .include "blitter.inc"
000000r 3               ; Shared Nova blitter helper declarations.
000000r 3               
