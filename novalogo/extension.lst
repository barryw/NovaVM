000000r 4               SYS_REGX          = $E8
000000r 4               .endif
000000r 4               ; @label SYS.REGY
000000r 4               ; @kind u8
000000r 4               ; @symbol SYS_REGY
000000r 4               ; @summary Returned Y register from the most recent SYS call.
000000r 4               .ifndef SYS_REGY
000000r 4               SYS_REGY          = $E9
000000r 4               .endif
