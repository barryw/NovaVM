00136Er 2  A0 10              LDY   #VSPRITE_DESC_SRCSTRH
001370r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
001372r 2  8D rr rr           STA   VSPRITE_SRCSTRH
001375r 2  A0 17              LDY   #VSPRITE_DESC_COLORKEY
001377r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
001379r 2  8D rr rr           STA   VSPRITE_COLORKEY
00137Cr 2  A0 00              LDY   #VSPRITE_DESC_FLAGS
00137Er 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
001380r 2  29 01              AND   #VSPRITE_DESC_FLAG_COLORKEY
001382r 2  8D rr rr           STA   VSPRITE_FLAGS
001385r 2  60                 RTS
001386r 2               
001386r 2               vsprite_scene_load_old:
001386r 2  20 rr rr           JSR   vsprite_scene_load_common
001389r 2  A0 04              LDY   #VSPRITE_DESC_OLD_XL
00138Br 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
00138Dr 2  8D rr rr           STA   VSPRITE_XL
001390r 2  A0 05              LDY   #VSPRITE_DESC_OLD_XH
001392r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
001394r 2  8D rr rr           STA   VSPRITE_XH
001397r 2  A0 06              LDY   #VSPRITE_DESC_OLD_Y
001399r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
00139Br 2  8D rr rr           STA   VSPRITE_Y
00139Er 2  60                 RTS
00139Fr 2               
00139Fr 2               vsprite_scene_store_old:
00139Fr 2  A0 01              LDY   #VSPRITE_DESC_XL
0013A1r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
0013A3r 2  A0 04              LDY   #VSPRITE_DESC_OLD_XL
0013A5r 2  91 rr              STA   (VSPRITE_DESC_PTR),Y
0013A7r 2  A0 02              LDY   #VSPRITE_DESC_XH
0013A9r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
0013ABr 2  A0 05              LDY   #VSPRITE_DESC_OLD_XH
0013ADr 2  91 rr              STA   (VSPRITE_DESC_PTR),Y
0013AFr 2  A0 03              LDY   #VSPRITE_DESC_Y
0013B1r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
0013B3r 2  A0 06              LDY   #VSPRITE_DESC_OLD_Y
0013B5r 2  91 rr              STA   (VSPRITE_DESC_PTR),Y
0013B7r 2  60                 RTS
0013B8r 2               
0013B8r 2               .endif
