000000r 3               .ifndef EXT_ARG_PTRL
000000r 3               EXT_ARG_PTRL      = $EB
000000r 3               .endif
000000r 3               .ifndef EXT_ARG_PTRH
000000r 3               EXT_ARG_PTRH      = $EC
000000r 3               .endif
