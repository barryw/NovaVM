001988r 2               @title:
001988r 2  4C rr rr           JMP   editui_draw_menu_title
00198Br 2               
00198Br 2               ; editui_draw_menu_title — draw the title right-aligned on the menu bar, just
00198Br 2               ; left of the dirty-marker cell, then refresh the marker.
00198Br 2               editui_draw_menu_title:
00198Br 2  AD rr rr           LDA   EDITUI_TITLEL
00198Er 2  0D rr rr           ORA   EDITUI_TITLEH
001991r 2  F0 23              BEQ   editui_refresh_dirty        ; no title: still stamp the marker cell
001993r 2  AD rr rr           LDA   EDITUI_TITLEL
001996r 2  8D rr rr           STA   EDITUI_PRINTL
001999r 2  AD rr rr           LDA   EDITUI_TITLEH
00199Cr 2  8D rr rr           STA   EDITUI_PRINTH
00199Fr 2  20 rr rr           JSR   editui_strlen               ; A / EDITUI_LEN = title length
0019A2r 2  A9 4D              LDA   #EDITUI_DIRTY_COL-1         ; one space gap before the marker
0019A4r 2  38                 SEC
0019A5r 2  ED rr rr           SBC   EDITUI_LEN
0019A8r 2  8D rr rr           STA   EDITUI_PRINTX
0019ABr 2  9C rr rr           STZ   EDITUI_PRINTY
0019AEr 2  A9 F0              LDA   #EDITUI_COLOR_MENU
0019B0r 2  8D rr rr           STA   VTEXT_COLOR
0019B3r 2  20 rr rr           JSR   editui_print_ptr
0019B6r 2                     ; fall through to stamp the dirty marker
0019B6r 2               
0019B6r 2               ; editui_refresh_dirty — stamp '*' (dirty) or ' ' (clean) at the menu-bar marker
0019B6r 2               ; cell. Cheap single-cell update; safe to call on every dirty-state change.
0019B6r 2               editui_refresh_dirty:
0019B6r 2  20 rr rr           JSR   editui_full_region
0019B9r 2  A9 4E              LDA   #EDITUI_DIRTY_COL
0019BBr 2  8D rr rr           STA   VTEXT_CURX
0019BEr 2  9C rr rr           STZ   VTEXT_CURY
0019C1r 2  20 rr rr           JSR   vtext_set_cursor
0019C4r 2  A9 F0              LDA   #EDITUI_COLOR_MENU
0019C6r 2  8D rr rr           STA   VTEXT_COLOR
0019C9r 2  AD rr rr           LDA   EDITUI_DIRTY
0019CCr 2  F0 04              BEQ   @clean
0019CEr 2  A9 2A              LDA   #'*'
0019D0r 2  80 02              BRA   @put
0019D2r 2               @clean:
0019D2r 2  A9 20              LDA   #' '
0019D4r 2               @put:
0019D4r 2  8D rr rr           STA   VTEXT_CHAR
0019D7r 2  4C rr rr           JMP   vtext_put_char
0019DAr 2               
