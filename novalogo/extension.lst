000ADAr 3               
000ADAr 2               .include "blitter.s"
000ADAr 3               ; Shared Nova blitter helper routines.
000ADAr 3               ;
000ADAr 3               ; Callers load the BLT hardware registers, then call blitter_start_copy or
000ADAr 3               ; blitter_start_fill. Routines return A=0 on success and A=1 on error; detailed
000ADAr 3               ; errors remain in BLT_ERRCODE_REG.
000ADAr 3               
000ADAr 3               .include "blitter.inc"
000ADAr 4               ; Shared Nova blitter helper declarations.
000ADAr 4               
000ADAr 4               .ifndef BLITTER_INC_INCLUDED
000ADAr 4               BLITTER_INC_INCLUDED = 1
000ADAr 4               
000ADAr 4               .include "nova.inc"
000ADAr 4               
000ADAr 4               BLITTER_RESULT_OK    = $00
000ADAr 4               BLITTER_RESULT_ERROR = $01
000ADAr 4               
000ADAr 4               .endif
000ADAr 4               
000ADAr 3               
000ADAr 3               .ifndef BLITTER_IMPLEMENTATION_INCLUDED
000ADAr 3               BLITTER_IMPLEMENTATION_INCLUDED = 1
000ADAr 3               
000ADAr 3                     .segment "CODE"
000ADAr 3               
000ADAr 3                     .export blitter_copy
000ADAr 3                     .export blitter_fill
000ADAr 3                     .export blitter_start_copy
000ADAr 3                     .export blitter_start_fill
000ADAr 3                     .export blitter_wait
000ADAr 3               
000ADAr 3               ; @label BLITTER.COPY
000ADAr 3               ; @kind routine
000ADAr 3               ; @symbol blitter_copy
000ADAr 3               ; @summary Start a rectangular blitter copy using the BLT controller registers.
000ADAr 3               ; @requires BLT_SRCSPACE BLT_DSTSPACE BLT_SRCL BLT_SRCM BLT_SRCH BLT_DSTL BLT_DSTM BLT_DSTH BLT_WIDTHL BLT_WIDTHH BLT_HEIGHTL BLT_HEIGHTH BLT_SRCSTRL BLT_SRCSTRH BLT_DSTSTRL BLT_DSTSTRH
000ADAr 3               ; @out A: 0 on success, 1 on error.
000ADAr 3               blitter_copy:
000ADAr 3  4C rr rr           JMP   blitter_start_copy
000ADDr 3               
000ADDr 3               ; @label BLITTER.FILL
000ADDr 3               ; @kind routine
000ADDr 3               ; @symbol blitter_fill
000ADDr 3               ; @summary Start a rectangular blitter fill using destination, size, stride, and fill registers.
000ADDr 3               ; @requires BLT_DSTSPACE BLT_DSTL BLT_DSTM BLT_DSTH BLT_WIDTHL BLT_WIDTHH BLT_HEIGHTL BLT_HEIGHTH BLT_DSTSTRL BLT_DSTSTRH BLT_FILLVALUE
000ADDr 3               ; @out A: 0 on success, 1 on error.
000ADDr 3               blitter_fill:
000ADDr 3  9C 86 BA           STZ   BLT_SRCSPACE
000AE0r 3  9C 88 BA           STZ   BLT_SRCL
000AE3r 3  9C 89 BA           STZ   BLT_SRCM
000AE6r 3  9C 8A BA           STZ   BLT_SRCH
000AE9r 3  9C 92 BA           STZ   BLT_SRCSTRL
000AECr 3  9C 93 BA           STZ   BLT_SRCSTRH
000AEFr 3  9C 98 BA           STZ   BLT_CKEY
000AF2r 3  4C rr rr           JMP   blitter_start_fill
000AF5r 3               
000AF5r 3               ; @label BLITTER.START_COPY
000AF5r 3               ; @kind routine
000AF5r 3               ; @symbol blitter_start_copy
000AF5r 3               ; @summary Low-level blitter copy start. Call BLITTER.COPY for the public wrapper.
000AF5r 3               ; @out A: 0 on success, 1 on error.
000AF5r 3               blitter_start_copy:
000AF5r 3  9C 96 BA           STZ   BLT_MODE_REG
000AF8r 3  9C 98 BA           STZ   BLT_CKEY
000AFBr 3  A9 01              LDA   #BLT_CMD_START
000AFDr 3  8D 83 BA           STA   BLT_CMD_REG
000B00r 3  4C rr rr           JMP   blitter_wait
000B03r 3               
000B03r 3               ; @label BLITTER.START_FILL
000B03r 3               ; @kind routine
000B03r 3               ; @symbol blitter_start_fill
000B03r 3               ; @summary Low-level blitter fill start. Call BLITTER.FILL for the public wrapper.
000B03r 3               ; @out A: 0 on success, 1 on error.
000B03r 3               blitter_start_fill:
000B03r 3  A9 01              LDA   #BLT_MODE_FILL
000B05r 3  8D 96 BA           STA   BLT_MODE_REG
000B08r 3  A9 01              LDA   #BLT_CMD_START
000B0Ar 3  8D 83 BA           STA   BLT_CMD_REG
000B0Dr 3  4C rr rr           JMP   blitter_wait
000B10r 3               
000B10r 3               ; @label BLITTER.WAIT
000B10r 3               ; @kind routine
000B10r 3               ; @symbol blitter_wait
000B10r 3               ; @summary Wait for the blitter controller to leave BUSY and return shared status.
000B10r 3               ; @out A: 0 on success, 1 on error.
000B10r 3               blitter_wait:
000B10r 3               @loop:
000B10r 3  AD 84 BA           LDA   BLT_STATUS_REG
000B13r 3  C9 01              CMP   #BLT_STATUS_BUSY
000B15r 3  F0 F9              BEQ   @loop
000B17r 3  C9 02              CMP   #BLT_STATUS_OK
000B19r 3  F0 03              BEQ   @ok
000B1Br 3  A9 01              LDA   #BLITTER_RESULT_ERROR
000B1Dr 3  60                 RTS
000B1Er 3               @ok:
000B1Er 3  A9 00              LDA   #BLITTER_RESULT_OK
000B20r 3  60                 RTS
000B21r 3               
000B21r 3               .endif
000B21r 3               
000B21r 2               
000B21r 2               .ifndef VSPRITE_IMPLEMENTATION_INCLUDED
000B21r 2               VSPRITE_IMPLEMENTATION_INCLUDED = 1
000B21r 2               
000B21r 2                     .segment "BSS"
000311r 2               
000311r 2  xx           VSPRITE_SRCSPACE:       .res 1
000312r 2  xx           VSPRITE_DSTSPACE:       .res 1
000313r 2  xx           VSPRITE_SRCADDRL:       .res 1
000314r 2  xx           VSPRITE_SRCADDRM:       .res 1
000315r 2  xx           VSPRITE_SRCADDRH:       .res 1
000316r 2  xx           VSPRITE_DSTADDRL:       .res 1
000317r 2  xx           VSPRITE_DSTADDRM:       .res 1
000318r 2  xx           VSPRITE_DSTADDRH:       .res 1
000319r 2  xx           VSPRITE_WIDTHL:         .res 1
00031Ar 2  xx           VSPRITE_WIDTHH:         .res 1
00031Br 2  xx           VSPRITE_HEIGHTL:        .res 1
00031Cr 2  xx           VSPRITE_HEIGHTH:        .res 1
00031Dr 2  xx           VSPRITE_SRCSTRL:        .res 1
00031Er 2  xx           VSPRITE_SRCSTRH:        .res 1
00031Fr 2  xx           VSPRITE_DSTSTRL:        .res 1
000320r 2  xx           VSPRITE_DSTSTRH:        .res 1
000321r 2  xx           VSPRITE_BGSPACE:        .res 1
000322r 2  xx           VSPRITE_BGADDRL:        .res 1
000323r 2  xx           VSPRITE_BGADDRM:        .res 1
000324r 2  xx           VSPRITE_BGADDRH:        .res 1
000325r 2  xx           VSPRITE_BGSTRL:         .res 1
000326r 2  xx           VSPRITE_BGSTRH:         .res 1
000327r 2  xx           VSPRITE_COLORKEY:       .res 1
000328r 2  xx           VSPRITE_ORIGSPACE:      .res 1
000329r 2  xx           VSPRITE_ORIGADDRL:      .res 1
00032Ar 2  xx           VSPRITE_ORIGADDRM:      .res 1
00032Br 2  xx           VSPRITE_ORIGADDRH:      .res 1
00032Cr 2  xx           VSPRITE_ORIGSTRL:       .res 1
00032Dr 2  xx           VSPRITE_ORIGSTRH:       .res 1
00032Er 2  xx           VSPRITE_ROTSPACE:       .res 1
00032Fr 2  xx           VSPRITE_ROTADDRL:       .res 1
000330r 2  xx           VSPRITE_ROTADDRM:       .res 1
000331r 2  xx           VSPRITE_ROTADDRH:       .res 1
000332r 2  xx           VSPRITE_ROTSTRL:        .res 1
000333r 2  xx           VSPRITE_ROTSTRH:        .res 1
000334r 2  xx           VSPRITE_ROTANGLE:       .res 1
000335r 2  xx           VSPRITE_FILLVALUE:      .res 1
000336r 2  xx           VSPRITE_FLAGS:          .res 1
000337r 2  xx           VSPRITE_XL:             .res 1
000338r 2  xx           VSPRITE_XH:             .res 1
000339r 2  xx           VSPRITE_Y:              .res 1
00033Ar 2  xx           VSPRITE_SCENE_ADDRL:    .res 1
00033Br 2  xx           VSPRITE_SCENE_ADDRH:    .res 1
00033Cr 2  xx           VSPRITE_SCENE_COUNT:    .res 1
00033Dr 2  xx           VSPRITE_SCENE_REMAIN:   .res 1
00033Er 2  xx           VSPRITE_SCENE_XL:       .res 1
00033Fr 2  xx           VSPRITE_SCENE_XH:       .res 1
000340r 2  xx           VSPRITE_SCENE_Y:        .res 1
000341r 2  xx           VSPRITE_SCENE_WIDTHL:   .res 1
000342r 2  xx           VSPRITE_SCENE_WIDTHH:   .res 1
000343r 2  xx           VSPRITE_SCENE_HEIGHTL:  .res 1
000344r 2  xx           VSPRITE_SCENE_HEIGHTH:  .res 1
000345r 2  xx           VSPRITE_SCENE_WORKSPACE:.res 1
000346r 2  xx           VSPRITE_SCENE_WORKADDRL:.res 1
000347r 2  xx           VSPRITE_SCENE_WORKADDRM:.res 1
000348r 2  xx           VSPRITE_SCENE_WORKADDRH:.res 1
000349r 2  xx           VSPRITE_SCENE_WORKSTRL: .res 1
00034Ar 2  xx           VSPRITE_SCENE_WORKSTRH: .res 1
00034Br 2  xx           VSPRITE_SCENE_OFFL:     .res 1
00034Cr 2  xx           VSPRITE_SCENE_OFFH:     .res 1
00034Dr 2               
00034Dr 2                     .segment "ZEROPAGE"
000000r 2               
000000r 2  xx           VSPRITE_TMP:            .res 1
000001r 2  xx xx        VSPRITE_DESC_PTR:       .res 2
000003r 2               
000003r 2                     .segment "CODE"
000B21r 2               
000B21r 2                     .export vsprite_blit
000B21r 2                     .export vsprite_blit_start
000B21r 2                     .export vsprite_fill
000B21r 2                     .export vsprite_gfx_addr
000B21r 2                     .export vsprite_gfx_blit
000B21r 2                     .export vsprite_gfx_blit_start
000B21r 2                     .export vsprite_gfx_rotate_blit
000B21r 2                     .export vsprite_gfx_rotate_blit_keyed
000B21r 2                     .export vsprite_gfx_rotate_blit_nowait
000B21r 2                     .export vsprite_gfx_fill
000B21r 2                     .export vsprite_gfx_save_bg
000B21r 2                     .export vsprite_gfx_restore_bg
000B21r 2                     .export vsprite_rotate
000B21r 2                     .export vsprite_use_original
000B21r 2                     .export vsprite_use_rotated
000B21r 2                     .export vsprite_scene_begin
000B21r 2                     .export vsprite_scene_commit
000B21r 2                     .export vsprite_scene_commit_atomic
000B21r 2                     .export vsprite_scene_draw
000B21r 2               
000B21r 2               ; @label VSPRITE.BLIT
000B21r 2               ; @kind routine
000B21r 2               ; @symbol vsprite_blit
000B21r 2               ; @summary Copy the configured virtual sprite rectangle with the blitter.
000B21r 2               ; @requires VSPRITE_SRCSPACE VSPRITE_DSTSPACE VSPRITE_SRCADDR* VSPRITE_DSTADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_SRCSTR* VSPRITE_DSTSTR*
000B21r 2               ; @in VSPRITE_FLAGS: Set bit 0 to enable color-key transparency.
000B21r 2               ; @in VSPRITE_COLORKEY: Source byte skipped when color-key mode is enabled.
000B21r 2               ; @in VGC_GFXTRANS: Graphics-plane color treated as transparent by display composition; set this to a non-black color when blitting visible palette-0 black pixels.
000B21r 2               ; @out A: 0 on success, 1 on error.
000B21r 2               vsprite_blit:
000B21r 2  20 rr rr           JSR   vsprite_blit_start
000B24r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000B26r 2  D0 03              BNE   @done
000B28r 2  4C rr rr           JMP   blitter_wait
000B2Br 2               @done:
000B2Br 2  60                 RTS
000B2Cr 2               
000B2Cr 2               ; @label VSPRITE.BLIT_START
000B2Cr 2               ; @kind routine
000B2Cr 2               ; @symbol vsprite_blit_start
000B2Cr 2               ; @summary Start the configured virtual sprite blit without waiting for completion.
000B2Cr 2               ; @requires VSPRITE_SRCSPACE VSPRITE_DSTSPACE VSPRITE_SRCADDR* VSPRITE_DSTADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_SRCSTR* VSPRITE_DSTSTR*
000B2Cr 2               ; @in VSPRITE_FLAGS: Set bit 0 to enable color-key transparency.
000B2Cr 2               ; @in VSPRITE_COLORKEY: Source byte skipped when color-key mode is enabled.
000B2Cr 2               ; @out A: 0 after the blit command is issued.
000B2Cr 2               vsprite_blit_start:
000B2Cr 2  AD rr rr           LDA   VSPRITE_SRCSPACE
000B2Fr 2  8D 86 BA           STA   BLT_SRCSPACE
000B32r 2  AD rr rr           LDA   VSPRITE_DSTSPACE
000B35r 2  8D 87 BA           STA   BLT_DSTSPACE
000B38r 2  AD rr rr           LDA   VSPRITE_SRCADDRL
000B3Br 2  8D 88 BA           STA   BLT_SRCL
000B3Er 2  AD rr rr           LDA   VSPRITE_SRCADDRM
000B41r 2  8D 89 BA           STA   BLT_SRCM
000B44r 2  AD rr rr           LDA   VSPRITE_SRCADDRH
000B47r 2  8D 8A BA           STA   BLT_SRCH
000B4Ar 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000B4Dr 2  8D 8B BA           STA   BLT_DSTL
000B50r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000B53r 2  8D 8C BA           STA   BLT_DSTM
000B56r 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000B59r 2  8D 8D BA           STA   BLT_DSTH
000B5Cr 2  AD rr rr           LDA   VSPRITE_WIDTHL
000B5Fr 2  8D 8E BA           STA   BLT_WIDTHL
000B62r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000B65r 2  8D 8F BA           STA   BLT_WIDTHH
000B68r 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000B6Br 2  8D 90 BA           STA   BLT_HEIGHTL
000B6Er 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000B71r 2  8D 91 BA           STA   BLT_HEIGHTH
000B74r 2  AD rr rr           LDA   VSPRITE_SRCSTRL
000B77r 2  8D 92 BA           STA   BLT_SRCSTRL
000B7Ar 2  AD rr rr           LDA   VSPRITE_SRCSTRH
000B7Dr 2  8D 93 BA           STA   BLT_SRCSTRH
000B80r 2  AD rr rr           LDA   VSPRITE_DSTSTRL
000B83r 2  8D 94 BA           STA   BLT_DSTSTRL
000B86r 2  AD rr rr           LDA   VSPRITE_DSTSTRH
000B89r 2  8D 95 BA           STA   BLT_DSTSTRH
000B8Cr 2  AD rr rr           LDA   VSPRITE_COLORKEY
000B8Fr 2  8D 98 BA           STA   BLT_CKEY
000B92r 2  AD rr rr           LDA   VSPRITE_FLAGS
000B95r 2  29 01              AND   #VSPRITE_FLAG_COLORKEY
000B97r 2  F0 04              BEQ   @no_key
000B99r 2  A9 02              LDA   #BLT_MODE_COLORKEY
000B9Br 2  80 02              BRA   @mode
000B9Dr 2               @no_key:
000B9Dr 2  A9 00              LDA   #$00
000B9Fr 2               @mode:
000B9Fr 2  8D 96 BA           STA   BLT_MODE_REG
000BA2r 2  A9 01              LDA   #BLT_CMD_START
000BA4r 2  8D 83 BA           STA   BLT_CMD_REG
000BA7r 2  A9 00              LDA   #VSPRITE_RESULT_OK
000BA9r 2  60                 RTS
000BAAr 2               
000BAAr 2               ; @label VSPRITE.FILL
000BAAr 2               ; @kind routine
000BAAr 2               ; @symbol vsprite_fill
000BAAr 2               ; @summary Fill the configured destination rectangle with VSPRITE.FILLVALUE.
000BAAr 2               ; @requires VSPRITE_DSTSPACE VSPRITE_DSTADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_DSTSTR*
000BAAr 2               ; @out A: 0 on success, 1 on error.
000BAAr 2               vsprite_fill:
000BAAr 2  AD rr rr           LDA   VSPRITE_DSTSPACE
000BADr 2  8D 87 BA           STA   BLT_DSTSPACE
000BB0r 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000BB3r 2  8D 8B BA           STA   BLT_DSTL
000BB6r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000BB9r 2  8D 8C BA           STA   BLT_DSTM
000BBCr 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000BBFr 2  8D 8D BA           STA   BLT_DSTH
000BC2r 2  AD rr rr           LDA   VSPRITE_WIDTHL
000BC5r 2  8D 8E BA           STA   BLT_WIDTHL
000BC8r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000BCBr 2  8D 8F BA           STA   BLT_WIDTHH
000BCEr 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000BD1r 2  8D 90 BA           STA   BLT_HEIGHTL
000BD4r 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000BD7r 2  8D 91 BA           STA   BLT_HEIGHTH
000BDAr 2  AD rr rr           LDA   VSPRITE_DSTSTRL
000BDDr 2  8D 94 BA           STA   BLT_DSTSTRL
000BE0r 2  AD rr rr           LDA   VSPRITE_DSTSTRH
000BE3r 2  8D 95 BA           STA   BLT_DSTSTRH
000BE6r 2  AD rr rr           LDA   VSPRITE_FILLVALUE
000BE9r 2  8D 97 BA           STA   BLT_FILLVALUE
000BECr 2  4C rr rr           JMP   blitter_fill
000BEFr 2               
000BEFr 2               ; @label VSPRITE.USE_ORIGINAL
000BEFr 2               ; @kind routine
000BEFr 2               ; @symbol vsprite_use_original
000BEFr 2               ; @summary Point VSPRITE.SRC* at the configured immutable source shape.
000BEFr 2               ; @requires VSPRITE_ORIGSPACE VSPRITE_ORIGADDR* VSPRITE_ORIGSTR*
000BEFr 2               ; @out A: 0.
000BEFr 2               vsprite_use_original:
000BEFr 2  AD rr rr           LDA   VSPRITE_ORIGSPACE
000BF2r 2  8D rr rr           STA   VSPRITE_SRCSPACE
000BF5r 2  AD rr rr           LDA   VSPRITE_ORIGADDRL
000BF8r 2  8D rr rr           STA   VSPRITE_SRCADDRL
000BFBr 2  AD rr rr           LDA   VSPRITE_ORIGADDRM
000BFEr 2  8D rr rr           STA   VSPRITE_SRCADDRM
000C01r 2  AD rr rr           LDA   VSPRITE_ORIGADDRH
000C04r 2  8D rr rr           STA   VSPRITE_SRCADDRH
000C07r 2  AD rr rr           LDA   VSPRITE_ORIGSTRL
000C0Ar 2  8D rr rr           STA   VSPRITE_SRCSTRL
000C0Dr 2  AD rr rr           LDA   VSPRITE_ORIGSTRH
000C10r 2  8D rr rr           STA   VSPRITE_SRCSTRH
000C13r 2  A9 00              LDA   #VSPRITE_RESULT_OK
000C15r 2  60                 RTS
000C16r 2               
000C16r 2               ; @label VSPRITE.USE_ROTATED
000C16r 2               ; @kind routine
000C16r 2               ; @symbol vsprite_use_rotated
000C16r 2               ; @summary Point VSPRITE.SRC* at the configured rotated output buffer.
000C16r 2               ; @requires VSPRITE_ROTSPACE VSPRITE_ROTADDR* VSPRITE_ROTSTR*
000C16r 2               ; @out A: 0.
000C16r 2               vsprite_use_rotated:
000C16r 2  AD rr rr           LDA   VSPRITE_ROTSPACE
000C19r 2  8D rr rr           STA   VSPRITE_SRCSPACE
000C1Cr 2  AD rr rr           LDA   VSPRITE_ROTADDRL
000C1Fr 2  8D rr rr           STA   VSPRITE_SRCADDRL
000C22r 2  AD rr rr           LDA   VSPRITE_ROTADDRM
000C25r 2  8D rr rr           STA   VSPRITE_SRCADDRM
000C28r 2  AD rr rr           LDA   VSPRITE_ROTADDRH
000C2Br 2  8D rr rr           STA   VSPRITE_SRCADDRH
000C2Er 2  AD rr rr           LDA   VSPRITE_ROTSTRL
000C31r 2  8D rr rr           STA   VSPRITE_SRCSTRL
000C34r 2  AD rr rr           LDA   VSPRITE_ROTSTRH
000C37r 2  8D rr rr           STA   VSPRITE_SRCSTRH
000C3Ar 2  A9 00              LDA   #VSPRITE_RESULT_OK
000C3Cr 2  60                 RTS
000C3Dr 2               
000C3Dr 2               ; @label VSPRITE.ROTATE
000C3Dr 2               ; @kind routine
000C3Dr 2               ; @symbol vsprite_rotate
000C3Dr 2               ; @summary Rotate the configured square virtual sprite from immutable source into the caller-owned rotated buffer.
000C3Dr 2               ; @requires VSPRITE_ORIGSPACE VSPRITE_ORIGADDR* VSPRITE_ORIGSTR* VSPRITE_ROTSPACE VSPRITE_ROTADDR* VSPRITE_ROTSTR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_ROTANGLE
000C3Dr 2               ; @in VSPRITE_COLORKEY: Fill value for rotated output pixels outside the source bounds.
000C3Dr 2               ; @desc On success, VSPRITE.SRC* is automatically repointed at VSPRITE.ROT* so VSPRITE.GFX_BLIT draws the rotated copy. Hardware requires WIDTH == HEIGHT and both dimensions <= 256.
000C3Dr 2               ; @out A: 0 on success, 1 on error.
000C3Dr 2               vsprite_rotate:
000C3Dr 2  AD rr rr           LDA   VSPRITE_ORIGSPACE
000C40r 2  8D 86 BA           STA   BLT_SRCSPACE
000C43r 2  AD rr rr           LDA   VSPRITE_ROTSPACE
000C46r 2  8D 87 BA           STA   BLT_DSTSPACE
000C49r 2  AD rr rr           LDA   VSPRITE_ORIGADDRL
000C4Cr 2  8D 88 BA           STA   BLT_SRCL
000C4Fr 2  AD rr rr           LDA   VSPRITE_ORIGADDRM
000C52r 2  8D 89 BA           STA   BLT_SRCM
000C55r 2  AD rr rr           LDA   VSPRITE_ORIGADDRH
000C58r 2  8D 8A BA           STA   BLT_SRCH
000C5Br 2  AD rr rr           LDA   VSPRITE_ROTADDRL
000C5Er 2  8D 8B BA           STA   BLT_DSTL
000C61r 2  AD rr rr           LDA   VSPRITE_ROTADDRM
000C64r 2  8D 8C BA           STA   BLT_DSTM
000C67r 2  AD rr rr           LDA   VSPRITE_ROTADDRH
000C6Ar 2  8D 8D BA           STA   BLT_DSTH
000C6Dr 2  AD rr rr           LDA   VSPRITE_WIDTHL
000C70r 2  8D 8E BA           STA   BLT_WIDTHL
000C73r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000C76r 2  8D 8F BA           STA   BLT_WIDTHH
000C79r 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000C7Cr 2  8D 90 BA           STA   BLT_HEIGHTL
000C7Fr 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000C82r 2  8D 91 BA           STA   BLT_HEIGHTH
000C85r 2  AD rr rr           LDA   VSPRITE_ORIGSTRL
000C88r 2  8D 92 BA           STA   BLT_SRCSTRL
000C8Br 2  AD rr rr           LDA   VSPRITE_ORIGSTRH
000C8Er 2  8D 93 BA           STA   BLT_SRCSTRH
000C91r 2  AD rr rr           LDA   VSPRITE_ROTSTRL
000C94r 2  8D 94 BA           STA   BLT_DSTSTRL
000C97r 2  AD rr rr           LDA   VSPRITE_ROTSTRH
000C9Ar 2  8D 95 BA           STA   BLT_DSTSTRH
000C9Dr 2  AD rr rr           LDA   VSPRITE_COLORKEY
000CA0r 2  8D 98 BA           STA   BLT_CKEY
000CA3r 2  AD rr rr           LDA   VSPRITE_ROTANGLE
000CA6r 2  8D A2 BA           STA   BLT_ROTANGLE
000CA9r 2  A9 04              LDA   #BLT_MODE_ROTATE
000CABr 2  8D 96 BA           STA   BLT_MODE_REG
000CAEr 2  A9 01              LDA   #BLT_CMD_START
000CB0r 2  8D 83 BA           STA   BLT_CMD_REG
000CB3r 2  20 rr rr           JSR   blitter_wait
000CB6r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000CB8r 2  D0 03              BNE   @done
000CBAr 2  20 rr rr           JSR   vsprite_use_rotated
000CBDr 2               @done:
000CBDr 2  60                 RTS
000CBEr 2               
000CBEr 2               ; @label VSPRITE.GFX_ADDR
000CBEr 2               ; @kind routine
000CBEr 2               ; @symbol vsprite_gfx_addr
000CBEr 2               ; @summary Convert VSPRITE.X/Y to a linear VGC graphics-plane destination address.
000CBEr 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y
000CBEr 2               ; @out VSPRITE_DSTADDR*: y * 320 + x.
000CBEr 2               vsprite_gfx_addr:
000CBEr 2  9C rr rr           STZ   VSPRITE_DSTADDRL
000CC1r 2  AD rr rr           LDA   VSPRITE_Y
000CC4r 2  8D rr rr           STA   VSPRITE_DSTADDRM        ; y * 256
000CC7r 2  9C rr rr           STZ   VSPRITE_DSTADDRH
000CCAr 2               
000CCAr 2  AD rr rr           LDA   VSPRITE_Y               ; add y * 64
000CCDr 2  4A                 LSR
000CCEr 2  4A                 LSR
000CCFr 2  85 rr              STA   VSPRITE_TMP
000CD1r 2  AD rr rr           LDA   VSPRITE_Y
000CD4r 2  0A                 ASL
000CD5r 2  0A                 ASL
000CD6r 2  0A                 ASL
000CD7r 2  0A                 ASL
000CD8r 2  0A                 ASL
000CD9r 2  0A                 ASL
000CDAr 2  18                 CLC
000CDBr 2  6D rr rr           ADC   VSPRITE_DSTADDRL
000CDEr 2  8D rr rr           STA   VSPRITE_DSTADDRL
000CE1r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000CE4r 2  65 rr              ADC   VSPRITE_TMP
000CE6r 2  8D rr rr           STA   VSPRITE_DSTADDRM
000CE9r 2  90 03              BCC   @add_x
000CEBr 2  EE rr rr           INC   VSPRITE_DSTADDRH
000CEEr 2               
000CEEr 2               @add_x:
000CEEr 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000CF1r 2  18                 CLC
000CF2r 2  6D rr rr           ADC   VSPRITE_XL
000CF5r 2  8D rr rr           STA   VSPRITE_DSTADDRL
000CF8r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000CFBr 2  6D rr rr           ADC   VSPRITE_XH
000CFEr 2  8D rr rr           STA   VSPRITE_DSTADDRM
000D01r 2  90 03              BCC   @done
000D03r 2  EE rr rr           INC   VSPRITE_DSTADDRH
000D06r 2               @done:
000D06r 2  60                 RTS
000D07r 2               
000D07r 2               ; @label VSPRITE.GFX_BLIT
000D07r 2               ; @kind routine
000D07r 2               ; @symbol vsprite_gfx_blit
000D07r 2               ; @summary Copy the configured virtual sprite to the VGC graphics plane at X/Y.
000D07r 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_SRCSPACE VSPRITE_SRCADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_SRCSTR*
000D07r 2               ; @in VSPRITE_COLORKEY: Source transparent color when VSPRITE_FLAG_COLORKEY is set; normally match this to VGC_GFXTRANS for graphics-plane virtual sprites.
000D07r 2               ; @out A: 0 on success, 1 on error.
000D07r 2               vsprite_gfx_blit:
000D07r 2  20 rr rr           JSR   vsprite_gfx_addr
000D0Ar 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000D0Cr 2  8D rr rr           STA   VSPRITE_DSTSPACE
000D0Fr 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000D11r 2  8D rr rr           STA   VSPRITE_DSTSTRL
000D14r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000D16r 2  8D rr rr           STA   VSPRITE_DSTSTRH
000D19r 2  4C rr rr           JMP   vsprite_blit
000D1Cr 2               
000D1Cr 2               ; @label VSPRITE.GFX_BLIT_START
000D1Cr 2               ; @kind routine
000D1Cr 2               ; @symbol vsprite_gfx_blit_start
000D1Cr 2               ; @summary Start copying the configured virtual sprite to the VGC graphics plane at X/Y without waiting for completion.
000D1Cr 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_SRCSPACE VSPRITE_SRCADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_SRCSTR*
000D1Cr 2               ; @out A: 0 after the blit command is issued.
000D1Cr 2               vsprite_gfx_blit_start:
000D1Cr 2  20 rr rr           JSR   vsprite_gfx_addr
000D1Fr 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000D21r 2  8D rr rr           STA   VSPRITE_DSTSPACE
000D24r 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000D26r 2  8D rr rr           STA   VSPRITE_DSTSTRL
000D29r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000D2Br 2  8D rr rr           STA   VSPRITE_DSTSTRH
000D2Er 2  4C rr rr           JMP   vsprite_blit_start
000D31r 2               
000D31r 2               ; @label VSPRITE.GFX_ROTATE_BLIT
000D31r 2               ; @kind routine
000D31r 2               ; @symbol vsprite_gfx_rotate_blit
000D31r 2               ; @summary Rotate the configured virtual sprite offscreen, wait for the next frame, then copy the full rotated bounds to the graphics plane at X/Y.
000D31r 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_ORIGSPACE VSPRITE_ORIGADDR* VSPRITE_ORIGSTR* VSPRITE_ROTSPACE VSPRITE_ROTADDR* VSPRITE_ROTSTR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_ROTANGLE
000D31r 2               ; @in VSPRITE_COLORKEY: Fill value for rotated output pixels outside the source bounds; normally match this to VGC_GFXTRANS.
000D31r 2               ; @desc The final graphics blit is intentionally non-color-keyed so transparent pixels from the rotated buffer clear the previous frame in the same visible copy.
000D31r 2               ; @out A: 0 on success, 1 on error.
000D31r 2               vsprite_gfx_rotate_blit:
000D31r 2  20 rr rr           JSR   vsprite_rotate
000D34r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000D36r 2  D0 06              BNE   @done
000D38r 2  20 rr rr           JSR   vsprite_wait_frame
000D3Br 2  4C rr rr           JMP   vsprite_gfx_blit_rotated
000D3Er 2               @done:
000D3Er 2  60                 RTS
000D3Fr 2               
000D3Fr 2               ; @label VSPRITE.GFX_ROTATE_BLIT_KEYED
000D3Fr 2               ; @kind routine
000D3Fr 2               ; @symbol vsprite_gfx_rotate_blit_keyed
000D3Fr 2               ; @summary Rotate the configured virtual sprite, wait for the next frame, then blit it with the caller's VSPRITE.FLAGS.
000D3Fr 2               ; @requires VSPRITE.X/Y VSPRITE.ORIG* VSPRITE.ROT* VSPRITE.WIDTH/HEIGHT VSPRITE.ROTANGLE
000D3Fr 2               ; @in VSPRITE_FLAGS: Set VSPRITE_FLAG_COLORKEY to preserve existing graphics-plane pixels where the rotated sprite is transparent.
000D3Fr 2               ; @out A: 0 on success, 1 on error.
000D3Fr 2               vsprite_gfx_rotate_blit_keyed:
000D3Fr 2  20 rr rr           JSR   vsprite_rotate
000D42r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000D44r 2  D0 06              BNE   @done
000D46r 2  20 rr rr           JSR   vsprite_wait_frame
000D49r 2  4C rr rr           JMP   vsprite_gfx_blit
000D4Cr 2               @done:
000D4Cr 2  60                 RTS
000D4Dr 2               
000D4Dr 2               ; @label VSPRITE.GFX_ROTATE_BLIT_NOWAIT
000D4Dr 2               ; @kind routine
000D4Dr 2               ; @symbol vsprite_gfx_rotate_blit_nowait
000D4Dr 2               ; @summary Rotate the configured virtual sprite offscreen, then start copying the full rotated bounds to graphics memory without waiting for VGC.FRAME or final blit completion.
000D4Dr 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_ORIGSPACE VSPRITE_ORIGADDR* VSPRITE_ORIGSTR* VSPRITE_ROTSPACE VSPRITE_ROTADDR* VSPRITE_ROTSTR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_ROTANGLE
000D4Dr 2               ; @in VSPRITE_COLORKEY: Fill value for rotated output pixels outside the source bounds; normally match this to VGC_GFXTRANS.
000D4Dr 2               ; @desc Use this in command/REPL paths or runtimes that already own frame pacing.
000D4Dr 2               ; @out A: 0 on success, 1 on error.
000D4Dr 2               vsprite_gfx_rotate_blit_nowait:
000D4Dr 2  20 rr rr           JSR   vsprite_rotate
000D50r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000D52r 2  D0 25              BNE   vsprite_gfx_rotate_done
000D54r 2  AD rr rr           LDA   VSPRITE_FLAGS
000D57r 2  48                 PHA
000D58r 2  9C rr rr           STZ   VSPRITE_FLAGS
000D5Br 2  20 rr rr           JSR   vsprite_gfx_blit_start
000D5Er 2  85 rr              STA   VSPRITE_TMP
000D60r 2  68                 PLA
000D61r 2  8D rr rr           STA   VSPRITE_FLAGS
000D64r 2  A5 rr              LDA   VSPRITE_TMP
000D66r 2  60                 RTS
000D67r 2               
000D67r 2               vsprite_gfx_blit_rotated:
000D67r 2  AD rr rr           LDA   VSPRITE_FLAGS
000D6Ar 2  48                 PHA
000D6Br 2  9C rr rr           STZ   VSPRITE_FLAGS
000D6Er 2  20 rr rr           JSR   vsprite_gfx_blit
000D71r 2  85 rr              STA   VSPRITE_TMP
000D73r 2  68                 PLA
000D74r 2  8D rr rr           STA   VSPRITE_FLAGS
000D77r 2  A5 rr              LDA   VSPRITE_TMP
000D79r 2               vsprite_gfx_rotate_done:
000D79r 2  60                 RTS
000D7Ar 2               
000D7Ar 2               vsprite_wait_frame:
000D7Ar 2  AD 08 A0           LDA   VGC_FRAME
000D7Dr 2               @wait:
000D7Dr 2  CD 08 A0           CMP   VGC_FRAME
000D80r 2  F0 FB              BEQ   @wait
000D82r 2  60                 RTS
000D83r 2               
000D83r 2               ; @label VSPRITE.GFX_FILL
000D83r 2               ; @kind routine
000D83r 2               ; @symbol vsprite_gfx_fill
000D83r 2               ; @summary Fill a graphics-plane rectangle at VSPRITE.X/Y.
000D83r 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_FILLVALUE
000D83r 2               ; @out A: 0 on success, 1 on error.
000D83r 2               vsprite_gfx_fill:
000D83r 2  20 rr rr           JSR   vsprite_gfx_addr
000D86r 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000D88r 2  8D rr rr           STA   VSPRITE_DSTSPACE
000D8Br 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000D8Dr 2  8D rr rr           STA   VSPRITE_DSTSTRL
000D90r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000D92r 2  8D rr rr           STA   VSPRITE_DSTSTRH
000D95r 2  4C rr rr           JMP   vsprite_fill
000D98r 2               
000D98r 2               ; @label VSPRITE.GFX_SAVE_BG
000D98r 2               ; @kind routine
000D98r 2               ; @symbol vsprite_gfx_save_bg
000D98r 2               ; @summary Save a graphics-plane rectangle under VSPRITE.X/Y into the caller-owned VSPRITE.BG* buffer.
000D98r 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_BGSPACE VSPRITE_BGADDR* VSPRITE_BGSTR*
000D98r 2               ; @out A: 0 on success, 1 on error.
000D98r 2               vsprite_gfx_save_bg:
000D98r 2  20 rr rr           JSR   vsprite_gfx_addr
000D9Br 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000D9Dr 2  8D 86 BA           STA   BLT_SRCSPACE
000DA0r 2  AD rr rr           LDA   VSPRITE_BGSPACE
000DA3r 2  8D 87 BA           STA   BLT_DSTSPACE
000DA6r 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000DA9r 2  8D 88 BA           STA   BLT_SRCL
000DACr 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000DAFr 2  8D 89 BA           STA   BLT_SRCM
000DB2r 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000DB5r 2  8D 8A BA           STA   BLT_SRCH
000DB8r 2  AD rr rr           LDA   VSPRITE_BGADDRL
000DBBr 2  8D 8B BA           STA   BLT_DSTL
000DBEr 2  AD rr rr           LDA   VSPRITE_BGADDRM
000DC1r 2  8D 8C BA           STA   BLT_DSTM
000DC4r 2  AD rr rr           LDA   VSPRITE_BGADDRH
000DC7r 2  8D 8D BA           STA   BLT_DSTH
000DCAr 2  AD rr rr           LDA   VSPRITE_WIDTHL
000DCDr 2  8D 8E BA           STA   BLT_WIDTHL
000DD0r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000DD3r 2  8D 8F BA           STA   BLT_WIDTHH
000DD6r 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000DD9r 2  8D 90 BA           STA   BLT_HEIGHTL
000DDCr 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000DDFr 2  8D 91 BA           STA   BLT_HEIGHTH
000DE2r 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000DE4r 2  8D 92 BA           STA   BLT_SRCSTRL
000DE7r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000DE9r 2  8D 93 BA           STA   BLT_SRCSTRH
000DECr 2  AD rr rr           LDA   VSPRITE_BGSTRL
000DEFr 2  8D 94 BA           STA   BLT_DSTSTRL
000DF2r 2  AD rr rr           LDA   VSPRITE_BGSTRH
000DF5r 2  8D 95 BA           STA   BLT_DSTSTRH
000DF8r 2  4C rr rr           JMP   blitter_start_copy
000DFBr 2               
000DFBr 2               ; @label VSPRITE.GFX_RESTORE_BG
000DFBr 2               ; @kind routine
000DFBr 2               ; @symbol vsprite_gfx_restore_bg
000DFBr 2               ; @summary Restore a caller-owned VSPRITE.BG* buffer into the graphics plane at VSPRITE.X/Y.
000DFBr 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_BGSPACE VSPRITE_BGADDR* VSPRITE_BGSTR*
000DFBr 2               ; @out A: 0 on success, 1 on error.
000DFBr 2               vsprite_gfx_restore_bg:
000DFBr 2  20 rr rr           JSR   vsprite_gfx_addr
000DFEr 2  AD rr rr           LDA   VSPRITE_BGSPACE
000E01r 2  8D 86 BA           STA   BLT_SRCSPACE
000E04r 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000E06r 2  8D 87 BA           STA   BLT_DSTSPACE
000E09r 2  AD rr rr           LDA   VSPRITE_BGADDRL
000E0Cr 2  8D 88 BA           STA   BLT_SRCL
000E0Fr 2  AD rr rr           LDA   VSPRITE_BGADDRM
000E12r 2  8D 89 BA           STA   BLT_SRCM
000E15r 2  AD rr rr           LDA   VSPRITE_BGADDRH
000E18r 2  8D 8A BA           STA   BLT_SRCH
000E1Br 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000E1Er 2  8D 8B BA           STA   BLT_DSTL
000E21r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000E24r 2  8D 8C BA           STA   BLT_DSTM
000E27r 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000E2Ar 2  8D 8D BA           STA   BLT_DSTH
000E2Dr 2  AD rr rr           LDA   VSPRITE_WIDTHL
000E30r 2  8D 8E BA           STA   BLT_WIDTHL
000E33r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000E36r 2  8D 8F BA           STA   BLT_WIDTHH
000E39r 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000E3Cr 2  8D 90 BA           STA   BLT_HEIGHTL
000E3Fr 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000E42r 2  8D 91 BA           STA   BLT_HEIGHTH
000E45r 2  AD rr rr           LDA   VSPRITE_BGSTRL
000E48r 2  8D 92 BA           STA   BLT_SRCSTRL
000E4Br 2  AD rr rr           LDA   VSPRITE_BGSTRH
000E4Er 2  8D 93 BA           STA   BLT_SRCSTRH
000E51r 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000E53r 2  8D 94 BA           STA   BLT_DSTSTRL
000E56r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000E58r 2  8D 95 BA           STA   BLT_DSTSTRH
000E5Br 2  4C rr rr           JMP   blitter_start_copy
000E5Er 2               
000E5Er 2               ; @label VSPRITE.SCENE_BEGIN
000E5Er 2               ; @kind routine
000E5Er 2               ; @symbol vsprite_scene_begin
000E5Er 2               ; @summary Restore all saved old backgrounds in the configured scene descriptor list.
000E5Er 2               ; @requires VSPRITE_SCENE_ADDRL VSPRITE_SCENE_ADDRH VSPRITE_SCENE_COUNT
000E5Er 2               ; @desc Call this once per animation frame before updating descriptor X/Y values. Descriptors with VSPRITE.DESC_SAVED are restored and have that internal flag cleared.
000E5Er 2               vsprite_scene_begin:
000E5Er 2  20 rr rr           JSR   vsprite_scene_rewind
000E61r 2               @loop:
000E61r 2  AD rr rr           LDA   VSPRITE_SCENE_REMAIN
000E64r 2  F0 1B              BEQ   @done
000E66r 2  A0 00              LDY   #VSPRITE_DESC_FLAGS
000E68r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
000E6Ar 2  29 40              AND   #VSPRITE_DESC_SAVED
000E6Cr 2  F0 0E              BEQ   @next
000E6Er 2  20 rr rr           JSR   vsprite_scene_load_old
000E71r 2  20 rr rr           JSR   vsprite_gfx_restore_bg
000E74r 2  A0 00              LDY   #VSPRITE_DESC_FLAGS
000E76r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
000E78r 2  29 BF              AND   #$BF
000E7Ar 2  91 rr              STA   (VSPRITE_DESC_PTR),Y
000E7Cr 2               @next:
000E7Cr 2  20 rr rr           JSR   vsprite_scene_next
000E7Fr 2  80 E0              BRA   @loop
000E81r 2               @done:
000E81r 2  60                 RTS
000E82r 2               
000E82r 2               ; @label VSPRITE.SCENE_COMMIT
000E82r 2               ; @kind routine
000E82r 2               ; @symbol vsprite_scene_commit
000E82r 2               ; @summary Save all current backgrounds, then draw all visible descriptors in list order.
000E82r 2               ; @requires VSPRITE_SCENE_ADDRL VSPRITE_SCENE_ADDRH VSPRITE_SCENE_COUNT
000E82r 2               ; @desc List order is z-order: later descriptors draw in front of earlier descriptors.
000E82r 2               vsprite_scene_commit:
000E82r 2  20 rr rr           JSR   vsprite_scene_save
000E85r 2                     ; fall through
000E85r 2               
000E85r 2               ; @label VSPRITE.SCENE_DRAW
000E85r 2               ; @kind routine
000E85r 2               ; @symbol vsprite_scene_draw
000E85r 2               ; @summary Draw all visible descriptors in list order without saving backgrounds.
000E85r 2               ; @requires VSPRITE_SCENE_ADDRL VSPRITE_SCENE_ADDRH VSPRITE_SCENE_COUNT
000E85r 2               vsprite_scene_draw:
000E85r 2  20 rr rr           JSR   vsprite_scene_rewind
000E88r 2               @loop:
000E88r 2  AD rr rr           LDA   VSPRITE_SCENE_REMAIN
000E8Br 2  F0 13              BEQ   @done
000E8Dr 2  A0 00              LDY   #VSPRITE_DESC_FLAGS
000E8Fr 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
000E91r 2  29 80              AND   #VSPRITE_DESC_VISIBLE
000E93r 2  F0 06              BEQ   @next
000E95r 2  20 rr rr           JSR   vsprite_scene_load_current
000E98r 2  20 rr rr           JSR   vsprite_gfx_blit
000E9Br 2               @next:
000E9Br 2  20 rr rr           JSR   vsprite_scene_next
000E9Er 2  80 E8              BRA   @loop
000EA0r 2               @done:
000EA0r 2  60                 RTS
000EA1r 2               
000EA1r 2               ; @label VSPRITE.SCENE_COMMIT_ATOMIC
000EA1r 2               ; @kind routine
000EA1r 2               ; @symbol vsprite_scene_commit_atomic
000EA1r 2               ; @summary Compose a scene into a caller-owned work buffer, then commit the completed dirty rectangle to graphics memory.
000EA1r 2               ; @requires VSPRITE_SCENE_ADDRL VSPRITE_SCENE_ADDRH VSPRITE_SCENE_COUNT VSPRITE_SCENE_X* VSPRITE_SCENE_Y VSPRITE_SCENE_WIDTH* VSPRITE_SCENE_HEIGHT* VSPRITE_SCENE_WORK*
000EA1r 2               ; @desc The final visible commit is one graphics-plane blit. It is visually atomic only when the dirty rectangle fits in one vblank-safe write window.
000EA1r 2               vsprite_scene_commit_atomic:
000EA1r 2  20 rr rr           JSR   vsprite_scene_gfx_to_work
000EA4r 2  20 rr rr           JSR   vsprite_scene_restore_old_to_work
000EA7r 2  20 rr rr           JSR   vsprite_scene_save_current_from_work
000EAAr 2  20 rr rr           JSR   vsprite_scene_draw_current_to_work
000EADr 2  4C rr rr           JMP   vsprite_scene_work_to_gfx
000EB0r 2               
000EB0r 2               vsprite_scene_gfx_to_work:
000EB0r 2  AD rr rr           LDA   VSPRITE_SCENE_XL
000EB3r 2  8D rr rr           STA   VSPRITE_XL
000EB6r 2  AD rr rr           LDA   VSPRITE_SCENE_XH
000EB9r 2  8D rr rr           STA   VSPRITE_XH
000EBCr 2  AD rr rr           LDA   VSPRITE_SCENE_Y
000EBFr 2  8D rr rr           STA   VSPRITE_Y
000EC2r 2  20 rr rr           JSR   vsprite_gfx_addr
000EC5r 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000EC7r 2  8D 86 BA           STA   BLT_SRCSPACE
000ECAr 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSPACE
000ECDr 2  8D 87 BA           STA   BLT_DSTSPACE
000ED0r 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000ED3r 2  8D 88 BA           STA   BLT_SRCL
000ED6r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000ED9r 2  8D 89 BA           STA   BLT_SRCM
000EDCr 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000EDFr 2  8D 8A BA           STA   BLT_SRCH
000EE2r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKADDRL
000EE5r 2  8D 8B BA           STA   BLT_DSTL
000EE8r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKADDRM
000EEBr 2  8D 8C BA           STA   BLT_DSTM
000EEEr 2  AD rr rr           LDA   VSPRITE_SCENE_WORKADDRH
000EF1r 2  8D 8D BA           STA   BLT_DSTH
000EF4r 2  20 rr rr           JSR   vsprite_scene_load_dirty_size
000EF7r 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000EF9r 2  8D 92 BA           STA   BLT_SRCSTRL
000EFCr 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000EFEr 2  8D 93 BA           STA   BLT_SRCSTRH
000F01r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSTRL
000F04r 2  8D 94 BA           STA   BLT_DSTSTRL
000F07r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSTRH
000F0Ar 2  8D 95 BA           STA   BLT_DSTSTRH
000F0Dr 2  4C rr rr           JMP   blitter_start_copy
000F10r 2               
000F10r 2               vsprite_scene_work_to_gfx:
000F10r 2  AD rr rr           LDA   VSPRITE_SCENE_XL
000F13r 2  8D rr rr           STA   VSPRITE_XL
000F16r 2  AD rr rr           LDA   VSPRITE_SCENE_XH
000F19r 2  8D rr rr           STA   VSPRITE_XH
000F1Cr 2  AD rr rr           LDA   VSPRITE_SCENE_Y
000F1Fr 2  8D rr rr           STA   VSPRITE_Y
000F22r 2  20 rr rr           JSR   vsprite_gfx_addr
000F25r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSPACE
000F28r 2  8D 86 BA           STA   BLT_SRCSPACE
000F2Br 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000F2Dr 2  8D 87 BA           STA   BLT_DSTSPACE
000F30r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKADDRL
000F33r 2  8D 88 BA           STA   BLT_SRCL
000F36r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKADDRM
000F39r 2  8D 89 BA           STA   BLT_SRCM
000F3Cr 2  AD rr rr           LDA   VSPRITE_SCENE_WORKADDRH
000F3Fr 2  8D 8A BA           STA   BLT_SRCH
000F42r 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000F45r 2  8D 8B BA           STA   BLT_DSTL
000F48r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000F4Br 2  8D 8C BA           STA   BLT_DSTM
000F4Er 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000F51r 2  8D 8D BA           STA   BLT_DSTH
000F54r 2  20 rr rr           JSR   vsprite_scene_load_dirty_size
000F57r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSTRL
000F5Ar 2  8D 92 BA           STA   BLT_SRCSTRL
000F5Dr 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSTRH
000F60r 2  8D 93 BA           STA   BLT_SRCSTRH
000F63r 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000F65r 2  8D 94 BA           STA   BLT_DSTSTRL
000F68r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000F6Ar 2  8D 95 BA           STA   BLT_DSTSTRH
000F6Dr 2  4C rr rr           JMP   blitter_start_copy
000F70r 2               
000F70r 2               vsprite_scene_load_dirty_size:
000F70r 2  AD rr rr           LDA   VSPRITE_SCENE_WIDTHL
000F73r 2  8D 8E BA           STA   BLT_WIDTHL
000F76r 2  AD rr rr           LDA   VSPRITE_SCENE_WIDTHH
000F79r 2  8D 8F BA           STA   BLT_WIDTHH
000F7Cr 2  AD rr rr           LDA   VSPRITE_SCENE_HEIGHTL
000F7Fr 2  8D 90 BA           STA   BLT_HEIGHTL
000F82r 2  AD rr rr           LDA   VSPRITE_SCENE_HEIGHTH
000F85r 2  8D 91 BA           STA   BLT_HEIGHTH
000F88r 2  60                 RTS
000F89r 2               
000F89r 2               vsprite_scene_restore_old_to_work:
000F89r 2  20 rr rr           JSR   vsprite_scene_rewind
000F8Cr 2               @loop:
000F8Cr 2  AD rr rr           LDA   VSPRITE_SCENE_REMAIN
000F8Fr 2  F0 61              BEQ   @done
000F91r 2  A0 00              LDY   #VSPRITE_DESC_FLAGS
000F93r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
000F95r 2  29 40              AND   #VSPRITE_DESC_SAVED
000F97r 2  F0 54              BEQ   @next
000F99r 2  20 rr rr           JSR   vsprite_scene_load_old
000F9Cr 2  20 rr rr           JSR   vsprite_scene_calc_work_addr
000F9Fr 2  AD rr rr           LDA   VSPRITE_BGSPACE
000FA2r 2  8D 86 BA           STA   BLT_SRCSPACE
000FA5r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSPACE
000FA8r 2  8D 87 BA           STA   BLT_DSTSPACE
000FABr 2  AD rr rr           LDA   VSPRITE_BGADDRL
000FAEr 2  8D 88 BA           STA   BLT_SRCL
000FB1r 2  AD rr rr           LDA   VSPRITE_BGADDRM
000FB4r 2  8D 89 BA           STA   BLT_SRCM
000FB7r 2  AD rr rr           LDA   VSPRITE_BGADDRH
000FBAr 2  8D 8A BA           STA   BLT_SRCH
000FBDr 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000FC0r 2  8D 8B BA           STA   BLT_DSTL
000FC3r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000FC6r 2  8D 8C BA           STA   BLT_DSTM
000FC9r 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000FCCr 2  8D 8D BA           STA   BLT_DSTH
000FCFr 2  20 rr rr           JSR   vsprite_scene_load_sprite_size
000FD2r 2  AD rr rr           LDA   VSPRITE_BGSTRL
000FD5r 2  8D 92 BA           STA   BLT_SRCSTRL
000FD8r 2  AD rr rr           LDA   VSPRITE_BGSTRH
000FDBr 2  8D 93 BA           STA   BLT_SRCSTRH
000FDEr 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSTRL
000FE1r 2  8D 94 BA           STA   BLT_DSTSTRL
000FE4r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSTRH
000FE7r 2  8D 95 BA           STA   BLT_DSTSTRH
000FEAr 2  20 rr rr           JSR   blitter_start_copy
000FEDr 2               @next:
000FEDr 2  20 rr rr           JSR   vsprite_scene_next
000FF0r 2  80 9A              BRA   @loop
000FF2r 2               @done:
000FF2r 2  60                 RTS
000FF3r 2               
000FF3r 2               vsprite_scene_save_current_from_work:
000FF3r 2  20 rr rr           JSR   vsprite_scene_rewind
000FF6r 2               @loop:
000FF6r 2  AD rr rr           LDA   VSPRITE_SCENE_REMAIN
000FF9r 2  F0 6C              BEQ   @done
000FFBr 2  A0 00              LDY   #VSPRITE_DESC_FLAGS
000FFDr 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
000FFFr 2  29 80              AND   #VSPRITE_DESC_VISIBLE
001001r 2  F0 5F              BEQ   @next
001003r 2  20 rr rr           JSR   vsprite_scene_load_current
001006r 2  20 rr rr           JSR   vsprite_scene_calc_work_addr
001009r 2  AD rr rr           LDA   VSPRITE_SCENE_WORKSPACE
00100Cr 2  8D 86 BA           STA   BLT_SRCSPACE
00100Fr 2  AD rr rr           LDA   VSPRITE_BGSPACE
001012r 2  8D 87 BA           STA   BLT_DSTSPACE
001015r 2  AD rr rr           LDA   VSPRITE_DSTADDRL
001018r 2  8D 88 BA           STA   BLT_SRCL
00101Br 2  AD rr rr           LDA   VSPRITE_DSTADDRM
00101Er 2  8D 89 BA           STA   BLT_SRCM
001021r 2  AD rr rr           LDA   VSPRITE_DSTADDRH
001024r 2  8D 8A BA           STA   BLT_SRCH
001027r 2  AD rr rr           LDA   VSPRITE_BGADDRL
00102Ar 2  8D 8B BA           STA   BLT_DSTL
00102Dr 2  AD rr rr           LDA   VSPRITE_BGADDRM
001030r 2  8D 8C BA           STA   BLT_DSTM
001033r 2  AD rr rr           LDA   VSPRITE_BGADDRH
001036r 2  8D 8D BA           STA   BLT_DSTH
001039r 2  20 rr rr           JSR   vsprite_scene_load_sprite_size
