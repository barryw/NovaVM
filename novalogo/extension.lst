0024D7r 2                     ; cursor < len ?
0024D7r 2  AD rr rr           LDA   EDITBUF_CURL
0024DAr 2  CD rr rr           CMP   EDITBUF_LENL
0024DDr 2  AD rr rr           LDA   EDITBUF_CURH
0024E0r 2  ED rr rr           SBC   EDITBUF_LENH
0024E3r 2  B0 36              BCS   @done                 ; cursor >= len
0024E5r 2                     ; peek the byte at the cursor to tell a line join (\n) from an in-line delete.
0024E5r 2  AE rr rr           LDX   EDITBUF_CURL
0024E8r 2  AD rr rr           LDA   EDITBUF_CURH
