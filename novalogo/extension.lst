001903r 2  85 rr              STA   EDITUI_SCANL
001905r 2  AD rr rr           LDA   EDITUI_PRINTH
001908r 2  85 rr              STA   EDITUI_SCANH
00190Ar 2  9C rr rr           STZ   EDITUI_LEN
00190Dr 2               @loop:
