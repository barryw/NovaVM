000000r 3               NVR2H             = $25
000000r 3               .endif
000000r 3               .ifndef NVR3L
000000r 3               NVR3L             = $26
000000r 3               .endif
000000r 3               .ifndef NVR3H
000000r 3               NVR3H             = $27
000000r 3               .endif
