000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; Editor body geometry. Minimal full-screen layout (no frame, no title band):
000000r 2               ;   row 0          : menu bar (File/Edit/Help + title + dirty marker)
000000r 2               ;   rows 1..N-2    : editable body, full 80 columns
000000r 2               ;   row N-1        : status bar (help / status message)
000000r 2               ; ---------------------------------------------------------------------
000000r 2               EDITBUF_VIEW_LEFT   = 0                               ; first text column
000000r 2               EDITBUF_VIEW_TOP    = 1                               ; first text row (below menu bar)
000000r 2               EDITBUF_VIEW_COLS   = EDITUI_SCREEN_COLS              ; 80 visible columns
000000r 2               EDITBUF_VIEW_ROWS   = EDITUI_SCREEN_ROWS - 2          ; 48 (menu bar + status bar reserved)
000000r 2               
000000r 2               ; Clipboard capacity (bytes). Lives in editbuf BSS.
000000r 2               EDITBUF_CLIP_CAP    = 256
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; Exit reason returned in A by editbuf_run (also stored in EDITBUF_RESULT).
000000r 2               ; ---------------------------------------------------------------------
000000r 2               EDITBUF_EXIT_QUIT    = $00      ; Ctrl-Q while clean
000000r 2               EDITBUF_EXIT_SAVED   = $01      ; left via dialog "Save First" after a clean save
000000r 2               EDITBUF_EXIT_DISCARD = $02      ; left via dialog "Exit Anyway" (draft preserved)
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; SAVE hook contract.
000000r 2               ;   Called with no arguments (current text is in EDITBUF_BUF / EDITBUF_LEN).
000000r 2               ;   Returns status in A:
000000r 2               ; ---------------------------------------------------------------------
000000r 2               EDITBUF_SAVE_OK      = $00      ; saved + installed: clears dirty
000000r 2               EDITBUF_SAVE_DRAFT   = $01      ; draft kept but not usable: stays "dirty"-ish
000000r 2               EDITBUF_SAVE_ERROR   = $02      ; rejected: stays dirty
000000r 2               ; The host may point EDITBUF_STATUS at a message string before returning; the
000000r 2               ; editor redraws the status bar with it.
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; INDENT hook contract.
000000r 2               ;   Called after a newline is inserted. The cursor sits at the start of the
000000r 2               ;   freshly created line. Returns in A the number of leading spaces to insert
000000r 2               ;   (0 = no auto-indent). editbuf inserts that many spaces.
000000r 2               ; ---------------------------------------------------------------------
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; HILITE hook contract.
000000r 2               ;   Called once per visible line before it is drawn.
000000r 2               ;     EDITBUF_HL_PTR (zp) -> first byte of the line text (in EDITBUF_BUF)
000000r 2               ;     EDITBUF_HL_LEN       = line length in bytes (0..255, excludes the \n)
000000r 2               ;     EDITBUF_HL_COLORS    = 80-byte buffer the hook fills with one VGC color
000000r 2               ;                            byte per character. Pre-filled with the default
000000r 2               ;                            text color; the hook overwrites as needed.
000000r 2               ;   The hook returns nothing. If unset, the default color is used for all.
000000r 2               ; ---------------------------------------------------------------------
000000r 2               
000000r 2               ; Default editor colors (bg = high nibble, fg = low nibble; palette mode 0).
000000r 2               EDITBUF_COLOR_TEXT   = $01      ; white on black body
000000r 2               EDITBUF_COLOR_SEL    = $1F      ; selection: white bg, grey text
000000r 2               
000000r 2               ; --- Config (host sets before editbuf_run) -------------------------------
000000r 2               .global EDITBUF_BUFL          ; pointer to text buffer
000000r 2               .global EDITBUF_BUFH
000000r 2               .global EDITBUF_CAPL          ; capacity in bytes (16-bit)
000000r 2               .global EDITBUF_CAPH
000000r 2               .global EDITBUF_LENL          ; current length in bytes (16-bit)
000000r 2               .global EDITBUF_LENH
000000r 2               .global EDITBUF_TITLEL        ; NUL-terminated title string
000000r 2               .global EDITBUF_TITLEH
000000r 2               .global EDITBUF_STATUSL       ; NUL-terminated status message (may be 0)
000000r 2               .global EDITBUF_STATUSH
000000r 2               .global EDITBUF_SAVE_VECL     ; SAVE hook vector
000000r 2               .global EDITBUF_SAVE_VECH
000000r 2               .global EDITBUF_INDENT_VECL   ; INDENT hook vector
000000r 2               .global EDITBUF_INDENT_VECH
000000r 2               .global EDITBUF_HILITE_VECL   ; HILITE hook vector
000000r 2               .global EDITBUF_HILITE_VECH
000000r 2               .global EDITBUF_MENU_VECL     ; MENU-config hook vector
000000r 2               .global EDITBUF_MENU_VECH
000000r 2               
000000r 2               ; --- Result / observable state ------------------------------------------
000000r 2               .global EDITBUF_RESULT
000000r 2               .global EDITBUF_CURL          ; cursor byte offset (16-bit)
000000r 2               .global EDITBUF_CURH
000000r 2               
000000r 2               ; --- HILITE hook scratch (zp pointer + buffers) -------------------------
000000r 2               .global EDITBUF_HL_PTR        ; zp, 2 bytes
000000r 2               .global EDITBUF_HL_LEN
000000r 2               .global EDITBUF_HL_COLORS     ; 80-byte color buffer
000000r 2               
000000r 2               ; --- Entry points -------------------------------------------------------
000000r 2               .global editbuf_run           ; run the modal editor
000000r 2               .global editbuf_reset_state   ; reset cursor/scroll/selection/dirty for a new session
000000r 2               .global editbuf_dialog3       ; three-choice restore-under modal (A=result 0/1/2)
000000r 2               
000000r 2               ; Dialog choice result codes (returned by editbuf_dialog3 in A).
000000r 2               EDITBUF_DLG_EXIT   = $00       ; first button  (Exit Anyway)
000000r 2               EDITBUF_DLG_SAVE   = $01       ; second button (Save First)
000000r 2               EDITBUF_DLG_CANCEL = $02       ; third button  (Cancel)
000000r 2               
000000r 2               .endif
000000r 2               
000000r 1               
000000r 1               ; --- Turtle virtual-sprite configuration ---
000000r 1               TURTLE_SPR_SIZE   = 16
000000r 1               TURTLE_SPR_HALF   = 8
000000r 1               TURTLE_MAX_X      = 304        ; 320 - 16
000000r 1               TURTLE_MAX_Y      = 184        ; 200 - 16
000000r 1               TURTLE_CENTER_X   = 160        ; center of 320-wide graphics
000000r 1               TURTLE_CENTER_Y   = 80         ; center of split graphics viewport
000000r 1               SPLIT_Y           = 160        ; copper split: gfx rows 0-159, text below
000000r 1               SPLIT_TEXT_ROW    = 40         ; 160px / 4px text cell height
000000r 1               SPLIT_TEXT_HEIGHT = 10
000000r 1               MODE_GFX_SPRITES  = 3          ; VGC mode: graphics + sprites
000000r 1               MODE_TEXT_ONLY    = 0
000000r 1               COL_WHITE         = 1
000000r 1               COL_RED           = 2
000000r 1               COL_GREEN         = 5
000000r 1               
000000r 1               ; Editor display colors. The shared editor no longer dictates the global
000000r 1               ; background/border/foreground — this runtime owns them. Change these to
000000r 1               ; restyle the NovaLogo editor. (Palette mode 0: 0=black, 1=white, 15=grey-light.)
000000r 1               EDITOR_BGCOL      = $00        ; black background
000000r 1               EDITOR_BORDER     = $00        ; black border
000000r 1               EDITOR_FGCOL      = $01        ; white text (cursor is an inverted cell -> white)
000000r 1               
000000r 1               ; --- Base-ROM list cell format, used by SETPOS [x y] ---
000000r 1               CONS_CAR_TYPE     = 1
000000r 1               CONS_CAR_HI       = 2
000000r 1               CONS_CAR_LO       = 3
000000r 1               CONS_CDR_LO       = 5
000000r 1               CONS_CDR_HI       = 6
000000r 1               
000000r 1               ; --- Local ZP temporaries (reuse NVR scratch) ---
000000r 1               tmp0              = NVR0L
000000r 1               tmp1              = NVR0H
000000r 1               tmp2              = NVR1L
000000r 1               tmp3              = NVR1H
000000r 1               old_x_lo          = NVR2L
000000r 1               old_x_hi          = NVR2H
000000r 1               old_y_lo          = NVR3L
000000r 1               old_y_hi          = NVR3H
000000r 1               dx_lo             = NVR4L
000000r 1               dx_hi             = NVR4H
000000r 1               dy_lo             = NVR5L
000000r 1               dy_hi             = NVR5H
000000r 1               sin_val           = NVR6L
000000r 1               cos_val           = NVR6H
000000r 1               dx_frac           = NVR7L
000000r 1               dy_frac           = NVR7H
000000r 1               
000000r 1               ; Turtle work buffers + persistent state are PINNED at fixed RAM addresses
000000r 1               ; ($9C00-$9F10) so the struct base stays at $9F00 (tests/SV/smoke read it there)
000000r 1               ; no matter how much editor BSS the extension links. The editor's own BSS lives
000000r 1               ; below, in $9800-$9BFF (see extension.cfg + heap.s HEAP_END). These addresses
000000r 1               ; are byte-for-byte identical to the previous linker-placed layout, so turtle
000000r 1               ; behavior is unchanged.
000000r 1               TURTLE_BUF_BASE      = $9C00
000000r 1               turtle_source_shape  = TURTLE_BUF_BASE + 0 * (TURTLE_SPR_SIZE * TURTLE_SPR_SIZE)
000000r 1               turtle_rotated_shape = TURTLE_BUF_BASE + 1 * (TURTLE_SPR_SIZE * TURTLE_SPR_SIZE)
000000r 1               turtle_saved_bg      = TURTLE_BUF_BASE + 2 * (TURTLE_SPR_SIZE * TURTLE_SPR_SIZE)
000000r 1               TURTLE_STATE_BASE    = TURTLE_BUF_BASE + 3 * (TURTLE_SPR_SIZE * TURTLE_SPR_SIZE)  ; $9F00
000000r 1               TURTLE_X_FRAC        = TURTLE_STATE_BASE + 0
000000r 1               TURTLE_X_LO          = TURTLE_STATE_BASE + 1
000000r 1               TURTLE_X_HI          = TURTLE_STATE_BASE + 2
000000r 1               TURTLE_Y_FRAC        = TURTLE_STATE_BASE + 3
000000r 1               TURTLE_Y_LO          = TURTLE_STATE_BASE + 4
000000r 1               TURTLE_Y_HI          = TURTLE_STATE_BASE + 5
000000r 1               TURTLE_HEADING_LO    = TURTLE_STATE_BASE + 6
000000r 1               TURTLE_HEADING_HI    = TURTLE_STATE_BASE + 7
000000r 1               TURTLE_PEN           = TURTLE_STATE_BASE + 8
000000r 1               TURTLE_SHOWN         = TURTLE_STATE_BASE + 9
000000r 1               TURTLE_COLOR         = TURTLE_STATE_BASE + 10
000000r 1               TURTLE_SPRITE        = TURTLE_STATE_BASE + 11
000000r 1               TURTLE_INITED        = TURTLE_STATE_BASE + 12
000000r 1               turtle_bg_x_lo       = TURTLE_STATE_BASE + 13
000000r 1               turtle_bg_x_hi       = TURTLE_STATE_BASE + 14
000000r 1               turtle_bg_y          = TURTLE_STATE_BASE + 15
000000r 1               turtle_bg_saved      = TURTLE_STATE_BASE + 16
000000r 1               TURTLE_GFX_VISIBLE   = TURTLE_STATE_BASE + 17  ; 1 = split/full graphics active (0 at boot)
000000r 1               
000000r 1                     .segment "CODE"
000000r 1               
000000r 1               ; =====================================================================
000000r 1               ; Extension entry point — called via JSR $C000 from RAM trampoline
000000r 1               ; =====================================================================
000000r 1               ext_entry:
000000r 1  D8                 CLD                       ; all extension math is binary, never BCD
000001r 1  A5 80              LDA   EXT_CMD
000003r 1  0A                 ASL                       ; * 2 for word-sized table
000004r 1  AA                 TAX
000005r 1  BD rr rr           LDA   ext_dispatch+1,X   ; high byte of handler-1
000008r 1  48                 PHA
000009r 1  BD rr rr           LDA   ext_dispatch,X     ; low byte of handler-1
00000Cr 1  48                 PHA
00000Dr 1  60                 RTS                       ; dispatch via RTS trick
00000Er 1               
00000Er 1               ; --- Dispatch table (entries are handler_address - 1) ---
00000Er 1               ext_dispatch:
00000Er 1  rr rr              .word ext_unsupported-1   ; cmd $00: reserved
000010r 1  rr rr              .word ext_test-1          ; cmd $01: EXT.TEST
000012r 1  rr rr              .word ext_unsupported-1   ; cmd $02
000014r 1  rr rr              .word ext_unsupported-1   ; cmd $03
000016r 1  rr rr              .word ext_unsupported-1   ; cmd $04
000018r 1  rr rr              .word ext_unsupported-1   ; cmd $05
00001Ar 1  rr rr              .word ext_unsupported-1   ; cmd $06
00001Cr 1  rr rr              .word ext_unsupported-1   ; cmd $07
00001Er 1  rr rr              .word ext_unsupported-1   ; cmd $08
000020r 1  rr rr              .word ext_unsupported-1   ; cmd $09
000022r 1  rr rr              .word ext_unsupported-1   ; cmd $0A
000024r 1  rr rr              .word ext_unsupported-1   ; cmd $0B
000026r 1  rr rr              .word ext_unsupported-1   ; cmd $0C
000028r 1  rr rr              .word ext_unsupported-1   ; cmd $0D
00002Ar 1  rr rr              .word ext_unsupported-1   ; cmd $0E
00002Cr 1  rr rr              .word ext_unsupported-1   ; cmd $0F
00002Er 1  rr rr              .word ext_fd-1            ; cmd $10: FD
000030r 1  rr rr              .word ext_bk-1            ; cmd $11: BK
000032r 1  rr rr              .word ext_rt-1            ; cmd $12: RT
000034r 1  rr rr              .word ext_lt-1            ; cmd $13: LT
000036r 1  rr rr              .word ext_cs-1            ; cmd $14: CS
000038r 1  rr rr              .word ext_pu-1            ; cmd $15: PU
00003Ar 1  rr rr              .word ext_pd-1            ; cmd $16: PD
00003Cr 1  rr rr              .word ext_st-1            ; cmd $17: ST
00003Er 1  rr rr              .word ext_ht-1            ; cmd $18: HT
000040r 1  rr rr              .word ext_home-1          ; cmd $19: HOME
000042r 1  rr rr              .word ext_ts-1            ; cmd $1A: TEXTSCREEN
000044r 1  rr rr              .word ext_ss-1            ; cmd $1B: SPLITSCREEN
000046r 1  rr rr              .word ext_fs-1            ; cmd $1C: FULLSCREEN
000048r 1  rr rr              .word ext_setxy-1         ; cmd $1D: SETXY
00004Ar 1  rr rr              .word ext_setx-1          ; cmd $1E: SETX
00004Cr 1  rr rr              .word ext_sety-1          ; cmd $1F: SETY
00004Er 1  rr rr              .word ext_seth-1          ; cmd $20: SETHEADING
000050r 1  rr rr              .word ext_xcor-1          ; cmd $21: XCOR
000052r 1  rr rr              .word ext_ycor-1          ; cmd $22: YCOR
000054r 1  rr rr              .word ext_heading-1       ; cmd $23: HEADING
000056r 1  rr rr              .word ext_pendownp-1      ; cmd $24: PENDOWN?
000058r 1  rr rr              .word ext_shownp-1        ; cmd $25: SHOWN?
00005Ar 1  rr rr              .word ext_setpc-1         ; cmd $26: SETPC
00005Cr 1  rr rr              .word ext_setbg-1         ; cmd $27: SETBG
00005Er 1  rr rr              .word ext_towards-1       ; cmd $28: TOWARDS
000060r 1  rr rr              .word ext_setpos-1        ; cmd $29: SETPOS
000062r 1  rr rr              .word ext_unsupported-1   ; cmd $2A
000064r 1  rr rr              .word ext_unsupported-1   ; cmd $2B
000066r 1  rr rr              .word ext_unsupported-1   ; cmd $2C
000068r 1  rr rr              .word ext_unsupported-1   ; cmd $2D
00006Ar 1  rr rr              .word ext_unsupported-1   ; cmd $2E
00006Cr 1  rr rr              .word ext_unsupported-1   ; cmd $2F
00006Er 1  rr rr              .word ext_setcolor-1      ; cmd $30: SETCOLOR
000070r 1  rr rr              .word ext_plot-1          ; cmd $31: PLOT
000072r 1  rr rr              .word ext_unplot-1        ; cmd $32: UNPLOT
000074r 1  rr rr              .word ext_line-1          ; cmd $33: LINE
000076r 1  rr rr              .word ext_circle-1        ; cmd $34: CIRCLE
000078r 1  rr rr              .word ext_rect-1          ; cmd $35: RECT
00007Ar 1  rr rr              .word ext_fillrect-1      ; cmd $36: FILL
00007Cr 1  rr rr              .word ext_paint-1         ; cmd $37: PAINT
00007Er 1  rr rr              .word ext_unsupported-1   ; cmd $38
000080r 1  rr rr              .word ext_unsupported-1   ; cmd $39
000082r 1  rr rr              .word ext_unsupported-1   ; cmd $3A
000084r 1  rr rr              .word ext_unsupported-1   ; cmd $3B
000086r 1  rr rr              .word ext_unsupported-1   ; cmd $3C
000088r 1  rr rr              .word ext_unsupported-1   ; cmd $3D
00008Ar 1  rr rr              .word ext_unsupported-1   ; cmd $3E
00008Cr 1  rr rr              .word ext_unsupported-1   ; cmd $3F
00008Er 1  rr rr              .word ext_sprite-1        ; cmd $40: SPRITE
000090r 1  rr rr              .word ext_spritepos-1     ; cmd $41: SPRITEPOS
000092r 1  rr rr              .word ext_spriteon-1      ; cmd $42: SPRITEON
000094r 1  rr rr              .word ext_spriteoff-1     ; cmd $43: SPRITEOFF
000096r 1  rr rr              .word ext_sprcollp-1      ; cmd $44: SPRITECOLLISION?
000098r 1  rr rr              .word ext_tone-1          ; cmd $45: TONE
00009Ar 1  rr rr              .word ext_noise-1         ; cmd $46: NOISE
00009Cr 1  rr rr              .word ext_volume-1        ; cmd $47: VOLUME
00009Er 1  rr rr              .word ext_wait-1          ; cmd $48: WAIT
0000A0r 1  rr rr              .word ext_waitvbl-1       ; cmd $49: WAITVBL
0000A2r 1  rr rr              .word ext_timer-1         ; cmd $4A: TIMER
0000A4r 1  rr rr              .word ext_edit-1          ; cmd $4B: EDIT (shared editor)
0000A6r 1               
0000A6r 1               ; =====================================================================
0000A6r 1               ; ext_unsupported — unknown command, just return
0000A6r 1               ; =====================================================================
0000A6r 1               ext_unsupported:
0000A6r 1  60                 RTS
0000A7r 1               
0000A7r 1               ; =====================================================================
0000A7r 1               ; ext_test — test command: returns arg0 + 1
0000A7r 1               ; =====================================================================
0000A7r 1               ext_test:
0000A7r 1  18                 CLC
0000A8r 1  A5 84              LDA   EXT_ARG0_LO
0000AAr 1  69 01              ADC   #1
0000ACr 1  85 90              STA   EXT_RESULT_LO
0000AEr 1  A5 83              LDA   EXT_ARG0_HI
0000B0r 1  69 00              ADC   #0
0000B2r 1  85 8F              STA   EXT_RESULT_HI
0000B4r 1  A5 85              LDA   EXT_ARG0_FRAC
0000B6r 1  85 91              STA   EXT_RESULT_FRAC
0000B8r 1  64 8E              STZ   EXT_RESULT_TYPE    ; VAL_NUMBER
0000BAr 1  60                 RTS
0000BBr 1               
0000BBr 1               ; =====================================================================
0000BBr 1               ; ext_cs — clear screen, set up graphics mode, init turtle
0000BBr 1               ; =====================================================================
0000BBr 1               ext_cs:
0000BBr 1  9C 01 A0           STZ   VGC_BGCOL
0000BEr 1  A9 01              LDA   #COL_WHITE
0000C0r 1  8D 02 A0           STA   VGC_FGCOL
0000C3r 1  9C 0D A0           STZ   VGC_BORDER
0000C6r 1  9C E8 A0           STZ   VGC_GFXTRANS
0000C9r 1  9C 05 A0           STZ   VGC_SCROLLX
0000CCr 1  9C 06 A0           STZ   VGC_SCROLLY
0000CFr 1  9C EA A0           STZ   VGC_SCROLLCTL
0000D2r 1  A9 00              LDA   #MODE_TEXT_ONLY
0000D4r 1  8D 00 A0           STA   VGC_MODE
0000D7r 1  20 rr rr           JSR   clear_gfx_plane
0000DAr 1               
0000DAr 1                     ; Set up copper split: graphics+sprites top, text bottom
0000DAr 1  20 rr rr           JSR   setup_copper
0000DDr 1  20 rr rr           JSR   prepare_split_text
0000E0r 1               
0000E0r 1                     ; Initialize turtle state
0000E0r 1  20 rr rr           JSR   turtle_init
0000E3r 1               
0000E3r 1                     ; Show centered virtual sprite
0000E3r 1  20 rr rr           JSR   draw_turtle_sprite
0000E6r 1               
0000E6r 1  A9 01              LDA   #1
0000E8r 1  8D 11 9F           STA   TURTLE_GFX_VISIBLE
0000EBr 1  60                 RTS
0000ECr 1               
0000ECr 1               ; =====================================================================
0000ECr 1               ; ensure_gfx_mode — make a turtle/drawing command work without an explicit
0000ECr 1               ; CS/DRAW: initialize the turtle if needed, and if the display is still in full
0000ECr 1               ; text mode, auto-switch to split screen so the drawing is visible.
0000ECr 1               ; =====================================================================
0000ECr 1               ensure_gfx_mode:
0000ECr 1  AD 0C 9F           LDA   TURTLE_INITED
0000EFr 1  D0 03              BNE   @check_mode
0000F1r 1  20 rr rr           JSR   turtle_init
0000F4r 1               @check_mode:
0000F4r 1  AD 11 9F           LDA   TURTLE_GFX_VISIBLE
0000F7r 1  D0 06              BNE   @done
0000F9r 1  20 rr rr           JSR   ext_ss              ; switch to split screen (sets TURTLE_GFX_VISIBLE)
0000FCr 1  20 rr rr           JSR   draw_turtle_sprite  ; show the turtle in the freshly-entered gfx area
0000FFr 1               @done:
0000FFr 1  60                 RTS
000100r 1               
000100r 1               ; =====================================================================
000100r 1               ; ext_fd — move forward by distance
000100r 1               ; =====================================================================
000100r 1               ext_fd:
000100r 1  20 rr rr           JSR   ensure_gfx_mode
000103r 1                     ; Save old integer position for line drawing
000103r 1  AD 01 9F           LDA   TURTLE_X_LO
000106r 1  85 24              STA   old_x_lo
000108r 1  AD 02 9F           LDA   TURTLE_X_HI
00010Br 1  85 25              STA   old_x_hi
00010Dr 1  AD 04 9F           LDA   TURTLE_Y_LO
000110r 1  85 26              STA   old_y_lo
000112r 1  AD 05 9F           LDA   TURTLE_Y_HI
000115r 1  85 27              STA   old_y_hi
000117r 1  20 rr rr           JSR   erase_turtle_sprite
00011Ar 1               
00011Ar 1                     ; Convert heading degrees to the exact NDK/blitter angle byte.
00011Ar 1  20 rr rr           JSR   turtle_heading_u8
00011Dr 1  85 20              STA   tmp0
00011Fr 1               
00011Fr 1                     ; Get sin/cos from coprocessor
00011Fr 1                     ; Logo heading: 0=north, 90=east, 180=south, 270=west
00011Fr 1                     ; sin(heading) gives dx, -cos(heading) gives dy (screen y goes down)
00011Fr 1  8D 2E BB           STA   MATH_SINCOS_ANGLE  ; triggers sincos
000122r 1  AD 38 BB           LDA   MATH_RES0          ; sin (1.7 signed: -128..+127)
000125r 1  85 2C              STA   sin_val
000127r 1  AD 39 BB           LDA   MATH_RES1          ; cos (1.7 signed)
00012Ar 1  85 2D              STA   cos_val
00012Cr 1               
00012Cr 1                     ; Compute dx = distance * sin / 128
00012Cr 1                     ; distance is 16.8 fixed point in EXT_ARG0 (hi:lo:frac)
00012Cr 1                     ; For simplicity, use integer part only for the multiply
00012Cr 1  A5 84              LDA   EXT_ARG0_LO
00012Er 1  8D 20 BB           STA   MATH_MUL16_A_LO
000131r 1  A5 83              LDA   EXT_ARG0_HI
000133r 1  8D 21 BB           STA   MATH_MUL16_A_HI
000136r 1                     ; Sign-extend sin to 16-bit
000136r 1  A5 2C              LDA   sin_val
000138r 1  C9 7F              CMP   #127             ; +1.0 is 127/128; use 128 so cardinal moves stay exact
00013Ar 1  D0 02              BNE   :+
00013Cr 1  A9 80              LDA   #128
00013Er 1               :
00013Er 1  8D 22 BB           STA   MATH_MUL16_B_LO
000141r 1  A5 2C              LDA   sin_val
000143r 1  09 7F              ORA   #$7F
000145r 1  30 04              BMI   @sin_neg
000147r 1  A9 00              LDA   #$00
000149r 1  80 02              BRA   @sin_ext
00014Br 1               @sin_neg:
00014Br 1  A9 FF              LDA   #$FF
00014Dr 1               @sin_ext:
00014Dr 1  8D 23 BB           STA   MATH_MUL16_B_HI    ; triggers multiply
000150r 1               
000150r 1                     ; dx in 16.8 position units = (distance*sin/128) * 256 = result << 1.
000150r 1                     ; Keep the sub-pixel fraction (don't round to whole pixels) so small steps
000150r 1                     ; like FD 1 accumulate instead of snapping to 8 directions (octagon).
000150r 1  AD 38 BB           LDA   MATH_RES0
000153r 1  0A                 ASL                       ; result << 1 across frac:lo:hi
000154r 1  85 2E              STA   dx_frac
000156r 1  AD 39 BB           LDA   MATH_RES1
000159r 1  2A                 ROL
00015Ar 1  85 28              STA   dx_lo
00015Cr 1  AD 3A BB           LDA   MATH_RES2
00015Fr 1  2A                 ROL
000160r 1  85 29              STA   dx_hi
000162r 1               
000162r 1                     ; Compute dy = -(distance * cos / 128)
000162r 1                     ; (negative because screen y increases downward)
000162r 1  A5 84              LDA   EXT_ARG0_LO
000164r 1  8D 20 BB           STA   MATH_MUL16_A_LO
000167r 1  A5 83              LDA   EXT_ARG0_HI
000169r 1  8D 21 BB           STA   MATH_MUL16_A_HI
00016Cr 1                     ; Sign-extend cos to 16-bit
00016Cr 1  A5 2D              LDA   cos_val
00016Er 1  C9 7F              CMP   #127             ; +1.0 is 127/128; use 128 so cardinal moves stay exact
000170r 1  D0 02              BNE   :+
000172r 1  A9 80              LDA   #128
000174r 1               :
000174r 1  8D 22 BB           STA   MATH_MUL16_B_LO
000177r 1  A5 2D              LDA   cos_val
000179r 1  09 7F              ORA   #$7F
00017Br 1  30 04              BMI   @cos_neg
00017Dr 1  A9 00              LDA   #$00
00017Fr 1  80 02              BRA   @cos_ext
000181r 1               @cos_neg:
000181r 1  A9 FF              LDA   #$FF
000183r 1               @cos_ext:
000183r 1  8D 23 BB           STA   MATH_MUL16_B_HI    ; triggers multiply
000186r 1               
000186r 1                     ; raw_dy in 16.8 position units = result << 1 (frac:lo:hi)
000186r 1  AD 38 BB           LDA   MATH_RES0
000189r 1  0A                 ASL
00018Ar 1  85 21              STA   tmp1                ; raw_dy frac
00018Cr 1  AD 39 BB           LDA   MATH_RES1
00018Fr 1  2A                 ROL
000190r 1  85 22              STA   tmp2                ; raw_dy lo
000192r 1  AD 3A BB           LDA   MATH_RES2
000195r 1  2A                 ROL
000196r 1  85 23              STA   tmp3                ; raw_dy hi
000198r 1               
000198r 1                     ; dy = -raw_dy (negate 24-bit)
000198r 1  38                 SEC
000199r 1  A9 00              LDA   #0
00019Br 1  E5 21              SBC   tmp1
00019Dr 1  85 2F              STA   dy_frac
00019Fr 1  A9 00              LDA   #0
0001A1r 1  E5 22              SBC   tmp2
0001A3r 1  85 2A              STA   dy_lo
0001A5r 1  A9 00              LDA   #0
0001A7r 1  E5 23              SBC   tmp3
0001A9r 1  85 2B              STA   dy_hi
0001ABr 1               
0001ABr 1                     ; Add dx to turtle X (24-bit fixed: frac:lo:hi) — sub-pixel accumulates
0001ABr 1  18                 CLC
0001ACr 1  AD 00 9F           LDA   TURTLE_X_FRAC
0001AFr 1  65 2E              ADC   dx_frac
0001B1r 1  8D 00 9F           STA   TURTLE_X_FRAC
0001B4r 1  AD 01 9F           LDA   TURTLE_X_LO
0001B7r 1  65 28              ADC   dx_lo
0001B9r 1  8D 01 9F           STA   TURTLE_X_LO
0001BCr 1  AD 02 9F           LDA   TURTLE_X_HI
0001BFr 1  65 29              ADC   dx_hi
0001C1r 1  8D 02 9F           STA   TURTLE_X_HI
0001C4r 1               
0001C4r 1                     ; Add dy to turtle Y (24-bit fixed: frac:lo:hi)
0001C4r 1  18                 CLC
0001C5r 1  AD 03 9F           LDA   TURTLE_Y_FRAC
0001C8r 1  65 2F              ADC   dy_frac
0001CAr 1  8D 03 9F           STA   TURTLE_Y_FRAC
0001CDr 1  AD 04 9F           LDA   TURTLE_Y_LO
0001D0r 1  65 2A              ADC   dy_lo
0001D2r 1  8D 04 9F           STA   TURTLE_Y_LO
0001D5r 1  AD 05 9F           LDA   TURTLE_Y_HI
0001D8r 1  65 2B              ADC   dy_hi
0001DAr 1  8D 05 9F           STA   TURTLE_Y_HI
0001DDr 1               
0001DDr 1                     ; If pen is down, draw line from old to new position
0001DDr 1  AD 08 9F           LDA   TURTLE_PEN
0001E0r 1  D0 03              BNE   @skip_draw          ; pen up = $01, skip
0001E2r 1  20 rr rr           JSR   draw_line
0001E5r 1               @skip_draw:
0001E5r 1               
0001E5r 1                     ; Redraw virtual sprite at the new position
0001E5r 1  20 rr rr           JSR   draw_turtle_sprite
0001E8r 1  60                 RTS
0001E9r 1               
0001E9r 1               ; =====================================================================
0001E9r 1               ; ext_bk — move backward by distance (negate and forward)
0001E9r 1               ; =====================================================================
0001E9r 1               ext_bk:
0001E9r 1                     ; Negate arg0 (16.8 two's complement)
0001E9r 1  38                 SEC
0001EAr 1  A9 00              LDA   #0
0001ECr 1  E5 85              SBC   EXT_ARG0_FRAC
0001EEr 1  85 85              STA   EXT_ARG0_FRAC
0001F0r 1  A9 00              LDA   #0
0001F2r 1  E5 84              SBC   EXT_ARG0_LO
0001F4r 1  85 84              STA   EXT_ARG0_LO
0001F6r 1  A9 00              LDA   #0
0001F8r 1  E5 83              SBC   EXT_ARG0_HI
0001FAr 1  85 83              STA   EXT_ARG0_HI
0001FCr 1  4C rr rr           JMP   ext_fd
0001FFr 1               
0001FFr 1               ; =====================================================================
0001FFr 1               ; ext_rt — turn right by degrees
0001FFr 1               ; =====================================================================
0001FFr 1               ext_rt:
0001FFr 1  20 rr rr           JSR   ensure_gfx_mode
000202r 1                     ; heading = (heading + degrees) mod 360
000202r 1  18                 CLC
000203r 1  AD 06 9F           LDA   TURTLE_HEADING_LO
000206r 1  65 84              ADC   EXT_ARG0_LO
000208r 1  8D 06 9F           STA   TURTLE_HEADING_LO
00020Br 1  AD 07 9F           LDA   TURTLE_HEADING_HI
00020Er 1  65 83              ADC   EXT_ARG0_HI
000210r 1  8D 07 9F           STA   TURTLE_HEADING_HI
000213r 1               
000213r 1                     ; Reduce mod 360
000213r 1  20 rr rr           JSR   heading_mod360
000216r 1               
000216r 1                     ; Redraw virtual sprite with the new heading
000216r 1  20 rr rr           JSR   draw_turtle_sprite
000219r 1  60                 RTS
00021Ar 1               
00021Ar 1               ; =====================================================================
00021Ar 1               ; ext_lt — turn left by degrees
00021Ar 1               ; =====================================================================
00021Ar 1               ext_lt:
00021Ar 1  20 rr rr           JSR   ensure_gfx_mode
00021Dr 1                     ; heading = (heading - degrees) mod 360
00021Dr 1                     ; If result negative, add 360
00021Dr 1  38                 SEC
00021Er 1  AD 06 9F           LDA   TURTLE_HEADING_LO
000221r 1  E5 84              SBC   EXT_ARG0_LO
000223r 1  8D 06 9F           STA   TURTLE_HEADING_LO
000226r 1  AD 07 9F           LDA   TURTLE_HEADING_HI
000229r 1  E5 83              SBC   EXT_ARG0_HI
00022Br 1  8D 07 9F           STA   TURTLE_HEADING_HI
00022Er 1               
00022Er 1                     ; If negative (hi bit 7 set), add 360
00022Er 1  30 07              BMI   @add360
000230r 1                     ; Also do mod 360 in case it's >=360
000230r 1  20 rr rr           JSR   heading_mod360
000233r 1  20 rr rr           JSR   draw_turtle_sprite
000236r 1  60                 RTS
000237r 1               
000237r 1               @add360:
000237r 1  18                 CLC
000238r 1  AD 06 9F           LDA   TURTLE_HEADING_LO
00023Br 1  69 68              ADC   #<360
00023Dr 1  8D 06 9F           STA   TURTLE_HEADING_LO
000240r 1  AD 07 9F           LDA   TURTLE_HEADING_HI
000243r 1  69 01              ADC   #>360
000245r 1  8D 07 9F           STA   TURTLE_HEADING_HI
000248r 1                     ; Could still be negative if turned more than 360, recurse
000248r 1  30 ED              BMI   @add360
00024Ar 1  20 rr rr           JSR   heading_mod360
00024Dr 1  20 rr rr           JSR   draw_turtle_sprite
000250r 1  60                 RTS
000251r 1               
000251r 1               ; =====================================================================
000251r 1               ; ext_pu — pen up
000251r 1               ; =====================================================================
000251r 1               ext_pu:
000251r 1  20 rr rr           JSR   ensure_gfx_mode
000254r 1  A9 01              LDA   #$01
000256r 1  8D 08 9F           STA   TURTLE_PEN
000259r 1  60                 RTS
00025Ar 1               
00025Ar 1               ; =====================================================================
00025Ar 1               ; ext_pd — pen down
00025Ar 1               ; =====================================================================
00025Ar 1               ext_pd:
00025Ar 1  20 rr rr           JSR   ensure_gfx_mode
00025Dr 1  9C 08 9F           STZ   TURTLE_PEN
000260r 1  60                 RTS
000261r 1               
000261r 1               ; =====================================================================
000261r 1               ; ext_st — show turtle sprite
000261r 1               ; =====================================================================
000261r 1               ext_st:
000261r 1  20 rr rr           JSR   ensure_gfx_mode
000264r 1  A9 01              LDA   #$01
000266r 1  8D 09 9F           STA   TURTLE_SHOWN
000269r 1  4C rr rr           JMP   draw_turtle_sprite
00026Cr 1               
00026Cr 1               ; =====================================================================
00026Cr 1               ; ext_ht — hide turtle sprite
00026Cr 1               ; =====================================================================
00026Cr 1               ext_ht:
00026Cr 1  20 rr rr           JSR   ensure_gfx_mode
00026Fr 1  20 rr rr           JSR   erase_turtle_sprite
000272r 1  9C 09 9F           STZ   TURTLE_SHOWN
000275r 1  60                 RTS
000276r 1               
000276r 1               ; =====================================================================
000276r 1               ; ext_home — move to center, heading 0 (draw line if pen down)
000276r 1               ; =====================================================================
000276r 1               ext_home:
000276r 1  20 rr rr           JSR   ensure_gfx_mode
000279r 1                     ; Ensure initialized
000279r 1  AD 0C 9F           LDA   TURTLE_INITED
00027Cr 1  D0 07              BNE   @go
00027Er 1  20 rr rr           JSR   turtle_init
000281r 1  20 rr rr           JSR   draw_turtle_sprite
000284r 1  60                 RTS
000285r 1               @go:
000285r 1                     ; Save old position
000285r 1  AD 01 9F           LDA   TURTLE_X_LO
000288r 1  85 24              STA   old_x_lo
00028Ar 1  AD 02 9F           LDA   TURTLE_X_HI
00028Dr 1  85 25              STA   old_x_hi
00028Fr 1  AD 04 9F           LDA   TURTLE_Y_LO
000292r 1  85 26              STA   old_y_lo
000294r 1  AD 05 9F           LDA   TURTLE_Y_HI
000297r 1  85 27              STA   old_y_hi
000299r 1  20 rr rr           JSR   erase_turtle_sprite
00029Cr 1               
00029Cr 1                     ; Move to center
00029Cr 1  A9 A0              LDA   #TURTLE_CENTER_X
00029Er 1  8D 01 9F           STA   TURTLE_X_LO
0002A1r 1  9C 02 9F           STZ   TURTLE_X_HI
0002A4r 1  9C 00 9F           STZ   TURTLE_X_FRAC
0002A7r 1  A9 50              LDA   #TURTLE_CENTER_Y
0002A9r 1  8D 04 9F           STA   TURTLE_Y_LO
0002ACr 1  9C 05 9F           STZ   TURTLE_Y_HI
0002AFr 1  9C 03 9F           STZ   TURTLE_Y_FRAC
0002B2r 1               
0002B2r 1                     ; Heading = 0
0002B2r 1  9C 06 9F           STZ   TURTLE_HEADING_LO
0002B5r 1  9C 07 9F           STZ   TURTLE_HEADING_HI
0002B8r 1               
0002B8r 1                     ; Draw line if pen down
0002B8r 1  AD 08 9F           LDA   TURTLE_PEN
0002BBr 1  D0 03              BNE   @no_draw
0002BDr 1  20 rr rr           JSR   draw_line
0002C0r 1               @no_draw:
0002C0r 1  20 rr rr           JSR   draw_turtle_sprite
0002C3r 1  60                 RTS
0002C4r 1               
0002C4r 1               ; =====================================================================
0002C4r 1               ; turtle_init — initialize turtle state and sprite
0002C4r 1               ; =====================================================================
0002C4r 1               turtle_init:
0002C4r 1                     ; Position to center (160, 100) as 16.8
0002C4r 1  A9 A0              LDA   #TURTLE_CENTER_X
0002C6r 1  8D 01 9F           STA   TURTLE_X_LO
0002C9r 1  9C 02 9F           STZ   TURTLE_X_HI
0002CCr 1  9C 00 9F           STZ   TURTLE_X_FRAC
0002CFr 1  A9 50              LDA   #TURTLE_CENTER_Y
0002D1r 1  8D 04 9F           STA   TURTLE_Y_LO
0002D4r 1  9C 05 9F           STZ   TURTLE_Y_HI
0002D7r 1  9C 03 9F           STZ   TURTLE_Y_FRAC
0002DAr 1                     ; Heading 0 (north)
0002DAr 1  9C 06 9F           STZ   TURTLE_HEADING_LO
0002DDr 1  9C 07 9F           STZ   TURTLE_HEADING_HI
0002E0r 1                     ; Pen down, shown, white
0002E0r 1  9C 08 9F           STZ   TURTLE_PEN
0002E3r 1  A9 01              LDA   #$01
0002E5r 1  8D 09 9F           STA   TURTLE_SHOWN
0002E8r 1  A9 01              LDA   #1                  ; white in Nova palette
0002EAr 1  8D 0A 9F           STA   TURTLE_COLOR
0002EDr 1  9C 0B 9F           STZ   TURTLE_SPRITE
0002F0r 1  A9 01              LDA   #$01
0002F2r 1  8D 0C 9F           STA   TURTLE_INITED
0002F5r 1               
0002F5r 1  A2 00              LDX   #0
0002F7r 1               @copy_shape:
0002F7r 1  BD rr rr           LDA   turtle_shape_data,X
0002FAr 1  9D 00 9C           STA   turtle_source_shape,X
0002FDr 1  E8                 INX
0002FEr 1  D0 F7              BNE   @copy_shape
000300r 1               
000300r 1  9C 10 9F           STZ   turtle_bg_saved
000303r 1  60                 RTS
000304r 1               
000304r 1               ; =====================================================================
000304r 1               ; heading_mod360 — reduce TURTLE_HEADING to 0-359
000304r 1               ; =====================================================================
000304r 1               heading_mod360:
000304r 1               @loop:
000304r 1                     ; If heading >= 360, subtract 360
000304r 1  AD 07 9F           LDA   TURTLE_HEADING_HI
000307r 1  D0 02              BNE   @check_hi
000309r 1  80 1E              BRA   @done               ; hi = 0 is always < 360
00030Br 1               @check_hi:
00030Br 1                     ; hi > 1 → definitely >= 360 (since 360 = $0168)
00030Br 1  C9 01              CMP   #>360               ; >360 hi = $01
00030Dr 1  D0 07              BNE   @subtract           ; hi > 1
00030Fr 1                     ; hi = 1, compare lo
00030Fr 1  AD 06 9F           LDA   TURTLE_HEADING_LO
000312r 1  C9 68              CMP   #<360
000314r 1  90 13              BCC   @done
000316r 1               @subtract:
000316r 1  38                 SEC
000317r 1  AD 06 9F           LDA   TURTLE_HEADING_LO
00031Ar 1  E9 68              SBC   #<360
00031Cr 1  8D 06 9F           STA   TURTLE_HEADING_LO
00031Fr 1  AD 07 9F           LDA   TURTLE_HEADING_HI
000322r 1  E9 01              SBC   #>360
000324r 1  8D 07 9F           STA   TURTLE_HEADING_HI
000327r 1  80 DB              BRA   @loop
000329r 1               @done:
000329r 1  60                 RTS
00032Ar 1               
00032Ar 1               ; =====================================================================
00032Ar 1               ; draw_line — VGC LINE from old position to current position
00032Ar 1               ; =====================================================================
00032Ar 1               draw_line:
00032Ar 1                     ; Set color
00032Ar 1  20 rr rr           JSR   vgc_wait_cmd
00032Dr 1  AD 0A 9F           LDA   TURTLE_COLOR
000330r 1  8D 11 A0           STA   VGC_P0
000333r 1  20 rr rr           JSR   vgc_gcolor
000336r 1               
000336r 1                     ; Draw line
000336r 1  20 rr rr           JSR   vgc_wait_cmd
000339r 1  A5 24              LDA   old_x_lo
00033Br 1  8D 11 A0           STA   VGC_P0
00033Er 1  A5 25              LDA   old_x_hi
000340r 1  8D 12 A0           STA   VGC_P1
000343r 1  A5 26              LDA   old_y_lo
000345r 1  8D 13 A0           STA   VGC_P2
000348r 1  A5 27              LDA   old_y_hi
00034Ar 1  8D 14 A0           STA   VGC_P3
00034Dr 1  AD 01 9F           LDA   TURTLE_X_LO
000350r 1  8D 15 A0           STA   VGC_P4
000353r 1  AD 02 9F           LDA   TURTLE_X_HI
000356r 1  8D 16 A0           STA   VGC_P5
000359r 1  AD 04 9F           LDA   TURTLE_Y_LO
00035Cr 1  8D 17 A0           STA   VGC_P6
00035Fr 1  AD 05 9F           LDA   TURTLE_Y_HI
000362r 1  8D 18 A0           STA   VGC_P7
000365r 1  20 rr rr           JSR   vgc_line
000368r 1  60                 RTS
000369r 1               
000369r 1               ; =====================================================================
000369r 1               ; clear_gfx_plane — clear full graphics plane through the NDK VGC helper
000369r 1               ; =====================================================================
000369r 1               clear_gfx_plane:
000369r 1  20 rr rr           JSR   vgc_wait_cmd
00036Cr 1  20 rr rr           JSR   vgc_gcls
00036Fr 1  4C rr rr           JMP   vgc_wait_cmd
000372r 1               
000372r 1               ; =====================================================================
000372r 1               ; configure_turtle_vsprite — configure NDK virtual-sprite state
000372r 1               ; =====================================================================
000372r 1               configure_turtle_vsprite:
000372r 1  A9 10              LDA   #TURTLE_SPR_SIZE
000374r 1  8D rr rr           STA   VSPRITE_WIDTHL
000377r 1  9C rr rr           STZ   VSPRITE_WIDTHH
00037Ar 1  8D rr rr           STA   VSPRITE_HEIGHTL
00037Dr 1  9C rr rr           STZ   VSPRITE_HEIGHTH
000380r 1  8D rr rr           STA   VSPRITE_ORIGSTRL
000383r 1  9C rr rr           STZ   VSPRITE_ORIGSTRH
000386r 1  8D rr rr           STA   VSPRITE_ROTSTRL
000389r 1  9C rr rr           STZ   VSPRITE_ROTSTRH
00038Cr 1  8D rr rr           STA   VSPRITE_BGSTRL
00038Fr 1  9C rr rr           STZ   VSPRITE_BGSTRH
000392r 1               
000392r 1  A9 00              LDA   #BLT_SPACE_CPU
000394r 1  8D rr rr           STA   VSPRITE_ORIGSPACE
000397r 1  8D rr rr           STA   VSPRITE_ROTSPACE
00039Ar 1  8D rr rr           STA   VSPRITE_BGSPACE
00039Dr 1               
00039Dr 1  A9 00              LDA   #<turtle_source_shape
00039Fr 1  8D rr rr           STA   VSPRITE_ORIGADDRL
0003A2r 1  A9 9C              LDA   #>turtle_source_shape
0003A4r 1  8D rr rr           STA   VSPRITE_ORIGADDRM
0003A7r 1  9C rr rr           STZ   VSPRITE_ORIGADDRH
0003AAr 1               
0003AAr 1  A9 00              LDA   #<turtle_rotated_shape
0003ACr 1  8D rr rr           STA   VSPRITE_ROTADDRL
0003AFr 1  A9 9D              LDA   #>turtle_rotated_shape
0003B1r 1  8D rr rr           STA   VSPRITE_ROTADDRM
0003B4r 1  9C rr rr           STZ   VSPRITE_ROTADDRH
0003B7r 1               
0003B7r 1  A9 00              LDA   #<turtle_saved_bg
0003B9r 1  8D rr rr           STA   VSPRITE_BGADDRL
0003BCr 1  A9 9E              LDA   #>turtle_saved_bg
0003BEr 1  8D rr rr           STA   VSPRITE_BGADDRM
0003C1r 1  9C rr rr           STZ   VSPRITE_BGADDRH
0003C4r 1               
0003C4r 1  9C rr rr           STZ   VSPRITE_COLORKEY
0003C7r 1  A9 01              LDA   #VSPRITE_FLAG_COLORKEY
0003C9r 1  8D rr rr           STA   VSPRITE_FLAGS
0003CCr 1  60                 RTS
0003CDr 1               
0003CDr 1               ; =====================================================================
0003CDr 1               ; set_turtle_vsprite_pos — center the 16x16 sprite on the turtle position
0003CDr 1               ; =====================================================================
0003CDr 1               set_turtle_vsprite_pos:
0003CDr 1  38                 SEC
0003CEr 1  AD 01 9F           LDA   TURTLE_X_LO
0003D1r 1  E9 08              SBC   #TURTLE_SPR_HALF
0003D3r 1  85 20              STA   tmp0
0003D5r 1  AD 02 9F           LDA   TURTLE_X_HI
0003D8r 1  E9 00              SBC   #0
0003DAr 1  85 21              STA   tmp1
0003DCr 1  30 1A              BMI   @x_zero
0003DEr 1  C9 01              CMP   #>TURTLE_MAX_X
0003E0r 1  90 1E              BCC   @x_ok
0003E2r 1  D0 08              BNE   @x_max
0003E4r 1  A5 20              LDA   tmp0
0003E6r 1  C9 30              CMP   #<TURTLE_MAX_X
0003E8r 1  90 16              BCC   @x_ok
0003EAr 1  F0 14              BEQ   @x_ok
0003ECr 1               @x_max:
0003ECr 1  A9 30              LDA   #<TURTLE_MAX_X
0003EEr 1  8D rr rr           STA   VSPRITE_XL
0003F1r 1  A9 01              LDA   #>TURTLE_MAX_X
0003F3r 1  8D rr rr           STA   VSPRITE_XH
0003F6r 1  80 12              BRA   @y
0003F8r 1               @x_zero:
0003F8r 1  9C rr rr           STZ   VSPRITE_XL
0003FBr 1  9C rr rr           STZ   VSPRITE_XH
0003FEr 1  80 0A              BRA   @y
000400r 1               @x_ok:
000400r 1  A5 20              LDA   tmp0
000402r 1  8D rr rr           STA   VSPRITE_XL
000405r 1  A5 21              LDA   tmp1
000407r 1  8D rr rr           STA   VSPRITE_XH
00040Ar 1               
00040Ar 1               @y:
00040Ar 1  38                 SEC
00040Br 1  AD 04 9F           LDA   TURTLE_Y_LO
00040Er 1  E9 08              SBC   #TURTLE_SPR_HALF
000410r 1  85 20              STA   tmp0
000412r 1  AD 05 9F           LDA   TURTLE_Y_HI
000415r 1  E9 00              SBC   #0
000417r 1  30 0E              BMI   @y_zero
000419r 1  D0 06              BNE   @y_max
00041Br 1  A5 20              LDA   tmp0
00041Dr 1  C9 B9              CMP   #(TURTLE_MAX_Y + 1)
00041Fr 1  90 0A              BCC   @y_ok
000421r 1               @y_max:
000421r 1  A9 B8              LDA   #TURTLE_MAX_Y
000423r 1  8D rr rr           STA   VSPRITE_Y
000426r 1  60                 RTS
000427r 1               @y_zero:
000427r 1  9C rr rr           STZ   VSPRITE_Y
00042Ar 1  60                 RTS
00042Br 1               @y_ok:
00042Br 1  A5 20              LDA   tmp0
00042Dr 1  8D rr rr           STA   VSPRITE_Y
000430r 1  60                 RTS
000431r 1               
000431r 1               ; =====================================================================
000431r 1               ; turtle_heading_u8 — convert Logo degrees to the NDK/blitter angle byte.
000431r 1               ;   A = floor((heading * 256) / 360). Cardinal headings must land exactly:
000431r 1               ;   90 -> 64, 180 -> 128, 270 -> 192.
000431r 1               ; =====================================================================
000431r 1               turtle_heading_u8:
000431r 1  9C 28 BB           STZ   MATH_DIV_N_LO
000434r 1  AD 06 9F           LDA   TURTLE_HEADING_LO
000437r 1  8D 29 BB           STA   MATH_DIV_N_1
00043Ar 1  AD 07 9F           LDA   TURTLE_HEADING_HI
00043Dr 1  8D 2A BB           STA   MATH_DIV_N_2
000440r 1  9C 2B BB           STZ   MATH_DIV_N_HI
000443r 1  A9 68              LDA   #<360
000445r 1  8D 2C BB           STA   MATH_DIV_D_LO
000448r 1  A9 01              LDA   #>360
00044Ar 1  8D 2D BB           STA   MATH_DIV_D_HI
00044Dr 1  AD 38 BB           LDA   MATH_RES0
000450r 1  60                 RTS
000451r 1               
000451r 1               ; =====================================================================
000451r 1               ; erase_turtle_sprite — restore the background saved by the NDK vsprite path
000451r 1               ; =====================================================================
000451r 1               erase_turtle_sprite:
000451r 1  AD 10 9F           LDA   turtle_bg_saved
000454r 1  F0 1B              BEQ   @done
000456r 1  20 rr rr           JSR   configure_turtle_vsprite
000459r 1  AD 0D 9F           LDA   turtle_bg_x_lo
00045Cr 1  8D rr rr           STA   VSPRITE_XL
00045Fr 1  AD 0E 9F           LDA   turtle_bg_x_hi
000462r 1  8D rr rr           STA   VSPRITE_XH
000465r 1  AD 0F 9F           LDA   turtle_bg_y
000468r 1  8D rr rr           STA   VSPRITE_Y
00046Br 1  20 rr rr           JSR   vsprite_gfx_restore_bg
00046Er 1  9C 10 9F           STZ   turtle_bg_saved
000471r 1               @done:
000471r 1  60                 RTS
000472r 1               
000472r 1               ; =====================================================================
000472r 1               ; draw_turtle_sprite — draw rotated NDK virtual sprite
000472r 1               ; =====================================================================
000472r 1               draw_turtle_sprite:
000472r 1  AD 09 9F           LDA   TURTLE_SHOWN
000475r 1  F0 30              BEQ   @done
000477r 1  20 rr rr           JSR   erase_turtle_sprite
00047Ar 1  20 rr rr           JSR   configure_turtle_vsprite
00047Dr 1  20 rr rr           JSR   set_turtle_vsprite_pos
000480r 1  AD rr rr           LDA   VSPRITE_XL
000483r 1  8D 0D 9F           STA   turtle_bg_x_lo
000486r 1  AD rr rr           LDA   VSPRITE_XH
000489r 1  8D 0E 9F           STA   turtle_bg_x_hi
00048Cr 1  AD rr rr           LDA   VSPRITE_Y
00048Fr 1  8D 0F 9F           STA   turtle_bg_y
000492r 1  20 rr rr           JSR   vsprite_gfx_save_bg
000495r 1  C9 00              CMP   #VSPRITE_RESULT_OK
000497r 1  D0 0E              BNE   @done
000499r 1  A9 01              LDA   #$01
00049Br 1  8D 10 9F           STA   turtle_bg_saved
00049Er 1  20 rr rr           JSR   turtle_heading_u8
0004A1r 1  8D rr rr           STA   VSPRITE_ROTANGLE
0004A4r 1  20 rr rr           JSR   vsprite_gfx_rotate_blit_keyed
0004A7r 1               @done:
0004A7r 1  60                 RTS
0004A8r 1               
0004A8r 1               ; =====================================================================
0004A8r 1               ; setup_copper — copper split for gfx+sprites top, text bottom
0004A8r 1               ; =====================================================================
0004A8r 1               setup_copper:
0004A8r 1  9C 11 A0           STZ   VGC_P0
0004ABr 1  A9 A0              LDA   #SPLIT_Y
0004ADr 1  8D 12 A0           STA   VGC_P1
0004B0r 1  A9 03              LDA   #MODE_GFX_SPRITES
0004B2r 1  8D 13 A0           STA   VGC_P2
0004B5r 1  A9 00              LDA   #MODE_TEXT_ONLY
0004B7r 1  8D 14 A0           STA   VGC_P3
0004BAr 1  4C rr rr           JMP   copper_split_mode
0004BDr 1               
0004BDr 1               ; =====================================================================
0004BDr 1               ; wait_vgc — wait until VGC is not busy
0004BDr 1               ; =====================================================================
0004BDr 1               wait_vgc:
0004BDr 1  4C rr rr           JMP   vgc_wait_cmd
0004C0r 1               
0004C0r 1               ; =====================================================================
0004C0r 1               ; ext_ts — TEXTSCREEN: full text mode, disable copper, mode=0
0004C0r 1               ; =====================================================================
0004C0r 1               ext_ts:
0004C0r 1  20 rr rr           JSR   vgc_wait_cmd
0004C3r 1  20 rr rr           JSR   copper_off
0004C6r 1  9C 00 A0           STZ   VGC_MODE
0004C9r 1  9C 11 9F           STZ   TURTLE_GFX_VISIBLE
0004CCr 1  60                 RTS
0004CDr 1               
0004CDr 1               ; =====================================================================
0004CDr 1               ; ext_ss — SPLITSCREEN: copper split (gfx+sprites top, text bottom)
0004CDr 1               ; =====================================================================
0004CDr 1               ext_ss:
0004CDr 1  20 rr rr           JSR   setup_copper
0004D0r 1  20 rr rr           JSR   prepare_split_text
0004D3r 1  A9 01              LDA   #1
0004D5r 1  8D 11 9F           STA   TURTLE_GFX_VISIBLE
0004D8r 1  60                 RTS
0004D9r 1               
0004D9r 1               ; =====================================================================
0004D9r 1               ; ext_fs — FULLSCREEN: full graphics mode, no text area
0004D9r 1               ; =====================================================================
0004D9r 1               ext_fs:
0004D9r 1                     ; Disable copper first
0004D9r 1  20 rr rr           JSR   wait_vgc
0004DCr 1  A9 1E              LDA   #VCMD_COPPERDIS
0004DEr 1  8D 10 A0           STA   VGC_CMD
0004E1r 1                     ; Set mode to graphics + sprites
0004E1r 1  A9 03              LDA   #MODE_GFX_SPRITES
0004E3r 1  8D 00 A0           STA   VGC_MODE
0004E6r 1  A9 01              LDA   #1
0004E8r 1  8D 11 9F           STA   TURTLE_GFX_VISIBLE
0004EBr 1  60                 RTS
0004ECr 1               
0004ECr 1               ; =====================================================================
0004ECr 1               ; prepare_split_text — keep Logo's prompt in the visible split text area
0004ECr 1               ; =====================================================================
0004ECr 1               prepare_split_text:
0004ECr 1  A9 0C              LDA   #$0C
0004EEr 1  8D 0E A0           STA   VGC_CHAROUT
0004F1r 1  20 rr rr           JSR   wait_vgc
0004F4r 1  9C F2 B9           STZ   TEXTWIN_LEFT
0004F7r 1  A9 28              LDA   #SPLIT_TEXT_ROW
0004F9r 1  8D F3 B9           STA   TEXTWIN_TOP
0004FCr 1  A9 50              LDA   #80
0004FEr 1  8D F4 B9           STA   TEXTWIN_WIDTH
000501r 1  A9 0A              LDA   #SPLIT_TEXT_HEIGHT
000503r 1  8D F5 B9           STA   TEXTWIN_HEIGHT
000506r 1  9C 03 A0           STZ   VGC_CURSX
000509r 1  A9 28              LDA   #SPLIT_TEXT_ROW
00050Br 1  8D 04 A0           STA   VGC_CURSY
00050Er 1  9C 0A A0           STZ   VGC_CURSEN
000511r 1  60                 RTS
000512r 1               
000512r 1               ; =====================================================================
000512r 1               ; ext_edit — run the shared EDITUI/EDITBUF editor on a RAM text buffer.
000512r 1               ;   The base ROM passes a buffer ptr/len/cap and a title in the mailbox
000512r 1               ;   (see EXT_CMD_EDIT in ext_iface.inc). We snapshot the VGC display state,
000512r 1               ;   switch to full-screen text (the editor owns the whole screen), run the
000512r 1               ;   modal editor, then restore the display EXACTLY — graphics/turtle are
000512r 1               ;   never cleared. A nonzero RESULT_HI means the user asked to save.
000512r 1               ; =====================================================================
000512r 1               ext_edit:
000512r 1                     ; --- snapshot the display registers editui_init will clobber ---
000512r 1  AD 00 A0           LDA   VGC_MODE
000515r 1  8D rr rr           STA   ee_saved_mode
000518r 1  AD E9 A0           LDA   VGC_PALETTE
00051Br 1  8D rr rr           STA   ee_saved_palette
00051Er 1  AD 01 A0           LDA   VGC_BGCOL
000521r 1  8D rr rr           STA   ee_saved_bgcol
000524r 1  AD 0D A0           LDA   VGC_BORDER
000527r 1  8D rr rr           STA   ee_saved_border
00052Ar 1  AD 02 A0           LDA   VGC_FGCOL
00052Dr 1  8D rr rr           STA   ee_saved_fgcol
000530r 1  AD 03 A0           LDA   VGC_CURSX
000533r 1  8D rr rr           STA   ee_saved_cursx
000536r 1  AD 04 A0           LDA   VGC_CURSY
000539r 1  8D rr rr           STA   ee_saved_cursy
00053Cr 1  AD 0A A0           LDA   VGC_CURSEN
00053Fr 1  8D rr rr           STA   ee_saved_cursen
000542r 1               
000542r 1                     ; --- the editor owns the whole screen: copper off, full text window ---
000542r 1  20 rr rr           JSR   copper_off
000545r 1  9C F2 B9           STZ   TEXTWIN_LEFT
000548r 1  9C F3 B9           STZ   TEXTWIN_TOP
00054Br 1  A9 50              LDA   #80
00054Dr 1  8D F4 B9           STA   TEXTWIN_WIDTH
000550r 1  A9 19              LDA   #25
000552r 1  8D F5 B9           STA   TEXTWIN_HEIGHT
000555r 1               
000555r 1                     ; --- runtime-chosen editor colors (the engine no longer sets these) ---
000555r 1  A9 00              LDA   #EDITOR_BGCOL
000557r 1  8D 01 A0           STA   VGC_BGCOL
00055Ar 1  A9 00              LDA   #EDITOR_BORDER
00055Cr 1  8D 0D A0           STA   VGC_BORDER
00055Fr 1  A9 01              LDA   #EDITOR_FGCOL
000561r 1  8D 02 A0           STA   VGC_FGCOL
000564r 1               
000564r 1                     ; --- editbuf config from the mailbox ---
000564r 1  A5 84              LDA   EXT_ARG0_LO
000566r 1  8D rr rr           STA   EDITBUF_BUFL
000569r 1  A5 83              LDA   EXT_ARG0_HI
00056Br 1  8D rr rr           STA   EDITBUF_BUFH
00056Er 1  A5 8C              LDA   EXT_ARG2_LO
000570r 1  8D rr rr           STA   EDITBUF_CAPL
000573r 1  A5 8B              LDA   EXT_ARG2_HI
000575r 1  8D rr rr           STA   EDITBUF_CAPH
000578r 1  A5 88              LDA   EXT_ARG1_LO
00057Ar 1  8D rr rr           STA   EDITBUF_LENL
00057Dr 1  A5 87              LDA   EXT_ARG1_HI
00057Fr 1  8D rr rr           STA   EDITBUF_LENH
000582r 1  A5 A1              LDA   EXT_ARG3_LO
000584r 1  8D rr rr           STA   EDITBUF_TITLEL
000587r 1  A5 A0              LDA   EXT_ARG3_HI
000589r 1  8D rr rr           STA   EDITBUF_TITLEH
00058Cr 1  9C rr rr           STZ   EDITBUF_STATUSL
00058Fr 1  9C rr rr           STZ   EDITBUF_STATUSH
000592r 1               
000592r 1                     ; --- install hooks explicitly (BSS is not zeroed between sessions) ---
000592r 1  A9 rr              LDA   #<ext_edit_save_hook
000594r 1  8D rr rr           STA   EDITBUF_SAVE_VECL
000597r 1  A9 rr              LDA   #>ext_edit_save_hook
000599r 1  8D rr rr           STA   EDITBUF_SAVE_VECH
00059Cr 1  9C rr rr           STZ   EDITBUF_INDENT_VECL    ; 0 => editbuf installs its no-op default
00059Fr 1  9C rr rr           STZ   EDITBUF_INDENT_VECH
0005A2r 1  9C rr rr           STZ   EDITBUF_HILITE_VECL
0005A5r 1  9C rr rr           STZ   EDITBUF_HILITE_VECH
0005A8r 1  9C rr rr           STZ   EDITBUF_MENU_VECL      ; keep EDITUI's default menus for now
0005ABr 1  9C rr rr           STZ   EDITBUF_MENU_VECH
0005AEr 1               
0005AEr 1                     ; --- run the modal editor ---
0005AEr 1  9C rr rr           STZ   ee_saved_flag
0005B1r 1  20 rr rr           JSR   editbuf_reset_state
0005B4r 1                     ; Place the cursor where the host asked (start of the body line), instead
0005B4r 1                     ; of the default offset 0. Cursor offset rides in the ARG FRAC bytes.
0005B4r 1  A5 8D              LDA   EXT_ARG2_FRAC
0005B6r 1  8D rr rr           STA   EDITBUF_CURL
0005B9r 1  A5 A2              LDA   EXT_ARG3_FRAC
0005BBr 1  8D rr rr           STA   EDITBUF_CURH
0005BEr 1  20 rr rr           JSR   editbuf_run            ; A = exit reason
0005C1r 1               
0005C1r 1                     ; --- publish results to the mailbox ---
0005C1r 1  85 90              STA   EXT_RESULT_LO          ; editbuf exit reason
0005C3r 1  AD rr rr           LDA   ee_saved_flag
0005C6r 1  85 8F              STA   EXT_RESULT_HI          ; nonzero => save requested
0005C8r 1  AD rr rr           LDA   EDITBUF_LENL
0005CBr 1  85 88              STA   EXT_ARG1_LO            ; final length back to the host
0005CDr 1  AD rr rr           LDA   EDITBUF_LENH
0005D0r 1  85 87              STA   EXT_ARG1_HI
0005D2r 1               
0005D2r 1                     ; --- restore the display exactly (never clear graphics) ---
0005D2r 1                     ; Restore the host's palette + colors FIRST: the form-feed clear below
0005D2r 1                     ; fills color RAM with the *current* text color, so the host's colors
0005D2r 1                     ; must be back in place before we clear, or the editor's panel color
0005D2r 1                     ; leaks into the restored text area.
0005D2r 1  AD rr rr           LDA   ee_saved_palette
0005D5r 1  8D E9 A0           STA   VGC_PALETTE
0005D8r 1  AD rr rr           LDA   ee_saved_bgcol
0005DBr 1  8D 01 A0           STA   VGC_BGCOL
0005DEr 1  AD rr rr           LDA   ee_saved_border
0005E1r 1  8D 0D A0           STA   VGC_BORDER
0005E4r 1  AD rr rr           LDA   ee_saved_fgcol
0005E7r 1  8D 02 A0           STA   VGC_FGCOL
0005EAr 1               
0005EAr 1  AD 0C 9F           LDA   TURTLE_INITED
0005EDr 1  F0 08              BEQ   @text_restore
0005EFr 1                     ; turtle/graphics were active: rebuild the copper split + text window
0005EFr 1                     ; (prepare_split_text issues the form-feed clear with the host colors)
0005EFr 1  20 rr rr           JSR   setup_copper
0005F2r 1  20 rr rr           JSR   prepare_split_text
0005F5r 1  80 15              BRA   @restore_regs
0005F7r 1               @text_restore:
0005F7r 1                     ; plain text session: full text window, clear the editor chrome
0005F7r 1  9C F2 B9           STZ   TEXTWIN_LEFT
0005FAr 1  9C F3 B9           STZ   TEXTWIN_TOP
0005FDr 1  A9 50              LDA   #80
0005FFr 1  8D F4 B9           STA   TEXTWIN_WIDTH
000602r 1  A9 19              LDA   #25
000604r 1  8D F5 B9           STA   TEXTWIN_HEIGHT
000607r 1  A9 0C              LDA   #$0C                   ; form feed: clear text plane only
000609r 1  8D 0E A0           STA   VGC_CHAROUT
00060Cr 1               @restore_regs:
00060Cr 1  AD rr rr           LDA   ee_saved_mode
00060Fr 1  8D 00 A0           STA   VGC_MODE
000612r 1  AD rr rr           LDA   ee_saved_cursx
000615r 1  8D 03 A0           STA   VGC_CURSX
000618r 1  AD rr rr           LDA   ee_saved_cursy
00061Br 1  8D 04 A0           STA   VGC_CURSY
00061Er 1  AD rr rr           LDA   ee_saved_cursen
000621r 1  8D 0A A0           STA   VGC_CURSEN
000624r 1  60                 RTS
000625r 1               
000625r 1               ; ext_edit_save_hook — SAVE hook while the editor runs. For now it just records
000625r 1               ; that the user asked to save and reports success; the base ROM builds the
000625r 1               ; procedure record from the final buffer when the editor exits. (Cross-bank
000625r 1               ; live validation is the next increment.)
000625r 1               ext_edit_save_hook:
000625r 1  A9 01              LDA   #1
000627r 1  8D rr rr           STA   ee_saved_flag
00062Ar 1  A9 00              LDA   #EDITBUF_SAVE_OK
00062Cr 1  60                 RTS
00062Dr 1               
00062Dr 1                     .segment "BSS"
000000r 1  xx           ee_saved_mode:    .res 1
000001r 1  xx           ee_saved_palette: .res 1
000002r 1  xx           ee_saved_bgcol:   .res 1
000003r 1  xx           ee_saved_border:  .res 1
000004r 1  xx           ee_saved_fgcol:   .res 1
000005r 1  xx           ee_saved_cursx:   .res 1
000006r 1  xx           ee_saved_cursy:   .res 1
000007r 1  xx           ee_saved_cursen:  .res 1
000008r 1  xx           ee_saved_flag:    .res 1          ; nonzero once the SAVE hook fires
000009r 1                     .segment "CODE"
00062Dr 1               
00062Dr 1               ; =====================================================================
00062Dr 1               ; ext_setxy — move to (x, y). Draw line if pen down.
00062Dr 1               ;   ARG0 = x, ARG1 = y
00062Dr 1               ; =====================================================================
00062Dr 1               ext_setxy:
00062Dr 1  20 rr rr           JSR   ensure_gfx_mode
000630r 1                     ; Ensure turtle is initialized
000630r 1  AD 0C 9F           LDA   TURTLE_INITED
000633r 1  D0 03              BNE   @go
000635r 1  20 rr rr           JSR   turtle_init
000638r 1               @go:
000638r 1                     ; Save old position for line drawing
000638r 1  AD 01 9F           LDA   TURTLE_X_LO
00063Br 1  85 24              STA   old_x_lo
00063Dr 1  AD 02 9F           LDA   TURTLE_X_HI
000640r 1  85 25              STA   old_x_hi
000642r 1  AD 04 9F           LDA   TURTLE_Y_LO
000645r 1  85 26              STA   old_y_lo
000647r 1  AD 05 9F           LDA   TURTLE_Y_HI
00064Ar 1  85 27              STA   old_y_hi
00064Cr 1  20 rr rr           JSR   erase_turtle_sprite
00064Fr 1               
00064Fr 1                     ; Set new position
00064Fr 1  A5 84              LDA   EXT_ARG0_LO
000651r 1  8D 01 9F           STA   TURTLE_X_LO
000654r 1  A5 83              LDA   EXT_ARG0_HI
000656r 1  8D 02 9F           STA   TURTLE_X_HI
000659r 1  9C 00 9F           STZ   TURTLE_X_FRAC
00065Cr 1  A5 88              LDA   EXT_ARG1_LO
00065Er 1  8D 04 9F           STA   TURTLE_Y_LO
000661r 1  A5 87              LDA   EXT_ARG1_HI
000663r 1  8D 05 9F           STA   TURTLE_Y_HI
000666r 1  9C 03 9F           STZ   TURTLE_Y_FRAC
000669r 1               
000669r 1                     ; Draw line if pen down
000669r 1  AD 08 9F           LDA   TURTLE_PEN
00066Cr 1  D0 03              BNE   @skip_draw
00066Er 1  20 rr rr           JSR   draw_line
000671r 1               @skip_draw:
000671r 1  20 rr rr           JSR   draw_turtle_sprite
000674r 1  60                 RTS
000675r 1               
000675r 1               ; =====================================================================
000675r 1               ; ext_setpos — move to position from a Logo list. Draw line if pen down.
000675r 1               ;   ARG0 = [x y]
000675r 1               ; =====================================================================
000675r 1               ext_setpos:
000675r 1  20 rr rr           JSR   ensure_gfx_mode
000678r 1  A5 82              LDA   EXT_ARG0_TYPE
00067Ar 1  C9 02              CMP   #VAL_LIST
00067Cr 1  D0 53              BNE   @done
00067Er 1               
00067Er 1  A5 84              LDA   EXT_ARG0_LO
000680r 1  85 20              STA   tmp0
000682r 1  A5 83              LDA   EXT_ARG0_HI
000684r 1  85 21              STA   tmp1
000686r 1  05 20              ORA   tmp0
000688r 1  F0 47              BEQ   @done
00068Ar 1               
00068Ar 1                     ; First list element is X.
00068Ar 1  A0 01              LDY   #CONS_CAR_TYPE
00068Cr 1  B1 20              LDA   (tmp0),Y
00068Er 1  C9 00              CMP   #VAL_NUMBER
000690r 1  D0 3F              BNE   @done
000692r 1  A0 03              LDY   #CONS_CAR_LO
000694r 1  B1 20              LDA   (tmp0),Y
000696r 1  85 84              STA   EXT_ARG0_LO
000698r 1  A0 02              LDY   #CONS_CAR_HI
00069Ar 1  B1 20              LDA   (tmp0),Y
00069Cr 1  85 83              STA   EXT_ARG0_HI
00069Er 1  64 85              STZ   EXT_ARG0_FRAC
0006A0r 1               
0006A0r 1                     ; Second list element is Y.
0006A0r 1  A0 05              LDY   #CONS_CDR_LO
0006A2r 1  B1 20              LDA   (tmp0),Y
0006A4r 1  85 22              STA   tmp2
0006A6r 1  A0 06              LDY   #CONS_CDR_HI
0006A8r 1  B1 20              LDA   (tmp0),Y
0006AAr 1  85 23              STA   tmp3
0006ACr 1  05 22              ORA   tmp2
0006AEr 1  F0 21              BEQ   @done
0006B0r 1               
0006B0r 1  A5 22              LDA   tmp2
0006B2r 1  85 20              STA   tmp0
0006B4r 1  A5 23              LDA   tmp3
0006B6r 1  85 21              STA   tmp1
0006B8r 1  A0 01              LDY   #CONS_CAR_TYPE
0006BAr 1  B1 20              LDA   (tmp0),Y
0006BCr 1  C9 00              CMP   #VAL_NUMBER
0006BEr 1  D0 11              BNE   @done
0006C0r 1  A0 03              LDY   #CONS_CAR_LO
0006C2r 1  B1 20              LDA   (tmp0),Y
0006C4r 1  85 88              STA   EXT_ARG1_LO
0006C6r 1  A0 02              LDY   #CONS_CAR_HI
0006C8r 1  B1 20              LDA   (tmp0),Y
0006CAr 1  85 87              STA   EXT_ARG1_HI
0006CCr 1  64 89              STZ   EXT_ARG1_FRAC
0006CEr 1               
0006CEr 1  4C rr rr           JMP   ext_setxy
0006D1r 1               
0006D1r 1               @done:
0006D1r 1  60                 RTS
0006D2r 1               
0006D2r 1               ; =====================================================================
0006D2r 1               ; ext_setx — set X only. Draw line if pen down.
0006D2r 1               ;   ARG0 = x
0006D2r 1               ; =====================================================================
0006D2r 1               ext_setx:
0006D2r 1  20 rr rr           JSR   ensure_gfx_mode
0006D5r 1  AD 0C 9F           LDA   TURTLE_INITED
0006D8r 1  D0 03              BNE   @go
0006DAr 1  20 rr rr           JSR   turtle_init
0006DDr 1               @go:
0006DDr 1                     ; Save old position
0006DDr 1  AD 01 9F           LDA   TURTLE_X_LO
0006E0r 1  85 24              STA   old_x_lo
0006E2r 1  AD 02 9F           LDA   TURTLE_X_HI
0006E5r 1  85 25              STA   old_x_hi
0006E7r 1  AD 04 9F           LDA   TURTLE_Y_LO
0006EAr 1  85 26              STA   old_y_lo
0006ECr 1  AD 05 9F           LDA   TURTLE_Y_HI
0006EFr 1  85 27              STA   old_y_hi
0006F1r 1  20 rr rr           JSR   erase_turtle_sprite
0006F4r 1               
0006F4r 1                     ; Update X only
0006F4r 1  A5 84              LDA   EXT_ARG0_LO
0006F6r 1  8D 01 9F           STA   TURTLE_X_LO
0006F9r 1  A5 83              LDA   EXT_ARG0_HI
0006FBr 1  8D 02 9F           STA   TURTLE_X_HI
0006FEr 1  9C 00 9F           STZ   TURTLE_X_FRAC
000701r 1               
000701r 1                     ; Draw line if pen down
000701r 1  AD 08 9F           LDA   TURTLE_PEN
000704r 1  D0 03              BNE   @skip_draw
000706r 1  20 rr rr           JSR   draw_line
000709r 1               @skip_draw:
000709r 1  20 rr rr           JSR   draw_turtle_sprite
00070Cr 1  60                 RTS
00070Dr 1               
00070Dr 1               ; =====================================================================
00070Dr 1               ; ext_sety — set Y only. Draw line if pen down.
00070Dr 1               ;   ARG0 = y
00070Dr 1               ; =====================================================================
00070Dr 1               ext_sety:
00070Dr 1  20 rr rr           JSR   ensure_gfx_mode
000710r 1  AD 0C 9F           LDA   TURTLE_INITED
000713r 1  D0 03              BNE   @go
000715r 1  20 rr rr           JSR   turtle_init
000718r 1               @go:
000718r 1                     ; Save old position
000718r 1  AD 01 9F           LDA   TURTLE_X_LO
00071Br 1  85 24              STA   old_x_lo
00071Dr 1  AD 02 9F           LDA   TURTLE_X_HI
000720r 1  85 25              STA   old_x_hi
000722r 1  AD 04 9F           LDA   TURTLE_Y_LO
000725r 1  85 26              STA   old_y_lo
000727r 1  AD 05 9F           LDA   TURTLE_Y_HI
00072Ar 1  85 27              STA   old_y_hi
00072Cr 1  20 rr rr           JSR   erase_turtle_sprite
00072Fr 1               
00072Fr 1                     ; Update Y only
00072Fr 1  A5 84              LDA   EXT_ARG0_LO
000731r 1  8D 04 9F           STA   TURTLE_Y_LO
000734r 1  A5 83              LDA   EXT_ARG0_HI
000736r 1  8D 05 9F           STA   TURTLE_Y_HI
000739r 1  9C 03 9F           STZ   TURTLE_Y_FRAC
00073Cr 1               
00073Cr 1                     ; Draw line if pen down
00073Cr 1  AD 08 9F           LDA   TURTLE_PEN
00073Fr 1  D0 03              BNE   @skip_draw
000741r 1  20 rr rr           JSR   draw_line
000744r 1               @skip_draw:
000744r 1  20 rr rr           JSR   draw_turtle_sprite
000747r 1  60                 RTS
000748r 1               
000748r 1               ; =====================================================================
000748r 1               ; ext_seth — set heading to degrees. Normalize mod 360.
000748r 1               ;   ARG0 = degrees
000748r 1               ; =====================================================================
000748r 1               ext_seth:
000748r 1  20 rr rr           JSR   ensure_gfx_mode
00074Br 1  A5 84              LDA   EXT_ARG0_LO
00074Dr 1  8D 06 9F           STA   TURTLE_HEADING_LO
000750r 1  A5 83              LDA   EXT_ARG0_HI
000752r 1  8D 07 9F           STA   TURTLE_HEADING_HI
000755r 1               
000755r 1                     ; Handle negative heading by adding 360 until positive
000755r 1  AD 07 9F           LDA   TURTLE_HEADING_HI
000758r 1  30 06              BMI   @add360
00075Ar 1  20 rr rr           JSR   heading_mod360
00075Dr 1  4C rr rr           JMP   @update
000760r 1               @add360:
000760r 1  18                 CLC
000761r 1  AD 06 9F           LDA   TURTLE_HEADING_LO
000764r 1  69 68              ADC   #<360
000766r 1  8D 06 9F           STA   TURTLE_HEADING_LO
000769r 1  AD 07 9F           LDA   TURTLE_HEADING_HI
00076Cr 1  69 01              ADC   #>360
00076Er 1  8D 07 9F           STA   TURTLE_HEADING_HI
000771r 1  30 ED              BMI   @add360
000773r 1  20 rr rr           JSR   heading_mod360
000776r 1               @update:
000776r 1  20 rr rr           JSR   draw_turtle_sprite
000779r 1  60                 RTS
00077Ar 1               
00077Ar 1               ; =====================================================================
00077Ar 1               ; ext_xcor — return turtle X position (integer part)
00077Ar 1               ; =====================================================================
00077Ar 1               ext_xcor:
00077Ar 1  AD 01 9F           LDA   TURTLE_X_LO
00077Dr 1  85 90              STA   EXT_RESULT_LO
00077Fr 1  AD 02 9F           LDA   TURTLE_X_HI
000782r 1  85 8F              STA   EXT_RESULT_HI
000784r 1  64 91              STZ   EXT_RESULT_FRAC
000786r 1  64 8E              STZ   EXT_RESULT_TYPE      ; VAL_NUMBER
000788r 1  60                 RTS
000789r 1               
000789r 1               ; =====================================================================
000789r 1               ; ext_ycor — return turtle Y position (integer part)
000789r 1               ; =====================================================================
000789r 1               ext_ycor:
000789r 1  AD 04 9F           LDA   TURTLE_Y_LO
00078Cr 1  85 90              STA   EXT_RESULT_LO
00078Er 1  AD 05 9F           LDA   TURTLE_Y_HI
000791r 1  85 8F              STA   EXT_RESULT_HI
000793r 1  64 91              STZ   EXT_RESULT_FRAC
000795r 1  64 8E              STZ   EXT_RESULT_TYPE      ; VAL_NUMBER
000797r 1  60                 RTS
000798r 1               
000798r 1               ; =====================================================================
000798r 1               ; ext_heading — return current heading in degrees
000798r 1               ; =====================================================================
000798r 1               ext_heading:
000798r 1  AD 06 9F           LDA   TURTLE_HEADING_LO
00079Br 1  85 90              STA   EXT_RESULT_LO
00079Dr 1  AD 07 9F           LDA   TURTLE_HEADING_HI
0007A0r 1  85 8F              STA   EXT_RESULT_HI
0007A2r 1  64 91              STZ   EXT_RESULT_FRAC
0007A4r 1  64 8E              STZ   EXT_RESULT_TYPE      ; VAL_NUMBER
0007A6r 1  60                 RTS
0007A7r 1               
0007A7r 1               ; =====================================================================
0007A7r 1               ; ext_pendownp — return 1 if pen is down, 0 if up
0007A7r 1               ; =====================================================================
0007A7r 1               ext_pendownp:
0007A7r 1  AD 08 9F           LDA   TURTLE_PEN
0007AAr 1  D0 06              BNE   @up
0007ACr 1                     ; Pen down ($00) → return 1
0007ACr 1  A9 01              LDA   #1
0007AEr 1  85 90              STA   EXT_RESULT_LO
0007B0r 1  80 02              BRA   @done
0007B2r 1               @up:
0007B2r 1                     ; Pen up ($01) → return 0
0007B2r 1  64 90              STZ   EXT_RESULT_LO
0007B4r 1               @done:
0007B4r 1  64 8F              STZ   EXT_RESULT_HI
0007B6r 1  64 91              STZ   EXT_RESULT_FRAC
0007B8r 1  64 8E              STZ   EXT_RESULT_TYPE
0007BAr 1  60                 RTS
0007BBr 1               
0007BBr 1               ; =====================================================================
0007BBr 1               ; ext_shownp — return 1 if turtle shown, 0 if hidden
0007BBr 1               ; =====================================================================
0007BBr 1               ext_shownp:
0007BBr 1  AD 09 9F           LDA   TURTLE_SHOWN
0007BEr 1  85 90              STA   EXT_RESULT_LO
0007C0r 1  64 8F              STZ   EXT_RESULT_HI
0007C2r 1  64 91              STZ   EXT_RESULT_FRAC
0007C4r 1  64 8E              STZ   EXT_RESULT_TYPE
0007C6r 1  60                 RTS
0007C7r 1               
0007C7r 1               ; =====================================================================
0007C7r 1               ; ext_setpc — set pen color (palette index)
0007C7r 1               ;   ARG0 = color
0007C7r 1               ; =====================================================================
0007C7r 1               ext_setpc:
0007C7r 1  20 rr rr           JSR   ensure_gfx_mode
0007CAr 1  A5 84              LDA   EXT_ARG0_LO
0007CCr 1  8D 0A 9F           STA   TURTLE_COLOR
0007CFr 1  60                 RTS
0007D0r 1               
0007D0r 1               ; =====================================================================
0007D0r 1               ; ext_setbg — set background color (VGC background)
0007D0r 1               ;   ARG0 = color
0007D0r 1               ; =====================================================================
0007D0r 1               ext_setbg:
0007D0r 1  20 rr rr           JSR   ensure_gfx_mode
0007D3r 1  20 rr rr           JSR   erase_turtle_sprite
0007D6r 1  A5 84              LDA   EXT_ARG0_LO
0007D8r 1  8D 01 A0           STA   VGC_BGCOL
0007DBr 1                     ; Also clear graphics plane to this color
0007DBr 1  20 rr rr           JSR   wait_vgc
0007DEr 1  A5 84              LDA   EXT_ARG0_LO
0007E0r 1  8D 11 A0           STA   VGC_P0
0007E3r 1  A9 07              LDA   #VCMD_GCLS
0007E5r 1  8D 10 A0           STA   VGC_CMD
0007E8r 1  20 rr rr           JSR   wait_vgc
0007EBr 1  9C 10 9F           STZ   turtle_bg_saved
0007EEr 1  4C rr rr           JMP   draw_turtle_sprite
0007F1r 1               
0007F1r 1               ; =====================================================================
0007F1r 1               ; ext_towards — return heading angle towards point (x, y)
0007F1r 1               ;   ARG0 = target_x, ARG1 = target_y
0007F1r 1               ;   Uses ATAN2 coprocessor
0007F1r 1               ; =====================================================================
0007F1r 1               ext_towards:
0007F1r 1                     ; dx = target_x - turtle_x (signed 16-bit)
0007F1r 1  38                 SEC
0007F2r 1  A5 84              LDA   EXT_ARG0_LO
0007F4r 1  ED 01 9F           SBC   TURTLE_X_LO
0007F7r 1  8D 31 BB           STA   MATH_ATAN_DX_LO
0007FAr 1  A5 83              LDA   EXT_ARG0_HI
0007FCr 1  ED 02 9F           SBC   TURTLE_X_HI
0007FFr 1  8D 32 BB           STA   MATH_ATAN_DX_HI
000802r 1               
000802r 1                     ; dy = -(target_y - turtle_y) (negate because screen Y is inverted)
000802r 1  38                 SEC
000803r 1  AD 04 9F           LDA   TURTLE_Y_LO
000806r 1  E5 88              SBC   EXT_ARG1_LO
000808r 1  8D 2F BB           STA   MATH_ATAN_DY_LO
00080Br 1  AD 05 9F           LDA   TURTLE_Y_HI
00080Er 1  E5 87              SBC   EXT_ARG1_HI
000810r 1  8D 30 BB           STA   MATH_ATAN_DY_HI      ; writing DY_HI triggers ATAN2
000813r 1               
000813r 1                     ; Result in MATH_RES0 is a u8 angle (0-255)
000813r 1                     ; Convert to degrees: degrees = u8 * 360 / 256 ≈ u8 * 45 / 32
000813r 1                     ; Or more precisely: u8 * 360 / 256 = u8 * 1.40625
000813r 1                     ; Use MUL16: u8 * 360, then take hi byte of result (>>8)
000813r 1  AD 38 BB           LDA   MATH_RES0
000816r 1  8D 20 BB           STA   MATH_MUL16_A_LO
000819r 1  9C 21 BB           STZ   MATH_MUL16_A_HI
00081Cr 1  A9 68              LDA   #<360
00081Er 1  8D 22 BB           STA   MATH_MUL16_B_LO
000821r 1  A9 01              LDA   #>360
000823r 1  8D 23 BB           STA   MATH_MUL16_B_HI      ; triggers multiply
000826r 1               
000826r 1                     ; Result is u8*360, which is 16-bit. >> 8 = MATH_RES1
000826r 1  AD 39 BB           LDA   MATH_RES1
000829r 1  85 90              STA   EXT_RESULT_LO
00082Br 1  AD 3A BB           LDA   MATH_RES2
00082Er 1  85 8F              STA   EXT_RESULT_HI
000830r 1  64 91              STZ   EXT_RESULT_FRAC
000832r 1  64 8E              STZ   EXT_RESULT_TYPE
000834r 1  60                 RTS
000835r 1               
000835r 1               ; =====================================================================
000835r 1               ; ext_setcolor — set VGC drawing color
000835r 1               ;   ARG0 = color (palette index 0-15)
000835r 1               ; =====================================================================
000835r 1               ext_setcolor:
000835r 1  20 rr rr           JSR   ensure_gfx_mode
000838r 1  20 rr rr           JSR   wait_vgc
00083Br 1  A5 84              LDA   EXT_ARG0_LO
00083Dr 1  8D 11 A0           STA   VGC_P0
000840r 1  A9 08              LDA   #VCMD_GCOLOR
000842r 1  8D 10 A0           STA   VGC_CMD
000845r 1  60                 RTS
000846r 1               
000846r 1               ; =====================================================================
000846r 1               ; ext_plot — plot a pixel at (x, y) in current draw color
000846r 1               ;   ARG0 = x, ARG1 = y
000846r 1               ; =====================================================================
000846r 1               ext_plot:
000846r 1  20 rr rr           JSR   ensure_gfx_mode
000849r 1  20 rr rr           JSR   erase_turtle_sprite
00084Cr 1  20 rr rr           JSR   wait_vgc
00084Fr 1  A5 84              LDA   EXT_ARG0_LO
000851r 1  8D 11 A0           STA   VGC_P0
000854r 1  A5 83              LDA   EXT_ARG0_HI
000856r 1  8D 12 A0           STA   VGC_P1
000859r 1  A5 88              LDA   EXT_ARG1_LO
00085Br 1  8D 13 A0           STA   VGC_P2
00085Er 1  A5 87              LDA   EXT_ARG1_HI
000860r 1  8D 14 A0           STA   VGC_P3
000863r 1  A9 01              LDA   #VCMD_PLOT
000865r 1  8D 10 A0           STA   VGC_CMD
000868r 1  20 rr rr           JSR   wait_vgc
00086Br 1  4C rr rr           JMP   draw_turtle_sprite
00086Er 1               
00086Er 1               ; =====================================================================
00086Er 1               ; ext_unplot — clear a pixel at (x, y)
00086Er 1               ;   ARG0 = x, ARG1 = y
00086Er 1               ; =====================================================================
00086Er 1               ext_unplot:
00086Er 1  20 rr rr           JSR   ensure_gfx_mode
000871r 1  20 rr rr           JSR   erase_turtle_sprite
000874r 1  20 rr rr           JSR   wait_vgc
000877r 1  A5 84              LDA   EXT_ARG0_LO
000879r 1  8D 11 A0           STA   VGC_P0
00087Cr 1  A5 83              LDA   EXT_ARG0_HI
00087Er 1  8D 12 A0           STA   VGC_P1
000881r 1  A5 88              LDA   EXT_ARG1_LO
000883r 1  8D 13 A0           STA   VGC_P2
000886r 1  A5 87              LDA   EXT_ARG1_HI
000888r 1  8D 14 A0           STA   VGC_P3
00088Br 1  A9 02              LDA   #VCMD_UNPLOT
00088Dr 1  8D 10 A0           STA   VGC_CMD
000890r 1  20 rr rr           JSR   wait_vgc
000893r 1  4C rr rr           JMP   draw_turtle_sprite
000896r 1               
000896r 1               ; =====================================================================
000896r 1               ; ext_line — draw line from (x1,y1) to (x2,y2)
000896r 1               ;   ARG0 = x1, ARG1 = y1, ARG2 = x2, ARG3 = y2
000896r 1               ; =====================================================================
000896r 1               ext_line:
000896r 1  20 rr rr           JSR   ensure_gfx_mode
000899r 1  20 rr rr           JSR   erase_turtle_sprite
00089Cr 1  20 rr rr           JSR   wait_vgc
00089Fr 1  A5 84              LDA   EXT_ARG0_LO
0008A1r 1  8D 11 A0           STA   VGC_P0
0008A4r 1  A5 83              LDA   EXT_ARG0_HI
0008A6r 1  8D 12 A0           STA   VGC_P1
0008A9r 1  A5 88              LDA   EXT_ARG1_LO
0008ABr 1  8D 13 A0           STA   VGC_P2
0008AEr 1  A5 87              LDA   EXT_ARG1_HI
0008B0r 1  8D 14 A0           STA   VGC_P3
0008B3r 1  A5 8C              LDA   EXT_ARG2_LO
0008B5r 1  8D 15 A0           STA   VGC_P4
0008B8r 1  A5 8B              LDA   EXT_ARG2_HI
0008BAr 1  8D 16 A0           STA   VGC_P5
0008BDr 1  A5 A1              LDA   EXT_ARG3_LO
0008BFr 1  8D 17 A0           STA   VGC_P6
0008C2r 1  A5 A0              LDA   EXT_ARG3_HI
0008C4r 1  8D 18 A0           STA   VGC_P7
0008C7r 1  A9 03              LDA   #VCMD_LINE
0008C9r 1  8D 10 A0           STA   VGC_CMD
0008CCr 1  20 rr rr           JSR   wait_vgc
0008CFr 1  4C rr rr           JMP   draw_turtle_sprite
0008D2r 1               
0008D2r 1               ; =====================================================================
0008D2r 1               ; ext_circle — draw circle at (x, y) with radius r
0008D2r 1               ;   ARG0 = x, ARG1 = y, ARG2 = r
0008D2r 1               ; =====================================================================
0008D2r 1               ext_circle:
0008D2r 1  20 rr rr           JSR   ensure_gfx_mode
0008D5r 1  20 rr rr           JSR   erase_turtle_sprite
0008D8r 1  20 rr rr           JSR   wait_vgc
0008DBr 1  A5 84              LDA   EXT_ARG0_LO
0008DDr 1  8D 11 A0           STA   VGC_P0
0008E0r 1  A5 83              LDA   EXT_ARG0_HI
0008E2r 1  8D 12 A0           STA   VGC_P1
0008E5r 1  A5 88              LDA   EXT_ARG1_LO
0008E7r 1  8D 13 A0           STA   VGC_P2
0008EAr 1  A5 87              LDA   EXT_ARG1_HI
0008ECr 1  8D 14 A0           STA   VGC_P3
0008EFr 1  A5 8C              LDA   EXT_ARG2_LO
0008F1r 1  8D 15 A0           STA   VGC_P4
0008F4r 1  A5 8B              LDA   EXT_ARG2_HI
0008F6r 1  8D 16 A0           STA   VGC_P5
0008F9r 1  9C 17 A0           STZ   VGC_P6              ; ry_lo = 0 → use rx as both radii
0008FCr 1  9C 18 A0           STZ   VGC_P7              ; ry_hi = 0
0008FFr 1  A9 04              LDA   #VCMD_CIRCLE
000901r 1  8D 10 A0           STA   VGC_CMD
000904r 1  20 rr rr           JSR   wait_vgc
000907r 1  4C rr rr           JMP   draw_turtle_sprite
00090Ar 1               
00090Ar 1               ; =====================================================================
00090Ar 1               ; ext_rect — draw rectangle outline from (x1,y1) to (x2,y2)
00090Ar 1               ;   ARG0 = x1, ARG1 = y1, ARG2 = x2, ARG3 = y2
00090Ar 1               ; =====================================================================
00090Ar 1               ext_rect:
00090Ar 1  20 rr rr           JSR   ensure_gfx_mode
00090Dr 1  20 rr rr           JSR   erase_turtle_sprite
000910r 1  20 rr rr           JSR   wait_vgc
000913r 1  A5 84              LDA   EXT_ARG0_LO
000915r 1  8D 11 A0           STA   VGC_P0
000918r 1  A5 83              LDA   EXT_ARG0_HI
00091Ar 1  8D 12 A0           STA   VGC_P1
00091Dr 1  A5 88              LDA   EXT_ARG1_LO
00091Fr 1  8D 13 A0           STA   VGC_P2
000922r 1  A5 87              LDA   EXT_ARG1_HI
000924r 1  8D 14 A0           STA   VGC_P3
000927r 1  A5 8C              LDA   EXT_ARG2_LO
000929r 1  8D 15 A0           STA   VGC_P4
00092Cr 1  A5 8B              LDA   EXT_ARG2_HI
00092Er 1  8D 16 A0           STA   VGC_P5
000931r 1  A5 A1              LDA   EXT_ARG3_LO
000933r 1  8D 17 A0           STA   VGC_P6
000936r 1  A5 A0              LDA   EXT_ARG3_HI
000938r 1  8D 18 A0           STA   VGC_P7
00093Br 1  A9 05              LDA   #VCMD_RECT
00093Dr 1  8D 10 A0           STA   VGC_CMD
000940r 1  20 rr rr           JSR   wait_vgc
000943r 1  4C rr rr           JMP   draw_turtle_sprite
000946r 1               
000946r 1               ; =====================================================================
000946r 1               ; ext_fillrect — draw filled rectangle from (x1,y1) to (x2,y2)
000946r 1               ;   ARG0 = x1, ARG1 = y1, ARG2 = x2, ARG3 = y2
000946r 1               ; =====================================================================
000946r 1               ext_fillrect:
000946r 1  20 rr rr           JSR   ensure_gfx_mode
000949r 1  20 rr rr           JSR   erase_turtle_sprite
00094Cr 1  20 rr rr           JSR   wait_vgc
00094Fr 1  A5 84              LDA   EXT_ARG0_LO
000951r 1  8D 11 A0           STA   VGC_P0
000954r 1  A5 83              LDA   EXT_ARG0_HI
000956r 1  8D 12 A0           STA   VGC_P1
000959r 1  A5 88              LDA   EXT_ARG1_LO
00095Br 1  8D 13 A0           STA   VGC_P2
00095Er 1  A5 87              LDA   EXT_ARG1_HI
000960r 1  8D 14 A0           STA   VGC_P3
000963r 1  A5 8C              LDA   EXT_ARG2_LO
000965r 1  8D 15 A0           STA   VGC_P4
000968r 1  A5 8B              LDA   EXT_ARG2_HI
00096Ar 1  8D 16 A0           STA   VGC_P5
00096Dr 1  A5 A1              LDA   EXT_ARG3_LO
00096Fr 1  8D 17 A0           STA   VGC_P6
000972r 1  A5 A0              LDA   EXT_ARG3_HI
000974r 1  8D 18 A0           STA   VGC_P7
000977r 1  A9 06              LDA   #VCMD_FILL
000979r 1  8D 10 A0           STA   VGC_CMD
00097Cr 1  20 rr rr           JSR   wait_vgc
00097Fr 1  4C rr rr           JMP   draw_turtle_sprite
000982r 1               
000982r 1               ; =====================================================================
000982r 1               ; ext_paint — flood fill at (x, y) with current draw color
000982r 1               ;   ARG0 = x, ARG1 = y
000982r 1               ; =====================================================================
000982r 1               ext_paint:
000982r 1  20 rr rr           JSR   ensure_gfx_mode
000985r 1  20 rr rr           JSR   erase_turtle_sprite
000988r 1  20 rr rr           JSR   wait_vgc
00098Br 1  A5 84              LDA   EXT_ARG0_LO
00098Dr 1  8D 11 A0           STA   VGC_P0
000990r 1  A5 83              LDA   EXT_ARG0_HI
000992r 1  8D 12 A0           STA   VGC_P1
000995r 1  A5 88              LDA   EXT_ARG1_LO
000997r 1  8D 13 A0           STA   VGC_P2
00099Ar 1  A5 87              LDA   EXT_ARG1_HI
00099Cr 1  8D 14 A0           STA   VGC_P3
00099Fr 1  A9 09              LDA   #VCMD_PAINT
0009A1r 1  8D 10 A0           STA   VGC_CMD
0009A4r 1  20 rr rr           JSR   wait_vgc
0009A7r 1  4C rr rr           JMP   draw_turtle_sprite
0009AAr 1               
0009AAr 1               ; =====================================================================
0009AAr 1               ; ext_sprite — SPRITE n x y: position and enable sprite N
0009AAr 1               ;   ARG0 = slot, ARG1 = x (16-bit), ARG2 = y (16-bit)
0009AAr 1               ; =====================================================================
0009AAr 1               ext_sprite:
0009AAr 1  20 rr rr           JSR   ensure_gfx_mode
0009ADr 1                     ; SPRPOS: P0=slot, P1=x_lo, P2=x_hi, P3=y_lo, P4=y_hi
0009ADr 1  20 rr rr           JSR   wait_vgc
0009B0r 1  A5 84              LDA   EXT_ARG0_LO
0009B2r 1  8D 11 A0           STA   VGC_P0
0009B5r 1  A5 88              LDA   EXT_ARG1_LO
0009B7r 1  8D 12 A0           STA   VGC_P1
0009BAr 1  A5 87              LDA   EXT_ARG1_HI
0009BCr 1  8D 13 A0           STA   VGC_P2
0009BFr 1  A5 8C              LDA   EXT_ARG2_LO
0009C1r 1  8D 14 A0           STA   VGC_P3
0009C4r 1  A5 8B              LDA   EXT_ARG2_HI
0009C6r 1  8D 15 A0           STA   VGC_P4
0009C9r 1  A9 14              LDA   #VCMD_SPRPOS
0009CBr 1  8D 10 A0           STA   VGC_CMD
0009CEr 1                     ; SPRENA: P0=slot
0009CEr 1  20 rr rr           JSR   wait_vgc
0009D1r 1  A5 84              LDA   EXT_ARG0_LO
0009D3r 1  8D 11 A0           STA   VGC_P0
0009D6r 1  A9 15              LDA   #VCMD_SPRENA
0009D8r 1  8D 10 A0           STA   VGC_CMD
0009DBr 1  60                 RTS
0009DCr 1               
0009DCr 1               ; =====================================================================
0009DCr 1               ; ext_spritepos — SPRITEPOS n x y: reposition sprite N
0009DCr 1               ;   ARG0 = slot, ARG1 = x, ARG2 = y
0009DCr 1               ; =====================================================================
0009DCr 1               ext_spritepos:
0009DCr 1  20 rr rr           JSR   ensure_gfx_mode
0009DFr 1  20 rr rr           JSR   wait_vgc
0009E2r 1  A5 84              LDA   EXT_ARG0_LO
0009E4r 1  8D 11 A0           STA   VGC_P0
0009E7r 1  A5 88              LDA   EXT_ARG1_LO
0009E9r 1  8D 12 A0           STA   VGC_P1
0009ECr 1  A5 87              LDA   EXT_ARG1_HI
0009EEr 1  8D 13 A0           STA   VGC_P2
0009F1r 1  A5 8C              LDA   EXT_ARG2_LO
0009F3r 1  8D 14 A0           STA   VGC_P3
0009F6r 1  A5 8B              LDA   EXT_ARG2_HI
0009F8r 1  8D 15 A0           STA   VGC_P4
0009FBr 1  A9 14              LDA   #VCMD_SPRPOS
0009FDr 1  8D 10 A0           STA   VGC_CMD
000A00r 1  60                 RTS
000A01r 1               
000A01r 1               ; =====================================================================
000A01r 1               ; ext_spriteon — SPRITEON n: enable sprite N
000A01r 1               ;   ARG0 = slot
000A01r 1               ; =====================================================================
000A01r 1               ext_spriteon:
000A01r 1  20 rr rr           JSR   ensure_gfx_mode
000A04r 1  20 rr rr           JSR   wait_vgc
000A07r 1  A5 84              LDA   EXT_ARG0_LO
000A09r 1  8D 11 A0           STA   VGC_P0
000A0Cr 1  A9 15              LDA   #VCMD_SPRENA
000A0Er 1  8D 10 A0           STA   VGC_CMD
000A11r 1  60                 RTS
000A12r 1               
000A12r 1               ; =====================================================================
000A12r 1               ; ext_spriteoff — SPRITEOFF n: disable sprite N
000A12r 1               ;   ARG0 = slot
000A12r 1               ; =====================================================================
000A12r 1               ext_spriteoff:
000A12r 1  20 rr rr           JSR   ensure_gfx_mode
000A15r 1  20 rr rr           JSR   wait_vgc
000A18r 1  A5 84              LDA   EXT_ARG0_LO
000A1Ar 1  8D 11 A0           STA   VGC_P0
000A1Dr 1  A9 16              LDA   #VCMD_SPRDIS
000A1Fr 1  8D 10 A0           STA   VGC_CMD
000A22r 1  60                 RTS
000A23r 1               
000A23r 1               ; =====================================================================
000A23r 1               ; ext_sprcollp — SPRITECOLLISION? n: return 1 if sprite N collided
000A23r 1               ;   ARG0 = slot (0-15)
000A23r 1               ;   Reads VGC_COLLST (bits 0-7) / VGC_COLLST_HI (bits 8-15)
000A23r 1               ; =====================================================================
000A23r 1               ext_sprcollp:
000A23r 1  A5 84              LDA   EXT_ARG0_LO
000A25r 1  C9 08              CMP   #8
000A27r 1  B0 06              BCS   @hi_byte
000A29r 1                     ; Sprite 0-7: read low byte, test bit
000A29r 1  AA                 TAX
000A2Ar 1  AD 0B A0           LDA   VGC_COLLST
000A2Dr 1  80 07              BRA   @test_bit
000A2Fr 1               @hi_byte:
000A2Fr 1                     ; Sprite 8-15: read high byte, adjust bit index
000A2Fr 1  38                 SEC
000A30r 1  E9 08              SBC   #8
000A32r 1  AA                 TAX
000A33r 1  AD EB A0           LDA   VGC_COLLST_HI
000A36r 1               @test_bit:
000A36r 1                     ; Shift right X times to get bit into carry
000A36r 1  E0 00              CPX   #0
000A38r 1  F0 04              BEQ   @check
000A3Ar 1               @shift:
000A3Ar 1  4A                 LSR
000A3Br 1  CA                 DEX
000A3Cr 1  D0 FC              BNE   @shift
000A3Er 1               @check:
000A3Er 1  29 01              AND   #$01
000A40r 1  85 90              STA   EXT_RESULT_LO
000A42r 1  64 8F              STZ   EXT_RESULT_HI
000A44r 1  64 91              STZ   EXT_RESULT_FRAC
000A46r 1  64 8E              STZ   EXT_RESULT_TYPE
000A48r 1  60                 RTS
000A49r 1               
000A49r 1               ; =====================================================================
000A49r 1               ; ext_tone — TONE freq dur: play a tone on SID voice 0
000A49r 1               ;   ARG0 = frequency (16-bit SID freq word), ARG1 = duration (frames)
000A49r 1               ; =====================================================================
000A49r 1               ext_tone:
000A49r 1                     ; Set SID master volume to max
000A49r 1  A9 0F              LDA   #$0F
000A4Br 1  8D 18 D4           STA   SID_BASE + $18         ; $D418 filter/volume, bits 0-3 = volume
000A4Er 1                     ; Set frequency
000A4Er 1  A5 84              LDA   EXT_ARG0_LO
000A50r 1  8D 00 D4           STA   SID_BASE + $00         ; freq lo
000A53r 1  A5 83              LDA   EXT_ARG0_HI
000A55r 1  8D 01 D4           STA   SID_BASE + $01         ; freq hi
000A58r 1                     ; Set ADSR: attack=0, decay=9, sustain=$A, release=0
000A58r 1  A9 09              LDA   #$09
000A5Ar 1  8D 05 D4           STA   SID_BASE + $05         ; attack/decay
000A5Dr 1  A9 A0              LDA   #$A0
000A5Fr 1  8D 06 D4           STA   SID_BASE + $06         ; sustain/release
000A62r 1                     ; Gate on with sawtooth waveform
000A62r 1  A9 21              LDA   #$21                   ; sawtooth ($20) + gate ($01)
000A64r 1  8D 04 D4           STA   SID_BASE + $04         ; control register
000A67r 1                     ; Wait duration frames
000A67r 1  A5 88              LDA   EXT_ARG1_LO
000A69r 1  20 rr rr           JSR   wait_frames
000A6Cr 1                     ; Gate off
000A6Cr 1  A9 20              LDA   #$20                   ; sawtooth, no gate
000A6Er 1  8D 04 D4           STA   SID_BASE + $04
000A71r 1  60                 RTS
000A72r 1               
000A72r 1               ; =====================================================================
000A72r 1               ; ext_noise — NOISE dur: noise burst on SID voice 0
000A72r 1               ;   ARG0 = duration (frames)
000A72r 1               ; =====================================================================
000A72r 1               ext_noise:
000A72r 1                     ; Set SID master volume to max
000A72r 1  A9 0F              LDA   #$0F
000A74r 1  8D 18 D4           STA   SID_BASE + $18
000A77r 1                     ; Set a mid-range frequency for noise
000A77r 1  A9 00              LDA   #$00
000A79r 1  8D 00 D4           STA   SID_BASE + $00
000A7Cr 1  A9 20              LDA   #$20
000A7Er 1  8D 01 D4           STA   SID_BASE + $01
000A81r 1                     ; ADSR: fast attack, medium sustain
000A81r 1  A9 09              LDA   #$09
000A83r 1  8D 05 D4           STA   SID_BASE + $05
000A86r 1  A9 A0              LDA   #$A0
000A88r 1  8D 06 D4           STA   SID_BASE + $06
000A8Br 1                     ; Gate on with noise waveform
000A8Br 1  A9 81              LDA   #$81                   ; noise ($80) + gate ($01)
000A8Dr 1  8D 04 D4           STA   SID_BASE + $04
000A90r 1                     ; Wait duration frames
000A90r 1  A5 84              LDA   EXT_ARG0_LO
000A92r 1  20 rr rr           JSR   wait_frames
000A95r 1                     ; Gate off
000A95r 1  A9 80              LDA   #$80                   ; noise, no gate
000A97r 1  8D 04 D4           STA   SID_BASE + $04
000A9Ar 1  60                 RTS
000A9Br 1               
000A9Br 1               ; =====================================================================
000A9Br 1               ; ext_volume — VOLUME vol: set SID master volume (0-15)
000A9Br 1               ;   ARG0 = volume
000A9Br 1               ; =====================================================================
000A9Br 1               ext_volume:
000A9Br 1  A5 84              LDA   EXT_ARG0_LO
000A9Dr 1  29 0F              AND   #$0F                   ; clamp to 0-15
000A9Fr 1  8D 18 D4           STA   SID_BASE + $18
000AA2r 1  60                 RTS
000AA3r 1               
000AA3r 1               ; =====================================================================
000AA3r 1               ; ext_wait — WAIT n: wait N video frames
000AA3r 1               ;   ARG0 = count
000AA3r 1               ; =====================================================================
000AA3r 1               ext_wait:
000AA3r 1  A5 84              LDA   EXT_ARG0_LO
000AA5r 1  20 rr rr           JSR   wait_frames
000AA8r 1  60                 RTS
000AA9r 1               
000AA9r 1               ; =====================================================================
000AA9r 1               ; ext_waitvbl — WAITVBL: wait for next vertical blank (1 frame)
000AA9r 1               ; =====================================================================
000AA9r 1               ext_waitvbl:
000AA9r 1  AD 08 A0           LDA   VGC_FRAME
000AACr 1  CD 08 A0     @w:   CMP   VGC_FRAME
000AAFr 1  F0 FB              BEQ   @w
000AB1r 1  60                 RTS
000AB2r 1               
000AB2r 1               ; =====================================================================
000AB2r 1               ; ext_timer — TIMER: return current frame counter (8-bit)
000AB2r 1               ; =====================================================================
000AB2r 1               ext_timer:
000AB2r 1  AD 08 A0           LDA   VGC_FRAME
000AB5r 1  85 90              STA   EXT_RESULT_LO
000AB7r 1  64 8F              STZ   EXT_RESULT_HI
000AB9r 1  64 91              STZ   EXT_RESULT_FRAC
000ABBr 1  64 8E              STZ   EXT_RESULT_TYPE
000ABDr 1  60                 RTS
000ABEr 1               
000ABEr 1               ; =====================================================================
000ABEr 1               ; wait_frames — wait A video frames. Reused by TONE, NOISE, WAIT.
000ABEr 1               ; =====================================================================
000ABEr 1               wait_frames:
000ABEr 1  AA                 TAX
000ABFr 1  F0 0E              BEQ   @done
000AC1r 1  AD 08 A0           LDA   VGC_FRAME
000AC4r 1               @wait:
000AC4r 1  CD 08 A0           CMP   VGC_FRAME
000AC7r 1  F0 FB              BEQ   @wait
000AC9r 1  AD 08 A0           LDA   VGC_FRAME
000ACCr 1  CA                 DEX
000ACDr 1  D0 F5              BNE   @wait
000ACFr 1               @done:
000ACFr 1  60                 RTS
000AD0r 1               
000AD0r 1               ; =====================================================================
000AD0r 1               ; RODATA segment — turtle sprite shape data
000AD0r 1               ; =====================================================================
000AD0r 1                     .segment "RODATA"
000000r 1               
000000r 1               ; 16x16 turtle arrow shape pointing UP (north), matching the NDK turtle demo.
000000r 1               ; Single-color triangle (apex = heading). Orientation is shown by a 2-row-thick
000000r 1               ; solid base bar (rows 13-14); the slanted sides are one pixel wide.
000000r 1               turtle_shape_data:
000000r 1  00 00 00 00  .repeat 16, yy
000004r 1  00 00 00 00  
000008r 1  00 00 00 00  
000100r 1                 .repeat 16, xx
000100r 1                   .if yy < 1
000100r 1                     .byte 0
000100r 1                   .elseif yy > 14
000100r 1                     .byte 0
000100r 1                   .elseif yy >= 13
000100r 1                     ; bottom two rows: filled base bar spanning the triangle width
000100r 1                     .if xx >= (8 - ((((yy - 1) * 7) + 6) / 13)) && xx <= (8 + ((((yy - 1) * 6) + 6) / 13))
000100r 1                       .byte COL_WHITE
000100r 1                     .else
000100r 1                       .byte 0
000100r 1                     .endif
000100r 1                   .elseif xx = (8 - ((((yy - 1) * 7) + 6) / 13))
000100r 1                     .byte COL_WHITE
000100r 1                   .elseif xx = (8 + ((((yy - 1) * 6) + 6) / 13))
000100r 1                     .byte COL_WHITE
000100r 1                   .else
000100r 1                     .byte 0
000100r 1                   .endif
000100r 1                 .endrepeat
000100r 1               .endrepeat
000100r 1               
000100r 1                     .include "vgc.s"
000100r 2               ; Shared Nova VGC helper routines.
000100r 2               ;
000100r 2               ; BASIC should parse language syntax and load VGC registers; assembly callers
000100r 2               ; can use the same routines directly after setting VGC_P* arguments.
000100r 2               
000100r 2               .include "vgc.inc"
000100r 3               ; Shared Nova VGC helper declarations.
000100r 3               ;
000100r 3               ; The command helpers use the VGC hardware parameter registers directly:
000100r 3               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
000100r 3               ; Routines return through the hardware status model; command completion can be
000100r 3               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
000100r 3               
000100r 3               .ifndef VGC_INC_INCLUDED
000100r 3               VGC_INC_INCLUDED = 1
000100r 3               
000100r 3               .include "nova.inc"
000100r 3               
000100r 3               VGC_RESULT_OK    = $00
000100r 3               VGC_RESULT_ERROR = $01
000100r 3               
000100r 3               .endif
000100r 3               
000100r 2               
000100r 2               .ifndef VGC_IMPLEMENTATION_INCLUDED
000100r 2               VGC_IMPLEMENTATION_INCLUDED = 1
000100r 2               
000100r 2                     .segment "CODE"
000AD0r 2               
000AD0r 2                     .export vgc_cmd
000AD0r 2                     .export vgc_wait_cmd
000AD0r 2               .ifndef VGC_NO_EXEC
000AD0r 2                     .export vgc_exec
000AD0r 2               .endif
000AD0r 2                     .export vgc_vsync
000AD0r 2                     .export vgc_cls
000AD0r 2                     .export vgc_set_fg
000AD0r 2                     .export vgc_set_bg
000AD0r 2                     .export vgc_set_border
000AD0r 2                     .export vgc_display_on
000AD0r 2                     .export vgc_display_off
000AD0r 2                     .export vgc_irq_install
000AD0r 2                     .export vgc_irq_enable
000AD0r 2                     .export vgc_irq_disable
000AD0r 2                     .export vgc_irq_ack
000AD0r 2                     .export vgc_locate
000AD0r 2                     .export vgc_set_mode
000AD0r 2                     .export vgc_set_font
000AD0r 2                     .export vgc_mem_read
000AD0r 2                     .export vgc_mem_write
000AD0r 2                     .export vgc_reverse_default
000AD0r 2                     .export vgc_reverse_explicit
000AD0r 2                     .export vgc_reverse_off
000AD0r 2                     .export vgc_flash_on
000AD0r 2                     .export vgc_flash_off
000AD0r 2               .ifndef VGC_NO_PRIMITIVES
000AD0r 2                     .export vgc_gcls
000AD0r 2                     .export vgc_gcolor
000AD0r 2                     .export vgc_plot
000AD0r 2                     .export vgc_unplot
000AD0r 2                     .export vgc_line
000AD0r 2                     .export vgc_circle
000AD0r 2                     .export vgc_gtext
000AD0r 2                     .export vgc_rect
000AD0r 2                     .export vgc_fill
000AD0r 2                     .export vgc_paint
000AD0r 2               .endif
000AD0r 2               
000AD0r 2               ; Input: A = VGC command. Does not wait for completion.
000AD0r 2               ; @label VGC.COMMAND
000AD0r 2               ; @kind routine
000AD0r 2               ; @symbol vgc_cmd
000AD0r 2               ; @summary Issue a raw VGC command without waiting for completion.
000AD0r 2               ; @in A: VGC command byte.
000AD0r 2               vgc_cmd:
000AD0r 2  8D 10 A0           STA   VGC_CMD
000AD3r 2  60                 RTS
000AD4r 2               
000AD4r 2               ; Wait until the command busy bit clears.
000AD4r 2               ; @label VGC.WAIT_COMMAND
000AD4r 2               ; @kind routine
000AD4r 2               ; @symbol vgc_wait_cmd
000AD4r 2               ; @summary Wait for the active VGC command to complete.
000AD4r 2               vgc_wait_cmd:
000AD4r 2               @wait:
000AD4r 2  AD 10 A0           LDA   VGC_CMD
000AD7r 2  29 01              AND   #$01
000AD9r 2  D0 F9              BNE   @wait
000ADBr 2  60                 RTS
000ADCr 2               
000ADCr 2               ; Input: A = VGC command. Issue and wait for completion.
000ADCr 2               .ifndef VGC_NO_EXEC
000ADCr 2               ; @label VGC.EXEC
000ADCr 2               ; @kind routine
000ADCr 2               ; @symbol vgc_exec
000ADCr 2               ; @summary Issue a raw VGC command and wait for completion.
000ADCr 2               ; @in A: VGC command byte.
000ADCr 2               vgc_exec:
000ADCr 2  20 rr rr           JSR   vgc_cmd
000ADFr 2  4C rr rr           JMP   vgc_wait_cmd
000AE2r 2               .endif
000AE2r 2               
000AE2r 2               ; Wait for the next frame counter tick.
000AE2r 2               ; @label VGC.VSYNC
000AE2r 2               ; @kind routine
000AE2r 2               ; @symbol vgc_vsync
000AE2r 2               ; @summary Wait until the VGC frame counter advances.
000AE2r 2               ; @out A: Last observed frame counter value.
000AE2r 2               vgc_vsync:
000AE2r 2  AD 08 A0           LDA   VGC_FRAME
000AE5r 2               @wait:
000AE5r 2  CD 08 A0           CMP   VGC_FRAME
000AE8r 2  F0 FB              BEQ   @wait
000AEAr 2  60                 RTS
000AEBr 2               
000AEBr 2               ; @label VGC.CLS
000AEBr 2               ; @kind routine
000AEBr 2               ; @symbol vgc_cls
000AEBr 2               ; @summary Clear the text screen through the VGC character output register and wait for completion.
000AEBr 2               vgc_cls:
000AEBr 2               .ifdef VGC_CLS_EXT
000AEBr 2                     LDA   #EXT_CMD_CLS
000AEBr 2                     JMP   EXT_vec
000AEBr 2               .else
000AEBr 2  A9 0C              LDA   #$0C
000AEDr 2  8D 0E A0           STA   VGC_CHAROUT
000AF0r 2  4C rr rr           JMP   vgc_wait_cmd
000AF3r 2               .endif
000AF3r 2               
000AF3r 2               ; @label VGC.SET_FG
000AF3r 2               ; @kind routine
000AF3r 2               ; @symbol vgc_set_fg
000AF3r 2               ; @summary Set the current text foreground colour.
000AF3r 2               ; @in X: Foreground colour byte.
000AF3r 2               vgc_set_fg:
000AF3r 2  8E 02 A0           STX   VGC_FGCOL
000AF6r 2  60                 RTS
000AF7r 2               
000AF7r 2               ; @label VGC.SET_BG
000AF7r 2               ; @kind routine
000AF7r 2               ; @symbol vgc_set_bg
000AF7r 2               ; @summary Set the current text background colour.
000AF7r 2               ; @in X: Background colour byte.
000AF7r 2               vgc_set_bg:
000AF7r 2  8E 01 A0           STX   VGC_BGCOL
000AFAr 2  60                 RTS
000AFBr 2               
000AFBr 2               ; @label VGC.SET_BORDER
000AFBr 2               ; @kind routine
000AFBr 2               ; @symbol vgc_set_border
000AFBr 2               ; @summary Set the VGC border colour.
000AFBr 2               ; @in X: Border colour byte.
000AFBr 2               vgc_set_border:
000AFBr 2  8E 0D A0           STX   VGC_BORDER
000AFEr 2  60                 RTS
000AFFr 2               
000AFFr 2               ; @label VGC.DISPLAY_ON
000AFFr 2               ; @kind routine
000AFFr 2               ; @symbol vgc_display_on
000AFFr 2               ; @summary Restore full VGC output brightness.
000AFFr 2               vgc_display_on:
000AFFr 2  A9 0F              LDA   #$0F
000B01r 2  8D E5 A0           STA   VGC_DIMMER
000B04r 2  60                 RTS
000B05r 2               
000B05r 2               ; @label VGC.DISPLAY_OFF
000B05r 2               ; @kind routine
000B05r 2               ; @symbol vgc_display_off
000B05r 2               ; @summary Blank VGC output while keeping video timing active.
000B05r 2               vgc_display_off:
000B05r 2  A9 00              LDA   #$00
000B07r 2  8D E5 A0           STA   VGC_DIMMER
000B0Ar 2  60                 RTS
000B0Br 2               
000B0Br 2               ; @label VGC.IRQ_INSTALL
000B0Br 2               ; @kind routine
000B0Br 2               ; @symbol vgc_irq_install
000B0Br 2               ; @summary Install the CPU IRQ vector used when enabled VGC IRQ sources fire.
000B0Br 2               ; @in A: Handler address high byte.
000B0Br 2               ; @in Y: Handler address low byte.
000B0Br 2               vgc_irq_install:
000B0Br 2  08                 PHP
000B0Cr 2  78                 SEI
000B0Dr 2  8C FE FF           STY   CPU_IRQ_VECTOR
000B10r 2  8D FF FF           STA   CPU_IRQ_VECTOR+1
000B13r 2  28                 PLP
000B14r 2  60                 RTS
000B15r 2               
000B15r 2               ; @label VGC.IRQ_ENABLE
000B15r 2               ; @kind routine
000B15r 2               ; @symbol vgc_irq_enable
000B15r 2               ; @summary Enable one or more VGC IRQ source bits and enable maskable CPU IRQs.
000B15r 2               ; @in A: VGC IRQ source mask.
000B15r 2               vgc_irq_enable:
000B15r 2  0D F0 A0           ORA   VGC_IRQ_ENABLE
000B18r 2  8D F0 A0           STA   VGC_IRQ_ENABLE
000B1Br 2  58                 CLI
000B1Cr 2  60                 RTS
000B1Dr 2               
000B1Dr 2               ; @label VGC.IRQ_DISABLE
000B1Dr 2               ; @kind routine
000B1Dr 2               ; @symbol vgc_irq_disable
000B1Dr 2               ; @summary Disable one or more VGC IRQ source bits.
000B1Dr 2               ; @in A: VGC IRQ source mask.
000B1Dr 2               vgc_irq_disable:
000B1Dr 2  49 FF              EOR   #$FF
000B1Fr 2  2D F0 A0           AND   VGC_IRQ_ENABLE
000B22r 2  8D F0 A0           STA   VGC_IRQ_ENABLE
000B25r 2  60                 RTS
000B26r 2               
000B26r 2               ; @label VGC.IRQ_ACK
000B26r 2               ; @kind routine
000B26r 2               ; @symbol vgc_irq_ack
000B26r 2               ; @summary Acknowledge pending VGC IRQ source bits.
000B26r 2               ; @in A: VGC IRQ source mask.
000B26r 2               vgc_irq_ack:
000B26r 2  8D F1 A0           STA   VGC_IRQ_STATUS
000B29r 2  60                 RTS
000B2Ar 2               
000B2Ar 2               ; @label VGC.LOCATE
000B2Ar 2               ; @kind routine
000B2Ar 2               ; @symbol vgc_locate
000B2Ar 2               ; @summary Set the text cursor position from VGC.P0/VGC.P1.
000B2Ar 2               ; @in VGC_P0: Cursor X column.
000B2Ar 2               ; @in VGC_P1: Cursor Y row.
000B2Ar 2               vgc_locate:
000B2Ar 2  AD 11 A0           LDA   VGC_P0
000B2Dr 2  8D 03 A0           STA   VGC_CURSX
000B30r 2  AD 12 A0           LDA   VGC_P1
000B33r 2  8D 04 A0           STA   VGC_CURSY
000B36r 2  60                 RTS
000B37r 2               
000B37r 2               ; @label VGC.SET_MODE
000B37r 2               ; @kind routine
000B37r 2               ; @symbol vgc_set_mode
000B37r 2               ; @summary Set the active VGC graphics/text mode.
000B37r 2               ; @in X: Mode byte.
000B37r 2               vgc_set_mode:
000B37r 2  8E 00 A0           STX   VGC_MODE
000B3Ar 2  60                 RTS
000B3Br 2               
000B3Br 2               ; @label VGC.SET_FONT
000B3Br 2               ; @kind routine
000B3Br 2               ; @symbol vgc_set_font
000B3Br 2               ; @summary Select the active text font slot.
000B3Br 2               ; @in X: Font slot, 0..7.
000B3Br 2               vgc_set_font:
000B3Br 2  8E 07 A0           STX   VGC_FONT
000B3Er 2  60                 RTS
000B3Fr 2               
000B3Fr 2               ; @label VGC.MEM_READ
000B3Fr 2               ; @kind routine
000B3Fr 2               ; @symbol vgc_mem_read
000B3Fr 2               ; @summary Read one byte from VGC memory using VGC.P0..VGC.P4.
000B3Fr 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P4
000B3Fr 2               ; @out VGC_P3: Read byte.
000B3Fr 2               vgc_mem_read:
000B3Fr 2  A9 19              LDA   #VCMD_MEMREAD
000B41r 2  2C                 .byte $2C
000B42r 2               
000B42r 2               ; @label VGC.MEM_WRITE
000B42r 2               ; @kind routine
000B42r 2               ; @symbol vgc_mem_write
000B42r 2               ; @summary Write one byte to VGC memory using VGC.P0..VGC.P4.
000B42r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4
000B42r 2               vgc_mem_write:
000B42r 2  A9 1A              LDA   #VCMD_MEMWRITE
000B44r 2  8D 10 A0           STA   VGC_CMD
000B47r 2  4C rr rr           JMP   vgc_wait_cmd
000B4Ar 2               
000B4Ar 2               ; Enable reverse text by swapping the current foreground/background colours.
000B4Ar 2               ; @label VGC.REVERSE
000B4Ar 2               ; @kind routine
000B4Ar 2               ; @symbol vgc_reverse_default
000B4Ar 2               ; @summary Enable reverse text using the current foreground/background colours.
000B4Ar 2               vgc_reverse_default:
000B4Ar 2  AD E6 A0           LDA   VGC_TXTFLAGS
000B4Dr 2  29 FC              AND   #$FC
000B4Fr 2  09 01              ORA   #VTXT_REV
000B51r 2  8D E6 A0           STA   VGC_TXTFLAGS
000B54r 2  60                 RTS
000B55r 2               
000B55r 2               ; Input: A = packed reverse attribute, low nibble fg and high nibble bg.
000B55r 2               ; @label VGC.REVERSE_EXPLICIT
000B55r 2               ; @kind routine
000B55r 2               ; @symbol vgc_reverse_explicit
000B55r 2               ; @summary Enable reverse text with explicit packed foreground/background colours.
000B55r 2               ; @in A: Packed reverse attribute, low nibble foreground and high nibble background.
000B55r 2               vgc_reverse_explicit:
000B55r 2  8D E7 A0           STA   VGC_TXTREVATTR
000B58r 2  AD E6 A0           LDA   VGC_TXTFLAGS
000B5Br 2  29 FC              AND   #$FC
000B5Dr 2  09 03              ORA   #(VTXT_REV | VTXT_REVEX)
000B5Fr 2  8D E6 A0           STA   VGC_TXTFLAGS
000B62r 2  60                 RTS
000B63r 2               
000B63r 2               ; @label VGC.REVERSE_OFF
000B63r 2               ; @kind routine
000B63r 2               ; @symbol vgc_reverse_off
000B63r 2               ; @summary Disable reverse text.
000B63r 2               vgc_reverse_off:
000B63r 2  AD E6 A0           LDA   VGC_TXTFLAGS
000B66r 2  29 FC              AND   #$FC
000B68r 2  8D E6 A0           STA   VGC_TXTFLAGS
000B6Br 2  60                 RTS
000B6Cr 2               
000B6Cr 2               ; @label VGC.FLASH_ON
000B6Cr 2               ; @kind routine
000B6Cr 2               ; @symbol vgc_flash_on
000B6Cr 2               ; @summary Enable flashing text.
000B6Cr 2               vgc_flash_on:
000B6Cr 2  AD E6 A0           LDA   VGC_TXTFLAGS
000B6Fr 2  09 04              ORA   #VTXT_FLASH
000B71r 2  8D E6 A0           STA   VGC_TXTFLAGS
000B74r 2  60                 RTS
000B75r 2               
000B75r 2               ; @label VGC.FLASH_OFF
000B75r 2               ; @kind routine
000B75r 2               ; @symbol vgc_flash_off
000B75r 2               ; @summary Disable flashing text.
000B75r 2               vgc_flash_off:
000B75r 2  AD E6 A0           LDA   VGC_TXTFLAGS
000B78r 2  29 FB              AND   #$FB
000B7Ar 2  8D E6 A0           STA   VGC_TXTFLAGS
000B7Dr 2  60                 RTS
000B7Er 2               
000B7Er 2               .ifndef VGC_NO_PRIMITIVES
000B7Er 2               ; @label VGC.GCLS
000B7Er 2               ; @kind routine
000B7Er 2               ; @symbol vgc_gcls
000B7Er 2               ; @summary Issue the VGC graphics clear command.
000B7Er 2               vgc_gcls:
000B7Er 2  A9 07              LDA   #VCMD_GCLS
000B80r 2  4C rr rr           JMP   vgc_cmd
000B83r 2               
000B83r 2               ; @label VGC.GCOLOR
000B83r 2               ; @kind routine
000B83r 2               ; @symbol vgc_gcolor
000B83r 2               ; @summary Issue the VGC graphics colour command using VGC.P0.
000B83r 2               ; @requires VGC_P0
000B83r 2               vgc_gcolor:
000B83r 2  A9 08              LDA   #VCMD_GCOLOR
000B85r 2  4C rr rr           JMP   vgc_cmd
000B88r 2               
000B88r 2               ; @label VGC.PLOT
000B88r 2               ; @kind routine
000B88r 2               ; @symbol vgc_plot
000B88r 2               ; @summary Issue the VGC plot command using VGC.P0..VGC.P3.
000B88r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000B88r 2               vgc_plot:
000B88r 2  A9 01              LDA   #VCMD_PLOT
000B8Ar 2  4C rr rr           JMP   vgc_cmd
000B8Dr 2               
000B8Dr 2               ; @label VGC.UNPLOT
000B8Dr 2               ; @kind routine
000B8Dr 2               ; @symbol vgc_unplot
000B8Dr 2               ; @summary Issue the VGC unplot command using VGC.P0..VGC.P3.
000B8Dr 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000B8Dr 2               vgc_unplot:
000B8Dr 2  A9 02              LDA   #VCMD_UNPLOT
000B8Fr 2  4C rr rr           JMP   vgc_cmd
000B92r 2               
000B92r 2               ; @label VGC.LINE
000B92r 2               ; @kind routine
000B92r 2               ; @symbol vgc_line
000B92r 2               ; @summary Issue the VGC line command using VGC.P0..VGC.P7.
000B92r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000B92r 2               vgc_line:
000B92r 2  A9 03              LDA   #VCMD_LINE
000B94r 2  4C rr rr           JMP   vgc_cmd
000B97r 2               
000B97r 2               ; @label VGC.CIRCLE
000B97r 2               ; @kind routine
000B97r 2               ; @symbol vgc_circle
000B97r 2               ; @summary Issue the VGC circle/ellipse command using VGC.P0..VGC.P7.
000B97r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000B97r 2               vgc_circle:
000B97r 2  A9 04              LDA   #VCMD_CIRCLE
000B99r 2  4C rr rr           JMP   vgc_cmd
000B9Cr 2               
000B9Cr 2               ; @label VGC.GTEXT
000B9Cr 2               ; @kind routine
000B9Cr 2               ; @symbol vgc_gtext
000B9Cr 2               ; @summary Issue the VGC graphics text command using VGC.P0..VGC.P5 and FIO.NAME.
000B9Cr 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 FIO_NAME FIO_NAMELEN
000B9Cr 2               vgc_gtext:
000B9Cr 2  A9 0A              LDA   #VCMD_GTEXT
000B9Er 2  4C rr rr           JMP   vgc_cmd
000BA1r 2               
000BA1r 2               ; @label VGC.RECT
000BA1r 2               ; @kind routine
000BA1r 2               ; @symbol vgc_rect
000BA1r 2               ; @summary Issue the VGC rectangle command using VGC.P0..VGC.P7.
000BA1r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000BA1r 2               vgc_rect:
000BA1r 2  A9 05              LDA   #VCMD_RECT
000BA3r 2  4C rr rr           JMP   vgc_cmd
000BA6r 2               
000BA6r 2               ; @label VGC.FILL
000BA6r 2               ; @kind routine
000BA6r 2               ; @symbol vgc_fill
000BA6r 2               ; @summary Issue the VGC filled rectangle command using VGC.P0..VGC.P7.
000BA6r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000BA6r 2               vgc_fill:
000BA6r 2  A9 06              LDA   #VCMD_FILL
000BA8r 2  4C rr rr           JMP   vgc_cmd
000BABr 2               
000BABr 2               ; @label VGC.PAINT
000BABr 2               ; @kind routine
000BABr 2               ; @symbol vgc_paint
000BABr 2               ; @summary Issue the VGC paint command using VGC.P0..VGC.P3.
000BABr 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000BABr 2               vgc_paint:
000BABr 2  A9 09              LDA   #VCMD_PAINT
000BADr 2  4C rr rr           JMP   vgc_cmd
000BB0r 2               .endif
000BB0r 2               
000BB0r 2               .endif
000BB0r 2               
000BB0r 1                     .include "copper.s"
000BB0r 2               ; Shared Nova copper helper routines.
000BB0r 2               ;
000BB0r 2               ; Assembly ABI:
000BB0r 2               ;   copper_add expects VGC_P0/P1=x, VGC_P2=y, VGC_P3/P4=register/index,
000BB0r 2               ;   VGC_P5=value. COPPER_REG_* constants cover common VGC register indices.
000BB0r 2               
000BB0r 2               .include "copper.inc"
000BB0r 3               ; Shared Nova copper helper declarations.
000BB0r 3               
000BB0r 3               .ifndef COPPER_INC_INCLUDED
000BB0r 3               COPPER_INC_INCLUDED = 1
000BB0r 3               
000BB0r 3               .include "vgc.inc"
000BB0r 3               
000BB0r 3               COPPER_RESULT_OK    = $00
000BB0r 3               COPPER_RESULT_ERROR = $01
000BB0r 3               
000BB0r 3               COPPER_REG_MODE     = $00
000BB0r 3               COPPER_REG_BGCOL    = $01
000BB0r 3               COPPER_REG_SCROLLX  = $05
000BB0r 3               COPPER_REG_SCROLLY  = $06
000BB0r 3               
000BB0r 3               .endif
000BB0r 3               
000BB0r 2               
000BB0r 2               .ifndef COPPER_IMPLEMENTATION_INCLUDED
000BB0r 2               COPPER_IMPLEMENTATION_INCLUDED = 1
000BB0r 2               
000BB0r 2                     .segment "CODE"
000BB0r 2               
000BB0r 2                     .export copper_command
000BB0r 2                     .export copper_clear
000BB0r 2                     .export copper_on
000BB0r 2                     .export copper_off
000BB0r 2                     .export copper_list
000BB0r 2                     .export copper_list_end
000BB0r 2                     .export copper_use
000BB0r 2                     .export copper_add
000BB0r 2                     .export copper_set_reg_index
000BB0r 2                     .export copper_set_sprite_reg
000BB0r 2               
000BB0r 2               ; Input: A = copper VGC command. Does not wait for completion.
000BB0r 2               ; @label COPPER.COMMAND
000BB0r 2               ; @kind routine
000BB0r 2               ; @symbol copper_command
000BB0r 2               ; @summary Issue a raw copper VGC command.
000BB0r 2               ; @in A: Copper VGC command byte.
000BB0r 2               copper_command:
000BB0r 2  8D 10 A0           STA   VGC_CMD
000BB3r 2  A9 00              LDA   #COPPER_RESULT_OK
000BB5r 2  60                 RTS
000BB6r 2               
000BB6r 2               ; @label COPPER.CLEAR
000BB6r 2               ; @kind routine
000BB6r 2               ; @symbol copper_clear
000BB6r 2               ; @summary Clear the active copper list.
000BB6r 2               copper_clear:
000BB6r 2  A9 1C              LDA   #VCMD_COPPERCLR
000BB8r 2  4C rr rr           JMP   copper_command
000BBBr 2               
000BBBr 2               ; @label COPPER.ON
000BBBr 2               ; @kind routine
000BBBr 2               ; @symbol copper_on
000BBBr 2               ; @summary Enable copper execution.
000BBBr 2               copper_on:
000BBBr 2  A9 1D              LDA   #VCMD_COPPERENA
000BBDr 2  4C rr rr           JMP   copper_command
000BC0r 2               
000BC0r 2               ; @label COPPER.OFF
000BC0r 2               ; @kind routine
000BC0r 2               ; @symbol copper_off
000BC0r 2               ; @summary Disable copper execution.
000BC0r 2               copper_off:
000BC0r 2  A9 1E              LDA   #VCMD_COPPERDIS
000BC2r 2  4C rr rr           JMP   copper_command
000BC5r 2               
000BC5r 2               ; @label COPPER.LIST
000BC5r 2               ; @kind routine
000BC5r 2               ; @symbol copper_list
000BC5r 2               ; @summary Select a copper list using VGC.P0.
000BC5r 2               ; @requires VGC_P0
000BC5r 2               copper_list:
000BC5r 2  A9 20              LDA   #VCMD_COPPERLIST
000BC7r 2  4C rr rr           JMP   copper_command
000BCAr 2               
000BCAr 2               ; @label COPPER.LIST_END
000BCAr 2               ; @kind routine
000BCAr 2               ; @symbol copper_list_end
000BCAr 2               ; @summary Finish the current copper list.
000BCAr 2               copper_list_end:
000BCAr 2  A9 22              LDA   #VCMD_COPPEREND
000BCCr 2  4C rr rr           JMP   copper_command
000BCFr 2               
000BCFr 2               ; @label COPPER.USE
000BCFr 2               ; @kind routine
000BCFr 2               ; @symbol copper_use
000BCFr 2               ; @summary Activate a copper list using VGC.P0.
000BCFr 2               ; @requires VGC_P0
000BCFr 2               copper_use:
000BCFr 2  A9 21              LDA   #VCMD_COPPERUSE
000BD1r 2  4C rr rr           JMP   copper_command
000BD4r 2               
000BD4r 2               ; @label COPPER.ADD
000BD4r 2               ; @kind routine
000BD4r 2               ; @symbol copper_add
000BD4r 2               ; @summary Add a copper operation using VGC.P0..VGC.P5.
000BD4r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5
000BD4r 2               copper_add:
000BD4r 2  A9 1B              LDA   #VCMD_COPPERADD
000BD6r 2  4C rr rr           JMP   copper_command
000BD9r 2               
000BD9r 2               ; Input: A = direct VGC register index. Output: VGC_P3/P4 updated.
000BD9r 2               ; @label COPPER.SET_REG_INDEX
000BD9r 2               ; @kind routine
000BD9r 2               ; @symbol copper_set_reg_index
000BD9r 2               ; @summary Set VGC.P3/P4 to a direct VGC register index.
000BD9r 2               ; @in A: VGC register index.
000BD9r 2               copper_set_reg_index:
000BD9r 2  8D 14 A0           STA   VGC_P3
000BDCr 2  9C 15 A0           STZ   VGC_P4
000BDFr 2  60                 RTS
000BE0r 2               
000BE0r 2               ; Input: X = sprite index, A = VGC_SPR_*_OFF field.
000BE0r 2               ; Output: VGC_P3/P4 = absolute sprite register address.
000BE0r 2               ; Clobbers: A, NVR7L.
000BE0r 2               ; @label COPPER.SET_SPRITE_REG
000BE0r 2               ; @kind routine
000BE0r 2               ; @symbol copper_set_sprite_reg
000BE0r 2               ; @summary Set VGC.P3/P4 to a sprite attribute register address.
000BE0r 2               ; @in X: Sprite index.
000BE0r 2               ; @in A: Sprite field offset.
000BE0r 2               copper_set_sprite_reg:
000BE0r 2  85 2E              STA   NVR7L
000BE2r 2  8A                 TXA
000BE3r 2  0A                 ASL
000BE4r 2  0A                 ASL
000BE5r 2  0A                 ASL
000BE6r 2  18                 CLC
000BE7r 2  65 2E              ADC   NVR7L
000BE9r 2  18                 CLC
000BEAr 2  69 40              ADC   #<VGC_SPR_BASE
000BECr 2  8D 14 A0           STA   VGC_P3
000BEFr 2  A9 A0              LDA   #>VGC_SPR_BASE
000BF1r 2  69 00              ADC   #$00
000BF3r 2  8D 15 A0           STA   VGC_P4
000BF6r 2  60                 RTS
000BF7r 2               
000BF7r 2               .endif
000BF7r 2               
000BF7r 1                     .include "copper_split.s"
000BF7r 2               ; Shared Nova copper split helper routines.
000BF7r 2               
000BF7r 2               .include "copper_split.inc"
000BF7r 3               ; Shared Nova copper split helper declarations.
000BF7r 3               
000BF7r 3               .ifndef COPPER_SPLIT_INC_INCLUDED
000BF7r 3               COPPER_SPLIT_INC_INCLUDED = 1
000BF7r 3               
000BF7r 3               .include "copper.inc"
000BF7r 3               .include "vgc.inc"
000BF7r 3               
000BF7r 3               COPPER_SPLIT_RESULT_OK    = COPPER_RESULT_OK
000BF7r 3               COPPER_SPLIT_RESULT_ERROR = COPPER_RESULT_ERROR
000BF7r 3               
000BF7r 3               ; @label COPPER.SPLIT_MODE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_split_mode
000BF7r 3               ; @summary Configure one copper list to switch VGC mode at a scanline.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000BF7r 3               ; @in VGC_P0: Copper list index.
000BF7r 3               ; @in VGC_P1: Split scanline Y.
000BF7r 3               ; @in VGC_P2: Mode from scanline 0 up to split Y-1.
000BF7r 3               ; @in VGC_P3: Mode from split Y onward.
000BF7r 3               .global copper_split_mode
000BF7r 3               
000BF7r 3               .endif
000BF7r 3               
000BF7r 2               .include "vgc.s"
000BF7r 3               ; Shared Nova VGC helper routines.
000BF7r 3               ;
000BF7r 3               ; BASIC should parse language syntax and load VGC registers; assembly callers
000BF7r 3               ; can use the same routines directly after setting VGC_P* arguments.
000BF7r 3               
000BF7r 3               .include "vgc.inc"
000BF7r 4               ; Shared Nova VGC helper declarations.
000BF7r 4               ;
000BF7r 4               ; The command helpers use the VGC hardware parameter registers directly:
000BF7r 4               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
000BF7r 4               ; Routines return through the hardware status model; command completion can be
000BF7r 4               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
000BF7r 4               
000BF7r 4               .ifndef VGC_INC_INCLUDED
000BF7r 4               VGC_INC_INCLUDED = 1
000BF7r 4               
000BF7r 4               .include "nova.inc"
000BF7r 4               
000BF7r 4               VGC_RESULT_OK    = $00
000BF7r 4               VGC_RESULT_ERROR = $01
000BF7r 4               
000BF7r 4               .endif
000BF7r 4               
000BF7r 3               
000BF7r 3               .ifndef VGC_IMPLEMENTATION_INCLUDED
000BF7r 3               VGC_IMPLEMENTATION_INCLUDED = 1
000BF7r 3               
000BF7r 3                     .segment "CODE"
000BF7r 3               
000BF7r 3                     .export vgc_cmd
000BF7r 3                     .export vgc_wait_cmd
000BF7r 3               .ifndef VGC_NO_EXEC
000BF7r 3                     .export vgc_exec
000BF7r 3               .endif
000BF7r 3                     .export vgc_vsync
000BF7r 3                     .export vgc_cls
000BF7r 3                     .export vgc_set_fg
000BF7r 3                     .export vgc_set_bg
000BF7r 3                     .export vgc_set_border
000BF7r 3                     .export vgc_display_on
000BF7r 3                     .export vgc_display_off
000BF7r 3                     .export vgc_irq_install
000BF7r 3                     .export vgc_irq_enable
000BF7r 3                     .export vgc_irq_disable
000BF7r 3                     .export vgc_irq_ack
000BF7r 3                     .export vgc_locate
000BF7r 3                     .export vgc_set_mode
000BF7r 3                     .export vgc_set_font
000BF7r 3                     .export vgc_mem_read
000BF7r 3                     .export vgc_mem_write
000BF7r 3                     .export vgc_reverse_default
000BF7r 3                     .export vgc_reverse_explicit
000BF7r 3                     .export vgc_reverse_off
000BF7r 3                     .export vgc_flash_on
000BF7r 3                     .export vgc_flash_off
000BF7r 3               .ifndef VGC_NO_PRIMITIVES
000BF7r 3                     .export vgc_gcls
000BF7r 3                     .export vgc_gcolor
000BF7r 3                     .export vgc_plot
000BF7r 3                     .export vgc_unplot
000BF7r 3                     .export vgc_line
000BF7r 3                     .export vgc_circle
000BF7r 3                     .export vgc_gtext
000BF7r 3                     .export vgc_rect
000BF7r 3                     .export vgc_fill
000BF7r 3                     .export vgc_paint
000BF7r 3               .endif
000BF7r 3               
000BF7r 3               ; Input: A = VGC command. Does not wait for completion.
000BF7r 3               ; @label VGC.COMMAND
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_cmd
000BF7r 3               ; @summary Issue a raw VGC command without waiting for completion.
000BF7r 3               ; @in A: VGC command byte.
000BF7r 3               vgc_cmd:
000BF7r 3                     STA   VGC_CMD
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; Wait until the command busy bit clears.
000BF7r 3               ; @label VGC.WAIT_COMMAND
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_wait_cmd
000BF7r 3               ; @summary Wait for the active VGC command to complete.
000BF7r 3               vgc_wait_cmd:
000BF7r 3               @wait:
000BF7r 3                     LDA   VGC_CMD
000BF7r 3                     AND   #$01
000BF7r 3                     BNE   @wait
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; Input: A = VGC command. Issue and wait for completion.
000BF7r 3               .ifndef VGC_NO_EXEC
000BF7r 3               ; @label VGC.EXEC
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_exec
000BF7r 3               ; @summary Issue a raw VGC command and wait for completion.
000BF7r 3               ; @in A: VGC command byte.
000BF7r 3               vgc_exec:
000BF7r 3                     JSR   vgc_cmd
000BF7r 3                     JMP   vgc_wait_cmd
000BF7r 3               .endif
000BF7r 3               
000BF7r 3               ; Wait for the next frame counter tick.
000BF7r 3               ; @label VGC.VSYNC
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_vsync
000BF7r 3               ; @summary Wait until the VGC frame counter advances.
000BF7r 3               ; @out A: Last observed frame counter value.
000BF7r 3               vgc_vsync:
000BF7r 3                     LDA   VGC_FRAME
000BF7r 3               @wait:
000BF7r 3                     CMP   VGC_FRAME
000BF7r 3                     BEQ   @wait
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.CLS
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_cls
000BF7r 3               ; @summary Clear the text screen through the VGC character output register and wait for completion.
000BF7r 3               vgc_cls:
000BF7r 3               .ifdef VGC_CLS_EXT
000BF7r 3                     LDA   #EXT_CMD_CLS
000BF7r 3                     JMP   EXT_vec
000BF7r 3               .else
000BF7r 3                     LDA   #$0C
000BF7r 3                     STA   VGC_CHAROUT
000BF7r 3                     JMP   vgc_wait_cmd
000BF7r 3               .endif
000BF7r 3               
000BF7r 3               ; @label VGC.SET_FG
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_set_fg
000BF7r 3               ; @summary Set the current text foreground colour.
000BF7r 3               ; @in X: Foreground colour byte.
000BF7r 3               vgc_set_fg:
000BF7r 3                     STX   VGC_FGCOL
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.SET_BG
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_set_bg
000BF7r 3               ; @summary Set the current text background colour.
000BF7r 3               ; @in X: Background colour byte.
000BF7r 3               vgc_set_bg:
000BF7r 3                     STX   VGC_BGCOL
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.SET_BORDER
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_set_border
000BF7r 3               ; @summary Set the VGC border colour.
000BF7r 3               ; @in X: Border colour byte.
000BF7r 3               vgc_set_border:
000BF7r 3                     STX   VGC_BORDER
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.DISPLAY_ON
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_display_on
000BF7r 3               ; @summary Restore full VGC output brightness.
000BF7r 3               vgc_display_on:
000BF7r 3                     LDA   #$0F
000BF7r 3                     STA   VGC_DIMMER
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.DISPLAY_OFF
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_display_off
000BF7r 3               ; @summary Blank VGC output while keeping video timing active.
000BF7r 3               vgc_display_off:
000BF7r 3                     LDA   #$00
000BF7r 3                     STA   VGC_DIMMER
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.IRQ_INSTALL
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_irq_install
000BF7r 3               ; @summary Install the CPU IRQ vector used when enabled VGC IRQ sources fire.
000BF7r 3               ; @in A: Handler address high byte.
000BF7r 3               ; @in Y: Handler address low byte.
000BF7r 3               vgc_irq_install:
000BF7r 3                     PHP
000BF7r 3                     SEI
000BF7r 3                     STY   CPU_IRQ_VECTOR
000BF7r 3                     STA   CPU_IRQ_VECTOR+1
000BF7r 3                     PLP
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.IRQ_ENABLE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_irq_enable
000BF7r 3               ; @summary Enable one or more VGC IRQ source bits and enable maskable CPU IRQs.
000BF7r 3               ; @in A: VGC IRQ source mask.
000BF7r 3               vgc_irq_enable:
000BF7r 3                     ORA   VGC_IRQ_ENABLE
000BF7r 3                     STA   VGC_IRQ_ENABLE
000BF7r 3                     CLI
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.IRQ_DISABLE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_irq_disable
000BF7r 3               ; @summary Disable one or more VGC IRQ source bits.
000BF7r 3               ; @in A: VGC IRQ source mask.
000BF7r 3               vgc_irq_disable:
000BF7r 3                     EOR   #$FF
000BF7r 3                     AND   VGC_IRQ_ENABLE
000BF7r 3                     STA   VGC_IRQ_ENABLE
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.IRQ_ACK
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_irq_ack
000BF7r 3               ; @summary Acknowledge pending VGC IRQ source bits.
000BF7r 3               ; @in A: VGC IRQ source mask.
000BF7r 3               vgc_irq_ack:
000BF7r 3                     STA   VGC_IRQ_STATUS
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.LOCATE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_locate
000BF7r 3               ; @summary Set the text cursor position from VGC.P0/VGC.P1.
000BF7r 3               ; @in VGC_P0: Cursor X column.
000BF7r 3               ; @in VGC_P1: Cursor Y row.
000BF7r 3               vgc_locate:
000BF7r 3                     LDA   VGC_P0
000BF7r 3                     STA   VGC_CURSX
000BF7r 3                     LDA   VGC_P1
000BF7r 3                     STA   VGC_CURSY
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.SET_MODE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_set_mode
000BF7r 3               ; @summary Set the active VGC graphics/text mode.
000BF7r 3               ; @in X: Mode byte.
000BF7r 3               vgc_set_mode:
000BF7r 3                     STX   VGC_MODE
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.SET_FONT
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_set_font
000BF7r 3               ; @summary Select the active text font slot.
000BF7r 3               ; @in X: Font slot, 0..7.
000BF7r 3               vgc_set_font:
000BF7r 3                     STX   VGC_FONT
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.MEM_READ
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_mem_read
000BF7r 3               ; @summary Read one byte from VGC memory using VGC.P0..VGC.P4.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P4
000BF7r 3               ; @out VGC_P3: Read byte.
000BF7r 3               vgc_mem_read:
000BF7r 3                     LDA   #VCMD_MEMREAD
000BF7r 3                     .byte $2C
000BF7r 3               
000BF7r 3               ; @label VGC.MEM_WRITE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_mem_write
000BF7r 3               ; @summary Write one byte to VGC memory using VGC.P0..VGC.P4.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4
000BF7r 3               vgc_mem_write:
000BF7r 3                     LDA   #VCMD_MEMWRITE
000BF7r 3                     STA   VGC_CMD
000BF7r 3                     JMP   vgc_wait_cmd
000BF7r 3               
000BF7r 3               ; Enable reverse text by swapping the current foreground/background colours.
000BF7r 3               ; @label VGC.REVERSE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_reverse_default
000BF7r 3               ; @summary Enable reverse text using the current foreground/background colours.
000BF7r 3               vgc_reverse_default:
000BF7r 3                     LDA   VGC_TXTFLAGS
000BF7r 3                     AND   #$FC
000BF7r 3                     ORA   #VTXT_REV
000BF7r 3                     STA   VGC_TXTFLAGS
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; Input: A = packed reverse attribute, low nibble fg and high nibble bg.
000BF7r 3               ; @label VGC.REVERSE_EXPLICIT
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_reverse_explicit
000BF7r 3               ; @summary Enable reverse text with explicit packed foreground/background colours.
000BF7r 3               ; @in A: Packed reverse attribute, low nibble foreground and high nibble background.
000BF7r 3               vgc_reverse_explicit:
000BF7r 3                     STA   VGC_TXTREVATTR
000BF7r 3                     LDA   VGC_TXTFLAGS
000BF7r 3                     AND   #$FC
000BF7r 3                     ORA   #(VTXT_REV | VTXT_REVEX)
000BF7r 3                     STA   VGC_TXTFLAGS
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.REVERSE_OFF
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_reverse_off
000BF7r 3               ; @summary Disable reverse text.
000BF7r 3               vgc_reverse_off:
000BF7r 3                     LDA   VGC_TXTFLAGS
000BF7r 3                     AND   #$FC
000BF7r 3                     STA   VGC_TXTFLAGS
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.FLASH_ON
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_flash_on
000BF7r 3               ; @summary Enable flashing text.
000BF7r 3               vgc_flash_on:
000BF7r 3                     LDA   VGC_TXTFLAGS
000BF7r 3                     ORA   #VTXT_FLASH
000BF7r 3                     STA   VGC_TXTFLAGS
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label VGC.FLASH_OFF
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_flash_off
000BF7r 3               ; @summary Disable flashing text.
000BF7r 3               vgc_flash_off:
000BF7r 3                     LDA   VGC_TXTFLAGS
000BF7r 3                     AND   #$FB
000BF7r 3                     STA   VGC_TXTFLAGS
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               .ifndef VGC_NO_PRIMITIVES
000BF7r 3               ; @label VGC.GCLS
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_gcls
000BF7r 3               ; @summary Issue the VGC graphics clear command.
000BF7r 3               vgc_gcls:
000BF7r 3                     LDA   #VCMD_GCLS
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               
000BF7r 3               ; @label VGC.GCOLOR
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_gcolor
000BF7r 3               ; @summary Issue the VGC graphics colour command using VGC.P0.
000BF7r 3               ; @requires VGC_P0
000BF7r 3               vgc_gcolor:
000BF7r 3                     LDA   #VCMD_GCOLOR
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               
000BF7r 3               ; @label VGC.PLOT
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_plot
000BF7r 3               ; @summary Issue the VGC plot command using VGC.P0..VGC.P3.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000BF7r 3               vgc_plot:
000BF7r 3                     LDA   #VCMD_PLOT
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               
000BF7r 3               ; @label VGC.UNPLOT
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_unplot
000BF7r 3               ; @summary Issue the VGC unplot command using VGC.P0..VGC.P3.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000BF7r 3               vgc_unplot:
000BF7r 3                     LDA   #VCMD_UNPLOT
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               
000BF7r 3               ; @label VGC.LINE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_line
000BF7r 3               ; @summary Issue the VGC line command using VGC.P0..VGC.P7.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000BF7r 3               vgc_line:
000BF7r 3                     LDA   #VCMD_LINE
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               
000BF7r 3               ; @label VGC.CIRCLE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_circle
000BF7r 3               ; @summary Issue the VGC circle/ellipse command using VGC.P0..VGC.P7.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000BF7r 3               vgc_circle:
000BF7r 3                     LDA   #VCMD_CIRCLE
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               
000BF7r 3               ; @label VGC.GTEXT
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_gtext
000BF7r 3               ; @summary Issue the VGC graphics text command using VGC.P0..VGC.P5 and FIO.NAME.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 FIO_NAME FIO_NAMELEN
000BF7r 3               vgc_gtext:
000BF7r 3                     LDA   #VCMD_GTEXT
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               
000BF7r 3               ; @label VGC.RECT
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_rect
000BF7r 3               ; @summary Issue the VGC rectangle command using VGC.P0..VGC.P7.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000BF7r 3               vgc_rect:
000BF7r 3                     LDA   #VCMD_RECT
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               
000BF7r 3               ; @label VGC.FILL
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_fill
000BF7r 3               ; @summary Issue the VGC filled rectangle command using VGC.P0..VGC.P7.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000BF7r 3               vgc_fill:
000BF7r 3                     LDA   #VCMD_FILL
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               
000BF7r 3               ; @label VGC.PAINT
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol vgc_paint
000BF7r 3               ; @summary Issue the VGC paint command using VGC.P0..VGC.P3.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000BF7r 3               vgc_paint:
000BF7r 3                     LDA   #VCMD_PAINT
000BF7r 3                     JMP   vgc_cmd
000BF7r 3               .endif
000BF7r 3               
000BF7r 3               .endif
000BF7r 3               
000BF7r 2               .include "copper.s"
000BF7r 3               ; Shared Nova copper helper routines.
000BF7r 3               ;
000BF7r 3               ; Assembly ABI:
000BF7r 3               ;   copper_add expects VGC_P0/P1=x, VGC_P2=y, VGC_P3/P4=register/index,
000BF7r 3               ;   VGC_P5=value. COPPER_REG_* constants cover common VGC register indices.
000BF7r 3               
000BF7r 3               .include "copper.inc"
000BF7r 4               ; Shared Nova copper helper declarations.
000BF7r 4               
000BF7r 4               .ifndef COPPER_INC_INCLUDED
000BF7r 4               COPPER_INC_INCLUDED = 1
000BF7r 4               
000BF7r 4               .include "vgc.inc"
000BF7r 4               
000BF7r 4               COPPER_RESULT_OK    = $00
000BF7r 4               COPPER_RESULT_ERROR = $01
000BF7r 4               
000BF7r 4               COPPER_REG_MODE     = $00
000BF7r 4               COPPER_REG_BGCOL    = $01
000BF7r 4               COPPER_REG_SCROLLX  = $05
000BF7r 4               COPPER_REG_SCROLLY  = $06
000BF7r 4               
000BF7r 4               .endif
000BF7r 4               
000BF7r 3               
000BF7r 3               .ifndef COPPER_IMPLEMENTATION_INCLUDED
000BF7r 3               COPPER_IMPLEMENTATION_INCLUDED = 1
000BF7r 3               
000BF7r 3                     .segment "CODE"
000BF7r 3               
000BF7r 3                     .export copper_command
000BF7r 3                     .export copper_clear
000BF7r 3                     .export copper_on
000BF7r 3                     .export copper_off
000BF7r 3                     .export copper_list
000BF7r 3                     .export copper_list_end
000BF7r 3                     .export copper_use
000BF7r 3                     .export copper_add
000BF7r 3                     .export copper_set_reg_index
000BF7r 3                     .export copper_set_sprite_reg
000BF7r 3               
000BF7r 3               ; Input: A = copper VGC command. Does not wait for completion.
000BF7r 3               ; @label COPPER.COMMAND
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_command
000BF7r 3               ; @summary Issue a raw copper VGC command.
000BF7r 3               ; @in A: Copper VGC command byte.
000BF7r 3               copper_command:
000BF7r 3                     STA   VGC_CMD
000BF7r 3                     LDA   #COPPER_RESULT_OK
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; @label COPPER.CLEAR
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_clear
000BF7r 3               ; @summary Clear the active copper list.
000BF7r 3               copper_clear:
000BF7r 3                     LDA   #VCMD_COPPERCLR
000BF7r 3                     JMP   copper_command
000BF7r 3               
000BF7r 3               ; @label COPPER.ON
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_on
000BF7r 3               ; @summary Enable copper execution.
000BF7r 3               copper_on:
000BF7r 3                     LDA   #VCMD_COPPERENA
000BF7r 3                     JMP   copper_command
000BF7r 3               
000BF7r 3               ; @label COPPER.OFF
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_off
000BF7r 3               ; @summary Disable copper execution.
000BF7r 3               copper_off:
000BF7r 3                     LDA   #VCMD_COPPERDIS
000BF7r 3                     JMP   copper_command
000BF7r 3               
000BF7r 3               ; @label COPPER.LIST
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_list
000BF7r 3               ; @summary Select a copper list using VGC.P0.
000BF7r 3               ; @requires VGC_P0
000BF7r 3               copper_list:
000BF7r 3                     LDA   #VCMD_COPPERLIST
000BF7r 3                     JMP   copper_command
000BF7r 3               
000BF7r 3               ; @label COPPER.LIST_END
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_list_end
000BF7r 3               ; @summary Finish the current copper list.
000BF7r 3               copper_list_end:
000BF7r 3                     LDA   #VCMD_COPPEREND
000BF7r 3                     JMP   copper_command
000BF7r 3               
000BF7r 3               ; @label COPPER.USE
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_use
000BF7r 3               ; @summary Activate a copper list using VGC.P0.
000BF7r 3               ; @requires VGC_P0
000BF7r 3               copper_use:
000BF7r 3                     LDA   #VCMD_COPPERUSE
000BF7r 3                     JMP   copper_command
000BF7r 3               
000BF7r 3               ; @label COPPER.ADD
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_add
000BF7r 3               ; @summary Add a copper operation using VGC.P0..VGC.P5.
000BF7r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5
000BF7r 3               copper_add:
000BF7r 3                     LDA   #VCMD_COPPERADD
000BF7r 3                     JMP   copper_command
000BF7r 3               
000BF7r 3               ; Input: A = direct VGC register index. Output: VGC_P3/P4 updated.
000BF7r 3               ; @label COPPER.SET_REG_INDEX
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_set_reg_index
000BF7r 3               ; @summary Set VGC.P3/P4 to a direct VGC register index.
000BF7r 3               ; @in A: VGC register index.
000BF7r 3               copper_set_reg_index:
000BF7r 3                     STA   VGC_P3
000BF7r 3                     STZ   VGC_P4
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               ; Input: X = sprite index, A = VGC_SPR_*_OFF field.
000BF7r 3               ; Output: VGC_P3/P4 = absolute sprite register address.
000BF7r 3               ; Clobbers: A, NVR7L.
000BF7r 3               ; @label COPPER.SET_SPRITE_REG
000BF7r 3               ; @kind routine
000BF7r 3               ; @symbol copper_set_sprite_reg
000BF7r 3               ; @summary Set VGC.P3/P4 to a sprite attribute register address.
000BF7r 3               ; @in X: Sprite index.
000BF7r 3               ; @in A: Sprite field offset.
000BF7r 3               copper_set_sprite_reg:
000BF7r 3                     STA   NVR7L
000BF7r 3                     TXA
000BF7r 3                     ASL
000BF7r 3                     ASL
000BF7r 3                     ASL
000BF7r 3                     CLC
000BF7r 3                     ADC   NVR7L
000BF7r 3                     CLC
000BF7r 3                     ADC   #<VGC_SPR_BASE
000BF7r 3                     STA   VGC_P3
000BF7r 3                     LDA   #>VGC_SPR_BASE
000BF7r 3                     ADC   #$00
000BF7r 3                     STA   VGC_P4
000BF7r 3                     RTS
000BF7r 3               
000BF7r 3               .endif
000BF7r 3               
000BF7r 2               
000BF7r 2               .ifndef COPPER_SPLIT_IMPLEMENTATION_INCLUDED
000BF7r 2               COPPER_SPLIT_IMPLEMENTATION_INCLUDED = 1
000BF7r 2               
000BF7r 2                     .segment "CODE"
000BF7r 2               
000BF7r 2                     .export copper_split_mode
000BF7r 2               
000BF7r 2               ; Configure one copper list with two VGC_MODE rules:
000BF7r 2               ;   line 0       -> VGC_P2 mode
000BF7r 2               ;   VGC_P1 line -> VGC_P3 mode
000BF7r 2               ; Clobbers A and NVR4L..NVR5H.
000BF7r 2               copper_split_mode:
000BF7r 2  AD 11 A0           LDA   VGC_P0
000BFAr 2  85 28              STA   NVR4L
000BFCr 2  AD 12 A0           LDA   VGC_P1
000BFFr 2  85 29              STA   NVR4H
000C01r 2  AD 13 A0           LDA   VGC_P2
000C04r 2  85 2A              STA   NVR5L
000C06r 2  AD 14 A0           LDA   VGC_P3
000C09r 2  85 2B              STA   NVR5H
000C0Br 2               
000C0Br 2  20 rr rr           JSR   vgc_wait_cmd
000C0Er 2  20 rr rr           JSR   copper_off
000C11r 2               
000C11r 2  20 rr rr           JSR   vgc_wait_cmd
000C14r 2  A5 28              LDA   NVR4L
000C16r 2  8D 11 A0           STA   VGC_P0
000C19r 2  20 rr rr           JSR   copper_list
000C1Cr 2               
000C1Cr 2  20 rr rr           JSR   vgc_wait_cmd
000C1Fr 2  20 rr rr           JSR   copper_clear
000C22r 2               
000C22r 2  9C 11 A0           STZ   VGC_P0
000C25r 2  9C 12 A0           STZ   VGC_P1
000C28r 2  9C 13 A0           STZ   VGC_P2
000C2Br 2  A9 00              LDA   #COPPER_REG_MODE
000C2Dr 2  20 rr rr           JSR   copper_set_reg_index
000C30r 2  A5 2A              LDA   NVR5L
000C32r 2  8D 16 A0           STA   VGC_P5
000C35r 2  20 rr rr           JSR   vgc_wait_cmd
000C38r 2  20 rr rr           JSR   copper_add
000C3Br 2               
000C3Br 2  9C 11 A0           STZ   VGC_P0
000C3Er 2  9C 12 A0           STZ   VGC_P1
000C41r 2  A5 29              LDA   NVR4H
000C43r 2  8D 13 A0           STA   VGC_P2
000C46r 2  A9 00              LDA   #COPPER_REG_MODE
000C48r 2  20 rr rr           JSR   copper_set_reg_index
000C4Br 2  A5 2B              LDA   NVR5H
000C4Dr 2  8D 16 A0           STA   VGC_P5
000C50r 2  20 rr rr           JSR   vgc_wait_cmd
000C53r 2  20 rr rr           JSR   copper_add
000C56r 2               
000C56r 2  20 rr rr           JSR   vgc_wait_cmd
000C59r 2  A5 28              LDA   NVR4L
000C5Br 2  8D 11 A0           STA   VGC_P0
000C5Er 2  20 rr rr           JSR   copper_use
000C61r 2               
000C61r 2  20 rr rr           JSR   vgc_wait_cmd
000C64r 2  20 rr rr           JSR   copper_on
000C67r 2  A9 00              LDA   #COPPER_SPLIT_RESULT_OK
000C69r 2  60                 RTS
000C6Ar 2               
000C6Ar 2               .endif
000C6Ar 2               
000C6Ar 1                     .include "vsprite.s"
000C6Ar 2               ; Shared Nova virtual-sprite helper routines.
000C6Ar 2               ;
000C6Ar 2               ; The helpers intentionally expose a small blitter-shaped ABI. Runtimes can use
000C6Ar 2               ; them for games, cursors, software sprites, board pieces, and any other
000C6Ar 2               ; rectangular graphic that should not consume scarce hardware sprite slots.
000C6Ar 2               ;
000C6Ar 2               ; Moving virtual sprites should use the saved-background helpers instead of
000C6Ar 2               ; redrawing their whole scene every frame. Save the graphics-plane rectangle
000C6Ar 2               ; under the object, draw the object, restore the saved rectangle before moving,
000C6Ar 2               ; then repeat at the new position.
000C6Ar 2               
000C6Ar 2               .include "vsprite.inc"
000C6Ar 3               ; Shared Nova virtual-sprite helper declarations.
000C6Ar 3               ;
000C6Ar 3               ; A virtual sprite is a caller-owned rectangular pixel stamp copied by the
000C6Ar 3               ; blitter into a VGC memory space. Unlike hardware sprites, the count is limited
000C6Ar 3               ; by memory and redraw cost rather than VGC sprite registers.
000C6Ar 3               ;
000C6Ar 3               ; Transparency is split into two explicit layers:
000C6Ar 3               ; - VSPRITE_COLORKEY controls which source byte VSPRITE.BLIT skips.
000C6Ar 3               ; - VGC_GFXTRANS controls which color in the VGC graphics plane is transparent
000C6Ar 3               ;   during final display composition.
000C6Ar 3               ;
000C6Ar 3               ; The default for both is 0. If a runtime needs visible black graphics-plane
000C6Ar 3               ; pixels, choose another unused color as the transparent color, store it in
000C6Ar 3               ; VGC_GFXTRANS, write that value into transparent source pixels, and set
000C6Ar 3               ; VSPRITE_COLORKEY to the same value before a color-keyed blit.
000C6Ar 3               ;
000C6Ar 3               ; For moving objects, use the graphics-plane saved-background helpers in the
000C6Ar 3               ; same style as an Amiga BOB:
000C6Ar 3               ; 1. Set VSPRITE.X/Y, VSPRITE.WIDTH/HEIGHT, and VSPRITE.BG* to caller-owned RAM.
000C6Ar 3               ; 2. Call VSPRITE.GFX_SAVE_BG before drawing the object.
000C6Ar 3               ; 3. Draw with VSPRITE.GFX_BLIT.
000C6Ar 3               ; 4. Before the next frame, call VSPRITE.GFX_RESTORE_BG at the saved X/Y, move
000C6Ar 3               ;    the object, save the new background, and draw again.
000C6Ar 3               ; Static objects that were not first drawn with a saved background must be
000C6Ar 3               ; erased by the caller before entering this loop.
000C6Ar 3               ;
000C6Ar 3               ; For multiple moving virtual sprites, use the scene helpers instead of calling
000C6Ar 3               ; the single-sprite save/restore loop for each object. A scene descriptor list
000C6Ar 3               ; restores every old background first, lets the caller update positions, saves
000C6Ar 3               ; every new background from the clean playfield, then draws the list in order.
000C6Ar 3               ; List order is z-order: later descriptors draw in front of earlier ones.
000C6Ar 3               ;
000C6Ar 3               ; For scenes where multiple virtual sprites overlap or cross paths, use
000C6Ar 3               ; VSPRITE.SCENE_COMMIT_ATOMIC. The caller supplies a dirty graphics rectangle
000C6Ar 3               ; and a work buffer. The helper composes the clean old backgrounds and new
000C6Ar 3               ; sprites into that offscreen buffer, then copies the completed rectangle to
000C6Ar 3               ; the graphics plane as one visible blit. For a truly atomic visual update, the
000C6Ar 3               ; final dirty rectangle must be small enough to fit in one vblank window.
000C6Ar 3               ;
000C6Ar 3               ; For in-place rotated virtual sprites on the transparent graphics plane, use
000C6Ar 3               ; VSPRITE.GFX_ROTATE_BLIT. It rotates into VSPRITE.ROT* offscreen, then copies
000C6Ar 3               ; the full rotated rectangle to graphics memory in one blit so old pixels are
000C6Ar 3               ; cleared without a separate visible erase.
000C6Ar 3               
000C6Ar 3               .ifndef VSPRITE_INC_INCLUDED
000C6Ar 3               VSPRITE_INC_INCLUDED = 1
000C6Ar 3               
000C6Ar 3               .include "blitter.inc"
000C6Ar 3               .include "nova.inc"
000C6Ar 3               
000C6Ar 3               VSPRITE_RESULT_OK        = BLITTER_RESULT_OK
000C6Ar 3               VSPRITE_RESULT_ERROR     = BLITTER_RESULT_ERROR
000C6Ar 3               
000C6Ar 3               ; @label VSPRITE.FLAG_COLORKEY
000C6Ar 3               ; @kind const
000C6Ar 3               ; @symbol VSPRITE_FLAG_COLORKEY
000C6Ar 3               ; @summary Enable source color-key transparency for VSPRITE.BLIT and VSPRITE.GFX_BLIT.
000C6Ar 3               VSPRITE_FLAG_COLORKEY    = $01
000C6Ar 3               
000C6Ar 3               ; @label VSPRITE.DESC_FLAG_COLORKEY
000C6Ar 3               ; @kind const
000C6Ar 3               ; @symbol VSPRITE_DESC_FLAG_COLORKEY
000C6Ar 3               ; @summary Descriptor flag enabling source color-key transparency.
000C6Ar 3               VSPRITE_DESC_FLAG_COLORKEY = VSPRITE_FLAG_COLORKEY
000C6Ar 3               
000C6Ar 3               ; @label VSPRITE.DESC_SAVED
000C6Ar 3               ; @kind const
000C6Ar 3               ; @symbol VSPRITE_DESC_SAVED
000C6Ar 3               ; @summary Internal descriptor flag set when old X/Y has a saved background to restore.
000C6Ar 3               VSPRITE_DESC_SAVED       = $40
000C6Ar 3               
000C6Ar 3               ; @label VSPRITE.DESC_VISIBLE
000C6Ar 3               ; @kind const
000C6Ar 3               ; @symbol VSPRITE_DESC_VISIBLE
000C6Ar 3               ; @summary Descriptor flag enabling scene save/draw for this virtual sprite.
000C6Ar 3               VSPRITE_DESC_VISIBLE     = $80
000C6Ar 3               
000C6Ar 3               VSPRITE_GFX_STRIDE       = 320
000C6Ar 3               
000C6Ar 3               ; Scene descriptor layout. Descriptors are caller-owned RAM because scene
000C6Ar 3               ; helpers update OLD_* and SAVED as part of the frame protocol.
000C6Ar 3               VSPRITE_DESC_FLAGS       = $00
000C6Ar 3               VSPRITE_DESC_XL          = $01
000C6Ar 3               VSPRITE_DESC_XH          = $02
000C6Ar 3               VSPRITE_DESC_Y           = $03
000C6Ar 3               VSPRITE_DESC_OLD_XL      = $04
000C6Ar 3               VSPRITE_DESC_OLD_XH      = $05
000C6Ar 3               VSPRITE_DESC_OLD_Y       = $06
000C6Ar 3               VSPRITE_DESC_WIDTHL      = $07
000C6Ar 3               VSPRITE_DESC_WIDTHH      = $08
000C6Ar 3               VSPRITE_DESC_HEIGHTL     = $09
000C6Ar 3               VSPRITE_DESC_HEIGHTH     = $0A
000C6Ar 3               VSPRITE_DESC_SRCSPACE    = $0B
000C6Ar 3               VSPRITE_DESC_SRCADDRL    = $0C
000C6Ar 3               VSPRITE_DESC_SRCADDRM    = $0D
000C6Ar 3               VSPRITE_DESC_SRCADDRH    = $0E
000C6Ar 3               VSPRITE_DESC_SRCSTRL     = $0F
000C6Ar 3               VSPRITE_DESC_SRCSTRH     = $10
000C6Ar 3               VSPRITE_DESC_BGSPACE     = $11
000C6Ar 3               VSPRITE_DESC_BGADDRL     = $12
000C6Ar 3               VSPRITE_DESC_BGADDRM     = $13
000C6Ar 3               VSPRITE_DESC_BGADDRH     = $14
000C6Ar 3               VSPRITE_DESC_BGSTRL      = $15
000C6Ar 3               VSPRITE_DESC_BGSTRH      = $16
000C6Ar 3               VSPRITE_DESC_COLORKEY    = $17
000C6Ar 3               VSPRITE_DESC_SIZE        = $18
000C6Ar 3               
000C6Ar 3               ; Assembly-facing state ABI. Callers set these before invoking the helpers.
000C6Ar 3               ; @label VSPRITE.SRCSPACE
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_SRCSPACE
000C6Ar 3               ; @summary Blitter memory space for the virtual-sprite source rectangle.
000C6Ar 3               .global VSPRITE_SRCSPACE
000C6Ar 3               ; @label VSPRITE.DSTSPACE
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_DSTSPACE
000C6Ar 3               ; @summary Blitter memory space for the virtual-sprite destination rectangle.
000C6Ar 3               .global VSPRITE_DSTSPACE
000C6Ar 3               ; @label VSPRITE.SRCADDRL
