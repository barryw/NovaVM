000000r 1                     .include "copper.inc"
000000r 2               ; Shared Nova copper helper declarations.
000000r 2               
000000r 2               .ifndef COPPER_INC_INCLUDED
000000r 2               COPPER_INC_INCLUDED = 1
000000r 2               
000000r 2               .include "vgc.inc"
000000r 3               ; Shared Nova VGC helper declarations.
000000r 3               ;
000000r 3               ; The command helpers use the VGC hardware parameter registers directly:
000000r 3               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
000000r 3               ; Routines return through the hardware status model; command completion can be
000000r 3               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
000000r 3               
