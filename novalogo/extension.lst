000297r 3               EDITUI_KEY_RIGHT     = $1D
000297r 3               EDITUI_KEY_UP        = $1E
000297r 3               EDITUI_KEY_DOWN      = $1F
000297r 3               EDITUI_KEY_DELETE    = $7F
000297r 3               EDITUI_KEY_ALT_PREFIX = EDITUI_KEY_ESC
000297r 3               
000297r 3               EDITUI_KEY_CTRL_A    = $01
000297r 3               EDITUI_KEY_CTRL_C    = $03
