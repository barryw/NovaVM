000E87r 2  B0 31              BCS   @done
000E89r 2  AD rr rr           LDA   EDITUI_MENU_SAVE_H
000E8Cr 2  F0 2C              BEQ   @done
000E8Er 2  C9 11              CMP   #EDITUI_MENU_SAVE_MAX_H + 1
000E90r 2  B0 28              BCS   @done
000E92r 2  20 rr rr           JSR   editui_menu_select_saved_region
000E95r 2  D0 23              BNE   @done
000E97r 2  20 rr rr           JSR   vtext_calc_region_addr
