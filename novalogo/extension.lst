002592r 2                     ; count = end - start
002592r 2  38                 SEC
002593r 2  AD rr rr           LDA   EB_SELENDL
002596r 2  ED rr rr           SBC   EB_SELSTARTL
002599r 2  85 rr              STA   EDITBUF_CNTL
00259Br 2  AD rr rr           LDA   EB_SELENDH
00259Er 2  ED rr rr           SBC   EB_SELSTARTH
