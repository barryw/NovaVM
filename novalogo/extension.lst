000297r 2               .include "editui.inc"
000297r 3               ; Shared Nova editor-shell UI declarations.
000297r 3               ;
000297r 3               ; EDITUI is a small text-mode shell for native tools: menu bar, title/help
000297r 3               ; rows, framed panels, and status lines. Applications own input dispatch,
000297r 3               ; document state, and editor-specific drawing.
000297r 3               
000297r 3               .ifndef EDITUI_INC_INCLUDED
000297r 3               EDITUI_INC_INCLUDED = 1
000297r 3               
000297r 3               .include "vtext.inc"
000297r 3               
000297r 3               EDITUI_OK  = $00
000297r 3               EDITUI_ERR = $01
000297r 3               
000297r 3               EDITUI_SCREEN_COLS = VTEXT_SCREEN_COLS
000297r 3               EDITUI_SCREEN_ROWS = VTEXT_SCREEN_ROWS
000297r 3               
000297r 3               ; Black background with light-grey bars. bg = high nibble, fg = low nibble.
000297r 3               ; Palette mode 0: 0=black, 1=white, 2=red, 12=grey-med, 15=grey-light.
000297r 3               EDITUI_PALETTE_MODE     = $00
000297r 3               EDITUI_COLOR_BG         = $00      ; black
000297r 3               EDITUI_COLOR_FG         = $01      ; white
000297r 3               EDITUI_COLOR_SHELL      = $0F      ; editor background (black bg)
000297r 3               EDITUI_COLOR_TITLE      = $01      ; title text: white on black
000297r 3               EDITUI_COLOR_MENU       = $F0      ; light-grey menu bar, black text
000297r 3               EDITUI_COLOR_MENU_HOT   = $F2      ; light-grey bar, red hotkey
000297r 3               EDITUI_COLOR_FRAME      = $0F      ; grey frame lines on black
000297r 3               EDITUI_COLOR_DIM        = $0C      ; grey-med dim text on black
000297r 3               EDITUI_COLOR_MENU_SEL   = $1F      ; selected dropdown item: white bg
000297r 3               EDITUI_COLOR_MENU_SEL_HOT = $12    ; selected item hotkey
000297r 3               EDITUI_COLOR_STATUS     = $F0      ; light-grey status bar
000297r 3               EDITUI_COLOR_STATUS_HOT = $F6      ; status bar accent
000297r 3               EDITUI_COLOR_PANEL      = $0F      ; dialog panel: black bg
000297r 3               
000297r 3               EDITUI_STATUS_ROW = EDITUI_SCREEN_ROWS - 1
000297r 3               ; Dirty marker ('*') cell on the menu bar (right side). The title is drawn just
000297r 3               ; to its left; toggling the marker is a single-cell write.
000297r 3               EDITUI_DIRTY_COL  = EDITUI_SCREEN_COLS - 2
000297r 3               
000297r 3               EDITUI_BOX_SINGLE = $00
000297r 3               EDITUI_BOX_DOUBLE = $01
000297r 3               
000297r 3               ; CP437 box-drawing characters from Nova's default font.
000297r 3               EDITUI_CH_SINGLE_TL = $DA
000297r 3               EDITUI_CH_SINGLE_TR = $BF
000297r 3               EDITUI_CH_SINGLE_BL = $C0
000297r 3               EDITUI_CH_SINGLE_BR = $D9
000297r 3               EDITUI_CH_SINGLE_H  = $C4
000297r 3               EDITUI_CH_SINGLE_V  = $B3
000297r 3               EDITUI_CH_SINGLE_TITLE_L = $B4
000297r 3               EDITUI_CH_SINGLE_TITLE_R = $C3
000297r 3               EDITUI_CH_DOUBLE_TL = $C9
000297r 3               EDITUI_CH_DOUBLE_TR = $BB
000297r 3               EDITUI_CH_DOUBLE_BL = $C8
000297r 3               EDITUI_CH_DOUBLE_BR = $BC
000297r 3               EDITUI_CH_DOUBLE_H  = $CD
000297r 3               EDITUI_CH_DOUBLE_V  = $BA
000297r 3               EDITUI_CH_DOUBLE_TITLE_L = $B9
000297r 3               EDITUI_CH_DOUBLE_TITLE_R = $CC
000297r 3               EDITUI_CH_DOT       = $FA
000297r 3               
000297r 3               EDITUI_KEY_BACKSPACE = $08
000297r 3               EDITUI_KEY_TAB       = $09
000297r 3               EDITUI_KEY_ENTER     = $0D
000297r 3               EDITUI_KEY_ESC       = $1B
