001F57r 2                     ; fall through
001F57r 2               
001F57r 2               ; editui_save_under — capture the three text planes under the rectangle in
001F57r 2               ; EDITUI_MENU_SAVE_X/Y/W/H into the save buffers; sets EDITUI_MENU_SAVE_VALID.
001F57r 2               ; Reusable by dialogs and any overlapping overlay, not just menus.
001F57r 2               editui_save_under:
001F57r 2  9C rr rr           STZ   EDITUI_MENU_SAVE_VALID
001F5Ar 2  AD rr rr           LDA   EDITUI_MENU_SAVE_W
001F5Dr 2  F0 35              BEQ   @done
