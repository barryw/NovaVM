000E63r 2               editui_menu_save_under:
000E63r 2                     ; Derive the save rectangle from the active dropdown, then capture it
000E63r 2                     ; through the generic save-under path.
000E63r 2  AD rr rr           LDA   EDITUI_MENU_WIDTH
000E66r 2  8D rr rr           STA   EDITUI_MENU_SAVE_W
000E69r 2  AD rr rr           LDA   EDITUI_MENU_ITEM_COUNT
