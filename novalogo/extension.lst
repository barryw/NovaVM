000C6Ar 3               .global VSPRITE_SCENE_WORKSTRH
000C6Ar 3               
000C6Ar 3               ; Public helper routines.
000C6Ar 3               .global vsprite_blit
000C6Ar 3               .global vsprite_blit_start
000C6Ar 3               .global vsprite_fill
000C6Ar 3               .global vsprite_gfx_addr
000C6Ar 3               .global vsprite_gfx_blit
000C6Ar 3               .global vsprite_gfx_blit_start
000C6Ar 3               .global vsprite_gfx_rotate_blit
000C6Ar 3               .global vsprite_gfx_rotate_blit_keyed
000C6Ar 3               .global vsprite_gfx_rotate_blit_nowait
