000092r 3               EDITUI_CMD_CLOSE     = $0A
000092r 3               EDITUI_CMD_HELP      = $0B
000092r 3               EDITUI_CMD_ABOUT     = $0C
000092r 3               
000092r 3               EDITUI_MENU_ENTRY_SIZE = 6
000092r 3               EDITUI_MENU_ITEM_SIZE  = 4
000092r 3               
000092r 3               .global EDITUI_TITLEL
000092r 3               .global EDITUI_TITLEH
000092r 3               .global EDITUI_MENUL
000092r 3               .global EDITUI_MENUH
000092r 3               .global EDITUI_MENUSL
000092r 3               .global EDITUI_MENUSH
000092r 3               .global EDITUI_HELPL
000092r 3               .global EDITUI_HELPH
000092r 3               .global EDITUI_STATUSL
000092r 3               .global EDITUI_STATUSH
000092r 3               .global EDITUI_DIRTY
000092r 3               .global EDITUI_BOXX
000092r 3               .global EDITUI_BOXY
000092r 3               .global EDITUI_BOXW
