000297r 4               
000297r 4                     .segment "CODE"
000297r 4               
000297r 4                     .export blitter_copy
000297r 4                     .export blitter_fill
000297r 4                     .export blitter_start_copy
000297r 4                     .export blitter_start_fill
000297r 4                     .export blitter_wait
000297r 4               
000297r 4               ; @label BLITTER.COPY
000297r 4               ; @kind routine
000297r 4               ; @symbol blitter_copy
000297r 4               ; @summary Start a rectangular blitter copy using the BLT controller registers.
000297r 4               ; @requires BLT_SRCSPACE BLT_DSTSPACE BLT_SRCL BLT_SRCM BLT_SRCH BLT_DSTL BLT_DSTM BLT_DSTH BLT_WIDTHL BLT_WIDTHH BLT_HEIGHTL BLT_HEIGHTH BLT_SRCSTRL BLT_SRCSTRH BLT_DSTSTRL BLT_DSTSTRH
000297r 4               ; @out A: 0 on success, 1 on error.
000297r 4               blitter_copy:
000297r 4  4C rr rr           JMP   blitter_start_copy
00029Ar 4               
00029Ar 4               ; @label BLITTER.FILL
00029Ar 4               ; @kind routine
00029Ar 4               ; @symbol blitter_fill
00029Ar 4               ; @summary Start a rectangular blitter fill using destination, size, stride, and fill registers.
00029Ar 4               ; @requires BLT_DSTSPACE BLT_DSTL BLT_DSTM BLT_DSTH BLT_WIDTHL BLT_WIDTHH BLT_HEIGHTL BLT_HEIGHTH BLT_DSTSTRL BLT_DSTSTRH BLT_FILLVALUE
00029Ar 4               ; @out A: 0 on success, 1 on error.
00029Ar 4               blitter_fill:
00029Ar 4  9C 86 BA           STZ   BLT_SRCSPACE
00029Dr 4  9C 88 BA           STZ   BLT_SRCL
0002A0r 4  9C 89 BA           STZ   BLT_SRCM
0002A3r 4  9C 8A BA           STZ   BLT_SRCH
0002A6r 4  9C 92 BA           STZ   BLT_SRCSTRL
0002A9r 4  9C 93 BA           STZ   BLT_SRCSTRH
0002ACr 4  9C 98 BA           STZ   BLT_CKEY
0002AFr 4  4C rr rr           JMP   blitter_start_fill
0002B2r 4               
0002B2r 4               ; @label BLITTER.START_COPY
0002B2r 4               ; @kind routine
0002B2r 4               ; @symbol blitter_start_copy
0002B2r 4               ; @summary Low-level blitter copy start. Call BLITTER.COPY for the public wrapper.
0002B2r 4               ; @out A: 0 on success, 1 on error.
0002B2r 4               blitter_start_copy:
0002B2r 4  9C 96 BA           STZ   BLT_MODE_REG
0002B5r 4  9C 98 BA           STZ   BLT_CKEY
0002B8r 4  A9 01              LDA   #BLT_CMD_START
0002BAr 4  8D 83 BA           STA   BLT_CMD_REG
0002BDr 4  4C rr rr           JMP   blitter_wait
0002C0r 4               
0002C0r 4               ; @label BLITTER.START_FILL
0002C0r 4               ; @kind routine
0002C0r 4               ; @symbol blitter_start_fill
0002C0r 4               ; @summary Low-level blitter fill start. Call BLITTER.FILL for the public wrapper.
0002C0r 4               ; @out A: 0 on success, 1 on error.
0002C0r 4               blitter_start_fill:
0002C0r 4  A9 01              LDA   #BLT_MODE_FILL
0002C2r 4  8D 96 BA           STA   BLT_MODE_REG
0002C5r 4  A9 01              LDA   #BLT_CMD_START
0002C7r 4  8D 83 BA           STA   BLT_CMD_REG
0002CAr 4  4C rr rr           JMP   blitter_wait
0002CDr 4               
0002CDr 4               ; @label BLITTER.WAIT
0002CDr 4               ; @kind routine
0002CDr 4               ; @symbol blitter_wait
0002CDr 4               ; @summary Wait for the blitter controller to leave BUSY and return shared status.
0002CDr 4               ; @out A: 0 on success, 1 on error.
0002CDr 4               blitter_wait:
0002CDr 4               @loop:
0002CDr 4  AD 84 BA           LDA   BLT_STATUS_REG
0002D0r 4  C9 01              CMP   #BLT_STATUS_BUSY
0002D2r 4  F0 F9              BEQ   @loop
0002D4r 4  C9 02              CMP   #BLT_STATUS_OK
0002D6r 4  F0 03              BEQ   @ok
0002D8r 4  A9 01              LDA   #BLITTER_RESULT_ERROR
0002DAr 4  60                 RTS
0002DBr 4               @ok:
0002DBr 4  A9 00              LDA   #BLITTER_RESULT_OK
0002DDr 4  60                 RTS
0002DEr 4               
0002DEr 4               .endif
0002DEr 4               
0002DEr 3               
0002DEr 3               .ifndef VTEXT_IMPLEMENTATION_INCLUDED
0002DEr 3               VTEXT_IMPLEMENTATION_INCLUDED = 1
0002DEr 3               
0002DEr 3                     .segment "BSS"
000009r 3               
000009r 3  xx           VTEXT_LEFT:       .res 1
00000Ar 3  xx           VTEXT_TOP:        .res 1
00000Br 3  xx           VTEXT_WIDTH:      .res 1
00000Cr 3  xx           VTEXT_HEIGHT:     .res 1
00000Dr 3  xx           VTEXT_CURX:       .res 1
00000Er 3  xx           VTEXT_CURY:       .res 1
00000Fr 3  xx           VTEXT_COLOR:      .res 1
000010r 3  xx           VTEXT_ATTR:       .res 1
000011r 3  xx           VTEXT_CHAR:       .res 1
000012r 3  xx           VTEXT_FLAGS:      .res 1
000013r 3  xx           VTEXT_TABLEL:     .res 1
000014r 3  xx           VTEXT_TABLEH:     .res 1
000015r 3  xx           VTEXT_REGION_ID:  .res 1
000016r 3               
000016r 3                     .segment "ZEROPAGE"
000000r 3               
000000r 3  xx           VTEXT_ADDRL:      .res 1
000001r 3  xx           VTEXT_ADDRH:      .res 1
000002r 3  xx           VTEXT_TMP:        .res 1
000003r 3  xx           VTEXT_STRL:       .res 1
000004r 3  xx           VTEXT_STRH:       .res 1
000005r 3               
000005r 3                     .segment "CODE"
0002DEr 3               
0002DEr 3                     .export vtext_define_region
0002DEr 3                     .export vtext_select_region
0002DEr 3                     .export vtext_store_region
0002DEr 3                     .export vtext_validate_region
0002DEr 3                     .export vtext_set_cursor
0002DEr 3                     .export vtext_sync_cursor
0002DEr 3                     .export vtext_home
0002DEr 3                     .export vtext_put_char
0002DEr 3                     .export vtext_puts
0002DEr 3                     .export vtext_put_hex_nibble
0002DEr 3                     .export vtext_put_hex_byte
0002DEr 3                     .export vtext_newline
0002DEr 3                     .export vtext_clear_region
0002DEr 3                     .export vtext_clear_line
0002DEr 3                     .export vtext_scroll_up
0002DEr 3                     .export vtext_wait_blitter
0002DEr 3               
0002DEr 3               vtext_ok:
0002DEr 3  A9 00              LDA   #VTEXT_OK
0002E0r 3  60                 RTS
0002E1r 3               
0002E1r 3               vtext_err:
0002E1r 3  A9 01              LDA   #VTEXT_ERR
0002E3r 3  60                 RTS
0002E4r 3               
0002E4r 3               ; ---------------------------------------------------------------------
0002E4r 3               ; Optional region-table helpers
0002E4r 3               ; ---------------------------------------------------------------------
0002E4r 3               vtext_region_slot:
0002E4r 3  AD rr rr           LDA   VTEXT_TABLEL
0002E7r 3  85 rr              STA   VTEXT_ADDRL
0002E9r 3  AD rr rr           LDA   VTEXT_TABLEH
0002ECr 3  85 rr              STA   VTEXT_ADDRH
0002EEr 3               
0002EEr 3  AD rr rr           LDA   VTEXT_REGION_ID
0002F1r 3  0A                 ASL
0002F2r 3  85 rr              STA   VTEXT_TMP          ; id * 2
0002F4r 3  0A                 ASL
0002F5r 3  0A                 ASL                      ; id * 8
0002F6r 3  18                 CLC
0002F7r 3  65 rr              ADC   VTEXT_TMP          ; id * 10
0002F9r 3  18                 CLC
0002FAr 3  65 rr              ADC   VTEXT_ADDRL
0002FCr 3  85 rr              STA   VTEXT_ADDRL
0002FEr 3  90 02              BCC   @done
000300r 3  E6 rr              INC   VTEXT_ADDRH
000302r 3               @done:
000302r 3  60                 RTS
000303r 3               
000303r 3               vtext_define_region:
000303r 3  20 rr rr           JSR   vtext_validate_region
000306r 3  D0 41              BNE   @done
000308r 3  20 rr rr           JSR   vtext_region_slot
00030Br 3  A0 00              LDY   #VTEXT_REGION_LEFT
00030Dr 3  AD rr rr           LDA   VTEXT_LEFT
000310r 3  91 rr              STA   (VTEXT_ADDRL),Y
000312r 3  C8                 INY
000313r 3  AD rr rr           LDA   VTEXT_TOP
000316r 3  91 rr              STA   (VTEXT_ADDRL),Y
000318r 3  C8                 INY
000319r 3  AD rr rr           LDA   VTEXT_WIDTH
00031Cr 3  91 rr              STA   (VTEXT_ADDRL),Y
00031Er 3  C8                 INY
00031Fr 3  AD rr rr           LDA   VTEXT_HEIGHT
000322r 3  91 rr              STA   (VTEXT_ADDRL),Y
000324r 3  C8                 INY
000325r 3  AD rr rr           LDA   VTEXT_CURX
000328r 3  91 rr              STA   (VTEXT_ADDRL),Y
00032Ar 3  C8                 INY
00032Br 3  AD rr rr           LDA   VTEXT_CURY
00032Er 3  91 rr              STA   (VTEXT_ADDRL),Y
000330r 3  C8                 INY
000331r 3  AD rr rr           LDA   VTEXT_COLOR
000334r 3  91 rr              STA   (VTEXT_ADDRL),Y
000336r 3  C8                 INY
000337r 3  AD rr rr           LDA   VTEXT_ATTR
00033Ar 3  91 rr              STA   (VTEXT_ADDRL),Y
00033Cr 3  C8                 INY
00033Dr 3  AD rr rr           LDA   VTEXT_FLAGS
000340r 3  91 rr              STA   (VTEXT_ADDRL),Y
000342r 3  C8                 INY
000343r 3  A9 00              LDA   #$00
000345r 3  91 rr              STA   (VTEXT_ADDRL),Y
000347r 3  A9 00              LDA   #VTEXT_OK
000349r 3               @done:
000349r 3  60                 RTS
00034Ar 3               
00034Ar 3               vtext_select_region:
00034Ar 3  20 rr rr           JSR   vtext_region_slot
00034Dr 3  A0 00              LDY   #VTEXT_REGION_LEFT
00034Fr 3  B1 rr              LDA   (VTEXT_ADDRL),Y
000351r 3  8D rr rr           STA   VTEXT_LEFT
000354r 3  C8                 INY
000355r 3  B1 rr              LDA   (VTEXT_ADDRL),Y
000357r 3  8D rr rr           STA   VTEXT_TOP
00035Ar 3  C8                 INY
00035Br 3  B1 rr              LDA   (VTEXT_ADDRL),Y
00035Dr 3  8D rr rr           STA   VTEXT_WIDTH
000360r 3  C8                 INY
000361r 3  B1 rr              LDA   (VTEXT_ADDRL),Y
000363r 3  8D rr rr           STA   VTEXT_HEIGHT
000366r 3  C8                 INY
000367r 3  B1 rr              LDA   (VTEXT_ADDRL),Y
000369r 3  8D rr rr           STA   VTEXT_CURX
00036Cr 3  C8                 INY
00036Dr 3  B1 rr              LDA   (VTEXT_ADDRL),Y
00036Fr 3  8D rr rr           STA   VTEXT_CURY
000372r 3  C8                 INY
000373r 3  B1 rr              LDA   (VTEXT_ADDRL),Y
000375r 3  8D rr rr           STA   VTEXT_COLOR
000378r 3  C8                 INY
000379r 3  B1 rr              LDA   (VTEXT_ADDRL),Y
00037Br 3  8D rr rr           STA   VTEXT_ATTR
00037Er 3  C8                 INY
00037Fr 3  B1 rr              LDA   (VTEXT_ADDRL),Y
000381r 3  8D rr rr           STA   VTEXT_FLAGS
000384r 3  20 rr rr           JSR   vtext_validate_region
000387r 3  D0 03              BNE   @done
000389r 3  4C rr rr           JMP   vtext_set_cursor
00038Cr 3               @done:
00038Cr 3  60                 RTS
00038Dr 3               
00038Dr 3               vtext_store_region:
00038Dr 3  20 rr rr           JSR   vtext_validate_region
000390r 3  D0 08              BNE   @done
000392r 3  20 rr rr           JSR   vtext_set_cursor
000395r 3  D0 03              BNE   @done
000397r 3  4C rr rr           JMP   vtext_define_region
00039Ar 3               @done:
00039Ar 3  60                 RTS
00039Br 3               
00039Br 3               ; ---------------------------------------------------------------------
00039Br 3               ; Validation and cursor helpers
00039Br 3               ; ---------------------------------------------------------------------
00039Br 3               vtext_validate_region:
00039Br 3  AD rr rr           LDA   VTEXT_WIDTH
00039Er 3  F0 2A              BEQ   @bad
0003A0r 3  AD rr rr           LDA   VTEXT_HEIGHT
0003A3r 3  F0 25              BEQ   @bad
0003A5r 3  AD rr rr           LDA   VTEXT_LEFT
0003A8r 3  C9 50              CMP   #VTEXT_SCREEN_COLS
0003AAr 3  B0 1E              BCS   @bad
0003ACr 3  18                 CLC
0003ADr 3  6D rr rr           ADC   VTEXT_WIDTH
0003B0r 3  B0 18              BCS   @bad
0003B2r 3  C9 51              CMP   #VTEXT_SCREEN_COLS + 1
0003B4r 3  B0 14              BCS   @bad
0003B6r 3  AD rr rr           LDA   VTEXT_TOP
0003B9r 3  C9 32              CMP   #VTEXT_SCREEN_ROWS
0003BBr 3  B0 0D              BCS   @bad
0003BDr 3  18                 CLC
0003BEr 3  6D rr rr           ADC   VTEXT_HEIGHT
0003C1r 3  B0 07              BCS   @bad
0003C3r 3  C9 33              CMP   #VTEXT_SCREEN_ROWS + 1
0003C5r 3  B0 03              BCS   @bad
0003C7r 3  4C rr rr           JMP   vtext_ok
0003CAr 3               @bad:
0003CAr 3  4C rr rr           JMP   vtext_err
0003CDr 3               
0003CDr 3               vtext_sync_cursor:
0003CDr 3  AD rr rr           LDA   VTEXT_LEFT
0003D0r 3  18                 CLC
0003D1r 3  6D rr rr           ADC   VTEXT_CURX
0003D4r 3  8D 03 A0           STA   VGC_CURSX
0003D7r 3  AD rr rr           LDA   VTEXT_TOP
0003DAr 3  18                 CLC
0003DBr 3  6D rr rr           ADC   VTEXT_CURY
0003DEr 3  8D 04 A0           STA   VGC_CURSY
0003E1r 3  60                 RTS
0003E2r 3               
0003E2r 3               vtext_set_cursor:
0003E2r 3  20 rr rr           JSR   vtext_validate_region
0003E5r 3  D0 19              BNE   @done
0003E7r 3  AD rr rr           LDA   VTEXT_CURX
0003EAr 3  CD rr rr           CMP   VTEXT_WIDTH
0003EDr 3  B0 0E              BCS   @bad
0003EFr 3  AD rr rr           LDA   VTEXT_CURY
0003F2r 3  CD rr rr           CMP   VTEXT_HEIGHT
0003F5r 3  B0 06              BCS   @bad
0003F7r 3  20 rr rr           JSR   vtext_sync_cursor
0003FAr 3  4C rr rr           JMP   vtext_ok
0003FDr 3               @bad:
0003FDr 3  4C rr rr           JMP   vtext_err
000400r 3               @done:
000400r 3  60                 RTS
000401r 3               
000401r 3               vtext_home:
000401r 3  9C rr rr           STZ   VTEXT_CURX
000404r 3  9C rr rr           STZ   VTEXT_CURY
000407r 3  4C rr rr           JMP   vtext_set_cursor
00040Ar 3               
00040Ar 3               ; ---------------------------------------------------------------------
00040Ar 3               ; Addressing and VRAM writes
00040Ar 3               ; ---------------------------------------------------------------------
00040Ar 3               vtext_calc_region_addr:
00040Ar 3  AD rr rr           LDA   VTEXT_CURX
00040Dr 3  48                 PHA
00040Er 3  AD rr rr           LDA   VTEXT_CURY
000411r 3  48                 PHA
000412r 3  9C rr rr           STZ   VTEXT_CURX
000415r 3  9C rr rr           STZ   VTEXT_CURY
000418r 3  20 rr rr           JSR   vtext_calc_addr
00041Br 3  68                 PLA
00041Cr 3  8D rr rr           STA   VTEXT_CURY
00041Fr 3  68                 PLA
000420r 3  8D rr rr           STA   VTEXT_CURX
000423r 3  60                 RTS
000424r 3               
000424r 3               ; VTEXT_ADDR = (TOP + CURY) * 80 + LEFT + CURX
000424r 3               vtext_calc_addr:
000424r 3  AD rr rr           LDA   VTEXT_TOP
000427r 3  18                 CLC
000428r 3  6D rr rr           ADC   VTEXT_CURY
00042Br 3  85 rr              STA   VTEXT_TMP
00042Dr 3               
00042Dr 3  0A                 ASL
00042Er 3  0A                 ASL
00042Fr 3  18                 CLC
000430r 3  65 rr              ADC   VTEXT_TMP          ; row * 5
000432r 3  85 rr              STA   VTEXT_ADDRL
000434r 3  64 rr              STZ   VTEXT_ADDRH
000436r 3               
000436r 3  06 rr              ASL   VTEXT_ADDRL
000438r 3  26 rr              ROL   VTEXT_ADDRH
00043Ar 3  06 rr              ASL   VTEXT_ADDRL
00043Cr 3  26 rr              ROL   VTEXT_ADDRH
00043Er 3  06 rr              ASL   VTEXT_ADDRL
000440r 3  26 rr              ROL   VTEXT_ADDRH
000442r 3  06 rr              ASL   VTEXT_ADDRL
000444r 3  26 rr              ROL   VTEXT_ADDRH        ; row * 80
000446r 3               
000446r 3  AD rr rr           LDA   VTEXT_LEFT
000449r 3  18                 CLC
00044Ar 3  6D rr rr           ADC   VTEXT_CURX
00044Dr 3  18                 CLC
00044Er 3  65 rr              ADC   VTEXT_ADDRL
000450r 3  85 rr              STA   VTEXT_ADDRL
000452r 3  90 02              BCC   @done
000454r 3  E6 rr              INC   VTEXT_ADDRH
000456r 3               @done:
000456r 3  60                 RTS
000457r 3               
000457r 3               vtext_select_vram_addr:
000457r 3  8D E0 A0           STA   VGC_VRAM_PLANE
00045Ar 3  A5 rr              LDA   VTEXT_ADDRL
00045Cr 3  8D E1 A0           STA   VGC_VRAM_ADDRL
00045Fr 3  A5 rr              LDA   VTEXT_ADDRH
000461r 3  8D E2 A0           STA   VGC_VRAM_ADDRH
000464r 3  A9 00              LDA   #$00
000466r 3  8D E4 A0           STA   VGC_VRAM_CTRL
000469r 3  60                 RTS
00046Ar 3               
00046Ar 3               vtext_write_current_cell:
00046Ar 3  20 rr rr           JSR   vtext_calc_addr
00046Dr 3               
00046Dr 3  A9 01              LDA   #VTEXT_PLANE_CHAR
00046Fr 3  20 rr rr           JSR   vtext_select_vram_addr
000472r 3  AD rr rr           LDA   VTEXT_CHAR
000475r 3  8D E3 A0           STA   VGC_VRAM_DATA
000478r 3               
000478r 3  A9 02              LDA   #VTEXT_PLANE_COLOR
00047Ar 3  20 rr rr           JSR   vtext_select_vram_addr
00047Dr 3  AD rr rr           LDA   VTEXT_COLOR
000480r 3  8D E3 A0           STA   VGC_VRAM_DATA
000483r 3               
000483r 3  A9 07              LDA   #VTEXT_PLANE_TEXTATTR
000485r 3  20 rr rr           JSR   vtext_select_vram_addr
000488r 3  AD rr rr           LDA   VTEXT_ATTR
00048Br 3  8D E3 A0           STA   VGC_VRAM_DATA
00048Er 3               
00048Er 3  4C rr rr           JMP   vtext_ok
000491r 3               
000491r 3               ; ---------------------------------------------------------------------
000491r 3               ; Character output
000491r 3               ; ---------------------------------------------------------------------
000491r 3               vtext_put_char:
000491r 3  20 rr rr           JSR   vtext_validate_region
000494r 3  D0 49              BNE   @done
000496r 3  AD rr rr           LDA   VTEXT_CHAR
000499r 3  C9 0D              CMP   #$0D
00049Br 3  F0 1D              BEQ   @cr
00049Dr 3  C9 0A              CMP   #$0A
00049Fr 3  F0 22              BEQ   @lf
0004A1r 3  C9 08              CMP   #$08
0004A3r 3  F0 21              BEQ   @bs
0004A5r 3  C9 0C              CMP   #$0C
0004A7r 3  F0 28              BEQ   @ff
0004A9r 3  C9 20              CMP   #$20
0004ABr 3  90 13              BCC   @ok
0004ADr 3               
0004ADr 3  20 rr rr           JSR   vtext_set_cursor
0004B0r 3  D0 2D              BNE   @done
0004B2r 3  20 rr rr           JSR   vtext_write_current_cell
0004B5r 3  D0 28              BNE   @done
0004B7r 3  4C rr rr           JMP   vtext_advance_char
0004BAr 3               @cr:
0004BAr 3  9C rr rr           STZ   VTEXT_CURX
0004BDr 3  4C rr rr           JMP   vtext_set_cursor
0004C0r 3               @ok:
0004C0r 3  4C rr rr           JMP   vtext_ok
0004C3r 3               @lf:
0004C3r 3  4C rr rr           JMP   vtext_newline
0004C6r 3               @bs:
0004C6r 3  AD rr rr           LDA   VTEXT_CURX
0004C9r 3  F0 F5              BEQ   @ok
0004CBr 3  CE rr rr           DEC   VTEXT_CURX
0004CEr 3  4C rr rr           JMP   vtext_set_cursor
0004D1r 3               @ff:
0004D1r 3  20 rr rr           JSR   vtext_clear_region
0004D4r 3  D0 09              BNE   @done
0004D6r 3  9C rr rr           STZ   VTEXT_CURX
0004D9r 3  9C rr rr           STZ   VTEXT_CURY
0004DCr 3  4C rr rr           JMP   vtext_set_cursor
0004DFr 3               @done:
0004DFr 3  60                 RTS
0004E0r 3               
0004E0r 3               vtext_advance_char:
0004E0r 3  EE rr rr           INC   VTEXT_CURX
0004E3r 3  AD rr rr           LDA   VTEXT_CURX
0004E6r 3  CD rr rr           CMP   VTEXT_WIDTH
0004E9r 3  90 19              BCC   @ok
0004EBr 3               
0004EBr 3  AD rr rr           LDA   VTEXT_FLAGS
0004EEr 3  29 01              AND   #VTEXT_FLAG_WRAP
0004F0r 3  D0 0C              BNE   @wrap
0004F2r 3  AD rr rr           LDA   VTEXT_WIDTH
0004F5r 3  38                 SEC
0004F6r 3  E9 01              SBC   #$01
0004F8r 3  8D rr rr           STA   VTEXT_CURX
0004FBr 3  4C rr rr           JMP   vtext_set_cursor
0004FEr 3               @wrap:
0004FEr 3  9C rr rr           STZ   VTEXT_CURX
000501r 3  4C rr rr           JMP   vtext_advance_line
000504r 3               @ok:
000504r 3  4C rr rr           JMP   vtext_set_cursor
000507r 3               
000507r 3               ; @label VTEXT.PUTS
000507r 3               ; @kind routine
000507r 3               ; @symbol vtext_puts
000507r 3               ; @summary Print a zero-terminated string into the current VTEXT region.
000507r 3               ; @in A/Y: Pointer to the zero-terminated string, low byte in A and high byte in Y.
000507r 3               ; @requires VTEXT_LEFT VTEXT_TOP VTEXT_WIDTH VTEXT_HEIGHT VTEXT_CURX VTEXT_CURY VTEXT_COLOR VTEXT_ATTR
000507r 3               ; @out A: 0 on success, 1 on error.
000507r 3               vtext_puts:
000507r 3  85 rr              STA   VTEXT_STRL
000509r 3  84 rr              STY   VTEXT_STRH
00050Br 3               @loop:
00050Br 3  A0 00              LDY   #$00
00050Dr 3  B1 rr              LDA   (VTEXT_STRL),Y
00050Fr 3  F0 10              BEQ   @ok
000511r 3  8D rr rr           STA   VTEXT_CHAR
000514r 3  20 rr rr           JSR   vtext_put_char
000517r 3  D0 0A              BNE   @done
000519r 3  E6 rr              INC   VTEXT_STRL
00051Br 3  D0 EE              BNE   @loop
00051Dr 3  E6 rr              INC   VTEXT_STRH
00051Fr 3  80 EA              BRA   @loop
000521r 3               @ok:
000521r 3  A9 00              LDA   #VTEXT_OK
000523r 3               @done:
000523r 3  60                 RTS
000524r 3               
000524r 3               ; @label VTEXT.PUT_HEX_NIBBLE
000524r 3               ; @kind routine
000524r 3               ; @symbol vtext_put_hex_nibble
000524r 3               ; @summary Print the low nibble of A as one uppercase hexadecimal digit.
000524r 3               ; @in A: Value whose low nibble should be printed.
000524r 3               ; @requires Current VTEXT region and cursor.
000524r 3               ; @out A: 0 on success, 1 on error.
000524r 3               vtext_put_hex_nibble:
000524r 3  29 0F              AND   #$0F
000526r 3  AA                 TAX
000527r 3  BD rr rr           LDA   vtext_hex_digits,X
00052Ar 3  8D rr rr           STA   VTEXT_CHAR
00052Dr 3  4C rr rr           JMP   vtext_put_char
000530r 3               
000530r 3               ; @label VTEXT.PUT_HEX_BYTE
000530r 3               ; @kind routine
000530r 3               ; @symbol vtext_put_hex_byte
000530r 3               ; @summary Print A as two uppercase hexadecimal digits.
000530r 3               ; @in A: Byte value to print.
000530r 3               ; @requires Current VTEXT region and cursor.
000530r 3               ; @out A: 0 on success, 1 on error.
000530r 3               vtext_put_hex_byte:
000530r 3  48                 PHA
000531r 3  4A                 LSR
000532r 3  4A                 LSR
000533r 3  4A                 LSR
000534r 3  4A                 LSR
000535r 3  20 rr rr           JSR   vtext_put_hex_nibble
000538r 3  D0 04              BNE   @fail
00053Ar 3  68                 PLA
00053Br 3  4C rr rr           JMP   vtext_put_hex_nibble
00053Er 3               @fail:
00053Er 3  68                 PLA
00053Fr 3  A9 01              LDA   #VTEXT_ERR
000541r 3  60                 RTS
000542r 3               
000542r 3               vtext_newline:
000542r 3  20 rr rr           JSR   vtext_validate_region
000545r 3  D0 06              BNE   @done
000547r 3  9C rr rr           STZ   VTEXT_CURX
00054Ar 3  4C rr rr           JMP   vtext_advance_line
00054Dr 3               @done:
00054Dr 3  60                 RTS
00054Er 3               
00054Er 3               vtext_advance_line:
00054Er 3  EE rr rr           INC   VTEXT_CURY
000551r 3  AD rr rr           LDA   VTEXT_CURY
000554r 3  CD rr rr           CMP   VTEXT_HEIGHT
000557r 3  90 15              BCC   @ok
000559r 3               
000559r 3  AD rr rr           LDA   VTEXT_FLAGS
00055Cr 3  29 02              AND   #VTEXT_FLAG_SCROLL
00055Er 3  F0 05              BEQ   @clamp
000560r 3  20 rr rr           JSR   vtext_scroll_up
000563r 3  D0 0C              BNE   @done
000565r 3               @clamp:
000565r 3  AD rr rr           LDA   VTEXT_HEIGHT
000568r 3  38                 SEC
000569r 3  E9 01              SBC   #$01
00056Br 3  8D rr rr           STA   VTEXT_CURY
00056Er 3               @ok:
00056Er 3  4C rr rr           JMP   vtext_set_cursor
000571r 3               @done:
000571r 3  60                 RTS
000572r 3               
000572r 3               ; ---------------------------------------------------------------------
000572r 3               ; Clears and scrolling
000572r 3               ; ---------------------------------------------------------------------
000572r 3               vtext_clear_region:
000572r 3  20 rr rr           JSR   vtext_validate_region
000575r 3  D0 2D              BNE   @done
000577r 3  20 rr rr           JSR   vtext_calc_region_addr
00057Ar 3               
00057Ar 3  A9 20              LDA   #$20
00057Cr 3  85 rr              STA   VTEXT_TMP
00057Er 3  AE rr rr           LDX   VTEXT_HEIGHT
000581r 3  A9 01              LDA   #VTEXT_PLANE_CHAR
000583r 3  20 rr rr           JSR   vtext_blt_fill_plane
000586r 3  D0 1C              BNE   @done
000588r 3               
000588r 3  AD rr rr           LDA   VTEXT_COLOR
00058Br 3  85 rr              STA   VTEXT_TMP
00058Dr 3  AE rr rr           LDX   VTEXT_HEIGHT
000590r 3  A9 02              LDA   #VTEXT_PLANE_COLOR
000592r 3  20 rr rr           JSR   vtext_blt_fill_plane
000595r 3  D0 0D              BNE   @done
000597r 3               
000597r 3  AD rr rr           LDA   VTEXT_ATTR
00059Ar 3  85 rr              STA   VTEXT_TMP
00059Cr 3  AE rr rr           LDX   VTEXT_HEIGHT
00059Fr 3  A9 07              LDA   #VTEXT_PLANE_TEXTATTR
0005A1r 3  20 rr rr           JSR   vtext_blt_fill_plane
0005A4r 3               @done:
0005A4r 3  60                 RTS
0005A5r 3               
0005A5r 3               vtext_clear_line:
0005A5r 3  20 rr rr           JSR   vtext_set_cursor
0005A8r 3  D0 35              BNE   @done
0005AAr 3  AD rr rr           LDA   VTEXT_CURX
0005ADr 3  48                 PHA
0005AEr 3  9C rr rr           STZ   VTEXT_CURX
0005B1r 3  20 rr rr           JSR   vtext_calc_addr
0005B4r 3  68                 PLA
0005B5r 3  8D rr rr           STA   VTEXT_CURX
0005B8r 3               
0005B8r 3  A9 20              LDA   #$20
0005BAr 3  85 rr              STA   VTEXT_TMP
0005BCr 3  A2 01              LDX   #$01
0005BEr 3  A9 01              LDA   #VTEXT_PLANE_CHAR
0005C0r 3  20 rr rr           JSR   vtext_blt_fill_plane
0005C3r 3  D0 1A              BNE   @done
0005C5r 3               
0005C5r 3  AD rr rr           LDA   VTEXT_COLOR
0005C8r 3  85 rr              STA   VTEXT_TMP
0005CAr 3  A2 01              LDX   #$01
0005CCr 3  A9 02              LDA   #VTEXT_PLANE_COLOR
0005CEr 3  20 rr rr           JSR   vtext_blt_fill_plane
0005D1r 3  D0 0C              BNE   @done
0005D3r 3               
0005D3r 3  AD rr rr           LDA   VTEXT_ATTR
0005D6r 3  85 rr              STA   VTEXT_TMP
0005D8r 3  A2 01              LDX   #$01
0005DAr 3  A9 07              LDA   #VTEXT_PLANE_TEXTATTR
0005DCr 3  20 rr rr           JSR   vtext_blt_fill_plane
0005DFr 3               @done:
0005DFr 3  60                 RTS
0005E0r 3               
0005E0r 3               vtext_scroll_up:
0005E0r 3  20 rr rr           JSR   vtext_validate_region
0005E3r 3  D0 70              BNE   @done
0005E5r 3  AD rr rr           LDA   VTEXT_HEIGHT
0005E8r 3  C9 01              CMP   #$01
0005EAr 3  D0 03              BNE   @copy_rows
0005ECr 3  4C rr rr           JMP   vtext_clear_region
0005EFr 3               
0005EFr 3               @copy_rows:
0005EFr 3  20 rr rr           JSR   vtext_calc_region_addr
0005F2r 3  AD rr rr           LDA   VTEXT_HEIGHT
0005F5r 3  38                 SEC
0005F6r 3  E9 01              SBC   #$01
0005F8r 3  85 rr              STA   VTEXT_TMP
0005FAr 3               
0005FAr 3  A9 01              LDA   #VTEXT_PLANE_CHAR
0005FCr 3  20 rr rr           JSR   vtext_blt_copy_up_plane
0005FFr 3  D0 54              BNE   @done
000601r 3  A9 02              LDA   #VTEXT_PLANE_COLOR
000603r 3  20 rr rr           JSR   vtext_blt_copy_up_plane
000606r 3  D0 4D              BNE   @done
000608r 3  A9 07              LDA   #VTEXT_PLANE_TEXTATTR
00060Ar 3  20 rr rr           JSR   vtext_blt_copy_up_plane
00060Dr 3  D0 46              BNE   @done
00060Fr 3               
00060Fr 3  AD rr rr           LDA   VTEXT_CURX
000612r 3  48                 PHA
000613r 3  AD rr rr           LDA   VTEXT_CURY
000616r 3  48                 PHA
000617r 3  9C rr rr           STZ   VTEXT_CURX
00061Ar 3  AD rr rr           LDA   VTEXT_HEIGHT
00061Dr 3  38                 SEC
00061Er 3  E9 01              SBC   #$01
000620r 3  8D rr rr           STA   VTEXT_CURY
000623r 3  20 rr rr           JSR   vtext_calc_addr
000626r 3  68                 PLA
000627r 3  8D rr rr           STA   VTEXT_CURY
00062Ar 3  68                 PLA
00062Br 3  8D rr rr           STA   VTEXT_CURX
00062Er 3               
00062Er 3  A9 20              LDA   #$20
000630r 3  85 rr              STA   VTEXT_TMP
000632r 3  A2 01              LDX   #$01
000634r 3  A9 01              LDA   #VTEXT_PLANE_CHAR
000636r 3  20 rr rr           JSR   vtext_blt_fill_plane
000639r 3  D0 1A              BNE   @done
00063Br 3               
00063Br 3  AD rr rr           LDA   VTEXT_COLOR
00063Er 3  85 rr              STA   VTEXT_TMP
000640r 3  A2 01              LDX   #$01
000642r 3  A9 02              LDA   #VTEXT_PLANE_COLOR
000644r 3  20 rr rr           JSR   vtext_blt_fill_plane
000647r 3  D0 0C              BNE   @done
000649r 3               
000649r 3  AD rr rr           LDA   VTEXT_ATTR
00064Cr 3  85 rr              STA   VTEXT_TMP
00064Er 3  A2 01              LDX   #$01
000650r 3  A9 07              LDA   #VTEXT_PLANE_TEXTATTR
000652r 3  20 rr rr           JSR   vtext_blt_fill_plane
000655r 3               @done:
000655r 3  60                 RTS
000656r 3               
000656r 3               vtext_blt_fill_plane:
000656r 3  8D 87 BA           STA   BLT_DSTSPACE
000659r 3  9C 86 BA           STZ   BLT_SRCSPACE
00065Cr 3  9C 88 BA           STZ   BLT_SRCL
00065Fr 3  9C 89 BA           STZ   BLT_SRCM
000662r 3  9C 8A BA           STZ   BLT_SRCH
000665r 3  9C 92 BA           STZ   BLT_SRCSTRL
000668r 3  9C 93 BA           STZ   BLT_SRCSTRH
00066Br 3  9C 98 BA           STZ   BLT_CKEY
00066Er 3  A5 rr              LDA   VTEXT_ADDRL
000670r 3  8D 8B BA           STA   BLT_DSTL
000673r 3  A5 rr              LDA   VTEXT_ADDRH
000675r 3  8D 8C BA           STA   BLT_DSTM
000678r 3  9C 8D BA           STZ   BLT_DSTH
00067Br 3  AD rr rr           LDA   VTEXT_WIDTH
00067Er 3  8D 8E BA           STA   BLT_WIDTHL
000681r 3  9C 8F BA           STZ   BLT_WIDTHH
000684r 3  8E 90 BA           STX   BLT_HEIGHTL
000687r 3  9C 91 BA           STZ   BLT_HEIGHTH
00068Ar 3  A9 50              LDA   #<VTEXT_SCREEN_COLS
00068Cr 3  8D 94 BA           STA   BLT_DSTSTRL
00068Fr 3  A9 00              LDA   #>VTEXT_SCREEN_COLS
000691r 3  8D 95 BA           STA   BLT_DSTSTRH
000694r 3  A5 rr              LDA   VTEXT_TMP
000696r 3  8D 97 BA           STA   BLT_FILLVALUE
000699r 3  20 rr rr           JSR   blitter_start_fill
00069Cr 3  4C rr rr           JMP   vtext_blitter_result
00069Fr 3               
00069Fr 3               vtext_blt_copy_up_plane:
00069Fr 3  8D 86 BA           STA   BLT_SRCSPACE
0006A2r 3  8D 87 BA           STA   BLT_DSTSPACE
0006A5r 3  A5 rr              LDA   VTEXT_ADDRL
0006A7r 3  18                 CLC
0006A8r 3  69 50              ADC   #VTEXT_SCREEN_COLS
0006AAr 3  8D 88 BA           STA   BLT_SRCL
0006ADr 3  A5 rr              LDA   VTEXT_ADDRH
0006AFr 3  69 00              ADC   #$00
0006B1r 3  8D 89 BA           STA   BLT_SRCM
0006B4r 3  9C 8A BA           STZ   BLT_SRCH
0006B7r 3  A5 rr              LDA   VTEXT_ADDRL
0006B9r 3  8D 8B BA           STA   BLT_DSTL
0006BCr 3  A5 rr              LDA   VTEXT_ADDRH
0006BEr 3  8D 8C BA           STA   BLT_DSTM
0006C1r 3  9C 8D BA           STZ   BLT_DSTH
0006C4r 3  AD rr rr           LDA   VTEXT_WIDTH
0006C7r 3  8D 8E BA           STA   BLT_WIDTHL
0006CAr 3  9C 8F BA           STZ   BLT_WIDTHH
0006CDr 3  A5 rr              LDA   VTEXT_TMP
0006CFr 3  8D 90 BA           STA   BLT_HEIGHTL
0006D2r 3  9C 91 BA           STZ   BLT_HEIGHTH
0006D5r 3  A9 50              LDA   #<VTEXT_SCREEN_COLS
0006D7r 3  8D 92 BA           STA   BLT_SRCSTRL
0006DAr 3  8D 94 BA           STA   BLT_DSTSTRL
0006DDr 3  A9 00              LDA   #>VTEXT_SCREEN_COLS
0006DFr 3  8D 93 BA           STA   BLT_SRCSTRH
0006E2r 3  8D 95 BA           STA   BLT_DSTSTRH
0006E5r 3  20 rr rr           JSR   blitter_start_copy
0006E8r 3  4C rr rr           JMP   vtext_blitter_result
0006EBr 3               
0006EBr 3               vtext_wait_blitter:
0006EBr 3  20 rr rr           JSR   blitter_wait
0006EEr 3               
0006EEr 3               vtext_blitter_result:
0006EEr 3  C9 00              CMP   #BLITTER_RESULT_OK
0006F0r 3  F0 03              BEQ   @ok
0006F2r 3  4C rr rr           JMP   vtext_err
0006F5r 3               @ok:
0006F5r 3  4C rr rr           JMP   vtext_ok
0006F8r 3               
0006F8r 3               vtext_hex_digits:
0006F8r 3  30 31 32 33        .byte "0123456789ABCDEF"
0006FCr 3  34 35 36 37  
000700r 3  38 39 41 42  
000708r 3               
000708r 3               .endif
000708r 3               
000708r 2               
000708r 2               .ifndef EDITUI_IMPLEMENTATION_INCLUDED
000708r 2               EDITUI_IMPLEMENTATION_INCLUDED = 1
000708r 2               
000708r 2               EDITUI_MENU_SAVE_MAX_W = EDITUI_SCREEN_COLS
000708r 2               EDITUI_MENU_SAVE_MAX_H = 16
000708r 2               EDITUI_MENU_SAVE_BYTES = EDITUI_MENU_SAVE_MAX_W * EDITUI_MENU_SAVE_MAX_H
000708r 2               
000708r 2               ; Overlay save-under staging lives in XRAM (the editor stays RAM-light). Flat
000708r 2               ; 24-bit base $05_4000 (XRAM transient staging region, free when no Z-machine /
000708r 2               ; NVG job is running). Three planes of EDITUI_MENU_SAVE_BYTES each.
000708r 2               EDITUI_XRAM_SAVE_H = $05
000708r 2               .ifndef EDITUI_XRAM_SAVE_BASE
000708r 2               EDITUI_XRAM_SAVE_BASE = $4000          ; low 16 bits of $05_4000
000708r 2               .endif
000708r 2               
000708r 2                     .segment "BSS"
000016r 2               
000016r 2  xx           EDITUI_TITLEL:      .res 1
000017r 2  xx           EDITUI_TITLEH:      .res 1
000018r 2  xx           EDITUI_MENUL:       .res 1
000019r 2  xx           EDITUI_MENUH:       .res 1
00001Ar 2  xx           EDITUI_MENUSL:      .res 1
00001Br 2  xx           EDITUI_MENUSH:      .res 1
00001Cr 2  xx           EDITUI_HELPL:       .res 1
00001Dr 2  xx           EDITUI_HELPH:       .res 1
00001Er 2  xx           EDITUI_STATUSL:     .res 1
00001Fr 2  xx           EDITUI_STATUSH:     .res 1
000020r 2  xx           EDITUI_DIRTY:       .res 1
000021r 2  xx           EDITUI_BOXX:        .res 1
000022r 2  xx           EDITUI_BOXY:        .res 1
000023r 2  xx           EDITUI_BOXW:        .res 1
000024r 2  xx           EDITUI_BOXH:        .res 1
000025r 2  xx           EDITUI_BOX_TITLEL:  .res 1
000026r 2  xx           EDITUI_BOX_TITLEH:  .res 1
000027r 2  xx           EDITUI_BOX_STYLE:   .res 1
000028r 2  xx           EDITUI_PRINTX:      .res 1
000029r 2  xx           EDITUI_PRINTY:      .res 1
00002Ar 2  xx           EDITUI_PRINTL:      .res 1
00002Br 2  xx           EDITUI_PRINTH:      .res 1
00002Cr 2  xx           EDITUI_FILLROW:     .res 1
00002Dr 2  xx           EDITUI_TMP:         .res 1
00002Er 2  xx           EDITUI_COL:         .res 1
00002Fr 2  xx           EDITUI_ROW:         .res 1
000030r 2  xx           EDITUI_LEN:         .res 1
000031r 2  xx           EDITUI_PRINT_COLOR: .res 1
000032r 2  xx           EDITUI_HOT_COLOR:   .res 1
000033r 2  xx           EDITUI_CH_TL:       .res 1
000034r 2  xx           EDITUI_CH_TR:       .res 1
000035r 2  xx           EDITUI_CH_BL:       .res 1
000036r 2  xx           EDITUI_CH_BR:       .res 1
000037r 2  xx           EDITUI_CH_H:        .res 1
000038r 2  xx           EDITUI_CH_V:        .res 1
000039r 2  xx           EDITUI_CH_TITLE_L:  .res 1
00003Ar 2  xx           EDITUI_CH_TITLE_R:  .res 1
00003Br 2  xx           EDITUI_MENU_INDEX:  .res 1
00003Cr 2  xx           EDITUI_MENU_COUNT:  .res 1
00003Dr 2  xx           EDITUI_MENU_X:      .res 1
00003Er 2  xx           EDITUI_MENU_Y:      .res 1
00003Fr 2  xx           EDITUI_MENU_WIDTH:  .res 1
000040r 2  xx           EDITUI_MENU_ITEMS_L:.res 1
000041r 2  xx           EDITUI_MENU_ITEMS_H:.res 1
000042r 2  xx           EDITUI_MENU_ITEM_COUNT: .res 1
000043r 2  xx           EDITUI_MENU_SELECTED: .res 1
000044r 2  xx           EDITUI_MENU_ACTIVE: .res 1
000045r 2  xx           EDITUI_MENU_CMD:    .res 1
000046r 2  xx           EDITUI_MENU_KEY:    .res 1
000047r 2  xx           EDITUI_MENU_SAVE_VALID: .res 1
000048r 2  xx           EDITUI_MENU_SAVE_X: .res 1
000049r 2  xx           EDITUI_MENU_SAVE_Y: .res 1
00004Ar 2  xx           EDITUI_MENU_SAVE_W: .res 1
00004Br 2  xx           EDITUI_MENU_SAVE_H: .res 1
00004Cr 2  xx           EDITUI_SAVE_BOXX:   .res 1
00004Dr 2  xx           EDITUI_SAVE_BOXY:   .res 1
00004Er 2  xx           EDITUI_SAVE_BOXW:   .res 1
00004Fr 2  xx           EDITUI_SAVE_BOXH:   .res 1
000050r 2  xx           EDITUI_SAVE_TITL:   .res 1
000051r 2  xx           EDITUI_SAVE_TITH:   .res 1
000052r 2  xx           EDITUI_SAVE_STYLE:  .res 1
000053r 2               ; The overlay save-under planes are staged in XRAM (not CPU BSS) so the editor
000053r 2               ; is RAM-light and reusable in any runtime. Each plane occupies
000053r 2               ; EDITUI_MENU_SAVE_BYTES at EDITUI_XRAM_SAVE + index*EDITUI_MENU_SAVE_BYTES.
000053r 2               
000053r 2                     .segment "ZEROPAGE"
000005r 2               
000005r 2  xx           EDITUI_SCANL:       .res 1
000006r 2  xx           EDITUI_SCANH:       .res 1
000007r 2  xx           EDITUI_MENU_PTRL:   .res 1
000008r 2  xx           EDITUI_MENU_PTRH:   .res 1
000009r 2  xx           EDITUI_MENU_ITEML:  .res 1
00000Ar 2  xx           EDITUI_MENU_ITEMH:  .res 1
00000Br 2               
00000Br 2                     .segment "CODE"
000708r 2               
000708r 2                     .export editui_init
000708r 2                     .export editui_full_region
000708r 2                     .export editui_clear_screen
000708r 2                     .export editui_shutdown
000708r 2                     .export editui_draw_shell
000708r 2                     .export editui_draw_status
000708r 2                     .export editui_draw_box
000708r 2                     .export editui_select_box_body
000708r 2                     .export editui_print_ptr
000708r 2                     .export editui_print_marked
000708r 2                     .export editui_menu_open_hotkey
000708r 2                     .export editui_default_menus
000708r 2                     .export editui_draw_title_band
000708r 2                     .export editui_refresh_dirty
000708r 2                     .export editui_save_under
000708r 2                     .export editui_restore_under
000708r 2               
000708r 2               editui_ok:
000708r 2  A9 00              LDA   #EDITUI_OK
00070Ar 2  60                 RTS
00070Br 2               
00070Br 2               editui_init:
00070Br 2  A9 00              LDA   #$00
00070Dr 2  8D 00 A0           STA   VGC_MODE
000710r 2                     ; The editor paints every cell via per-cell color RAM, so it does NOT
000710r 2                     ; dictate the global background/border/foreground — the host runtime owns
000710r 2                     ; those (and is responsible for restoring them on exit). We only set the
000710r 2                     ; palette mode the editor's color constants are authored against.
000710r 2  A9 00              LDA   #EDITUI_PALETTE_MODE
000712r 2  8D E9 A0           STA   VGC_PALETTE
000715r 2  9C 0A A0           STZ   VGC_CURSEN
000718r 2  9C rr rr           STZ   EDITUI_BOX_STYLE
00071Br 2  9C rr rr           STZ   EDITUI_MENUL
00071Er 2  9C rr rr           STZ   EDITUI_MENUH
000721r 2  9C rr rr           STZ   EDITUI_DIRTY
000724r 2  9C rr rr           STZ   EDITUI_MENU_SAVE_VALID
000727r 2  A9 rr              LDA   #<editui_default_menus
000729r 2  8D rr rr           STA   EDITUI_MENUSL
00072Cr 2  A9 rr              LDA   #>editui_default_menus
00072Er 2  8D rr rr           STA   EDITUI_MENUSH
000731r 2  4C rr rr           JMP   editui_ok
000734r 2               
000734r 2               ; editui_set_menus — A = menu-table ptr low byte, Y = high byte. Point the menu
000734r 2               ; bar at a host-supplied table. Editor-owned menu-management entry point so a
000734r 2               ; runtime can install a tailored ("dumb") menu instead of the File/Edit/Help
000734r 2               ; default. Pass A=Y=0 to fall back to editui_default_menus.
000734r 2               editui_set_menus:
000734r 2  8D rr rr           STA   EDITUI_MENUSL
000737r 2  8C rr rr           STY   EDITUI_MENUSH
00073Ar 2  60                 RTS
00073Br 2               
00073Br 2               editui_full_region:
00073Br 2  9C rr rr           STZ   VTEXT_LEFT
00073Er 2  9C rr rr           STZ   VTEXT_TOP
000741r 2  A9 50              LDA   #EDITUI_SCREEN_COLS
000743r 2  8D rr rr           STA   VTEXT_WIDTH
000746r 2  A9 32              LDA   #EDITUI_SCREEN_ROWS
000748r 2  8D rr rr           STA   VTEXT_HEIGHT
00074Br 2  9C rr rr           STZ   VTEXT_CURX
00074Er 2  9C rr rr           STZ   VTEXT_CURY
000751r 2  A9 0F              LDA   #EDITUI_COLOR_SHELL
000753r 2  8D rr rr           STA   VTEXT_COLOR
000756r 2  9C rr rr           STZ   VTEXT_ATTR
000759r 2  9C rr rr           STZ   VTEXT_FLAGS
00075Cr 2  60                 RTS
00075Dr 2               
00075Dr 2               editui_clear_screen:
00075Dr 2  20 rr rr           JSR   editui_full_region
000760r 2  A9 20              LDA   #' '
000762r 2  8D rr rr           STA   VTEXT_CHAR
000765r 2  4C rr rr           JMP   vtext_clear_region
000768r 2               
000768r 2               editui_shutdown:
000768r 2  A9 0C              LDA   #$0C
00076Ar 2  8D 0E A0           STA   VGC_CHAROUT
00076Dr 2               @wait:
00076Dr 2  AD 10 A0           LDA   VGC_CMD
000770r 2  29 01              AND   #$01
000772r 2  D0 F9              BNE   @wait
000774r 2  9C 03 A0           STZ   VGC_CURSX
000777r 2  9C 04 A0           STZ   VGC_CURSY
00077Ar 2  A9 01              LDA   #$01
00077Cr 2  8D 0A A0           STA   VGC_CURSEN
00077Fr 2  60                 RTS
000780r 2               
000780r 2               editui_fill_row:
000780r 2  AD rr rr           LDA   VTEXT_COLOR
000783r 2  48                 PHA
000784r 2  20 rr rr           JSR   editui_full_region
000787r 2  68                 PLA
000788r 2  8D rr rr           STA   VTEXT_COLOR
00078Br 2  AD rr rr           LDA   EDITUI_FILLROW
00078Er 2  8D rr rr           STA   VTEXT_TOP
000791r 2  A9 01              LDA   #1
000793r 2  8D rr rr           STA   VTEXT_HEIGHT
000796r 2  9C rr rr           STZ   VTEXT_CURX
000799r 2  9C rr rr           STZ   VTEXT_CURY
00079Cr 2  A9 20              LDA   #' '
00079Er 2  8D rr rr           STA   VTEXT_CHAR
0007A1r 2  4C rr rr           JMP   vtext_clear_region
0007A4r 2               
0007A4r 2               editui_print_ptr:
0007A4r 2  AD rr rr           LDA   VTEXT_COLOR
0007A7r 2  48                 PHA
0007A8r 2  20 rr rr           JSR   editui_full_region
0007ABr 2  68                 PLA
0007ACr 2  8D rr rr           STA   VTEXT_COLOR
0007AFr 2  AD rr rr           LDA   EDITUI_PRINTX
0007B2r 2  8D rr rr           STA   VTEXT_CURX
0007B5r 2  AD rr rr           LDA   EDITUI_PRINTY
0007B8r 2  8D rr rr           STA   VTEXT_CURY
0007BBr 2  20 rr rr           JSR   vtext_set_cursor
0007BEr 2  AD rr rr           LDA   EDITUI_PRINTL
0007C1r 2  AC rr rr           LDY   EDITUI_PRINTH
0007C4r 2  4C rr rr           JMP   vtext_puts
0007C7r 2               
0007C7r 2               editui_print_marked:
0007C7r 2  AD rr rr           LDA   EDITUI_PRINTL
0007CAr 2  85 rr              STA   EDITUI_SCANL
0007CCr 2  AD rr rr           LDA   EDITUI_PRINTH
0007CFr 2  85 rr              STA   EDITUI_SCANH
0007D1r 2  20 rr rr           JSR   editui_full_region
0007D4r 2  AD rr rr           LDA   EDITUI_PRINT_COLOR
0007D7r 2  8D rr rr           STA   VTEXT_COLOR
0007DAr 2  AD rr rr           LDA   EDITUI_PRINTX
0007DDr 2  8D rr rr           STA   VTEXT_CURX
0007E0r 2  AD rr rr           LDA   EDITUI_PRINTY
0007E3r 2  8D rr rr           STA   VTEXT_CURY
0007E6r 2  20 rr rr           JSR   vtext_set_cursor
0007E9r 2               @loop:
0007E9r 2  A0 00              LDY   #$00
0007EBr 2  B1 rr              LDA   (EDITUI_SCANL),Y
0007EDr 2  F0 2F              BEQ   @done
