000000r 1               NOVALOGO_TURTLE_STATE_EXTERNAL = 1   ; mailbox-ABI only; turtle state lives in the GRAPHICS module
000000r 1                     .include "ext_iface.inc"
000000r 2               ; ext_iface.inc — shared interface between NovaLogo base ROM and extension ROM
000000r 2               ;
000000r 2               ; These equates define the ZP mailbox used to pass arguments and results
000000r 2               ; between the base ROM and the extension ROM via the RAM trampoline.
000000r 2               ; Both ROMs include this file so addresses are always consistent.
000000r 2               ;
000000r 2               ; Addresses $80-$91 are outside the linker-managed ZEROPAGE segment
000000r 2               ; but inside true zero page RAM, accessible to both ROM banks.
000000r 2               
000000r 2               ; --- Command and argument count ---
000000r 2               EXT_CMD         = $80           ; command ID (set by base ROM before trampoline call)
000000r 2               EXT_ARGC        = $81           ; argument count
000000r 2               
000000r 2               ; --- Argument 0 ---
000000r 2               EXT_ARG0_TYPE   = $82           ; type: VAL_NUMBER=$00, VAL_WORD=$01, VAL_LIST=$02
000000r 2               EXT_ARG0_HI     = $83           ; value high byte
000000r 2               EXT_ARG0_LO     = $84           ; value low byte
000000r 2               EXT_ARG0_FRAC   = $85           ; fractional byte (16.8 fixed point)
000000r 2               
000000r 2               ; --- Argument 1 ---
000000r 2               EXT_ARG1_TYPE   = $86
000000r 2               EXT_ARG1_HI     = $87
000000r 2               EXT_ARG1_LO     = $88
000000r 2               EXT_ARG1_FRAC   = $89
000000r 2               
000000r 2               ; --- Argument 2 ---
000000r 2               EXT_ARG2_TYPE   = $8A
000000r 2               EXT_ARG2_HI     = $8B
000000r 2               EXT_ARG2_LO     = $8C
000000r 2               EXT_ARG2_FRAC   = $8D
000000r 2               
000000r 2               ; --- Result ---
000000r 2               EXT_RESULT_TYPE = $8E           ; return value type
000000r 2               EXT_RESULT_HI   = $8F           ; return value high byte
000000r 2               EXT_RESULT_LO   = $90           ; return value low byte
000000r 2               EXT_RESULT_FRAC = $91           ; return value fractional byte
000000r 2               
000000r 2               ; --- Command IDs ---
000000r 2               EXT_CMD_TEST    = $01           ; test command: returns arg0 + 1
000000r 2               EXT_CMD_FD      = $10           ; FD distance — move forward
000000r 2               EXT_CMD_BK      = $11           ; BK distance — move backward
000000r 2               EXT_CMD_RT      = $12           ; RT degrees — turn right
000000r 2               EXT_CMD_LT      = $13           ; LT degrees — turn left
000000r 2               EXT_CMD_CS      = $14           ; CS — clear screen, init turtle
000000r 2               EXT_CMD_PU      = $15           ; PU — pen up
000000r 2               EXT_CMD_PD      = $16           ; PD — pen down
000000r 2               EXT_CMD_ST      = $17           ; ST — show turtle
000000r 2               EXT_CMD_HT      = $18           ; HT — hide turtle
000000r 2               EXT_CMD_HOME    = $19           ; HOME — move to center, heading 0
000000r 2               EXT_CMD_TS      = $1A           ; TEXTSCREEN — full text mode
000000r 2               EXT_CMD_SS      = $1B           ; SPLITSCREEN — copper split
000000r 2               EXT_CMD_FS      = $1C           ; FULLSCREEN — full graphics mode
000000r 2               EXT_CMD_SETXY   = $1D           ; SETXY x y — move to position
000000r 2               EXT_CMD_SETX    = $1E           ; SETX x — set X only
000000r 2               EXT_CMD_SETY    = $1F           ; SETY y — set Y only
000000r 2               EXT_CMD_SETH    = $20           ; SETHEADING — set heading degrees
000000r 2               EXT_CMD_XCOR    = $21           ; XCOR — report turtle X
000000r 2               EXT_CMD_YCOR    = $22           ; YCOR — report turtle Y
000000r 2               EXT_CMD_HEADING = $23           ; HEADING — report heading degrees
000000r 2               EXT_CMD_PENDOWNP = $24          ; PENDOWN? — report pen state
000000r 2               EXT_CMD_SHOWNP  = $25           ; SHOWN? — report visibility
000000r 2               EXT_CMD_SETPC   = $26           ; SETPC color — set pen color
000000r 2               EXT_CMD_SETBG   = $27           ; SETBG color — set background color
000000r 2               EXT_CMD_TOWARDS = $28           ; TOWARDS x y — heading towards point
000000r 2               EXT_CMD_SETPOS  = $29           ; SETPOS [x y] — move to position from list
000000r 2               
000000r 2               ; --- VGC graphics commands ---
000000r 2               EXT_CMD_SETCOLOR = $30          ; SETCOLOR color — set VGC draw color
000000r 2               EXT_CMD_PLOT     = $31          ; PLOT x y — plot pixel
000000r 2               EXT_CMD_UNPLOT   = $32          ; UNPLOT x y — clear pixel
000000r 2               EXT_CMD_LINE     = $33          ; LINE x1 y1 x2 y2 — draw line
000000r 2               EXT_CMD_CIRCLE   = $34          ; CIRCLE x y r — draw circle
000000r 2               EXT_CMD_RECT     = $35          ; RECT x1 y1 x2 y2 — draw rectangle
000000r 2               EXT_CMD_FILLRECT = $36          ; FILL x1 y1 x2 y2 — filled rectangle
000000r 2               EXT_CMD_PAINT    = $37          ; PAINT x y — flood fill
000000r 2               
000000r 2               ; --- Sprite commands ---
000000r 2               EXT_CMD_SPRITE   = $40          ; SPRITE n x y — position and enable
000000r 2               EXT_CMD_SPRITEPOS = $41         ; SPRITEPOS n x y — reposition
000000r 2               EXT_CMD_SPRITEON = $42          ; SPRITEON n — enable sprite
000000r 2               EXT_CMD_SPRITEOFF = $43         ; SPRITEOFF n — disable sprite
000000r 2               EXT_CMD_SPRCOLLP = $44          ; SPRITECOLLISION? n — collision query
000000r 2               
000000r 2               ; --- Sound commands ---
000000r 2               EXT_CMD_TONE     = $45          ; TONE freq dur — play tone
000000r 2               EXT_CMD_NOISE    = $46          ; NOISE dur — noise burst
000000r 2               EXT_CMD_VOLUME   = $47          ; VOLUME vol — set SID master volume
000000r 2               
000000r 2               ; --- Timing commands ---
000000r 2               EXT_CMD_WAIT     = $48          ; WAIT n — wait N frames
000000r 2               EXT_CMD_WAITVBL  = $49          ; WAITVBL — wait for next VBL
000000r 2               EXT_CMD_TIMER    = $4A          ; TIMER — return frame counter
000000r 2               
000000r 2               ; --- Editor command ---
000000r 2               ; EXT_CMD_EDIT — open the shared EDITUI/EDITBUF editor on a RAM text buffer.
000000r 2               ;   In:  ARG0 = buffer ptr (lo/hi)   ARG1 = current length (lo/hi)
000000r 2               ;        ARG2 = capacity (lo/hi)     ARG3 = NUL-terminated title ptr (lo/hi)
000000r 2               ;        ARG2_FRAC:ARG3_FRAC = initial cursor byte offset (lo:hi) — the unused
000000r 2               ;        fractional bytes of the cap/title pointer args carry the cursor.
000000r 2               ;   Out: RESULT_LO = editbuf exit reason (EDITBUF_EXIT_*)
000000r 2               ;        RESULT_HI = nonzero if the user requested a save (Ctrl-S / "Save First")
000000r 2               ;        ARG1 (lo/hi) = final buffer length
000000r 2               EXT_CMD_EDIT     = $4B          ; EDIT — run the shared text editor
000000r 2               
