000000r 5               ; BASIC-owned data before calling an extension handler.
000000r 5               .ifndef EXT_ARG_LEN
000000r 5               EXT_ARG_LEN       = $EA
000000r 5               .endif
000000r 5               .ifndef EXT_ARG_PTRL
000000r 5               EXT_ARG_PTRL      = $EB
000000r 5               .endif
000000r 5               .ifndef EXT_ARG_PTRH
000000r 5               EXT_ARG_PTRH      = $EC
000000r 5               .endif
