002450r 2  20 rr rr           JSR   editbuf_call_indent       ; A = count
002453r 2  AA                 TAX
002454r 2  F0 25              BEQ   @done
002456r 2               @indent:
002456r 2  20 rr rr           JSR   editbuf_has_room
002459r 2  90 20              BCC   @done
00245Br 2  DA                 PHX
00245Cr 2  A9 01              LDA   #1
00245Er 2  85 rr              STA   EDITBUF_CNTL
002460r 2  64 rr              STZ   EDITBUF_CNTH
002462r 2  20 rr rr           JSR   editbuf_make_gap
002465r 2  AE rr rr           LDX   EDITBUF_CURL
002468r 2  AD rr rr           LDA   EDITBUF_CURH
00246Br 2  20 rr rr           JSR   editbuf_ptr_from_off
00246Er 2  A9 20              LDA   #' '
002470r 2  A0 00              LDY   #0
002472r 2  91 rr              STA   (EB_PL),Y
002474r 2  20 rr rr           JSR   editbuf_cursor_inc
002477r 2  FA                 PLX
002478r 2  CA                 DEX
002479r 2  D0 DB              BNE   @indent
00247Br 2               @done:
00247Br 2  4C rr rr           JMP   editbuf_after_change_down   ; newline shifts lines below it down
00247Er 2               @full:
00247Er 2  60                 RTS
00247Fr 2               
00247Fr 2               ; editbuf_backspace — delete char before cursor.
00247Fr 2               editbuf_backspace:
00247Fr 2  AD rr rr           LDA   EDITBUF_SELACT
002482r 2  F0 06              BEQ   @nosel
002484r 2  20 rr rr           JSR   editbuf_delete_selection
002487r 2  4C rr rr           JMP   editbuf_after_change
00248Ar 2               @nosel:
00248Ar 2  AD rr rr           LDA   EDITBUF_CURL
00248Dr 2  0D rr rr           ORA   EDITBUF_CURH
002490r 2  F0 39              BEQ   @done                 ; at start
002492r 2  20 rr rr           JSR   editbuf_cursor_dec
002495r 2                     ; peek the byte about to be removed (now at the cursor) to tell a line
002495r 2                     ; join (\n) from an in-line delete.
002495r 2  AE rr rr           LDX   EDITBUF_CURL
002498r 2  AD rr rr           LDA   EDITBUF_CURH
