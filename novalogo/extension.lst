0017E2r 2               EDITUI_MENU_SAVE_BYTES = EDITUI_MENU_SAVE_MAX_W * EDITUI_MENU_SAVE_MAX_H
0017E2r 2               
0017E2r 2               ; Overlay save-under staging lives in XRAM (the editor stays RAM-light). Flat
0017E2r 2               ; 24-bit base $05_4000 (XRAM transient staging region, free when no Z-machine /
0017E2r 2               ; NVG job is running). Three planes of EDITUI_MENU_SAVE_BYTES each.
0017E2r 2               EDITUI_XRAM_SAVE_H = $05
0017E2r 2               .ifndef EDITUI_XRAM_SAVE_BASE
0017E2r 2               EDITUI_XRAM_SAVE_BASE = $4000          ; low 16 bits of $05_4000
0017E2r 2               .endif
0017E2r 2               
