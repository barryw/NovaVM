001781r 3  18                 CLC
001782r 3  69 50              ADC   #VTEXT_SCREEN_COLS
001784r 3  8D 88 BA           STA   BLT_SRCL
001787r 3  A5 rr              LDA   VTEXT_ADDRH
001789r 3  69 00              ADC   #$00
00178Br 3  8D 89 BA           STA   BLT_SRCM
