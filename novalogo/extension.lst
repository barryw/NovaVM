00262Cr 2  9D rr rr           STA   EDITBUF_CLIP,X
00262Fr 2  E6 rr              INC   EB_SRCL
002631r 2  D0 02              BNE   :+
002633r 2  E6 rr              INC   EB_SRCH
002635r 2  E8           :     INX
002636r 2  D0 E6              BNE   @cl
002638r 2               @done:
002638r 2  60                 RTS
002639r 2               
002639r 2               editbuf_cut:
002639r 2  AD rr rr           LDA   EDITBUF_SELACT
00263Cr 2  F0 09              BEQ   @done
00263Er 2  20 rr rr           JSR   editbuf_copy
002641r 2  20 rr rr           JSR   editbuf_delete_selection
002644r 2  4C rr rr           JMP   editbuf_after_change
002647r 2               @done:
002647r 2  60                 RTS
002648r 2               
002648r 2               ; editbuf_paste — insert clipboard bytes at cursor.
002648r 2               editbuf_paste:
002648r 2  20 rr rr           JSR   editbuf_clear_selection
00264Br 2  AD rr rr           LDA   EDITBUF_CLIPLENL
00264Er 2  0D rr rr           ORA   EDITBUF_CLIPLENH
002651r 2  F0 7C              BEQ   @done
002653r 2                     ; room? LEN + cliplen <= CAP
002653r 2  18                 CLC
002654r 2  AD rr rr           LDA   EDITBUF_LENL
002657r 2  6D rr rr           ADC   EDITBUF_CLIPLENL
00265Ar 2  85 rr              STA   EB_T0
00265Cr 2  AD rr rr           LDA   EDITBUF_LENH
00265Fr 2  6D rr rr           ADC   EDITBUF_CLIPLENH
002662r 2  85 rr              STA   EB_T1
002664r 2  A5 rr              LDA   EB_T0
002666r 2  CD rr rr           CMP   EDITBUF_CAPL
002669r 2  A5 rr              LDA   EB_T1
00266Br 2  ED rr rr           SBC   EDITBUF_CAPH
00266Er 2  B0 5F              BCS   @done                 ; would overflow cap
002670r 2                     ; make gap of cliplen at cursor
002670r 2  AD rr rr           LDA   EDITBUF_CLIPLENL
002673r 2  85 rr              STA   EDITBUF_CNTL
002675r 2  AD rr rr           LDA   EDITBUF_CLIPLENH
002678r 2  85 rr              STA   EDITBUF_CNTH
00267Ar 2  20 rr rr           JSR   editbuf_make_gap
00267Dr 2                     ; dst ptr = BUF + cursor
00267Dr 2  AD rr rr           LDA   EDITBUF_CURL
002680r 2  8D rr rr           STA   EB_SCRATCHL
002683r 2  AD rr rr           LDA   EDITBUF_CURH
002686r 2  8D rr rr           STA   EB_SCRATCHH
002689r 2  AD rr rr           LDA   EDITBUF_BUFL
00268Cr 2  18                 CLC
00268Dr 2  6D rr rr           ADC   EB_SCRATCHL
002690r 2  85 rr              STA   EB_DSTL
002692r 2  AD rr rr           LDA   EDITBUF_BUFH
002695r 2  6D rr rr           ADC   EB_SCRATCHH
002698r 2  85 rr              STA   EB_DSTH
00269Ar 2  A2 00              LDX   #0
00269Cr 2               @pl:
00269Cr 2  EC rr rr           CPX   EDITBUF_CLIPLENL
00269Fr 2  D0 05              BNE   :+
0026A1r 2  AD rr rr           LDA   EDITBUF_CLIPLENH
0026A4r 2  F0 10              BEQ   @adv
0026A6r 2  BD rr rr     :     LDA   EDITBUF_CLIP,X
0026A9r 2  A0 00              LDY   #0
0026ABr 2  91 rr              STA   (EB_DSTL),Y
0026ADr 2  E6 rr              INC   EB_DSTL
0026AFr 2  D0 02              BNE   :+
0026B1r 2  E6 rr              INC   EB_DSTH
0026B3r 2  E8           :     INX
0026B4r 2  D0 E6              BNE   @pl
0026B6r 2               @adv:
0026B6r 2                     ; cursor += cliplen
0026B6r 2  18                 CLC
0026B7r 2  AD rr rr           LDA   EDITBUF_CURL
0026BAr 2  6D rr rr           ADC   EDITBUF_CLIPLENL
0026BDr 2  8D rr rr           STA   EDITBUF_CURL
0026C0r 2  AD rr rr           LDA   EDITBUF_CURH
0026C3r 2  6D rr rr           ADC   EDITBUF_CLIPLENH
0026C6r 2  8D rr rr           STA   EDITBUF_CURH
0026C9r 2  20 rr rr           JSR   editbuf_mark_dirty
0026CCr 2  4C rr rr           JMP   editbuf_after_change
0026CFr 2               @done:
0026CFr 2  60                 RTS
0026D0r 2               
0026D0r 2               ; =====================================================================
0026D0r 2               ; Cursor navigation
0026D0r 2               ; =====================================================================
0026D0r 2               
0026D0r 2               editbuf_move_left:
0026D0r 2  20 rr rr           JSR   editbuf_begin_move
0026D3r 2  AD rr rr           LDA   EDITBUF_CURL
0026D6r 2  0D rr rr           ORA   EDITBUF_CURH
0026D9r 2  F0 09              BEQ   @done
0026DBr 2  20 rr rr           JSR   editbuf_cursor_dec
0026DEr 2  20 rr rr           JSR   editbuf_update_goalcol
0026E1r 2  4C rr rr           JMP   editbuf_after_move
0026E4r 2               @done:
0026E4r 2  60                 RTS
0026E5r 2               
0026E5r 2               editbuf_move_right:
0026E5r 2  20 rr rr           JSR   editbuf_begin_move
0026E8r 2  AD rr rr           LDA   EDITBUF_CURL
0026EBr 2  CD rr rr           CMP   EDITBUF_LENL
0026EEr 2  AD rr rr           LDA   EDITBUF_CURH
0026F1r 2  ED rr rr           SBC   EDITBUF_LENH
0026F4r 2  B0 09              BCS   @done                 ; cursor >= len
0026F6r 2  20 rr rr           JSR   editbuf_cursor_inc
0026F9r 2  20 rr rr           JSR   editbuf_update_goalcol
0026FCr 2  4C rr rr           JMP   editbuf_after_move
0026FFr 2               @done:
0026FFr 2  60                 RTS
002700r 2               
002700r 2               editbuf_move_home:
002700r 2  20 rr rr           JSR   editbuf_begin_move
002703r 2  20 rr rr           JSR   editbuf_compute_linecol
002706r 2                     ; cursor = cursor - curcol
002706r 2  38                 SEC
002707r 2  AD rr rr           LDA   EDITBUF_CURL
00270Ar 2  ED rr rr           SBC   EB_CURCOL
00270Dr 2  8D rr rr           STA   EDITBUF_CURL
002710r 2  AD rr rr           LDA   EDITBUF_CURH
002713r 2  E9 00              SBC   #0
002715r 2  8D rr rr           STA   EDITBUF_CURH
002718r 2  9C rr rr           STZ   EB_GOALCOL
00271Br 2  4C rr rr           JMP   editbuf_after_move
00271Er 2               
00271Er 2               editbuf_move_end:
00271Er 2  20 rr rr           JSR   editbuf_begin_move
002721r 2  20 rr rr           JSR   editbuf_compute_linecol
002724r 2                     ; advance cursor to end of current line (until \n or buffer end)
002724r 2               @scan:
002724r 2  AD rr rr           LDA   EDITBUF_CURL
002727r 2  CD rr rr           CMP   EDITBUF_LENL
00272Ar 2  AD rr rr           LDA   EDITBUF_CURH
00272Dr 2  ED rr rr           SBC   EDITBUF_LENH
002730r 2  B0 16              BCS   @done                 ; at end of buffer
002732r 2  AE rr rr           LDX   EDITBUF_CURL
002735r 2  AD rr rr           LDA   EDITBUF_CURH
002738r 2  20 rr rr           JSR   editbuf_ptr_from_off
00273Br 2  A0 00              LDY   #0
00273Dr 2  B1 rr              LDA   (EB_PL),Y
00273Fr 2  C9 0A              CMP   #$0A
002741r 2  F0 05              BEQ   @done
002743r 2  20 rr rr           JSR   editbuf_cursor_inc
002746r 2  80 DC              BRA   @scan
002748r 2               @done:
002748r 2  20 rr rr           JSR   editbuf_update_goalcol
00274Br 2  4C rr rr           JMP   editbuf_after_move
00274Er 2               
00274Er 2               editbuf_move_up:
00274Er 2  20 rr rr           JSR   editbuf_begin_move
002751r 2  20 rr rr           JSR   editbuf_compute_linecol
002754r 2  AD rr rr           LDA   EB_CURLINEL
002757r 2  0D rr rr           ORA   EB_CURLINEH
00275Ar 2  F0 1D              BEQ   @done                 ; already on first line
00275Cr 2                     ; target line = curline - 1
00275Cr 2  AD rr rr           LDA   EB_CURLINEL
00275Fr 2  8D rr rr           STA   EB_SCRATCHL
002762r 2  AD rr rr           LDA   EB_CURLINEH
002765r 2  8D rr rr           STA   EB_SCRATCHH
002768r 2  AD rr rr           LDA   EB_SCRATCHL
00276Br 2  D0 03              BNE   :+
00276Dr 2  CE rr rr           DEC   EB_SCRATCHH
002770r 2  CE rr rr     :     DEC   EB_SCRATCHL
002773r 2  20 rr rr           JSR   editbuf_goto_line_col
002776r 2  4C rr rr           JMP   editbuf_after_move
002779r 2               @done:
002779r 2  60                 RTS
00277Ar 2               
00277Ar 2               editbuf_move_down:
00277Ar 2  20 rr rr           JSR   editbuf_begin_move
00277Dr 2  20 rr rr           JSR   editbuf_compute_linecol  ; CURLINE (clobbers EB_SCRATCH)
002780r 2  20 rr rr           JSR   editbuf_count_lines      ; EB_T0:EB_T1 = total (clobbers EB_SCRATCH)
002783r 2                     ; target line = curline + 1 (set EB_SCRATCH last; both helpers above use it)
002783r 2  AD rr rr           LDA   EB_CURLINEL
002786r 2  8D rr rr           STA   EB_SCRATCHL
002789r 2  AD rr rr           LDA   EB_CURLINEH
00278Cr 2  8D rr rr           STA   EB_SCRATCHH
00278Fr 2  EE rr rr           INC   EB_SCRATCHL
002792r 2  D0 03              BNE   :+
002794r 2  EE rr rr           INC   EB_SCRATCHH
002797r 2  AD rr rr     :     LDA   EB_SCRATCHL
00279Ar 2  C5 rr              CMP   EB_T0
00279Cr 2  AD rr rr           LDA   EB_SCRATCHH
00279Fr 2  E5 rr              SBC   EB_T1
0027A1r 2  B0 06              BCS   @done                 ; target >= total -> no line below
0027A3r 2  20 rr rr           JSR   editbuf_goto_line_col
0027A6r 2  4C rr rr           JMP   editbuf_after_move
0027A9r 2               @done:
0027A9r 2  60                 RTS
0027AAr 2               
0027AAr 2               editbuf_page_up:
0027AAr 2  20 rr rr           JSR   editbuf_begin_move
0027ADr 2  20 rr rr           JSR   editbuf_compute_linecol
0027B0r 2                     ; target = curline - VIEW_ROWS (clamp 0)
0027B0r 2  AD rr rr           LDA   EB_CURLINEL
0027B3r 2  38                 SEC
0027B4r 2  E9 30              SBC   #EDITBUF_VIEW_ROWS
0027B6r 2  8D rr rr           STA   EB_SCRATCHL
0027B9r 2  AD rr rr           LDA   EB_CURLINEH
0027BCr 2  E9 00              SBC   #0
0027BEr 2  8D rr rr           STA   EB_SCRATCHH
0027C1r 2  B0 06              BCS   @ok
0027C3r 2  9C rr rr           STZ   EB_SCRATCHL
0027C6r 2  9C rr rr           STZ   EB_SCRATCHH
0027C9r 2               @ok:
0027C9r 2  20 rr rr           JSR   editbuf_goto_line_col
0027CCr 2  4C rr rr           JMP   editbuf_after_move
0027CFr 2               
0027CFr 2               editbuf_page_down:
0027CFr 2  20 rr rr           JSR   editbuf_begin_move
0027D2r 2  20 rr rr           JSR   editbuf_compute_linecol  ; CURLINE (clobbers EB_SCRATCH)
0027D5r 2  20 rr rr           JSR   editbuf_count_lines      ; EB_T0:EB_T1 = total (clobbers EB_SCRATCH)
0027D8r 2                     ; clamp total to total-1 in EB_T0:EB_T1 (last visible line index)
0027D8r 2  A5 rr              LDA   EB_T0
0027DAr 2  D0 02              BNE   :+
0027DCr 2  C6 rr              DEC   EB_T1
0027DEr 2  C6 rr        :     DEC   EB_T0
0027E0r 2                     ; target = curline + VIEW_ROWS (set EB_SCRATCH after the helpers)
0027E0r 2  AD rr rr           LDA   EB_CURLINEL
0027E3r 2  18                 CLC
0027E4r 2  69 30              ADC   #EDITBUF_VIEW_ROWS
0027E6r 2  8D rr rr           STA   EB_SCRATCHL
0027E9r 2  AD rr rr           LDA   EB_CURLINEH
0027ECr 2  69 00              ADC   #0
0027EEr 2  8D rr rr           STA   EB_SCRATCHH
0027F1r 2  AD rr rr           LDA   EB_SCRATCHL
0027F4r 2  C5 rr              CMP   EB_T0
0027F6r 2  AD rr rr           LDA   EB_SCRATCHH
0027F9r 2  E5 rr              SBC   EB_T1
0027FBr 2  90 0A              BCC   @ok
0027FDr 2  A5 rr              LDA   EB_T0
0027FFr 2  8D rr rr           STA   EB_SCRATCHL
002802r 2  A5 rr              LDA   EB_T1
002804r 2  8D rr rr           STA   EB_SCRATCHH
002807r 2               @ok:
002807r 2  20 rr rr           JSR   editbuf_goto_line_col
00280Ar 2  4C rr rr           JMP   editbuf_after_move
00280Dr 2               
00280Dr 2               ; editbuf_goto_line_col — set cursor to (line=EB_SCRATCH, col=EB_GOALCOL),
00280Dr 2               ; clamped to the line's length.
00280Dr 2               editbuf_goto_line_col:
00280Dr 2  20 rr rr           JSR   editbuf_offset_of_line   ; EB_LINEOFF = start offset of EB_SCRATCH line
002810r 2                     ; cursor = lineoff
002810r 2  AD rr rr           LDA   EB_LINEOFFL
002813r 2  8D rr rr           STA   EDITBUF_CURL
002816r 2  AD rr rr           LDA   EB_LINEOFFH
002819r 2  8D rr rr           STA   EDITBUF_CURH
00281Cr 2                     ; advance up to GOALCOL chars, stopping at \n / buffer end
00281Cr 2  AE rr rr           LDX   EB_GOALCOL
00281Fr 2  F0 27              BEQ   @done
002821r 2               @adv:
002821r 2  AD rr rr           LDA   EDITBUF_CURL
002824r 2  CD rr rr           CMP   EDITBUF_LENL
002827r 2  AD rr rr           LDA   EDITBUF_CURH
00282Ar 2  ED rr rr           SBC   EDITBUF_LENH
00282Dr 2  B0 19              BCS   @done
00282Fr 2  DA                 PHX
002830r 2  AE rr rr           LDX   EDITBUF_CURL
002833r 2  AD rr rr           LDA   EDITBUF_CURH
002836r 2  20 rr rr           JSR   editbuf_ptr_from_off
002839r 2  A0 00              LDY   #0
00283Br 2  B1 rr              LDA   (EB_PL),Y
00283Dr 2  FA                 PLX
00283Er 2  C9 0A              CMP   #$0A
002840r 2  F0 06              BEQ   @done
002842r 2  20 rr rr           JSR   editbuf_cursor_inc
002845r 2  CA                 DEX
002846r 2  D0 D9              BNE   @adv
002848r 2               @done:
002848r 2  60                 RTS
002849r 2               
002849r 2               editbuf_update_goalcol:
002849r 2  20 rr rr           JSR   editbuf_compute_linecol
00284Cr 2  AD rr rr           LDA   EB_CURCOL
00284Fr 2  8D rr rr           STA   EB_GOALCOL
002852r 2  60                 RTS
002853r 2               
002853r 2               ; =====================================================================
002853r 2               ; Line/column computation
002853r 2               ; =====================================================================
002853r 2               
002853r 2               ; editbuf_compute_linecol — scan [0,cursor) counting newlines.
002853r 2               ;   Sets EB_CURLINE (16) and EB_CURCOL (8, clamped 255), and EB_LINEOFF =
002853r 2               ;   offset of the current line's first byte.
002853r 2               editbuf_compute_linecol:
002853r 2  9C rr rr           STZ   EB_CURLINEL
002856r 2  9C rr rr           STZ   EB_CURLINEH
002859r 2  9C rr rr           STZ   EB_CURCOL
00285Cr 2  9C rr rr           STZ   EB_LINEOFFL
00285Fr 2  9C rr rr           STZ   EB_LINEOFFH
002862r 2                     ; iterate offset 0..cursor-1
002862r 2  9C rr rr           STZ   EB_SCRATCHL
002865r 2  9C rr rr           STZ   EB_SCRATCHH
002868r 2               @loop:
002868r 2  AD rr rr           LDA   EB_SCRATCHL
00286Br 2  CD rr rr           CMP   EDITBUF_CURL
00286Er 2  AD rr rr           LDA   EB_SCRATCHH
002871r 2  ED rr rr           SBC   EDITBUF_CURH
002874r 2  B0 3D              BCS   @done                 ; scratch >= cursor
002876r 2  20 rr rr           JSR   editbuf_src_from_scratch
002879r 2  A0 00              LDY   #0
00287Br 2  B1 rr              LDA   (EB_SRCL),Y
00287Dr 2  C9 0A              CMP   #$0A
00287Fr 2  D0 1E              BNE   @notnl
002881r 2                     ; newline: line++, col=0, lineoff = scratch+1
002881r 2  EE rr rr           INC   EB_CURLINEL
002884r 2  D0 03              BNE   :+
002886r 2  EE rr rr           INC   EB_CURLINEH
002889r 2  9C rr rr     :     STZ   EB_CURCOL
00288Cr 2  18                 CLC
00288Dr 2  AD rr rr           LDA   EB_SCRATCHL
002890r 2  69 01              ADC   #1
002892r 2  8D rr rr           STA   EB_LINEOFFL
002895r 2  AD rr rr           LDA   EB_SCRATCHH
002898r 2  69 00              ADC   #0
00289Ar 2  8D rr rr           STA   EB_LINEOFFH
00289Dr 2  80 0A              BRA   @next
00289Fr 2               @notnl:
00289Fr 2  AD rr rr           LDA   EB_CURCOL
0028A2r 2  C9 FF              CMP   #255
0028A4r 2  B0 03              BCS   @next
0028A6r 2  EE rr rr           INC   EB_CURCOL
0028A9r 2               @next:
0028A9r 2  EE rr rr           INC   EB_SCRATCHL
0028ACr 2  D0 BA              BNE   @loop
0028AEr 2  EE rr rr           INC   EB_SCRATCHH
0028B1r 2  80 B5              BRA   @loop
0028B3r 2               @done:
0028B3r 2  60                 RTS
0028B4r 2               
0028B4r 2               ; editbuf_offset_of_line — find first-byte offset of line number EB_SCRATCH.
0028B4r 2               ;   Output: EB_LINEOFF.
0028B4r 2               editbuf_offset_of_line:
0028B4r 2                     ; if line 0 -> offset 0
0028B4r 2  AD rr rr           LDA   EB_SCRATCHL
0028B7r 2  0D rr rr           ORA   EB_SCRATCHH
0028BAr 2  D0 07              BNE   @scan
0028BCr 2  9C rr rr           STZ   EB_LINEOFFL
0028BFr 2  9C rr rr           STZ   EB_LINEOFFH
0028C2r 2  60                 RTS
0028C3r 2               @scan:
0028C3r 2                     ; walk buffer counting newlines until we've passed EB_SCRATCH of them
0028C3r 2  9C rr rr           STZ   EB_LINEOFFL           ; reuse as running offset
0028C6r 2  9C rr rr           STZ   EB_LINEOFFH
0028C9r 2  64 rr              STZ   EB_T0                 ; newline count lo
0028CBr 2  64 rr              STZ   EB_T1                 ; newline count hi
0028CDr 2               @loop:
0028CDr 2                     ; offset >= len? then return current offset (line past end -> end)
0028CDr 2  AD rr rr           LDA   EB_LINEOFFL
0028D0r 2  CD rr rr           CMP   EDITBUF_LENL
0028D3r 2  AD rr rr           LDA   EB_LINEOFFH
0028D6r 2  ED rr rr           SBC   EDITBUF_LENH
0028D9r 2  B0 35              BCS   @done
0028DBr 2                     ; read byte at offset
0028DBr 2  AD rr rr           LDA   EDITBUF_BUFL
0028DEr 2  18                 CLC
0028DFr 2  6D rr rr           ADC   EB_LINEOFFL
0028E2r 2  85 rr              STA   EB_SRCL
0028E4r 2  AD rr rr           LDA   EDITBUF_BUFH
0028E7r 2  6D rr rr           ADC   EB_LINEOFFH
0028EAr 2  85 rr              STA   EB_SRCH
0028ECr 2  A0 00              LDY   #0
0028EEr 2  B1 rr              LDA   (EB_SRCL),Y
0028F0r 2                     ; advance offset
0028F0r 2  EE rr rr           INC   EB_LINEOFFL
0028F3r 2  D0 03              BNE   :+
0028F5r 2  EE rr rr           INC   EB_LINEOFFH
0028F8r 2  C9 0A        :     CMP   #$0A
0028FAr 2  D0 D1              BNE   @loop
0028FCr 2                     ; counted a newline
0028FCr 2  E6 rr              INC   EB_T0
0028FEr 2  D0 02              BNE   :+
002900r 2  E6 rr              INC   EB_T1
002902r 2               :     ; reached target? (newline count == target line)
002902r 2  A5 rr              LDA   EB_T0
002904r 2  CD rr rr           CMP   EB_SCRATCHL
002907r 2  D0 C4              BNE   @loop
002909r 2  A5 rr              LDA   EB_T1
00290Br 2  CD rr rr           CMP   EB_SCRATCHH
00290Er 2  D0 BD              BNE   @loop
002910r 2                     ; EB_LINEOFF now points just past the Nth newline = line start
002910r 2               @done:
002910r 2  60                 RTS
002911r 2               
002911r 2               ; editbuf_count_lines — total line count = (newlines in buffer)+1 -> EB_T0:EB_T1
002911r 2               editbuf_count_lines:
002911r 2  A9 01              LDA   #1
002913r 2  85 rr              STA   EB_T0
002915r 2  64 rr              STZ   EB_T1
002917r 2  9C rr rr           STZ   EB_SCRATCHL
00291Ar 2  9C rr rr           STZ   EB_SCRATCHH
00291Dr 2               @loop:
00291Dr 2  AD rr rr           LDA   EB_SCRATCHL
002920r 2  CD rr rr           CMP   EDITBUF_LENL
002923r 2  AD rr rr           LDA   EB_SCRATCHH
002926r 2  ED rr rr           SBC   EDITBUF_LENH
002929r 2  B0 1B              BCS   @done
00292Br 2  20 rr rr           JSR   editbuf_src_from_scratch
00292Er 2  A0 00              LDY   #0
002930r 2  B1 rr              LDA   (EB_SRCL),Y
002932r 2  C9 0A              CMP   #$0A
002934r 2  D0 06              BNE   @next
002936r 2  E6 rr              INC   EB_T0
002938r 2  D0 02              BNE   @next
00293Ar 2  E6 rr              INC   EB_T1
00293Cr 2               @next:
00293Cr 2  EE rr rr           INC   EB_SCRATCHL
00293Fr 2  D0 DC              BNE   @loop
002941r 2  EE rr rr           INC   EB_SCRATCHH
002944r 2  80 D7              BRA   @loop
002946r 2               @done:
002946r 2  60                 RTS
002947r 2               
002947r 2               ; =====================================================================
002947r 2               ; After-change: recompute, adjust scroll, re-render, place cursor.
002947r 2               ; =====================================================================
002947r 2               editbuf_after_change:
002947r 2  20 rr rr           JSR   editbuf_compute_linecol
00294Ar 2  20 rr rr           JSR   editbuf_adjust_scroll
00294Dr 2  20 rr rr           JSR   editbuf_render
002950r 2  60                 RTS
002951r 2               
002951r 2               ; editbuf_begin_move — start a cursor move: remember whether a selection was
002951r 2               ; active (so its highlight can be cleared on the next repaint), then drop it.
002951r 2               editbuf_begin_move:
002951r 2  AD rr rr           LDA   EDITBUF_SELACT
002954r 2  8D rr rr           STA   EB_PREVSEL
002957r 2  9C rr rr           STZ   EDITBUF_SELACT
00295Ar 2  60                 RTS
00295Br 2               
00295Br 2               ; editbuf_after_move — finish a cursor move. The buffer didn't change, so when
00295Br 2               ; the scroll didn't move and no selection highlight needs clearing, just reposition
00295Br 2               ; the hardware cursor — no body repaint (this is what made arrowing smear).
00295Br 2               editbuf_after_move:
00295Br 2  20 rr rr           JSR   editbuf_compute_linecol
00295Er 2  AD rr rr           LDA   EB_TOPLINEL
002961r 2  8D rr rr           STA   EB_PREVTOPL
002964r 2  AD rr rr           LDA   EB_TOPLINEH
002967r 2  8D rr rr           STA   EB_PREVTOPH
00296Ar 2  AD rr rr           LDA   EB_LEFTCOL
00296Dr 2  8D rr rr           STA   EB_PREVLEFT
002970r 2  20 rr rr           JSR   editbuf_adjust_scroll
002973r 2  AD rr rr           LDA   EB_PREVSEL                ; had a selection -> repaint to clear it
002976r 2  D0 1B              BNE   @full
002978r 2  AD rr rr           LDA   EB_TOPLINEL
00297Br 2  CD rr rr           CMP   EB_PREVTOPL
00297Er 2  D0 13              BNE   @full
002980r 2  AD rr rr           LDA   EB_TOPLINEH
002983r 2  CD rr rr           CMP   EB_PREVTOPH
002986r 2  D0 0B              BNE   @full
002988r 2  AD rr rr           LDA   EB_LEFTCOL
00298Br 2  CD rr rr           CMP   EB_PREVLEFT
00298Er 2  D0 03              BNE   @full
002990r 2  4C rr rr           JMP   editbuf_place_cursor
002993r 2               @full:
002993r 2  4C rr rr           JMP   editbuf_render
002996r 2               
002996r 2               ; editbuf_after_inline_edit — for edits confined to the cursor's line (printable
002996r 2               ; insert, mid-line delete/backspace). EB_EDITDELTA holds how many columns left of
002996r 2               ; the cursor the changed run begins (1 after an insert, 0 after a delete). When
002996r 2               ; the scroll didn't move, repaint ONLY the changed run [start..VIEW_COLS) of the
002996r 2               ; cursor's row; otherwise a full repaint.
002996r 2               editbuf_after_inline_edit:
002996r 2  20 rr rr           JSR   editbuf_compute_linecol
002999r 2  AD rr rr           LDA   EB_TOPLINEL
00299Cr 2  8D rr rr           STA   EB_PREVTOPL
00299Fr 2  AD rr rr           LDA   EB_TOPLINEH
0029A2r 2  8D rr rr           STA   EB_PREVTOPH
0029A5r 2  AD rr rr           LDA   EB_LEFTCOL
0029A8r 2  8D rr rr           STA   EB_PREVLEFT
0029ABr 2  20 rr rr           JSR   editbuf_adjust_scroll
0029AEr 2  AD rr rr           LDA   EB_TOPLINEL
0029B1r 2  CD rr rr           CMP   EB_PREVTOPL
0029B4r 2  D0 25              BNE   @full
0029B6r 2  AD rr rr           LDA   EB_TOPLINEH
0029B9r 2  CD rr rr           CMP   EB_PREVTOPH
0029BCr 2  D0 1D              BNE   @full
0029BEr 2  AD rr rr           LDA   EB_LEFTCOL
0029C1r 2  CD rr rr           CMP   EB_PREVLEFT
0029C4r 2  D0 15              BNE   @full
0029C6r 2                     ; first changed screen col = (curcol - EDITDELTA) - leftcol, clamped to 0.
0029C6r 2  38                 SEC
0029C7r 2  AD rr rr           LDA   EB_CURCOL
0029CAr 2  ED rr rr           SBC   EB_EDITDELTA
0029CDr 2  38                 SEC
0029CEr 2  ED rr rr           SBC   EB_LEFTCOL
0029D1r 2  B0 02              BCS   @setstart
0029D3r 2  A9 00              LDA   #0
0029D5r 2               @setstart:
0029D5r 2  8D rr rr           STA   EB_PAINTSTART
0029D8r 2  4C rr rr           JMP   editbuf_render_current_line
0029DBr 2               @full:
0029DBr 2  9C rr rr           STZ   EB_PAINTSTART
0029DEr 2  4C rr rr           JMP   editbuf_render
0029E1r 2               
0029E1r 2               ; editbuf_render_current_line — repaint the cursor's visible row from column
0029E1r 2               ; EB_PAINTSTART (caller sets it) to the right edge of the view.
0029E1r 2               editbuf_render_current_line:
0029E1r 2                     ; single-char edits clear the selection: render with an empty range.
0029E1r 2  9C rr rr           STZ   EB_SELSTARTL
0029E4r 2  9C rr rr           STZ   EB_SELSTARTH
0029E7r 2  9C rr rr           STZ   EB_SELENDL
0029EAr 2  9C rr rr           STZ   EB_SELENDH
0029EDr 2                     ; screen row = curline - topline (cursor is on-screen, so < VIEW_ROWS)
0029EDr 2  38                 SEC
0029EEr 2  AD rr rr           LDA   EB_CURLINEL
0029F1r 2  ED rr rr           SBC   EB_TOPLINEL
0029F4r 2  8D rr rr           STA   EB_ROW
0029F7r 2                     ; running offset = first byte of the current line
0029F7r 2  AD rr rr           LDA   EB_CURLINEL
0029FAr 2  8D rr rr           STA   EB_SCRATCHL
0029FDr 2  AD rr rr           LDA   EB_CURLINEH
002A00r 2  8D rr rr           STA   EB_SCRATCHH
002A03r 2  20 rr rr           JSR   editbuf_offset_of_line
002A06r 2  AD rr rr           LDA   EB_LINEOFFL
002A09r 2  8D rr rr           STA   EB_VISLINEL
002A0Cr 2  AD rr rr           LDA   EB_LINEOFFH
002A0Fr 2  8D rr rr           STA   EB_VISLINEH
002A12r 2  20 rr rr           JSR   editbuf_render_row
002A15r 2  4C rr rr           JMP   editbuf_place_cursor
002A18r 2               
002A18r 2               ; editbuf_after_change_down — for edits that shift text vertically (newline,
002A18r 2               ; line-join delete/backspace): repaint from the changed line to the bottom of
002A18r 2               ; the view (a "local" repaint, not the whole screen), or full-repaint if the
002A18r 2               ; scroll moved.
002A18r 2               editbuf_after_change_down:
002A18r 2  20 rr rr           JSR   editbuf_compute_linecol
002A1Br 2  AD rr rr           LDA   EB_TOPLINEL
002A1Er 2  8D rr rr           STA   EB_PREVTOPL
002A21r 2  AD rr rr           LDA   EB_TOPLINEH
002A24r 2  8D rr rr           STA   EB_PREVTOPH
002A27r 2  AD rr rr           LDA   EB_LEFTCOL
002A2Ar 2  8D rr rr           STA   EB_PREVLEFT
002A2Dr 2  20 rr rr           JSR   editbuf_adjust_scroll
002A30r 2  AD rr rr           LDA   EB_TOPLINEL
002A33r 2  CD rr rr           CMP   EB_PREVTOPL
002A36r 2  D0 39              BNE   @full
002A38r 2  AD rr rr           LDA   EB_TOPLINEH
002A3Br 2  CD rr rr           CMP   EB_PREVTOPH
002A3Er 2  D0 31              BNE   @full
002A40r 2  AD rr rr           LDA   EB_LEFTCOL
002A43r 2  CD rr rr           CMP   EB_PREVLEFT
002A46r 2  D0 29              BNE   @full
002A48r 2                     ; start row = (curline - 1) - topline, clamped to the top of the view.
002A48r 2                     ; curline-1 covers both the split line (newline) and the joined line
002A48r 2                     ; (delete); repainting one extra unchanged row above is harmless.
002A48r 2  AD rr rr           LDA   EB_CURLINEL
002A4Br 2  38                 SEC
002A4Cr 2  E9 01              SBC   #1
002A4Er 2  8D rr rr           STA   EB_SCRATCHL
002A51r 2  AD rr rr           LDA   EB_CURLINEH
002A54r 2  E9 00              SBC   #0
002A56r 2  8D rr rr           STA   EB_SCRATCHH
002A59r 2  38                 SEC
002A5Ar 2  AD rr rr           LDA   EB_SCRATCHL
002A5Dr 2  ED rr rr           SBC   EB_TOPLINEL
002A60r 2  8D rr rr           STA   EB_ROW
002A63r 2  AD rr rr           LDA   EB_SCRATCHH
002A66r 2  ED rr rr           SBC   EB_TOPLINEH
002A69r 2  B0 03              BCS   @render                    ; (curline-1) >= topline -> EB_ROW valid
002A6Br 2  9C rr rr           STZ   EB_ROW                     ; clamp to the top visible row
002A6Er 2               @render:
002A6Er 2  4C rr rr           JMP   editbuf_render_from_row
002A71r 2               @full:
002A71r 2  4C rr rr           JMP   editbuf_render
002A74r 2               
002A74r 2               ; editbuf_render_from_row — repaint rows [EB_ROW .. VIEW_ROWS): the line at
002A74r 2               ; (topline + EB_ROW) down to the bottom of the view.
002A74r 2               editbuf_render_from_row:
002A74r 2  9C rr rr           STZ   EB_SELSTARTL
002A77r 2  9C rr rr           STZ   EB_SELSTARTH
002A7Ar 2  9C rr rr           STZ   EB_SELENDL
002A7Dr 2  9C rr rr           STZ   EB_SELENDH
002A80r 2  18                 CLC
002A81r 2  AD rr rr           LDA   EB_TOPLINEL
002A84r 2  6D rr rr           ADC   EB_ROW
002A87r 2  8D rr rr           STA   EB_SCRATCHL
002A8Ar 2  AD rr rr           LDA   EB_TOPLINEH
002A8Dr 2  69 00              ADC   #0
002A8Fr 2  8D rr rr           STA   EB_SCRATCHH
002A92r 2  20 rr rr           JSR   editbuf_offset_of_line
002A95r 2  AD rr rr           LDA   EB_LINEOFFL
002A98r 2  8D rr rr           STA   EB_VISLINEL
002A9Br 2  AD rr rr           LDA   EB_LINEOFFH
002A9Er 2  8D rr rr           STA   EB_VISLINEH
002AA1r 2  9C rr rr           STZ   EB_PAINTSTART
002AA4r 2               @loop:
002AA4r 2  AD rr rr           LDA   EB_ROW
002AA7r 2  C9 30              CMP   #EDITBUF_VIEW_ROWS
002AA9r 2  B0 08              BCS   @done
002AABr 2  20 rr rr           JSR   editbuf_render_row
002AAEr 2  EE rr rr           INC   EB_ROW
002AB1r 2  80 F1              BRA   @loop
002AB3r 2               @done:
002AB3r 2  4C rr rr           JMP   editbuf_place_cursor
002AB6r 2               
002AB6r 2               editbuf_adjust_scroll:
002AB6r 2                     ; vertical: if curline < topline -> topline = curline
002AB6r 2  AD rr rr           LDA   EB_CURLINEL
002AB9r 2  CD rr rr           CMP   EB_TOPLINEL
002ABCr 2  AD rr rr           LDA   EB_CURLINEH
002ABFr 2  ED rr rr           SBC   EB_TOPLINEH
002AC2r 2  B0 0E              BCS   @check_bottom
002AC4r 2  AD rr rr           LDA   EB_CURLINEL
002AC7r 2  8D rr rr           STA   EB_TOPLINEL
002ACAr 2  AD rr rr           LDA   EB_CURLINEH
002ACDr 2  8D rr rr           STA   EB_TOPLINEH
002AD0r 2  80 2C              BRA   @horizontal
002AD2r 2               @check_bottom:
002AD2r 2                     ; if curline >= topline + VIEW_ROWS -> topline = curline - VIEW_ROWS + 1
002AD2r 2  18                 CLC
002AD3r 2  AD rr rr           LDA   EB_TOPLINEL
002AD6r 2  69 30              ADC   #EDITBUF_VIEW_ROWS
002AD8r 2  85 rr              STA   EB_T0
002ADAr 2  AD rr rr           LDA   EB_TOPLINEH
002ADDr 2  69 00              ADC   #0
002ADFr 2  85 rr              STA   EB_T1
002AE1r 2  AD rr rr           LDA   EB_CURLINEL
002AE4r 2  C5 rr              CMP   EB_T0
002AE6r 2  AD rr rr           LDA   EB_CURLINEH
002AE9r 2  E5 rr              SBC   EB_T1
002AEBr 2  90 11              BCC   @horizontal
002AEDr 2                     ; topline = curline - (VIEW_ROWS-1)
002AEDr 2  38                 SEC
002AEEr 2  AD rr rr           LDA   EB_CURLINEL
002AF1r 2  E9 2F              SBC   #EDITBUF_VIEW_ROWS-1
002AF3r 2  8D rr rr           STA   EB_TOPLINEL
002AF6r 2  AD rr rr           LDA   EB_CURLINEH
002AF9r 2  E9 00              SBC   #0
002AFBr 2  8D rr rr           STA   EB_TOPLINEH
002AFEr 2               @horizontal:
002AFEr 2                     ; if curcol < leftcol -> leftcol = curcol
002AFEr 2  AD rr rr           LDA   EB_CURCOL
002B01r 2  CD rr rr           CMP   EB_LEFTCOL
002B04r 2  B0 04              BCS   @right
002B06r 2  8D rr rr           STA   EB_LEFTCOL
002B09r 2  60                 RTS
002B0Ar 2               @right:
002B0Ar 2                     ; if curcol >= leftcol + VIEW_COLS -> leftcol = curcol - VIEW_COLS + 1
002B0Ar 2  AD rr rr           LDA   EB_LEFTCOL
002B0Dr 2  18                 CLC
002B0Er 2  69 50              ADC   #EDITBUF_VIEW_COLS
002B10r 2  85 rr              STA   EB_T0
002B12r 2  AD rr rr           LDA   EB_CURCOL
002B15r 2  C5 rr              CMP   EB_T0
002B17r 2  90 09              BCC   @done
002B19r 2  AD rr rr           LDA   EB_CURCOL
002B1Cr 2  38                 SEC
002B1Dr 2  E9 4F              SBC   #EDITBUF_VIEW_COLS-1
002B1Fr 2  8D rr rr           STA   EB_LEFTCOL
002B22r 2               @done:
002B22r 2  60                 RTS
002B23r 2               
002B23r 2               ; =====================================================================
002B23r 2               ; Render the visible text into the body region.
002B23r 2               ; =====================================================================
002B23r 2               editbuf_render:
002B23r 2                     ; normalize selection once for cell tests
002B23r 2  AD rr rr           LDA   EDITBUF_SELACT
002B26r 2  F0 05              BEQ   @nosel
002B28r 2  20 rr rr           JSR   editbuf_normalize_selection
002B2Br 2  80 0C              BRA   @start
002B2Dr 2               @nosel:
002B2Dr 2                     ; empty selection range
002B2Dr 2  9C rr rr           STZ   EB_SELSTARTL
002B30r 2  9C rr rr           STZ   EB_SELSTARTH
002B33r 2  9C rr rr           STZ   EB_SELENDL
002B36r 2  9C rr rr           STZ   EB_SELENDH
002B39r 2               @start:
002B39r 2                     ; line being rendered = topline ; its offset:
002B39r 2  AD rr rr           LDA   EB_TOPLINEL
002B3Cr 2  8D rr rr           STA   EB_SCRATCHL
002B3Fr 2  AD rr rr           LDA   EB_TOPLINEH
002B42r 2  8D rr rr           STA   EB_SCRATCHH
002B45r 2  20 rr rr           JSR   editbuf_offset_of_line
002B48r 2  AD rr rr           LDA   EB_LINEOFFL
002B4Br 2  8D rr rr           STA   EB_VISLINEL           ; reuse EB_VISLINE as running offset
002B4Er 2  AD rr rr           LDA   EB_LINEOFFH
002B51r 2  8D rr rr           STA   EB_VISLINEH
002B54r 2  9C rr rr           STZ   EB_ROW
002B57r 2  9C rr rr           STZ   EB_PAINTSTART
002B5Ar 2               @rowloop:
002B5Ar 2  AD rr rr           LDA   EB_ROW
002B5Dr 2  C9 30              CMP   #EDITBUF_VIEW_ROWS
002B5Fr 2  B0 08              BCS   @donerows
002B61r 2  20 rr rr           JSR   editbuf_render_row
002B64r 2  EE rr rr           INC   EB_ROW
002B67r 2  80 F1              BRA   @rowloop
002B69r 2               @donerows:
002B69r 2  4C rr rr           JMP   editbuf_place_cursor
002B6Cr 2               
002B6Cr 2               ; editbuf_render_row — render screen row EB_ROW, painting columns
002B6Cr 2               ; [EB_PAINTSTART .. VIEW_COLS) from the document. EB_VISLINE = offset of this
002B6Cr 2               ; line's first byte; on exit it points to the next line's first byte.
002B6Cr 2               ;
002B6Cr 2               ; Cells are written through the VGC direct screen window one plane at a time:
002B6Cr 2               ; the row's base cell offset is computed ONCE (no per-cell multiply, no per-cell
002B6Cr 2               ; cursor sync the way vtext_put_char does), the plane is selected via $B1A0, and
002B6Cr 2               ; each pass walks a plain (zp),Y store pointer through the window ($A200+off) —
002B6Cr 2               ; one store per cell instead of the VRAM port's address+data handshake.
002B6Cr 2               editbuf_render_row:
002B6Cr 2                     ; Determine line length (chars before \n or buffer end), and fill colors.
002B6Cr 2  20 rr rr           JSR   editbuf_measure_line   ; EB_LINELEN set; HL colors filled
002B6Fr 2                     ; EB_CELL = plane offset of the first painted cell:
002B6Fr 2                     ;   (VIEW_TOP + EB_ROW) * 80 + VIEW_LEFT + EB_PAINTSTART
002B6Fr 2  A9 01              LDA   #EDITBUF_VIEW_TOP
002B71r 2  18                 CLC
002B72r 2  6D rr rr           ADC   EB_ROW
002B75r 2  85 rr              STA   EB_T0                 ; absolute screen row (<= 47)
002B77r 2  0A                 ASL
002B78r 2  0A                 ASL
002B79r 2  18                 CLC
002B7Ar 2  65 rr              ADC   EB_T0                 ; row * 5 (<= 235, fits 8 bits)
002B7Cr 2  8D rr rr           STA   EB_CELLL
002B7Fr 2  9C rr rr           STZ   EB_CELLH
002B82r 2  0E rr rr           ASL   EB_CELLL
002B85r 2  2E rr rr           ROL   EB_CELLH
002B88r 2  0E rr rr           ASL   EB_CELLL
002B8Br 2  2E rr rr           ROL   EB_CELLH
002B8Er 2  0E rr rr           ASL   EB_CELLL
002B91r 2  2E rr rr           ROL   EB_CELLH
002B94r 2  0E rr rr           ASL   EB_CELLL
002B97r 2  2E rr rr           ROL   EB_CELLH              ; row * 80
002B9Ar 2  A9 00              LDA   #EDITBUF_VIEW_LEFT
002B9Cr 2  18                 CLC
002B9Dr 2  6D rr rr           ADC   EB_PAINTSTART
002BA0r 2  18                 CLC
002BA1r 2  6D rr rr           ADC   EB_CELLL
002BA4r 2  8D rr rr           STA   EB_CELLL
002BA7r 2  90 03              BCC   :+
002BA9r 2  EE rr rr           INC   EB_CELLH
002BACr 2               :
002BACr 2                     ; ---- char plane ----
002BACr 2  A9 00              LDA   #VGC_SCREENWIN_CHAR
002BAEr 2  20 rr rr           JSR   editbuf_win_begin      ; select window plane, point run ptr at EB_CELL
002BB1r 2  AD rr rr           LDA   EB_PAINTSTART
002BB4r 2  8D rr rr           STA   EB_COL
002BB7r 2               @charloop:
002BB7r 2  AD rr rr           LDA   EB_COL
002BBAr 2  C9 50              CMP   #EDITBUF_VIEW_COLS
002BBCr 2  B0 3C              BCS   @colorpass
002BBEr 2  AD rr rr           LDA   EB_LEFTCOL
002BC1r 2  18                 CLC
002BC2r 2  6D rr rr           ADC   EB_COL
002BC5r 2  85 rr              STA   EB_T0                 ; src col
002BC7r 2  CD rr rr           CMP   EB_LINELEN
002BCAr 2  B0 24              BCS   @charblank
002BCCr 2                     ; char = BUF[EB_VISLINE + srccol]
002BCCr 2  AD rr rr           LDA   EB_VISLINEL
002BCFr 2  18                 CLC
002BD0r 2  65 rr              ADC   EB_T0
002BD2r 2  85 rr              STA   EB_PL
002BD4r 2  AD rr rr           LDA   EB_VISLINEH
002BD7r 2  69 00              ADC   #0
002BD9r 2  85 rr              STA   EB_PH
002BDBr 2  AD rr rr           LDA   EDITBUF_BUFL
002BDEr 2  18                 CLC
002BDFr 2  65 rr              ADC   EB_PL
002BE1r 2  85 rr              STA   EB_PL
002BE3r 2  AD rr rr           LDA   EDITBUF_BUFH
002BE6r 2  65 rr              ADC   EB_PH
002BE8r 2  85 rr              STA   EB_PH
002BEAr 2  A0 00              LDY   #0
002BECr 2  B1 rr              LDA   (EB_PL),Y
002BEEr 2  80 02              BRA   @charput
002BF0r 2               @charblank:
002BF0r 2  A9 20              LDA   #' '
002BF2r 2               @charput:
002BF2r 2  20 rr rr           JSR   editbuf_win_put        ; store A at the window cell, advance run ptr
002BF5r 2  EE rr rr           INC   EB_COL
002BF8r 2  80 BD              BRA   @charloop
002BFAr 2               
002BFAr 2                     ; ---- color plane ----
002BFAr 2               @colorpass:
002BFAr 2  A9 01              LDA   #VGC_SCREENWIN_COLOR
002BFCr 2  20 rr rr           JSR   editbuf_win_begin
002BFFr 2  AD rr rr           LDA   EB_PAINTSTART
002C02r 2  8D rr rr           STA   EB_COL
002C05r 2               @colorloop:
002C05r 2  AD rr rr           LDA   EB_COL
002C08r 2  C9 50              CMP   #EDITBUF_VIEW_COLS
002C0Ar 2  B0 37              BCS   @attrpass
002C0Cr 2  AD rr rr           LDA   EB_LEFTCOL
002C0Fr 2  18                 CLC
002C10r 2  6D rr rr           ADC   EB_COL
002C13r 2  85 rr              STA   EB_T0                 ; src col
002C15r 2  CD rr rr           CMP   EB_LINELEN
002C18r 2  B0 1F              BCS   @colorblank
002C1Ar 2                     ; abs offset = EB_VISLINE + srccol -> EB_SRC (for selection test)
002C1Ar 2  AD rr rr           LDA   EB_VISLINEL
002C1Dr 2  18                 CLC
002C1Er 2  65 rr              ADC   EB_T0
002C20r 2  85 rr              STA   EB_SRCL
002C22r 2  AD rr rr           LDA   EB_VISLINEH
002C25r 2  69 00              ADC   #0
002C27r 2  85 rr              STA   EB_SRCH
002C29r 2  20 rr rr           JSR   editbuf_cell_in_selection   ; carry set if in selection
002C2Cr 2  90 04              BCC   @colornormal
002C2Er 2  A9 1F              LDA   #EDITBUF_COLOR_SEL
002C30r 2  80 09              BRA   @colorput
002C32r 2               @colornormal:
002C32r 2  A6 rr              LDX   EB_T0
002C34r 2  BD rr rr           LDA   EDITBUF_HL_COLORS,X
002C37r 2  80 02              BRA   @colorput
002C39r 2               @colorblank:
002C39r 2  A9 01              LDA   #EDITBUF_COLOR_TEXT
002C3Br 2               @colorput:
002C3Br 2  20 rr rr           JSR   editbuf_win_put
002C3Er 2  EE rr rr           INC   EB_COL
002C41r 2  80 C2              BRA   @colorloop
002C43r 2               
002C43r 2                     ; ---- attribute plane (always 0 in the body) ----
002C43r 2               @attrpass:
002C43r 2  A9 02              LDA   #VGC_SCREENWIN_ATTR
002C45r 2  20 rr rr           JSR   editbuf_win_begin
002C48r 2  AD rr rr           LDA   EB_PAINTSTART
002C4Br 2  8D rr rr           STA   EB_COL
002C4Er 2               @attrloop:
002C4Er 2  AD rr rr           LDA   EB_COL
002C51r 2  C9 50              CMP   #EDITBUF_VIEW_COLS
002C53r 2  B0 0A              BCS   @done
002C55r 2  A9 00              LDA   #0
002C57r 2  20 rr rr           JSR   editbuf_win_put
002C5Ar 2  EE rr rr           INC   EB_COL
002C5Dr 2  80 EF              BRA   @attrloop
002C5Fr 2               @done:
002C5Fr 2                     ; advance EB_VISLINE to next line: skip to and over the \n (if any)
002C5Fr 2  20 rr rr           JSR   editbuf_advance_to_next_line
002C62r 2  60                 RTS
002C63r 2               
002C63r 2               ; editbuf_win_begin — select window plane A ($B1A0: 0=char/1=color/2=attr) and
002C63r 2               ; seed the zero-page run pointer EB_RUN at the window address of the row's first
002C63r 2               ; painted cell (VGC_SCREENWIN + EB_CELL). editbuf_win_put then writes one cell.
002C63r 2               editbuf_win_begin:
002C63r 2  8D A0 B1           STA   VGC_SCREENWIN_PLANE
002C66r 2  AD rr rr           LDA   EB_CELLL
002C69r 2  18                 CLC
002C6Ar 2  69 00              ADC   #<VGC_SCREENWIN
002C6Cr 2  85 rr              STA   EB_RUNL
002C6Er 2  AD rr rr           LDA   EB_CELLH
002C71r 2  69 A2              ADC   #>VGC_SCREENWIN
002C73r 2  85 rr              STA   EB_RUNH
002C75r 2  60                 RTS
002C76r 2               
002C76r 2               ; editbuf_win_put — store A at the window cell EB_RUN points to (a plain store,
002C76r 2               ; no port handshake), then advance EB_RUN by one. A is preserved.
002C76r 2               editbuf_win_put:
002C76r 2  A0 00              LDY   #0
002C78r 2  91 rr              STA   (EB_RUNL),Y
002C7Ar 2  E6 rr              INC   EB_RUNL
002C7Cr 2  D0 02              BNE   :+
002C7Er 2  E6 rr              INC   EB_RUNH
002C80r 2  60           :     RTS
002C81r 2               
002C81r 2               ; editbuf_cell_in_selection — EB_SRC = absolute offset of cell.
002C81r 2               ;   carry set if SELSTART <= off < SELEND (and selection active).
002C81r 2               editbuf_cell_in_selection:
002C81r 2  AD rr rr           LDA   EDITBUF_SELACT
002C84r 2  D0 02              BNE   :+
002C86r 2  18                 CLC
002C87r 2  60                 RTS
002C88r 2               :     ; off >= selstart ?
002C88r 2  A5 rr              LDA   EB_SRCL
002C8Ar 2  CD rr rr           CMP   EB_SELSTARTL
002C8Dr 2  A5 rr              LDA   EB_SRCH
002C8Fr 2  ED rr rr           SBC   EB_SELSTARTH
002C92r 2  90 0C              BCC   @no                   ; off < start
002C94r 2                     ; off < selend ?
002C94r 2  A5 rr              LDA   EB_SRCL
002C96r 2  CD rr rr           CMP   EB_SELENDL
002C99r 2  A5 rr              LDA   EB_SRCH
002C9Br 2  ED rr rr           SBC   EB_SELENDH
002C9Er 2  90 02              BCC   @yes                  ; off < end
002CA0r 2               @no:
002CA0r 2  18                 CLC
002CA1r 2  60                 RTS
002CA2r 2               @yes:
002CA2r 2  38                 SEC
002CA3r 2  60                 RTS
002CA4r 2               
002CA4r 2               ; editbuf_measure_line — measure current line (offset EB_VISLINE): set EB_LINELEN
002CA4r 2               ;   to chars before \n (clamped 80), pre-fill HL_COLORS with default, then call
002CA4r 2               ;   the HILITE hook.
002CA4r 2               editbuf_measure_line:
002CA4r 2                     ; pre-fill colors with default
002CA4r 2  A2 4F              LDX   #79
002CA6r 2  A9 01              LDA   #EDITBUF_COLOR_TEXT
002CA8r 2  9D rr rr     :     STA   EDITBUF_HL_COLORS,X
002CABr 2  CA                 DEX
002CACr 2  10 FA              BPL   :-
002CAEr 2                     ; scan line length
002CAEr 2  AD rr rr           LDA   EB_VISLINEL
002CB1r 2  8D rr rr           STA   EB_SCRATCHL
002CB4r 2  AD rr rr           LDA   EB_VISLINEH
002CB7r 2  8D rr rr           STA   EB_SCRATCHH
002CBAr 2  A2 00              LDX   #0
002CBCr 2               @scan:
002CBCr 2                     ; offset >= len ?
002CBCr 2  AD rr rr           LDA   EB_SCRATCHL
002CBFr 2  CD rr rr           CMP   EDITBUF_LENL
002CC2r 2  AD rr rr           LDA   EB_SCRATCHH
002CC5r 2  ED rr rr           SBC   EDITBUF_LENH
002CC8r 2  B0 1A              BCS   @done
002CCAr 2  20 rr rr           JSR   editbuf_src_from_scratch
002CCDr 2  A0 00              LDY   #0
002CCFr 2  B1 rr              LDA   (EB_SRCL),Y
002CD1r 2  C9 0A              CMP   #$0A
002CD3r 2  F0 0F              BEQ   @done
002CD5r 2  E8                 INX
002CD6r 2  E0 50              CPX   #80
002CD8r 2  B0 0A              BCS   @done
002CDAr 2  EE rr rr           INC   EB_SCRATCHL
002CDDr 2  D0 DD              BNE   @scan
002CDFr 2  EE rr rr           INC   EB_SCRATCHH
002CE2r 2  80 D8              BRA   @scan
002CE4r 2               @done:
002CE4r 2  8E rr rr           STX   EB_LINELEN
002CE7r 2                     ; set HL hook inputs
002CE7r 2  AD rr rr           LDA   EDITBUF_BUFL
002CEAr 2  18                 CLC
002CEBr 2  6D rr rr           ADC   EB_VISLINEL
002CEEr 2  85 rr              STA   EDITBUF_HL_PTR
002CF0r 2  AD rr rr           LDA   EDITBUF_BUFH
002CF3r 2  6D rr rr           ADC   EB_VISLINEH
002CF6r 2  85 rr              STA   EDITBUF_HL_PTR+1
002CF8r 2  AD rr rr           LDA   EB_LINELEN
002CFBr 2  8D rr rr           STA   EDITBUF_HL_LEN
002CFEr 2  4C rr rr           JMP   editbuf_call_hilite
002D01r 2               
002D01r 2               ; editbuf_advance_to_next_line — move EB_VISLINE past the current line's \n.
002D01r 2               editbuf_advance_to_next_line:
002D01r 2               @scan:
002D01r 2  AD rr rr           LDA   EB_VISLINEL
002D04r 2  CD rr rr           CMP   EDITBUF_LENL
002D07r 2  AD rr rr           LDA   EB_VISLINEH
002D0Ar 2  ED rr rr           SBC   EDITBUF_LENH
002D0Dr 2  B0 1F              BCS   @done                 ; at end
002D0Fr 2  AD rr rr           LDA   EB_VISLINEL
002D12r 2  8D rr rr           STA   EB_SCRATCHL
002D15r 2  AD rr rr           LDA   EB_VISLINEH
002D18r 2  8D rr rr           STA   EB_SCRATCHH
002D1Br 2  20 rr rr           JSR   editbuf_src_from_scratch
002D1Er 2  A0 00              LDY   #0
002D20r 2  B1 rr              LDA   (EB_SRCL),Y
002D22r 2                     ; advance
002D22r 2  EE rr rr           INC   EB_VISLINEL
002D25r 2  D0 03              BNE   :+
002D27r 2  EE rr rr           INC   EB_VISLINEH
002D2Ar 2  C9 0A        :     CMP   #$0A
002D2Cr 2  D0 D3              BNE   @scan
002D2Er 2               @done:
002D2Er 2  60                 RTS
002D2Fr 2               
002D2Fr 2               ; editbuf_place_cursor — set hw cursor at the on-screen cursor position.
002D2Fr 2               editbuf_place_cursor:
002D2Fr 2                     ; screen x = VIEW_LEFT + (curcol - leftcol)
002D2Fr 2  AD rr rr           LDA   EB_CURCOL
002D32r 2  38                 SEC
002D33r 2  ED rr rr           SBC   EB_LEFTCOL
002D36r 2  18                 CLC
002D37r 2  69 00              ADC   #EDITBUF_VIEW_LEFT
002D39r 2  8D 03 A0           STA   VGC_CURSX
002D3Cr 2                     ; screen y = VIEW_TOP + (curline - topline)
002D3Cr 2  38                 SEC
002D3Dr 2  AD rr rr           LDA   EB_CURLINEL
002D40r 2  ED rr rr           SBC   EB_TOPLINEL
002D43r 2                     ; (assume within view; high bytes equal after scroll adjust)
002D43r 2  18                 CLC
002D44r 2  69 01              ADC   #EDITBUF_VIEW_TOP
002D46r 2  8D 04 A0           STA   VGC_CURSY
002D49r 2  A9 01              LDA   #1
002D4Br 2  8D 0A A0           STA   VGC_CURSEN
002D4Er 2  60                 RTS
002D4Fr 2               
002D4Fr 2               ; =====================================================================
002D4Fr 2               ; Dirty handling
002D4Fr 2               ; =====================================================================
002D4Fr 2               editbuf_mark_dirty:
002D4Fr 2  AD rr rr           LDA   EDITUI_DIRTY
002D52r 2  D0 08              BNE   @done
002D54r 2  A9 01              LDA   #1
002D56r 2  8D rr rr           STA   EDITUI_DIRTY
002D59r 2  20 rr rr           JSR   editui_refresh_dirty
002D5Cr 2               @done:
002D5Cr 2  60                 RTS
002D5Dr 2               
002D5Dr 2               ; =====================================================================
002D5Dr 2               ; Save / quit
002D5Dr 2               ; =====================================================================
002D5Dr 2               editbuf_do_save:
002D5Dr 2  20 rr rr           JSR   editbuf_call_save        ; A = status
002D60r 2  C9 00              CMP   #EDITBUF_SAVE_OK
002D62r 2  D0 06              BNE   @notok
002D64r 2  9C rr rr           STZ   EDITUI_DIRTY
002D67r 2  20 rr rr           JSR   editui_refresh_dirty
002D6Ar 2               @notok:
002D6Ar 2  20 rr rr           JSR   editbuf_apply_status
002D6Dr 2  20 rr rr           JSR   editui_draw_status
002D70r 2  4C rr rr           JMP   editbuf_place_cursor
002D73r 2               
002D73r 2               ; editbuf_do_quit — returns carry set to exit the editor, clear to stay.
002D73r 2               editbuf_do_quit:
002D73r 2  AD rr rr           LDA   EDITUI_DIRTY
002D76r 2  D0 07              BNE   @dirty
002D78r 2  A9 00              LDA   #EDITBUF_EXIT_QUIT
002D7Ar 2  8D rr rr           STA   EDITBUF_RESULT
002D7Dr 2  38                 SEC
002D7Er 2  60                 RTS
002D7Fr 2               @dirty:
002D7Fr 2  20 rr rr           JSR   editbuf_dialog3          ; A = 0 exit / 1 save / 2 cancel
002D82r 2  C9 02              CMP   #EDITBUF_DLG_CANCEL
002D84r 2  F0 2A              BEQ   @stay
002D86r 2  C9 01              CMP   #EDITBUF_DLG_SAVE
002D88r 2  F0 07              BEQ   @savefirst
002D8Ar 2                     ; exit anyway
002D8Ar 2  A9 02              LDA   #EDITBUF_EXIT_DISCARD
002D8Cr 2  8D rr rr           STA   EDITBUF_RESULT
002D8Fr 2  38                 SEC
002D90r 2  60                 RTS
002D91r 2               @savefirst:
002D91r 2  20 rr rr           JSR   editbuf_call_save
002D94r 2  C9 00              CMP   #EDITBUF_SAVE_OK
002D96r 2  D0 0A              BNE   @save_failed
002D98r 2  9C rr rr           STZ   EDITUI_DIRTY
002D9Br 2  A9 01              LDA   #EDITBUF_EXIT_SAVED
002D9Dr 2  8D rr rr           STA   EDITBUF_RESULT
002DA0r 2  38                 SEC
002DA1r 2  60                 RTS
002DA2r 2               @save_failed:
002DA2r 2                     ; stay in editor showing the host's status message
002DA2r 2  20 rr rr           JSR   editbuf_redraw_all
002DA5r 2  20 rr rr           JSR   editbuf_apply_status
002DA8r 2  20 rr rr           JSR   editui_draw_status
002DABr 2  20 rr rr           JSR   editbuf_place_cursor
002DAEr 2  18                 CLC
002DAFr 2  60                 RTS
002DB0r 2               @stay:
002DB0r 2  20 rr rr           JSR   editbuf_redraw_all
002DB3r 2  18                 CLC
002DB4r 2  60                 RTS
002DB5r 2               
002DB5r 2               ; editbuf_redraw_all — full repaint after a dialog (chrome + body + cursor).
002DB5r 2               editbuf_redraw_all:
002DB5r 2  20 rr rr           JSR   editui_draw_shell
002DB8r 2  4C rr rr           JMP   editbuf_render
002DBBr 2               
002DBBr 2               ; =====================================================================
002DBBr 2               ; Three-choice modal dialog (restore-under). Returns A = 0/1/2.
002DBBr 2               ; =====================================================================
002DBBr 2               EB_DLG_X     = 15
002DBBr 2               EB_DLG_Y     = 20
002DBBr 2               EB_DLG_W     = 50
002DBBr 2               EB_DLG_H     = 9
002DBBr 2               
002DBBr 2               editbuf_dialog3:
002DBBr 2  9C rr rr           STZ   EB_DLGSEL
002DBEr 2                     ; set save-under region to the dialog rect and capture it
002DBEr 2  A9 0F              LDA   #EB_DLG_X
002DC0r 2  8D rr rr           STA   EDITUI_MENU_SAVE_X
002DC3r 2  A9 14              LDA   #EB_DLG_Y
002DC5r 2  8D rr rr           STA   EDITUI_MENU_SAVE_Y
002DC8r 2  A9 32              LDA   #EB_DLG_W
002DCAr 2  8D rr rr           STA   EDITUI_MENU_SAVE_W
002DCDr 2  A9 09              LDA   #EB_DLG_H
002DCFr 2  8D rr rr           STA   EDITUI_MENU_SAVE_H
002DD2r 2  20 rr rr           JSR   editui_save_under
002DD5r 2                     ; draw dialog frame
002DD5r 2  A9 0F              LDA   #EB_DLG_X
002DD7r 2  8D rr rr           STA   EDITUI_BOXX
002DDAr 2  A9 14              LDA   #EB_DLG_Y
002DDCr 2  8D rr rr           STA   EDITUI_BOXY
002DDFr 2  A9 32              LDA   #EB_DLG_W
002DE1r 2  8D rr rr           STA   EDITUI_BOXW
002DE4r 2  A9 09              LDA   #EB_DLG_H
002DE6r 2  8D rr rr           STA   EDITUI_BOXH
002DE9r 2  A9 01              LDA   #EDITUI_BOX_DOUBLE
002DEBr 2  8D rr rr           STA   EDITUI_BOX_STYLE
002DEEr 2  A9 rr              LDA   #<editbuf_dlg_title
002DF0r 2  8D rr rr           STA   EDITUI_BOX_TITLEL
002DF3r 2  A9 rr              LDA   #>editbuf_dlg_title
002DF5r 2  8D rr rr           STA   EDITUI_BOX_TITLEH
002DF8r 2  20 rr rr           JSR   editui_draw_box
002DFBr 2                     ; clear the dialog interior (box vars still hold the dialog rect)
002DFBr 2  20 rr rr           JSR   editui_select_box_body
002DFEr 2  A9 0F              LDA   #EDITUI_COLOR_PANEL
002E00r 2  8D rr rr           STA   VTEXT_COLOR
002E03r 2  9C rr rr           STZ   VTEXT_ATTR
002E06r 2  A9 20              LDA   #' '
002E08r 2  8D rr rr           STA   VTEXT_CHAR
002E0Br 2  20 rr rr           JSR   vtext_clear_region
002E0Er 2                     ; message line
002E0Er 2  A9 rr              LDA   #<editbuf_dlg_msg
002E10r 2  8D rr rr           STA   EDITUI_PRINTL
002E13r 2  A9 rr              LDA   #>editbuf_dlg_msg
002E15r 2  8D rr rr           STA   EDITUI_PRINTH
002E18r 2  A9 12              LDA   #EB_DLG_X+3
002E1Ar 2  8D rr rr           STA   EDITUI_PRINTX
002E1Dr 2  A9 16              LDA   #EB_DLG_Y+2
002E1Fr 2  8D rr rr           STA   EDITUI_PRINTY
002E22r 2  A9 01              LDA   #EDITUI_COLOR_TITLE
002E24r 2  8D rr rr           STA   VTEXT_COLOR
002E27r 2  20 rr rr           JSR   editui_print_ptr
002E2Ar 2  20 rr rr           JSR   editbuf_dialog_draw_buttons
002E2Dr 2               @wait:
002E2Dr 2  AD 0F A0           LDA   VGC_CHARIN
002E30r 2  F0 FB              BEQ   @wait
002E32r 2  C9 1C              CMP   #EDITUI_KEY_LEFT
002E34r 2  F0 31              BEQ   @left
002E36r 2  C9 1D              CMP   #EDITUI_KEY_RIGHT
002E38r 2  F0 3D              BEQ   @right
002E3Ar 2  C9 09              CMP   #EDITUI_KEY_TAB
002E3Cr 2  F0 39              BEQ   @right
002E3Er 2  C9 0D              CMP   #EDITUI_KEY_ENTER
002E40r 2  F0 4C              BEQ   @choose
002E42r 2  C9 1B              CMP   #EDITUI_KEY_ESC
002E44r 2  F0 43              BEQ   @cancel
002E46r 2                     ; hotkeys: e/s/c (and upper)
002E46r 2  09 20              ORA   #$20
002E48r 2  C9 65              CMP   #'e'
002E4Ar 2  D0 05              BNE   :+
002E4Cr 2  9C rr rr           STZ   EB_DLGSEL
002E4Fr 2  80 3D              BRA   @choose
002E51r 2  C9 73        :     CMP   #'s'
002E53r 2  D0 07              BNE   :+
002E55r 2  A9 01              LDA   #1
002E57r 2  8D rr rr           STA   EB_DLGSEL
002E5Ar 2  80 32              BRA   @choose
002E5Cr 2  C9 63        :     CMP   #'c'
002E5Er 2  D0 CD              BNE   @wait
002E60r 2  A9 02              LDA   #2
002E62r 2  8D rr rr           STA   EB_DLGSEL
002E65r 2  80 27              BRA   @choose
002E67r 2               @left:
002E67r 2  AD rr rr           LDA   EB_DLGSEL
002E6Ar 2  D0 02              BNE   :+
002E6Cr 2  A9 03              LDA   #3
002E6Er 2  3A           :     DEC   A
002E6Fr 2  8D rr rr           STA   EB_DLGSEL
002E72r 2  20 rr rr           JSR   editbuf_dialog_draw_buttons
002E75r 2  80 B6              BRA   @wait
002E77r 2               @right:
002E77r 2  AD rr rr           LDA   EB_DLGSEL
002E7Ar 2  1A                 INC   A
002E7Br 2  C9 03              CMP   #3
002E7Dr 2  90 02              BCC   :+
002E7Fr 2  A9 00              LDA   #0
002E81r 2  8D rr rr     :     STA   EB_DLGSEL
002E84r 2  20 rr rr           JSR   editbuf_dialog_draw_buttons
002E87r 2  80 A4              BRA   @wait
002E89r 2               @cancel:
002E89r 2  A9 02              LDA   #2
002E8Br 2  8D rr rr           STA   EB_DLGSEL
002E8Er 2               @choose:
002E8Er 2  20 rr rr           JSR   editui_restore_under
002E91r 2  AD rr rr           LDA   EB_DLGSEL
002E94r 2  60                 RTS
002E95r 2               
002E95r 2               ; Draw the three buttons, highlighting EB_DLGSEL.
002E95r 2               editbuf_dialog_draw_buttons:
002E95r 2  A9 00              LDA   #0
002E97r 2  85 rr              STA   EB_T0                 ; button index
002E99r 2  A9 rr              LDA   #<editbuf_dlg_btn0
002E9Br 2  85 rr              STA   EB_PL
002E9Dr 2  A9 rr              LDA   #>editbuf_dlg_btn0
002E9Fr 2  85 rr              STA   EB_PH
002EA1r 2               @draw:
002EA1r 2                     ; X position per button
002EA1r 2  A6 rr              LDX   EB_T0
002EA3r 2  BD rr rr           LDA   editbuf_dlg_btn_x,X
002EA6r 2  8D rr rr           STA   EDITUI_PRINTX
002EA9r 2  A9 19              LDA   #EB_DLG_Y+5
002EABr 2  8D rr rr           STA   EDITUI_PRINTY
002EAEr 2                     ; color: selected?
002EAEr 2  A5 rr              LDA   EB_T0
002EB0r 2  CD rr rr           CMP   EB_DLGSEL
002EB3r 2  D0 04              BNE   @normal
002EB5r 2  A9 1F              LDA   #EDITUI_COLOR_MENU_SEL
002EB7r 2  80 02              BRA   @setc
002EB9r 2               @normal:
002EB9r 2  A9 0C              LDA   #EDITUI_COLOR_DIM
002EBBr 2               @setc:
002EBBr 2  8D rr rr           STA   VTEXT_COLOR
002EBEr 2                     ; print label (split low/high byte pointer tables, indexed by button #)
002EBEr 2  A6 rr              LDX   EB_T0
002EC0r 2  BD rr rr           LDA   editbuf_dlg_btn_lo,X
002EC3r 2  8D rr rr           STA   EDITUI_PRINTL
002EC6r 2  BD rr rr           LDA   editbuf_dlg_btn_hi,X
002EC9r 2  8D rr rr           STA   EDITUI_PRINTH
002ECCr 2  20 rr rr           JSR   editui_print_ptr
002ECFr 2  E6 rr              INC   EB_T0
002ED1r 2  A5 rr              LDA   EB_T0
002ED3r 2  C9 03              CMP   #3
002ED5r 2  90 CA              BCC   @draw
002ED7r 2  60                 RTS
002ED8r 2               
002ED8r 2               ; =====================================================================
002ED8r 2               ; Hook invocation (indirect JSR via vector; default no-ops)
002ED8r 2               ; =====================================================================
002ED8r 2               ; editbuf_init_vectors — default any unset hook vector to a no-op.
002ED8r 2               editbuf_init_vectors:
002ED8r 2  AD rr rr           LDA   EDITBUF_SAVE_VECL
002EDBr 2  0D rr rr           ORA   EDITBUF_SAVE_VECH
002EDEr 2  D0 0A              BNE   :+
002EE0r 2  A9 rr              LDA   #<editbuf_default_save
002EE2r 2  8D rr rr           STA   EDITBUF_SAVE_VECL
002EE5r 2  A9 rr              LDA   #>editbuf_default_save
002EE7r 2  8D rr rr           STA   EDITBUF_SAVE_VECH
002EEAr 2  AD rr rr     :     LDA   EDITBUF_INDENT_VECL
002EEDr 2  0D rr rr           ORA   EDITBUF_INDENT_VECH
002EF0r 2  D0 0A              BNE   :+
002EF2r 2  A9 rr              LDA   #<editbuf_default_indent
002EF4r 2  8D rr rr           STA   EDITBUF_INDENT_VECL
002EF7r 2  A9 rr              LDA   #>editbuf_default_indent
002EF9r 2  8D rr rr           STA   EDITBUF_INDENT_VECH
002EFCr 2  AD rr rr     :     LDA   EDITBUF_HILITE_VECL
002EFFr 2  0D rr rr           ORA   EDITBUF_HILITE_VECH
002F02r 2  D0 0A              BNE   :+
002F04r 2  A9 rr              LDA   #<editbuf_default_hilite
002F06r 2  8D rr rr           STA   EDITBUF_HILITE_VECL
002F09r 2  A9 rr              LDA   #>editbuf_default_hilite
002F0Br 2  8D rr rr           STA   EDITBUF_HILITE_VECH
002F0Er 2  AD rr rr     :     LDA   EDITBUF_MENU_VECL
002F11r 2  0D rr rr           ORA   EDITBUF_MENU_VECH
002F14r 2  D0 0A              BNE   :+
002F16r 2  A9 rr              LDA   #<editbuf_default_menu
002F18r 2  8D rr rr           STA   EDITBUF_MENU_VECL
002F1Br 2  A9 rr              LDA   #>editbuf_default_menu
002F1Dr 2  8D rr rr           STA   EDITBUF_MENU_VECH
002F20r 2  60           :     RTS
002F21r 2               
002F21r 2               editbuf_call_menu:
002F21r 2  6C rr rr           JMP   (EDITBUF_MENU_VECL)
002F24r 2               
002F24r 2               editbuf_call_save:
002F24r 2  6C rr rr           JMP   (EDITBUF_SAVE_VECL)
002F27r 2               
002F27r 2               editbuf_call_indent:
002F27r 2  6C rr rr           JMP   (EDITBUF_INDENT_VECL)
002F2Ar 2               
002F2Ar 2               editbuf_call_hilite:
002F2Ar 2  6C rr rr           JMP   (EDITBUF_HILITE_VECL)
002F2Dr 2               
002F2Dr 2               ; default hook bodies (host may point vectors here)
002F2Dr 2                     .export editbuf_default_save
002F2Dr 2                     .export editbuf_default_indent
002F2Dr 2                     .export editbuf_default_hilite
002F2Dr 2                     .export editbuf_default_menu
002F2Dr 2               editbuf_default_save:
002F2Dr 2  A9 00              LDA   #EDITBUF_SAVE_OK
002F2Fr 2  60                 RTS
002F30r 2               editbuf_default_indent:
002F30r 2  A9 00              LDA   #0
002F32r 2  60                 RTS
002F33r 2               editbuf_default_hilite:
002F33r 2  60                 RTS
002F34r 2               ; Default MENU hook: keep EDITUI's default menus. A host runtime points
002F34r 2               ; EDITBUF_MENU_VECL/H at its own routine which calls editui_set_menus (and,
002F34r 2               ; later, the per-item enable/disable API) to tailor the menu for its tools.
002F34r 2               editbuf_default_menu:
002F34r 2  60                 RTS
002F35r 2               
002F35r 2               ; =====================================================================
002F35r 2               ; RODATA
002F35r 2               ; =====================================================================
002F35r 2                     .segment "RODATA"
000192r 2               
