000000r 2               VSPRITE_DESC_SRCSPACE    = $0B
000000r 2               VSPRITE_DESC_SRCADDRL    = $0C
000000r 2               VSPRITE_DESC_SRCADDRM    = $0D
000000r 2               VSPRITE_DESC_SRCADDRH    = $0E
000000r 2               VSPRITE_DESC_SRCSTRL     = $0F
000000r 2               VSPRITE_DESC_SRCSTRH     = $10
000000r 2               VSPRITE_DESC_BGSPACE     = $11
000000r 2               VSPRITE_DESC_BGADDRL     = $12
