000C6Ar 3               
000C6Ar 2               .include "blitter.s"
000C6Ar 3               ; Shared Nova blitter helper routines.
000C6Ar 3               ;
000C6Ar 3               ; Callers load the BLT hardware registers, then call blitter_start_copy or
000C6Ar 3               ; blitter_start_fill. Routines return A=0 on success and A=1 on error; detailed
000C6Ar 3               ; errors remain in BLT_ERRCODE_REG.
000C6Ar 3               
000C6Ar 3               .include "blitter.inc"
000C6Ar 4               ; Shared Nova blitter helper declarations.
000C6Ar 4               
000C6Ar 4               .ifndef BLITTER_INC_INCLUDED
000C6Ar 4               BLITTER_INC_INCLUDED = 1
000C6Ar 4               
000C6Ar 4               .include "nova.inc"
000C6Ar 4               
000C6Ar 4               BLITTER_RESULT_OK    = $00
000C6Ar 4               BLITTER_RESULT_ERROR = $01
000C6Ar 4               
000C6Ar 4               .endif
000C6Ar 4               
000C6Ar 3               
000C6Ar 3               .ifndef BLITTER_IMPLEMENTATION_INCLUDED
000C6Ar 3               BLITTER_IMPLEMENTATION_INCLUDED = 1
000C6Ar 3               
000C6Ar 3                     .segment "CODE"
000C6Ar 3               
000C6Ar 3                     .export blitter_copy
000C6Ar 3                     .export blitter_fill
000C6Ar 3                     .export blitter_start_copy
000C6Ar 3                     .export blitter_start_fill
000C6Ar 3                     .export blitter_wait
000C6Ar 3               
000C6Ar 3               ; @label BLITTER.COPY
000C6Ar 3               ; @kind routine
000C6Ar 3               ; @symbol blitter_copy
000C6Ar 3               ; @summary Start a rectangular blitter copy using the BLT controller registers.
000C6Ar 3               ; @requires BLT_SRCSPACE BLT_DSTSPACE BLT_SRCL BLT_SRCM BLT_SRCH BLT_DSTL BLT_DSTM BLT_DSTH BLT_WIDTHL BLT_WIDTHH BLT_HEIGHTL BLT_HEIGHTH BLT_SRCSTRL BLT_SRCSTRH BLT_DSTSTRL BLT_DSTSTRH
000C6Ar 3               ; @out A: 0 on success, 1 on error.
000C6Ar 3               blitter_copy:
000C6Ar 3  4C rr rr           JMP   blitter_start_copy
000C6Dr 3               
000C6Dr 3               ; @label BLITTER.FILL
000C6Dr 3               ; @kind routine
000C6Dr 3               ; @symbol blitter_fill
000C6Dr 3               ; @summary Start a rectangular blitter fill using destination, size, stride, and fill registers.
000C6Dr 3               ; @requires BLT_DSTSPACE BLT_DSTL BLT_DSTM BLT_DSTH BLT_WIDTHL BLT_WIDTHH BLT_HEIGHTL BLT_HEIGHTH BLT_DSTSTRL BLT_DSTSTRH BLT_FILLVALUE
000C6Dr 3               ; @out A: 0 on success, 1 on error.
000C6Dr 3               blitter_fill:
000C6Dr 3  9C 86 BA           STZ   BLT_SRCSPACE
000C70r 3  9C 88 BA           STZ   BLT_SRCL
000C73r 3  9C 89 BA           STZ   BLT_SRCM
000C76r 3  9C 8A BA           STZ   BLT_SRCH
000C79r 3  9C 92 BA           STZ   BLT_SRCSTRL
000C7Cr 3  9C 93 BA           STZ   BLT_SRCSTRH
000C7Fr 3  9C 98 BA           STZ   BLT_CKEY
000C82r 3  4C rr rr           JMP   blitter_start_fill
000C85r 3               
000C85r 3               ; @label BLITTER.START_COPY
000C85r 3               ; @kind routine
000C85r 3               ; @symbol blitter_start_copy
000C85r 3               ; @summary Low-level blitter copy start. Call BLITTER.COPY for the public wrapper.
000C85r 3               ; @out A: 0 on success, 1 on error.
000C85r 3               blitter_start_copy:
000C85r 3  9C 96 BA           STZ   BLT_MODE_REG
000C88r 3  9C 98 BA           STZ   BLT_CKEY
000C8Br 3  A9 01              LDA   #BLT_CMD_START
000C8Dr 3  8D 83 BA           STA   BLT_CMD_REG
000C90r 3  4C rr rr           JMP   blitter_wait
000C93r 3               
000C93r 3               ; @label BLITTER.START_FILL
000C93r 3               ; @kind routine
000C93r 3               ; @symbol blitter_start_fill
000C93r 3               ; @summary Low-level blitter fill start. Call BLITTER.FILL for the public wrapper.
000C93r 3               ; @out A: 0 on success, 1 on error.
000C93r 3               blitter_start_fill:
000C93r 3  A9 01              LDA   #BLT_MODE_FILL
000C95r 3  8D 96 BA           STA   BLT_MODE_REG
000C98r 3  A9 01              LDA   #BLT_CMD_START
000C9Ar 3  8D 83 BA           STA   BLT_CMD_REG
000C9Dr 3  4C rr rr           JMP   blitter_wait
000CA0r 3               
000CA0r 3               ; @label BLITTER.WAIT
000CA0r 3               ; @kind routine
000CA0r 3               ; @symbol blitter_wait
000CA0r 3               ; @summary Wait for the blitter controller to leave BUSY and return shared status.
000CA0r 3               ; @out A: 0 on success, 1 on error.
000CA0r 3               blitter_wait:
000CA0r 3               @loop:
000CA0r 3  AD 84 BA           LDA   BLT_STATUS_REG
000CA3r 3  C9 01              CMP   #BLT_STATUS_BUSY
000CA5r 3  F0 F9              BEQ   @loop
000CA7r 3  C9 02              CMP   #BLT_STATUS_OK
000CA9r 3  F0 03              BEQ   @ok
000CABr 3  A9 01              LDA   #BLITTER_RESULT_ERROR
000CADr 3  60                 RTS
000CAEr 3               @ok:
000CAEr 3  A9 00              LDA   #BLITTER_RESULT_OK
000CB0r 3  60                 RTS
000CB1r 3               
000CB1r 3               .endif
000CB1r 3               
000CB1r 2               
000CB1r 2               .ifndef VSPRITE_IMPLEMENTATION_INCLUDED
000CB1r 2               VSPRITE_IMPLEMENTATION_INCLUDED = 1
000CB1r 2               
000CB1r 2                     .segment "BSS"
000009r 2               
000009r 2  xx           VSPRITE_SRCSPACE:       .res 1
00000Ar 2  xx           VSPRITE_DSTSPACE:       .res 1
00000Br 2  xx           VSPRITE_SRCADDRL:       .res 1
00000Cr 2  xx           VSPRITE_SRCADDRM:       .res 1
00000Dr 2  xx           VSPRITE_SRCADDRH:       .res 1
00000Er 2  xx           VSPRITE_DSTADDRL:       .res 1
00000Fr 2  xx           VSPRITE_DSTADDRM:       .res 1
000010r 2  xx           VSPRITE_DSTADDRH:       .res 1
000011r 2  xx           VSPRITE_WIDTHL:         .res 1
000012r 2  xx           VSPRITE_WIDTHH:         .res 1
000013r 2  xx           VSPRITE_HEIGHTL:        .res 1
000014r 2  xx           VSPRITE_HEIGHTH:        .res 1
000015r 2  xx           VSPRITE_SRCSTRL:        .res 1
000016r 2  xx           VSPRITE_SRCSTRH:        .res 1
000017r 2  xx           VSPRITE_DSTSTRL:        .res 1
000018r 2  xx           VSPRITE_DSTSTRH:        .res 1
000019r 2  xx           VSPRITE_BGSPACE:        .res 1
00001Ar 2  xx           VSPRITE_BGADDRL:        .res 1
00001Br 2  xx           VSPRITE_BGADDRM:        .res 1
00001Cr 2  xx           VSPRITE_BGADDRH:        .res 1
00001Dr 2  xx           VSPRITE_BGSTRL:         .res 1
00001Er 2  xx           VSPRITE_BGSTRH:         .res 1
00001Fr 2  xx           VSPRITE_COLORKEY:       .res 1
000020r 2  xx           VSPRITE_ORIGSPACE:      .res 1
000021r 2  xx           VSPRITE_ORIGADDRL:      .res 1
000022r 2  xx           VSPRITE_ORIGADDRM:      .res 1
000023r 2  xx           VSPRITE_ORIGADDRH:      .res 1
000024r 2  xx           VSPRITE_ORIGSTRL:       .res 1
000025r 2  xx           VSPRITE_ORIGSTRH:       .res 1
000026r 2  xx           VSPRITE_ROTSPACE:       .res 1
000027r 2  xx           VSPRITE_ROTADDRL:       .res 1
000028r 2  xx           VSPRITE_ROTADDRM:       .res 1
000029r 2  xx           VSPRITE_ROTADDRH:       .res 1
00002Ar 2  xx           VSPRITE_ROTSTRL:        .res 1
00002Br 2  xx           VSPRITE_ROTSTRH:        .res 1
00002Cr 2  xx           VSPRITE_ROTANGLE:       .res 1
00002Dr 2  xx           VSPRITE_FILLVALUE:      .res 1
00002Er 2  xx           VSPRITE_FLAGS:          .res 1
00002Fr 2  xx           VSPRITE_XL:             .res 1
000030r 2  xx           VSPRITE_XH:             .res 1
000031r 2  xx           VSPRITE_Y:              .res 1
000032r 2  xx           VSPRITE_SCENE_ADDRL:    .res 1
000033r 2  xx           VSPRITE_SCENE_ADDRH:    .res 1
000034r 2  xx           VSPRITE_SCENE_COUNT:    .res 1
000035r 2  xx           VSPRITE_SCENE_REMAIN:   .res 1
000036r 2  xx           VSPRITE_SCENE_XL:       .res 1
000037r 2  xx           VSPRITE_SCENE_XH:       .res 1
000038r 2  xx           VSPRITE_SCENE_Y:        .res 1
000039r 2  xx           VSPRITE_SCENE_WIDTHL:   .res 1
00003Ar 2  xx           VSPRITE_SCENE_WIDTHH:   .res 1
00003Br 2  xx           VSPRITE_SCENE_HEIGHTL:  .res 1
00003Cr 2  xx           VSPRITE_SCENE_HEIGHTH:  .res 1
00003Dr 2  xx           VSPRITE_SCENE_WORKSPACE:.res 1
00003Er 2  xx           VSPRITE_SCENE_WORKADDRL:.res 1
00003Fr 2  xx           VSPRITE_SCENE_WORKADDRM:.res 1
000040r 2  xx           VSPRITE_SCENE_WORKADDRH:.res 1
000041r 2  xx           VSPRITE_SCENE_WORKSTRL: .res 1
000042r 2  xx           VSPRITE_SCENE_WORKSTRH: .res 1
000043r 2  xx           VSPRITE_SCENE_OFFL:     .res 1
000044r 2  xx           VSPRITE_SCENE_OFFH:     .res 1
000045r 2               
000045r 2                     .segment "ZEROPAGE"
000000r 2               
000000r 2  xx           VSPRITE_TMP:            .res 1
000001r 2  xx xx        VSPRITE_DESC_PTR:       .res 2
000003r 2               
000003r 2                     .segment "CODE"
000CB1r 2               
000CB1r 2                     .export vsprite_blit
000CB1r 2                     .export vsprite_blit_start
000CB1r 2                     .export vsprite_fill
000CB1r 2                     .export vsprite_gfx_addr
000CB1r 2                     .export vsprite_gfx_blit
000CB1r 2                     .export vsprite_gfx_blit_start
000CB1r 2                     .export vsprite_gfx_rotate_blit
000CB1r 2                     .export vsprite_gfx_rotate_blit_keyed
000CB1r 2                     .export vsprite_gfx_rotate_blit_nowait
000CB1r 2                     .export vsprite_gfx_fill
000CB1r 2                     .export vsprite_gfx_save_bg
000CB1r 2                     .export vsprite_gfx_restore_bg
000CB1r 2                     .export vsprite_rotate
000CB1r 2                     .export vsprite_use_original
000CB1r 2                     .export vsprite_use_rotated
000CB1r 2                     .export vsprite_scene_begin
000CB1r 2                     .export vsprite_scene_commit
000CB1r 2                     .export vsprite_scene_commit_atomic
000CB1r 2                     .export vsprite_scene_draw
000CB1r 2               
000CB1r 2               ; @label VSPRITE.BLIT
000CB1r 2               ; @kind routine
000CB1r 2               ; @symbol vsprite_blit
000CB1r 2               ; @summary Copy the configured virtual sprite rectangle with the blitter.
000CB1r 2               ; @requires VSPRITE_SRCSPACE VSPRITE_DSTSPACE VSPRITE_SRCADDR* VSPRITE_DSTADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_SRCSTR* VSPRITE_DSTSTR*
000CB1r 2               ; @in VSPRITE_FLAGS: Set bit 0 to enable color-key transparency.
000CB1r 2               ; @in VSPRITE_COLORKEY: Source byte skipped when color-key mode is enabled.
000CB1r 2               ; @in VGC_GFXTRANS: Graphics-plane color treated as transparent by display composition; set this to a non-black color when blitting visible palette-0 black pixels.
000CB1r 2               ; @out A: 0 on success, 1 on error.
000CB1r 2               vsprite_blit:
000CB1r 2  20 rr rr           JSR   vsprite_blit_start
000CB4r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000CB6r 2  D0 03              BNE   @done
000CB8r 2  4C rr rr           JMP   blitter_wait
000CBBr 2               @done:
000CBBr 2  60                 RTS
000CBCr 2               
000CBCr 2               ; @label VSPRITE.BLIT_START
000CBCr 2               ; @kind routine
000CBCr 2               ; @symbol vsprite_blit_start
000CBCr 2               ; @summary Start the configured virtual sprite blit without waiting for completion.
000CBCr 2               ; @requires VSPRITE_SRCSPACE VSPRITE_DSTSPACE VSPRITE_SRCADDR* VSPRITE_DSTADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_SRCSTR* VSPRITE_DSTSTR*
000CBCr 2               ; @in VSPRITE_FLAGS: Set bit 0 to enable color-key transparency.
000CBCr 2               ; @in VSPRITE_COLORKEY: Source byte skipped when color-key mode is enabled.
000CBCr 2               ; @out A: 0 after the blit command is issued.
000CBCr 2               vsprite_blit_start:
000CBCr 2  AD rr rr           LDA   VSPRITE_SRCSPACE
000CBFr 2  8D 86 BA           STA   BLT_SRCSPACE
000CC2r 2  AD rr rr           LDA   VSPRITE_DSTSPACE
000CC5r 2  8D 87 BA           STA   BLT_DSTSPACE
000CC8r 2  AD rr rr           LDA   VSPRITE_SRCADDRL
000CCBr 2  8D 88 BA           STA   BLT_SRCL
000CCEr 2  AD rr rr           LDA   VSPRITE_SRCADDRM
000CD1r 2  8D 89 BA           STA   BLT_SRCM
000CD4r 2  AD rr rr           LDA   VSPRITE_SRCADDRH
000CD7r 2  8D 8A BA           STA   BLT_SRCH
000CDAr 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000CDDr 2  8D 8B BA           STA   BLT_DSTL
000CE0r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000CE3r 2  8D 8C BA           STA   BLT_DSTM
000CE6r 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000CE9r 2  8D 8D BA           STA   BLT_DSTH
000CECr 2  AD rr rr           LDA   VSPRITE_WIDTHL
000CEFr 2  8D 8E BA           STA   BLT_WIDTHL
000CF2r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000CF5r 2  8D 8F BA           STA   BLT_WIDTHH
000CF8r 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000CFBr 2  8D 90 BA           STA   BLT_HEIGHTL
000CFEr 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000D01r 2  8D 91 BA           STA   BLT_HEIGHTH
000D04r 2  AD rr rr           LDA   VSPRITE_SRCSTRL
000D07r 2  8D 92 BA           STA   BLT_SRCSTRL
000D0Ar 2  AD rr rr           LDA   VSPRITE_SRCSTRH
000D0Dr 2  8D 93 BA           STA   BLT_SRCSTRH
000D10r 2  AD rr rr           LDA   VSPRITE_DSTSTRL
000D13r 2  8D 94 BA           STA   BLT_DSTSTRL
000D16r 2  AD rr rr           LDA   VSPRITE_DSTSTRH
000D19r 2  8D 95 BA           STA   BLT_DSTSTRH
000D1Cr 2  AD rr rr           LDA   VSPRITE_COLORKEY
000D1Fr 2  8D 98 BA           STA   BLT_CKEY
000D22r 2  AD rr rr           LDA   VSPRITE_FLAGS
000D25r 2  29 01              AND   #VSPRITE_FLAG_COLORKEY
000D27r 2  F0 04              BEQ   @no_key
000D29r 2  A9 02              LDA   #BLT_MODE_COLORKEY
000D2Br 2  80 02              BRA   @mode
000D2Dr 2               @no_key:
000D2Dr 2  A9 00              LDA   #$00
000D2Fr 2               @mode:
000D2Fr 2  8D 96 BA           STA   BLT_MODE_REG
000D32r 2  A9 01              LDA   #BLT_CMD_START
000D34r 2  8D 83 BA           STA   BLT_CMD_REG
000D37r 2  A9 00              LDA   #VSPRITE_RESULT_OK
000D39r 2  60                 RTS
000D3Ar 2               
000D3Ar 2               ; @label VSPRITE.FILL
000D3Ar 2               ; @kind routine
000D3Ar 2               ; @symbol vsprite_fill
000D3Ar 2               ; @summary Fill the configured destination rectangle with VSPRITE.FILLVALUE.
000D3Ar 2               ; @requires VSPRITE_DSTSPACE VSPRITE_DSTADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_DSTSTR*
000D3Ar 2               ; @out A: 0 on success, 1 on error.
000D3Ar 2               vsprite_fill:
000D3Ar 2  AD rr rr           LDA   VSPRITE_DSTSPACE
000D3Dr 2  8D 87 BA           STA   BLT_DSTSPACE
000D40r 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000D43r 2  8D 8B BA           STA   BLT_DSTL
000D46r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000D49r 2  8D 8C BA           STA   BLT_DSTM
000D4Cr 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000D4Fr 2  8D 8D BA           STA   BLT_DSTH
000D52r 2  AD rr rr           LDA   VSPRITE_WIDTHL
000D55r 2  8D 8E BA           STA   BLT_WIDTHL
000D58r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000D5Br 2  8D 8F BA           STA   BLT_WIDTHH
000D5Er 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000D61r 2  8D 90 BA           STA   BLT_HEIGHTL
000D64r 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000D67r 2  8D 91 BA           STA   BLT_HEIGHTH
000D6Ar 2  AD rr rr           LDA   VSPRITE_DSTSTRL
000D6Dr 2  8D 94 BA           STA   BLT_DSTSTRL
000D70r 2  AD rr rr           LDA   VSPRITE_DSTSTRH
000D73r 2  8D 95 BA           STA   BLT_DSTSTRH
000D76r 2  AD rr rr           LDA   VSPRITE_FILLVALUE
000D79r 2  8D 97 BA           STA   BLT_FILLVALUE
000D7Cr 2  4C rr rr           JMP   blitter_fill
000D7Fr 2               
000D7Fr 2               ; @label VSPRITE.USE_ORIGINAL
000D7Fr 2               ; @kind routine
000D7Fr 2               ; @symbol vsprite_use_original
000D7Fr 2               ; @summary Point VSPRITE.SRC* at the configured immutable source shape.
000D7Fr 2               ; @requires VSPRITE_ORIGSPACE VSPRITE_ORIGADDR* VSPRITE_ORIGSTR*
000D7Fr 2               ; @out A: 0.
000D7Fr 2               vsprite_use_original:
000D7Fr 2  AD rr rr           LDA   VSPRITE_ORIGSPACE
000D82r 2  8D rr rr           STA   VSPRITE_SRCSPACE
000D85r 2  AD rr rr           LDA   VSPRITE_ORIGADDRL
000D88r 2  8D rr rr           STA   VSPRITE_SRCADDRL
000D8Br 2  AD rr rr           LDA   VSPRITE_ORIGADDRM
000D8Er 2  8D rr rr           STA   VSPRITE_SRCADDRM
000D91r 2  AD rr rr           LDA   VSPRITE_ORIGADDRH
000D94r 2  8D rr rr           STA   VSPRITE_SRCADDRH
000D97r 2  AD rr rr           LDA   VSPRITE_ORIGSTRL
000D9Ar 2  8D rr rr           STA   VSPRITE_SRCSTRL
000D9Dr 2  AD rr rr           LDA   VSPRITE_ORIGSTRH
000DA0r 2  8D rr rr           STA   VSPRITE_SRCSTRH
000DA3r 2  A9 00              LDA   #VSPRITE_RESULT_OK
000DA5r 2  60                 RTS
000DA6r 2               
000DA6r 2               ; @label VSPRITE.USE_ROTATED
000DA6r 2               ; @kind routine
000DA6r 2               ; @symbol vsprite_use_rotated
000DA6r 2               ; @summary Point VSPRITE.SRC* at the configured rotated output buffer.
000DA6r 2               ; @requires VSPRITE_ROTSPACE VSPRITE_ROTADDR* VSPRITE_ROTSTR*
000DA6r 2               ; @out A: 0.
000DA6r 2               vsprite_use_rotated:
000DA6r 2  AD rr rr           LDA   VSPRITE_ROTSPACE
000DA9r 2  8D rr rr           STA   VSPRITE_SRCSPACE
000DACr 2  AD rr rr           LDA   VSPRITE_ROTADDRL
000DAFr 2  8D rr rr           STA   VSPRITE_SRCADDRL
000DB2r 2  AD rr rr           LDA   VSPRITE_ROTADDRM
000DB5r 2  8D rr rr           STA   VSPRITE_SRCADDRM
000DB8r 2  AD rr rr           LDA   VSPRITE_ROTADDRH
000DBBr 2  8D rr rr           STA   VSPRITE_SRCADDRH
000DBEr 2  AD rr rr           LDA   VSPRITE_ROTSTRL
000DC1r 2  8D rr rr           STA   VSPRITE_SRCSTRL
000DC4r 2  AD rr rr           LDA   VSPRITE_ROTSTRH
000DC7r 2  8D rr rr           STA   VSPRITE_SRCSTRH
000DCAr 2  A9 00              LDA   #VSPRITE_RESULT_OK
000DCCr 2  60                 RTS
000DCDr 2               
000DCDr 2               ; @label VSPRITE.ROTATE
000DCDr 2               ; @kind routine
000DCDr 2               ; @symbol vsprite_rotate
000DCDr 2               ; @summary Rotate the configured square virtual sprite from immutable source into the caller-owned rotated buffer.
000DCDr 2               ; @requires VSPRITE_ORIGSPACE VSPRITE_ORIGADDR* VSPRITE_ORIGSTR* VSPRITE_ROTSPACE VSPRITE_ROTADDR* VSPRITE_ROTSTR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_ROTANGLE
000DCDr 2               ; @in VSPRITE_COLORKEY: Fill value for rotated output pixels outside the source bounds.
000DCDr 2               ; @desc On success, VSPRITE.SRC* is automatically repointed at VSPRITE.ROT* so VSPRITE.GFX_BLIT draws the rotated copy. Hardware requires WIDTH == HEIGHT and both dimensions <= 256.
000DCDr 2               ; @out A: 0 on success, 1 on error.
000DCDr 2               vsprite_rotate:
000DCDr 2  AD rr rr           LDA   VSPRITE_ORIGSPACE
000DD0r 2  8D 86 BA           STA   BLT_SRCSPACE
000DD3r 2  AD rr rr           LDA   VSPRITE_ROTSPACE
000DD6r 2  8D 87 BA           STA   BLT_DSTSPACE
000DD9r 2  AD rr rr           LDA   VSPRITE_ORIGADDRL
000DDCr 2  8D 88 BA           STA   BLT_SRCL
000DDFr 2  AD rr rr           LDA   VSPRITE_ORIGADDRM
000DE2r 2  8D 89 BA           STA   BLT_SRCM
000DE5r 2  AD rr rr           LDA   VSPRITE_ORIGADDRH
000DE8r 2  8D 8A BA           STA   BLT_SRCH
000DEBr 2  AD rr rr           LDA   VSPRITE_ROTADDRL
000DEEr 2  8D 8B BA           STA   BLT_DSTL
000DF1r 2  AD rr rr           LDA   VSPRITE_ROTADDRM
000DF4r 2  8D 8C BA           STA   BLT_DSTM
000DF7r 2  AD rr rr           LDA   VSPRITE_ROTADDRH
000DFAr 2  8D 8D BA           STA   BLT_DSTH
000DFDr 2  AD rr rr           LDA   VSPRITE_WIDTHL
000E00r 2  8D 8E BA           STA   BLT_WIDTHL
000E03r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000E06r 2  8D 8F BA           STA   BLT_WIDTHH
000E09r 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000E0Cr 2  8D 90 BA           STA   BLT_HEIGHTL
000E0Fr 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000E12r 2  8D 91 BA           STA   BLT_HEIGHTH
000E15r 2  AD rr rr           LDA   VSPRITE_ORIGSTRL
000E18r 2  8D 92 BA           STA   BLT_SRCSTRL
000E1Br 2  AD rr rr           LDA   VSPRITE_ORIGSTRH
000E1Er 2  8D 93 BA           STA   BLT_SRCSTRH
000E21r 2  AD rr rr           LDA   VSPRITE_ROTSTRL
000E24r 2  8D 94 BA           STA   BLT_DSTSTRL
000E27r 2  AD rr rr           LDA   VSPRITE_ROTSTRH
000E2Ar 2  8D 95 BA           STA   BLT_DSTSTRH
000E2Dr 2  AD rr rr           LDA   VSPRITE_COLORKEY
000E30r 2  8D 98 BA           STA   BLT_CKEY
000E33r 2  AD rr rr           LDA   VSPRITE_ROTANGLE
000E36r 2  8D A2 BA           STA   BLT_ROTANGLE
000E39r 2  A9 04              LDA   #BLT_MODE_ROTATE
000E3Br 2  8D 96 BA           STA   BLT_MODE_REG
000E3Er 2  A9 01              LDA   #BLT_CMD_START
000E40r 2  8D 83 BA           STA   BLT_CMD_REG
000E43r 2  20 rr rr           JSR   blitter_wait
000E46r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000E48r 2  D0 03              BNE   @done
000E4Ar 2  20 rr rr           JSR   vsprite_use_rotated
000E4Dr 2               @done:
000E4Dr 2  60                 RTS
000E4Er 2               
000E4Er 2               ; @label VSPRITE.GFX_ADDR
000E4Er 2               ; @kind routine
000E4Er 2               ; @symbol vsprite_gfx_addr
000E4Er 2               ; @summary Convert VSPRITE.X/Y to a linear VGC graphics-plane destination address.
000E4Er 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y
000E4Er 2               ; @out VSPRITE_DSTADDR*: y * 320 + x.
000E4Er 2               vsprite_gfx_addr:
000E4Er 2  9C rr rr           STZ   VSPRITE_DSTADDRL
000E51r 2  AD rr rr           LDA   VSPRITE_Y
000E54r 2  8D rr rr           STA   VSPRITE_DSTADDRM        ; y * 256
000E57r 2  9C rr rr           STZ   VSPRITE_DSTADDRH
000E5Ar 2               
000E5Ar 2  AD rr rr           LDA   VSPRITE_Y               ; add y * 64
000E5Dr 2  4A                 LSR
000E5Er 2  4A                 LSR
000E5Fr 2  85 rr              STA   VSPRITE_TMP
000E61r 2  AD rr rr           LDA   VSPRITE_Y
000E64r 2  0A                 ASL
000E65r 2  0A                 ASL
000E66r 2  0A                 ASL
000E67r 2  0A                 ASL
000E68r 2  0A                 ASL
000E69r 2  0A                 ASL
000E6Ar 2  18                 CLC
000E6Br 2  6D rr rr           ADC   VSPRITE_DSTADDRL
000E6Er 2  8D rr rr           STA   VSPRITE_DSTADDRL
000E71r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000E74r 2  65 rr              ADC   VSPRITE_TMP
000E76r 2  8D rr rr           STA   VSPRITE_DSTADDRM
000E79r 2  90 03              BCC   @add_x
000E7Br 2  EE rr rr           INC   VSPRITE_DSTADDRH
000E7Er 2               
000E7Er 2               @add_x:
000E7Er 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000E81r 2  18                 CLC
000E82r 2  6D rr rr           ADC   VSPRITE_XL
000E85r 2  8D rr rr           STA   VSPRITE_DSTADDRL
000E88r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000E8Br 2  6D rr rr           ADC   VSPRITE_XH
000E8Er 2  8D rr rr           STA   VSPRITE_DSTADDRM
000E91r 2  90 03              BCC   @done
000E93r 2  EE rr rr           INC   VSPRITE_DSTADDRH
000E96r 2               @done:
000E96r 2  60                 RTS
000E97r 2               
000E97r 2               ; @label VSPRITE.GFX_BLIT
000E97r 2               ; @kind routine
000E97r 2               ; @symbol vsprite_gfx_blit
000E97r 2               ; @summary Copy the configured virtual sprite to the VGC graphics plane at X/Y.
000E97r 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_SRCSPACE VSPRITE_SRCADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_SRCSTR*
000E97r 2               ; @in VSPRITE_COLORKEY: Source transparent color when VSPRITE_FLAG_COLORKEY is set; normally match this to VGC_GFXTRANS for graphics-plane virtual sprites.
000E97r 2               ; @out A: 0 on success, 1 on error.
000E97r 2               vsprite_gfx_blit:
000E97r 2  20 rr rr           JSR   vsprite_gfx_addr
000E9Ar 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000E9Cr 2  8D rr rr           STA   VSPRITE_DSTSPACE
000E9Fr 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000EA1r 2  8D rr rr           STA   VSPRITE_DSTSTRL
000EA4r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000EA6r 2  8D rr rr           STA   VSPRITE_DSTSTRH
000EA9r 2  4C rr rr           JMP   vsprite_blit
000EACr 2               
000EACr 2               ; @label VSPRITE.GFX_BLIT_START
000EACr 2               ; @kind routine
000EACr 2               ; @symbol vsprite_gfx_blit_start
000EACr 2               ; @summary Start copying the configured virtual sprite to the VGC graphics plane at X/Y without waiting for completion.
000EACr 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_SRCSPACE VSPRITE_SRCADDR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_SRCSTR*
000EACr 2               ; @out A: 0 after the blit command is issued.
000EACr 2               vsprite_gfx_blit_start:
000EACr 2  20 rr rr           JSR   vsprite_gfx_addr
000EAFr 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000EB1r 2  8D rr rr           STA   VSPRITE_DSTSPACE
000EB4r 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000EB6r 2  8D rr rr           STA   VSPRITE_DSTSTRL
000EB9r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000EBBr 2  8D rr rr           STA   VSPRITE_DSTSTRH
000EBEr 2  4C rr rr           JMP   vsprite_blit_start
000EC1r 2               
000EC1r 2               ; @label VSPRITE.GFX_ROTATE_BLIT
000EC1r 2               ; @kind routine
000EC1r 2               ; @symbol vsprite_gfx_rotate_blit
000EC1r 2               ; @summary Rotate the configured virtual sprite offscreen, wait for the next frame, then copy the full rotated bounds to the graphics plane at X/Y.
000EC1r 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_ORIGSPACE VSPRITE_ORIGADDR* VSPRITE_ORIGSTR* VSPRITE_ROTSPACE VSPRITE_ROTADDR* VSPRITE_ROTSTR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_ROTANGLE
000EC1r 2               ; @in VSPRITE_COLORKEY: Fill value for rotated output pixels outside the source bounds; normally match this to VGC_GFXTRANS.
000EC1r 2               ; @desc The final graphics blit is intentionally non-color-keyed so transparent pixels from the rotated buffer clear the previous frame in the same visible copy.
000EC1r 2               ; @out A: 0 on success, 1 on error.
000EC1r 2               vsprite_gfx_rotate_blit:
000EC1r 2  20 rr rr           JSR   vsprite_rotate
000EC4r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000EC6r 2  D0 06              BNE   @done
000EC8r 2  20 rr rr           JSR   vsprite_wait_frame
000ECBr 2  4C rr rr           JMP   vsprite_gfx_blit_rotated
000ECEr 2               @done:
000ECEr 2  60                 RTS
000ECFr 2               
000ECFr 2               ; @label VSPRITE.GFX_ROTATE_BLIT_KEYED
000ECFr 2               ; @kind routine
000ECFr 2               ; @symbol vsprite_gfx_rotate_blit_keyed
000ECFr 2               ; @summary Rotate the configured virtual sprite, wait for the next frame, then blit it with the caller's VSPRITE.FLAGS.
000ECFr 2               ; @requires VSPRITE.X/Y VSPRITE.ORIG* VSPRITE.ROT* VSPRITE.WIDTH/HEIGHT VSPRITE.ROTANGLE
000ECFr 2               ; @in VSPRITE_FLAGS: Set VSPRITE_FLAG_COLORKEY to preserve existing graphics-plane pixels where the rotated sprite is transparent.
000ECFr 2               ; @out A: 0 on success, 1 on error.
000ECFr 2               vsprite_gfx_rotate_blit_keyed:
000ECFr 2  20 rr rr           JSR   vsprite_rotate
000ED2r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000ED4r 2  D0 06              BNE   @done
000ED6r 2  20 rr rr           JSR   vsprite_wait_frame
000ED9r 2  4C rr rr           JMP   vsprite_gfx_blit
000EDCr 2               @done:
000EDCr 2  60                 RTS
000EDDr 2               
000EDDr 2               ; @label VSPRITE.GFX_ROTATE_BLIT_NOWAIT
000EDDr 2               ; @kind routine
000EDDr 2               ; @symbol vsprite_gfx_rotate_blit_nowait
000EDDr 2               ; @summary Rotate the configured virtual sprite offscreen, then start copying the full rotated bounds to graphics memory without waiting for VGC.FRAME or final blit completion.
000EDDr 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_ORIGSPACE VSPRITE_ORIGADDR* VSPRITE_ORIGSTR* VSPRITE_ROTSPACE VSPRITE_ROTADDR* VSPRITE_ROTSTR* VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_ROTANGLE
000EDDr 2               ; @in VSPRITE_COLORKEY: Fill value for rotated output pixels outside the source bounds; normally match this to VGC_GFXTRANS.
000EDDr 2               ; @desc Use this in command/REPL paths or runtimes that already own frame pacing.
000EDDr 2               ; @out A: 0 on success, 1 on error.
000EDDr 2               vsprite_gfx_rotate_blit_nowait:
000EDDr 2  20 rr rr           JSR   vsprite_rotate
000EE0r 2  C9 00              CMP   #VSPRITE_RESULT_OK
000EE2r 2  D0 25              BNE   vsprite_gfx_rotate_done
000EE4r 2  AD rr rr           LDA   VSPRITE_FLAGS
000EE7r 2  48                 PHA
000EE8r 2  9C rr rr           STZ   VSPRITE_FLAGS
000EEBr 2  20 rr rr           JSR   vsprite_gfx_blit_start
000EEEr 2  85 rr              STA   VSPRITE_TMP
000EF0r 2  68                 PLA
000EF1r 2  8D rr rr           STA   VSPRITE_FLAGS
000EF4r 2  A5 rr              LDA   VSPRITE_TMP
000EF6r 2  60                 RTS
000EF7r 2               
000EF7r 2               vsprite_gfx_blit_rotated:
000EF7r 2  AD rr rr           LDA   VSPRITE_FLAGS
000EFAr 2  48                 PHA
000EFBr 2  9C rr rr           STZ   VSPRITE_FLAGS
000EFEr 2  20 rr rr           JSR   vsprite_gfx_blit
000F01r 2  85 rr              STA   VSPRITE_TMP
000F03r 2  68                 PLA
000F04r 2  8D rr rr           STA   VSPRITE_FLAGS
000F07r 2  A5 rr              LDA   VSPRITE_TMP
000F09r 2               vsprite_gfx_rotate_done:
000F09r 2  60                 RTS
000F0Ar 2               
000F0Ar 2               vsprite_wait_frame:
000F0Ar 2  AD 08 A0           LDA   VGC_FRAME
000F0Dr 2               @wait:
000F0Dr 2  CD 08 A0           CMP   VGC_FRAME
000F10r 2  F0 FB              BEQ   @wait
000F12r 2  60                 RTS
000F13r 2               
000F13r 2               ; @label VSPRITE.GFX_FILL
000F13r 2               ; @kind routine
000F13r 2               ; @symbol vsprite_gfx_fill
000F13r 2               ; @summary Fill a graphics-plane rectangle at VSPRITE.X/Y.
000F13r 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_FILLVALUE
000F13r 2               ; @out A: 0 on success, 1 on error.
000F13r 2               vsprite_gfx_fill:
000F13r 2  20 rr rr           JSR   vsprite_gfx_addr
000F16r 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000F18r 2  8D rr rr           STA   VSPRITE_DSTSPACE
000F1Br 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000F1Dr 2  8D rr rr           STA   VSPRITE_DSTSTRL
000F20r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000F22r 2  8D rr rr           STA   VSPRITE_DSTSTRH
000F25r 2  4C rr rr           JMP   vsprite_fill
000F28r 2               
000F28r 2               ; @label VSPRITE.GFX_SAVE_BG
000F28r 2               ; @kind routine
000F28r 2               ; @symbol vsprite_gfx_save_bg
000F28r 2               ; @summary Save a graphics-plane rectangle under VSPRITE.X/Y into the caller-owned VSPRITE.BG* buffer.
000F28r 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_BGSPACE VSPRITE_BGADDR* VSPRITE_BGSTR*
000F28r 2               ; @out A: 0 on success, 1 on error.
000F28r 2               vsprite_gfx_save_bg:
000F28r 2  20 rr rr           JSR   vsprite_gfx_addr
000F2Br 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000F2Dr 2  8D 86 BA           STA   BLT_SRCSPACE
000F30r 2  AD rr rr           LDA   VSPRITE_BGSPACE
000F33r 2  8D 87 BA           STA   BLT_DSTSPACE
000F36r 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000F39r 2  8D 88 BA           STA   BLT_SRCL
000F3Cr 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000F3Fr 2  8D 89 BA           STA   BLT_SRCM
000F42r 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000F45r 2  8D 8A BA           STA   BLT_SRCH
000F48r 2  AD rr rr           LDA   VSPRITE_BGADDRL
000F4Br 2  8D 8B BA           STA   BLT_DSTL
000F4Er 2  AD rr rr           LDA   VSPRITE_BGADDRM
000F51r 2  8D 8C BA           STA   BLT_DSTM
000F54r 2  AD rr rr           LDA   VSPRITE_BGADDRH
000F57r 2  8D 8D BA           STA   BLT_DSTH
000F5Ar 2  AD rr rr           LDA   VSPRITE_WIDTHL
000F5Dr 2  8D 8E BA           STA   BLT_WIDTHL
000F60r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000F63r 2  8D 8F BA           STA   BLT_WIDTHH
000F66r 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000F69r 2  8D 90 BA           STA   BLT_HEIGHTL
000F6Cr 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000F6Fr 2  8D 91 BA           STA   BLT_HEIGHTH
000F72r 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000F74r 2  8D 92 BA           STA   BLT_SRCSTRL
000F77r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000F79r 2  8D 93 BA           STA   BLT_SRCSTRH
000F7Cr 2  AD rr rr           LDA   VSPRITE_BGSTRL
000F7Fr 2  8D 94 BA           STA   BLT_DSTSTRL
000F82r 2  AD rr rr           LDA   VSPRITE_BGSTRH
000F85r 2  8D 95 BA           STA   BLT_DSTSTRH
000F88r 2  4C rr rr           JMP   blitter_start_copy
000F8Br 2               
000F8Br 2               ; @label VSPRITE.GFX_RESTORE_BG
000F8Br 2               ; @kind routine
000F8Br 2               ; @symbol vsprite_gfx_restore_bg
000F8Br 2               ; @summary Restore a caller-owned VSPRITE.BG* buffer into the graphics plane at VSPRITE.X/Y.
000F8Br 2               ; @requires VSPRITE_XL VSPRITE_XH VSPRITE_Y VSPRITE_WIDTH* VSPRITE_HEIGHT* VSPRITE_BGSPACE VSPRITE_BGADDR* VSPRITE_BGSTR*
000F8Br 2               ; @out A: 0 on success, 1 on error.
000F8Br 2               vsprite_gfx_restore_bg:
000F8Br 2  20 rr rr           JSR   vsprite_gfx_addr
000F8Er 2  AD rr rr           LDA   VSPRITE_BGSPACE
000F91r 2  8D 86 BA           STA   BLT_SRCSPACE
000F94r 2  A9 03              LDA   #BLT_SPACE_VGC_GFX
000F96r 2  8D 87 BA           STA   BLT_DSTSPACE
000F99r 2  AD rr rr           LDA   VSPRITE_BGADDRL
000F9Cr 2  8D 88 BA           STA   BLT_SRCL
000F9Fr 2  AD rr rr           LDA   VSPRITE_BGADDRM
000FA2r 2  8D 89 BA           STA   BLT_SRCM
000FA5r 2  AD rr rr           LDA   VSPRITE_BGADDRH
000FA8r 2  8D 8A BA           STA   BLT_SRCH
000FABr 2  AD rr rr           LDA   VSPRITE_DSTADDRL
000FAEr 2  8D 8B BA           STA   BLT_DSTL
000FB1r 2  AD rr rr           LDA   VSPRITE_DSTADDRM
000FB4r 2  8D 8C BA           STA   BLT_DSTM
000FB7r 2  AD rr rr           LDA   VSPRITE_DSTADDRH
000FBAr 2  8D 8D BA           STA   BLT_DSTH
000FBDr 2  AD rr rr           LDA   VSPRITE_WIDTHL
000FC0r 2  8D 8E BA           STA   BLT_WIDTHL
000FC3r 2  AD rr rr           LDA   VSPRITE_WIDTHH
000FC6r 2  8D 8F BA           STA   BLT_WIDTHH
000FC9r 2  AD rr rr           LDA   VSPRITE_HEIGHTL
000FCCr 2  8D 90 BA           STA   BLT_HEIGHTL
000FCFr 2  AD rr rr           LDA   VSPRITE_HEIGHTH
000FD2r 2  8D 91 BA           STA   BLT_HEIGHTH
000FD5r 2  AD rr rr           LDA   VSPRITE_BGSTRL
000FD8r 2  8D 92 BA           STA   BLT_SRCSTRL
000FDBr 2  AD rr rr           LDA   VSPRITE_BGSTRH
000FDEr 2  8D 93 BA           STA   BLT_SRCSTRH
000FE1r 2  A9 40              LDA   #<VSPRITE_GFX_STRIDE
000FE3r 2  8D 94 BA           STA   BLT_DSTSTRL
000FE6r 2  A9 01              LDA   #>VSPRITE_GFX_STRIDE
000FE8r 2  8D 95 BA           STA   BLT_DSTSTRH
000FEBr 2  4C rr rr           JMP   blitter_start_copy
000FEEr 2               
000FEEr 2               ; @label VSPRITE.SCENE_BEGIN
000FEEr 2               ; @kind routine
000FEEr 2               ; @symbol vsprite_scene_begin
000FEEr 2               ; @summary Restore all saved old backgrounds in the configured scene descriptor list.
000FEEr 2               ; @requires VSPRITE_SCENE_ADDRL VSPRITE_SCENE_ADDRH VSPRITE_SCENE_COUNT
000FEEr 2               ; @desc Call this once per animation frame before updating descriptor X/Y values. Descriptors with VSPRITE.DESC_SAVED are restored and have that internal flag cleared.
000FEEr 2               vsprite_scene_begin:
000FEEr 2  20 rr rr           JSR   vsprite_scene_rewind
000FF1r 2               @loop:
000FF1r 2  AD rr rr           LDA   VSPRITE_SCENE_REMAIN
000FF4r 2  F0 1B              BEQ   @done
000FF6r 2  A0 00              LDY   #VSPRITE_DESC_FLAGS
000FF8r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
000FFAr 2  29 40              AND   #VSPRITE_DESC_SAVED
000FFCr 2  F0 0E              BEQ   @next
000FFEr 2  20 rr rr           JSR   vsprite_scene_load_old
001001r 2  20 rr rr           JSR   vsprite_gfx_restore_bg
001004r 2  A0 00              LDY   #VSPRITE_DESC_FLAGS
001006r 2  B1 rr              LDA   (VSPRITE_DESC_PTR),Y
001008r 2  29 BF              AND   #$BF
00100Ar 2  91 rr              STA   (VSPRITE_DESC_PTR),Y
00100Cr 2               @next:
00100Cr 2  20 rr rr           JSR   vsprite_scene_next
00100Fr 2  80 E0              BRA   @loop
001011r 2               @done:
001011r 2  60                 RTS
001012r 2               
001012r 2               ; @label VSPRITE.SCENE_COMMIT
001012r 2               ; @kind routine
001012r 2               ; @symbol vsprite_scene_commit
001012r 2               ; @summary Save all current backgrounds, then draw all visible descriptors in list order.
001012r 2               ; @requires VSPRITE_SCENE_ADDRL VSPRITE_SCENE_ADDRH VSPRITE_SCENE_COUNT
001012r 2               ; @desc List order is z-order: later descriptors draw in front of earlier descriptors.
001012r 2               vsprite_scene_commit:
001012r 2  20 rr rr           JSR   vsprite_scene_save
001015r 2                     ; fall through
001015r 2               
001015r 2               ; @label VSPRITE.SCENE_DRAW
001015r 2               ; @kind routine
001015r 2               ; @symbol vsprite_scene_draw
001015r 2               ; @summary Draw all visible descriptors in list order without saving backgrounds.
001015r 2               ; @requires VSPRITE_SCENE_ADDRL VSPRITE_SCENE_ADDRH VSPRITE_SCENE_COUNT
