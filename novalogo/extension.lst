000000r 3               .ifndef FIO_RNG1
000000r 3               FIO_RNG1         = FIO_SRCH
000000r 3               .endif
000000r 3               ; @label FIO.RNG2
000000r 3               ; @kind u8
000000r 3               ; @symbol FIO_RNG2
000000r 3               ; @summary Third byte returned by FIO.CMD_RNG.
000000r 3               .ifndef FIO_RNG2
000000r 3               FIO_RNG2         = FIO_ENDL
000000r 3               .endif
