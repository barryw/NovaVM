000000r 4               ; BASIC SYS register bridge. SYS addr[,A[,X[,Y]]] loads A/X/Y from these
000000r 4               ; bytes before jumping and stores A/X/Y back here when the routine returns.
000000r 4               ; @label SYS.REGA
000000r 4               ; @kind u8
000000r 4               ; @symbol SYS_REGA
