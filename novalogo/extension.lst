000000r 3               NVR1H             = $23
000000r 3               .endif
000000r 3               .ifndef NVR2L
000000r 3               NVR2L             = $24
000000r 3               .endif
000000r 3               .ifndef NVR2H
000000r 3               NVR2H             = $25
000000r 3               .endif
000000r 3               .ifndef NVR3L
000000r 3               NVR3L             = $26
000000r 3               .endif
000000r 3               .ifndef NVR3H
000000r 3               NVR3H             = $27
000000r 3               .endif
000000r 3               .ifndef NVR4L
000000r 3               NVR4L             = $28
000000r 3               .endif
