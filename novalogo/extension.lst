0013B8r 3               
0013B8r 2               .include "vtext.s"
0013B8r 3               ; Shared NovaVM text-region runtime.
0013B8r 3               ;
0013B8r 3               ; Provides small rectangular text regions over the VGC char/color/attribute
0013B8r 3               ; planes. Domain runtimes such as NovaZ decide what a region means; this code
0013B8r 3               ; only clips, clears, writes, and scrolls rectangular text areas.
0013B8r 3               
0013B8r 3               .include "vtext.inc"
0013B8r 4               ; NovaVM shared text-region runtime interface.
0013B8r 4               ;
0013B8r 4               ; This layer is intentionally language-neutral. It knows about rectangular
0013B8r 4               ; regions over the VGC text planes, but not about BASIC, NovaZ, or Z-machine
0013B8r 4               ; window semantics.
0013B8r 4               ;
0013B8r 4               ; Calling convention:
0013B8r 4               ;   Region:      VTEXT_LEFT/TOP/WIDTH/HEIGHT state bytes
0013B8r 4               ;   Cursor:      VTEXT_CURX/CURY state bytes, relative to the current region.
0013B8r 4               ;                vtext_set_cursor and character output mirror this to the
0013B8r 4               ;                absolute VGC visible cursor registers.
0013B8r 4               ;   Cell attrs:  VTEXT_COLOR (packed bg/fg), VTEXT_ATTR (style bits)
0013B8r 4               ;   Character:   VTEXT_CHAR input byte
0013B8r 4               ;   Flags:       VTEXT_FLAGS state byte (wrap/scroll)
0013B8r 4               ;
0013B8r 4               ; Routines return A=0 on success and A=1 on error. X/Y are scratch unless a
0013B8r 4               ; routine explicitly documents otherwise.
0013B8r 4               
0013B8r 4               .ifndef VTEXT_INC_INCLUDED
0013B8r 4               VTEXT_INC_INCLUDED = 1
0013B8r 4               
0013B8r 4               .include "nova.inc"
0013B8r 4               
0013B8r 4               VTEXT_SCREEN_COLS = NOVA_SCREEN_COLS
0013B8r 4               VTEXT_SCREEN_ROWS = NOVA_SCREEN_ROWS
0013B8r 4               
0013B8r 4               VTEXT_PLANE_CHAR = VGC_PLANE_CHAR
0013B8r 4               VTEXT_PLANE_COLOR = VGC_PLANE_COLOR
0013B8r 4               VTEXT_PLANE_TEXTATTR = VGC_PLANE_TEXTATTR
0013B8r 4               
0013B8r 4               VTEXT_VRAM_AUTOINC = VGC_VRAM_AUTOINC
0013B8r 4               
0013B8r 4               VTEXT_FLAG_WRAP = $01
0013B8r 4               VTEXT_FLAG_SCROLL = $02
0013B8r 4               
0013B8r 4               VTEXT_ATTR_NONE = $00
0013B8r 4               VTEXT_ATTR_FLASH = VTXT_ATTR_FLASH
0013B8r 4               
0013B8r 4               VTEXT_OK = $00
0013B8r 4               VTEXT_ERR = $01
0013B8r 4               
0013B8r 4               ; Assembly-facing state ABI. These are linker-owned storage symbols defined by
0013B8r 4               ; vtext.s, not shared NVR pseudo-registers. NVR remains caller scratch/mailbox.
0013B8r 4               .global VTEXT_LEFT
0013B8r 4               .global VTEXT_TOP
0013B8r 4               .global VTEXT_WIDTH
0013B8r 4               .global VTEXT_HEIGHT
0013B8r 4               .global VTEXT_CURX
0013B8r 4               .global VTEXT_CURY
0013B8r 4               .global VTEXT_COLOR
0013B8r 4               .global VTEXT_ATTR
0013B8r 4               .global VTEXT_CHAR
0013B8r 4               .global VTEXT_FLAGS
0013B8r 4               
0013B8r 4               ; Optional region-table ABI. Callers own the table storage and set these state
0013B8r 4               ; bytes before define/select/store.
0013B8r 4               .global VTEXT_TABLEL
0013B8r 4               .global VTEXT_TABLEH
0013B8r 4               .global VTEXT_REGION_ID
0013B8r 4               
0013B8r 4               VTEXT_REGION_LEFT = 0
0013B8r 4               VTEXT_REGION_TOP = 1
0013B8r 4               VTEXT_REGION_WIDTH = 2
0013B8r 4               VTEXT_REGION_HEIGHT = 3
0013B8r 4               VTEXT_REGION_CURX = 4
0013B8r 4               VTEXT_REGION_CURY = 5
0013B8r 4               VTEXT_REGION_COLOR = 6
0013B8r 4               VTEXT_REGION_ATTR = 7
0013B8r 4               VTEXT_REGION_FLAGS = 8
0013B8r 4               VTEXT_REGION_RESERVED = 9
0013B8r 4               VTEXT_REGION_SIZE = 10
0013B8r 4               
0013B8r 4               ; Public helper routines.
0013B8r 4               .global vtext_define_region
0013B8r 4               .global vtext_select_region
0013B8r 4               .global vtext_store_region
0013B8r 4               .global vtext_validate_region
0013B8r 4               .global vtext_set_cursor
0013B8r 4               .global vtext_sync_cursor
0013B8r 4               .global vtext_home
0013B8r 4               .global vtext_put_char
0013B8r 4               .global vtext_puts
0013B8r 4               .global vtext_put_hex_nibble
0013B8r 4               .global vtext_put_hex_byte
0013B8r 4               .global vtext_newline
0013B8r 4               .global vtext_clear_region
0013B8r 4               .global vtext_clear_line
0013B8r 4               .global vtext_scroll_up
0013B8r 4               .global vtext_wait_blitter
0013B8r 4               
0013B8r 4               .endif
0013B8r 4               
0013B8r 3               .include "blitter.s"
0013B8r 4               ; Shared Nova blitter helper routines.
0013B8r 4               ;
0013B8r 4               ; Callers load the BLT hardware registers, then call blitter_start_copy or
0013B8r 4               ; blitter_start_fill. Routines return A=0 on success and A=1 on error; detailed
0013B8r 4               ; errors remain in BLT_ERRCODE_REG.
0013B8r 4               
0013B8r 4               .include "blitter.inc"
0013B8r 5               ; Shared Nova blitter helper declarations.
0013B8r 5               
0013B8r 5               .ifndef BLITTER_INC_INCLUDED
0013B8r 5               BLITTER_INC_INCLUDED = 1
0013B8r 5               
0013B8r 5               .include "nova.inc"
0013B8r 5               
0013B8r 5               BLITTER_RESULT_OK    = $00
0013B8r 5               BLITTER_RESULT_ERROR = $01
0013B8r 5               
0013B8r 5               .endif
0013B8r 5               
0013B8r 4               
0013B8r 4               .ifndef BLITTER_IMPLEMENTATION_INCLUDED
0013B8r 4               BLITTER_IMPLEMENTATION_INCLUDED = 1
0013B8r 4               
0013B8r 4                     .segment "CODE"
0013B8r 4               
0013B8r 4                     .export blitter_copy
0013B8r 4                     .export blitter_fill
0013B8r 4                     .export blitter_start_copy
0013B8r 4                     .export blitter_start_fill
0013B8r 4                     .export blitter_wait
0013B8r 4               
0013B8r 4               ; @label BLITTER.COPY
0013B8r 4               ; @kind routine
0013B8r 4               ; @symbol blitter_copy
0013B8r 4               ; @summary Start a rectangular blitter copy using the BLT controller registers.
0013B8r 4               ; @requires BLT_SRCSPACE BLT_DSTSPACE BLT_SRCL BLT_SRCM BLT_SRCH BLT_DSTL BLT_DSTM BLT_DSTH BLT_WIDTHL BLT_WIDTHH BLT_HEIGHTL BLT_HEIGHTH BLT_SRCSTRL BLT_SRCSTRH BLT_DSTSTRL BLT_DSTSTRH
0013B8r 4               ; @out A: 0 on success, 1 on error.
0013B8r 4               blitter_copy:
0013B8r 4                     JMP   blitter_start_copy
0013B8r 4               
0013B8r 4               ; @label BLITTER.FILL
0013B8r 4               ; @kind routine
0013B8r 4               ; @symbol blitter_fill
0013B8r 4               ; @summary Start a rectangular blitter fill using destination, size, stride, and fill registers.
0013B8r 4               ; @requires BLT_DSTSPACE BLT_DSTL BLT_DSTM BLT_DSTH BLT_WIDTHL BLT_WIDTHH BLT_HEIGHTL BLT_HEIGHTH BLT_DSTSTRL BLT_DSTSTRH BLT_FILLVALUE
0013B8r 4               ; @out A: 0 on success, 1 on error.
0013B8r 4               blitter_fill:
0013B8r 4                     STZ   BLT_SRCSPACE
0013B8r 4                     STZ   BLT_SRCL
0013B8r 4                     STZ   BLT_SRCM
0013B8r 4                     STZ   BLT_SRCH
0013B8r 4                     STZ   BLT_SRCSTRL
0013B8r 4                     STZ   BLT_SRCSTRH
0013B8r 4                     STZ   BLT_CKEY
0013B8r 4                     JMP   blitter_start_fill
0013B8r 4               
0013B8r 4               ; @label BLITTER.START_COPY
0013B8r 4               ; @kind routine
0013B8r 4               ; @symbol blitter_start_copy
0013B8r 4               ; @summary Low-level blitter copy start. Call BLITTER.COPY for the public wrapper.
0013B8r 4               ; @out A: 0 on success, 1 on error.
0013B8r 4               blitter_start_copy:
0013B8r 4                     STZ   BLT_MODE_REG
0013B8r 4                     STZ   BLT_CKEY
0013B8r 4                     LDA   #BLT_CMD_START
0013B8r 4                     STA   BLT_CMD_REG
0013B8r 4                     JMP   blitter_wait
0013B8r 4               
0013B8r 4               ; @label BLITTER.START_FILL
0013B8r 4               ; @kind routine
0013B8r 4               ; @symbol blitter_start_fill
0013B8r 4               ; @summary Low-level blitter fill start. Call BLITTER.FILL for the public wrapper.
0013B8r 4               ; @out A: 0 on success, 1 on error.
0013B8r 4               blitter_start_fill:
0013B8r 4                     LDA   #BLT_MODE_FILL
0013B8r 4                     STA   BLT_MODE_REG
0013B8r 4                     LDA   #BLT_CMD_START
0013B8r 4                     STA   BLT_CMD_REG
0013B8r 4                     JMP   blitter_wait
0013B8r 4               
0013B8r 4               ; @label BLITTER.WAIT
0013B8r 4               ; @kind routine
0013B8r 4               ; @symbol blitter_wait
0013B8r 4               ; @summary Wait for the blitter controller to leave BUSY and return shared status.
0013B8r 4               ; @out A: 0 on success, 1 on error.
0013B8r 4               blitter_wait:
0013B8r 4               @loop:
0013B8r 4                     LDA   BLT_STATUS_REG
0013B8r 4                     CMP   #BLT_STATUS_BUSY
0013B8r 4                     BEQ   @loop
0013B8r 4                     CMP   #BLT_STATUS_OK
0013B8r 4                     BEQ   @ok
0013B8r 4                     LDA   #BLITTER_RESULT_ERROR
0013B8r 4                     RTS
0013B8r 4               @ok:
0013B8r 4                     LDA   #BLITTER_RESULT_OK
0013B8r 4                     RTS
0013B8r 4               
0013B8r 4               .endif
0013B8r 4               
0013B8r 3               
0013B8r 3               .ifndef VTEXT_IMPLEMENTATION_INCLUDED
0013B8r 3               VTEXT_IMPLEMENTATION_INCLUDED = 1
0013B8r 3               
0013B8r 3                     .segment "BSS"
000045r 3               
000045r 3  xx           VTEXT_LEFT:       .res 1
000046r 3  xx           VTEXT_TOP:        .res 1
000047r 3  xx           VTEXT_WIDTH:      .res 1
000048r 3  xx           VTEXT_HEIGHT:     .res 1
000049r 3  xx           VTEXT_CURX:       .res 1
00004Ar 3  xx           VTEXT_CURY:       .res 1
00004Br 3  xx           VTEXT_COLOR:      .res 1
00004Cr 3  xx           VTEXT_ATTR:       .res 1
00004Dr 3  xx           VTEXT_CHAR:       .res 1
00004Er 3  xx           VTEXT_FLAGS:      .res 1
00004Fr 3  xx           VTEXT_TABLEL:     .res 1
000050r 3  xx           VTEXT_TABLEH:     .res 1
000051r 3  xx           VTEXT_REGION_ID:  .res 1
000052r 3               
000052r 3                     .segment "ZEROPAGE"
000003r 3               
000003r 3  xx           VTEXT_ADDRL:      .res 1
000004r 3  xx           VTEXT_ADDRH:      .res 1
000005r 3  xx           VTEXT_TMP:        .res 1
000006r 3  xx           VTEXT_STRL:       .res 1
000007r 3  xx           VTEXT_STRH:       .res 1
000008r 3               
000008r 3                     .segment "CODE"
0013B8r 3               
0013B8r 3                     .export vtext_define_region
0013B8r 3                     .export vtext_select_region
0013B8r 3                     .export vtext_store_region
0013B8r 3                     .export vtext_validate_region
0013B8r 3                     .export vtext_set_cursor
0013B8r 3                     .export vtext_sync_cursor
0013B8r 3                     .export vtext_home
0013B8r 3                     .export vtext_put_char
0013B8r 3                     .export vtext_puts
0013B8r 3                     .export vtext_put_hex_nibble
0013B8r 3                     .export vtext_put_hex_byte
0013B8r 3                     .export vtext_newline
0013B8r 3                     .export vtext_clear_region
0013B8r 3                     .export vtext_clear_line
0013B8r 3                     .export vtext_scroll_up
0013B8r 3                     .export vtext_wait_blitter
0013B8r 3               
0013B8r 3               vtext_ok:
0013B8r 3  A9 00              LDA   #VTEXT_OK
0013BAr 3  60                 RTS
0013BBr 3               
