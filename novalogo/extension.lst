000000r 5               ; BASIC SYS register bridge. SYS addr[,A[,X[,Y]]] loads A/X/Y from these
000000r 5               ; bytes before jumping and stores A/X/Y back here when the routine returns.
000000r 5               ; @label SYS.REGA
000000r 5               ; @kind u8
000000r 5               ; @symbol SYS_REGA
000000r 5               ; @summary Returned A register from the most recent SYS call.
000000r 5               .ifndef SYS_REGA
000000r 5               SYS_REGA          = $E7
000000r 5               .endif
000000r 5               ; @label SYS.REGX
000000r 5               ; @kind u8
000000r 5               ; @symbol SYS_REGX
000000r 5               ; @summary Returned X register from the most recent SYS call.
000000r 5               .ifndef SYS_REGX
000000r 5               SYS_REGX          = $E8
000000r 5               .endif
000000r 5               ; @label SYS.REGY
000000r 5               ; @kind u8
000000r 5               ; @symbol SYS_REGY
000000r 5               ; @summary Returned Y register from the most recent SYS call.
000000r 5               .ifndef SYS_REGY
000000r 5               SYS_REGY          = $E9
000000r 5               .endif
000000r 5               
