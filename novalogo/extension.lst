0025EDr 2                     ; count = end - start, clamp to clip cap
0025EDr 2  38                 SEC
0025EEr 2  AD rr rr           LDA   EB_SELENDL
0025F1r 2  ED rr rr           SBC   EB_SELSTARTL
0025F4r 2  8D rr rr           STA   EDITBUF_CLIPLENL
