000000r 1               
000000r 1               ; --- Turtle virtual-sprite configuration ---
000000r 1               TURTLE_SPR_SIZE   = 16
000000r 1               TURTLE_SPR_HALF   = 8
000000r 1               TURTLE_MAX_X      = 304        ; 320 - 16
000000r 1               TURTLE_MAX_Y      = 184        ; 200 - 16
000000r 1               TURTLE_CENTER_X   = 160        ; center of 320-wide graphics
000000r 1               TURTLE_CENTER_Y   = 80         ; center of split graphics viewport
000000r 1               SPLIT_Y           = 160        ; copper split: gfx rows 0-159, text below
000000r 1               SPLIT_TEXT_ROW    = 40         ; 160px / 4px text cell height
000000r 1               SPLIT_TEXT_HEIGHT = 10
000000r 1               MODE_GFX_SPRITES  = 3          ; VGC mode: graphics + sprites
000000r 1               MODE_TEXT_ONLY    = 0
000000r 1               COL_WHITE         = 1
000000r 1               COL_RED           = 2
000000r 1               COL_GREEN         = 5
000000r 1               
000000r 1               ; --- Base-ROM list cell format, used by SETPOS [x y] ---
000000r 1               CONS_CAR_TYPE     = 1
000000r 1               CONS_CAR_HI       = 2
000000r 1               CONS_CAR_LO       = 3
000000r 1               CONS_CDR_LO       = 5
000000r 1               CONS_CDR_HI       = 6
000000r 1               
000000r 1               ; --- Local ZP temporaries (reuse NVR scratch) ---
000000r 1               tmp0              = NVR0L
000000r 1               tmp1              = NVR0H
000000r 1               tmp2              = NVR1L
000000r 1               tmp3              = NVR1H
000000r 1               old_x_lo          = NVR2L
000000r 1               old_x_hi          = NVR2H
000000r 1               old_y_lo          = NVR3L
000000r 1               old_y_hi          = NVR3H
000000r 1               dx_lo             = NVR4L
000000r 1               dx_hi             = NVR4H
000000r 1               dy_lo             = NVR5L
000000r 1               dy_hi             = NVR5H
000000r 1               sin_val           = NVR6L
000000r 1               cos_val           = NVR6H
000000r 1               
000000r 1                     .segment "BSS"
000000r 1               
000000r 1               turtle_source_shape:
000000r 1  xx xx xx xx        .res TURTLE_SPR_SIZE * TURTLE_SPR_SIZE
000004r 1  xx xx xx xx  
000008r 1  xx xx xx xx  
000100r 1               turtle_rotated_shape:
000100r 1  xx xx xx xx        .res TURTLE_SPR_SIZE * TURTLE_SPR_SIZE
000104r 1  xx xx xx xx  
000108r 1  xx xx xx xx  
000200r 1               turtle_saved_bg:
000200r 1  xx xx xx xx        .res TURTLE_SPR_SIZE * TURTLE_SPR_SIZE
000204r 1  xx xx xx xx  
000208r 1  xx xx xx xx  
000300r 1               TURTLE_X_FRAC:
000300r 1  xx                 .res 1
000301r 1               TURTLE_X_LO:
000301r 1  xx                 .res 1
000302r 1               TURTLE_X_HI:
000302r 1  xx                 .res 1
000303r 1               TURTLE_Y_FRAC:
000303r 1  xx                 .res 1
000304r 1               TURTLE_Y_LO:
000304r 1  xx                 .res 1
000305r 1               TURTLE_Y_HI:
000305r 1  xx                 .res 1
000306r 1               TURTLE_HEADING_LO:
000306r 1  xx                 .res 1
000307r 1               TURTLE_HEADING_HI:
000307r 1  xx                 .res 1
000308r 1               TURTLE_PEN:
000308r 1  xx                 .res 1
000309r 1               TURTLE_SHOWN:
000309r 1  xx                 .res 1
00030Ar 1               TURTLE_COLOR:
00030Ar 1  xx                 .res 1
00030Br 1               TURTLE_SPRITE:
00030Br 1  xx                 .res 1
00030Cr 1               TURTLE_INITED:
00030Cr 1  xx                 .res 1
00030Dr 1               turtle_bg_x_lo:
00030Dr 1  xx                 .res 1
00030Er 1               turtle_bg_x_hi:
00030Er 1  xx                 .res 1
00030Fr 1               turtle_bg_y:
00030Fr 1  xx                 .res 1
000310r 1               turtle_bg_saved:
000310r 1  xx                 .res 1
000311r 1               
000311r 1                     .segment "CODE"
000000r 1               
000000r 1               ; =====================================================================
000000r 1               ; Extension entry point — called via JSR $C000 from RAM trampoline
000000r 1               ; =====================================================================
000000r 1               ext_entry:
000000r 1  D8                 CLD                       ; all extension math is binary, never BCD
000001r 1  A5 80              LDA   EXT_CMD
000003r 1  0A                 ASL                       ; * 2 for word-sized table
000004r 1  AA                 TAX
000005r 1  BD rr rr           LDA   ext_dispatch+1,X   ; high byte of handler-1
000008r 1  48                 PHA
000009r 1  BD rr rr           LDA   ext_dispatch,X     ; low byte of handler-1
00000Cr 1  48                 PHA
00000Dr 1  60                 RTS                       ; dispatch via RTS trick
00000Er 1               
00000Er 1               ; --- Dispatch table (entries are handler_address - 1) ---
00000Er 1               ext_dispatch:
00000Er 1  rr rr              .word ext_unsupported-1   ; cmd $00: reserved
000010r 1  rr rr              .word ext_test-1          ; cmd $01: EXT.TEST
000012r 1  rr rr              .word ext_unsupported-1   ; cmd $02
000014r 1  rr rr              .word ext_unsupported-1   ; cmd $03
000016r 1  rr rr              .word ext_unsupported-1   ; cmd $04
000018r 1  rr rr              .word ext_unsupported-1   ; cmd $05
00001Ar 1  rr rr              .word ext_unsupported-1   ; cmd $06
00001Cr 1  rr rr              .word ext_unsupported-1   ; cmd $07
00001Er 1  rr rr              .word ext_unsupported-1   ; cmd $08
000020r 1  rr rr              .word ext_unsupported-1   ; cmd $09
000022r 1  rr rr              .word ext_unsupported-1   ; cmd $0A
000024r 1  rr rr              .word ext_unsupported-1   ; cmd $0B
000026r 1  rr rr              .word ext_unsupported-1   ; cmd $0C
000028r 1  rr rr              .word ext_unsupported-1   ; cmd $0D
00002Ar 1  rr rr              .word ext_unsupported-1   ; cmd $0E
00002Cr 1  rr rr              .word ext_unsupported-1   ; cmd $0F
00002Er 1  rr rr              .word ext_fd-1            ; cmd $10: FD
000030r 1  rr rr              .word ext_bk-1            ; cmd $11: BK
000032r 1  rr rr              .word ext_rt-1            ; cmd $12: RT
000034r 1  rr rr              .word ext_lt-1            ; cmd $13: LT
000036r 1  rr rr              .word ext_cs-1            ; cmd $14: CS
000038r 1  rr rr              .word ext_pu-1            ; cmd $15: PU
00003Ar 1  rr rr              .word ext_pd-1            ; cmd $16: PD
00003Cr 1  rr rr              .word ext_st-1            ; cmd $17: ST
00003Er 1  rr rr              .word ext_ht-1            ; cmd $18: HT
000040r 1  rr rr              .word ext_home-1          ; cmd $19: HOME
000042r 1  rr rr              .word ext_ts-1            ; cmd $1A: TEXTSCREEN
000044r 1  rr rr              .word ext_ss-1            ; cmd $1B: SPLITSCREEN
000046r 1  rr rr              .word ext_fs-1            ; cmd $1C: FULLSCREEN
000048r 1  rr rr              .word ext_setxy-1         ; cmd $1D: SETXY
00004Ar 1  rr rr              .word ext_setx-1          ; cmd $1E: SETX
00004Cr 1  rr rr              .word ext_sety-1          ; cmd $1F: SETY
00004Er 1  rr rr              .word ext_seth-1          ; cmd $20: SETHEADING
000050r 1  rr rr              .word ext_xcor-1          ; cmd $21: XCOR
000052r 1  rr rr              .word ext_ycor-1          ; cmd $22: YCOR
000054r 1  rr rr              .word ext_heading-1       ; cmd $23: HEADING
000056r 1  rr rr              .word ext_pendownp-1      ; cmd $24: PENDOWN?
000058r 1  rr rr              .word ext_shownp-1        ; cmd $25: SHOWN?
00005Ar 1  rr rr              .word ext_setpc-1         ; cmd $26: SETPC
00005Cr 1  rr rr              .word ext_setbg-1         ; cmd $27: SETBG
00005Er 1  rr rr              .word ext_towards-1       ; cmd $28: TOWARDS
000060r 1  rr rr              .word ext_setpos-1        ; cmd $29: SETPOS
000062r 1  rr rr              .word ext_unsupported-1   ; cmd $2A
000064r 1  rr rr              .word ext_unsupported-1   ; cmd $2B
000066r 1  rr rr              .word ext_unsupported-1   ; cmd $2C
000068r 1  rr rr              .word ext_unsupported-1   ; cmd $2D
00006Ar 1  rr rr              .word ext_unsupported-1   ; cmd $2E
00006Cr 1  rr rr              .word ext_unsupported-1   ; cmd $2F
00006Er 1  rr rr              .word ext_setcolor-1      ; cmd $30: SETCOLOR
000070r 1  rr rr              .word ext_plot-1          ; cmd $31: PLOT
000072r 1  rr rr              .word ext_unplot-1        ; cmd $32: UNPLOT
000074r 1  rr rr              .word ext_line-1          ; cmd $33: LINE
000076r 1  rr rr              .word ext_circle-1        ; cmd $34: CIRCLE
000078r 1  rr rr              .word ext_rect-1          ; cmd $35: RECT
00007Ar 1  rr rr              .word ext_fillrect-1      ; cmd $36: FILL
00007Cr 1  rr rr              .word ext_paint-1         ; cmd $37: PAINT
00007Er 1  rr rr              .word ext_unsupported-1   ; cmd $38
000080r 1  rr rr              .word ext_unsupported-1   ; cmd $39
000082r 1  rr rr              .word ext_unsupported-1   ; cmd $3A
000084r 1  rr rr              .word ext_unsupported-1   ; cmd $3B
000086r 1  rr rr              .word ext_unsupported-1   ; cmd $3C
000088r 1  rr rr              .word ext_unsupported-1   ; cmd $3D
00008Ar 1  rr rr              .word ext_unsupported-1   ; cmd $3E
00008Cr 1  rr rr              .word ext_unsupported-1   ; cmd $3F
00008Er 1  rr rr              .word ext_sprite-1        ; cmd $40: SPRITE
000090r 1  rr rr              .word ext_spritepos-1     ; cmd $41: SPRITEPOS
000092r 1  rr rr              .word ext_spriteon-1      ; cmd $42: SPRITEON
000094r 1  rr rr              .word ext_spriteoff-1     ; cmd $43: SPRITEOFF
000096r 1  rr rr              .word ext_sprcollp-1      ; cmd $44: SPRITECOLLISION?
000098r 1  rr rr              .word ext_tone-1          ; cmd $45: TONE
00009Ar 1  rr rr              .word ext_noise-1         ; cmd $46: NOISE
00009Cr 1  rr rr              .word ext_volume-1        ; cmd $47: VOLUME
00009Er 1  rr rr              .word ext_wait-1          ; cmd $48: WAIT
0000A0r 1  rr rr              .word ext_waitvbl-1       ; cmd $49: WAITVBL
0000A2r 1  rr rr              .word ext_timer-1         ; cmd $4A: TIMER
0000A4r 1               
0000A4r 1               ; =====================================================================
0000A4r 1               ; ext_unsupported — unknown command, just return
0000A4r 1               ; =====================================================================
0000A4r 1               ext_unsupported:
0000A4r 1  60                 RTS
0000A5r 1               
0000A5r 1               ; =====================================================================
0000A5r 1               ; ext_test — test command: returns arg0 + 1
0000A5r 1               ; =====================================================================
0000A5r 1               ext_test:
0000A5r 1  18                 CLC
0000A6r 1  A5 84              LDA   EXT_ARG0_LO
0000A8r 1  69 01              ADC   #1
0000AAr 1  85 90              STA   EXT_RESULT_LO
0000ACr 1  A5 83              LDA   EXT_ARG0_HI
0000AEr 1  69 00              ADC   #0
0000B0r 1  85 8F              STA   EXT_RESULT_HI
0000B2r 1  A5 85              LDA   EXT_ARG0_FRAC
0000B4r 1  85 91              STA   EXT_RESULT_FRAC
0000B6r 1  64 8E              STZ   EXT_RESULT_TYPE    ; VAL_NUMBER
0000B8r 1  60                 RTS
0000B9r 1               
0000B9r 1               ; =====================================================================
0000B9r 1               ; ext_cs — clear screen, set up graphics mode, init turtle
0000B9r 1               ; =====================================================================
0000B9r 1               ext_cs:
0000B9r 1  9C 01 A0           STZ   VGC_BGCOL
0000BCr 1  A9 01              LDA   #COL_WHITE
0000BEr 1  8D 02 A0           STA   VGC_FGCOL
0000C1r 1  9C 0D A0           STZ   VGC_BORDER
0000C4r 1  9C E8 A0           STZ   VGC_GFXTRANS
0000C7r 1  9C 05 A0           STZ   VGC_SCROLLX
0000CAr 1  9C 06 A0           STZ   VGC_SCROLLY
0000CDr 1  9C EA A0           STZ   VGC_SCROLLCTL
0000D0r 1  A9 00              LDA   #MODE_TEXT_ONLY
0000D2r 1  8D 00 A0           STA   VGC_MODE
0000D5r 1  20 rr rr           JSR   clear_gfx_plane
0000D8r 1               
0000D8r 1                     ; Set up copper split: graphics+sprites top, text bottom
0000D8r 1  20 rr rr           JSR   setup_copper
0000DBr 1  20 rr rr           JSR   prepare_split_text
0000DEr 1               
0000DEr 1                     ; Initialize turtle state
0000DEr 1  20 rr rr           JSR   turtle_init
0000E1r 1               
0000E1r 1                     ; Show centered virtual sprite
0000E1r 1  20 rr rr           JSR   draw_turtle_sprite
0000E4r 1               
0000E4r 1  60                 RTS
0000E5r 1               
0000E5r 1               ; =====================================================================
0000E5r 1               ; ext_fd — move forward by distance
0000E5r 1               ; =====================================================================
0000E5r 1               ext_fd:
0000E5r 1                     ; Ensure turtle is initialized
0000E5r 1  AD rr rr           LDA   TURTLE_INITED
0000E8r 1  D0 03              BNE   @go
0000EAr 1  20 rr rr           JSR   turtle_init
0000EDr 1               @go:
0000EDr 1                     ; Save old integer position for line drawing
0000EDr 1  AD rr rr           LDA   TURTLE_X_LO
0000F0r 1  85 24              STA   old_x_lo
0000F2r 1  AD rr rr           LDA   TURTLE_X_HI
0000F5r 1  85 25              STA   old_x_hi
0000F7r 1  AD rr rr           LDA   TURTLE_Y_LO
0000FAr 1  85 26              STA   old_y_lo
0000FCr 1  AD rr rr           LDA   TURTLE_Y_HI
0000FFr 1  85 27              STA   old_y_hi
000101r 1  20 rr rr           JSR   erase_turtle_sprite
000104r 1               
000104r 1                     ; Convert heading degrees to the exact NDK/blitter angle byte.
000104r 1  20 rr rr           JSR   turtle_heading_u8
000107r 1  85 20              STA   tmp0
000109r 1               
000109r 1                     ; Get sin/cos from coprocessor
000109r 1                     ; Logo heading: 0=north, 90=east, 180=south, 270=west
000109r 1                     ; sin(heading) gives dx, -cos(heading) gives dy (screen y goes down)
000109r 1  8D 2E BB           STA   MATH_SINCOS_ANGLE  ; triggers sincos
00010Cr 1  AD 38 BB           LDA   MATH_RES0          ; sin (1.7 signed: -128..+127)
00010Fr 1  85 2C              STA   sin_val
000111r 1  AD 39 BB           LDA   MATH_RES1          ; cos (1.7 signed)
000114r 1  85 2D              STA   cos_val
000116r 1               
000116r 1                     ; Compute dx = distance * sin / 128
000116r 1                     ; distance is 16.8 fixed point in EXT_ARG0 (hi:lo:frac)
000116r 1                     ; For simplicity, use integer part only for the multiply
000116r 1  A5 84              LDA   EXT_ARG0_LO
000118r 1  8D 20 BB           STA   MATH_MUL16_A_LO
00011Br 1  A5 83              LDA   EXT_ARG0_HI
00011Dr 1  8D 21 BB           STA   MATH_MUL16_A_HI
000120r 1                     ; Sign-extend sin to 16-bit
000120r 1  A5 2C              LDA   sin_val
000122r 1  8D 22 BB           STA   MATH_MUL16_B_LO
000125r 1  09 7F              ORA   #$7F
000127r 1  30 04              BMI   @sin_neg
000129r 1  A9 00              LDA   #$00
00012Br 1  80 02              BRA   @sin_ext
00012Dr 1               @sin_neg:
00012Dr 1  A9 FF              LDA   #$FF
00012Fr 1               @sin_ext:
00012Fr 1  8D 23 BB           STA   MATH_MUL16_B_HI    ; triggers multiply
000132r 1               
000132r 1                     ; dx = round(result / 128). The math coprocessor exposes 1.7 signed
000132r 1                     ; sin/cos, so +1.0 is 127/128; rounding keeps cardinal moves exact.
000132r 1  18                 CLC
000133r 1  AD 38 BB           LDA   MATH_RES0
000136r 1  69 40              ADC   #64
000138r 1  85 22              STA   tmp2
00013Ar 1  AD 39 BB           LDA   MATH_RES1
00013Dr 1  69 00              ADC   #0
00013Fr 1  85 23              STA   tmp3
000141r 1  AD 3A BB           LDA   MATH_RES2
000144r 1  69 00              ADC   #0
000146r 1  85 21              STA   tmp1
000148r 1  A5 22              LDA   tmp2
00014Ar 1  0A                 ASL                       ; bit 7 → carry
00014Br 1  A5 23              LDA   tmp3
00014Dr 1  2A                 ROL
00014Er 1  85 28              STA   dx_lo
000150r 1  A5 21              LDA   tmp1
000152r 1  2A                 ROL
000153r 1  85 29              STA   dx_hi
000155r 1               
000155r 1                     ; Compute dy = -(distance * cos / 128)
000155r 1                     ; (negative because screen y increases downward)
000155r 1  A5 84              LDA   EXT_ARG0_LO
000157r 1  8D 20 BB           STA   MATH_MUL16_A_LO
00015Ar 1  A5 83              LDA   EXT_ARG0_HI
00015Cr 1  8D 21 BB           STA   MATH_MUL16_A_HI
00015Fr 1                     ; Sign-extend cos to 16-bit
00015Fr 1  A5 2D              LDA   cos_val
000161r 1  8D 22 BB           STA   MATH_MUL16_B_LO
000164r 1  09 7F              ORA   #$7F
000166r 1  30 04              BMI   @cos_neg
000168r 1  A9 00              LDA   #$00
00016Ar 1  80 02              BRA   @cos_ext
00016Cr 1               @cos_neg:
00016Cr 1  A9 FF              LDA   #$FF
00016Er 1               @cos_ext:
00016Er 1  8D 23 BB           STA   MATH_MUL16_B_HI    ; triggers multiply
000171r 1               
000171r 1                     ; raw_dy = round(result / 128)
000171r 1  18                 CLC
000172r 1  AD 38 BB           LDA   MATH_RES0
000175r 1  69 40              ADC   #64
000177r 1  85 22              STA   tmp2
000179r 1  AD 39 BB           LDA   MATH_RES1
00017Cr 1  69 00              ADC   #0
00017Er 1  85 23              STA   tmp3
000180r 1  AD 3A BB           LDA   MATH_RES2
000183r 1  69 00              ADC   #0
000185r 1  85 21              STA   tmp1
000187r 1  A5 22              LDA   tmp2
000189r 1  0A                 ASL
00018Ar 1  A5 23              LDA   tmp3
00018Cr 1  2A                 ROL
00018Dr 1  85 22              STA   tmp2                ; raw_dy lo
00018Fr 1  A5 21              LDA   tmp1
000191r 1  2A                 ROL
000192r 1  85 23              STA   tmp3                ; raw_dy hi
000194r 1               
000194r 1                     ; dy = -raw_dy (negate 16-bit)
000194r 1  38                 SEC
000195r 1  A9 00              LDA   #0
000197r 1  E5 22              SBC   tmp2
000199r 1  85 2A              STA   dy_lo
00019Br 1  A9 00              LDA   #0
00019Dr 1  E5 23              SBC   tmp3
00019Fr 1  85 2B              STA   dy_hi
0001A1r 1               
0001A1r 1                     ; Add dx to turtle X (24-bit: hi:lo:frac)
0001A1r 1                     ; dx is integer pixels, add to lo:hi (frac stays)
0001A1r 1  18                 CLC
0001A2r 1  AD rr rr           LDA   TURTLE_X_LO
0001A5r 1  65 28              ADC   dx_lo
0001A7r 1  8D rr rr           STA   TURTLE_X_LO
0001AAr 1  AD rr rr           LDA   TURTLE_X_HI
0001ADr 1  65 29              ADC   dx_hi
0001AFr 1  8D rr rr           STA   TURTLE_X_HI
0001B2r 1               
0001B2r 1                     ; Add dy to turtle Y
0001B2r 1  18                 CLC
0001B3r 1  AD rr rr           LDA   TURTLE_Y_LO
0001B6r 1  65 2A              ADC   dy_lo
0001B8r 1  8D rr rr           STA   TURTLE_Y_LO
0001BBr 1  AD rr rr           LDA   TURTLE_Y_HI
0001BEr 1  65 2B              ADC   dy_hi
0001C0r 1  8D rr rr           STA   TURTLE_Y_HI
0001C3r 1               
0001C3r 1                     ; If pen is down, draw line from old to new position
0001C3r 1  AD rr rr           LDA   TURTLE_PEN
0001C6r 1  D0 03              BNE   @skip_draw          ; pen up = $01, skip
0001C8r 1  20 rr rr           JSR   draw_line
0001CBr 1               @skip_draw:
0001CBr 1               
0001CBr 1                     ; Redraw virtual sprite at the new position
0001CBr 1  20 rr rr           JSR   draw_turtle_sprite
0001CEr 1  60                 RTS
0001CFr 1               
0001CFr 1               ; =====================================================================
0001CFr 1               ; ext_bk — move backward by distance (negate and forward)
0001CFr 1               ; =====================================================================
0001CFr 1               ext_bk:
0001CFr 1                     ; Negate arg0 (16.8 two's complement)
0001CFr 1  38                 SEC
0001D0r 1  A9 00              LDA   #0
0001D2r 1  E5 85              SBC   EXT_ARG0_FRAC
0001D4r 1  85 85              STA   EXT_ARG0_FRAC
0001D6r 1  A9 00              LDA   #0
0001D8r 1  E5 84              SBC   EXT_ARG0_LO
0001DAr 1  85 84              STA   EXT_ARG0_LO
0001DCr 1  A9 00              LDA   #0
0001DEr 1  E5 83              SBC   EXT_ARG0_HI
0001E0r 1  85 83              STA   EXT_ARG0_HI
0001E2r 1  4C rr rr           JMP   ext_fd
0001E5r 1               
0001E5r 1               ; =====================================================================
0001E5r 1               ; ext_rt — turn right by degrees
0001E5r 1               ; =====================================================================
0001E5r 1               ext_rt:
0001E5r 1                     ; heading = (heading + degrees) mod 360
0001E5r 1  18                 CLC
0001E6r 1  AD rr rr           LDA   TURTLE_HEADING_LO
0001E9r 1  65 84              ADC   EXT_ARG0_LO
0001EBr 1  8D rr rr           STA   TURTLE_HEADING_LO
0001EEr 1  AD rr rr           LDA   TURTLE_HEADING_HI
0001F1r 1  65 83              ADC   EXT_ARG0_HI
0001F3r 1  8D rr rr           STA   TURTLE_HEADING_HI
0001F6r 1               
0001F6r 1                     ; Reduce mod 360
0001F6r 1  20 rr rr           JSR   heading_mod360
0001F9r 1               
0001F9r 1                     ; Redraw virtual sprite with the new heading
0001F9r 1  20 rr rr           JSR   draw_turtle_sprite
0001FCr 1  60                 RTS
0001FDr 1               
0001FDr 1               ; =====================================================================
0001FDr 1               ; ext_lt — turn left by degrees
0001FDr 1               ; =====================================================================
0001FDr 1               ext_lt:
0001FDr 1                     ; heading = (heading - degrees) mod 360
0001FDr 1                     ; If result negative, add 360
0001FDr 1  38                 SEC
0001FEr 1  AD rr rr           LDA   TURTLE_HEADING_LO
000201r 1  E5 84              SBC   EXT_ARG0_LO
000203r 1  8D rr rr           STA   TURTLE_HEADING_LO
000206r 1  AD rr rr           LDA   TURTLE_HEADING_HI
000209r 1  E5 83              SBC   EXT_ARG0_HI
00020Br 1  8D rr rr           STA   TURTLE_HEADING_HI
00020Er 1               
00020Er 1                     ; If negative (hi bit 7 set), add 360
00020Er 1  30 07              BMI   @add360
000210r 1                     ; Also do mod 360 in case it's >=360
000210r 1  20 rr rr           JSR   heading_mod360
000213r 1  20 rr rr           JSR   draw_turtle_sprite
000216r 1  60                 RTS
000217r 1               
000217r 1               @add360:
000217r 1  18                 CLC
000218r 1  AD rr rr           LDA   TURTLE_HEADING_LO
00021Br 1  69 68              ADC   #<360
00021Dr 1  8D rr rr           STA   TURTLE_HEADING_LO
000220r 1  AD rr rr           LDA   TURTLE_HEADING_HI
000223r 1  69 01              ADC   #>360
000225r 1  8D rr rr           STA   TURTLE_HEADING_HI
000228r 1                     ; Could still be negative if turned more than 360, recurse
000228r 1  30 ED              BMI   @add360
00022Ar 1  20 rr rr           JSR   heading_mod360
00022Dr 1  20 rr rr           JSR   draw_turtle_sprite
000230r 1  60                 RTS
000231r 1               
000231r 1               ; =====================================================================
000231r 1               ; ext_pu — pen up
000231r 1               ; =====================================================================
000231r 1               ext_pu:
000231r 1  A9 01              LDA   #$01
000233r 1  8D rr rr           STA   TURTLE_PEN
000236r 1  60                 RTS
000237r 1               
000237r 1               ; =====================================================================
000237r 1               ; ext_pd — pen down
000237r 1               ; =====================================================================
000237r 1               ext_pd:
000237r 1  9C rr rr           STZ   TURTLE_PEN
00023Ar 1  60                 RTS
00023Br 1               
00023Br 1               ; =====================================================================
00023Br 1               ; ext_st — show turtle sprite
00023Br 1               ; =====================================================================
00023Br 1               ext_st:
00023Br 1  A9 01              LDA   #$01
00023Dr 1  8D rr rr           STA   TURTLE_SHOWN
000240r 1  4C rr rr           JMP   draw_turtle_sprite
000243r 1               
000243r 1               ; =====================================================================
000243r 1               ; ext_ht — hide turtle sprite
000243r 1               ; =====================================================================
000243r 1               ext_ht:
000243r 1  20 rr rr           JSR   erase_turtle_sprite
000246r 1  9C rr rr           STZ   TURTLE_SHOWN
000249r 1  60                 RTS
00024Ar 1               
00024Ar 1               ; =====================================================================
00024Ar 1               ; ext_home — move to center, heading 0 (draw line if pen down)
00024Ar 1               ; =====================================================================
00024Ar 1               ext_home:
00024Ar 1                     ; Ensure initialized
00024Ar 1  AD rr rr           LDA   TURTLE_INITED
00024Dr 1  D0 07              BNE   @go
00024Fr 1  20 rr rr           JSR   turtle_init
000252r 1  20 rr rr           JSR   draw_turtle_sprite
000255r 1  60                 RTS
000256r 1               @go:
000256r 1                     ; Save old position
000256r 1  AD rr rr           LDA   TURTLE_X_LO
000259r 1  85 24              STA   old_x_lo
00025Br 1  AD rr rr           LDA   TURTLE_X_HI
00025Er 1  85 25              STA   old_x_hi
000260r 1  AD rr rr           LDA   TURTLE_Y_LO
000263r 1  85 26              STA   old_y_lo
000265r 1  AD rr rr           LDA   TURTLE_Y_HI
000268r 1  85 27              STA   old_y_hi
00026Ar 1  20 rr rr           JSR   erase_turtle_sprite
00026Dr 1               
00026Dr 1                     ; Move to center
00026Dr 1  A9 A0              LDA   #TURTLE_CENTER_X
00026Fr 1  8D rr rr           STA   TURTLE_X_LO
000272r 1  9C rr rr           STZ   TURTLE_X_HI
000275r 1  9C rr rr           STZ   TURTLE_X_FRAC
000278r 1  A9 50              LDA   #TURTLE_CENTER_Y
00027Ar 1  8D rr rr           STA   TURTLE_Y_LO
00027Dr 1  9C rr rr           STZ   TURTLE_Y_HI
000280r 1  9C rr rr           STZ   TURTLE_Y_FRAC
000283r 1               
000283r 1                     ; Heading = 0
000283r 1  9C rr rr           STZ   TURTLE_HEADING_LO
000286r 1  9C rr rr           STZ   TURTLE_HEADING_HI
000289r 1               
000289r 1                     ; Draw line if pen down
000289r 1  AD rr rr           LDA   TURTLE_PEN
00028Cr 1  D0 03              BNE   @no_draw
00028Er 1  20 rr rr           JSR   draw_line
000291r 1               @no_draw:
000291r 1  20 rr rr           JSR   draw_turtle_sprite
000294r 1  60                 RTS
000295r 1               
000295r 1               ; =====================================================================
000295r 1               ; turtle_init — initialize turtle state and sprite
000295r 1               ; =====================================================================
000295r 1               turtle_init:
000295r 1                     ; Position to center (160, 100) as 16.8
000295r 1  A9 A0              LDA   #TURTLE_CENTER_X
000297r 1  8D rr rr           STA   TURTLE_X_LO
00029Ar 1  9C rr rr           STZ   TURTLE_X_HI
00029Dr 1  9C rr rr           STZ   TURTLE_X_FRAC
0002A0r 1  A9 50              LDA   #TURTLE_CENTER_Y
0002A2r 1  8D rr rr           STA   TURTLE_Y_LO
0002A5r 1  9C rr rr           STZ   TURTLE_Y_HI
0002A8r 1  9C rr rr           STZ   TURTLE_Y_FRAC
0002ABr 1                     ; Heading 0 (north)
0002ABr 1  9C rr rr           STZ   TURTLE_HEADING_LO
0002AEr 1  9C rr rr           STZ   TURTLE_HEADING_HI
0002B1r 1                     ; Pen down, shown, white
0002B1r 1  9C rr rr           STZ   TURTLE_PEN
0002B4r 1  A9 01              LDA   #$01
0002B6r 1  8D rr rr           STA   TURTLE_SHOWN
0002B9r 1  A9 01              LDA   #1                  ; white in Nova palette
0002BBr 1  8D rr rr           STA   TURTLE_COLOR
0002BEr 1  9C rr rr           STZ   TURTLE_SPRITE
0002C1r 1  A9 01              LDA   #$01
0002C3r 1  8D rr rr           STA   TURTLE_INITED
0002C6r 1               
0002C6r 1  A2 00              LDX   #0
0002C8r 1               @copy_shape:
0002C8r 1  BD rr rr           LDA   turtle_shape_data,X
0002CBr 1  9D rr rr           STA   turtle_source_shape,X
0002CEr 1  E8                 INX
0002CFr 1  D0 F7              BNE   @copy_shape
0002D1r 1               
0002D1r 1  9C rr rr           STZ   turtle_bg_saved
0002D4r 1  60                 RTS
0002D5r 1               
0002D5r 1               ; =====================================================================
0002D5r 1               ; heading_mod360 — reduce TURTLE_HEADING to 0-359
0002D5r 1               ; =====================================================================
0002D5r 1               heading_mod360:
0002D5r 1               @loop:
0002D5r 1                     ; If heading >= 360, subtract 360
0002D5r 1  AD rr rr           LDA   TURTLE_HEADING_HI
0002D8r 1  D0 02              BNE   @check_hi
0002DAr 1  80 1E              BRA   @done               ; hi = 0 is always < 360
0002DCr 1               @check_hi:
0002DCr 1                     ; hi > 1 → definitely >= 360 (since 360 = $0168)
0002DCr 1  C9 01              CMP   #>360               ; >360 hi = $01
0002DEr 1  D0 07              BNE   @subtract           ; hi > 1
0002E0r 1                     ; hi = 1, compare lo
0002E0r 1  AD rr rr           LDA   TURTLE_HEADING_LO
0002E3r 1  C9 68              CMP   #<360
0002E5r 1  90 13              BCC   @done
0002E7r 1               @subtract:
0002E7r 1  38                 SEC
0002E8r 1  AD rr rr           LDA   TURTLE_HEADING_LO
0002EBr 1  E9 68              SBC   #<360
0002EDr 1  8D rr rr           STA   TURTLE_HEADING_LO
0002F0r 1  AD rr rr           LDA   TURTLE_HEADING_HI
0002F3r 1  E9 01              SBC   #>360
0002F5r 1  8D rr rr           STA   TURTLE_HEADING_HI
0002F8r 1  80 DB              BRA   @loop
0002FAr 1               @done:
0002FAr 1  60                 RTS
0002FBr 1               
0002FBr 1               ; =====================================================================
0002FBr 1               ; draw_line — VGC LINE from old position to current position
0002FBr 1               ; =====================================================================
0002FBr 1               draw_line:
0002FBr 1                     ; Set color
0002FBr 1  20 rr rr           JSR   vgc_wait_cmd
0002FEr 1  AD rr rr           LDA   TURTLE_COLOR
000301r 1  8D 11 A0           STA   VGC_P0
000304r 1  20 rr rr           JSR   vgc_gcolor
000307r 1               
000307r 1                     ; Draw line
000307r 1  20 rr rr           JSR   vgc_wait_cmd
00030Ar 1  A5 24              LDA   old_x_lo
00030Cr 1  8D 11 A0           STA   VGC_P0
00030Fr 1  A5 25              LDA   old_x_hi
000311r 1  8D 12 A0           STA   VGC_P1
000314r 1  A5 26              LDA   old_y_lo
000316r 1  8D 13 A0           STA   VGC_P2
000319r 1  A5 27              LDA   old_y_hi
00031Br 1  8D 14 A0           STA   VGC_P3
00031Er 1  AD rr rr           LDA   TURTLE_X_LO
000321r 1  8D 15 A0           STA   VGC_P4
000324r 1  AD rr rr           LDA   TURTLE_X_HI
000327r 1  8D 16 A0           STA   VGC_P5
00032Ar 1  AD rr rr           LDA   TURTLE_Y_LO
00032Dr 1  8D 17 A0           STA   VGC_P6
000330r 1  AD rr rr           LDA   TURTLE_Y_HI
000333r 1  8D 18 A0           STA   VGC_P7
000336r 1  20 rr rr           JSR   vgc_line
000339r 1  60                 RTS
00033Ar 1               
00033Ar 1               ; =====================================================================
00033Ar 1               ; clear_gfx_plane — clear full graphics plane through the NDK VGC helper
00033Ar 1               ; =====================================================================
00033Ar 1               clear_gfx_plane:
00033Ar 1  20 rr rr           JSR   vgc_wait_cmd
00033Dr 1  20 rr rr           JSR   vgc_gcls
000340r 1  4C rr rr           JMP   vgc_wait_cmd
000343r 1               
000343r 1               ; =====================================================================
000343r 1               ; configure_turtle_vsprite — configure NDK virtual-sprite state
000343r 1               ; =====================================================================
000343r 1               configure_turtle_vsprite:
000343r 1  A9 10              LDA   #TURTLE_SPR_SIZE
000345r 1  8D rr rr           STA   VSPRITE_WIDTHL
000348r 1  9C rr rr           STZ   VSPRITE_WIDTHH
00034Br 1  8D rr rr           STA   VSPRITE_HEIGHTL
00034Er 1  9C rr rr           STZ   VSPRITE_HEIGHTH
000351r 1  8D rr rr           STA   VSPRITE_ORIGSTRL
000354r 1  9C rr rr           STZ   VSPRITE_ORIGSTRH
000357r 1  8D rr rr           STA   VSPRITE_ROTSTRL
00035Ar 1  9C rr rr           STZ   VSPRITE_ROTSTRH
00035Dr 1  8D rr rr           STA   VSPRITE_BGSTRL
000360r 1  9C rr rr           STZ   VSPRITE_BGSTRH
000363r 1               
000363r 1  A9 00              LDA   #BLT_SPACE_CPU
000365r 1  8D rr rr           STA   VSPRITE_ORIGSPACE
000368r 1  8D rr rr           STA   VSPRITE_ROTSPACE
00036Br 1  8D rr rr           STA   VSPRITE_BGSPACE
00036Er 1               
00036Er 1  A9 rr              LDA   #<turtle_source_shape
000370r 1  8D rr rr           STA   VSPRITE_ORIGADDRL
000373r 1  A9 rr              LDA   #>turtle_source_shape
000375r 1  8D rr rr           STA   VSPRITE_ORIGADDRM
000378r 1  9C rr rr           STZ   VSPRITE_ORIGADDRH
00037Br 1               
00037Br 1  A9 rr              LDA   #<turtle_rotated_shape
00037Dr 1  8D rr rr           STA   VSPRITE_ROTADDRL
000380r 1  A9 rr              LDA   #>turtle_rotated_shape
000382r 1  8D rr rr           STA   VSPRITE_ROTADDRM
000385r 1  9C rr rr           STZ   VSPRITE_ROTADDRH
000388r 1               
000388r 1  A9 rr              LDA   #<turtle_saved_bg
00038Ar 1  8D rr rr           STA   VSPRITE_BGADDRL
00038Dr 1  A9 rr              LDA   #>turtle_saved_bg
00038Fr 1  8D rr rr           STA   VSPRITE_BGADDRM
000392r 1  9C rr rr           STZ   VSPRITE_BGADDRH
000395r 1               
000395r 1  9C rr rr           STZ   VSPRITE_COLORKEY
000398r 1  A9 01              LDA   #VSPRITE_FLAG_COLORKEY
00039Ar 1  8D rr rr           STA   VSPRITE_FLAGS
00039Dr 1  60                 RTS
00039Er 1               
00039Er 1               ; =====================================================================
00039Er 1               ; set_turtle_vsprite_pos — center the 16x16 sprite on the turtle position
00039Er 1               ; =====================================================================
00039Er 1               set_turtle_vsprite_pos:
00039Er 1  38                 SEC
00039Fr 1  AD rr rr           LDA   TURTLE_X_LO
0003A2r 1  E9 08              SBC   #TURTLE_SPR_HALF
0003A4r 1  85 20              STA   tmp0
0003A6r 1  AD rr rr           LDA   TURTLE_X_HI
0003A9r 1  E9 00              SBC   #0
0003ABr 1  85 21              STA   tmp1
0003ADr 1  30 1A              BMI   @x_zero
0003AFr 1  C9 01              CMP   #>TURTLE_MAX_X
0003B1r 1  90 1E              BCC   @x_ok
0003B3r 1  D0 08              BNE   @x_max
0003B5r 1  A5 20              LDA   tmp0
0003B7r 1  C9 30              CMP   #<TURTLE_MAX_X
0003B9r 1  90 16              BCC   @x_ok
0003BBr 1  F0 14              BEQ   @x_ok
0003BDr 1               @x_max:
0003BDr 1  A9 30              LDA   #<TURTLE_MAX_X
0003BFr 1  8D rr rr           STA   VSPRITE_XL
0003C2r 1  A9 01              LDA   #>TURTLE_MAX_X
0003C4r 1  8D rr rr           STA   VSPRITE_XH
0003C7r 1  80 12              BRA   @y
0003C9r 1               @x_zero:
0003C9r 1  9C rr rr           STZ   VSPRITE_XL
0003CCr 1  9C rr rr           STZ   VSPRITE_XH
0003CFr 1  80 0A              BRA   @y
0003D1r 1               @x_ok:
0003D1r 1  A5 20              LDA   tmp0
0003D3r 1  8D rr rr           STA   VSPRITE_XL
0003D6r 1  A5 21              LDA   tmp1
0003D8r 1  8D rr rr           STA   VSPRITE_XH
0003DBr 1               
0003DBr 1               @y:
0003DBr 1  38                 SEC
0003DCr 1  AD rr rr           LDA   TURTLE_Y_LO
0003DFr 1  E9 08              SBC   #TURTLE_SPR_HALF
0003E1r 1  85 20              STA   tmp0
0003E3r 1  AD rr rr           LDA   TURTLE_Y_HI
0003E6r 1  E9 00              SBC   #0
0003E8r 1  30 0E              BMI   @y_zero
0003EAr 1  D0 06              BNE   @y_max
0003ECr 1  A5 20              LDA   tmp0
0003EEr 1  C9 B9              CMP   #(TURTLE_MAX_Y + 1)
0003F0r 1  90 0A              BCC   @y_ok
0003F2r 1               @y_max:
0003F2r 1  A9 B8              LDA   #TURTLE_MAX_Y
0003F4r 1  8D rr rr           STA   VSPRITE_Y
0003F7r 1  60                 RTS
0003F8r 1               @y_zero:
0003F8r 1  9C rr rr           STZ   VSPRITE_Y
0003FBr 1  60                 RTS
0003FCr 1               @y_ok:
0003FCr 1  A5 20              LDA   tmp0
0003FEr 1  8D rr rr           STA   VSPRITE_Y
000401r 1  60                 RTS
000402r 1               
000402r 1               ; =====================================================================
000402r 1               ; turtle_heading_u8 — convert Logo degrees to the NDK/blitter angle byte.
000402r 1               ;   A = floor((heading * 256) / 360). Cardinal headings must land exactly:
000402r 1               ;   90 -> 64, 180 -> 128, 270 -> 192.
000402r 1               ; =====================================================================
000402r 1               turtle_heading_u8:
000402r 1  9C 28 BB           STZ   MATH_DIV_N_LO
000405r 1  AD rr rr           LDA   TURTLE_HEADING_LO
000408r 1  8D 29 BB           STA   MATH_DIV_N_1
00040Br 1  AD rr rr           LDA   TURTLE_HEADING_HI
00040Er 1  8D 2A BB           STA   MATH_DIV_N_2
000411r 1  9C 2B BB           STZ   MATH_DIV_N_HI
000414r 1  A9 68              LDA   #<360
000416r 1  8D 2C BB           STA   MATH_DIV_D_LO
000419r 1  A9 01              LDA   #>360
00041Br 1  8D 2D BB           STA   MATH_DIV_D_HI
00041Er 1  AD 38 BB           LDA   MATH_RES0
000421r 1  60                 RTS
000422r 1               
000422r 1               ; =====================================================================
000422r 1               ; erase_turtle_sprite — restore the background saved by the NDK vsprite path
000422r 1               ; =====================================================================
000422r 1               erase_turtle_sprite:
000422r 1  AD rr rr           LDA   turtle_bg_saved
000425r 1  F0 1B              BEQ   @done
000427r 1  20 rr rr           JSR   configure_turtle_vsprite
00042Ar 1  AD rr rr           LDA   turtle_bg_x_lo
00042Dr 1  8D rr rr           STA   VSPRITE_XL
000430r 1  AD rr rr           LDA   turtle_bg_x_hi
000433r 1  8D rr rr           STA   VSPRITE_XH
000436r 1  AD rr rr           LDA   turtle_bg_y
000439r 1  8D rr rr           STA   VSPRITE_Y
00043Cr 1  20 rr rr           JSR   vsprite_gfx_restore_bg
00043Fr 1  9C rr rr           STZ   turtle_bg_saved
000442r 1               @done:
000442r 1  60                 RTS
000443r 1               
000443r 1               ; =====================================================================
000443r 1               ; draw_turtle_sprite — draw rotated NDK virtual sprite
000443r 1               ; =====================================================================
000443r 1               draw_turtle_sprite:
000443r 1  AD rr rr           LDA   TURTLE_SHOWN
000446r 1  F0 30              BEQ   @done
000448r 1  20 rr rr           JSR   erase_turtle_sprite
00044Br 1  20 rr rr           JSR   configure_turtle_vsprite
00044Er 1  20 rr rr           JSR   set_turtle_vsprite_pos
000451r 1  AD rr rr           LDA   VSPRITE_XL
000454r 1  8D rr rr           STA   turtle_bg_x_lo
000457r 1  AD rr rr           LDA   VSPRITE_XH
00045Ar 1  8D rr rr           STA   turtle_bg_x_hi
00045Dr 1  AD rr rr           LDA   VSPRITE_Y
000460r 1  8D rr rr           STA   turtle_bg_y
000463r 1  20 rr rr           JSR   vsprite_gfx_save_bg
000466r 1  C9 00              CMP   #VSPRITE_RESULT_OK
000468r 1  D0 0E              BNE   @done
00046Ar 1  A9 01              LDA   #$01
00046Cr 1  8D rr rr           STA   turtle_bg_saved
00046Fr 1  20 rr rr           JSR   turtle_heading_u8
000472r 1  8D rr rr           STA   VSPRITE_ROTANGLE
000475r 1  20 rr rr           JSR   vsprite_gfx_rotate_blit_keyed
000478r 1               @done:
000478r 1  60                 RTS
000479r 1               
000479r 1               ; =====================================================================
000479r 1               ; setup_copper — copper split for gfx+sprites top, text bottom
000479r 1               ; =====================================================================
000479r 1               setup_copper:
000479r 1  9C 11 A0           STZ   VGC_P0
00047Cr 1  A9 A0              LDA   #SPLIT_Y
00047Er 1  8D 12 A0           STA   VGC_P1
000481r 1  A9 03              LDA   #MODE_GFX_SPRITES
000483r 1  8D 13 A0           STA   VGC_P2
000486r 1  A9 00              LDA   #MODE_TEXT_ONLY
000488r 1  8D 14 A0           STA   VGC_P3
00048Br 1  4C rr rr           JMP   copper_split_mode
00048Er 1               
00048Er 1               ; =====================================================================
00048Er 1               ; wait_vgc — wait until VGC is not busy
00048Er 1               ; =====================================================================
00048Er 1               wait_vgc:
00048Er 1  4C rr rr           JMP   vgc_wait_cmd
000491r 1               
000491r 1               ; =====================================================================
000491r 1               ; ext_ts — TEXTSCREEN: full text mode, disable copper, mode=0
000491r 1               ; =====================================================================
000491r 1               ext_ts:
000491r 1  20 rr rr           JSR   vgc_wait_cmd
000494r 1  20 rr rr           JSR   copper_off
000497r 1  9C 00 A0           STZ   VGC_MODE
00049Ar 1  60                 RTS
00049Br 1               
00049Br 1               ; =====================================================================
00049Br 1               ; ext_ss — SPLITSCREEN: copper split (gfx+sprites top, text bottom)
00049Br 1               ; =====================================================================
00049Br 1               ext_ss:
00049Br 1  20 rr rr           JSR   setup_copper
00049Er 1  20 rr rr           JSR   prepare_split_text
0004A1r 1  60                 RTS
0004A2r 1               
0004A2r 1               ; =====================================================================
0004A2r 1               ; ext_fs — FULLSCREEN: full graphics mode, no text area
0004A2r 1               ; =====================================================================
0004A2r 1               ext_fs:
0004A2r 1                     ; Disable copper first
0004A2r 1  20 rr rr           JSR   wait_vgc
0004A5r 1  A9 1E              LDA   #VCMD_COPPERDIS
0004A7r 1  8D 10 A0           STA   VGC_CMD
0004AAr 1                     ; Set mode to graphics + sprites
0004AAr 1  A9 03              LDA   #MODE_GFX_SPRITES
0004ACr 1  8D 00 A0           STA   VGC_MODE
0004AFr 1  60                 RTS
0004B0r 1               
0004B0r 1               ; =====================================================================
0004B0r 1               ; prepare_split_text — keep Logo's prompt in the visible split text area
0004B0r 1               ; =====================================================================
0004B0r 1               prepare_split_text:
0004B0r 1  A9 0C              LDA   #$0C
0004B2r 1  8D 0E A0           STA   VGC_CHAROUT
0004B5r 1  20 rr rr           JSR   wait_vgc
0004B8r 1  9C F2 B9           STZ   TEXTWIN_LEFT
0004BBr 1  A9 28              LDA   #SPLIT_TEXT_ROW
0004BDr 1  8D F3 B9           STA   TEXTWIN_TOP
0004C0r 1  A9 50              LDA   #80
0004C2r 1  8D F4 B9           STA   TEXTWIN_WIDTH
0004C5r 1  A9 0A              LDA   #SPLIT_TEXT_HEIGHT
0004C7r 1  8D F5 B9           STA   TEXTWIN_HEIGHT
0004CAr 1  9C 03 A0           STZ   VGC_CURSX
0004CDr 1  A9 28              LDA   #SPLIT_TEXT_ROW
0004CFr 1  8D 04 A0           STA   VGC_CURSY
0004D2r 1  9C 0A A0           STZ   VGC_CURSEN
0004D5r 1  60                 RTS
0004D6r 1               
0004D6r 1               ; =====================================================================
0004D6r 1               ; ext_setxy — move to (x, y). Draw line if pen down.
0004D6r 1               ;   ARG0 = x, ARG1 = y
0004D6r 1               ; =====================================================================
0004D6r 1               ext_setxy:
0004D6r 1                     ; Ensure turtle is initialized
0004D6r 1  AD rr rr           LDA   TURTLE_INITED
0004D9r 1  D0 03              BNE   @go
0004DBr 1  20 rr rr           JSR   turtle_init
0004DEr 1               @go:
0004DEr 1                     ; Save old position for line drawing
0004DEr 1  AD rr rr           LDA   TURTLE_X_LO
0004E1r 1  85 24              STA   old_x_lo
0004E3r 1  AD rr rr           LDA   TURTLE_X_HI
0004E6r 1  85 25              STA   old_x_hi
0004E8r 1  AD rr rr           LDA   TURTLE_Y_LO
0004EBr 1  85 26              STA   old_y_lo
0004EDr 1  AD rr rr           LDA   TURTLE_Y_HI
0004F0r 1  85 27              STA   old_y_hi
0004F2r 1  20 rr rr           JSR   erase_turtle_sprite
0004F5r 1               
0004F5r 1                     ; Set new position
0004F5r 1  A5 84              LDA   EXT_ARG0_LO
0004F7r 1  8D rr rr           STA   TURTLE_X_LO
0004FAr 1  A5 83              LDA   EXT_ARG0_HI
0004FCr 1  8D rr rr           STA   TURTLE_X_HI
0004FFr 1  9C rr rr           STZ   TURTLE_X_FRAC
000502r 1  A5 88              LDA   EXT_ARG1_LO
000504r 1  8D rr rr           STA   TURTLE_Y_LO
000507r 1  A5 87              LDA   EXT_ARG1_HI
000509r 1  8D rr rr           STA   TURTLE_Y_HI
00050Cr 1  9C rr rr           STZ   TURTLE_Y_FRAC
00050Fr 1               
00050Fr 1                     ; Draw line if pen down
00050Fr 1  AD rr rr           LDA   TURTLE_PEN
000512r 1  D0 03              BNE   @skip_draw
000514r 1  20 rr rr           JSR   draw_line
000517r 1               @skip_draw:
000517r 1  20 rr rr           JSR   draw_turtle_sprite
00051Ar 1  60                 RTS
00051Br 1               
00051Br 1               ; =====================================================================
00051Br 1               ; ext_setpos — move to position from a Logo list. Draw line if pen down.
00051Br 1               ;   ARG0 = [x y]
00051Br 1               ; =====================================================================
00051Br 1               ext_setpos:
00051Br 1  A5 82              LDA   EXT_ARG0_TYPE
00051Dr 1  C9 02              CMP   #VAL_LIST
00051Fr 1  D0 53              BNE   @done
000521r 1               
000521r 1  A5 84              LDA   EXT_ARG0_LO
000523r 1  85 20              STA   tmp0
000525r 1  A5 83              LDA   EXT_ARG0_HI
000527r 1  85 21              STA   tmp1
000529r 1  05 20              ORA   tmp0
00052Br 1  F0 47              BEQ   @done
00052Dr 1               
00052Dr 1                     ; First list element is X.
00052Dr 1  A0 01              LDY   #CONS_CAR_TYPE
00052Fr 1  B1 20              LDA   (tmp0),Y
000531r 1  C9 00              CMP   #VAL_NUMBER
000533r 1  D0 3F              BNE   @done
000535r 1  A0 03              LDY   #CONS_CAR_LO
000537r 1  B1 20              LDA   (tmp0),Y
000539r 1  85 84              STA   EXT_ARG0_LO
00053Br 1  A0 02              LDY   #CONS_CAR_HI
00053Dr 1  B1 20              LDA   (tmp0),Y
00053Fr 1  85 83              STA   EXT_ARG0_HI
000541r 1  64 85              STZ   EXT_ARG0_FRAC
000543r 1               
000543r 1                     ; Second list element is Y.
000543r 1  A0 05              LDY   #CONS_CDR_LO
000545r 1  B1 20              LDA   (tmp0),Y
000547r 1  85 22              STA   tmp2
000549r 1  A0 06              LDY   #CONS_CDR_HI
00054Br 1  B1 20              LDA   (tmp0),Y
00054Dr 1  85 23              STA   tmp3
00054Fr 1  05 22              ORA   tmp2
000551r 1  F0 21              BEQ   @done
000553r 1               
000553r 1  A5 22              LDA   tmp2
000555r 1  85 20              STA   tmp0
000557r 1  A5 23              LDA   tmp3
000559r 1  85 21              STA   tmp1
00055Br 1  A0 01              LDY   #CONS_CAR_TYPE
00055Dr 1  B1 20              LDA   (tmp0),Y
00055Fr 1  C9 00              CMP   #VAL_NUMBER
000561r 1  D0 11              BNE   @done
000563r 1  A0 03              LDY   #CONS_CAR_LO
000565r 1  B1 20              LDA   (tmp0),Y
000567r 1  85 88              STA   EXT_ARG1_LO
000569r 1  A0 02              LDY   #CONS_CAR_HI
00056Br 1  B1 20              LDA   (tmp0),Y
00056Dr 1  85 87              STA   EXT_ARG1_HI
00056Fr 1  64 89              STZ   EXT_ARG1_FRAC
000571r 1               
000571r 1  4C rr rr           JMP   ext_setxy
000574r 1               
000574r 1               @done:
000574r 1  60                 RTS
000575r 1               
000575r 1               ; =====================================================================
000575r 1               ; ext_setx — set X only. Draw line if pen down.
000575r 1               ;   ARG0 = x
000575r 1               ; =====================================================================
000575r 1               ext_setx:
000575r 1  AD rr rr           LDA   TURTLE_INITED
000578r 1  D0 03              BNE   @go
00057Ar 1  20 rr rr           JSR   turtle_init
00057Dr 1               @go:
00057Dr 1                     ; Save old position
00057Dr 1  AD rr rr           LDA   TURTLE_X_LO
000580r 1  85 24              STA   old_x_lo
000582r 1  AD rr rr           LDA   TURTLE_X_HI
000585r 1  85 25              STA   old_x_hi
000587r 1  AD rr rr           LDA   TURTLE_Y_LO
00058Ar 1  85 26              STA   old_y_lo
00058Cr 1  AD rr rr           LDA   TURTLE_Y_HI
00058Fr 1  85 27              STA   old_y_hi
000591r 1  20 rr rr           JSR   erase_turtle_sprite
000594r 1               
000594r 1                     ; Update X only
000594r 1  A5 84              LDA   EXT_ARG0_LO
000596r 1  8D rr rr           STA   TURTLE_X_LO
000599r 1  A5 83              LDA   EXT_ARG0_HI
00059Br 1  8D rr rr           STA   TURTLE_X_HI
00059Er 1  9C rr rr           STZ   TURTLE_X_FRAC
0005A1r 1               
0005A1r 1                     ; Draw line if pen down
0005A1r 1  AD rr rr           LDA   TURTLE_PEN
0005A4r 1  D0 03              BNE   @skip_draw
0005A6r 1  20 rr rr           JSR   draw_line
0005A9r 1               @skip_draw:
0005A9r 1  20 rr rr           JSR   draw_turtle_sprite
0005ACr 1  60                 RTS
0005ADr 1               
0005ADr 1               ; =====================================================================
0005ADr 1               ; ext_sety — set Y only. Draw line if pen down.
0005ADr 1               ;   ARG0 = y
0005ADr 1               ; =====================================================================
0005ADr 1               ext_sety:
0005ADr 1  AD rr rr           LDA   TURTLE_INITED
0005B0r 1  D0 03              BNE   @go
0005B2r 1  20 rr rr           JSR   turtle_init
0005B5r 1               @go:
0005B5r 1                     ; Save old position
0005B5r 1  AD rr rr           LDA   TURTLE_X_LO
0005B8r 1  85 24              STA   old_x_lo
0005BAr 1  AD rr rr           LDA   TURTLE_X_HI
0005BDr 1  85 25              STA   old_x_hi
0005BFr 1  AD rr rr           LDA   TURTLE_Y_LO
0005C2r 1  85 26              STA   old_y_lo
0005C4r 1  AD rr rr           LDA   TURTLE_Y_HI
0005C7r 1  85 27              STA   old_y_hi
0005C9r 1  20 rr rr           JSR   erase_turtle_sprite
0005CCr 1               
0005CCr 1                     ; Update Y only
0005CCr 1  A5 84              LDA   EXT_ARG0_LO
0005CEr 1  8D rr rr           STA   TURTLE_Y_LO
0005D1r 1  A5 83              LDA   EXT_ARG0_HI
0005D3r 1  8D rr rr           STA   TURTLE_Y_HI
0005D6r 1  9C rr rr           STZ   TURTLE_Y_FRAC
0005D9r 1               
0005D9r 1                     ; Draw line if pen down
0005D9r 1  AD rr rr           LDA   TURTLE_PEN
0005DCr 1  D0 03              BNE   @skip_draw
0005DEr 1  20 rr rr           JSR   draw_line
0005E1r 1               @skip_draw:
0005E1r 1  20 rr rr           JSR   draw_turtle_sprite
0005E4r 1  60                 RTS
0005E5r 1               
0005E5r 1               ; =====================================================================
0005E5r 1               ; ext_seth — set heading to degrees. Normalize mod 360.
0005E5r 1               ;   ARG0 = degrees
0005E5r 1               ; =====================================================================
0005E5r 1               ext_seth:
0005E5r 1  A5 84              LDA   EXT_ARG0_LO
0005E7r 1  8D rr rr           STA   TURTLE_HEADING_LO
0005EAr 1  A5 83              LDA   EXT_ARG0_HI
0005ECr 1  8D rr rr           STA   TURTLE_HEADING_HI
0005EFr 1               
0005EFr 1                     ; Handle negative heading by adding 360 until positive
0005EFr 1  AD rr rr           LDA   TURTLE_HEADING_HI
0005F2r 1  30 06              BMI   @add360
0005F4r 1  20 rr rr           JSR   heading_mod360
0005F7r 1  4C rr rr           JMP   @update
0005FAr 1               @add360:
0005FAr 1  18                 CLC
0005FBr 1  AD rr rr           LDA   TURTLE_HEADING_LO
0005FEr 1  69 68              ADC   #<360
000600r 1  8D rr rr           STA   TURTLE_HEADING_LO
000603r 1  AD rr rr           LDA   TURTLE_HEADING_HI
000606r 1  69 01              ADC   #>360
000608r 1  8D rr rr           STA   TURTLE_HEADING_HI
00060Br 1  30 ED              BMI   @add360
00060Dr 1  20 rr rr           JSR   heading_mod360
000610r 1               @update:
000610r 1  20 rr rr           JSR   draw_turtle_sprite
000613r 1  60                 RTS
000614r 1               
000614r 1               ; =====================================================================
000614r 1               ; ext_xcor — return turtle X position (integer part)
000614r 1               ; =====================================================================
000614r 1               ext_xcor:
000614r 1  AD rr rr           LDA   TURTLE_X_LO
000617r 1  85 90              STA   EXT_RESULT_LO
000619r 1  AD rr rr           LDA   TURTLE_X_HI
00061Cr 1  85 8F              STA   EXT_RESULT_HI
00061Er 1  64 91              STZ   EXT_RESULT_FRAC
000620r 1  64 8E              STZ   EXT_RESULT_TYPE      ; VAL_NUMBER
000622r 1  60                 RTS
000623r 1               
000623r 1               ; =====================================================================
000623r 1               ; ext_ycor — return turtle Y position (integer part)
000623r 1               ; =====================================================================
000623r 1               ext_ycor:
000623r 1  AD rr rr           LDA   TURTLE_Y_LO
000626r 1  85 90              STA   EXT_RESULT_LO
000628r 1  AD rr rr           LDA   TURTLE_Y_HI
00062Br 1  85 8F              STA   EXT_RESULT_HI
00062Dr 1  64 91              STZ   EXT_RESULT_FRAC
00062Fr 1  64 8E              STZ   EXT_RESULT_TYPE      ; VAL_NUMBER
000631r 1  60                 RTS
000632r 1               
000632r 1               ; =====================================================================
000632r 1               ; ext_heading — return current heading in degrees
000632r 1               ; =====================================================================
000632r 1               ext_heading:
000632r 1  AD rr rr           LDA   TURTLE_HEADING_LO
000635r 1  85 90              STA   EXT_RESULT_LO
000637r 1  AD rr rr           LDA   TURTLE_HEADING_HI
00063Ar 1  85 8F              STA   EXT_RESULT_HI
00063Cr 1  64 91              STZ   EXT_RESULT_FRAC
00063Er 1  64 8E              STZ   EXT_RESULT_TYPE      ; VAL_NUMBER
000640r 1  60                 RTS
000641r 1               
000641r 1               ; =====================================================================
000641r 1               ; ext_pendownp — return 1 if pen is down, 0 if up
000641r 1               ; =====================================================================
000641r 1               ext_pendownp:
000641r 1  AD rr rr           LDA   TURTLE_PEN
000644r 1  D0 06              BNE   @up
000646r 1                     ; Pen down ($00) → return 1
000646r 1  A9 01              LDA   #1
000648r 1  85 90              STA   EXT_RESULT_LO
00064Ar 1  80 02              BRA   @done
00064Cr 1               @up:
00064Cr 1                     ; Pen up ($01) → return 0
00064Cr 1  64 90              STZ   EXT_RESULT_LO
00064Er 1               @done:
00064Er 1  64 8F              STZ   EXT_RESULT_HI
000650r 1  64 91              STZ   EXT_RESULT_FRAC
000652r 1  64 8E              STZ   EXT_RESULT_TYPE
000654r 1  60                 RTS
000655r 1               
000655r 1               ; =====================================================================
000655r 1               ; ext_shownp — return 1 if turtle shown, 0 if hidden
000655r 1               ; =====================================================================
000655r 1               ext_shownp:
000655r 1  AD rr rr           LDA   TURTLE_SHOWN
000658r 1  85 90              STA   EXT_RESULT_LO
00065Ar 1  64 8F              STZ   EXT_RESULT_HI
00065Cr 1  64 91              STZ   EXT_RESULT_FRAC
00065Er 1  64 8E              STZ   EXT_RESULT_TYPE
000660r 1  60                 RTS
000661r 1               
000661r 1               ; =====================================================================
000661r 1               ; ext_setpc — set pen color (palette index)
000661r 1               ;   ARG0 = color
000661r 1               ; =====================================================================
000661r 1               ext_setpc:
000661r 1  A5 84              LDA   EXT_ARG0_LO
000663r 1  8D rr rr           STA   TURTLE_COLOR
000666r 1  60                 RTS
000667r 1               
000667r 1               ; =====================================================================
000667r 1               ; ext_setbg — set background color (VGC background)
000667r 1               ;   ARG0 = color
000667r 1               ; =====================================================================
000667r 1               ext_setbg:
000667r 1  20 rr rr           JSR   erase_turtle_sprite
00066Ar 1  A5 84              LDA   EXT_ARG0_LO
00066Cr 1  8D 01 A0           STA   VGC_BGCOL
00066Fr 1                     ; Also clear graphics plane to this color
00066Fr 1  20 rr rr           JSR   wait_vgc
000672r 1  A5 84              LDA   EXT_ARG0_LO
000674r 1  8D 11 A0           STA   VGC_P0
000677r 1  A9 07              LDA   #VCMD_GCLS
000679r 1  8D 10 A0           STA   VGC_CMD
00067Cr 1  20 rr rr           JSR   wait_vgc
00067Fr 1  9C rr rr           STZ   turtle_bg_saved
000682r 1  4C rr rr           JMP   draw_turtle_sprite
000685r 1               
000685r 1               ; =====================================================================
000685r 1               ; ext_towards — return heading angle towards point (x, y)
000685r 1               ;   ARG0 = target_x, ARG1 = target_y
000685r 1               ;   Uses ATAN2 coprocessor
000685r 1               ; =====================================================================
000685r 1               ext_towards:
000685r 1                     ; dx = target_x - turtle_x (signed 16-bit)
000685r 1  38                 SEC
000686r 1  A5 84              LDA   EXT_ARG0_LO
000688r 1  ED rr rr           SBC   TURTLE_X_LO
00068Br 1  8D 31 BB           STA   MATH_ATAN_DX_LO
00068Er 1  A5 83              LDA   EXT_ARG0_HI
000690r 1  ED rr rr           SBC   TURTLE_X_HI
000693r 1  8D 32 BB           STA   MATH_ATAN_DX_HI
000696r 1               
000696r 1                     ; dy = -(target_y - turtle_y) (negate because screen Y is inverted)
000696r 1  38                 SEC
000697r 1  AD rr rr           LDA   TURTLE_Y_LO
00069Ar 1  E5 88              SBC   EXT_ARG1_LO
00069Cr 1  8D 2F BB           STA   MATH_ATAN_DY_LO
00069Fr 1  AD rr rr           LDA   TURTLE_Y_HI
0006A2r 1  E5 87              SBC   EXT_ARG1_HI
0006A4r 1  8D 30 BB           STA   MATH_ATAN_DY_HI      ; writing DY_HI triggers ATAN2
0006A7r 1               
0006A7r 1                     ; Result in MATH_RES0 is a u8 angle (0-255)
0006A7r 1                     ; Convert to degrees: degrees = u8 * 360 / 256 ≈ u8 * 45 / 32
0006A7r 1                     ; Or more precisely: u8 * 360 / 256 = u8 * 1.40625
0006A7r 1                     ; Use MUL16: u8 * 360, then take hi byte of result (>>8)
0006A7r 1  AD 38 BB           LDA   MATH_RES0
0006AAr 1  8D 20 BB           STA   MATH_MUL16_A_LO
0006ADr 1  9C 21 BB           STZ   MATH_MUL16_A_HI
0006B0r 1  A9 68              LDA   #<360
0006B2r 1  8D 22 BB           STA   MATH_MUL16_B_LO
0006B5r 1  A9 01              LDA   #>360
0006B7r 1  8D 23 BB           STA   MATH_MUL16_B_HI      ; triggers multiply
0006BAr 1               
0006BAr 1                     ; Result is u8*360, which is 16-bit. >> 8 = MATH_RES1
0006BAr 1  AD 39 BB           LDA   MATH_RES1
0006BDr 1  85 90              STA   EXT_RESULT_LO
0006BFr 1  AD 3A BB           LDA   MATH_RES2
0006C2r 1  85 8F              STA   EXT_RESULT_HI
0006C4r 1  64 91              STZ   EXT_RESULT_FRAC
0006C6r 1  64 8E              STZ   EXT_RESULT_TYPE
0006C8r 1  60                 RTS
0006C9r 1               
0006C9r 1               ; =====================================================================
0006C9r 1               ; ext_setcolor — set VGC drawing color
0006C9r 1               ;   ARG0 = color (palette index 0-15)
0006C9r 1               ; =====================================================================
0006C9r 1               ext_setcolor:
0006C9r 1  20 rr rr           JSR   wait_vgc
0006CCr 1  A5 84              LDA   EXT_ARG0_LO
0006CEr 1  8D 11 A0           STA   VGC_P0
0006D1r 1  A9 08              LDA   #VCMD_GCOLOR
0006D3r 1  8D 10 A0           STA   VGC_CMD
0006D6r 1  60                 RTS
0006D7r 1               
0006D7r 1               ; =====================================================================
0006D7r 1               ; ext_plot — plot a pixel at (x, y) in current draw color
0006D7r 1               ;   ARG0 = x, ARG1 = y
0006D7r 1               ; =====================================================================
0006D7r 1               ext_plot:
0006D7r 1  20 rr rr           JSR   erase_turtle_sprite
0006DAr 1  20 rr rr           JSR   wait_vgc
0006DDr 1  A5 84              LDA   EXT_ARG0_LO
0006DFr 1  8D 11 A0           STA   VGC_P0
0006E2r 1  A5 83              LDA   EXT_ARG0_HI
0006E4r 1  8D 12 A0           STA   VGC_P1
0006E7r 1  A5 88              LDA   EXT_ARG1_LO
0006E9r 1  8D 13 A0           STA   VGC_P2
0006ECr 1  A5 87              LDA   EXT_ARG1_HI
0006EEr 1  8D 14 A0           STA   VGC_P3
0006F1r 1  A9 01              LDA   #VCMD_PLOT
0006F3r 1  8D 10 A0           STA   VGC_CMD
0006F6r 1  20 rr rr           JSR   wait_vgc
0006F9r 1  4C rr rr           JMP   draw_turtle_sprite
0006FCr 1               
0006FCr 1               ; =====================================================================
0006FCr 1               ; ext_unplot — clear a pixel at (x, y)
0006FCr 1               ;   ARG0 = x, ARG1 = y
0006FCr 1               ; =====================================================================
0006FCr 1               ext_unplot:
0006FCr 1  20 rr rr           JSR   erase_turtle_sprite
0006FFr 1  20 rr rr           JSR   wait_vgc
000702r 1  A5 84              LDA   EXT_ARG0_LO
000704r 1  8D 11 A0           STA   VGC_P0
000707r 1  A5 83              LDA   EXT_ARG0_HI
000709r 1  8D 12 A0           STA   VGC_P1
00070Cr 1  A5 88              LDA   EXT_ARG1_LO
00070Er 1  8D 13 A0           STA   VGC_P2
000711r 1  A5 87              LDA   EXT_ARG1_HI
000713r 1  8D 14 A0           STA   VGC_P3
000716r 1  A9 02              LDA   #VCMD_UNPLOT
000718r 1  8D 10 A0           STA   VGC_CMD
00071Br 1  20 rr rr           JSR   wait_vgc
00071Er 1  4C rr rr           JMP   draw_turtle_sprite
000721r 1               
000721r 1               ; =====================================================================
000721r 1               ; ext_line — draw line from (x1,y1) to (x2,y2)
000721r 1               ;   ARG0 = x1, ARG1 = y1, ARG2 = x2, ARG3 = y2
000721r 1               ; =====================================================================
000721r 1               ext_line:
000721r 1  20 rr rr           JSR   erase_turtle_sprite
000724r 1  20 rr rr           JSR   wait_vgc
000727r 1  A5 84              LDA   EXT_ARG0_LO
000729r 1  8D 11 A0           STA   VGC_P0
00072Cr 1  A5 83              LDA   EXT_ARG0_HI
00072Er 1  8D 12 A0           STA   VGC_P1
000731r 1  A5 88              LDA   EXT_ARG1_LO
000733r 1  8D 13 A0           STA   VGC_P2
000736r 1  A5 87              LDA   EXT_ARG1_HI
000738r 1  8D 14 A0           STA   VGC_P3
00073Br 1  A5 8C              LDA   EXT_ARG2_LO
00073Dr 1  8D 15 A0           STA   VGC_P4
000740r 1  A5 8B              LDA   EXT_ARG2_HI
000742r 1  8D 16 A0           STA   VGC_P5
000745r 1  A5 A1              LDA   EXT_ARG3_LO
000747r 1  8D 17 A0           STA   VGC_P6
00074Ar 1  A5 A0              LDA   EXT_ARG3_HI
00074Cr 1  8D 18 A0           STA   VGC_P7
00074Fr 1  A9 03              LDA   #VCMD_LINE
000751r 1  8D 10 A0           STA   VGC_CMD
000754r 1  20 rr rr           JSR   wait_vgc
000757r 1  4C rr rr           JMP   draw_turtle_sprite
00075Ar 1               
00075Ar 1               ; =====================================================================
00075Ar 1               ; ext_circle — draw circle at (x, y) with radius r
00075Ar 1               ;   ARG0 = x, ARG1 = y, ARG2 = r
00075Ar 1               ; =====================================================================
00075Ar 1               ext_circle:
00075Ar 1  20 rr rr           JSR   erase_turtle_sprite
00075Dr 1  20 rr rr           JSR   wait_vgc
000760r 1  A5 84              LDA   EXT_ARG0_LO
000762r 1  8D 11 A0           STA   VGC_P0
000765r 1  A5 83              LDA   EXT_ARG0_HI
000767r 1  8D 12 A0           STA   VGC_P1
00076Ar 1  A5 88              LDA   EXT_ARG1_LO
00076Cr 1  8D 13 A0           STA   VGC_P2
00076Fr 1  A5 87              LDA   EXT_ARG1_HI
000771r 1  8D 14 A0           STA   VGC_P3
000774r 1  A5 8C              LDA   EXT_ARG2_LO
000776r 1  8D 15 A0           STA   VGC_P4
000779r 1  A5 8B              LDA   EXT_ARG2_HI
00077Br 1  8D 16 A0           STA   VGC_P5
00077Er 1  9C 17 A0           STZ   VGC_P6              ; ry_lo = 0 → use rx as both radii
000781r 1  9C 18 A0           STZ   VGC_P7              ; ry_hi = 0
000784r 1  A9 04              LDA   #VCMD_CIRCLE
000786r 1  8D 10 A0           STA   VGC_CMD
000789r 1  20 rr rr           JSR   wait_vgc
00078Cr 1  4C rr rr           JMP   draw_turtle_sprite
00078Fr 1               
00078Fr 1               ; =====================================================================
00078Fr 1               ; ext_rect — draw rectangle outline from (x1,y1) to (x2,y2)
00078Fr 1               ;   ARG0 = x1, ARG1 = y1, ARG2 = x2, ARG3 = y2
00078Fr 1               ; =====================================================================
00078Fr 1               ext_rect:
00078Fr 1  20 rr rr           JSR   erase_turtle_sprite
000792r 1  20 rr rr           JSR   wait_vgc
000795r 1  A5 84              LDA   EXT_ARG0_LO
000797r 1  8D 11 A0           STA   VGC_P0
00079Ar 1  A5 83              LDA   EXT_ARG0_HI
00079Cr 1  8D 12 A0           STA   VGC_P1
00079Fr 1  A5 88              LDA   EXT_ARG1_LO
0007A1r 1  8D 13 A0           STA   VGC_P2
0007A4r 1  A5 87              LDA   EXT_ARG1_HI
0007A6r 1  8D 14 A0           STA   VGC_P3
0007A9r 1  A5 8C              LDA   EXT_ARG2_LO
0007ABr 1  8D 15 A0           STA   VGC_P4
0007AEr 1  A5 8B              LDA   EXT_ARG2_HI
0007B0r 1  8D 16 A0           STA   VGC_P5
0007B3r 1  A5 A1              LDA   EXT_ARG3_LO
0007B5r 1  8D 17 A0           STA   VGC_P6
0007B8r 1  A5 A0              LDA   EXT_ARG3_HI
0007BAr 1  8D 18 A0           STA   VGC_P7
0007BDr 1  A9 05              LDA   #VCMD_RECT
0007BFr 1  8D 10 A0           STA   VGC_CMD
0007C2r 1  20 rr rr           JSR   wait_vgc
0007C5r 1  4C rr rr           JMP   draw_turtle_sprite
0007C8r 1               
0007C8r 1               ; =====================================================================
0007C8r 1               ; ext_fillrect — draw filled rectangle from (x1,y1) to (x2,y2)
0007C8r 1               ;   ARG0 = x1, ARG1 = y1, ARG2 = x2, ARG3 = y2
0007C8r 1               ; =====================================================================
0007C8r 1               ext_fillrect:
0007C8r 1  20 rr rr           JSR   erase_turtle_sprite
0007CBr 1  20 rr rr           JSR   wait_vgc
0007CEr 1  A5 84              LDA   EXT_ARG0_LO
0007D0r 1  8D 11 A0           STA   VGC_P0
0007D3r 1  A5 83              LDA   EXT_ARG0_HI
0007D5r 1  8D 12 A0           STA   VGC_P1
0007D8r 1  A5 88              LDA   EXT_ARG1_LO
0007DAr 1  8D 13 A0           STA   VGC_P2
0007DDr 1  A5 87              LDA   EXT_ARG1_HI
0007DFr 1  8D 14 A0           STA   VGC_P3
0007E2r 1  A5 8C              LDA   EXT_ARG2_LO
0007E4r 1  8D 15 A0           STA   VGC_P4
0007E7r 1  A5 8B              LDA   EXT_ARG2_HI
0007E9r 1  8D 16 A0           STA   VGC_P5
0007ECr 1  A5 A1              LDA   EXT_ARG3_LO
0007EEr 1  8D 17 A0           STA   VGC_P6
0007F1r 1  A5 A0              LDA   EXT_ARG3_HI
0007F3r 1  8D 18 A0           STA   VGC_P7
0007F6r 1  A9 06              LDA   #VCMD_FILL
0007F8r 1  8D 10 A0           STA   VGC_CMD
0007FBr 1  20 rr rr           JSR   wait_vgc
0007FEr 1  4C rr rr           JMP   draw_turtle_sprite
000801r 1               
000801r 1               ; =====================================================================
000801r 1               ; ext_paint — flood fill at (x, y) with current draw color
000801r 1               ;   ARG0 = x, ARG1 = y
000801r 1               ; =====================================================================
000801r 1               ext_paint:
000801r 1  20 rr rr           JSR   erase_turtle_sprite
000804r 1  20 rr rr           JSR   wait_vgc
000807r 1  A5 84              LDA   EXT_ARG0_LO
000809r 1  8D 11 A0           STA   VGC_P0
00080Cr 1  A5 83              LDA   EXT_ARG0_HI
00080Er 1  8D 12 A0           STA   VGC_P1
000811r 1  A5 88              LDA   EXT_ARG1_LO
000813r 1  8D 13 A0           STA   VGC_P2
000816r 1  A5 87              LDA   EXT_ARG1_HI
000818r 1  8D 14 A0           STA   VGC_P3
00081Br 1  A9 09              LDA   #VCMD_PAINT
00081Dr 1  8D 10 A0           STA   VGC_CMD
000820r 1  20 rr rr           JSR   wait_vgc
000823r 1  4C rr rr           JMP   draw_turtle_sprite
000826r 1               
000826r 1               ; =====================================================================
000826r 1               ; ext_sprite — SPRITE n x y: position and enable sprite N
000826r 1               ;   ARG0 = slot, ARG1 = x (16-bit), ARG2 = y (16-bit)
000826r 1               ; =====================================================================
000826r 1               ext_sprite:
000826r 1                     ; SPRPOS: P0=slot, P1=x_lo, P2=x_hi, P3=y_lo, P4=y_hi
000826r 1  20 rr rr           JSR   wait_vgc
000829r 1  A5 84              LDA   EXT_ARG0_LO
00082Br 1  8D 11 A0           STA   VGC_P0
00082Er 1  A5 88              LDA   EXT_ARG1_LO
000830r 1  8D 12 A0           STA   VGC_P1
000833r 1  A5 87              LDA   EXT_ARG1_HI
000835r 1  8D 13 A0           STA   VGC_P2
000838r 1  A5 8C              LDA   EXT_ARG2_LO
00083Ar 1  8D 14 A0           STA   VGC_P3
00083Dr 1  A5 8B              LDA   EXT_ARG2_HI
00083Fr 1  8D 15 A0           STA   VGC_P4
000842r 1  A9 14              LDA   #VCMD_SPRPOS
000844r 1  8D 10 A0           STA   VGC_CMD
000847r 1                     ; SPRENA: P0=slot
000847r 1  20 rr rr           JSR   wait_vgc
00084Ar 1  A5 84              LDA   EXT_ARG0_LO
00084Cr 1  8D 11 A0           STA   VGC_P0
00084Fr 1  A9 15              LDA   #VCMD_SPRENA
000851r 1  8D 10 A0           STA   VGC_CMD
000854r 1  60                 RTS
000855r 1               
000855r 1               ; =====================================================================
000855r 1               ; ext_spritepos — SPRITEPOS n x y: reposition sprite N
000855r 1               ;   ARG0 = slot, ARG1 = x, ARG2 = y
000855r 1               ; =====================================================================
000855r 1               ext_spritepos:
000855r 1  20 rr rr           JSR   wait_vgc
000858r 1  A5 84              LDA   EXT_ARG0_LO
00085Ar 1  8D 11 A0           STA   VGC_P0
00085Dr 1  A5 88              LDA   EXT_ARG1_LO
00085Fr 1  8D 12 A0           STA   VGC_P1
000862r 1  A5 87              LDA   EXT_ARG1_HI
000864r 1  8D 13 A0           STA   VGC_P2
000867r 1  A5 8C              LDA   EXT_ARG2_LO
000869r 1  8D 14 A0           STA   VGC_P3
00086Cr 1  A5 8B              LDA   EXT_ARG2_HI
00086Er 1  8D 15 A0           STA   VGC_P4
000871r 1  A9 14              LDA   #VCMD_SPRPOS
000873r 1  8D 10 A0           STA   VGC_CMD
000876r 1  60                 RTS
000877r 1               
000877r 1               ; =====================================================================
000877r 1               ; ext_spriteon — SPRITEON n: enable sprite N
000877r 1               ;   ARG0 = slot
000877r 1               ; =====================================================================
000877r 1               ext_spriteon:
000877r 1  20 rr rr           JSR   wait_vgc
00087Ar 1  A5 84              LDA   EXT_ARG0_LO
00087Cr 1  8D 11 A0           STA   VGC_P0
00087Fr 1  A9 15              LDA   #VCMD_SPRENA
000881r 1  8D 10 A0           STA   VGC_CMD
000884r 1  60                 RTS
000885r 1               
000885r 1               ; =====================================================================
000885r 1               ; ext_spriteoff — SPRITEOFF n: disable sprite N
000885r 1               ;   ARG0 = slot
000885r 1               ; =====================================================================
000885r 1               ext_spriteoff:
000885r 1  20 rr rr           JSR   wait_vgc
000888r 1  A5 84              LDA   EXT_ARG0_LO
00088Ar 1  8D 11 A0           STA   VGC_P0
00088Dr 1  A9 16              LDA   #VCMD_SPRDIS
00088Fr 1  8D 10 A0           STA   VGC_CMD
000892r 1  60                 RTS
000893r 1               
000893r 1               ; =====================================================================
000893r 1               ; ext_sprcollp — SPRITECOLLISION? n: return 1 if sprite N collided
000893r 1               ;   ARG0 = slot (0-15)
000893r 1               ;   Reads VGC_COLLST (bits 0-7) / VGC_COLLST_HI (bits 8-15)
000893r 1               ; =====================================================================
000893r 1               ext_sprcollp:
000893r 1  A5 84              LDA   EXT_ARG0_LO
000895r 1  C9 08              CMP   #8
000897r 1  B0 06              BCS   @hi_byte
000899r 1                     ; Sprite 0-7: read low byte, test bit
000899r 1  AA                 TAX
00089Ar 1  AD 0B A0           LDA   VGC_COLLST
00089Dr 1  80 07              BRA   @test_bit
00089Fr 1               @hi_byte:
00089Fr 1                     ; Sprite 8-15: read high byte, adjust bit index
00089Fr 1  38                 SEC
0008A0r 1  E9 08              SBC   #8
0008A2r 1  AA                 TAX
0008A3r 1  AD EB A0           LDA   VGC_COLLST_HI
0008A6r 1               @test_bit:
0008A6r 1                     ; Shift right X times to get bit into carry
0008A6r 1  E0 00              CPX   #0
0008A8r 1  F0 04              BEQ   @check
0008AAr 1               @shift:
0008AAr 1  4A                 LSR
0008ABr 1  CA                 DEX
0008ACr 1  D0 FC              BNE   @shift
0008AEr 1               @check:
0008AEr 1  29 01              AND   #$01
0008B0r 1  85 90              STA   EXT_RESULT_LO
0008B2r 1  64 8F              STZ   EXT_RESULT_HI
0008B4r 1  64 91              STZ   EXT_RESULT_FRAC
0008B6r 1  64 8E              STZ   EXT_RESULT_TYPE
0008B8r 1  60                 RTS
0008B9r 1               
0008B9r 1               ; =====================================================================
0008B9r 1               ; ext_tone — TONE freq dur: play a tone on SID voice 0
0008B9r 1               ;   ARG0 = frequency (16-bit SID freq word), ARG1 = duration (frames)
0008B9r 1               ; =====================================================================
0008B9r 1               ext_tone:
0008B9r 1                     ; Set SID master volume to max
0008B9r 1  A9 0F              LDA   #$0F
0008BBr 1  8D 18 D4           STA   SID_BASE + $18         ; $D418 filter/volume, bits 0-3 = volume
0008BEr 1                     ; Set frequency
0008BEr 1  A5 84              LDA   EXT_ARG0_LO
0008C0r 1  8D 00 D4           STA   SID_BASE + $00         ; freq lo
0008C3r 1  A5 83              LDA   EXT_ARG0_HI
0008C5r 1  8D 01 D4           STA   SID_BASE + $01         ; freq hi
0008C8r 1                     ; Set ADSR: attack=0, decay=9, sustain=$A, release=0
0008C8r 1  A9 09              LDA   #$09
0008CAr 1  8D 05 D4           STA   SID_BASE + $05         ; attack/decay
0008CDr 1  A9 A0              LDA   #$A0
0008CFr 1  8D 06 D4           STA   SID_BASE + $06         ; sustain/release
0008D2r 1                     ; Gate on with sawtooth waveform
0008D2r 1  A9 21              LDA   #$21                   ; sawtooth ($20) + gate ($01)
0008D4r 1  8D 04 D4           STA   SID_BASE + $04         ; control register
0008D7r 1                     ; Wait duration frames
0008D7r 1  A5 88              LDA   EXT_ARG1_LO
0008D9r 1  20 rr rr           JSR   wait_frames
0008DCr 1                     ; Gate off
0008DCr 1  A9 20              LDA   #$20                   ; sawtooth, no gate
0008DEr 1  8D 04 D4           STA   SID_BASE + $04
0008E1r 1  60                 RTS
0008E2r 1               
0008E2r 1               ; =====================================================================
0008E2r 1               ; ext_noise — NOISE dur: noise burst on SID voice 0
0008E2r 1               ;   ARG0 = duration (frames)
0008E2r 1               ; =====================================================================
0008E2r 1               ext_noise:
0008E2r 1                     ; Set SID master volume to max
0008E2r 1  A9 0F              LDA   #$0F
0008E4r 1  8D 18 D4           STA   SID_BASE + $18
0008E7r 1                     ; Set a mid-range frequency for noise
0008E7r 1  A9 00              LDA   #$00
0008E9r 1  8D 00 D4           STA   SID_BASE + $00
0008ECr 1  A9 20              LDA   #$20
0008EEr 1  8D 01 D4           STA   SID_BASE + $01
0008F1r 1                     ; ADSR: fast attack, medium sustain
0008F1r 1  A9 09              LDA   #$09
0008F3r 1  8D 05 D4           STA   SID_BASE + $05
0008F6r 1  A9 A0              LDA   #$A0
0008F8r 1  8D 06 D4           STA   SID_BASE + $06
0008FBr 1                     ; Gate on with noise waveform
0008FBr 1  A9 81              LDA   #$81                   ; noise ($80) + gate ($01)
0008FDr 1  8D 04 D4           STA   SID_BASE + $04
000900r 1                     ; Wait duration frames
000900r 1  A5 84              LDA   EXT_ARG0_LO
000902r 1  20 rr rr           JSR   wait_frames
000905r 1                     ; Gate off
000905r 1  A9 80              LDA   #$80                   ; noise, no gate
000907r 1  8D 04 D4           STA   SID_BASE + $04
00090Ar 1  60                 RTS
00090Br 1               
00090Br 1               ; =====================================================================
00090Br 1               ; ext_volume — VOLUME vol: set SID master volume (0-15)
00090Br 1               ;   ARG0 = volume
00090Br 1               ; =====================================================================
00090Br 1               ext_volume:
00090Br 1  A5 84              LDA   EXT_ARG0_LO
00090Dr 1  29 0F              AND   #$0F                   ; clamp to 0-15
00090Fr 1  8D 18 D4           STA   SID_BASE + $18
000912r 1  60                 RTS
000913r 1               
000913r 1               ; =====================================================================
000913r 1               ; ext_wait — WAIT n: wait N video frames
000913r 1               ;   ARG0 = count
000913r 1               ; =====================================================================
000913r 1               ext_wait:
000913r 1  A5 84              LDA   EXT_ARG0_LO
000915r 1  20 rr rr           JSR   wait_frames
000918r 1  60                 RTS
000919r 1               
000919r 1               ; =====================================================================
000919r 1               ; ext_waitvbl — WAITVBL: wait for next vertical blank (1 frame)
000919r 1               ; =====================================================================
000919r 1               ext_waitvbl:
000919r 1  AD 08 A0           LDA   VGC_FRAME
00091Cr 1  CD 08 A0     @w:   CMP   VGC_FRAME
00091Fr 1  F0 FB              BEQ   @w
000921r 1  60                 RTS
000922r 1               
000922r 1               ; =====================================================================
000922r 1               ; ext_timer — TIMER: return current frame counter (8-bit)
000922r 1               ; =====================================================================
000922r 1               ext_timer:
000922r 1  AD 08 A0           LDA   VGC_FRAME
000925r 1  85 90              STA   EXT_RESULT_LO
000927r 1  64 8F              STZ   EXT_RESULT_HI
000929r 1  64 91              STZ   EXT_RESULT_FRAC
00092Br 1  64 8E              STZ   EXT_RESULT_TYPE
00092Dr 1  60                 RTS
00092Er 1               
00092Er 1               ; =====================================================================
00092Er 1               ; wait_frames — wait A video frames. Reused by TONE, NOISE, WAIT.
00092Er 1               ; =====================================================================
00092Er 1               wait_frames:
00092Er 1  AA                 TAX
00092Fr 1  F0 0E              BEQ   @done
000931r 1  AD 08 A0           LDA   VGC_FRAME
000934r 1               @wait:
000934r 1  CD 08 A0           CMP   VGC_FRAME
000937r 1  F0 FB              BEQ   @wait
000939r 1  AD 08 A0           LDA   VGC_FRAME
00093Cr 1  CA                 DEX
00093Dr 1  D0 F5              BNE   @wait
00093Fr 1               @done:
00093Fr 1  60                 RTS
000940r 1               
000940r 1               ; =====================================================================
000940r 1               ; RODATA segment — turtle sprite shape data
000940r 1               ; =====================================================================
000940r 1                     .segment "RODATA"
000000r 1               
000000r 1               ; 16x16 turtle arrow shape pointing UP (north), matching the NDK turtle demo.
000000r 1               turtle_shape_data:
000000r 1  00 00 00 00  .repeat 16, yy
000004r 1  00 00 00 00  
000008r 1  00 00 00 00  
000100r 1                 .repeat 16, xx
000100r 1                   .if yy < 1
000100r 1                     .byte 0
000100r 1                   .elseif yy > 14
000100r 1                     .byte 0
000100r 1                   .elseif yy = 14
000100r 1                     .if xx >= 1 && xx <= 5
000100r 1                       .byte COL_RED
000100r 1                     .elseif xx >= 10 && xx <= 14
000100r 1                       .byte COL_GREEN
000100r 1                     .elseif xx >= 1 && xx <= 14
000100r 1                       .byte COL_WHITE
000100r 1                     .else
000100r 1                       .byte 0
000100r 1                     .endif
000100r 1                   .elseif xx = (8 - ((((yy - 1) * 7) + 6) / 13))
000100r 1                     .if yy >= 9
000100r 1                       .byte COL_RED
000100r 1                     .else
000100r 1                       .byte COL_WHITE
000100r 1                     .endif
000100r 1                   .elseif xx = (8 + ((((yy - 1) * 6) + 6) / 13))
000100r 1                     .if yy >= 9
000100r 1                       .byte COL_GREEN
000100r 1                     .else
000100r 1                       .byte COL_WHITE
000100r 1                     .endif
000100r 1                   .else
000100r 1                     .byte 0
000100r 1                   .endif
000100r 1                 .endrepeat
000100r 1               .endrepeat
000100r 1               
000100r 1                     .include "vgc.s"
000100r 2               ; Shared Nova VGC helper routines.
000100r 2               ;
000100r 2               ; BASIC should parse language syntax and load VGC registers; assembly callers
000100r 2               ; can use the same routines directly after setting VGC_P* arguments.
000100r 2               
000100r 2               .include "vgc.inc"
000100r 3               ; Shared Nova VGC helper declarations.
000100r 3               ;
000100r 3               ; The command helpers use the VGC hardware parameter registers directly:
000100r 3               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
000100r 3               ; Routines return through the hardware status model; command completion can be
000100r 3               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
000100r 3               
000100r 3               .ifndef VGC_INC_INCLUDED
000100r 3               VGC_INC_INCLUDED = 1
000100r 3               
000100r 3               .include "nova.inc"
000100r 3               
000100r 3               VGC_RESULT_OK    = $00
000100r 3               VGC_RESULT_ERROR = $01
000100r 3               
000100r 3               .endif
000100r 3               
000100r 2               
000100r 2               .ifndef VGC_IMPLEMENTATION_INCLUDED
000100r 2               VGC_IMPLEMENTATION_INCLUDED = 1
000100r 2               
000100r 2                     .segment "CODE"
000940r 2               
000940r 2                     .export vgc_cmd
000940r 2                     .export vgc_wait_cmd
000940r 2               .ifndef VGC_NO_EXEC
000940r 2                     .export vgc_exec
000940r 2               .endif
000940r 2                     .export vgc_vsync
000940r 2                     .export vgc_cls
000940r 2                     .export vgc_set_fg
000940r 2                     .export vgc_set_bg
000940r 2                     .export vgc_set_border
000940r 2                     .export vgc_display_on
000940r 2                     .export vgc_display_off
000940r 2                     .export vgc_irq_install
000940r 2                     .export vgc_irq_enable
000940r 2                     .export vgc_irq_disable
000940r 2                     .export vgc_irq_ack
000940r 2                     .export vgc_locate
000940r 2                     .export vgc_set_mode
000940r 2                     .export vgc_set_font
000940r 2                     .export vgc_mem_read
000940r 2                     .export vgc_mem_write
000940r 2                     .export vgc_reverse_default
000940r 2                     .export vgc_reverse_explicit
000940r 2                     .export vgc_reverse_off
000940r 2                     .export vgc_flash_on
000940r 2                     .export vgc_flash_off
000940r 2               .ifndef VGC_NO_PRIMITIVES
000940r 2                     .export vgc_gcls
000940r 2                     .export vgc_gcolor
000940r 2                     .export vgc_plot
000940r 2                     .export vgc_unplot
000940r 2                     .export vgc_line
000940r 2                     .export vgc_circle
000940r 2                     .export vgc_gtext
000940r 2                     .export vgc_rect
000940r 2                     .export vgc_fill
000940r 2                     .export vgc_paint
000940r 2               .endif
000940r 2               
000940r 2               ; Input: A = VGC command. Does not wait for completion.
000940r 2               ; @label VGC.COMMAND
000940r 2               ; @kind routine
000940r 2               ; @symbol vgc_cmd
000940r 2               ; @summary Issue a raw VGC command without waiting for completion.
000940r 2               ; @in A: VGC command byte.
000940r 2               vgc_cmd:
000940r 2  8D 10 A0           STA   VGC_CMD
000943r 2  60                 RTS
000944r 2               
000944r 2               ; Wait until the command busy bit clears.
000944r 2               ; @label VGC.WAIT_COMMAND
000944r 2               ; @kind routine
000944r 2               ; @symbol vgc_wait_cmd
000944r 2               ; @summary Wait for the active VGC command to complete.
000944r 2               vgc_wait_cmd:
000944r 2               @wait:
000944r 2  AD 10 A0           LDA   VGC_CMD
000947r 2  29 01              AND   #$01
000949r 2  D0 F9              BNE   @wait
00094Br 2  60                 RTS
00094Cr 2               
00094Cr 2               ; Input: A = VGC command. Issue and wait for completion.
00094Cr 2               .ifndef VGC_NO_EXEC
00094Cr 2               ; @label VGC.EXEC
00094Cr 2               ; @kind routine
00094Cr 2               ; @symbol vgc_exec
00094Cr 2               ; @summary Issue a raw VGC command and wait for completion.
00094Cr 2               ; @in A: VGC command byte.
00094Cr 2               vgc_exec:
00094Cr 2  20 rr rr           JSR   vgc_cmd
00094Fr 2  4C rr rr           JMP   vgc_wait_cmd
000952r 2               .endif
000952r 2               
000952r 2               ; Wait for the next frame counter tick.
000952r 2               ; @label VGC.VSYNC
000952r 2               ; @kind routine
000952r 2               ; @symbol vgc_vsync
000952r 2               ; @summary Wait until the VGC frame counter advances.
000952r 2               ; @out A: Last observed frame counter value.
000952r 2               vgc_vsync:
000952r 2  AD 08 A0           LDA   VGC_FRAME
000955r 2               @wait:
000955r 2  CD 08 A0           CMP   VGC_FRAME
000958r 2  F0 FB              BEQ   @wait
00095Ar 2  60                 RTS
00095Br 2               
00095Br 2               ; @label VGC.CLS
00095Br 2               ; @kind routine
00095Br 2               ; @symbol vgc_cls
00095Br 2               ; @summary Clear the text screen through the VGC character output register and wait for completion.
00095Br 2               vgc_cls:
00095Br 2               .ifdef VGC_CLS_EXT
00095Br 2                     LDA   #EXT_CMD_CLS
00095Br 2                     JMP   EXT_vec
00095Br 2               .else
00095Br 2  A9 0C              LDA   #$0C
00095Dr 2  8D 0E A0           STA   VGC_CHAROUT
000960r 2  4C rr rr           JMP   vgc_wait_cmd
000963r 2               .endif
000963r 2               
000963r 2               ; @label VGC.SET_FG
000963r 2               ; @kind routine
000963r 2               ; @symbol vgc_set_fg
000963r 2               ; @summary Set the current text foreground colour.
000963r 2               ; @in X: Foreground colour byte.
000963r 2               vgc_set_fg:
000963r 2  8E 02 A0           STX   VGC_FGCOL
000966r 2  60                 RTS
000967r 2               
000967r 2               ; @label VGC.SET_BG
000967r 2               ; @kind routine
000967r 2               ; @symbol vgc_set_bg
000967r 2               ; @summary Set the current text background colour.
000967r 2               ; @in X: Background colour byte.
000967r 2               vgc_set_bg:
000967r 2  8E 01 A0           STX   VGC_BGCOL
00096Ar 2  60                 RTS
00096Br 2               
00096Br 2               ; @label VGC.SET_BORDER
00096Br 2               ; @kind routine
00096Br 2               ; @symbol vgc_set_border
00096Br 2               ; @summary Set the VGC border colour.
00096Br 2               ; @in X: Border colour byte.
00096Br 2               vgc_set_border:
00096Br 2  8E 0D A0           STX   VGC_BORDER
00096Er 2  60                 RTS
00096Fr 2               
00096Fr 2               ; @label VGC.DISPLAY_ON
00096Fr 2               ; @kind routine
00096Fr 2               ; @symbol vgc_display_on
00096Fr 2               ; @summary Restore full VGC output brightness.
00096Fr 2               vgc_display_on:
00096Fr 2  A9 0F              LDA   #$0F
000971r 2  8D E5 A0           STA   VGC_DIMMER
000974r 2  60                 RTS
000975r 2               
000975r 2               ; @label VGC.DISPLAY_OFF
000975r 2               ; @kind routine
000975r 2               ; @symbol vgc_display_off
000975r 2               ; @summary Blank VGC output while keeping video timing active.
000975r 2               vgc_display_off:
000975r 2  A9 00              LDA   #$00
000977r 2  8D E5 A0           STA   VGC_DIMMER
00097Ar 2  60                 RTS
00097Br 2               
00097Br 2               ; @label VGC.IRQ_INSTALL
00097Br 2               ; @kind routine
00097Br 2               ; @symbol vgc_irq_install
00097Br 2               ; @summary Install the CPU IRQ vector used when enabled VGC IRQ sources fire.
00097Br 2               ; @in A: Handler address high byte.
00097Br 2               ; @in Y: Handler address low byte.
00097Br 2               vgc_irq_install:
00097Br 2  08                 PHP
00097Cr 2  78                 SEI
00097Dr 2  8C FE FF           STY   CPU_IRQ_VECTOR
000980r 2  8D FF FF           STA   CPU_IRQ_VECTOR+1
000983r 2  28                 PLP
000984r 2  60                 RTS
000985r 2               
000985r 2               ; @label VGC.IRQ_ENABLE
000985r 2               ; @kind routine
000985r 2               ; @symbol vgc_irq_enable
000985r 2               ; @summary Enable one or more VGC IRQ source bits and enable maskable CPU IRQs.
000985r 2               ; @in A: VGC IRQ source mask.
000985r 2               vgc_irq_enable:
000985r 2  0D F0 A0           ORA   VGC_IRQ_ENABLE
000988r 2  8D F0 A0           STA   VGC_IRQ_ENABLE
00098Br 2  58                 CLI
00098Cr 2  60                 RTS
00098Dr 2               
00098Dr 2               ; @label VGC.IRQ_DISABLE
00098Dr 2               ; @kind routine
00098Dr 2               ; @symbol vgc_irq_disable
00098Dr 2               ; @summary Disable one or more VGC IRQ source bits.
00098Dr 2               ; @in A: VGC IRQ source mask.
00098Dr 2               vgc_irq_disable:
00098Dr 2  49 FF              EOR   #$FF
00098Fr 2  2D F0 A0           AND   VGC_IRQ_ENABLE
000992r 2  8D F0 A0           STA   VGC_IRQ_ENABLE
000995r 2  60                 RTS
000996r 2               
000996r 2               ; @label VGC.IRQ_ACK
000996r 2               ; @kind routine
000996r 2               ; @symbol vgc_irq_ack
000996r 2               ; @summary Acknowledge pending VGC IRQ source bits.
000996r 2               ; @in A: VGC IRQ source mask.
000996r 2               vgc_irq_ack:
000996r 2  8D F1 A0           STA   VGC_IRQ_STATUS
000999r 2  60                 RTS
00099Ar 2               
00099Ar 2               ; @label VGC.LOCATE
00099Ar 2               ; @kind routine
00099Ar 2               ; @symbol vgc_locate
00099Ar 2               ; @summary Set the text cursor position from VGC.P0/VGC.P1.
00099Ar 2               ; @in VGC_P0: Cursor X column.
00099Ar 2               ; @in VGC_P1: Cursor Y row.
00099Ar 2               vgc_locate:
00099Ar 2  AD 11 A0           LDA   VGC_P0
00099Dr 2  8D 03 A0           STA   VGC_CURSX
0009A0r 2  AD 12 A0           LDA   VGC_P1
0009A3r 2  8D 04 A0           STA   VGC_CURSY
0009A6r 2  60                 RTS
0009A7r 2               
0009A7r 2               ; @label VGC.SET_MODE
0009A7r 2               ; @kind routine
0009A7r 2               ; @symbol vgc_set_mode
0009A7r 2               ; @summary Set the active VGC graphics/text mode.
0009A7r 2               ; @in X: Mode byte.
0009A7r 2               vgc_set_mode:
0009A7r 2  8E 00 A0           STX   VGC_MODE
0009AAr 2  60                 RTS
0009ABr 2               
0009ABr 2               ; @label VGC.SET_FONT
0009ABr 2               ; @kind routine
0009ABr 2               ; @symbol vgc_set_font
0009ABr 2               ; @summary Select the active text font slot.
0009ABr 2               ; @in X: Font slot, 0..7.
0009ABr 2               vgc_set_font:
0009ABr 2  8E 07 A0           STX   VGC_FONT
0009AEr 2  60                 RTS
0009AFr 2               
0009AFr 2               ; @label VGC.MEM_READ
0009AFr 2               ; @kind routine
0009AFr 2               ; @symbol vgc_mem_read
0009AFr 2               ; @summary Read one byte from VGC memory using VGC.P0..VGC.P4.
0009AFr 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P4
0009AFr 2               ; @out VGC_P3: Read byte.
0009AFr 2               vgc_mem_read:
0009AFr 2  A9 19              LDA   #VCMD_MEMREAD
0009B1r 2  2C                 .byte $2C
0009B2r 2               
0009B2r 2               ; @label VGC.MEM_WRITE
0009B2r 2               ; @kind routine
0009B2r 2               ; @symbol vgc_mem_write
0009B2r 2               ; @summary Write one byte to VGC memory using VGC.P0..VGC.P4.
0009B2r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4
0009B2r 2               vgc_mem_write:
0009B2r 2  A9 1A              LDA   #VCMD_MEMWRITE
0009B4r 2  8D 10 A0           STA   VGC_CMD
0009B7r 2  4C rr rr           JMP   vgc_wait_cmd
0009BAr 2               
0009BAr 2               ; Enable reverse text by swapping the current foreground/background colours.
0009BAr 2               ; @label VGC.REVERSE
0009BAr 2               ; @kind routine
0009BAr 2               ; @symbol vgc_reverse_default
0009BAr 2               ; @summary Enable reverse text using the current foreground/background colours.
0009BAr 2               vgc_reverse_default:
0009BAr 2  AD E6 A0           LDA   VGC_TXTFLAGS
0009BDr 2  29 FC              AND   #$FC
0009BFr 2  09 01              ORA   #VTXT_REV
0009C1r 2  8D E6 A0           STA   VGC_TXTFLAGS
0009C4r 2  60                 RTS
0009C5r 2               
0009C5r 2               ; Input: A = packed reverse attribute, low nibble fg and high nibble bg.
0009C5r 2               ; @label VGC.REVERSE_EXPLICIT
0009C5r 2               ; @kind routine
0009C5r 2               ; @symbol vgc_reverse_explicit
0009C5r 2               ; @summary Enable reverse text with explicit packed foreground/background colours.
0009C5r 2               ; @in A: Packed reverse attribute, low nibble foreground and high nibble background.
0009C5r 2               vgc_reverse_explicit:
0009C5r 2  8D E7 A0           STA   VGC_TXTREVATTR
0009C8r 2  AD E6 A0           LDA   VGC_TXTFLAGS
0009CBr 2  29 FC              AND   #$FC
0009CDr 2  09 03              ORA   #(VTXT_REV | VTXT_REVEX)
0009CFr 2  8D E6 A0           STA   VGC_TXTFLAGS
0009D2r 2  60                 RTS
0009D3r 2               
0009D3r 2               ; @label VGC.REVERSE_OFF
0009D3r 2               ; @kind routine
0009D3r 2               ; @symbol vgc_reverse_off
0009D3r 2               ; @summary Disable reverse text.
0009D3r 2               vgc_reverse_off:
0009D3r 2  AD E6 A0           LDA   VGC_TXTFLAGS
0009D6r 2  29 FC              AND   #$FC
0009D8r 2  8D E6 A0           STA   VGC_TXTFLAGS
0009DBr 2  60                 RTS
0009DCr 2               
0009DCr 2               ; @label VGC.FLASH_ON
0009DCr 2               ; @kind routine
0009DCr 2               ; @symbol vgc_flash_on
0009DCr 2               ; @summary Enable flashing text.
0009DCr 2               vgc_flash_on:
0009DCr 2  AD E6 A0           LDA   VGC_TXTFLAGS
0009DFr 2  09 04              ORA   #VTXT_FLASH
0009E1r 2  8D E6 A0           STA   VGC_TXTFLAGS
0009E4r 2  60                 RTS
0009E5r 2               
0009E5r 2               ; @label VGC.FLASH_OFF
0009E5r 2               ; @kind routine
0009E5r 2               ; @symbol vgc_flash_off
0009E5r 2               ; @summary Disable flashing text.
0009E5r 2               vgc_flash_off:
0009E5r 2  AD E6 A0           LDA   VGC_TXTFLAGS
0009E8r 2  29 FB              AND   #$FB
0009EAr 2  8D E6 A0           STA   VGC_TXTFLAGS
0009EDr 2  60                 RTS
0009EEr 2               
0009EEr 2               .ifndef VGC_NO_PRIMITIVES
0009EEr 2               ; @label VGC.GCLS
0009EEr 2               ; @kind routine
0009EEr 2               ; @symbol vgc_gcls
0009EEr 2               ; @summary Issue the VGC graphics clear command.
0009EEr 2               vgc_gcls:
0009EEr 2  A9 07              LDA   #VCMD_GCLS
0009F0r 2  4C rr rr           JMP   vgc_cmd
0009F3r 2               
0009F3r 2               ; @label VGC.GCOLOR
0009F3r 2               ; @kind routine
0009F3r 2               ; @symbol vgc_gcolor
0009F3r 2               ; @summary Issue the VGC graphics colour command using VGC.P0.
0009F3r 2               ; @requires VGC_P0
0009F3r 2               vgc_gcolor:
0009F3r 2  A9 08              LDA   #VCMD_GCOLOR
0009F5r 2  4C rr rr           JMP   vgc_cmd
0009F8r 2               
0009F8r 2               ; @label VGC.PLOT
0009F8r 2               ; @kind routine
0009F8r 2               ; @symbol vgc_plot
0009F8r 2               ; @summary Issue the VGC plot command using VGC.P0..VGC.P3.
0009F8r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
0009F8r 2               vgc_plot:
0009F8r 2  A9 01              LDA   #VCMD_PLOT
0009FAr 2  4C rr rr           JMP   vgc_cmd
0009FDr 2               
0009FDr 2               ; @label VGC.UNPLOT
0009FDr 2               ; @kind routine
0009FDr 2               ; @symbol vgc_unplot
0009FDr 2               ; @summary Issue the VGC unplot command using VGC.P0..VGC.P3.
0009FDr 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
0009FDr 2               vgc_unplot:
0009FDr 2  A9 02              LDA   #VCMD_UNPLOT
0009FFr 2  4C rr rr           JMP   vgc_cmd
000A02r 2               
000A02r 2               ; @label VGC.LINE
000A02r 2               ; @kind routine
000A02r 2               ; @symbol vgc_line
000A02r 2               ; @summary Issue the VGC line command using VGC.P0..VGC.P7.
000A02r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000A02r 2               vgc_line:
000A02r 2  A9 03              LDA   #VCMD_LINE
000A04r 2  4C rr rr           JMP   vgc_cmd
000A07r 2               
000A07r 2               ; @label VGC.CIRCLE
000A07r 2               ; @kind routine
000A07r 2               ; @symbol vgc_circle
000A07r 2               ; @summary Issue the VGC circle/ellipse command using VGC.P0..VGC.P7.
000A07r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000A07r 2               vgc_circle:
000A07r 2  A9 04              LDA   #VCMD_CIRCLE
000A09r 2  4C rr rr           JMP   vgc_cmd
000A0Cr 2               
000A0Cr 2               ; @label VGC.GTEXT
000A0Cr 2               ; @kind routine
000A0Cr 2               ; @symbol vgc_gtext
000A0Cr 2               ; @summary Issue the VGC graphics text command using VGC.P0..VGC.P5 and FIO.NAME.
000A0Cr 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 FIO_NAME FIO_NAMELEN
000A0Cr 2               vgc_gtext:
000A0Cr 2  A9 0A              LDA   #VCMD_GTEXT
000A0Er 2  4C rr rr           JMP   vgc_cmd
000A11r 2               
000A11r 2               ; @label VGC.RECT
000A11r 2               ; @kind routine
000A11r 2               ; @symbol vgc_rect
000A11r 2               ; @summary Issue the VGC rectangle command using VGC.P0..VGC.P7.
000A11r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000A11r 2               vgc_rect:
000A11r 2  A9 05              LDA   #VCMD_RECT
000A13r 2  4C rr rr           JMP   vgc_cmd
000A16r 2               
000A16r 2               ; @label VGC.FILL
000A16r 2               ; @kind routine
000A16r 2               ; @symbol vgc_fill
000A16r 2               ; @summary Issue the VGC filled rectangle command using VGC.P0..VGC.P7.
000A16r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000A16r 2               vgc_fill:
000A16r 2  A9 06              LDA   #VCMD_FILL
000A18r 2  4C rr rr           JMP   vgc_cmd
000A1Br 2               
000A1Br 2               ; @label VGC.PAINT
000A1Br 2               ; @kind routine
000A1Br 2               ; @symbol vgc_paint
000A1Br 2               ; @summary Issue the VGC paint command using VGC.P0..VGC.P3.
000A1Br 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000A1Br 2               vgc_paint:
000A1Br 2  A9 09              LDA   #VCMD_PAINT
000A1Dr 2  4C rr rr           JMP   vgc_cmd
000A20r 2               .endif
000A20r 2               
000A20r 2               .endif
000A20r 2               
000A20r 1                     .include "copper.s"
000A20r 2               ; Shared Nova copper helper routines.
000A20r 2               ;
000A20r 2               ; Assembly ABI:
000A20r 2               ;   copper_add expects VGC_P0/P1=x, VGC_P2=y, VGC_P3/P4=register/index,
000A20r 2               ;   VGC_P5=value. COPPER_REG_* constants cover common VGC register indices.
000A20r 2               
000A20r 2               .include "copper.inc"
000A20r 3               ; Shared Nova copper helper declarations.
000A20r 3               
000A20r 3               .ifndef COPPER_INC_INCLUDED
000A20r 3               COPPER_INC_INCLUDED = 1
000A20r 3               
000A20r 3               .include "vgc.inc"
000A20r 3               
000A20r 3               COPPER_RESULT_OK    = $00
000A20r 3               COPPER_RESULT_ERROR = $01
000A20r 3               
000A20r 3               COPPER_REG_MODE     = $00
000A20r 3               COPPER_REG_BGCOL    = $01
000A20r 3               COPPER_REG_SCROLLX  = $05
000A20r 3               COPPER_REG_SCROLLY  = $06
000A20r 3               
000A20r 3               .endif
000A20r 3               
000A20r 2               
000A20r 2               .ifndef COPPER_IMPLEMENTATION_INCLUDED
000A20r 2               COPPER_IMPLEMENTATION_INCLUDED = 1
000A20r 2               
000A20r 2                     .segment "CODE"
000A20r 2               
000A20r 2                     .export copper_command
000A20r 2                     .export copper_clear
000A20r 2                     .export copper_on
000A20r 2                     .export copper_off
000A20r 2                     .export copper_list
000A20r 2                     .export copper_list_end
000A20r 2                     .export copper_use
000A20r 2                     .export copper_add
000A20r 2                     .export copper_set_reg_index
000A20r 2                     .export copper_set_sprite_reg
000A20r 2               
000A20r 2               ; Input: A = copper VGC command. Does not wait for completion.
000A20r 2               ; @label COPPER.COMMAND
000A20r 2               ; @kind routine
000A20r 2               ; @symbol copper_command
000A20r 2               ; @summary Issue a raw copper VGC command.
000A20r 2               ; @in A: Copper VGC command byte.
000A20r 2               copper_command:
000A20r 2  8D 10 A0           STA   VGC_CMD
000A23r 2  A9 00              LDA   #COPPER_RESULT_OK
000A25r 2  60                 RTS
000A26r 2               
000A26r 2               ; @label COPPER.CLEAR
000A26r 2               ; @kind routine
000A26r 2               ; @symbol copper_clear
000A26r 2               ; @summary Clear the active copper list.
000A26r 2               copper_clear:
000A26r 2  A9 1C              LDA   #VCMD_COPPERCLR
000A28r 2  4C rr rr           JMP   copper_command
000A2Br 2               
000A2Br 2               ; @label COPPER.ON
000A2Br 2               ; @kind routine
000A2Br 2               ; @symbol copper_on
000A2Br 2               ; @summary Enable copper execution.
000A2Br 2               copper_on:
000A2Br 2  A9 1D              LDA   #VCMD_COPPERENA
000A2Dr 2  4C rr rr           JMP   copper_command
000A30r 2               
000A30r 2               ; @label COPPER.OFF
000A30r 2               ; @kind routine
000A30r 2               ; @symbol copper_off
000A30r 2               ; @summary Disable copper execution.
000A30r 2               copper_off:
000A30r 2  A9 1E              LDA   #VCMD_COPPERDIS
000A32r 2  4C rr rr           JMP   copper_command
000A35r 2               
000A35r 2               ; @label COPPER.LIST
000A35r 2               ; @kind routine
000A35r 2               ; @symbol copper_list
000A35r 2               ; @summary Select a copper list using VGC.P0.
000A35r 2               ; @requires VGC_P0
000A35r 2               copper_list:
000A35r 2  A9 20              LDA   #VCMD_COPPERLIST
000A37r 2  4C rr rr           JMP   copper_command
000A3Ar 2               
000A3Ar 2               ; @label COPPER.LIST_END
000A3Ar 2               ; @kind routine
000A3Ar 2               ; @symbol copper_list_end
000A3Ar 2               ; @summary Finish the current copper list.
000A3Ar 2               copper_list_end:
000A3Ar 2  A9 22              LDA   #VCMD_COPPEREND
000A3Cr 2  4C rr rr           JMP   copper_command
000A3Fr 2               
000A3Fr 2               ; @label COPPER.USE
000A3Fr 2               ; @kind routine
000A3Fr 2               ; @symbol copper_use
000A3Fr 2               ; @summary Activate a copper list using VGC.P0.
000A3Fr 2               ; @requires VGC_P0
000A3Fr 2               copper_use:
000A3Fr 2  A9 21              LDA   #VCMD_COPPERUSE
000A41r 2  4C rr rr           JMP   copper_command
000A44r 2               
000A44r 2               ; @label COPPER.ADD
000A44r 2               ; @kind routine
000A44r 2               ; @symbol copper_add
000A44r 2               ; @summary Add a copper operation using VGC.P0..VGC.P5.
000A44r 2               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5
000A44r 2               copper_add:
000A44r 2  A9 1B              LDA   #VCMD_COPPERADD
000A46r 2  4C rr rr           JMP   copper_command
000A49r 2               
000A49r 2               ; Input: A = direct VGC register index. Output: VGC_P3/P4 updated.
000A49r 2               ; @label COPPER.SET_REG_INDEX
000A49r 2               ; @kind routine
000A49r 2               ; @symbol copper_set_reg_index
000A49r 2               ; @summary Set VGC.P3/P4 to a direct VGC register index.
000A49r 2               ; @in A: VGC register index.
000A49r 2               copper_set_reg_index:
000A49r 2  8D 14 A0           STA   VGC_P3
000A4Cr 2  9C 15 A0           STZ   VGC_P4
000A4Fr 2  60                 RTS
000A50r 2               
000A50r 2               ; Input: X = sprite index, A = VGC_SPR_*_OFF field.
000A50r 2               ; Output: VGC_P3/P4 = absolute sprite register address.
000A50r 2               ; Clobbers: A, NVR7L.
000A50r 2               ; @label COPPER.SET_SPRITE_REG
000A50r 2               ; @kind routine
000A50r 2               ; @symbol copper_set_sprite_reg
000A50r 2               ; @summary Set VGC.P3/P4 to a sprite attribute register address.
000A50r 2               ; @in X: Sprite index.
000A50r 2               ; @in A: Sprite field offset.
000A50r 2               copper_set_sprite_reg:
000A50r 2  85 2E              STA   NVR7L
000A52r 2  8A                 TXA
000A53r 2  0A                 ASL
000A54r 2  0A                 ASL
000A55r 2  0A                 ASL
000A56r 2  18                 CLC
000A57r 2  65 2E              ADC   NVR7L
000A59r 2  18                 CLC
000A5Ar 2  69 40              ADC   #<VGC_SPR_BASE
000A5Cr 2  8D 14 A0           STA   VGC_P3
000A5Fr 2  A9 A0              LDA   #>VGC_SPR_BASE
000A61r 2  69 00              ADC   #$00
000A63r 2  8D 15 A0           STA   VGC_P4
000A66r 2  60                 RTS
000A67r 2               
000A67r 2               .endif
000A67r 2               
000A67r 1                     .include "copper_split.s"
000A67r 2               ; Shared Nova copper split helper routines.
000A67r 2               
000A67r 2               .include "copper_split.inc"
000A67r 3               ; Shared Nova copper split helper declarations.
000A67r 3               
000A67r 3               .ifndef COPPER_SPLIT_INC_INCLUDED
000A67r 3               COPPER_SPLIT_INC_INCLUDED = 1
000A67r 3               
000A67r 3               .include "copper.inc"
000A67r 3               .include "vgc.inc"
000A67r 3               
000A67r 3               COPPER_SPLIT_RESULT_OK    = COPPER_RESULT_OK
000A67r 3               COPPER_SPLIT_RESULT_ERROR = COPPER_RESULT_ERROR
000A67r 3               
000A67r 3               ; @label COPPER.SPLIT_MODE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol copper_split_mode
000A67r 3               ; @summary Configure one copper list to switch VGC mode at a scanline.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000A67r 3               ; @in VGC_P0: Copper list index.
000A67r 3               ; @in VGC_P1: Split scanline Y.
000A67r 3               ; @in VGC_P2: Mode from scanline 0 up to split Y-1.
000A67r 3               ; @in VGC_P3: Mode from split Y onward.
000A67r 3               .global copper_split_mode
000A67r 3               
000A67r 3               .endif
000A67r 3               
000A67r 2               .include "vgc.s"
000A67r 3               ; Shared Nova VGC helper routines.
000A67r 3               ;
000A67r 3               ; BASIC should parse language syntax and load VGC registers; assembly callers
000A67r 3               ; can use the same routines directly after setting VGC_P* arguments.
000A67r 3               
000A67r 3               .include "vgc.inc"
000A67r 4               ; Shared Nova VGC helper declarations.
000A67r 4               ;
000A67r 4               ; The command helpers use the VGC hardware parameter registers directly:
000A67r 4               ; callers load VGC_P0..VGC_P14 as needed, then call a vgc_* routine.
000A67r 4               ; Routines return through the hardware status model; command completion can be
000A67r 4               ; checked with vgc_wait_cmd when the caller needs a synchronous operation.
000A67r 4               
000A67r 4               .ifndef VGC_INC_INCLUDED
000A67r 4               VGC_INC_INCLUDED = 1
000A67r 4               
000A67r 4               .include "nova.inc"
000A67r 4               
000A67r 4               VGC_RESULT_OK    = $00
000A67r 4               VGC_RESULT_ERROR = $01
000A67r 4               
000A67r 4               .endif
000A67r 4               
000A67r 3               
000A67r 3               .ifndef VGC_IMPLEMENTATION_INCLUDED
000A67r 3               VGC_IMPLEMENTATION_INCLUDED = 1
000A67r 3               
000A67r 3                     .segment "CODE"
000A67r 3               
000A67r 3                     .export vgc_cmd
000A67r 3                     .export vgc_wait_cmd
000A67r 3               .ifndef VGC_NO_EXEC
000A67r 3                     .export vgc_exec
000A67r 3               .endif
000A67r 3                     .export vgc_vsync
000A67r 3                     .export vgc_cls
000A67r 3                     .export vgc_set_fg
000A67r 3                     .export vgc_set_bg
000A67r 3                     .export vgc_set_border
000A67r 3                     .export vgc_display_on
000A67r 3                     .export vgc_display_off
000A67r 3                     .export vgc_irq_install
000A67r 3                     .export vgc_irq_enable
000A67r 3                     .export vgc_irq_disable
000A67r 3                     .export vgc_irq_ack
000A67r 3                     .export vgc_locate
000A67r 3                     .export vgc_set_mode
000A67r 3                     .export vgc_set_font
000A67r 3                     .export vgc_mem_read
000A67r 3                     .export vgc_mem_write
000A67r 3                     .export vgc_reverse_default
000A67r 3                     .export vgc_reverse_explicit
000A67r 3                     .export vgc_reverse_off
000A67r 3                     .export vgc_flash_on
000A67r 3                     .export vgc_flash_off
000A67r 3               .ifndef VGC_NO_PRIMITIVES
000A67r 3                     .export vgc_gcls
000A67r 3                     .export vgc_gcolor
000A67r 3                     .export vgc_plot
000A67r 3                     .export vgc_unplot
000A67r 3                     .export vgc_line
000A67r 3                     .export vgc_circle
000A67r 3                     .export vgc_gtext
000A67r 3                     .export vgc_rect
000A67r 3                     .export vgc_fill
000A67r 3                     .export vgc_paint
000A67r 3               .endif
000A67r 3               
000A67r 3               ; Input: A = VGC command. Does not wait for completion.
000A67r 3               ; @label VGC.COMMAND
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_cmd
000A67r 3               ; @summary Issue a raw VGC command without waiting for completion.
000A67r 3               ; @in A: VGC command byte.
000A67r 3               vgc_cmd:
000A67r 3                     STA   VGC_CMD
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; Wait until the command busy bit clears.
000A67r 3               ; @label VGC.WAIT_COMMAND
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_wait_cmd
000A67r 3               ; @summary Wait for the active VGC command to complete.
000A67r 3               vgc_wait_cmd:
000A67r 3               @wait:
000A67r 3                     LDA   VGC_CMD
000A67r 3                     AND   #$01
000A67r 3                     BNE   @wait
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; Input: A = VGC command. Issue and wait for completion.
000A67r 3               .ifndef VGC_NO_EXEC
000A67r 3               ; @label VGC.EXEC
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_exec
000A67r 3               ; @summary Issue a raw VGC command and wait for completion.
000A67r 3               ; @in A: VGC command byte.
000A67r 3               vgc_exec:
000A67r 3                     JSR   vgc_cmd
000A67r 3                     JMP   vgc_wait_cmd
000A67r 3               .endif
000A67r 3               
000A67r 3               ; Wait for the next frame counter tick.
000A67r 3               ; @label VGC.VSYNC
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_vsync
000A67r 3               ; @summary Wait until the VGC frame counter advances.
000A67r 3               ; @out A: Last observed frame counter value.
000A67r 3               vgc_vsync:
000A67r 3                     LDA   VGC_FRAME
000A67r 3               @wait:
000A67r 3                     CMP   VGC_FRAME
000A67r 3                     BEQ   @wait
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.CLS
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_cls
000A67r 3               ; @summary Clear the text screen through the VGC character output register and wait for completion.
000A67r 3               vgc_cls:
000A67r 3               .ifdef VGC_CLS_EXT
000A67r 3                     LDA   #EXT_CMD_CLS
000A67r 3                     JMP   EXT_vec
000A67r 3               .else
000A67r 3                     LDA   #$0C
000A67r 3                     STA   VGC_CHAROUT
000A67r 3                     JMP   vgc_wait_cmd
000A67r 3               .endif
000A67r 3               
000A67r 3               ; @label VGC.SET_FG
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_set_fg
000A67r 3               ; @summary Set the current text foreground colour.
000A67r 3               ; @in X: Foreground colour byte.
000A67r 3               vgc_set_fg:
000A67r 3                     STX   VGC_FGCOL
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.SET_BG
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_set_bg
000A67r 3               ; @summary Set the current text background colour.
000A67r 3               ; @in X: Background colour byte.
000A67r 3               vgc_set_bg:
000A67r 3                     STX   VGC_BGCOL
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.SET_BORDER
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_set_border
000A67r 3               ; @summary Set the VGC border colour.
000A67r 3               ; @in X: Border colour byte.
000A67r 3               vgc_set_border:
000A67r 3                     STX   VGC_BORDER
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.DISPLAY_ON
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_display_on
000A67r 3               ; @summary Restore full VGC output brightness.
000A67r 3               vgc_display_on:
000A67r 3                     LDA   #$0F
000A67r 3                     STA   VGC_DIMMER
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.DISPLAY_OFF
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_display_off
000A67r 3               ; @summary Blank VGC output while keeping video timing active.
000A67r 3               vgc_display_off:
000A67r 3                     LDA   #$00
000A67r 3                     STA   VGC_DIMMER
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.IRQ_INSTALL
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_irq_install
000A67r 3               ; @summary Install the CPU IRQ vector used when enabled VGC IRQ sources fire.
000A67r 3               ; @in A: Handler address high byte.
000A67r 3               ; @in Y: Handler address low byte.
000A67r 3               vgc_irq_install:
000A67r 3                     PHP
000A67r 3                     SEI
000A67r 3                     STY   CPU_IRQ_VECTOR
000A67r 3                     STA   CPU_IRQ_VECTOR+1
000A67r 3                     PLP
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.IRQ_ENABLE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_irq_enable
000A67r 3               ; @summary Enable one or more VGC IRQ source bits and enable maskable CPU IRQs.
000A67r 3               ; @in A: VGC IRQ source mask.
000A67r 3               vgc_irq_enable:
000A67r 3                     ORA   VGC_IRQ_ENABLE
000A67r 3                     STA   VGC_IRQ_ENABLE
000A67r 3                     CLI
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.IRQ_DISABLE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_irq_disable
000A67r 3               ; @summary Disable one or more VGC IRQ source bits.
000A67r 3               ; @in A: VGC IRQ source mask.
000A67r 3               vgc_irq_disable:
000A67r 3                     EOR   #$FF
000A67r 3                     AND   VGC_IRQ_ENABLE
000A67r 3                     STA   VGC_IRQ_ENABLE
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.IRQ_ACK
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_irq_ack
000A67r 3               ; @summary Acknowledge pending VGC IRQ source bits.
000A67r 3               ; @in A: VGC IRQ source mask.
000A67r 3               vgc_irq_ack:
000A67r 3                     STA   VGC_IRQ_STATUS
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.LOCATE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_locate
000A67r 3               ; @summary Set the text cursor position from VGC.P0/VGC.P1.
000A67r 3               ; @in VGC_P0: Cursor X column.
000A67r 3               ; @in VGC_P1: Cursor Y row.
000A67r 3               vgc_locate:
000A67r 3                     LDA   VGC_P0
000A67r 3                     STA   VGC_CURSX
000A67r 3                     LDA   VGC_P1
000A67r 3                     STA   VGC_CURSY
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.SET_MODE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_set_mode
000A67r 3               ; @summary Set the active VGC graphics/text mode.
000A67r 3               ; @in X: Mode byte.
000A67r 3               vgc_set_mode:
000A67r 3                     STX   VGC_MODE
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.SET_FONT
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_set_font
000A67r 3               ; @summary Select the active text font slot.
000A67r 3               ; @in X: Font slot, 0..7.
000A67r 3               vgc_set_font:
000A67r 3                     STX   VGC_FONT
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.MEM_READ
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_mem_read
000A67r 3               ; @summary Read one byte from VGC memory using VGC.P0..VGC.P4.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P4
000A67r 3               ; @out VGC_P3: Read byte.
000A67r 3               vgc_mem_read:
000A67r 3                     LDA   #VCMD_MEMREAD
000A67r 3                     .byte $2C
000A67r 3               
000A67r 3               ; @label VGC.MEM_WRITE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_mem_write
000A67r 3               ; @summary Write one byte to VGC memory using VGC.P0..VGC.P4.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4
000A67r 3               vgc_mem_write:
000A67r 3                     LDA   #VCMD_MEMWRITE
000A67r 3                     STA   VGC_CMD
000A67r 3                     JMP   vgc_wait_cmd
000A67r 3               
000A67r 3               ; Enable reverse text by swapping the current foreground/background colours.
000A67r 3               ; @label VGC.REVERSE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_reverse_default
000A67r 3               ; @summary Enable reverse text using the current foreground/background colours.
000A67r 3               vgc_reverse_default:
000A67r 3                     LDA   VGC_TXTFLAGS
000A67r 3                     AND   #$FC
000A67r 3                     ORA   #VTXT_REV
000A67r 3                     STA   VGC_TXTFLAGS
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; Input: A = packed reverse attribute, low nibble fg and high nibble bg.
000A67r 3               ; @label VGC.REVERSE_EXPLICIT
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_reverse_explicit
000A67r 3               ; @summary Enable reverse text with explicit packed foreground/background colours.
000A67r 3               ; @in A: Packed reverse attribute, low nibble foreground and high nibble background.
000A67r 3               vgc_reverse_explicit:
000A67r 3                     STA   VGC_TXTREVATTR
000A67r 3                     LDA   VGC_TXTFLAGS
000A67r 3                     AND   #$FC
000A67r 3                     ORA   #(VTXT_REV | VTXT_REVEX)
000A67r 3                     STA   VGC_TXTFLAGS
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.REVERSE_OFF
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_reverse_off
000A67r 3               ; @summary Disable reverse text.
000A67r 3               vgc_reverse_off:
000A67r 3                     LDA   VGC_TXTFLAGS
000A67r 3                     AND   #$FC
000A67r 3                     STA   VGC_TXTFLAGS
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.FLASH_ON
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_flash_on
000A67r 3               ; @summary Enable flashing text.
000A67r 3               vgc_flash_on:
000A67r 3                     LDA   VGC_TXTFLAGS
000A67r 3                     ORA   #VTXT_FLASH
000A67r 3                     STA   VGC_TXTFLAGS
000A67r 3                     RTS
000A67r 3               
000A67r 3               ; @label VGC.FLASH_OFF
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_flash_off
000A67r 3               ; @summary Disable flashing text.
000A67r 3               vgc_flash_off:
000A67r 3                     LDA   VGC_TXTFLAGS
000A67r 3                     AND   #$FB
000A67r 3                     STA   VGC_TXTFLAGS
000A67r 3                     RTS
000A67r 3               
000A67r 3               .ifndef VGC_NO_PRIMITIVES
000A67r 3               ; @label VGC.GCLS
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_gcls
000A67r 3               ; @summary Issue the VGC graphics clear command.
000A67r 3               vgc_gcls:
000A67r 3                     LDA   #VCMD_GCLS
000A67r 3                     JMP   vgc_cmd
000A67r 3               
000A67r 3               ; @label VGC.GCOLOR
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_gcolor
000A67r 3               ; @summary Issue the VGC graphics colour command using VGC.P0.
000A67r 3               ; @requires VGC_P0
000A67r 3               vgc_gcolor:
000A67r 3                     LDA   #VCMD_GCOLOR
000A67r 3                     JMP   vgc_cmd
000A67r 3               
000A67r 3               ; @label VGC.PLOT
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_plot
000A67r 3               ; @summary Issue the VGC plot command using VGC.P0..VGC.P3.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000A67r 3               vgc_plot:
000A67r 3                     LDA   #VCMD_PLOT
000A67r 3                     JMP   vgc_cmd
000A67r 3               
000A67r 3               ; @label VGC.UNPLOT
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_unplot
000A67r 3               ; @summary Issue the VGC unplot command using VGC.P0..VGC.P3.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3
000A67r 3               vgc_unplot:
000A67r 3                     LDA   #VCMD_UNPLOT
000A67r 3                     JMP   vgc_cmd
000A67r 3               
000A67r 3               ; @label VGC.LINE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_line
000A67r 3               ; @summary Issue the VGC line command using VGC.P0..VGC.P7.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000A67r 3               vgc_line:
000A67r 3                     LDA   #VCMD_LINE
000A67r 3                     JMP   vgc_cmd
000A67r 3               
000A67r 3               ; @label VGC.CIRCLE
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_circle
000A67r 3               ; @summary Issue the VGC circle/ellipse command using VGC.P0..VGC.P7.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000A67r 3               vgc_circle:
000A67r 3                     LDA   #VCMD_CIRCLE
000A67r 3                     JMP   vgc_cmd
000A67r 3               
000A67r 3               ; @label VGC.GTEXT
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_gtext
000A67r 3               ; @summary Issue the VGC graphics text command using VGC.P0..VGC.P5 and FIO.NAME.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 FIO_NAME FIO_NAMELEN
000A67r 3               vgc_gtext:
000A67r 3                     LDA   #VCMD_GTEXT
000A67r 3                     JMP   vgc_cmd
000A67r 3               
000A67r 3               ; @label VGC.RECT
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_rect
000A67r 3               ; @summary Issue the VGC rectangle command using VGC.P0..VGC.P7.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000A67r 3               vgc_rect:
000A67r 3                     LDA   #VCMD_RECT
000A67r 3                     JMP   vgc_cmd
000A67r 3               
000A67r 3               ; @label VGC.FILL
000A67r 3               ; @kind routine
000A67r 3               ; @symbol vgc_fill
000A67r 3               ; @summary Issue the VGC filled rectangle command using VGC.P0..VGC.P7.
000A67r 3               ; @requires VGC_P0 VGC_P1 VGC_P2 VGC_P3 VGC_P4 VGC_P5 VGC_P6 VGC_P7
000A67r 3               vgc_fill:
