0025FAr 2  ED rr rr           SBC   EB_SELSTARTH
0025FDr 2  8D rr rr           STA   EDITBUF_CLIPLENH
002600r 2                     ; clamp cliplen to 255 (copy/paste iterate with an 8-bit index)
002600r 2  AD rr rr           LDA   EDITBUF_CLIPLENH
002603r 2  F0 08              BEQ   @copy
002605r 2  A9 FF              LDA   #255
002607r 2  8D rr rr           STA   EDITBUF_CLIPLENL
00260Ar 2  9C rr rr           STZ   EDITBUF_CLIPLENH
00260Dr 2               @copy:
