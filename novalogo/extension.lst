0013B8r 2               .include "editui.inc"
0013B8r 3               ; Shared Nova editor-shell UI declarations.
0013B8r 3               ;
0013B8r 3               ; EDITUI is a small text-mode shell for native tools: menu bar, title/help
0013B8r 3               ; rows, framed panels, and status lines. Applications own input dispatch,
0013B8r 3               ; document state, and editor-specific drawing.
0013B8r 3               
0013B8r 3               .ifndef EDITUI_INC_INCLUDED
0013B8r 3               EDITUI_INC_INCLUDED = 1
0013B8r 3               
0013B8r 3               .include "vtext.inc"
0013B8r 3               
0013B8r 3               EDITUI_OK  = $00
0013B8r 3               EDITUI_ERR = $01
0013B8r 3               
0013B8r 3               EDITUI_SCREEN_COLS = VTEXT_SCREEN_COLS
0013B8r 3               EDITUI_SCREEN_ROWS = VTEXT_SCREEN_ROWS
0013B8r 3               
0013B8r 3               ; Black background with light-grey bars. bg = high nibble, fg = low nibble.
0013B8r 3               ; Palette mode 0: 0=black, 1=white, 2=red, 12=grey-med, 15=grey-light.
0013B8r 3               EDITUI_PALETTE_MODE     = $00
0013B8r 3               EDITUI_COLOR_BG         = $00      ; black
0013B8r 3               EDITUI_COLOR_FG         = $01      ; white
0013B8r 3               EDITUI_COLOR_SHELL      = $0F      ; editor background (black bg)
0013B8r 3               EDITUI_COLOR_TITLE      = $01      ; title text: white on black
0013B8r 3               EDITUI_COLOR_MENU       = $F0      ; light-grey menu bar, black text
0013B8r 3               EDITUI_COLOR_MENU_HOT   = $F2      ; light-grey bar, red hotkey
0013B8r 3               EDITUI_COLOR_FRAME      = $0F      ; grey frame lines on black
0013B8r 3               EDITUI_COLOR_DIM        = $0C      ; grey-med dim text on black
0013B8r 3               EDITUI_COLOR_MENU_SEL   = $1F      ; selected dropdown item: white bg
0013B8r 3               EDITUI_COLOR_MENU_SEL_HOT = $12    ; selected item hotkey
0013B8r 3               EDITUI_COLOR_STATUS     = $F0      ; light-grey status bar
0013B8r 3               EDITUI_COLOR_STATUS_HOT = $F6      ; status bar accent
0013B8r 3               EDITUI_COLOR_PANEL      = $0F      ; dialog panel: black bg
0013B8r 3               
0013B8r 3               EDITUI_STATUS_ROW = EDITUI_SCREEN_ROWS - 1
0013B8r 3               ; Dirty marker ('*') cell on the menu bar (right side). The title is drawn just
0013B8r 3               ; to its left; toggling the marker is a single-cell write.
0013B8r 3               EDITUI_DIRTY_COL  = EDITUI_SCREEN_COLS - 2
0013B8r 3               
0013B8r 3               EDITUI_BOX_SINGLE = $00
0013B8r 3               EDITUI_BOX_DOUBLE = $01
0013B8r 3               
0013B8r 3               ; CP437 box-drawing characters from Nova's default font.
0013B8r 3               EDITUI_CH_SINGLE_TL = $DA
0013B8r 3               EDITUI_CH_SINGLE_TR = $BF
0013B8r 3               EDITUI_CH_SINGLE_BL = $C0
0013B8r 3               EDITUI_CH_SINGLE_BR = $D9
0013B8r 3               EDITUI_CH_SINGLE_H  = $C4
0013B8r 3               EDITUI_CH_SINGLE_V  = $B3
0013B8r 3               EDITUI_CH_SINGLE_TITLE_L = $B4
0013B8r 3               EDITUI_CH_SINGLE_TITLE_R = $C3
0013B8r 3               EDITUI_CH_DOUBLE_TL = $C9
0013B8r 3               EDITUI_CH_DOUBLE_TR = $BB
0013B8r 3               EDITUI_CH_DOUBLE_BL = $C8
0013B8r 3               EDITUI_CH_DOUBLE_BR = $BC
0013B8r 3               EDITUI_CH_DOUBLE_H  = $CD
0013B8r 3               EDITUI_CH_DOUBLE_V  = $BA
0013B8r 3               EDITUI_CH_DOUBLE_TITLE_L = $B9
0013B8r 3               EDITUI_CH_DOUBLE_TITLE_R = $CC
0013B8r 3               EDITUI_CH_DOT       = $FA
0013B8r 3               
0013B8r 3               EDITUI_KEY_BACKSPACE = $08
0013B8r 3               EDITUI_KEY_TAB       = $09
0013B8r 3               EDITUI_KEY_ENTER     = $0D
0013B8r 3               EDITUI_KEY_ESC       = $1B
0013B8r 3               EDITUI_KEY_LEFT      = $1C
0013B8r 3               EDITUI_KEY_RIGHT     = $1D
0013B8r 3               EDITUI_KEY_UP        = $1E
0013B8r 3               EDITUI_KEY_DOWN      = $1F
0013B8r 3               EDITUI_KEY_DELETE    = $7F
0013B8r 3               EDITUI_KEY_ALT_PREFIX = EDITUI_KEY_ESC
