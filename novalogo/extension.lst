000000r 3               
000000r 3               ; Host RNG result byte aliases. FIO.CMD_RNG returns little-endian bytes here.
000000r 3               ; @label FIO.RNG0
000000r 3               ; @kind u8
000000r 3               ; @symbol FIO_RNG0
