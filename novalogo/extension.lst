000000r 4               .ifndef SYS_REGA
000000r 4               SYS_REGA          = $E7
000000r 4               .endif
000000r 4               ; @label SYS.REGX
000000r 4               ; @kind u8
000000r 4               ; @symbol SYS_REGX
000000r 4               ; @summary Returned X register from the most recent SYS call.
