00260Dr 2  AD rr rr           LDA   EB_SELSTARTL
002610r 2  8D rr rr           STA   EB_SCRATCHL
002613r 2  AD rr rr           LDA   EB_SELSTARTH
002616r 2  8D rr rr           STA   EB_SCRATCHH
002619r 2  20 rr rr           JSR   editbuf_src_from_scratch
00261Cr 2  A2 00              LDX   #0                    ; clip index (<=256)
00261Er 2               @cl:
00261Er 2  EC rr rr           CPX   EDITBUF_CLIPLENL
002621r 2  D0 05              BNE   :+
002623r 2  AD rr rr           LDA   EDITBUF_CLIPLENH
