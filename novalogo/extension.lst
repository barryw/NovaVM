000C6Ar 3               ; @label VSPRITE.DSTSTRH
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_DSTSTRH
000C6Ar 3               ; @summary High byte of the destination row stride.
000C6Ar 3               .global VSPRITE_DSTSTRH
000C6Ar 3               ; @label VSPRITE.BGSPACE
000C6Ar 3               ; @kind u8
000C6Ar 3               ; @symbol VSPRITE_BGSPACE
000C6Ar 3               ; @summary Blitter memory space for the saved-background buffer. Use BLT_SPACE_CPU for normal RAM buffers.
