0024BFr 2  E8                 INX
0024C0r 2  C8                 INY
0024C1r 2  C0 05              CPY   #5
0024C3r 2  90 D4              BCC   @rn_div
0024C5r 2               
0024C5r 2                     ; Write digits suppressing leading zeros
0024C5r 2  A0 00              LDY   #0                     ; suppress flag
0024C7r 2  A2 00              LDX   #0
0024C9r 2               @rn_print:
0024C9r 2  BD rr rr           LDA   pn_buf,X
0024CCr 2  D0 04              BNE   @rn_nonzero
0024CEr 2  C0 00              CPY   #0
0024D0r 2  F0 0D              BEQ   @rn_skip
0024D2r 2               @rn_nonzero:
0024D2r 2  A0 01              LDY   #1
0024D4r 2  09 30              ORA   #'0'
0024D6r 2  DA                 PHX
0024D7r 2  A6 rr              LDX   z:buf_idx
0024D9r 2  9D rr rr           STA   input_buf,X
0024DCr 2  E6 rr              INC   z:buf_idx
0024DEr 2  FA                 PLX
0024DFr 2               @rn_skip:
0024DFr 2  E8                 INX
0024E0r 2  E0 04              CPX   #4
0024E2r 2  90 E5              BCC   @rn_print
0024E4r 2                     ; Always write ones digit
0024E4r 2  AD rr rr           LDA   pn_buf+4
0024E7r 2  09 30              ORA   #'0'
0024E9r 2  A6 rr              LDX   z:buf_idx
0024EBr 2  9D rr rr           STA   input_buf,X
0024EEr 2  E6 rr              INC   z:buf_idx
0024F0r 2               
0024F0r 2                     ; Fractional part
0024F0r 2  A5 rr              LDA   eval_val_frac
0024F2r 2  D0 01              BNE   @rn_has_frac
0024F4r 2  60                 RTS
0024F5r 2               @rn_has_frac:
0024F5r 2                     ; Write '.'
0024F5r 2  A6 rr              LDX   z:buf_idx
0024F7r 2  A9 2E              LDA   #'.'
0024F9r 2  9D rr rr           STA   input_buf,X
0024FCr 2  E6 rr              INC   z:buf_idx
0024FEr 2                     ; First frac digit
0024FEr 2  A5 rr              LDA   eval_val_frac
002500r 2  8D rr rr           STA   num_tmp_lo
002503r 2  9C rr rr           STZ   num_tmp_hi
002506r 2  AD rr rr           LDA   num_tmp_lo
002509r 2  0A                 ASL
00250Ar 2  8D rr rr           STA   num_val_lo
00250Dr 2  AD rr rr           LDA   num_tmp_hi
002510r 2  2A                 ROL
002511r 2  8D rr rr           STA   num_val_hi
002514r 2  0E rr rr           ASL   num_val_lo
002517r 2  2E rr rr           ROL   num_val_hi
00251Ar 2  0E rr rr           ASL   num_val_lo
00251Dr 2  2E rr rr           ROL   num_val_hi
002520r 2  18                 CLC
002521r 2  AD rr rr           LDA   num_tmp_lo
002524r 2  0A                 ASL
002525r 2  6D rr rr           ADC   num_val_lo
002528r 2  8D rr rr           STA   num_val_lo
00252Br 2  AD rr rr           LDA   num_tmp_hi
00252Er 2  2A                 ROL
00252Fr 2  6D rr rr           ADC   num_val_hi
002532r 2  8D rr rr           STA   num_val_hi
002535r 2                     ; High byte = digit
002535r 2  AD rr rr           LDA   num_val_hi
002538r 2  09 30              ORA   #'0'
00253Ar 2  A6 rr              LDX   z:buf_idx
00253Cr 2  9D rr rr           STA   input_buf,X
00253Fr 2  E6 rr              INC   z:buf_idx
002541r 2                     ; Second frac digit
002541r 2  AD rr rr           LDA   num_val_lo
002544r 2  8D rr rr           STA   num_tmp_lo
002547r 2  9C rr rr           STZ   num_tmp_hi
00254Ar 2  AD rr rr           LDA   num_tmp_lo
00254Dr 2  0A                 ASL
00254Er 2  8D rr rr           STA   num_val_lo
002551r 2  AD rr rr           LDA   num_tmp_hi
002554r 2  2A                 ROL
002555r 2  8D rr rr           STA   num_val_hi
002558r 2  0E rr rr           ASL   num_val_lo
00255Br 2  2E rr rr           ROL   num_val_hi
00255Er 2  0E rr rr           ASL   num_val_lo
002561r 2  2E rr rr           ROL   num_val_hi
002564r 2  18                 CLC
002565r 2  AD rr rr           LDA   num_tmp_lo
002568r 2  0A                 ASL
002569r 2  6D rr rr           ADC   num_val_lo
00256Cr 2  8D rr rr           STA   num_val_lo
00256Fr 2  AD rr rr           LDA   num_tmp_hi
002572r 2  2A                 ROL
002573r 2  6D rr rr           ADC   num_val_hi
002576r 2  8D rr rr           STA   num_val_hi
002579r 2  AD rr rr           LDA   num_val_hi
00257Cr 2  F0 09              BEQ   @rn_done                ; skip trailing zero
00257Er 2  09 30              ORA   #'0'
002580r 2  A6 rr              LDX   z:buf_idx
002582r 2  9D rr rr           STA   input_buf,X
002585r 2  E6 rr              INC   z:buf_idx
002587r 2               @rn_done:
