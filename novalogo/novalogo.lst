002282r 2  A5 rr              LDA   ptr_hi
002284r 2  9D 03 01           STA   $0103,X
002287r 2  A5 rr              LDA   ptr_lo
002289r 2  9D 02 01           STA   $0102,X
00228Cr 2  A9 00              LDA   #0
00228Er 2  9D 01 01           STA   $0101,X
002291r 2               
