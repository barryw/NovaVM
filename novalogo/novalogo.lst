00319Dr 2               
00319Dr 2  AA                 TAX
00319Er 2  F0 3C              BEQ   @erase_match            ; both empty = match
0031A0r 2  A0 00              LDY   #0
0031A2r 2               @ecmp:
0031A2r 2  DA                 PHX
0031A3r 2  5A                 PHY
0031A4r 2  A5 rr              LDA   var_name_lo
0031A6r 2  85 rr              STA   ptr_lo
0031A8r 2  A5 rr              LDA   var_name_hi
0031AAr 2  85 rr              STA   ptr_hi
0031ACr 2  C8                 INY
0031ADr 2  B1 rr              LDA   (ptr_lo),Y             ; search char
0031AFr 2  85 rr              STA   proc_rec_off
0031B1r 2               
0031B1r 2  7A                 PLY
0031B2r 2  A5 rr              LDA   proc_entry_lo
0031B4r 2  85 rr              STA   ptr_lo
0031B6r 2  A5 rr              LDA   proc_entry_hi
0031B8r 2  85 rr              STA   ptr_hi
0031BAr 2  5A                 PHY
0031BBr 2  98                 TYA
0031BCr 2  18                 CLC
0031BDr 2  69 03              ADC   #3
0031BFr 2  A8                 TAY
0031C0r 2  B1 rr              LDA   (ptr_lo),Y             ; record char
0031C2r 2  7A                 PLY
0031C3r 2  C5 rr              CMP   proc_rec_off
0031C5r 2  D0 07              BNE   @ecmp_ne
0031C7r 2  FA                 PLX
0031C8r 2  C8                 INY
0031C9r 2  CA                 DEX
0031CAr 2  D0 D6              BNE   @ecmp
0031CCr 2  80 0E              BRA   @erase_match
0031CEr 2               
0031CEr 2               @ecmp_ne:
0031CEr 2  FA                 PLX
0031CFr 2               
0031CFr 2               @erase_next:
0031CFr 2                     ; prev = &current->next (proc_entry + 0)
0031CFr 2  A5 rr              LDA   proc_entry_lo
0031D1r 2  85 rr              STA   proc_ptr_lo
0031D3r 2  A5 rr              LDA   proc_entry_hi
0031D5r 2  85 rr              STA   proc_ptr_hi
0031D7r 2                     ; current = current->next
0031D7r 2  20 rr rr           JSR   proc_next
0031DAr 2  80 9A              BRA   @walk
0031DCr 2               
0031DCr 2               @erase_match:
0031DCr 2                     ; Unlink: prev->next = current->next  (read current->next once)
0031DCr 2  A5 rr              LDA   proc_entry_lo
0031DEr 2  85 rr              STA   ptr_lo
0031E0r 2  A5 rr              LDA   proc_entry_hi
0031E2r 2  85 rr              STA   ptr_hi
0031E4r 2  A0 00              LDY   #0
0031E6r 2  B1 rr              LDA   (ptr_lo),Y             ; next_lo -> X
0031E8r 2  AA                 TAX
0031E9r 2  C8                 INY
0031EAr 2  B1 rr              LDA   (ptr_lo),Y             ; next_hi -> stack
0031ECr 2  48                 PHA
0031EDr 2  A5 rr              LDA   proc_ptr_lo            ; ptr = prev
0031EFr 2  85 rr              STA   ptr_lo
0031F1r 2  A5 rr              LDA   proc_ptr_hi
0031F3r 2  85 rr              STA   ptr_hi
0031F5r 2  A0 00              LDY   #0
0031F7r 2  8A                 TXA
0031F8r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_lo = next_lo
0031FAr 2  C8                 INY
0031FBr 2  68                 PLA
0031FCr 2  91 rr              STA   (ptr_lo),Y             ; prev->next_hi = next_hi
