002320r 2               ; ---------------------------------------------------------------------
002320r 2               ; do_run — RUN list: evaluate a list as Logo code
002320r 2               ;   Arity 0: evaluates its own argument
002320r 2               ;
002320r 2               ;   Strategy: convert list to text in input_buf, then save evaluator
002320r 2               ;   state, tokenize_line + eval_line, restore state.
002320r 2               ; ---------------------------------------------------------------------
002320r 2               do_run:
002320r 2  20 rr rr           JSR   eval_expr
002323r 2  90 03              BCC   :+
002325r 2  4C rr rr           JMP   @err
002328r 2               :
002328r 2  A5 rr              LDA   eval_type
00232Ar 2  C9 02              CMP   #VAL_LIST
00232Cr 2  D0 43              BNE   @err_type
00232Er 2               
00232Er 2                     ; Save eval_cur on stack (we'll resume here after RUN)
00232Er 2  A5 rr              LDA   eval_cur_lo
002330r 2  48                 PHA
002331r 2  A5 rr              LDA   eval_cur_hi
002333r 2  48                 PHA
002334r 2               
002334r 2                     ; Render the list into input_buf as text
002334r 2                     ; eval_val_lo/hi = list head
002334r 2  64 rr              STZ   z:buf_idx               ; reset write position
002336r 2  20 rr rr           JSR   render_list_to_buf
002339r 2               
002339r 2                     ; Null-terminate input_buf
002339r 2  A6 rr              LDX   z:buf_idx
00233Br 2  9E rr rr           STZ   input_buf,X
00233Er 2               
00233Er 2                     ; Save tokenizer and eval state (same pattern as proc_invoke)
00233Er 2  A5 rr              LDA   tok_head_lo
002340r 2  48                 PHA
002341r 2  A5 rr              LDA   tok_head_hi
002343r 2  48                 PHA
002344r 2  A5 rr              LDA   tok_tail_lo
002346r 2  48                 PHA
002347r 2  A5 rr              LDA   tok_tail_hi
002349r 2  48                 PHA
00234Ar 2  A5 rr              LDA   eval_in_body
00234Cr 2  48                 PHA
00234Dr 2  A5 rr              LDA   eval_reporter
00234Fr 2  48                 PHA
002350r 2               
002350r 2                     ; Tokenize the reconstructed line
002350r 2  20 rr rr           JSR   tokenize_line
002353r 2               
002353r 2                     ; Evaluate it
002353r 2  20 rr rr           JSR   eval_line
002356r 2               
002356r 2                     ; Restore tokenizer/eval state
002356r 2  68                 PLA
002357r 2  85 rr              STA   eval_reporter
002359r 2  68                 PLA
00235Ar 2  85 rr              STA   eval_in_body
00235Cr 2  68                 PLA
00235Dr 2  85 rr              STA   tok_tail_hi
00235Fr 2  68                 PLA
002360r 2  85 rr              STA   tok_tail_lo
002362r 2  68                 PLA
002363r 2  85 rr              STA   tok_head_hi
002365r 2  68                 PLA
002366r 2  85 rr              STA   tok_head_lo
002368r 2               
002368r 2                     ; Restore eval_cur
002368r 2  68                 PLA
002369r 2  85 rr              STA   eval_cur_hi
00236Br 2  68                 PLA
00236Cr 2  85 rr              STA   eval_cur_lo
00236Er 2               
00236Er 2  4C rr rr           JMP   eval_continue
002371r 2               
002371r 2               @err_type:
002371r 2  A2 rr              LDX   #<str_run_name
002373r 2  A0 rr              LDY   #>str_run_name
002375r 2  4C rr rr           JMP   err_needs_list
002378r 2               @err:
002378r 2  A2 rr              LDX   #<str_run_name
