00225Ar 2  A0 01              LDY   #CONS_CAR_TYPE
00225Cr 2  91 rr              STA   (ptr_lo),Y
00225Er 2  BD 03 01           LDA   $0103,X                 ; second hi
002261r 2  A0 02              LDY   #CONS_CAR_HI
002263r 2  91 rr              STA   (ptr_lo),Y
002265r 2  BD 02 01           LDA   $0102,X                 ; second lo
002268r 2  A0 03              LDY   #CONS_CAR_LO
00226Ar 2  91 rr              STA   (ptr_lo),Y
00226Cr 2  BD 01 01           LDA   $0101,X                 ; second frac
00226Fr 2  A0 04              LDY   #CONS_CAR_FRAC
002271r 2  91 rr              STA   (ptr_lo),Y
002273r 2  A0 05              LDY   #CONS_CDR_LO
002275r 2  A9 00              LDA   #0
002277r 2  91 rr              STA   (ptr_lo),Y
002279r 2  A0 06              LDY   #CONS_CDR_HI
00227Br 2  91 rr              STA   (ptr_lo),Y
00227Dr 2                     ; Update second value on stack
00227Dr 2  A9 02              LDA   #VAL_LIST
