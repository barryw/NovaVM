000196r 2  68                 PLA
000197r 2  48                 PHA
000198r 2  A0 03              LDY   #TOK_PAYLOAD
00019Ar 2  91 rr              STA   (ptr_lo),Y
00019Cr 2                     ; copy chars with uppercasing
00019Cr 2  68                 PLA
00019Dr 2  AA                 TAX                        ; X = remaining
00019Er 2  A0 04              LDY   #TOK_PAYLOAD+1       ; Y = dest offset
0001A0r 2  9C rr rr           STZ   num_tmp_lo           ; source offset from tok_src
0001A3r 2               @copy:
0001A3r 2  DA                 PHX
0001A4r 2  AD rr rr           LDA   num_tmp_lo
0001A7r 2  18                 CLC
0001A8r 2  65 rr              ADC   tok_src
0001AAr 2  AA                 TAX
0001ABr 2  BD rr rr           LDA   input_buf,X
0001AEr 2  C9 61              CMP   #'a'
0001B0r 2  90 07              BCC   @noup
0001B2r 2  C9 7B              CMP   #'z'+1
0001B4r 2  B0 03              BCS   @noup
0001B6r 2  38                 SEC
0001B7r 2  E9 20              SBC   #$20
0001B9r 2               @noup:
0001B9r 2  91 rr              STA   (ptr_lo),Y
