002EB6r 2               @po_param_done:
002EB6r 2  84 rr              STY   proc_rec_off
002EB8r 2  FA                 PLX
002EB9r 2  CA                 DEX
002EBAr 2  D0 D4              BNE   @po_param
002EBCr 2               
002EBCr 2               @po_header_done:
002EBCr 2  20 rr rr           JSR   eval_newline
002EBFr 2               
002EBFr 2                     ; Read body_len
002EBFr 2  A5 rr              LDA   proc_entry_lo
002EC1r 2  85 rr              STA   ptr_lo
002EC3r 2  A5 rr              LDA   proc_entry_hi
002EC5r 2  85 rr              STA   ptr_hi
002EC7r 2  A4 rr              LDY   proc_rec_off
002EC9r 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_lo
002ECBr 2  85 rr              STA   proc_body_len_lo
002ECDr 2  C8                 INY
002ECEr 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_hi
002ED0r 2  85 rr              STA   proc_body_len_hi
002ED2r 2  C8                 INY                           ; Y = offset to body text
002ED3r 2               
002ED3r 2                     ; Compute absolute pointer to body
002ED3r 2  84 rr              STY   proc_rec_off
002ED5r 2  18                 CLC
002ED6r 2  A5 rr              LDA   proc_entry_lo
002ED8r 2  65 rr              ADC   proc_rec_off
002EDAr 2  85 rr              STA   proc_ptr_lo
002EDCr 2  A5 rr              LDA   proc_entry_hi
002EDEr 2  69 00              ADC   #0
002EE0r 2  85 rr              STA   proc_ptr_hi
002EE2r 2               
002EE2r 2                     ; Print body text, converting $0A to CR+LF
002EE2r 2               @po_body:
002EE2r 2  A5 rr              LDA   proc_body_len_lo
002EE4r 2  05 rr              ORA   proc_body_len_hi
002EE6r 2  F0 20              BEQ   @po_end
002EE8r 2               
002EE8r 2  A0 00              LDY   #0
002EEAr 2  B1 rr              LDA   (proc_ptr_lo),Y
002EECr 2  C9 0A              CMP   #$0A
002EEEr 2  D0 05              BNE   @po_char
002EF0r 2  20 rr rr           JSR   eval_newline
002EF3r 2  80 03              BRA   @po_advance
002EF5r 2               @po_char:
002EF5r 2  8D 0E A0           STA   VGC_CHAROUT
002EF8r 2               @po_advance:
002EF8r 2  E6 rr              INC   proc_ptr_lo
002EFAr 2  D0 02              BNE   :+
002EFCr 2  E6 rr              INC   proc_ptr_hi
002EFEr 2  A5 rr        :     LDA   proc_body_len_lo
002F00r 2  D0 02              BNE   :+
002F02r 2  C6 rr              DEC   proc_body_len_hi
002F04r 2  C6 rr        :     DEC   proc_body_len_lo
002F06r 2  80 DA              BRA   @po_body
002F08r 2               
002F08r 2               @po_end:
002F08r 2                     ; Print "END"
002F08r 2  A9 45              LDA   #'E'
002F0Ar 2  8D 0E A0           STA   VGC_CHAROUT
002F0Dr 2  A9 4E              LDA   #'N'
002F0Fr 2  8D 0E A0           STA   VGC_CHAROUT
002F12r 2  A9 44              LDA   #'D'
002F14r 2  8D 0E A0           STA   VGC_CHAROUT
002F17r 2  20 rr rr           JSR   eval_newline
002F1Ar 2  4C rr rr           JMP   eval_continue
002F1Dr 2               
002F1Dr 2               @err:
002F1Dr 2  A2 rr              LDX   #<str_po_err
002F1Fr 2  A0 rr              LDY   #>str_po_err
002F21r 2  4C rr rr           JMP   list_print_err
002F24r 2               @err_notfound:
002F24r 2  A2 rr              LDX   #<str_idk
002F26r 2  A0 rr              LDY   #>str_idk
002F28r 2  4C rr rr           JMP   list_print_err
002F2Br 2               
002F2Br 2               ; ---------------------------------------------------------------------
002F2Br 2               ; do_erase — ERASE "name: remove procedure from directory
002F2Br 2               ;   Arity 0 — evaluates its own argument
002F2Br 2               ; ---------------------------------------------------------------------
002F2Br 2               do_erase:
002F2Br 2  20 rr rr           JSR   eval_expr
002F2Er 2  90 03              BCC   @er_type_ok
002F30r 2  4C rr rr           JMP   @err
002F33r 2               @er_type_ok:
002F33r 2  A5 rr              LDA   eval_type
002F35r 2  C9 01              CMP   #VAL_WORD
002F37r 2  F0 03              BEQ   @er_word_ok
002F39r 2  4C rr rr           JMP   @err
002F3Cr 2               @er_word_ok:
002F3Cr 2               
002F3Cr 2                     ; Save name pointer
002F3Cr 2  A5 rr              LDA   eval_val_lo
002F3Er 2  85 rr              STA   var_name_lo
002F40r 2  A5 rr              LDA   eval_val_hi
002F42r 2  85 rr              STA   var_name_hi
002F44r 2               
002F44r 2                     ; Walk proc_head with prev tracking
002F44r 2                     ; prev = address of "next" pointer to patch (starts as &proc_head)
002F44r 2  A9 rr              LDA   #<proc_head_lo
002F46r 2  85 rr              STA   proc_ptr_lo             ; prev_ptr_lo
002F48r 2  A9 rr              LDA   #>proc_head_lo
002F4Ar 2  85 rr              STA   proc_ptr_hi             ; prev_ptr_hi (ZP, so high byte = 0)
002F4Cr 2               
002F4Cr 2  A5 rr              LDA   proc_head_lo
002F4Er 2  85 rr              STA   proc_entry_lo
002F50r 2  A5 rr              LDA   proc_head_hi
002F52r 2  85 rr              STA   proc_entry_hi
002F54r 2               
002F54r 2               @walk:
002F54r 2  A5 rr              LDA   proc_entry_lo
002F56r 2  05 rr              ORA   proc_entry_hi
002F58r 2  D0 03              BNE   @walk_ok
002F5Ar 2  4C rr rr           JMP   @not_found
002F5Dr 2               @walk_ok:
002F5Dr 2               
002F5Dr 2                     ; Compare name
002F5Dr 2  A5 rr              LDA   var_name_lo
002F5Fr 2  85 rr              STA   ptr_lo
002F61r 2  A5 rr              LDA   var_name_hi
002F63r 2  85 rr              STA   ptr_hi
002F65r 2  A0 00              LDY   #0
002F67r 2  B1 rr              LDA   (ptr_lo),Y             ; search name len
002F69r 2  85 rr              STA   proc_name_len
002F6Br 2               
002F6Br 2  A5 rr              LDA   proc_entry_lo
002F6Dr 2  85 rr              STA   ptr_lo
002F6Fr 2  A5 rr              LDA   proc_entry_hi
002F71r 2  85 rr              STA   ptr_hi
002F73r 2  A0 02              LDY   #2
002F75r 2  B1 rr              LDA   (ptr_lo),Y             ; record name len
002F77r 2  C5 rr              CMP   proc_name_len
002F79r 2  D0 32              BNE   @erase_next
002F7Br 2               
002F7Br 2  AA                 TAX
002F7Cr 2  F0 4D              BEQ   @erase_match            ; both empty = match
002F7Er 2  A0 00              LDY   #0
002F80r 2               @ecmp:
002F80r 2  DA                 PHX
002F81r 2  5A                 PHY
002F82r 2  A5 rr              LDA   var_name_lo
002F84r 2  85 rr              STA   ptr_lo
002F86r 2  A5 rr              LDA   var_name_hi
002F88r 2  85 rr              STA   ptr_hi
002F8Ar 2  C8                 INY
002F8Br 2  B1 rr              LDA   (ptr_lo),Y             ; search char
002F8Dr 2  85 rr              STA   proc_rec_off
002F8Fr 2               
002F8Fr 2  7A                 PLY
002F90r 2  A5 rr              LDA   proc_entry_lo
002F92r 2  85 rr              STA   ptr_lo
002F94r 2  A5 rr              LDA   proc_entry_hi
002F96r 2  85 rr              STA   ptr_hi
002F98r 2  5A                 PHY
002F99r 2  98                 TYA
002F9Ar 2  18                 CLC
002F9Br 2  69 03              ADC   #3
002F9Dr 2  A8                 TAY
002F9Er 2  B1 rr              LDA   (ptr_lo),Y             ; record char
002FA0r 2  7A                 PLY
002FA1r 2  C5 rr              CMP   proc_rec_off
002FA3r 2  D0 07              BNE   @ecmp_ne
002FA5r 2  FA                 PLX
002FA6r 2  C8                 INY
002FA7r 2  CA                 DEX
002FA8r 2  D0 D6              BNE   @ecmp
002FAAr 2  80 1F              BRA   @erase_match
002FACr 2               
002FACr 2               @ecmp_ne:
002FACr 2  FA                 PLX
002FADr 2               
002FADr 2               @erase_next:
002FADr 2                     ; prev = &current->next (proc_entry + 0)
002FADr 2  A5 rr              LDA   proc_entry_lo
002FAFr 2  85 rr              STA   proc_ptr_lo
002FB1r 2  A5 rr              LDA   proc_entry_hi
002FB3r 2  85 rr              STA   proc_ptr_hi
002FB5r 2                     ; current = current->next
002FB5r 2  A5 rr              LDA   proc_entry_lo
002FB7r 2  85 rr              STA   ptr_lo
002FB9r 2  A5 rr              LDA   proc_entry_hi
002FBBr 2  85 rr              STA   ptr_hi
002FBDr 2  A0 00              LDY   #0
002FBFr 2  B1 rr              LDA   (ptr_lo),Y
002FC1r 2  AA                 TAX
002FC2r 2  C8                 INY
002FC3r 2  B1 rr              LDA   (ptr_lo),Y
002FC5r 2  85 rr              STA   proc_entry_hi
002FC7r 2  86 rr              STX   proc_entry_lo
002FC9r 2  80 89              BRA   @walk
002FCBr 2               
002FCBr 2               @erase_match:
002FCBr 2                     ; Unlink: *prev = current->next
002FCBr 2                     ; Read current->next
002FCBr 2  A5 rr              LDA   proc_entry_lo
002FCDr 2  85 rr              STA   ptr_lo
002FCFr 2  A5 rr              LDA   proc_entry_hi
002FD1r 2  85 rr              STA   ptr_hi
002FD3r 2  A0 00              LDY   #0
002FD5r 2  B1 rr              LDA   (ptr_lo),Y             ; next_lo
002FD7r 2  AA                 TAX
002FD8r 2  C8                 INY
002FD9r 2  B1 rr              LDA   (ptr_lo),Y             ; next_hi
002FDBr 2               
002FDBr 2                     ; Write to prev
002FDBr 2  A0 00              LDY   #0
002FDDr 2  A5 rr              LDA   proc_ptr_lo
002FDFr 2  85 rr              STA   ptr_lo
002FE1r 2  A5 rr              LDA   proc_ptr_hi
002FE3r 2  85 rr              STA   ptr_hi
002FE5r 2  8A                 TXA
002FE6r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_lo = next_lo
002FE8r 2  C8                 INY
002FE9r 2  A5 rr              LDA   proc_entry_lo
002FEBr 2  85 rr              STA   ptr_lo
002FEDr 2  A5 rr              LDA   proc_entry_hi
002FEFr 2  85 rr              STA   ptr_hi
002FF1r 2  A0 01              LDY   #1
002FF3r 2  B1 rr              LDA   (ptr_lo),Y             ; re-read next_hi
002FF5r 2  A0 01              LDY   #1
002FF7r 2  A5 rr              LDA   proc_ptr_lo
002FF9r 2  85 rr              STA   ptr_lo
002FFBr 2  A5 rr              LDA   proc_ptr_hi
002FFDr 2  85 rr              STA   ptr_hi
002FFFr 2  A5 rr              LDA   proc_entry_lo
003001r 2  85 rr              STA   ptr2_lo
003003r 2  A5 rr              LDA   proc_entry_hi
003005r 2  85 rr              STA   ptr2_hi
003007r 2  A0 01              LDY   #1
003009r 2  B1 rr              LDA   (ptr2_lo),Y            ; next_hi
00300Br 2  91 rr              STA   (ptr_lo),Y             ; prev->next_hi = next_hi
00300Dr 2               
00300Dr 2  4C rr rr           JMP   eval_continue
003010r 2               
003010r 2               @not_found:
003010r 2  A2 rr              LDX   #<str_idk
