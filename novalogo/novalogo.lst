0024DBr 2  09 30              ORA   #'0'
0024DDr 2  A6 rr              LDX   z:buf_idx
0024DFr 2  9D rr rr           STA   input_buf,X
0024E2r 2  E6 rr              INC   z:buf_idx
0024E4r 2               
0024E4r 2                     ; Fractional part
0024E4r 2  A5 rr              LDA   eval_val_frac
0024E6r 2  D0 01              BNE   @rn_has_frac
0024E8r 2  60                 RTS
0024E9r 2               @rn_has_frac:
0024E9r 2                     ; Write '.'
0024E9r 2  A6 rr              LDX   z:buf_idx
0024EBr 2  A9 2E              LDA   #'.'
0024EDr 2  9D rr rr           STA   input_buf,X
0024F0r 2  E6 rr              INC   z:buf_idx
0024F2r 2                     ; First frac digit
0024F2r 2  A5 rr              LDA   eval_val_frac
0024F4r 2  8D rr rr           STA   num_tmp_lo
0024F7r 2  9C rr rr           STZ   num_tmp_hi
0024FAr 2  AD rr rr           LDA   num_tmp_lo
0024FDr 2  0A                 ASL
0024FEr 2  8D rr rr           STA   num_val_lo
002501r 2  AD rr rr           LDA   num_tmp_hi
002504r 2  2A                 ROL
002505r 2  8D rr rr           STA   num_val_hi
002508r 2  0E rr rr           ASL   num_val_lo
00250Br 2  2E rr rr           ROL   num_val_hi
00250Er 2  0E rr rr           ASL   num_val_lo
002511r 2  2E rr rr           ROL   num_val_hi
002514r 2  18                 CLC
002515r 2  AD rr rr           LDA   num_tmp_lo
002518r 2  0A                 ASL
002519r 2  6D rr rr           ADC   num_val_lo
00251Cr 2  8D rr rr           STA   num_val_lo
00251Fr 2  AD rr rr           LDA   num_tmp_hi
002522r 2  2A                 ROL
002523r 2  6D rr rr           ADC   num_val_hi
002526r 2  8D rr rr           STA   num_val_hi
002529r 2                     ; High byte = digit
002529r 2  AD rr rr           LDA   num_val_hi
00252Cr 2  09 30              ORA   #'0'
00252Er 2  A6 rr              LDX   z:buf_idx
002530r 2  9D rr rr           STA   input_buf,X
002533r 2  E6 rr              INC   z:buf_idx
002535r 2                     ; Second frac digit
002535r 2  AD rr rr           LDA   num_val_lo
002538r 2  8D rr rr           STA   num_tmp_lo
00253Br 2  9C rr rr           STZ   num_tmp_hi
00253Er 2  AD rr rr           LDA   num_tmp_lo
002541r 2  0A                 ASL
002542r 2  8D rr rr           STA   num_val_lo
002545r 2  AD rr rr           LDA   num_tmp_hi
002548r 2  2A                 ROL
002549r 2  8D rr rr           STA   num_val_hi
00254Cr 2  0E rr rr           ASL   num_val_lo
00254Fr 2  2E rr rr           ROL   num_val_hi
002552r 2  0E rr rr           ASL   num_val_lo
002555r 2  2E rr rr           ROL   num_val_hi
002558r 2  18                 CLC
002559r 2  AD rr rr           LDA   num_tmp_lo
00255Cr 2  0A                 ASL
00255Dr 2  6D rr rr           ADC   num_val_lo
002560r 2  8D rr rr           STA   num_val_lo
002563r 2  AD rr rr           LDA   num_tmp_hi
002566r 2  2A                 ROL
002567r 2  6D rr rr           ADC   num_val_hi
00256Ar 2  8D rr rr           STA   num_val_hi
00256Dr 2  AD rr rr           LDA   num_val_hi
002570r 2  F0 09              BEQ   @rn_done                ; skip trailing zero
002572r 2  09 30              ORA   #'0'
002574r 2  A6 rr              LDX   z:buf_idx
002576r 2  9D rr rr           STA   input_buf,X
002579r 2  E6 rr              INC   z:buf_idx
00257Br 2               @rn_done:
