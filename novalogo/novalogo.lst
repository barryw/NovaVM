002CFEr 2  8D rr rr           STA   param_name_tmp        ; length byte
002D01r 2  AA                 TAX                         ; X = char count
002D02r 2  A9 00              LDA   #0
002D04r 2  85 rr              STA   proc_name_len         ; dest offset in param_name_tmp
002D06r 2               @bind_ch:
002D06r 2  E0 00              CPX   #0
002D08r 2  F0 0F              BEQ   @bind_ch_done
002D0Ar 2  C8                 INY
002D0Br 2  B1 rr              LDA   (ptr_lo),Y
002D0Dr 2  DA                 PHX
002D0Er 2  A6 rr              LDX   proc_name_len
002D10r 2  9D rr rr           STA   param_name_tmp+1,X
002D13r 2  E6 rr              INC   proc_name_len
002D15r 2  FA                 PLX
002D16r 2  CA                 DEX
002D17r 2  80 ED              BRA   @bind_ch
002D19r 2               @bind_ch_done:
002D19r 2                     ; Advance proc_rec_off past this param
002D19r 2  C8                 INY
