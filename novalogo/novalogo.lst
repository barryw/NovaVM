001DFDr 2               
001DFDr 2                     ; Follow cdr
001DFDr 2  A5 rr              LDA   list_ptr_lo
001DFFr 2  85 rr              STA   ptr_lo
001E01r 2  A5 rr              LDA   list_ptr_hi
001E03r 2  85 rr              STA   ptr_hi
