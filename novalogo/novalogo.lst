0001D7r 2  20 rr rr           JSR   is_word_char
0001DAr 2  90 04              BCC   @counted
0001DCr 2  E8                 INX
0001DDr 2  C8                 INY
0001DEr 2  80 F4              BRA   @count
0001E0r 2               @counted:
0001E0r 2  98                 TYA
0001E1r 2  F0 53              BEQ   @empty
