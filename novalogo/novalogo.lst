001DF3r 2  C6 rr              DEC   list_count_hi
001DF5r 2  C6 rr        :     DEC   list_count_lo
001DF7r 2               
001DF7r 2  A5 rr              LDA   list_count_lo
001DF9r 2  05 rr              ORA   list_count_hi
