0020DBr 2  BD 07 01           LDA   $0107,X                 ; first hi
0020DEr 2  A0 02              LDY   #CONS_CAR_HI
0020E0r 2  91 rr              STA   (ptr_lo),Y
0020E2r 2  BD 06 01           LDA   $0106,X                 ; first lo
0020E5r 2  A0 03              LDY   #CONS_CAR_LO
0020E7r 2  91 rr              STA   (ptr_lo),Y
0020E9r 2  BD 05 01           LDA   $0105,X                 ; first frac
0020ECr 2  A0 04              LDY   #CONS_CAR_FRAC
0020EEr 2  91 rr              STA   (ptr_lo),Y
0020F0r 2  A0 05              LDY   #CONS_CDR_LO
0020F2r 2  A9 00              LDA   #0
0020F4r 2  91 rr              STA   (ptr_lo),Y
0020F6r 2  A0 06              LDY   #CONS_CDR_HI
