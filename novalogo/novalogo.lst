00317Cr 2               
00317Cr 2               ; ---------------------------------------------------------------------
00317Cr 2               ; do_apply — APPLY "proc [args]: call procedure with args from list
00317Cr 2               ;   Arity 0 — evaluates its own arguments
00317Cr 2               ;   Strategy: build "name arg1 arg2 ..." in input_buf, tokenize+eval.
00317Cr 2               ; ---------------------------------------------------------------------
00317Cr 2               do_apply:
00317Cr 2                     ; Evaluate first arg: procedure name (quoted word)
00317Cr 2  20 rr rr           JSR   eval_expr
00317Fr 2  90 03              BCC   @ap_type_ok
003181r 2  4C rr rr           JMP   @err
003184r 2               @ap_type_ok:
003184r 2  A5 rr              LDA   eval_type
003186r 2  C9 01              CMP   #VAL_WORD
003188r 2  F0 03              BEQ   @ap_word_ok
00318Ar 2  4C rr rr           JMP   @err
00318Dr 2               @ap_word_ok:
00318Dr 2               
00318Dr 2                     ; Copy proc name to input_buf
00318Dr 2  A5 rr              LDA   eval_val_lo
00318Fr 2  85 rr              STA   ptr_lo
003191r 2  A5 rr              LDA   eval_val_hi
003193r 2  85 rr              STA   ptr_hi
003195r 2  64 rr              STZ   z:buf_idx
003197r 2  A0 00              LDY   #0
003199r 2  B1 rr              LDA   (ptr_lo),Y             ; name length
00319Br 2  AA                 TAX
00319Cr 2  F0 10              BEQ   @apply_args
00319Er 2  C8                 INY
00319Fr 2               @apply_name:
00319Fr 2  B1 rr              LDA   (ptr_lo),Y
0031A1r 2  5A                 PHY
0031A2r 2  A4 rr              LDY   z:buf_idx
0031A4r 2  99 rr rr           STA   input_buf,Y
0031A7r 2  E6 rr              INC   z:buf_idx
0031A9r 2  7A                 PLY
0031AAr 2  C8                 INY
0031ABr 2  CA                 DEX
0031ACr 2  D0 F1              BNE   @apply_name
0031AEr 2               
0031AEr 2               @apply_args:
0031AEr 2                     ; Evaluate second arg: list of arguments
0031AEr 2  20 rr rr           JSR   eval_expr
0031B1r 2  B0 5B              BCS   @err
0031B3r 2  A5 rr              LDA   eval_type
0031B5r 2  C9 02              CMP   #VAL_LIST
0031B7r 2  D0 55              BNE   @err
0031B9r 2               
0031B9r 2                     ; Render list elements to input_buf (after name)
0031B9r 2                     ; eval_val_lo/hi = list head
0031B9r 2  A5 rr              LDA   eval_val_lo
0031BBr 2  05 rr              ORA   eval_val_hi
0031BDr 2  F0 11              BEQ   @apply_run              ; empty arg list, just run name
0031BFr 2               
0031BFr 2                     ; Use render_list_to_buf — it prepends space before elements
0031BFr 2                     ; but we need a space before the first arg too
0031BFr 2  A5 rr              LDA   z:buf_idx
0031C1r 2  C9 7E              CMP   #126
0031C3r 2  B0 0B              BCS   @apply_run
0031C5r 2  A8                 TAY
0031C6r 2  A9 20              LDA   #' '
0031C8r 2  99 rr rr           STA   input_buf,Y
0031CBr 2  E6 rr              INC   z:buf_idx
0031CDr 2               
0031CDr 2                     ; render_list_to_buf expects eval_val set
0031CDr 2  20 rr rr           JSR   render_list_to_buf
0031D0r 2               
0031D0r 2               @apply_run:
0031D0r 2                     ; Null-terminate
0031D0r 2  A6 rr              LDX   z:buf_idx
0031D2r 2  9E rr rr           STZ   input_buf,X
0031D5r 2               
0031D5r 2                     ; Save eval state and tokenize+eval (same pattern as do_run)
0031D5r 2  A5 rr              LDA   eval_cur_lo
0031D7r 2  48                 PHA
0031D8r 2  A5 rr              LDA   eval_cur_hi
0031DAr 2  48                 PHA
0031DBr 2  A5 rr              LDA   tok_head_lo
0031DDr 2  48                 PHA
0031DEr 2  A5 rr              LDA   tok_head_hi
0031E0r 2  48                 PHA
0031E1r 2  A5 rr              LDA   tok_tail_lo
0031E3r 2  48                 PHA
0031E4r 2  A5 rr              LDA   tok_tail_hi
0031E6r 2  48                 PHA
0031E7r 2  A5 rr              LDA   eval_in_body
0031E9r 2  48                 PHA
0031EAr 2  A5 rr              LDA   eval_reporter
0031ECr 2  48                 PHA
0031EDr 2               
0031EDr 2  20 rr rr           JSR   tokenize_line
0031F0r 2  20 rr rr           JSR   eval_line
0031F3r 2               
0031F3r 2  68                 PLA
0031F4r 2  85 rr              STA   eval_reporter
0031F6r 2  68                 PLA
0031F7r 2  85 rr              STA   eval_in_body
0031F9r 2  68                 PLA
0031FAr 2  85 rr              STA   tok_tail_hi
0031FCr 2  68                 PLA
0031FDr 2  85 rr              STA   tok_tail_lo
0031FFr 2  68                 PLA
003200r 2  85 rr              STA   tok_head_hi
003202r 2  68                 PLA
003203r 2  85 rr              STA   tok_head_lo
003205r 2  68                 PLA
003206r 2  85 rr              STA   eval_cur_hi
003208r 2  68                 PLA
003209r 2  85 rr              STA   eval_cur_lo
00320Br 2               
00320Br 2  4C rr rr           JMP   eval_continue
00320Er 2               
00320Er 2               @err:
00320Er 2  A2 rr              LDX   #<str_apply_err
003210r 2  A0 rr              LDY   #>str_apply_err
003212r 2  4C rr rr           JMP   list_print_err
003215r 2               
003215r 2               ; =====================================================================
003215r 2               ; RODATA — procedure strings
003215r 2               ; =====================================================================
003215r 2                     .segment "RODATA"
00091Br 2               
00091Br 2               str_po_err:
00091Br 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO PO", 0
00091Fr 2  45 4E 4F 55  
000923r 2  47 48 20 49  
000933r 2               
000933r 2               str_erase_err:
000933r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO ERASE", 0
000937r 2  45 4E 4F 55  
00093Br 2  47 48 20 49  
00094Er 2               
00094Er 2               str_apply_err:
