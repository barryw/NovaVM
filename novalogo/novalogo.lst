002228r 2  A9 02              LDA   #VAL_LIST
00222Ar 2  9D 08 01           STA   $0108,X                 ; type = list
00222Dr 2  A5 rr              LDA   ptr_hi
00222Fr 2  9D 07 01           STA   $0107,X                 ; hi = ptr_hi
002232r 2  A5 rr              LDA   ptr_lo
002234r 2  9D 06 01           STA   $0106,X                 ; lo = ptr_lo
002237r 2  A9 00              LDA   #0
002239r 2  9D 05 01           STA   $0105,X                 ; frac = 0
00223Cr 2               
00223Cr 2               @first_is_list:
00223Cr 2                     ; Process second arg: if not list, wrap it
00223Cr 2  BA                 TSX
