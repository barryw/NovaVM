001E54r 2  90 03              BCC   :+
001E56r 2  4C rr rr           JMP   @err
001E59r 2               :
001E59r 2                     ; Save search value on stack (type + 3 value bytes)
001E59r 2  A5 rr              LDA   eval_val_frac
001E5Br 2  48                 PHA
001E5Cr 2  A5 rr              LDA   eval_val_lo
001E5Er 2  48                 PHA
