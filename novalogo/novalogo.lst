0002BAr 2               str_ext_wait:
0002BAr 2  04 57 41 49        .byte 4, "WAIT"
0002BEr 2  54           
0002BFr 2               str_ext_waitvbl:
0002BFr 2  07 57 41 49        .byte 7, "WAITVBL"
0002C3r 2  54 56 42 4C  
0002C7r 2               str_ext_timer:
0002C7r 2  05 54 49 4D        .byte 5, "TIMER"
0002CBr 2  45 52        
0002CDr 2               
0002CDr 2                     .segment "RODATA"
0002CDr 2               
0002CDr 2               str_idk:
0002CDr 2  49 20 44 4F        .byte "I DON'T KNOW HOW TO ", 0
0002D1r 2  4E 27 54 20  
0002D5r 2  4B 4E 4F 57  
0002E2r 2               
0002E2r 2               str_notenough:
0002E2r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS", 0
0002E6r 2  45 4E 4F 55  
0002EAr 2  47 48 20 49  
0002F4r 2               
0002F4r 2               str_no_value:
0002F4r 2  20 48 41 53        .byte " HAS NO VALUE", 0
0002F8r 2  20 4E 4F 20  
0002FCr 2  56 41 4C 55  
000302r 2               
000302r 2               str_error_tag:
000302r 2  05 45 52 52        .byte 5, "ERROR"
000306r 2  4F 52        
000308r 2               
000308r 2               str_catch_notag:
000308r 2  43 41 4E 27        .byte "CAN'T FIND CATCH TAG ", 0
00030Cr 2  54 20 46 49  
000310r 2  4E 44 20 43  
00031Er 2               
00031Er 2               ; Powers of 10 table (16-bit): 10000, 1000, 100, 10, 1
00031Er 2               pow10_lo:
00031Er 2  10 E8 64 0A        .byte <10000, <1000, <100, <10, <1
000322r 2  01           
000323r 2               pow10_hi:
000323r 2  27 03 00 00        .byte >10000, >1000, >100, >10, >1
000327r 2  00           
000328r 2               
000328r 1                     .include "builtins.s"
000328r 2               ; builtins.s — built-in command table and handlers
000328r 2               
000328r 2               ; =====================================================================
000328r 2               ; CODE segment — builtin lookup and handlers
000328r 2               ; =====================================================================
000328r 2                     .segment "CODE"
000BF1r 2               
000BF1r 2               ; ---------------------------------------------------------------------
000BF1r 2               ; lookup_builtin — search builtin table for the current TOK_WORD
000BF1r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000BF1r 2               ;   Output: Carry clear = found, ptr2_lo/hi = handler addr, A = arity
000BF1r 2               ;           Carry set = not found
000BF1r 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000BF1r 2               ; ---------------------------------------------------------------------
000BF1r 2               lookup_builtin:
000BF1r 2                     ; Save table pointer in num_tmp_lo/hi
000BF1r 2  A9 rr              LDA   #<builtin_table
000BF3r 2  8D rr rr           STA   num_tmp_lo
000BF6r 2  A9 rr              LDA   #>builtin_table
000BF8r 2  8D rr rr           STA   num_tmp_hi
000BFBr 2               
000BFBr 2               @scan:
000BFBr 2                     ; Read name pointer from table
000BFBr 2  AD rr rr           LDA   num_tmp_lo
000BFEr 2  85 rr              STA   ptr2_lo
000C00r 2  AD rr rr           LDA   num_tmp_hi
000C03r 2  85 rr              STA   ptr2_hi
000C05r 2  A0 00              LDY   #0
000C07r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000C09r 2  AA                 TAX
000C0Ar 2  C8                 INY
000C0Br 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000C0Dr 2  D0 06              BNE   @have_entry
000C0Fr 2  E0 00              CPX   #0
000C11r 2  D0 02              BNE   @have_entry
000C13r 2                     ; Null pointer — end of table
000C13r 2  38                 SEC
000C14r 2  60                 RTS
000C15r 2               
000C15r 2               @have_entry:
000C15r 2                     ; X = name_ptr_lo, A = name_ptr_hi
000C15r 2                     ; Compare the table name against the token payload
000C15r 2                     ; Token payload: at eval_cur + TOK_PAYLOAD = length byte + chars
000C15r 2  85 rr              STA   ptr2_hi
000C17r 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000C19r 2               
000C19r 2                     ; Get token payload pointer
000C19r 2  A5 rr              LDA   eval_cur_lo
000C1Br 2  85 rr              STA   ptr_lo
000C1Dr 2  A5 rr              LDA   eval_cur_hi
000C1Fr 2  85 rr              STA   ptr_hi
000C21r 2               
000C21r 2                     ; Compare length bytes
000C21r 2  A0 00              LDY   #0
000C23r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000C25r 2  A0 03              LDY   #TOK_PAYLOAD
000C27r 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000C29r 2  D0 45              BNE   @next
000C2Br 2               
000C2Br 2                     ; Lengths match — compare chars
000C2Br 2  AA                 TAX                       ; X = length
000C2Cr 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000C2Er 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000C30r 2               @cmp_loop:
000C30r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000C32r 2  5A                 PHY
000C33r 2                     ; Compute token char offset: TOK_PAYLOAD + 1 + tok_sign
000C33r 2  A5 rr              LDA   tok_sign
000C35r 2  18                 CLC
000C36r 2  69 04              ADC   #TOK_PAYLOAD+1
000C38r 2  A8                 TAY
000C39r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000C3Br 2  7A                 PLY
000C3Cr 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000C3Er 2  D0 30              BNE   @next
000C40r 2  C8                 INY
000C41r 2  E6 rr              INC   tok_sign
000C43r 2  CA                 DEX
000C44r 2  D0 EA              BNE   @cmp_loop
000C46r 2               
000C46r 2                     ; Match found — read handler address and arity
000C46r 2                     ; Table entry: name_ptr(2) + handler_addr(2) + arity(1)
000C46r 2                     ; handler is at table_base + 2, arity at table_base + 4
000C46r 2  AD rr rr           LDA   num_tmp_lo
000C49r 2  85 rr              STA   ptr2_lo
000C4Br 2  AD rr rr           LDA   num_tmp_hi
000C4Er 2  85 rr              STA   ptr2_hi
000C50r 2  A0 02              LDY   #2
000C52r 2  B1 rr              LDA   (ptr2_lo),Y        ; handler low
000C54r 2  AA                 TAX
000C55r 2  C8                 INY
000C56r 2  B1 rr              LDA   (ptr2_lo),Y        ; handler high
000C58r 2  85 rr              STA   ptr2_hi
000C5Ar 2  86 rr              STX   ptr2_lo             ; ptr2 = handler address
000C5Cr 2  A0 04              LDY   #4
000C5Er 2  B1 rr              LDA   (ptr2_lo),Y        ; — wrong, we already overwrote ptr2
000C60r 2                     ; Fix: re-read arity from table using num_tmp as base
000C60r 2  AD rr rr           LDA   num_tmp_lo
000C63r 2  85 rr              STA   ptr_lo
000C65r 2  AD rr rr           LDA   num_tmp_hi
000C68r 2  85 rr              STA   ptr_hi
000C6Ar 2  A0 04              LDY   #4
000C6Cr 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000C6Er 2  18                 CLC                       ; found
000C6Fr 2  60                 RTS
000C70r 2               
000C70r 2               @next:
000C70r 2  64 rr              STZ   tok_sign            ; reset comparison counter
000C72r 2                     ; Advance to next entry: +5 bytes (2 name + 2 handler + 1 arity)
000C72r 2  18                 CLC
000C73r 2  AD rr rr           LDA   num_tmp_lo
000C76r 2  69 05              ADC   #5
000C78r 2  8D rr rr           STA   num_tmp_lo
000C7Br 2  90 03              BCC   @next2
000C7Dr 2  EE rr rr           INC   num_tmp_hi
000C80r 2               @next2:
000C80r 2  4C rr rr           JMP   @scan
000C83r 2               
000C83r 2               ; ---------------------------------------------------------------------
000C83r 2               ; do_print — PRINT <expr>: evaluate arg and print with newline
000C83r 2               ;   Entry: eval_val/eval_type already set with the argument
000C83r 2               ;   Must JMP to eval_continue when done
000C83r 2               ; ---------------------------------------------------------------------
000C83r 2               do_print:
000C83r 2  A5 rr              LDA   eval_type
000C85r 2  C9 02              CMP   #VAL_LIST
000C87r 2  F0 0D              BEQ   @list
000C89r 2  C9 01              CMP   #VAL_WORD
000C8Br 2  F0 12              BEQ   @word
000C8Dr 2               
000C8Dr 2                     ; Print number
000C8Dr 2  20 rr rr           JSR   print_number
000C90r 2  20 rr rr           JSR   eval_newline
000C93r 2  4C rr rr           JMP   eval_continue
000C96r 2               
000C96r 2               @list:
000C96r 2  20 rr rr           JSR   print_list
000C99r 2  20 rr rr           JSR   eval_newline
000C9Cr 2  4C rr rr           JMP   eval_continue
000C9Fr 2               
000C9Fr 2               @word:
000C9Fr 2                     ; Print quoted word — eval_val_lo/hi points at length+chars
000C9Fr 2  A5 rr              LDA   eval_val_lo
000CA1r 2  85 rr              STA   ptr_lo
000CA3r 2  A5 rr              LDA   eval_val_hi
000CA5r 2  85 rr              STA   ptr_hi
000CA7r 2  A0 00              LDY   #0
000CA9r 2  B1 rr              LDA   (ptr_lo),Y         ; length
000CABr 2  AA                 TAX
000CACr 2  C8                 INY
000CADr 2               @wch:
000CADr 2  B1 rr              LDA   (ptr_lo),Y
000CAFr 2  8D 0E A0           STA   VGC_CHAROUT
000CB2r 2  C8                 INY
000CB3r 2  CA                 DEX
000CB4r 2  D0 F7              BNE   @wch
000CB6r 2  20 rr rr           JSR   eval_newline
000CB9r 2  4C rr rr           JMP   eval_continue
000CBCr 2               
000CBCr 2               ; ---------------------------------------------------------------------
000CBCr 2               ; do_type — TYPE <expr>: like PRINT but no newline
000CBCr 2               ; ---------------------------------------------------------------------
000CBCr 2               do_type:
000CBCr 2  A5 rr              LDA   eval_type
000CBEr 2  C9 02              CMP   #VAL_LIST
000CC0r 2  F0 0A              BEQ   @list
000CC2r 2  C9 01              CMP   #VAL_WORD
000CC4r 2  F0 0C              BEQ   @word
000CC6r 2               
000CC6r 2                     ; Print number (no newline)
000CC6r 2  20 rr rr           JSR   print_number
000CC9r 2  4C rr rr           JMP   eval_continue
000CCCr 2               
000CCCr 2               @list:
000CCCr 2  20 rr rr           JSR   print_list
000CCFr 2  4C rr rr           JMP   eval_continue
000CD2r 2               
000CD2r 2               @word:
000CD2r 2  A5 rr              LDA   eval_val_lo
000CD4r 2  85 rr              STA   ptr_lo
000CD6r 2  A5 rr              LDA   eval_val_hi
000CD8r 2  85 rr              STA   ptr_hi
000CDAr 2  A0 00              LDY   #0
000CDCr 2  B1 rr              LDA   (ptr_lo),Y
000CDEr 2  AA                 TAX
000CDFr 2  C8                 INY
000CE0r 2               @wch:
000CE0r 2  B1 rr              LDA   (ptr_lo),Y
000CE2r 2  8D 0E A0           STA   VGC_CHAROUT
000CE5r 2  C8                 INY
000CE6r 2  CA                 DEX
000CE7r 2  D0 F7              BNE   @wch
000CE9r 2  4C rr rr           JMP   eval_continue
000CECr 2               
000CECr 2               ; ---------------------------------------------------------------------
000CECr 2               ; do_make — MAKE "name value: store a variable
000CECr 2               ;   Arity 0 — we do our own argument evaluation
000CECr 2               ;   1. eval_expr → name (must be TOK_QUOTE → word type)
000CECr 2               ;   2. save name pointer
000CECr 2               ;   3. eval_expr → value
000CECr 2               ;   4. var_set(saved name, current value)
000CECr 2               ; ---------------------------------------------------------------------
000CECr 2               do_make:
000CECr 2                     ; Evaluate first argument: the name (a quoted word)
000CECr 2  20 rr rr           JSR   eval_expr
000CEFr 2  B0 1F              BCS   @err
000CF1r 2               
000CF1r 2                     ; Must be a word (type $01)
000CF1r 2  A5 rr              LDA   eval_type
000CF3r 2  C9 01              CMP   #$01
000CF5r 2  D0 19              BNE   @err
000CF7r 2               
000CF7r 2                     ; Save the name pointer (points into token payload: len + chars)
000CF7r 2  A5 rr              LDA   eval_val_lo
000CF9r 2  48                 PHA
000CFAr 2  A5 rr              LDA   eval_val_hi
000CFCr 2  48                 PHA
000CFDr 2               
000CFDr 2                     ; Evaluate second argument: the value
000CFDr 2  20 rr rr           JSR   eval_expr
000D00r 2  B0 0C              BCS   @err_pop
000D02r 2               
000D02r 2                     ; Set up ptr_lo/hi → saved name, eval_val holds value
000D02r 2  68                 PLA
000D03r 2  85 rr              STA   ptr_hi
000D05r 2  68                 PLA
000D06r 2  85 rr              STA   ptr_lo
000D08r 2               
000D08r 2  20 rr rr           JSR   var_set
000D0Br 2  4C rr rr           JMP   eval_continue
000D0Er 2               
000D0Er 2               @err_pop:
000D0Er 2  68                 PLA
000D0Fr 2  68                 PLA
000D10r 2               @err:
000D10r 2                     ; Print error
000D10r 2  A2 00              LDX   #0
000D12r 2               @ep:
000D12r 2  BD rr rr           LDA   str_make_err,X
000D15r 2  F0 06              BEQ   @ep_done
000D17r 2  8D 0E A0           STA   VGC_CHAROUT
000D1Ar 2  E8                 INX
000D1Br 2  D0 F5              BNE   @ep
000D1Dr 2               @ep_done:
000D1Dr 2  20 rr rr           JSR   eval_newline
000D20r 2  4C rr rr           JMP   eval_continue
000D23r 2               
000D23r 2               ; ---------------------------------------------------------------------
000D23r 2               ; do_repeat — REPEAT count [body]
000D23r 2               ;   Arity 0 — handles its own argument parsing
000D23r 2               ;   1. Evaluate count expression
000D23r 2               ;   2. Locate the bracketed body [...]
000D23r 2               ;   3. Execute the body count times
000D23r 2               ;   4. Resume after the closing ]
000D23r 2               ;
000D23r 2               ;   Nesting: saves/restores repeat state (body_start, body_resume,
000D23r 2               ;   repeat_count, eval_in_body) on the hardware stack so nested
000D23r 2               ;   REPEAT works correctly.
000D23r 2               ; ---------------------------------------------------------------------
000D23r 2               
000D23r 2                     .segment "ZEROPAGE"
000021r 2  xx           repeat_count_lo:  .res 1
000022r 2  xx           repeat_count_hi:  .res 1
000023r 2  xx           body_start_lo:    .res 1       ; first token after [
000024r 2  xx           body_start_hi:    .res 1
000025r 2  xx           body_resume_lo:   .res 1       ; token after ]
000026r 2  xx           body_resume_hi:   .res 1
000027r 2  xx           repcount:         .res 1       ; 1-based REPCOUNT within REPEAT loop
000028r 2  xx           for_cur_lo:       .res 1       ; FOR loop current value low
000029r 2  xx           for_cur_hi:       .res 1       ; FOR loop current value high
00002Ar 2  xx           for_end_lo:       .res 1       ; FOR loop end value low
00002Br 2  xx           for_end_hi:       .res 1       ; FOR loop end value high
00002Cr 2  xx           cond_start_lo:    .res 1       ; WHILE/UNTIL condition start low
00002Dr 2  xx           cond_start_hi:    .res 1       ; WHILE/UNTIL condition start high
00002Er 2               
00002Er 2                     .segment "CODE"
000D23r 2               
000D23r 2               do_repeat:
000D23r 2                     ; --- Evaluate the count argument ---
000D23r 2  20 rr rr           JSR   eval_expr
000D26r 2  90 03              BCC   @count_ok
000D28r 2  4C rr rr           JMP   @err_args             ; carry set = no token
000D2Br 2               @count_ok:
000D2Br 2                     ; Count must be a number
000D2Br 2  A5 rr              LDA   eval_type
000D2Dr 2  F0 03              BEQ   @type_ok
000D2Fr 2  4C rr rr           JMP   @err_args
000D32r 2               @type_ok:
000D32r 2               
000D32r 2                     ; --- Save outer repeat state for nesting ---
000D32r 2  A5 rr              LDA   repcount
000D34r 2  48                 PHA
000D35r 2  A5 rr              LDA   repeat_count_lo
000D37r 2  48                 PHA
000D38r 2  A5 rr              LDA   repeat_count_hi
000D3Ar 2  48                 PHA
000D3Br 2  A5 rr              LDA   body_start_lo
000D3Dr 2  48                 PHA
000D3Er 2  A5 rr              LDA   body_start_hi
000D40r 2  48                 PHA
000D41r 2  A5 rr              LDA   body_resume_lo
000D43r 2  48                 PHA
000D44r 2  A5 rr              LDA   body_resume_hi
000D46r 2  48                 PHA
000D47r 2  A5 rr              LDA   eval_in_body
000D49r 2  48                 PHA
000D4Ar 2               
000D4Ar 2                     ; Store count (integer part only, clamped to 0 if negative)
000D4Ar 2  A5 rr              LDA   eval_val_hi
000D4Cr 2  30 08              BMI   @zero_count           ; negative = treat as 0
000D4Er 2  85 rr              STA   repeat_count_hi
000D50r 2  A5 rr              LDA   eval_val_lo
000D52r 2  85 rr              STA   repeat_count_lo
000D54r 2  80 04              BRA   @find_body
000D56r 2               
000D56r 2               @zero_count:
000D56r 2  64 rr              STZ   repeat_count_lo
000D58r 2  64 rr              STZ   repeat_count_hi
000D5Ar 2               
000D5Ar 2               @find_body:
000D5Ar 2                     ; --- Current token must be TOK_LBRACKET ---
000D5Ar 2  A5 rr              LDA   eval_cur_lo
000D5Cr 2  05 rr              ORA   eval_cur_hi
000D5Er 2  D0 03              BNE   @have_tok
000D60r 2  4C rr rr           JMP   @err_bracket_pop
000D63r 2               @have_tok:
000D63r 2  A5 rr              LDA   eval_cur_lo
000D65r 2  85 rr              STA   ptr_lo
000D67r 2  A5 rr              LDA   eval_cur_hi
000D69r 2  85 rr              STA   ptr_hi
000D6Br 2  A0 00              LDY   #TOK_TAG
000D6Dr 2  B1 rr              LDA   (ptr_lo),Y
000D6Fr 2  C9 03              CMP   #TOK_LBRACKET
000D71r 2  F0 03              BEQ   @is_bracket
000D73r 2  4C rr rr           JMP   @err_bracket_pop
000D76r 2               @is_bracket:
000D76r 2               
000D76r 2                     ; Advance past the [
000D76r 2  20 rr rr           JSR   eval_advance
000D79r 2               
000D79r 2                     ; Save body start (first token after [)
000D79r 2  A5 rr              LDA   eval_cur_lo
000D7Br 2  85 rr              STA   body_start_lo
000D7Dr 2  A5 rr              LDA   eval_cur_hi
000D7Fr 2  85 rr              STA   body_start_hi
000D81r 2               
000D81r 2                     ; --- Scan forward to find the matching ] ---
000D81r 2  A2 01              LDX   #1                    ; depth (we've consumed the [)
000D83r 2               @scan:
000D83r 2  A5 rr              LDA   eval_cur_lo
000D85r 2  05 rr              ORA   eval_cur_hi
000D87r 2  D0 03              BNE   @scan_ok
000D89r 2  4C rr rr           JMP   @err_bracket_pop
000D8Cr 2               @scan_ok:
000D8Cr 2  A5 rr              LDA   eval_cur_lo
000D8Er 2  85 rr              STA   ptr_lo
000D90r 2  A5 rr              LDA   eval_cur_hi
000D92r 2  85 rr              STA   ptr_hi
000D94r 2  A0 00              LDY   #TOK_TAG
000D96r 2  B1 rr              LDA   (ptr_lo),Y
000D98r 2               
000D98r 2  C9 03              CMP   #TOK_LBRACKET
000D9Ar 2  D0 03              BNE   @scan_not_lb
000D9Cr 2  E8                 INX
000D9Dr 2  80 07              BRA   @scan_next
000D9Fr 2               @scan_not_lb:
000D9Fr 2  C9 04              CMP   #TOK_RBRACKET
000DA1r 2  D0 03              BNE   @scan_next
000DA3r 2  CA                 DEX
000DA4r 2  F0 07              BEQ   @scan_found           ; depth == 0, found matching ]
000DA6r 2               @scan_next:
000DA6r 2  DA                 PHX                        ; save depth across eval_advance
000DA7r 2  20 rr rr           JSR   eval_advance
000DAAr 2  FA                 PLX
000DABr 2  80 D6              BRA   @scan
000DADr 2               
000DADr 2               @scan_found:
000DADr 2                     ; eval_cur is at the matching ]. Save resume point (token after ]).
000DADr 2  20 rr rr           JSR   eval_advance
000DB0r 2  A5 rr              LDA   eval_cur_lo
000DB2r 2  85 rr              STA   body_resume_lo
000DB4r 2  A5 rr              LDA   eval_cur_hi
000DB6r 2  85 rr              STA   body_resume_hi
000DB8r 2               
000DB8r 2                     ; --- Initialize repcount and execute the body repeat_count times ---
000DB8r 2  A9 01              LDA   #1
000DBAr 2  85 rr              STA   repcount
000DBCr 2               @loop:
000DBCr 2                     ; Check if STOP/OUTPUT was signaled
000DBCr 2  A5 rr              LDA   proc_stopped
000DBEr 2  D0 27              BNE   @loop_done
000DC0r 2               
000DC0r 2                     ; Check if count is zero
000DC0r 2  A5 rr              LDA   repeat_count_lo
000DC2r 2  05 rr              ORA   repeat_count_hi
000DC4r 2  F0 21              BEQ   @loop_done
000DC6r 2               
000DC6r 2                     ; Set eval_cur to body start
000DC6r 2  A5 rr              LDA   body_start_lo
000DC8r 2  85 rr              STA   eval_cur_lo
000DCAr 2  A5 rr              LDA   body_start_hi
000DCCr 2  85 rr              STA   eval_cur_hi
000DCEr 2               
000DCEr 2                     ; Set body mode and call eval_body
000DCEr 2  A9 01              LDA   #$01
000DD0r 2  85 rr              STA   eval_in_body
000DD2r 2  20 rr rr           JSR   eval_body
000DD5r 2               
000DD5r 2                     ; Increment repcount (capped at 255)
000DD5r 2  A5 rr              LDA   repcount
000DD7r 2  C9 FF              CMP   #$FF
000DD9r 2  B0 02              BCS   :+
000DDBr 2  E6 rr              INC   repcount
000DDDr 2               :
000DDDr 2                     ; Decrement count (16-bit)
000DDDr 2  A5 rr              LDA   repeat_count_lo
000DDFr 2  D0 02              BNE   @dec_lo
000DE1r 2  C6 rr              DEC   repeat_count_hi
000DE3r 2               @dec_lo:
000DE3r 2  C6 rr              DEC   repeat_count_lo
000DE5r 2  80 D5              BRA   @loop
000DE7r 2               
000DE7r 2               @loop_done:
000DE7r 2                     ; Resume past THIS REPEAT's ] BEFORE restoring outer state — restore pops
000DE7r 2                     ; body_resume back to the enclosing REPEAT's value, so reading it after the
000DE7r 2                     ; restore would resume at the wrong token (trailing commands never run).
000DE7r 2  A5 rr              LDA   body_resume_lo
000DE9r 2  85 rr              STA   eval_cur_lo
000DEBr 2  A5 rr              LDA   body_resume_hi
000DEDr 2  85 rr              STA   eval_cur_hi
000DEFr 2                     ; --- Restore outer state ---
000DEFr 2  20 rr rr           JSR   repeat_restore_state
000DF2r 2  4C rr rr           JMP   eval_continue
000DF5r 2               
000DF5r 2               @err_bracket_pop:
