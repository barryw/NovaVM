00301Er 2               ; ---------------------------------------------------------------------
00301Er 2               ; do_apply — APPLY "proc [args]: call procedure with args from list
00301Er 2               ;   Arity 0 — evaluates its own arguments
00301Er 2               ;   Strategy: build "name arg1 arg2 ..." in input_buf, tokenize+eval.
00301Er 2               ; ---------------------------------------------------------------------
00301Er 2               do_apply:
00301Er 2                     ; Evaluate first arg: procedure name (quoted word)
00301Er 2  20 rr rr           JSR   eval_expr
003021r 2  90 03              BCC   @ap_type_ok
003023r 2  4C rr rr           JMP   @err
003026r 2               @ap_type_ok:
003026r 2  A5 rr              LDA   eval_type
003028r 2  C9 01              CMP   #VAL_WORD
00302Ar 2  F0 03              BEQ   @ap_word_ok
00302Cr 2  4C rr rr           JMP   @err
00302Fr 2               @ap_word_ok:
00302Fr 2               
00302Fr 2                     ; Copy proc name to input_buf
00302Fr 2  A5 rr              LDA   eval_val_lo
003031r 2  85 rr              STA   ptr_lo
003033r 2  A5 rr              LDA   eval_val_hi
003035r 2  85 rr              STA   ptr_hi
003037r 2  64 rr              STZ   z:buf_idx
003039r 2  A0 00              LDY   #0
00303Br 2  B1 rr              LDA   (ptr_lo),Y             ; name length
00303Dr 2  AA                 TAX
00303Er 2  F0 10              BEQ   @apply_args
003040r 2  C8                 INY
003041r 2               @apply_name:
003041r 2  B1 rr              LDA   (ptr_lo),Y
003043r 2  5A                 PHY
003044r 2  A4 rr              LDY   z:buf_idx
003046r 2  99 rr rr           STA   input_buf,Y
003049r 2  E6 rr              INC   z:buf_idx
00304Br 2  7A                 PLY
00304Cr 2  C8                 INY
00304Dr 2  CA                 DEX
00304Er 2  D0 F1              BNE   @apply_name
003050r 2               
003050r 2               @apply_args:
003050r 2                     ; Evaluate second arg: list of arguments
003050r 2  20 rr rr           JSR   eval_expr
003053r 2  B0 5B              BCS   @err
003055r 2  A5 rr              LDA   eval_type
003057r 2  C9 02              CMP   #VAL_LIST
003059r 2  D0 55              BNE   @err
00305Br 2               
00305Br 2                     ; Render list elements to input_buf (after name)
00305Br 2                     ; eval_val_lo/hi = list head
00305Br 2  A5 rr              LDA   eval_val_lo
00305Dr 2  05 rr              ORA   eval_val_hi
00305Fr 2  F0 11              BEQ   @apply_run              ; empty arg list, just run name
003061r 2               
003061r 2                     ; Use render_list_to_buf — it prepends space before elements
003061r 2                     ; but we need a space before the first arg too
003061r 2  A5 rr              LDA   z:buf_idx
003063r 2  C9 7E              CMP   #126
003065r 2  B0 0B              BCS   @apply_run
003067r 2  A8                 TAY
003068r 2  A9 20              LDA   #' '
00306Ar 2  99 rr rr           STA   input_buf,Y
00306Dr 2  E6 rr              INC   z:buf_idx
00306Fr 2               
00306Fr 2                     ; render_list_to_buf expects eval_val set
00306Fr 2  20 rr rr           JSR   render_list_to_buf
003072r 2               
003072r 2               @apply_run:
003072r 2                     ; Null-terminate
003072r 2  A6 rr              LDX   z:buf_idx
003074r 2  9E rr rr           STZ   input_buf,X
003077r 2               
003077r 2                     ; Save eval state and tokenize+eval (same pattern as do_run)
003077r 2  A5 rr              LDA   eval_cur_lo
003079r 2  48                 PHA
00307Ar 2  A5 rr              LDA   eval_cur_hi
00307Cr 2  48                 PHA
00307Dr 2  A5 rr              LDA   tok_head_lo
00307Fr 2  48                 PHA
003080r 2  A5 rr              LDA   tok_head_hi
003082r 2  48                 PHA
003083r 2  A5 rr              LDA   tok_tail_lo
003085r 2  48                 PHA
003086r 2  A5 rr              LDA   tok_tail_hi
003088r 2  48                 PHA
003089r 2  A5 rr              LDA   eval_in_body
00308Br 2  48                 PHA
00308Cr 2  A5 rr              LDA   eval_reporter
00308Er 2  48                 PHA
00308Fr 2               
00308Fr 2  20 rr rr           JSR   tokenize_line
003092r 2  20 rr rr           JSR   eval_line
003095r 2               
003095r 2  68                 PLA
003096r 2  85 rr              STA   eval_reporter
003098r 2  68                 PLA
003099r 2  85 rr              STA   eval_in_body
00309Br 2  68                 PLA
00309Cr 2  85 rr              STA   tok_tail_hi
00309Er 2  68                 PLA
00309Fr 2  85 rr              STA   tok_tail_lo
0030A1r 2  68                 PLA
0030A2r 2  85 rr              STA   tok_head_hi
0030A4r 2  68                 PLA
0030A5r 2  85 rr              STA   tok_head_lo
0030A7r 2  68                 PLA
0030A8r 2  85 rr              STA   eval_cur_hi
0030AAr 2  68                 PLA
0030ABr 2  85 rr              STA   eval_cur_lo
0030ADr 2               
0030ADr 2  4C rr rr           JMP   eval_continue
0030B0r 2               
0030B0r 2               @err:
0030B0r 2  A2 rr              LDX   #<str_apply_err
0030B2r 2  A0 rr              LDY   #>str_apply_err
0030B4r 2  4C rr rr           JMP   list_print_err
0030B7r 2               
0030B7r 2               ; =====================================================================
0030B7r 2               ; RODATA — procedure strings
0030B7r 2               ; =====================================================================
0030B7r 2                     .segment "RODATA"
0009DEr 2               
0009DEr 2               str_defined:
0009DEr 2  20 44 45 46        .byte " DEFINED", 0
0009E2r 2  49 4E 45 44  
0009E6r 2  00           
0009E7r 2               
0009E7r 2               str_to_needs_name:
0009E7r 2  54 4F 20 4E        .byte "TO NEEDS A NAME", 0
0009EBr 2  45 45 44 53  
0009EFr 2  20 41 20 4E  
0009F7r 2               
0009F7r 2               str_po_err:
0009F7r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO PO", 0
0009FBr 2  45 4E 4F 55  
0009FFr 2  47 48 20 49  
000A0Fr 2               
000A0Fr 2               str_erase_err:
000A0Fr 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO ERASE", 0
000A13r 2  45 4E 4F 55  
000A17r 2  47 48 20 49  
000A2Ar 2               
000A2Ar 2               str_apply_err:
000A2Ar 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO APPLY", 0
000A2Er 2  45 4E 4F 55  
000A32r 2  47 48 20 49  
000A45r 2               
000A45r 2               ; Builtin name strings for workspace commands
000A45r 2               str_po_name:
000A45r 2  02 50 4F           .byte 2, "PO"
000A48r 2               str_printout_name:
000A48r 2  08 50 52 49        .byte 8, "PRINTOUT"
000A4Cr 2  4E 54 4F 55  
000A50r 2  54           
000A51r 2               str_pots_name:
000A51r 2  04 50 4F 54        .byte 4, "POTS"
000A55r 2  53           
000A56r 2               str_printtitles_name:
000A56r 2  0B 50 52 49        .byte 11, "PRINTTITLES"
000A5Ar 2  4E 54 54 49  
000A5Er 2  54 4C 45 53  
000A62r 2               str_erase_name:
000A62r 2  05 45 52 41        .byte 5, "ERASE"
000A66r 2  53 45        
000A68r 2               str_apply_name:
000A68r 2  05 41 50 50        .byte 5, "APPLY"
000A6Cr 2  4C 59        
000A6Er 2               
000A6Er 1                     .include "gc.s"
000A6Er 2               ; gc.s — mark-sweep garbage collector for NovaLogo
000A6Er 2               ;
000A6Er 2               ; Allocation header (prepended by heap_alloc):
000A6Er 2               ;   +0: alloc_tag  (bit 7 = mark, bits 6-0 = type)
000A6Er 2               ;   +1: alloc_size (total size including header; 0 = use 16-bit size at +2/+3)
000A6Er 2               ;
000A6Er 2               ; Type constants (bits 6-0 of alloc_tag):
000A6Er 2               ATYPE_FREE   = $00
000A6Er 2               ATYPE_TOKEN  = $01
000A6Er 2               ATYPE_CONS   = $02
000A6Er 2               ATYPE_VAR    = $03
000A6Er 2               ATYPE_PROC   = $04
000A6Er 2               ATYPE_STRING = $05
000A6Er 2               
000A6Er 2               ; Header layout offsets (relative to allocation base, NOT payload)
000A6Er 2               GC_HDR_TAG   = 0
000A6Er 2               GC_HDR_SIZE  = 1
000A6Er 2               GC_HDR_BYTES = 2              ; overhead per allocation
000A6Er 2               
000A6Er 2               ; Mark bit
000A6Er 2               ALLOC_MARK_BIT = $80
000A6Er 2               
000A6Er 2               ; =====================================================================
000A6Er 2               ; ZEROPAGE segment — GC variables
000A6Er 2               ; =====================================================================
000A6Er 2                     .segment "ZEROPAGE"
000047r 2               
000047r 2  xx           gc_ptr_lo:    .res 1          ; GC walk pointer low
000048r 2  xx           gc_ptr_hi:    .res 1          ; GC walk pointer high
000049r 2  xx           gc_tmp_lo:    .res 1          ; GC temp low
00004Ar 2  xx           gc_tmp_hi:    .res 1          ; GC temp high
00004Br 2  xx           gc_mark_lo:   .res 1          ; node-to-mark pointer low
00004Cr 2  xx           gc_mark_hi:   .res 1          ; node-to-mark pointer high
00004Dr 2               
00004Dr 2               ; =====================================================================
00004Dr 2               ; CODE segment — GC routines
00004Dr 2               ; =====================================================================
00004Dr 2                     .segment "CODE"
0030B7r 2               
0030B7r 2               ; ---------------------------------------------------------------------
0030B7r 2               ; gc_collect — run a full mark-sweep garbage collection cycle
0030B7r 2               ;   1. Clear all mark bits
0030B7r 2               ;   2. Mark all reachable objects from roots
0030B7r 2               ;   3. Sweep: coalesce all unmarked blocks and reset heap_ptr
0030B7r 2               ;
0030B7r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_tmp, gc_mark, ptr_lo/hi, ptr2_lo/hi
0030B7r 2               ; ---------------------------------------------------------------------
0030B7r 2               gc_collect:
0030B7r 2                     ; Phase 1: Clear all mark bits by walking the heap linearly
0030B7r 2  A9 00              LDA   #<HEAP_START
0030B9r 2  85 rr              STA   gc_ptr_lo
0030BBr 2  A9 04              LDA   #>HEAP_START
0030BDr 2  85 rr              STA   gc_ptr_hi
0030BFr 2               
0030BFr 2               @clear_loop:
0030BFr 2                     ; Have we reached heap_ptr (end of allocated space)?
0030BFr 2  A5 rr              LDA   gc_ptr_hi
0030C1r 2  C5 rr              CMP   heap_ptr+1
0030C3r 2  90 08              BCC   @clear_one
0030C5r 2  D0 41              BNE   @clear_done
0030C7r 2  A5 rr              LDA   gc_ptr_lo
0030C9r 2  C5 rr              CMP   heap_ptr
0030CBr 2  B0 3B              BCS   @clear_done
0030CDr 2               
0030CDr 2               @clear_one:
0030CDr 2                     ; Clear mark bit on this allocation
0030CDr 2  A5 rr              LDA   gc_ptr_lo
0030CFr 2  85 rr              STA   ptr_lo
0030D1r 2  A5 rr              LDA   gc_ptr_hi
0030D3r 2  85 rr              STA   ptr_hi
0030D5r 2  A0 00              LDY   #GC_HDR_TAG
0030D7r 2  B1 rr              LDA   (ptr_lo),Y
0030D9r 2  29 7F              AND   #<~ALLOC_MARK_BIT    ; clear bit 7
0030DBr 2  91 rr              STA   (ptr_lo),Y
0030DDr 2               
0030DDr 2                     ; Advance by alloc_size
0030DDr 2  A0 01              LDY   #GC_HDR_SIZE
0030DFr 2  B1 rr              LDA   (ptr_lo),Y
0030E1r 2  F0 0B              BEQ   @clear_big           ; size=0 means 16-bit size at +2/+3
0030E3r 2  18                 CLC
0030E4r 2  65 rr              ADC   gc_ptr_lo
0030E6r 2  85 rr              STA   gc_ptr_lo
0030E8r 2  90 D5              BCC   @clear_loop
0030EAr 2  E6 rr              INC   gc_ptr_hi
0030ECr 2  80 D1              BRA   @clear_loop
0030EEr 2               
0030EEr 2               @clear_big:
0030EEr 2                     ; 16-bit size at payload offset 0 and 1 (header +2 and +3)
0030EEr 2  A0 02              LDY   #GC_HDR_BYTES
0030F0r 2  B1 rr              LDA   (ptr_lo),Y
0030F2r 2  85 rr              STA   gc_tmp_lo
0030F4r 2  C8                 INY
0030F5r 2  B1 rr              LDA   (ptr_lo),Y
0030F7r 2  85 rr              STA   gc_tmp_hi
0030F9r 2  18                 CLC
0030FAr 2  A5 rr              LDA   gc_ptr_lo
0030FCr 2  65 rr              ADC   gc_tmp_lo
0030FEr 2  85 rr              STA   gc_ptr_lo
003100r 2  A5 rr              LDA   gc_ptr_hi
003102r 2  65 rr              ADC   gc_tmp_hi
003104r 2  85 rr              STA   gc_ptr_hi
003106r 2  80 B7              BRA   @clear_loop
003108r 2               
003108r 2               @clear_done:
003108r 2               
003108r 2                     ; Phase 2: Mark all reachable objects
003108r 2                     ; Root 1: variable list (var_head)
003108r 2  20 rr rr           JSR   gc_mark_vars
00310Br 2               
00310Br 2                     ; Root 2: procedure list (proc_head)
00310Br 2  20 rr rr           JSR   gc_mark_procs
00310Er 2               
00310Er 2                     ; Root 3: current token list (tok_head)
00310Er 2  20 rr rr           JSR   gc_mark_token_list
003111r 2               
003111r 2                     ; Phase 3: Sweep — find the highest marked allocation,
003111r 2                     ; reset heap_ptr to just past it. This works because we
003111r 2                     ; use a bump allocator with no free list; all unmarked
003111r 2                     ; allocations between marked ones become wasted space,
003111r 2                     ; but in practice the permanent objects (vars, procs) are
003111r 2                     ; allocated early and the ephemeral ones (tokens, cons,
003111r 2                     ; strings) are allocated later and all unmarked — so
003111r 2                     ; heap_ptr shrinks back dramatically.
003111r 2                     ;
003111r 2                     ; Walk the heap forward; track the highest end-address
003111r 2                     ; of any marked allocation.
003111r 2  A9 00              LDA   #<HEAP_START
003113r 2  85 rr              STA   gc_ptr_lo
003115r 2  A9 04              LDA   #>HEAP_START
003117r 2  85 rr              STA   gc_ptr_hi
003119r 2                     ; gc_tmp = highest marked end (start at HEAP_START = nothing marked)
003119r 2  A9 00              LDA   #<HEAP_START
00311Br 2  85 rr              STA   gc_tmp_lo
00311Dr 2  A9 04              LDA   #>HEAP_START
00311Fr 2  85 rr              STA   gc_tmp_hi
003121r 2               
003121r 2               @sweep_loop:
003121r 2                     ; Reached end of allocated space?
003121r 2  A5 rr              LDA   gc_ptr_hi
003123r 2  C5 rr              CMP   heap_ptr+1
003125r 2  90 08              BCC   @sweep_one
003127r 2  D0 49              BNE   @sweep_done
003129r 2  A5 rr              LDA   gc_ptr_lo
00312Br 2  C5 rr              CMP   heap_ptr
00312Dr 2  B0 43              BCS   @sweep_done
00312Fr 2               
00312Fr 2               @sweep_one:
00312Fr 2  A5 rr              LDA   gc_ptr_lo
003131r 2  85 rr              STA   ptr_lo
003133r 2  A5 rr              LDA   gc_ptr_hi
003135r 2  85 rr              STA   ptr_hi
003137r 2               
003137r 2                     ; Get size of this allocation
003137r 2  A0 01              LDY   #GC_HDR_SIZE
003139r 2  B1 rr              LDA   (ptr_lo),Y
00313Br 2  F0 06              BEQ   @sweep_big
00313Dr 2  85 rr              STA   gc_mark_lo            ; use gc_mark_lo as temp for size
00313Fr 2  64 rr              STZ   gc_mark_hi
003141r 2  80 0B              BRA   @sweep_check_mark
003143r 2               
003143r 2               @sweep_big:
003143r 2  A0 02              LDY   #GC_HDR_BYTES
003145r 2  B1 rr              LDA   (ptr_lo),Y
003147r 2  85 rr              STA   gc_mark_lo
003149r 2  C8                 INY
00314Ar 2  B1 rr              LDA   (ptr_lo),Y
00314Cr 2  85 rr              STA   gc_mark_hi
00314Er 2               
00314Er 2               @sweep_check_mark:
00314Er 2                     ; Is this allocation marked?
00314Er 2  A0 00              LDY   #GC_HDR_TAG
003150r 2  B1 rr              LDA   (ptr_lo),Y
003152r 2  29 80              AND   #ALLOC_MARK_BIT
003154r 2  F0 0D              BEQ   @sweep_advance        ; not marked — skip
003156r 2               
003156r 2                     ; Marked — compute end address = gc_ptr + size
003156r 2  18                 CLC
003157r 2  A5 rr              LDA   gc_ptr_lo
003159r 2  65 rr              ADC   gc_mark_lo
00315Br 2  85 rr              STA   gc_tmp_lo             ; update highest end
00315Dr 2  A5 rr              LDA   gc_ptr_hi
00315Fr 2  65 rr              ADC   gc_mark_hi
003161r 2  85 rr              STA   gc_tmp_hi
003163r 2               
003163r 2               @sweep_advance:
003163r 2                     ; Advance gc_ptr by size
003163r 2  18                 CLC
003164r 2  A5 rr              LDA   gc_ptr_lo
003166r 2  65 rr              ADC   gc_mark_lo
003168r 2  85 rr              STA   gc_ptr_lo
00316Ar 2  A5 rr              LDA   gc_ptr_hi
00316Cr 2  65 rr              ADC   gc_mark_hi
00316Er 2  85 rr              STA   gc_ptr_hi
003170r 2  80 AF              BRA   @sweep_loop
003172r 2               
003172r 2               @sweep_done:
003172r 2                     ; Set heap_ptr to highest marked end
003172r 2  A5 rr              LDA   gc_tmp_lo
003174r 2  85 rr              STA   heap_ptr
003176r 2  A5 rr              LDA   gc_tmp_hi
003178r 2  85 rr              STA   heap_ptr+1
00317Ar 2  60                 RTS
00317Br 2               
00317Br 2               ; ---------------------------------------------------------------------
00317Br 2               ; gc_mark_node — mark a single allocation given a payload pointer
00317Br 2               ;   Input: gc_mark_lo/hi = pointer to payload (header is at -2)
00317Br 2               ;   If pointer is $0000 or below HEAP_START, skip.
00317Br 2               ;   Clobbers: A, Y (preserves gc_mark_lo/hi)
00317Br 2               ; ---------------------------------------------------------------------
00317Br 2               gc_mark_node:
00317Br 2                     ; Null check
00317Br 2  A5 rr              LDA   gc_mark_lo
00317Dr 2  05 rr              ORA   gc_mark_hi
00317Fr 2  F0 21              BEQ   @done
003181r 2               
003181r 2                     ; Compute header address = payload - 2
003181r 2  A5 rr              LDA   gc_mark_lo
003183r 2  38                 SEC
003184r 2  E9 02              SBC   #GC_HDR_BYTES
003186r 2  85 rr              STA   ptr_lo
003188r 2  A5 rr              LDA   gc_mark_hi
00318Ar 2  E9 00              SBC   #0
00318Cr 2  85 rr              STA   ptr_hi
00318Er 2               
00318Er 2                     ; Range check: must be >= HEAP_START
00318Er 2  C9 04              CMP   #>HEAP_START
003190r 2  90 10              BCC   @done
003192r 2  D0 06              BNE   @in_range
003194r 2  A5 rr              LDA   ptr_lo
003196r 2  C9 00              CMP   #<HEAP_START
003198r 2  90 08              BCC   @done
00319Ar 2               @in_range:
00319Ar 2               
00319Ar 2                     ; Set mark bit
00319Ar 2  A0 00              LDY   #GC_HDR_TAG
00319Cr 2  B1 rr              LDA   (ptr_lo),Y
00319Er 2  09 80              ORA   #ALLOC_MARK_BIT
0031A0r 2  91 rr              STA   (ptr_lo),Y
0031A2r 2               @done:
0031A2r 2  60                 RTS
0031A3r 2               
0031A3r 2               ; ---------------------------------------------------------------------
0031A3r 2               ; gc_mark_vars — walk the variable linked list and mark each entry
0031A3r 2               ;   Also marks any list values pointed to by variables.
0031A3r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_mark, ptr_lo/hi, ptr2_lo/hi
0031A3r 2               ; ---------------------------------------------------------------------
0031A3r 2               gc_mark_vars:
0031A3r 2  A5 rr              LDA   var_head_lo
0031A5r 2  85 rr              STA   gc_ptr_lo
0031A7r 2  A5 rr              LDA   var_head_hi
0031A9r 2  85 rr              STA   gc_ptr_hi
0031ABr 2               
0031ABr 2               @walk:
0031ABr 2  A5 rr              LDA   gc_ptr_lo
0031ADr 2  05 rr              ORA   gc_ptr_hi
0031AFr 2  D0 01              BNE   @have_var
0031B1r 2  60                 RTS
0031B2r 2               @have_var:
0031B2r 2               
0031B2r 2                     ; Mark this var entry
0031B2r 2  A5 rr              LDA   gc_ptr_lo
0031B4r 2  85 rr              STA   gc_mark_lo
0031B6r 2  A5 rr              LDA   gc_ptr_hi
0031B8r 2  85 rr              STA   gc_mark_hi
0031BAr 2  20 rr rr           JSR   gc_mark_node
0031BDr 2               
0031BDr 2                     ; Read the variable's value — if it's a list, mark the list
0031BDr 2  A5 rr              LDA   gc_ptr_lo
0031BFr 2  85 rr              STA   ptr_lo
0031C1r 2  A5 rr              LDA   gc_ptr_hi
0031C3r 2  85 rr              STA   ptr_hi
0031C5r 2  A0 02              LDY   #VAR_NAME_LEN
0031C7r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
0031C9r 2  18                 CLC
0031CAr 2  69 03              ADC   #VAR_NAME             ; offset to value_type
0031CCr 2  A8                 TAY
0031CDr 2  B1 rr              LDA   (ptr_lo),Y           ; value_type
0031CFr 2  C9 02              CMP   #VAL_LIST
0031D1r 2  D0 23              BNE   @var_check_word
0031D3r 2                     ; It's a list — get the list head pointer and mark the list
0031D3r 2  C8                 INY
0031D4r 2  B1 rr              LDA   (ptr_lo),Y           ; val_hi (actually car_hi)
0031D6r 2  85 rr              STA   gc_tmp_hi
0031D8r 2  C8                 INY
0031D9r 2  B1 rr              LDA   (ptr_lo),Y           ; val_lo
0031DBr 2  85 rr              STA   gc_tmp_lo
0031DDr 2                     ; Save gc_ptr across recursive mark
0031DDr 2  A5 rr              LDA   gc_ptr_lo
0031DFr 2  48                 PHA
0031E0r 2  A5 rr              LDA   gc_ptr_hi
0031E2r 2  48                 PHA
0031E3r 2  A5 rr              LDA   gc_tmp_lo
0031E5r 2  85 rr              STA   gc_mark_lo
0031E7r 2  A5 rr              LDA   gc_tmp_hi
0031E9r 2  85 rr              STA   gc_mark_hi
0031EBr 2  20 rr rr           JSR   gc_mark_list
0031EEr 2  68                 PLA
0031EFr 2  85 rr              STA   gc_ptr_hi
0031F1r 2  68                 PLA
0031F2r 2  85 rr              STA   gc_ptr_lo
0031F4r 2  80 25              BRA   @var_next
0031F6r 2               
0031F6r 2               @var_check_word:
0031F6r 2  C9 01              CMP   #VAL_WORD
0031F8r 2  D0 21              BNE   @var_next
0031FAr 2                     ; It's a word — mark the string allocation
0031FAr 2  C8                 INY
0031FBr 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_hi for word
0031FDr 2  85 rr              STA   gc_tmp_hi
0031FFr 2  C8                 INY
003200r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_lo for word
003202r 2  85 rr              STA   gc_tmp_lo
003204r 2  A5 rr              LDA   gc_ptr_lo
003206r 2  48                 PHA
003207r 2  A5 rr              LDA   gc_ptr_hi
003209r 2  48                 PHA
00320Ar 2  A5 rr              LDA   gc_tmp_lo
00320Cr 2  85 rr              STA   gc_mark_lo
00320Er 2  A5 rr              LDA   gc_tmp_hi
003210r 2  85 rr              STA   gc_mark_hi
003212r 2  20 rr rr           JSR   gc_mark_node
003215r 2  68                 PLA
003216r 2  85 rr              STA   gc_ptr_hi
003218r 2  68                 PLA
003219r 2  85 rr              STA   gc_ptr_lo
00321Br 2               
00321Br 2               @var_next:
00321Br 2                     ; Follow next pointer
00321Br 2  A5 rr              LDA   gc_ptr_lo
00321Dr 2  85 rr              STA   ptr_lo
00321Fr 2  A5 rr              LDA   gc_ptr_hi
003221r 2  85 rr              STA   ptr_hi
003223r 2  A0 00              LDY   #VAR_NEXT_LO
003225r 2  B1 rr              LDA   (ptr_lo),Y
003227r 2  AA                 TAX
003228r 2  C8                 INY
003229r 2  B1 rr              LDA   (ptr_lo),Y
00322Br 2  85 rr              STA   gc_ptr_hi
00322Dr 2  86 rr              STX   gc_ptr_lo
00322Fr 2  4C rr rr           JMP   @walk
003232r 2               
003232r 2               ; ---------------------------------------------------------------------
003232r 2               ; gc_mark_procs — walk the procedure list and mark each record
003232r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
003232r 2               ; ---------------------------------------------------------------------
003232r 2               gc_mark_procs:
003232r 2  A5 rr              LDA   proc_head_lo
003234r 2  85 rr              STA   gc_ptr_lo
003236r 2  A5 rr              LDA   proc_head_hi
003238r 2  85 rr              STA   gc_ptr_hi
00323Ar 2               
00323Ar 2               @walk:
00323Ar 2  A5 rr              LDA   gc_ptr_lo
00323Cr 2  05 rr              ORA   gc_ptr_hi
00323Er 2  F0 2B              BEQ   @done
003240r 2               
003240r 2                     ; Mark this procedure record.
003240r 2                     ; proc_entry points to record data (base+4); header is at base+0.
003240r 2                     ; Subtract 4 to get the header address for marking.
003240r 2  A5 rr              LDA   gc_ptr_lo
003242r 2  38                 SEC
003243r 2  E9 04              SBC   #4
003245r 2  85 rr              STA   ptr_lo
003247r 2  A5 rr              LDA   gc_ptr_hi
003249r 2  E9 00              SBC   #0
00324Br 2  85 rr              STA   ptr_hi
00324Dr 2                     ; Set mark bit directly at the header
00324Dr 2  A0 00              LDY   #GC_HDR_TAG
00324Fr 2  B1 rr              LDA   (ptr_lo),Y
003251r 2  09 80              ORA   #ALLOC_MARK_BIT
003253r 2  91 rr              STA   (ptr_lo),Y
003255r 2               
003255r 2                     ; Follow next pointer (at record data offset 0)
003255r 2  A5 rr              LDA   gc_ptr_lo
003257r 2  85 rr              STA   ptr_lo
003259r 2  A5 rr              LDA   gc_ptr_hi
00325Br 2  85 rr              STA   ptr_hi
00325Dr 2  A0 00              LDY   #0                    ; next_lo at offset 0
00325Fr 2  B1 rr              LDA   (ptr_lo),Y
003261r 2  AA                 TAX
003262r 2  C8                 INY
003263r 2  B1 rr              LDA   (ptr_lo),Y
003265r 2  85 rr              STA   gc_ptr_hi
003267r 2  86 rr              STX   gc_ptr_lo
003269r 2  80 CF              BRA   @walk
00326Br 2               
00326Br 2               @done:
00326Br 2  60                 RTS
00326Cr 2               
00326Cr 2               ; ---------------------------------------------------------------------
00326Cr 2               ; gc_mark_token_list — walk tok_head linked list and mark each token
00326Cr 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
00326Cr 2               ; ---------------------------------------------------------------------
00326Cr 2               gc_mark_token_list:
00326Cr 2  A5 rr              LDA   tok_head_lo
00326Er 2  85 rr              STA   gc_ptr_lo
003270r 2  A5 rr              LDA   tok_head_hi
003272r 2  85 rr              STA   gc_ptr_hi
003274r 2               
003274r 2               @walk:
003274r 2  A5 rr              LDA   gc_ptr_lo
003276r 2  05 rr              ORA   gc_ptr_hi
003278r 2  F0 21              BEQ   @done
00327Ar 2               
00327Ar 2                     ; Mark this token
00327Ar 2  A5 rr              LDA   gc_ptr_lo
00327Cr 2  85 rr              STA   gc_mark_lo
00327Er 2  A5 rr              LDA   gc_ptr_hi
003280r 2  85 rr              STA   gc_mark_hi
003282r 2  20 rr rr           JSR   gc_mark_node
003285r 2               
003285r 2                     ; Follow next pointer (at payload offsets TOK_NEXT_LO/HI)
003285r 2  A5 rr              LDA   gc_ptr_lo
003287r 2  85 rr              STA   ptr_lo
003289r 2  A5 rr              LDA   gc_ptr_hi
00328Br 2  85 rr              STA   ptr_hi
00328Dr 2  A0 01              LDY   #TOK_NEXT_LO
00328Fr 2  B1 rr              LDA   (ptr_lo),Y
003291r 2  AA                 TAX
003292r 2  C8                 INY
003293r 2  B1 rr              LDA   (ptr_lo),Y
003295r 2  85 rr              STA   gc_ptr_hi
003297r 2  86 rr              STX   gc_ptr_lo
003299r 2  80 D9              BRA   @walk
00329Br 2               
00329Br 2               @done:
00329Br 2  60                 RTS
00329Cr 2               
00329Cr 2               ; ---------------------------------------------------------------------
00329Cr 2               ; gc_mark_list — recursively mark a cons-pair list
00329Cr 2               ;   Input: gc_mark_lo/hi = head cons pair pointer (payload)
00329Cr 2               ;   Marks each cons cell, and recursively marks sublists and word strings.
00329Cr 2               ;   Clobbers: A, X, Y, gc_mark, gc_ptr, ptr_lo/hi
00329Cr 2               ; ---------------------------------------------------------------------
00329Cr 2               gc_mark_list:
00329Cr 2                     ; Use gc_ptr to walk the list, gc_mark for marking
00329Cr 2  A5 rr              LDA   gc_mark_lo
00329Er 2  85 rr              STA   gc_ptr_lo
0032A0r 2  A5 rr              LDA   gc_mark_hi
0032A2r 2  85 rr              STA   gc_ptr_hi
0032A4r 2               
0032A4r 2               @walk:
0032A4r 2  A5 rr              LDA   gc_ptr_lo
0032A6r 2  05 rr              ORA   gc_ptr_hi
0032A8r 2  F0 70              BEQ   @done
0032AAr 2               
0032AAr 2                     ; Mark this cons pair
0032AAr 2  A5 rr              LDA   gc_ptr_lo
0032ACr 2  85 rr              STA   gc_mark_lo
0032AEr 2  A5 rr              LDA   gc_ptr_hi
0032B0r 2  85 rr              STA   gc_mark_hi
0032B2r 2  20 rr rr           JSR   gc_mark_node
0032B5r 2               
0032B5r 2                     ; Check car_type: if list, recursively mark sublist
0032B5r 2                     ; if word, mark the string
0032B5r 2  A5 rr              LDA   gc_ptr_lo
0032B7r 2  85 rr              STA   ptr_lo
0032B9r 2  A5 rr              LDA   gc_ptr_hi
0032BBr 2  85 rr              STA   ptr_hi
0032BDr 2  A0 01              LDY   #CONS_CAR_TYPE
0032BFr 2  B1 rr              LDA   (ptr_lo),Y
0032C1r 2  C9 02              CMP   #VAL_LIST
0032C3r 2  F0 23              BEQ   @car_list
0032C5r 2  C9 01              CMP   #VAL_WORD
0032C7r 2  F0 02              BEQ   @car_word
0032C9r 2  80 38              BRA   @follow_cdr
0032CBr 2               
0032CBr 2               @car_word:
0032CBr 2                     ; Mark the word string allocation
0032CBr 2  A0 03              LDY   #CONS_CAR_LO
0032CDr 2  B1 rr              LDA   (ptr_lo),Y
0032CFr 2  85 rr              STA   gc_mark_lo
0032D1r 2  A0 02              LDY   #CONS_CAR_HI
0032D3r 2  B1 rr              LDA   (ptr_lo),Y
0032D5r 2  85 rr              STA   gc_mark_hi
0032D7r 2                     ; Save gc_ptr across mark
0032D7r 2  A5 rr              LDA   gc_ptr_lo
0032D9r 2  48                 PHA
0032DAr 2  A5 rr              LDA   gc_ptr_hi
0032DCr 2  48                 PHA
0032DDr 2  20 rr rr           JSR   gc_mark_node
0032E0r 2  68                 PLA
0032E1r 2  85 rr              STA   gc_ptr_hi
0032E3r 2  68                 PLA
0032E4r 2  85 rr              STA   gc_ptr_lo
0032E6r 2  80 1B              BRA   @follow_cdr
0032E8r 2               
0032E8r 2               @car_list:
0032E8r 2                     ; Recursively mark the sublist
0032E8r 2  A0 03              LDY   #CONS_CAR_LO
0032EAr 2  B1 rr              LDA   (ptr_lo),Y
0032ECr 2  85 rr              STA   gc_mark_lo
0032EEr 2  A0 02              LDY   #CONS_CAR_HI
0032F0r 2  B1 rr              LDA   (ptr_lo),Y
0032F2r 2  85 rr              STA   gc_mark_hi
0032F4r 2                     ; Save gc_ptr across recursive call
0032F4r 2  A5 rr              LDA   gc_ptr_lo
0032F6r 2  48                 PHA
0032F7r 2  A5 rr              LDA   gc_ptr_hi
0032F9r 2  48                 PHA
0032FAr 2  20 rr rr           JSR   gc_mark_list          ; recursive
0032FDr 2  68                 PLA
0032FEr 2  85 rr              STA   gc_ptr_hi
003300r 2  68                 PLA
003301r 2  85 rr              STA   gc_ptr_lo
003303r 2               
003303r 2               @follow_cdr:
003303r 2                     ; Follow cdr to next cons pair
003303r 2  A5 rr              LDA   gc_ptr_lo
003305r 2  85 rr              STA   ptr_lo
003307r 2  A5 rr              LDA   gc_ptr_hi
003309r 2  85 rr              STA   ptr_hi
00330Br 2  A0 05              LDY   #CONS_CDR_LO
00330Dr 2  B1 rr              LDA   (ptr_lo),Y
00330Fr 2  AA                 TAX
003310r 2  A0 06              LDY   #CONS_CDR_HI
003312r 2  B1 rr              LDA   (ptr_lo),Y
003314r 2  85 rr              STA   gc_ptr_hi
003316r 2  86 rr              STX   gc_ptr_lo
003318r 2  80 8A              BRA   @walk
00331Ar 2               
00331Ar 2               @done:
00331Ar 2  60                 RTS
00331Br 2               
00331Br 1               
00331Br 1               ; =====================================================================
00331Br 1               ; ZEROPAGE segment — interpreter zero-page variables
00331Br 1               ; =====================================================================
00331Br 1                     .segment "ZEROPAGE"
00004Dr 1               
00004Dr 1  xx           buf_idx:      .res 1          ; current position in input_buf
00004Er 1               
00004Er 1               ; =====================================================================
00004Er 1               ; BSS segment — runtime buffers
00004Er 1               ; =====================================================================
00004Er 1                     .segment "BSS"
000982r 1               
000982r 1  xx xx xx xx  input_buf:    .res 128        ; input line buffer
000986r 1  xx xx xx xx  
00098Ar 1  xx xx xx xx  
000A02r 1               
000A02r 1               ; =====================================================================
000A02r 1               ; CODE segment — cold start and main loop
000A02r 1               ; =====================================================================
000A02r 1                     .segment "CODE"
00331Br 1               
00331Br 1               cold_start:
00331Br 1                     ; Copy extension ROM trampoline to RAM
00331Br 1  A2 0D              LDX   #EXT_TRAMP_SIZE-1
00331Dr 1               @copy_tramp:
00331Dr 1  BD rr rr           LDA   ext_tramp_src,X
003320r 1  9D 70 02           STA   EXT_TRAMPOLINE,X
003323r 1  CA                 DEX
003324r 1  10 F7              BPL   @copy_tramp
003326r 1               
003326r 1                     ; Zero NovaLogo turtle/graphics state ($9F00..$9F1F) so each session starts
003326r 1                     ; in a known mode. The extension pins its turtle state here (extension.s
003326r 1                     ; TURTLE_STATE_BASE=$9F00); RAM is stale across soft-reboot on HW, and a
003326r 1                     ; stale graphics-mode/inited flag breaks auto-switch and re-init.
003326r 1  A2 1F              LDX   #$1F
003328r 1               @zero_turtle:
003328r 1  9E 00 9F           STZ   $9F00,X
00332Br 1  CA                 DEX
00332Cr 1  10 FA              BPL   @zero_turtle
00332Er 1               
00332Er 1  20 rr rr           JSR   heap_init
003331r 1  20 rr rr           JSR   var_init
003334r 1  20 rr rr           JSR   proc_init
003337r 1  64 rr              STZ   catch_active
003339r 1  9C 0A A0           STZ   VGC_CURSEN
00333Cr 1  20 rr rr           JSR   print_banner
00333Fr 1  20 rr rr           JSR   print_prompt
003342r 1               
003342r 1               main_loop:
003342r 1  20 rr rr           JSR   read_line
003345r 1  9C 0A A0           STZ   VGC_CURSEN
003348r 1  20 rr rr           JSR   tokenize_line
00334Br 1  20 rr rr           JSR   check_to_command
00334Er 1  B0 03              BCS   @was_to               ; carry set = TO was handled
003350r 1  20 rr rr           JSR   eval_line
003353r 1               @was_to:
003353r 1                     ; Reclaim dead heap objects (tokens, list cells, etc.)
003353r 1  20 rr rr           JSR   gc_collect
003356r 1  20 rr rr           JSR   print_prompt
003359r 1  80 E7              BRA   main_loop
00335Br 1               
00335Br 1               ; ---------------------------------------------------------------------
00335Br 1               ; check_to_command — check if first token is TO; if so, collect procedure
00335Br 1               ;   Output: carry set = was TO (proc_collect called), carry clear = not TO
00335Br 1               ;   Clobbers: A, Y, ptr_lo/hi, eval_cur
00335Br 1               ; ---------------------------------------------------------------------
00335Br 1               check_to_command:
00335Br 1                     ; Is there a token list?
00335Br 1  A5 rr              LDA   tok_head_lo
00335Dr 1  05 rr              ORA   tok_head_hi
00335Fr 1  F0 37              BEQ   @not_to
003361r 1               
003361r 1                     ; Check first token: must be TOK_WORD
003361r 1  A5 rr              LDA   tok_head_lo
003363r 1  85 rr              STA   ptr_lo
003365r 1  A5 rr              LDA   tok_head_hi
003367r 1  85 rr              STA   ptr_hi
003369r 1  A0 00              LDY   #TOK_TAG
00336Br 1  B1 rr              LDA   (ptr_lo),Y
00336Dr 1  C9 01              CMP   #TOK_WORD
00336Fr 1  D0 27              BNE   @not_to
003371r 1               
003371r 1                     ; Check if word is "TO" (2 chars, 'T','O')
003371r 1  A0 03              LDY   #TOK_PAYLOAD
003373r 1  B1 rr              LDA   (ptr_lo),Y           ; length
003375r 1  C9 02              CMP   #2
003377r 1  D0 1F              BNE   @not_to
003379r 1  A0 04              LDY   #TOK_PAYLOAD+1
00337Br 1  B1 rr              LDA   (ptr_lo),Y
00337Dr 1  C9 54              CMP   #'T'
00337Fr 1  D0 17              BNE   @not_to
003381r 1  C8                 INY
003382r 1  B1 rr              LDA   (ptr_lo),Y
003384r 1  C9 4F              CMP   #'O'
003386r 1  D0 10              BNE   @not_to
003388r 1               
003388r 1                     ; It's TO — set up eval_cur past the TO token and call proc_collect
003388r 1  A5 rr              LDA   tok_head_lo
00338Ar 1  85 rr              STA   eval_cur_lo
00338Cr 1  A5 rr              LDA   tok_head_hi
00338Er 1  85 rr              STA   eval_cur_hi
003390r 1  20 rr rr           JSR   eval_advance          ; advance past TO token
003393r 1  20 rr rr           JSR   proc_collect
003396r 1  38                 SEC
003397r 1  60                 RTS
003398r 1               
003398r 1               @not_to:
003398r 1  18                 CLC
003399r 1  60                 RTS
00339Ar 1               
00339Ar 1               ; ---------------------------------------------------------------------
00339Ar 1               ; read_line — read a line of input into input_buf, null-terminated
00339Ar 1               ;   On return: input_buf contains the line, buf_idx = length
00339Ar 1               ; ---------------------------------------------------------------------
00339Ar 1               read_line:
00339Ar 1  64 rr              STZ   buf_idx            ; reset buffer index to 0
00339Cr 1  A9 01              LDA   #$01
00339Er 1  8D 0A A0           STA   VGC_CURSEN
0033A1r 1               
0033A1r 1               @poll:
0033A1r 1  AD 0F A0           LDA   VGC_CHARIN         ; poll keyboard
0033A4r 1  F0 FB              BEQ   @poll              ; no key waiting — spin
0033A6r 1               
0033A6r 1                     ; --- handle CR ($0D) ---
0033A6r 1  C9 0D              CMP   #$0D
0033A8r 1  D0 10              BNE   @not_cr
0033AAr 1  A6 rr              LDX   buf_idx
0033ACr 1  9E rr rr           STZ   input_buf,X        ; null-terminate
0033AFr 1  A9 0D              LDA   #$0D
0033B1r 1  8D 0E A0           STA   VGC_CHAROUT        ; carriage return
0033B4r 1  A9 0A              LDA   #$0A
0033B6r 1  8D 0E A0           STA   VGC_CHAROUT        ; line feed
0033B9r 1  60                 RTS
0033BAr 1               
0033BAr 1               @not_cr:
0033BAr 1                     ; --- handle backspace ($08, $14, $7F) ---
0033BAr 1  C9 08              CMP   #$08
0033BCr 1  F0 18              BEQ   @backspace
0033BEr 1  C9 14              CMP   #$14
0033C0r 1  F0 14              BEQ   @backspace
0033C2r 1  C9 7F              CMP   #$7F
0033C4r 1  F0 10              BEQ   @backspace
0033C6r 1               
0033C6r 1                     ; --- buffer full? ---
0033C6r 1  A6 rr              LDX   buf_idx
0033C8r 1  E0 7F              CPX   #127
0033CAr 1  B0 D5              BCS   @poll              ; at capacity — ignore keystroke
0033CCr 1               
0033CCr 1                     ; --- store and echo printable character ---
0033CCr 1  9D rr rr           STA   input_buf,X        ; store in buffer
0033CFr 1  8D 0E A0           STA   VGC_CHAROUT        ; echo to screen
0033D2r 1  E6 rr              INC   buf_idx
0033D4r 1  80 CB              BRA   @poll
0033D6r 1               
0033D6r 1               @backspace:
0033D6r 1  A6 rr              LDX   buf_idx
0033D8r 1  F0 C7              BEQ   @poll              ; nothing to delete — ignore
0033DAr 1  CA                 DEX
0033DBr 1  86 rr              STX   buf_idx
0033DDr 1  A9 08              LDA   #$08
0033DFr 1  8D 0E A0           STA   VGC_CHAROUT        ; move cursor left and erase
0033E2r 1  80 BD              BRA   @poll
0033E4r 1               
0033E4r 1               ; ---------------------------------------------------------------------
0033E4r 1               ; print_prompt — prints "? " to the screen
0033E4r 1               ; ---------------------------------------------------------------------
0033E4r 1               print_prompt:
0033E4r 1  A2 00              LDX   #0
0033E6r 1  BD rr rr     @lp:  LDA   str_prompt,X
0033E9r 1  F0 06              BEQ   @done
0033EBr 1  8D 0E A0           STA   VGC_CHAROUT
0033EEr 1  E8                 INX
0033EFr 1  D0 F5              BNE   @lp
0033F1r 1               @done:
0033F1r 1  A9 01              LDA   #$01
0033F3r 1  8D 0A A0           STA   VGC_CURSEN
0033F6r 1  60                 RTS
0033F7r 1               
0033F7r 1               ; ---------------------------------------------------------------------
0033F7r 1               ; print_banner — prints title and current available heap bytes
0033F7r 1               ; ---------------------------------------------------------------------
0033F7r 1               print_banner:
0033F7r 1  A2 00              LDX   #0
0033F9r 1               @title:
0033F9r 1  BD rr rr           LDA   str_banner_title,X
0033FCr 1  F0 06              BEQ   @free
0033FEr 1  8D 0E A0           STA   VGC_CHAROUT
003401r 1  E8                 INX
003402r 1  D0 F5              BNE   @title
003404r 1               
003404r 1               @free:
003404r 1  38                 SEC
003405r 1  A9 00              LDA   #<HEAP_END
003407r 1  E5 rr              SBC   heap_ptr
003409r 1  85 rr              STA   eval_val_lo
00340Br 1  A9 98              LDA   #>HEAP_END
00340Dr 1  E5 rr              SBC   heap_ptr+1
00340Fr 1  85 rr              STA   eval_val_hi
003411r 1  38                 SEC
003412r 1  A5 rr              LDA   eval_val_lo
003414r 1  E9 02              SBC   #GC_HDR_BYTES
003416r 1  85 rr              STA   eval_val_lo
003418r 1  A5 rr              LDA   eval_val_hi
00341Ar 1  E9 00              SBC   #0
00341Cr 1  85 rr              STA   eval_val_hi
00341Er 1  64 rr              STZ   eval_val_frac
003420r 1  20 rr rr           JSR   print_uint16
003423r 1               
003423r 1  A2 00              LDX   #0
003425r 1               @suffix:
003425r 1  BD rr rr           LDA   str_bytes_free,X
003428r 1  F0 06              BEQ   @done
00342Ar 1  8D 0E A0           STA   VGC_CHAROUT
00342Dr 1  E8                 INX
00342Er 1  D0 F5              BNE   @suffix
003430r 1               @done:
003430r 1  60                 RTS
003431r 1               
003431r 1               ; =====================================================================
003431r 1               ; RODATA segment — string constants
003431r 1               ; =====================================================================
003431r 1                     .segment "RODATA"
000A6Er 1               
000A6Er 1               str_banner_title:
000A6Er 1  4E 6F 76 61        .byte "Nova LOGO v1.0", $0D, $0A
000A72r 1  20 4C 4F 47  
000A76r 1  4F 20 76 31  
000A7Er 1  00                 .byte 0
000A7Fr 1               str_bytes_free:
000A7Fr 1  20 42 59 54        .byte " BYTES FREE", $0D, $0A, $0D, $0A
000A83r 1  45 53 20 46  
000A87r 1  52 45 45 0D  
000A8Er 1  00                 .byte 0
000A8Fr 1               
000A8Fr 1               str_prompt:
000A8Fr 1  3F 20 00           .byte "? ", 0
000A92r 1               
000A92r 1               ; Extension ROM trampoline — copied to RAM at $0270 during cold_start.
000A92r 1               ; Swaps to extension ROM, calls entry, swaps back to Logo ROM.
000A92r 1               ext_tramp_src:
000A92r 1  A9 04              .byte $A9, ROMSWAP_EXTENSION  ; LDA #ROMSWAP_EXTENSION
000A94r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000A97r 1  20 00 C0           .byte $20, $00, $C0          ; JSR $C000
000A9Ar 1  A9 05              .byte $A9, ROMSWAP_LOGO      ; LDA #ROMSWAP_LOGO
000A9Cr 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000A9Fr 1  60                 .byte $60                     ; RTS
000AA0r 1               
000AA0r 1               ; =====================================================================
000AA0r 1               ; MONITOR segment — reset handler at $FFD7
000AA0r 1               ; =====================================================================
000AA0r 1                     .segment "MONITOR"
000000r 1                     .org  $FFD7
00FFD7  1               
00FFD7  1               RES_vec:
00FFD7  1  D8                 CLD                     ; clear decimal mode
00FFD8  1  A2 FF              LDX   #$FF              ; empty stack
00FFDA  1  9A                 TXS                     ; set the stack
00FFDB  1  4C rr rr           JMP   cold_start
00FFDE  1               
00FFDE  1               ; IRQ/NMI stubs
00FFDE  1               NMI_stub:
00FFDE  1  40                 RTI
00FFDF  1               
00FFDF  1               IRQ_stub:
00FFDF  1  40                 RTI
00FFE0  1               
00FFE0  1               ; =====================================================================
00FFE0  1               ; VECTORS segment — 6502 hardware vectors at $FFFA
00FFE0  1               ; =====================================================================
00FFE0  1                     .segment "VECTORS"
00FFE0  1                     .org  $FFFA
00FFFA  1               
00FFFA  1  DE FF              .word NMI_stub           ; $FFFA — NMI vector
00FFFC  1  D7 FF              .word RES_vec            ; $FFFC — RESET vector
00FFFE  1  DF FF              .word IRQ_stub           ; $FFFE — IRQ vector
00FFFE  1               
