000ECEr 2  A0 rr              LDY   #>str_if_name
000ED0r 2  4C rr rr           JMP   err_nei
000ED3r 2               
000ED3r 2               ; ---------------------------------------------------------------------
000ED3r 2               ; do_ifelse — IFELSE condition [true-body] [false-body]
000ED3r 2               ;   Arity 0 — handles its own argument parsing
000ED3r 2               ; ---------------------------------------------------------------------
000ED3r 2               do_ifelse:
