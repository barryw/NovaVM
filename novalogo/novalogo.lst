0004B1r 2               ; =====================================================================
0004B1r 2               ; RODATA — tokenizer strings
0004B1r 2               ; =====================================================================
0004B1r 2                     .segment "RODATA"
000000r 2               
000000r 2               str_tokens:
000000r 2  20 54 4F 4B        .byte " TOKENS", 0
000004r 2  45 4E 53 00  
000008r 2               
000008r 1                     .include "eval.s"
000008r 2               ; eval.s — evaluator: walk token list and dispatch commands
000008r 2               
000008r 2               ; =====================================================================
000008r 2               ; ZEROPAGE segment — evaluator variables
000008r 2               ; =====================================================================
000008r 2                     .segment "ZEROPAGE"
00000Cr 2               
00000Cr 2  xx           eval_type:      .res 1    ; result type: $00=number, $01=word
00000Dr 2  xx           eval_val_hi:    .res 1    ; number high byte or word ptr high
00000Er 2  xx           eval_val_lo:    .res 1    ; number low byte or word ptr low
00000Fr 2  xx           eval_val_frac:  .res 1    ; number fractional byte
000010r 2  xx           eval_cur_lo:    .res 1    ; current token pointer (low)
000011r 2  xx           eval_cur_hi:    .res 1    ; current token pointer (high)
000012r 2  xx           eval_left_hi:   .res 1    ; saved left operand high byte
000013r 2  xx           eval_left_lo:   .res 1    ; saved left operand low byte
000014r 2  xx           eval_left_frac: .res 1    ; saved left operand fractional byte
000015r 2  xx           eval_op:        .res 1    ; infix operator character
000016r 2  xx           handler_lo:     .res 1    ; saved handler address for JMP
000017r 2  xx           handler_hi:     .res 1
000018r 2  xx           eval_in_body:   .res 1    ; $00 = normal eval_loop, $01 = in body
000019r 2  xx           proc_stopped:   .res 1    ; $00 = running, $01 = STOP, $02 = OUTPUT
00001Ar 2  xx           eval_reporter:  .res 1    ; $00 = normal, $01 = reporter mode (return from eval_continue)
00001Br 2               
00001Br 2               ; --- Catch frame for CATCH/THROW error handling ---
00001Br 2  xx           catch_active:   .res 1    ; $00 = no catch, $01 = catch active
00001Cr 2  xx           catch_tag_lo:   .res 1    ; pointer to tag word (length-prefixed)
00001Dr 2  xx           catch_tag_hi:   .res 1
00001Er 2  xx           catch_sp:       .res 1    ; saved 6502 stack pointer for unwinding
00001Fr 2  xx           catch_resume_lo: .res 1   ; eval_cur to resume at (past the body's ])
000020r 2  xx           catch_resume_hi: .res 1
000021r 2               
000021r 2               ; =====================================================================
000021r 2               ; BSS segment — scratch for number printing
000021r 2               ; =====================================================================
000021r 2                     .segment "BSS"
000007r 2               
000007r 2  xx xx xx xx  pn_buf:         .res 8    ; decimal digit buffer for print_number
00000Br 2  xx xx xx xx  
00000Fr 2               
00000Fr 2               ; =====================================================================
00000Fr 2               ; CODE segment — evaluator routines
00000Fr 2               ; =====================================================================
00000Fr 2                     .segment "CODE"
0004B1r 2               
0004B1r 2               ; ---------------------------------------------------------------------
0004B1r 2               ; eval_line — evaluate the token list built by tokenize_line
0004B1r 2               ;   Input:  tok_head_lo/hi = first token
0004B1r 2               ;   Output: commands executed, errors printed
0004B1r 2               ; ---------------------------------------------------------------------
0004B1r 2               eval_line:
0004B1r 2  64 rr              STZ   eval_in_body
0004B3r 2  64 rr              STZ   proc_stopped
0004B5r 2  64 rr              STZ   eval_reporter
0004B7r 2  A5 rr              LDA   tok_head_lo
0004B9r 2  85 rr              STA   eval_cur_lo
0004BBr 2  A5 rr              LDA   tok_head_hi
0004BDr 2  85 rr              STA   eval_cur_hi
0004BFr 2               
0004BFr 2               eval_loop:
0004BFr 2                     ; Check if STOP/OUTPUT was signaled — bail out
0004BFr 2  A5 rr              LDA   proc_stopped
0004C1r 2  D0 1B              BNE   @bail_out
0004C3r 2               
0004C3r 2                     ; Check for end of list
0004C3r 2  A5 rr              LDA   eval_cur_lo
0004C5r 2  05 rr              ORA   eval_cur_hi
0004C7r 2  F0 15              BEQ   @bail_out
0004C9r 2               
0004C9r 2                     ; Read tag of current token
0004C9r 2  A5 rr              LDA   eval_cur_lo
0004CBr 2  85 rr              STA   ptr_lo
0004CDr 2  A5 rr              LDA   eval_cur_hi
0004CFr 2  85 rr              STA   ptr_hi
0004D1r 2  A0 00              LDY   #TOK_TAG
0004D3r 2  B1 rr              LDA   (ptr_lo),Y
0004D5r 2               
0004D5r 2                     ; Dispatch based on tag
0004D5r 2  C9 01              CMP   #TOK_WORD
0004D7r 2  F0 06              BEQ   @do_command
0004D9r 2               
0004D9r 2                     ; Bare expression — skip it for now (could error)
0004D9r 2                     ; Advance to next token
0004D9r 2  20 rr rr           JSR   eval_advance
0004DCr 2  80 E1              BRA   eval_loop
0004DEr 2               
0004DEr 2               @bail_out:
0004DEr 2  60                 RTS
0004DFr 2               
0004DFr 2               @do_command:
0004DFr 2                     ; Look up the word in the builtin table
0004DFr 2  20 rr rr           JSR   lookup_builtin
0004E2r 2  B0 42              BCS   @unknown
0004E4r 2               
0004E4r 2                     ; Found: handler addr is in ptr2_lo/hi, arity in A
0004E4r 2                     ; Save handler address — eval_expr may clobber ptr2
0004E4r 2  A6 rr              LDX   ptr2_lo
0004E6r 2  86 rr              STX   handler_lo
0004E8r 2  A6 rr              LDX   ptr2_hi
0004EAr 2  86 rr              STX   handler_hi
0004ECr 2                     ; Save arity across eval_advance (which clobbers X)
0004ECr 2  AA                 TAX
0004EDr 2  DA                 PHX
0004EEr 2                     ; Advance past the command word token
0004EEr 2  20 rr rr           JSR   eval_advance
0004F1r 2  FA                 PLX
0004F2r 2               
0004F2r 2                     ; Evaluate arguments (X = arity count)
0004F2r 2  E0 00              CPX   #0
0004F4r 2  F0 16              BEQ   @call_handler
0004F6r 2                     ; Save handler address — eval_expr may invoke proc_invoke which
0004F6r 2                     ; clobbers handler_lo/hi via inner eval_loop dispatch
0004F6r 2  A5 rr              LDA   handler_hi
0004F8r 2  48                 PHA
0004F9r 2  A5 rr              LDA   handler_lo
0004FBr 2  48                 PHA
0004FCr 2               @eval_args:
0004FCr 2  DA                 PHX                   ; save remaining arg count
0004FDr 2  20 rr rr           JSR   eval_expr
000500r 2  B0 0D              BCS   @arg_error
000502r 2  FA                 PLX
000503r 2  CA                 DEX
000504r 2  D0 F6              BNE   @eval_args
000506r 2                     ; Restore handler address
000506r 2  68                 PLA
000507r 2  85 rr              STA   handler_lo
000509r 2  68                 PLA
00050Ar 2  85 rr              STA   handler_hi
00050Cr 2               
00050Cr 2               @call_handler:
00050Cr 2                     ; Call the handler via indirect JMP
00050Cr 2  6C rr rr           JMP   (handler_lo)
00050Fr 2                     ; handlers must JMP back to eval_loop via eval_continue
00050Fr 2               
00050Fr 2               @arg_error:
00050Fr 2  FA                 PLX                   ; discard saved arity counter
000510r 2                     ; Discard saved handler address
000510r 2  68                 PLA
000511r 2  68                 PLA
000512r 2                     ; Print error and abort line
000512r 2  A2 00              LDX   #0
000514r 2               @ae_lp:
000514r 2  BD rr rr           LDA   str_notenough,X
000517r 2  F0 06              BEQ   @ae_done
000519r 2  8D 0E A0           STA   VGC_CHAROUT
00051Cr 2  E8                 INX
00051Dr 2  D0 F5              BNE   @ae_lp
00051Fr 2               @ae_done:
00051Fr 2  20 rr rr           JSR   eval_newline
000522r 2  20 rr rr           JSR   try_throw_error
000525r 2  60                 RTS
000526r 2               
000526r 2               @unknown:
000526r 2                     ; Try user-defined procedures before erroring
000526r 2  20 rr rr           JSR   proc_lookup
000529r 2  B0 06              BCS   @try_ext_cmd
00052Br 2                     ; Found a procedure — invoke it (proc_stopped restored internally)
00052Br 2  20 rr rr           JSR   proc_invoke
00052Er 2  4C rr rr           JMP   eval_loop
000531r 2               
000531r 2               @try_ext_cmd:
000531r 2                     ; Try extension command table before giving up
000531r 2  20 rr rr           JSR   lookup_ext_cmd
000534r 2  B0 35              BCS   @truly_unknown
000536r 2                     ; Found: A = arity, ext_cmd set.
000536r 2                     ; Advance past the command word token.
000536r 2  AA                 TAX                       ; X = arity
000537r 2  DA                 PHX
000538r 2  20 rr rr           JSR   eval_advance
00053Br 2  FA                 PLX
00053Cr 2                     ; Evaluate arguments and copy to ext_arg slots
00053Cr 2  20 rr rr           JSR   ext_eval_args
00053Fr 2  B0 16              BCS   @ext_arg_err
000541r 2                     ; Call extension via RAM trampoline
000541r 2  20 70 02           JSR   EXT_TRAMPOLINE
000544r 2                     ; Copy result back to eval_val
000544r 2  A5 8E              LDA   EXT_RESULT_TYPE
000546r 2  85 rr              STA   eval_type
000548r 2  A5 8F              LDA   EXT_RESULT_HI
00054Ar 2  85 rr              STA   eval_val_hi
00054Cr 2  A5 90              LDA   EXT_RESULT_LO
00054Er 2  85 rr              STA   eval_val_lo
000550r 2  A5 91              LDA   EXT_RESULT_FRAC
000552r 2  85 rr              STA   eval_val_frac
000554r 2  4C rr rr           JMP   eval_continue
000557r 2               
000557r 2               @ext_arg_err:
000557r 2  A2 00              LDX   #0
000559r 2               @eae_lp:
000559r 2  BD rr rr           LDA   str_notenough,X
00055Cr 2  F0 06              BEQ   @eae_done
00055Er 2  8D 0E A0           STA   VGC_CHAROUT
000561r 2  E8                 INX
000562r 2  D0 F5              BNE   @eae_lp
000564r 2               @eae_done:
000564r 2  20 rr rr           JSR   eval_newline
000567r 2  20 rr rr           JSR   try_throw_error
00056Ar 2  60                 RTS
00056Br 2               
00056Br 2               @truly_unknown:
00056Br 2                     ; Print "I don't know how to " + the word
00056Br 2  A2 00              LDX   #0
00056Dr 2               @unk_lp:
00056Dr 2  BD rr rr           LDA   str_idk,X
000570r 2  F0 06              BEQ   @unk_word
000572r 2  8D 0E A0           STA   VGC_CHAROUT
000575r 2  E8                 INX
000576r 2  D0 F5              BNE   @unk_lp
000578r 2               @unk_word:
000578r 2                     ; Print the word from the token payload
000578r 2  A5 rr              LDA   eval_cur_lo
00057Ar 2  85 rr              STA   ptr_lo
00057Cr 2  A5 rr              LDA   eval_cur_hi
00057Er 2  85 rr              STA   ptr_hi
000580r 2  A0 03              LDY   #TOK_PAYLOAD        ; length byte
000582r 2  B1 rr              LDA   (ptr_lo),Y
000584r 2  AA                 TAX                       ; X = length
000585r 2  A0 04              LDY   #TOK_PAYLOAD+1      ; first char
000587r 2               @unk_ch:
000587r 2  B1 rr              LDA   (ptr_lo),Y
000589r 2  8D 0E A0           STA   VGC_CHAROUT
00058Cr 2  C8                 INY
00058Dr 2  CA                 DEX
00058Er 2  D0 F7              BNE   @unk_ch
000590r 2  20 rr rr           JSR   eval_newline
000593r 2  20 rr rr           JSR   try_throw_error
000596r 2  60                 RTS
000597r 2               
000597r 2               @done:
000597r 2  60                 RTS
000598r 2               
000598r 2               ; ---------------------------------------------------------------------
000598r 2               ; eval_continue — handlers JMP here to resume the eval loop
000598r 2               ;   If eval_in_body != 0, resumes body execution instead
000598r 2               ; ---------------------------------------------------------------------
000598r 2               ; ---------------------------------------------------------------------
000598r 2               ; jmp_handler — trampoline for calling builtins from reporter position
000598r 2               ; ---------------------------------------------------------------------
000598r 2               jmp_handler:
000598r 2  6C rr rr           JMP   (handler_lo)
00059Br 2               
00059Br 2               eval_continue:
00059Br 2                     ; If in reporter mode, return to eval_expr instead of looping
00059Br 2  A5 rr              LDA   eval_reporter
00059Dr 2  D0 07              BNE   @reporter_return
00059Fr 2  A5 rr              LDA   eval_in_body
0005A1r 2  D0 07              BNE   eval_body
0005A3r 2  4C rr rr           JMP   eval_loop
0005A6r 2               
0005A6r 2               @reporter_return:
0005A6r 2  64 rr              STZ   eval_reporter
0005A8r 2  18                 CLC
0005A9r 2  60                 RTS
0005AAr 2               
0005AAr 2               ; ---------------------------------------------------------------------
0005AAr 2               ; eval_body — execute tokens within a body until TOK_RBRACKET at depth 0
0005AAr 2               ;   Entry: eval_cur is at the next token to execute inside the body
0005AAr 2               ;   Exit:  eval_cur points at the TOK_RBRACKET that ended the body
0005AAr 2               ;   eval_in_body must be $01 on entry
0005AAr 2               ; ---------------------------------------------------------------------
0005AAr 2               eval_body:
0005AAr 2                     ; Check if STOP/OUTPUT was signaled — bail out immediately
0005AAr 2  A5 rr              LDA   proc_stopped
0005ACr 2  D0 65              BNE   @done
0005AEr 2               
0005AEr 2                     ; Check for end of list (safety — malformed input)
0005AEr 2  A5 rr              LDA   eval_cur_lo
0005B0r 2  05 rr              ORA   eval_cur_hi
0005B2r 2  F0 5F              BEQ   @done
0005B4r 2               
0005B4r 2                     ; Read tag of current token
0005B4r 2  A5 rr              LDA   eval_cur_lo
0005B6r 2  85 rr              STA   ptr_lo
0005B8r 2  A5 rr              LDA   eval_cur_hi
0005BAr 2  85 rr              STA   ptr_hi
0005BCr 2  A0 00              LDY   #TOK_TAG
0005BEr 2  B1 rr              LDA   (ptr_lo),Y
0005C0r 2               
0005C0r 2                     ; Hit the closing bracket? We're done with this body pass.
0005C0r 2  C9 04              CMP   #TOK_RBRACKET
0005C2r 2  F0 4F              BEQ   @done
0005C4r 2               
0005C4r 2                     ; Dispatch command words (same as eval_loop)
0005C4r 2  C9 01              CMP   #TOK_WORD
0005C6r 2  F0 05              BEQ   @do_command
0005C8r 2               
0005C8r 2                     ; Skip non-word tokens (bare numbers, brackets inside expressions, etc.)
0005C8r 2  20 rr rr           JSR   eval_advance
0005CBr 2  80 DD              BRA   eval_body
0005CDr 2               
0005CDr 2               @do_command:
0005CDr 2                     ; Same dispatch as eval_loop — look up builtin, eval args, call handler
0005CDr 2  20 rr rr           JSR   lookup_builtin
0005D0r 2  B0 42              BCS   @unknown
0005D2r 2               
0005D2r 2  A6 rr              LDX   ptr2_lo
0005D4r 2  86 rr              STX   handler_lo
0005D6r 2  A6 rr              LDX   ptr2_hi
0005D8r 2  86 rr              STX   handler_hi
0005DAr 2  AA                 TAX
0005DBr 2  DA                 PHX
0005DCr 2  20 rr rr           JSR   eval_advance
0005DFr 2  FA                 PLX
0005E0r 2               
0005E0r 2  E0 00              CPX   #0
0005E2r 2  F0 16              BEQ   @call_handler
0005E4r 2                     ; Save handler address — eval_expr may invoke proc_invoke
0005E4r 2  A5 rr              LDA   handler_hi
0005E6r 2  48                 PHA
0005E7r 2  A5 rr              LDA   handler_lo
0005E9r 2  48                 PHA
0005EAr 2               @eval_args:
0005EAr 2  DA                 PHX
0005EBr 2  20 rr rr           JSR   eval_expr
0005EEr 2  B0 0D              BCS   @arg_error
0005F0r 2  FA                 PLX
0005F1r 2  CA                 DEX
0005F2r 2  D0 F6              BNE   @eval_args
0005F4r 2                     ; Restore handler address
0005F4r 2  68                 PLA
0005F5r 2  85 rr              STA   handler_lo
0005F7r 2  68                 PLA
0005F8r 2  85 rr              STA   handler_hi
0005FAr 2               
0005FAr 2               @call_handler:
0005FAr 2  6C rr rr           JMP   (handler_lo)
0005FDr 2                     ; handler JMPs to eval_continue, which routes back here
0005FDr 2               
0005FDr 2               @arg_error:
0005FDr 2  FA                 PLX
0005FEr 2  68                 PLA
0005FFr 2  68                 PLA
000600r 2  A2 00              LDX   #0
000602r 2               @ae_lp:
000602r 2  BD rr rr           LDA   str_notenough,X
000605r 2  F0 06              BEQ   @ae_done
000607r 2  8D 0E A0           STA   VGC_CHAROUT
00060Ar 2  E8                 INX
00060Br 2  D0 F5              BNE   @ae_lp
00060Dr 2               @ae_done:
00060Dr 2  20 rr rr           JSR   eval_newline
000610r 2  20 rr rr           JSR   try_throw_error
000613r 2                     ; fall through to @done — abort body on error
000613r 2               
000613r 2               @done:
000613r 2  60                 RTS
000614r 2               
000614r 2               @unknown:
000614r 2                     ; Try user-defined procedures before erroring (inside body)
000614r 2  20 rr rr           JSR   proc_lookup
000617r 2  B0 06              BCS   @try_ext_cmd
000619r 2  20 rr rr           JSR   proc_invoke
00061Cr 2  4C rr rr           JMP   eval_body
00061Fr 2               
00061Fr 2               @try_ext_cmd:
00061Fr 2                     ; Try extension command table before giving up (inside body)
00061Fr 2  20 rr rr           JSR   lookup_ext_cmd
000622r 2  B0 35              BCS   @truly_unknown
000624r 2  AA                 TAX
000625r 2  DA                 PHX
000626r 2  20 rr rr           JSR   eval_advance
000629r 2  FA                 PLX
00062Ar 2  20 rr rr           JSR   ext_eval_args
00062Dr 2  B0 16              BCS   @body_ext_err
00062Fr 2  20 70 02           JSR   EXT_TRAMPOLINE
000632r 2  A5 8E              LDA   EXT_RESULT_TYPE
000634r 2  85 rr              STA   eval_type
000636r 2  A5 8F              LDA   EXT_RESULT_HI
000638r 2  85 rr              STA   eval_val_hi
00063Ar 2  A5 90              LDA   EXT_RESULT_LO
00063Cr 2  85 rr              STA   eval_val_lo
00063Er 2  A5 91              LDA   EXT_RESULT_FRAC
000640r 2  85 rr              STA   eval_val_frac
000642r 2  4C rr rr           JMP   eval_continue
000645r 2               
000645r 2               @body_ext_err:
000645r 2  A2 00              LDX   #0
000647r 2               @bee_lp:
