001045r 2               ; ---------------------------------------------------------------------
001045r 2               ; do_catch — CATCH "tag [body]: execute body, catching errors/throws
001045r 2               ;   Arity 0 — handles its own argument parsing
001045r 2               ;   1. Evaluate tag argument (quoted word)
001045r 2               ;   2. Save current catch frame (for nesting) on the 6502 stack
001045r 2               ;   3. Set up new catch frame with tag and stack pointer
001045r 2               ;   4. Execute the body
001045r 2               ;   5. On normal completion: restore previous catch frame, continue
001045r 2               ;   On THROW match: try_throw_error or do_throw restores SP from
001045r 2               ;   catch frame, which unwinds back to step 5's stack context.
001045r 2               ; ---------------------------------------------------------------------
001045r 2               do_catch:
001045r 2                     ; Evaluate tag argument (e.g., "ERROR)
001045r 2  20 rr rr           JSR   eval_expr
