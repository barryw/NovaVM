0015F2r 2               
0015F2r 2               ; ---------------------------------------------------------------------
0015F2r 2               ; do_char — CHAR n: convert ASCII code to 1-char word
0015F2r 2               ;   Arity 0: evaluates its own argument
0015F2r 2               ; ---------------------------------------------------------------------
0015F2r 2               do_char:
0015F2r 2  20 rr rr           JSR   eval_expr
0015F5r 2  B0 09              BCS   @err
0015F7r 2                     ; Must be a number
0015F7r 2  A5 rr              LDA   eval_type
0015F9r 2  D0 05              BNE   @err
0015FBr 2                     ; Low byte of number is the ASCII code
0015FBr 2  A5 rr              LDA   eval_val_lo
0015FDr 2  4C rr rr           JMP   alloc_one_char_word
001600r 2               @err:
001600r 2  A2 rr              LDX   #<str_char_err
001602r 2  A0 rr              LDY   #>str_char_err
001604r 2  4C rr rr           JMP   list_print_err
001607r 2               
001607r 2               ; ---------------------------------------------------------------------
001607r 2               ; do_ascii — ASCII word: return ASCII code of first character
001607r 2               ;   Arity 0: evaluates its own argument
001607r 2               ; ---------------------------------------------------------------------
001607r 2               do_ascii:
001607r 2  20 rr rr           JSR   eval_expr
00160Ar 2  B0 23              BCS   @err
00160Cr 2                     ; Must be a word
00160Cr 2  A5 rr              LDA   eval_type
00160Er 2  C9 01              CMP   #VAL_WORD
001610r 2  D0 1D              BNE   @err_type
001612r 2                     ; eval_val_lo/hi points at length-prefixed string
001612r 2  A5 rr              LDA   eval_val_lo
001614r 2  85 rr              STA   ptr_lo
001616r 2  A5 rr              LDA   eval_val_hi
001618r 2  85 rr              STA   ptr_hi
00161Ar 2  A0 00              LDY   #0
00161Cr 2  B1 rr              LDA   (ptr_lo),Y           ; length
00161Er 2  F0 0F              BEQ   @err_empty            ; empty word
001620r 2  A0 01              LDY   #1
001622r 2  B1 rr              LDA   (ptr_lo),Y           ; first character
001624r 2  85 rr              STA   eval_val_lo
001626r 2  64 rr              STZ   eval_val_hi
001628r 2  64 rr              STZ   eval_val_frac
00162Ar 2  64 rr              STZ   eval_type             ; VAL_NUMBER
00162Cr 2  4C rr rr           JMP   eval_continue
00162Fr 2               @err_type:
00162Fr 2               @err_empty:
00162Fr 2               @err:
00162Fr 2  A2 rr              LDX   #<str_ascii_err
001631r 2  A0 rr              LDY   #>str_ascii_err
001633r 2  4C rr rr           JMP   list_print_err
001636r 2               
001636r 2               ; =====================================================================
001636r 2               ; Math functions and type predicates
001636r 2               ; =====================================================================
001636r 2               
001636r 2               ; ---------------------------------------------------------------------
001636r 2               ; return_number — set eval_val from eval_val_lo/hi, clear frac+type
001636r 2               ;   Entry: eval_val_lo/hi already set
001636r 2               ;   Jumps to eval_continue
001636r 2               ; ---------------------------------------------------------------------
001636r 2               return_number:
001636r 2  64 rr              STZ   eval_val_frac
001638r 2  64 rr              STZ   eval_type
00163Ar 2  4C rr rr           JMP   eval_continue
00163Dr 2               
00163Dr 2               ; ---------------------------------------------------------------------
00163Dr 2               ; return_signed_byte — sign-extend A into eval_val as 16.8 number
00163Dr 2               ;   Entry: A = signed byte (-128..+127)
00163Dr 2               ;   Jumps to eval_continue
00163Dr 2               ; ---------------------------------------------------------------------
00163Dr 2               return_signed_byte:
00163Dr 2  85 rr              STA   eval_val_lo
00163Fr 2  10 04              BPL   @pos
001641r 2  A9 FF              LDA   #$FF
001643r 2  80 02              BRA   @set
001645r 2  A9 00        @pos: LDA   #$00
001647r 2  85 rr        @set: STA   eval_val_hi
001649r 2  80 EB              BRA   return_number
00164Br 2               
00164Br 2               ; ---------------------------------------------------------------------
00164Br 2               ; predicate_result — set eval_val to 1 (Z set) or 0 (Z clear)
00164Br 2               ;   Entry: Z flag from CMP
00164Br 2               ;   Jumps to eval_continue
00164Br 2               ; ---------------------------------------------------------------------
00164Br 2               predicate_result:
00164Br 2  F0 04              BEQ   @true
00164Dr 2  64 rr              STZ   eval_val_lo
00164Fr 2  80 04              BRA   @done
001651r 2               @true:
001651r 2  A9 01              LDA   #1
001653r 2  85 rr              STA   eval_val_lo
001655r 2               @done:
001655r 2  64 rr              STZ   eval_val_hi
001657r 2  80 DD              BRA   return_number
001659r 2               
001659r 2               ; ---------------------------------------------------------------------
001659r 2               ; degrees_to_u8 — convert eval_val (degrees 0-360) to u8 angle (0-255)
001659r 2               ;   Uses MUL16 coprocessor: angle = degrees * 91 / 128
001659r 2               ;   Actually: write degrees to MUL16 A, 91 to B, read RES1 (high byte)
001659r 2               ;   Then shift right once (divide by 2) since 91/256=0.355, we want 91/128
001659r 2               ;   Wait, let me recalculate: degrees * 91 >> 7
001659r 2               ;   MUL16 gives degrees*91 in RES1:RES0. We want bits [14:7] of that.
001659r 2               ;   RES1 is bits [15:8]. But we want >>7 which is RES1<<1 | RES0>>7.
001659r 2               ;   Simpler: degrees * 182 / 256 = RES1 of (degrees * 182). Let's use 182.
001659r 2               ;   Output: A = u8 angle
001659r 2               ;   Clobbers: uses math coprocessor regs
001659r 2               ; ---------------------------------------------------------------------
001659r 2               degrees_to_u8:
001659r 2  A5 rr              LDA   eval_val_lo
00165Br 2  8D 20 BB           STA   MATH_MUL16_A_LO
00165Er 2  A5 rr              LDA   eval_val_hi
001660r 2  8D 21 BB           STA   MATH_MUL16_A_HI
001663r 2  A9 B6              LDA   #182
001665r 2  8D 22 BB           STA   MATH_MUL16_B_LO
001668r 2  9C 23 BB           STZ   MATH_MUL16_B_HI       ; trigger multiply
00166Br 2  AD 39 BB           LDA   MATH_RES1              ; high byte = degrees * 182 / 256
00166Er 2  60                 RTS
00166Fr 2               
00166Fr 2               ; ---------------------------------------------------------------------
00166Fr 2               ; do_sin — SIN degrees: return sin as signed byte (-128..+127)
00166Fr 2               ; ---------------------------------------------------------------------
00166Fr 2               do_sin:
00166Fr 2  20 rr rr           JSR   eval_expr
001672r 2  B0 0C              BCS   @err
001674r 2  20 rr rr           JSR   degrees_to_u8
001677r 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
00167Ar 2  AD 38 BB           LDA   MATH_RES0              ; sin result (signed 1.7)
00167Dr 2  4C rr rr           JMP   return_signed_byte
001680r 2               @err:
001680r 2  38                 SEC
001681r 2  60                 RTS
001682r 2               
001682r 2               ; ---------------------------------------------------------------------
001682r 2               ; do_cos — COS degrees: return cos as signed byte (-128..+127)
001682r 2               ; ---------------------------------------------------------------------
001682r 2               do_cos:
001682r 2  20 rr rr           JSR   eval_expr
001685r 2  B0 0C              BCS   @err
001687r 2  20 rr rr           JSR   degrees_to_u8
00168Ar 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
00168Dr 2  AD 39 BB           LDA   MATH_RES1              ; cos result (signed 1.7)
001690r 2  4C rr rr           JMP   return_signed_byte
001693r 2               @err:
001693r 2  38                 SEC
001694r 2  60                 RTS
001695r 2               
001695r 2               ; ---------------------------------------------------------------------
001695r 2               ; do_abs — ABS n: return absolute value
001695r 2               ; ---------------------------------------------------------------------
001695r 2               do_abs:
001695r 2  20 rr rr           JSR   eval_expr
001698r 2  B0 22              BCS   @err
00169Ar 2  A5 rr              LDA   eval_val_hi
00169Cr 2  10 19              BPL   @done                  ; already positive
00169Er 2                     ; Negate 24-bit value
00169Er 2  A5 rr              LDA   eval_val_frac
0016A0r 2  49 FF              EOR   #$FF
0016A2r 2  18                 CLC
0016A3r 2  69 01              ADC   #1
0016A5r 2  85 rr              STA   eval_val_frac
0016A7r 2  A5 rr              LDA   eval_val_lo
0016A9r 2  49 FF              EOR   #$FF
0016ABr 2  69 00              ADC   #0
0016ADr 2  85 rr              STA   eval_val_lo
0016AFr 2  A5 rr              LDA   eval_val_hi
0016B1r 2  49 FF              EOR   #$FF
0016B3r 2  69 00              ADC   #0
0016B5r 2  85 rr              STA   eval_val_hi
0016B7r 2               @done:
0016B7r 2  64 rr              STZ   eval_type
0016B9r 2  4C rr rr           JMP   eval_continue
0016BCr 2               @err:
0016BCr 2  38                 SEC
0016BDr 2  60                 RTS
0016BEr 2               
0016BEr 2               ; ---------------------------------------------------------------------
0016BEr 2               ; do_int — INT n: truncate fractional part
0016BEr 2               ; ---------------------------------------------------------------------
0016BEr 2               do_int:
0016BEr 2  20 rr rr           JSR   eval_expr
0016C1r 2  B0 07              BCS   @err
0016C3r 2  64 rr              STZ   eval_val_frac
0016C5r 2  64 rr              STZ   eval_type
0016C7r 2  4C rr rr           JMP   eval_continue
0016CAr 2               @err:
0016CAr 2  38                 SEC
0016CBr 2  60                 RTS
0016CCr 2               
0016CCr 2               ; ---------------------------------------------------------------------
0016CCr 2               ; do_round — ROUND n: round to nearest integer
0016CCr 2               ; ---------------------------------------------------------------------
0016CCr 2               do_round:
0016CCr 2  20 rr rr           JSR   eval_expr
0016CFr 2  B0 19              BCS   @err
0016D1r 2  A5 rr              LDA   eval_val_frac
0016D3r 2  C9 80              CMP   #128
0016D5r 2  90 0C              BCC   @trunc
0016D7r 2                     ; Round up: increment integer part
0016D7r 2  A5 rr              LDA   eval_val_hi
0016D9r 2  10 02              BPL   @pos_round
0016DBr 2                     ; Negative: actually round toward zero = truncate
0016DBr 2  80 06              BRA   @trunc
0016DDr 2               @pos_round:
0016DDr 2  E6 rr              INC   eval_val_lo
0016DFr 2  D0 02              BNE   @trunc
0016E1r 2  E6 rr              INC   eval_val_hi
0016E3r 2               @trunc:
0016E3r 2  64 rr              STZ   eval_val_frac
0016E5r 2  64 rr              STZ   eval_type
0016E7r 2  4C rr rr           JMP   eval_continue
0016EAr 2               @err:
0016EAr 2  38                 SEC
0016EBr 2  60                 RTS
0016ECr 2               
0016ECr 2               ; ---------------------------------------------------------------------
0016ECr 2               ; do_random — RANDOM n: return random number 0..n-1
0016ECr 2               ;   Uses math coprocessor RNG + MUL16 to scale
0016ECr 2               ; ---------------------------------------------------------------------
0016ECr 2               do_random:
0016ECr 2  20 rr rr           JSR   eval_expr
0016EFr 2  B0 1D              BCS   @err
0016F1r 2                     ; RNG byte * n / 256 gives 0..n-1
0016F1r 2  AD 37 BB           LDA   MATH_RNG
0016F4r 2  8D 20 BB           STA   MATH_MUL16_A_LO
0016F7r 2  9C 21 BB           STZ   MATH_MUL16_A_HI
0016FAr 2  A5 rr              LDA   eval_val_lo
0016FCr 2  8D 22 BB           STA   MATH_MUL16_B_LO
0016FFr 2  A5 rr              LDA   eval_val_hi
001701r 2  8D 23 BB           STA   MATH_MUL16_B_HI       ; trigger
001704r 2  AD 39 BB           LDA   MATH_RES1              ; high byte of (rng * n) = rng*n/256
001707r 2  85 rr              STA   eval_val_lo
001709r 2  64 rr              STZ   eval_val_hi
00170Br 2  4C rr rr           JMP   return_number
00170Er 2               @err:
00170Er 2  38                 SEC
00170Fr 2  60                 RTS
001710r 2               
001710r 2               ; ---------------------------------------------------------------------
001710r 2               ; do_sqrt — SQRT n: approximate sqrt via DIST_APPROX(n, 0)
001710r 2               ; ---------------------------------------------------------------------
001710r 2               do_sqrt:
001710r 2  20 rr rr           JSR   eval_expr
001713r 2  B0 1D              BCS   @err
001715r 2  A5 rr              LDA   eval_val_lo
001717r 2  8D 33 BB           STA   MATH_DIST_DX_LO
00171Ar 2  A5 rr              LDA   eval_val_hi
00171Cr 2  8D 34 BB           STA   MATH_DIST_DX_HI
00171Fr 2  9C 35 BB           STZ   MATH_DIST_DY_LO
001722r 2  9C 36 BB           STZ   MATH_DIST_DY_HI       ; trigger (write to DY_HI triggers)
001725r 2  AD 38 BB           LDA   MATH_RES0
001728r 2  85 rr              STA   eval_val_lo
00172Ar 2  AD 39 BB           LDA   MATH_RES1
00172Dr 2  85 rr              STA   eval_val_hi
00172Fr 2  4C rr rr           JMP   return_number
001732r 2               @err:
001732r 2  38                 SEC
001733r 2  60                 RTS
001734r 2               
001734r 2               ; ---------------------------------------------------------------------
001734r 2               ; do_remainder — REMAINDER a b: return a mod b via DIV coprocessor
001734r 2               ; ---------------------------------------------------------------------
001734r 2               do_remainder:
001734r 2  20 rr rr           JSR   eval_expr              ; first arg (a)
001737r 2  B0 49              BCS   @err
001739r 2  A5 rr              LDA   eval_val_lo
00173Br 2  48                 PHA
00173Cr 2  A5 rr              LDA   eval_val_hi
00173Er 2  48                 PHA
00173Fr 2  20 rr rr           JSR   eval_expr              ; second arg (b)
001742r 2  B0 3C              BCS   @err_pop
001744r 2                     ; b in eval_val, a on stack
001744r 2                     ; Check divide by zero
001744r 2  A5 rr              LDA   eval_val_lo
001746r 2  05 rr              ORA   eval_val_hi
001748r 2  F0 2D              BEQ   @zero_pop
00174Ar 2                     ; Set up 32÷16 division: dividend=a, divisor=b
00174Ar 2  68                 PLA
00174Br 2  8D 29 BB           STA   MATH_DIV_N_1           ; a_hi
00174Er 2  AA                 TAX                          ; save for sign-extend
00174Fr 2  68                 PLA
001750r 2  8D 28 BB           STA   MATH_DIV_N_LO          ; a_lo
001753r 2                     ; Sign-extend a
001753r 2  8A                 TXA
001754r 2  09 7F              ORA   #$7F
001756r 2  30 02              BMI   @neg_a
001758r 2  A9 00              LDA   #$00
00175Ar 2               @neg_a:                            ; A=$FF if negative
00175Ar 2  8D 2A BB           STA   MATH_DIV_N_2
00175Dr 2  8D 2B BB           STA   MATH_DIV_N_HI
001760r 2  A5 rr              LDA   eval_val_lo
001762r 2  8D 2C BB           STA   MATH_DIV_D_LO
001765r 2  A5 rr              LDA   eval_val_hi
001767r 2  8D 2D BB           STA   MATH_DIV_D_HI          ; trigger
00176Ar 2                     ; Remainder is in RES2:RES3 (actually check what the copro returns)
00176Ar 2                     ; The math copro returns quotient in RES0:RES1, remainder in RES2:RES3
00176Ar 2  AD 3A BB           LDA   MATH_RES2
00176Dr 2  85 rr              STA   eval_val_lo
00176Fr 2  AD 3B BB           LDA   MATH_RES3
001772r 2  85 rr              STA   eval_val_hi
001774r 2  4C rr rr           JMP   return_number
001777r 2               @zero_pop:
001777r 2  68                 PLA
001778r 2  68                 PLA
001779r 2  64 rr              STZ   eval_val_lo
00177Br 2  64 rr              STZ   eval_val_hi
00177Dr 2  4C rr rr           JMP   return_number
001780r 2               @err_pop:
001780r 2  68                 PLA
001781r 2  68                 PLA
001782r 2               @err:
001782r 2  38                 SEC
001783r 2  60                 RTS
001784r 2               
001784r 2               ; ---------------------------------------------------------------------
001784r 2               ; do_not — NOT expr: return 1 if expr is 0, else 0
001784r 2               ; ---------------------------------------------------------------------
001784r 2               do_not:
001784r 2  20 rr rr           JSR   eval_expr
001787r 2  B0 13              BCS   @err
001789r 2  A5 rr              LDA   eval_val_lo
00178Br 2  05 rr              ORA   eval_val_hi
00178Dr 2                     ; If zero, set result to 1. If nonzero, set to 0.
00178Dr 2  D0 06              BNE   @false
00178Fr 2  A9 01              LDA   #1
001791r 2  85 rr              STA   eval_val_lo
001793r 2  80 02              BRA   @done
001795r 2               @false:
001795r 2  64 rr              STZ   eval_val_lo
001797r 2               @done:
001797r 2  64 rr              STZ   eval_val_hi
001799r 2  4C rr rr           JMP   return_number
00179Cr 2               @err:
00179Cr 2  38                 SEC
00179Dr 2  60                 RTS
00179Er 2               
00179Er 2               ; ---------------------------------------------------------------------
00179Er 2               ; do_and — AND a b: return 1 if both nonzero, else 0
00179Er 2               ; ---------------------------------------------------------------------
00179Er 2               do_and:
00179Er 2  20 rr rr           JSR   eval_expr
0017A1r 2  B0 1E              BCS   @err
0017A3r 2  A5 rr              LDA   eval_val_lo
0017A5r 2  05 rr              ORA   eval_val_hi
0017A7r 2  F0 11              BEQ   @false                 ; first arg is 0 → short-circuit
0017A9r 2  20 rr rr           JSR   eval_expr
0017ACr 2  B0 13              BCS   @err
0017AEr 2  A5 rr              LDA   eval_val_lo
0017B0r 2  05 rr              ORA   eval_val_hi
0017B2r 2  F0 06              BEQ   @false
0017B4r 2  A9 01              LDA   #1
0017B6r 2  85 rr              STA   eval_val_lo
0017B8r 2  80 02              BRA   @done
0017BAr 2               @false:
0017BAr 2  64 rr              STZ   eval_val_lo
0017BCr 2               @done:
0017BCr 2  64 rr              STZ   eval_val_hi
0017BEr 2  4C rr rr           JMP   return_number
0017C1r 2               @err:
0017C1r 2  38                 SEC
0017C2r 2  60                 RTS
0017C3r 2               
0017C3r 2               ; ---------------------------------------------------------------------
0017C3r 2               ; do_or — OR a b: return 1 if either nonzero, else 0
0017C3r 2               ; ---------------------------------------------------------------------
0017C3r 2               do_or:
0017C3r 2  20 rr rr           JSR   eval_expr
0017C6r 2  B0 1E              BCS   @err
0017C8r 2  A5 rr              LDA   eval_val_lo
0017CAr 2  05 rr              ORA   eval_val_hi
0017CCr 2  D0 0F              BNE   @true                  ; first arg nonzero → short-circuit
0017CEr 2  20 rr rr           JSR   eval_expr
0017D1r 2  B0 13              BCS   @err
0017D3r 2  A5 rr              LDA   eval_val_lo
0017D5r 2  05 rr              ORA   eval_val_hi
0017D7r 2  D0 04              BNE   @true
0017D9r 2  64 rr              STZ   eval_val_lo
0017DBr 2  80 04              BRA   @done
0017DDr 2               @true:
0017DDr 2  A9 01              LDA   #1
0017DFr 2  85 rr              STA   eval_val_lo
0017E1r 2               @done:
0017E1r 2  64 rr              STZ   eval_val_hi
0017E3r 2  4C rr rr           JMP   return_number
0017E6r 2               @err:
0017E6r 2  38                 SEC
0017E7r 2  60                 RTS
0017E8r 2               
0017E8r 2               ; ---------------------------------------------------------------------
0017E8r 2               ; Type predicates — NUMBER?, WORD?, LIST?
0017E8r 2               ; ---------------------------------------------------------------------
0017E8r 2               do_numberp:
0017E8r 2  20 rr rr           JSR   eval_expr
0017EBr 2  B0 07              BCS   @err
0017EDr 2  A5 rr              LDA   eval_type
0017EFr 2  C9 00              CMP   #VAL_NUMBER
0017F1r 2  4C rr rr           JMP   predicate_result
0017F4r 2               @err:
0017F4r 2  38                 SEC
0017F5r 2  60                 RTS
0017F6r 2               
0017F6r 2               do_wordp:
0017F6r 2  20 rr rr           JSR   eval_expr
0017F9r 2  B0 07              BCS   @err
0017FBr 2  A5 rr              LDA   eval_type
0017FDr 2  C9 01              CMP   #VAL_WORD
0017FFr 2  4C rr rr           JMP   predicate_result
001802r 2               @err:
001802r 2  38                 SEC
001803r 2  60                 RTS
001804r 2               
001804r 2               do_listp:
001804r 2  20 rr rr           JSR   eval_expr
001807r 2  B0 07              BCS   @err
001809r 2  A5 rr              LDA   eval_type
00180Br 2  C9 02              CMP   #VAL_LIST
00180Dr 2  4C rr rr           JMP   predicate_result
001810r 2               @err:
001810r 2  38                 SEC
001811r 2  60                 RTS
001812r 2               
