002579r 2  6D rr rr           ADC   num_val_hi
00257Cr 2  8D rr rr           STA   num_val_hi
00257Fr 2  AD rr rr           LDA   num_val_hi
002582r 2  F0 09              BEQ   @rn_done                ; skip trailing zero
002584r 2  09 30              ORA   #'0'
002586r 2  A6 rr              LDX   z:buf_idx
002588r 2  9D rr rr           STA   input_buf,X
00258Br 2  E6 rr              INC   z:buf_idx
00258Dr 2               @rn_done:
00258Dr 2  60                 RTS
00258Er 2               
00258Er 2               ; =====================================================================
00258Er 2               ; RODATA — list error strings
00258Er 2               ; =====================================================================
00258Er 2                     .segment "RODATA"
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               ; Builtin name strings for list operations
0005B9r 2               str_first_name:
0005B9r 2  05 46 49 52        .byte 5, "FIRST"
0005BDr 2  53 54        
0005BFr 2               str_butfirst_name:
0005BFr 2  08 42 55 54        .byte 8, "BUTFIRST"
0005C3r 2  46 49 52 53  
0005C7r 2  54           
0005C8r 2               str_bf_name:
0005C8r 2  02 42 46           .byte 2, "BF"
0005CBr 2               str_count_name:
0005CBr 2  05 43 4F 55        .byte 5, "COUNT"
0005CFr 2  4E 54        
0005D1r 2               str_emptyp_name:
0005D1r 2  06 45 4D 50        .byte 6, "EMPTY?"
0005D5r 2  54 59 3F     
0005D8r 2               str_last_name:
0005D8r 2  04 4C 41 53        .byte 4, "LAST"
0005DCr 2  54           
0005DDr 2               str_butlast_name:
0005DDr 2  07 42 55 54        .byte 7, "BUTLAST"
0005E1r 2  4C 41 53 54  
0005E5r 2               str_bl_name:
0005E5r 2  02 42 4C           .byte 2, "BL"
0005E8r 2               str_item_name:
0005E8r 2  04 49 54 45        .byte 4, "ITEM"
0005ECr 2  4D           
0005EDr 2               str_memberp_name:
0005EDr 2  07 4D 45 4D        .byte 7, "MEMBER?"
0005F1r 2  42 45 52 3F  
0005F5r 2               str_show_name:
0005F5r 2  04 53 48 4F        .byte 4, "SHOW"
0005F9r 2  57           
0005FAr 2               str_fput_name:
0005FAr 2  04 46 50 55        .byte 4, "FPUT"
0005FEr 2  54           
0005FFr 2               str_lput_name:
0005FFr 2  04 4C 50 55        .byte 4, "LPUT"
000603r 2  54           
000604r 2               str_list_name:
000604r 2  04 4C 49 53        .byte 4, "LIST"
000608r 2  54           
000609r 2               str_sentence_name:
000609r 2  08 53 45 4E        .byte 8, "SENTENCE"
00060Dr 2  54 45 4E 43  
000611r 2  45           
000612r 2               str_se_name:
000612r 2  02 53 45           .byte 2, "SE"
000615r 2               str_word_name:
000615r 2  04 57 4F 52        .byte 4, "WORD"
000619r 2  44           
00061Ar 2               str_run_name:
00061Ar 2  03 52 55 4E        .byte 3, "RUN"
00061Er 2               
00061Er 1                     .include "vars.s"
00061Er 2               ; vars.s — variable storage for NovaLogo (MAKE / :reference)
00061Er 2               ;
00061Er 2               ; Variables are stored as a linked list of heap entries.
00061Er 2               ; Entry layout:
00061Er 2               ;   +0: next_lo  (2 bytes — pointer to next entry, or $0000)
00061Er 2               ;   +1: next_hi
00061Er 2               ;   +2: name_len (1 byte)
00061Er 2               ;   +3: name chars (name_len bytes, uppercased)
00061Er 2               ;   +3+name_len: value_type (1 byte: $00=number, $01=word)
00061Er 2               ;   +4+name_len: val_hi  (or ptr_lo for word)
00061Er 2               ;   +5+name_len: val_lo  (or ptr_hi for word)
00061Er 2               ;   +6+name_len: val_frac (0 for word)
00061Er 2               ;   +7+name_len: pad     (0)
00061Er 2               ;
00061Er 2               ; Total entry size = 8 + name_len bytes.
00061Er 2               
00061Er 2               ; Entry field offsets (relative to entry base)
00061Er 2               VAR_NEXT_LO  = 0
00061Er 2               VAR_NEXT_HI  = 1
00061Er 2               VAR_NAME_LEN = 2
00061Er 2               VAR_NAME     = 3              ; first char of name
00061Er 2               
00061Er 2               ; =====================================================================
00061Er 2               ; ZEROPAGE segment — variable list head + scratch
00061Er 2               ; =====================================================================
00061Er 2                     .segment "ZEROPAGE"
000037r 2               
000037r 2  xx           var_head_lo:    .res 1        ; head of variable linked list
000038r 2  xx           var_head_hi:    .res 1
000039r 2  xx           var_entry_lo:   .res 1        ; current entry pointer (walk scratch)
00003Ar 2  xx           var_entry_hi:   .res 1
00003Br 2  xx           var_name_lo:    .res 1        ; saved name pointer for set/get
00003Cr 2  xx           var_name_hi:    .res 1
00003Dr 2               
00003Dr 2               ; =====================================================================
00003Dr 2               ; CODE segment — variable routines
00003Dr 2               ; =====================================================================
00003Dr 2                     .segment "CODE"
00258Er 2               
00258Er 2               ; ---------------------------------------------------------------------
00258Er 2               ; var_init — initialize variable list to empty
00258Er 2               ;   Called once at cold_start
00258Er 2               ; ---------------------------------------------------------------------
00258Er 2               var_init:
00258Er 2  64 rr              STZ   var_head_lo
002590r 2  64 rr              STZ   var_head_hi
002592r 2  60                 RTS
002593r 2               
002593r 2               ; ---------------------------------------------------------------------
002593r 2               ; var_set — store a value under a variable name
002593r 2               ;   Input: ptr_lo/hi → length-prefixed name string (in token node)
002593r 2               ;          eval_type, eval_val_hi/lo/frac = value to store
002593r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, var_entry, var_name
002593r 2               ; ---------------------------------------------------------------------
002593r 2               var_set:
002593r 2                     ; Save name pointer — we need it after the walk
002593r 2  A5 rr              LDA   ptr_lo
002595r 2  85 rr              STA   var_name_lo
002597r 2  A5 rr              LDA   ptr_hi
002599r 2  85 rr              STA   var_name_hi
00259Br 2               
00259Br 2                     ; Walk the list looking for an existing entry with this name
00259Br 2  A5 rr              LDA   var_head_lo
00259Dr 2  85 rr              STA   var_entry_lo
00259Fr 2  A5 rr              LDA   var_head_hi
0025A1r 2  85 rr              STA   var_entry_hi
0025A3r 2               
0025A3r 2               @walk:
0025A3r 2                     ; End of list?
0025A3r 2  A5 rr              LDA   var_entry_lo
0025A5r 2  05 rr              ORA   var_entry_hi
0025A7r 2  F0 44              BEQ   @not_found
0025A9r 2               
0025A9r 2                     ; Compare name in entry against var_name
0025A9r 2  20 rr rr           JSR   var_names_equal
0025ACr 2  B0 16              BCS   @found
0025AEr 2               
0025AEr 2                     ; Advance to next entry
0025AEr 2  A5 rr              LDA   var_entry_lo
0025B0r 2  85 rr              STA   ptr2_lo
0025B2r 2  A5 rr              LDA   var_entry_hi
0025B4r 2  85 rr              STA   ptr2_hi
0025B6r 2  A0 00              LDY   #VAR_NEXT_LO
0025B8r 2  B1 rr              LDA   (ptr2_lo),Y
0025BAr 2  AA                 TAX
0025BBr 2  C8                 INY
0025BCr 2  B1 rr              LDA   (ptr2_lo),Y
0025BEr 2  85 rr              STA   var_entry_hi
0025C0r 2  86 rr              STX   var_entry_lo
0025C2r 2  80 DF              BRA   @walk
0025C4r 2               
0025C4r 2               @found:
0025C4r 2                     ; Overwrite value in place
0025C4r 2                     ; Value starts at entry + 3 + name_len
0025C4r 2  A5 rr              LDA   var_entry_lo
0025C6r 2  85 rr              STA   ptr2_lo
0025C8r 2  A5 rr              LDA   var_entry_hi
0025CAr 2  85 rr              STA   ptr2_hi
0025CCr 2  A0 02              LDY   #VAR_NAME_LEN
0025CEr 2  B1 rr              LDA   (ptr2_lo),Y          ; name_len
0025D0r 2  18                 CLC
0025D1r 2  69 03              ADC   #VAR_NAME             ; A = 3 + name_len = offset to value_type
0025D3r 2  A8                 TAY
0025D4r 2  A5 rr              LDA   eval_type
0025D6r 2  91 rr              STA   (ptr2_lo),Y
0025D8r 2  C8                 INY
0025D9r 2  A5 rr              LDA   eval_val_hi
0025DBr 2  91 rr              STA   (ptr2_lo),Y
0025DDr 2  C8                 INY
0025DEr 2  A5 rr              LDA   eval_val_lo
0025E0r 2  91 rr              STA   (ptr2_lo),Y
0025E2r 2  C8                 INY
0025E3r 2  A5 rr              LDA   eval_val_frac
0025E5r 2  91 rr              STA   (ptr2_lo),Y
0025E7r 2  C8                 INY
0025E8r 2  A9 00              LDA   #0
0025EAr 2  91 rr              STA   (ptr2_lo),Y          ; pad
0025ECr 2  60                 RTS
0025EDr 2               
0025EDr 2               @not_found:
0025EDr 2                     ; Allocate a new entry: 8 + name_len bytes
0025EDr 2                     ; Read name_len from the name string
0025EDr 2  A5 rr              LDA   var_name_lo
0025EFr 2  85 rr              STA   ptr_lo
0025F1r 2  A5 rr              LDA   var_name_hi
0025F3r 2  85 rr              STA   ptr_hi
0025F5r 2  A0 00              LDY   #0
0025F7r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
0025F9r 2  48                 PHA                         ; save name_len
0025FAr 2  18                 CLC
0025FBr 2  69 08              ADC   #8                    ; total entry size
0025FDr 2  A2 03              LDX   #ATYPE_VAR
0025FFr 2  20 rr rr           JSR   heap_alloc
002602r 2  B0 62              BCS   @oom
002604r 2               
002604r 2                     ; ptr_lo/hi now points to new entry
002604r 2                     ; Set next → current head
002604r 2  A0 00              LDY   #VAR_NEXT_LO
002606r 2  A5 rr              LDA   var_head_lo
002608r 2  91 rr              STA   (ptr_lo),Y
00260Ar 2  C8                 INY
00260Br 2  A5 rr              LDA   var_head_hi
00260Dr 2  91 rr              STA   (ptr_lo),Y
00260Fr 2               
00260Fr 2                     ; Copy name_len
00260Fr 2  68                 PLA                         ; A = name_len
002610r 2  48                 PHA                         ; keep it on stack
002611r 2  A0 02              LDY   #VAR_NAME_LEN
002613r 2  91 rr              STA   (ptr_lo),Y
002615r 2               
002615r 2                     ; Copy name chars (uppercased) from var_name source
002615r 2  68                 PLA                         ; A = name_len
002616r 2  AA                 TAX                         ; X = remaining chars
002617r 2  F0 2C              BEQ   @name_done            ; zero-length name (shouldn't happen)
002619r 2  A0 03              LDY   #VAR_NAME             ; dest offset in entry
00261Br 2  9C rr rr           STZ   num_tmp_lo            ; source offset counter
00261Er 2               
00261Er 2               @copy_name:
00261Er 2  DA                 PHX
00261Fr 2  5A                 PHY
002620r 2                     ; Read source char
002620r 2  A5 rr              LDA   var_name_lo
002622r 2  85 rr              STA   ptr2_lo
002624r 2  A5 rr              LDA   var_name_hi
002626r 2  85 rr              STA   ptr2_hi
002628r 2  AD rr rr           LDA   num_tmp_lo
00262Br 2  1A                 INC                         ; skip length byte → offset = idx + 1
00262Cr 2  A8                 TAY
00262Dr 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
00262Fr 2                     ; Uppercase
00262Fr 2  C9 61              CMP   #'a'
002631r 2  90 07              BCC   @noup
002633r 2  C9 7B              CMP   #'z'+1
002635r 2  B0 03              BCS   @noup
002637r 2  38                 SEC
002638r 2  E9 20              SBC   #$20
00263Ar 2               @noup:
00263Ar 2  7A                 PLY                         ; restore dest offset
00263Br 2  91 rr              STA   (ptr_lo),Y           ; write to entry
00263Dr 2  C8                 INY
00263Er 2  EE rr rr           INC   num_tmp_lo
002641r 2  FA                 PLX
002642r 2  CA                 DEX
002643r 2  D0 D9              BNE   @copy_name
002645r 2               
002645r 2               @name_done:
002645r 2                     ; Write value after name
002645r 2                     ; Y is already at VAR_NAME + name_len = value_type offset
002645r 2  A5 rr              LDA   eval_type
002647r 2  91 rr              STA   (ptr_lo),Y
002649r 2  C8                 INY
00264Ar 2  A5 rr              LDA   eval_val_hi
00264Cr 2  91 rr              STA   (ptr_lo),Y
00264Er 2  C8                 INY
00264Fr 2  A5 rr              LDA   eval_val_lo
002651r 2  91 rr              STA   (ptr_lo),Y
002653r 2  C8                 INY
002654r 2  A5 rr              LDA   eval_val_frac
002656r 2  91 rr              STA   (ptr_lo),Y
002658r 2  C8                 INY
002659r 2  A9 00              LDA   #0
00265Br 2  91 rr              STA   (ptr_lo),Y           ; pad
00265Dr 2               
00265Dr 2                     ; Prepend to list: head = new entry
00265Dr 2  A5 rr              LDA   ptr_lo
00265Fr 2  85 rr              STA   var_head_lo
002661r 2  A5 rr              LDA   ptr_hi
002663r 2  85 rr              STA   var_head_hi
002665r 2  60                 RTS
002666r 2               
002666r 2               @oom:
002666r 2  68                 PLA                         ; discard saved name_len
002667r 2  60                 RTS
002668r 2               
002668r 2               ; ---------------------------------------------------------------------
002668r 2               ; var_get — look up a variable by name
002668r 2               ;   Input: ptr_lo/hi → length-prefixed name string
002668r 2               ;   Output: Carry clear = found, eval_type/eval_val set
002668r 2               ;           Carry set = not found
002668r 2               ;   Clobbers: A, X, Y, ptr2, var_entry, var_name
002668r 2               ; ---------------------------------------------------------------------
002668r 2               var_get:
002668r 2                     ; Save name pointer
002668r 2  A5 rr              LDA   ptr_lo
00266Ar 2  85 rr              STA   var_name_lo
00266Cr 2  A5 rr              LDA   ptr_hi
00266Er 2  85 rr              STA   var_name_hi
002670r 2               
002670r 2                     ; Walk the list
002670r 2  A5 rr              LDA   var_head_lo
002672r 2  85 rr              STA   var_entry_lo
002674r 2  A5 rr              LDA   var_head_hi
002676r 2  85 rr              STA   var_entry_hi
002678r 2               
002678r 2               @walk:
002678r 2  A5 rr              LDA   var_entry_lo
00267Ar 2  05 rr              ORA   var_entry_hi
00267Cr 2  F0 40              BEQ   @not_found
00267Er 2               
00267Er 2  20 rr rr           JSR   var_names_equal
002681r 2  B0 16              BCS   @found
002683r 2               
002683r 2                     ; Advance to next
002683r 2  A5 rr              LDA   var_entry_lo
002685r 2  85 rr              STA   ptr2_lo
002687r 2  A5 rr              LDA   var_entry_hi
002689r 2  85 rr              STA   ptr2_hi
00268Br 2  A0 00              LDY   #VAR_NEXT_LO
00268Dr 2  B1 rr              LDA   (ptr2_lo),Y
00268Fr 2  AA                 TAX
002690r 2  C8                 INY
002691r 2  B1 rr              LDA   (ptr2_lo),Y
002693r 2  85 rr              STA   var_entry_hi
002695r 2  86 rr              STX   var_entry_lo
002697r 2  80 DF              BRA   @walk
002699r 2               
002699r 2               @found:
002699r 2                     ; Read value from entry + 3 + name_len
002699r 2  A5 rr              LDA   var_entry_lo
00269Br 2  85 rr              STA   ptr2_lo
00269Dr 2  A5 rr              LDA   var_entry_hi
00269Fr 2  85 rr              STA   ptr2_hi
0026A1r 2  A0 02              LDY   #VAR_NAME_LEN
0026A3r 2  B1 rr              LDA   (ptr2_lo),Y
0026A5r 2  18                 CLC
0026A6r 2  69 03              ADC   #VAR_NAME
0026A8r 2  A8                 TAY
0026A9r 2  B1 rr              LDA   (ptr2_lo),Y          ; value_type
0026ABr 2  85 rr              STA   eval_type
0026ADr 2  C8                 INY
0026AEr 2  B1 rr              LDA   (ptr2_lo),Y          ; val_hi
0026B0r 2  85 rr              STA   eval_val_hi
0026B2r 2  C8                 INY
0026B3r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_lo
0026B5r 2  85 rr              STA   eval_val_lo
0026B7r 2  C8                 INY
0026B8r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_frac
0026BAr 2  85 rr              STA   eval_val_frac
0026BCr 2  18                 CLC
0026BDr 2  60                 RTS
0026BEr 2               
0026BEr 2               @not_found:
0026BEr 2  38                 SEC
0026BFr 2  60                 RTS
0026C0r 2               
0026C0r 2               ; ---------------------------------------------------------------------
0026C0r 2               ; var_names_equal — compare name at var_name_lo/hi against entry at var_entry
0026C0r 2               ;   The name source is length-prefixed (from token / quote).
0026C0r 2               ;   The entry stores: name_len at +2, chars at +3 (already uppercased).
0026C0r 2               ;   The source name chars are uppercased during comparison.
0026C0r 2               ;   Returns: Carry set = equal, Carry clear = not equal
0026C0r 2               ;   Clobbers: A, X, Y, ptr2
0026C0r 2               ; ---------------------------------------------------------------------
0026C0r 2               var_names_equal:
0026C0r 2                     ; Read source name length
0026C0r 2  A5 rr              LDA   var_name_lo
0026C2r 2  85 rr              STA   ptr2_lo
0026C4r 2  A5 rr              LDA   var_name_hi
0026C6r 2  85 rr              STA   ptr2_hi
0026C8r 2  A0 00              LDY   #0
0026CAr 2  B1 rr              LDA   (ptr2_lo),Y          ; source name_len
0026CCr 2  AA                 TAX                         ; X = source name_len
0026CDr 2               
0026CDr 2                     ; Read entry name length
0026CDr 2  A5 rr              LDA   var_entry_lo
0026CFr 2  85 rr              STA   ptr2_lo
0026D1r 2  A5 rr              LDA   var_entry_hi
0026D3r 2  85 rr              STA   ptr2_hi
0026D5r 2  A0 02              LDY   #VAR_NAME_LEN
0026D7r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry name_len
0026D9r 2               
0026D9r 2                     ; Compare lengths
0026D9r 2  8E rr rr           STX   num_tmp_lo            ; save source length
0026DCr 2  CD rr rr           CMP   num_tmp_lo
0026DFr 2  D0 43              BNE   @ne
0026E1r 2               
0026E1r 2                     ; Lengths match — compare chars
0026E1r 2  E0 00              CPX   #0
0026E3r 2  F0 3B              BEQ   @eq                   ; both zero-length — equal
0026E5r 2  A0 00              LDY   #0                    ; char index
0026E7r 2               
0026E7r 2               @cmp_loop:
0026E7r 2  DA                 PHX
0026E8r 2  5A                 PHY
0026E9r 2                     ; Read source char (var_name + 1 + Y)
0026E9r 2  A5 rr              LDA   var_name_lo
0026EBr 2  85 rr              STA   ptr2_lo
0026EDr 2  A5 rr              LDA   var_name_hi
0026EFr 2  85 rr              STA   ptr2_hi
0026F1r 2  98                 TYA
0026F2r 2  1A                 INC                         ; skip length byte
0026F3r 2  A8                 TAY
0026F4r 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
0026F6r 2                     ; Uppercase it
0026F6r 2  C9 61              CMP   #'a'
0026F8r 2  90 07              BCC   @noup
0026FAr 2  C9 7B              CMP   #'z'+1
0026FCr 2  B0 03              BCS   @noup
0026FEr 2  38                 SEC
0026FFr 2  E9 20              SBC   #$20
002701r 2               @noup:
002701r 2  8D rr rr           STA   num_tmp_hi            ; temp: uppercased source char
002704r 2               
002704r 2                     ; Read entry char (var_entry + VAR_NAME + Y)
002704r 2  7A                 PLY                         ; restore char index
002705r 2  5A                 PHY
002706r 2  A5 rr              LDA   var_entry_lo
002708r 2  85 rr              STA   ptr2_lo
00270Ar 2  A5 rr              LDA   var_entry_hi
00270Cr 2  85 rr              STA   ptr2_hi
00270Er 2  98                 TYA
00270Fr 2  18                 CLC
002710r 2  69 03              ADC   #VAR_NAME
002712r 2  A8                 TAY
002713r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry char (already uppercase)
002715r 2               
002715r 2  CD rr rr           CMP   num_tmp_hi
002718r 2                     ; 65C02: PLY/PLX clobber flags! Must branch BEFORE pulling.
002718r 2  D0 08              BNE   @ne_pull
00271Ar 2               
00271Ar 2  7A                 PLY
00271Br 2  FA                 PLX
00271Cr 2  C8                 INY
00271Dr 2  CA                 DEX
00271Er 2  D0 C7              BNE   @cmp_loop
002720r 2               
002720r 2               @eq:
002720r 2  38                 SEC                         ; equal
002721r 2  60                 RTS
002722r 2               
002722r 2               @ne_pull:
002722r 2  7A                 PLY                         ; clean up stack
002723r 2  FA                 PLX
002724r 2               @ne:
002724r 2  18                 CLC                         ; not equal
002725r 2  60                 RTS
002726r 2               
002726r 1                     .include "procedures.s"
002726r 2               ; procedures.s — user-defined procedure storage and invocation
002726r 2               ;
002726r 2               ; Procedure record layout (heap-allocated linked list):
002726r 2               ;   +0: next_lo
002726r 2               ;   +1: next_hi    (pointer to next procedure, or $0000)
002726r 2               ;   +2: name_len   (1 byte)
002726r 2               ;   +3..3+NL-1: name chars (uppercased)
002726r 2               ;   +3+NL: param_count (1 byte)
002726r 2               ;   For each param:
002726r 2               ;     1 byte: param_name_len
002726r 2               ;     N bytes: param_name chars (uppercased)
002726r 2               ;   After all params:
002726r 2               ;     2 bytes: body_len_lo, body_len_hi (16-bit)
002726r 2               ;     body_len bytes: body text (lines separated by $0A)
002726r 2               
002726r 2               ; =====================================================================
002726r 2               ; ZEROPAGE segment — procedure variables
002726r 2               ; =====================================================================
002726r 2                     .segment "ZEROPAGE"
00003Dr 2               
00003Dr 2  xx           proc_head_lo:     .res 1        ; head of procedure directory
00003Er 2  xx           proc_head_hi:     .res 1
00003Fr 2  xx           proc_entry_lo:    .res 1        ; current entry pointer (walk scratch)
000040r 2  xx           proc_entry_hi:    .res 1
000041r 2  xx           proc_ptr_lo:      .res 1        ; scratch pointer for proc operations
000042r 2  xx           proc_ptr_hi:      .res 1
000043r 2  xx           proc_body_len_lo: .res 1        ; body length during collection / invocation
000044r 2  xx           proc_body_len_hi: .res 1
000045r 2  xx           proc_param_cnt:   .res 1        ; param count during define / invoke
000046r 2  xx           proc_name_len:    .res 1        ; name length scratch
000047r 2  xx           proc_rec_off:     .res 1        ; offset into record during invoke
000048r 2               
000048r 2               ; =====================================================================
000048r 2               ; BSS segment — temporary buffers
000048r 2               ; =====================================================================
000048r 2                     .segment "BSS"
00000Fr 2               
00000Fr 2  xx xx xx xx  proc_body_buf:    .res 2048     ; editor text buffer: "TO ..\n<body>\nEND\n"
000013r 2  xx xx xx xx  
000017r 2  xx xx xx xx  
00080Fr 2  xx xx xx xx  proc_name_buf:    .res 32       ; procedure name: length-prefixed
000813r 2  xx xx xx xx  
000817r 2  xx xx xx xx  
00082Fr 2  xx xx xx xx  proc_param_buf:   .res 128      ; packed: count, [len,chars]... each param
000833r 2  xx xx xx xx  
000837r 2  xx xx xx xx  
0008AFr 2  xx           proc_param_end:   .res 1        ; write offset into proc_param_buf
0008B0r 2  xx xx xx xx  proc_editor_title:.res 36       ; "TO <name>" + NUL, passed to the shared editor
0008B4r 2  xx xx xx xx  
0008B8r 2  xx xx xx xx  
0008D4r 2  xx           proc_body_src_lo: .res 1        ; pointer to the body text proc_build_record copies
0008D5r 2  xx           proc_body_src_hi: .res 1
0008D6r 2  xx           proc_edit_cur_lo: .res 1        ; initial editor cursor offset (start of body line)
0008D7r 2  xx           proc_edit_cur_hi: .res 1
0008D8r 2  xx           proc_scan_off_lo: .res 1        ; 16-bit scan offset for body extraction
0008D9r 2  xx           proc_scan_off_hi: .res 1
0008DAr 2  xx           proc_brk_depth:   .res 1        ; bracket/paren nesting depth while accumulating a statement
0008DBr 2  xx           proc_tmp:         .res 1        ; scratch byte (EDIT record→buffer copy)
0008DCr 2               
0008DCr 2               ; Save area for eval state during procedure invocation
0008DCr 2  xx           save_eval_cur_lo: .res 1
0008DDr 2  xx           save_eval_cur_hi: .res 1
0008DEr 2  xx           save_tok_head_lo: .res 1
0008DFr 2  xx           save_tok_head_hi: .res 1
0008E0r 2  xx           save_tok_tail_lo: .res 1
0008E1r 2  xx           save_tok_tail_hi: .res 1
0008E2r 2  xx xx xx xx  save_input_buf:   .res 128      ; save outer input_buf during proc body exec
0008E6r 2  xx xx xx xx  
0008EAr 2  xx xx xx xx  
000962r 2  xx           save_heap_ptr_lo: .res 1        ; save heap for token re-use
000963r 2  xx           save_heap_ptr_hi: .res 1
000964r 2               
000964r 2               ; Param-binding scratch: length-prefixed name built here for var_set
000964r 2  xx xx xx xx  param_name_tmp:   .res 32
000968r 2  xx xx xx xx  
00096Cr 2  xx xx xx xx  
000984r 2               
000984r 2               ; =====================================================================
000984r 2               ; CODE segment — procedure routines
000984r 2               ; =====================================================================
000984r 2                     .segment "CODE"
002726r 2               
002726r 2               ; ---------------------------------------------------------------------
002726r 2               ; proc_init — initialize procedure directory to empty
002726r 2               ; ---------------------------------------------------------------------
002726r 2               proc_init:
002726r 2  64 rr              STZ   proc_head_lo
002728r 2  64 rr              STZ   proc_head_hi
00272Ar 2  64 rr              STZ   proc_stopped
00272Cr 2  60                 RTS
00272Dr 2               
00272Dr 2               ; ---------------------------------------------------------------------
00272Dr 2               ; proc_collect — enter TO/END multi-line collection mode
00272Dr 2               ;   Called from main_loop after detecting TO as first token.
00272Dr 2               ;   eval_cur_lo/hi has been advanced past the TO token.
00272Dr 2               ; ---------------------------------------------------------------------
00272Dr 2               proc_collect:
00272Dr 2                     ; Next token should be the procedure name (TOK_WORD)
00272Dr 2  A5 rr              LDA   eval_cur_lo
00272Fr 2  05 rr              ORA   eval_cur_hi
002731r 2  D0 03              BNE   @have_name
002733r 2  4C rr rr           JMP   @err_noname
002736r 2               @have_name:
002736r 2  A5 rr              LDA   eval_cur_lo
002738r 2  85 rr              STA   ptr_lo
00273Ar 2  A5 rr              LDA   eval_cur_hi
00273Cr 2  85 rr              STA   ptr_hi
00273Er 2  A0 00              LDY   #TOK_TAG
002740r 2  B1 rr              LDA   (ptr_lo),Y
002742r 2  C9 01              CMP   #TOK_WORD
002744r 2  F0 03              BEQ   @name_ok
002746r 2  4C rr rr           JMP   @err_noname
002749r 2               @name_ok:
002749r 2                     ; Copy procedure name to proc_name_buf (length-prefixed)
002749r 2  A0 03              LDY   #TOK_PAYLOAD
00274Br 2  B1 rr              LDA   (ptr_lo),Y           ; name length
00274Dr 2  8D rr rr           STA   proc_name_buf
002750r 2  85 rr              STA   proc_name_len
002752r 2  AA                 TAX                         ; X = char count
002753r 2  A0 04              LDY   #TOK_PAYLOAD+1
002755r 2  A9 00              LDA   #0
002757r 2  85 rr              STA   proc_rec_off          ; dest index in name_buf
002759r 2               @copy_name:
002759r 2  E0 00              CPX   #0
00275Br 2  F0 0F              BEQ   @name_copied
00275Dr 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased by tokenizer
00275Fr 2  5A                 PHY
002760r 2  A4 rr              LDY   proc_rec_off
002762r 2  99 rr rr           STA   proc_name_buf+1,Y
002765r 2  E6 rr              INC   proc_rec_off
002767r 2  7A                 PLY
002768r 2  C8                 INY
002769r 2  CA                 DEX
00276Ar 2  80 ED              BRA   @copy_name
00276Cr 2               @name_copied:
00276Cr 2               
00276Cr 2                     ; Advance past the name token
00276Cr 2  20 rr rr           JSR   eval_advance
00276Fr 2               
00276Fr 2                     ; Parse parameter names (TOK_VARREF tokens: :SIZE :COLOR etc.)
00276Fr 2  64 rr              STZ   proc_param_cnt
002771r 2  A9 01              LDA   #1                    ; dest offset (skip count byte at [0])
002773r 2  8D rr rr           STA   proc_param_end
002776r 2               
002776r 2               @parse_params:
002776r 2  A5 rr              LDA   eval_cur_lo
002778r 2  05 rr              ORA   eval_cur_hi
00277Ar 2  F0 47              BEQ   @params_done
00277Cr 2  A5 rr              LDA   eval_cur_lo
00277Er 2  85 rr              STA   ptr_lo
002780r 2  A5 rr              LDA   eval_cur_hi
002782r 2  85 rr              STA   ptr_hi
002784r 2  A0 00              LDY   #TOK_TAG
002786r 2  B1 rr              LDA   (ptr_lo),Y
002788r 2  C9 05              CMP   #TOK_VARREF
00278Ar 2  D0 37              BNE   @params_done
00278Cr 2               
00278Cr 2  E6 rr              INC   proc_param_cnt
00278Er 2  A0 03              LDY   #TOK_PAYLOAD
002790r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002792r 2  AE rr rr           LDX   proc_param_end
002795r 2  9D rr rr           STA   proc_param_buf,X     ; store length
002798r 2  E8                 INX
002799r 2  A8                 TAY                         ; Y = char count to copy
00279Ar 2  64 rr              STZ   proc_rec_off          ; source char index
00279Cr 2               
00279Cr 2               @copy_param_ch:
00279Cr 2  C0 00              CPY   #0
00279Er 2  F0 1B              BEQ   @param_ch_done
0027A0r 2                     ; Read source char from token
0027A0r 2  A5 rr              LDA   eval_cur_lo
0027A2r 2  85 rr              STA   ptr_lo
0027A4r 2  A5 rr              LDA   eval_cur_hi
0027A6r 2  85 rr              STA   ptr_hi
0027A8r 2  5A                 PHY
0027A9r 2  A5 rr              LDA   proc_rec_off
0027ABr 2  18                 CLC
0027ACr 2  69 04              ADC   #TOK_PAYLOAD+1
0027AEr 2  A8                 TAY
0027AFr 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased
0027B1r 2  7A                 PLY
0027B2r 2                     ; Write to proc_param_buf
0027B2r 2  9D rr rr           STA   proc_param_buf,X
0027B5r 2  E8                 INX
0027B6r 2  E6 rr              INC   proc_rec_off
0027B8r 2  88                 DEY
0027B9r 2  80 E1              BRA   @copy_param_ch
0027BBr 2               @param_ch_done:
0027BBr 2  8E rr rr           STX   proc_param_end
0027BEr 2               
0027BEr 2  20 rr rr           JSR   eval_advance
0027C1r 2  80 B3              BRA   @parse_params
0027C3r 2               
0027C3r 2               @params_done:
0027C3r 2  A5 rr              LDA   proc_param_cnt
0027C5r 2  8D rr rr           STA   proc_param_buf        ; count byte at [0]
0027C8r 2               
0027C8r 2                     ; Initialize body buffer
0027C8r 2  64 rr              STZ   proc_body_len_lo
0027CAr 2  64 rr              STZ   proc_body_len_hi
0027CCr 2               
0027CCr 2                     ; Open the shared EDITUI editor on an empty body buffer. Carry set means
0027CCr 2                     ; the user asked to save (Ctrl-S / "Save First") before exiting.
0027CCr 2  20 rr rr           JSR   proc_open_editor
0027CFr 2  B0 01              BCS   @body_done
0027D1r 2  60                 RTS
0027D2r 2               
0027D2r 2                     ; Print "NAME DEFINED\n"
0027D2r 2               @body_done:
0027D2r 2  20 rr rr           JSR   proc_print_defined
0027D5r 2  60                 RTS
0027D6r 2               
0027D6r 2               @err_noname:
0027D6r 2  20 rr rr           JSR   print_inl
0027D9r 2  54 4F 20 4E        .byte "TO NEEDS A NAME", 0
0027DDr 2  45 45 44 53  
0027E1r 2  20 41 20 4E  
0027E9r 2  20 rr rr           JSR   eval_newline
0027ECr 2  60                 RTS
0027EDr 2               
0027EDr 2               ; ---------------------------------------------------------------------
0027EDr 2               ; proc_print_defined — print "<name> DEFINED\n" (name from proc_name_buf).
0027EDr 2               ; ---------------------------------------------------------------------
0027EDr 2               proc_print_defined:
0027EDr 2  A6 rr              LDX   proc_name_len
0027EFr 2  A0 00              LDY   #0
0027F1r 2               @pn:
0027F1r 2  E0 00              CPX   #0
0027F3r 2  F0 0A              BEQ   @pd
0027F5r 2  B9 rr rr           LDA   proc_name_buf+1,Y
0027F8r 2  8D 0E A0           STA   VGC_CHAROUT
0027FBr 2  C8                 INY
0027FCr 2  CA                 DEX
0027FDr 2  80 F2              BRA   @pn
0027FFr 2               @pd:
0027FFr 2  20 rr rr           JSR   print_inl
002802r 2  20 44 45 46        .byte " DEFINED", 0
002806r 2  49 4E 45 44  
00280Ar 2  00           
00280Br 2  20 rr rr           JSR   eval_newline
00280Er 2  60                 RTS
00280Fr 2               
00280Fr 2               ; ---------------------------------------------------------------------
00280Fr 2               ; proc_build_header — write the "TO <name> :params" first line into
00280Fr 2               ;   proc_body_buf (no trailing newline). Built with 8-bit Y since the header
00280Fr 2               ;   is always < 256 bytes (name<=31, params<=127). Returns Y = header length.
00280Fr 2               ;   Inputs: proc_name_buf/proc_name_len, proc_param_buf/proc_param_end.
00280Fr 2               ; ---------------------------------------------------------------------
00280Fr 2               proc_build_header:
00280Fr 2  A0 00              LDY   #0
002811r 2  A9 54              LDA   #'T'
002813r 2  99 rr rr           STA   proc_body_buf,Y
002816r 2  C8                 INY
002817r 2  A9 4F              LDA   #'O'
002819r 2  99 rr rr           STA   proc_body_buf,Y
00281Cr 2  C8                 INY
00281Dr 2  A9 20              LDA   #' '
00281Fr 2  99 rr rr           STA   proc_body_buf,Y
002822r 2  C8                 INY
002823r 2  A2 00              LDX   #0                     ; name source index
002825r 2               @nm:
002825r 2  E4 rr              CPX   proc_name_len
002827r 2  B0 0A              BCS   @nm_done
002829r 2  BD rr rr           LDA   proc_name_buf+1,X
00282Cr 2  99 rr rr           STA   proc_body_buf,Y
00282Fr 2  C8                 INY
002830r 2  E8                 INX
002831r 2  80 F2              BRA   @nm
002833r 2               @nm_done:
002833r 2                     ; params: " :" + chars, walking proc_param_buf[1..proc_param_end)
002833r 2  A2 01              LDX   #1
002835r 2               @pp:
002835r 2  EC rr rr           CPX   proc_param_end
002838r 2  B0 22              BCS   @pp_done
00283Ar 2  A9 20              LDA   #' '
00283Cr 2  99 rr rr           STA   proc_body_buf,Y
00283Fr 2  C8                 INY
002840r 2  A9 3A              LDA   #':'
002842r 2  99 rr rr           STA   proc_body_buf,Y
002845r 2  C8                 INY
002846r 2  BD rr rr           LDA   proc_param_buf,X       ; this param's char count
002849r 2  85 rr              STA   proc_rec_off
00284Br 2  E8                 INX
00284Cr 2               @ppc:
00284Cr 2  A5 rr              LDA   proc_rec_off
00284Er 2  F0 E5              BEQ   @pp
002850r 2  BD rr rr           LDA   proc_param_buf,X
002853r 2  99 rr rr           STA   proc_body_buf,Y
002856r 2  C8                 INY
002857r 2  E8                 INX
002858r 2  C6 rr              DEC   proc_rec_off
00285Ar 2  80 F0              BRA   @ppc
00285Cr 2               @pp_done:
00285Cr 2  60                 RTS
00285Dr 2               
00285Dr 2               proc_open_editor:
00285Dr 2                     ; build "TO <name> :params" header, then append an empty body "  ".
00285Dr 2  20 rr rr           JSR   proc_build_header
002860r 2                     ; Y = line-1 length. The body line is line 1's '\n' + 2 indent spaces,
002860r 2                     ; so the cursor lands at offset (line1 + 3).
002860r 2  98                 TYA
002861r 2  18                 CLC
002862r 2  69 03              ADC   #3
002864r 2  8D rr rr           STA   proc_edit_cur_lo
002867r 2  A9 00              LDA   #0
002869r 2  69 00              ADC   #0
00286Br 2  8D rr rr           STA   proc_edit_cur_hi
00286Er 2                     ; append "\n  \nEND\n"
00286Er 2  A9 0A              LDA   #$0A
002870r 2  99 rr rr           STA   proc_body_buf,Y
002873r 2  C8                 INY
002874r 2  A9 20              LDA   #' '
002876r 2  99 rr rr           STA   proc_body_buf,Y
002879r 2  C8                 INY
00287Ar 2  99 rr rr           STA   proc_body_buf,Y
00287Dr 2  C8                 INY
00287Er 2  A9 0A              LDA   #$0A
002880r 2  99 rr rr           STA   proc_body_buf,Y
002883r 2  C8                 INY
002884r 2  A9 45              LDA   #'E'
002886r 2  99 rr rr           STA   proc_body_buf,Y
002889r 2  C8                 INY
00288Ar 2  A9 4E              LDA   #'N'
00288Cr 2  99 rr rr           STA   proc_body_buf,Y
00288Fr 2  C8                 INY
002890r 2  A9 44              LDA   #'D'
002892r 2  99 rr rr           STA   proc_body_buf,Y
002895r 2  C8                 INY
002896r 2  A9 0A              LDA   #$0A
002898r 2  99 rr rr           STA   proc_body_buf,Y
00289Br 2  C8                 INY
00289Cr 2  84 rr              STY   proc_body_len_lo
00289Er 2  64 rr              STZ   proc_body_len_hi
0028A0r 2               
0028A0r 2               ; ---------------------------------------------------------------------
0028A0r 2               ; proc_edit_run — shared tail: build the editor title, hand proc_body_buf
0028A0r 2               ;   (with proc_body_len + proc_edit_cur already set) to the EDITUI editor, and
0028A0r 2               ;   on save extract the body + (re)build the procedure record.
0028A0r 2               ;   Returns: carry set = saved, carry clear = abandoned.
0028A0r 2               ; ---------------------------------------------------------------------
0028A0r 2               proc_edit_run:
0028A0r 2                     ; --- title "TO <name>" + NUL for the editor's title band ---
0028A0r 2  A9 54              LDA   #'T'
0028A2r 2  8D rr rr           STA   proc_editor_title+0
0028A5r 2  A9 4F              LDA   #'O'
0028A7r 2  8D rr rr           STA   proc_editor_title+1
0028AAr 2  A9 20              LDA   #' '
0028ACr 2  8D rr rr           STA   proc_editor_title+2
0028AFr 2  A2 00              LDX   #0
0028B1r 2  A0 03              LDY   #3
0028B3r 2               @tt:
0028B3r 2  E4 rr              CPX   proc_name_len
0028B5r 2  B0 0A              BCS   @tt_done
0028B7r 2  BD rr rr           LDA   proc_name_buf+1,X
0028BAr 2  99 rr rr           STA   proc_editor_title,Y
0028BDr 2  E8                 INX
0028BEr 2  C8                 INY
0028BFr 2  80 F2              BRA   @tt
0028C1r 2               @tt_done:
0028C1r 2  A9 00              LDA   #0
0028C3r 2  99 rr rr           STA   proc_editor_title,Y
0028C6r 2               
0028C6r 2                     ; --- mailbox: ARG0=buf ARG1=len ARG2=cap ARG3=title; cursor in FRAC bytes
0028C6r 2  A9 rr              LDA   #<proc_body_buf
0028C8r 2  85 84              STA   EXT_ARG0_LO
0028CAr 2  A9 rr              LDA   #>proc_body_buf
0028CCr 2  85 83              STA   EXT_ARG0_HI
0028CEr 2  A5 rr              LDA   proc_body_len_lo
0028D0r 2  85 88              STA   EXT_ARG1_LO
0028D2r 2  A5 rr              LDA   proc_body_len_hi
0028D4r 2  85 87              STA   EXT_ARG1_HI
0028D6r 2  A9 00              LDA   #<2048
0028D8r 2  85 8C              STA   EXT_ARG2_LO
0028DAr 2  A9 08              LDA   #>2048
0028DCr 2  85 8B              STA   EXT_ARG2_HI
0028DEr 2  A9 rr              LDA   #<proc_editor_title
0028E0r 2  85 A1              STA   EXT_ARG3_LO
0028E2r 2  A9 rr              LDA   #>proc_editor_title
0028E4r 2  85 A0              STA   EXT_ARG3_HI
0028E6r 2  AD rr rr           LDA   proc_edit_cur_lo
0028E9r 2  85 8D              STA   EXT_ARG2_FRAC          ; initial cursor offset (see ext_iface.inc)
0028EBr 2  AD rr rr           LDA   proc_edit_cur_hi
0028EEr 2  85 A2              STA   EXT_ARG3_FRAC
0028F0r 2               
0028F0r 2  A9 4B              LDA   #EXT_CMD_EDIT
0028F2r 2  85 80              STA   EXT_CMD
0028F4r 2  20 70 02           JSR   EXT_TRAMPOLINE         ; swap to ext ROM, run editor, swap back
0028F7r 2               
0028F7r 2                     ; editor returns the final buffer length in ARG1
0028F7r 2  A5 88              LDA   EXT_ARG1_LO
0028F9r 2  85 rr              STA   proc_body_len_lo
0028FBr 2  A5 87              LDA   EXT_ARG1_HI
0028FDr 2  85 rr              STA   proc_body_len_hi
0028FFr 2               
0028FFr 2  A5 8F              LDA   EXT_RESULT_HI
002901r 2  F0 08              BEQ   @abandoned
002903r 2                     ; Strip line 1 + the END line -> proc_body_src/proc_body_len = body only.
002903r 2  20 rr rr           JSR   proc_extract_body
002906r 2  20 rr rr           JSR   proc_build_record
002909r 2  38                 SEC
00290Ar 2  60                 RTS
00290Br 2               @abandoned:
00290Br 2  18                 CLC
00290Cr 2  60                 RTS
00290Dr 2               
00290Dr 2               ; ---------------------------------------------------------------------
00290Dr 2               ; proc_buf_put — append A to proc_body_buf at ptr2, advancing ptr2 and the
00290Dr 2               ;   16-bit proc_body_len counter. Preserves A; clobbers Y.
00290Dr 2               ; ---------------------------------------------------------------------
00290Dr 2               proc_buf_put:
00290Dr 2  A0 00              LDY   #0
00290Fr 2  91 rr              STA   (ptr2_lo),Y
002911r 2  E6 rr              INC   ptr2_lo
002913r 2  D0 02              BNE   :+
002915r 2  E6 rr              INC   ptr2_hi
002917r 2  E6 rr        :     INC   proc_body_len_lo
002919r 2  D0 02              BNE   :+
00291Br 2  E6 rr              INC   proc_body_len_hi
00291Dr 2  60           :     RTS
00291Er 2               
00291Er 2               ; ---------------------------------------------------------------------
00291Er 2               ; proc_record_to_buffers — unpack the procedure record at proc_entry into the
00291Er 2               ;   collect buffers so it can be edited and rebuilt:
00291Er 2               ;     proc_name_buf/proc_name_len, proc_param_buf/proc_param_cnt/proc_param_end,
00291Er 2               ;     and proc_body_src/proc_body_len = the record's body text (ptr + length).
00291Er 2               ;   The name+param region is < 256 bytes so 8-bit Y indexing is safe there.
00291Er 2               ; ---------------------------------------------------------------------
00291Er 2               proc_record_to_buffers:
00291Er 2  A5 rr              LDA   proc_entry_lo
002920r 2  85 rr              STA   ptr_lo
002922r 2  A5 rr              LDA   proc_entry_hi
002924r 2  85 rr              STA   ptr_hi
002926r 2                     ; --- name (record +2 = len, +3.. = chars) ---
002926r 2  A0 02              LDY   #2
002928r 2  B1 rr              LDA   (ptr_lo),Y
00292Ar 2  8D rr rr           STA   proc_name_buf
00292Dr 2  85 rr              STA   proc_name_len
00292Fr 2  C8                 INY                         ; Y=3 -> first name char
002930r 2  A2 00              LDX   #0
002932r 2               @rb_nm:
002932r 2  E4 rr              CPX   proc_name_len
002934r 2  B0 09              BCS   @rb_nm_done
002936r 2  B1 rr              LDA   (ptr_lo),Y
002938r 2  9D rr rr           STA   proc_name_buf+1,X
00293Br 2  C8                 INY
00293Cr 2  E8                 INX
00293Dr 2  80 F3              BRA   @rb_nm
00293Fr 2               @rb_nm_done:
00293Fr 2                     ; --- param_count then packed params ---
00293Fr 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002941r 2  85 rr              STA   proc_param_cnt
002943r 2  8D rr rr           STA   proc_param_buf        ; [0] = count
002946r 2  8D rr rr           STA   proc_tmp              ; remaining params
002949r 2  C8                 INY                         ; Y -> first param len
00294Ar 2  A2 01              LDX   #1                    ; dest index into proc_param_buf
00294Cr 2               @rb_param:
00294Cr 2  AD rr rr           LDA   proc_tmp
00294Fr 2  F0 1B              BEQ   @rb_params_done
002951r 2  CE rr rr           DEC   proc_tmp
002954r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002956r 2  9D rr rr           STA   proc_param_buf,X
002959r 2  85 rr              STA   proc_rec_off          ; char counter
00295Br 2  C8                 INY
00295Cr 2  E8                 INX
00295Dr 2               @rb_pchars:
00295Dr 2  A5 rr              LDA   proc_rec_off
00295Fr 2  F0 EB              BEQ   @rb_param
002961r 2  C6 rr              DEC   proc_rec_off
002963r 2  B1 rr              LDA   (ptr_lo),Y
002965r 2  9D rr rr           STA   proc_param_buf,X
002968r 2  C8                 INY
002969r 2  E8                 INX
00296Ar 2  80 F1              BRA   @rb_pchars
00296Cr 2               @rb_params_done:
00296Cr 2  8E rr rr           STX   proc_param_end
00296Fr 2                     ; Y -> body_len_lo within the record. Compute absolute pointer.
00296Fr 2  98                 TYA
002970r 2  18                 CLC
002971r 2  65 rr              ADC   proc_entry_lo
002973r 2  85 rr              STA   ptr_lo
002975r 2  A5 rr              LDA   proc_entry_hi
002977r 2  69 00              ADC   #0
002979r 2  85 rr              STA   ptr_hi               ; ptr -> body_len_lo
00297Br 2  A0 00              LDY   #0
00297Dr 2  B1 rr              LDA   (ptr_lo),Y
00297Fr 2  85 rr              STA   proc_body_len_lo     ; record body length
002981r 2  C8                 INY
002982r 2  B1 rr              LDA   (ptr_lo),Y
002984r 2  85 rr              STA   proc_body_len_hi
002986r 2  18                 CLC                         ; body src = ptr + 2
002987r 2  A5 rr              LDA   ptr_lo
002989r 2  69 02              ADC   #2
00298Br 2  8D rr rr           STA   proc_body_src_lo
00298Er 2  A5 rr              LDA   ptr_hi
002990r 2  69 00              ADC   #0
002992r 2  8D rr rr           STA   proc_body_src_hi
002995r 2  60                 RTS
002996r 2               
002996r 2               ; ---------------------------------------------------------------------
002996r 2               ; proc_edit_reconstruct — build the full editable text "TO <name> :params\n
002996r 2               ;   <body>END\n" into proc_body_buf from the collect buffers + the record body
002996r 2               ;   (proc_body_src/proc_body_len set by proc_record_to_buffers). Sets
002996r 2               ;   proc_body_len = total buffer length and proc_edit_cur = start of the body.
002996r 2               ; ---------------------------------------------------------------------
002996r 2               proc_edit_reconstruct:
002996r 2                     ; Save the record body src/len before proc_body_len is repurposed.
002996r 2  AD rr rr           LDA   proc_body_src_lo
002999r 2  85 rr              STA   proc_ptr_lo
00299Br 2  AD rr rr           LDA   proc_body_src_hi
00299Er 2  85 rr              STA   proc_ptr_hi
0029A0r 2  A5 rr              LDA   proc_body_len_lo
0029A2r 2  8D rr rr           STA   num_tmp_lo
0029A5r 2  A5 rr              LDA   proc_body_len_hi
0029A7r 2  8D rr rr           STA   num_tmp_hi
0029AAr 2                     ; Header "TO name params" (8-bit), then a newline.
0029AAr 2  20 rr rr           JSR   proc_build_header     ; Y = header length
0029ADr 2  A9 0A              LDA   #$0A
0029AFr 2  99 rr rr           STA   proc_body_buf,Y
0029B2r 2  C8                 INY                         ; Y = body-line start offset
0029B3r 2  8C rr rr           STY   proc_edit_cur_lo
0029B6r 2  9C rr rr           STZ   proc_edit_cur_hi
0029B9r 2  84 rr              STY   proc_body_len_lo
0029BBr 2  64 rr              STZ   proc_body_len_hi
0029BDr 2                     ; dest pointer ptr2 = proc_body_buf + Y
0029BDr 2  98                 TYA
0029BEr 2  18                 CLC
0029BFr 2  69 rr              ADC   #<proc_body_buf
0029C1r 2  85 rr              STA   ptr2_lo
0029C3r 2  A9 rr              LDA   #>proc_body_buf
0029C5r 2  69 00              ADC   #0
0029C7r 2  85 rr              STA   ptr2_hi
0029C9r 2                     ; copy the record body (num_tmp bytes from proc_ptr)
0029C9r 2               @rc_body:
0029C9r 2  AD rr rr           LDA   num_tmp_lo
0029CCr 2  0D rr rr           ORA   num_tmp_hi
0029CFr 2  F0 1A              BEQ   @rc_body_done
0029D1r 2  A0 00              LDY   #0
0029D3r 2  B1 rr              LDA   (proc_ptr_lo),Y
0029D5r 2  20 rr rr           JSR   proc_buf_put
0029D8r 2  E6 rr              INC   proc_ptr_lo
0029DAr 2  D0 02              BNE   :+
0029DCr 2  E6 rr              INC   proc_ptr_hi
0029DEr 2  AD rr rr     :     LDA   num_tmp_lo
0029E1r 2  D0 03              BNE   @rc_dec
0029E3r 2  CE rr rr           DEC   num_tmp_hi
0029E6r 2               @rc_dec:
0029E6r 2  CE rr rr           DEC   num_tmp_lo
0029E9r 2  80 DE              BRA   @rc_body
0029EBr 2               @rc_body_done:
0029EBr 2                     ; append "END" + newline
0029EBr 2  A9 45              LDA   #'E'
0029EDr 2  20 rr rr           JSR   proc_buf_put
0029F0r 2  A9 4E              LDA   #'N'
0029F2r 2  20 rr rr           JSR   proc_buf_put
0029F5r 2  A9 44              LDA   #'D'
0029F7r 2  20 rr rr           JSR   proc_buf_put
0029FAr 2  A9 0A              LDA   #$0A
0029FCr 2  20 rr rr           JSR   proc_buf_put
0029FFr 2  60                 RTS
002A00r 2               
002A00r 2               ; ---------------------------------------------------------------------
002A00r 2               ; proc_edit — handle "EDIT <name>" / "ED <name>". eval_cur is at the name
002A00r 2               ;   token. If the procedure exists, reopen it in the editor pre-filled with its
002A00r 2               ;   current definition; otherwise fall back to the TO collector (create it).
002A00r 2               ; ---------------------------------------------------------------------
002A00r 2               proc_edit:
002A00r 2  A5 rr              LDA   eval_cur_lo
002A02r 2  05 rr              ORA   eval_cur_hi
002A04r 2  F0 14              BEQ   @to_collect
002A06r 2  20 rr rr           JSR   proc_lookup
002A09r 2  B0 0F              BCS   @to_collect          ; unknown -> create via the TO collector
002A0Br 2  20 rr rr           JSR   proc_record_to_buffers
002A0Er 2  20 rr rr           JSR   proc_edit_reconstruct
002A11r 2  20 rr rr           JSR   proc_edit_run
002A14r 2  90 03              BCC   @done                ; abandoned
002A16r 2  20 rr rr           JSR   proc_print_defined
002A19r 2               @done:
002A19r 2  60                 RTS
002A1Ar 2               @to_collect:
002A1Ar 2  4C rr rr           JMP   proc_collect
002A1Dr 2               
002A1Dr 2               ; ---------------------------------------------------------------------
002A1Dr 2               ; proc_extract_body — narrow proc_body_buf/proc_body_len down to just the body:
002A1Dr 2               ;   everything after the first '\n' (line 1) up to (not including) the line that
002A1Dr 2               ;   reads "END". Sets proc_body_src_lo/hi + proc_body_len_lo/hi.
002A1Dr 2               ; ---------------------------------------------------------------------
002A1Dr 2               proc_extract_body:
002A1Dr 2  A9 rr              LDA   #<proc_body_buf
002A1Fr 2  85 rr              STA   proc_ptr_lo
002A21r 2  A9 rr              LDA   #>proc_body_buf
002A23r 2  85 rr              STA   proc_ptr_hi
002A25r 2  9C rr rr           STZ   proc_scan_off_lo
002A28r 2  9C rr rr           STZ   proc_scan_off_hi
002A2Br 2               @find_nl:
002A2Br 2  20 rr rr           JSR   proc_scan_at_end
002A2Er 2  B0 4F              BCS   @whole                ; no newline -> whole buffer is the body
002A30r 2  A0 00              LDY   #0
002A32r 2  B1 rr              LDA   (proc_ptr_lo),Y
002A34r 2  20 rr rr           JSR   proc_scan_advance
002A37r 2  C9 0A              CMP   #$0A
002A39r 2  D0 F0              BNE   @find_nl
002A3Br 2                     ; body starts here
002A3Br 2  A5 rr              LDA   proc_ptr_lo
002A3Dr 2  8D rr rr           STA   proc_body_src_lo
002A40r 2  A5 rr              LDA   proc_ptr_hi
002A42r 2  8D rr rr           STA   proc_body_src_hi
002A45r 2  AD rr rr           LDA   proc_scan_off_lo
002A48r 2  8D rr rr           STA   num_tmp_lo            ; body-start offset
002A4Br 2  AD rr rr           LDA   proc_scan_off_hi
002A4Er 2  8D rr rr           STA   num_tmp_hi
002A51r 2               @line:
002A51r 2  20 rr rr           JSR   proc_scan_at_end
002A54r 2  B0 17              BCS   @body_end             ; ran off the end -> body = rest
002A56r 2  20 rr rr           JSR   proc_line_is_end
002A59r 2  B0 12              BCS   @body_end             ; this line is "END" -> stop
002A5Br 2               @skip:
002A5Br 2  20 rr rr           JSR   proc_scan_at_end
002A5Er 2  B0 0D              BCS   @body_end
002A60r 2  A0 00              LDY   #0
002A62r 2  B1 rr              LDA   (proc_ptr_lo),Y
002A64r 2  20 rr rr           JSR   proc_scan_advance
002A67r 2  C9 0A              CMP   #$0A
002A69r 2  D0 F0              BNE   @skip
002A6Br 2  80 E4              BRA   @line
002A6Dr 2               @body_end:
002A6Dr 2  38                 SEC
002A6Er 2  AD rr rr           LDA   proc_scan_off_lo
002A71r 2  ED rr rr           SBC   num_tmp_lo
002A74r 2  85 rr              STA   proc_body_len_lo
002A76r 2  AD rr rr           LDA   proc_scan_off_hi
002A79r 2  ED rr rr           SBC   num_tmp_hi
002A7Cr 2  85 rr              STA   proc_body_len_hi
002A7Er 2  60                 RTS
002A7Fr 2               @whole:
002A7Fr 2  A9 rr              LDA   #<proc_body_buf
002A81r 2  8D rr rr           STA   proc_body_src_lo
002A84r 2  A9 rr              LDA   #>proc_body_buf
002A86r 2  8D rr rr           STA   proc_body_src_hi
002A89r 2  60                 RTS
002A8Ar 2               
002A8Ar 2               ; carry set if proc_scan_off >= proc_body_len
002A8Ar 2               proc_scan_at_end:
002A8Ar 2  AD rr rr           LDA   proc_scan_off_lo
002A8Dr 2  C5 rr              CMP   proc_body_len_lo
002A8Fr 2  AD rr rr           LDA   proc_scan_off_hi
002A92r 2  E5 rr              SBC   proc_body_len_hi
002A94r 2  60                 RTS
002A95r 2               
002A95r 2               ; advance the scan pointer + offset by one byte
002A95r 2               proc_scan_advance:
002A95r 2  E6 rr              INC   proc_ptr_lo
002A97r 2  D0 02              BNE   :+
002A99r 2  E6 rr              INC   proc_ptr_hi
002A9Br 2  EE rr rr     :     INC   proc_scan_off_lo
002A9Er 2  D0 03              BNE   :+
002AA0r 2  EE rr rr           INC   proc_scan_off_hi
002AA3r 2  60           :     RTS
002AA4r 2               
002AA4r 2               ; proc_line_is_end — carry set if the line at proc_ptr is exactly "END" followed
002AA4r 2               ; by '\n' or end-of-buffer. Needs room for 3 chars (off+3 <= len). Non-destructive.
002AA4r 2               proc_line_is_end:
002AA4r 2                     ; proc_entry = proc_scan_off + 3
002AA4r 2  18                 CLC
002AA5r 2  AD rr rr           LDA   proc_scan_off_lo
002AA8r 2  69 03              ADC   #3
002AAAr 2  85 rr              STA   proc_entry_lo
002AACr 2  AD rr rr           LDA   proc_scan_off_hi
002AAFr 2  69 00              ADC   #0
002AB1r 2  85 rr              STA   proc_entry_hi
002AB3r 2                     ; need off+3 <= len, i.e. NOT (off+3 > len) == NOT (len < off+3)
002AB3r 2  A5 rr              LDA   proc_body_len_lo
002AB5r 2  C5 rr              CMP   proc_entry_lo
002AB7r 2  A5 rr              LDA   proc_body_len_hi
002AB9r 2  E5 rr              SBC   proc_entry_hi
002ABBr 2  90 2B              BCC   @no                   ; len < off+3 -> not enough room
002ABDr 2  A0 00              LDY   #0
002ABFr 2  B1 rr              LDA   (proc_ptr_lo),Y
002AC1r 2  C9 45              CMP   #'E'
002AC3r 2  D0 23              BNE   @no
002AC5r 2  C8                 INY
002AC6r 2  B1 rr              LDA   (proc_ptr_lo),Y
002AC8r 2  C9 4E              CMP   #'N'
002ACAr 2  D0 1C              BNE   @no
002ACCr 2  C8                 INY
002ACDr 2  B1 rr              LDA   (proc_ptr_lo),Y
002ACFr 2  C9 44              CMP   #'D'
002AD1r 2  D0 15              BNE   @no
002AD3r 2                     ; 4th byte: '\n', or off+3 == len (END at buffer end)
002AD3r 2  A5 rr              LDA   proc_entry_lo
002AD5r 2  C5 rr              CMP   proc_body_len_lo
002AD7r 2  D0 06              BNE   @check_nl
002AD9r 2  A5 rr              LDA   proc_entry_hi
002ADBr 2  C5 rr              CMP   proc_body_len_hi
002ADDr 2  F0 07              BEQ   @yes                  ; off+3 == len
002ADFr 2               @check_nl:
002ADFr 2  C8                 INY
002AE0r 2  B1 rr              LDA   (proc_ptr_lo),Y
002AE2r 2  C9 0A              CMP   #$0A
002AE4r 2  D0 02              BNE   @no
002AE6r 2               @yes:
002AE6r 2  38                 SEC
002AE7r 2  60                 RTS
002AE8r 2               @no:
002AE8r 2  18                 CLC
002AE9r 2  60                 RTS
002AEAr 2               
002AEAr 2               ; ---------------------------------------------------------------------
002AEAr 2               ; heap_alloc_big — allocate for procedure records (16-bit payload)
002AEAr 2               ;   Input:  proc_ptr_lo/hi = record data size (16-bit)
002AEAr 2               ;   Output: proc_entry_lo/hi = pointer to record data (payload+2)
002AEAr 2               ;           Carry clear = success, Carry set = OOM
002AEAr 2               ;
002AEAr 2               ;   Layout: [GC_HDR_TAG, GC_HDR_SIZE=0, total_lo, total_hi, ...data...]
002AEAr 2               ;   GC header (2 bytes) + 16-bit size (2 bytes) + record data.
002AEAr 2               ;   Total allocation = record_data_size + 4.
002AEAr 2               ;   GC_HDR_SIZE = 0 tells GC to read 16-bit total from payload[0..1].
002AEAr 2               ;   proc_entry points to data (base+4).
002AEAr 2               ;
002AEAr 2               ;   Clobbers: A, Y, ptr_lo/hi
002AEAr 2               ; ---------------------------------------------------------------------
002AEAr 2               heap_alloc_big:
002AEAr 2                     ; Total allocation = data_size + 4 (2 hdr + 2 size field)
002AEAr 2  18                 CLC
002AEBr 2  A5 rr              LDA   proc_ptr_lo
002AEDr 2  69 04              ADC   #4
002AEFr 2  48                 PHA                        ; save total_lo
002AF0r 2  A5 rr              LDA   proc_ptr_hi
002AF2r 2  69 00              ADC   #0
002AF4r 2  48                 PHA                        ; save total_hi
002AF5r 2               
002AF5r 2                     ; Save current heap_ptr as base
002AF5r 2  A5 rr              LDA   heap_ptr
002AF7r 2  85 rr              STA   proc_entry_lo
002AF9r 2  A5 rr              LDA   heap_ptr+1
002AFBr 2  85 rr              STA   proc_entry_hi
002AFDr 2               
002AFDr 2                     ; Advance heap_ptr by total
002AFDr 2  BA                 TSX
002AFEr 2  18                 CLC
002AFFr 2  A5 rr              LDA   heap_ptr
002B01r 2  7D 02 01           ADC   $0102,X              ; total_lo
002B04r 2  85 rr              STA   heap_ptr
002B06r 2  A5 rr              LDA   heap_ptr+1
002B08r 2  7D 01 01           ADC   $0101,X              ; total_hi
002B0Br 2  85 rr              STA   heap_ptr+1
002B0Dr 2               
002B0Dr 2                     ; OOM check
002B0Dr 2  C9 98              CMP   #>HEAP_END
002B0Fr 2  90 16              BCC   @big_ok
002B11r 2  D0 08              BNE   @big_oom
002B13r 2  A5 rr              LDA   heap_ptr
002B15r 2  C9 00              CMP   #<HEAP_END
002B17r 2  90 0E              BCC   @big_ok
002B19r 2  F0 0C              BEQ   @big_ok
002B1Br 2               @big_oom:
002B1Br 2  A5 rr              LDA   proc_entry_lo
002B1Dr 2  85 rr              STA   heap_ptr
002B1Fr 2  A5 rr              LDA   proc_entry_hi
002B21r 2  85 rr              STA   heap_ptr+1
002B23r 2  68                 PLA
002B24r 2  68                 PLA
002B25r 2  38                 SEC
002B26r 2  60                 RTS
002B27r 2               @big_ok:
002B27r 2                     ; Write header at base (proc_entry = base here)
002B27r 2  A5 rr              LDA   proc_entry_lo
002B29r 2  85 rr              STA   ptr_lo
002B2Br 2  A5 rr              LDA   proc_entry_hi
002B2Dr 2  85 rr              STA   ptr_hi
002B2Fr 2               
002B2Fr 2  A0 00              LDY   #GC_HDR_TAG
002B31r 2  A9 04              LDA   #ATYPE_PROC
002B33r 2  91 rr              STA   (ptr_lo),Y
002B35r 2               
002B35r 2  A0 01              LDY   #GC_HDR_SIZE
002B37r 2  A9 00              LDA   #0                    ; 0 = 16-bit size at payload[0..1]
002B39r 2  91 rr              STA   (ptr_lo),Y
002B3Br 2               
002B3Br 2                     ; Write 16-bit total at payload offsets 0,1 (base+2, base+3)
002B3Br 2  68                 PLA                        ; total_hi
002B3Cr 2  A0 03              LDY   #GC_HDR_BYTES+1       ; base+3
002B3Er 2  91 rr              STA   (ptr_lo),Y
002B40r 2  68                 PLA                        ; total_lo
002B41r 2  A0 02              LDY   #GC_HDR_BYTES         ; base+2
002B43r 2  91 rr              STA   (ptr_lo),Y
002B45r 2               
002B45r 2                     ; Advance proc_entry to point past header+size field = base+4
002B45r 2                     ; This is where the record data starts
002B45r 2  18                 CLC
002B46r 2  A5 rr              LDA   proc_entry_lo
002B48r 2  69 04              ADC   #4
002B4Ar 2  85 rr              STA   proc_entry_lo
002B4Cr 2  A5 rr              LDA   proc_entry_hi
002B4Er 2  69 00              ADC   #0
002B50r 2  85 rr              STA   proc_entry_hi
002B52r 2               
002B52r 2  18                 CLC
002B53r 2  60                 RTS
002B54r 2               
002B54r 2               ; ---------------------------------------------------------------------
002B54r 2               ; proc_build_record — allocate and populate a procedure heap record
002B54r 2               ;   Uses: proc_name_buf, proc_param_buf/proc_param_end,
002B54r 2               ;         proc_body_buf/proc_body_len
002B54r 2               ; ---------------------------------------------------------------------
002B54r 2               proc_build_record:
002B54r 2                     ; Calculate total record size
002B54r 2                     ; 2 (next) + 1 (name_len) + name_len
002B54r 2                     ; + 1 (param_count) + (proc_param_end - 1) param packed bytes
002B54r 2                     ; + 2 (body_len) + body_len
002B54r 2                     ;
002B54r 2                     ; We build the total in proc_ptr_lo:proc_ptr_hi (16-bit)
002B54r 2               
002B54r 2  A9 04              LDA   #4                    ; 2(next) + 1(name_len) + 1(param_count)
002B56r 2  18                 CLC
002B57r 2  6D rr rr           ADC   proc_name_buf         ; + name_len
002B5Ar 2  85 rr              STA   proc_ptr_lo
002B5Cr 2  A9 00              LDA   #0
002B5Er 2  85 rr              STA   proc_ptr_hi
002B60r 2               
002B60r 2                     ; + param packed bytes (proc_param_end - 1)
002B60r 2  AD rr rr           LDA   proc_param_end
002B63r 2  38                 SEC
002B64r 2  E9 01              SBC   #1
002B66r 2  18                 CLC
002B67r 2  65 rr              ADC   proc_ptr_lo
002B69r 2  85 rr              STA   proc_ptr_lo
002B6Br 2  90 02              BCC   :+
002B6Dr 2  E6 rr              INC   proc_ptr_hi
002B6Fr 2               :
002B6Fr 2                     ; + 2 (body_len field)
002B6Fr 2  18                 CLC
002B70r 2  A5 rr              LDA   proc_ptr_lo
002B72r 2  69 02              ADC   #2
002B74r 2  85 rr              STA   proc_ptr_lo
002B76r 2  90 02              BCC   :+
002B78r 2  E6 rr              INC   proc_ptr_hi
002B7Ar 2               :
002B7Ar 2                     ; + body_len
002B7Ar 2  18                 CLC
002B7Br 2  A5 rr              LDA   proc_ptr_lo
002B7Dr 2  65 rr              ADC   proc_body_len_lo
002B7Fr 2  85 rr              STA   proc_ptr_lo
002B81r 2  A5 rr              LDA   proc_ptr_hi
002B83r 2  65 rr              ADC   proc_body_len_hi
002B85r 2  85 rr              STA   proc_ptr_hi
002B87r 2               
002B87r 2                     ; Allocate with GC header (16-bit size via heap_alloc_big)
002B87r 2                     ; proc_ptr_lo/hi = payload size
002B87r 2  20 rr rr           JSR   heap_alloc_big
002B8Ar 2  90 01              BCC   @ok
002B8Cr 2  60                 RTS                        ; OOM
002B8Dr 2               @ok:
002B8Dr 2                     ; Fill the record using (ptr_lo),Y indirect addressing
002B8Dr 2                     ; We track Y as the write offset. For records > 256 bytes
002B8Dr 2                     ; we bump ptr_hi when Y wraps.
002B8Dr 2  A5 rr              LDA   proc_entry_lo
002B8Fr 2  85 rr              STA   ptr_lo
002B91r 2  A5 rr              LDA   proc_entry_hi
002B93r 2  85 rr              STA   ptr_hi
002B95r 2               
002B95r 2                     ; +0,+1: next pointer = current proc_head
002B95r 2  A0 00              LDY   #0
002B97r 2  A5 rr              LDA   proc_head_lo
002B99r 2  91 rr              STA   (ptr_lo),Y
002B9Br 2  C8                 INY
002B9Cr 2  A5 rr              LDA   proc_head_hi
002B9Er 2  91 rr              STA   (ptr_lo),Y
002BA0r 2               
002BA0r 2                     ; +2: name_len
002BA0r 2  C8                 INY
002BA1r 2  AD rr rr           LDA   proc_name_buf
002BA4r 2  91 rr              STA   (ptr_lo),Y
002BA6r 2               
002BA6r 2                     ; +3..+3+NL-1: name chars
002BA6r 2  AE rr rr           LDX   proc_name_buf         ; X = char count
002BA9r 2  64 rr              STZ   proc_rec_off          ; source index
002BABr 2               @bld_name:
002BABr 2  E0 00              CPX   #0
002BADr 2  F0 13              BEQ   @bld_name_done
002BAFr 2  C8                 INY
002BB0r 2  D0 02              BNE   :+
002BB2r 2  E6 rr              INC   ptr_hi
002BB4r 2  DA           :     PHX
002BB5r 2  A6 rr              LDX   proc_rec_off
002BB7r 2  BD rr rr           LDA   proc_name_buf+1,X
002BBAr 2  FA                 PLX
002BBBr 2  91 rr              STA   (ptr_lo),Y
002BBDr 2  E6 rr              INC   proc_rec_off
002BBFr 2  CA                 DEX
002BC0r 2  80 E9              BRA   @bld_name
002BC2r 2               @bld_name_done:
002BC2r 2               
002BC2r 2                     ; +3+NL: param_count
002BC2r 2  C8                 INY
002BC3r 2  D0 02              BNE   :+
002BC5r 2  E6 rr              INC   ptr_hi
002BC7r 2  A5 rr        :     LDA   proc_param_cnt
002BC9r 2  91 rr              STA   (ptr_lo),Y
002BCBr 2               
002BCBr 2                     ; Copy packed param data from proc_param_buf[1..proc_param_end-1]
002BCBr 2  AD rr rr           LDA   proc_param_end
002BCEr 2  C9 02              CMP   #2                    ; at least 1 = there are params
002BD0r 2  90 14              BCC   @bld_params_done
002BD2r 2  A2 01              LDX   #1                    ; source index (skip count byte)
002BD4r 2               @bld_param:
002BD4r 2  EC rr rr           CPX   proc_param_end
002BD7r 2  B0 0D              BCS   @bld_params_done
002BD9r 2  C8                 INY
002BDAr 2  D0 02              BNE   :+
002BDCr 2  E6 rr              INC   ptr_hi
002BDEr 2  BD rr rr     :     LDA   proc_param_buf,X
002BE1r 2  91 rr              STA   (ptr_lo),Y
002BE3r 2  E8                 INX
002BE4r 2  80 EE              BRA   @bld_param
002BE6r 2               @bld_params_done:
002BE6r 2               
002BE6r 2                     ; body_len_lo, body_len_hi
002BE6r 2  C8                 INY
002BE7r 2  D0 02              BNE   :+
002BE9r 2  E6 rr              INC   ptr_hi
002BEBr 2  A5 rr        :     LDA   proc_body_len_lo
002BEDr 2  91 rr              STA   (ptr_lo),Y
002BEFr 2  C8                 INY
002BF0r 2  D0 02              BNE   :+
002BF2r 2  E6 rr              INC   ptr_hi
002BF4r 2  A5 rr        :     LDA   proc_body_len_hi
002BF6r 2  91 rr              STA   (ptr_lo),Y
002BF8r 2               
002BF8r 2                     ; Copy body text (proc_body_src points at the body region of the buffer)
002BF8r 2  A5 rr              LDA   proc_body_len_lo
002BFAr 2  05 rr              ORA   proc_body_len_hi
002BFCr 2  F0 3A              BEQ   @bld_body_done
002BFEr 2               
002BFEr 2  AD rr rr           LDA   proc_body_src_lo
002C01r 2  85 rr              STA   proc_ptr_lo
002C03r 2  AD rr rr           LDA   proc_body_src_hi
002C06r 2  85 rr              STA   proc_ptr_hi
002C08r 2                     ; 16-bit counter
002C08r 2  A5 rr              LDA   proc_body_len_lo
002C0Ar 2  8D rr rr           STA   num_tmp_lo
002C0Dr 2  A5 rr              LDA   proc_body_len_hi
002C0Fr 2  8D rr rr           STA   num_tmp_hi
002C12r 2               
002C12r 2               @bld_body:
002C12r 2  C8                 INY
002C13r 2  D0 02              BNE   :+
002C15r 2  E6 rr              INC   ptr_hi
002C17r 2  5A           :     PHY
002C18r 2  A0 00              LDY   #0
002C1Ar 2  B1 rr              LDA   (proc_ptr_lo),Y
002C1Cr 2  7A                 PLY
002C1Dr 2  91 rr              STA   (ptr_lo),Y
002C1Fr 2                     ; Advance source
002C1Fr 2  E6 rr              INC   proc_ptr_lo
002C21r 2  D0 02              BNE   :+
002C23r 2  E6 rr              INC   proc_ptr_hi
002C25r 2               :     ; Decrement counter
002C25r 2  AD rr rr           LDA   num_tmp_lo
002C28r 2  D0 03              BNE   @bld_dec_lo
002C2Ar 2  CE rr rr           DEC   num_tmp_hi
002C2Dr 2               @bld_dec_lo:
002C2Dr 2  CE rr rr           DEC   num_tmp_lo
002C30r 2  AD rr rr           LDA   num_tmp_lo
002C33r 2  0D rr rr           ORA   num_tmp_hi
002C36r 2  D0 DA              BNE   @bld_body
002C38r 2               
002C38r 2               @bld_body_done:
002C38r 2                     ; Prepend to directory
002C38r 2  A5 rr              LDA   proc_entry_lo
002C3Ar 2  85 rr              STA   proc_head_lo
002C3Cr 2  A5 rr              LDA   proc_entry_hi
002C3Er 2  85 rr              STA   proc_head_hi
002C40r 2  60                 RTS
002C41r 2               
002C41r 2               ; ---------------------------------------------------------------------
002C41r 2               ; proc_lookup — search for a procedure by name
002C41r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
002C41r 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002C41r 2               ;           carry set = not found
002C41r 2               ; ---------------------------------------------------------------------
002C41r 2               proc_lookup:
002C41r 2  A5 rr              LDA   proc_head_lo
002C43r 2  85 rr              STA   proc_entry_lo
002C45r 2  A5 rr              LDA   proc_head_hi
002C47r 2  85 rr              STA   proc_entry_hi
002C49r 2               
002C49r 2               @walk:
002C49r 2  A5 rr              LDA   proc_entry_lo
002C4Br 2  05 rr              ORA   proc_entry_hi
002C4Dr 2  F0 0C              BEQ   @not_found
002C4Fr 2               
002C4Fr 2  20 rr rr           JSR   proc_names_equal
002C52r 2  B0 05              BCS   @found
002C54r 2               
002C54r 2                     ; Follow next pointer
002C54r 2  20 rr rr           JSR   proc_next
002C57r 2  80 F0              BRA   @walk
002C59r 2               
002C59r 2               @found:
002C59r 2  18                 CLC
002C5Ar 2  60                 RTS
002C5Br 2               @not_found:
002C5Br 2  38                 SEC
002C5Cr 2  60                 RTS
002C5Dr 2               
002C5Dr 2               ; ---------------------------------------------------------------------
002C5Dr 2               ; proc_next — advance proc_entry_lo/hi to the next record it links to.
002C5Dr 2               ;   In/out: proc_entry_lo/hi.  Clobbers: A, X, Y, ptr_lo/hi.
002C5Dr 2               ; ---------------------------------------------------------------------
002C5Dr 2               proc_next:
002C5Dr 2  A5 rr              LDA   proc_entry_lo
002C5Fr 2  85 rr              STA   ptr_lo
002C61r 2  A5 rr              LDA   proc_entry_hi
002C63r 2  85 rr              STA   ptr_hi
002C65r 2  A0 00              LDY   #0
002C67r 2  B1 rr              LDA   (ptr_lo),Y
002C69r 2  AA                 TAX
002C6Ar 2  C8                 INY
002C6Br 2  B1 rr              LDA   (ptr_lo),Y
002C6Dr 2  85 rr              STA   proc_entry_hi
002C6Fr 2  86 rr              STX   proc_entry_lo
002C71r 2  60                 RTS
002C72r 2               
002C72r 2               ; ---------------------------------------------------------------------
002C72r 2               ; proc_names_equal — compare token word vs record name
002C72r 2               ;   Input: eval_cur_lo/hi = TOK_WORD, proc_entry_lo/hi = record
002C72r 2               ;   Returns: carry set = equal, carry clear = not equal
002C72r 2               ; ---------------------------------------------------------------------
002C72r 2               proc_names_equal:
002C72r 2                     ; Token name length
002C72r 2  A5 rr              LDA   eval_cur_lo
002C74r 2  85 rr              STA   ptr_lo
002C76r 2  A5 rr              LDA   eval_cur_hi
002C78r 2  85 rr              STA   ptr_hi
002C7Ar 2  A0 03              LDY   #TOK_PAYLOAD
002C7Cr 2  B1 rr              LDA   (ptr_lo),Y
002C7Er 2  85 rr              STA   proc_name_len         ; token name length
002C80r 2               
002C80r 2                     ; Record name length
002C80r 2  A5 rr              LDA   proc_entry_lo
002C82r 2  85 rr              STA   ptr_lo
002C84r 2  A5 rr              LDA   proc_entry_hi
002C86r 2  85 rr              STA   ptr_hi
002C88r 2  A0 02              LDY   #2
002C8Ar 2  B1 rr              LDA   (ptr_lo),Y
002C8Cr 2               
002C8Cr 2  C5 rr              CMP   proc_name_len
002C8Er 2  D0 37              BNE   @ne
002C90r 2               
002C90r 2                     ; Lengths match — compare chars
002C90r 2  AA                 TAX                         ; X = length
002C91r 2  F0 30              BEQ   @eq
002C93r 2  A0 00              LDY   #0                    ; char index
002C95r 2               @cmp:
002C95r 2  DA                 PHX
002C96r 2  5A                 PHY
002C97r 2                     ; Token char at eval_cur + TOK_PAYLOAD + 1 + charIdx
002C97r 2  A5 rr              LDA   eval_cur_lo
002C99r 2  85 rr              STA   ptr_lo
002C9Br 2  A5 rr              LDA   eval_cur_hi
002C9Dr 2  85 rr              STA   ptr_hi
002C9Fr 2  98                 TYA
002CA0r 2  18                 CLC
002CA1r 2  69 04              ADC   #TOK_PAYLOAD+1
002CA3r 2  A8                 TAY
002CA4r 2  B1 rr              LDA   (ptr_lo),Y
002CA6r 2  85 rr              STA   proc_rec_off          ; temp: token char
002CA8r 2               
002CA8r 2                     ; Record char at proc_entry + 3 + charIdx
002CA8r 2  7A                 PLY
002CA9r 2  5A                 PHY
002CAAr 2  A5 rr              LDA   proc_entry_lo
002CACr 2  85 rr              STA   ptr_lo
002CAEr 2  A5 rr              LDA   proc_entry_hi
002CB0r 2  85 rr              STA   ptr_hi
002CB2r 2  98                 TYA
002CB3r 2  18                 CLC
002CB4r 2  69 03              ADC   #3
002CB6r 2  A8                 TAY
002CB7r 2  B1 rr              LDA   (ptr_lo),Y
002CB9r 2               
002CB9r 2  C5 rr              CMP   proc_rec_off
002CBBr 2  D0 08              BNE   @ne_pop
002CBDr 2  7A                 PLY
002CBEr 2  FA                 PLX
002CBFr 2  C8                 INY
002CC0r 2  CA                 DEX
002CC1r 2  D0 D2              BNE   @cmp
002CC3r 2               @eq:
002CC3r 2  38                 SEC
002CC4r 2  60                 RTS
002CC5r 2               @ne_pop:
002CC5r 2  7A                 PLY
002CC6r 2  FA                 PLX
002CC7r 2               @ne:
002CC7r 2  18                 CLC
002CC8r 2  60                 RTS
002CC9r 2               
002CC9r 2               ; ---------------------------------------------------------------------
002CC9r 2               ; proc_invoke — invoke a user-defined procedure
002CC9r 2               ;   Input: eval_cur_lo/hi = TOK_WORD token (the procedure name)
002CC9r 2               ;          proc_entry_lo/hi = matching procedure record
002CC9r 2               ;   On exit: JMPs to eval_loop or eval_body to continue.
002CC9r 2               ; ---------------------------------------------------------------------
002CC9r 2               proc_invoke:
002CC9r 2                     ; Save outer tokenizer and eval state on the hardware stack.
002CC9r 2                     ; We push: tok_head(2), tok_tail(2), eval_in_body(1),
002CC9r 2                     ;          proc_stopped(1) = 6 bytes.
002CC9r 2                     ; input_buf is saved to BSS (128 bytes too large for stack).
002CC9r 2  A5 rr              LDA   tok_head_lo
002CCBr 2  48                 PHA
002CCCr 2  A5 rr              LDA   tok_head_hi
002CCEr 2  48                 PHA
002CCFr 2  A5 rr              LDA   tok_tail_lo
002CD1r 2  48                 PHA
002CD2r 2  A5 rr              LDA   tok_tail_hi
002CD4r 2  48                 PHA
002CD5r 2  A5 rr              LDA   eval_in_body
002CD7r 2  48                 PHA
002CD8r 2  A5 rr              LDA   proc_stopped
002CDAr 2  48                 PHA
002CDBr 2               
002CDBr 2                     ; Save input_buf to BSS save area
002CDBr 2  A2 00              LDX   #0
002CDDr 2               @save_ib:
002CDDr 2  BD rr rr           LDA   input_buf,X
002CE0r 2  9D rr rr           STA   save_input_buf,X
002CE3r 2  E8                 INX
002CE4r 2  E0 80              CPX   #128
002CE6r 2  D0 F5              BNE   @save_ib
002CE8r 2               
002CE8r 2                     ; Advance eval_cur past the procedure name token
002CE8r 2  20 rr rr           JSR   eval_advance
002CEBr 2               
002CEBr 2                     ; --- Bind parameters ---
002CEBr 2                     ; Navigate to param_count in the record:
002CEBr 2                     ;   offset = 3 + name_len
002CEBr 2  A5 rr              LDA   proc_entry_lo
002CEDr 2  85 rr              STA   ptr_lo
002CEFr 2  A5 rr              LDA   proc_entry_hi
002CF1r 2  85 rr              STA   ptr_hi
002CF3r 2  A0 02              LDY   #2
002CF5r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002CF7r 2  18                 CLC
002CF8r 2  69 03              ADC   #3
002CFAr 2  A8                 TAY                         ; Y = offset to param_count
002CFBr 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002CFDr 2  85 rr              STA   proc_param_cnt
002CFFr 2  C8                 INY                         ; Y = offset to first param name
002D00r 2  84 rr              STY   proc_rec_off          ; save record offset
002D02r 2               
002D02r 2  A5 rr              LDA   proc_param_cnt
002D04r 2  F0 5C              BEQ   @bind_done
002D06r 2               
002D06r 2  A6 rr              LDX   proc_param_cnt
002D08r 2               @bind_loop:
002D08r 2  DA                 PHX                         ; save remaining param count
002D09r 2               
002D09r 2                     ; First: evaluate the next argument from the caller's token stream.
002D09r 2                     ; eval_cur still points into the caller's token list.
002D09r 2  20 rr rr           JSR   eval_expr
002D0Cr 2  90 03              BCC   @arg_ok
002D0Er 2  4C rr rr           JMP   @bind_err
002D11r 2               @arg_ok:
002D11r 2               
002D11r 2                     ; eval_val now holds the argument value.
002D11r 2                     ; Push value onto stack (type + 3 value bytes = 4 bytes)
002D11r 2  A5 rr              LDA   eval_val_frac
002D13r 2  48                 PHA
002D14r 2  A5 rr              LDA   eval_val_lo
002D16r 2  48                 PHA
002D17r 2  A5 rr              LDA   eval_val_hi
002D19r 2  48                 PHA
002D1Ar 2  A5 rr              LDA   eval_type
002D1Cr 2  48                 PHA
002D1Dr 2               
002D1Dr 2                     ; Build the param name as a length-prefixed string in param_name_tmp
002D1Dr 2                     ; Read from record at proc_entry + proc_rec_off
002D1Dr 2  A5 rr              LDA   proc_entry_lo
002D1Fr 2  85 rr              STA   ptr_lo
002D21r 2  A5 rr              LDA   proc_entry_hi
002D23r 2  85 rr              STA   ptr_hi
002D25r 2  A4 rr              LDY   proc_rec_off
002D27r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002D29r 2  8D rr rr           STA   param_name_tmp        ; length byte
002D2Cr 2  AA                 TAX                         ; X = char count
002D2Dr 2  A9 00              LDA   #0
002D2Fr 2  85 rr              STA   proc_name_len         ; dest offset in param_name_tmp
002D31r 2               @bind_ch:
002D31r 2  E0 00              CPX   #0
002D33r 2  F0 0F              BEQ   @bind_ch_done
002D35r 2  C8                 INY
002D36r 2  B1 rr              LDA   (ptr_lo),Y
002D38r 2  DA                 PHX
002D39r 2  A6 rr              LDX   proc_name_len
002D3Br 2  9D rr rr           STA   param_name_tmp+1,X
002D3Er 2  E6 rr              INC   proc_name_len
002D40r 2  FA                 PLX
002D41r 2  CA                 DEX
002D42r 2  80 ED              BRA   @bind_ch
002D44r 2               @bind_ch_done:
002D44r 2                     ; Advance proc_rec_off past this param
002D44r 2  C8                 INY
002D45r 2  84 rr              STY   proc_rec_off
002D47r 2               
002D47r 2                     ; Pop value from stack back into eval_val
002D47r 2  68                 PLA
002D48r 2  85 rr              STA   eval_type
002D4Ar 2  68                 PLA
002D4Br 2  85 rr              STA   eval_val_hi
002D4Dr 2  68                 PLA
002D4Er 2  85 rr              STA   eval_val_lo
002D50r 2  68                 PLA
002D51r 2  85 rr              STA   eval_val_frac
002D53r 2               
002D53r 2                     ; Call var_set with ptr_lo/hi → param_name_tmp
002D53r 2  A9 rr              LDA   #<param_name_tmp
002D55r 2  85 rr              STA   ptr_lo
002D57r 2  A9 rr              LDA   #>param_name_tmp
002D59r 2  85 rr              STA   ptr_hi
002D5Br 2  20 rr rr           JSR   var_set
002D5Er 2               
002D5Er 2  FA                 PLX                         ; restore remaining count
002D5Fr 2  CA                 DEX
002D60r 2  D0 A6              BNE   @bind_loop
002D62r 2               
002D62r 2               @bind_done:
002D62r 2                     ; Save heap pointer AFTER param binding so var_set allocations persist.
002D62r 2                     ; Body tokenization will reuse heap from this point each line.
002D62r 2  A5 rr              LDA   heap_ptr
002D64r 2  8D rr rr           STA   save_heap_ptr_lo
002D67r 2  A5 rr              LDA   heap_ptr+1
002D69r 2  8D rr rr           STA   save_heap_ptr_hi
002D6Cr 2               
002D6Cr 2                     ; Save eval_cur (resume point after all args consumed from caller)
002D6Cr 2  A5 rr              LDA   eval_cur_lo
002D6Er 2  8D rr rr           STA   save_eval_cur_lo
002D71r 2  A5 rr              LDA   eval_cur_hi
002D73r 2  8D rr rr           STA   save_eval_cur_hi
002D76r 2               
002D76r 2                     ; --- Execute the body ---
002D76r 2                     ; Navigate to body in the record:
002D76r 2                     ;   proc_rec_off now points past all params.
002D76r 2                     ;   Next 2 bytes = body_len, then body text.
002D76r 2  A5 rr              LDA   proc_entry_lo
002D78r 2  85 rr              STA   ptr_lo
002D7Ar 2  A5 rr              LDA   proc_entry_hi
002D7Cr 2  85 rr              STA   ptr_hi
002D7Er 2  A4 rr              LDY   proc_rec_off
002D80r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_lo
002D82r 2  85 rr              STA   proc_body_len_lo
002D84r 2  C8                 INY
002D85r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_hi
002D87r 2  85 rr              STA   proc_body_len_hi
002D89r 2  C8                 INY                         ; Y = offset to body text start
002D8Ar 2  84 rr              STY   proc_rec_off
002D8Cr 2               
002D8Cr 2                     ; Compute absolute pointer to body text start
002D8Cr 2  18                 CLC
002D8Dr 2  A5 rr              LDA   proc_entry_lo
002D8Fr 2  65 rr              ADC   proc_rec_off
002D91r 2  85 rr              STA   proc_ptr_lo
002D93r 2  A5 rr              LDA   proc_entry_hi
002D95r 2  69 00              ADC   #0
002D97r 2  85 rr              STA   proc_ptr_hi
002D99r 2               
002D99r 2                     ; Process body line by line: find each $0A, copy line to input_buf,
002D99r 2                     ; tokenize, eval, repeat.
002D99r 2                     ; proc_ptr = current position in body text
002D99r 2                     ; proc_body_len = remaining bytes
002D99r 2               
002D99r 2                     ; Clear STOP/OUTPUT flag before executing body
002D99r 2  64 rr              STZ   proc_stopped
002D9Br 2               
002D9Br 2               @exec_line:
002D9Br 2                     ; Any body text remaining?
002D9Br 2  A5 rr              LDA   proc_body_len_lo
002D9Dr 2  05 rr              ORA   proc_body_len_hi
002D9Fr 2  D0 03              BNE   @have_body
002DA1r 2  4C rr rr           JMP   @exec_done
002DA4r 2               @have_body:
002DA4r 2               
002DA4r 2                     ; Reset heap for this statement's tokens (reuse token heap each statement)
002DA4r 2  AD rr rr           LDA   save_heap_ptr_lo
002DA7r 2  85 rr              STA   heap_ptr
002DA9r 2  AD rr rr           LDA   save_heap_ptr_hi
002DACr 2  85 rr              STA   heap_ptr+1
002DAEr 2               
002DAEr 2                     ; Accumulate physical lines into one logical statement: keep copying lines
002DAEr 2                     ; into input_buf until bracket/paren depth returns to 0, so a [ ... ] or
002DAEr 2                     ; ( ... ) that spans several lines is pieced together before we tokenize.
002DAEr 2  A2 00              LDX   #0                    ; input_buf index
002DB0r 2  9C rr rr           STZ   proc_brk_depth
002DB3r 2               @line_ch:
002DB3r 2  A5 rr              LDA   proc_body_len_lo
002DB5r 2  05 rr              ORA   proc_body_len_hi
002DB7r 2  F0 71              BEQ   @line_eol             ; no more body text -> end of last line
002DB9r 2               
002DB9r 2  A0 00              LDY   #0
002DBBr 2  B1 rr              LDA   (proc_ptr_lo),Y      ; read body char
002DBDr 2  C9 0A              CMP   #$0A
002DBFr 2  F0 5B              BEQ   @line_nl
002DC1r 2  C9 3B              CMP   #';'                 ; comment -> skip rest of physical line
002DC3r 2  F0 37              BEQ   @line_comment
002DC5r 2               
002DC5r 2                     ; Store char in input_buf, tracking bracket/paren nesting depth.
002DC5r 2  9D rr rr           STA   input_buf,X
002DC8r 2  E8                 INX
002DC9r 2  C9 5B              CMP   #'['
002DCBr 2  F0 20              BEQ   @brk_inc
002DCDr 2  C9 28              CMP   #'('
002DCFr 2  F0 1C              BEQ   @brk_inc
002DD1r 2  C9 5D              CMP   #']'
002DD3r 2  F0 1D              BEQ   @brk_dec
002DD5r 2  C9 29              CMP   #')'
002DD7r 2  F0 19              BEQ   @brk_dec
002DD9r 2               @brk_done:
002DD9r 2                     ; Advance body pointer
002DD9r 2  E6 rr              INC   proc_ptr_lo
002DDBr 2  D0 02              BNE   :+
002DDDr 2  E6 rr              INC   proc_ptr_hi
002DDFr 2               :     ; Decrement remaining
002DDFr 2  A5 rr              LDA   proc_body_len_lo
002DE1r 2  D0 02              BNE   @ln_dec_lo
002DE3r 2  C6 rr              DEC   proc_body_len_hi
002DE5r 2               @ln_dec_lo:
002DE5r 2  C6 rr              DEC   proc_body_len_lo
002DE7r 2                     ; Guard against input_buf overflow (~120 chars per statement).
002DE7r 2  E0 78              CPX   #120
002DE9r 2  B0 3F              BCS   @line_eol
002DEBr 2  80 C6              BRA   @line_ch
002DEDr 2               
002DEDr 2               @brk_inc:
002DEDr 2  EE rr rr           INC   proc_brk_depth
002DF0r 2  80 E7              BRA   @brk_done
002DF2r 2               @brk_dec:
002DF2r 2  AD rr rr           LDA   proc_brk_depth
002DF5r 2  F0 E2              BEQ   @brk_done             ; floor at 0
002DF7r 2  CE rr rr           DEC   proc_brk_depth
002DFAr 2  80 DD              BRA   @brk_done
002DFCr 2               
002DFCr 2               @line_comment:
002DFCr 2                     ; ';' begins a comment: advance past the rest of this physical line
002DFCr 2                     ; without copying, so comment text (and any brackets in it) is ignored.
002DFCr 2  A5 rr              LDA   proc_body_len_lo
002DFEr 2  05 rr              ORA   proc_body_len_hi
002E00r 2  F0 28              BEQ   @line_eol             ; comment runs to end of body
002E02r 2  A0 00              LDY   #0
002E04r 2  B1 rr              LDA   (proc_ptr_lo),Y
002E06r 2  48                 PHA                         ; remember if this was the newline
002E07r 2  E6 rr              INC   proc_ptr_lo
002E09r 2  D0 02              BNE   :+
002E0Br 2  E6 rr              INC   proc_ptr_hi
002E0Dr 2  A5 rr        :     LDA   proc_body_len_lo
002E0Fr 2  D0 02              BNE   @cmt_dec
002E11r 2  C6 rr              DEC   proc_body_len_hi
002E13r 2               @cmt_dec:
002E13r 2  C6 rr              DEC   proc_body_len_lo
002E15r 2  68                 PLA
002E16r 2  C9 0A              CMP   #$0A
002E18r 2  D0 E2              BNE   @line_comment         ; keep skipping comment chars
002E1Ar 2  80 0E              BRA   @line_eol             ; consumed the newline -> end of physical line
002E1Cr 2               
002E1Cr 2               @line_nl:
002E1Cr 2                     ; Skip the $0A
002E1Cr 2  E6 rr              INC   proc_ptr_lo
002E1Er 2  D0 02              BNE   :+
002E20r 2  E6 rr              INC   proc_ptr_hi
002E22r 2  A5 rr        :     LDA   proc_body_len_lo
002E24r 2  D0 02              BNE   @ln2_dec_lo
002E26r 2  C6 rr              DEC   proc_body_len_hi
002E28r 2               @ln2_dec_lo:
002E28r 2  C6 rr              DEC   proc_body_len_lo
002E2Ar 2                     ; fall through to end-of-physical-line decision
002E2Ar 2               
002E2Ar 2               @line_eol:
002E2Ar 2                     ; End of a physical line. If brackets/parens are still open AND there is
002E2Ar 2                     ; more body to read AND room in the buffer, append a separating space and
002E2Ar 2                     ; keep accumulating; otherwise the statement is complete.
002E2Ar 2  AD rr rr           LDA   proc_brk_depth
002E2Dr 2  F0 13              BEQ   @line_end             ; balanced -> execute
002E2Fr 2  A5 rr              LDA   proc_body_len_lo
002E31r 2  05 rr              ORA   proc_body_len_hi
002E33r 2  F0 0D              BEQ   @line_end             ; no more lines -> execute (eval will report)
002E35r 2  E0 78              CPX   #120
002E37r 2  B0 09              BCS   @line_end             ; buffer full -> execute
002E39r 2  A9 20              LDA   #' '                  ; join lines with whitespace
002E3Br 2  9D rr rr           STA   input_buf,X
002E3Er 2  E8                 INX
002E3Fr 2  4C rr rr           JMP   @line_ch
002E42r 2               
002E42r 2               @line_end:
002E42r 2                     ; Null-terminate input_buf
002E42r 2  9E rr rr           STZ   input_buf,X
002E45r 2               
002E45r 2                     ; Tokenize this line
002E45r 2  20 rr rr           JSR   tokenize_line
002E48r 2               
002E48r 2                     ; Save body-loop state that recursive proc_invoke would clobber.
002E48r 2                     ; BSS save areas (save_heap_ptr, save_eval_cur) plus ZP body-loop
002E48r 2                     ; variables (proc_ptr, proc_body_len) all need protection.
002E48r 2  A5 rr              LDA   proc_ptr_lo
002E4Ar 2  48                 PHA
002E4Br 2  A5 rr              LDA   proc_ptr_hi
002E4Dr 2  48                 PHA
002E4Er 2  A5 rr              LDA   proc_body_len_lo
002E50r 2  48                 PHA
002E51r 2  A5 rr              LDA   proc_body_len_hi
002E53r 2  48                 PHA
002E54r 2  AD rr rr           LDA   save_heap_ptr_lo
002E57r 2  48                 PHA
002E58r 2  AD rr rr           LDA   save_heap_ptr_hi
002E5Br 2  48                 PHA
002E5Cr 2  AD rr rr           LDA   save_eval_cur_lo
002E5Fr 2  48                 PHA
002E60r 2  AD rr rr           LDA   save_eval_cur_hi
002E63r 2  48                 PHA
002E64r 2               
002E64r 2                     ; Eval this line (full eval — not body mode)
002E64r 2  20 rr rr           JSR   eval_line
002E67r 2               
002E67r 2                     ; Restore body-loop state
002E67r 2  68                 PLA
002E68r 2  8D rr rr           STA   save_eval_cur_hi
002E6Br 2  68                 PLA
002E6Cr 2  8D rr rr           STA   save_eval_cur_lo
002E6Fr 2  68                 PLA
002E70r 2  8D rr rr           STA   save_heap_ptr_hi
002E73r 2  68                 PLA
002E74r 2  8D rr rr           STA   save_heap_ptr_lo
002E77r 2  68                 PLA
002E78r 2  85 rr              STA   proc_body_len_hi
002E7Ar 2  68                 PLA
002E7Br 2  85 rr              STA   proc_body_len_lo
002E7Dr 2  68                 PLA
002E7Er 2  85 rr              STA   proc_ptr_hi
002E80r 2  68                 PLA
002E81r 2  85 rr              STA   proc_ptr_lo
002E83r 2               
002E83r 2                     ; Check if STOP or OUTPUT was called — stop processing lines
002E83r 2  A5 rr              LDA   proc_stopped
002E85r 2  D0 03              BNE   @exec_done
002E87r 2               
002E87r 2  4C rr rr           JMP   @exec_line
002E8Ar 2               
002E8Ar 2               @exec_done:
002E8Ar 2                     ; Restore heap pointer (procedures stay, but per-line tokens freed)
002E8Ar 2  AD rr rr           LDA   save_heap_ptr_lo
002E8Dr 2  85 rr              STA   heap_ptr
002E8Fr 2  AD rr rr           LDA   save_heap_ptr_hi
002E92r 2  85 rr              STA   heap_ptr+1
002E94r 2               
002E94r 2                     ; Restore input_buf
002E94r 2  A2 00              LDX   #0
002E96r 2               @rest_ib:
002E96r 2  BD rr rr           LDA   save_input_buf,X
002E99r 2  9D rr rr           STA   input_buf,X
002E9Cr 2  E8                 INX
002E9Dr 2  E0 80              CPX   #128
002E9Fr 2  D0 F5              BNE   @rest_ib
002EA1r 2               
002EA1r 2                     ; Restore eval_cur to the resume point in the caller's token stream
002EA1r 2  AD rr rr           LDA   save_eval_cur_lo
002EA4r 2  85 rr              STA   eval_cur_lo
002EA6r 2  AD rr rr           LDA   save_eval_cur_hi
002EA9r 2  85 rr              STA   eval_cur_hi
002EABr 2               
002EABr 2                     ; Restore outer state from stack.
002EABr 2                     ; X returns this invocation's proc_stopped to the caller.
002EABr 2                     ; Stack layout (top to bottom):
002EABr 2                     ;   saved_proc_stopped, eval_in_body, tok_tail_hi, tok_tail_lo,
002EABr 2                     ;   tok_head_hi, tok_head_lo
002EABr 2  A6 rr              LDX   proc_stopped          ; X = this proc's exit state
002EADr 2  68                 PLA                         ; pop saved outer proc_stopped
002EAEr 2  85 rr              STA   proc_stopped          ; restore outer proc_stopped
002EB0r 2  68                 PLA
002EB1r 2  85 rr              STA   eval_in_body
002EB3r 2  68                 PLA
002EB4r 2  85 rr              STA   tok_tail_hi
002EB6r 2  68                 PLA
002EB7r 2  85 rr              STA   tok_tail_lo
002EB9r 2  68                 PLA
002EBAr 2  85 rr              STA   tok_head_hi
002EBCr 2  68                 PLA
002EBDr 2  85 rr              STA   tok_head_lo
002EBFr 2               
002EBFr 2                     ; Return with X = exit status ($00=normal, $01=STOP, $02=OUTPUT)
002EBFr 2  60                 RTS
002EC0r 2               
002EC0r 2               @bind_err:
002EC0r 2  FA                 PLX                         ; discard remaining param count
002EC1r 2                     ; Print error
002EC1r 2  A2 00              LDX   #0
002EC3r 2               @be_lp:
002EC3r 2  BD rr rr           LDA   str_notenough,X
002EC6r 2  F0 06              BEQ   @be_done
002EC8r 2  8D 0E A0           STA   VGC_CHAROUT
002ECBr 2  E8                 INX
002ECCr 2  D0 F5              BNE   @be_lp
002ECEr 2               @be_done:
002ECEr 2  20 rr rr           JSR   eval_newline
002ED1r 2                     ; Restore input_buf and stack, skip body execution
002ED1r 2  A2 00              LDX   #0
002ED3r 2               @be_rest_ib:
002ED3r 2  BD rr rr           LDA   save_input_buf,X
002ED6r 2  9D rr rr           STA   input_buf,X
002ED9r 2  E8                 INX
002EDAr 2  E0 80              CPX   #128
002EDCr 2  D0 F5              BNE   @be_rest_ib
002EDEr 2                     ; Restore stack (6 bytes: proc_stopped, eval_in_body, tok_tail, tok_head)
002EDEr 2  A2 00              LDX   #$00                  ; X = normal exit status
002EE0r 2  68                 PLA                         ; saved proc_stopped
002EE1r 2  85 rr              STA   proc_stopped
002EE3r 2  68                 PLA
002EE4r 2  85 rr              STA   eval_in_body
002EE6r 2  68                 PLA
002EE7r 2  85 rr              STA   tok_tail_hi
002EE9r 2  68                 PLA
002EEAr 2  85 rr              STA   tok_tail_lo
002EECr 2  68                 PLA
002EEDr 2  85 rr              STA   tok_head_hi
002EEFr 2  68                 PLA
002EF0r 2  85 rr              STA   tok_head_lo
002EF2r 2  60                 RTS
002EF3r 2               
002EF3r 2               ; ---------------------------------------------------------------------
002EF3r 2               ; proc_find_by_name — search proc_head for a procedure by name string
002EF3r 2               ;   Input: ptr_lo/hi = length-prefixed name string (e.g. from eval_val)
002EF3r 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002EF3r 2               ;           carry set = not found
002EF3r 2               ;   Clobbers: A, X, Y, proc_entry, proc_name_len, proc_rec_off
002EF3r 2               ; ---------------------------------------------------------------------
002EF3r 2               proc_find_by_name:
002EF3r 2                     ; Save search name pointer
002EF3r 2  A5 rr              LDA   ptr_lo
002EF5r 2  85 rr              STA   var_name_lo             ; reuse var scratch as search ptr
002EF7r 2  A5 rr              LDA   ptr_hi
002EF9r 2  85 rr              STA   var_name_hi
002EFBr 2               
002EFBr 2  A5 rr              LDA   proc_head_lo
002EFDr 2  85 rr              STA   proc_entry_lo
002EFFr 2  A5 rr              LDA   proc_head_hi
002F01r 2  85 rr              STA   proc_entry_hi
002F03r 2               
002F03r 2               @walk:
002F03r 2  A5 rr              LDA   proc_entry_lo
002F05r 2  05 rr              ORA   proc_entry_hi
002F07r 2  F0 55              BEQ   @not_found
002F09r 2               
002F09r 2                     ; Compare name lengths
002F09r 2  A5 rr              LDA   var_name_lo
002F0Br 2  85 rr              STA   ptr_lo
002F0Dr 2  A5 rr              LDA   var_name_hi
002F0Fr 2  85 rr              STA   ptr_hi
002F11r 2  A0 00              LDY   #0
002F13r 2  B1 rr              LDA   (ptr_lo),Y             ; search name length
002F15r 2  85 rr              STA   proc_name_len
002F17r 2               
002F17r 2  A5 rr              LDA   proc_entry_lo
002F19r 2  85 rr              STA   ptr_lo
002F1Br 2  A5 rr              LDA   proc_entry_hi
002F1Dr 2  85 rr              STA   ptr_hi
002F1Fr 2  A0 02              LDY   #2
002F21r 2  B1 rr              LDA   (ptr_lo),Y             ; record name length
002F23r 2  C5 rr              CMP   proc_name_len
002F25r 2  D0 32              BNE   @next
002F27r 2               
002F27r 2                     ; Lengths match — compare chars
002F27r 2  AA                 TAX                           ; X = length
002F28r 2  F0 2C              BEQ   @found                  ; both zero = match
002F2Ar 2  A0 00              LDY   #0
002F2Cr 2               @cmp:
002F2Cr 2  DA                 PHX
002F2Dr 2  5A                 PHY
002F2Er 2                     ; Search char
002F2Er 2  A5 rr              LDA   var_name_lo
002F30r 2  85 rr              STA   ptr_lo
002F32r 2  A5 rr              LDA   var_name_hi
002F34r 2  85 rr              STA   ptr_hi
002F36r 2  C8                 INY                           ; +1 for length byte
002F37r 2  B1 rr              LDA   (ptr_lo),Y
002F39r 2  85 rr              STA   proc_rec_off            ; temp: search char
002F3Br 2               
002F3Br 2                     ; Record char
002F3Br 2  7A                 PLY
002F3Cr 2  A5 rr              LDA   proc_entry_lo
002F3Er 2  85 rr              STA   ptr_lo
002F40r 2  A5 rr              LDA   proc_entry_hi
002F42r 2  85 rr              STA   ptr_hi
002F44r 2  5A                 PHY
002F45r 2  98                 TYA
002F46r 2  18                 CLC
002F47r 2  69 03              ADC   #3                      ; record name starts at offset 3
002F49r 2  A8                 TAY
002F4Ar 2  B1 rr              LDA   (ptr_lo),Y
002F4Cr 2  7A                 PLY
002F4Dr 2  C5 rr              CMP   proc_rec_off
002F4Fr 2  D0 07              BNE   @ne_pop
002F51r 2  FA                 PLX
002F52r 2  C8                 INY
002F53r 2  CA                 DEX
002F54r 2  D0 D6              BNE   @cmp
002F56r 2               
002F56r 2               @found:
002F56r 2  18                 CLC
002F57r 2  60                 RTS
002F58r 2               
002F58r 2               @ne_pop:
002F58r 2  FA                 PLX
002F59r 2               @next:
002F59r 2                     ; Follow next pointer
002F59r 2  20 rr rr           JSR   proc_next
002F5Cr 2  80 A5              BRA   @walk
002F5Er 2               
002F5Er 2               @not_found:
002F5Er 2  38                 SEC
002F5Fr 2  60                 RTS
002F60r 2               
002F60r 2               ; ---------------------------------------------------------------------
002F60r 2               ; do_pots — POTS: print all procedure names
002F60r 2               ;   Arity 0, no arguments.
002F60r 2               ; ---------------------------------------------------------------------
002F60r 2               do_pots:
002F60r 2  A5 rr              LDA   proc_head_lo
002F62r 2  85 rr              STA   proc_entry_lo
002F64r 2  A5 rr              LDA   proc_head_hi
002F66r 2  85 rr              STA   proc_entry_hi
002F68r 2               
002F68r 2               @walk:
002F68r 2  A5 rr              LDA   proc_entry_lo
002F6Ar 2  05 rr              ORA   proc_entry_hi
002F6Cr 2  F0 24              BEQ   @done
002F6Er 2               
002F6Er 2                     ; Print name
002F6Er 2  A5 rr              LDA   proc_entry_lo
002F70r 2  85 rr              STA   ptr_lo
002F72r 2  A5 rr              LDA   proc_entry_hi
002F74r 2  85 rr              STA   ptr_hi
002F76r 2  A0 02              LDY   #2
002F78r 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002F7Ar 2  AA                 TAX
002F7Br 2  F0 0B              BEQ   @skip_name
002F7Dr 2  A0 03              LDY   #3
002F7Fr 2               @pch:
002F7Fr 2  B1 rr              LDA   (ptr_lo),Y
002F81r 2  8D 0E A0           STA   VGC_CHAROUT
002F84r 2  C8                 INY
002F85r 2  CA                 DEX
002F86r 2  D0 F7              BNE   @pch
002F88r 2               @skip_name:
002F88r 2  A9 20              LDA   #' '
002F8Ar 2  8D 0E A0           STA   VGC_CHAROUT
002F8Dr 2               
002F8Dr 2                     ; Follow next
002F8Dr 2  20 rr rr           JSR   proc_next
002F90r 2  80 D6              BRA   @walk
002F92r 2               
002F92r 2               @done:
002F92r 2  20 rr rr           JSR   eval_newline
002F95r 2  4C rr rr           JMP   eval_continue
002F98r 2               
002F98r 2               ; ---------------------------------------------------------------------
002F98r 2               ; do_po — PO "name: print procedure definition
002F98r 2               ;   Arity 0 — evaluates its own argument
002F98r 2               ; ---------------------------------------------------------------------
002F98r 2               do_po:
002F98r 2  20 rr rr           JSR   eval_expr
002F9Br 2  90 03              BCC   @po_type_ok
002F9Dr 2  4C rr rr           JMP   @err
002FA0r 2               @po_type_ok:
002FA0r 2  A5 rr              LDA   eval_type
002FA2r 2  C9 01              CMP   #VAL_WORD
002FA4r 2  F0 03              BEQ   @po_word_ok
002FA6r 2  4C rr rr           JMP   @err
002FA9r 2               @po_word_ok:
002FA9r 2               
002FA9r 2                     ; Look up by name
002FA9r 2  A5 rr              LDA   eval_val_lo
002FABr 2  85 rr              STA   ptr_lo
002FADr 2  A5 rr              LDA   eval_val_hi
002FAFr 2  85 rr              STA   ptr_hi
002FB1r 2  20 rr rr           JSR   proc_find_by_name
002FB4r 2  90 03              BCC   @po_found
002FB6r 2  4C rr rr           JMP   @err_notfound
002FB9r 2               @po_found:
002FB9r 2               
002FB9r 2                     ; proc_entry_lo/hi = record
002FB9r 2                     ; Print "TO "
002FB9r 2  A9 54              LDA   #'T'
002FBBr 2  8D 0E A0           STA   VGC_CHAROUT
002FBEr 2  A9 4F              LDA   #'O'
002FC0r 2  8D 0E A0           STA   VGC_CHAROUT
002FC3r 2  A9 20              LDA   #' '
002FC5r 2  8D 0E A0           STA   VGC_CHAROUT
002FC8r 2               
002FC8r 2                     ; Print name
002FC8r 2  A5 rr              LDA   proc_entry_lo
002FCAr 2  85 rr              STA   ptr_lo
002FCCr 2  A5 rr              LDA   proc_entry_hi
002FCEr 2  85 rr              STA   ptr_hi
002FD0r 2  A0 02              LDY   #2
002FD2r 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002FD4r 2  AA                 TAX
002FD5r 2  85 rr              STA   proc_name_len
002FD7r 2  F0 0B              BEQ   @po_params
002FD9r 2  A0 03              LDY   #3
002FDBr 2               @po_name_ch:
002FDBr 2  B1 rr              LDA   (ptr_lo),Y
002FDDr 2  8D 0E A0           STA   VGC_CHAROUT
002FE0r 2  C8                 INY
002FE1r 2  CA                 DEX
002FE2r 2  D0 F7              BNE   @po_name_ch
002FE4r 2               
002FE4r 2               @po_params:
002FE4r 2                     ; Y = 3 + name_len = offset to param_count
002FE4r 2  A5 rr              LDA   proc_name_len
002FE6r 2  18                 CLC
002FE7r 2  69 03              ADC   #3
002FE9r 2  A8                 TAY
002FEAr 2  B1 rr              LDA   (ptr_lo),Y             ; param_count
002FECr 2  85 rr              STA   proc_param_cnt
002FEEr 2  C8                 INY                           ; offset to first param
002FEFr 2  84 rr              STY   proc_rec_off
002FF1r 2               
002FF1r 2  A5 rr              LDA   proc_param_cnt
002FF3r 2  F0 2E              BEQ   @po_header_done
002FF5r 2               
002FF5r 2  A6 rr              LDX   proc_param_cnt
002FF7r 2               @po_param:
002FF7r 2                     ; Print " :"
002FF7r 2  A9 20              LDA   #' '
002FF9r 2  8D 0E A0           STA   VGC_CHAROUT
002FFCr 2  A9 3A              LDA   #':'
002FFEr 2  8D 0E A0           STA   VGC_CHAROUT
003001r 2               
003001r 2                     ; Read param name length
003001r 2  A5 rr              LDA   proc_entry_lo
003003r 2  85 rr              STA   ptr_lo
003005r 2  A5 rr              LDA   proc_entry_hi
003007r 2  85 rr              STA   ptr_hi
003009r 2  A4 rr              LDY   proc_rec_off
00300Br 2  B1 rr              LDA   (ptr_lo),Y             ; param name length
00300Dr 2  DA                 PHX
00300Er 2  AA                 TAX                           ; X = chars to print
00300Fr 2  C8                 INY
003010r 2               @po_pch:
003010r 2  E0 00              CPX   #0
003012r 2  F0 09              BEQ   @po_param_done
003014r 2  B1 rr              LDA   (ptr_lo),Y
003016r 2  8D 0E A0           STA   VGC_CHAROUT
003019r 2  C8                 INY
00301Ar 2  CA                 DEX
00301Br 2  80 F3              BRA   @po_pch
00301Dr 2               @po_param_done:
00301Dr 2  84 rr              STY   proc_rec_off
00301Fr 2  FA                 PLX
003020r 2  CA                 DEX
003021r 2  D0 D4              BNE   @po_param
003023r 2               
003023r 2               @po_header_done:
003023r 2  20 rr rr           JSR   eval_newline
003026r 2               
003026r 2                     ; Read body_len
003026r 2  A5 rr              LDA   proc_entry_lo
003028r 2  85 rr              STA   ptr_lo
00302Ar 2  A5 rr              LDA   proc_entry_hi
00302Cr 2  85 rr              STA   ptr_hi
00302Er 2  A4 rr              LDY   proc_rec_off
003030r 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_lo
003032r 2  85 rr              STA   proc_body_len_lo
003034r 2  C8                 INY
003035r 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_hi
003037r 2  85 rr              STA   proc_body_len_hi
003039r 2  C8                 INY                           ; Y = offset to body text
00303Ar 2               
00303Ar 2                     ; Compute absolute pointer to body
00303Ar 2  84 rr              STY   proc_rec_off
00303Cr 2  18                 CLC
00303Dr 2  A5 rr              LDA   proc_entry_lo
00303Fr 2  65 rr              ADC   proc_rec_off
003041r 2  85 rr              STA   proc_ptr_lo
003043r 2  A5 rr              LDA   proc_entry_hi
003045r 2  69 00              ADC   #0
003047r 2  85 rr              STA   proc_ptr_hi
003049r 2               
003049r 2                     ; Print body text, converting $0A to CR+LF
003049r 2               @po_body:
003049r 2  A5 rr              LDA   proc_body_len_lo
00304Br 2  05 rr              ORA   proc_body_len_hi
00304Dr 2  F0 20              BEQ   @po_end
00304Fr 2               
00304Fr 2  A0 00              LDY   #0
003051r 2  B1 rr              LDA   (proc_ptr_lo),Y
003053r 2  C9 0A              CMP   #$0A
003055r 2  D0 05              BNE   @po_char
003057r 2  20 rr rr           JSR   eval_newline
00305Ar 2  80 03              BRA   @po_advance
00305Cr 2               @po_char:
00305Cr 2  8D 0E A0           STA   VGC_CHAROUT
00305Fr 2               @po_advance:
00305Fr 2  E6 rr              INC   proc_ptr_lo
003061r 2  D0 02              BNE   :+
003063r 2  E6 rr              INC   proc_ptr_hi
003065r 2  A5 rr        :     LDA   proc_body_len_lo
003067r 2  D0 02              BNE   :+
003069r 2  C6 rr              DEC   proc_body_len_hi
00306Br 2  C6 rr        :     DEC   proc_body_len_lo
00306Dr 2  80 DA              BRA   @po_body
00306Fr 2               
00306Fr 2               @po_end:
00306Fr 2                     ; Print "END"
00306Fr 2  A9 45              LDA   #'E'
003071r 2  8D 0E A0           STA   VGC_CHAROUT
003074r 2  A9 4E              LDA   #'N'
003076r 2  8D 0E A0           STA   VGC_CHAROUT
003079r 2  A9 44              LDA   #'D'
00307Br 2  8D 0E A0           STA   VGC_CHAROUT
00307Er 2  20 rr rr           JSR   eval_newline
003081r 2  4C rr rr           JMP   eval_continue
003084r 2               
003084r 2               @err:
003084r 2  A2 rr              LDX   #<str_po_name
003086r 2  A0 rr              LDY   #>str_po_name
003088r 2  4C rr rr           JMP   err_nei
00308Br 2               @err_notfound:
00308Br 2  A2 rr              LDX   #<str_idk
00308Dr 2  A0 rr              LDY   #>str_idk
00308Fr 2  4C rr rr           JMP   list_print_err
003092r 2               
003092r 2               ; ---------------------------------------------------------------------
003092r 2               ; do_erase — ERASE "name: remove procedure from directory
003092r 2               ;   Arity 0 — evaluates its own argument
003092r 2               ; ---------------------------------------------------------------------
003092r 2               do_erase:
003092r 2  20 rr rr           JSR   eval_expr
003095r 2  90 03              BCC   @er_type_ok
003097r 2  4C rr rr           JMP   @err
00309Ar 2               @er_type_ok:
00309Ar 2  A5 rr              LDA   eval_type
00309Cr 2  C9 01              CMP   #VAL_WORD
00309Er 2  F0 03              BEQ   @er_word_ok
0030A0r 2  4C rr rr           JMP   @err
0030A3r 2               @er_word_ok:
0030A3r 2               
0030A3r 2                     ; Save name pointer
0030A3r 2  A5 rr              LDA   eval_val_lo
0030A5r 2  85 rr              STA   var_name_lo
0030A7r 2  A5 rr              LDA   eval_val_hi
0030A9r 2  85 rr              STA   var_name_hi
0030ABr 2               
0030ABr 2                     ; Walk proc_head with prev tracking
0030ABr 2                     ; prev = address of "next" pointer to patch (starts as &proc_head)
0030ABr 2  A9 rr              LDA   #<proc_head_lo
0030ADr 2  85 rr              STA   proc_ptr_lo             ; prev_ptr_lo
0030AFr 2  A9 rr              LDA   #>proc_head_lo
0030B1r 2  85 rr              STA   proc_ptr_hi             ; prev_ptr_hi (ZP, so high byte = 0)
0030B3r 2               
0030B3r 2  A5 rr              LDA   proc_head_lo
0030B5r 2  85 rr              STA   proc_entry_lo
0030B7r 2  A5 rr              LDA   proc_head_hi
0030B9r 2  85 rr              STA   proc_entry_hi
0030BBr 2               
0030BBr 2               @walk:
0030BBr 2  A5 rr              LDA   proc_entry_lo
0030BDr 2  05 rr              ORA   proc_entry_hi
0030BFr 2  D0 03              BNE   @walk_ok
0030C1r 2  4C rr rr           JMP   @not_found
0030C4r 2               @walk_ok:
0030C4r 2               
0030C4r 2                     ; Compare name
0030C4r 2  A5 rr              LDA   var_name_lo
0030C6r 2  85 rr              STA   ptr_lo
0030C8r 2  A5 rr              LDA   var_name_hi
0030CAr 2  85 rr              STA   ptr_hi
0030CCr 2  A0 00              LDY   #0
0030CEr 2  B1 rr              LDA   (ptr_lo),Y             ; search name len
0030D0r 2  85 rr              STA   proc_name_len
0030D2r 2               
0030D2r 2  A5 rr              LDA   proc_entry_lo
0030D4r 2  85 rr              STA   ptr_lo
0030D6r 2  A5 rr              LDA   proc_entry_hi
0030D8r 2  85 rr              STA   ptr_hi
0030DAr 2  A0 02              LDY   #2
0030DCr 2  B1 rr              LDA   (ptr_lo),Y             ; record name len
0030DEr 2  C5 rr              CMP   proc_name_len
0030E0r 2  D0 32              BNE   @erase_next
0030E2r 2               
0030E2r 2  AA                 TAX
0030E3r 2  F0 3C              BEQ   @erase_match            ; both empty = match
0030E5r 2  A0 00              LDY   #0
0030E7r 2               @ecmp:
0030E7r 2  DA                 PHX
0030E8r 2  5A                 PHY
0030E9r 2  A5 rr              LDA   var_name_lo
0030EBr 2  85 rr              STA   ptr_lo
0030EDr 2  A5 rr              LDA   var_name_hi
0030EFr 2  85 rr              STA   ptr_hi
0030F1r 2  C8                 INY
0030F2r 2  B1 rr              LDA   (ptr_lo),Y             ; search char
0030F4r 2  85 rr              STA   proc_rec_off
0030F6r 2               
0030F6r 2  7A                 PLY
0030F7r 2  A5 rr              LDA   proc_entry_lo
0030F9r 2  85 rr              STA   ptr_lo
0030FBr 2  A5 rr              LDA   proc_entry_hi
0030FDr 2  85 rr              STA   ptr_hi
0030FFr 2  5A                 PHY
003100r 2  98                 TYA
003101r 2  18                 CLC
003102r 2  69 03              ADC   #3
003104r 2  A8                 TAY
003105r 2  B1 rr              LDA   (ptr_lo),Y             ; record char
003107r 2  7A                 PLY
003108r 2  C5 rr              CMP   proc_rec_off
00310Ar 2  D0 07              BNE   @ecmp_ne
00310Cr 2  FA                 PLX
00310Dr 2  C8                 INY
00310Er 2  CA                 DEX
00310Fr 2  D0 D6              BNE   @ecmp
003111r 2  80 0E              BRA   @erase_match
003113r 2               
003113r 2               @ecmp_ne:
003113r 2  FA                 PLX
003114r 2               
003114r 2               @erase_next:
003114r 2                     ; prev = &current->next (proc_entry + 0)
003114r 2  A5 rr              LDA   proc_entry_lo
003116r 2  85 rr              STA   proc_ptr_lo
003118r 2  A5 rr              LDA   proc_entry_hi
00311Ar 2  85 rr              STA   proc_ptr_hi
00311Cr 2                     ; current = current->next
00311Cr 2  20 rr rr           JSR   proc_next
00311Fr 2  80 9A              BRA   @walk
003121r 2               
003121r 2               @erase_match:
003121r 2                     ; Unlink: prev->next = current->next  (read current->next once)
003121r 2  A5 rr              LDA   proc_entry_lo
003123r 2  85 rr              STA   ptr_lo
003125r 2  A5 rr              LDA   proc_entry_hi
003127r 2  85 rr              STA   ptr_hi
003129r 2  A0 00              LDY   #0
00312Br 2  B1 rr              LDA   (ptr_lo),Y             ; next_lo -> X
00312Dr 2  AA                 TAX
00312Er 2  C8                 INY
00312Fr 2  B1 rr              LDA   (ptr_lo),Y             ; next_hi -> stack
003131r 2  48                 PHA
003132r 2  A5 rr              LDA   proc_ptr_lo            ; ptr = prev
003134r 2  85 rr              STA   ptr_lo
003136r 2  A5 rr              LDA   proc_ptr_hi
003138r 2  85 rr              STA   ptr_hi
00313Ar 2  A0 00              LDY   #0
00313Cr 2  8A                 TXA
00313Dr 2  91 rr              STA   (ptr_lo),Y             ; prev->next_lo = next_lo
00313Fr 2  C8                 INY
003140r 2  68                 PLA
003141r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_hi = next_hi
003143r 2               
003143r 2  4C rr rr           JMP   eval_continue
003146r 2               
003146r 2               @not_found:
003146r 2  A2 rr              LDX   #<str_idk
003148r 2  A0 rr              LDY   #>str_idk
00314Ar 2  4C rr rr           JMP   list_print_err
00314Dr 2               @err:
00314Dr 2  A2 rr              LDX   #<str_erase_name
00314Fr 2  A0 rr              LDY   #>str_erase_name
003151r 2  4C rr rr           JMP   err_nei
003154r 2               
003154r 2               ; ---------------------------------------------------------------------
003154r 2               ; do_apply — APPLY "proc [args]: call procedure with args from list
003154r 2               ;   Arity 0 — evaluates its own arguments
003154r 2               ;   Strategy: build "name arg1 arg2 ..." in input_buf, tokenize+eval.
003154r 2               ; ---------------------------------------------------------------------
003154r 2               do_apply:
003154r 2                     ; Evaluate first arg: procedure name (quoted word)
003154r 2  20 rr rr           JSR   eval_expr
003157r 2  90 03              BCC   @ap_type_ok
003159r 2  4C rr rr           JMP   @err
00315Cr 2               @ap_type_ok:
00315Cr 2  A5 rr              LDA   eval_type
00315Er 2  C9 01              CMP   #VAL_WORD
003160r 2  F0 03              BEQ   @ap_word_ok
003162r 2  4C rr rr           JMP   @err
003165r 2               @ap_word_ok:
003165r 2               
003165r 2                     ; Copy proc name to input_buf
003165r 2  A5 rr              LDA   eval_val_lo
003167r 2  85 rr              STA   ptr_lo
003169r 2  A5 rr              LDA   eval_val_hi
00316Br 2  85 rr              STA   ptr_hi
00316Dr 2  64 rr              STZ   z:buf_idx
00316Fr 2  A0 00              LDY   #0
003171r 2  B1 rr              LDA   (ptr_lo),Y             ; name length
003173r 2  AA                 TAX
003174r 2  F0 10              BEQ   @apply_args
003176r 2  C8                 INY
003177r 2               @apply_name:
003177r 2  B1 rr              LDA   (ptr_lo),Y
003179r 2  5A                 PHY
00317Ar 2  A4 rr              LDY   z:buf_idx
00317Cr 2  99 rr rr           STA   input_buf,Y
00317Fr 2  E6 rr              INC   z:buf_idx
003181r 2  7A                 PLY
003182r 2  C8                 INY
003183r 2  CA                 DEX
003184r 2  D0 F1              BNE   @apply_name
003186r 2               
003186r 2               @apply_args:
003186r 2                     ; Evaluate second arg: list of arguments
003186r 2  20 rr rr           JSR   eval_expr
003189r 2  B0 5B              BCS   @err
00318Br 2  A5 rr              LDA   eval_type
00318Dr 2  C9 02              CMP   #VAL_LIST
00318Fr 2  D0 55              BNE   @err
003191r 2               
003191r 2                     ; Render list elements to input_buf (after name)
003191r 2                     ; eval_val_lo/hi = list head
003191r 2  A5 rr              LDA   eval_val_lo
003193r 2  05 rr              ORA   eval_val_hi
003195r 2  F0 11              BEQ   @apply_run              ; empty arg list, just run name
003197r 2               
003197r 2                     ; Use render_list_to_buf — it prepends space before elements
003197r 2                     ; but we need a space before the first arg too
003197r 2  A5 rr              LDA   z:buf_idx
003199r 2  C9 7E              CMP   #126
00319Br 2  B0 0B              BCS   @apply_run
00319Dr 2  A8                 TAY
00319Er 2  A9 20              LDA   #' '
0031A0r 2  99 rr rr           STA   input_buf,Y
0031A3r 2  E6 rr              INC   z:buf_idx
0031A5r 2               
0031A5r 2                     ; render_list_to_buf expects eval_val set
0031A5r 2  20 rr rr           JSR   render_list_to_buf
0031A8r 2               
0031A8r 2               @apply_run:
0031A8r 2                     ; Null-terminate
0031A8r 2  A6 rr              LDX   z:buf_idx
0031AAr 2  9E rr rr           STZ   input_buf,X
0031ADr 2               
0031ADr 2                     ; Save eval state and tokenize+eval (same pattern as do_run)
0031ADr 2  A5 rr              LDA   eval_cur_lo
0031AFr 2  48                 PHA
0031B0r 2  A5 rr              LDA   eval_cur_hi
0031B2r 2  48                 PHA
0031B3r 2  A5 rr              LDA   tok_head_lo
0031B5r 2  48                 PHA
0031B6r 2  A5 rr              LDA   tok_head_hi
0031B8r 2  48                 PHA
0031B9r 2  A5 rr              LDA   tok_tail_lo
0031BBr 2  48                 PHA
0031BCr 2  A5 rr              LDA   tok_tail_hi
0031BEr 2  48                 PHA
0031BFr 2  A5 rr              LDA   eval_in_body
0031C1r 2  48                 PHA
0031C2r 2  A5 rr              LDA   eval_reporter
0031C4r 2  48                 PHA
0031C5r 2               
0031C5r 2  20 rr rr           JSR   tokenize_line
0031C8r 2  20 rr rr           JSR   eval_line
0031CBr 2               
0031CBr 2  68                 PLA
0031CCr 2  85 rr              STA   eval_reporter
0031CEr 2  68                 PLA
0031CFr 2  85 rr              STA   eval_in_body
0031D1r 2  68                 PLA
0031D2r 2  85 rr              STA   tok_tail_hi
0031D4r 2  68                 PLA
0031D5r 2  85 rr              STA   tok_tail_lo
0031D7r 2  68                 PLA
0031D8r 2  85 rr              STA   tok_head_hi
0031DAr 2  68                 PLA
0031DBr 2  85 rr              STA   tok_head_lo
0031DDr 2  68                 PLA
0031DEr 2  85 rr              STA   eval_cur_hi
0031E0r 2  68                 PLA
0031E1r 2  85 rr              STA   eval_cur_lo
0031E3r 2               
0031E3r 2  4C rr rr           JMP   eval_continue
0031E6r 2               
0031E6r 2               @err:
0031E6r 2  A2 rr              LDX   #<str_apply_name
0031E8r 2  A0 rr              LDY   #>str_apply_name
0031EAr 2  4C rr rr           JMP   err_nei
0031EDr 2               
0031EDr 2               ; =====================================================================
0031EDr 2               ; RODATA — procedure strings
0031EDr 2               ; =====================================================================
0031EDr 2                     .segment "RODATA"
00061Er 2               
00061Er 2               
00061Er 2               
00061Er 2               
00061Er 2               ; Builtin name strings for workspace commands
00061Er 2               str_po_name:
00061Er 2  02 50 4F           .byte 2, "PO"
000621r 2               str_printout_name:
000621r 2  08 50 52 49        .byte 8, "PRINTOUT"
000625r 2  4E 54 4F 55  
000629r 2  54           
00062Ar 2               str_pots_name:
00062Ar 2  04 50 4F 54        .byte 4, "POTS"
00062Er 2  53           
00062Fr 2               str_printtitles_name:
00062Fr 2  0B 50 52 49        .byte 11, "PRINTTITLES"
000633r 2  4E 54 54 49  
000637r 2  54 4C 45 53  
00063Br 2               str_erase_name:
00063Br 2  05 45 52 41        .byte 5, "ERASE"
00063Fr 2  53 45        
000641r 2               str_apply_name:
000641r 2  05 41 50 50        .byte 5, "APPLY"
000645r 2  4C 59        
000647r 2               
000647r 1                     .include "gc.s"
000647r 2               ; gc.s — mark-sweep garbage collector for NovaLogo
000647r 2               ;
000647r 2               ; Allocation header (prepended by heap_alloc):
000647r 2               ;   +0: alloc_tag  (bit 7 = mark, bits 6-0 = type)
000647r 2               ;   +1: alloc_size (total size including header; 0 = use 16-bit size at +2/+3)
000647r 2               ;
000647r 2               ; Type constants (bits 6-0 of alloc_tag):
000647r 2               ATYPE_FREE   = $00
000647r 2               ATYPE_TOKEN  = $01
000647r 2               ATYPE_CONS   = $02
000647r 2               ATYPE_VAR    = $03
000647r 2               ATYPE_PROC   = $04
000647r 2               ATYPE_STRING = $05
000647r 2               
000647r 2               ; Header layout offsets (relative to allocation base, NOT payload)
000647r 2               GC_HDR_TAG   = 0
000647r 2               GC_HDR_SIZE  = 1
000647r 2               GC_HDR_BYTES = 2              ; overhead per allocation
000647r 2               
000647r 2               ; Mark bit
000647r 2               ALLOC_MARK_BIT = $80
000647r 2               
000647r 2               ; =====================================================================
000647r 2               ; ZEROPAGE segment — GC variables
000647r 2               ; =====================================================================
000647r 2                     .segment "ZEROPAGE"
000048r 2               
000048r 2  xx           gc_ptr_lo:    .res 1          ; GC walk pointer low
000049r 2  xx           gc_ptr_hi:    .res 1          ; GC walk pointer high
00004Ar 2  xx           gc_tmp_lo:    .res 1          ; GC temp low
00004Br 2  xx           gc_tmp_hi:    .res 1          ; GC temp high
00004Cr 2  xx           gc_mark_lo:   .res 1          ; node-to-mark pointer low
00004Dr 2  xx           gc_mark_hi:   .res 1          ; node-to-mark pointer high
00004Er 2               
00004Er 2               ; =====================================================================
00004Er 2               ; CODE segment — GC routines
00004Er 2               ; =====================================================================
00004Er 2                     .segment "CODE"
0031EDr 2               
0031EDr 2               ; ---------------------------------------------------------------------
0031EDr 2               ; gc_collect — run a full mark-sweep garbage collection cycle
0031EDr 2               ;   1. Clear all mark bits
0031EDr 2               ;   2. Mark all reachable objects from roots
0031EDr 2               ;   3. Sweep: coalesce all unmarked blocks and reset heap_ptr
0031EDr 2               ;
0031EDr 2               ;   Clobbers: A, X, Y, gc_ptr, gc_tmp, gc_mark, ptr_lo/hi, ptr2_lo/hi
0031EDr 2               ; ---------------------------------------------------------------------
0031EDr 2               gc_collect:
0031EDr 2                     ; Phase 1: Clear all mark bits by walking the heap linearly
0031EDr 2  A9 00              LDA   #<HEAP_START
0031EFr 2  85 rr              STA   gc_ptr_lo
0031F1r 2  A9 05              LDA   #>HEAP_START
0031F3r 2  85 rr              STA   gc_ptr_hi
0031F5r 2               
0031F5r 2               @clear_loop:
0031F5r 2                     ; Have we reached heap_ptr (end of allocated space)?
0031F5r 2  A5 rr              LDA   gc_ptr_hi
0031F7r 2  C5 rr              CMP   heap_ptr+1
0031F9r 2  90 08              BCC   @clear_one
0031FBr 2  D0 41              BNE   @clear_done
0031FDr 2  A5 rr              LDA   gc_ptr_lo
0031FFr 2  C5 rr              CMP   heap_ptr
003201r 2  B0 3B              BCS   @clear_done
003203r 2               
003203r 2               @clear_one:
003203r 2                     ; Clear mark bit on this allocation
003203r 2  A5 rr              LDA   gc_ptr_lo
003205r 2  85 rr              STA   ptr_lo
003207r 2  A5 rr              LDA   gc_ptr_hi
003209r 2  85 rr              STA   ptr_hi
00320Br 2  A0 00              LDY   #GC_HDR_TAG
00320Dr 2  B1 rr              LDA   (ptr_lo),Y
00320Fr 2  29 7F              AND   #<~ALLOC_MARK_BIT    ; clear bit 7
003211r 2  91 rr              STA   (ptr_lo),Y
003213r 2               
003213r 2                     ; Advance by alloc_size
003213r 2  A0 01              LDY   #GC_HDR_SIZE
003215r 2  B1 rr              LDA   (ptr_lo),Y
003217r 2  F0 0B              BEQ   @clear_big           ; size=0 means 16-bit size at +2/+3
003219r 2  18                 CLC
00321Ar 2  65 rr              ADC   gc_ptr_lo
00321Cr 2  85 rr              STA   gc_ptr_lo
00321Er 2  90 D5              BCC   @clear_loop
003220r 2  E6 rr              INC   gc_ptr_hi
003222r 2  80 D1              BRA   @clear_loop
003224r 2               
003224r 2               @clear_big:
003224r 2                     ; 16-bit size at payload offset 0 and 1 (header +2 and +3)
003224r 2  A0 02              LDY   #GC_HDR_BYTES
003226r 2  B1 rr              LDA   (ptr_lo),Y
003228r 2  85 rr              STA   gc_tmp_lo
00322Ar 2  C8                 INY
00322Br 2  B1 rr              LDA   (ptr_lo),Y
00322Dr 2  85 rr              STA   gc_tmp_hi
00322Fr 2  18                 CLC
003230r 2  A5 rr              LDA   gc_ptr_lo
003232r 2  65 rr              ADC   gc_tmp_lo
003234r 2  85 rr              STA   gc_ptr_lo
003236r 2  A5 rr              LDA   gc_ptr_hi
003238r 2  65 rr              ADC   gc_tmp_hi
00323Ar 2  85 rr              STA   gc_ptr_hi
00323Cr 2  80 B7              BRA   @clear_loop
00323Er 2               
00323Er 2               @clear_done:
00323Er 2               
00323Er 2                     ; Phase 2: Mark all reachable objects
00323Er 2                     ; Root 1: variable list (var_head)
00323Er 2  20 rr rr           JSR   gc_mark_vars
003241r 2               
003241r 2                     ; Root 2: procedure list (proc_head)
003241r 2  20 rr rr           JSR   gc_mark_procs
003244r 2               
003244r 2                     ; Root 3: current token list (tok_head)
003244r 2  20 rr rr           JSR   gc_mark_token_list
003247r 2               
003247r 2                     ; Phase 3: Sweep — find the highest marked allocation,
003247r 2                     ; reset heap_ptr to just past it. This works because we
003247r 2                     ; use a bump allocator with no free list; all unmarked
003247r 2                     ; allocations between marked ones become wasted space,
003247r 2                     ; but in practice the permanent objects (vars, procs) are
003247r 2                     ; allocated early and the ephemeral ones (tokens, cons,
003247r 2                     ; strings) are allocated later and all unmarked — so
003247r 2                     ; heap_ptr shrinks back dramatically.
003247r 2                     ;
003247r 2                     ; Walk the heap forward; track the highest end-address
003247r 2                     ; of any marked allocation.
003247r 2  A9 00              LDA   #<HEAP_START
003249r 2  85 rr              STA   gc_ptr_lo
00324Br 2  A9 05              LDA   #>HEAP_START
00324Dr 2  85 rr              STA   gc_ptr_hi
00324Fr 2                     ; gc_tmp = highest marked end (start at HEAP_START = nothing marked)
00324Fr 2  A9 00              LDA   #<HEAP_START
003251r 2  85 rr              STA   gc_tmp_lo
003253r 2  A9 05              LDA   #>HEAP_START
003255r 2  85 rr              STA   gc_tmp_hi
003257r 2               
003257r 2               @sweep_loop:
003257r 2                     ; Reached end of allocated space?
003257r 2  A5 rr              LDA   gc_ptr_hi
003259r 2  C5 rr              CMP   heap_ptr+1
00325Br 2  90 08              BCC   @sweep_one
00325Dr 2  D0 49              BNE   @sweep_done
00325Fr 2  A5 rr              LDA   gc_ptr_lo
003261r 2  C5 rr              CMP   heap_ptr
003263r 2  B0 43              BCS   @sweep_done
003265r 2               
003265r 2               @sweep_one:
003265r 2  A5 rr              LDA   gc_ptr_lo
003267r 2  85 rr              STA   ptr_lo
003269r 2  A5 rr              LDA   gc_ptr_hi
00326Br 2  85 rr              STA   ptr_hi
00326Dr 2               
00326Dr 2                     ; Get size of this allocation
00326Dr 2  A0 01              LDY   #GC_HDR_SIZE
00326Fr 2  B1 rr              LDA   (ptr_lo),Y
003271r 2  F0 06              BEQ   @sweep_big
003273r 2  85 rr              STA   gc_mark_lo            ; use gc_mark_lo as temp for size
003275r 2  64 rr              STZ   gc_mark_hi
003277r 2  80 0B              BRA   @sweep_check_mark
003279r 2               
003279r 2               @sweep_big:
003279r 2  A0 02              LDY   #GC_HDR_BYTES
00327Br 2  B1 rr              LDA   (ptr_lo),Y
00327Dr 2  85 rr              STA   gc_mark_lo
00327Fr 2  C8                 INY
003280r 2  B1 rr              LDA   (ptr_lo),Y
003282r 2  85 rr              STA   gc_mark_hi
003284r 2               
003284r 2               @sweep_check_mark:
003284r 2                     ; Is this allocation marked?
003284r 2  A0 00              LDY   #GC_HDR_TAG
003286r 2  B1 rr              LDA   (ptr_lo),Y
003288r 2  29 80              AND   #ALLOC_MARK_BIT
00328Ar 2  F0 0D              BEQ   @sweep_advance        ; not marked — skip
00328Cr 2               
00328Cr 2                     ; Marked — compute end address = gc_ptr + size
00328Cr 2  18                 CLC
00328Dr 2  A5 rr              LDA   gc_ptr_lo
00328Fr 2  65 rr              ADC   gc_mark_lo
003291r 2  85 rr              STA   gc_tmp_lo             ; update highest end
003293r 2  A5 rr              LDA   gc_ptr_hi
003295r 2  65 rr              ADC   gc_mark_hi
003297r 2  85 rr              STA   gc_tmp_hi
003299r 2               
003299r 2               @sweep_advance:
003299r 2                     ; Advance gc_ptr by size
003299r 2  18                 CLC
00329Ar 2  A5 rr              LDA   gc_ptr_lo
00329Cr 2  65 rr              ADC   gc_mark_lo
00329Er 2  85 rr              STA   gc_ptr_lo
0032A0r 2  A5 rr              LDA   gc_ptr_hi
0032A2r 2  65 rr              ADC   gc_mark_hi
0032A4r 2  85 rr              STA   gc_ptr_hi
0032A6r 2  80 AF              BRA   @sweep_loop
0032A8r 2               
0032A8r 2               @sweep_done:
0032A8r 2                     ; Set heap_ptr to highest marked end
0032A8r 2  A5 rr              LDA   gc_tmp_lo
0032AAr 2  85 rr              STA   heap_ptr
0032ACr 2  A5 rr              LDA   gc_tmp_hi
0032AEr 2  85 rr              STA   heap_ptr+1
0032B0r 2  60                 RTS
0032B1r 2               
0032B1r 2               ; ---------------------------------------------------------------------
0032B1r 2               ; gc_mark_node — mark a single allocation given a payload pointer
0032B1r 2               ;   Input: gc_mark_lo/hi = pointer to payload (header is at -2)
0032B1r 2               ;   If pointer is $0000 or below HEAP_START, skip.
0032B1r 2               ;   Clobbers: A, Y (preserves gc_mark_lo/hi)
0032B1r 2               ; ---------------------------------------------------------------------
0032B1r 2               gc_mark_node:
0032B1r 2                     ; Null check
0032B1r 2  A5 rr              LDA   gc_mark_lo
0032B3r 2  05 rr              ORA   gc_mark_hi
0032B5r 2  F0 21              BEQ   @done
0032B7r 2               
0032B7r 2                     ; Compute header address = payload - 2
0032B7r 2  A5 rr              LDA   gc_mark_lo
0032B9r 2  38                 SEC
0032BAr 2  E9 02              SBC   #GC_HDR_BYTES
0032BCr 2  85 rr              STA   ptr_lo
0032BEr 2  A5 rr              LDA   gc_mark_hi
0032C0r 2  E9 00              SBC   #0
0032C2r 2  85 rr              STA   ptr_hi
0032C4r 2               
0032C4r 2                     ; Range check: must be >= HEAP_START
0032C4r 2  C9 05              CMP   #>HEAP_START
0032C6r 2  90 10              BCC   @done
0032C8r 2  D0 06              BNE   @in_range
0032CAr 2  A5 rr              LDA   ptr_lo
0032CCr 2  C9 00              CMP   #<HEAP_START
0032CEr 2  90 08              BCC   @done
0032D0r 2               @in_range:
0032D0r 2               
0032D0r 2                     ; Set mark bit
0032D0r 2  A0 00              LDY   #GC_HDR_TAG
0032D2r 2  B1 rr              LDA   (ptr_lo),Y
0032D4r 2  09 80              ORA   #ALLOC_MARK_BIT
0032D6r 2  91 rr              STA   (ptr_lo),Y
0032D8r 2               @done:
0032D8r 2  60                 RTS
0032D9r 2               
0032D9r 2               ; ---------------------------------------------------------------------
0032D9r 2               ; gc_mark_vars — walk the variable linked list and mark each entry
0032D9r 2               ;   Also marks any list values pointed to by variables.
0032D9r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_mark, ptr_lo/hi, ptr2_lo/hi
0032D9r 2               ; ---------------------------------------------------------------------
0032D9r 2               gc_mark_vars:
0032D9r 2  A5 rr              LDA   var_head_lo
0032DBr 2  85 rr              STA   gc_ptr_lo
0032DDr 2  A5 rr              LDA   var_head_hi
0032DFr 2  85 rr              STA   gc_ptr_hi
0032E1r 2               
0032E1r 2               @walk:
0032E1r 2  A5 rr              LDA   gc_ptr_lo
0032E3r 2  05 rr              ORA   gc_ptr_hi
0032E5r 2  D0 01              BNE   @have_var
0032E7r 2  60                 RTS
0032E8r 2               @have_var:
0032E8r 2               
0032E8r 2                     ; Mark this var entry
0032E8r 2  A5 rr              LDA   gc_ptr_lo
0032EAr 2  85 rr              STA   gc_mark_lo
0032ECr 2  A5 rr              LDA   gc_ptr_hi
0032EEr 2  85 rr              STA   gc_mark_hi
0032F0r 2  20 rr rr           JSR   gc_mark_node
0032F3r 2               
0032F3r 2                     ; Read the variable's value — if it's a list, mark the list
0032F3r 2  A5 rr              LDA   gc_ptr_lo
0032F5r 2  85 rr              STA   ptr_lo
0032F7r 2  A5 rr              LDA   gc_ptr_hi
0032F9r 2  85 rr              STA   ptr_hi
0032FBr 2  A0 02              LDY   #VAR_NAME_LEN
0032FDr 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
0032FFr 2  18                 CLC
003300r 2  69 03              ADC   #VAR_NAME             ; offset to value_type
003302r 2  A8                 TAY
003303r 2  B1 rr              LDA   (ptr_lo),Y           ; value_type
003305r 2  C9 02              CMP   #VAL_LIST
003307r 2  D0 23              BNE   @var_check_word
003309r 2                     ; It's a list — get the list head pointer and mark the list
003309r 2  C8                 INY
00330Ar 2  B1 rr              LDA   (ptr_lo),Y           ; val_hi (actually car_hi)
00330Cr 2  85 rr              STA   gc_tmp_hi
00330Er 2  C8                 INY
00330Fr 2  B1 rr              LDA   (ptr_lo),Y           ; val_lo
003311r 2  85 rr              STA   gc_tmp_lo
003313r 2                     ; Save gc_ptr across recursive mark
003313r 2  A5 rr              LDA   gc_ptr_lo
003315r 2  48                 PHA
003316r 2  A5 rr              LDA   gc_ptr_hi
003318r 2  48                 PHA
003319r 2  A5 rr              LDA   gc_tmp_lo
00331Br 2  85 rr              STA   gc_mark_lo
00331Dr 2  A5 rr              LDA   gc_tmp_hi
00331Fr 2  85 rr              STA   gc_mark_hi
003321r 2  20 rr rr           JSR   gc_mark_list
003324r 2  68                 PLA
003325r 2  85 rr              STA   gc_ptr_hi
003327r 2  68                 PLA
003328r 2  85 rr              STA   gc_ptr_lo
00332Ar 2  80 25              BRA   @var_next
00332Cr 2               
00332Cr 2               @var_check_word:
00332Cr 2  C9 01              CMP   #VAL_WORD
00332Er 2  D0 21              BNE   @var_next
003330r 2                     ; It's a word — mark the string allocation
003330r 2  C8                 INY
003331r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_hi for word
003333r 2  85 rr              STA   gc_tmp_hi
003335r 2  C8                 INY
003336r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_lo for word
003338r 2  85 rr              STA   gc_tmp_lo
00333Ar 2  A5 rr              LDA   gc_ptr_lo
00333Cr 2  48                 PHA
00333Dr 2  A5 rr              LDA   gc_ptr_hi
00333Fr 2  48                 PHA
003340r 2  A5 rr              LDA   gc_tmp_lo
003342r 2  85 rr              STA   gc_mark_lo
003344r 2  A5 rr              LDA   gc_tmp_hi
003346r 2  85 rr              STA   gc_mark_hi
003348r 2  20 rr rr           JSR   gc_mark_node
00334Br 2  68                 PLA
00334Cr 2  85 rr              STA   gc_ptr_hi
00334Er 2  68                 PLA
00334Fr 2  85 rr              STA   gc_ptr_lo
003351r 2               
003351r 2               @var_next:
003351r 2                     ; Follow next pointer
003351r 2  A5 rr              LDA   gc_ptr_lo
003353r 2  85 rr              STA   ptr_lo
003355r 2  A5 rr              LDA   gc_ptr_hi
003357r 2  85 rr              STA   ptr_hi
003359r 2  A0 00              LDY   #VAR_NEXT_LO
00335Br 2  B1 rr              LDA   (ptr_lo),Y
00335Dr 2  AA                 TAX
00335Er 2  C8                 INY
00335Fr 2  B1 rr              LDA   (ptr_lo),Y
003361r 2  85 rr              STA   gc_ptr_hi
003363r 2  86 rr              STX   gc_ptr_lo
003365r 2  4C rr rr           JMP   @walk
003368r 2               
003368r 2               ; ---------------------------------------------------------------------
003368r 2               ; gc_mark_procs — walk the procedure list and mark each record
003368r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
003368r 2               ; ---------------------------------------------------------------------
003368r 2               gc_mark_procs:
003368r 2  A5 rr              LDA   proc_head_lo
00336Ar 2  85 rr              STA   gc_ptr_lo
00336Cr 2  A5 rr              LDA   proc_head_hi
00336Er 2  85 rr              STA   gc_ptr_hi
003370r 2               
003370r 2               @walk:
003370r 2  A5 rr              LDA   gc_ptr_lo
003372r 2  05 rr              ORA   gc_ptr_hi
003374r 2  F0 2B              BEQ   @done
003376r 2               
003376r 2                     ; Mark this procedure record.
003376r 2                     ; proc_entry points to record data (base+4); header is at base+0.
003376r 2                     ; Subtract 4 to get the header address for marking.
003376r 2  A5 rr              LDA   gc_ptr_lo
003378r 2  38                 SEC
003379r 2  E9 04              SBC   #4
00337Br 2  85 rr              STA   ptr_lo
00337Dr 2  A5 rr              LDA   gc_ptr_hi
00337Fr 2  E9 00              SBC   #0
003381r 2  85 rr              STA   ptr_hi
003383r 2                     ; Set mark bit directly at the header
003383r 2  A0 00              LDY   #GC_HDR_TAG
003385r 2  B1 rr              LDA   (ptr_lo),Y
003387r 2  09 80              ORA   #ALLOC_MARK_BIT
003389r 2  91 rr              STA   (ptr_lo),Y
00338Br 2               
00338Br 2                     ; Follow next pointer (at record data offset 0)
00338Br 2  A5 rr              LDA   gc_ptr_lo
00338Dr 2  85 rr              STA   ptr_lo
00338Fr 2  A5 rr              LDA   gc_ptr_hi
003391r 2  85 rr              STA   ptr_hi
003393r 2  A0 00              LDY   #0                    ; next_lo at offset 0
003395r 2  B1 rr              LDA   (ptr_lo),Y
003397r 2  AA                 TAX
003398r 2  C8                 INY
003399r 2  B1 rr              LDA   (ptr_lo),Y
00339Br 2  85 rr              STA   gc_ptr_hi
00339Dr 2  86 rr              STX   gc_ptr_lo
00339Fr 2  80 CF              BRA   @walk
0033A1r 2               
0033A1r 2               @done:
0033A1r 2  60                 RTS
0033A2r 2               
0033A2r 2               ; ---------------------------------------------------------------------
0033A2r 2               ; gc_mark_token_list — walk tok_head linked list and mark each token
0033A2r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
0033A2r 2               ; ---------------------------------------------------------------------
0033A2r 2               gc_mark_token_list:
0033A2r 2  A5 rr              LDA   tok_head_lo
0033A4r 2  85 rr              STA   gc_ptr_lo
0033A6r 2  A5 rr              LDA   tok_head_hi
0033A8r 2  85 rr              STA   gc_ptr_hi
0033AAr 2               
0033AAr 2               @walk:
0033AAr 2  A5 rr              LDA   gc_ptr_lo
0033ACr 2  05 rr              ORA   gc_ptr_hi
0033AEr 2  F0 21              BEQ   @done
0033B0r 2               
0033B0r 2                     ; Mark this token
0033B0r 2  A5 rr              LDA   gc_ptr_lo
0033B2r 2  85 rr              STA   gc_mark_lo
0033B4r 2  A5 rr              LDA   gc_ptr_hi
0033B6r 2  85 rr              STA   gc_mark_hi
0033B8r 2  20 rr rr           JSR   gc_mark_node
0033BBr 2               
0033BBr 2                     ; Follow next pointer (at payload offsets TOK_NEXT_LO/HI)
0033BBr 2  A5 rr              LDA   gc_ptr_lo
0033BDr 2  85 rr              STA   ptr_lo
0033BFr 2  A5 rr              LDA   gc_ptr_hi
0033C1r 2  85 rr              STA   ptr_hi
0033C3r 2  A0 01              LDY   #TOK_NEXT_LO
0033C5r 2  B1 rr              LDA   (ptr_lo),Y
0033C7r 2  AA                 TAX
0033C8r 2  C8                 INY
0033C9r 2  B1 rr              LDA   (ptr_lo),Y
0033CBr 2  85 rr              STA   gc_ptr_hi
0033CDr 2  86 rr              STX   gc_ptr_lo
0033CFr 2  80 D9              BRA   @walk
0033D1r 2               
0033D1r 2               @done:
0033D1r 2  60                 RTS
0033D2r 2               
0033D2r 2               ; ---------------------------------------------------------------------
0033D2r 2               ; gc_mark_list — recursively mark a cons-pair list
0033D2r 2               ;   Input: gc_mark_lo/hi = head cons pair pointer (payload)
0033D2r 2               ;   Marks each cons cell, and recursively marks sublists and word strings.
0033D2r 2               ;   Clobbers: A, X, Y, gc_mark, gc_ptr, ptr_lo/hi
0033D2r 2               ; ---------------------------------------------------------------------
0033D2r 2               gc_mark_list:
0033D2r 2                     ; Use gc_ptr to walk the list, gc_mark for marking
0033D2r 2  A5 rr              LDA   gc_mark_lo
0033D4r 2  85 rr              STA   gc_ptr_lo
0033D6r 2  A5 rr              LDA   gc_mark_hi
0033D8r 2  85 rr              STA   gc_ptr_hi
0033DAr 2               
0033DAr 2               @walk:
0033DAr 2  A5 rr              LDA   gc_ptr_lo
0033DCr 2  05 rr              ORA   gc_ptr_hi
0033DEr 2  F0 70              BEQ   @done
0033E0r 2               
0033E0r 2                     ; Mark this cons pair
0033E0r 2  A5 rr              LDA   gc_ptr_lo
0033E2r 2  85 rr              STA   gc_mark_lo
0033E4r 2  A5 rr              LDA   gc_ptr_hi
0033E6r 2  85 rr              STA   gc_mark_hi
0033E8r 2  20 rr rr           JSR   gc_mark_node
0033EBr 2               
0033EBr 2                     ; Check car_type: if list, recursively mark sublist
0033EBr 2                     ; if word, mark the string
0033EBr 2  A5 rr              LDA   gc_ptr_lo
0033EDr 2  85 rr              STA   ptr_lo
0033EFr 2  A5 rr              LDA   gc_ptr_hi
0033F1r 2  85 rr              STA   ptr_hi
0033F3r 2  A0 01              LDY   #CONS_CAR_TYPE
0033F5r 2  B1 rr              LDA   (ptr_lo),Y
0033F7r 2  C9 02              CMP   #VAL_LIST
0033F9r 2  F0 23              BEQ   @car_list
0033FBr 2  C9 01              CMP   #VAL_WORD
0033FDr 2  F0 02              BEQ   @car_word
0033FFr 2  80 38              BRA   @follow_cdr
003401r 2               
003401r 2               @car_word:
003401r 2                     ; Mark the word string allocation
003401r 2  A0 03              LDY   #CONS_CAR_LO
003403r 2  B1 rr              LDA   (ptr_lo),Y
003405r 2  85 rr              STA   gc_mark_lo
003407r 2  A0 02              LDY   #CONS_CAR_HI
003409r 2  B1 rr              LDA   (ptr_lo),Y
00340Br 2  85 rr              STA   gc_mark_hi
00340Dr 2                     ; Save gc_ptr across mark
00340Dr 2  A5 rr              LDA   gc_ptr_lo
00340Fr 2  48                 PHA
003410r 2  A5 rr              LDA   gc_ptr_hi
003412r 2  48                 PHA
003413r 2  20 rr rr           JSR   gc_mark_node
003416r 2  68                 PLA
003417r 2  85 rr              STA   gc_ptr_hi
003419r 2  68                 PLA
00341Ar 2  85 rr              STA   gc_ptr_lo
00341Cr 2  80 1B              BRA   @follow_cdr
00341Er 2               
00341Er 2               @car_list:
00341Er 2                     ; Recursively mark the sublist
00341Er 2  A0 03              LDY   #CONS_CAR_LO
003420r 2  B1 rr              LDA   (ptr_lo),Y
003422r 2  85 rr              STA   gc_mark_lo
003424r 2  A0 02              LDY   #CONS_CAR_HI
003426r 2  B1 rr              LDA   (ptr_lo),Y
003428r 2  85 rr              STA   gc_mark_hi
00342Ar 2                     ; Save gc_ptr across recursive call
00342Ar 2  A5 rr              LDA   gc_ptr_lo
00342Cr 2  48                 PHA
00342Dr 2  A5 rr              LDA   gc_ptr_hi
00342Fr 2  48                 PHA
003430r 2  20 rr rr           JSR   gc_mark_list          ; recursive
003433r 2  68                 PLA
003434r 2  85 rr              STA   gc_ptr_hi
003436r 2  68                 PLA
003437r 2  85 rr              STA   gc_ptr_lo
003439r 2               
003439r 2               @follow_cdr:
003439r 2                     ; Follow cdr to next cons pair
003439r 2  A5 rr              LDA   gc_ptr_lo
00343Br 2  85 rr              STA   ptr_lo
00343Dr 2  A5 rr              LDA   gc_ptr_hi
00343Fr 2  85 rr              STA   ptr_hi
003441r 2  A0 05              LDY   #CONS_CDR_LO
003443r 2  B1 rr              LDA   (ptr_lo),Y
003445r 2  AA                 TAX
003446r 2  A0 06              LDY   #CONS_CDR_HI
003448r 2  B1 rr              LDA   (ptr_lo),Y
00344Ar 2  85 rr              STA   gc_ptr_hi
00344Cr 2  86 rr              STX   gc_ptr_lo
00344Er 2  80 8A              BRA   @walk
003450r 2               
003450r 2               @done:
003450r 2  60                 RTS
003451r 2               
003451r 1               
003451r 1               ; =====================================================================
003451r 1               ; ZEROPAGE segment — interpreter zero-page variables
003451r 1               ; =====================================================================
003451r 1                     .segment "ZEROPAGE"
00004Er 1               
00004Er 1  xx           buf_idx:      .res 1          ; current position in input_buf
00004Fr 1               
00004Fr 1               ; =====================================================================
00004Fr 1               ; BSS segment — runtime buffers
00004Fr 1               ; =====================================================================
00004Fr 1                     .segment "BSS"
000984r 1               
000984r 1  xx xx xx xx  input_buf:    .res 128        ; input line buffer
000988r 1  xx xx xx xx  
00098Cr 1  xx xx xx xx  
000A04r 1               
000A04r 1               ; =====================================================================
000A04r 1               ; CODE segment — cold start and main loop
000A04r 1               ; =====================================================================
000A04r 1                     .segment "CODE"
003451r 1               
003451r 1               cold_start:
003451r 1                     ; Copy extension ROM trampoline to RAM
003451r 1  A2 0D              LDX   #EXT_TRAMP_SIZE-1
003453r 1               @copy_tramp:
003453r 1  BD rr rr           LDA   ext_tramp_src,X
003456r 1  9D 70 02           STA   EXT_TRAMPOLINE,X
003459r 1  CA                 DEX
00345Ar 1  10 F7              BPL   @copy_tramp
00345Cr 1               
00345Cr 1                     ; Tell the resident paged-library loader which ROM bank to restore after
00345Cr 1                     ; a module call returns (lib_call swaps back to LIB_HOME_BANK).
00345Cr 1  A9 05              LDA   #ROMSWAP_LOGO
00345Er 1  8D 17 03           STA   LIB_HOME_BANK
003461r 1               
003461r 1                     ; Zero NovaLogo turtle/graphics state ($9F00..$9F1F) so each session starts
003461r 1                     ; in a known mode. The extension pins its turtle state here (extension.s
003461r 1                     ; TURTLE_STATE_BASE=$9F00); RAM is stale across soft-reboot on HW, and a
003461r 1                     ; stale graphics-mode/inited flag breaks auto-switch and re-init.
003461r 1  A2 1F              LDX   #$1F
003463r 1               @zero_turtle:
003463r 1  9E 00 9F           STZ   $9F00,X
003466r 1  CA                 DEX
003467r 1  10 FA              BPL   @zero_turtle
003469r 1               
003469r 1  20 rr rr           JSR   heap_init
00346Cr 1  20 rr rr           JSR   var_init
00346Fr 1  20 rr rr           JSR   proc_init
003472r 1  64 rr              STZ   catch_active
003474r 1  9C 0A A0           STZ   VGC_CURSEN
003477r 1  20 rr rr           JSR   print_banner
00347Ar 1  20 rr rr           JSR   print_prompt
00347Dr 1               
00347Dr 1               main_loop:
00347Dr 1  20 rr rr           JSR   read_line
003480r 1  9C 0A A0           STZ   VGC_CURSEN
003483r 1  20 rr rr           JSR   tokenize_line
003486r 1  20 rr rr           JSR   check_to_command
003489r 1  B0 03              BCS   @was_to               ; carry set = TO was handled
00348Br 1  20 rr rr           JSR   eval_line
00348Er 1               @was_to:
00348Er 1                     ; Reclaim dead heap objects (tokens, list cells, etc.)
00348Er 1  20 rr rr           JSR   gc_collect
003491r 1  20 rr rr           JSR   print_prompt
003494r 1  80 E7              BRA   main_loop
003496r 1               
003496r 1               ; ---------------------------------------------------------------------
003496r 1               ; check_to_command — if the first token is TO / EDIT / ED, handle it as a
003496r 1               ;   procedure-definition command (TO collects a new proc; EDIT/ED reopen an
003496r 1               ;   existing one in the editor).
003496r 1               ;   Output: carry set = handled, carry clear = not a definition command.
003496r 1               ;   Clobbers: A, Y, ptr_lo/hi, eval_cur
003496r 1               ; ---------------------------------------------------------------------
003496r 1               check_to_command:
003496r 1  A5 rr              LDA   tok_head_lo
003498r 1  05 rr              ORA   tok_head_hi
00349Ar 1  F0 5A              BEQ   @not_to
00349Cr 1               
00349Cr 1                     ; First token must be TOK_WORD
00349Cr 1  A5 rr              LDA   tok_head_lo
00349Er 1  85 rr              STA   ptr_lo
0034A0r 1  A5 rr              LDA   tok_head_hi
0034A2r 1  85 rr              STA   ptr_hi
0034A4r 1  A0 00              LDY   #TOK_TAG
0034A6r 1  B1 rr              LDA   (ptr_lo),Y
0034A8r 1  C9 01              CMP   #TOK_WORD
0034AAr 1  D0 4A              BNE   @not_to
0034ACr 1               
0034ACr 1  A0 03              LDY   #TOK_PAYLOAD
0034AEr 1  B1 rr              LDA   (ptr_lo),Y           ; word length
0034B0r 1  C9 02              CMP   #2
0034B2r 1  F0 06              BEQ   @len2
0034B4r 1  C9 04              CMP   #4
0034B6r 1  F0 19              BEQ   @len4
0034B8r 1  80 3C              BRA   @not_to
0034BAr 1               
0034BAr 1               @len2:
0034BAr 1  A0 04              LDY   #TOK_PAYLOAD+1
0034BCr 1  B1 rr              LDA   (ptr_lo),Y
0034BEr 1  C9 54              CMP   #'T'
0034C0r 1  D0 34              BNE   @not_to
0034C2r 1  C8                 INY
0034C3r 1  B1 rr              LDA   (ptr_lo),Y
0034C5r 1  C9 4F              CMP   #'O'
0034C7r 1  D0 2D              BNE   @not_to
0034C9r 1                     ; "TO" — collect a new procedure
0034C9r 1  20 rr rr           JSR   @set_cur
0034CCr 1  20 rr rr           JSR   proc_collect
0034CFr 1  38                 SEC
0034D0r 1  60                 RTS
0034D1r 1               @len4:
0034D1r 1  A0 04              LDY   #TOK_PAYLOAD+1
0034D3r 1  B1 rr              LDA   (ptr_lo),Y
0034D5r 1  C9 45              CMP   #'E'
0034D7r 1  D0 1D              BNE   @not_to
0034D9r 1  C8                 INY
0034DAr 1  B1 rr              LDA   (ptr_lo),Y
0034DCr 1  C9 44              CMP   #'D'
0034DEr 1  D0 16              BNE   @not_to
0034E0r 1  C8                 INY
0034E1r 1  B1 rr              LDA   (ptr_lo),Y
0034E3r 1  C9 49              CMP   #'I'
0034E5r 1  D0 0F              BNE   @not_to
0034E7r 1  C8                 INY
0034E8r 1  B1 rr              LDA   (ptr_lo),Y
0034EAr 1  C9 54              CMP   #'T'
0034ECr 1  D0 08              BNE   @not_to
0034EEr 1                     ; "EDIT" — edit
0034EEr 1  20 rr rr           JSR   @set_cur
0034F1r 1  20 rr rr           JSR   proc_edit
0034F4r 1  38                 SEC
0034F5r 1  60                 RTS
0034F6r 1               
0034F6r 1               @not_to:
0034F6r 1  18                 CLC
0034F7r 1  60                 RTS
0034F8r 1               
0034F8r 1               @set_cur:
0034F8r 1                     ; eval_cur = first token, then advance past it to the name token
0034F8r 1  A5 rr              LDA   tok_head_lo
0034FAr 1  85 rr              STA   eval_cur_lo
0034FCr 1  A5 rr              LDA   tok_head_hi
0034FEr 1  85 rr              STA   eval_cur_hi
003500r 1  4C rr rr           JMP   eval_advance         ; ends with RTS
003503r 1               
003503r 1               ; ---------------------------------------------------------------------
003503r 1               ; read_line — read a line of input into input_buf, null-terminated
003503r 1               ;   On return: input_buf contains the line, buf_idx = length
003503r 1               ; ---------------------------------------------------------------------
003503r 1               read_line:
003503r 1  64 rr              STZ   buf_idx            ; reset buffer index to 0
003505r 1  A9 01              LDA   #$01
003507r 1  8D 0A A0           STA   VGC_CURSEN
00350Ar 1               
00350Ar 1               @poll:
00350Ar 1  AD 0F A0           LDA   VGC_CHARIN         ; poll keyboard
00350Dr 1  F0 FB              BEQ   @poll              ; no key waiting — spin
00350Fr 1               
00350Fr 1                     ; --- handle CR ($0D) ---
00350Fr 1  C9 0D              CMP   #$0D
003511r 1  D0 39              BNE   @not_cr
003513r 1                     ; End of a typed line. If brackets/parens are still open, keep reading so
003513r 1                     ; a multi-line statement can be entered right at the prompt.
003513r 1  20 rr rr           JSR   line_bracket_depth
003516r 1  F0 24              BEQ   @cr_finish
003518r 1  A6 rr              LDX   buf_idx
00351Ar 1  E0 78              CPX   #120
00351Cr 1  B0 1E              BCS   @cr_finish         ; buffer nearly full — stop accumulating
00351Er 1  A9 0A              LDA   #$0A               ; newline separator (tokenizer treats it as space)
003520r 1  9D rr rr           STA   input_buf,X
003523r 1  E6 rr              INC   buf_idx
003525r 1  A9 0D              LDA   #$0D
003527r 1  8D 0E A0           STA   VGC_CHAROUT
00352Ar 1  A9 0A              LDA   #$0A
00352Cr 1  8D 0E A0           STA   VGC_CHAROUT
00352Fr 1  A9 7E              LDA   #'~'               ; continuation prompt
003531r 1  8D 0E A0           STA   VGC_CHAROUT
003534r 1  A9 20              LDA   #' '
003536r 1  8D 0E A0           STA   VGC_CHAROUT
003539r 1  4C rr rr           JMP   @poll
00353Cr 1               @cr_finish:
00353Cr 1  A6 rr              LDX   buf_idx
00353Er 1  9E rr rr           STZ   input_buf,X        ; null-terminate
003541r 1  A9 0D              LDA   #$0D
003543r 1  8D 0E A0           STA   VGC_CHAROUT        ; carriage return
003546r 1  A9 0A              LDA   #$0A
003548r 1  8D 0E A0           STA   VGC_CHAROUT        ; line feed
00354Br 1  60                 RTS
00354Cr 1               
00354Cr 1               @not_cr:
00354Cr 1                     ; --- handle backspace ($08, $14, $7F) ---
00354Cr 1  C9 08              CMP   #$08
00354Er 1  F0 18              BEQ   @backspace
003550r 1  C9 14              CMP   #$14
003552r 1  F0 14              BEQ   @backspace
003554r 1  C9 7F              CMP   #$7F
003556r 1  F0 10              BEQ   @backspace
003558r 1               
003558r 1                     ; --- buffer full? ---
003558r 1  A6 rr              LDX   buf_idx
00355Ar 1  E0 7F              CPX   #127
00355Cr 1  B0 AC              BCS   @poll              ; at capacity — ignore keystroke
00355Er 1               
00355Er 1                     ; --- store and echo printable character ---
00355Er 1  9D rr rr           STA   input_buf,X        ; store in buffer
003561r 1  8D 0E A0           STA   VGC_CHAROUT        ; echo to screen
003564r 1  E6 rr              INC   buf_idx
003566r 1  80 A2              BRA   @poll
003568r 1               
003568r 1               @backspace:
003568r 1  A6 rr              LDX   buf_idx
00356Ar 1  F0 9E              BEQ   @poll              ; nothing to delete — ignore
00356Cr 1  CA                 DEX
00356Dr 1  86 rr              STX   buf_idx
00356Fr 1  A9 08              LDA   #$08
003571r 1  8D 0E A0           STA   VGC_CHAROUT        ; move cursor left and erase
003574r 1  80 94              BRA   @poll
003576r 1               
003576r 1               ; ---------------------------------------------------------------------
003576r 1               ; line_bracket_depth — net count of unclosed '[' and '(' in input_buf[0..buf_idx),
003576r 1               ;   ignoring text inside ';' comments. Returns depth in A (Z set if balanced).
003576r 1               ;   Clobbers: A, X, Y.
003576r 1               ; ---------------------------------------------------------------------
003576r 1               line_bracket_depth:
003576r 1  A2 00              LDX   #0                 ; scan index
003578r 1  A0 00              LDY   #0                 ; depth
00357Ar 1               @bd_loop:
00357Ar 1  E4 rr              CPX   buf_idx
00357Cr 1  B0 32              BCS   @bd_done
00357Er 1  BD rr rr           LDA   input_buf,X
003581r 1  C9 3B              CMP   #';'
003583r 1  F0 1D              BEQ   @bd_comment
003585r 1  C9 5B              CMP   #'['
003587r 1  F0 0F              BEQ   @bd_inc
003589r 1  C9 28              CMP   #'('
00358Br 1  F0 0B              BEQ   @bd_inc
00358Dr 1  C9 5D              CMP   #']'
00358Fr 1  F0 0A              BEQ   @bd_dec
003591r 1  C9 29              CMP   #')'
003593r 1  F0 06              BEQ   @bd_dec
003595r 1               @bd_next:
003595r 1  E8                 INX
003596r 1  80 E2              BRA   @bd_loop
003598r 1               @bd_inc:
003598r 1  C8                 INY
003599r 1  80 FA              BRA   @bd_next
00359Br 1               @bd_dec:
00359Br 1  C0 00              CPY   #0
00359Dr 1  F0 F6              BEQ   @bd_next           ; floor at 0
00359Fr 1  88                 DEY
0035A0r 1  80 F3              BRA   @bd_next
0035A2r 1               @bd_comment:
0035A2r 1  E8                 INX                      ; skip ';' and everything up to a newline
0035A3r 1  E4 rr              CPX   buf_idx
0035A5r 1  B0 09              BCS   @bd_done
0035A7r 1  BD rr rr           LDA   input_buf,X
0035AAr 1  C9 0A              CMP   #$0A
0035ACr 1  D0 F4              BNE   @bd_comment
0035AEr 1  80 E5              BRA   @bd_next           ; resume scanning after the newline
0035B0r 1               @bd_done:
0035B0r 1  98                 TYA                      ; depth -> A, sets Z if zero
0035B1r 1  60                 RTS
0035B2r 1               
0035B2r 1               ; ---------------------------------------------------------------------
0035B2r 1               ; print_prompt — prints "? " to the screen
0035B2r 1               ; ---------------------------------------------------------------------
0035B2r 1               print_prompt:
0035B2r 1  20 rr rr           JSR   print_inl
0035B5r 1  3F 20 00           .byte "? ", 0
0035B8r 1  A9 01              LDA   #$01
0035BAr 1  8D 0A A0           STA   VGC_CURSEN
0035BDr 1  60                 RTS
0035BEr 1               
0035BEr 1               ; ---------------------------------------------------------------------
0035BEr 1               ; print_banner — prints title and current available heap bytes
0035BEr 1               ; ---------------------------------------------------------------------
0035BEr 1               print_banner:
0035BEr 1  20 rr rr           JSR   print_inl
0035C1r 1  4E 6F 76 61        .byte "Nova LOGO v1.0", $0D, $0A, 0
0035C5r 1  20 4C 4F 47  
0035C9r 1  4F 20 76 31  
0035D2r 1               
0035D2r 1  38                 SEC
0035D3r 1  A9 00              LDA   #<HEAP_END
0035D5r 1  E5 rr              SBC   heap_ptr
0035D7r 1  85 rr              STA   eval_val_lo
0035D9r 1  A9 98              LDA   #>HEAP_END
0035DBr 1  E5 rr              SBC   heap_ptr+1
0035DDr 1  85 rr              STA   eval_val_hi
0035DFr 1  38                 SEC
0035E0r 1  A5 rr              LDA   eval_val_lo
0035E2r 1  E9 02              SBC   #GC_HDR_BYTES
0035E4r 1  85 rr              STA   eval_val_lo
0035E6r 1  A5 rr              LDA   eval_val_hi
0035E8r 1  E9 00              SBC   #0
0035EAr 1  85 rr              STA   eval_val_hi
0035ECr 1  64 rr              STZ   eval_val_frac
0035EEr 1  20 rr rr           JSR   print_uint16
0035F1r 1               
0035F1r 1  20 rr rr           JSR   print_inl
0035F4r 1  20 42 59 54        .byte " BYTES FREE", $0D, $0A, $0D, $0A, 0
0035F8r 1  45 53 20 46  
0035FCr 1  52 45 45 0D  
003604r 1  60                 RTS
003605r 1               
003605r 1               ; =====================================================================
003605r 1               ; RODATA segment — string constants
003605r 1               ; =====================================================================
003605r 1                     .segment "RODATA"
000647r 1               
000647r 1               ; Extension ROM trampoline — copied to RAM at $0270 during cold_start.
000647r 1               ; Swaps to extension ROM, calls entry, swaps back to Logo ROM.
000647r 1               ext_tramp_src:
000647r 1  A9 04              .byte $A9, ROMSWAP_EXTENSION  ; LDA #ROMSWAP_EXTENSION
000649r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
00064Cr 1  20 00 C0           .byte $20, $00, $C0          ; JSR $C000
00064Fr 1  A9 05              .byte $A9, ROMSWAP_LOGO      ; LDA #ROMSWAP_LOGO
000651r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000654r 1  60                 .byte $60                     ; RTS
000655r 1               
000655r 1               ; =====================================================================
000655r 1               ; MONITOR segment — reset handler at $FFD7
000655r 1               ; =====================================================================
000655r 1                     .segment "MONITOR"
000000r 1                     .org  $FFD7
00FFD7  1               
00FFD7  1               RES_vec:
00FFD7  1  D8                 CLD                     ; clear decimal mode
00FFD8  1  A2 FF              LDX   #$FF              ; empty stack
00FFDA  1  9A                 TXS                     ; set the stack
00FFDB  1  4C rr rr           JMP   cold_start
00FFDE  1               
00FFDE  1               ; IRQ/NMI stubs
00FFDE  1               NMI_stub:
00FFDE  1  40                 RTI
00FFDF  1               
00FFDF  1               IRQ_stub:
00FFDF  1  40                 RTI
00FFE0  1               
00FFE0  1               ; =====================================================================
00FFE0  1               ; VECTORS segment — 6502 hardware vectors at $FFFA
00FFE0  1               ; =====================================================================
00FFE0  1                     .segment "VECTORS"
00FFE0  1                     .org  $FFFA
00FFFA  1               
00FFFA  1  DE FF              .word NMI_stub           ; $FFFA — NMI vector
00FFFC  1  D7 FF              .word RES_vec            ; $FFFC — RESET vector
00FFFE  1  DF FF              .word IRQ_stub           ; $FFFE — IRQ vector
00FFFE  1               
