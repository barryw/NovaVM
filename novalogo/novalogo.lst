002646r 2               ; RODATA — list error strings
002646r 2               ; =====================================================================
002646r 2                     .segment "RODATA"
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               ; Builtin name strings for list operations
0005B9r 2               str_first_name:
0005B9r 2  05 46 49 52        .byte 5, "FIRST"
0005BDr 2  53 54        
0005BFr 2               str_butfirst_name:
0005BFr 2  08 42 55 54        .byte 8, "BUTFIRST"
0005C3r 2  46 49 52 53  
0005C7r 2  54           
