0013EEr 2               @oom:
0013EEr 2  A2 rr              LDX   #<str_oom
0013F0r 2  A0 rr              LDY   #>str_oom
0013F2r 2  4C rr rr           JMP   list_print_err
0013F5r 2               
0013F5r 2               ; ---------------------------------------------------------------------
0013F5r 2               ; do_readword — READWORD: read chars until space/CR, return as word
0013F5r 2               ;   Arity 0, no arguments. Reporter.
0013F5r 2               ;   Uses input_buf as scratch (safe — main input already consumed).
0013F5r 2               ; ---------------------------------------------------------------------
0013F5r 2               do_readword:
0013F5r 2  64 rr              STZ   z:buf_idx
0013F7r 2               @rw_poll:
0013F7r 2  AD 0F A0           LDA   VGC_CHARIN
