002241r 2               ; ---------------------------------------------------------------------
002241r 2               ; do_word — WORD val1 val2: concatenate two words into one
002241r 2               ;   Arity 0: evaluates its own arguments
002241r 2               ; ---------------------------------------------------------------------
002241r 2               do_word:
002241r 2                     ; Evaluate first arg (must be a word)
002241r 2  20 rr rr           JSR   eval_expr
002244r 2  90 03              BCC   :+
002246r 2  4C rr rr           JMP   @err
002249r 2               :
002249r 2  A5 rr              LDA   eval_type
00224Br 2  C9 01              CMP   #VAL_WORD
00224Dr 2  F0 03              BEQ   :+
00224Fr 2  4C rr rr           JMP   @err_type
002252r 2               :
002252r 2                     ; Save first word pointer
002252r 2  A5 rr              LDA   eval_val_lo
002254r 2  48                 PHA
002255r 2  A5 rr              LDA   eval_val_hi
002257r 2  48                 PHA
002258r 2               
002258r 2                     ; Evaluate second arg (must be a word)
002258r 2  20 rr rr           JSR   eval_expr
00225Br 2  90 05              BCC   :+
00225Dr 2  68                 PLA
00225Er 2  68                 PLA
00225Fr 2  4C rr rr           JMP   @err
002262r 2               :
002262r 2  A5 rr              LDA   eval_type
002264r 2  C9 01              CMP   #VAL_WORD
002266r 2  F0 03              BEQ   :+
002268r 2  4C rr rr           JMP   @err_type_pop2
00226Br 2               :
00226Br 2               
00226Br 2                     ; eval_val = second word, stack has first word ptr
00226Br 2                     ; Read lengths
00226Br 2  A5 rr              LDA   eval_val_lo
00226Dr 2  85 rr              STA   ptr2_lo
00226Fr 2  A5 rr              LDA   eval_val_hi
002271r 2  85 rr              STA   ptr2_hi
002273r 2  A0 00              LDY   #0
002275r 2  B1 rr              LDA   (ptr2_lo),Y            ; second word length
002277r 2  85 rr              STA   list_count_lo           ; save len2
002279r 2               
002279r 2                     ; Read first word length from stack
002279r 2  68                 PLA
00227Ar 2  85 rr              STA   list_head_hi            ; first word ptr hi
00227Cr 2  68                 PLA
00227Dr 2  85 rr              STA   list_head_lo            ; first word ptr lo
00227Fr 2  A5 rr              LDA   list_head_lo
002281r 2  85 rr              STA   ptr_lo
002283r 2  A5 rr              LDA   list_head_hi
002285r 2  85 rr              STA   ptr_hi
002287r 2  A0 00              LDY   #0
002289r 2  B1 rr              LDA   (ptr_lo),Y             ; first word length
00228Br 2  85 rr              STA   list_count_hi           ; save len1
00228Dr 2               
00228Dr 2                     ; Allocate new string: 1 (length byte) + len1 + len2
00228Dr 2  18                 CLC
00228Er 2  65 rr              ADC   list_count_lo
002290r 2  1A                 INC                           ; +1 for length byte
002291r 2  A2 05              LDX   #ATYPE_STRING
002293r 2  20 rr rr           JSR   heap_alloc
002296r 2  B0 6F              BCS   @err_oom
002298r 2               
002298r 2                     ; Write combined length
002298r 2  A5 rr              LDA   list_count_hi
00229Ar 2  18                 CLC
00229Br 2  65 rr              ADC   list_count_lo
00229Dr 2  A0 00              LDY   #0
00229Fr 2  91 rr              STA   (ptr_lo),Y
0022A1r 2               
0022A1r 2                     ; Copy first word's chars
0022A1r 2  A6 rr              LDX   list_count_hi           ; len1
0022A3r 2  F0 23              BEQ   @w_copy2
0022A5r 2  A5 rr              LDA   list_head_lo
0022A7r 2  85 rr              STA   ptr2_lo
0022A9r 2  A5 rr              LDA   list_head_hi
0022ABr 2  85 rr              STA   ptr2_hi
0022ADr 2  A0 01              LDY   #1                     ; dest offset in new string
0022AFr 2  9C rr rr           STZ   num_tmp_lo              ; source offset
0022B2r 2               @w_c1:
0022B2r 2  DA                 PHX
0022B3r 2  5A                 PHY
0022B4r 2  AD rr rr           LDA   num_tmp_lo
0022B7r 2  1A                 INC                           ; skip length byte in source
0022B8r 2  A8                 TAY
0022B9r 2  B1 rr              LDA   (ptr2_lo),Y            ; source char
0022BBr 2  7A                 PLY
0022BCr 2  91 rr              STA   (ptr_lo),Y             ; dest char
0022BEr 2  C8                 INY
0022BFr 2  EE rr rr           INC   num_tmp_lo
0022C2r 2  FA                 PLX
0022C3r 2  CA                 DEX
0022C4r 2  D0 EC              BNE   @w_c1
0022C6r 2               
0022C6r 2                     ; Y is already at the next dest offset
0022C6r 2  80 02              BRA   @w_copy2_start
0022C8r 2               
0022C8r 2               @w_copy2:
0022C8r 2  A0 01              LDY   #1                     ; start at offset 1 if len1 was 0
0022CAr 2               @w_copy2_start:
0022CAr 2                     ; Copy second word's chars
0022CAr 2  A6 rr              LDX   list_count_lo           ; len2
0022CCr 2  F0 1F              BEQ   @w_done
0022CEr 2  A5 rr              LDA   eval_val_lo
0022D0r 2  85 rr              STA   ptr2_lo
0022D2r 2  A5 rr              LDA   eval_val_hi
0022D4r 2  85 rr              STA   ptr2_hi
0022D6r 2  9C rr rr           STZ   num_tmp_lo
0022D9r 2               @w_c2:
0022D9r 2  DA                 PHX
0022DAr 2  5A                 PHY
0022DBr 2  AD rr rr           LDA   num_tmp_lo
0022DEr 2  1A                 INC
0022DFr 2  A8                 TAY
0022E0r 2  B1 rr              LDA   (ptr2_lo),Y
0022E2r 2  7A                 PLY
0022E3r 2  91 rr              STA   (ptr_lo),Y
0022E5r 2  C8                 INY
0022E6r 2  EE rr rr           INC   num_tmp_lo
0022E9r 2  FA                 PLX
0022EAr 2  CA                 DEX
0022EBr 2  D0 EC              BNE   @w_c2
0022EDr 2               
0022EDr 2               @w_done:
0022EDr 2                     ; Return the new word
0022EDr 2  A9 01              LDA   #VAL_WORD
0022EFr 2  85 rr              STA   eval_type
0022F1r 2  A5 rr              LDA   ptr_lo
0022F3r 2  85 rr              STA   eval_val_lo
0022F5r 2  A5 rr              LDA   ptr_hi
0022F7r 2  85 rr              STA   eval_val_hi
