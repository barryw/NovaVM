00138Er 2               @wu_exec_body:
00138Er 2                     ; Execute body
00138Er 2  A5 rr              LDA   body_start_lo
001390r 2  85 rr              STA   eval_cur_lo
001392r 2  A5 rr              LDA   body_start_hi
001394r 2  85 rr              STA   eval_cur_hi
