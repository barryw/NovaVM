000F08r 2  85 rr              STA   proc_stopped
000F0Ar 2  4C rr rr           JMP   eval_continue
000F0Dr 2               
000F0Dr 2               ; ---------------------------------------------------------------------
000F0Dr 2               ; do_output — OUTPUT expr: exit procedure with a return value
000F0Dr 2               ;   Arity 0 — handles its own argument evaluation
000F0Dr 2               ; ---------------------------------------------------------------------
000F0Dr 2               do_output:
000F0Dr 2  20 rr rr           JSR   eval_expr           ; evaluate the expression
000F10r 2  A9 02              LDA   #$02
