000389r 2  00           
00038Ar 2               
00038Ar 1                     .include "builtins.s"
00038Ar 2               ; builtins.s — built-in command table and handlers
00038Ar 2               
00038Ar 2               ; =====================================================================
00038Ar 2               ; CODE segment — builtin lookup and handlers
00038Ar 2               ; =====================================================================
00038Ar 2                     .segment "CODE"
000C40r 2               
000C40r 2               ; ---------------------------------------------------------------------
000C40r 2               ; lookup_builtin — search builtin table for the current TOK_WORD
000C40r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000C40r 2               ;   Output: Carry clear = found, ptr2_lo/hi = handler addr, A = arity
000C40r 2               ;           Carry set = not found
000C40r 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000C40r 2               ; ---------------------------------------------------------------------
000C40r 2               lookup_builtin:
000C40r 2                     ; Save table pointer in num_tmp_lo/hi
000C40r 2  A9 rr              LDA   #<builtin_table
000C42r 2  8D rr rr           STA   num_tmp_lo
000C45r 2  A9 rr              LDA   #>builtin_table
000C47r 2  8D rr rr           STA   num_tmp_hi
000C4Ar 2               
000C4Ar 2               @scan:
000C4Ar 2                     ; Read name pointer from table
000C4Ar 2  AD rr rr           LDA   num_tmp_lo
000C4Dr 2  85 rr              STA   ptr2_lo
000C4Fr 2  AD rr rr           LDA   num_tmp_hi
000C52r 2  85 rr              STA   ptr2_hi
000C54r 2  A0 00              LDY   #0
000C56r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000C58r 2  AA                 TAX
000C59r 2  C8                 INY
000C5Ar 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000C5Cr 2  D0 06              BNE   @have_entry
000C5Er 2  E0 00              CPX   #0
000C60r 2  D0 02              BNE   @have_entry
000C62r 2                     ; Null pointer — end of table
000C62r 2  38                 SEC
000C63r 2  60                 RTS
000C64r 2               
000C64r 2               @have_entry:
000C64r 2                     ; X = name_ptr_lo, A = name_ptr_hi
000C64r 2                     ; Compare the table name against the token payload
000C64r 2                     ; Token payload: at eval_cur + TOK_PAYLOAD = length byte + chars
000C64r 2  85 rr              STA   ptr2_hi
000C66r 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000C68r 2               
000C68r 2                     ; Get token payload pointer
000C68r 2  A5 rr              LDA   eval_cur_lo
000C6Ar 2  85 rr              STA   ptr_lo
000C6Cr 2  A5 rr              LDA   eval_cur_hi
000C6Er 2  85 rr              STA   ptr_hi
000C70r 2               
000C70r 2                     ; Compare length bytes
000C70r 2  A0 00              LDY   #0
000C72r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000C74r 2  A0 03              LDY   #TOK_PAYLOAD
000C76r 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000C78r 2  D0 41              BNE   @next
000C7Ar 2               
000C7Ar 2                     ; Lengths match — compare chars
000C7Ar 2  AA                 TAX                       ; X = length
000C7Br 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000C7Dr 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000C7Fr 2               @cmp_loop:
000C7Fr 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000C81r 2  5A                 PHY
000C82r 2                     ; Compute token char offset: TOK_PAYLOAD + 1 + tok_sign
000C82r 2  A5 rr              LDA   tok_sign
000C84r 2  18                 CLC
000C85r 2  69 04              ADC   #TOK_PAYLOAD+1
000C87r 2  A8                 TAY
000C88r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000C8Ar 2  7A                 PLY
000C8Br 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000C8Dr 2  D0 2C              BNE   @next
000C8Fr 2  C8                 INY
000C90r 2  E6 rr              INC   tok_sign
000C92r 2  CA                 DEX
000C93r 2  D0 EA              BNE   @cmp_loop
000C95r 2               
000C95r 2                     ; Match found — read handler address and arity
000C95r 2                     ; Table entry: name_ptr(2) + handler_addr(2) + arity(1)
000C95r 2                     ; handler is at table_base + 2, arity at table_base + 4
000C95r 2  AD rr rr           LDA   num_tmp_lo
000C98r 2  85 rr              STA   ptr2_lo
000C9Ar 2  AD rr rr           LDA   num_tmp_hi
000C9Dr 2  85 rr              STA   ptr2_hi
000C9Fr 2  A0 02              LDY   #2
000CA1r 2  B1 rr              LDA   (ptr2_lo),Y        ; handler low
000CA3r 2  AA                 TAX
000CA4r 2  C8                 INY
000CA5r 2  B1 rr              LDA   (ptr2_lo),Y        ; handler high
000CA7r 2  85 rr              STA   ptr2_hi
000CA9r 2  86 rr              STX   ptr2_lo             ; ptr2 = handler address (return value)
000CABr 2                     ; Read arity from the table (num_tmp = entry base)
000CABr 2  AD rr rr           LDA   num_tmp_lo
000CAEr 2  85 rr              STA   ptr_lo
000CB0r 2  AD rr rr           LDA   num_tmp_hi
000CB3r 2  85 rr              STA   ptr_hi
000CB5r 2  A0 04              LDY   #4
000CB7r 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000CB9r 2  18                 CLC                       ; found
000CBAr 2  60                 RTS
000CBBr 2               
000CBBr 2               @next:
000CBBr 2  64 rr              STZ   tok_sign            ; reset comparison counter
000CBDr 2                     ; Advance to next entry: +5 bytes (2 name + 2 handler + 1 arity)
000CBDr 2  18                 CLC
000CBEr 2  AD rr rr           LDA   num_tmp_lo
000CC1r 2  69 05              ADC   #5
000CC3r 2  8D rr rr           STA   num_tmp_lo
000CC6r 2  90 03              BCC   @next2
000CC8r 2  EE rr rr           INC   num_tmp_hi
000CCBr 2               @next2:
000CCBr 2  4C rr rr           JMP   @scan
000CCEr 2               
000CCEr 2               ; ---------------------------------------------------------------------
000CCEr 2               ; do_print — PRINT <expr>: evaluate arg and print with newline
000CCEr 2               ;   Entry: eval_val/eval_type already set with the argument
000CCEr 2               ;   Must JMP to eval_continue when done
000CCEr 2               ; ---------------------------------------------------------------------
000CCEr 2               ; do_print / do_type share one body. PRINT appends a newline; TYPE does not.
000CCEr 2               ; The newline flag is carried on the stack across the (balanced) print calls.
000CCEr 2               do_print:
000CCEr 2  A9 FF              LDA   #$FF                 ; PRINT: append trailing newline
000CD0r 2  80 02              BRA   pt_common
000CD2r 2               do_type:
000CD2r 2  A9 00              LDA   #$00                 ; TYPE: no trailing newline
000CD4r 2               pt_common:
000CD4r 2  48                 PHA                        ; save newline flag
000CD5r 2  A5 rr              LDA   eval_type
000CD7r 2  C9 02              CMP   #VAL_LIST
000CD9r 2  F0 09              BEQ   pt_list
000CDBr 2  C9 01              CMP   #VAL_WORD
000CDDr 2  F0 0A              BEQ   pt_word
000CDFr 2               
000CDFr 2                     ; Print number
000CDFr 2  20 rr rr           JSR   print_number
000CE2r 2  80 1C              BRA   pt_done
000CE4r 2               
000CE4r 2               pt_list:
000CE4r 2  20 rr rr           JSR   print_list
000CE7r 2  80 17              BRA   pt_done
000CE9r 2               
000CE9r 2               pt_word:
000CE9r 2                     ; Print quoted word — eval_val_lo/hi points at length+chars
000CE9r 2  A5 rr              LDA   eval_val_lo
000CEBr 2  85 rr              STA   ptr_lo
000CEDr 2  A5 rr              LDA   eval_val_hi
000CEFr 2  85 rr              STA   ptr_hi
000CF1r 2  A0 00              LDY   #0
000CF3r 2  B1 rr              LDA   (ptr_lo),Y         ; length
000CF5r 2  AA                 TAX
000CF6r 2  C8                 INY
000CF7r 2               pt_wch:
000CF7r 2  B1 rr              LDA   (ptr_lo),Y
000CF9r 2  8D 0E A0           STA   VGC_CHAROUT
000CFCr 2  C8                 INY
000CFDr 2  CA                 DEX
000CFEr 2  D0 F7              BNE   pt_wch
000D00r 2               
000D00r 2               pt_done:
000D00r 2  68                 PLA                        ; restore newline flag
000D01r 2  F0 03              BEQ   pt_no_nl
000D03r 2  20 rr rr           JSR   eval_newline
000D06r 2               pt_no_nl:
000D06r 2  4C rr rr           JMP   eval_continue
000D09r 2               
000D09r 2               ; ---------------------------------------------------------------------
000D09r 2               ; do_type — TYPE <expr>: like PRINT but no newline
000D09r 2               ; ---------------------------------------------------------------------
000D09r 2               ; ---------------------------------------------------------------------
000D09r 2               ; do_make — MAKE "name value: store a variable
000D09r 2               ;   Arity 0 — we do our own argument evaluation
000D09r 2               ;   1. eval_expr → name (must be TOK_QUOTE → word type)
000D09r 2               ;   2. save name pointer
000D09r 2               ;   3. eval_expr → value
000D09r 2               ;   4. var_set(saved name, current value)
000D09r 2               ; ---------------------------------------------------------------------
000D09r 2               do_make:
000D09r 2                     ; Evaluate first argument: the name (a quoted word)
000D09r 2  20 rr rr           JSR   eval_expr
000D0Cr 2  B0 1F              BCS   @err
000D0Er 2               
000D0Er 2                     ; Must be a word (type $01)
000D0Er 2  A5 rr              LDA   eval_type
000D10r 2  C9 01              CMP   #$01
000D12r 2  D0 19              BNE   @err
000D14r 2               
000D14r 2                     ; Save the name pointer (points into token payload: len + chars)
000D14r 2  A5 rr              LDA   eval_val_lo
000D16r 2  48                 PHA
000D17r 2  A5 rr              LDA   eval_val_hi
000D19r 2  48                 PHA
000D1Ar 2               
000D1Ar 2                     ; Evaluate second argument: the value
000D1Ar 2  20 rr rr           JSR   eval_expr
000D1Dr 2  B0 0C              BCS   @err_pop
000D1Fr 2               
000D1Fr 2                     ; Set up ptr_lo/hi → saved name, eval_val holds value
000D1Fr 2  68                 PLA
000D20r 2  85 rr              STA   ptr_hi
000D22r 2  68                 PLA
000D23r 2  85 rr              STA   ptr_lo
000D25r 2               
000D25r 2  20 rr rr           JSR   var_set
000D28r 2  4C rr rr           JMP   eval_continue
000D2Br 2               
000D2Br 2               @err_pop:
000D2Br 2  68                 PLA
000D2Cr 2  68                 PLA
000D2Dr 2               @err:
000D2Dr 2                     ; Print error
000D2Dr 2  A2 rr              LDX   #<str_make_name
000D2Fr 2  A0 rr              LDY   #>str_make_name
000D31r 2  4C rr rr           JMP   err_nei
000D34r 2               
000D34r 2               ; ---------------------------------------------------------------------
000D34r 2               ; do_repeat — REPEAT count [body]
000D34r 2               ;   Arity 0 — handles its own argument parsing
000D34r 2               ;   1. Evaluate count expression
000D34r 2               ;   2. Locate the bracketed body [...]
000D34r 2               ;   3. Execute the body count times
000D34r 2               ;   4. Resume after the closing ]
000D34r 2               ;
000D34r 2               ;   Nesting: saves/restores repeat state (body_start, body_resume,
000D34r 2               ;   repeat_count, eval_in_body) on the hardware stack so nested
000D34r 2               ;   REPEAT works correctly.
000D34r 2               ; ---------------------------------------------------------------------
000D34r 2               
000D34r 2                     .segment "ZEROPAGE"
000022r 2  xx           repeat_count_lo:  .res 1
000023r 2  xx           repeat_count_hi:  .res 1
000024r 2  xx           body_start_lo:    .res 1       ; first token after [
000025r 2  xx           body_start_hi:    .res 1
000026r 2  xx           body_resume_lo:   .res 1       ; token after ]
000027r 2  xx           body_resume_hi:   .res 1
000028r 2  xx           repcount:         .res 1       ; 1-based REPCOUNT within REPEAT loop
000029r 2  xx           for_cur_lo:       .res 1       ; FOR loop current value low
00002Ar 2  xx           for_cur_hi:       .res 1       ; FOR loop current value high
00002Br 2  xx           for_end_lo:       .res 1       ; FOR loop end value low
00002Cr 2  xx           for_end_hi:       .res 1       ; FOR loop end value high
00002Dr 2  xx           cond_start_lo:    .res 1       ; WHILE/UNTIL condition start low
00002Er 2  xx           cond_start_hi:    .res 1       ; WHILE/UNTIL condition start high
00002Fr 2               
00002Fr 2                     .segment "CODE"
000D34r 2               
000D34r 2               do_repeat:
000D34r 2                     ; --- Evaluate the count argument ---
000D34r 2  20 rr rr           JSR   eval_expr
000D37r 2  90 03              BCC   @count_ok
000D39r 2  4C rr rr           JMP   @err_args             ; carry set = no token
000D3Cr 2               @count_ok:
000D3Cr 2                     ; Count must be a number
000D3Cr 2  A5 rr              LDA   eval_type
000D3Er 2  F0 03              BEQ   @type_ok
000D40r 2  4C rr rr           JMP   @err_args
000D43r 2               @type_ok:
000D43r 2               
000D43r 2                     ; --- Save outer repeat state for nesting ---
000D43r 2  A5 rr              LDA   repcount
000D45r 2  48                 PHA
000D46r 2  A5 rr              LDA   repeat_count_lo
000D48r 2  48                 PHA
000D49r 2  A5 rr              LDA   repeat_count_hi
000D4Br 2  48                 PHA
000D4Cr 2  A5 rr              LDA   body_start_lo
000D4Er 2  48                 PHA
000D4Fr 2  A5 rr              LDA   body_start_hi
000D51r 2  48                 PHA
000D52r 2  A5 rr              LDA   body_resume_lo
000D54r 2  48                 PHA
000D55r 2  A5 rr              LDA   body_resume_hi
000D57r 2  48                 PHA
000D58r 2  A5 rr              LDA   eval_in_body
000D5Ar 2  48                 PHA
000D5Br 2               
000D5Br 2                     ; Store count (integer part only, clamped to 0 if negative)
000D5Br 2  A5 rr              LDA   eval_val_hi
000D5Dr 2  30 08              BMI   @zero_count           ; negative = treat as 0
000D5Fr 2  85 rr              STA   repeat_count_hi
000D61r 2  A5 rr              LDA   eval_val_lo
000D63r 2  85 rr              STA   repeat_count_lo
000D65r 2  80 04              BRA   @find_body
000D67r 2               
000D67r 2               @zero_count:
000D67r 2  64 rr              STZ   repeat_count_lo
000D69r 2  64 rr              STZ   repeat_count_hi
000D6Br 2               
000D6Br 2               @find_body:
000D6Br 2                     ; --- Current token must be TOK_LBRACKET ---
000D6Br 2  A5 rr              LDA   eval_cur_lo
000D6Dr 2  05 rr              ORA   eval_cur_hi
000D6Fr 2  D0 03              BNE   @have_tok
000D71r 2  4C rr rr           JMP   @err_bracket_pop
000D74r 2               @have_tok:
000D74r 2  A5 rr              LDA   eval_cur_lo
000D76r 2  85 rr              STA   ptr_lo
000D78r 2  A5 rr              LDA   eval_cur_hi
000D7Ar 2  85 rr              STA   ptr_hi
000D7Cr 2  A0 00              LDY   #TOK_TAG
000D7Er 2  B1 rr              LDA   (ptr_lo),Y
000D80r 2  C9 03              CMP   #TOK_LBRACKET
000D82r 2  F0 03              BEQ   @is_bracket
000D84r 2  4C rr rr           JMP   @err_bracket_pop
000D87r 2               @is_bracket:
000D87r 2               
000D87r 2                     ; Advance past the [
000D87r 2  20 rr rr           JSR   eval_advance
000D8Ar 2               
000D8Ar 2                     ; Save body start (first token after [)
000D8Ar 2  A5 rr              LDA   eval_cur_lo
000D8Cr 2  85 rr              STA   body_start_lo
000D8Er 2  A5 rr              LDA   eval_cur_hi
000D90r 2  85 rr              STA   body_start_hi
000D92r 2               
000D92r 2                     ; --- Scan forward to find the matching ] ---
000D92r 2  A2 01              LDX   #1                    ; depth (we've consumed the [)
000D94r 2               @scan:
000D94r 2  A5 rr              LDA   eval_cur_lo
000D96r 2  05 rr              ORA   eval_cur_hi
000D98r 2  D0 03              BNE   @scan_ok
000D9Ar 2  4C rr rr           JMP   @err_bracket_pop
000D9Dr 2               @scan_ok:
000D9Dr 2  A5 rr              LDA   eval_cur_lo
000D9Fr 2  85 rr              STA   ptr_lo
000DA1r 2  A5 rr              LDA   eval_cur_hi
000DA3r 2  85 rr              STA   ptr_hi
000DA5r 2  A0 00              LDY   #TOK_TAG
000DA7r 2  B1 rr              LDA   (ptr_lo),Y
000DA9r 2               
000DA9r 2  C9 03              CMP   #TOK_LBRACKET
000DABr 2  D0 03              BNE   @scan_not_lb
000DADr 2  E8                 INX
000DAEr 2  80 07              BRA   @scan_next
000DB0r 2               @scan_not_lb:
000DB0r 2  C9 04              CMP   #TOK_RBRACKET
000DB2r 2  D0 03              BNE   @scan_next
000DB4r 2  CA                 DEX
000DB5r 2  F0 07              BEQ   @scan_found           ; depth == 0, found matching ]
000DB7r 2               @scan_next:
000DB7r 2  DA                 PHX                        ; save depth across eval_advance
000DB8r 2  20 rr rr           JSR   eval_advance
000DBBr 2  FA                 PLX
000DBCr 2  80 D6              BRA   @scan
000DBEr 2               
000DBEr 2               @scan_found:
000DBEr 2                     ; eval_cur is at the matching ]. Save resume point (token after ]).
000DBEr 2  20 rr rr           JSR   eval_advance
000DC1r 2  A5 rr              LDA   eval_cur_lo
000DC3r 2  85 rr              STA   body_resume_lo
000DC5r 2  A5 rr              LDA   eval_cur_hi
000DC7r 2  85 rr              STA   body_resume_hi
000DC9r 2               
000DC9r 2                     ; --- Initialize repcount and execute the body repeat_count times ---
000DC9r 2  A9 01              LDA   #1
000DCBr 2  85 rr              STA   repcount
000DCDr 2               @loop:
000DCDr 2                     ; Check if STOP/OUTPUT was signaled
000DCDr 2  A5 rr              LDA   proc_stopped
000DCFr 2  D0 27              BNE   @loop_done
000DD1r 2               
000DD1r 2                     ; Check if count is zero
000DD1r 2  A5 rr              LDA   repeat_count_lo
000DD3r 2  05 rr              ORA   repeat_count_hi
000DD5r 2  F0 21              BEQ   @loop_done
000DD7r 2               
000DD7r 2                     ; Set eval_cur to body start
000DD7r 2  A5 rr              LDA   body_start_lo
000DD9r 2  85 rr              STA   eval_cur_lo
000DDBr 2  A5 rr              LDA   body_start_hi
000DDDr 2  85 rr              STA   eval_cur_hi
000DDFr 2               
000DDFr 2                     ; Set body mode and call eval_body
000DDFr 2  A9 01              LDA   #$01
000DE1r 2  85 rr              STA   eval_in_body
000DE3r 2  20 rr rr           JSR   eval_body
000DE6r 2               
000DE6r 2                     ; Increment repcount (capped at 255)
000DE6r 2  A5 rr              LDA   repcount
000DE8r 2  C9 FF              CMP   #$FF
000DEAr 2  B0 02              BCS   :+
000DECr 2  E6 rr              INC   repcount
000DEEr 2               :
000DEEr 2                     ; Decrement count (16-bit)
000DEEr 2  A5 rr              LDA   repeat_count_lo
000DF0r 2  D0 02              BNE   @dec_lo
000DF2r 2  C6 rr              DEC   repeat_count_hi
000DF4r 2               @dec_lo:
000DF4r 2  C6 rr              DEC   repeat_count_lo
000DF6r 2  80 D5              BRA   @loop
000DF8r 2               
000DF8r 2               @loop_done:
000DF8r 2                     ; Resume past THIS REPEAT's ] BEFORE restoring outer state — restore pops
000DF8r 2                     ; body_resume back to the enclosing REPEAT's value, so reading it after the
000DF8r 2                     ; restore would resume at the wrong token (trailing commands never run).
000DF8r 2  A5 rr              LDA   body_resume_lo
000DFAr 2  85 rr              STA   eval_cur_lo
000DFCr 2  A5 rr              LDA   body_resume_hi
000DFEr 2  85 rr              STA   eval_cur_hi
000E00r 2                     ; --- Restore outer state ---
000E00r 2  20 rr rr           JSR   repeat_restore_state
000E03r 2  4C rr rr           JMP   eval_continue
000E06r 2               
000E06r 2               @err_bracket_pop:
000E06r 2                     ; Restore stack before printing error
000E06r 2  20 rr rr           JSR   repeat_restore_state
000E09r 2                     ; Fall through to error message
000E09r 2  20 rr rr           JSR   print_inl
000E0Cr 2  52 45 50 45        .byte "REPEAT NEEDS [ BODY ]", 0
000E10r 2  41 54 20 4E  
000E14r 2  45 45 44 53  
000E22r 2  20 rr rr           JSR   eval_newline
000E25r 2  4C rr rr           JMP   eval_continue
000E28r 2               
000E28r 2               @err_args:
000E28r 2  A2 rr              LDX   #<str_repeat_name
000E2Ar 2  A0 rr              LDY   #>str_repeat_name
000E2Cr 2  4C rr rr           JMP   err_nei
000E2Fr 2               
000E2Fr 2               ; ---------------------------------------------------------------------
000E2Fr 2               ; repeat_restore_state — pop 7 saved bytes from stack to ZP
000E2Fr 2               ;   Restores eval_in_body, body_resume, body_start, repeat_count
000E2Fr 2               ;   Must be called via JSR (uses return address on stack correctly)
000E2Fr 2               ; ---------------------------------------------------------------------
000E2Fr 2               repeat_restore_state:
000E2Fr 2                     ; Pull our return address, pop 8 saved bytes, push RA, RTS.
000E2Fr 2  68                 PLA
000E30r 2  85 rr              STA   handler_lo            ; save return address low
000E32r 2  68                 PLA
000E33r 2  85 rr              STA   handler_hi            ; save return address high
000E35r 2               
000E35r 2  68                 PLA
000E36r 2  85 rr              STA   eval_in_body
000E38r 2  68                 PLA
000E39r 2  85 rr              STA   body_resume_hi
000E3Br 2  68                 PLA
000E3Cr 2  85 rr              STA   body_resume_lo
000E3Er 2  68                 PLA
000E3Fr 2  85 rr              STA   body_start_hi
000E41r 2  68                 PLA
000E42r 2  85 rr              STA   body_start_lo
000E44r 2  68                 PLA
000E45r 2  85 rr              STA   repeat_count_hi
000E47r 2  68                 PLA
000E48r 2  85 rr              STA   repeat_count_lo
000E4Ar 2  68                 PLA
000E4Br 2  85 rr              STA   repcount
000E4Dr 2               
000E4Dr 2  A5 rr              LDA   handler_hi
000E4Fr 2  48                 PHA
000E50r 2  A5 rr              LDA   handler_lo
000E52r 2  48                 PHA
000E53r 2  60                 RTS
000E54r 2               
000E54r 2               ; ---------------------------------------------------------------------
000E54r 2               ; skip_list_body — advance eval_cur past a [...] block without executing
000E54r 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000E54r 2               ;   Exit:  eval_cur points at the token after the matching TOK_RBRACKET
000E54r 2               ;          Carry clear = success, Carry set = missing bracket
000E54r 2               ;   Clobbers: A, X, Y, ptr_lo/hi
000E54r 2               ; ---------------------------------------------------------------------
000E54r 2               skip_list_body:
000E54r 2                     ; Verify current token is TOK_LBRACKET
000E54r 2  A5 rr              LDA   eval_cur_lo
000E56r 2  05 rr              ORA   eval_cur_hi
000E58r 2  F0 41              BEQ   @err
000E5Ar 2  A5 rr              LDA   eval_cur_lo
000E5Cr 2  85 rr              STA   ptr_lo
000E5Er 2  A5 rr              LDA   eval_cur_hi
000E60r 2  85 rr              STA   ptr_hi
000E62r 2  A0 00              LDY   #TOK_TAG
000E64r 2  B1 rr              LDA   (ptr_lo),Y
000E66r 2  C9 03              CMP   #TOK_LBRACKET
000E68r 2  D0 31              BNE   @err
000E6Ar 2               
000E6Ar 2                     ; Advance past the [
000E6Ar 2  20 rr rr           JSR   eval_advance
000E6Dr 2  A2 01              LDX   #1                    ; depth = 1
000E6Fr 2               
000E6Fr 2               @scan:
000E6Fr 2  A5 rr              LDA   eval_cur_lo
000E71r 2  05 rr              ORA   eval_cur_hi
000E73r 2  F0 26              BEQ   @err                  ; ran out of tokens
000E75r 2  A5 rr              LDA   eval_cur_lo
000E77r 2  85 rr              STA   ptr_lo
000E79r 2  A5 rr              LDA   eval_cur_hi
000E7Br 2  85 rr              STA   ptr_hi
000E7Dr 2  A0 00              LDY   #TOK_TAG
000E7Fr 2  B1 rr              LDA   (ptr_lo),Y
000E81r 2               
000E81r 2  C9 03              CMP   #TOK_LBRACKET
000E83r 2  D0 03              BNE   @not_lb
000E85r 2  E8                 INX
000E86r 2  80 07              BRA   @scan_next
000E88r 2               @not_lb:
000E88r 2  C9 04              CMP   #TOK_RBRACKET
000E8Ar 2  D0 03              BNE   @scan_next
000E8Cr 2  CA                 DEX
000E8Dr 2  F0 07              BEQ   @found                 ; depth == 0 -> matched
000E8Fr 2               @scan_next:
000E8Fr 2  DA                 PHX
000E90r 2  20 rr rr           JSR   eval_advance
000E93r 2  FA                 PLX
000E94r 2  80 D9              BRA   @scan
000E96r 2               
000E96r 2               @found:
000E96r 2                     ; eval_cur is at the matching ]. Advance past it.
000E96r 2  20 rr rr           JSR   eval_advance
000E99r 2  18                 CLC
000E9Ar 2  60                 RTS
000E9Br 2               
000E9Br 2               @err:
000E9Br 2  38                 SEC
000E9Cr 2  60                 RTS
000E9Dr 2               
000E9Dr 2               ; ---------------------------------------------------------------------
000E9Dr 2               ; exec_body_block — execute a [...] body once
000E9Dr 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000E9Dr 2               ;   Exit:  eval_cur points past the matching ], carry clear = ok
000E9Dr 2               ;          Carry set = bracket error
000E9Dr 2               ;   Saves/restores body_resume, eval_in_body for nesting.
000E9Dr 2               ;   Clobbers: A, X, Y, ptr_lo/hi, body_start/resume, eval_in_body
000E9Dr 2               ; ---------------------------------------------------------------------
000E9Dr 2               exec_body_block:
000E9Dr 2                     ; Verify current token is [
000E9Dr 2  A5 rr              LDA   eval_cur_lo
000E9Fr 2  05 rr              ORA   eval_cur_hi
000EA1r 2  F0 7B              BEQ   @err
000EA3r 2  A5 rr              LDA   eval_cur_lo
000EA5r 2  85 rr              STA   ptr_lo
000EA7r 2  A5 rr              LDA   eval_cur_hi
000EA9r 2  85 rr              STA   ptr_hi
000EABr 2  A0 00              LDY   #TOK_TAG
000EADr 2  B1 rr              LDA   (ptr_lo),Y
000EAFr 2  C9 03              CMP   #TOK_LBRACKET
000EB1r 2  D0 6B              BNE   @err
000EB3r 2               
000EB3r 2                     ; Advance past [
000EB3r 2  20 rr rr           JSR   eval_advance
000EB6r 2               
000EB6r 2                     ; Save outer state for nesting
000EB6r 2  A5 rr              LDA   body_resume_lo
000EB8r 2  48                 PHA
000EB9r 2  A5 rr              LDA   body_resume_hi
000EBBr 2  48                 PHA
000EBCr 2  A5 rr              LDA   eval_in_body
000EBEr 2  48                 PHA
000EBFr 2               
000EBFr 2                     ; Save body start
000EBFr 2  A5 rr              LDA   eval_cur_lo
000EC1r 2  48                 PHA
000EC2r 2  A5 rr              LDA   eval_cur_hi
000EC4r 2  48                 PHA
000EC5r 2               
000EC5r 2                     ; Scan forward for matching ]
000EC5r 2  A2 01              LDX   #1
000EC7r 2               @scan:
000EC7r 2  A5 rr              LDA   eval_cur_lo
000EC9r 2  05 rr              ORA   eval_cur_hi
000ECBr 2  F0 4C              BEQ   @err_pop5
000ECDr 2  A5 rr              LDA   eval_cur_lo
000ECFr 2  85 rr              STA   ptr_lo
000ED1r 2  A5 rr              LDA   eval_cur_hi
000ED3r 2  85 rr              STA   ptr_hi
000ED5r 2  A0 00              LDY   #TOK_TAG
000ED7r 2  B1 rr              LDA   (ptr_lo),Y
000ED9r 2  C9 03              CMP   #TOK_LBRACKET
000EDBr 2  D0 03              BNE   @not_lb
000EDDr 2  E8                 INX
000EDEr 2  80 07              BRA   @scan_next
000EE0r 2               @not_lb:
000EE0r 2  C9 04              CMP   #TOK_RBRACKET
000EE2r 2  D0 03              BNE   @scan_next
000EE4r 2  CA                 DEX
000EE5r 2  F0 07              BEQ   @found
000EE7r 2               @scan_next:
000EE7r 2  DA                 PHX
000EE8r 2  20 rr rr           JSR   eval_advance
000EEBr 2  FA                 PLX
000EECr 2  80 D9              BRA   @scan
000EEEr 2               
000EEEr 2               @found:
000EEEr 2                     ; Advance past ] for resume point
000EEEr 2  20 rr rr           JSR   eval_advance
