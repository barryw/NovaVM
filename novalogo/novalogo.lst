002173r 2  A5 rr              LDA   list_head_lo
002175r 2  05 rr              ORA   list_head_hi
002177r 2  F0 44              BEQ   @se_return_second
002179r 2               
002179r 2                     ; Walk to end of first list, patch cdr to second
002179r 2  A5 rr              LDA   list_head_lo
