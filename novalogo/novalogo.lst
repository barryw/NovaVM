000956r 2  47 48 20 49  
000969r 2               
000969r 2               ; Builtin name strings for workspace commands
000969r 2               str_po_name:
000969r 2  02 50 4F           .byte 2, "PO"
00096Cr 2               str_printout_name:
00096Cr 2  08 50 52 49        .byte 8, "PRINTOUT"
000970r 2  4E 54 4F 55  
000974r 2  54           
000975r 2               str_pots_name:
000975r 2  04 50 4F 54        .byte 4, "POTS"
000979r 2  53           
00097Ar 2               str_printtitles_name:
00097Ar 2  0B 50 52 49        .byte 11, "PRINTTITLES"
00097Er 2  4E 54 54 49  
000982r 2  54 4C 45 53  
000986r 2               str_erase_name:
000986r 2  05 45 52 41        .byte 5, "ERASE"
00098Ar 2  53 45        
00098Cr 2               str_apply_name:
00098Cr 2  05 41 50 50        .byte 5, "APPLY"
000990r 2  4C 59        
000992r 2               
000992r 1                     .include "gc.s"
000992r 2               ; gc.s — mark-sweep garbage collector for NovaLogo
000992r 2               ;
000992r 2               ; Allocation header (prepended by heap_alloc):
000992r 2               ;   +0: alloc_tag  (bit 7 = mark, bits 6-0 = type)
000992r 2               ;   +1: alloc_size (total size including header; 0 = use 16-bit size at +2/+3)
000992r 2               ;
000992r 2               ; Type constants (bits 6-0 of alloc_tag):
000992r 2               ATYPE_FREE   = $00
000992r 2               ATYPE_TOKEN  = $01
000992r 2               ATYPE_CONS   = $02
000992r 2               ATYPE_VAR    = $03
000992r 2               ATYPE_PROC   = $04
000992r 2               ATYPE_STRING = $05
000992r 2               
000992r 2               ; Header layout offsets (relative to allocation base, NOT payload)
000992r 2               GC_HDR_TAG   = 0
000992r 2               GC_HDR_SIZE  = 1
000992r 2               GC_HDR_BYTES = 2              ; overhead per allocation
000992r 2               
000992r 2               ; Mark bit
000992r 2               ALLOC_MARK_BIT = $80
000992r 2               
000992r 2               ; =====================================================================
000992r 2               ; ZEROPAGE segment — GC variables
000992r 2               ; =====================================================================
000992r 2                     .segment "ZEROPAGE"
000047r 2               
000047r 2  xx           gc_ptr_lo:    .res 1          ; GC walk pointer low
000048r 2  xx           gc_ptr_hi:    .res 1          ; GC walk pointer high
000049r 2  xx           gc_tmp_lo:    .res 1          ; GC temp low
00004Ar 2  xx           gc_tmp_hi:    .res 1          ; GC temp high
00004Br 2  xx           gc_mark_lo:   .res 1          ; node-to-mark pointer low
00004Cr 2  xx           gc_mark_hi:   .res 1          ; node-to-mark pointer high
00004Dr 2               
00004Dr 2               ; =====================================================================
00004Dr 2               ; CODE segment — GC routines
00004Dr 2               ; =====================================================================
00004Dr 2                     .segment "CODE"
003215r 2               
003215r 2               ; ---------------------------------------------------------------------
003215r 2               ; gc_collect — run a full mark-sweep garbage collection cycle
003215r 2               ;   1. Clear all mark bits
003215r 2               ;   2. Mark all reachable objects from roots
003215r 2               ;   3. Sweep: coalesce all unmarked blocks and reset heap_ptr
003215r 2               ;
003215r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_tmp, gc_mark, ptr_lo/hi, ptr2_lo/hi
003215r 2               ; ---------------------------------------------------------------------
003215r 2               gc_collect:
003215r 2                     ; Phase 1: Clear all mark bits by walking the heap linearly
003215r 2  A9 00              LDA   #<HEAP_START
003217r 2  85 rr              STA   gc_ptr_lo
003219r 2  A9 04              LDA   #>HEAP_START
00321Br 2  85 rr              STA   gc_ptr_hi
00321Dr 2               
00321Dr 2               @clear_loop:
00321Dr 2                     ; Have we reached heap_ptr (end of allocated space)?
00321Dr 2  A5 rr              LDA   gc_ptr_hi
00321Fr 2  C5 rr              CMP   heap_ptr+1
003221r 2  90 08              BCC   @clear_one
003223r 2  D0 41              BNE   @clear_done
003225r 2  A5 rr              LDA   gc_ptr_lo
003227r 2  C5 rr              CMP   heap_ptr
003229r 2  B0 3B              BCS   @clear_done
00322Br 2               
00322Br 2               @clear_one:
00322Br 2                     ; Clear mark bit on this allocation
00322Br 2  A5 rr              LDA   gc_ptr_lo
00322Dr 2  85 rr              STA   ptr_lo
00322Fr 2  A5 rr              LDA   gc_ptr_hi
003231r 2  85 rr              STA   ptr_hi
003233r 2  A0 00              LDY   #GC_HDR_TAG
003235r 2  B1 rr              LDA   (ptr_lo),Y
003237r 2  29 7F              AND   #<~ALLOC_MARK_BIT    ; clear bit 7
003239r 2  91 rr              STA   (ptr_lo),Y
00323Br 2               
00323Br 2                     ; Advance by alloc_size
00323Br 2  A0 01              LDY   #GC_HDR_SIZE
00323Dr 2  B1 rr              LDA   (ptr_lo),Y
00323Fr 2  F0 0B              BEQ   @clear_big           ; size=0 means 16-bit size at +2/+3
003241r 2  18                 CLC
003242r 2  65 rr              ADC   gc_ptr_lo
003244r 2  85 rr              STA   gc_ptr_lo
003246r 2  90 D5              BCC   @clear_loop
003248r 2  E6 rr              INC   gc_ptr_hi
00324Ar 2  80 D1              BRA   @clear_loop
00324Cr 2               
00324Cr 2               @clear_big:
00324Cr 2                     ; 16-bit size at payload offset 0 and 1 (header +2 and +3)
00324Cr 2  A0 02              LDY   #GC_HDR_BYTES
00324Er 2  B1 rr              LDA   (ptr_lo),Y
003250r 2  85 rr              STA   gc_tmp_lo
003252r 2  C8                 INY
003253r 2  B1 rr              LDA   (ptr_lo),Y
003255r 2  85 rr              STA   gc_tmp_hi
003257r 2  18                 CLC
003258r 2  A5 rr              LDA   gc_ptr_lo
00325Ar 2  65 rr              ADC   gc_tmp_lo
00325Cr 2  85 rr              STA   gc_ptr_lo
00325Er 2  A5 rr              LDA   gc_ptr_hi
003260r 2  65 rr              ADC   gc_tmp_hi
003262r 2  85 rr              STA   gc_ptr_hi
003264r 2  80 B7              BRA   @clear_loop
003266r 2               
003266r 2               @clear_done:
003266r 2               
003266r 2                     ; Phase 2: Mark all reachable objects
003266r 2                     ; Root 1: variable list (var_head)
003266r 2  20 rr rr           JSR   gc_mark_vars
003269r 2               
003269r 2                     ; Root 2: procedure list (proc_head)
003269r 2  20 rr rr           JSR   gc_mark_procs
00326Cr 2               
00326Cr 2                     ; Root 3: current token list (tok_head)
00326Cr 2  20 rr rr           JSR   gc_mark_token_list
00326Fr 2               
00326Fr 2                     ; Phase 3: Sweep — find the highest marked allocation,
00326Fr 2                     ; reset heap_ptr to just past it. This works because we
00326Fr 2                     ; use a bump allocator with no free list; all unmarked
00326Fr 2                     ; allocations between marked ones become wasted space,
00326Fr 2                     ; but in practice the permanent objects (vars, procs) are
00326Fr 2                     ; allocated early and the ephemeral ones (tokens, cons,
00326Fr 2                     ; strings) are allocated later and all unmarked — so
00326Fr 2                     ; heap_ptr shrinks back dramatically.
00326Fr 2                     ;
00326Fr 2                     ; Walk the heap forward; track the highest end-address
00326Fr 2                     ; of any marked allocation.
00326Fr 2  A9 00              LDA   #<HEAP_START
003271r 2  85 rr              STA   gc_ptr_lo
003273r 2  A9 04              LDA   #>HEAP_START
003275r 2  85 rr              STA   gc_ptr_hi
003277r 2                     ; gc_tmp = highest marked end (start at HEAP_START = nothing marked)
003277r 2  A9 00              LDA   #<HEAP_START
003279r 2  85 rr              STA   gc_tmp_lo
00327Br 2  A9 04              LDA   #>HEAP_START
00327Dr 2  85 rr              STA   gc_tmp_hi
00327Fr 2               
00327Fr 2               @sweep_loop:
00327Fr 2                     ; Reached end of allocated space?
00327Fr 2  A5 rr              LDA   gc_ptr_hi
003281r 2  C5 rr              CMP   heap_ptr+1
003283r 2  90 08              BCC   @sweep_one
003285r 2  D0 49              BNE   @sweep_done
003287r 2  A5 rr              LDA   gc_ptr_lo
003289r 2  C5 rr              CMP   heap_ptr
00328Br 2  B0 43              BCS   @sweep_done
00328Dr 2               
00328Dr 2               @sweep_one:
00328Dr 2  A5 rr              LDA   gc_ptr_lo
00328Fr 2  85 rr              STA   ptr_lo
003291r 2  A5 rr              LDA   gc_ptr_hi
003293r 2  85 rr              STA   ptr_hi
003295r 2               
003295r 2                     ; Get size of this allocation
003295r 2  A0 01              LDY   #GC_HDR_SIZE
003297r 2  B1 rr              LDA   (ptr_lo),Y
003299r 2  F0 06              BEQ   @sweep_big
00329Br 2  85 rr              STA   gc_mark_lo            ; use gc_mark_lo as temp for size
00329Dr 2  64 rr              STZ   gc_mark_hi
00329Fr 2  80 0B              BRA   @sweep_check_mark
0032A1r 2               
0032A1r 2               @sweep_big:
0032A1r 2  A0 02              LDY   #GC_HDR_BYTES
0032A3r 2  B1 rr              LDA   (ptr_lo),Y
0032A5r 2  85 rr              STA   gc_mark_lo
0032A7r 2  C8                 INY
0032A8r 2  B1 rr              LDA   (ptr_lo),Y
0032AAr 2  85 rr              STA   gc_mark_hi
0032ACr 2               
0032ACr 2               @sweep_check_mark:
0032ACr 2                     ; Is this allocation marked?
0032ACr 2  A0 00              LDY   #GC_HDR_TAG
0032AEr 2  B1 rr              LDA   (ptr_lo),Y
0032B0r 2  29 80              AND   #ALLOC_MARK_BIT
0032B2r 2  F0 0D              BEQ   @sweep_advance        ; not marked — skip
0032B4r 2               
0032B4r 2                     ; Marked — compute end address = gc_ptr + size
0032B4r 2  18                 CLC
0032B5r 2  A5 rr              LDA   gc_ptr_lo
0032B7r 2  65 rr              ADC   gc_mark_lo
0032B9r 2  85 rr              STA   gc_tmp_lo             ; update highest end
0032BBr 2  A5 rr              LDA   gc_ptr_hi
0032BDr 2  65 rr              ADC   gc_mark_hi
0032BFr 2  85 rr              STA   gc_tmp_hi
0032C1r 2               
0032C1r 2               @sweep_advance:
0032C1r 2                     ; Advance gc_ptr by size
0032C1r 2  18                 CLC
0032C2r 2  A5 rr              LDA   gc_ptr_lo
0032C4r 2  65 rr              ADC   gc_mark_lo
0032C6r 2  85 rr              STA   gc_ptr_lo
0032C8r 2  A5 rr              LDA   gc_ptr_hi
0032CAr 2  65 rr              ADC   gc_mark_hi
0032CCr 2  85 rr              STA   gc_ptr_hi
0032CEr 2  80 AF              BRA   @sweep_loop
0032D0r 2               
0032D0r 2               @sweep_done:
0032D0r 2                     ; Set heap_ptr to highest marked end
0032D0r 2  A5 rr              LDA   gc_tmp_lo
0032D2r 2  85 rr              STA   heap_ptr
0032D4r 2  A5 rr              LDA   gc_tmp_hi
0032D6r 2  85 rr              STA   heap_ptr+1
0032D8r 2  60                 RTS
0032D9r 2               
0032D9r 2               ; ---------------------------------------------------------------------
0032D9r 2               ; gc_mark_node — mark a single allocation given a payload pointer
0032D9r 2               ;   Input: gc_mark_lo/hi = pointer to payload (header is at -2)
0032D9r 2               ;   If pointer is $0000 or below HEAP_START, skip.
0032D9r 2               ;   Clobbers: A, Y (preserves gc_mark_lo/hi)
0032D9r 2               ; ---------------------------------------------------------------------
0032D9r 2               gc_mark_node:
0032D9r 2                     ; Null check
0032D9r 2  A5 rr              LDA   gc_mark_lo
0032DBr 2  05 rr              ORA   gc_mark_hi
0032DDr 2  F0 21              BEQ   @done
0032DFr 2               
0032DFr 2                     ; Compute header address = payload - 2
0032DFr 2  A5 rr              LDA   gc_mark_lo
0032E1r 2  38                 SEC
0032E2r 2  E9 02              SBC   #GC_HDR_BYTES
0032E4r 2  85 rr              STA   ptr_lo
0032E6r 2  A5 rr              LDA   gc_mark_hi
0032E8r 2  E9 00              SBC   #0
0032EAr 2  85 rr              STA   ptr_hi
0032ECr 2               
0032ECr 2                     ; Range check: must be >= HEAP_START
0032ECr 2  C9 04              CMP   #>HEAP_START
0032EEr 2  90 10              BCC   @done
0032F0r 2  D0 06              BNE   @in_range
0032F2r 2  A5 rr              LDA   ptr_lo
0032F4r 2  C9 00              CMP   #<HEAP_START
0032F6r 2  90 08              BCC   @done
0032F8r 2               @in_range:
0032F8r 2               
0032F8r 2                     ; Set mark bit
0032F8r 2  A0 00              LDY   #GC_HDR_TAG
0032FAr 2  B1 rr              LDA   (ptr_lo),Y
0032FCr 2  09 80              ORA   #ALLOC_MARK_BIT
0032FEr 2  91 rr              STA   (ptr_lo),Y
003300r 2               @done:
003300r 2  60                 RTS
003301r 2               
003301r 2               ; ---------------------------------------------------------------------
003301r 2               ; gc_mark_vars — walk the variable linked list and mark each entry
003301r 2               ;   Also marks any list values pointed to by variables.
003301r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_mark, ptr_lo/hi, ptr2_lo/hi
003301r 2               ; ---------------------------------------------------------------------
003301r 2               gc_mark_vars:
003301r 2  A5 rr              LDA   var_head_lo
003303r 2  85 rr              STA   gc_ptr_lo
003305r 2  A5 rr              LDA   var_head_hi
003307r 2  85 rr              STA   gc_ptr_hi
003309r 2               
003309r 2               @walk:
003309r 2  A5 rr              LDA   gc_ptr_lo
00330Br 2  05 rr              ORA   gc_ptr_hi
00330Dr 2  D0 01              BNE   @have_var
00330Fr 2  60                 RTS
003310r 2               @have_var:
003310r 2               
003310r 2                     ; Mark this var entry
003310r 2  A5 rr              LDA   gc_ptr_lo
003312r 2  85 rr              STA   gc_mark_lo
003314r 2  A5 rr              LDA   gc_ptr_hi
003316r 2  85 rr              STA   gc_mark_hi
003318r 2  20 rr rr           JSR   gc_mark_node
00331Br 2               
00331Br 2                     ; Read the variable's value — if it's a list, mark the list
00331Br 2  A5 rr              LDA   gc_ptr_lo
00331Dr 2  85 rr              STA   ptr_lo
00331Fr 2  A5 rr              LDA   gc_ptr_hi
003321r 2  85 rr              STA   ptr_hi
003323r 2  A0 02              LDY   #VAR_NAME_LEN
003325r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
003327r 2  18                 CLC
003328r 2  69 03              ADC   #VAR_NAME             ; offset to value_type
00332Ar 2  A8                 TAY
00332Br 2  B1 rr              LDA   (ptr_lo),Y           ; value_type
00332Dr 2  C9 02              CMP   #VAL_LIST
00332Fr 2  D0 23              BNE   @var_check_word
003331r 2                     ; It's a list — get the list head pointer and mark the list
003331r 2  C8                 INY
003332r 2  B1 rr              LDA   (ptr_lo),Y           ; val_hi (actually car_hi)
003334r 2  85 rr              STA   gc_tmp_hi
003336r 2  C8                 INY
003337r 2  B1 rr              LDA   (ptr_lo),Y           ; val_lo
003339r 2  85 rr              STA   gc_tmp_lo
00333Br 2                     ; Save gc_ptr across recursive mark
00333Br 2  A5 rr              LDA   gc_ptr_lo
00333Dr 2  48                 PHA
00333Er 2  A5 rr              LDA   gc_ptr_hi
003340r 2  48                 PHA
003341r 2  A5 rr              LDA   gc_tmp_lo
003343r 2  85 rr              STA   gc_mark_lo
003345r 2  A5 rr              LDA   gc_tmp_hi
003347r 2  85 rr              STA   gc_mark_hi
003349r 2  20 rr rr           JSR   gc_mark_list
00334Cr 2  68                 PLA
00334Dr 2  85 rr              STA   gc_ptr_hi
00334Fr 2  68                 PLA
003350r 2  85 rr              STA   gc_ptr_lo
003352r 2  80 25              BRA   @var_next
003354r 2               
003354r 2               @var_check_word:
003354r 2  C9 01              CMP   #VAL_WORD
003356r 2  D0 21              BNE   @var_next
003358r 2                     ; It's a word — mark the string allocation
003358r 2  C8                 INY
003359r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_hi for word
00335Br 2  85 rr              STA   gc_tmp_hi
00335Dr 2  C8                 INY
00335Er 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_lo for word
003360r 2  85 rr              STA   gc_tmp_lo
003362r 2  A5 rr              LDA   gc_ptr_lo
003364r 2  48                 PHA
003365r 2  A5 rr              LDA   gc_ptr_hi
003367r 2  48                 PHA
003368r 2  A5 rr              LDA   gc_tmp_lo
00336Ar 2  85 rr              STA   gc_mark_lo
00336Cr 2  A5 rr              LDA   gc_tmp_hi
00336Er 2  85 rr              STA   gc_mark_hi
003370r 2  20 rr rr           JSR   gc_mark_node
003373r 2  68                 PLA
003374r 2  85 rr              STA   gc_ptr_hi
003376r 2  68                 PLA
003377r 2  85 rr              STA   gc_ptr_lo
003379r 2               
003379r 2               @var_next:
003379r 2                     ; Follow next pointer
003379r 2  A5 rr              LDA   gc_ptr_lo
00337Br 2  85 rr              STA   ptr_lo
00337Dr 2  A5 rr              LDA   gc_ptr_hi
00337Fr 2  85 rr              STA   ptr_hi
003381r 2  A0 00              LDY   #VAR_NEXT_LO
003383r 2  B1 rr              LDA   (ptr_lo),Y
003385r 2  AA                 TAX
003386r 2  C8                 INY
003387r 2  B1 rr              LDA   (ptr_lo),Y
003389r 2  85 rr              STA   gc_ptr_hi
00338Br 2  86 rr              STX   gc_ptr_lo
00338Dr 2  4C rr rr           JMP   @walk
003390r 2               
003390r 2               ; ---------------------------------------------------------------------
003390r 2               ; gc_mark_procs — walk the procedure list and mark each record
003390r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
003390r 2               ; ---------------------------------------------------------------------
003390r 2               gc_mark_procs:
003390r 2  A5 rr              LDA   proc_head_lo
003392r 2  85 rr              STA   gc_ptr_lo
003394r 2  A5 rr              LDA   proc_head_hi
003396r 2  85 rr              STA   gc_ptr_hi
003398r 2               
003398r 2               @walk:
003398r 2  A5 rr              LDA   gc_ptr_lo
00339Ar 2  05 rr              ORA   gc_ptr_hi
00339Cr 2  F0 2B              BEQ   @done
00339Er 2               
00339Er 2                     ; Mark this procedure record.
00339Er 2                     ; proc_entry points to record data (base+4); header is at base+0.
00339Er 2                     ; Subtract 4 to get the header address for marking.
00339Er 2  A5 rr              LDA   gc_ptr_lo
0033A0r 2  38                 SEC
0033A1r 2  E9 04              SBC   #4
0033A3r 2  85 rr              STA   ptr_lo
0033A5r 2  A5 rr              LDA   gc_ptr_hi
0033A7r 2  E9 00              SBC   #0
0033A9r 2  85 rr              STA   ptr_hi
0033ABr 2                     ; Set mark bit directly at the header
0033ABr 2  A0 00              LDY   #GC_HDR_TAG
0033ADr 2  B1 rr              LDA   (ptr_lo),Y
0033AFr 2  09 80              ORA   #ALLOC_MARK_BIT
0033B1r 2  91 rr              STA   (ptr_lo),Y
0033B3r 2               
0033B3r 2                     ; Follow next pointer (at record data offset 0)
0033B3r 2  A5 rr              LDA   gc_ptr_lo
0033B5r 2  85 rr              STA   ptr_lo
0033B7r 2  A5 rr              LDA   gc_ptr_hi
0033B9r 2  85 rr              STA   ptr_hi
0033BBr 2  A0 00              LDY   #0                    ; next_lo at offset 0
0033BDr 2  B1 rr              LDA   (ptr_lo),Y
0033BFr 2  AA                 TAX
0033C0r 2  C8                 INY
0033C1r 2  B1 rr              LDA   (ptr_lo),Y
0033C3r 2  85 rr              STA   gc_ptr_hi
0033C5r 2  86 rr              STX   gc_ptr_lo
0033C7r 2  80 CF              BRA   @walk
0033C9r 2               
0033C9r 2               @done:
0033C9r 2  60                 RTS
0033CAr 2               
0033CAr 2               ; ---------------------------------------------------------------------
0033CAr 2               ; gc_mark_token_list — walk tok_head linked list and mark each token
0033CAr 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
0033CAr 2               ; ---------------------------------------------------------------------
0033CAr 2               gc_mark_token_list:
0033CAr 2  A5 rr              LDA   tok_head_lo
0033CCr 2  85 rr              STA   gc_ptr_lo
0033CEr 2  A5 rr              LDA   tok_head_hi
0033D0r 2  85 rr              STA   gc_ptr_hi
0033D2r 2               
0033D2r 2               @walk:
0033D2r 2  A5 rr              LDA   gc_ptr_lo
0033D4r 2  05 rr              ORA   gc_ptr_hi
0033D6r 2  F0 21              BEQ   @done
0033D8r 2               
0033D8r 2                     ; Mark this token
0033D8r 2  A5 rr              LDA   gc_ptr_lo
0033DAr 2  85 rr              STA   gc_mark_lo
0033DCr 2  A5 rr              LDA   gc_ptr_hi
0033DEr 2  85 rr              STA   gc_mark_hi
0033E0r 2  20 rr rr           JSR   gc_mark_node
0033E3r 2               
0033E3r 2                     ; Follow next pointer (at payload offsets TOK_NEXT_LO/HI)
0033E3r 2  A5 rr              LDA   gc_ptr_lo
0033E5r 2  85 rr              STA   ptr_lo
0033E7r 2  A5 rr              LDA   gc_ptr_hi
0033E9r 2  85 rr              STA   ptr_hi
0033EBr 2  A0 01              LDY   #TOK_NEXT_LO
0033EDr 2  B1 rr              LDA   (ptr_lo),Y
0033EFr 2  AA                 TAX
0033F0r 2  C8                 INY
0033F1r 2  B1 rr              LDA   (ptr_lo),Y
0033F3r 2  85 rr              STA   gc_ptr_hi
0033F5r 2  86 rr              STX   gc_ptr_lo
0033F7r 2  80 D9              BRA   @walk
0033F9r 2               
0033F9r 2               @done:
0033F9r 2  60                 RTS
0033FAr 2               
0033FAr 2               ; ---------------------------------------------------------------------
0033FAr 2               ; gc_mark_list — recursively mark a cons-pair list
0033FAr 2               ;   Input: gc_mark_lo/hi = head cons pair pointer (payload)
0033FAr 2               ;   Marks each cons cell, and recursively marks sublists and word strings.
0033FAr 2               ;   Clobbers: A, X, Y, gc_mark, gc_ptr, ptr_lo/hi
0033FAr 2               ; ---------------------------------------------------------------------
0033FAr 2               gc_mark_list:
0033FAr 2                     ; Use gc_ptr to walk the list, gc_mark for marking
0033FAr 2  A5 rr              LDA   gc_mark_lo
0033FCr 2  85 rr              STA   gc_ptr_lo
0033FEr 2  A5 rr              LDA   gc_mark_hi
003400r 2  85 rr              STA   gc_ptr_hi
003402r 2               
003402r 2               @walk:
003402r 2  A5 rr              LDA   gc_ptr_lo
003404r 2  05 rr              ORA   gc_ptr_hi
003406r 2  F0 70              BEQ   @done
003408r 2               
003408r 2                     ; Mark this cons pair
003408r 2  A5 rr              LDA   gc_ptr_lo
00340Ar 2  85 rr              STA   gc_mark_lo
00340Cr 2  A5 rr              LDA   gc_ptr_hi
00340Er 2  85 rr              STA   gc_mark_hi
003410r 2  20 rr rr           JSR   gc_mark_node
003413r 2               
003413r 2                     ; Check car_type: if list, recursively mark sublist
003413r 2                     ; if word, mark the string
003413r 2  A5 rr              LDA   gc_ptr_lo
003415r 2  85 rr              STA   ptr_lo
003417r 2  A5 rr              LDA   gc_ptr_hi
003419r 2  85 rr              STA   ptr_hi
00341Br 2  A0 01              LDY   #CONS_CAR_TYPE
00341Dr 2  B1 rr              LDA   (ptr_lo),Y
00341Fr 2  C9 02              CMP   #VAL_LIST
003421r 2  F0 23              BEQ   @car_list
003423r 2  C9 01              CMP   #VAL_WORD
003425r 2  F0 02              BEQ   @car_word
003427r 2  80 38              BRA   @follow_cdr
003429r 2               
003429r 2               @car_word:
003429r 2                     ; Mark the word string allocation
003429r 2  A0 03              LDY   #CONS_CAR_LO
00342Br 2  B1 rr              LDA   (ptr_lo),Y
00342Dr 2  85 rr              STA   gc_mark_lo
00342Fr 2  A0 02              LDY   #CONS_CAR_HI
003431r 2  B1 rr              LDA   (ptr_lo),Y
003433r 2  85 rr              STA   gc_mark_hi
003435r 2                     ; Save gc_ptr across mark
003435r 2  A5 rr              LDA   gc_ptr_lo
003437r 2  48                 PHA
003438r 2  A5 rr              LDA   gc_ptr_hi
00343Ar 2  48                 PHA
00343Br 2  20 rr rr           JSR   gc_mark_node
00343Er 2  68                 PLA
00343Fr 2  85 rr              STA   gc_ptr_hi
003441r 2  68                 PLA
003442r 2  85 rr              STA   gc_ptr_lo
003444r 2  80 1B              BRA   @follow_cdr
003446r 2               
003446r 2               @car_list:
003446r 2                     ; Recursively mark the sublist
003446r 2  A0 03              LDY   #CONS_CAR_LO
003448r 2  B1 rr              LDA   (ptr_lo),Y
00344Ar 2  85 rr              STA   gc_mark_lo
00344Cr 2  A0 02              LDY   #CONS_CAR_HI
00344Er 2  B1 rr              LDA   (ptr_lo),Y
003450r 2  85 rr              STA   gc_mark_hi
003452r 2                     ; Save gc_ptr across recursive call
003452r 2  A5 rr              LDA   gc_ptr_lo
003454r 2  48                 PHA
003455r 2  A5 rr              LDA   gc_ptr_hi
003457r 2  48                 PHA
003458r 2  20 rr rr           JSR   gc_mark_list          ; recursive
00345Br 2  68                 PLA
00345Cr 2  85 rr              STA   gc_ptr_hi
00345Er 2  68                 PLA
00345Fr 2  85 rr              STA   gc_ptr_lo
003461r 2               
003461r 2               @follow_cdr:
003461r 2                     ; Follow cdr to next cons pair
003461r 2  A5 rr              LDA   gc_ptr_lo
003463r 2  85 rr              STA   ptr_lo
003465r 2  A5 rr              LDA   gc_ptr_hi
003467r 2  85 rr              STA   ptr_hi
003469r 2  A0 05              LDY   #CONS_CDR_LO
00346Br 2  B1 rr              LDA   (ptr_lo),Y
00346Dr 2  AA                 TAX
00346Er 2  A0 06              LDY   #CONS_CDR_HI
003470r 2  B1 rr              LDA   (ptr_lo),Y
003472r 2  85 rr              STA   gc_ptr_hi
003474r 2  86 rr              STX   gc_ptr_lo
003476r 2  80 8A              BRA   @walk
003478r 2               
003478r 2               @done:
003478r 2  60                 RTS
003479r 2               
003479r 1               
003479r 1               ; =====================================================================
003479r 1               ; ZEROPAGE segment — interpreter zero-page variables
003479r 1               ; =====================================================================
003479r 1                     .segment "ZEROPAGE"
00004Dr 1               
00004Dr 1  xx           buf_idx:      .res 1          ; current position in input_buf
00004Er 1               
00004Er 1               ; =====================================================================
00004Er 1               ; BSS segment — runtime buffers
00004Er 1               ; =====================================================================
00004Er 1                     .segment "BSS"
000984r 1               
000984r 1  xx xx xx xx  input_buf:    .res 128        ; input line buffer
000988r 1  xx xx xx xx  
00098Cr 1  xx xx xx xx  
000A04r 1               
000A04r 1               ; =====================================================================
000A04r 1               ; CODE segment — cold start and main loop
000A04r 1               ; =====================================================================
000A04r 1                     .segment "CODE"
003479r 1               
003479r 1               cold_start:
003479r 1                     ; Copy extension ROM trampoline to RAM
003479r 1  A2 0D              LDX   #EXT_TRAMP_SIZE-1
00347Br 1               @copy_tramp:
00347Br 1  BD rr rr           LDA   ext_tramp_src,X
00347Er 1  9D 70 02           STA   EXT_TRAMPOLINE,X
003481r 1  CA                 DEX
003482r 1  10 F7              BPL   @copy_tramp
003484r 1               
003484r 1                     ; Zero NovaLogo turtle/graphics state ($9F00..$9F1F) so each session starts
003484r 1                     ; in a known mode. The extension pins its turtle state here (extension.s
003484r 1                     ; TURTLE_STATE_BASE=$9F00); RAM is stale across soft-reboot on HW, and a
003484r 1                     ; stale graphics-mode/inited flag breaks auto-switch and re-init.
003484r 1  A2 1F              LDX   #$1F
003486r 1               @zero_turtle:
003486r 1  9E 00 9F           STZ   $9F00,X
003489r 1  CA                 DEX
00348Ar 1  10 FA              BPL   @zero_turtle
00348Cr 1               
00348Cr 1  20 rr rr           JSR   heap_init
00348Fr 1  20 rr rr           JSR   var_init
003492r 1  20 rr rr           JSR   proc_init
003495r 1  64 rr              STZ   catch_active
003497r 1  9C 0A A0           STZ   VGC_CURSEN
00349Ar 1  20 rr rr           JSR   print_banner
00349Dr 1  20 rr rr           JSR   print_prompt
0034A0r 1               
0034A0r 1               main_loop:
0034A0r 1  20 rr rr           JSR   read_line
0034A3r 1  9C 0A A0           STZ   VGC_CURSEN
0034A6r 1  20 rr rr           JSR   tokenize_line
0034A9r 1  20 rr rr           JSR   check_to_command
0034ACr 1  B0 03              BCS   @was_to               ; carry set = TO was handled
0034AEr 1  20 rr rr           JSR   eval_line
0034B1r 1               @was_to:
0034B1r 1                     ; Reclaim dead heap objects (tokens, list cells, etc.)
0034B1r 1  20 rr rr           JSR   gc_collect
0034B4r 1  20 rr rr           JSR   print_prompt
0034B7r 1  80 E7              BRA   main_loop
0034B9r 1               
0034B9r 1               ; ---------------------------------------------------------------------
0034B9r 1               ; check_to_command — if the first token is TO / EDIT / ED, handle it as a
0034B9r 1               ;   procedure-definition command (TO collects a new proc; EDIT/ED reopen an
0034B9r 1               ;   existing one in the editor).
0034B9r 1               ;   Output: carry set = handled, carry clear = not a definition command.
0034B9r 1               ;   Clobbers: A, Y, ptr_lo/hi, eval_cur
0034B9r 1               ; ---------------------------------------------------------------------
0034B9r 1               check_to_command:
0034B9r 1  A5 rr              LDA   tok_head_lo
0034BBr 1  05 rr              ORA   tok_head_hi
0034BDr 1  F0 5A              BEQ   @not_to
0034BFr 1               
0034BFr 1                     ; First token must be TOK_WORD
0034BFr 1  A5 rr              LDA   tok_head_lo
0034C1r 1  85 rr              STA   ptr_lo
0034C3r 1  A5 rr              LDA   tok_head_hi
0034C5r 1  85 rr              STA   ptr_hi
0034C7r 1  A0 00              LDY   #TOK_TAG
0034C9r 1  B1 rr              LDA   (ptr_lo),Y
0034CBr 1  C9 01              CMP   #TOK_WORD
0034CDr 1  D0 4A              BNE   @not_to
0034CFr 1               
0034CFr 1  A0 03              LDY   #TOK_PAYLOAD
0034D1r 1  B1 rr              LDA   (ptr_lo),Y           ; word length
0034D3r 1  C9 02              CMP   #2
0034D5r 1  F0 06              BEQ   @len2
0034D7r 1  C9 04              CMP   #4
0034D9r 1  F0 19              BEQ   @len4
0034DBr 1  80 3C              BRA   @not_to
0034DDr 1               
0034DDr 1               @len2:
0034DDr 1  A0 04              LDY   #TOK_PAYLOAD+1
0034DFr 1  B1 rr              LDA   (ptr_lo),Y
0034E1r 1  C9 54              CMP   #'T'
0034E3r 1  D0 34              BNE   @not_to
0034E5r 1  C8                 INY
0034E6r 1  B1 rr              LDA   (ptr_lo),Y
0034E8r 1  C9 4F              CMP   #'O'
0034EAr 1  D0 2D              BNE   @not_to
0034ECr 1                     ; "TO" — collect a new procedure
0034ECr 1  20 rr rr           JSR   @set_cur
0034EFr 1  20 rr rr           JSR   proc_collect
0034F2r 1  38                 SEC
0034F3r 1  60                 RTS
0034F4r 1               @len4:
0034F4r 1  A0 04              LDY   #TOK_PAYLOAD+1
0034F6r 1  B1 rr              LDA   (ptr_lo),Y
0034F8r 1  C9 45              CMP   #'E'
0034FAr 1  D0 1D              BNE   @not_to
0034FCr 1  C8                 INY
0034FDr 1  B1 rr              LDA   (ptr_lo),Y
0034FFr 1  C9 44              CMP   #'D'
003501r 1  D0 16              BNE   @not_to
003503r 1  C8                 INY
003504r 1  B1 rr              LDA   (ptr_lo),Y
003506r 1  C9 49              CMP   #'I'
003508r 1  D0 0F              BNE   @not_to
00350Ar 1  C8                 INY
00350Br 1  B1 rr              LDA   (ptr_lo),Y
00350Dr 1  C9 54              CMP   #'T'
00350Fr 1  D0 08              BNE   @not_to
003511r 1                     ; "EDIT" — edit
003511r 1  20 rr rr           JSR   @set_cur
003514r 1  20 rr rr           JSR   proc_edit
003517r 1  38                 SEC
003518r 1  60                 RTS
003519r 1               
003519r 1               @not_to:
003519r 1  18                 CLC
00351Ar 1  60                 RTS
00351Br 1               
00351Br 1               @set_cur:
00351Br 1                     ; eval_cur = first token, then advance past it to the name token
00351Br 1  A5 rr              LDA   tok_head_lo
00351Dr 1  85 rr              STA   eval_cur_lo
00351Fr 1  A5 rr              LDA   tok_head_hi
003521r 1  85 rr              STA   eval_cur_hi
003523r 1  4C rr rr           JMP   eval_advance         ; ends with RTS
003526r 1               
003526r 1               ; ---------------------------------------------------------------------
003526r 1               ; read_line — read a line of input into input_buf, null-terminated
003526r 1               ;   On return: input_buf contains the line, buf_idx = length
003526r 1               ; ---------------------------------------------------------------------
003526r 1               read_line:
003526r 1  64 rr              STZ   buf_idx            ; reset buffer index to 0
003528r 1  A9 01              LDA   #$01
00352Ar 1  8D 0A A0           STA   VGC_CURSEN
00352Dr 1               
00352Dr 1               @poll:
00352Dr 1  AD 0F A0           LDA   VGC_CHARIN         ; poll keyboard
003530r 1  F0 FB              BEQ   @poll              ; no key waiting — spin
003532r 1               
003532r 1                     ; --- handle CR ($0D) ---
003532r 1  C9 0D              CMP   #$0D
003534r 1  D0 39              BNE   @not_cr
003536r 1                     ; End of a typed line. If brackets/parens are still open, keep reading so
003536r 1                     ; a multi-line statement can be entered right at the prompt.
003536r 1  20 rr rr           JSR   line_bracket_depth
003539r 1  F0 24              BEQ   @cr_finish
00353Br 1  A6 rr              LDX   buf_idx
00353Dr 1  E0 78              CPX   #120
00353Fr 1  B0 1E              BCS   @cr_finish         ; buffer nearly full — stop accumulating
003541r 1  A9 0A              LDA   #$0A               ; newline separator (tokenizer treats it as space)
003543r 1  9D rr rr           STA   input_buf,X
003546r 1  E6 rr              INC   buf_idx
003548r 1  A9 0D              LDA   #$0D
00354Ar 1  8D 0E A0           STA   VGC_CHAROUT
00354Dr 1  A9 0A              LDA   #$0A
00354Fr 1  8D 0E A0           STA   VGC_CHAROUT
003552r 1  A9 7E              LDA   #'~'               ; continuation prompt
003554r 1  8D 0E A0           STA   VGC_CHAROUT
003557r 1  A9 20              LDA   #' '
003559r 1  8D 0E A0           STA   VGC_CHAROUT
00355Cr 1  4C rr rr           JMP   @poll
00355Fr 1               @cr_finish:
00355Fr 1  A6 rr              LDX   buf_idx
003561r 1  9E rr rr           STZ   input_buf,X        ; null-terminate
003564r 1  A9 0D              LDA   #$0D
003566r 1  8D 0E A0           STA   VGC_CHAROUT        ; carriage return
003569r 1  A9 0A              LDA   #$0A
00356Br 1  8D 0E A0           STA   VGC_CHAROUT        ; line feed
00356Er 1  60                 RTS
00356Fr 1               
00356Fr 1               @not_cr:
00356Fr 1                     ; --- handle backspace ($08, $14, $7F) ---
00356Fr 1  C9 08              CMP   #$08
003571r 1  F0 18              BEQ   @backspace
003573r 1  C9 14              CMP   #$14
003575r 1  F0 14              BEQ   @backspace
003577r 1  C9 7F              CMP   #$7F
003579r 1  F0 10              BEQ   @backspace
00357Br 1               
00357Br 1                     ; --- buffer full? ---
00357Br 1  A6 rr              LDX   buf_idx
00357Dr 1  E0 7F              CPX   #127
00357Fr 1  B0 AC              BCS   @poll              ; at capacity — ignore keystroke
003581r 1               
003581r 1                     ; --- store and echo printable character ---
003581r 1  9D rr rr           STA   input_buf,X        ; store in buffer
003584r 1  8D 0E A0           STA   VGC_CHAROUT        ; echo to screen
003587r 1  E6 rr              INC   buf_idx
003589r 1  80 A2              BRA   @poll
00358Br 1               
00358Br 1               @backspace:
00358Br 1  A6 rr              LDX   buf_idx
00358Dr 1  F0 9E              BEQ   @poll              ; nothing to delete — ignore
00358Fr 1  CA                 DEX
003590r 1  86 rr              STX   buf_idx
003592r 1  A9 08              LDA   #$08
003594r 1  8D 0E A0           STA   VGC_CHAROUT        ; move cursor left and erase
003597r 1  80 94              BRA   @poll
003599r 1               
003599r 1               ; ---------------------------------------------------------------------
003599r 1               ; line_bracket_depth — net count of unclosed '[' and '(' in input_buf[0..buf_idx),
003599r 1               ;   ignoring text inside ';' comments. Returns depth in A (Z set if balanced).
003599r 1               ;   Clobbers: A, X, Y.
003599r 1               ; ---------------------------------------------------------------------
003599r 1               line_bracket_depth:
003599r 1  A2 00              LDX   #0                 ; scan index
00359Br 1  A0 00              LDY   #0                 ; depth
00359Dr 1               @bd_loop:
00359Dr 1  E4 rr              CPX   buf_idx
00359Fr 1  B0 32              BCS   @bd_done
0035A1r 1  BD rr rr           LDA   input_buf,X
0035A4r 1  C9 3B              CMP   #';'
0035A6r 1  F0 1D              BEQ   @bd_comment
0035A8r 1  C9 5B              CMP   #'['
0035AAr 1  F0 0F              BEQ   @bd_inc
0035ACr 1  C9 28              CMP   #'('
0035AEr 1  F0 0B              BEQ   @bd_inc
0035B0r 1  C9 5D              CMP   #']'
0035B2r 1  F0 0A              BEQ   @bd_dec
0035B4r 1  C9 29              CMP   #')'
0035B6r 1  F0 06              BEQ   @bd_dec
0035B8r 1               @bd_next:
0035B8r 1  E8                 INX
0035B9r 1  80 E2              BRA   @bd_loop
0035BBr 1               @bd_inc:
0035BBr 1  C8                 INY
0035BCr 1  80 FA              BRA   @bd_next
0035BEr 1               @bd_dec:
0035BEr 1  C0 00              CPY   #0
0035C0r 1  F0 F6              BEQ   @bd_next           ; floor at 0
0035C2r 1  88                 DEY
0035C3r 1  80 F3              BRA   @bd_next
0035C5r 1               @bd_comment:
0035C5r 1  E8                 INX                      ; skip ';' and everything up to a newline
0035C6r 1  E4 rr              CPX   buf_idx
0035C8r 1  B0 09              BCS   @bd_done
0035CAr 1  BD rr rr           LDA   input_buf,X
0035CDr 1  C9 0A              CMP   #$0A
0035CFr 1  D0 F4              BNE   @bd_comment
0035D1r 1  80 E5              BRA   @bd_next           ; resume scanning after the newline
0035D3r 1               @bd_done:
0035D3r 1  98                 TYA                      ; depth -> A, sets Z if zero
0035D4r 1  60                 RTS
0035D5r 1               
0035D5r 1               ; ---------------------------------------------------------------------
0035D5r 1               ; print_prompt — prints "? " to the screen
0035D5r 1               ; ---------------------------------------------------------------------
0035D5r 1               print_prompt:
0035D5r 1  20 rr rr           JSR   print_inl
0035D8r 1  3F 20 00           .byte "? ", 0
0035DBr 1  A9 01              LDA   #$01
0035DDr 1  8D 0A A0           STA   VGC_CURSEN
0035E0r 1  60                 RTS
0035E1r 1               
0035E1r 1               ; ---------------------------------------------------------------------
0035E1r 1               ; print_banner — prints title and current available heap bytes
0035E1r 1               ; ---------------------------------------------------------------------
0035E1r 1               print_banner:
0035E1r 1  20 rr rr           JSR   print_inl
0035E4r 1  4E 6F 76 61        .byte "Nova LOGO v1.0", $0D, $0A, 0
0035E8r 1  20 4C 4F 47  
0035ECr 1  4F 20 76 31  
0035F5r 1               
0035F5r 1  38                 SEC
0035F6r 1  A9 00              LDA   #<HEAP_END
0035F8r 1  E5 rr              SBC   heap_ptr
0035FAr 1  85 rr              STA   eval_val_lo
0035FCr 1  A9 98              LDA   #>HEAP_END
0035FEr 1  E5 rr              SBC   heap_ptr+1
003600r 1  85 rr              STA   eval_val_hi
003602r 1  38                 SEC
003603r 1  A5 rr              LDA   eval_val_lo
003605r 1  E9 02              SBC   #GC_HDR_BYTES
003607r 1  85 rr              STA   eval_val_lo
003609r 1  A5 rr              LDA   eval_val_hi
00360Br 1  E9 00              SBC   #0
00360Dr 1  85 rr              STA   eval_val_hi
00360Fr 1  64 rr              STZ   eval_val_frac
003611r 1  20 rr rr           JSR   print_uint16
003614r 1               
003614r 1  20 rr rr           JSR   print_inl
003617r 1  20 42 59 54        .byte " BYTES FREE", $0D, $0A, $0D, $0A, 0
00361Br 1  45 53 20 46  
00361Fr 1  52 45 45 0D  
003627r 1  60                 RTS
003628r 1               
003628r 1               ; =====================================================================
003628r 1               ; RODATA segment — string constants
003628r 1               ; =====================================================================
003628r 1                     .segment "RODATA"
000992r 1               
000992r 1               ; Extension ROM trampoline — copied to RAM at $0270 during cold_start.
000992r 1               ; Swaps to extension ROM, calls entry, swaps back to Logo ROM.
000992r 1               ext_tramp_src:
000992r 1  A9 04              .byte $A9, ROMSWAP_EXTENSION  ; LDA #ROMSWAP_EXTENSION
000994r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000997r 1  20 00 C0           .byte $20, $00, $C0          ; JSR $C000
00099Ar 1  A9 05              .byte $A9, ROMSWAP_LOGO      ; LDA #ROMSWAP_LOGO
00099Cr 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
00099Fr 1  60                 .byte $60                     ; RTS
0009A0r 1               
0009A0r 1               ; =====================================================================
0009A0r 1               ; MONITOR segment — reset handler at $FFD7
0009A0r 1               ; =====================================================================
0009A0r 1                     .segment "MONITOR"
000000r 1                     .org  $FFD7
00FFD7  1               
00FFD7  1               RES_vec:
00FFD7  1  D8                 CLD                     ; clear decimal mode
00FFD8  1  A2 FF              LDX   #$FF              ; empty stack
00FFDA  1  9A                 TXS                     ; set the stack
00FFDB  1  4C rr rr           JMP   cold_start
00FFDE  1               
00FFDE  1               ; IRQ/NMI stubs
00FFDE  1               NMI_stub:
00FFDE  1  40                 RTI
00FFDF  1               
00FFDF  1               IRQ_stub:
00FFDF  1  40                 RTI
00FFE0  1               
00FFE0  1               ; =====================================================================
00FFE0  1               ; VECTORS segment — 6502 hardware vectors at $FFFA
00FFE0  1               ; =====================================================================
00FFE0  1                     .segment "VECTORS"
00FFE0  1                     .org  $FFFA
00FFFA  1               
00FFFA  1  DE FF              .word NMI_stub           ; $FFFA — NMI vector
00FFFC  1  D7 FF              .word RES_vec            ; $FFFC — RESET vector
00FFFE  1  DF FF              .word IRQ_stub           ; $FFFE — IRQ vector
00FFFE  1               
