000E81r 2               ; ---------------------------------------------------------------------
000E81r 2               ; exec_body_block — execute a [...] body once
000E81r 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000E81r 2               ;   Exit:  eval_cur points past the matching ], carry clear = ok
000E81r 2               ;          Carry set = bracket error
000E81r 2               ;   Saves/restores body_resume, eval_in_body for nesting.
000E81r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, body_start/resume, eval_in_body
000E81r 2               ; ---------------------------------------------------------------------
000E81r 2               exec_body_block:
000E81r 2                     ; Verify current token is [
000E81r 2  A5 rr              LDA   eval_cur_lo
000E83r 2  05 rr              ORA   eval_cur_hi
000E85r 2  F0 7B              BEQ   @err
000E87r 2  A5 rr              LDA   eval_cur_lo
000E89r 2  85 rr              STA   ptr_lo
000E8Br 2  A5 rr              LDA   eval_cur_hi
000E8Dr 2  85 rr              STA   ptr_hi
000E8Fr 2  A0 00              LDY   #TOK_TAG
000E91r 2  B1 rr              LDA   (ptr_lo),Y
000E93r 2  C9 03              CMP   #TOK_LBRACKET
000E95r 2  D0 6B              BNE   @err
000E97r 2               
000E97r 2                     ; Advance past [
000E97r 2  20 rr rr           JSR   eval_advance
000E9Ar 2               
000E9Ar 2                     ; Save outer state for nesting
000E9Ar 2  A5 rr              LDA   body_resume_lo
000E9Cr 2  48                 PHA
000E9Dr 2  A5 rr              LDA   body_resume_hi
000E9Fr 2  48                 PHA
000EA0r 2  A5 rr              LDA   eval_in_body
000EA2r 2  48                 PHA
000EA3r 2               
000EA3r 2                     ; Save body start
000EA3r 2  A5 rr              LDA   eval_cur_lo
000EA5r 2  48                 PHA
000EA6r 2  A5 rr              LDA   eval_cur_hi
000EA8r 2  48                 PHA
000EA9r 2               
000EA9r 2                     ; Scan forward for matching ]
000EA9r 2  A2 01              LDX   #1
000EABr 2               @scan:
000EABr 2  A5 rr              LDA   eval_cur_lo
000EADr 2  05 rr              ORA   eval_cur_hi
000EAFr 2  F0 4C              BEQ   @err_pop5
000EB1r 2  A5 rr              LDA   eval_cur_lo
000EB3r 2  85 rr              STA   ptr_lo
000EB5r 2  A5 rr              LDA   eval_cur_hi
000EB7r 2  85 rr              STA   ptr_hi
000EB9r 2  A0 00              LDY   #TOK_TAG
000EBBr 2  B1 rr              LDA   (ptr_lo),Y
000EBDr 2  C9 03              CMP   #TOK_LBRACKET
000EBFr 2  D0 03              BNE   @not_lb
000EC1r 2  E8                 INX
000EC2r 2  80 07              BRA   @scan_next
000EC4r 2               @not_lb:
000EC4r 2  C9 04              CMP   #TOK_RBRACKET
000EC6r 2  D0 03              BNE   @scan_next
000EC8r 2  CA                 DEX
000EC9r 2  F0 07              BEQ   @found
000ECBr 2               @scan_next:
000ECBr 2  DA                 PHX
000ECCr 2  20 rr rr           JSR   eval_advance
000ECFr 2  FA                 PLX
000ED0r 2  80 D9              BRA   @scan
000ED2r 2               
000ED2r 2               @found:
000ED2r 2                     ; Advance past ] for resume point
000ED2r 2  20 rr rr           JSR   eval_advance
000ED5r 2  A5 rr              LDA   eval_cur_lo
000ED7r 2  85 rr              STA   body_resume_lo
000ED9r 2  A5 rr              LDA   eval_cur_hi
000EDBr 2  85 rr              STA   body_resume_hi
000EDDr 2               
000EDDr 2                     ; Restore body start
000EDDr 2  68                 PLA
000EDEr 2  85 rr              STA   eval_cur_hi
000EE0r 2  68                 PLA
000EE1r 2  85 rr              STA   eval_cur_lo
000EE3r 2               
000EE3r 2                     ; Execute the body
000EE3r 2  A9 01              LDA   #$01
000EE5r 2  85 rr              STA   eval_in_body
000EE7r 2  20 rr rr           JSR   eval_body
000EEAr 2               
000EEAr 2                     ; Restore outer state
000EEAr 2  68                 PLA
000EEBr 2  85 rr              STA   eval_in_body
000EEDr 2  68                 PLA
000EEEr 2  85 rr              STA   body_resume_hi
000EF0r 2  68                 PLA
000EF1r 2  85 rr              STA   body_resume_lo
000EF3r 2               
000EF3r 2                     ; Set eval_cur past the ]
000EF3r 2  A5 rr              LDA   body_resume_lo
000EF5r 2  85 rr              STA   eval_cur_lo
000EF7r 2  A5 rr              LDA   body_resume_hi
000EF9r 2  85 rr              STA   eval_cur_hi
000EFBr 2  18                 CLC
000EFCr 2  60                 RTS
000EFDr 2               
000EFDr 2               @err_pop5:
000EFDr 2  68                 PLA
000EFEr 2  68                 PLA
000EFFr 2  68                 PLA
000F00r 2  68                 PLA
000F01r 2  68                 PLA
000F02r 2               @err:
000F02r 2  38                 SEC
000F03r 2  60                 RTS
