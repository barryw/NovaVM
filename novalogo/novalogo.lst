003089r 2               ; do_erase — ERASE "name: remove procedure from directory
003089r 2               ;   Arity 0 — evaluates its own argument
003089r 2               ; ---------------------------------------------------------------------
003089r 2               do_erase:
003089r 2  20 rr rr           JSR   eval_expr
00308Cr 2  90 03              BCC   @er_type_ok
00308Er 2  4C rr rr           JMP   @err
003091r 2               @er_type_ok:
003091r 2  A5 rr              LDA   eval_type
003093r 2  C9 01              CMP   #VAL_WORD
003095r 2  F0 03              BEQ   @er_word_ok
003097r 2  4C rr rr           JMP   @err
00309Ar 2               @er_word_ok:
00309Ar 2               
00309Ar 2                     ; Save name pointer
00309Ar 2  A5 rr              LDA   eval_val_lo
00309Cr 2  85 rr              STA   var_name_lo
00309Er 2  A5 rr              LDA   eval_val_hi
0030A0r 2  85 rr              STA   var_name_hi
0030A2r 2               
0030A2r 2                     ; Walk proc_head with prev tracking
0030A2r 2                     ; prev = address of "next" pointer to patch (starts as &proc_head)
0030A2r 2  A9 rr              LDA   #<proc_head_lo
0030A4r 2  85 rr              STA   proc_ptr_lo             ; prev_ptr_lo
0030A6r 2  A9 rr              LDA   #>proc_head_lo
0030A8r 2  85 rr              STA   proc_ptr_hi             ; prev_ptr_hi (ZP, so high byte = 0)
0030AAr 2               
0030AAr 2  A5 rr              LDA   proc_head_lo
0030ACr 2  85 rr              STA   proc_entry_lo
0030AEr 2  A5 rr              LDA   proc_head_hi
0030B0r 2  85 rr              STA   proc_entry_hi
0030B2r 2               
0030B2r 2               @walk:
0030B2r 2  A5 rr              LDA   proc_entry_lo
0030B4r 2  05 rr              ORA   proc_entry_hi
0030B6r 2  D0 03              BNE   @walk_ok
0030B8r 2  4C rr rr           JMP   @not_found
0030BBr 2               @walk_ok:
0030BBr 2               
0030BBr 2                     ; Compare name
0030BBr 2  A5 rr              LDA   var_name_lo
0030BDr 2  85 rr              STA   ptr_lo
0030BFr 2  A5 rr              LDA   var_name_hi
0030C1r 2  85 rr              STA   ptr_hi
0030C3r 2  A0 00              LDY   #0
0030C5r 2  B1 rr              LDA   (ptr_lo),Y             ; search name len
0030C7r 2  85 rr              STA   proc_name_len
0030C9r 2               
0030C9r 2  A5 rr              LDA   proc_entry_lo
0030CBr 2  85 rr              STA   ptr_lo
0030CDr 2  A5 rr              LDA   proc_entry_hi
0030CFr 2  85 rr              STA   ptr_hi
0030D1r 2  A0 02              LDY   #2
0030D3r 2  B1 rr              LDA   (ptr_lo),Y             ; record name len
0030D5r 2  C5 rr              CMP   proc_name_len
0030D7r 2  D0 32              BNE   @erase_next
0030D9r 2               
0030D9r 2  AA                 TAX
0030DAr 2  F0 4D              BEQ   @erase_match            ; both empty = match
0030DCr 2  A0 00              LDY   #0
0030DEr 2               @ecmp:
0030DEr 2  DA                 PHX
0030DFr 2  5A                 PHY
0030E0r 2  A5 rr              LDA   var_name_lo
0030E2r 2  85 rr              STA   ptr_lo
0030E4r 2  A5 rr              LDA   var_name_hi
0030E6r 2  85 rr              STA   ptr_hi
0030E8r 2  C8                 INY
0030E9r 2  B1 rr              LDA   (ptr_lo),Y             ; search char
0030EBr 2  85 rr              STA   proc_rec_off
0030EDr 2               
0030EDr 2  7A                 PLY
0030EEr 2  A5 rr              LDA   proc_entry_lo
0030F0r 2  85 rr              STA   ptr_lo
0030F2r 2  A5 rr              LDA   proc_entry_hi
0030F4r 2  85 rr              STA   ptr_hi
0030F6r 2  5A                 PHY
0030F7r 2  98                 TYA
0030F8r 2  18                 CLC
0030F9r 2  69 03              ADC   #3
0030FBr 2  A8                 TAY
0030FCr 2  B1 rr              LDA   (ptr_lo),Y             ; record char
0030FEr 2  7A                 PLY
0030FFr 2  C5 rr              CMP   proc_rec_off
003101r 2  D0 07              BNE   @ecmp_ne
003103r 2  FA                 PLX
003104r 2  C8                 INY
003105r 2  CA                 DEX
003106r 2  D0 D6              BNE   @ecmp
003108r 2  80 1F              BRA   @erase_match
00310Ar 2               
00310Ar 2               @ecmp_ne:
00310Ar 2  FA                 PLX
00310Br 2               
00310Br 2               @erase_next:
00310Br 2                     ; prev = &current->next (proc_entry + 0)
00310Br 2  A5 rr              LDA   proc_entry_lo
00310Dr 2  85 rr              STA   proc_ptr_lo
00310Fr 2  A5 rr              LDA   proc_entry_hi
003111r 2  85 rr              STA   proc_ptr_hi
003113r 2                     ; current = current->next
003113r 2  A5 rr              LDA   proc_entry_lo
003115r 2  85 rr              STA   ptr_lo
003117r 2  A5 rr              LDA   proc_entry_hi
003119r 2  85 rr              STA   ptr_hi
00311Br 2  A0 00              LDY   #0
00311Dr 2  B1 rr              LDA   (ptr_lo),Y
00311Fr 2  AA                 TAX
003120r 2  C8                 INY
003121r 2  B1 rr              LDA   (ptr_lo),Y
003123r 2  85 rr              STA   proc_entry_hi
003125r 2  86 rr              STX   proc_entry_lo
003127r 2  80 89              BRA   @walk
003129r 2               
003129r 2               @erase_match:
003129r 2                     ; Unlink: *prev = current->next
003129r 2                     ; Read current->next
003129r 2  A5 rr              LDA   proc_entry_lo
00312Br 2  85 rr              STA   ptr_lo
00312Dr 2  A5 rr              LDA   proc_entry_hi
00312Fr 2  85 rr              STA   ptr_hi
003131r 2  A0 00              LDY   #0
003133r 2  B1 rr              LDA   (ptr_lo),Y             ; next_lo
003135r 2  AA                 TAX
003136r 2  C8                 INY
003137r 2  B1 rr              LDA   (ptr_lo),Y             ; next_hi
003139r 2               
003139r 2                     ; Write to prev
003139r 2  A0 00              LDY   #0
00313Br 2  A5 rr              LDA   proc_ptr_lo
00313Dr 2  85 rr              STA   ptr_lo
00313Fr 2  A5 rr              LDA   proc_ptr_hi
003141r 2  85 rr              STA   ptr_hi
003143r 2  8A                 TXA
003144r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_lo = next_lo
003146r 2  C8                 INY
003147r 2  A5 rr              LDA   proc_entry_lo
003149r 2  85 rr              STA   ptr_lo
00314Br 2  A5 rr              LDA   proc_entry_hi
00314Dr 2  85 rr              STA   ptr_hi
00314Fr 2  A0 01              LDY   #1
003151r 2  B1 rr              LDA   (ptr_lo),Y             ; re-read next_hi
003153r 2  A0 01              LDY   #1
003155r 2  A5 rr              LDA   proc_ptr_lo
003157r 2  85 rr              STA   ptr_lo
003159r 2  A5 rr              LDA   proc_ptr_hi
00315Br 2  85 rr              STA   ptr_hi
00315Dr 2  A5 rr              LDA   proc_entry_lo
00315Fr 2  85 rr              STA   ptr2_lo
003161r 2  A5 rr              LDA   proc_entry_hi
003163r 2  85 rr              STA   ptr2_hi
003165r 2  A0 01              LDY   #1
003167r 2  B1 rr              LDA   (ptr2_lo),Y            ; next_hi
003169r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_hi = next_hi
00316Br 2               
00316Br 2  4C rr rr           JMP   eval_continue
00316Er 2               
00316Er 2               @not_found:
