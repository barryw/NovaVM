002FF2r 2  B1 rr              LDA   (ptr_lo),Y
002FF4r 2  85 rr              STA   proc_rec_off            ; temp: search char
002FF6r 2               
002FF6r 2                     ; Record char
002FF6r 2  7A                 PLY
002FF7r 2  A5 rr              LDA   proc_entry_lo
002FF9r 2  85 rr              STA   ptr_lo
002FFBr 2  A5 rr              LDA   proc_entry_hi
002FFDr 2  85 rr              STA   ptr_hi
002FFFr 2  5A                 PHY
003000r 2  98                 TYA
003001r 2  18                 CLC
003002r 2  69 03              ADC   #3                      ; record name starts at offset 3
003004r 2  A8                 TAY
003005r 2  B1 rr              LDA   (ptr_lo),Y
003007r 2  7A                 PLY
003008r 2  C5 rr              CMP   proc_rec_off
00300Ar 2  D0 07              BNE   @ne_pop
00300Cr 2  FA                 PLX
00300Dr 2  C8                 INY
00300Er 2  CA                 DEX
00300Fr 2  D0 D6              BNE   @cmp
003011r 2               
003011r 2               @found:
