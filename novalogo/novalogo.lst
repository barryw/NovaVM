0009DEr 1                     .include "vars.s"
0009DEr 2               ; vars.s — variable storage for NovaLogo (MAKE / :reference)
0009DEr 2               ;
0009DEr 2               ; Variables are stored as a linked list of heap entries.
0009DEr 2               ; Entry layout:
0009DEr 2               ;   +0: next_lo  (2 bytes — pointer to next entry, or $0000)
0009DEr 2               ;   +1: next_hi
0009DEr 2               ;   +2: name_len (1 byte)
0009DEr 2               ;   +3: name chars (name_len bytes, uppercased)
0009DEr 2               ;   +3+name_len: value_type (1 byte: $00=number, $01=word)
0009DEr 2               ;   +4+name_len: val_hi  (or ptr_lo for word)
0009DEr 2               ;   +5+name_len: val_lo  (or ptr_hi for word)
0009DEr 2               ;   +6+name_len: val_frac (0 for word)
0009DEr 2               ;   +7+name_len: pad     (0)
0009DEr 2               ;
0009DEr 2               ; Total entry size = 8 + name_len bytes.
0009DEr 2               
0009DEr 2               ; Entry field offsets (relative to entry base)
0009DEr 2               VAR_NEXT_LO  = 0
0009DEr 2               VAR_NEXT_HI  = 1
0009DEr 2               VAR_NAME_LEN = 2
0009DEr 2               VAR_NAME     = 3              ; first char of name
0009DEr 2               
0009DEr 2               ; =====================================================================
0009DEr 2               ; ZEROPAGE segment — variable list head + scratch
0009DEr 2               ; =====================================================================
0009DEr 2                     .segment "ZEROPAGE"
000036r 2               
000036r 2  xx           var_head_lo:    .res 1        ; head of variable linked list
000037r 2  xx           var_head_hi:    .res 1
000038r 2  xx           var_entry_lo:   .res 1        ; current entry pointer (walk scratch)
000039r 2  xx           var_entry_hi:   .res 1
00003Ar 2  xx           var_name_lo:    .res 1        ; saved name pointer for set/get
00003Br 2  xx           var_name_hi:    .res 1
00003Cr 2               
00003Cr 2               ; =====================================================================
00003Cr 2               ; CODE segment — variable routines
00003Cr 2               ; =====================================================================
00003Cr 2                     .segment "CODE"
00257Cr 2               
00257Cr 2               ; ---------------------------------------------------------------------
00257Cr 2               ; var_init — initialize variable list to empty
00257Cr 2               ;   Called once at cold_start
00257Cr 2               ; ---------------------------------------------------------------------
00257Cr 2               var_init:
00257Cr 2  64 rr              STZ   var_head_lo
00257Er 2  64 rr              STZ   var_head_hi
002580r 2  60                 RTS
002581r 2               
002581r 2               ; ---------------------------------------------------------------------
002581r 2               ; var_set — store a value under a variable name
002581r 2               ;   Input: ptr_lo/hi → length-prefixed name string (in token node)
002581r 2               ;          eval_type, eval_val_hi/lo/frac = value to store
002581r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, var_entry, var_name
002581r 2               ; ---------------------------------------------------------------------
002581r 2               var_set:
002581r 2                     ; Save name pointer — we need it after the walk
002581r 2  A5 rr              LDA   ptr_lo
002583r 2  85 rr              STA   var_name_lo
002585r 2  A5 rr              LDA   ptr_hi
002587r 2  85 rr              STA   var_name_hi
002589r 2               
002589r 2                     ; Walk the list looking for an existing entry with this name
002589r 2  A5 rr              LDA   var_head_lo
00258Br 2  85 rr              STA   var_entry_lo
00258Dr 2  A5 rr              LDA   var_head_hi
00258Fr 2  85 rr              STA   var_entry_hi
002591r 2               
002591r 2               @walk:
002591r 2                     ; End of list?
002591r 2  A5 rr              LDA   var_entry_lo
002593r 2  05 rr              ORA   var_entry_hi
002595r 2  F0 44              BEQ   @not_found
002597r 2               
002597r 2                     ; Compare name in entry against var_name
002597r 2  20 rr rr           JSR   var_names_equal
00259Ar 2  B0 16              BCS   @found
00259Cr 2               
00259Cr 2                     ; Advance to next entry
00259Cr 2  A5 rr              LDA   var_entry_lo
00259Er 2  85 rr              STA   ptr2_lo
0025A0r 2  A5 rr              LDA   var_entry_hi
0025A2r 2  85 rr              STA   ptr2_hi
0025A4r 2  A0 00              LDY   #VAR_NEXT_LO
0025A6r 2  B1 rr              LDA   (ptr2_lo),Y
0025A8r 2  AA                 TAX
0025A9r 2  C8                 INY
0025AAr 2  B1 rr              LDA   (ptr2_lo),Y
0025ACr 2  85 rr              STA   var_entry_hi
0025AEr 2  86 rr              STX   var_entry_lo
0025B0r 2  80 DF              BRA   @walk
0025B2r 2               
0025B2r 2               @found:
0025B2r 2                     ; Overwrite value in place
0025B2r 2                     ; Value starts at entry + 3 + name_len
0025B2r 2  A5 rr              LDA   var_entry_lo
0025B4r 2  85 rr              STA   ptr2_lo
0025B6r 2  A5 rr              LDA   var_entry_hi
0025B8r 2  85 rr              STA   ptr2_hi
0025BAr 2  A0 02              LDY   #VAR_NAME_LEN
0025BCr 2  B1 rr              LDA   (ptr2_lo),Y          ; name_len
0025BEr 2  18                 CLC
0025BFr 2  69 03              ADC   #VAR_NAME             ; A = 3 + name_len = offset to value_type
0025C1r 2  A8                 TAY
0025C2r 2  A5 rr              LDA   eval_type
0025C4r 2  91 rr              STA   (ptr2_lo),Y
0025C6r 2  C8                 INY
0025C7r 2  A5 rr              LDA   eval_val_hi
0025C9r 2  91 rr              STA   (ptr2_lo),Y
0025CBr 2  C8                 INY
0025CCr 2  A5 rr              LDA   eval_val_lo
0025CEr 2  91 rr              STA   (ptr2_lo),Y
0025D0r 2  C8                 INY
0025D1r 2  A5 rr              LDA   eval_val_frac
0025D3r 2  91 rr              STA   (ptr2_lo),Y
0025D5r 2  C8                 INY
0025D6r 2  A9 00              LDA   #0
0025D8r 2  91 rr              STA   (ptr2_lo),Y          ; pad
0025DAr 2  60                 RTS
0025DBr 2               
0025DBr 2               @not_found:
0025DBr 2                     ; Allocate a new entry: 8 + name_len bytes
0025DBr 2                     ; Read name_len from the name string
0025DBr 2  A5 rr              LDA   var_name_lo
0025DDr 2  85 rr              STA   ptr_lo
0025DFr 2  A5 rr              LDA   var_name_hi
0025E1r 2  85 rr              STA   ptr_hi
0025E3r 2  A0 00              LDY   #0
0025E5r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
0025E7r 2  48                 PHA                         ; save name_len
0025E8r 2  18                 CLC
0025E9r 2  69 08              ADC   #8                    ; total entry size
0025EBr 2  A2 03              LDX   #ATYPE_VAR
0025EDr 2  20 rr rr           JSR   heap_alloc
0025F0r 2  B0 62              BCS   @oom
0025F2r 2               
0025F2r 2                     ; ptr_lo/hi now points to new entry
0025F2r 2                     ; Set next → current head
0025F2r 2  A0 00              LDY   #VAR_NEXT_LO
0025F4r 2  A5 rr              LDA   var_head_lo
0025F6r 2  91 rr              STA   (ptr_lo),Y
0025F8r 2  C8                 INY
0025F9r 2  A5 rr              LDA   var_head_hi
0025FBr 2  91 rr              STA   (ptr_lo),Y
0025FDr 2               
0025FDr 2                     ; Copy name_len
0025FDr 2  68                 PLA                         ; A = name_len
0025FEr 2  48                 PHA                         ; keep it on stack
0025FFr 2  A0 02              LDY   #VAR_NAME_LEN
002601r 2  91 rr              STA   (ptr_lo),Y
002603r 2               
002603r 2                     ; Copy name chars (uppercased) from var_name source
002603r 2  68                 PLA                         ; A = name_len
002604r 2  AA                 TAX                         ; X = remaining chars
002605r 2  F0 2C              BEQ   @name_done            ; zero-length name (shouldn't happen)
002607r 2  A0 03              LDY   #VAR_NAME             ; dest offset in entry
002609r 2  9C rr rr           STZ   num_tmp_lo            ; source offset counter
00260Cr 2               
00260Cr 2               @copy_name:
00260Cr 2  DA                 PHX
00260Dr 2  5A                 PHY
00260Er 2                     ; Read source char
00260Er 2  A5 rr              LDA   var_name_lo
002610r 2  85 rr              STA   ptr2_lo
002612r 2  A5 rr              LDA   var_name_hi
002614r 2  85 rr              STA   ptr2_hi
002616r 2  AD rr rr           LDA   num_tmp_lo
002619r 2  1A                 INC                         ; skip length byte → offset = idx + 1
00261Ar 2  A8                 TAY
00261Br 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
00261Dr 2                     ; Uppercase
00261Dr 2  C9 61              CMP   #'a'
00261Fr 2  90 07              BCC   @noup
002621r 2  C9 7B              CMP   #'z'+1
002623r 2  B0 03              BCS   @noup
002625r 2  38                 SEC
002626r 2  E9 20              SBC   #$20
002628r 2               @noup:
002628r 2  7A                 PLY                         ; restore dest offset
002629r 2  91 rr              STA   (ptr_lo),Y           ; write to entry
00262Br 2  C8                 INY
00262Cr 2  EE rr rr           INC   num_tmp_lo
00262Fr 2  FA                 PLX
002630r 2  CA                 DEX
002631r 2  D0 D9              BNE   @copy_name
002633r 2               
002633r 2               @name_done:
002633r 2                     ; Write value after name
002633r 2                     ; Y is already at VAR_NAME + name_len = value_type offset
002633r 2  A5 rr              LDA   eval_type
002635r 2  91 rr              STA   (ptr_lo),Y
002637r 2  C8                 INY
002638r 2  A5 rr              LDA   eval_val_hi
00263Ar 2  91 rr              STA   (ptr_lo),Y
00263Cr 2  C8                 INY
00263Dr 2  A5 rr              LDA   eval_val_lo
00263Fr 2  91 rr              STA   (ptr_lo),Y
002641r 2  C8                 INY
002642r 2  A5 rr              LDA   eval_val_frac
002644r 2  91 rr              STA   (ptr_lo),Y
002646r 2  C8                 INY
002647r 2  A9 00              LDA   #0
002649r 2  91 rr              STA   (ptr_lo),Y           ; pad
00264Br 2               
00264Br 2                     ; Prepend to list: head = new entry
00264Br 2  A5 rr              LDA   ptr_lo
00264Dr 2  85 rr              STA   var_head_lo
00264Fr 2  A5 rr              LDA   ptr_hi
002651r 2  85 rr              STA   var_head_hi
002653r 2  60                 RTS
002654r 2               
002654r 2               @oom:
002654r 2  68                 PLA                         ; discard saved name_len
002655r 2  60                 RTS
002656r 2               
002656r 2               ; ---------------------------------------------------------------------
002656r 2               ; var_get — look up a variable by name
002656r 2               ;   Input: ptr_lo/hi → length-prefixed name string
002656r 2               ;   Output: Carry clear = found, eval_type/eval_val set
002656r 2               ;           Carry set = not found
002656r 2               ;   Clobbers: A, X, Y, ptr2, var_entry, var_name
002656r 2               ; ---------------------------------------------------------------------
002656r 2               var_get:
002656r 2                     ; Save name pointer
002656r 2  A5 rr              LDA   ptr_lo
002658r 2  85 rr              STA   var_name_lo
00265Ar 2  A5 rr              LDA   ptr_hi
00265Cr 2  85 rr              STA   var_name_hi
00265Er 2               
00265Er 2                     ; Walk the list
00265Er 2  A5 rr              LDA   var_head_lo
002660r 2  85 rr              STA   var_entry_lo
002662r 2  A5 rr              LDA   var_head_hi
002664r 2  85 rr              STA   var_entry_hi
002666r 2               
002666r 2               @walk:
002666r 2  A5 rr              LDA   var_entry_lo
002668r 2  05 rr              ORA   var_entry_hi
00266Ar 2  F0 40              BEQ   @not_found
00266Cr 2               
00266Cr 2  20 rr rr           JSR   var_names_equal
00266Fr 2  B0 16              BCS   @found
002671r 2               
002671r 2                     ; Advance to next
002671r 2  A5 rr              LDA   var_entry_lo
002673r 2  85 rr              STA   ptr2_lo
002675r 2  A5 rr              LDA   var_entry_hi
002677r 2  85 rr              STA   ptr2_hi
002679r 2  A0 00              LDY   #VAR_NEXT_LO
00267Br 2  B1 rr              LDA   (ptr2_lo),Y
00267Dr 2  AA                 TAX
00267Er 2  C8                 INY
00267Fr 2  B1 rr              LDA   (ptr2_lo),Y
002681r 2  85 rr              STA   var_entry_hi
002683r 2  86 rr              STX   var_entry_lo
002685r 2  80 DF              BRA   @walk
002687r 2               
002687r 2               @found:
002687r 2                     ; Read value from entry + 3 + name_len
002687r 2  A5 rr              LDA   var_entry_lo
002689r 2  85 rr              STA   ptr2_lo
00268Br 2  A5 rr              LDA   var_entry_hi
00268Dr 2  85 rr              STA   ptr2_hi
00268Fr 2  A0 02              LDY   #VAR_NAME_LEN
002691r 2  B1 rr              LDA   (ptr2_lo),Y
002693r 2  18                 CLC
002694r 2  69 03              ADC   #VAR_NAME
002696r 2  A8                 TAY
002697r 2  B1 rr              LDA   (ptr2_lo),Y          ; value_type
002699r 2  85 rr              STA   eval_type
00269Br 2  C8                 INY
00269Cr 2  B1 rr              LDA   (ptr2_lo),Y          ; val_hi
00269Er 2  85 rr              STA   eval_val_hi
0026A0r 2  C8                 INY
0026A1r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_lo
0026A3r 2  85 rr              STA   eval_val_lo
0026A5r 2  C8                 INY
0026A6r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_frac
0026A8r 2  85 rr              STA   eval_val_frac
0026AAr 2  18                 CLC
0026ABr 2  60                 RTS
0026ACr 2               
0026ACr 2               @not_found:
0026ACr 2  38                 SEC
0026ADr 2  60                 RTS
0026AEr 2               
0026AEr 2               ; ---------------------------------------------------------------------
0026AEr 2               ; var_names_equal — compare name at var_name_lo/hi against entry at var_entry
0026AEr 2               ;   The name source is length-prefixed (from token / quote).
0026AEr 2               ;   The entry stores: name_len at +2, chars at +3 (already uppercased).
0026AEr 2               ;   The source name chars are uppercased during comparison.
0026AEr 2               ;   Returns: Carry set = equal, Carry clear = not equal
0026AEr 2               ;   Clobbers: A, X, Y, ptr2
0026AEr 2               ; ---------------------------------------------------------------------
0026AEr 2               var_names_equal:
0026AEr 2                     ; Read source name length
0026AEr 2  A5 rr              LDA   var_name_lo
0026B0r 2  85 rr              STA   ptr2_lo
0026B2r 2  A5 rr              LDA   var_name_hi
0026B4r 2  85 rr              STA   ptr2_hi
0026B6r 2  A0 00              LDY   #0
0026B8r 2  B1 rr              LDA   (ptr2_lo),Y          ; source name_len
0026BAr 2  AA                 TAX                         ; X = source name_len
0026BBr 2               
0026BBr 2                     ; Read entry name length
0026BBr 2  A5 rr              LDA   var_entry_lo
0026BDr 2  85 rr              STA   ptr2_lo
0026BFr 2  A5 rr              LDA   var_entry_hi
0026C1r 2  85 rr              STA   ptr2_hi
0026C3r 2  A0 02              LDY   #VAR_NAME_LEN
0026C5r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry name_len
0026C7r 2               
0026C7r 2                     ; Compare lengths
0026C7r 2  8E rr rr           STX   num_tmp_lo            ; save source length
0026CAr 2  CD rr rr           CMP   num_tmp_lo
0026CDr 2  D0 43              BNE   @ne
0026CFr 2               
0026CFr 2                     ; Lengths match — compare chars
0026CFr 2  E0 00              CPX   #0
0026D1r 2  F0 3B              BEQ   @eq                   ; both zero-length — equal
0026D3r 2  A0 00              LDY   #0                    ; char index
0026D5r 2               
0026D5r 2               @cmp_loop:
0026D5r 2  DA                 PHX
0026D6r 2  5A                 PHY
0026D7r 2                     ; Read source char (var_name + 1 + Y)
0026D7r 2  A5 rr              LDA   var_name_lo
0026D9r 2  85 rr              STA   ptr2_lo
0026DBr 2  A5 rr              LDA   var_name_hi
0026DDr 2  85 rr              STA   ptr2_hi
0026DFr 2  98                 TYA
0026E0r 2  1A                 INC                         ; skip length byte
0026E1r 2  A8                 TAY
0026E2r 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
0026E4r 2                     ; Uppercase it
0026E4r 2  C9 61              CMP   #'a'
0026E6r 2  90 07              BCC   @noup
0026E8r 2  C9 7B              CMP   #'z'+1
0026EAr 2  B0 03              BCS   @noup
0026ECr 2  38                 SEC
0026EDr 2  E9 20              SBC   #$20
0026EFr 2               @noup:
0026EFr 2  8D rr rr           STA   num_tmp_hi            ; temp: uppercased source char
0026F2r 2               
0026F2r 2                     ; Read entry char (var_entry + VAR_NAME + Y)
0026F2r 2  7A                 PLY                         ; restore char index
0026F3r 2  5A                 PHY
0026F4r 2  A5 rr              LDA   var_entry_lo
0026F6r 2  85 rr              STA   ptr2_lo
0026F8r 2  A5 rr              LDA   var_entry_hi
0026FAr 2  85 rr              STA   ptr2_hi
0026FCr 2  98                 TYA
0026FDr 2  18                 CLC
0026FEr 2  69 03              ADC   #VAR_NAME
002700r 2  A8                 TAY
002701r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry char (already uppercase)
002703r 2               
002703r 2  CD rr rr           CMP   num_tmp_hi
002706r 2                     ; 65C02: PLY/PLX clobber flags! Must branch BEFORE pulling.
002706r 2  D0 08              BNE   @ne_pull
002708r 2               
002708r 2  7A                 PLY
002709r 2  FA                 PLX
00270Ar 2  C8                 INY
00270Br 2  CA                 DEX
00270Cr 2  D0 C7              BNE   @cmp_loop
00270Er 2               
00270Er 2               @eq:
00270Er 2  38                 SEC                         ; equal
00270Fr 2  60                 RTS
002710r 2               
002710r 2               @ne_pull:
002710r 2  7A                 PLY                         ; clean up stack
002711r 2  FA                 PLX
002712r 2               @ne:
002712r 2  18                 CLC                         ; not equal
002713r 2  60                 RTS
002714r 2               
002714r 1                     .include "procedures.s"
002714r 2               ; procedures.s — user-defined procedure storage and invocation
002714r 2               ;
002714r 2               ; Procedure record layout (heap-allocated linked list):
002714r 2               ;   +0: next_lo
002714r 2               ;   +1: next_hi    (pointer to next procedure, or $0000)
002714r 2               ;   +2: name_len   (1 byte)
002714r 2               ;   +3..3+NL-1: name chars (uppercased)
002714r 2               ;   +3+NL: param_count (1 byte)
002714r 2               ;   For each param:
002714r 2               ;     1 byte: param_name_len
002714r 2               ;     N bytes: param_name chars (uppercased)
002714r 2               ;   After all params:
002714r 2               ;     2 bytes: body_len_lo, body_len_hi (16-bit)
002714r 2               ;     body_len bytes: body text (lines separated by $0A)
002714r 2               
002714r 2               ; =====================================================================
002714r 2               ; ZEROPAGE segment — procedure variables
002714r 2               ; =====================================================================
002714r 2                     .segment "ZEROPAGE"
00003Cr 2               
00003Cr 2  xx           proc_head_lo:     .res 1        ; head of procedure directory
00003Dr 2  xx           proc_head_hi:     .res 1
00003Er 2  xx           proc_entry_lo:    .res 1        ; current entry pointer (walk scratch)
00003Fr 2  xx           proc_entry_hi:    .res 1
000040r 2  xx           proc_ptr_lo:      .res 1        ; scratch pointer for proc operations
000041r 2  xx           proc_ptr_hi:      .res 1
000042r 2  xx           proc_body_len_lo: .res 1        ; body length during collection / invocation
000043r 2  xx           proc_body_len_hi: .res 1
000044r 2  xx           proc_param_cnt:   .res 1        ; param count during define / invoke
000045r 2  xx           proc_name_len:    .res 1        ; name length scratch
000046r 2  xx           proc_rec_off:     .res 1        ; offset into record during invoke
000047r 2               
000047r 2               ; =====================================================================
000047r 2               ; BSS segment — temporary buffers
000047r 2               ; =====================================================================
000047r 2                     .segment "BSS"
00000Fr 2               
00000Fr 2  xx xx xx xx  proc_body_buf:    .res 2048     ; temporary buffer for body during TO/END
000013r 2  xx xx xx xx  
000017r 2  xx xx xx xx  
00080Fr 2  xx xx xx xx  proc_name_buf:    .res 32       ; procedure name: length-prefixed
000813r 2  xx xx xx xx  
000817r 2  xx xx xx xx  
00082Fr 2  xx xx xx xx  proc_param_buf:   .res 128      ; packed: count, [len,chars]... each param
000833r 2  xx xx xx xx  
000837r 2  xx xx xx xx  
0008AFr 2  xx           proc_param_end:   .res 1        ; write offset into proc_param_buf
0008B0r 2               
0008B0r 2               ; Save area for eval state during procedure invocation
0008B0r 2  xx           save_eval_cur_lo: .res 1
0008B1r 2  xx           save_eval_cur_hi: .res 1
0008B2r 2  xx           save_tok_head_lo: .res 1
0008B3r 2  xx           save_tok_head_hi: .res 1
0008B4r 2  xx           save_tok_tail_lo: .res 1
0008B5r 2  xx           save_tok_tail_hi: .res 1
0008B6r 2  xx xx xx xx  save_input_buf:   .res 128      ; save outer input_buf during proc body exec
0008BAr 2  xx xx xx xx  
0008BEr 2  xx xx xx xx  
000936r 2  xx           save_heap_ptr_lo: .res 1        ; save heap for token re-use
000937r 2  xx           save_heap_ptr_hi: .res 1
000938r 2               
000938r 2               ; Param-binding scratch: length-prefixed name built here for var_set
000938r 2  xx xx xx xx  param_name_tmp:   .res 32
00093Cr 2  xx xx xx xx  
000940r 2  xx xx xx xx  
000958r 2               
000958r 2               ; =====================================================================
000958r 2               ; CODE segment — procedure routines
000958r 2               ; =====================================================================
000958r 2                     .segment "CODE"
002714r 2               
002714r 2               ; ---------------------------------------------------------------------
002714r 2               ; proc_init — initialize procedure directory to empty
002714r 2               ; ---------------------------------------------------------------------
002714r 2               proc_init:
002714r 2  64 rr              STZ   proc_head_lo
002716r 2  64 rr              STZ   proc_head_hi
002718r 2  64 rr              STZ   proc_stopped
00271Ar 2  60                 RTS
00271Br 2               
00271Br 2               ; ---------------------------------------------------------------------
00271Br 2               ; proc_collect — enter TO/END multi-line collection mode
00271Br 2               ;   Called from main_loop after detecting TO as first token.
00271Br 2               ;   eval_cur_lo/hi has been advanced past the TO token.
00271Br 2               ; ---------------------------------------------------------------------
00271Br 2               proc_collect:
00271Br 2                     ; Next token should be the procedure name (TOK_WORD)
00271Br 2  A5 rr              LDA   eval_cur_lo
00271Dr 2  05 rr              ORA   eval_cur_hi
00271Fr 2  D0 03              BNE   @have_name
002721r 2  4C rr rr           JMP   @err_noname
002724r 2               @have_name:
002724r 2  A5 rr              LDA   eval_cur_lo
002726r 2  85 rr              STA   ptr_lo
002728r 2  A5 rr              LDA   eval_cur_hi
00272Ar 2  85 rr              STA   ptr_hi
00272Cr 2  A0 00              LDY   #TOK_TAG
00272Er 2  B1 rr              LDA   (ptr_lo),Y
002730r 2  C9 01              CMP   #TOK_WORD
002732r 2  F0 03              BEQ   @name_ok
002734r 2  4C rr rr           JMP   @err_noname
002737r 2               @name_ok:
002737r 2                     ; Copy procedure name to proc_name_buf (length-prefixed)
002737r 2  A0 03              LDY   #TOK_PAYLOAD
002739r 2  B1 rr              LDA   (ptr_lo),Y           ; name length
00273Br 2  8D rr rr           STA   proc_name_buf
00273Er 2  85 rr              STA   proc_name_len
002740r 2  AA                 TAX                         ; X = char count
002741r 2  A0 04              LDY   #TOK_PAYLOAD+1
002743r 2  A9 00              LDA   #0
002745r 2  85 rr              STA   proc_rec_off          ; dest index in name_buf
002747r 2               @copy_name:
002747r 2  E0 00              CPX   #0
002749r 2  F0 0F              BEQ   @name_copied
00274Br 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased by tokenizer
00274Dr 2  5A                 PHY
00274Er 2  A4 rr              LDY   proc_rec_off
002750r 2  99 rr rr           STA   proc_name_buf+1,Y
002753r 2  E6 rr              INC   proc_rec_off
002755r 2  7A                 PLY
002756r 2  C8                 INY
002757r 2  CA                 DEX
002758r 2  80 ED              BRA   @copy_name
00275Ar 2               @name_copied:
00275Ar 2               
00275Ar 2                     ; Advance past the name token
00275Ar 2  20 rr rr           JSR   eval_advance
00275Dr 2               
00275Dr 2                     ; Parse parameter names (TOK_VARREF tokens: :SIZE :COLOR etc.)
00275Dr 2  64 rr              STZ   proc_param_cnt
00275Fr 2  A9 01              LDA   #1                    ; dest offset (skip count byte at [0])
002761r 2  8D rr rr           STA   proc_param_end
002764r 2               
002764r 2               @parse_params:
002764r 2  A5 rr              LDA   eval_cur_lo
002766r 2  05 rr              ORA   eval_cur_hi
002768r 2  F0 47              BEQ   @params_done
00276Ar 2  A5 rr              LDA   eval_cur_lo
00276Cr 2  85 rr              STA   ptr_lo
00276Er 2  A5 rr              LDA   eval_cur_hi
002770r 2  85 rr              STA   ptr_hi
002772r 2  A0 00              LDY   #TOK_TAG
002774r 2  B1 rr              LDA   (ptr_lo),Y
002776r 2  C9 05              CMP   #TOK_VARREF
002778r 2  D0 37              BNE   @params_done
00277Ar 2               
00277Ar 2  E6 rr              INC   proc_param_cnt
00277Cr 2  A0 03              LDY   #TOK_PAYLOAD
00277Er 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002780r 2  AE rr rr           LDX   proc_param_end
002783r 2  9D rr rr           STA   proc_param_buf,X     ; store length
002786r 2  E8                 INX
002787r 2  A8                 TAY                         ; Y = char count to copy
002788r 2  64 rr              STZ   proc_rec_off          ; source char index
00278Ar 2               
00278Ar 2               @copy_param_ch:
00278Ar 2  C0 00              CPY   #0
00278Cr 2  F0 1B              BEQ   @param_ch_done
00278Er 2                     ; Read source char from token
00278Er 2  A5 rr              LDA   eval_cur_lo
002790r 2  85 rr              STA   ptr_lo
002792r 2  A5 rr              LDA   eval_cur_hi
002794r 2  85 rr              STA   ptr_hi
002796r 2  5A                 PHY
002797r 2  A5 rr              LDA   proc_rec_off
002799r 2  18                 CLC
00279Ar 2  69 04              ADC   #TOK_PAYLOAD+1
00279Cr 2  A8                 TAY
00279Dr 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased
00279Fr 2  7A                 PLY
0027A0r 2                     ; Write to proc_param_buf
0027A0r 2  9D rr rr           STA   proc_param_buf,X
0027A3r 2  E8                 INX
0027A4r 2  E6 rr              INC   proc_rec_off
0027A6r 2  88                 DEY
0027A7r 2  80 E1              BRA   @copy_param_ch
0027A9r 2               @param_ch_done:
0027A9r 2  8E rr rr           STX   proc_param_end
0027ACr 2               
0027ACr 2  20 rr rr           JSR   eval_advance
0027AFr 2  80 B3              BRA   @parse_params
0027B1r 2               
0027B1r 2               @params_done:
0027B1r 2  A5 rr              LDA   proc_param_cnt
0027B3r 2  8D rr rr           STA   proc_param_buf        ; count byte at [0]
0027B6r 2               
0027B6r 2                     ; Initialize body buffer
0027B6r 2  64 rr              STZ   proc_body_len_lo
0027B8r 2  64 rr              STZ   proc_body_len_hi
0027BAr 2               
0027BAr 2                     ; Read body lines until END
0027BAr 2               @read_body_line:
0027BAr 2  20 rr rr           JSR   print_cont_prompt
0027BDr 2  20 rr rr           JSR   read_line
0027C0r 2               
0027C0r 2                     ; Check if line is just "END"
0027C0r 2  20 rr rr           JSR   check_end_line
0027C3r 2  B0 40              BCS   @body_done
0027C5r 2               
0027C5r 2                     ; Append input_buf chars to proc_body_buf, then $0A
0027C5r 2  A2 00              LDX   #0
0027C7r 2               @copy_body_ch:
0027C7r 2  E4 rr              CPX   z:buf_idx
0027C9r 2  B0 1F              BCS   @append_nl
0027CBr 2               
0027CBr 2                     ; Compute dest address: proc_body_buf + body_len
0027CBr 2  DA                 PHX
0027CCr 2  18                 CLC
0027CDr 2  A5 rr              LDA   proc_body_len_lo
0027CFr 2  69 rr              ADC   #<proc_body_buf
0027D1r 2  85 rr              STA   proc_ptr_lo
0027D3r 2  A5 rr              LDA   proc_body_len_hi
0027D5r 2  69 rr              ADC   #>proc_body_buf
0027D7r 2  85 rr              STA   proc_ptr_hi
0027D9r 2  FA                 PLX
0027DAr 2               
0027DAr 2  BD rr rr           LDA   input_buf,X
0027DDr 2  A0 00              LDY   #0
0027DFr 2  91 rr              STA   (proc_ptr_lo),Y
0027E1r 2               
0027E1r 2  E6 rr              INC   proc_body_len_lo
0027E3r 2  D0 02              BNE   :+
0027E5r 2  E6 rr              INC   proc_body_len_hi
0027E7r 2  E8           :     INX
0027E8r 2  80 DD              BRA   @copy_body_ch
0027EAr 2               
0027EAr 2               @append_nl:
0027EAr 2                     ; Add $0A separator
0027EAr 2  18                 CLC
0027EBr 2  A5 rr              LDA   proc_body_len_lo
0027EDr 2  69 rr              ADC   #<proc_body_buf
0027EFr 2  85 rr              STA   proc_ptr_lo
0027F1r 2  A5 rr              LDA   proc_body_len_hi
0027F3r 2  69 rr              ADC   #>proc_body_buf
0027F5r 2  85 rr              STA   proc_ptr_hi
0027F7r 2  A9 0A              LDA   #$0A
0027F9r 2  A0 00              LDY   #0
0027FBr 2  91 rr              STA   (proc_ptr_lo),Y
0027FDr 2  E6 rr              INC   proc_body_len_lo
0027FFr 2  D0 02              BNE   :+
002801r 2  E6 rr              INC   proc_body_len_hi
002803r 2  80 B5        :     BRA   @read_body_line
002805r 2               
002805r 2               @body_done:
002805r 2                     ; Build the heap record
002805r 2  20 rr rr           JSR   proc_build_record
002808r 2               
002808r 2                     ; Print "NAME DEFINED\n"
002808r 2  A6 rr              LDX   proc_name_len
00280Ar 2  A0 00              LDY   #0
00280Cr 2               @print_name:
00280Cr 2  E0 00              CPX   #0
00280Er 2  F0 0A              BEQ   @print_def
002810r 2  B9 rr rr           LDA   proc_name_buf+1,Y
002813r 2  8D 0E A0           STA   VGC_CHAROUT
002816r 2  C8                 INY
002817r 2  CA                 DEX
002818r 2  80 F2              BRA   @print_name
00281Ar 2               @print_def:
00281Ar 2  A2 00              LDX   #0
00281Cr 2               @pd_lp:
00281Cr 2  BD rr rr           LDA   str_defined,X
00281Fr 2  F0 06              BEQ   @pd_done
002821r 2  8D 0E A0           STA   VGC_CHAROUT
002824r 2  E8                 INX
002825r 2  D0 F5              BNE   @pd_lp
002827r 2               @pd_done:
002827r 2  20 rr rr           JSR   eval_newline
00282Ar 2  60                 RTS
00282Br 2               
00282Br 2               @err_noname:
00282Br 2  A2 00              LDX   #0
00282Dr 2               @en_lp:
00282Dr 2  BD rr rr           LDA   str_to_needs_name,X
002830r 2  F0 06              BEQ   @en_done
002832r 2  8D 0E A0           STA   VGC_CHAROUT
002835r 2  E8                 INX
002836r 2  D0 F5              BNE   @en_lp
002838r 2               @en_done:
002838r 2  20 rr rr           JSR   eval_newline
00283Br 2  60                 RTS
00283Cr 2               
00283Cr 2               ; ---------------------------------------------------------------------
00283Cr 2               ; check_end_line — check if input_buf == "END" (case-insensitive)
00283Cr 2               ;   Returns: carry set = yes, carry clear = no
00283Cr 2               ; ---------------------------------------------------------------------
00283Cr 2               check_end_line:
00283Cr 2  A5 rr              LDA   z:buf_idx
00283Er 2  C9 03              CMP   #3
002840r 2  D0 1D              BNE   @no
002842r 2  AD rr rr           LDA   input_buf
002845r 2  29 DF              AND   #$DF
002847r 2  C9 45              CMP   #'E'
002849r 2  D0 14              BNE   @no
00284Br 2  AD rr rr           LDA   input_buf+1
00284Er 2  29 DF              AND   #$DF
002850r 2  C9 4E              CMP   #'N'
002852r 2  D0 0B              BNE   @no
002854r 2  AD rr rr           LDA   input_buf+2
002857r 2  29 DF              AND   #$DF
002859r 2  C9 44              CMP   #'D'
00285Br 2  D0 02              BNE   @no
00285Dr 2  38                 SEC
00285Er 2  60                 RTS
00285Fr 2               @no:
00285Fr 2  18                 CLC
002860r 2  60                 RTS
002861r 2               
002861r 2               ; ---------------------------------------------------------------------
002861r 2               ; print_cont_prompt — print "> "
002861r 2               ; ---------------------------------------------------------------------
002861r 2               print_cont_prompt:
002861r 2  A9 3E              LDA   #'>'
002863r 2  8D 0E A0           STA   VGC_CHAROUT
002866r 2  A9 20              LDA   #' '
002868r 2  8D 0E A0           STA   VGC_CHAROUT
00286Br 2  60                 RTS
00286Cr 2               
00286Cr 2               ; ---------------------------------------------------------------------
00286Cr 2               ; heap_alloc_big — allocate for procedure records (16-bit payload)
00286Cr 2               ;   Input:  proc_ptr_lo/hi = record data size (16-bit)
00286Cr 2               ;   Output: proc_entry_lo/hi = pointer to record data (payload+2)
00286Cr 2               ;           Carry clear = success, Carry set = OOM
00286Cr 2               ;
00286Cr 2               ;   Layout: [GC_HDR_TAG, GC_HDR_SIZE=0, total_lo, total_hi, ...data...]
00286Cr 2               ;   GC header (2 bytes) + 16-bit size (2 bytes) + record data.
00286Cr 2               ;   Total allocation = record_data_size + 4.
00286Cr 2               ;   GC_HDR_SIZE = 0 tells GC to read 16-bit total from payload[0..1].
00286Cr 2               ;   proc_entry points to data (base+4).
00286Cr 2               ;
00286Cr 2               ;   Clobbers: A, Y, ptr_lo/hi
00286Cr 2               ; ---------------------------------------------------------------------
00286Cr 2               heap_alloc_big:
00286Cr 2                     ; Total allocation = data_size + 4 (2 hdr + 2 size field)
00286Cr 2  18                 CLC
00286Dr 2  A5 rr              LDA   proc_ptr_lo
00286Fr 2  69 04              ADC   #4
002871r 2  48                 PHA                        ; save total_lo
002872r 2  A5 rr              LDA   proc_ptr_hi
002874r 2  69 00              ADC   #0
002876r 2  48                 PHA                        ; save total_hi
002877r 2               
002877r 2                     ; Save current heap_ptr as base
002877r 2  A5 rr              LDA   heap_ptr
002879r 2  85 rr              STA   proc_entry_lo
00287Br 2  A5 rr              LDA   heap_ptr+1
00287Dr 2  85 rr              STA   proc_entry_hi
00287Fr 2               
00287Fr 2                     ; Advance heap_ptr by total
00287Fr 2  BA                 TSX
002880r 2  18                 CLC
002881r 2  A5 rr              LDA   heap_ptr
002883r 2  7D 02 01           ADC   $0102,X              ; total_lo
002886r 2  85 rr              STA   heap_ptr
002888r 2  A5 rr              LDA   heap_ptr+1
00288Ar 2  7D 01 01           ADC   $0101,X              ; total_hi
00288Dr 2  85 rr              STA   heap_ptr+1
00288Fr 2               
00288Fr 2                     ; OOM check
00288Fr 2  C9 9C              CMP   #>HEAP_END
002891r 2  90 16              BCC   @big_ok
002893r 2  D0 08              BNE   @big_oom
002895r 2  A5 rr              LDA   heap_ptr
002897r 2  C9 00              CMP   #<HEAP_END
002899r 2  90 0E              BCC   @big_ok
00289Br 2  F0 0C              BEQ   @big_ok
00289Dr 2               @big_oom:
00289Dr 2  A5 rr              LDA   proc_entry_lo
00289Fr 2  85 rr              STA   heap_ptr
0028A1r 2  A5 rr              LDA   proc_entry_hi
0028A3r 2  85 rr              STA   heap_ptr+1
0028A5r 2  68                 PLA
0028A6r 2  68                 PLA
0028A7r 2  38                 SEC
0028A8r 2  60                 RTS
0028A9r 2               @big_ok:
0028A9r 2                     ; Write header at base (proc_entry = base here)
0028A9r 2  A5 rr              LDA   proc_entry_lo
0028ABr 2  85 rr              STA   ptr_lo
0028ADr 2  A5 rr              LDA   proc_entry_hi
0028AFr 2  85 rr              STA   ptr_hi
0028B1r 2               
0028B1r 2  A0 00              LDY   #GC_HDR_TAG
0028B3r 2  A9 04              LDA   #ATYPE_PROC
0028B5r 2  91 rr              STA   (ptr_lo),Y
0028B7r 2               
0028B7r 2  A0 01              LDY   #GC_HDR_SIZE
0028B9r 2  A9 00              LDA   #0                    ; 0 = 16-bit size at payload[0..1]
0028BBr 2  91 rr              STA   (ptr_lo),Y
0028BDr 2               
0028BDr 2                     ; Write 16-bit total at payload offsets 0,1 (base+2, base+3)
0028BDr 2  68                 PLA                        ; total_hi
0028BEr 2  A0 03              LDY   #GC_HDR_BYTES+1       ; base+3
0028C0r 2  91 rr              STA   (ptr_lo),Y
0028C2r 2  68                 PLA                        ; total_lo
0028C3r 2  A0 02              LDY   #GC_HDR_BYTES         ; base+2
0028C5r 2  91 rr              STA   (ptr_lo),Y
0028C7r 2               
0028C7r 2                     ; Advance proc_entry to point past header+size field = base+4
0028C7r 2                     ; This is where the record data starts
0028C7r 2  18                 CLC
0028C8r 2  A5 rr              LDA   proc_entry_lo
0028CAr 2  69 04              ADC   #4
0028CCr 2  85 rr              STA   proc_entry_lo
0028CEr 2  A5 rr              LDA   proc_entry_hi
0028D0r 2  69 00              ADC   #0
0028D2r 2  85 rr              STA   proc_entry_hi
0028D4r 2               
0028D4r 2  18                 CLC
0028D5r 2  60                 RTS
0028D6r 2               
0028D6r 2               ; ---------------------------------------------------------------------
0028D6r 2               ; proc_build_record — allocate and populate a procedure heap record
0028D6r 2               ;   Uses: proc_name_buf, proc_param_buf/proc_param_end,
0028D6r 2               ;         proc_body_buf/proc_body_len
0028D6r 2               ; ---------------------------------------------------------------------
0028D6r 2               proc_build_record:
0028D6r 2                     ; Calculate total record size
0028D6r 2                     ; 2 (next) + 1 (name_len) + name_len
0028D6r 2                     ; + 1 (param_count) + (proc_param_end - 1) param packed bytes
0028D6r 2                     ; + 2 (body_len) + body_len
0028D6r 2                     ;
0028D6r 2                     ; We build the total in proc_ptr_lo:proc_ptr_hi (16-bit)
0028D6r 2               
0028D6r 2  A9 04              LDA   #4                    ; 2(next) + 1(name_len) + 1(param_count)
0028D8r 2  18                 CLC
0028D9r 2  6D rr rr           ADC   proc_name_buf         ; + name_len
0028DCr 2  85 rr              STA   proc_ptr_lo
0028DEr 2  A9 00              LDA   #0
0028E0r 2  85 rr              STA   proc_ptr_hi
0028E2r 2               
0028E2r 2                     ; + param packed bytes (proc_param_end - 1)
0028E2r 2  AD rr rr           LDA   proc_param_end
0028E5r 2  38                 SEC
0028E6r 2  E9 01              SBC   #1
0028E8r 2  18                 CLC
0028E9r 2  65 rr              ADC   proc_ptr_lo
0028EBr 2  85 rr              STA   proc_ptr_lo
0028EDr 2  90 02              BCC   :+
0028EFr 2  E6 rr              INC   proc_ptr_hi
0028F1r 2               :
0028F1r 2                     ; + 2 (body_len field)
0028F1r 2  18                 CLC
0028F2r 2  A5 rr              LDA   proc_ptr_lo
0028F4r 2  69 02              ADC   #2
0028F6r 2  85 rr              STA   proc_ptr_lo
0028F8r 2  90 02              BCC   :+
0028FAr 2  E6 rr              INC   proc_ptr_hi
0028FCr 2               :
0028FCr 2                     ; + body_len
0028FCr 2  18                 CLC
0028FDr 2  A5 rr              LDA   proc_ptr_lo
0028FFr 2  65 rr              ADC   proc_body_len_lo
002901r 2  85 rr              STA   proc_ptr_lo
002903r 2  A5 rr              LDA   proc_ptr_hi
002905r 2  65 rr              ADC   proc_body_len_hi
002907r 2  85 rr              STA   proc_ptr_hi
002909r 2               
002909r 2                     ; Allocate with GC header (16-bit size via heap_alloc_big)
002909r 2                     ; proc_ptr_lo/hi = payload size
002909r 2  20 rr rr           JSR   heap_alloc_big
00290Cr 2  90 01              BCC   @ok
00290Er 2  60                 RTS                        ; OOM
00290Fr 2               @ok:
00290Fr 2                     ; Fill the record using (ptr_lo),Y indirect addressing
00290Fr 2                     ; We track Y as the write offset. For records > 256 bytes
00290Fr 2                     ; we bump ptr_hi when Y wraps.
00290Fr 2  A5 rr              LDA   proc_entry_lo
002911r 2  85 rr              STA   ptr_lo
002913r 2  A5 rr              LDA   proc_entry_hi
002915r 2  85 rr              STA   ptr_hi
002917r 2               
002917r 2                     ; +0,+1: next pointer = current proc_head
002917r 2  A0 00              LDY   #0
002919r 2  A5 rr              LDA   proc_head_lo
00291Br 2  91 rr              STA   (ptr_lo),Y
00291Dr 2  C8                 INY
00291Er 2  A5 rr              LDA   proc_head_hi
002920r 2  91 rr              STA   (ptr_lo),Y
002922r 2               
002922r 2                     ; +2: name_len
002922r 2  C8                 INY
002923r 2  AD rr rr           LDA   proc_name_buf
002926r 2  91 rr              STA   (ptr_lo),Y
002928r 2               
002928r 2                     ; +3..+3+NL-1: name chars
002928r 2  AE rr rr           LDX   proc_name_buf         ; X = char count
00292Br 2  64 rr              STZ   proc_rec_off          ; source index
00292Dr 2               @bld_name:
00292Dr 2  E0 00              CPX   #0
00292Fr 2  F0 13              BEQ   @bld_name_done
002931r 2  C8                 INY
002932r 2  D0 02              BNE   :+
002934r 2  E6 rr              INC   ptr_hi
002936r 2  DA           :     PHX
002937r 2  A6 rr              LDX   proc_rec_off
002939r 2  BD rr rr           LDA   proc_name_buf+1,X
00293Cr 2  FA                 PLX
00293Dr 2  91 rr              STA   (ptr_lo),Y
00293Fr 2  E6 rr              INC   proc_rec_off
002941r 2  CA                 DEX
002942r 2  80 E9              BRA   @bld_name
002944r 2               @bld_name_done:
002944r 2               
002944r 2                     ; +3+NL: param_count
002944r 2  C8                 INY
002945r 2  D0 02              BNE   :+
002947r 2  E6 rr              INC   ptr_hi
002949r 2  A5 rr        :     LDA   proc_param_cnt
00294Br 2  91 rr              STA   (ptr_lo),Y
00294Dr 2               
00294Dr 2                     ; Copy packed param data from proc_param_buf[1..proc_param_end-1]
00294Dr 2  AD rr rr           LDA   proc_param_end
002950r 2  C9 02              CMP   #2                    ; at least 1 = there are params
002952r 2  90 14              BCC   @bld_params_done
002954r 2  A2 01              LDX   #1                    ; source index (skip count byte)
002956r 2               @bld_param:
002956r 2  EC rr rr           CPX   proc_param_end
002959r 2  B0 0D              BCS   @bld_params_done
00295Br 2  C8                 INY
00295Cr 2  D0 02              BNE   :+
00295Er 2  E6 rr              INC   ptr_hi
002960r 2  BD rr rr     :     LDA   proc_param_buf,X
002963r 2  91 rr              STA   (ptr_lo),Y
002965r 2  E8                 INX
002966r 2  80 EE              BRA   @bld_param
002968r 2               @bld_params_done:
002968r 2               
002968r 2                     ; body_len_lo, body_len_hi
002968r 2  C8                 INY
002969r 2  D0 02              BNE   :+
00296Br 2  E6 rr              INC   ptr_hi
00296Dr 2  A5 rr        :     LDA   proc_body_len_lo
00296Fr 2  91 rr              STA   (ptr_lo),Y
002971r 2  C8                 INY
002972r 2  D0 02              BNE   :+
002974r 2  E6 rr              INC   ptr_hi
002976r 2  A5 rr        :     LDA   proc_body_len_hi
002978r 2  91 rr              STA   (ptr_lo),Y
00297Ar 2               
00297Ar 2                     ; Copy body text
00297Ar 2  A5 rr              LDA   proc_body_len_lo
00297Cr 2  05 rr              ORA   proc_body_len_hi
00297Er 2  F0 38              BEQ   @bld_body_done
002980r 2               
002980r 2  A9 rr              LDA   #<proc_body_buf
002982r 2  85 rr              STA   proc_ptr_lo
002984r 2  A9 rr              LDA   #>proc_body_buf
002986r 2  85 rr              STA   proc_ptr_hi
002988r 2                     ; 16-bit counter
002988r 2  A5 rr              LDA   proc_body_len_lo
00298Ar 2  8D rr rr           STA   num_tmp_lo
00298Dr 2  A5 rr              LDA   proc_body_len_hi
00298Fr 2  8D rr rr           STA   num_tmp_hi
002992r 2               
002992r 2               @bld_body:
002992r 2  C8                 INY
002993r 2  D0 02              BNE   :+
002995r 2  E6 rr              INC   ptr_hi
002997r 2  5A           :     PHY
002998r 2  A0 00              LDY   #0
00299Ar 2  B1 rr              LDA   (proc_ptr_lo),Y
00299Cr 2  7A                 PLY
00299Dr 2  91 rr              STA   (ptr_lo),Y
00299Fr 2                     ; Advance source
00299Fr 2  E6 rr              INC   proc_ptr_lo
0029A1r 2  D0 02              BNE   :+
0029A3r 2  E6 rr              INC   proc_ptr_hi
0029A5r 2               :     ; Decrement counter
0029A5r 2  AD rr rr           LDA   num_tmp_lo
0029A8r 2  D0 03              BNE   @bld_dec_lo
0029AAr 2  CE rr rr           DEC   num_tmp_hi
0029ADr 2               @bld_dec_lo:
0029ADr 2  CE rr rr           DEC   num_tmp_lo
0029B0r 2  AD rr rr           LDA   num_tmp_lo
0029B3r 2  0D rr rr           ORA   num_tmp_hi
0029B6r 2  D0 DA              BNE   @bld_body
0029B8r 2               
0029B8r 2               @bld_body_done:
0029B8r 2                     ; Prepend to directory
0029B8r 2  A5 rr              LDA   proc_entry_lo
0029BAr 2  85 rr              STA   proc_head_lo
0029BCr 2  A5 rr              LDA   proc_entry_hi
0029BEr 2  85 rr              STA   proc_head_hi
0029C0r 2  60                 RTS
0029C1r 2               
0029C1r 2               ; ---------------------------------------------------------------------
0029C1r 2               ; proc_lookup — search for a procedure by name
0029C1r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
0029C1r 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
0029C1r 2               ;           carry set = not found
0029C1r 2               ; ---------------------------------------------------------------------
0029C1r 2               proc_lookup:
0029C1r 2  A5 rr              LDA   proc_head_lo
0029C3r 2  85 rr              STA   proc_entry_lo
0029C5r 2  A5 rr              LDA   proc_head_hi
0029C7r 2  85 rr              STA   proc_entry_hi
0029C9r 2               
0029C9r 2               @walk:
0029C9r 2  A5 rr              LDA   proc_entry_lo
0029CBr 2  05 rr              ORA   proc_entry_hi
0029CDr 2  F0 1D              BEQ   @not_found
0029CFr 2               
0029CFr 2  20 rr rr           JSR   proc_names_equal
0029D2r 2  B0 16              BCS   @found
0029D4r 2               
0029D4r 2                     ; Follow next pointer
0029D4r 2  A5 rr              LDA   proc_entry_lo
0029D6r 2  85 rr              STA   ptr_lo
0029D8r 2  A5 rr              LDA   proc_entry_hi
0029DAr 2  85 rr              STA   ptr_hi
0029DCr 2  A0 00              LDY   #0
0029DEr 2  B1 rr              LDA   (ptr_lo),Y
0029E0r 2  AA                 TAX
0029E1r 2  C8                 INY
0029E2r 2  B1 rr              LDA   (ptr_lo),Y
0029E4r 2  85 rr              STA   proc_entry_hi
0029E6r 2  86 rr              STX   proc_entry_lo
0029E8r 2  80 DF              BRA   @walk
0029EAr 2               
0029EAr 2               @found:
0029EAr 2  18                 CLC
0029EBr 2  60                 RTS
0029ECr 2               @not_found:
0029ECr 2  38                 SEC
0029EDr 2  60                 RTS
0029EEr 2               
0029EEr 2               ; ---------------------------------------------------------------------
0029EEr 2               ; proc_names_equal — compare token word vs record name
0029EEr 2               ;   Input: eval_cur_lo/hi = TOK_WORD, proc_entry_lo/hi = record
0029EEr 2               ;   Returns: carry set = equal, carry clear = not equal
0029EEr 2               ; ---------------------------------------------------------------------
0029EEr 2               proc_names_equal:
0029EEr 2                     ; Token name length
0029EEr 2  A5 rr              LDA   eval_cur_lo
0029F0r 2  85 rr              STA   ptr_lo
0029F2r 2  A5 rr              LDA   eval_cur_hi
0029F4r 2  85 rr              STA   ptr_hi
0029F6r 2  A0 03              LDY   #TOK_PAYLOAD
0029F8r 2  B1 rr              LDA   (ptr_lo),Y
0029FAr 2  85 rr              STA   proc_name_len         ; token name length
0029FCr 2               
0029FCr 2                     ; Record name length
0029FCr 2  A5 rr              LDA   proc_entry_lo
0029FEr 2  85 rr              STA   ptr_lo
002A00r 2  A5 rr              LDA   proc_entry_hi
002A02r 2  85 rr              STA   ptr_hi
002A04r 2  A0 02              LDY   #2
002A06r 2  B1 rr              LDA   (ptr_lo),Y
002A08r 2               
002A08r 2  C5 rr              CMP   proc_name_len
002A0Ar 2  D0 37              BNE   @ne
002A0Cr 2               
002A0Cr 2                     ; Lengths match — compare chars
002A0Cr 2  AA                 TAX                         ; X = length
002A0Dr 2  F0 30              BEQ   @eq
002A0Fr 2  A0 00              LDY   #0                    ; char index
002A11r 2               @cmp:
002A11r 2  DA                 PHX
002A12r 2  5A                 PHY
002A13r 2                     ; Token char at eval_cur + TOK_PAYLOAD + 1 + charIdx
002A13r 2  A5 rr              LDA   eval_cur_lo
002A15r 2  85 rr              STA   ptr_lo
002A17r 2  A5 rr              LDA   eval_cur_hi
002A19r 2  85 rr              STA   ptr_hi
002A1Br 2  98                 TYA
002A1Cr 2  18                 CLC
002A1Dr 2  69 04              ADC   #TOK_PAYLOAD+1
002A1Fr 2  A8                 TAY
002A20r 2  B1 rr              LDA   (ptr_lo),Y
002A22r 2  85 rr              STA   proc_rec_off          ; temp: token char
002A24r 2               
002A24r 2                     ; Record char at proc_entry + 3 + charIdx
002A24r 2  7A                 PLY
002A25r 2  5A                 PHY
002A26r 2  A5 rr              LDA   proc_entry_lo
002A28r 2  85 rr              STA   ptr_lo
002A2Ar 2  A5 rr              LDA   proc_entry_hi
002A2Cr 2  85 rr              STA   ptr_hi
002A2Er 2  98                 TYA
002A2Fr 2  18                 CLC
002A30r 2  69 03              ADC   #3
002A32r 2  A8                 TAY
002A33r 2  B1 rr              LDA   (ptr_lo),Y
002A35r 2               
002A35r 2  C5 rr              CMP   proc_rec_off
002A37r 2  D0 08              BNE   @ne_pop
002A39r 2  7A                 PLY
002A3Ar 2  FA                 PLX
002A3Br 2  C8                 INY
002A3Cr 2  CA                 DEX
002A3Dr 2  D0 D2              BNE   @cmp
002A3Fr 2               @eq:
002A3Fr 2  38                 SEC
002A40r 2  60                 RTS
002A41r 2               @ne_pop:
002A41r 2  7A                 PLY
002A42r 2  FA                 PLX
002A43r 2               @ne:
002A43r 2  18                 CLC
002A44r 2  60                 RTS
002A45r 2               
002A45r 2               ; ---------------------------------------------------------------------
002A45r 2               ; proc_invoke — invoke a user-defined procedure
002A45r 2               ;   Input: eval_cur_lo/hi = TOK_WORD token (the procedure name)
002A45r 2               ;          proc_entry_lo/hi = matching procedure record
002A45r 2               ;   On exit: JMPs to eval_loop or eval_body to continue.
002A45r 2               ; ---------------------------------------------------------------------
002A45r 2               proc_invoke:
002A45r 2                     ; Save outer tokenizer and eval state on the hardware stack.
002A45r 2                     ; We push: tok_head(2), tok_tail(2), eval_in_body(1),
002A45r 2                     ;          proc_stopped(1) = 6 bytes.
002A45r 2                     ; input_buf is saved to BSS (128 bytes too large for stack).
002A45r 2  A5 rr              LDA   tok_head_lo
002A47r 2  48                 PHA
002A48r 2  A5 rr              LDA   tok_head_hi
002A4Ar 2  48                 PHA
002A4Br 2  A5 rr              LDA   tok_tail_lo
002A4Dr 2  48                 PHA
002A4Er 2  A5 rr              LDA   tok_tail_hi
002A50r 2  48                 PHA
002A51r 2  A5 rr              LDA   eval_in_body
002A53r 2  48                 PHA
002A54r 2  A5 rr              LDA   proc_stopped
002A56r 2  48                 PHA
002A57r 2               
002A57r 2                     ; Save input_buf to BSS save area
002A57r 2  A2 00              LDX   #0
002A59r 2               @save_ib:
002A59r 2  BD rr rr           LDA   input_buf,X
002A5Cr 2  9D rr rr           STA   save_input_buf,X
002A5Fr 2  E8                 INX
002A60r 2  E0 80              CPX   #128
002A62r 2  D0 F5              BNE   @save_ib
002A64r 2               
002A64r 2                     ; Advance eval_cur past the procedure name token
002A64r 2  20 rr rr           JSR   eval_advance
002A67r 2               
002A67r 2                     ; --- Bind parameters ---
002A67r 2                     ; Navigate to param_count in the record:
002A67r 2                     ;   offset = 3 + name_len
002A67r 2  A5 rr              LDA   proc_entry_lo
002A69r 2  85 rr              STA   ptr_lo
002A6Br 2  A5 rr              LDA   proc_entry_hi
002A6Dr 2  85 rr              STA   ptr_hi
002A6Fr 2  A0 02              LDY   #2
002A71r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002A73r 2  18                 CLC
002A74r 2  69 03              ADC   #3
002A76r 2  A8                 TAY                         ; Y = offset to param_count
002A77r 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002A79r 2  85 rr              STA   proc_param_cnt
002A7Br 2  C8                 INY                         ; Y = offset to first param name
002A7Cr 2  84 rr              STY   proc_rec_off          ; save record offset
002A7Er 2               
002A7Er 2  A5 rr              LDA   proc_param_cnt
002A80r 2  F0 5C              BEQ   @bind_done
002A82r 2               
002A82r 2  A6 rr              LDX   proc_param_cnt
002A84r 2               @bind_loop:
002A84r 2  DA                 PHX                         ; save remaining param count
002A85r 2               
002A85r 2                     ; First: evaluate the next argument from the caller's token stream.
002A85r 2                     ; eval_cur still points into the caller's token list.
002A85r 2  20 rr rr           JSR   eval_expr
002A88r 2  90 03              BCC   @arg_ok
002A8Ar 2  4C rr rr           JMP   @bind_err
002A8Dr 2               @arg_ok:
002A8Dr 2               
002A8Dr 2                     ; eval_val now holds the argument value.
002A8Dr 2                     ; Push value onto stack (type + 3 value bytes = 4 bytes)
002A8Dr 2  A5 rr              LDA   eval_val_frac
002A8Fr 2  48                 PHA
002A90r 2  A5 rr              LDA   eval_val_lo
002A92r 2  48                 PHA
002A93r 2  A5 rr              LDA   eval_val_hi
002A95r 2  48                 PHA
002A96r 2  A5 rr              LDA   eval_type
002A98r 2  48                 PHA
002A99r 2               
002A99r 2                     ; Build the param name as a length-prefixed string in param_name_tmp
002A99r 2                     ; Read from record at proc_entry + proc_rec_off
002A99r 2  A5 rr              LDA   proc_entry_lo
002A9Br 2  85 rr              STA   ptr_lo
002A9Dr 2  A5 rr              LDA   proc_entry_hi
002A9Fr 2  85 rr              STA   ptr_hi
002AA1r 2  A4 rr              LDY   proc_rec_off
002AA3r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002AA5r 2  8D rr rr           STA   param_name_tmp        ; length byte
002AA8r 2  AA                 TAX                         ; X = char count
002AA9r 2  A9 00              LDA   #0
002AABr 2  85 rr              STA   proc_name_len         ; dest offset in param_name_tmp
002AADr 2               @bind_ch:
002AADr 2  E0 00              CPX   #0
002AAFr 2  F0 0F              BEQ   @bind_ch_done
002AB1r 2  C8                 INY
002AB2r 2  B1 rr              LDA   (ptr_lo),Y
002AB4r 2  DA                 PHX
002AB5r 2  A6 rr              LDX   proc_name_len
002AB7r 2  9D rr rr           STA   param_name_tmp+1,X
002ABAr 2  E6 rr              INC   proc_name_len
002ABCr 2  FA                 PLX
002ABDr 2  CA                 DEX
002ABEr 2  80 ED              BRA   @bind_ch
002AC0r 2               @bind_ch_done:
002AC0r 2                     ; Advance proc_rec_off past this param
002AC0r 2  C8                 INY
002AC1r 2  84 rr              STY   proc_rec_off
002AC3r 2               
002AC3r 2                     ; Pop value from stack back into eval_val
002AC3r 2  68                 PLA
002AC4r 2  85 rr              STA   eval_type
002AC6r 2  68                 PLA
002AC7r 2  85 rr              STA   eval_val_hi
002AC9r 2  68                 PLA
002ACAr 2  85 rr              STA   eval_val_lo
002ACCr 2  68                 PLA
002ACDr 2  85 rr              STA   eval_val_frac
002ACFr 2               
002ACFr 2                     ; Call var_set with ptr_lo/hi → param_name_tmp
002ACFr 2  A9 rr              LDA   #<param_name_tmp
002AD1r 2  85 rr              STA   ptr_lo
002AD3r 2  A9 rr              LDA   #>param_name_tmp
002AD5r 2  85 rr              STA   ptr_hi
002AD7r 2  20 rr rr           JSR   var_set
002ADAr 2               
002ADAr 2  FA                 PLX                         ; restore remaining count
002ADBr 2  CA                 DEX
002ADCr 2  D0 A6              BNE   @bind_loop
002ADEr 2               
002ADEr 2               @bind_done:
002ADEr 2                     ; Save heap pointer AFTER param binding so var_set allocations persist.
002ADEr 2                     ; Body tokenization will reuse heap from this point each line.
002ADEr 2  A5 rr              LDA   heap_ptr
002AE0r 2  8D rr rr           STA   save_heap_ptr_lo
002AE3r 2  A5 rr              LDA   heap_ptr+1
002AE5r 2  8D rr rr           STA   save_heap_ptr_hi
002AE8r 2               
002AE8r 2                     ; Save eval_cur (resume point after all args consumed from caller)
002AE8r 2  A5 rr              LDA   eval_cur_lo
002AEAr 2  8D rr rr           STA   save_eval_cur_lo
002AEDr 2  A5 rr              LDA   eval_cur_hi
002AEFr 2  8D rr rr           STA   save_eval_cur_hi
002AF2r 2               
002AF2r 2                     ; --- Execute the body ---
002AF2r 2                     ; Navigate to body in the record:
002AF2r 2                     ;   proc_rec_off now points past all params.
002AF2r 2                     ;   Next 2 bytes = body_len, then body text.
002AF2r 2  A5 rr              LDA   proc_entry_lo
002AF4r 2  85 rr              STA   ptr_lo
002AF6r 2  A5 rr              LDA   proc_entry_hi
002AF8r 2  85 rr              STA   ptr_hi
002AFAr 2  A4 rr              LDY   proc_rec_off
002AFCr 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_lo
002AFEr 2  85 rr              STA   proc_body_len_lo
002B00r 2  C8                 INY
002B01r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_hi
002B03r 2  85 rr              STA   proc_body_len_hi
002B05r 2  C8                 INY                         ; Y = offset to body text start
002B06r 2  84 rr              STY   proc_rec_off
002B08r 2               
002B08r 2                     ; Compute absolute pointer to body text start
002B08r 2  18                 CLC
002B09r 2  A5 rr              LDA   proc_entry_lo
002B0Br 2  65 rr              ADC   proc_rec_off
002B0Dr 2  85 rr              STA   proc_ptr_lo
002B0Fr 2  A5 rr              LDA   proc_entry_hi
002B11r 2  69 00              ADC   #0
002B13r 2  85 rr              STA   proc_ptr_hi
002B15r 2               
002B15r 2                     ; Process body line by line: find each $0A, copy line to input_buf,
002B15r 2                     ; tokenize, eval, repeat.
002B15r 2                     ; proc_ptr = current position in body text
002B15r 2                     ; proc_body_len = remaining bytes
002B15r 2               
002B15r 2                     ; Clear STOP/OUTPUT flag before executing body
002B15r 2  64 rr              STZ   proc_stopped
002B17r 2               
002B17r 2               @exec_line:
002B17r 2                     ; Any body text remaining?
002B17r 2  A5 rr              LDA   proc_body_len_lo
002B19r 2  05 rr              ORA   proc_body_len_hi
002B1Br 2  D0 03              BNE   @have_body
002B1Dr 2  4C rr rr           JMP   @exec_done
002B20r 2               @have_body:
002B20r 2               
002B20r 2                     ; Reset heap for this line's tokens (reuse token heap each line)
002B20r 2  AD rr rr           LDA   save_heap_ptr_lo
002B23r 2  85 rr              STA   heap_ptr
002B25r 2  AD rr rr           LDA   save_heap_ptr_hi
002B28r 2  85 rr              STA   heap_ptr+1
002B2Ar 2               
002B2Ar 2                     ; Copy characters from body to input_buf until $0A or end
002B2Ar 2  A2 00              LDX   #0                    ; input_buf index
002B2Cr 2               @line_ch:
002B2Cr 2  A5 rr              LDA   proc_body_len_lo
002B2Er 2  05 rr              ORA   proc_body_len_hi
002B30r 2  F0 2A              BEQ   @line_end             ; no more body text
002B32r 2               
002B32r 2  A0 00              LDY   #0
002B34r 2  B1 rr              LDA   (proc_ptr_lo),Y      ; read body char
002B36r 2  C9 0A              CMP   #$0A
002B38r 2  F0 14              BEQ   @line_nl
002B3Ar 2               
002B3Ar 2                     ; Store in input_buf
002B3Ar 2  9D rr rr           STA   input_buf,X
002B3Dr 2  E8                 INX
002B3Er 2               
002B3Er 2                     ; Advance body pointer
002B3Er 2  E6 rr              INC   proc_ptr_lo
002B40r 2  D0 02              BNE   :+
002B42r 2  E6 rr              INC   proc_ptr_hi
002B44r 2               :     ; Decrement remaining
002B44r 2  A5 rr              LDA   proc_body_len_lo
002B46r 2  D0 02              BNE   @ln_dec_lo
002B48r 2  C6 rr              DEC   proc_body_len_hi
002B4Ar 2               @ln_dec_lo:
002B4Ar 2  C6 rr              DEC   proc_body_len_lo
002B4Cr 2  80 DE              BRA   @line_ch
002B4Er 2               
002B4Er 2               @line_nl:
002B4Er 2                     ; Skip the $0A
002B4Er 2  E6 rr              INC   proc_ptr_lo
002B50r 2  D0 02              BNE   :+
002B52r 2  E6 rr              INC   proc_ptr_hi
002B54r 2  A5 rr        :     LDA   proc_body_len_lo
002B56r 2  D0 02              BNE   @ln2_dec_lo
002B58r 2  C6 rr              DEC   proc_body_len_hi
002B5Ar 2               @ln2_dec_lo:
002B5Ar 2  C6 rr              DEC   proc_body_len_lo
002B5Cr 2               
002B5Cr 2               @line_end:
002B5Cr 2                     ; Null-terminate input_buf
002B5Cr 2  9E rr rr           STZ   input_buf,X
002B5Fr 2               
002B5Fr 2                     ; Tokenize this line
002B5Fr 2  20 rr rr           JSR   tokenize_line
002B62r 2               
002B62r 2                     ; Save body-loop state that recursive proc_invoke would clobber.
002B62r 2                     ; BSS save areas (save_heap_ptr, save_eval_cur) plus ZP body-loop
002B62r 2                     ; variables (proc_ptr, proc_body_len) all need protection.
002B62r 2  A5 rr              LDA   proc_ptr_lo
002B64r 2  48                 PHA
002B65r 2  A5 rr              LDA   proc_ptr_hi
002B67r 2  48                 PHA
002B68r 2  A5 rr              LDA   proc_body_len_lo
002B6Ar 2  48                 PHA
002B6Br 2  A5 rr              LDA   proc_body_len_hi
002B6Dr 2  48                 PHA
002B6Er 2  AD rr rr           LDA   save_heap_ptr_lo
002B71r 2  48                 PHA
002B72r 2  AD rr rr           LDA   save_heap_ptr_hi
002B75r 2  48                 PHA
002B76r 2  AD rr rr           LDA   save_eval_cur_lo
002B79r 2  48                 PHA
002B7Ar 2  AD rr rr           LDA   save_eval_cur_hi
002B7Dr 2  48                 PHA
002B7Er 2               
002B7Er 2                     ; Eval this line (full eval — not body mode)
002B7Er 2  20 rr rr           JSR   eval_line
002B81r 2               
002B81r 2                     ; Restore body-loop state
002B81r 2  68                 PLA
002B82r 2  8D rr rr           STA   save_eval_cur_hi
002B85r 2  68                 PLA
002B86r 2  8D rr rr           STA   save_eval_cur_lo
002B89r 2  68                 PLA
002B8Ar 2  8D rr rr           STA   save_heap_ptr_hi
002B8Dr 2  68                 PLA
002B8Er 2  8D rr rr           STA   save_heap_ptr_lo
002B91r 2  68                 PLA
002B92r 2  85 rr              STA   proc_body_len_hi
002B94r 2  68                 PLA
002B95r 2  85 rr              STA   proc_body_len_lo
002B97r 2  68                 PLA
002B98r 2  85 rr              STA   proc_ptr_hi
002B9Ar 2  68                 PLA
002B9Br 2  85 rr              STA   proc_ptr_lo
002B9Dr 2               
002B9Dr 2                     ; Check if STOP or OUTPUT was called — stop processing lines
002B9Dr 2  A5 rr              LDA   proc_stopped
002B9Fr 2  D0 03              BNE   @exec_done
002BA1r 2               
002BA1r 2  4C rr rr           JMP   @exec_line
002BA4r 2               
002BA4r 2               @exec_done:
002BA4r 2                     ; Restore heap pointer (procedures stay, but per-line tokens freed)
002BA4r 2  AD rr rr           LDA   save_heap_ptr_lo
002BA7r 2  85 rr              STA   heap_ptr
002BA9r 2  AD rr rr           LDA   save_heap_ptr_hi
002BACr 2  85 rr              STA   heap_ptr+1
002BAEr 2               
002BAEr 2                     ; Restore input_buf
002BAEr 2  A2 00              LDX   #0
002BB0r 2               @rest_ib:
002BB0r 2  BD rr rr           LDA   save_input_buf,X
002BB3r 2  9D rr rr           STA   input_buf,X
002BB6r 2  E8                 INX
002BB7r 2  E0 80              CPX   #128
002BB9r 2  D0 F5              BNE   @rest_ib
002BBBr 2               
002BBBr 2                     ; Restore eval_cur to the resume point in the caller's token stream
002BBBr 2  AD rr rr           LDA   save_eval_cur_lo
002BBEr 2  85 rr              STA   eval_cur_lo
002BC0r 2  AD rr rr           LDA   save_eval_cur_hi
002BC3r 2  85 rr              STA   eval_cur_hi
002BC5r 2               
002BC5r 2                     ; Restore outer state from stack.
002BC5r 2                     ; X returns this invocation's proc_stopped to the caller.
002BC5r 2                     ; Stack layout (top to bottom):
002BC5r 2                     ;   saved_proc_stopped, eval_in_body, tok_tail_hi, tok_tail_lo,
002BC5r 2                     ;   tok_head_hi, tok_head_lo
002BC5r 2  A6 rr              LDX   proc_stopped          ; X = this proc's exit state
002BC7r 2  68                 PLA                         ; pop saved outer proc_stopped
002BC8r 2  85 rr              STA   proc_stopped          ; restore outer proc_stopped
002BCAr 2  68                 PLA
002BCBr 2  85 rr              STA   eval_in_body
002BCDr 2  68                 PLA
002BCEr 2  85 rr              STA   tok_tail_hi
002BD0r 2  68                 PLA
002BD1r 2  85 rr              STA   tok_tail_lo
002BD3r 2  68                 PLA
002BD4r 2  85 rr              STA   tok_head_hi
002BD6r 2  68                 PLA
002BD7r 2  85 rr              STA   tok_head_lo
002BD9r 2               
002BD9r 2                     ; Return with X = exit status ($00=normal, $01=STOP, $02=OUTPUT)
002BD9r 2  60                 RTS
002BDAr 2               
002BDAr 2               @bind_err:
002BDAr 2  FA                 PLX                         ; discard remaining param count
002BDBr 2                     ; Print error
002BDBr 2  A2 00              LDX   #0
002BDDr 2               @be_lp:
002BDDr 2  BD rr rr           LDA   str_notenough,X
002BE0r 2  F0 06              BEQ   @be_done
002BE2r 2  8D 0E A0           STA   VGC_CHAROUT
002BE5r 2  E8                 INX
002BE6r 2  D0 F5              BNE   @be_lp
002BE8r 2               @be_done:
002BE8r 2  20 rr rr           JSR   eval_newline
002BEBr 2                     ; Restore input_buf and stack, skip body execution
002BEBr 2  A2 00              LDX   #0
002BEDr 2               @be_rest_ib:
002BEDr 2  BD rr rr           LDA   save_input_buf,X
002BF0r 2  9D rr rr           STA   input_buf,X
002BF3r 2  E8                 INX
002BF4r 2  E0 80              CPX   #128
002BF6r 2  D0 F5              BNE   @be_rest_ib
002BF8r 2                     ; Restore stack (6 bytes: proc_stopped, eval_in_body, tok_tail, tok_head)
002BF8r 2  A2 00              LDX   #$00                  ; X = normal exit status
002BFAr 2  68                 PLA                         ; saved proc_stopped
002BFBr 2  85 rr              STA   proc_stopped
002BFDr 2  68                 PLA
002BFEr 2  85 rr              STA   eval_in_body
002C00r 2  68                 PLA
002C01r 2  85 rr              STA   tok_tail_hi
002C03r 2  68                 PLA
002C04r 2  85 rr              STA   tok_tail_lo
002C06r 2  68                 PLA
002C07r 2  85 rr              STA   tok_head_hi
002C09r 2  68                 PLA
002C0Ar 2  85 rr              STA   tok_head_lo
002C0Cr 2  60                 RTS
002C0Dr 2               
002C0Dr 2               ; ---------------------------------------------------------------------
002C0Dr 2               ; proc_find_by_name — search proc_head for a procedure by name string
002C0Dr 2               ;   Input: ptr_lo/hi = length-prefixed name string (e.g. from eval_val)
002C0Dr 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002C0Dr 2               ;           carry set = not found
002C0Dr 2               ;   Clobbers: A, X, Y, proc_entry, proc_name_len, proc_rec_off
002C0Dr 2               ; ---------------------------------------------------------------------
002C0Dr 2               proc_find_by_name:
002C0Dr 2                     ; Save search name pointer
002C0Dr 2  A5 rr              LDA   ptr_lo
002C0Fr 2  85 rr              STA   var_name_lo             ; reuse var scratch as search ptr
002C11r 2  A5 rr              LDA   ptr_hi
002C13r 2  85 rr              STA   var_name_hi
002C15r 2               
002C15r 2  A5 rr              LDA   proc_head_lo
002C17r 2  85 rr              STA   proc_entry_lo
002C19r 2  A5 rr              LDA   proc_head_hi
002C1Br 2  85 rr              STA   proc_entry_hi
002C1Dr 2               
002C1Dr 2               @walk:
002C1Dr 2  A5 rr              LDA   proc_entry_lo
002C1Fr 2  05 rr              ORA   proc_entry_hi
002C21r 2  F0 66              BEQ   @not_found
002C23r 2               
002C23r 2                     ; Compare name lengths
002C23r 2  A5 rr              LDA   var_name_lo
002C25r 2  85 rr              STA   ptr_lo
002C27r 2  A5 rr              LDA   var_name_hi
002C29r 2  85 rr              STA   ptr_hi
002C2Br 2  A0 00              LDY   #0
002C2Dr 2  B1 rr              LDA   (ptr_lo),Y             ; search name length
002C2Fr 2  85 rr              STA   proc_name_len
002C31r 2               
002C31r 2  A5 rr              LDA   proc_entry_lo
002C33r 2  85 rr              STA   ptr_lo
002C35r 2  A5 rr              LDA   proc_entry_hi
002C37r 2  85 rr              STA   ptr_hi
002C39r 2  A0 02              LDY   #2
002C3Br 2  B1 rr              LDA   (ptr_lo),Y             ; record name length
002C3Dr 2  C5 rr              CMP   proc_name_len
002C3Fr 2  D0 32              BNE   @next
002C41r 2               
002C41r 2                     ; Lengths match — compare chars
002C41r 2  AA                 TAX                           ; X = length
002C42r 2  F0 2C              BEQ   @found                  ; both zero = match
002C44r 2  A0 00              LDY   #0
002C46r 2               @cmp:
002C46r 2  DA                 PHX
002C47r 2  5A                 PHY
002C48r 2                     ; Search char
002C48r 2  A5 rr              LDA   var_name_lo
002C4Ar 2  85 rr              STA   ptr_lo
002C4Cr 2  A5 rr              LDA   var_name_hi
002C4Er 2  85 rr              STA   ptr_hi
002C50r 2  C8                 INY                           ; +1 for length byte
002C51r 2  B1 rr              LDA   (ptr_lo),Y
002C53r 2  85 rr              STA   proc_rec_off            ; temp: search char
002C55r 2               
002C55r 2                     ; Record char
002C55r 2  7A                 PLY
002C56r 2  A5 rr              LDA   proc_entry_lo
002C58r 2  85 rr              STA   ptr_lo
002C5Ar 2  A5 rr              LDA   proc_entry_hi
002C5Cr 2  85 rr              STA   ptr_hi
002C5Er 2  5A                 PHY
002C5Fr 2  98                 TYA
002C60r 2  18                 CLC
002C61r 2  69 03              ADC   #3                      ; record name starts at offset 3
002C63r 2  A8                 TAY
002C64r 2  B1 rr              LDA   (ptr_lo),Y
002C66r 2  7A                 PLY
002C67r 2  C5 rr              CMP   proc_rec_off
002C69r 2  D0 07              BNE   @ne_pop
002C6Br 2  FA                 PLX
002C6Cr 2  C8                 INY
002C6Dr 2  CA                 DEX
002C6Er 2  D0 D6              BNE   @cmp
002C70r 2               
002C70r 2               @found:
002C70r 2  18                 CLC
002C71r 2  60                 RTS
002C72r 2               
002C72r 2               @ne_pop:
002C72r 2  FA                 PLX
002C73r 2               @next:
002C73r 2                     ; Follow next pointer
002C73r 2  A5 rr              LDA   proc_entry_lo
002C75r 2  85 rr              STA   ptr_lo
002C77r 2  A5 rr              LDA   proc_entry_hi
002C79r 2  85 rr              STA   ptr_hi
002C7Br 2  A0 00              LDY   #0
002C7Dr 2  B1 rr              LDA   (ptr_lo),Y
002C7Fr 2  AA                 TAX
002C80r 2  C8                 INY
002C81r 2  B1 rr              LDA   (ptr_lo),Y
002C83r 2  85 rr              STA   proc_entry_hi
002C85r 2  86 rr              STX   proc_entry_lo
002C87r 2  80 94              BRA   @walk
002C89r 2               
002C89r 2               @not_found:
002C89r 2  38                 SEC
002C8Ar 2  60                 RTS
002C8Br 2               
002C8Br 2               ; ---------------------------------------------------------------------
002C8Br 2               ; do_pots — POTS: print all procedure names
002C8Br 2               ;   Arity 0, no arguments.
002C8Br 2               ; ---------------------------------------------------------------------
002C8Br 2               do_pots:
