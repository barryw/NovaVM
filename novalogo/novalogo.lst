000E4Er 2                     ; Advance past the [
000E4Er 2  20 rr rr           JSR   eval_advance
000E51r 2  A2 01              LDX   #1                    ; depth = 1
000E53r 2               
000E53r 2               @scan:
000E53r 2  A5 rr              LDA   eval_cur_lo
000E55r 2  05 rr              ORA   eval_cur_hi
