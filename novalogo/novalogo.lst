001DCFr 2  A5 rr              LDA   eval_type
001DD1r 2  C9 02              CMP   #VAL_LIST
001DD3r 2  D0 65              BNE   @err_type_pop2
001DD5r 2               
001DD5r 2  68                 PLA
001DD6r 2  85 rr              STA   list_count_hi
001DD8r 2  68                 PLA
001DD9r 2  85 rr              STA   list_count_lo
001DDBr 2               
001DDBr 2                     ; Index must be >= 1
001DDBr 2  A5 rr              LDA   list_count_lo
001DDDr 2  05 rr              ORA   list_count_hi
001DDFr 2  F0 69              BEQ   @err_range
001DE1r 2               
001DE1r 2  A5 rr              LDA   eval_val_lo
001DE3r 2  85 rr              STA   list_ptr_lo
001DE5r 2  A5 rr              LDA   eval_val_hi
001DE7r 2  85 rr              STA   list_ptr_hi
