001CE8r 2               @bl_loop:
001CE8r 2                     ; If cdr of current cell is null, this is the last — stop
001CE8r 2  A5 rr              LDA   list_ptr_lo
001CEAr 2  85 rr              STA   ptr_lo
001CECr 2  A5 rr              LDA   list_ptr_hi
001CEEr 2  85 rr              STA   ptr_hi
001CF0r 2  A0 05              LDY   #CONS_CDR_LO
001CF2r 2  B1 rr              LDA   (ptr_lo),Y
001CF4r 2  AA                 TAX
001CF5r 2  A0 06              LDY   #CONS_CDR_HI
001CF7r 2  B1 rr              LDA   (ptr_lo),Y
001CF9r 2  8E rr rr           STX   num_tmp_lo
001CFCr 2  8D rr rr           STA   num_tmp_hi
001CFFr 2  0D rr rr           ORA   num_tmp_lo
001D02r 2  D0 03              BNE   :+
001D04r 2  4C rr rr           JMP   @bl_done
001D07r 2               :
001D07r 2                     ; Allocate new cons pair and copy car
