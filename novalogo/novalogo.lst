000237r 2               ; tok_scan_quote — scan TOK_QUOTE after '"'
000237r 2               ;   tok_src points at first char after '"'
000237r 2               ; ---------------------------------------------------------------------
000237r 2               tok_scan_quote:
000237r 2  A6 rr              LDX   tok_src
000239r 2  A0 00              LDY   #0
00023Br 2               @count:
00023Br 2  BD rr rr           LDA   input_buf,X
00023Er 2  20 rr rr           JSR   is_word_char
000241r 2  90 04              BCC   @counted
000243r 2  E8                 INX
000244r 2  C8                 INY
