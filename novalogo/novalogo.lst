000237r 2               ; ---------------------------------------------------------------------
000237r 2               ; tok_scan_quote — scan TOK_QUOTE after '"'
000237r 2               ;   tok_src points at first char after '"'
000237r 2               ; ---------------------------------------------------------------------
000237r 2               tok_scan_quote:
000237r 2  A6 rr              LDX   tok_src
000239r 2  A0 00              LDY   #0
00023Br 2               @count:
00023Br 2  BD rr rr           LDA   input_buf,X
00023Er 2  20 rr rr           JSR   is_word_char
000241r 2  90 04              BCC   @counted
000243r 2  E8                 INX
000244r 2  C8                 INY
000245r 2  80 F4              BRA   @count
000247r 2               @counted:
000247r 2  98                 TYA
000248r 2  F0 48              BEQ   @empty
00024Ar 2  48                 PHA
00024Br 2  18                 CLC
00024Cr 2  69 04              ADC   #4
00024Er 2  A2 01              LDX   #ATYPE_TOKEN
000250r 2  20 rr rr           JSR   heap_alloc
000253r 2  B0 3C              BCS   @oom
000255r 2  A0 00              LDY   #TOK_TAG
000257r 2  A9 06              LDA   #TOK_QUOTE
000259r 2  91 rr              STA   (ptr_lo),Y
00025Br 2  A0 01              LDY   #TOK_NEXT_LO
00025Dr 2  A9 00              LDA   #0
00025Fr 2  91 rr              STA   (ptr_lo),Y
000261r 2  C8                 INY
000262r 2  91 rr              STA   (ptr_lo),Y
000264r 2  68                 PLA
000265r 2  48                 PHA
000266r 2  A0 03              LDY   #TOK_PAYLOAD
000268r 2  91 rr              STA   (ptr_lo),Y
00026Ar 2                     ; Copy characters — no uppercasing for quotes
00026Ar 2  68                 PLA
00026Br 2  AA                 TAX
00026Cr 2  A0 04              LDY   #TOK_PAYLOAD+1
00026Er 2  9C rr rr           STZ   num_tmp_lo
000271r 2               @copy:
000271r 2  DA                 PHX
000272r 2  AD rr rr           LDA   num_tmp_lo
000275r 2  18                 CLC
000276r 2  65 rr              ADC   tok_src
000278r 2  AA                 TAX
000279r 2  BD rr rr           LDA   input_buf,X
00027Cr 2  91 rr              STA   (ptr_lo),Y
00027Er 2  C8                 INY
00027Fr 2  EE rr rr           INC   num_tmp_lo
000282r 2  FA                 PLX
000283r 2  CA                 DEX
000284r 2  D0 EB              BNE   @copy
000286r 2  AD rr rr           LDA   num_tmp_lo
000289r 2  18                 CLC
00028Ar 2  65 rr              ADC   tok_src
00028Cr 2  85 rr              STA   tok_src
00028Er 2  4C rr rr           JMP   tok_append_node
000291r 2               @oom:
000291r 2  68                 PLA
000292r 2               @empty:
000292r 2  60                 RTS
000293r 2               
000293r 2               ; ---------------------------------------------------------------------
000293r 2               ; tok_parse_number — parse decimal integer[.fraction] into TOK_NUMBER
000293r 2               ;   tok_src points at first digit or '-'
000293r 2               ;   Payload: 3 bytes = int_hi, int_lo, frac (16.8 fixed-point)
000293r 2               ; ---------------------------------------------------------------------
000293r 2               tok_parse_number:
000293r 2  9C rr rr           STZ   num_val_lo
000296r 2  9C rr rr           STZ   num_val_hi
000299r 2  64 rr              STZ   tok_sign              ; 0 = positive
00029Br 2  A6 rr              LDX   tok_src
00029Dr 2  BD rr rr           LDA   input_buf,X
0002A0r 2  C9 2D              CMP   #'-'
0002A2r 2  D0 06              BNE   @parse_int
0002A4r 2  A9 01              LDA   #1
0002A6r 2  85 rr              STA   tok_sign
0002A8r 2  E6 rr              INC   tok_src
0002AAr 2               
0002AAr 2                     ; Parse integer digits
0002AAr 2               @parse_int:
0002AAr 2  A6 rr              LDX   tok_src
0002ACr 2  BD rr rr           LDA   input_buf,X
0002AFr 2  C9 30              CMP   #'0'
0002B1r 2  90 54              BCC   @int_done
0002B3r 2  C9 3A              CMP   #'9'+1
0002B5r 2  B0 50              BCS   @int_done
0002B7r 2  38                 SEC
0002B8r 2  E9 30              SBC   #'0'                 ; A = digit 0..9
0002BAr 2  48                 PHA                        ; save digit
0002BBr 2               
0002BBr 2                     ; Multiply num_val by 10: (val << 3) + (val << 1)
0002BBr 2                     ; Compute val << 1
0002BBr 2  AD rr rr           LDA   num_val_lo
0002BEr 2  0A                 ASL
0002BFr 2  8D rr rr           STA   num_tmp_lo
0002C2r 2  AD rr rr           LDA   num_val_hi
0002C5r 2  2A                 ROL
0002C6r 2  8D rr rr           STA   num_tmp_hi           ; tmp = val * 2
0002C9r 2               
0002C9r 2                     ; Compute val << 3 = (val * 2) << 2
0002C9r 2  0E rr rr           ASL   num_tmp_lo
0002CCr 2  2E rr rr           ROL   num_tmp_hi
0002CFr 2  0E rr rr           ASL   num_tmp_lo
0002D2r 2  2E rr rr           ROL   num_tmp_hi           ; tmp = val * 8
0002D5r 2               
0002D5r 2                     ; val*10 = val*8 + val*2. Recompute val*2 into num_val first, with a
0002D5r 2                     ; proper 16-bit shift (ASL low, ROL high) so the carry out of the low
0002D5r 2                     ; byte reaches the high byte — then add val*8. (The previous version
0002D5r 2                     ; fused the shift and add and CLC'd away that carry, dropping 256 from
0002D5r 2                     ; any value whose low byte had bit 7 set, e.g. 4242 -> 3986.)
0002D5r 2  AD rr rr           LDA   num_val_lo
0002D8r 2  0A                 ASL
0002D9r 2  8D rr rr           STA   num_val_lo
0002DCr 2  AD rr rr           LDA   num_val_hi
0002DFr 2  2A                 ROL
0002E0r 2  8D rr rr           STA   num_val_hi           ; num_val = val * 2
0002E3r 2               
0002E3r 2  18                 CLC
0002E4r 2  AD rr rr           LDA   num_val_lo
0002E7r 2  6D rr rr           ADC   num_tmp_lo
0002EAr 2  8D rr rr           STA   num_val_lo
0002EDr 2  AD rr rr           LDA   num_val_hi
0002F0r 2  6D rr rr           ADC   num_tmp_hi
0002F3r 2  8D rr rr           STA   num_val_hi           ; num_val = val*2 + val*8 = val*10
0002F6r 2               
0002F6r 2                     ; Add digit
0002F6r 2  68                 PLA
0002F7r 2  18                 CLC
0002F8r 2  6D rr rr           ADC   num_val_lo
0002FBr 2  8D rr rr           STA   num_val_lo
0002FEr 2  90 03              BCC   @no_carry
000300r 2  EE rr rr           INC   num_val_hi
000303r 2               @no_carry:
000303r 2  E6 rr              INC   tok_src
000305r 2  80 A3              BRA   @parse_int
000307r 2               
000307r 2               @int_done:
000307r 2                     ; Parse fractional part
000307r 2  9C rr rr           STZ   num_tmp_lo           ; frac result
00030Ar 2  A6 rr              LDX   tok_src
00030Cr 2  BD rr rr           LDA   input_buf,X
00030Fr 2  C9 2E              CMP   #'.'
000311r 2  D0 67              BNE   @apply_sign
000313r 2  E6 rr              INC   tok_src
000315r 2               
000315r 2                     ; Parse up to 2 fractional digits
000315r 2  9C rr rr           STZ   num_tmp_hi           ; frac_raw accumulator
000318r 2  A0 00              LDY   #0                   ; digit count
00031Ar 2               @frac_loop:
00031Ar 2  C0 02              CPY   #2
00031Cr 2  B0 2E              BCS   @frac_skip
00031Er 2  A6 rr              LDX   tok_src
000320r 2  BD rr rr           LDA   input_buf,X
000323r 2  C9 30              CMP   #'0'
000325r 2  90 36              BCC   @frac_conv
000327r 2  C9 3A              CMP   #'9'+1
000329r 2  B0 32              BCS   @frac_conv
00032Br 2  38                 SEC
00032Cr 2  E9 30              SBC   #'0'
00032Er 2  48                 PHA
00032Fr 2                     ; frac_raw = frac_raw * 10 + digit
00032Fr 2  AD rr rr           LDA   num_tmp_hi
000332r 2  0A                 ASL
000333r 2  8D rr rr           STA   num_tmp_lo           ; *2
000336r 2  0A                 ASL
000337r 2  0A                 ASL                        ; A = val*8
000338r 2  18                 CLC
000339r 2  6D rr rr           ADC   num_tmp_lo           ; A = val*10
00033Cr 2  8D rr rr           STA   num_tmp_hi
00033Fr 2  68                 PLA
000340r 2  18                 CLC
000341r 2  6D rr rr           ADC   num_tmp_hi
000344r 2  8D rr rr           STA   num_tmp_hi
000347r 2  E6 rr              INC   tok_src
000349r 2  C8                 INY
00034Ar 2  80 CE              BRA   @frac_loop
00034Cr 2               
00034Cr 2               @frac_skip:
00034Cr 2                     ; skip remaining digits after '.'
00034Cr 2  A6 rr              LDX   tok_src
00034Er 2  BD rr rr           LDA   input_buf,X
000351r 2  C9 30              CMP   #'0'
000353r 2  90 08              BCC   @frac_conv
000355r 2  C9 3A              CMP   #'9'+1
000357r 2  B0 04              BCS   @frac_conv
000359r 2  E6 rr              INC   tok_src
00035Br 2  80 EF              BRA   @frac_skip
00035Dr 2               
00035Dr 2               @frac_conv:
00035Dr 2                     ; If only 1 digit, multiply by 10
00035Dr 2  C0 01              CPY   #1
00035Fr 2  D0 10              BNE   @frac_2d
000361r 2  AD rr rr           LDA   num_tmp_hi
000364r 2  0A                 ASL
000365r 2  8D rr rr           STA   num_tmp_lo
000368r 2  0A                 ASL
000369r 2  0A                 ASL
00036Ar 2  18                 CLC
00036Br 2  6D rr rr           ADC   num_tmp_lo
00036Er 2  8D rr rr           STA   num_tmp_hi
000371r 2               @frac_2d:
000371r 2                     ; Convert centesimal (0..99) → 8-bit fraction
000371r 2  AD rr rr           LDA   num_tmp_hi
000374r 2  20 rr rr           JSR   frac_to_byte
000377r 2  8D rr rr           STA   num_tmp_lo
00037Ar 2               
00037Ar 2               @apply_sign:
00037Ar 2                     ; Apply sign (negate 16.8 via two's complement if negative)
00037Ar 2  A5 rr              LDA   tok_sign
00037Cr 2  F0 1F              BEQ   @emit_num
00037Er 2                     ; Negate: complement and add 1 across all 3 bytes
00037Er 2  AD rr rr           LDA   num_tmp_lo           ; frac
000381r 2  49 FF              EOR   #$FF
000383r 2  18                 CLC
000384r 2  69 01              ADC   #1
000386r 2  8D rr rr           STA   num_tmp_lo
000389r 2  AD rr rr           LDA   num_val_lo
00038Cr 2  49 FF              EOR   #$FF
00038Er 2  69 00              ADC   #0
000390r 2  8D rr rr           STA   num_val_lo
000393r 2  AD rr rr           LDA   num_val_hi
000396r 2  49 FF              EOR   #$FF
000398r 2  69 00              ADC   #0
00039Ar 2  8D rr rr           STA   num_val_hi
00039Dr 2               
00039Dr 2               @emit_num:
00039Dr 2                     ; Allocate 6-byte node
00039Dr 2  A9 06              LDA   #6
00039Fr 2  A2 01              LDX   #ATYPE_TOKEN
0003A1r 2  20 rr rr           JSR   heap_alloc
0003A4r 2  B0 25              BCS   @oom
0003A6r 2  A0 00              LDY   #TOK_TAG
0003A8r 2  A9 02              LDA   #TOK_NUMBER
0003AAr 2  91 rr              STA   (ptr_lo),Y
0003ACr 2  A0 01              LDY   #TOK_NEXT_LO
0003AEr 2  A9 00              LDA   #0
0003B0r 2  91 rr              STA   (ptr_lo),Y
0003B2r 2  C8                 INY
0003B3r 2  91 rr              STA   (ptr_lo),Y
0003B5r 2                     ; Payload: [hi, lo, frac]
0003B5r 2  A0 03              LDY   #TOK_PAYLOAD
0003B7r 2  AD rr rr           LDA   num_val_hi
0003BAr 2  91 rr              STA   (ptr_lo),Y
0003BCr 2  C8                 INY
0003BDr 2  AD rr rr           LDA   num_val_lo
0003C0r 2  91 rr              STA   (ptr_lo),Y
0003C2r 2  C8                 INY
0003C3r 2  AD rr rr           LDA   num_tmp_lo
0003C6r 2  91 rr              STA   (ptr_lo),Y
0003C8r 2  4C rr rr           JMP   tok_append_node
0003CBr 2               @oom:
0003CBr 2  60                 RTS
0003CCr 2               
0003CCr 2               ; ---------------------------------------------------------------------
0003CCr 2               ; frac_to_byte — convert centesimal fraction (0..99) to 8-bit (0..252)
0003CCr 2               ;   Input: A = centesimal value (0..99)
0003CCr 2               ;   Output: A = 8-bit fractional byte
0003CCr 2               ;   Method: (A * 256) / 100 via 16÷8 long division
0003CCr 2               ;   Clobbers: X, Y
0003CCr 2               ; ---------------------------------------------------------------------
0003CCr 2               frac_to_byte:
0003CCr 2                     ; dividend = A:$00 (A*256), divisor = 100
0003CCr 2  8D rr rr           STA   num_tmp_hi
0003CFr 2  9C rr rr           STZ   num_tmp_lo
0003D2r 2  A2 00              LDX   #0                   ; remainder
0003D4r 2  A0 10              LDY   #16                  ; 16-bit division
0003D6r 2               @div:
0003D6r 2  0E rr rr           ASL   num_tmp_lo
0003D9r 2  2E rr rr           ROL   num_tmp_hi
0003DCr 2  8A                 TXA
0003DDr 2  2A                 ROL
0003DEr 2  AA                 TAX
0003DFr 2  E0 64              CPX   #100
0003E1r 2  90 08              BCC   @nosub
0003E3r 2  8A                 TXA
0003E4r 2  38                 SEC
0003E5r 2  E9 64              SBC   #100
0003E7r 2  AA                 TAX
0003E8r 2  EE rr rr           INC   num_tmp_lo
0003EBr 2               @nosub:
0003EBr 2  88                 DEY
0003ECr 2  D0 E8              BNE   @div
0003EEr 2  AD rr rr           LDA   num_tmp_lo           ; quotient low byte
0003F1r 2  60                 RTS
0003F2r 2               
0003F2r 2               ; ---------------------------------------------------------------------
0003F2r 2               ; tok_append_node — link ptr_lo/hi into the list, continue scanning
0003F2r 2               ; ---------------------------------------------------------------------
0003F2r 2               tok_append_node:
0003F2r 2  A5 rr              LDA   tok_head_lo
0003F4r 2  05 rr              ORA   tok_head_hi
0003F6r 2  D0 0F              BNE   @link
0003F8r 2                     ; Empty list: head = tail = new node
0003F8r 2  A5 rr              LDA   ptr_lo
0003FAr 2  85 rr              STA   tok_head_lo
0003FCr 2  85 rr              STA   tok_tail_lo
0003FEr 2  A5 rr              LDA   ptr_hi
000400r 2  85 rr              STA   tok_head_hi
000402r 2  85 rr              STA   tok_tail_hi
000404r 2  4C rr rr           JMP   tok_scan_next
000407r 2               @link:
000407r 2                     ; tail->next = new node
000407r 2  A5 rr              LDA   tok_tail_lo
000409r 2  85 rr              STA   ptr2_lo
00040Br 2  A5 rr              LDA   tok_tail_hi
00040Dr 2  85 rr              STA   ptr2_hi
00040Fr 2  A0 01              LDY   #TOK_NEXT_LO
000411r 2  A5 rr              LDA   ptr_lo
000413r 2  91 rr              STA   (ptr2_lo),Y
000415r 2  C8                 INY
000416r 2  A5 rr              LDA   ptr_hi
000418r 2  91 rr              STA   (ptr2_lo),Y
00041Ar 2                     ; tail = new node
00041Ar 2  A5 rr              LDA   ptr_lo
00041Cr 2  85 rr              STA   tok_tail_lo
00041Er 2  A5 rr              LDA   ptr_hi
000420r 2  85 rr              STA   tok_tail_hi
000422r 2  4C rr rr           JMP   tok_scan_next
000425r 2               
000425r 2               ; ---------------------------------------------------------------------
000425r 2               ; is_word_char — test if A is a valid word character
000425r 2               ;   Returns: carry set = word char, carry clear = delimiter
000425r 2               ;   Preserves: X
000425r 2               ; ---------------------------------------------------------------------
000425r 2               is_word_char:
000425r 2  C9 00              CMP   #0
000427r 2  F0 36              BEQ   @no
000429r 2  C9 20              CMP   #$20
00042Br 2  F0 32              BEQ   @no
00042Dr 2  C9 09              CMP   #$09
00042Fr 2  F0 2E              BEQ   @no
000431r 2  C9 5B              CMP   #'['
000433r 2  F0 2A              BEQ   @no
000435r 2  C9 5D              CMP   #']'
000437r 2  F0 26              BEQ   @no
000439r 2  C9 28              CMP   #'('
00043Br 2  F0 22              BEQ   @no
00043Dr 2  C9 29              CMP   #')'
00043Fr 2  F0 1E              BEQ   @no
000441r 2  C9 2B              CMP   #'+'
000443r 2  F0 1A              BEQ   @no
000445r 2  C9 2D              CMP   #'-'
000447r 2  F0 16              BEQ   @no
000449r 2  C9 2A              CMP   #'*'
00044Br 2  F0 12              BEQ   @no
00044Dr 2  C9 2F              CMP   #'/'
00044Fr 2  F0 0E              BEQ   @no
000451r 2  C9 3C              CMP   #'<'
000453r 2  F0 0A              BEQ   @no
000455r 2  C9 3E              CMP   #'>'
000457r 2  F0 06              BEQ   @no
000459r 2  C9 3D              CMP   #'='
00045Br 2  F0 02              BEQ   @no
00045Dr 2  38                 SEC
00045Er 2  60                 RTS
00045Fr 2               @no:
00045Fr 2  18                 CLC
000460r 2  60                 RTS
000461r 2               
000461r 2               ; =====================================================================
000461r 2               ; print_token_count — walk the token list, count, print "N TOKENS\n"
000461r 2               ; =====================================================================
000461r 2               print_token_count:
000461r 2  A2 00              LDX   #0
000463r 2  A5 rr              LDA   tok_head_lo
000465r 2  85 rr              STA   ptr2_lo
000467r 2  A5 rr              LDA   tok_head_hi
000469r 2  85 rr              STA   ptr2_hi
00046Br 2               @walk:
00046Br 2  A5 rr              LDA   ptr2_lo
00046Dr 2  05 rr              ORA   ptr2_hi
00046Fr 2  F0 10              BEQ   @print
000471r 2  E8                 INX
000472r 2  A0 01              LDY   #TOK_NEXT_LO
000474r 2  B1 rr              LDA   (ptr2_lo),Y
000476r 2  48                 PHA
000477r 2  C8                 INY
000478r 2  B1 rr              LDA   (ptr2_lo),Y
00047Ar 2  85 rr              STA   ptr2_hi
00047Cr 2  68                 PLA
00047Dr 2  85 rr              STA   ptr2_lo
00047Fr 2  80 EA              BRA   @walk
000481r 2               @print:
000481r 2  8A                 TXA
000482r 2  20 rr rr           JSR   print_byte_decimal
000485r 2  A2 00              LDX   #0
000487r 2               @str:
000487r 2  BD rr rr           LDA   str_tokens,X
00048Ar 2  F0 06              BEQ   @nl
00048Cr 2  8D 0E A0           STA   VGC_CHAROUT
00048Fr 2  E8                 INX
000490r 2  D0 F5              BNE   @str
000492r 2               @nl:
000492r 2  A9 0D              LDA   #$0D
000494r 2  8D 0E A0           STA   VGC_CHAROUT
000497r 2  A9 0A              LDA   #$0A
000499r 2  8D 0E A0           STA   VGC_CHAROUT
00049Cr 2  60                 RTS
00049Dr 2               
00049Dr 2               ; ---------------------------------------------------------------------
00049Dr 2               ; print_byte_decimal — print A as 1-3 decimal digits (no leading zeros)
00049Dr 2               ;   Input: A = value 0..255
00049Dr 2               ; ---------------------------------------------------------------------
00049Dr 2               print_byte_decimal:
00049Dr 2  A2 00              LDX   #0                   ; suppress leading zeros
00049Fr 2  A0 00              LDY   #0
0004A1r 2               @hundreds:
0004A1r 2  C9 64              CMP   #100
0004A3r 2  90 06              BCC   @tens_setup
0004A5r 2  38                 SEC
0004A6r 2  E9 64              SBC   #100
0004A8r 2  C8                 INY
0004A9r 2  80 F6              BRA   @hundreds
0004ABr 2               @tens_setup:
0004ABr 2  48                 PHA
0004ACr 2  98                 TYA
0004ADr 2  F0 07              BEQ   @skip_h
0004AFr 2  09 30              ORA   #'0'
0004B1r 2  8D 0E A0           STA   VGC_CHAROUT
0004B4r 2  A2 01              LDX   #1
0004B6r 2               @skip_h:
0004B6r 2  68                 PLA
0004B7r 2  A0 00              LDY   #0
0004B9r 2               @tens:
0004B9r 2  C9 0A              CMP   #10
0004BBr 2  90 06              BCC   @ones
0004BDr 2  38                 SEC
0004BEr 2  E9 0A              SBC   #10
0004C0r 2  C8                 INY
0004C1r 2  80 F6              BRA   @tens
0004C3r 2               @ones:
0004C3r 2  48                 PHA
0004C4r 2  98                 TYA
0004C5r 2  D0 04              BNE   @print_t
0004C7r 2  E0 00              CPX   #0
0004C9r 2  F0 05              BEQ   @skip_t
0004CBr 2               @print_t:
0004CBr 2  09 30              ORA   #'0'
0004CDr 2  8D 0E A0           STA   VGC_CHAROUT
0004D0r 2               @skip_t:
0004D0r 2  68                 PLA
0004D1r 2  09 30              ORA   #'0'
0004D3r 2  8D 0E A0           STA   VGC_CHAROUT
0004D6r 2  60                 RTS
0004D7r 2               
0004D7r 2               ; =====================================================================
0004D7r 2               ; RODATA — tokenizer strings
0004D7r 2               ; =====================================================================
0004D7r 2                     .segment "RODATA"
000000r 2               
000000r 2               str_tokens:
000000r 2  20 54 4F 4B        .byte " TOKENS", 0
000004r 2  45 4E 53 00  
000008r 2               
000008r 1                     .include "eval.s"
000008r 2               ; eval.s — evaluator: walk token list and dispatch commands
000008r 2               
000008r 2               ; =====================================================================
000008r 2               ; ZEROPAGE segment — evaluator variables
000008r 2               ; =====================================================================
000008r 2                     .segment "ZEROPAGE"
00000Cr 2               
00000Cr 2  xx           eval_type:      .res 1    ; result type: $00=number, $01=word
00000Dr 2  xx           eval_val_hi:    .res 1    ; number high byte or word ptr high
00000Er 2  xx           eval_val_lo:    .res 1    ; number low byte or word ptr low
00000Fr 2  xx           eval_val_frac:  .res 1    ; number fractional byte
000010r 2  xx           eval_cur_lo:    .res 1    ; current token pointer (low)
000011r 2  xx           eval_cur_hi:    .res 1    ; current token pointer (high)
000012r 2  xx           eval_left_hi:   .res 1    ; saved left operand high byte
000013r 2  xx           eval_left_lo:   .res 1    ; saved left operand low byte
000014r 2  xx           eval_left_frac: .res 1    ; saved left operand fractional byte
000015r 2  xx           eval_op:        .res 1    ; infix operator character
000016r 2  xx           handler_lo:     .res 1    ; saved handler address for JMP
000017r 2  xx           handler_hi:     .res 1
000018r 2  xx           eval_in_body:   .res 1    ; $00 = normal eval_loop, $01 = in body
000019r 2  xx           proc_stopped:   .res 1    ; $00 = running, $01 = STOP, $02 = OUTPUT
00001Ar 2  xx           eval_reporter:  .res 1    ; $00 = normal, $01 = reporter mode (return from eval_continue)
00001Br 2               
00001Br 2               ; --- Catch frame for CATCH/THROW error handling ---
00001Br 2  xx           catch_active:   .res 1    ; $00 = no catch, $01 = catch active
00001Cr 2  xx           catch_tag_lo:   .res 1    ; pointer to tag word (length-prefixed)
00001Dr 2  xx           catch_tag_hi:   .res 1
00001Er 2  xx           catch_sp:       .res 1    ; saved 6502 stack pointer for unwinding
00001Fr 2  xx           catch_resume_lo: .res 1   ; eval_cur to resume at (past the body's ])
000020r 2  xx           catch_resume_hi: .res 1
000021r 2               
000021r 2               ; =====================================================================
000021r 2               ; BSS segment — scratch for number printing
000021r 2               ; =====================================================================
000021r 2                     .segment "BSS"
000007r 2               
000007r 2  xx xx xx xx  pn_buf:         .res 8    ; decimal digit buffer for print_number
00000Br 2  xx xx xx xx  
00000Fr 2               
00000Fr 2               ; =====================================================================
00000Fr 2               ; CODE segment — evaluator routines
00000Fr 2               ; =====================================================================
00000Fr 2                     .segment "CODE"
0004D7r 2               
0004D7r 2               ; ---------------------------------------------------------------------
0004D7r 2               ; eval_line — evaluate the token list built by tokenize_line
0004D7r 2               ;   Input:  tok_head_lo/hi = first token
0004D7r 2               ;   Output: commands executed, errors printed
0004D7r 2               ; ---------------------------------------------------------------------
0004D7r 2               eval_line:
0004D7r 2  64 rr              STZ   eval_in_body
0004D9r 2  64 rr              STZ   proc_stopped
0004DBr 2  64 rr              STZ   eval_reporter
0004DDr 2  A5 rr              LDA   tok_head_lo
0004DFr 2  85 rr              STA   eval_cur_lo
0004E1r 2  A5 rr              LDA   tok_head_hi
0004E3r 2  85 rr              STA   eval_cur_hi
0004E5r 2               
0004E5r 2               eval_loop:
0004E5r 2                     ; Check if STOP/OUTPUT was signaled — bail out
0004E5r 2  A5 rr              LDA   proc_stopped
0004E7r 2  D0 1B              BNE   @bail_out
0004E9r 2               
0004E9r 2                     ; Check for end of list
0004E9r 2  A5 rr              LDA   eval_cur_lo
0004EBr 2  05 rr              ORA   eval_cur_hi
0004EDr 2  F0 15              BEQ   @bail_out
0004EFr 2               
0004EFr 2                     ; Read tag of current token
0004EFr 2  A5 rr              LDA   eval_cur_lo
0004F1r 2  85 rr              STA   ptr_lo
0004F3r 2  A5 rr              LDA   eval_cur_hi
0004F5r 2  85 rr              STA   ptr_hi
0004F7r 2  A0 00              LDY   #TOK_TAG
0004F9r 2  B1 rr              LDA   (ptr_lo),Y
0004FBr 2               
0004FBr 2                     ; Dispatch based on tag
0004FBr 2  C9 01              CMP   #TOK_WORD
0004FDr 2  F0 06              BEQ   @do_command
0004FFr 2               
0004FFr 2                     ; Bare expression — skip it for now (could error)
0004FFr 2                     ; Advance to next token
0004FFr 2  20 rr rr           JSR   eval_advance
000502r 2  80 E1              BRA   eval_loop
000504r 2               
000504r 2               @bail_out:
000504r 2  60                 RTS
000505r 2               
000505r 2               @do_command:
000505r 2                     ; Look up the word in the builtin table
000505r 2  20 rr rr           JSR   lookup_builtin
000508r 2  B0 42              BCS   @unknown
00050Ar 2               
00050Ar 2                     ; Found: handler addr is in ptr2_lo/hi, arity in A
00050Ar 2                     ; Save handler address — eval_expr may clobber ptr2
00050Ar 2  A6 rr              LDX   ptr2_lo
00050Cr 2  86 rr              STX   handler_lo
00050Er 2  A6 rr              LDX   ptr2_hi
000510r 2  86 rr              STX   handler_hi
000512r 2                     ; Save arity across eval_advance (which clobbers X)
000512r 2  AA                 TAX
000513r 2  DA                 PHX
000514r 2                     ; Advance past the command word token
000514r 2  20 rr rr           JSR   eval_advance
000517r 2  FA                 PLX
000518r 2               
000518r 2                     ; Evaluate arguments (X = arity count)
000518r 2  E0 00              CPX   #0
00051Ar 2  F0 16              BEQ   @call_handler
00051Cr 2                     ; Save handler address — eval_expr may invoke proc_invoke which
00051Cr 2                     ; clobbers handler_lo/hi via inner eval_loop dispatch
00051Cr 2  A5 rr              LDA   handler_hi
00051Er 2  48                 PHA
00051Fr 2  A5 rr              LDA   handler_lo
000521r 2  48                 PHA
000522r 2               @eval_args:
000522r 2  DA                 PHX                   ; save remaining arg count
000523r 2  20 rr rr           JSR   eval_expr
000526r 2  B0 0D              BCS   @arg_error
000528r 2  FA                 PLX
000529r 2  CA                 DEX
00052Ar 2  D0 F6              BNE   @eval_args
00052Cr 2                     ; Restore handler address
00052Cr 2  68                 PLA
00052Dr 2  85 rr              STA   handler_lo
00052Fr 2  68                 PLA
000530r 2  85 rr              STA   handler_hi
000532r 2               
000532r 2               @call_handler:
000532r 2                     ; Call the handler via indirect JMP
000532r 2  6C rr rr           JMP   (handler_lo)
000535r 2                     ; handlers must JMP back to eval_loop via eval_continue
000535r 2               
000535r 2               @arg_error:
000535r 2  FA                 PLX                   ; discard saved arity counter
000536r 2                     ; Discard saved handler address
000536r 2  68                 PLA
000537r 2  68                 PLA
000538r 2                     ; Print error and abort line
000538r 2  A2 00              LDX   #0
00053Ar 2               @ae_lp:
00053Ar 2  BD rr rr           LDA   str_notenough,X
00053Dr 2  F0 06              BEQ   @ae_done
00053Fr 2  8D 0E A0           STA   VGC_CHAROUT
000542r 2  E8                 INX
000543r 2  D0 F5              BNE   @ae_lp
000545r 2               @ae_done:
000545r 2  20 rr rr           JSR   eval_newline
000548r 2  20 rr rr           JSR   try_throw_error
00054Br 2  60                 RTS
00054Cr 2               
00054Cr 2               @unknown:
00054Cr 2                     ; Try user-defined procedures before erroring
00054Cr 2  20 rr rr           JSR   proc_lookup
00054Fr 2  B0 06              BCS   @try_ext_cmd
000551r 2                     ; Found a procedure — invoke it (proc_stopped restored internally)
000551r 2  20 rr rr           JSR   proc_invoke
000554r 2  4C rr rr           JMP   eval_loop
000557r 2               
000557r 2               @try_ext_cmd:
000557r 2                     ; Try extension command table before giving up
000557r 2  20 rr rr           JSR   lookup_ext_cmd
00055Ar 2  B0 35              BCS   @truly_unknown
00055Cr 2                     ; Found: A = arity, ext_cmd set.
00055Cr 2                     ; Advance past the command word token.
00055Cr 2  AA                 TAX                       ; X = arity
00055Dr 2  DA                 PHX
00055Er 2  20 rr rr           JSR   eval_advance
000561r 2  FA                 PLX
000562r 2                     ; Evaluate arguments and copy to ext_arg slots
000562r 2  20 rr rr           JSR   ext_eval_args
000565r 2  B0 16              BCS   @ext_arg_err
000567r 2                     ; Call extension via RAM trampoline
000567r 2  20 70 02           JSR   EXT_TRAMPOLINE
00056Ar 2                     ; Copy result back to eval_val
00056Ar 2  A5 8E              LDA   EXT_RESULT_TYPE
00056Cr 2  85 rr              STA   eval_type
00056Er 2  A5 8F              LDA   EXT_RESULT_HI
000570r 2  85 rr              STA   eval_val_hi
000572r 2  A5 90              LDA   EXT_RESULT_LO
000574r 2  85 rr              STA   eval_val_lo
000576r 2  A5 91              LDA   EXT_RESULT_FRAC
000578r 2  85 rr              STA   eval_val_frac
00057Ar 2  4C rr rr           JMP   eval_continue
00057Dr 2               
00057Dr 2               @ext_arg_err:
00057Dr 2  A2 00              LDX   #0
00057Fr 2               @eae_lp:
00057Fr 2  BD rr rr           LDA   str_notenough,X
000582r 2  F0 06              BEQ   @eae_done
000584r 2  8D 0E A0           STA   VGC_CHAROUT
000587r 2  E8                 INX
000588r 2  D0 F5              BNE   @eae_lp
00058Ar 2               @eae_done:
00058Ar 2  20 rr rr           JSR   eval_newline
00058Dr 2  20 rr rr           JSR   try_throw_error
000590r 2  60                 RTS
000591r 2               
000591r 2               @truly_unknown:
000591r 2                     ; Print "I don't know how to " + the word
000591r 2  A2 00              LDX   #0
000593r 2               @unk_lp:
000593r 2  BD rr rr           LDA   str_idk,X
000596r 2  F0 06              BEQ   @unk_word
000598r 2  8D 0E A0           STA   VGC_CHAROUT
00059Br 2  E8                 INX
00059Cr 2  D0 F5              BNE   @unk_lp
00059Er 2               @unk_word:
00059Er 2                     ; Print the word from the token payload
00059Er 2  A5 rr              LDA   eval_cur_lo
0005A0r 2  85 rr              STA   ptr_lo
0005A2r 2  A5 rr              LDA   eval_cur_hi
0005A4r 2  85 rr              STA   ptr_hi
0005A6r 2  A0 03              LDY   #TOK_PAYLOAD        ; length byte
0005A8r 2  B1 rr              LDA   (ptr_lo),Y
0005AAr 2  AA                 TAX                       ; X = length
0005ABr 2  A0 04              LDY   #TOK_PAYLOAD+1      ; first char
0005ADr 2               @unk_ch:
0005ADr 2  B1 rr              LDA   (ptr_lo),Y
0005AFr 2  8D 0E A0           STA   VGC_CHAROUT
0005B2r 2  C8                 INY
0005B3r 2  CA                 DEX
0005B4r 2  D0 F7              BNE   @unk_ch
0005B6r 2  20 rr rr           JSR   eval_newline
0005B9r 2  20 rr rr           JSR   try_throw_error
0005BCr 2  60                 RTS
0005BDr 2               
0005BDr 2               @done:
0005BDr 2  60                 RTS
0005BEr 2               
0005BEr 2               ; ---------------------------------------------------------------------
0005BEr 2               ; eval_continue — handlers JMP here to resume the eval loop
0005BEr 2               ;   If eval_in_body != 0, resumes body execution instead
0005BEr 2               ; ---------------------------------------------------------------------
0005BEr 2               ; ---------------------------------------------------------------------
0005BEr 2               ; jmp_handler — trampoline for calling builtins from reporter position
0005BEr 2               ; ---------------------------------------------------------------------
0005BEr 2               jmp_handler:
0005BEr 2  6C rr rr           JMP   (handler_lo)
0005C1r 2               
0005C1r 2               eval_continue:
0005C1r 2                     ; If in reporter mode, return to eval_expr instead of looping
0005C1r 2  A5 rr              LDA   eval_reporter
0005C3r 2  D0 07              BNE   @reporter_return
0005C5r 2  A5 rr              LDA   eval_in_body
0005C7r 2  D0 07              BNE   eval_body
0005C9r 2  4C rr rr           JMP   eval_loop
0005CCr 2               
0005CCr 2               @reporter_return:
0005CCr 2  64 rr              STZ   eval_reporter
0005CEr 2  18                 CLC
0005CFr 2  60                 RTS
0005D0r 2               
0005D0r 2               ; ---------------------------------------------------------------------
0005D0r 2               ; eval_body — execute tokens within a body until TOK_RBRACKET at depth 0
0005D0r 2               ;   Entry: eval_cur is at the next token to execute inside the body
0005D0r 2               ;   Exit:  eval_cur points at the TOK_RBRACKET that ended the body
0005D0r 2               ;   eval_in_body must be $01 on entry
0005D0r 2               ; ---------------------------------------------------------------------
0005D0r 2               eval_body:
0005D0r 2                     ; Check if STOP/OUTPUT was signaled — bail out immediately
0005D0r 2  A5 rr              LDA   proc_stopped
0005D2r 2  D0 65              BNE   @done
0005D4r 2               
0005D4r 2                     ; Check for end of list (safety — malformed input)
0005D4r 2  A5 rr              LDA   eval_cur_lo
0005D6r 2  05 rr              ORA   eval_cur_hi
0005D8r 2  F0 5F              BEQ   @done
0005DAr 2               
0005DAr 2                     ; Read tag of current token
0005DAr 2  A5 rr              LDA   eval_cur_lo
0005DCr 2  85 rr              STA   ptr_lo
0005DEr 2  A5 rr              LDA   eval_cur_hi
0005E0r 2  85 rr              STA   ptr_hi
0005E2r 2  A0 00              LDY   #TOK_TAG
0005E4r 2  B1 rr              LDA   (ptr_lo),Y
0005E6r 2               
0005E6r 2                     ; Hit the closing bracket? We're done with this body pass.
0005E6r 2  C9 04              CMP   #TOK_RBRACKET
0005E8r 2  F0 4F              BEQ   @done
0005EAr 2               
0005EAr 2                     ; Dispatch command words (same as eval_loop)
0005EAr 2  C9 01              CMP   #TOK_WORD
0005ECr 2  F0 05              BEQ   @do_command
0005EEr 2               
0005EEr 2                     ; Skip non-word tokens (bare numbers, brackets inside expressions, etc.)
0005EEr 2  20 rr rr           JSR   eval_advance
0005F1r 2  80 DD              BRA   eval_body
0005F3r 2               
0005F3r 2               @do_command:
0005F3r 2                     ; Same dispatch as eval_loop — look up builtin, eval args, call handler
0005F3r 2  20 rr rr           JSR   lookup_builtin
0005F6r 2  B0 42              BCS   @unknown
0005F8r 2               
0005F8r 2  A6 rr              LDX   ptr2_lo
0005FAr 2  86 rr              STX   handler_lo
0005FCr 2  A6 rr              LDX   ptr2_hi
0005FEr 2  86 rr              STX   handler_hi
000600r 2  AA                 TAX
000601r 2  DA                 PHX
000602r 2  20 rr rr           JSR   eval_advance
000605r 2  FA                 PLX
000606r 2               
000606r 2  E0 00              CPX   #0
000608r 2  F0 16              BEQ   @call_handler
00060Ar 2                     ; Save handler address — eval_expr may invoke proc_invoke
00060Ar 2  A5 rr              LDA   handler_hi
00060Cr 2  48                 PHA
00060Dr 2  A5 rr              LDA   handler_lo
00060Fr 2  48                 PHA
000610r 2               @eval_args:
000610r 2  DA                 PHX
000611r 2  20 rr rr           JSR   eval_expr
000614r 2  B0 0D              BCS   @arg_error
000616r 2  FA                 PLX
000617r 2  CA                 DEX
000618r 2  D0 F6              BNE   @eval_args
00061Ar 2                     ; Restore handler address
00061Ar 2  68                 PLA
00061Br 2  85 rr              STA   handler_lo
00061Dr 2  68                 PLA
00061Er 2  85 rr              STA   handler_hi
000620r 2               
000620r 2               @call_handler:
000620r 2  6C rr rr           JMP   (handler_lo)
000623r 2                     ; handler JMPs to eval_continue, which routes back here
000623r 2               
000623r 2               @arg_error:
000623r 2  FA                 PLX
000624r 2  68                 PLA
000625r 2  68                 PLA
000626r 2  A2 00              LDX   #0
000628r 2               @ae_lp:
000628r 2  BD rr rr           LDA   str_notenough,X
00062Br 2  F0 06              BEQ   @ae_done
00062Dr 2  8D 0E A0           STA   VGC_CHAROUT
000630r 2  E8                 INX
000631r 2  D0 F5              BNE   @ae_lp
000633r 2               @ae_done:
000633r 2  20 rr rr           JSR   eval_newline
000636r 2  20 rr rr           JSR   try_throw_error
000639r 2                     ; fall through to @done — abort body on error
000639r 2               
000639r 2               @done:
000639r 2  60                 RTS
00063Ar 2               
00063Ar 2               @unknown:
00063Ar 2                     ; Try user-defined procedures before erroring (inside body)
00063Ar 2  20 rr rr           JSR   proc_lookup
00063Dr 2  B0 06              BCS   @try_ext_cmd
00063Fr 2  20 rr rr           JSR   proc_invoke
000642r 2  4C rr rr           JMP   eval_body
000645r 2               
000645r 2               @try_ext_cmd:
000645r 2                     ; Try extension command table before giving up (inside body)
000645r 2  20 rr rr           JSR   lookup_ext_cmd
000648r 2  B0 35              BCS   @truly_unknown
00064Ar 2  AA                 TAX
00064Br 2  DA                 PHX
00064Cr 2  20 rr rr           JSR   eval_advance
00064Fr 2  FA                 PLX
000650r 2  20 rr rr           JSR   ext_eval_args
000653r 2  B0 16              BCS   @body_ext_err
000655r 2  20 70 02           JSR   EXT_TRAMPOLINE
000658r 2  A5 8E              LDA   EXT_RESULT_TYPE
00065Ar 2  85 rr              STA   eval_type
00065Cr 2  A5 8F              LDA   EXT_RESULT_HI
00065Er 2  85 rr              STA   eval_val_hi
000660r 2  A5 90              LDA   EXT_RESULT_LO
000662r 2  85 rr              STA   eval_val_lo
000664r 2  A5 91              LDA   EXT_RESULT_FRAC
000666r 2  85 rr              STA   eval_val_frac
000668r 2  4C rr rr           JMP   eval_continue
00066Br 2               
00066Br 2               @body_ext_err:
00066Br 2  A2 00              LDX   #0
00066Dr 2               @bee_lp:
00066Dr 2  BD rr rr           LDA   str_notenough,X
000670r 2  F0 06              BEQ   @bee_done
000672r 2  8D 0E A0           STA   VGC_CHAROUT
000675r 2  E8                 INX
000676r 2  D0 F5              BNE   @bee_lp
000678r 2               @bee_done:
000678r 2  20 rr rr           JSR   eval_newline
00067Br 2  20 rr rr           JSR   try_throw_error
00067Er 2  60                 RTS
00067Fr 2               
00067Fr 2               @truly_unknown:
00067Fr 2                     ; Print "I don't know how to " + the word (inside body)
00067Fr 2  A2 00              LDX   #0
000681r 2               @unk_lp:
000681r 2  BD rr rr           LDA   str_idk,X
000684r 2  F0 06              BEQ   @unk_word
000686r 2  8D 0E A0           STA   VGC_CHAROUT
000689r 2  E8                 INX
00068Ar 2  D0 F5              BNE   @unk_lp
00068Cr 2               @unk_word:
00068Cr 2  A5 rr              LDA   eval_cur_lo
00068Er 2  85 rr              STA   ptr_lo
000690r 2  A5 rr              LDA   eval_cur_hi
000692r 2  85 rr              STA   ptr_hi
000694r 2  A0 03              LDY   #TOK_PAYLOAD
000696r 2  B1 rr              LDA   (ptr_lo),Y
000698r 2  AA                 TAX
000699r 2  A0 04              LDY   #TOK_PAYLOAD+1
00069Br 2               @unk_ch:
00069Br 2  B1 rr              LDA   (ptr_lo),Y
00069Dr 2  8D 0E A0           STA   VGC_CHAROUT
0006A0r 2  C8                 INY
0006A1r 2  CA                 DEX
0006A2r 2  D0 F7              BNE   @unk_ch
0006A4r 2  20 rr rr           JSR   eval_newline
0006A7r 2  20 rr rr           JSR   try_throw_error
0006AAr 2  60                 RTS
0006ABr 2               
0006ABr 2               ; ---------------------------------------------------------------------
0006ABr 2               ; eval_advance — advance eval_cur to the next token in the list
0006ABr 2               ;   Reads next pointer from current token, stores in eval_cur
0006ABr 2               ; ---------------------------------------------------------------------
0006ABr 2               eval_advance:
0006ABr 2  A5 rr              LDA   eval_cur_lo
0006ADr 2  85 rr              STA   ptr_lo
0006AFr 2  A5 rr              LDA   eval_cur_hi
0006B1r 2  85 rr              STA   ptr_hi
0006B3r 2  A0 01              LDY   #TOK_NEXT_LO
0006B5r 2  B1 rr              LDA   (ptr_lo),Y
0006B7r 2  AA                 TAX
0006B8r 2  C8                 INY
0006B9r 2  B1 rr              LDA   (ptr_lo),Y
0006BBr 2  85 rr              STA   eval_cur_hi
0006BDr 2  86 rr              STX   eval_cur_lo
0006BFr 2  60                 RTS
0006C0r 2               
0006C0r 2               ; ---------------------------------------------------------------------
0006C0r 2               ; eval_expr — evaluate one expression from the current token
0006C0r 2               ;   Output: eval_type, eval_val_hi/lo/frac set
0006C0r 2               ;           Carry clear = success, Carry set = error (no token)
0006C0r 2               ;   Advances eval_cur past the consumed token
0006C0r 2               ; ---------------------------------------------------------------------
0006C0r 2               eval_expr:
0006C0r 2                     ; Check for end of list
0006C0r 2  A5 rr              LDA   eval_cur_lo
0006C2r 2  05 rr              ORA   eval_cur_hi
0006C4r 2  D0 02              BNE   @have_token
0006C6r 2  38                 SEC                       ; no more tokens
0006C7r 2  60                 RTS
0006C8r 2               
0006C8r 2               @have_token:
0006C8r 2  A5 rr              LDA   eval_cur_lo
0006CAr 2  85 rr              STA   ptr_lo
0006CCr 2  A5 rr              LDA   eval_cur_hi
0006CEr 2  85 rr              STA   ptr_hi
0006D0r 2  A0 00              LDY   #TOK_TAG
0006D2r 2  B1 rr              LDA   (ptr_lo),Y
0006D4r 2               
0006D4r 2  C9 02              CMP   #TOK_NUMBER
0006D6r 2  D0 03              BNE   :+
0006D8r 2  4C rr rr           JMP   @number
0006DBr 2  C9 06        :     CMP   #TOK_QUOTE
0006DDr 2  D0 03              BNE   :+
0006DFr 2  4C rr rr           JMP   @quote
0006E2r 2  C9 05        :     CMP   #TOK_VARREF
0006E4r 2  D0 03              BNE   :+
0006E6r 2  4C rr rr           JMP   @varref
0006E9r 2  C9 01        :     CMP   #TOK_WORD
0006EBr 2  F0 06              BEQ   @word_expr
0006EDr 2  C9 03              CMP   #TOK_LBRACKET
0006EFr 2  F0 19              BEQ   @list_literal
0006F1r 2                     ; Anything else is an error
0006F1r 2  38                 SEC
0006F2r 2  60                 RTS
0006F3r 2               
0006F3r 2               @word_expr:
0006F3r 2                     ; Could be a reporter procedure (returns a value via OUTPUT)
0006F3r 2  20 rr rr           JSR   proc_lookup
0006F6r 2  B0 19              BCS   @word_not_proc        ; not a procedure — try builtins
0006F8r 2                     ; It's a procedure — invoke it
0006F8r 2  20 rr rr           JSR   proc_invoke
0006FBr 2                     ; X = exit status: $02 = OUTPUT (eval_val has value), else no value
0006FBr 2  E0 02              CPX   #$02
0006FDr 2  F0 08              BEQ   @word_has_val
0006FFr 2                     ; No OUTPUT — set result to 0
0006FFr 2  64 rr              STZ   eval_val_hi
000701r 2  64 rr              STZ   eval_val_lo
000703r 2  64 rr              STZ   eval_val_frac
000705r 2  64 rr              STZ   eval_type
000707r 2               @word_has_val:
000707r 2  4C rr rr           JMP   eval_check_infix      ; allow DOUBLE 5 + 3 etc.
00070Ar 2               
00070Ar 2               @list_literal:
00070Ar 2                     ; Advance past the [
00070Ar 2  20 rr rr           JSR   eval_advance
00070Dr 2                     ; Build list from tokens until ]
00070Dr 2  20 rr rr           JSR   eval_list
000710r 2                     ; eval_type = VAL_LIST, eval_val = head pointer
000710r 2                     ; Carry already set/clear from eval_list
000710r 2  60                 RTS
000711r 2               
000711r 2               @word_not_proc:
000711r 2                     ; Not a user proc — try built-in reporter
000711r 2  20 rr rr           JSR   lookup_builtin
000714r 2  B0 37              BCS   @word_unknown
000716r 2                     ; Found: ptr2_lo/hi = handler addr, A = arity
000716r 2                     ; Save handler address
000716r 2  A6 rr              LDX   ptr2_lo
000718r 2  86 rr              STX   handler_lo
00071Ar 2  A6 rr              LDX   ptr2_hi
00071Cr 2  86 rr              STX   handler_hi
00071Er 2  AA                 TAX                       ; X = arity
00071Fr 2  DA                 PHX                       ; save arity across eval_advance
000720r 2                     ; Advance past the command word
000720r 2  20 rr rr           JSR   eval_advance
000723r 2  FA                 PLX                       ; restore arity
000724r 2                     ; Evaluate arguments (X = arity count)
000724r 2  E0 00              CPX   #0
000726r 2  F0 16              BEQ   @call_reporter
000728r 2                     ; Save handler address — eval_expr may clobber it
000728r 2  A5 rr              LDA   handler_hi
00072Ar 2  48                 PHA
00072Br 2  A5 rr              LDA   handler_lo
00072Dr 2  48                 PHA
00072Er 2               @rpt_eval_args:
00072Er 2  DA                 PHX
00072Fr 2  20 rr rr           JSR   eval_expr
000732r 2  B0 14              BCS   @rpt_arg_error
000734r 2  FA                 PLX
000735r 2  CA                 DEX
000736r 2  D0 F6              BNE   @rpt_eval_args
000738r 2                     ; Restore handler address
000738r 2  68                 PLA
000739r 2  85 rr              STA   handler_lo
00073Br 2  68                 PLA
00073Cr 2  85 rr              STA   handler_hi
00073Er 2               @call_reporter:
00073Er 2                     ; Set reporter mode so eval_continue returns here instead of looping
00073Er 2  A9 01              LDA   #$01
000740r 2  85 rr              STA   eval_reporter
000742r 2                     ; Call via JSR to trampoline — handler JMPs to eval_continue
000742r 2                     ; which sees eval_reporter and does CLC + RTS back here.
000742r 2  20 rr rr           JSR   jmp_handler
000745r 2                     ; eval_val now set by the handler
000745r 2  4C rr rr           JMP   eval_check_infix
000748r 2               
000748r 2               @rpt_arg_error:
000748r 2  FA                 PLX                       ; discard saved arity counter
000749r 2  68                 PLA
00074Ar 2  68                 PLA                       ; discard saved handler address
00074Br 2  38                 SEC
00074Cr 2  60                 RTS
00074Dr 2               
00074Dr 2               @word_unknown:
00074Dr 2                     ; Try extension command table as reporter
00074Dr 2  20 rr rr           JSR   lookup_ext_cmd
000750r 2  B0 22              BCS   @word_really_unknown
000752r 2                     ; Found: A = arity, EXT_CMD set
000752r 2  AA                 TAX
000753r 2  DA                 PHX
000754r 2  20 rr rr           JSR   eval_advance
000757r 2  FA                 PLX
000758r 2  20 rr rr           JSR   ext_eval_args
00075Br 2  B0 17              BCS   @word_really_unknown
00075Dr 2  20 70 02           JSR   EXT_TRAMPOLINE
000760r 2                     ; Copy result back to eval_val
000760r 2  A5 8E              LDA   EXT_RESULT_TYPE
000762r 2  85 rr              STA   eval_type
000764r 2  A5 8F              LDA   EXT_RESULT_HI
000766r 2  85 rr              STA   eval_val_hi
000768r 2  A5 90              LDA   EXT_RESULT_LO
00076Ar 2  85 rr              STA   eval_val_lo
00076Cr 2  A5 91              LDA   EXT_RESULT_FRAC
00076Er 2  85 rr              STA   eval_val_frac
000770r 2  18                 CLC
000771r 2  4C rr rr           JMP   eval_check_infix
000774r 2               
000774r 2               @word_really_unknown:
000774r 2  38                 SEC
000775r 2  60                 RTS
000776r 2               
000776r 2               @number:
000776r 2                     ; Copy 3-byte payload to eval_val
000776r 2  A0 03              LDY   #TOK_PAYLOAD
000778r 2  B1 rr              LDA   (ptr_lo),Y         ; int_hi
00077Ar 2  85 rr              STA   eval_val_hi
00077Cr 2  C8                 INY
00077Dr 2  B1 rr              LDA   (ptr_lo),Y         ; int_lo
00077Fr 2  85 rr              STA   eval_val_lo
000781r 2  C8                 INY
000782r 2  B1 rr              LDA   (ptr_lo),Y         ; frac
000784r 2  85 rr              STA   eval_val_frac
000786r 2  64 rr              STZ   eval_type           ; $00 = number
000788r 2  20 rr rr           JSR   eval_advance
00078Br 2  4C rr rr           JMP   eval_check_infix    ; check for infix operator
00078Er 2               
00078Er 2               @quote:
00078Er 2                     ; Point eval_val at the payload (length byte + chars)
00078Er 2                     ; Pointer = ptr_lo/hi + TOK_PAYLOAD
00078Er 2  18                 CLC
00078Fr 2  A5 rr              LDA   ptr_lo
000791r 2  69 03              ADC   #TOK_PAYLOAD
000793r 2  85 rr              STA   eval_val_lo
000795r 2  A5 rr              LDA   ptr_hi
000797r 2  69 00              ADC   #0
000799r 2  85 rr              STA   eval_val_hi
00079Br 2  64 rr              STZ   eval_val_frac
00079Dr 2  A9 01              LDA   #$01
00079Fr 2  85 rr              STA   eval_type           ; $01 = word
0007A1r 2  20 rr rr           JSR   eval_advance
0007A4r 2  18                 CLC
0007A5r 2  60                 RTS
0007A6r 2               
0007A6r 2               @varref:
0007A6r 2                     ; Variable reference — :NAME
0007A6r 2                     ; Payload is length-prefixed name at token + TOK_PAYLOAD
0007A6r 2  18                 CLC
0007A7r 2  A5 rr              LDA   ptr_lo
0007A9r 2  69 03              ADC   #TOK_PAYLOAD
0007ABr 2  85 rr              STA   ptr_lo
0007ADr 2  A5 rr              LDA   ptr_hi
0007AFr 2  69 00              ADC   #0
0007B1r 2  85 rr              STA   ptr_hi
0007B3r 2  20 rr rr           JSR   var_get
0007B6r 2  90 30              BCC   @var_ok
0007B8r 2               
0007B8r 2                     ; Not found — print "NAME has no value"
0007B8r 2                     ; ptr_lo/hi was clobbered by var_get, reload from eval_cur
0007B8r 2  A5 rr              LDA   eval_cur_lo
0007BAr 2  85 rr              STA   ptr_lo
0007BCr 2  A5 rr              LDA   eval_cur_hi
0007BEr 2  85 rr              STA   ptr_hi
0007C0r 2  A0 03              LDY   #TOK_PAYLOAD          ; length byte
0007C2r 2  B1 rr              LDA   (ptr_lo),Y
0007C4r 2  AA                 TAX                         ; X = name length
0007C5r 2  A0 04              LDY   #TOK_PAYLOAD+1
0007C7r 2               @vr_name:
0007C7r 2  B1 rr              LDA   (ptr_lo),Y
0007C9r 2  8D 0E A0           STA   VGC_CHAROUT
0007CCr 2  C8                 INY
0007CDr 2  CA                 DEX
0007CEr 2  D0 F7              BNE   @vr_name
0007D0r 2  A2 00              LDX   #0
0007D2r 2               @vr_msg:
0007D2r 2  BD rr rr           LDA   str_no_value,X
0007D5r 2  F0 06              BEQ   @vr_done
0007D7r 2  8D 0E A0           STA   VGC_CHAROUT
0007DAr 2  E8                 INX
0007DBr 2  D0 F5              BNE   @vr_msg
0007DDr 2               @vr_done:
0007DDr 2  20 rr rr           JSR   eval_newline
0007E0r 2  20 rr rr           JSR   try_throw_error
0007E3r 2  20 rr rr           JSR   eval_advance
0007E6r 2  38                 SEC
0007E7r 2  60                 RTS
0007E8r 2               
0007E8r 2               @var_ok:
0007E8r 2                     ; eval_type and eval_val already set by var_get
0007E8r 2  20 rr rr           JSR   eval_advance
0007EBr 2  4C rr rr           JMP   eval_check_infix      ; allow :X + 5 etc.
0007EEr 2               
0007EEr 2               ; ---------------------------------------------------------------------
0007EEr 2               ; eval_newline — print CR+LF
0007EEr 2               ; ---------------------------------------------------------------------
0007EEr 2               eval_newline:
0007EEr 2  A9 0D              LDA   #$0D
0007F0r 2  8D 0E A0           STA   VGC_CHAROUT
0007F3r 2  A9 0A              LDA   #$0A
0007F5r 2  8D 0E A0           STA   VGC_CHAROUT
0007F8r 2  60                 RTS
0007F9r 2               
0007F9r 2               ; ---------------------------------------------------------------------
0007F9r 2               ; eval_check_infix — if next token is TOK_INFIX, evaluate binary op
0007F9r 2               ;   Entry: eval_val holds the left operand (primary value)
0007F9r 2               ;   Exit:  eval_val holds the result, carry clear = success
0007F9r 2               ; ---------------------------------------------------------------------
0007F9r 2               eval_check_infix:
0007F9r 2                     ; Is there a next token?
0007F9r 2  A5 rr              LDA   eval_cur_lo
0007FBr 2  05 rr              ORA   eval_cur_hi
0007FDr 2  F0 75              BEQ   @no_infix
0007FFr 2               
0007FFr 2                     ; Peek at the next token's tag
0007FFr 2  A5 rr              LDA   eval_cur_lo
000801r 2  85 rr              STA   ptr_lo
000803r 2  A5 rr              LDA   eval_cur_hi
000805r 2  85 rr              STA   ptr_hi
000807r 2  A0 00              LDY   #TOK_TAG
000809r 2  B1 rr              LDA   (ptr_lo),Y
00080Br 2  C9 07              CMP   #TOK_INFIX
00080Dr 2  D0 65              BNE   @no_infix
00080Fr 2               
00080Fr 2                     ; Save the left operand to ZP scratch
00080Fr 2  A5 rr              LDA   eval_val_hi
000811r 2  85 rr              STA   eval_left_hi
000813r 2  A5 rr              LDA   eval_val_lo
000815r 2  85 rr              STA   eval_left_lo
000817r 2  A5 rr              LDA   eval_val_frac
000819r 2  85 rr              STA   eval_left_frac
00081Br 2               
00081Br 2                     ; Read operator character from payload
00081Br 2  A0 03              LDY   #TOK_PAYLOAD
00081Dr 2  B1 rr              LDA   (ptr_lo),Y
00081Fr 2  85 rr              STA   eval_op
000821r 2               
000821r 2                     ; Advance past the infix token
000821r 2  20 rr rr           JSR   eval_advance
000824r 2               
000824r 2                     ; Push left operand and operator onto hardware stack so recursive
000824r 2                     ; proc_invoke calls (which may evaluate their own infix expressions)
000824r 2                     ; cannot clobber them.
000824r 2  A5 rr              LDA   eval_left_hi
000826r 2  48                 PHA
000827r 2  A5 rr              LDA   eval_left_lo
000829r 2  48                 PHA
00082Ar 2  A5 rr              LDA   eval_left_frac
00082Cr 2  48                 PHA
00082Dr 2  A5 rr              LDA   eval_op
00082Fr 2  48                 PHA
000830r 2               
000830r 2                     ; Evaluate the right operand (recursive call)
000830r 2  20 rr rr           JSR   eval_expr
000833r 2  B0 41              BCS   @err_rhs_pop
000835r 2               
000835r 2                     ; Restore left operand and operator from stack
000835r 2  68                 PLA
000836r 2  85 rr              STA   eval_op
000838r 2  68                 PLA
000839r 2  85 rr              STA   eval_left_frac
00083Br 2  68                 PLA
00083Cr 2  85 rr              STA   eval_left_lo
00083Er 2  68                 PLA
00083Fr 2  85 rr              STA   eval_left_hi
000841r 2               
000841r 2                     ; Dispatch based on operator character
000841r 2  A5 rr              LDA   eval_op
000843r 2  C9 2B              CMP   #'+'
000845r 2  F0 35              BEQ   @do_add
000847r 2  C9 2D              CMP   #'-'
000849r 2  F0 46              BEQ   @do_sub
00084Br 2  C9 2A              CMP   #'*'
00084Dr 2  F0 57              BEQ   @do_mul
00084Fr 2  C9 2F              CMP   #'/'
000851r 2  F0 75              BEQ   @do_div
000853r 2  C9 3E              CMP   #'>'
000855r 2  D0 03              BNE   :+
000857r 2  4C rr rr           JMP   @do_gt
00085Ar 2  C9 3C        :     CMP   #'<'
00085Cr 2  D0 03              BNE   :+
00085Er 2  4C rr rr           JMP   @do_lt
000861r 2  C9 3D        :     CMP   #'='
000863r 2  D0 03              BNE   :+
000865r 2  4C rr rr           JMP   @do_eq
000868r 2               :
000868r 2                     ; Unknown operator — return left value unchanged
000868r 2  A5 rr              LDA   eval_left_hi
00086Ar 2  85 rr              STA   eval_val_hi
00086Cr 2  A5 rr              LDA   eval_left_lo
00086Er 2  85 rr              STA   eval_val_lo
000870r 2  A5 rr              LDA   eval_left_frac
000872r 2  85 rr              STA   eval_val_frac
000874r 2               
000874r 2               @no_infix:
000874r 2  18                 CLC
000875r 2  60                 RTS
000876r 2               
000876r 2               @err_rhs_pop:
000876r 2                     ; Discard saved left operand + operator (4 bytes)
000876r 2  68                 PLA
000877r 2  68                 PLA
000878r 2  68                 PLA
000879r 2  68                 PLA
00087Ar 2               @err_rhs:
00087Ar 2  38                 SEC
00087Br 2  60                 RTS
00087Cr 2               
00087Cr 2                     ; ----- Addition: left + right (24-bit: frac, lo, hi) -----
00087Cr 2               @do_add:
00087Cr 2  18                 CLC
00087Dr 2  A5 rr              LDA   eval_left_frac
00087Fr 2  65 rr              ADC   eval_val_frac
000881r 2  85 rr              STA   eval_val_frac
000883r 2  A5 rr              LDA   eval_left_lo
000885r 2  65 rr              ADC   eval_val_lo
000887r 2  85 rr              STA   eval_val_lo
000889r 2  A5 rr              LDA   eval_left_hi
00088Br 2  65 rr              ADC   eval_val_hi
00088Dr 2  85 rr              STA   eval_val_hi
00088Fr 2  18                 CLC
000890r 2  60                 RTS
000891r 2               
000891r 2                     ; ----- Subtraction: left - right (24-bit) -----
000891r 2               @do_sub:
000891r 2  38                 SEC
000892r 2  A5 rr              LDA   eval_left_frac
000894r 2  E5 rr              SBC   eval_val_frac
000896r 2  85 rr              STA   eval_val_frac
000898r 2  A5 rr              LDA   eval_left_lo
00089Ar 2  E5 rr              SBC   eval_val_lo
00089Cr 2  85 rr              STA   eval_val_lo
00089Er 2  A5 rr              LDA   eval_left_hi
0008A0r 2  E5 rr              SBC   eval_val_hi
0008A2r 2  85 rr              STA   eval_val_hi
0008A4r 2  18                 CLC
0008A5r 2  60                 RTS
0008A6r 2               
0008A6r 2                     ; ----- Multiplication: left * right via coprocessor -----
0008A6r 2                     ; Integer-only for this pass (frac ignored)
0008A6r 2               @do_mul:
0008A6r 2  A5 rr              LDA   eval_left_lo
0008A8r 2  8D 20 BB           STA   MATH_MUL16_A_LO
0008ABr 2  A5 rr              LDA   eval_left_hi
0008ADr 2  8D 21 BB           STA   MATH_MUL16_A_HI
0008B0r 2  A5 rr              LDA   eval_val_lo
0008B2r 2  8D 22 BB           STA   MATH_MUL16_B_LO
0008B5r 2  A5 rr              LDA   eval_val_hi
0008B7r 2  8D 23 BB           STA   MATH_MUL16_B_HI     ; write triggers multiply
0008BAr 2  AD 38 BB           LDA   MATH_RES0
0008BDr 2  85 rr              STA   eval_val_lo
0008BFr 2  AD 39 BB           LDA   MATH_RES1
0008C2r 2  85 rr              STA   eval_val_hi
0008C4r 2  64 rr              STZ   eval_val_frac
0008C6r 2  18                 CLC
0008C7r 2  60                 RTS
0008C8r 2               
0008C8r 2                     ; ----- Division: left / right via coprocessor -----
0008C8r 2                     ; Signed 32÷16: dividend = sign-extended left integer, divisor = right integer
0008C8r 2               @do_div:
0008C8r 2                     ; Check for divide by zero
0008C8r 2  A5 rr              LDA   eval_val_lo
0008CAr 2  05 rr              ORA   eval_val_hi
0008CCr 2  D0 08              BNE   @div_ok
0008CEr 2                     ; Division by zero — return 0
0008CEr 2  64 rr              STZ   eval_val_frac
0008D0r 2  64 rr              STZ   eval_val_lo
0008D2r 2  64 rr              STZ   eval_val_hi
0008D4r 2  18                 CLC
0008D5r 2  60                 RTS
0008D6r 2               @div_ok:
0008D6r 2                     ; Write 32-bit dividend (sign-extend left integer to 32 bits)
0008D6r 2  A5 rr              LDA   eval_left_lo
0008D8r 2  8D 28 BB           STA   MATH_DIV_N_LO
0008DBr 2  A5 rr              LDA   eval_left_hi
0008DDr 2  8D 29 BB           STA   MATH_DIV_N_1
0008E0r 2                     ; Sign-extend high word
0008E0r 2  A5 rr              LDA   eval_left_hi
0008E2r 2  09 7F              ORA   #$7F                 ; set bits 0-6
0008E4r 2  30 04              BMI   @neg_ext             ; if bit 7 was set, A=$FF (negative)
0008E6r 2  A9 00              LDA   #$00                 ; positive: extend with $00
0008E8r 2  80 00              BRA   @write_ext
0008EAr 2               @neg_ext:                        ; A is already $FF
0008EAr 2               @write_ext:
0008EAr 2  8D 2A BB           STA   MATH_DIV_N_2
0008EDr 2  8D 2B BB           STA   MATH_DIV_N_HI
0008F0r 2                     ; Write 16-bit divisor (right operand integer)
0008F0r 2  A5 rr              LDA   eval_val_lo
0008F2r 2  8D 2C BB           STA   MATH_DIV_D_LO
0008F5r 2  A5 rr              LDA   eval_val_hi
0008F7r 2  8D 2D BB           STA   MATH_DIV_D_HI       ; write triggers divide
0008FAr 2                     ; Read quotient from result
0008FAr 2  AD 38 BB           LDA   MATH_RES0
0008FDr 2  85 rr              STA   eval_val_lo
0008FFr 2  AD 39 BB           LDA   MATH_RES1
000902r 2  85 rr              STA   eval_val_hi
000904r 2  64 rr              STZ   eval_val_frac
000906r 2  18                 CLC
000907r 2  60                 RTS
000908r 2               
000908r 2                     ; ----- Equality: left = right (all 3 bytes must match) -----
000908r 2               @do_eq:
000908r 2  A5 rr              LDA   eval_left_hi
00090Ar 2  C5 rr              CMP   eval_val_hi
00090Cr 2  D0 64              BNE   @set_false
00090Er 2  A5 rr              LDA   eval_left_lo
000910r 2  C5 rr              CMP   eval_val_lo
000912r 2  D0 5E              BNE   @set_false
000914r 2  A5 rr              LDA   eval_left_frac
000916r 2  C5 rr              CMP   eval_val_frac
000918r 2  D0 58              BNE   @set_false
00091Ar 2  80 4A              BRA   @set_true
00091Cr 2               
00091Cr 2                     ; ----- Greater than: left > right (signed 24-bit) -----
00091Cr 2               @do_gt:
00091Cr 2                     ; Compare hi bytes (signed)
00091Cr 2  A5 rr              LDA   eval_left_hi
00091Er 2  38                 SEC
00091Fr 2  E5 rr              SBC   eval_val_hi
000921r 2  50 02              BVC   @gt_sign_ok           ; no overflow — N flag valid
000923r 2  49 80              EOR   #$80                  ; overflow — invert N to get true sign
000925r 2               @gt_sign_ok:
000925r 2  30 4B              BMI   @set_false            ; left_hi < right_hi → false
000927r 2                     ; If the subtraction was nonzero and positive, left > right
000927r 2  A5 rr              LDA   eval_left_hi
000929r 2  C5 rr              CMP   eval_val_hi
00092Br 2  D0 39              BNE   @set_true             ; hi bytes differ, and left > right
00092Dr 2                     ; Hi bytes equal — compare lo bytes (unsigned)
00092Dr 2  A5 rr              LDA   eval_left_lo
00092Fr 2  C5 rr              CMP   eval_val_lo
000931r 2  D0 0A              BNE   @gt_lo_diff
000933r 2                     ; Lo bytes equal — compare frac bytes (unsigned)
000933r 2  A5 rr              LDA   eval_left_frac
000935r 2  C5 rr              CMP   eval_val_frac
000937r 2  F0 39              BEQ   @set_false            ; all equal → not greater
000939r 2  B0 2B              BCS   @set_true
00093Br 2  80 35              BRA   @set_false
00093Dr 2               @gt_lo_diff:
00093Dr 2  B0 27              BCS   @set_true
00093Fr 2  80 31              BRA   @set_false
000941r 2               
000941r 2                     ; ----- Less than: left < right (signed 24-bit) -----
000941r 2               @do_lt:
000941r 2                     ; Compare hi bytes (signed)
000941r 2  A5 rr              LDA   eval_left_hi
000943r 2  38                 SEC
000944r 2  E5 rr              SBC   eval_val_hi
000946r 2  50 02              BVC   @lt_sign_ok
000948r 2  49 80              EOR   #$80
00094Ar 2               @lt_sign_ok:
00094Ar 2  30 1A              BMI   @set_true             ; left_hi < right_hi → true
00094Cr 2  A5 rr              LDA   eval_left_hi
00094Er 2  C5 rr              CMP   eval_val_hi
000950r 2  D0 20              BNE   @set_false            ; left_hi > right_hi → false
000952r 2                     ; Hi bytes equal — compare lo bytes (unsigned)
000952r 2  A5 rr              LDA   eval_left_lo
000954r 2  C5 rr              CMP   eval_val_lo
000956r 2  D0 0A              BNE   @lt_lo_diff
000958r 2                     ; Lo bytes equal — compare frac (unsigned)
000958r 2  A5 rr              LDA   eval_left_frac
00095Ar 2  C5 rr              CMP   eval_val_frac
00095Cr 2  F0 14              BEQ   @set_false            ; equal → not less
00095Er 2  90 06              BCC   @set_true
000960r 2  80 10              BRA   @set_false
000962r 2               @lt_lo_diff:
000962r 2  90 02              BCC   @set_true
000964r 2  80 0C              BRA   @set_false
000966r 2               
000966r 2                     ; ----- Set result to TRUE (1) or FALSE (0) -----
000966r 2               @set_true:
000966r 2  64 rr              STZ   eval_val_hi
000968r 2  A9 01              LDA   #1
00096Ar 2  85 rr              STA   eval_val_lo
00096Cr 2  64 rr              STZ   eval_val_frac
00096Er 2  64 rr              STZ   eval_type
000970r 2  18                 CLC
000971r 2  60                 RTS
000972r 2               
000972r 2               @set_false:
000972r 2  64 rr              STZ   eval_val_hi
000974r 2  64 rr              STZ   eval_val_lo
000976r 2  64 rr              STZ   eval_val_frac
000978r 2  64 rr              STZ   eval_type
00097Ar 2  18                 CLC
00097Br 2  60                 RTS
00097Cr 2               
00097Cr 2               ; ---------------------------------------------------------------------
00097Cr 2               ; print_number — print eval_val as a signed decimal number
00097Cr 2               ;   Input: eval_val_hi/lo/frac (16.8 fixed-point, signed)
00097Cr 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
00097Cr 2               ; ---------------------------------------------------------------------
00097Cr 2               print_number:
00097Cr 2                     ; Check sign — if negative, print '-' and negate
00097Cr 2  A5 rr              LDA   eval_val_hi
00097Er 2  10 1E              BPL   @positive
000980r 2                     ; Print minus sign
000980r 2  A9 2D              LDA   #'-'
000982r 2  8D 0E A0           STA   VGC_CHAROUT
000985r 2                     ; Negate 3-byte value (two's complement)
000985r 2  A5 rr              LDA   eval_val_frac
000987r 2  49 FF              EOR   #$FF
000989r 2  18                 CLC
00098Ar 2  69 01              ADC   #1
00098Cr 2  85 rr              STA   eval_val_frac
00098Er 2  A5 rr              LDA   eval_val_lo
000990r 2  49 FF              EOR   #$FF
000992r 2  69 00              ADC   #0
000994r 2  85 rr              STA   eval_val_lo
000996r 2  A5 rr              LDA   eval_val_hi
000998r 2  49 FF              EOR   #$FF
00099Ar 2  69 00              ADC   #0
00099Cr 2  85 rr              STA   eval_val_hi
00099Er 2               
00099Er 2               @positive:
00099Er 2                     ; Print integer part (eval_val_hi:eval_val_lo as 16-bit unsigned)
00099Er 2  20 rr rr           JSR   print_uint16
0009A1r 2               
0009A1r 2                     ; Print fractional part if non-zero
0009A1r 2  A5 rr              LDA   eval_val_frac
0009A3r 2  D0 01              BNE   @has_frac
0009A5r 2  60                 RTS
0009A6r 2               @has_frac:
0009A6r 2               
0009A6r 2                     ; Print decimal point
0009A6r 2  A9 2E              LDA   #'.'
0009A8r 2  8D 0E A0           STA   VGC_CHAROUT
0009ABr 2               
0009ABr 2                     ; Convert frac byte to decimal digits
0009ABr 2                     ; frac * 10 / 256 = first digit, repeat with remainder
0009ABr 2  A5 rr              LDA   eval_val_frac
0009ADr 2  8D rr rr           STA   num_tmp_lo
0009B0r 2  9C rr rr           STZ   num_tmp_hi
0009B3r 2               
0009B3r 2                     ; First digit: (frac * 10) >> 8
0009B3r 2                     ; frac * 10 = (frac * 8) + (frac * 2)
0009B3r 2  AD rr rr           LDA   num_tmp_lo
0009B6r 2  0A                 ASL
0009B7r 2  8D rr rr           STA   num_val_lo          ; frac * 2
0009BAr 2  AD rr rr           LDA   num_tmp_hi
0009BDr 2  2A                 ROL
0009BEr 2  8D rr rr           STA   num_val_hi
0009C1r 2               
0009C1r 2  0E rr rr           ASL   num_val_lo
0009C4r 2  2E rr rr           ROL   num_val_hi
0009C7r 2  0E rr rr           ASL   num_val_lo
0009CAr 2  2E rr rr           ROL   num_val_hi          ; frac * 8
0009CDr 2               
0009CDr 2  18                 CLC
0009CEr 2  AD rr rr           LDA   num_tmp_lo
0009D1r 2  0A                 ASL                       ; frac * 2 (low byte)
0009D2r 2  6D rr rr           ADC   num_val_lo
0009D5r 2  8D rr rr           STA   num_val_lo
0009D8r 2  AD rr rr           LDA   num_tmp_hi
0009DBr 2  2A                 ROL
0009DCr 2  6D rr rr           ADC   num_val_hi
0009DFr 2  8D rr rr           STA   num_val_hi          ; num_val = frac * 10
0009E2r 2               
0009E2r 2                     ; High byte = first decimal digit
0009E2r 2  AD rr rr           LDA   num_val_hi
0009E5r 2  09 30              ORA   #'0'
0009E7r 2  8D 0E A0           STA   VGC_CHAROUT
0009EAr 2               
0009EAr 2                     ; Remainder = low byte → second digit
0009EAr 2  AD rr rr           LDA   num_val_lo
0009EDr 2  8D rr rr           STA   num_tmp_lo
0009F0r 2  9C rr rr           STZ   num_tmp_hi
0009F3r 2               
0009F3r 2                     ; Second digit: (remainder * 10) >> 8
0009F3r 2  AD rr rr           LDA   num_tmp_lo
0009F6r 2  0A                 ASL
0009F7r 2  8D rr rr           STA   num_val_lo
0009FAr 2  AD rr rr           LDA   num_tmp_hi
0009FDr 2  2A                 ROL
0009FEr 2  8D rr rr           STA   num_val_hi
000A01r 2               
000A01r 2  0E rr rr           ASL   num_val_lo
000A04r 2  2E rr rr           ROL   num_val_hi
000A07r 2  0E rr rr           ASL   num_val_lo
000A0Ar 2  2E rr rr           ROL   num_val_hi
000A0Dr 2               
000A0Dr 2  18                 CLC
000A0Er 2  AD rr rr           LDA   num_tmp_lo
000A11r 2  0A                 ASL
000A12r 2  6D rr rr           ADC   num_val_lo
000A15r 2  8D rr rr           STA   num_val_lo
000A18r 2  AD rr rr           LDA   num_tmp_hi
000A1Br 2  2A                 ROL
000A1Cr 2  6D rr rr           ADC   num_val_hi
000A1Fr 2  8D rr rr           STA   num_val_hi
000A22r 2               
000A22r 2                     ; High byte = second digit; skip if zero (trailing)
000A22r 2  AD rr rr           LDA   num_val_hi
000A25r 2  F0 05              BEQ   @done
000A27r 2  09 30              ORA   #'0'
000A29r 2  8D 0E A0           STA   VGC_CHAROUT
000A2Cr 2               
000A2Cr 2               @done:
000A2Cr 2  60                 RTS
000A2Dr 2               
000A2Dr 2               ; ---------------------------------------------------------------------
000A2Dr 2               ; print_uint16 — print eval_val_hi:eval_val_lo as unsigned decimal
000A2Dr 2               ;   No leading zeros (except value 0 prints "0")
000A2Dr 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
000A2Dr 2               ; ---------------------------------------------------------------------
000A2Dr 2               print_uint16:
000A2Dr 2                     ; Copy to working regs
000A2Dr 2  A5 rr              LDA   eval_val_lo
000A2Fr 2  8D rr rr           STA   num_val_lo
000A32r 2  A5 rr              LDA   eval_val_hi
000A34r 2  8D rr rr           STA   num_val_hi
000A37r 2               
000A37r 2  A2 00              LDX   #0                  ; digit buffer index
000A39r 2  A0 00              LDY   #0                  ; power-of-10 table index
000A3Br 2               
000A3Br 2               @div_loop:
000A3Br 2  9C rr rr           STZ   num_tmp_lo          ; digit counter for this power
000A3Er 2               @sub_loop:
000A3Er 2                     ; Subtract current power of 10
000A3Er 2  38                 SEC
000A3Fr 2  AD rr rr           LDA   num_val_lo
000A42r 2  F9 rr rr           SBC   pow10_lo,Y
000A45r 2  48                 PHA
000A46r 2  AD rr rr           LDA   num_val_hi
000A49r 2  F9 rr rr           SBC   pow10_hi,Y
000A4Cr 2  90 0C              BCC   @sub_done           ; underflow — done with this digit
000A4Er 2  8D rr rr           STA   num_val_hi
000A51r 2  68                 PLA
000A52r 2  8D rr rr           STA   num_val_lo
000A55r 2  EE rr rr           INC   num_tmp_lo
000A58r 2  80 E4              BRA   @sub_loop
000A5Ar 2               @sub_done:
000A5Ar 2  68                 PLA                       ; discard low byte from failed subtract
000A5Br 2  AD rr rr           LDA   num_tmp_lo
000A5Er 2  9D rr rr           STA   pn_buf,X
000A61r 2  E8                 INX
000A62r 2  C8                 INY
000A63r 2  C0 05              CPY   #5                  ; 5 powers (10000,1000,100,10,1)
000A65r 2  90 D4              BCC   @div_loop
000A67r 2               
000A67r 2                     ; Print digits, suppressing leading zeros
000A67r 2  A0 00              LDY   #0                  ; suppress flag (0=suppress)
000A69r 2  A2 00              LDX   #0
000A6Br 2               @print_loop:
000A6Br 2  BD rr rr           LDA   pn_buf,X
000A6Er 2  D0 04              BNE   @nonzero
000A70r 2  C0 00              CPY   #0
000A72r 2  F0 07              BEQ   @maybe_skip        ; still suppressing
000A74r 2               @nonzero:
000A74r 2  A0 01              LDY   #1                  ; seen nonzero digit
000A76r 2  09 30              ORA   #'0'
000A78r 2  8D 0E A0           STA   VGC_CHAROUT
000A7Br 2               @maybe_skip:
000A7Br 2  E8                 INX
000A7Cr 2  E0 04              CPX   #4
000A7Er 2  90 EB              BCC   @print_loop
000A80r 2                     ; Always print the last digit (ones place)
000A80r 2  AD rr rr           LDA   pn_buf+4
000A83r 2  09 30              ORA   #'0'
000A85r 2  8D 0E A0           STA   VGC_CHAROUT
000A88r 2  60                 RTS
000A89r 2               
000A89r 2               ; ---------------------------------------------------------------------
000A89r 2               ; try_throw_error — if a CATCH with tag "ERROR" is active, unwind to it
000A89r 2               ;   Called after error messages are printed. If no catch is active or
000A89r 2               ;   the tag doesn't match "ERROR", this is a no-op (returns normally).
000A89r 2               ;   If a match is found, this NEVER RETURNS — it unwinds the stack
000A89r 2               ;   via TXS and jumps to the catch resume point.
000A89r 2               ; ---------------------------------------------------------------------
000A89r 2               try_throw_error:
000A89r 2  A5 rr              LDA   catch_active
000A8Br 2  F0 3A              BEQ   @no_catch
000A8Dr 2               
000A8Dr 2                     ; Compare catch_tag against "ERROR" (5 chars, uppercased)
000A8Dr 2  A5 rr              LDA   catch_tag_lo
000A8Fr 2  85 rr              STA   ptr2_lo
000A91r 2  A5 rr              LDA   catch_tag_hi
000A93r 2  85 rr              STA   ptr2_hi
000A95r 2  A9 rr              LDA   #<str_error_tag
000A97r 2  85 rr              STA   ptr_lo
000A99r 2  A9 rr              LDA   #>str_error_tag
000A9Br 2  85 rr              STA   ptr_hi
000A9Dr 2  20 rr rr           JSR   catch_tags_equal
000AA0r 2  90 25              BCC   @no_catch
000AA2r 2               
000AA2r 2                     ; Match! Unwind stack to catch point and resume.
000AA2r 2  A6 rr              LDX   catch_sp
000AA4r 2  9A                 TXS
000AA5r 2               
000AA5r 2                     ; Restore previous catch frame from the restored stack
000AA5r 2  68                 PLA
000AA6r 2  85 rr              STA   catch_resume_hi
000AA8r 2  68                 PLA
000AA9r 2  85 rr              STA   catch_resume_lo
000AABr 2  68                 PLA
000AACr 2  85 rr              STA   catch_sp
000AAEr 2  68                 PLA
000AAFr 2  85 rr              STA   catch_tag_hi
000AB1r 2  68                 PLA
000AB2r 2  85 rr              STA   catch_tag_lo
000AB4r 2  68                 PLA
000AB5r 2  85 rr              STA   catch_active
000AB7r 2               
000AB7r 2                     ; Restore eval_in_body and discard saved tag pointer (3 bytes)
000AB7r 2  68                 PLA
000AB8r 2  85 rr              STA   eval_in_body
000ABAr 2  68                 PLA                         ; tag_hi
000ABBr 2  68                 PLA                         ; tag_lo
000ABCr 2               
000ABCr 2                     ; Set eval_cur to resume point (past the caught body)
000ABCr 2  A5 rr              LDA   catch_resume_lo
000ABEr 2  85 rr              STA   eval_cur_lo
000AC0r 2  A5 rr              LDA   catch_resume_hi
000AC2r 2  85 rr              STA   eval_cur_hi
000AC4r 2               
000AC4r 2  4C rr rr           JMP   eval_continue
000AC7r 2               
000AC7r 2               @no_catch:
000AC7r 2  60                 RTS
000AC8r 2               
000AC8r 2               ; ---------------------------------------------------------------------
000AC8r 2               ; catch_tags_equal — compare two length-prefixed strings (case-insensitive)
000AC8r 2               ;   Input: ptr_lo/hi = string A, ptr2_lo/hi = string B
000AC8r 2               ;   Output: carry set = equal, carry clear = not equal
000AC8r 2               ;   Clobbers: A, X, Y
000AC8r 2               ; ---------------------------------------------------------------------
000AC8r 2               catch_tags_equal:
000AC8r 2  A0 00              LDY   #0
000ACAr 2  B1 rr              LDA   (ptr_lo),Y           ; length of A
000ACCr 2  8D rr rr           STA   num_tmp_lo            ; temp: len A
000ACFr 2  B1 rr              LDA   (ptr2_lo),Y          ; length of B
000AD1r 2  CD rr rr           CMP   num_tmp_lo
000AD4r 2  D0 2D              BNE   @ne
000AD6r 2               
000AD6r 2                     ; Lengths match — compare chars
000AD6r 2  AA                 TAX                         ; X = length
000AD7r 2  F0 28              BEQ   @eq                   ; both zero = equal
000AD9r 2  A0 01              LDY   #1
000ADBr 2               @cmp:
000ADBr 2  B1 rr              LDA   (ptr_lo),Y
000ADDr 2                     ; Uppercase A char
000ADDr 2  C9 61              CMP   #'a'
000ADFr 2  90 07              BCC   @a_up
000AE1r 2  C9 7B              CMP   #'z'+1
000AE3r 2  B0 03              BCS   @a_up
000AE5r 2  38                 SEC
000AE6r 2  E9 20              SBC   #$20
000AE8r 2               @a_up:
000AE8r 2  8D rr rr           STA   num_tmp_lo            ; uppercased A char
000AEBr 2               
000AEBr 2  B1 rr              LDA   (ptr2_lo),Y
000AEDr 2                     ; Uppercase B char
000AEDr 2  C9 61              CMP   #'a'
000AEFr 2  90 07              BCC   @b_up
000AF1r 2  C9 7B              CMP   #'z'+1
000AF3r 2  B0 03              BCS   @b_up
000AF5r 2  38                 SEC
000AF6r 2  E9 20              SBC   #$20
000AF8r 2               @b_up:
000AF8r 2  CD rr rr           CMP   num_tmp_lo
000AFBr 2  D0 06              BNE   @ne
000AFDr 2  C8                 INY
000AFEr 2  CA                 DEX
000AFFr 2  D0 DA              BNE   @cmp
000B01r 2               
000B01r 2               @eq:
000B01r 2  38                 SEC
000B02r 2  60                 RTS
000B03r 2               @ne:
000B03r 2  18                 CLC
000B04r 2  60                 RTS
000B05r 2               
000B05r 2               ; =====================================================================
000B05r 2               ; RODATA — evaluator strings and tables
000B05r 2               ; =====================================================================
000B05r 2               ; ---------------------------------------------------------------------
000B05r 2               ; lookup_ext_cmd — search ext_cmd_table for the current TOK_WORD
000B05r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000B05r 2               ;   Output: Carry clear = found, A = arity, EXT_CMD set
000B05r 2               ;           Carry set = not found
000B05r 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000B05r 2               ; ---------------------------------------------------------------------
000B05r 2               lookup_ext_cmd:
000B05r 2                     ; Save table pointer in num_tmp_lo/hi
000B05r 2  A9 rr              LDA   #<ext_cmd_table
000B07r 2  8D rr rr           STA   num_tmp_lo
000B0Ar 2  A9 rr              LDA   #>ext_cmd_table
000B0Cr 2  8D rr rr           STA   num_tmp_hi
000B0Fr 2               
000B0Fr 2               @scan:
000B0Fr 2                     ; Read name pointer from table
000B0Fr 2  AD rr rr           LDA   num_tmp_lo
000B12r 2  85 rr              STA   ptr2_lo
000B14r 2  AD rr rr           LDA   num_tmp_hi
000B17r 2  85 rr              STA   ptr2_hi
000B19r 2  A0 00              LDY   #0
000B1Br 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000B1Dr 2  AA                 TAX
000B1Er 2  C8                 INY
000B1Fr 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000B21r 2  D0 06              BNE   @have_entry
000B23r 2  E0 00              CPX   #0
000B25r 2  D0 02              BNE   @have_entry
000B27r 2                     ; Null pointer — end of table
000B27r 2  38                 SEC
000B28r 2  60                 RTS
000B29r 2               
000B29r 2               @have_entry:
000B29r 2                     ; X = name_ptr_lo, A = name_ptr_hi
000B29r 2  85 rr              STA   ptr2_hi
000B2Br 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000B2Dr 2               
000B2Dr 2                     ; Get token payload pointer
000B2Dr 2  A5 rr              LDA   eval_cur_lo
000B2Fr 2  85 rr              STA   ptr_lo
000B31r 2  A5 rr              LDA   eval_cur_hi
000B33r 2  85 rr              STA   ptr_hi
000B35r 2               
000B35r 2                     ; Compare length bytes
000B35r 2  A0 00              LDY   #0
000B37r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000B39r 2  A0 03              LDY   #TOK_PAYLOAD
000B3Br 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000B3Dr 2  D0 30              BNE   @next
000B3Fr 2               
000B3Fr 2                     ; Lengths match — compare chars
000B3Fr 2  AA                 TAX                       ; X = length
000B40r 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000B42r 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000B44r 2               @cmp_loop:
000B44r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000B46r 2  5A                 PHY
000B47r 2  A5 rr              LDA   tok_sign
000B49r 2  18                 CLC
000B4Ar 2  69 04              ADC   #TOK_PAYLOAD+1
000B4Cr 2  A8                 TAY
000B4Dr 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000B4Fr 2  7A                 PLY
000B50r 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000B52r 2  D0 1B              BNE   @next
000B54r 2  C8                 INY
000B55r 2  E6 rr              INC   tok_sign
000B57r 2  CA                 DEX
000B58r 2  D0 EA              BNE   @cmp_loop
000B5Ar 2               
000B5Ar 2                     ; Match found — read cmd_id and arity
000B5Ar 2                     ; Table entry: name_ptr(2) + cmd_id(1) + arity(1)
000B5Ar 2  AD rr rr           LDA   num_tmp_lo
000B5Dr 2  85 rr              STA   ptr_lo
000B5Fr 2  AD rr rr           LDA   num_tmp_hi
000B62r 2  85 rr              STA   ptr_hi
000B64r 2  A0 02              LDY   #2
000B66r 2  B1 rr              LDA   (ptr_lo),Y         ; cmd_id
000B68r 2  85 80              STA   EXT_CMD
000B6Ar 2  C8                 INY
000B6Br 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000B6Dr 2  18                 CLC                       ; found
000B6Er 2  60                 RTS
000B6Fr 2               
000B6Fr 2               @next:
000B6Fr 2  64 rr              STZ   tok_sign
000B71r 2                     ; Advance to next entry: +4 bytes (2 name + 1 cmd_id + 1 arity)
000B71r 2  18                 CLC
000B72r 2  AD rr rr           LDA   num_tmp_lo
000B75r 2  69 04              ADC   #4
000B77r 2  8D rr rr           STA   num_tmp_lo
000B7Ar 2  90 03              BCC   :+
000B7Cr 2  EE rr rr           INC   num_tmp_hi
000B7Fr 2               :
000B7Fr 2  4C rr rr           JMP   @scan
000B82r 2               
000B82r 2               ; ---------------------------------------------------------------------
000B82r 2               ; ext_eval_args — evaluate X arguments and copy to EXT_ARG0..2 slots
000B82r 2               ;   Input: X = argument count (0-3)
000B82r 2               ;   Output: Carry clear = success, Carry set = error
000B82r 2               ;           EXT_ARGC set, EXT_ARG0..2 populated
000B82r 2               ;   Clobbers: A, X, Y
000B82r 2               ; ---------------------------------------------------------------------
000B82r 2               ext_eval_args:
000B82r 2  86 81              STX   EXT_ARGC
000B84r 2  E0 00              CPX   #0
000B86r 2  F0 65              BEQ   @done
000B88r 2               
000B88r 2                     ; Evaluate arg 0
000B88r 2  DA                 PHX
000B89r 2  20 rr rr           JSR   eval_expr
000B8Cr 2  FA                 PLX
000B8Dr 2  B0 60              BCS   @err
000B8Fr 2  A5 rr              LDA   eval_type
000B91r 2  85 82              STA   EXT_ARG0_TYPE
000B93r 2  A5 rr              LDA   eval_val_hi
000B95r 2  85 83              STA   EXT_ARG0_HI
000B97r 2  A5 rr              LDA   eval_val_lo
000B99r 2  85 84              STA   EXT_ARG0_LO
000B9Br 2  A5 rr              LDA   eval_val_frac
000B9Dr 2  85 85              STA   EXT_ARG0_FRAC
000B9Fr 2  CA                 DEX
000BA0r 2  F0 4B              BEQ   @done
000BA2r 2               
000BA2r 2                     ; Evaluate arg 1
000BA2r 2  DA                 PHX
000BA3r 2  20 rr rr           JSR   eval_expr
000BA6r 2  FA                 PLX
000BA7r 2  B0 46              BCS   @err
000BA9r 2  A5 rr              LDA   eval_type
000BABr 2  85 86              STA   EXT_ARG1_TYPE
000BADr 2  A5 rr              LDA   eval_val_hi
000BAFr 2  85 87              STA   EXT_ARG1_HI
000BB1r 2  A5 rr              LDA   eval_val_lo
000BB3r 2  85 88              STA   EXT_ARG1_LO
000BB5r 2  A5 rr              LDA   eval_val_frac
000BB7r 2  85 89              STA   EXT_ARG1_FRAC
000BB9r 2  CA                 DEX
000BBAr 2  F0 31              BEQ   @done
000BBCr 2               
000BBCr 2                     ; Evaluate arg 2
000BBCr 2  DA                 PHX
000BBDr 2  20 rr rr           JSR   eval_expr
000BC0r 2  FA                 PLX
000BC1r 2  B0 2C              BCS   @err
000BC3r 2  A5 rr              LDA   eval_type
000BC5r 2  85 8A              STA   EXT_ARG2_TYPE
000BC7r 2  A5 rr              LDA   eval_val_hi
000BC9r 2  85 8B              STA   EXT_ARG2_HI
000BCBr 2  A5 rr              LDA   eval_val_lo
000BCDr 2  85 8C              STA   EXT_ARG2_LO
000BCFr 2  A5 rr              LDA   eval_val_frac
000BD1r 2  85 8D              STA   EXT_ARG2_FRAC
000BD3r 2  CA                 DEX
000BD4r 2  F0 17              BEQ   @done
000BD6r 2               
000BD6r 2                     ; Evaluate arg 3 (for LINE, RECT, FILL etc.)
000BD6r 2  DA                 PHX
000BD7r 2  20 rr rr           JSR   eval_expr
000BDAr 2  FA                 PLX
000BDBr 2  B0 12              BCS   @err
000BDDr 2  A5 rr              LDA   eval_type
000BDFr 2  85 9F              STA   EXT_ARG3_TYPE
000BE1r 2  A5 rr              LDA   eval_val_hi
000BE3r 2  85 A0              STA   EXT_ARG3_HI
000BE5r 2  A5 rr              LDA   eval_val_lo
000BE7r 2  85 A1              STA   EXT_ARG3_LO
000BE9r 2  A5 rr              LDA   eval_val_frac
000BEBr 2  85 A2              STA   EXT_ARG3_FRAC
000BEDr 2               
000BEDr 2               @done:
000BEDr 2  18                 CLC
000BEEr 2  60                 RTS
000BEFr 2               @err:
000BEFr 2  38                 SEC
000BF0r 2  60                 RTS
000BF1r 2               
000BF1r 2                     .segment "RODATA"
