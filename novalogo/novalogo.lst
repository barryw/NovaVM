0015D6r 2  4C rr rr           JMP   eval_continue
0015D9r 2               
0015D9r 2               @rl_oom:
0015D9r 2                     ; Restore tokenizer state before error
0015D9r 2  68                 PLA
0015DAr 2  85 rr              STA   eval_cur_hi
0015DCr 2  68                 PLA
0015DDr 2  85 rr              STA   eval_cur_lo
0015DFr 2  68                 PLA
0015E0r 2  85 rr              STA   tok_tail_hi
0015E2r 2  68                 PLA
0015E3r 2  85 rr              STA   tok_tail_lo
0015E5r 2  68                 PLA
0015E6r 2  85 rr              STA   tok_head_hi
0015E8r 2  68                 PLA
