000328r 1                     .include "builtins.s"
000328r 2               ; builtins.s — built-in command table and handlers
000328r 2               
000328r 2               ; =====================================================================
000328r 2               ; CODE segment — builtin lookup and handlers
000328r 2               ; =====================================================================
000328r 2                     .segment "CODE"
000BCBr 2               
000BCBr 2               ; ---------------------------------------------------------------------
000BCBr 2               ; lookup_builtin — search builtin table for the current TOK_WORD
000BCBr 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000BCBr 2               ;   Output: Carry clear = found, ptr2_lo/hi = handler addr, A = arity
000BCBr 2               ;           Carry set = not found
000BCBr 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000BCBr 2               ; ---------------------------------------------------------------------
000BCBr 2               lookup_builtin:
000BCBr 2                     ; Save table pointer in num_tmp_lo/hi
000BCBr 2  A9 rr              LDA   #<builtin_table
000BCDr 2  8D rr rr           STA   num_tmp_lo
000BD0r 2  A9 rr              LDA   #>builtin_table
000BD2r 2  8D rr rr           STA   num_tmp_hi
000BD5r 2               
000BD5r 2               @scan:
000BD5r 2                     ; Read name pointer from table
000BD5r 2  AD rr rr           LDA   num_tmp_lo
000BD8r 2  85 rr              STA   ptr2_lo
000BDAr 2  AD rr rr           LDA   num_tmp_hi
000BDDr 2  85 rr              STA   ptr2_hi
000BDFr 2  A0 00              LDY   #0
000BE1r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000BE3r 2  AA                 TAX
000BE4r 2  C8                 INY
000BE5r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000BE7r 2  D0 06              BNE   @have_entry
000BE9r 2  E0 00              CPX   #0
000BEBr 2  D0 02              BNE   @have_entry
000BEDr 2                     ; Null pointer — end of table
000BEDr 2  38                 SEC
000BEEr 2  60                 RTS
000BEFr 2               
000BEFr 2               @have_entry:
000BEFr 2                     ; X = name_ptr_lo, A = name_ptr_hi
000BEFr 2                     ; Compare the table name against the token payload
000BEFr 2                     ; Token payload: at eval_cur + TOK_PAYLOAD = length byte + chars
000BEFr 2  85 rr              STA   ptr2_hi
000BF1r 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000BF3r 2               
000BF3r 2                     ; Get token payload pointer
000BF3r 2  A5 rr              LDA   eval_cur_lo
000BF5r 2  85 rr              STA   ptr_lo
000BF7r 2  A5 rr              LDA   eval_cur_hi
000BF9r 2  85 rr              STA   ptr_hi
000BFBr 2               
000BFBr 2                     ; Compare length bytes
000BFBr 2  A0 00              LDY   #0
000BFDr 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000BFFr 2  A0 03              LDY   #TOK_PAYLOAD
000C01r 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000C03r 2  D0 45              BNE   @next
000C05r 2               
000C05r 2                     ; Lengths match — compare chars
000C05r 2  AA                 TAX                       ; X = length
000C06r 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000C08r 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000C0Ar 2               @cmp_loop:
000C0Ar 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000C0Cr 2  5A                 PHY
000C0Dr 2                     ; Compute token char offset: TOK_PAYLOAD + 1 + tok_sign
000C0Dr 2  A5 rr              LDA   tok_sign
000C0Fr 2  18                 CLC
000C10r 2  69 04              ADC   #TOK_PAYLOAD+1
000C12r 2  A8                 TAY
000C13r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000C15r 2  7A                 PLY
000C16r 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000C18r 2  D0 30              BNE   @next
000C1Ar 2  C8                 INY
000C1Br 2  E6 rr              INC   tok_sign
000C1Dr 2  CA                 DEX
000C1Er 2  D0 EA              BNE   @cmp_loop
000C20r 2               
000C20r 2                     ; Match found — read handler address and arity
000C20r 2                     ; Table entry: name_ptr(2) + handler_addr(2) + arity(1)
000C20r 2                     ; handler is at table_base + 2, arity at table_base + 4
000C20r 2  AD rr rr           LDA   num_tmp_lo
000C23r 2  85 rr              STA   ptr2_lo
000C25r 2  AD rr rr           LDA   num_tmp_hi
000C28r 2  85 rr              STA   ptr2_hi
000C2Ar 2  A0 02              LDY   #2
000C2Cr 2  B1 rr              LDA   (ptr2_lo),Y        ; handler low
000C2Er 2  AA                 TAX
000C2Fr 2  C8                 INY
000C30r 2  B1 rr              LDA   (ptr2_lo),Y        ; handler high
000C32r 2  85 rr              STA   ptr2_hi
000C34r 2  86 rr              STX   ptr2_lo             ; ptr2 = handler address
000C36r 2  A0 04              LDY   #4
000C38r 2  B1 rr              LDA   (ptr2_lo),Y        ; — wrong, we already overwrote ptr2
000C3Ar 2                     ; Fix: re-read arity from table using num_tmp as base
000C3Ar 2  AD rr rr           LDA   num_tmp_lo
000C3Dr 2  85 rr              STA   ptr_lo
000C3Fr 2  AD rr rr           LDA   num_tmp_hi
000C42r 2  85 rr              STA   ptr_hi
000C44r 2  A0 04              LDY   #4
000C46r 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000C48r 2  18                 CLC                       ; found
000C49r 2  60                 RTS
000C4Ar 2               
000C4Ar 2               @next:
000C4Ar 2  64 rr              STZ   tok_sign            ; reset comparison counter
000C4Cr 2                     ; Advance to next entry: +5 bytes (2 name + 2 handler + 1 arity)
000C4Cr 2  18                 CLC
000C4Dr 2  AD rr rr           LDA   num_tmp_lo
000C50r 2  69 05              ADC   #5
000C52r 2  8D rr rr           STA   num_tmp_lo
000C55r 2  90 03              BCC   @next2
000C57r 2  EE rr rr           INC   num_tmp_hi
000C5Ar 2               @next2:
000C5Ar 2  4C rr rr           JMP   @scan
000C5Dr 2               
000C5Dr 2               ; ---------------------------------------------------------------------
000C5Dr 2               ; do_print — PRINT <expr>: evaluate arg and print with newline
000C5Dr 2               ;   Entry: eval_val/eval_type already set with the argument
000C5Dr 2               ;   Must JMP to eval_continue when done
000C5Dr 2               ; ---------------------------------------------------------------------
000C5Dr 2               do_print:
000C5Dr 2  A5 rr              LDA   eval_type
000C5Fr 2  C9 02              CMP   #VAL_LIST
000C61r 2  F0 0D              BEQ   @list
000C63r 2  C9 01              CMP   #VAL_WORD
000C65r 2  F0 12              BEQ   @word
000C67r 2               
000C67r 2                     ; Print number
000C67r 2  20 rr rr           JSR   print_number
000C6Ar 2  20 rr rr           JSR   eval_newline
000C6Dr 2  4C rr rr           JMP   eval_continue
000C70r 2               
000C70r 2               @list:
000C70r 2  20 rr rr           JSR   print_list
000C73r 2  20 rr rr           JSR   eval_newline
000C76r 2  4C rr rr           JMP   eval_continue
000C79r 2               
000C79r 2               @word:
000C79r 2                     ; Print quoted word — eval_val_lo/hi points at length+chars
000C79r 2  A5 rr              LDA   eval_val_lo
000C7Br 2  85 rr              STA   ptr_lo
000C7Dr 2  A5 rr              LDA   eval_val_hi
000C7Fr 2  85 rr              STA   ptr_hi
000C81r 2  A0 00              LDY   #0
000C83r 2  B1 rr              LDA   (ptr_lo),Y         ; length
000C85r 2  AA                 TAX
000C86r 2  C8                 INY
000C87r 2               @wch:
000C87r 2  B1 rr              LDA   (ptr_lo),Y
000C89r 2  8D 0E A0           STA   VGC_CHAROUT
000C8Cr 2  C8                 INY
000C8Dr 2  CA                 DEX
000C8Er 2  D0 F7              BNE   @wch
000C90r 2  20 rr rr           JSR   eval_newline
000C93r 2  4C rr rr           JMP   eval_continue
000C96r 2               
000C96r 2               ; ---------------------------------------------------------------------
000C96r 2               ; do_type — TYPE <expr>: like PRINT but no newline
000C96r 2               ; ---------------------------------------------------------------------
000C96r 2               do_type:
000C96r 2  A5 rr              LDA   eval_type
000C98r 2  C9 02              CMP   #VAL_LIST
000C9Ar 2  F0 0A              BEQ   @list
000C9Cr 2  C9 01              CMP   #VAL_WORD
000C9Er 2  F0 0C              BEQ   @word
000CA0r 2               
000CA0r 2                     ; Print number (no newline)
000CA0r 2  20 rr rr           JSR   print_number
000CA3r 2  4C rr rr           JMP   eval_continue
000CA6r 2               
000CA6r 2               @list:
000CA6r 2  20 rr rr           JSR   print_list
000CA9r 2  4C rr rr           JMP   eval_continue
000CACr 2               
000CACr 2               @word:
000CACr 2  A5 rr              LDA   eval_val_lo
000CAEr 2  85 rr              STA   ptr_lo
000CB0r 2  A5 rr              LDA   eval_val_hi
000CB2r 2  85 rr              STA   ptr_hi
000CB4r 2  A0 00              LDY   #0
000CB6r 2  B1 rr              LDA   (ptr_lo),Y
000CB8r 2  AA                 TAX
000CB9r 2  C8                 INY
000CBAr 2               @wch:
000CBAr 2  B1 rr              LDA   (ptr_lo),Y
000CBCr 2  8D 0E A0           STA   VGC_CHAROUT
000CBFr 2  C8                 INY
000CC0r 2  CA                 DEX
000CC1r 2  D0 F7              BNE   @wch
000CC3r 2  4C rr rr           JMP   eval_continue
000CC6r 2               
000CC6r 2               ; ---------------------------------------------------------------------
000CC6r 2               ; do_make — MAKE "name value: store a variable
000CC6r 2               ;   Arity 0 — we do our own argument evaluation
000CC6r 2               ;   1. eval_expr → name (must be TOK_QUOTE → word type)
000CC6r 2               ;   2. save name pointer
000CC6r 2               ;   3. eval_expr → value
000CC6r 2               ;   4. var_set(saved name, current value)
000CC6r 2               ; ---------------------------------------------------------------------
000CC6r 2               do_make:
000CC6r 2                     ; Evaluate first argument: the name (a quoted word)
000CC6r 2  20 rr rr           JSR   eval_expr
000CC9r 2  B0 1F              BCS   @err
000CCBr 2               
000CCBr 2                     ; Must be a word (type $01)
000CCBr 2  A5 rr              LDA   eval_type
000CCDr 2  C9 01              CMP   #$01
000CCFr 2  D0 19              BNE   @err
000CD1r 2               
000CD1r 2                     ; Save the name pointer (points into token payload: len + chars)
000CD1r 2  A5 rr              LDA   eval_val_lo
000CD3r 2  48                 PHA
000CD4r 2  A5 rr              LDA   eval_val_hi
000CD6r 2  48                 PHA
000CD7r 2               
000CD7r 2                     ; Evaluate second argument: the value
000CD7r 2  20 rr rr           JSR   eval_expr
000CDAr 2  B0 0C              BCS   @err_pop
000CDCr 2               
000CDCr 2                     ; Set up ptr_lo/hi → saved name, eval_val holds value
000CDCr 2  68                 PLA
000CDDr 2  85 rr              STA   ptr_hi
000CDFr 2  68                 PLA
000CE0r 2  85 rr              STA   ptr_lo
000CE2r 2               
000CE2r 2  20 rr rr           JSR   var_set
000CE5r 2  4C rr rr           JMP   eval_continue
000CE8r 2               
000CE8r 2               @err_pop:
000CE8r 2  68                 PLA
000CE9r 2  68                 PLA
000CEAr 2               @err:
000CEAr 2                     ; Print error
000CEAr 2  A2 00              LDX   #0
000CECr 2               @ep:
000CECr 2  BD rr rr           LDA   str_make_err,X
000CEFr 2  F0 06              BEQ   @ep_done
000CF1r 2  8D 0E A0           STA   VGC_CHAROUT
000CF4r 2  E8                 INX
000CF5r 2  D0 F5              BNE   @ep
000CF7r 2               @ep_done:
000CF7r 2  20 rr rr           JSR   eval_newline
000CFAr 2  4C rr rr           JMP   eval_continue
000CFDr 2               
000CFDr 2               ; ---------------------------------------------------------------------
000CFDr 2               ; do_repeat — REPEAT count [body]
000CFDr 2               ;   Arity 0 — handles its own argument parsing
000CFDr 2               ;   1. Evaluate count expression
000CFDr 2               ;   2. Locate the bracketed body [...]
000CFDr 2               ;   3. Execute the body count times
000CFDr 2               ;   4. Resume after the closing ]
000CFDr 2               ;
000CFDr 2               ;   Nesting: saves/restores repeat state (body_start, body_resume,
000CFDr 2               ;   repeat_count, eval_in_body) on the hardware stack so nested
000CFDr 2               ;   REPEAT works correctly.
000CFDr 2               ; ---------------------------------------------------------------------
000CFDr 2               
000CFDr 2                     .segment "ZEROPAGE"
000021r 2  xx           repeat_count_lo:  .res 1
000022r 2  xx           repeat_count_hi:  .res 1
000023r 2  xx           body_start_lo:    .res 1       ; first token after [
000024r 2  xx           body_start_hi:    .res 1
000025r 2  xx           body_resume_lo:   .res 1       ; token after ]
000026r 2  xx           body_resume_hi:   .res 1
000027r 2  xx           repcount:         .res 1       ; 1-based REPCOUNT within REPEAT loop
000028r 2  xx           for_cur_lo:       .res 1       ; FOR loop current value low
000029r 2  xx           for_cur_hi:       .res 1       ; FOR loop current value high
00002Ar 2  xx           for_end_lo:       .res 1       ; FOR loop end value low
00002Br 2  xx           for_end_hi:       .res 1       ; FOR loop end value high
00002Cr 2  xx           cond_start_lo:    .res 1       ; WHILE/UNTIL condition start low
00002Dr 2  xx           cond_start_hi:    .res 1       ; WHILE/UNTIL condition start high
00002Er 2               
00002Er 2                     .segment "CODE"
000CFDr 2               
000CFDr 2               do_repeat:
000CFDr 2                     ; --- Evaluate the count argument ---
000CFDr 2  20 rr rr           JSR   eval_expr
000D00r 2  90 03              BCC   @count_ok
000D02r 2  4C rr rr           JMP   @err_args             ; carry set = no token
000D05r 2               @count_ok:
000D05r 2                     ; Count must be a number
000D05r 2  A5 rr              LDA   eval_type
000D07r 2  F0 03              BEQ   @type_ok
000D09r 2  4C rr rr           JMP   @err_args
000D0Cr 2               @type_ok:
000D0Cr 2               
000D0Cr 2                     ; --- Save outer repeat state for nesting ---
000D0Cr 2  A5 rr              LDA   repcount
000D0Er 2  48                 PHA
000D0Fr 2  A5 rr              LDA   repeat_count_lo
000D11r 2  48                 PHA
000D12r 2  A5 rr              LDA   repeat_count_hi
000D14r 2  48                 PHA
000D15r 2  A5 rr              LDA   body_start_lo
000D17r 2  48                 PHA
000D18r 2  A5 rr              LDA   body_start_hi
000D1Ar 2  48                 PHA
000D1Br 2  A5 rr              LDA   body_resume_lo
000D1Dr 2  48                 PHA
000D1Er 2  A5 rr              LDA   body_resume_hi
000D20r 2  48                 PHA
000D21r 2  A5 rr              LDA   eval_in_body
000D23r 2  48                 PHA
000D24r 2               
000D24r 2                     ; Store count (integer part only, clamped to 0 if negative)
000D24r 2  A5 rr              LDA   eval_val_hi
000D26r 2  30 08              BMI   @zero_count           ; negative = treat as 0
000D28r 2  85 rr              STA   repeat_count_hi
000D2Ar 2  A5 rr              LDA   eval_val_lo
000D2Cr 2  85 rr              STA   repeat_count_lo
000D2Er 2  80 04              BRA   @find_body
000D30r 2               
000D30r 2               @zero_count:
000D30r 2  64 rr              STZ   repeat_count_lo
000D32r 2  64 rr              STZ   repeat_count_hi
000D34r 2               
000D34r 2               @find_body:
000D34r 2                     ; --- Current token must be TOK_LBRACKET ---
000D34r 2  A5 rr              LDA   eval_cur_lo
000D36r 2  05 rr              ORA   eval_cur_hi
000D38r 2  D0 03              BNE   @have_tok
000D3Ar 2  4C rr rr           JMP   @err_bracket_pop
000D3Dr 2               @have_tok:
000D3Dr 2  A5 rr              LDA   eval_cur_lo
000D3Fr 2  85 rr              STA   ptr_lo
000D41r 2  A5 rr              LDA   eval_cur_hi
000D43r 2  85 rr              STA   ptr_hi
000D45r 2  A0 00              LDY   #TOK_TAG
000D47r 2  B1 rr              LDA   (ptr_lo),Y
000D49r 2  C9 03              CMP   #TOK_LBRACKET
000D4Br 2  F0 03              BEQ   @is_bracket
000D4Dr 2  4C rr rr           JMP   @err_bracket_pop
000D50r 2               @is_bracket:
000D50r 2               
000D50r 2                     ; Advance past the [
000D50r 2  20 rr rr           JSR   eval_advance
000D53r 2               
000D53r 2                     ; Save body start (first token after [)
000D53r 2  A5 rr              LDA   eval_cur_lo
000D55r 2  85 rr              STA   body_start_lo
000D57r 2  A5 rr              LDA   eval_cur_hi
000D59r 2  85 rr              STA   body_start_hi
000D5Br 2               
000D5Br 2                     ; --- Scan forward to find the matching ] ---
000D5Br 2  A2 01              LDX   #1                    ; depth (we've consumed the [)
000D5Dr 2               @scan:
000D5Dr 2  A5 rr              LDA   eval_cur_lo
000D5Fr 2  05 rr              ORA   eval_cur_hi
000D61r 2  D0 03              BNE   @scan_ok
000D63r 2  4C rr rr           JMP   @err_bracket_pop
000D66r 2               @scan_ok:
000D66r 2  A5 rr              LDA   eval_cur_lo
000D68r 2  85 rr              STA   ptr_lo
000D6Ar 2  A5 rr              LDA   eval_cur_hi
000D6Cr 2  85 rr              STA   ptr_hi
000D6Er 2  A0 00              LDY   #TOK_TAG
000D70r 2  B1 rr              LDA   (ptr_lo),Y
000D72r 2               
000D72r 2  C9 03              CMP   #TOK_LBRACKET
000D74r 2  D0 03              BNE   @scan_not_lb
000D76r 2  E8                 INX
000D77r 2  80 07              BRA   @scan_next
000D79r 2               @scan_not_lb:
000D79r 2  C9 04              CMP   #TOK_RBRACKET
000D7Br 2  D0 03              BNE   @scan_next
000D7Dr 2  CA                 DEX
000D7Er 2  F0 07              BEQ   @scan_found           ; depth == 0, found matching ]
000D80r 2               @scan_next:
000D80r 2  DA                 PHX                        ; save depth across eval_advance
000D81r 2  20 rr rr           JSR   eval_advance
000D84r 2  FA                 PLX
000D85r 2  80 D6              BRA   @scan
000D87r 2               
000D87r 2               @scan_found:
000D87r 2                     ; eval_cur is at the matching ]. Save resume point (token after ]).
000D87r 2  20 rr rr           JSR   eval_advance
000D8Ar 2  A5 rr              LDA   eval_cur_lo
000D8Cr 2  85 rr              STA   body_resume_lo
000D8Er 2  A5 rr              LDA   eval_cur_hi
000D90r 2  85 rr              STA   body_resume_hi
000D92r 2               
000D92r 2                     ; --- Initialize repcount and execute the body repeat_count times ---
000D92r 2  A9 01              LDA   #1
000D94r 2  85 rr              STA   repcount
000D96r 2               @loop:
000D96r 2                     ; Check if STOP/OUTPUT was signaled
000D96r 2  A5 rr              LDA   proc_stopped
000D98r 2  D0 27              BNE   @loop_done
000D9Ar 2               
000D9Ar 2                     ; Check if count is zero
000D9Ar 2  A5 rr              LDA   repeat_count_lo
000D9Cr 2  05 rr              ORA   repeat_count_hi
000D9Er 2  F0 21              BEQ   @loop_done
000DA0r 2               
000DA0r 2                     ; Set eval_cur to body start
000DA0r 2  A5 rr              LDA   body_start_lo
000DA2r 2  85 rr              STA   eval_cur_lo
000DA4r 2  A5 rr              LDA   body_start_hi
000DA6r 2  85 rr              STA   eval_cur_hi
000DA8r 2               
000DA8r 2                     ; Set body mode and call eval_body
000DA8r 2  A9 01              LDA   #$01
000DAAr 2  85 rr              STA   eval_in_body
000DACr 2  20 rr rr           JSR   eval_body
000DAFr 2               
000DAFr 2                     ; Increment repcount (capped at 255)
000DAFr 2  A5 rr              LDA   repcount
000DB1r 2  C9 FF              CMP   #$FF
000DB3r 2  B0 02              BCS   :+
000DB5r 2  E6 rr              INC   repcount
000DB7r 2               :
000DB7r 2                     ; Decrement count (16-bit)
000DB7r 2  A5 rr              LDA   repeat_count_lo
000DB9r 2  D0 02              BNE   @dec_lo
000DBBr 2  C6 rr              DEC   repeat_count_hi
000DBDr 2               @dec_lo:
000DBDr 2  C6 rr              DEC   repeat_count_lo
000DBFr 2  80 D5              BRA   @loop
000DC1r 2               
000DC1r 2               @loop_done:
000DC1r 2                     ; --- Restore outer state and resume after ] ---
000DC1r 2  20 rr rr           JSR   repeat_restore_state
000DC4r 2               
000DC4r 2                     ; Set eval_cur past the ] to resume
000DC4r 2  A5 rr              LDA   body_resume_lo
000DC6r 2  85 rr              STA   eval_cur_lo
000DC8r 2  A5 rr              LDA   body_resume_hi
000DCAr 2  85 rr              STA   eval_cur_hi
000DCCr 2  4C rr rr           JMP   eval_continue
000DCFr 2               
000DCFr 2               @err_bracket_pop:
000DCFr 2                     ; Restore stack before printing error
000DCFr 2  20 rr rr           JSR   repeat_restore_state
000DD2r 2                     ; Fall through to error message
000DD2r 2  A2 00              LDX   #0
000DD4r 2               @eb_lp:
000DD4r 2  BD rr rr           LDA   str_repeat_bracket,X
000DD7r 2  F0 06              BEQ   @eb_done
000DD9r 2  8D 0E A0           STA   VGC_CHAROUT
000DDCr 2  E8                 INX
000DDDr 2  D0 F5              BNE   @eb_lp
000DDFr 2               @eb_done:
000DDFr 2  20 rr rr           JSR   eval_newline
000DE2r 2  4C rr rr           JMP   eval_continue
000DE5r 2               
000DE5r 2               @err_args:
000DE5r 2  A2 00              LDX   #0
000DE7r 2               @ea_lp:
000DE7r 2  BD rr rr           LDA   str_repeat_err,X
000DEAr 2  F0 06              BEQ   @ea_done
000DECr 2  8D 0E A0           STA   VGC_CHAROUT
000DEFr 2  E8                 INX
000DF0r 2  D0 F5              BNE   @ea_lp
000DF2r 2               @ea_done:
000DF2r 2  20 rr rr           JSR   eval_newline
000DF5r 2  4C rr rr           JMP   eval_continue
000DF8r 2               
000DF8r 2               ; ---------------------------------------------------------------------
000DF8r 2               ; repeat_restore_state — pop 7 saved bytes from stack to ZP
000DF8r 2               ;   Restores eval_in_body, body_resume, body_start, repeat_count
000DF8r 2               ;   Must be called via JSR (uses return address on stack correctly)
000DF8r 2               ; ---------------------------------------------------------------------
000DF8r 2               repeat_restore_state:
000DF8r 2                     ; Pull our return address, pop 8 saved bytes, push RA, RTS.
000DF8r 2  68                 PLA
000DF9r 2  85 rr              STA   handler_lo            ; save return address low
000DFBr 2  68                 PLA
000DFCr 2  85 rr              STA   handler_hi            ; save return address high
000DFEr 2               
000DFEr 2  68                 PLA
000DFFr 2  85 rr              STA   eval_in_body
000E01r 2  68                 PLA
000E02r 2  85 rr              STA   body_resume_hi
000E04r 2  68                 PLA
000E05r 2  85 rr              STA   body_resume_lo
000E07r 2  68                 PLA
000E08r 2  85 rr              STA   body_start_hi
000E0Ar 2  68                 PLA
000E0Br 2  85 rr              STA   body_start_lo
000E0Dr 2  68                 PLA
000E0Er 2  85 rr              STA   repeat_count_hi
000E10r 2  68                 PLA
000E11r 2  85 rr              STA   repeat_count_lo
000E13r 2  68                 PLA
000E14r 2  85 rr              STA   repcount
000E16r 2               
000E16r 2  A5 rr              LDA   handler_hi
000E18r 2  48                 PHA
000E19r 2  A5 rr              LDA   handler_lo
000E1Br 2  48                 PHA
000E1Cr 2  60                 RTS
000E1Dr 2               
000E1Dr 2               ; ---------------------------------------------------------------------
000E1Dr 2               ; print_byte_hex — print A as 2 hex digits
000E1Dr 2               ; ---------------------------------------------------------------------
000E1Dr 2               print_byte_hex:
000E1Dr 2  48                 PHA
000E1Er 2  4A                 LSR
000E1Fr 2  4A                 LSR
000E20r 2  4A                 LSR
000E21r 2  4A                 LSR
000E22r 2  20 rr rr           JSR   @nibble
000E25r 2  68                 PLA
000E26r 2  29 0F              AND   #$0F
000E28r 2  20 rr rr           JSR   @nibble
000E2Br 2  60                 RTS
000E2Cr 2               @nibble:
000E2Cr 2  C9 0A              CMP   #$0A
000E2Er 2  90 02              BCC   @digit
000E30r 2  69 06              ADC   #$06               ; carry is set, so adds 7
000E32r 2               @digit:
000E32r 2  69 30              ADC   #'0'
000E34r 2  8D 0E A0           STA   VGC_CHAROUT
000E37r 2  60                 RTS
000E38r 2               
000E38r 2               ; ---------------------------------------------------------------------
000E38r 2               ; skip_list_body — advance eval_cur past a [...] block without executing
000E38r 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000E38r 2               ;   Exit:  eval_cur points at the token after the matching TOK_RBRACKET
000E38r 2               ;          Carry clear = success, Carry set = missing bracket
000E38r 2               ;   Clobbers: A, X, Y, ptr_lo/hi
000E38r 2               ; ---------------------------------------------------------------------
000E38r 2               skip_list_body:
000E38r 2                     ; Verify current token is TOK_LBRACKET
000E38r 2  A5 rr              LDA   eval_cur_lo
000E3Ar 2  05 rr              ORA   eval_cur_hi
000E3Cr 2  F0 41              BEQ   @err
000E3Er 2  A5 rr              LDA   eval_cur_lo
000E40r 2  85 rr              STA   ptr_lo
000E42r 2  A5 rr              LDA   eval_cur_hi
000E44r 2  85 rr              STA   ptr_hi
