0023B1r 2               
0023B1r 2  C9 02              CMP   #VAL_LIST
0023B3r 2  F0 62              BEQ   @rl_sublist
0023B5r 2  C9 01              CMP   #VAL_WORD
0023B7r 2  F0 25              BEQ   @rl_word
