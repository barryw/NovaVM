0001D0r 2               ; ---------------------------------------------------------------------
0001D0r 2               ; tok_scan_varref — scan TOK_VARREF after ':'
0001D0r 2               ;   tok_src points at first char after ':'
0001D0r 2               ; ---------------------------------------------------------------------
