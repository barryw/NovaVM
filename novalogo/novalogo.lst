0015A3r 2               
0015A3r 2                     ; Link into list
0015A3r 2  A5 rr              LDA   z:list_head_lo
0015A5r 2  05 rr              ORA   z:list_head_hi
0015A7r 2  D0 0F              BNE   @rl_link_tail
0015A9r 2  A5 rr              LDA   ptr_lo
0015ABr 2  85 rr              STA   z:list_head_lo
0015ADr 2  85 rr              STA   z:list_tail_lo
0015AFr 2  A5 rr              LDA   ptr_hi
0015B1r 2  85 rr              STA   z:list_head_hi
0015B3r 2  85 rr              STA   z:list_tail_hi
0015B5r 2  4C rr rr           JMP   @rl_next
0015B8r 2               
0015B8r 2               @rl_link_tail:
0015B8r 2  A5 rr              LDA   z:list_tail_lo
0015BAr 2  85 rr              STA   ptr2_lo
0015BCr 2  A5 rr              LDA   z:list_tail_hi
0015BEr 2  85 rr              STA   ptr2_hi
0015C0r 2  A0 05              LDY   #CONS_CDR_LO
0015C2r 2  A5 rr              LDA   ptr_lo
0015C4r 2  91 rr              STA   (ptr2_lo),Y
0015C6r 2  A0 06              LDY   #CONS_CDR_HI
0015C8r 2  A5 rr              LDA   ptr_hi
0015CAr 2  91 rr              STA   (ptr2_lo),Y
0015CCr 2  A5 rr              LDA   ptr_lo
0015CEr 2  85 rr              STA   z:list_tail_lo
0015D0r 2  A5 rr              LDA   ptr_hi
0015D2r 2  85 rr              STA   z:list_tail_hi
0015D4r 2  4C rr rr           JMP   @rl_next
0015D7r 2               
0015D7r 2               @rl_build_done:
0015D7r 2                     ; Restore tokenizer state
0015D7r 2  68                 PLA
0015D8r 2  85 rr              STA   eval_cur_hi
0015DAr 2  68                 PLA
0015DBr 2  85 rr              STA   eval_cur_lo
0015DDr 2  68                 PLA
0015DEr 2  85 rr              STA   tok_tail_hi
0015E0r 2  68                 PLA
0015E1r 2  85 rr              STA   tok_tail_lo
0015E3r 2  68                 PLA
0015E4r 2  85 rr              STA   tok_head_hi
0015E6r 2  68                 PLA
0015E7r 2  85 rr              STA   tok_head_lo
0015E9r 2               
0015E9r 2                     ; Return the list
0015E9r 2  A9 02              LDA   #VAL_LIST
0015EBr 2  85 rr              STA   eval_type
0015EDr 2  A5 rr              LDA   z:list_head_lo
0015EFr 2  85 rr              STA   eval_val_lo
0015F1r 2  A5 rr              LDA   z:list_head_hi
0015F3r 2  85 rr              STA   eval_val_hi
0015F5r 2  64 rr              STZ   eval_val_frac
0015F7r 2  4C rr rr           JMP   eval_continue
0015FAr 2               
0015FAr 2               @rl_oom:
0015FAr 2                     ; Restore tokenizer state before error
0015FAr 2  68                 PLA
0015FBr 2  85 rr              STA   eval_cur_hi
0015FDr 2  68                 PLA
0015FEr 2  85 rr              STA   eval_cur_lo
001600r 2  68                 PLA
001601r 2  85 rr              STA   tok_tail_hi
001603r 2  68                 PLA
001604r 2  85 rr              STA   tok_tail_lo
001606r 2  68                 PLA
001607r 2  85 rr              STA   tok_head_hi
001609r 2  68                 PLA
00160Ar 2  85 rr              STA   tok_head_lo
00160Cr 2  A2 rr              LDX   #<str_oom
00160Er 2  A0 rr              LDY   #>str_oom
001610r 2  4C rr rr           JMP   list_print_err
001613r 2               
001613r 2               ; ---------------------------------------------------------------------
001613r 2               ; do_char — CHAR n: convert ASCII code to 1-char word
001613r 2               ;   Arity 0: evaluates its own argument
001613r 2               ; ---------------------------------------------------------------------
001613r 2               do_char:
001613r 2  20 rr rr           JSR   eval_expr
001616r 2  B0 09              BCS   @err
001618r 2                     ; Must be a number
001618r 2  A5 rr              LDA   eval_type
00161Ar 2  D0 05              BNE   @err
00161Cr 2                     ; Low byte of number is the ASCII code
00161Cr 2  A5 rr              LDA   eval_val_lo
00161Er 2  4C rr rr           JMP   alloc_one_char_word
001621r 2               @err:
001621r 2  A2 rr              LDX   #<str_char_err
001623r 2  A0 rr              LDY   #>str_char_err
001625r 2  4C rr rr           JMP   list_print_err
001628r 2               
001628r 2               ; ---------------------------------------------------------------------
001628r 2               ; do_ascii — ASCII word: return ASCII code of first character
001628r 2               ;   Arity 0: evaluates its own argument
001628r 2               ; ---------------------------------------------------------------------
001628r 2               do_ascii:
001628r 2  20 rr rr           JSR   eval_expr
00162Br 2  B0 23              BCS   @err
00162Dr 2                     ; Must be a word
00162Dr 2  A5 rr              LDA   eval_type
00162Fr 2  C9 01              CMP   #VAL_WORD
001631r 2  D0 1D              BNE   @err_type
001633r 2                     ; eval_val_lo/hi points at length-prefixed string
001633r 2  A5 rr              LDA   eval_val_lo
001635r 2  85 rr              STA   ptr_lo
001637r 2  A5 rr              LDA   eval_val_hi
001639r 2  85 rr              STA   ptr_hi
00163Br 2  A0 00              LDY   #0
00163Dr 2  B1 rr              LDA   (ptr_lo),Y           ; length
00163Fr 2  F0 0F              BEQ   @err_empty            ; empty word
001641r 2  A0 01              LDY   #1
001643r 2  B1 rr              LDA   (ptr_lo),Y           ; first character
001645r 2  85 rr              STA   eval_val_lo
001647r 2  64 rr              STZ   eval_val_hi
001649r 2  64 rr              STZ   eval_val_frac
00164Br 2  64 rr              STZ   eval_type             ; VAL_NUMBER
00164Dr 2  4C rr rr           JMP   eval_continue
001650r 2               @err_type:
001650r 2               @err_empty:
001650r 2               @err:
001650r 2  A2 rr              LDX   #<str_ascii_err
001652r 2  A0 rr              LDY   #>str_ascii_err
001654r 2  4C rr rr           JMP   list_print_err
001657r 2               
001657r 2               ; =====================================================================
001657r 2               ; Math functions and type predicates
001657r 2               ; =====================================================================
001657r 2               
001657r 2               ; ---------------------------------------------------------------------
001657r 2               ; return_number — set eval_val from eval_val_lo/hi, clear frac+type
001657r 2               ;   Entry: eval_val_lo/hi already set
001657r 2               ;   Jumps to eval_continue
001657r 2               ; ---------------------------------------------------------------------
001657r 2               return_number:
001657r 2  64 rr              STZ   eval_val_frac
001659r 2  64 rr              STZ   eval_type
00165Br 2  4C rr rr           JMP   eval_continue
00165Er 2               
00165Er 2               ; ---------------------------------------------------------------------
00165Er 2               ; return_signed_byte — sign-extend A into eval_val as 16.8 number
00165Er 2               ;   Entry: A = signed byte (-128..+127)
00165Er 2               ;   Jumps to eval_continue
00165Er 2               ; ---------------------------------------------------------------------
00165Er 2               return_signed_byte:
00165Er 2  85 rr              STA   eval_val_lo
001660r 2  10 04              BPL   @pos
001662r 2  A9 FF              LDA   #$FF
001664r 2  80 02              BRA   @set
001666r 2  A9 00        @pos: LDA   #$00
001668r 2  85 rr        @set: STA   eval_val_hi
00166Ar 2  80 EB              BRA   return_number
00166Cr 2               
00166Cr 2               ; ---------------------------------------------------------------------
00166Cr 2               ; predicate_result — set eval_val to 1 (Z set) or 0 (Z clear)
00166Cr 2               ;   Entry: Z flag from CMP
00166Cr 2               ;   Jumps to eval_continue
00166Cr 2               ; ---------------------------------------------------------------------
00166Cr 2               predicate_result:
00166Cr 2  F0 04              BEQ   @true
00166Er 2  64 rr              STZ   eval_val_lo
001670r 2  80 04              BRA   @done
001672r 2               @true:
001672r 2  A9 01              LDA   #1
001674r 2  85 rr              STA   eval_val_lo
001676r 2               @done:
001676r 2  64 rr              STZ   eval_val_hi
001678r 2  80 DD              BRA   return_number
00167Ar 2               
00167Ar 2               ; ---------------------------------------------------------------------
00167Ar 2               ; degrees_to_u8 — convert eval_val (degrees 0-360) to u8 angle (0-255)
00167Ar 2               ;   Uses MUL16 coprocessor: angle = degrees * 91 / 128
00167Ar 2               ;   Actually: write degrees to MUL16 A, 91 to B, read RES1 (high byte)
00167Ar 2               ;   Then shift right once (divide by 2) since 91/256=0.355, we want 91/128
00167Ar 2               ;   Wait, let me recalculate: degrees * 91 >> 7
00167Ar 2               ;   MUL16 gives degrees*91 in RES1:RES0. We want bits [14:7] of that.
00167Ar 2               ;   RES1 is bits [15:8]. But we want >>7 which is RES1<<1 | RES0>>7.
00167Ar 2               ;   Simpler: degrees * 182 / 256 = RES1 of (degrees * 182). Let's use 182.
00167Ar 2               ;   Output: A = u8 angle
00167Ar 2               ;   Clobbers: uses math coprocessor regs
00167Ar 2               ; ---------------------------------------------------------------------
00167Ar 2               degrees_to_u8:
00167Ar 2  A5 rr              LDA   eval_val_lo
00167Cr 2  8D 20 BB           STA   MATH_MUL16_A_LO
00167Fr 2  A5 rr              LDA   eval_val_hi
001681r 2  8D 21 BB           STA   MATH_MUL16_A_HI
001684r 2  A9 B6              LDA   #182
001686r 2  8D 22 BB           STA   MATH_MUL16_B_LO
001689r 2  9C 23 BB           STZ   MATH_MUL16_B_HI       ; trigger multiply
00168Cr 2  AD 39 BB           LDA   MATH_RES1              ; high byte = degrees * 182 / 256
00168Fr 2  60                 RTS
001690r 2               
001690r 2               ; ---------------------------------------------------------------------
001690r 2               ; do_sin — SIN degrees: return sin as signed byte (-128..+127)
001690r 2               ; ---------------------------------------------------------------------
001690r 2               do_sin:
001690r 2  20 rr rr           JSR   eval_expr
001693r 2  B0 0C              BCS   @err
001695r 2  20 rr rr           JSR   degrees_to_u8
001698r 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
00169Br 2  AD 38 BB           LDA   MATH_RES0              ; sin result (signed 1.7)
00169Er 2  4C rr rr           JMP   return_signed_byte
0016A1r 2               @err:
0016A1r 2  38                 SEC
0016A2r 2  60                 RTS
0016A3r 2               
0016A3r 2               ; ---------------------------------------------------------------------
0016A3r 2               ; do_cos — COS degrees: return cos as signed byte (-128..+127)
0016A3r 2               ; ---------------------------------------------------------------------
0016A3r 2               do_cos:
0016A3r 2  20 rr rr           JSR   eval_expr
0016A6r 2  B0 0C              BCS   @err
0016A8r 2  20 rr rr           JSR   degrees_to_u8
0016ABr 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
0016AEr 2  AD 39 BB           LDA   MATH_RES1              ; cos result (signed 1.7)
0016B1r 2  4C rr rr           JMP   return_signed_byte
0016B4r 2               @err:
0016B4r 2  38                 SEC
0016B5r 2  60                 RTS
0016B6r 2               
0016B6r 2               ; ---------------------------------------------------------------------
0016B6r 2               ; do_abs — ABS n: return absolute value
0016B6r 2               ; ---------------------------------------------------------------------
0016B6r 2               do_abs:
0016B6r 2  20 rr rr           JSR   eval_expr
0016B9r 2  B0 22              BCS   @err
0016BBr 2  A5 rr              LDA   eval_val_hi
0016BDr 2  10 19              BPL   @done                  ; already positive
0016BFr 2                     ; Negate 24-bit value
0016BFr 2  A5 rr              LDA   eval_val_frac
0016C1r 2  49 FF              EOR   #$FF
0016C3r 2  18                 CLC
0016C4r 2  69 01              ADC   #1
0016C6r 2  85 rr              STA   eval_val_frac
0016C8r 2  A5 rr              LDA   eval_val_lo
0016CAr 2  49 FF              EOR   #$FF
0016CCr 2  69 00              ADC   #0
0016CEr 2  85 rr              STA   eval_val_lo
0016D0r 2  A5 rr              LDA   eval_val_hi
0016D2r 2  49 FF              EOR   #$FF
0016D4r 2  69 00              ADC   #0
0016D6r 2  85 rr              STA   eval_val_hi
0016D8r 2               @done:
0016D8r 2  64 rr              STZ   eval_type
0016DAr 2  4C rr rr           JMP   eval_continue
0016DDr 2               @err:
0016DDr 2  38                 SEC
0016DEr 2  60                 RTS
0016DFr 2               
0016DFr 2               ; ---------------------------------------------------------------------
0016DFr 2               ; do_int — INT n: truncate fractional part
0016DFr 2               ; ---------------------------------------------------------------------
0016DFr 2               do_int:
0016DFr 2  20 rr rr           JSR   eval_expr
0016E2r 2  B0 07              BCS   @err
0016E4r 2  64 rr              STZ   eval_val_frac
0016E6r 2  64 rr              STZ   eval_type
0016E8r 2  4C rr rr           JMP   eval_continue
0016EBr 2               @err:
0016EBr 2  38                 SEC
0016ECr 2  60                 RTS
0016EDr 2               
0016EDr 2               ; ---------------------------------------------------------------------
0016EDr 2               ; do_round — ROUND n: round to nearest integer
0016EDr 2               ; ---------------------------------------------------------------------
0016EDr 2               do_round:
0016EDr 2  20 rr rr           JSR   eval_expr
0016F0r 2  B0 19              BCS   @err
0016F2r 2  A5 rr              LDA   eval_val_frac
0016F4r 2  C9 80              CMP   #128
0016F6r 2  90 0C              BCC   @trunc
0016F8r 2                     ; Round up: increment integer part
0016F8r 2  A5 rr              LDA   eval_val_hi
0016FAr 2  10 02              BPL   @pos_round
0016FCr 2                     ; Negative: actually round toward zero = truncate
0016FCr 2  80 06              BRA   @trunc
0016FEr 2               @pos_round:
0016FEr 2  E6 rr              INC   eval_val_lo
001700r 2  D0 02              BNE   @trunc
001702r 2  E6 rr              INC   eval_val_hi
001704r 2               @trunc:
001704r 2  64 rr              STZ   eval_val_frac
001706r 2  64 rr              STZ   eval_type
001708r 2  4C rr rr           JMP   eval_continue
00170Br 2               @err:
00170Br 2  38                 SEC
00170Cr 2  60                 RTS
00170Dr 2               
00170Dr 2               ; ---------------------------------------------------------------------
00170Dr 2               ; do_random — RANDOM n: return random number 0..n-1
00170Dr 2               ;   Uses math coprocessor RNG + MUL16 to scale
00170Dr 2               ; ---------------------------------------------------------------------
00170Dr 2               do_random:
00170Dr 2  20 rr rr           JSR   eval_expr
001710r 2  B0 1D              BCS   @err
001712r 2                     ; RNG byte * n / 256 gives 0..n-1
001712r 2  AD 37 BB           LDA   MATH_RNG
001715r 2  8D 20 BB           STA   MATH_MUL16_A_LO
001718r 2  9C 21 BB           STZ   MATH_MUL16_A_HI
00171Br 2  A5 rr              LDA   eval_val_lo
00171Dr 2  8D 22 BB           STA   MATH_MUL16_B_LO
001720r 2  A5 rr              LDA   eval_val_hi
001722r 2  8D 23 BB           STA   MATH_MUL16_B_HI       ; trigger
001725r 2  AD 39 BB           LDA   MATH_RES1              ; high byte of (rng * n) = rng*n/256
001728r 2  85 rr              STA   eval_val_lo
00172Ar 2  64 rr              STZ   eval_val_hi
00172Cr 2  4C rr rr           JMP   return_number
00172Fr 2               @err:
00172Fr 2  38                 SEC
001730r 2  60                 RTS
001731r 2               
001731r 2               ; ---------------------------------------------------------------------
001731r 2               ; do_sqrt — SQRT n: approximate sqrt via DIST_APPROX(n, 0)
001731r 2               ; ---------------------------------------------------------------------
001731r 2               do_sqrt:
001731r 2  20 rr rr           JSR   eval_expr
001734r 2  B0 1D              BCS   @err
001736r 2  A5 rr              LDA   eval_val_lo
001738r 2  8D 33 BB           STA   MATH_DIST_DX_LO
00173Br 2  A5 rr              LDA   eval_val_hi
00173Dr 2  8D 34 BB           STA   MATH_DIST_DX_HI
001740r 2  9C 35 BB           STZ   MATH_DIST_DY_LO
001743r 2  9C 36 BB           STZ   MATH_DIST_DY_HI       ; trigger (write to DY_HI triggers)
001746r 2  AD 38 BB           LDA   MATH_RES0
001749r 2  85 rr              STA   eval_val_lo
00174Br 2  AD 39 BB           LDA   MATH_RES1
00174Er 2  85 rr              STA   eval_val_hi
001750r 2  4C rr rr           JMP   return_number
001753r 2               @err:
001753r 2  38                 SEC
001754r 2  60                 RTS
001755r 2               
001755r 2               ; ---------------------------------------------------------------------
001755r 2               ; do_remainder — REMAINDER a b: return a mod b via DIV coprocessor
001755r 2               ; ---------------------------------------------------------------------
001755r 2               do_remainder:
001755r 2  20 rr rr           JSR   eval_expr              ; first arg (a)
001758r 2  B0 49              BCS   @err
00175Ar 2  A5 rr              LDA   eval_val_lo
00175Cr 2  48                 PHA
00175Dr 2  A5 rr              LDA   eval_val_hi
00175Fr 2  48                 PHA
001760r 2  20 rr rr           JSR   eval_expr              ; second arg (b)
001763r 2  B0 3C              BCS   @err_pop
001765r 2                     ; b in eval_val, a on stack
001765r 2                     ; Check divide by zero
001765r 2  A5 rr              LDA   eval_val_lo
001767r 2  05 rr              ORA   eval_val_hi
001769r 2  F0 2D              BEQ   @zero_pop
00176Br 2                     ; Set up 32÷16 division: dividend=a, divisor=b
00176Br 2  68                 PLA
00176Cr 2  8D 29 BB           STA   MATH_DIV_N_1           ; a_hi
00176Fr 2  AA                 TAX                          ; save for sign-extend
001770r 2  68                 PLA
001771r 2  8D 28 BB           STA   MATH_DIV_N_LO          ; a_lo
001774r 2                     ; Sign-extend a
001774r 2  8A                 TXA
001775r 2  09 7F              ORA   #$7F
001777r 2  30 02              BMI   @neg_a
001779r 2  A9 00              LDA   #$00
00177Br 2               @neg_a:                            ; A=$FF if negative
00177Br 2  8D 2A BB           STA   MATH_DIV_N_2
00177Er 2  8D 2B BB           STA   MATH_DIV_N_HI
001781r 2  A5 rr              LDA   eval_val_lo
001783r 2  8D 2C BB           STA   MATH_DIV_D_LO
001786r 2  A5 rr              LDA   eval_val_hi
001788r 2  8D 2D BB           STA   MATH_DIV_D_HI          ; trigger
00178Br 2                     ; Remainder is in RES2:RES3 (actually check what the copro returns)
00178Br 2                     ; The math copro returns quotient in RES0:RES1, remainder in RES2:RES3
00178Br 2  AD 3A BB           LDA   MATH_RES2
00178Er 2  85 rr              STA   eval_val_lo
001790r 2  AD 3B BB           LDA   MATH_RES3
001793r 2  85 rr              STA   eval_val_hi
001795r 2  4C rr rr           JMP   return_number
001798r 2               @zero_pop:
001798r 2  68                 PLA
001799r 2  68                 PLA
00179Ar 2  64 rr              STZ   eval_val_lo
00179Cr 2  64 rr              STZ   eval_val_hi
00179Er 2  4C rr rr           JMP   return_number
0017A1r 2               @err_pop:
0017A1r 2  68                 PLA
0017A2r 2  68                 PLA
0017A3r 2               @err:
0017A3r 2  38                 SEC
0017A4r 2  60                 RTS
0017A5r 2               
0017A5r 2               ; ---------------------------------------------------------------------
0017A5r 2               ; do_not — NOT expr: return 1 if expr is 0, else 0
0017A5r 2               ; ---------------------------------------------------------------------
0017A5r 2               do_not:
0017A5r 2  20 rr rr           JSR   eval_expr
0017A8r 2  B0 13              BCS   @err
0017AAr 2  A5 rr              LDA   eval_val_lo
0017ACr 2  05 rr              ORA   eval_val_hi
0017AEr 2                     ; If zero, set result to 1. If nonzero, set to 0.
0017AEr 2  D0 06              BNE   @false
0017B0r 2  A9 01              LDA   #1
0017B2r 2  85 rr              STA   eval_val_lo
0017B4r 2  80 02              BRA   @done
0017B6r 2               @false:
0017B6r 2  64 rr              STZ   eval_val_lo
0017B8r 2               @done:
0017B8r 2  64 rr              STZ   eval_val_hi
0017BAr 2  4C rr rr           JMP   return_number
0017BDr 2               @err:
0017BDr 2  38                 SEC
0017BEr 2  60                 RTS
0017BFr 2               
0017BFr 2               ; ---------------------------------------------------------------------
0017BFr 2               ; do_and — AND a b: return 1 if both nonzero, else 0
0017BFr 2               ; ---------------------------------------------------------------------
0017BFr 2               do_and:
0017BFr 2  20 rr rr           JSR   eval_expr
0017C2r 2  B0 1E              BCS   @err
0017C4r 2  A5 rr              LDA   eval_val_lo
0017C6r 2  05 rr              ORA   eval_val_hi
0017C8r 2  F0 11              BEQ   @false                 ; first arg is 0 → short-circuit
0017CAr 2  20 rr rr           JSR   eval_expr
0017CDr 2  B0 13              BCS   @err
0017CFr 2  A5 rr              LDA   eval_val_lo
0017D1r 2  05 rr              ORA   eval_val_hi
0017D3r 2  F0 06              BEQ   @false
0017D5r 2  A9 01              LDA   #1
0017D7r 2  85 rr              STA   eval_val_lo
0017D9r 2  80 02              BRA   @done
0017DBr 2               @false:
0017DBr 2  64 rr              STZ   eval_val_lo
0017DDr 2               @done:
0017DDr 2  64 rr              STZ   eval_val_hi
0017DFr 2  4C rr rr           JMP   return_number
0017E2r 2               @err:
0017E2r 2  38                 SEC
0017E3r 2  60                 RTS
0017E4r 2               
0017E4r 2               ; ---------------------------------------------------------------------
0017E4r 2               ; do_or — OR a b: return 1 if either nonzero, else 0
0017E4r 2               ; ---------------------------------------------------------------------
0017E4r 2               do_or:
0017E4r 2  20 rr rr           JSR   eval_expr
0017E7r 2  B0 1E              BCS   @err
0017E9r 2  A5 rr              LDA   eval_val_lo
0017EBr 2  05 rr              ORA   eval_val_hi
0017EDr 2  D0 0F              BNE   @true                  ; first arg nonzero → short-circuit
0017EFr 2  20 rr rr           JSR   eval_expr
0017F2r 2  B0 13              BCS   @err
0017F4r 2  A5 rr              LDA   eval_val_lo
0017F6r 2  05 rr              ORA   eval_val_hi
0017F8r 2  D0 04              BNE   @true
0017FAr 2  64 rr              STZ   eval_val_lo
0017FCr 2  80 04              BRA   @done
0017FEr 2               @true:
0017FEr 2  A9 01              LDA   #1
001800r 2  85 rr              STA   eval_val_lo
001802r 2               @done:
001802r 2  64 rr              STZ   eval_val_hi
001804r 2  4C rr rr           JMP   return_number
001807r 2               @err:
001807r 2  38                 SEC
001808r 2  60                 RTS
001809r 2               
001809r 2               ; ---------------------------------------------------------------------
001809r 2               ; Type predicates — NUMBER?, WORD?, LIST?
001809r 2               ; ---------------------------------------------------------------------
001809r 2               do_numberp:
001809r 2  20 rr rr           JSR   eval_expr
00180Cr 2  B0 07              BCS   @err
00180Er 2  A5 rr              LDA   eval_type
001810r 2  C9 00              CMP   #VAL_NUMBER
001812r 2  4C rr rr           JMP   predicate_result
001815r 2               @err:
001815r 2  38                 SEC
001816r 2  60                 RTS
001817r 2               
001817r 2               do_wordp:
001817r 2  20 rr rr           JSR   eval_expr
00181Ar 2  B0 07              BCS   @err
00181Cr 2  A5 rr              LDA   eval_type
00181Er 2  C9 01              CMP   #VAL_WORD
001820r 2  4C rr rr           JMP   predicate_result
001823r 2               @err:
001823r 2  38                 SEC
001824r 2  60                 RTS
001825r 2               
001825r 2               do_listp:
001825r 2  20 rr rr           JSR   eval_expr
001828r 2  B0 07              BCS   @err
00182Ar 2  A5 rr              LDA   eval_type
00182Cr 2  C9 02              CMP   #VAL_LIST
00182Er 2  4C rr rr           JMP   predicate_result
