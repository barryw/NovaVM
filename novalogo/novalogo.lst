002D83r 2                     ; Accumulate physical lines into one logical statement: keep copying lines
002D83r 2                     ; into input_buf until bracket/paren depth returns to 0, so a [ ... ] or
002D83r 2                     ; ( ... ) that spans several lines is pieced together before we tokenize.
002D83r 2  A2 00              LDX   #0                    ; input_buf index
002D85r 2  9C rr rr           STZ   proc_brk_depth
002D88r 2               @line_ch:
002D88r 2  A5 rr              LDA   proc_body_len_lo
002D8Ar 2  05 rr              ORA   proc_body_len_hi
002D8Cr 2  F0 71              BEQ   @line_eol             ; no more body text -> end of last line
