0005B9r 1                     .include "lists.s"
0005B9r 2               ; lists.s — list data type, cons pairs, and list operations for NovaLogo
0005B9r 2               ;
0005B9r 2               ; Cons pair format on heap (7 bytes):
0005B9r 2               ;   +0: tag byte ($10 = CONS_PAIR)
0005B9r 2               ;   +1: car_type ($00=number, $01=word, $02=list)
0005B9r 2               ;   +2: car_hi
0005B9r 2               ;   +3: car_lo
0005B9r 2               ;   +4: car_frac (only meaningful for numbers)
0005B9r 2               ;   +5: cdr_lo (pointer to next cons pair, or $0000 for empty)
0005B9r 2               ;   +6: cdr_hi
0005B9r 2               
0005B9r 2               CONS_PAIR  = $10
0005B9r 2               CONS_SIZE  = 7
0005B9r 2               
0005B9r 2               ; Value type constants
0005B9r 2               .ifndef VAL_NUMBER
0005B9r 2               VAL_NUMBER = $00
0005B9r 2               .endif
0005B9r 2               .ifndef VAL_WORD
0005B9r 2               VAL_WORD   = $01
0005B9r 2               .endif
0005B9r 2               .ifndef VAL_LIST
0005B9r 2               VAL_LIST   = $02
0005B9r 2               .endif
0005B9r 2               
0005B9r 2               ; Cons pair field offsets
0005B9r 2               CONS_TAG      = 0
0005B9r 2               CONS_CAR_TYPE = 1
0005B9r 2               CONS_CAR_HI   = 2
0005B9r 2               CONS_CAR_LO   = 3
0005B9r 2               CONS_CAR_FRAC = 4
0005B9r 2               CONS_CDR_LO   = 5
0005B9r 2               CONS_CDR_HI   = 6
0005B9r 2               
0005B9r 2               ; =====================================================================
0005B9r 2               ; ZEROPAGE segment — list scratch variables
0005B9r 2               ; =====================================================================
0005B9r 2                     .segment "ZEROPAGE"
00002Fr 2               
00002Fr 2  xx           list_head_lo:   .res 1    ; head of list being built
000030r 2  xx           list_head_hi:   .res 1
000031r 2  xx           list_tail_lo:   .res 1    ; tail of list being built
000032r 2  xx           list_tail_hi:   .res 1
000033r 2  xx           list_ptr_lo:    .res 1    ; general list walk pointer
000034r 2  xx           list_ptr_hi:    .res 1
000035r 2  xx           list_count_lo:  .res 1    ; 16-bit counter for COUNT / ITEM
000036r 2  xx           list_count_hi:  .res 1
000037r 2               
000037r 2               ; =====================================================================
000037r 2               ; CODE segment — list building and operations
000037r 2               ; =====================================================================
000037r 2                     .segment "CODE"
001846r 2               
001846r 2               ; ---------------------------------------------------------------------
001846r 2               ; eval_list — build a list from tokens between [ and ]
001846r 2               ;   Entry: eval_cur points at the first token AFTER the [
001846r 2               ;   Exit:  eval_type = VAL_LIST, eval_val_lo/hi = head cons pair ptr
001846r 2               ;          eval_cur advanced past the matching ]
001846r 2               ;          Carry clear = success
001846r 2               ; ---------------------------------------------------------------------
001846r 2               eval_list:
001846r 2  64 rr              STZ   list_head_lo
001848r 2  64 rr              STZ   list_head_hi
00184Ar 2  64 rr              STZ   list_tail_lo
00184Cr 2  64 rr              STZ   list_tail_hi
00184Er 2               
00184Er 2               @next_element:
00184Er 2  A5 rr              LDA   eval_cur_lo
001850r 2  05 rr              ORA   eval_cur_hi
001852r 2  D0 03              BNE   :+
001854r 2  4C rr rr           JMP   @err_no_bracket
001857r 2               :
001857r 2  A5 rr              LDA   eval_cur_lo
001859r 2  85 rr              STA   ptr_lo
00185Br 2  A5 rr              LDA   eval_cur_hi
00185Dr 2  85 rr              STA   ptr_hi
00185Fr 2  A0 00              LDY   #TOK_TAG
001861r 2  B1 rr              LDA   (ptr_lo),Y
001863r 2               
001863r 2  C9 04              CMP   #TOK_RBRACKET
001865r 2  D0 03              BNE   :+
001867r 2  4C rr rr           JMP   @end_list
00186Ar 2               :
00186Ar 2  C9 02              CMP   #TOK_NUMBER
00186Cr 2  D0 03              BNE   :+
00186Er 2  4C rr rr           JMP   @list_number
001871r 2  C9 01        :     CMP   #TOK_WORD
001873r 2  F0 10              BEQ   @list_word_jmp
001875r 2  C9 06              CMP   #TOK_QUOTE
001877r 2  F0 0C              BEQ   @list_word_jmp
001879r 2  C9 03              CMP   #TOK_LBRACKET
00187Br 2  D0 03              BNE   :+
00187Dr 2  4C rr rr           JMP   @list_sublist
001880r 2               :     ; Unknown token type in list — skip it
001880r 2  20 rr rr           JSR   eval_advance
001883r 2  80 C9              BRA   @next_element
001885r 2               
001885r 2               @list_word_jmp:
001885r 2  4C rr rr           JMP   @list_word
001888r 2               
001888r 2               @list_number:
001888r 2  A0 03              LDY   #TOK_PAYLOAD
00188Ar 2  B1 rr              LDA   (ptr_lo),Y
00188Cr 2  85 rr              STA   eval_val_hi
00188Er 2  C8                 INY
00188Fr 2  B1 rr              LDA   (ptr_lo),Y
001891r 2  85 rr              STA   eval_val_lo
001893r 2  C8                 INY
001894r 2  B1 rr              LDA   (ptr_lo),Y
001896r 2  85 rr              STA   eval_val_frac
001898r 2  A9 00              LDA   #VAL_NUMBER
00189Ar 2  85 rr              STA   eval_type
00189Cr 2  20 rr rr           JSR   eval_advance
00189Fr 2  4C rr rr           JMP   @alloc_cell
0018A2r 2               
0018A2r 2               @list_word:
0018A2r 2  A0 03              LDY   #TOK_PAYLOAD
0018A4r 2  B1 rr              LDA   (ptr_lo),Y
0018A6r 2  48                 PHA
0018A7r 2  1A                 INC
0018A8r 2  A2 05              LDX   #ATYPE_STRING
0018AAr 2  20 rr rr           JSR   heap_alloc
0018ADr 2  90 04              BCC   :+
0018AFr 2  68                 PLA
0018B0r 2  4C rr rr           JMP   @oom
0018B3r 2  A5 rr        :     LDA   eval_cur_lo
0018B5r 2  85 rr              STA   ptr2_lo
0018B7r 2  A5 rr              LDA   eval_cur_hi
0018B9r 2  85 rr              STA   ptr2_hi
0018BBr 2  68                 PLA
0018BCr 2  48                 PHA
0018BDr 2  A0 00              LDY   #0
0018BFr 2  91 rr              STA   (ptr_lo),Y
0018C1r 2  68                 PLA
0018C2r 2  AA                 TAX
0018C3r 2  F0 1B              BEQ   @word_done
0018C5r 2  A0 01              LDY   #1
0018C7r 2  9C rr rr           STZ   num_tmp_lo
0018CAr 2               @copy_word_ch:
0018CAr 2  DA                 PHX
0018CBr 2  5A                 PHY
0018CCr 2  AD rr rr           LDA   num_tmp_lo
0018CFr 2  18                 CLC
0018D0r 2  69 04              ADC   #TOK_PAYLOAD+1
0018D2r 2  A8                 TAY
0018D3r 2  B1 rr              LDA   (ptr2_lo),Y
0018D5r 2  7A                 PLY
0018D6r 2  91 rr              STA   (ptr_lo),Y
0018D8r 2  C8                 INY
0018D9r 2  EE rr rr           INC   num_tmp_lo
0018DCr 2  FA                 PLX
0018DDr 2  CA                 DEX
0018DEr 2  D0 EA              BNE   @copy_word_ch
0018E0r 2               @word_done:
0018E0r 2  A5 rr              LDA   ptr_lo
0018E2r 2  85 rr              STA   eval_val_lo
0018E4r 2  A5 rr              LDA   ptr_hi
0018E6r 2  85 rr              STA   eval_val_hi
0018E8r 2  64 rr              STZ   eval_val_frac
0018EAr 2  A9 01              LDA   #VAL_WORD
0018ECr 2  85 rr              STA   eval_type
0018EEr 2  20 rr rr           JSR   eval_advance
0018F1r 2  4C rr rr           JMP   @alloc_cell
0018F4r 2               
0018F4r 2               @list_sublist:
0018F4r 2  20 rr rr           JSR   eval_advance
0018F7r 2  A5 rr              LDA   list_head_lo
0018F9r 2  48                 PHA
0018FAr 2  A5 rr              LDA   list_head_hi
0018FCr 2  48                 PHA
0018FDr 2  A5 rr              LDA   list_tail_lo
0018FFr 2  48                 PHA
001900r 2  A5 rr              LDA   list_tail_hi
001902r 2  48                 PHA
001903r 2  20 rr rr           JSR   eval_list
001906r 2  90 06              BCC   @sublist_ok
001908r 2                     ; Error — clean up stack
001908r 2  68                 PLA
001909r 2  68                 PLA
00190Ar 2  68                 PLA
00190Br 2  68                 PLA
00190Cr 2  38                 SEC
00190Dr 2  60                 RTS
00190Er 2               @sublist_ok:
00190Er 2  68                 PLA
00190Fr 2  85 rr              STA   list_tail_hi
001911r 2  68                 PLA
001912r 2  85 rr              STA   list_tail_lo
001914r 2  68                 PLA
001915r 2  85 rr              STA   list_head_hi
001917r 2  68                 PLA
001918r 2  85 rr              STA   list_head_lo
00191Ar 2                     ; eval_type already VAL_LIST, eval_val has sublist ptr
00191Ar 2                     ; fall through to @alloc_cell
00191Ar 2               
00191Ar 2               @alloc_cell:
00191Ar 2  A9 07              LDA   #CONS_SIZE
00191Cr 2  A2 02              LDX   #ATYPE_CONS
00191Er 2  20 rr rr           JSR   heap_alloc
001921r 2  B0 71              BCS   @oom
001923r 2  A0 00              LDY   #CONS_TAG
001925r 2  A9 10              LDA   #CONS_PAIR
001927r 2  91 rr              STA   (ptr_lo),Y
001929r 2  A0 01              LDY   #CONS_CAR_TYPE
00192Br 2  A5 rr              LDA   eval_type
00192Dr 2  91 rr              STA   (ptr_lo),Y
00192Fr 2  A0 02              LDY   #CONS_CAR_HI
001931r 2  A5 rr              LDA   eval_val_hi
001933r 2  91 rr              STA   (ptr_lo),Y
001935r 2  A0 03              LDY   #CONS_CAR_LO
001937r 2  A5 rr              LDA   eval_val_lo
001939r 2  91 rr              STA   (ptr_lo),Y
00193Br 2  A0 04              LDY   #CONS_CAR_FRAC
00193Dr 2  A5 rr              LDA   eval_val_frac
00193Fr 2  91 rr              STA   (ptr_lo),Y
001941r 2  A0 05              LDY   #CONS_CDR_LO
001943r 2  A9 00              LDA   #0
001945r 2  91 rr              STA   (ptr_lo),Y
001947r 2  A0 06              LDY   #CONS_CDR_HI
001949r 2  91 rr              STA   (ptr_lo),Y
00194Br 2               
00194Br 2                     ; Link into list
00194Br 2  A5 rr              LDA   list_head_lo
00194Dr 2  05 rr              ORA   list_head_hi
00194Fr 2  D0 0F              BNE   @link_tail
001951r 2               
001951r 2  A5 rr              LDA   ptr_lo
001953r 2  85 rr              STA   list_head_lo
001955r 2  85 rr              STA   list_tail_lo
001957r 2  A5 rr              LDA   ptr_hi
001959r 2  85 rr              STA   list_head_hi
00195Br 2  85 rr              STA   list_tail_hi
00195Dr 2  4C rr rr           JMP   @next_element
001960r 2               
001960r 2               @link_tail:
001960r 2  A5 rr              LDA   list_tail_lo
001962r 2  85 rr              STA   ptr2_lo
001964r 2  A5 rr              LDA   list_tail_hi
001966r 2  85 rr              STA   ptr2_hi
001968r 2  A0 05              LDY   #CONS_CDR_LO
00196Ar 2  A5 rr              LDA   ptr_lo
00196Cr 2  91 rr              STA   (ptr2_lo),Y
00196Er 2  A0 06              LDY   #CONS_CDR_HI
001970r 2  A5 rr              LDA   ptr_hi
001972r 2  91 rr              STA   (ptr2_lo),Y
001974r 2  A5 rr              LDA   ptr_lo
001976r 2  85 rr              STA   list_tail_lo
001978r 2  A5 rr              LDA   ptr_hi
00197Ar 2  85 rr              STA   list_tail_hi
00197Cr 2  4C rr rr           JMP   @next_element
00197Fr 2               
00197Fr 2               @end_list:
00197Fr 2  20 rr rr           JSR   eval_advance
001982r 2  A9 02              LDA   #VAL_LIST
001984r 2  85 rr              STA   eval_type
001986r 2  A5 rr              LDA   list_head_lo
001988r 2  85 rr              STA   eval_val_lo
00198Ar 2  A5 rr              LDA   list_head_hi
00198Cr 2  85 rr              STA   eval_val_hi
00198Er 2  64 rr              STZ   eval_val_frac
001990r 2  18                 CLC
001991r 2  60                 RTS
001992r 2               
001992r 2               @err_no_bracket:
001992r 2  38                 SEC
001993r 2  60                 RTS
001994r 2               
001994r 2               @oom:
001994r 2  38                 SEC
001995r 2  60                 RTS
001996r 2               
001996r 2               ; ---------------------------------------------------------------------
001996r 2               ; print_list — print a list value to screen with brackets
001996r 2               ;   Entry: eval_val_lo/hi = head cons pair pointer (or $0000)
001996r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr
001996r 2               ; ---------------------------------------------------------------------
001996r 2               print_list:
001996r 2  A9 5B              LDA   #'['
001998r 2  8D 0E A0           STA   VGC_CHAROUT
00199Br 2               
00199Br 2  A5 rr              LDA   eval_val_lo
00199Dr 2  85 rr              STA   list_ptr_lo
00199Fr 2  A5 rr              LDA   eval_val_hi
0019A1r 2  85 rr              STA   list_ptr_hi
0019A3r 2               
0019A3r 2  A2 00              LDX   #0                  ; 0 = first element (no leading space)
0019A5r 2               
0019A5r 2               @pl_loop:
0019A5r 2  A5 rr              LDA   list_ptr_lo
0019A7r 2  05 rr              ORA   list_ptr_hi
0019A9r 2  D0 03              BNE   :+
0019ABr 2  4C rr rr           JMP   @pl_done
0019AEr 2               :
0019AEr 2  E0 00              CPX   #0
0019B0r 2  F0 05              BEQ   @pl_no_space
0019B2r 2  A9 20              LDA   #' '
0019B4r 2  8D 0E A0           STA   VGC_CHAROUT
0019B7r 2               @pl_no_space:
0019B7r 2  A2 01              LDX   #1
0019B9r 2               
0019B9r 2  A5 rr              LDA   list_ptr_lo
0019BBr 2  85 rr              STA   ptr_lo
0019BDr 2  A5 rr              LDA   list_ptr_hi
0019BFr 2  85 rr              STA   ptr_hi
0019C1r 2  A0 01              LDY   #CONS_CAR_TYPE
0019C3r 2  B1 rr              LDA   (ptr_lo),Y
0019C5r 2  C9 02              CMP   #VAL_LIST
0019C7r 2  F0 2C              BEQ   @pl_sublist
0019C9r 2  C9 01              CMP   #VAL_WORD
0019CBr 2  D0 03              BNE   :+
0019CDr 2  4C rr rr           JMP   @pl_word
0019D0r 2               :
0019D0r 2                     ; Number
0019D0r 2  DA                 PHX
0019D1r 2  A5 rr              LDA   list_ptr_lo
0019D3r 2  48                 PHA
0019D4r 2  A5 rr              LDA   list_ptr_hi
0019D6r 2  48                 PHA
0019D7r 2  A0 02              LDY   #CONS_CAR_HI
0019D9r 2  B1 rr              LDA   (ptr_lo),Y
0019DBr 2  85 rr              STA   eval_val_hi
0019DDr 2  A0 03              LDY   #CONS_CAR_LO
0019DFr 2  B1 rr              LDA   (ptr_lo),Y
0019E1r 2  85 rr              STA   eval_val_lo
0019E3r 2  A0 04              LDY   #CONS_CAR_FRAC
0019E5r 2  B1 rr              LDA   (ptr_lo),Y
0019E7r 2  85 rr              STA   eval_val_frac
0019E9r 2  20 rr rr           JSR   print_number
0019ECr 2  68                 PLA
0019EDr 2  85 rr              STA   list_ptr_hi
0019EFr 2  68                 PLA
0019F0r 2  85 rr              STA   list_ptr_lo
0019F2r 2  FA                 PLX
0019F3r 2  80 4A              BRA   @pl_advance
0019F5r 2               
0019F5r 2               @pl_sublist:
0019F5r 2  DA                 PHX
0019F6r 2  A5 rr              LDA   list_ptr_lo
0019F8r 2  48                 PHA
0019F9r 2  A5 rr              LDA   list_ptr_hi
0019FBr 2  48                 PHA
0019FCr 2  A0 03              LDY   #CONS_CAR_LO
0019FEr 2  B1 rr              LDA   (ptr_lo),Y
001A00r 2  85 rr              STA   eval_val_lo
001A02r 2  A0 02              LDY   #CONS_CAR_HI
001A04r 2  B1 rr              LDA   (ptr_lo),Y
001A06r 2  85 rr              STA   eval_val_hi
001A08r 2  20 rr rr           JSR   print_list
001A0Br 2  68                 PLA
001A0Cr 2  85 rr              STA   list_ptr_hi
001A0Er 2  68                 PLA
001A0Fr 2  85 rr              STA   list_ptr_lo
001A11r 2  FA                 PLX
001A12r 2  80 2B              BRA   @pl_advance
001A14r 2               
