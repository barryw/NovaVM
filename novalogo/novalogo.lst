0021DDr 2               ; ---------------------------------------------------------------------
0021DDr 2               ; do_word — WORD val1 val2: concatenate two words into one
0021DDr 2               ;   Arity 0: evaluates its own arguments
0021DDr 2               ; ---------------------------------------------------------------------
0021DDr 2               do_word:
0021DDr 2                     ; Evaluate first arg (must be a word)
0021DDr 2  20 rr rr           JSR   eval_expr
0021E0r 2  90 03              BCC   :+
0021E2r 2  4C rr rr           JMP   @err
0021E5r 2               :
0021E5r 2  A5 rr              LDA   eval_type
0021E7r 2  C9 01              CMP   #VAL_WORD
0021E9r 2  F0 03              BEQ   :+
0021EBr 2  4C rr rr           JMP   @err_type
0021EEr 2               :
0021EEr 2                     ; Save first word pointer
0021EEr 2  A5 rr              LDA   eval_val_lo
0021F0r 2  48                 PHA
0021F1r 2  A5 rr              LDA   eval_val_hi
0021F3r 2  48                 PHA
0021F4r 2               
0021F4r 2                     ; Evaluate second arg (must be a word)
0021F4r 2  20 rr rr           JSR   eval_expr
0021F7r 2  90 05              BCC   :+
0021F9r 2  68                 PLA
0021FAr 2  68                 PLA
0021FBr 2  4C rr rr           JMP   @err
0021FEr 2               :
0021FEr 2  A5 rr              LDA   eval_type
002200r 2  C9 01              CMP   #VAL_WORD
002202r 2  F0 03              BEQ   :+
002204r 2  4C rr rr           JMP   @err_type_pop2
002207r 2               :
002207r 2               
002207r 2                     ; eval_val = second word, stack has first word ptr
002207r 2                     ; Read lengths
002207r 2  A5 rr              LDA   eval_val_lo
002209r 2  85 rr              STA   ptr2_lo
00220Br 2  A5 rr              LDA   eval_val_hi
00220Dr 2  85 rr              STA   ptr2_hi
00220Fr 2  A0 00              LDY   #0
002211r 2  B1 rr              LDA   (ptr2_lo),Y            ; second word length
002213r 2  85 rr              STA   list_count_lo           ; save len2
002215r 2               
002215r 2                     ; Read first word length from stack
002215r 2  68                 PLA
002216r 2  85 rr              STA   list_head_hi            ; first word ptr hi
002218r 2  68                 PLA
002219r 2  85 rr              STA   list_head_lo            ; first word ptr lo
00221Br 2  A5 rr              LDA   list_head_lo
00221Dr 2  85 rr              STA   ptr_lo
00221Fr 2  A5 rr              LDA   list_head_hi
002221r 2  85 rr              STA   ptr_hi
002223r 2  A0 00              LDY   #0
002225r 2  B1 rr              LDA   (ptr_lo),Y             ; first word length
002227r 2  85 rr              STA   list_count_hi           ; save len1
002229r 2               
002229r 2                     ; Allocate new string: 1 (length byte) + len1 + len2
002229r 2  18                 CLC
00222Ar 2  65 rr              ADC   list_count_lo
00222Cr 2  1A                 INC                           ; +1 for length byte
00222Dr 2  A2 05              LDX   #ATYPE_STRING
00222Fr 2  20 rr rr           JSR   heap_alloc
002232r 2  B0 6F              BCS   @err_oom
002234r 2               
002234r 2                     ; Write combined length
002234r 2  A5 rr              LDA   list_count_hi
002236r 2  18                 CLC
002237r 2  65 rr              ADC   list_count_lo
002239r 2  A0 00              LDY   #0
00223Br 2  91 rr              STA   (ptr_lo),Y
00223Dr 2               
00223Dr 2                     ; Copy first word's chars
00223Dr 2  A6 rr              LDX   list_count_hi           ; len1
00223Fr 2  F0 23              BEQ   @w_copy2
002241r 2  A5 rr              LDA   list_head_lo
002243r 2  85 rr              STA   ptr2_lo
002245r 2  A5 rr              LDA   list_head_hi
002247r 2  85 rr              STA   ptr2_hi
002249r 2  A0 01              LDY   #1                     ; dest offset in new string
00224Br 2  9C rr rr           STZ   num_tmp_lo              ; source offset
00224Er 2               @w_c1:
00224Er 2  DA                 PHX
00224Fr 2  5A                 PHY
002250r 2  AD rr rr           LDA   num_tmp_lo
002253r 2  1A                 INC                           ; skip length byte in source
002254r 2  A8                 TAY
002255r 2  B1 rr              LDA   (ptr2_lo),Y            ; source char
002257r 2  7A                 PLY
002258r 2  91 rr              STA   (ptr_lo),Y             ; dest char
00225Ar 2  C8                 INY
00225Br 2  EE rr rr           INC   num_tmp_lo
00225Er 2  FA                 PLX
00225Fr 2  CA                 DEX
002260r 2  D0 EC              BNE   @w_c1
002262r 2               
002262r 2                     ; Y is already at the next dest offset
002262r 2  80 02              BRA   @w_copy2_start
002264r 2               
002264r 2               @w_copy2:
002264r 2  A0 01              LDY   #1                     ; start at offset 1 if len1 was 0
002266r 2               @w_copy2_start:
002266r 2                     ; Copy second word's chars
002266r 2  A6 rr              LDX   list_count_lo           ; len2
002268r 2  F0 1F              BEQ   @w_done
00226Ar 2  A5 rr              LDA   eval_val_lo
00226Cr 2  85 rr              STA   ptr2_lo
00226Er 2  A5 rr              LDA   eval_val_hi
002270r 2  85 rr              STA   ptr2_hi
002272r 2  9C rr rr           STZ   num_tmp_lo
002275r 2               @w_c2:
002275r 2  DA                 PHX
002276r 2  5A                 PHY
002277r 2  AD rr rr           LDA   num_tmp_lo
00227Ar 2  1A                 INC
00227Br 2  A8                 TAY
00227Cr 2  B1 rr              LDA   (ptr2_lo),Y
00227Er 2  7A                 PLY
00227Fr 2  91 rr              STA   (ptr_lo),Y
002281r 2  C8                 INY
002282r 2  EE rr rr           INC   num_tmp_lo
002285r 2  FA                 PLX
002286r 2  CA                 DEX
002287r 2  D0 EC              BNE   @w_c2
002289r 2               
002289r 2               @w_done:
002289r 2                     ; Return the new word
002289r 2  A9 01              LDA   #VAL_WORD
00228Br 2  85 rr              STA   eval_type
00228Dr 2  A5 rr              LDA   ptr_lo
00228Fr 2  85 rr              STA   eval_val_lo
002291r 2  A5 rr              LDA   ptr_hi
002293r 2  85 rr              STA   eval_val_hi
002295r 2  64 rr              STZ   eval_val_frac
002297r 2  4C rr rr           JMP   eval_continue
