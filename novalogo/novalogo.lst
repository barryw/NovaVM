000DB9r 2               ; repeat_restore_state — pop 7 saved bytes from stack to ZP
000DB9r 2               ;   Restores eval_in_body, body_resume, body_start, repeat_count
000DB9r 2               ;   Must be called via JSR (uses return address on stack correctly)
000DB9r 2               ; ---------------------------------------------------------------------
000DB9r 2               repeat_restore_state:
000DB9r 2                     ; Pull our return address, pop 8 saved bytes, push RA, RTS.
000DB9r 2  68                 PLA
000DBAr 2  85 rr              STA   handler_lo            ; save return address low
000DBCr 2  68                 PLA
000DBDr 2  85 rr              STA   handler_hi            ; save return address high
000DBFr 2               
000DBFr 2  68                 PLA
000DC0r 2  85 rr              STA   eval_in_body
