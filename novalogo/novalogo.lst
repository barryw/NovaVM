00301Dr 2               
00301Dr 2                     ; Read body_len
00301Dr 2  A5 rr              LDA   proc_entry_lo
00301Fr 2  85 rr              STA   ptr_lo
003021r 2  A5 rr              LDA   proc_entry_hi
003023r 2  85 rr              STA   ptr_hi
003025r 2  A4 rr              LDY   proc_rec_off
003027r 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_lo
003029r 2  85 rr              STA   proc_body_len_lo
00302Br 2  C8                 INY
00302Cr 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_hi
00302Er 2  85 rr              STA   proc_body_len_hi
003030r 2  C8                 INY                           ; Y = offset to body text
003031r 2               
003031r 2                     ; Compute absolute pointer to body
003031r 2  84 rr              STY   proc_rec_off
003033r 2  18                 CLC
003034r 2  A5 rr              LDA   proc_entry_lo
003036r 2  65 rr              ADC   proc_rec_off
003038r 2  85 rr              STA   proc_ptr_lo
00303Ar 2  A5 rr              LDA   proc_entry_hi
00303Cr 2  69 00              ADC   #0
00303Er 2  85 rr              STA   proc_ptr_hi
003040r 2               
003040r 2                     ; Print body text, converting $0A to CR+LF
003040r 2               @po_body:
003040r 2  A5 rr              LDA   proc_body_len_lo
003042r 2  05 rr              ORA   proc_body_len_hi
003044r 2  F0 20              BEQ   @po_end
003046r 2               
003046r 2  A0 00              LDY   #0
003048r 2  B1 rr              LDA   (proc_ptr_lo),Y
00304Ar 2  C9 0A              CMP   #$0A
00304Cr 2  D0 05              BNE   @po_char
00304Er 2  20 rr rr           JSR   eval_newline
003051r 2  80 03              BRA   @po_advance
003053r 2               @po_char:
003053r 2  8D 0E A0           STA   VGC_CHAROUT
003056r 2               @po_advance:
003056r 2  E6 rr              INC   proc_ptr_lo
003058r 2  D0 02              BNE   :+
00305Ar 2  E6 rr              INC   proc_ptr_hi
00305Cr 2  A5 rr        :     LDA   proc_body_len_lo
00305Er 2  D0 02              BNE   :+
003060r 2  C6 rr              DEC   proc_body_len_hi
003062r 2  C6 rr        :     DEC   proc_body_len_lo
003064r 2  80 DA              BRA   @po_body
003066r 2               
