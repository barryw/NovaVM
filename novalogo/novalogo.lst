002096r 2  4C rr rr           JMP   @err
002099r 2               :
002099r 2                     ; Save first value
002099r 2  A5 rr              LDA   eval_type
00209Br 2  48                 PHA
00209Cr 2  A5 rr              LDA   eval_val_hi
00209Er 2  48                 PHA
00209Fr 2  A5 rr              LDA   eval_val_lo
0020A1r 2  48                 PHA
0020A2r 2  A5 rr              LDA   eval_val_frac
0020A4r 2  48                 PHA
