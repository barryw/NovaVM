002D1Cr 2                     ; Pop value from stack back into eval_val
002D1Cr 2  68                 PLA
002D1Dr 2  85 rr              STA   eval_type
002D1Fr 2  68                 PLA
002D20r 2  85 rr              STA   eval_val_hi
002D22r 2  68                 PLA
