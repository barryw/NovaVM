002FFEr 2  85 rr              STA   ptr_hi
003000r 2  A4 rr              LDY   proc_rec_off
003002r 2  B1 rr              LDA   (ptr_lo),Y             ; param name length
003004r 2  DA                 PHX
003005r 2  AA                 TAX                           ; X = chars to print
003006r 2  C8                 INY
003007r 2               @po_pch:
003007r 2  E0 00              CPX   #0
003009r 2  F0 09              BEQ   @po_param_done
00300Br 2  B1 rr              LDA   (ptr_lo),Y
