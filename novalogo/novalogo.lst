000DF8r 2  A2 00              LDX   #0
000DFAr 2               @eb_lp:
000DFAr 2  BD rr rr           LDA   str_repeat_bracket,X
000DFDr 2  F0 06              BEQ   @eb_done
000DFFr 2  8D 0E A0           STA   VGC_CHAROUT
000E02r 2  E8                 INX
000E03r 2  D0 F5              BNE   @eb_lp
000E05r 2               @eb_done:
000E05r 2  20 rr rr           JSR   eval_newline
000E08r 2  4C rr rr           JMP   eval_continue
000E0Br 2               
000E0Br 2               @err_args:
000E0Br 2  A2 00              LDX   #0
000E0Dr 2               @ea_lp:
000E0Dr 2  BD rr rr           LDA   str_repeat_err,X
