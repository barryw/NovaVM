001C80r 2  B1 rr              LDA   (ptr_lo),Y
001C82r 2  85 rr              STA   eval_val_lo
001C84r 2  A0 04              LDY   #CONS_CAR_FRAC
001C86r 2  B1 rr              LDA   (ptr_lo),Y
