002D8Er 2  A0 00              LDY   #0
002D90r 2  B1 rr              LDA   (proc_ptr_lo),Y      ; read body char
002D92r 2  C9 0A              CMP   #$0A
002D94r 2  F0 5B              BEQ   @line_nl
002D96r 2  C9 3B              CMP   #';'                 ; comment -> skip rest of physical line
002D98r 2  F0 37              BEQ   @line_comment
