0001BFr 2  FA                 PLX
0001C0r 2  CA                 DEX
0001C1r 2  D0 E0              BNE   @copy
0001C3r 2                     ; advance tok_src
0001C3r 2  AD rr rr           LDA   num_tmp_lo
0001C6r 2  18                 CLC
0001C7r 2  65 rr              ADC   tok_src
0001C9r 2  85 rr              STA   tok_src
0001CBr 2  4C rr rr           JMP   tok_append_node
0001CEr 2               @oom:
0001CEr 2  68                 PLA
0001CFr 2               @empty:
0001CFr 2  60                 RTS
