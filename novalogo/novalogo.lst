0021B3r 2  A9 02              LDA   #VAL_LIST
0021B5r 2  9D 04 01           STA   $0104,X
0021B8r 2  A5 rr              LDA   ptr_hi
0021BAr 2  9D 03 01           STA   $0103,X
0021BDr 2  A5 rr              LDA   ptr_lo
