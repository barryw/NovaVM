000F09r 2               
000F09r 2                     ; Nonzero integer part = true
000F09r 2  A5 rr              LDA   eval_val_lo
000F0Br 2  05 rr              ORA   eval_val_hi
000F0Dr 2  D0 08              BNE   @true
000F0Fr 2               
