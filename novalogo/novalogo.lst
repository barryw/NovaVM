000DDEr 2               ; skip_list_body — advance eval_cur past a [...] block without executing
000DDEr 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000DDEr 2               ;   Exit:  eval_cur points at the token after the matching TOK_RBRACKET
000DDEr 2               ;          Carry clear = success, Carry set = missing bracket
000DDEr 2               ;   Clobbers: A, X, Y, ptr_lo/hi
000DDEr 2               ; ---------------------------------------------------------------------
000DDEr 2               skip_list_body:
000DDEr 2                     ; Verify current token is TOK_LBRACKET
000DDEr 2  A5 rr              LDA   eval_cur_lo
000DE0r 2  05 rr              ORA   eval_cur_hi
