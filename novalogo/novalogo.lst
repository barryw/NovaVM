001C91r 2  4C rr rr           JMP   err_nei
001C94r 2               @err_type:
001C94r 2  A2 rr              LDX   #<str_last_name
001C96r 2  A0 rr              LDY   #>str_last_name
001C98r 2  4C rr rr           JMP   err_doesnt_like
001C9Br 2               @err_empty:
001C9Br 2  A2 rr              LDX   #<str_last_name
