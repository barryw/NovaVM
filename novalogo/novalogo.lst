001D1Dr 2  A9 10              LDA   #CONS_PAIR
001D1Fr 2  91 rr              STA   (ptr_lo),Y
001D21r 2  A0 01              LDY   #CONS_CAR_TYPE
001D23r 2  B1 rr              LDA   (ptr2_lo),Y
001D25r 2  91 rr              STA   (ptr_lo),Y
