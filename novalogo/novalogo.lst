00236Dr 2               ; ---------------------------------------------------------------------
00236Dr 2               ; render_list_to_buf — render list elements into input_buf as text
00236Dr 2               ;   Entry: eval_val_lo/hi = list head pointer
00236Dr 2               ;          buf_idx = current write position in input_buf
00236Dr 2               ;   Exit:  buf_idx updated
00236Dr 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr, list_count
00236Dr 2               ; ---------------------------------------------------------------------
00236Dr 2               render_list_to_buf:
00236Dr 2  A5 rr              LDA   eval_val_lo
00236Fr 2  85 rr              STA   list_ptr_lo
002371r 2  A5 rr              LDA   eval_val_hi
002373r 2  85 rr              STA   list_ptr_hi
002375r 2  A2 00              LDX   #0                     ; 0 = first element (no leading space)
002377r 2               
002377r 2               @rl_loop:
002377r 2  A5 rr              LDA   list_ptr_lo
002379r 2  05 rr              ORA   list_ptr_hi
00237Br 2  D0 01              BNE   :+
00237Dr 2  60                 RTS                           ; end of list
00237Er 2               :
00237Er 2                     ; Add space before non-first elements
00237Er 2  E0 00              CPX   #0
002380r 2  F0 0F              BEQ   @rl_no_space
002382r 2  A5 rr              LDA   z:buf_idx
002384r 2  C9 7E              CMP   #126
002386r 2  90 01              BCC   :+
002388r 2  60                 RTS                           ; buffer full — truncate
002389r 2               :
002389r 2  A8                 TAY
00238Ar 2  A9 20              LDA   #' '
00238Cr 2  99 rr rr           STA   input_buf,Y
00238Fr 2  E6 rr              INC   z:buf_idx
002391r 2               @rl_no_space:
002391r 2  A2 01              LDX   #1                     ; subsequent elements get space
002393r 2               
002393r 2                     ; Read car type
002393r 2  A5 rr              LDA   list_ptr_lo
002395r 2  85 rr              STA   ptr_lo
002397r 2  A5 rr              LDA   list_ptr_hi
002399r 2  85 rr              STA   ptr_hi
00239Br 2  A0 01              LDY   #CONS_CAR_TYPE
00239Dr 2  B1 rr              LDA   (ptr_lo),Y
00239Fr 2               
00239Fr 2  C9 02              CMP   #VAL_LIST
0023A1r 2  F0 62              BEQ   @rl_sublist
0023A3r 2  C9 01              CMP   #VAL_WORD
0023A5r 2  F0 25              BEQ   @rl_word
0023A7r 2               
0023A7r 2                     ; Number: render to input_buf
0023A7r 2  DA                 PHX
0023A8r 2  A5 rr              LDA   list_ptr_lo
0023AAr 2  48                 PHA
0023ABr 2  A5 rr              LDA   list_ptr_hi
0023ADr 2  48                 PHA
0023AEr 2                     ; Load the number value
0023AEr 2  A0 02              LDY   #CONS_CAR_HI
0023B0r 2  B1 rr              LDA   (ptr_lo),Y
0023B2r 2  85 rr              STA   eval_val_hi
0023B4r 2  A0 03              LDY   #CONS_CAR_LO
0023B6r 2  B1 rr              LDA   (ptr_lo),Y
0023B8r 2  85 rr              STA   eval_val_lo
