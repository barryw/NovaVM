00017Dr 2  18                 CLC
00017Er 2  69 04              ADC   #4                   ; node = 3 header + 1 length + chars
000180r 2  A2 01              LDX   #ATYPE_TOKEN
000182r 2  20 rr rr           JSR   heap_alloc
000185r 2  B0 47              BCS   @oom
000187r 2                     ; tag
000187r 2  A0 00              LDY   #TOK_TAG
000189r 2  A9 01              LDA   #TOK_WORD
00018Br 2  91 rr              STA   (ptr_lo),Y
00018Dr 2                     ; next = null
00018Dr 2  A0 01              LDY   #TOK_NEXT_LO
00018Fr 2  A9 00              LDA   #0
