002D09r 2  C9 0A              CMP   #$0A
002D0Br 2  D0 E2              BNE   @line_comment         ; keep skipping comment chars
002D0Dr 2  80 0E              BRA   @line_eol             ; consumed the newline -> end of physical line
002D0Fr 2               
002D0Fr 2               @line_nl:
002D0Fr 2                     ; Skip the $0A
002D0Fr 2  E6 rr              INC   proc_ptr_lo
002D11r 2  D0 02              BNE   :+
002D13r 2  E6 rr              INC   proc_ptr_hi
