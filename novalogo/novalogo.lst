00202Ar 2  A5 rr              LDA   ptr_lo
00202Cr 2  85 rr              STA   list_tail_lo
00202Er 2  A5 rr              LDA   ptr_hi
002030r 2  85 rr              STA   list_tail_hi
002032r 2               
002032r 2                     ; Allocate first cell
