000000r 1                     .include "ext_iface.inc"
000000r 2               ; ext_iface.inc — shared interface between NovaLogo base ROM and extension ROM
000000r 2               ;
000000r 2               ; These equates define the ZP mailbox used to pass arguments and results
000000r 2               ; between the base ROM and the extension ROM via the RAM trampoline.
000000r 2               ; Both ROMs include this file so addresses are always consistent.
000000r 2               ;
000000r 2               ; Addresses $80-$91 are outside the linker-managed ZEROPAGE segment
000000r 2               ; but inside true zero page RAM, accessible to both ROM banks.
000000r 2               
000000r 2               ; --- Command and argument count ---
000000r 2               EXT_CMD         = $80           ; command ID (set by base ROM before trampoline call)
000000r 2               EXT_ARGC        = $81           ; argument count
000000r 2               
000000r 2               ; --- Argument 0 ---
000000r 2               EXT_ARG0_TYPE   = $82           ; type: VAL_NUMBER=$00, VAL_WORD=$01, VAL_LIST=$02
000000r 2               EXT_ARG0_HI     = $83           ; value high byte
000000r 2               EXT_ARG0_LO     = $84           ; value low byte
000000r 2               EXT_ARG0_FRAC   = $85           ; fractional byte (16.8 fixed point)
000000r 2               
000000r 2               ; --- Argument 1 ---
000000r 2               EXT_ARG1_TYPE   = $86
000000r 2               EXT_ARG1_HI     = $87
000000r 2               EXT_ARG1_LO     = $88
000000r 2               EXT_ARG1_FRAC   = $89
000000r 2               
000000r 2               ; --- Argument 2 ---
000000r 2               EXT_ARG2_TYPE   = $8A
000000r 2               EXT_ARG2_HI     = $8B
000000r 2               EXT_ARG2_LO     = $8C
000000r 2               EXT_ARG2_FRAC   = $8D
000000r 2               
000000r 2               ; --- Result ---
000000r 2               EXT_RESULT_TYPE = $8E           ; return value type
000000r 2               EXT_RESULT_HI   = $8F           ; return value high byte
000000r 2               EXT_RESULT_LO   = $90           ; return value low byte
000000r 2               EXT_RESULT_FRAC = $91           ; return value fractional byte
000000r 2               
000000r 2               ; --- Command IDs ---
000000r 2               EXT_CMD_TEST    = $01           ; test command: returns arg0 + 1
000000r 2               EXT_CMD_FD      = $10           ; FD distance — move forward
000000r 2               EXT_CMD_BK      = $11           ; BK distance — move backward
000000r 2               EXT_CMD_RT      = $12           ; RT degrees — turn right
000000r 2               EXT_CMD_LT      = $13           ; LT degrees — turn left
000000r 2               EXT_CMD_CS      = $14           ; CS — clear screen, init turtle
000000r 2               EXT_CMD_PU      = $15           ; PU — pen up
000000r 2               EXT_CMD_PD      = $16           ; PD — pen down
000000r 2               EXT_CMD_ST      = $17           ; ST — show turtle
000000r 2               EXT_CMD_HT      = $18           ; HT — hide turtle
000000r 2               EXT_CMD_HOME    = $19           ; HOME — move to center, heading 0
000000r 2               EXT_CMD_TS      = $1A           ; TEXTSCREEN — full text mode
000000r 2               EXT_CMD_SS      = $1B           ; SPLITSCREEN — copper split
000000r 2               EXT_CMD_FS      = $1C           ; FULLSCREEN — full graphics mode
000000r 2               EXT_CMD_SETXY   = $1D           ; SETXY x y — move to position
000000r 2               EXT_CMD_SETX    = $1E           ; SETX x — set X only
000000r 2               EXT_CMD_SETY    = $1F           ; SETY y — set Y only
000000r 2               EXT_CMD_SETH    = $20           ; SETHEADING — set heading degrees
000000r 2               EXT_CMD_XCOR    = $21           ; XCOR — report turtle X
000000r 2               EXT_CMD_YCOR    = $22           ; YCOR — report turtle Y
000000r 2               EXT_CMD_HEADING = $23           ; HEADING — report heading degrees
000000r 2               EXT_CMD_PENDOWNP = $24          ; PENDOWN? — report pen state
000000r 2               EXT_CMD_SHOWNP  = $25           ; SHOWN? — report visibility
000000r 2               EXT_CMD_SETPC   = $26           ; SETPC color — set pen color
000000r 2               EXT_CMD_SETBG   = $27           ; SETBG color — set background color
000000r 2               EXT_CMD_TOWARDS = $28           ; TOWARDS x y — heading towards point
000000r 2               EXT_CMD_SETPOS  = $29           ; SETPOS [x y] — move to position from list
000000r 2               
000000r 2               ; --- VGC graphics commands ---
000000r 2               EXT_CMD_SETCOLOR = $30          ; SETCOLOR color — set VGC draw color
000000r 2               EXT_CMD_PLOT     = $31          ; PLOT x y — plot pixel
000000r 2               EXT_CMD_UNPLOT   = $32          ; UNPLOT x y — clear pixel
000000r 2               EXT_CMD_LINE     = $33          ; LINE x1 y1 x2 y2 — draw line
000000r 2               EXT_CMD_CIRCLE   = $34          ; CIRCLE x y r — draw circle
000000r 2               EXT_CMD_RECT     = $35          ; RECT x1 y1 x2 y2 — draw rectangle
000000r 2               EXT_CMD_FILLRECT = $36          ; FILL x1 y1 x2 y2 — filled rectangle
000000r 2               EXT_CMD_PAINT    = $37          ; PAINT x y — flood fill
000000r 2               
000000r 2               ; --- Sprite commands ---
000000r 2               EXT_CMD_SPRITE   = $40          ; SPRITE n x y — position and enable
000000r 2               EXT_CMD_SPRITEPOS = $41         ; SPRITEPOS n x y — reposition
000000r 2               EXT_CMD_SPRITEON = $42          ; SPRITEON n — enable sprite
000000r 2               EXT_CMD_SPRITEOFF = $43         ; SPRITEOFF n — disable sprite
000000r 2               EXT_CMD_SPRCOLLP = $44          ; SPRITECOLLISION? n — collision query
000000r 2               
000000r 2               ; --- Sound commands ---
000000r 2               EXT_CMD_TONE     = $45          ; TONE freq dur — play tone
000000r 2               EXT_CMD_NOISE    = $46          ; NOISE dur — noise burst
000000r 2               EXT_CMD_VOLUME   = $47          ; VOLUME vol — set SID master volume
000000r 2               
000000r 2               ; --- Timing commands ---
000000r 2               EXT_CMD_WAIT     = $48          ; WAIT n — wait N frames
000000r 2               EXT_CMD_WAITVBL  = $49          ; WAITVBL — wait for next VBL
000000r 2               EXT_CMD_TIMER    = $4A          ; TIMER — return frame counter
000000r 2               
000000r 2               ; --- Editor command ---
000000r 2               ; EXT_CMD_EDIT — open the shared EDITUI/EDITBUF editor on a RAM text buffer.
000000r 2               ;   In:  ARG0 = buffer ptr (lo/hi)   ARG1 = current length (lo/hi)
000000r 2               ;        ARG2 = capacity (lo/hi)     ARG3 = NUL-terminated title ptr (lo/hi)
000000r 2               ;        ARG2_FRAC:ARG3_FRAC = initial cursor byte offset (lo:hi) — the unused
000000r 2               ;        fractional bytes of the cap/title pointer args carry the cursor.
000000r 2               ;   Out: RESULT_LO = editbuf exit reason (EDITBUF_EXIT_*)
000000r 2               ;        RESULT_HI = nonzero if the user requested a save (Ctrl-S / "Save First")
000000r 2               ;        ARG1 (lo/hi) = final buffer length
000000r 2               EXT_CMD_EDIT     = $4B          ; EDIT — run the shared text editor
000000r 2               
000000r 2               ; --- Value types (match eval_type in eval.s) ---
000000r 2               .ifndef VAL_NUMBER
000000r 2               VAL_NUMBER      = $00
000000r 2               .endif
000000r 2               .ifndef VAL_WORD
000000r 2               VAL_WORD        = $01
000000r 2               .endif
000000r 2               .ifndef VAL_LIST
000000r 2               VAL_LIST        = $02
000000r 2               .endif
000000r 2               
000000r 2               ; --- Legacy turtle state ZP addresses ---
000000r 2               ; Extension ROMs that define NOVALOGO_TURTLE_STATE_EXTERNAL provide their own
000000r 2               ; persistent turtle storage and only use this file for the mailbox ABI.
000000r 2               .ifndef NOVALOGO_TURTLE_STATE_EXTERNAL
000000r 2               TURTLE_X_FRAC   = $92
000000r 2               TURTLE_X_LO     = $93
000000r 2               TURTLE_X_HI     = $94
000000r 2               TURTLE_Y_FRAC   = $95
000000r 2               TURTLE_Y_LO     = $96
000000r 2               TURTLE_Y_HI     = $97
000000r 2               TURTLE_HEADING_LO = $98
000000r 2               TURTLE_HEADING_HI = $99
000000r 2               TURTLE_PEN      = $9A
000000r 2               TURTLE_SHOWN    = $9B
000000r 2               TURTLE_COLOR    = $9C
000000r 2               TURTLE_SPRITE   = $9D
000000r 2               TURTLE_INITED   = $9E
000000r 2               .endif
000000r 2               
000000r 2               ; --- Argument 3 (for 4+ arg commands like LINE, RECT, FILL) ---
000000r 2               EXT_ARG3_TYPE   = $9F
000000r 2               EXT_ARG3_HI     = $A0
000000r 2               EXT_ARG3_LO     = $A1
000000r 2               EXT_ARG3_FRAC   = $A2
000000r 2               
000000r 2               ; --- Trampoline location in RAM ---
000000r 2               EXT_TRAMPOLINE  = $0270         ; RAM address where trampoline code is copied
000000r 2               EXT_TRAMP_SIZE  = 14            ; size of trampoline code in bytes
000000r 2               
000000r 1                     .include "heap.s"
000000r 2               ; heap.s — bump allocator with GC headers for NovaLogo
000000r 2               ; Heap range: $0400 to HEAP_END-1.
000000r 2               
000000r 2               HEAP_START = $0400
000000r 2               HEAP_END   = $9800          ; one past last usable byte. $9800-$9BFF = editor BSS
000000r 2                                           ; (extension), $9C00-$9F10 = pinned turtle work+state.
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; ZEROPAGE segment — heap and general-purpose pointer variables
000000r 2               ; =====================================================================
000000r 2                     .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        heap_ptr:     .res 2          ; current heap allocation pointer
000002r 2  xx           ptr_lo:       .res 1          ; general-purpose pointer (low byte)
000003r 2  xx           ptr_hi:       .res 1          ; general-purpose pointer (high byte)
000004r 2               
000004r 2               ; =====================================================================
000004r 2               ; BSS segment — heap scratch
000004r 2               ; =====================================================================
000004r 2                     .segment "BSS"
000000r 2               
000000r 2  xx           ha_type:      .res 1          ; saved alloc type for heap_alloc
000001r 2  xx           ha_paysz:     .res 1          ; saved payload size for heap_alloc
000002r 2  xx           ha_gc_ran:    .res 1          ; flag: GC already attempted
000003r 2               
000003r 2               ; =====================================================================
000003r 2               ; CODE segment — heap routines
000003r 2               ; =====================================================================
000003r 2                     .segment "CODE"
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; heap_init — reset heap to empty
000000r 2               ;   Clobbers: A
000000r 2               ; ---------------------------------------------------------------------
000000r 2               heap_init:
000000r 2  A9 00              LDA   #<HEAP_START
000002r 2  85 rr              STA   heap_ptr
000004r 2  A9 04              LDA   #>HEAP_START
000006r 2  85 rr              STA   heap_ptr+1
000008r 2  60                 RTS
000009r 2               
000009r 2               ; ---------------------------------------------------------------------
000009r 2               ; heap_alloc — allocate A bytes with a 2-byte GC header
000009r 2               ;   Input:  A = payload size (bytes the caller wants)
000009r 2               ;           X = allocation type (ATYPE_*)
000009r 2               ;   Output: ptr_lo/ptr_hi = pointer to payload (header is at -2)
000009r 2               ;           Carry clear = success, Carry set = out of memory
000009r 2               ;   Clobbers: A, X, Y
000009r 2               ;
000009r 2               ;   Header layout at (returned_ptr - 2):
000009r 2               ;     +0: alloc_tag  = type (bits 6-0), mark cleared (bit 7 = 0)
000009r 2               ;     +1: alloc_size = payload + 2
000009r 2               ; ---------------------------------------------------------------------
000009r 2               heap_alloc:
000009r 2  8D rr rr           STA   ha_paysz
00000Cr 2  8E rr rr           STX   ha_type
00000Fr 2  9C rr rr           STZ   ha_gc_ran
000012r 2               
000012r 2               @retry:
000012r 2                     ; total = payload + 2
000012r 2  AD rr rr           LDA   ha_paysz
000015r 2  18                 CLC
000016r 2  69 02              ADC   #GC_HDR_BYTES
000018r 2               
000018r 2                     ; Save current heap_ptr → ptr_lo/hi (allocation base)
000018r 2  A6 rr              LDX   heap_ptr
00001Ar 2  86 rr              STX   ptr_lo
00001Cr 2  A6 rr              LDX   heap_ptr+1
00001Er 2  86 rr              STX   ptr_hi
000020r 2               
000020r 2                     ; Advance heap_ptr by total
000020r 2  18                 CLC
000021r 2  65 rr              ADC   heap_ptr
000023r 2  85 rr              STA   heap_ptr
000025r 2  A9 00              LDA   #0
000027r 2  65 rr              ADC   heap_ptr+1
000029r 2  85 rr              STA   heap_ptr+1
00002Br 2               
00002Br 2                     ; Check against HEAP_END
00002Br 2  C9 98              CMP   #>HEAP_END
00002Dr 2  90 21              BCC   @ok
00002Fr 2  D0 08              BNE   @oom
000031r 2  A5 rr              LDA   heap_ptr
000033r 2  C9 00              CMP   #<HEAP_END
000035r 2  90 19              BCC   @ok
000037r 2  F0 17              BEQ   @ok
000039r 2               
000039r 2               @oom:
000039r 2                     ; Restore heap_ptr
000039r 2  A5 rr              LDA   ptr_lo
00003Br 2  85 rr              STA   heap_ptr
00003Dr 2  A5 rr              LDA   ptr_hi
00003Fr 2  85 rr              STA   heap_ptr+1
000041r 2               
000041r 2                     ; Already tried GC?
000041r 2  AD rr rr           LDA   ha_gc_ran
000044r 2  D0 08              BNE   @fail
000046r 2  EE rr rr           INC   ha_gc_ran
000049r 2               
000049r 2                     ; Run GC and retry
000049r 2  20 rr rr           JSR   gc_collect
00004Cr 2  80 C4              BRA   @retry
00004Er 2               
00004Er 2               @fail:
00004Er 2  38                 SEC
00004Fr 2  60                 RTS
000050r 2               
000050r 2               @ok:
000050r 2                     ; Write header at allocation base (ptr_lo/hi)
000050r 2  A0 00              LDY   #GC_HDR_TAG
000052r 2  AD rr rr           LDA   ha_type
000055r 2  91 rr              STA   (ptr_lo),Y
000057r 2               
000057r 2  A0 01              LDY   #GC_HDR_SIZE
000059r 2  AD rr rr           LDA   ha_paysz
00005Cr 2  18                 CLC
00005Dr 2  69 02              ADC   #GC_HDR_BYTES
00005Fr 2  91 rr              STA   (ptr_lo),Y
000061r 2               
000061r 2                     ; Advance ptr_lo/hi past header → payload pointer
000061r 2  18                 CLC
000062r 2  A5 rr              LDA   ptr_lo
000064r 2  69 02              ADC   #GC_HDR_BYTES
000066r 2  85 rr              STA   ptr_lo
000068r 2  A5 rr              LDA   ptr_hi
00006Ar 2  69 00              ADC   #0
00006Cr 2  85 rr              STA   ptr_hi
00006Er 2               
00006Er 2  18                 CLC
00006Fr 2  60                 RTS
000070r 2               
000070r 1                     .include "tokens.s"
000070r 2               ; tokens.s — token node format and constants for NovaLogo
000070r 2               
000070r 2               ; Token type constants
000070r 2               TOK_WORD     = $01            ; payload: length byte + chars
000070r 2               TOK_NUMBER   = $02            ; payload: 3 bytes (hi, lo, frac) — 16.8 fixed-point
000070r 2               TOK_LBRACKET = $03            ; no payload
000070r 2               TOK_RBRACKET = $04            ; no payload
000070r 2               TOK_VARREF   = $05            ; payload: length byte + chars (name after :)
000070r 2               TOK_QUOTE    = $06            ; payload: length byte + chars (word after ")
000070r 2               TOK_INFIX    = $07            ; payload: 1 byte (operator char)
000070r 2               TOK_LPAREN   = $08            ; no payload
000070r 2               TOK_RPAREN   = $09            ; no payload
000070r 2               
000070r 2               ; Token node layout:
000070r 2               ;   Offset 0: tag byte (TOK_* constant)
000070r 2               ;   Offset 1: next pointer low byte
000070r 2               ;   Offset 2: next pointer high byte ($00/$00 = end of list)
000070r 2               ;   Offset 3+: payload (varies by type)
000070r 2               ;
000070r 2               ; Total size: 3 + payload_size
000070r 2               ;   TOK_WORD/VARREF/QUOTE: 3 + 1 + len (length byte + chars)
000070r 2               ;   TOK_NUMBER: 3 + 3 = 6 bytes
000070r 2               ;   TOK_LBRACKET/RBRACKET/LPAREN/RPAREN: 3 bytes (no payload)
000070r 2               ;   TOK_INFIX: 3 + 1 = 4 bytes
000070r 2               
000070r 2               TOK_TAG      = 0              ; offset to tag byte
000070r 2               TOK_NEXT_LO  = 1              ; offset to next pointer low
000070r 2               TOK_NEXT_HI  = 2              ; offset to next pointer high
000070r 2               TOK_PAYLOAD  = 3              ; offset to start of payload
000070r 2               
000070r 1                     .include "tokenizer.s"
000070r 2               ; tokenizer.s — scan input_buf into a linked list of token nodes
000070r 2               
000070r 2               ; =====================================================================
000070r 2               ; ZEROPAGE segment — tokenizer variables
000070r 2               ; =====================================================================
000070r 2                     .segment "ZEROPAGE"
000004r 2               
000004r 2  xx           tok_head_lo:  .res 1          ; head of token list (first token)
000005r 2  xx           tok_head_hi:  .res 1
000006r 2  xx           tok_tail_lo:  .res 1          ; tail of token list (for appending)
000007r 2  xx           tok_tail_hi:  .res 1
000008r 2  xx           tok_src:      .res 1          ; current scan position in input_buf
000009r 2  xx           ptr2_lo:      .res 1          ; second general-purpose pointer (low byte)
00000Ar 2  xx           ptr2_hi:      .res 1          ; second general-purpose pointer (high byte)
00000Br 2  xx           tok_sign:     .res 1          ; sign flag for number parsing (0=pos, 1=neg)
00000Cr 2               
00000Cr 2               ; =====================================================================
00000Cr 2               ; BSS segment — scratch for number parsing
00000Cr 2               ; =====================================================================
00000Cr 2                     .segment "BSS"
000003r 2               
000003r 2  xx           num_val_lo:   .res 1          ; integer accumulator low
000004r 2  xx           num_val_hi:   .res 1          ; integer accumulator high
000005r 2  xx           num_tmp_lo:   .res 1          ; temp for multiply / frac result
000006r 2  xx           num_tmp_hi:   .res 1          ; temp for multiply / frac raw
000007r 2               
000007r 2               ; =====================================================================
000007r 2               ; CODE segment — tokenizer routines
000007r 2               ; =====================================================================
000007r 2                     .segment "CODE"
000070r 2               
000070r 2               ; ---------------------------------------------------------------------
000070r 2               ; tokenize_line — scan input_buf and build a linked list of tokens
000070r 2               ;   Input:  input_buf contains null-terminated text
000070r 2               ;   Output: tok_head_lo/hi = first token ($0000 if empty line)
000070r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi
000070r 2               ; ---------------------------------------------------------------------
000070r 2               tokenize_line:
000070r 2  64 rr              STZ   tok_head_lo
000072r 2  64 rr              STZ   tok_head_hi
000074r 2  64 rr              STZ   tok_tail_lo
000076r 2  64 rr              STZ   tok_tail_hi
000078r 2  64 rr              STZ   tok_src
00007Ar 2                     ; fall through to scan loop
00007Ar 2               
00007Ar 2               ; Non-local entry for scan loop — reachable from all routines
00007Ar 2               tok_scan_next:
00007Ar 2                     ; --- skip whitespace ---
00007Ar 2  A6 rr              LDX   tok_src
00007Cr 2               @skip_ws:
00007Cr 2  BD rr rr           LDA   input_buf,X
00007Fr 2  C9 20              CMP   #$20                 ; space
000081r 2  F0 04              BEQ   @ws_next
000083r 2  C9 09              CMP   #$09                 ; tab
000085r 2  D0 03              BNE   @ws_done
000087r 2               @ws_next:
000087r 2  E8                 INX
000088r 2  80 F2              BRA   @skip_ws
00008Ar 2               @ws_done:
00008Ar 2  86 rr              STX   tok_src
00008Cr 2               
00008Cr 2                     ; --- check for end of input ---
00008Cr 2  C9 00              CMP   #0
00008Er 2  D0 01              BNE   @not_end
000090r 2  60                 RTS                        ; done — list complete
000091r 2               @not_end:
000091r 2               
000091r 2                     ; --- colon → TOK_VARREF ---
000091r 2  C9 3A              CMP   #':'
000093r 2  D0 05              BNE   @not_colon
000095r 2  E6 rr              INC   tok_src              ; skip ':'
000097r 2  4C rr rr           JMP   tok_scan_varref
00009Ar 2               @not_colon:
00009Ar 2               
00009Ar 2                     ; --- quote → TOK_QUOTE ---
00009Ar 2  C9 22              CMP   #'"'
00009Cr 2  D0 05              BNE   @not_quote
00009Er 2  E6 rr              INC   tok_src              ; skip '"'
0000A0r 2  4C rr rr           JMP   tok_scan_quote
0000A3r 2               @not_quote:
0000A3r 2               
0000A3r 2                     ; --- brackets ---
0000A3r 2  C9 5B              CMP   #'['
0000A5r 2  D0 05              BNE   @not_lb
0000A7r 2  A9 03              LDA   #TOK_LBRACKET
0000A9r 2  4C rr rr           JMP   tok_emit_simple
0000ACr 2               @not_lb:
0000ACr 2  C9 5D              CMP   #']'
0000AEr 2  D0 05              BNE   @not_rb
0000B0r 2  A9 04              LDA   #TOK_RBRACKET
0000B2r 2  4C rr rr           JMP   tok_emit_simple
0000B5r 2               @not_rb:
0000B5r 2               
0000B5r 2                     ; --- parens ---
0000B5r 2  C9 28              CMP   #'('
0000B7r 2  D0 05              BNE   @not_lp
0000B9r 2  A9 08              LDA   #TOK_LPAREN
0000BBr 2  4C rr rr           JMP   tok_emit_simple
0000BEr 2               @not_lp:
0000BEr 2  C9 29              CMP   #')'
0000C0r 2  D0 05              BNE   @not_rp
0000C2r 2  A9 09              LDA   #TOK_RPAREN
0000C4r 2  4C rr rr           JMP   tok_emit_simple
0000C7r 2               @not_rp:
0000C7r 2               
0000C7r 2                     ; --- infix operators (not minus) ---
0000C7r 2  C9 2B              CMP   #'+'
0000C9r 2  F0 16              BEQ   @is_infix
0000CBr 2  C9 2A              CMP   #'*'
0000CDr 2  F0 12              BEQ   @is_infix
0000CFr 2  C9 2F              CMP   #'/'
0000D1r 2  F0 0E              BEQ   @is_infix
0000D3r 2  C9 3C              CMP   #'<'
0000D5r 2  F0 0A              BEQ   @is_infix
0000D7r 2  C9 3E              CMP   #'>'
0000D9r 2  F0 06              BEQ   @is_infix
0000DBr 2  C9 3D              CMP   #'='
0000DDr 2  F0 02              BEQ   @is_infix
0000DFr 2  80 03              BRA   @not_infix
0000E1r 2               @is_infix:
0000E1r 2  4C rr rr           JMP   tok_emit_infix
0000E4r 2               @not_infix:
0000E4r 2               
0000E4r 2                     ; --- minus: could be infix or negative number ---
0000E4r 2  C9 2D              CMP   #'-'
0000E6r 2  D0 15              BNE   @not_minus
0000E8r 2                     ; peek at next character
0000E8r 2  A6 rr              LDX   tok_src
0000EAr 2  BD rr rr           LDA   input_buf+1,X
0000EDr 2  C9 30              CMP   #'0'
0000EFr 2  90 04              BCC   @minus_infix
0000F1r 2  C9 3A              CMP   #'9'+1
0000F3r 2  90 05              BCC   @minus_number
0000F5r 2               @minus_infix:
0000F5r 2  A9 2D              LDA   #'-'
0000F7r 2  4C rr rr           JMP   tok_emit_infix
0000FAr 2               @minus_number:
0000FAr 2  4C rr rr           JMP   tok_parse_number
0000FDr 2               @not_minus:
0000FDr 2               
0000FDr 2                     ; --- digit → TOK_NUMBER ---
0000FDr 2  C9 30              CMP   #'0'
0000FFr 2  90 04              BCC   @not_digit
000101r 2  C9 3A              CMP   #'9'+1
000103r 2  90 03              BCC   @is_digit
000105r 2               @not_digit:
000105r 2               
000105r 2                     ; --- default: TOK_WORD ---
000105r 2  4C rr rr           JMP   tok_scan_word
000108r 2               
000108r 2               @is_digit:
000108r 2  4C rr rr           JMP   tok_parse_number
00010Br 2               
00010Br 2               ; ---------------------------------------------------------------------
00010Br 2               ; tok_emit_simple — emit a 3-byte node (tag only, no payload)
00010Br 2               ;   Input: A = tag byte, tok_src points at the character
00010Br 2               ; ---------------------------------------------------------------------
00010Br 2               tok_emit_simple:
00010Br 2  48                 PHA                        ; save tag
00010Cr 2  A9 03              LDA   #3
00010Er 2  A2 01              LDX   #ATYPE_TOKEN
000110r 2  20 rr rr           JSR   heap_alloc
000113r 2  B0 13              BCS   @oom
000115r 2  68                 PLA
000116r 2  A0 00              LDY   #TOK_TAG
000118r 2  91 rr              STA   (ptr_lo),Y
00011Ar 2  A0 01              LDY   #TOK_NEXT_LO
00011Cr 2  A9 00              LDA   #0
00011Er 2  91 rr              STA   (ptr_lo),Y
000120r 2  C8                 INY
000121r 2  91 rr              STA   (ptr_lo),Y
000123r 2  E6 rr              INC   tok_src              ; advance past the character
000125r 2  4C rr rr           JMP   tok_append_node
000128r 2               @oom:
000128r 2  68                 PLA
000129r 2  60                 RTS
00012Ar 2               
00012Ar 2               ; ---------------------------------------------------------------------
00012Ar 2               ; tok_emit_infix — emit a 4-byte node (tag + operator char)
00012Ar 2               ;   Input: A = operator character, tok_src points at the operator
00012Ar 2               ; ---------------------------------------------------------------------
00012Ar 2               tok_emit_infix:
00012Ar 2  48                 PHA                        ; save operator char
00012Br 2  A9 04              LDA   #4
00012Dr 2  A2 01              LDX   #ATYPE_TOKEN
00012Fr 2  20 rr rr           JSR   heap_alloc
000132r 2  B0 19              BCS   @oom
000134r 2  A0 00              LDY   #TOK_TAG
000136r 2  A9 07              LDA   #TOK_INFIX
000138r 2  91 rr              STA   (ptr_lo),Y
00013Ar 2  A0 01              LDY   #TOK_NEXT_LO
00013Cr 2  A9 00              LDA   #0
00013Er 2  91 rr              STA   (ptr_lo),Y
000140r 2  C8                 INY
000141r 2  91 rr              STA   (ptr_lo),Y
000143r 2  A0 03              LDY   #TOK_PAYLOAD
000145r 2  68                 PLA
000146r 2  91 rr              STA   (ptr_lo),Y
000148r 2  E6 rr              INC   tok_src
00014Ar 2  4C rr rr           JMP   tok_append_node
00014Dr 2               @oom:
00014Dr 2  68                 PLA
00014Er 2  60                 RTS
00014Fr 2               
00014Fr 2               ; ---------------------------------------------------------------------
00014Fr 2               ; tok_scan_word — scan a word into TOK_WORD (uppercased)
00014Fr 2               ;   tok_src points at first character
00014Fr 2               ; ---------------------------------------------------------------------
00014Fr 2               tok_scan_word:
00014Fr 2  A6 rr              LDX   tok_src
000151r 2  A0 00              LDY   #0                   ; length counter
000153r 2               @count:
000153r 2  BD rr rr           LDA   input_buf,X
000156r 2  20 rr rr           JSR   is_word_char
000159r 2  90 04              BCC   @counted
00015Br 2  E8                 INX
00015Cr 2  C8                 INY
00015Dr 2  80 F4              BRA   @count
00015Fr 2               @counted:
00015Fr 2  98                 TYA
000160r 2  F0 53              BEQ   @empty
000162r 2  48                 PHA                        ; save length
000163r 2  18                 CLC
000164r 2  69 04              ADC   #4                   ; node = 3 header + 1 length + chars
000166r 2  A2 01              LDX   #ATYPE_TOKEN
000168r 2  20 rr rr           JSR   heap_alloc
00016Br 2  B0 47              BCS   @oom
00016Dr 2                     ; tag
00016Dr 2  A0 00              LDY   #TOK_TAG
00016Fr 2  A9 01              LDA   #TOK_WORD
000171r 2  91 rr              STA   (ptr_lo),Y
000173r 2                     ; next = null
000173r 2  A0 01              LDY   #TOK_NEXT_LO
000175r 2  A9 00              LDA   #0
000177r 2  91 rr              STA   (ptr_lo),Y
000179r 2  C8                 INY
00017Ar 2  91 rr              STA   (ptr_lo),Y
00017Cr 2                     ; length byte
00017Cr 2  68                 PLA
00017Dr 2  48                 PHA
00017Er 2  A0 03              LDY   #TOK_PAYLOAD
000180r 2  91 rr              STA   (ptr_lo),Y
000182r 2                     ; copy chars with uppercasing
000182r 2  68                 PLA
000183r 2  AA                 TAX                        ; X = remaining
000184r 2  A0 04              LDY   #TOK_PAYLOAD+1       ; Y = dest offset
000186r 2  9C rr rr           STZ   num_tmp_lo           ; source offset from tok_src
000189r 2               @copy:
000189r 2  DA                 PHX
00018Ar 2  AD rr rr           LDA   num_tmp_lo
00018Dr 2  18                 CLC
00018Er 2  65 rr              ADC   tok_src
000190r 2  AA                 TAX
000191r 2  BD rr rr           LDA   input_buf,X
000194r 2  C9 61              CMP   #'a'
000196r 2  90 07              BCC   @noup
000198r 2  C9 7B              CMP   #'z'+1
00019Ar 2  B0 03              BCS   @noup
00019Cr 2  38                 SEC
00019Dr 2  E9 20              SBC   #$20
00019Fr 2               @noup:
00019Fr 2  91 rr              STA   (ptr_lo),Y
0001A1r 2  C8                 INY
0001A2r 2  EE rr rr           INC   num_tmp_lo
0001A5r 2  FA                 PLX
0001A6r 2  CA                 DEX
0001A7r 2  D0 E0              BNE   @copy
0001A9r 2                     ; advance tok_src
0001A9r 2  AD rr rr           LDA   num_tmp_lo
0001ACr 2  18                 CLC
0001ADr 2  65 rr              ADC   tok_src
0001AFr 2  85 rr              STA   tok_src
0001B1r 2  4C rr rr           JMP   tok_append_node
0001B4r 2               @oom:
0001B4r 2  68                 PLA
0001B5r 2               @empty:
0001B5r 2  60                 RTS
0001B6r 2               
0001B6r 2               ; ---------------------------------------------------------------------
0001B6r 2               ; tok_scan_varref — scan TOK_VARREF after ':'
0001B6r 2               ;   tok_src points at first char after ':'
0001B6r 2               ; ---------------------------------------------------------------------
0001B6r 2               tok_scan_varref:
0001B6r 2  A6 rr              LDX   tok_src
0001B8r 2  A0 00              LDY   #0
0001BAr 2               @count:
0001BAr 2  BD rr rr           LDA   input_buf,X
0001BDr 2  20 rr rr           JSR   is_word_char
0001C0r 2  90 04              BCC   @counted
0001C2r 2  E8                 INX
0001C3r 2  C8                 INY
0001C4r 2  80 F4              BRA   @count
0001C6r 2               @counted:
0001C6r 2  98                 TYA
0001C7r 2  F0 53              BEQ   @empty
0001C9r 2  48                 PHA
0001CAr 2  18                 CLC
0001CBr 2  69 04              ADC   #4
0001CDr 2  A2 01              LDX   #ATYPE_TOKEN
0001CFr 2  20 rr rr           JSR   heap_alloc
0001D2r 2  B0 47              BCS   @oom
0001D4r 2  A0 00              LDY   #TOK_TAG
0001D6r 2  A9 05              LDA   #TOK_VARREF
0001D8r 2  91 rr              STA   (ptr_lo),Y
0001DAr 2  A0 01              LDY   #TOK_NEXT_LO
0001DCr 2  A9 00              LDA   #0
0001DEr 2  91 rr              STA   (ptr_lo),Y
0001E0r 2  C8                 INY
0001E1r 2  91 rr              STA   (ptr_lo),Y
0001E3r 2  68                 PLA
0001E4r 2  48                 PHA
0001E5r 2  A0 03              LDY   #TOK_PAYLOAD
0001E7r 2  91 rr              STA   (ptr_lo),Y
0001E9r 2  68                 PLA
0001EAr 2  AA                 TAX
0001EBr 2  A0 04              LDY   #TOK_PAYLOAD+1
0001EDr 2  9C rr rr           STZ   num_tmp_lo
0001F0r 2               @copy:
0001F0r 2  DA                 PHX
0001F1r 2  AD rr rr           LDA   num_tmp_lo
0001F4r 2  18                 CLC
0001F5r 2  65 rr              ADC   tok_src
0001F7r 2  AA                 TAX
0001F8r 2  BD rr rr           LDA   input_buf,X
0001FBr 2  C9 61              CMP   #'a'
0001FDr 2  90 07              BCC   @noup
0001FFr 2  C9 7B              CMP   #'z'+1
000201r 2  B0 03              BCS   @noup
000203r 2  38                 SEC
000204r 2  E9 20              SBC   #$20
000206r 2               @noup:
000206r 2  91 rr              STA   (ptr_lo),Y
000208r 2  C8                 INY
000209r 2  EE rr rr           INC   num_tmp_lo
00020Cr 2  FA                 PLX
00020Dr 2  CA                 DEX
00020Er 2  D0 E0              BNE   @copy
000210r 2  AD rr rr           LDA   num_tmp_lo
000213r 2  18                 CLC
000214r 2  65 rr              ADC   tok_src
000216r 2  85 rr              STA   tok_src
000218r 2  4C rr rr           JMP   tok_append_node
00021Br 2               @oom:
00021Br 2  68                 PLA
00021Cr 2               @empty:
00021Cr 2  60                 RTS
00021Dr 2               
00021Dr 2               ; ---------------------------------------------------------------------
00021Dr 2               ; tok_scan_quote — scan TOK_QUOTE after '"'
00021Dr 2               ;   tok_src points at first char after '"'
00021Dr 2               ; ---------------------------------------------------------------------
00021Dr 2               tok_scan_quote:
00021Dr 2  A6 rr              LDX   tok_src
00021Fr 2  A0 00              LDY   #0
000221r 2               @count:
000221r 2  BD rr rr           LDA   input_buf,X
000224r 2  20 rr rr           JSR   is_word_char
000227r 2  90 04              BCC   @counted
000229r 2  E8                 INX
00022Ar 2  C8                 INY
00022Br 2  80 F4              BRA   @count
00022Dr 2               @counted:
00022Dr 2  98                 TYA
00022Er 2  F0 48              BEQ   @empty
000230r 2  48                 PHA
000231r 2  18                 CLC
000232r 2  69 04              ADC   #4
000234r 2  A2 01              LDX   #ATYPE_TOKEN
000236r 2  20 rr rr           JSR   heap_alloc
000239r 2  B0 3C              BCS   @oom
00023Br 2  A0 00              LDY   #TOK_TAG
00023Dr 2  A9 06              LDA   #TOK_QUOTE
00023Fr 2  91 rr              STA   (ptr_lo),Y
000241r 2  A0 01              LDY   #TOK_NEXT_LO
000243r 2  A9 00              LDA   #0
000245r 2  91 rr              STA   (ptr_lo),Y
000247r 2  C8                 INY
000248r 2  91 rr              STA   (ptr_lo),Y
00024Ar 2  68                 PLA
00024Br 2  48                 PHA
00024Cr 2  A0 03              LDY   #TOK_PAYLOAD
00024Er 2  91 rr              STA   (ptr_lo),Y
000250r 2                     ; Copy characters — no uppercasing for quotes
000250r 2  68                 PLA
000251r 2  AA                 TAX
000252r 2  A0 04              LDY   #TOK_PAYLOAD+1
000254r 2  9C rr rr           STZ   num_tmp_lo
000257r 2               @copy:
000257r 2  DA                 PHX
000258r 2  AD rr rr           LDA   num_tmp_lo
00025Br 2  18                 CLC
00025Cr 2  65 rr              ADC   tok_src
00025Er 2  AA                 TAX
00025Fr 2  BD rr rr           LDA   input_buf,X
000262r 2  91 rr              STA   (ptr_lo),Y
000264r 2  C8                 INY
000265r 2  EE rr rr           INC   num_tmp_lo
000268r 2  FA                 PLX
000269r 2  CA                 DEX
00026Ar 2  D0 EB              BNE   @copy
00026Cr 2  AD rr rr           LDA   num_tmp_lo
00026Fr 2  18                 CLC
000270r 2  65 rr              ADC   tok_src
000272r 2  85 rr              STA   tok_src
000274r 2  4C rr rr           JMP   tok_append_node
000277r 2               @oom:
000277r 2  68                 PLA
000278r 2               @empty:
000278r 2  60                 RTS
000279r 2               
000279r 2               ; ---------------------------------------------------------------------
000279r 2               ; tok_parse_number — parse decimal integer[.fraction] into TOK_NUMBER
000279r 2               ;   tok_src points at first digit or '-'
000279r 2               ;   Payload: 3 bytes = int_hi, int_lo, frac (16.8 fixed-point)
000279r 2               ; ---------------------------------------------------------------------
000279r 2               tok_parse_number:
000279r 2  9C rr rr           STZ   num_val_lo
00027Cr 2  9C rr rr           STZ   num_val_hi
00027Fr 2  64 rr              STZ   tok_sign              ; 0 = positive
000281r 2  A6 rr              LDX   tok_src
000283r 2  BD rr rr           LDA   input_buf,X
000286r 2  C9 2D              CMP   #'-'
000288r 2  D0 06              BNE   @parse_int
00028Ar 2  A9 01              LDA   #1
00028Cr 2  85 rr              STA   tok_sign
00028Er 2  E6 rr              INC   tok_src
000290r 2               
000290r 2                     ; Parse integer digits
000290r 2               @parse_int:
000290r 2  A6 rr              LDX   tok_src
000292r 2  BD rr rr           LDA   input_buf,X
000295r 2  C9 30              CMP   #'0'
000297r 2  90 54              BCC   @int_done
000299r 2  C9 3A              CMP   #'9'+1
00029Br 2  B0 50              BCS   @int_done
00029Dr 2  38                 SEC
00029Er 2  E9 30              SBC   #'0'                 ; A = digit 0..9
0002A0r 2  48                 PHA                        ; save digit
0002A1r 2               
0002A1r 2                     ; Multiply num_val by 10: (val << 3) + (val << 1)
0002A1r 2                     ; Compute val << 1
0002A1r 2  AD rr rr           LDA   num_val_lo
0002A4r 2  0A                 ASL
0002A5r 2  8D rr rr           STA   num_tmp_lo
0002A8r 2  AD rr rr           LDA   num_val_hi
0002ABr 2  2A                 ROL
0002ACr 2  8D rr rr           STA   num_tmp_hi           ; tmp = val * 2
0002AFr 2               
0002AFr 2                     ; Compute val << 3 = (val * 2) << 2
0002AFr 2  0E rr rr           ASL   num_tmp_lo
0002B2r 2  2E rr rr           ROL   num_tmp_hi
0002B5r 2  0E rr rr           ASL   num_tmp_lo
0002B8r 2  2E rr rr           ROL   num_tmp_hi           ; tmp = val * 8
0002BBr 2               
0002BBr 2                     ; val*10 = val*8 + val*2. Recompute val*2 into num_val first, with a
0002BBr 2                     ; proper 16-bit shift (ASL low, ROL high) so the carry out of the low
0002BBr 2                     ; byte reaches the high byte — then add val*8. (The previous version
0002BBr 2                     ; fused the shift and add and CLC'd away that carry, dropping 256 from
0002BBr 2                     ; any value whose low byte had bit 7 set, e.g. 4242 -> 3986.)
0002BBr 2  AD rr rr           LDA   num_val_lo
0002BEr 2  0A                 ASL
0002BFr 2  8D rr rr           STA   num_val_lo
0002C2r 2  AD rr rr           LDA   num_val_hi
0002C5r 2  2A                 ROL
0002C6r 2  8D rr rr           STA   num_val_hi           ; num_val = val * 2
0002C9r 2               
0002C9r 2  18                 CLC
0002CAr 2  AD rr rr           LDA   num_val_lo
0002CDr 2  6D rr rr           ADC   num_tmp_lo
0002D0r 2  8D rr rr           STA   num_val_lo
0002D3r 2  AD rr rr           LDA   num_val_hi
0002D6r 2  6D rr rr           ADC   num_tmp_hi
0002D9r 2  8D rr rr           STA   num_val_hi           ; num_val = val*2 + val*8 = val*10
0002DCr 2               
0002DCr 2                     ; Add digit
0002DCr 2  68                 PLA
0002DDr 2  18                 CLC
0002DEr 2  6D rr rr           ADC   num_val_lo
0002E1r 2  8D rr rr           STA   num_val_lo
0002E4r 2  90 03              BCC   @no_carry
0002E6r 2  EE rr rr           INC   num_val_hi
0002E9r 2               @no_carry:
0002E9r 2  E6 rr              INC   tok_src
0002EBr 2  80 A3              BRA   @parse_int
0002EDr 2               
0002EDr 2               @int_done:
0002EDr 2                     ; Parse fractional part
0002EDr 2  9C rr rr           STZ   num_tmp_lo           ; frac result
0002F0r 2  A6 rr              LDX   tok_src
0002F2r 2  BD rr rr           LDA   input_buf,X
0002F5r 2  C9 2E              CMP   #'.'
0002F7r 2  D0 67              BNE   @apply_sign
0002F9r 2  E6 rr              INC   tok_src
0002FBr 2               
0002FBr 2                     ; Parse up to 2 fractional digits
0002FBr 2  9C rr rr           STZ   num_tmp_hi           ; frac_raw accumulator
0002FEr 2  A0 00              LDY   #0                   ; digit count
000300r 2               @frac_loop:
000300r 2  C0 02              CPY   #2
000302r 2  B0 2E              BCS   @frac_skip
000304r 2  A6 rr              LDX   tok_src
000306r 2  BD rr rr           LDA   input_buf,X
000309r 2  C9 30              CMP   #'0'
00030Br 2  90 36              BCC   @frac_conv
00030Dr 2  C9 3A              CMP   #'9'+1
00030Fr 2  B0 32              BCS   @frac_conv
000311r 2  38                 SEC
000312r 2  E9 30              SBC   #'0'
000314r 2  48                 PHA
000315r 2                     ; frac_raw = frac_raw * 10 + digit
000315r 2  AD rr rr           LDA   num_tmp_hi
000318r 2  0A                 ASL
000319r 2  8D rr rr           STA   num_tmp_lo           ; *2
00031Cr 2  0A                 ASL
00031Dr 2  0A                 ASL                        ; A = val*8
00031Er 2  18                 CLC
00031Fr 2  6D rr rr           ADC   num_tmp_lo           ; A = val*10
000322r 2  8D rr rr           STA   num_tmp_hi
000325r 2  68                 PLA
000326r 2  18                 CLC
000327r 2  6D rr rr           ADC   num_tmp_hi
00032Ar 2  8D rr rr           STA   num_tmp_hi
00032Dr 2  E6 rr              INC   tok_src
00032Fr 2  C8                 INY
000330r 2  80 CE              BRA   @frac_loop
000332r 2               
000332r 2               @frac_skip:
000332r 2                     ; skip remaining digits after '.'
000332r 2  A6 rr              LDX   tok_src
000334r 2  BD rr rr           LDA   input_buf,X
000337r 2  C9 30              CMP   #'0'
000339r 2  90 08              BCC   @frac_conv
00033Br 2  C9 3A              CMP   #'9'+1
00033Dr 2  B0 04              BCS   @frac_conv
00033Fr 2  E6 rr              INC   tok_src
000341r 2  80 EF              BRA   @frac_skip
000343r 2               
000343r 2               @frac_conv:
000343r 2                     ; If only 1 digit, multiply by 10
000343r 2  C0 01              CPY   #1
000345r 2  D0 10              BNE   @frac_2d
000347r 2  AD rr rr           LDA   num_tmp_hi
00034Ar 2  0A                 ASL
00034Br 2  8D rr rr           STA   num_tmp_lo
00034Er 2  0A                 ASL
00034Fr 2  0A                 ASL
000350r 2  18                 CLC
000351r 2  6D rr rr           ADC   num_tmp_lo
000354r 2  8D rr rr           STA   num_tmp_hi
000357r 2               @frac_2d:
000357r 2                     ; Convert centesimal (0..99) → 8-bit fraction
000357r 2  AD rr rr           LDA   num_tmp_hi
00035Ar 2  20 rr rr           JSR   frac_to_byte
00035Dr 2  8D rr rr           STA   num_tmp_lo
000360r 2               
000360r 2               @apply_sign:
000360r 2                     ; Apply sign (negate 16.8 via two's complement if negative)
000360r 2  A5 rr              LDA   tok_sign
000362r 2  F0 1F              BEQ   @emit_num
000364r 2                     ; Negate: complement and add 1 across all 3 bytes
000364r 2  AD rr rr           LDA   num_tmp_lo           ; frac
000367r 2  49 FF              EOR   #$FF
000369r 2  18                 CLC
00036Ar 2  69 01              ADC   #1
00036Cr 2  8D rr rr           STA   num_tmp_lo
00036Fr 2  AD rr rr           LDA   num_val_lo
000372r 2  49 FF              EOR   #$FF
000374r 2  69 00              ADC   #0
000376r 2  8D rr rr           STA   num_val_lo
000379r 2  AD rr rr           LDA   num_val_hi
00037Cr 2  49 FF              EOR   #$FF
00037Er 2  69 00              ADC   #0
000380r 2  8D rr rr           STA   num_val_hi
000383r 2               
000383r 2               @emit_num:
000383r 2                     ; Allocate 6-byte node
000383r 2  A9 06              LDA   #6
000385r 2  A2 01              LDX   #ATYPE_TOKEN
000387r 2  20 rr rr           JSR   heap_alloc
00038Ar 2  B0 25              BCS   @oom
00038Cr 2  A0 00              LDY   #TOK_TAG
00038Er 2  A9 02              LDA   #TOK_NUMBER
000390r 2  91 rr              STA   (ptr_lo),Y
000392r 2  A0 01              LDY   #TOK_NEXT_LO
000394r 2  A9 00              LDA   #0
000396r 2  91 rr              STA   (ptr_lo),Y
000398r 2  C8                 INY
000399r 2  91 rr              STA   (ptr_lo),Y
00039Br 2                     ; Payload: [hi, lo, frac]
00039Br 2  A0 03              LDY   #TOK_PAYLOAD
00039Dr 2  AD rr rr           LDA   num_val_hi
0003A0r 2  91 rr              STA   (ptr_lo),Y
0003A2r 2  C8                 INY
0003A3r 2  AD rr rr           LDA   num_val_lo
0003A6r 2  91 rr              STA   (ptr_lo),Y
0003A8r 2  C8                 INY
0003A9r 2  AD rr rr           LDA   num_tmp_lo
0003ACr 2  91 rr              STA   (ptr_lo),Y
0003AEr 2  4C rr rr           JMP   tok_append_node
0003B1r 2               @oom:
0003B1r 2  60                 RTS
0003B2r 2               
0003B2r 2               ; ---------------------------------------------------------------------
0003B2r 2               ; frac_to_byte — convert centesimal fraction (0..99) to 8-bit (0..252)
0003B2r 2               ;   Input: A = centesimal value (0..99)
0003B2r 2               ;   Output: A = 8-bit fractional byte
0003B2r 2               ;   Method: (A * 256) / 100 via 16÷8 long division
0003B2r 2               ;   Clobbers: X, Y
0003B2r 2               ; ---------------------------------------------------------------------
0003B2r 2               frac_to_byte:
0003B2r 2                     ; dividend = A:$00 (A*256), divisor = 100
0003B2r 2  8D rr rr           STA   num_tmp_hi
0003B5r 2  9C rr rr           STZ   num_tmp_lo
0003B8r 2  A2 00              LDX   #0                   ; remainder
0003BAr 2  A0 10              LDY   #16                  ; 16-bit division
0003BCr 2               @div:
0003BCr 2  0E rr rr           ASL   num_tmp_lo
0003BFr 2  2E rr rr           ROL   num_tmp_hi
0003C2r 2  8A                 TXA
0003C3r 2  2A                 ROL
0003C4r 2  AA                 TAX
0003C5r 2  E0 64              CPX   #100
0003C7r 2  90 08              BCC   @nosub
0003C9r 2  8A                 TXA
0003CAr 2  38                 SEC
0003CBr 2  E9 64              SBC   #100
0003CDr 2  AA                 TAX
0003CEr 2  EE rr rr           INC   num_tmp_lo
0003D1r 2               @nosub:
0003D1r 2  88                 DEY
0003D2r 2  D0 E8              BNE   @div
0003D4r 2  AD rr rr           LDA   num_tmp_lo           ; quotient low byte
0003D7r 2  60                 RTS
0003D8r 2               
0003D8r 2               ; ---------------------------------------------------------------------
0003D8r 2               ; tok_append_node — link ptr_lo/hi into the list, continue scanning
0003D8r 2               ; ---------------------------------------------------------------------
0003D8r 2               tok_append_node:
0003D8r 2  A5 rr              LDA   tok_head_lo
0003DAr 2  05 rr              ORA   tok_head_hi
0003DCr 2  D0 0F              BNE   @link
0003DEr 2                     ; Empty list: head = tail = new node
0003DEr 2  A5 rr              LDA   ptr_lo
0003E0r 2  85 rr              STA   tok_head_lo
0003E2r 2  85 rr              STA   tok_tail_lo
0003E4r 2  A5 rr              LDA   ptr_hi
0003E6r 2  85 rr              STA   tok_head_hi
0003E8r 2  85 rr              STA   tok_tail_hi
0003EAr 2  4C rr rr           JMP   tok_scan_next
0003EDr 2               @link:
0003EDr 2                     ; tail->next = new node
0003EDr 2  A5 rr              LDA   tok_tail_lo
0003EFr 2  85 rr              STA   ptr2_lo
0003F1r 2  A5 rr              LDA   tok_tail_hi
0003F3r 2  85 rr              STA   ptr2_hi
0003F5r 2  A0 01              LDY   #TOK_NEXT_LO
0003F7r 2  A5 rr              LDA   ptr_lo
0003F9r 2  91 rr              STA   (ptr2_lo),Y
0003FBr 2  C8                 INY
0003FCr 2  A5 rr              LDA   ptr_hi
0003FEr 2  91 rr              STA   (ptr2_lo),Y
000400r 2                     ; tail = new node
000400r 2  A5 rr              LDA   ptr_lo
000402r 2  85 rr              STA   tok_tail_lo
000404r 2  A5 rr              LDA   ptr_hi
000406r 2  85 rr              STA   tok_tail_hi
000408r 2  4C rr rr           JMP   tok_scan_next
00040Br 2               
00040Br 2               ; ---------------------------------------------------------------------
00040Br 2               ; is_word_char — test if A is a valid word character
00040Br 2               ;   Returns: carry set = word char, carry clear = delimiter
00040Br 2               ;   Preserves: X
00040Br 2               ; ---------------------------------------------------------------------
00040Br 2               is_word_char:
00040Br 2  C9 00              CMP   #0
00040Dr 2  F0 36              BEQ   @no
00040Fr 2  C9 20              CMP   #$20
000411r 2  F0 32              BEQ   @no
000413r 2  C9 09              CMP   #$09
000415r 2  F0 2E              BEQ   @no
000417r 2  C9 5B              CMP   #'['
000419r 2  F0 2A              BEQ   @no
00041Br 2  C9 5D              CMP   #']'
00041Dr 2  F0 26              BEQ   @no
00041Fr 2  C9 28              CMP   #'('
000421r 2  F0 22              BEQ   @no
000423r 2  C9 29              CMP   #')'
000425r 2  F0 1E              BEQ   @no
000427r 2  C9 2B              CMP   #'+'
000429r 2  F0 1A              BEQ   @no
00042Br 2  C9 2D              CMP   #'-'
00042Dr 2  F0 16              BEQ   @no
00042Fr 2  C9 2A              CMP   #'*'
000431r 2  F0 12              BEQ   @no
000433r 2  C9 2F              CMP   #'/'
000435r 2  F0 0E              BEQ   @no
000437r 2  C9 3C              CMP   #'<'
000439r 2  F0 0A              BEQ   @no
00043Br 2  C9 3E              CMP   #'>'
00043Dr 2  F0 06              BEQ   @no
00043Fr 2  C9 3D              CMP   #'='
000441r 2  F0 02              BEQ   @no
000443r 2  38                 SEC
000444r 2  60                 RTS
000445r 2               @no:
000445r 2  18                 CLC
000446r 2  60                 RTS
000447r 2               
000447r 2               ; =====================================================================
000447r 2               ; print_token_count — walk the token list, count, print "N TOKENS\n"
000447r 2               ; =====================================================================
000447r 2               print_token_count:
000447r 2  A2 00              LDX   #0
000449r 2  A5 rr              LDA   tok_head_lo
00044Br 2  85 rr              STA   ptr2_lo
00044Dr 2  A5 rr              LDA   tok_head_hi
00044Fr 2  85 rr              STA   ptr2_hi
000451r 2               @walk:
000451r 2  A5 rr              LDA   ptr2_lo
000453r 2  05 rr              ORA   ptr2_hi
000455r 2  F0 10              BEQ   @print
000457r 2  E8                 INX
000458r 2  A0 01              LDY   #TOK_NEXT_LO
00045Ar 2  B1 rr              LDA   (ptr2_lo),Y
00045Cr 2  48                 PHA
00045Dr 2  C8                 INY
00045Er 2  B1 rr              LDA   (ptr2_lo),Y
000460r 2  85 rr              STA   ptr2_hi
000462r 2  68                 PLA
000463r 2  85 rr              STA   ptr2_lo
000465r 2  80 EA              BRA   @walk
000467r 2               @print:
000467r 2  8A                 TXA
000468r 2  20 rr rr           JSR   print_byte_decimal
00046Br 2  A2 00              LDX   #0
00046Dr 2               @str:
00046Dr 2  BD rr rr           LDA   str_tokens,X
000470r 2  F0 06              BEQ   @nl
000472r 2  8D 0E A0           STA   VGC_CHAROUT
000475r 2  E8                 INX
000476r 2  D0 F5              BNE   @str
000478r 2               @nl:
000478r 2  A9 0D              LDA   #$0D
00047Ar 2  8D 0E A0           STA   VGC_CHAROUT
00047Dr 2  A9 0A              LDA   #$0A
00047Fr 2  8D 0E A0           STA   VGC_CHAROUT
000482r 2  60                 RTS
000483r 2               
000483r 2               ; ---------------------------------------------------------------------
000483r 2               ; print_byte_decimal — print A as 1-3 decimal digits (no leading zeros)
000483r 2               ;   Input: A = value 0..255
000483r 2               ; ---------------------------------------------------------------------
000483r 2               print_byte_decimal:
000483r 2  A2 00              LDX   #0                   ; suppress leading zeros
000485r 2  A0 00              LDY   #0
000487r 2               @hundreds:
000487r 2  C9 64              CMP   #100
000489r 2  90 06              BCC   @tens_setup
00048Br 2  38                 SEC
00048Cr 2  E9 64              SBC   #100
00048Er 2  C8                 INY
00048Fr 2  80 F6              BRA   @hundreds
000491r 2               @tens_setup:
000491r 2  48                 PHA
000492r 2  98                 TYA
000493r 2  F0 07              BEQ   @skip_h
000495r 2  09 30              ORA   #'0'
000497r 2  8D 0E A0           STA   VGC_CHAROUT
00049Ar 2  A2 01              LDX   #1
00049Cr 2               @skip_h:
00049Cr 2  68                 PLA
00049Dr 2  A0 00              LDY   #0
00049Fr 2               @tens:
00049Fr 2  C9 0A              CMP   #10
0004A1r 2  90 06              BCC   @ones
0004A3r 2  38                 SEC
0004A4r 2  E9 0A              SBC   #10
0004A6r 2  C8                 INY
0004A7r 2  80 F6              BRA   @tens
0004A9r 2               @ones:
0004A9r 2  48                 PHA
0004AAr 2  98                 TYA
0004ABr 2  D0 04              BNE   @print_t
0004ADr 2  E0 00              CPX   #0
0004AFr 2  F0 05              BEQ   @skip_t
0004B1r 2               @print_t:
0004B1r 2  09 30              ORA   #'0'
0004B3r 2  8D 0E A0           STA   VGC_CHAROUT
0004B6r 2               @skip_t:
0004B6r 2  68                 PLA
0004B7r 2  09 30              ORA   #'0'
0004B9r 2  8D 0E A0           STA   VGC_CHAROUT
0004BCr 2  60                 RTS
0004BDr 2               
0004BDr 2               ; =====================================================================
0004BDr 2               ; RODATA — tokenizer strings
0004BDr 2               ; =====================================================================
0004BDr 2                     .segment "RODATA"
000000r 2               
000000r 2               str_tokens:
000000r 2  20 54 4F 4B        .byte " TOKENS", 0
000004r 2  45 4E 53 00  
000008r 2               
000008r 1                     .include "eval.s"
000008r 2               ; eval.s — evaluator: walk token list and dispatch commands
000008r 2               
000008r 2               ; =====================================================================
000008r 2               ; ZEROPAGE segment — evaluator variables
000008r 2               ; =====================================================================
000008r 2                     .segment "ZEROPAGE"
00000Cr 2               
00000Cr 2  xx           eval_type:      .res 1    ; result type: $00=number, $01=word
00000Dr 2  xx           eval_val_hi:    .res 1    ; number high byte or word ptr high
00000Er 2  xx           eval_val_lo:    .res 1    ; number low byte or word ptr low
00000Fr 2  xx           eval_val_frac:  .res 1    ; number fractional byte
000010r 2  xx           eval_cur_lo:    .res 1    ; current token pointer (low)
000011r 2  xx           eval_cur_hi:    .res 1    ; current token pointer (high)
000012r 2  xx           eval_left_hi:   .res 1    ; saved left operand high byte
000013r 2  xx           eval_left_lo:   .res 1    ; saved left operand low byte
000014r 2  xx           eval_left_frac: .res 1    ; saved left operand fractional byte
000015r 2  xx           eval_op:        .res 1    ; infix operator character
000016r 2  xx           handler_lo:     .res 1    ; saved handler address for JMP
000017r 2  xx           handler_hi:     .res 1
000018r 2  xx           eval_in_body:   .res 1    ; $00 = normal eval_loop, $01 = in body
000019r 2  xx           proc_stopped:   .res 1    ; $00 = running, $01 = STOP, $02 = OUTPUT
00001Ar 2  xx           eval_reporter:  .res 1    ; $00 = normal, $01 = reporter mode (return from eval_continue)
00001Br 2               
00001Br 2               ; --- Catch frame for CATCH/THROW error handling ---
00001Br 2  xx           catch_active:   .res 1    ; $00 = no catch, $01 = catch active
00001Cr 2  xx           catch_tag_lo:   .res 1    ; pointer to tag word (length-prefixed)
00001Dr 2  xx           catch_tag_hi:   .res 1
00001Er 2  xx           catch_sp:       .res 1    ; saved 6502 stack pointer for unwinding
00001Fr 2  xx           catch_resume_lo: .res 1   ; eval_cur to resume at (past the body's ])
000020r 2  xx           catch_resume_hi: .res 1
000021r 2               
000021r 2               ; =====================================================================
000021r 2               ; BSS segment — scratch for number printing
000021r 2               ; =====================================================================
000021r 2                     .segment "BSS"
000007r 2               
000007r 2  xx xx xx xx  pn_buf:         .res 8    ; decimal digit buffer for print_number
00000Br 2  xx xx xx xx  
00000Fr 2               
00000Fr 2               ; =====================================================================
00000Fr 2               ; CODE segment — evaluator routines
00000Fr 2               ; =====================================================================
00000Fr 2                     .segment "CODE"
0004BDr 2               
0004BDr 2               ; ---------------------------------------------------------------------
0004BDr 2               ; eval_line — evaluate the token list built by tokenize_line
0004BDr 2               ;   Input:  tok_head_lo/hi = first token
0004BDr 2               ;   Output: commands executed, errors printed
0004BDr 2               ; ---------------------------------------------------------------------
0004BDr 2               eval_line:
0004BDr 2  64 rr              STZ   eval_in_body
0004BFr 2  64 rr              STZ   proc_stopped
0004C1r 2  64 rr              STZ   eval_reporter
0004C3r 2  A5 rr              LDA   tok_head_lo
0004C5r 2  85 rr              STA   eval_cur_lo
0004C7r 2  A5 rr              LDA   tok_head_hi
0004C9r 2  85 rr              STA   eval_cur_hi
0004CBr 2               
0004CBr 2               eval_loop:
0004CBr 2                     ; Check if STOP/OUTPUT was signaled — bail out
0004CBr 2  A5 rr              LDA   proc_stopped
0004CDr 2  D0 1B              BNE   @bail_out
0004CFr 2               
0004CFr 2                     ; Check for end of list
0004CFr 2  A5 rr              LDA   eval_cur_lo
0004D1r 2  05 rr              ORA   eval_cur_hi
0004D3r 2  F0 15              BEQ   @bail_out
0004D5r 2               
0004D5r 2                     ; Read tag of current token
0004D5r 2  A5 rr              LDA   eval_cur_lo
0004D7r 2  85 rr              STA   ptr_lo
0004D9r 2  A5 rr              LDA   eval_cur_hi
0004DBr 2  85 rr              STA   ptr_hi
0004DDr 2  A0 00              LDY   #TOK_TAG
0004DFr 2  B1 rr              LDA   (ptr_lo),Y
0004E1r 2               
0004E1r 2                     ; Dispatch based on tag
0004E1r 2  C9 01              CMP   #TOK_WORD
0004E3r 2  F0 06              BEQ   @do_command
0004E5r 2               
0004E5r 2                     ; Bare expression — skip it for now (could error)
0004E5r 2                     ; Advance to next token
0004E5r 2  20 rr rr           JSR   eval_advance
0004E8r 2  80 E1              BRA   eval_loop
0004EAr 2               
0004EAr 2               @bail_out:
0004EAr 2  60                 RTS
0004EBr 2               
0004EBr 2               @do_command:
0004EBr 2                     ; Look up the word in the builtin table
0004EBr 2  20 rr rr           JSR   lookup_builtin
0004EEr 2  B0 42              BCS   @unknown
0004F0r 2               
0004F0r 2                     ; Found: handler addr is in ptr2_lo/hi, arity in A
0004F0r 2                     ; Save handler address — eval_expr may clobber ptr2
0004F0r 2  A6 rr              LDX   ptr2_lo
0004F2r 2  86 rr              STX   handler_lo
0004F4r 2  A6 rr              LDX   ptr2_hi
0004F6r 2  86 rr              STX   handler_hi
0004F8r 2                     ; Save arity across eval_advance (which clobbers X)
0004F8r 2  AA                 TAX
0004F9r 2  DA                 PHX
0004FAr 2                     ; Advance past the command word token
0004FAr 2  20 rr rr           JSR   eval_advance
0004FDr 2  FA                 PLX
0004FEr 2               
0004FEr 2                     ; Evaluate arguments (X = arity count)
0004FEr 2  E0 00              CPX   #0
000500r 2  F0 16              BEQ   @call_handler
000502r 2                     ; Save handler address — eval_expr may invoke proc_invoke which
000502r 2                     ; clobbers handler_lo/hi via inner eval_loop dispatch
000502r 2  A5 rr              LDA   handler_hi
000504r 2  48                 PHA
000505r 2  A5 rr              LDA   handler_lo
000507r 2  48                 PHA
000508r 2               @eval_args:
000508r 2  DA                 PHX                   ; save remaining arg count
000509r 2  20 rr rr           JSR   eval_expr
00050Cr 2  B0 0D              BCS   @arg_error
00050Er 2  FA                 PLX
00050Fr 2  CA                 DEX
000510r 2  D0 F6              BNE   @eval_args
000512r 2                     ; Restore handler address
000512r 2  68                 PLA
000513r 2  85 rr              STA   handler_lo
000515r 2  68                 PLA
000516r 2  85 rr              STA   handler_hi
000518r 2               
000518r 2               @call_handler:
000518r 2                     ; Call the handler via indirect JMP
000518r 2  6C rr rr           JMP   (handler_lo)
00051Br 2                     ; handlers must JMP back to eval_loop via eval_continue
00051Br 2               
00051Br 2               @arg_error:
00051Br 2  FA                 PLX                   ; discard saved arity counter
00051Cr 2                     ; Discard saved handler address
00051Cr 2  68                 PLA
00051Dr 2  68                 PLA
00051Er 2                     ; Print error and abort line
00051Er 2  A2 00              LDX   #0
000520r 2               @ae_lp:
000520r 2  BD rr rr           LDA   str_notenough,X
000523r 2  F0 06              BEQ   @ae_done
000525r 2  8D 0E A0           STA   VGC_CHAROUT
000528r 2  E8                 INX
000529r 2  D0 F5              BNE   @ae_lp
00052Br 2               @ae_done:
00052Br 2  20 rr rr           JSR   eval_newline
00052Er 2  20 rr rr           JSR   try_throw_error
000531r 2  60                 RTS
000532r 2               
000532r 2               @unknown:
000532r 2                     ; Try user-defined procedures before erroring
000532r 2  20 rr rr           JSR   proc_lookup
000535r 2  B0 06              BCS   @try_ext_cmd
000537r 2                     ; Found a procedure — invoke it (proc_stopped restored internally)
000537r 2  20 rr rr           JSR   proc_invoke
00053Ar 2  4C rr rr           JMP   eval_loop
00053Dr 2               
00053Dr 2               @try_ext_cmd:
00053Dr 2                     ; Try extension command table before giving up
00053Dr 2  20 rr rr           JSR   lookup_ext_cmd
000540r 2  B0 35              BCS   @truly_unknown
000542r 2                     ; Found: A = arity, ext_cmd set.
000542r 2                     ; Advance past the command word token.
000542r 2  AA                 TAX                       ; X = arity
000543r 2  DA                 PHX
000544r 2  20 rr rr           JSR   eval_advance
000547r 2  FA                 PLX
000548r 2                     ; Evaluate arguments and copy to ext_arg slots
000548r 2  20 rr rr           JSR   ext_eval_args
00054Br 2  B0 16              BCS   @ext_arg_err
00054Dr 2                     ; Call extension via RAM trampoline
00054Dr 2  20 70 02           JSR   EXT_TRAMPOLINE
000550r 2                     ; Copy result back to eval_val
000550r 2  A5 8E              LDA   EXT_RESULT_TYPE
000552r 2  85 rr              STA   eval_type
000554r 2  A5 8F              LDA   EXT_RESULT_HI
000556r 2  85 rr              STA   eval_val_hi
000558r 2  A5 90              LDA   EXT_RESULT_LO
00055Ar 2  85 rr              STA   eval_val_lo
00055Cr 2  A5 91              LDA   EXT_RESULT_FRAC
00055Er 2  85 rr              STA   eval_val_frac
000560r 2  4C rr rr           JMP   eval_continue
000563r 2               
000563r 2               @ext_arg_err:
000563r 2  A2 00              LDX   #0
000565r 2               @eae_lp:
000565r 2  BD rr rr           LDA   str_notenough,X
000568r 2  F0 06              BEQ   @eae_done
00056Ar 2  8D 0E A0           STA   VGC_CHAROUT
00056Dr 2  E8                 INX
00056Er 2  D0 F5              BNE   @eae_lp
000570r 2               @eae_done:
000570r 2  20 rr rr           JSR   eval_newline
000573r 2  20 rr rr           JSR   try_throw_error
000576r 2  60                 RTS
000577r 2               
000577r 2               @truly_unknown:
000577r 2                     ; Print "I don't know how to " + the word
000577r 2  A2 00              LDX   #0
000579r 2               @unk_lp:
000579r 2  BD rr rr           LDA   str_idk,X
00057Cr 2  F0 06              BEQ   @unk_word
00057Er 2  8D 0E A0           STA   VGC_CHAROUT
000581r 2  E8                 INX
000582r 2  D0 F5              BNE   @unk_lp
000584r 2               @unk_word:
000584r 2                     ; Print the word from the token payload
000584r 2  A5 rr              LDA   eval_cur_lo
000586r 2  85 rr              STA   ptr_lo
000588r 2  A5 rr              LDA   eval_cur_hi
00058Ar 2  85 rr              STA   ptr_hi
00058Cr 2  A0 03              LDY   #TOK_PAYLOAD        ; length byte
00058Er 2  B1 rr              LDA   (ptr_lo),Y
000590r 2  AA                 TAX                       ; X = length
000591r 2  A0 04              LDY   #TOK_PAYLOAD+1      ; first char
000593r 2               @unk_ch:
000593r 2  B1 rr              LDA   (ptr_lo),Y
000595r 2  8D 0E A0           STA   VGC_CHAROUT
000598r 2  C8                 INY
000599r 2  CA                 DEX
00059Ar 2  D0 F7              BNE   @unk_ch
00059Cr 2  20 rr rr           JSR   eval_newline
00059Fr 2  20 rr rr           JSR   try_throw_error
0005A2r 2  60                 RTS
0005A3r 2               
0005A3r 2               @done:
0005A3r 2  60                 RTS
0005A4r 2               
0005A4r 2               ; ---------------------------------------------------------------------
0005A4r 2               ; eval_continue — handlers JMP here to resume the eval loop
0005A4r 2               ;   If eval_in_body != 0, resumes body execution instead
0005A4r 2               ; ---------------------------------------------------------------------
0005A4r 2               ; ---------------------------------------------------------------------
0005A4r 2               ; jmp_handler — trampoline for calling builtins from reporter position
0005A4r 2               ; ---------------------------------------------------------------------
0005A4r 2               jmp_handler:
0005A4r 2  6C rr rr           JMP   (handler_lo)
0005A7r 2               
0005A7r 2               eval_continue:
0005A7r 2                     ; If in reporter mode, return to eval_expr instead of looping
0005A7r 2  A5 rr              LDA   eval_reporter
0005A9r 2  D0 07              BNE   @reporter_return
0005ABr 2  A5 rr              LDA   eval_in_body
0005ADr 2  D0 07              BNE   eval_body
0005AFr 2  4C rr rr           JMP   eval_loop
0005B2r 2               
0005B2r 2               @reporter_return:
0005B2r 2  64 rr              STZ   eval_reporter
0005B4r 2  18                 CLC
0005B5r 2  60                 RTS
0005B6r 2               
0005B6r 2               ; ---------------------------------------------------------------------
0005B6r 2               ; eval_body — execute tokens within a body until TOK_RBRACKET at depth 0
0005B6r 2               ;   Entry: eval_cur is at the next token to execute inside the body
0005B6r 2               ;   Exit:  eval_cur points at the TOK_RBRACKET that ended the body
0005B6r 2               ;   eval_in_body must be $01 on entry
0005B6r 2               ; ---------------------------------------------------------------------
0005B6r 2               eval_body:
0005B6r 2                     ; Check if STOP/OUTPUT was signaled — bail out immediately
0005B6r 2  A5 rr              LDA   proc_stopped
0005B8r 2  D0 65              BNE   @done
0005BAr 2               
0005BAr 2                     ; Check for end of list (safety — malformed input)
0005BAr 2  A5 rr              LDA   eval_cur_lo
0005BCr 2  05 rr              ORA   eval_cur_hi
0005BEr 2  F0 5F              BEQ   @done
0005C0r 2               
0005C0r 2                     ; Read tag of current token
0005C0r 2  A5 rr              LDA   eval_cur_lo
0005C2r 2  85 rr              STA   ptr_lo
0005C4r 2  A5 rr              LDA   eval_cur_hi
0005C6r 2  85 rr              STA   ptr_hi
0005C8r 2  A0 00              LDY   #TOK_TAG
0005CAr 2  B1 rr              LDA   (ptr_lo),Y
0005CCr 2               
0005CCr 2                     ; Hit the closing bracket? We're done with this body pass.
0005CCr 2  C9 04              CMP   #TOK_RBRACKET
0005CEr 2  F0 4F              BEQ   @done
0005D0r 2               
0005D0r 2                     ; Dispatch command words (same as eval_loop)
0005D0r 2  C9 01              CMP   #TOK_WORD
0005D2r 2  F0 05              BEQ   @do_command
0005D4r 2               
0005D4r 2                     ; Skip non-word tokens (bare numbers, brackets inside expressions, etc.)
0005D4r 2  20 rr rr           JSR   eval_advance
0005D7r 2  80 DD              BRA   eval_body
0005D9r 2               
0005D9r 2               @do_command:
0005D9r 2                     ; Same dispatch as eval_loop — look up builtin, eval args, call handler
0005D9r 2  20 rr rr           JSR   lookup_builtin
0005DCr 2  B0 42              BCS   @unknown
0005DEr 2               
0005DEr 2  A6 rr              LDX   ptr2_lo
0005E0r 2  86 rr              STX   handler_lo
0005E2r 2  A6 rr              LDX   ptr2_hi
0005E4r 2  86 rr              STX   handler_hi
0005E6r 2  AA                 TAX
0005E7r 2  DA                 PHX
0005E8r 2  20 rr rr           JSR   eval_advance
0005EBr 2  FA                 PLX
0005ECr 2               
0005ECr 2  E0 00              CPX   #0
0005EEr 2  F0 16              BEQ   @call_handler
0005F0r 2                     ; Save handler address — eval_expr may invoke proc_invoke
0005F0r 2  A5 rr              LDA   handler_hi
0005F2r 2  48                 PHA
0005F3r 2  A5 rr              LDA   handler_lo
0005F5r 2  48                 PHA
0005F6r 2               @eval_args:
0005F6r 2  DA                 PHX
0005F7r 2  20 rr rr           JSR   eval_expr
0005FAr 2  B0 0D              BCS   @arg_error
0005FCr 2  FA                 PLX
0005FDr 2  CA                 DEX
0005FEr 2  D0 F6              BNE   @eval_args
000600r 2                     ; Restore handler address
000600r 2  68                 PLA
000601r 2  85 rr              STA   handler_lo
000603r 2  68                 PLA
000604r 2  85 rr              STA   handler_hi
000606r 2               
000606r 2               @call_handler:
000606r 2  6C rr rr           JMP   (handler_lo)
000609r 2                     ; handler JMPs to eval_continue, which routes back here
000609r 2               
000609r 2               @arg_error:
000609r 2  FA                 PLX
00060Ar 2  68                 PLA
00060Br 2  68                 PLA
00060Cr 2  A2 00              LDX   #0
00060Er 2               @ae_lp:
00060Er 2  BD rr rr           LDA   str_notenough,X
000611r 2  F0 06              BEQ   @ae_done
000613r 2  8D 0E A0           STA   VGC_CHAROUT
000616r 2  E8                 INX
000617r 2  D0 F5              BNE   @ae_lp
000619r 2               @ae_done:
000619r 2  20 rr rr           JSR   eval_newline
00061Cr 2  20 rr rr           JSR   try_throw_error
00061Fr 2                     ; fall through to @done — abort body on error
00061Fr 2               
00061Fr 2               @done:
00061Fr 2  60                 RTS
000620r 2               
000620r 2               @unknown:
000620r 2                     ; Try user-defined procedures before erroring (inside body)
000620r 2  20 rr rr           JSR   proc_lookup
000623r 2  B0 06              BCS   @try_ext_cmd
000625r 2  20 rr rr           JSR   proc_invoke
000628r 2  4C rr rr           JMP   eval_body
00062Br 2               
00062Br 2               @try_ext_cmd:
00062Br 2                     ; Try extension command table before giving up (inside body)
00062Br 2  20 rr rr           JSR   lookup_ext_cmd
00062Er 2  B0 35              BCS   @truly_unknown
000630r 2  AA                 TAX
000631r 2  DA                 PHX
000632r 2  20 rr rr           JSR   eval_advance
000635r 2  FA                 PLX
000636r 2  20 rr rr           JSR   ext_eval_args
000639r 2  B0 16              BCS   @body_ext_err
00063Br 2  20 70 02           JSR   EXT_TRAMPOLINE
00063Er 2  A5 8E              LDA   EXT_RESULT_TYPE
000640r 2  85 rr              STA   eval_type
000642r 2  A5 8F              LDA   EXT_RESULT_HI
000644r 2  85 rr              STA   eval_val_hi
000646r 2  A5 90              LDA   EXT_RESULT_LO
000648r 2  85 rr              STA   eval_val_lo
00064Ar 2  A5 91              LDA   EXT_RESULT_FRAC
00064Cr 2  85 rr              STA   eval_val_frac
00064Er 2  4C rr rr           JMP   eval_continue
000651r 2               
000651r 2               @body_ext_err:
000651r 2  A2 00              LDX   #0
000653r 2               @bee_lp:
000653r 2  BD rr rr           LDA   str_notenough,X
000656r 2  F0 06              BEQ   @bee_done
000658r 2  8D 0E A0           STA   VGC_CHAROUT
00065Br 2  E8                 INX
00065Cr 2  D0 F5              BNE   @bee_lp
00065Er 2               @bee_done:
00065Er 2  20 rr rr           JSR   eval_newline
000661r 2  20 rr rr           JSR   try_throw_error
000664r 2  60                 RTS
000665r 2               
000665r 2               @truly_unknown:
000665r 2                     ; Print "I don't know how to " + the word (inside body)
000665r 2  A2 00              LDX   #0
000667r 2               @unk_lp:
000667r 2  BD rr rr           LDA   str_idk,X
00066Ar 2  F0 06              BEQ   @unk_word
00066Cr 2  8D 0E A0           STA   VGC_CHAROUT
00066Fr 2  E8                 INX
000670r 2  D0 F5              BNE   @unk_lp
000672r 2               @unk_word:
000672r 2  A5 rr              LDA   eval_cur_lo
000674r 2  85 rr              STA   ptr_lo
000676r 2  A5 rr              LDA   eval_cur_hi
000678r 2  85 rr              STA   ptr_hi
00067Ar 2  A0 03              LDY   #TOK_PAYLOAD
00067Cr 2  B1 rr              LDA   (ptr_lo),Y
00067Er 2  AA                 TAX
00067Fr 2  A0 04              LDY   #TOK_PAYLOAD+1
000681r 2               @unk_ch:
000681r 2  B1 rr              LDA   (ptr_lo),Y
000683r 2  8D 0E A0           STA   VGC_CHAROUT
000686r 2  C8                 INY
000687r 2  CA                 DEX
000688r 2  D0 F7              BNE   @unk_ch
00068Ar 2  20 rr rr           JSR   eval_newline
00068Dr 2  20 rr rr           JSR   try_throw_error
000690r 2  60                 RTS
000691r 2               
000691r 2               ; ---------------------------------------------------------------------
000691r 2               ; eval_advance — advance eval_cur to the next token in the list
000691r 2               ;   Reads next pointer from current token, stores in eval_cur
000691r 2               ; ---------------------------------------------------------------------
000691r 2               eval_advance:
000691r 2  A5 rr              LDA   eval_cur_lo
000693r 2  85 rr              STA   ptr_lo
000695r 2  A5 rr              LDA   eval_cur_hi
000697r 2  85 rr              STA   ptr_hi
000699r 2  A0 01              LDY   #TOK_NEXT_LO
00069Br 2  B1 rr              LDA   (ptr_lo),Y
00069Dr 2  AA                 TAX
00069Er 2  C8                 INY
00069Fr 2  B1 rr              LDA   (ptr_lo),Y
0006A1r 2  85 rr              STA   eval_cur_hi
0006A3r 2  86 rr              STX   eval_cur_lo
0006A5r 2  60                 RTS
0006A6r 2               
0006A6r 2               ; ---------------------------------------------------------------------
0006A6r 2               ; eval_expr — evaluate one expression from the current token
0006A6r 2               ;   Output: eval_type, eval_val_hi/lo/frac set
0006A6r 2               ;           Carry clear = success, Carry set = error (no token)
0006A6r 2               ;   Advances eval_cur past the consumed token
0006A6r 2               ; ---------------------------------------------------------------------
0006A6r 2               eval_expr:
0006A6r 2                     ; Check for end of list
0006A6r 2  A5 rr              LDA   eval_cur_lo
0006A8r 2  05 rr              ORA   eval_cur_hi
0006AAr 2  D0 02              BNE   @have_token
0006ACr 2  38                 SEC                       ; no more tokens
0006ADr 2  60                 RTS
0006AEr 2               
0006AEr 2               @have_token:
0006AEr 2  A5 rr              LDA   eval_cur_lo
0006B0r 2  85 rr              STA   ptr_lo
0006B2r 2  A5 rr              LDA   eval_cur_hi
0006B4r 2  85 rr              STA   ptr_hi
0006B6r 2  A0 00              LDY   #TOK_TAG
0006B8r 2  B1 rr              LDA   (ptr_lo),Y
0006BAr 2               
0006BAr 2  C9 02              CMP   #TOK_NUMBER
0006BCr 2  D0 03              BNE   :+
0006BEr 2  4C rr rr           JMP   @number
0006C1r 2  C9 06        :     CMP   #TOK_QUOTE
0006C3r 2  D0 03              BNE   :+
0006C5r 2  4C rr rr           JMP   @quote
0006C8r 2  C9 05        :     CMP   #TOK_VARREF
0006CAr 2  D0 03              BNE   :+
0006CCr 2  4C rr rr           JMP   @varref
0006CFr 2  C9 01        :     CMP   #TOK_WORD
0006D1r 2  F0 06              BEQ   @word_expr
0006D3r 2  C9 03              CMP   #TOK_LBRACKET
0006D5r 2  F0 19              BEQ   @list_literal
0006D7r 2                     ; Anything else is an error
0006D7r 2  38                 SEC
0006D8r 2  60                 RTS
0006D9r 2               
0006D9r 2               @word_expr:
0006D9r 2                     ; Could be a reporter procedure (returns a value via OUTPUT)
0006D9r 2  20 rr rr           JSR   proc_lookup
0006DCr 2  B0 19              BCS   @word_not_proc        ; not a procedure — try builtins
0006DEr 2                     ; It's a procedure — invoke it
0006DEr 2  20 rr rr           JSR   proc_invoke
0006E1r 2                     ; X = exit status: $02 = OUTPUT (eval_val has value), else no value
0006E1r 2  E0 02              CPX   #$02
0006E3r 2  F0 08              BEQ   @word_has_val
0006E5r 2                     ; No OUTPUT — set result to 0
0006E5r 2  64 rr              STZ   eval_val_hi
0006E7r 2  64 rr              STZ   eval_val_lo
0006E9r 2  64 rr              STZ   eval_val_frac
0006EBr 2  64 rr              STZ   eval_type
0006EDr 2               @word_has_val:
0006EDr 2  4C rr rr           JMP   eval_check_infix      ; allow DOUBLE 5 + 3 etc.
0006F0r 2               
0006F0r 2               @list_literal:
0006F0r 2                     ; Advance past the [
0006F0r 2  20 rr rr           JSR   eval_advance
0006F3r 2                     ; Build list from tokens until ]
0006F3r 2  20 rr rr           JSR   eval_list
0006F6r 2                     ; eval_type = VAL_LIST, eval_val = head pointer
0006F6r 2                     ; Carry already set/clear from eval_list
0006F6r 2  60                 RTS
0006F7r 2               
0006F7r 2               @word_not_proc:
0006F7r 2                     ; Not a user proc — try built-in reporter
0006F7r 2  20 rr rr           JSR   lookup_builtin
0006FAr 2  B0 37              BCS   @word_unknown
0006FCr 2                     ; Found: ptr2_lo/hi = handler addr, A = arity
0006FCr 2                     ; Save handler address
0006FCr 2  A6 rr              LDX   ptr2_lo
0006FEr 2  86 rr              STX   handler_lo
000700r 2  A6 rr              LDX   ptr2_hi
000702r 2  86 rr              STX   handler_hi
000704r 2  AA                 TAX                       ; X = arity
000705r 2  DA                 PHX                       ; save arity across eval_advance
000706r 2                     ; Advance past the command word
000706r 2  20 rr rr           JSR   eval_advance
000709r 2  FA                 PLX                       ; restore arity
00070Ar 2                     ; Evaluate arguments (X = arity count)
00070Ar 2  E0 00              CPX   #0
00070Cr 2  F0 16              BEQ   @call_reporter
00070Er 2                     ; Save handler address — eval_expr may clobber it
00070Er 2  A5 rr              LDA   handler_hi
000710r 2  48                 PHA
000711r 2  A5 rr              LDA   handler_lo
000713r 2  48                 PHA
000714r 2               @rpt_eval_args:
000714r 2  DA                 PHX
000715r 2  20 rr rr           JSR   eval_expr
000718r 2  B0 14              BCS   @rpt_arg_error
00071Ar 2  FA                 PLX
00071Br 2  CA                 DEX
00071Cr 2  D0 F6              BNE   @rpt_eval_args
00071Er 2                     ; Restore handler address
00071Er 2  68                 PLA
00071Fr 2  85 rr              STA   handler_lo
000721r 2  68                 PLA
000722r 2  85 rr              STA   handler_hi
000724r 2               @call_reporter:
000724r 2                     ; Set reporter mode so eval_continue returns here instead of looping
000724r 2  A9 01              LDA   #$01
000726r 2  85 rr              STA   eval_reporter
000728r 2                     ; Call via JSR to trampoline — handler JMPs to eval_continue
000728r 2                     ; which sees eval_reporter and does CLC + RTS back here.
000728r 2  20 rr rr           JSR   jmp_handler
00072Br 2                     ; eval_val now set by the handler
00072Br 2  4C rr rr           JMP   eval_check_infix
00072Er 2               
00072Er 2               @rpt_arg_error:
00072Er 2  FA                 PLX                       ; discard saved arity counter
00072Fr 2  68                 PLA
000730r 2  68                 PLA                       ; discard saved handler address
000731r 2  38                 SEC
000732r 2  60                 RTS
000733r 2               
000733r 2               @word_unknown:
000733r 2                     ; Try extension command table as reporter
000733r 2  20 rr rr           JSR   lookup_ext_cmd
000736r 2  B0 22              BCS   @word_really_unknown
000738r 2                     ; Found: A = arity, EXT_CMD set
000738r 2  AA                 TAX
000739r 2  DA                 PHX
00073Ar 2  20 rr rr           JSR   eval_advance
00073Dr 2  FA                 PLX
00073Er 2  20 rr rr           JSR   ext_eval_args
000741r 2  B0 17              BCS   @word_really_unknown
000743r 2  20 70 02           JSR   EXT_TRAMPOLINE
000746r 2                     ; Copy result back to eval_val
000746r 2  A5 8E              LDA   EXT_RESULT_TYPE
000748r 2  85 rr              STA   eval_type
00074Ar 2  A5 8F              LDA   EXT_RESULT_HI
00074Cr 2  85 rr              STA   eval_val_hi
00074Er 2  A5 90              LDA   EXT_RESULT_LO
000750r 2  85 rr              STA   eval_val_lo
000752r 2  A5 91              LDA   EXT_RESULT_FRAC
000754r 2  85 rr              STA   eval_val_frac
000756r 2  18                 CLC
000757r 2  4C rr rr           JMP   eval_check_infix
00075Ar 2               
00075Ar 2               @word_really_unknown:
00075Ar 2  38                 SEC
00075Br 2  60                 RTS
00075Cr 2               
00075Cr 2               @number:
00075Cr 2                     ; Copy 3-byte payload to eval_val
00075Cr 2  A0 03              LDY   #TOK_PAYLOAD
00075Er 2  B1 rr              LDA   (ptr_lo),Y         ; int_hi
000760r 2  85 rr              STA   eval_val_hi
000762r 2  C8                 INY
000763r 2  B1 rr              LDA   (ptr_lo),Y         ; int_lo
000765r 2  85 rr              STA   eval_val_lo
000767r 2  C8                 INY
000768r 2  B1 rr              LDA   (ptr_lo),Y         ; frac
00076Ar 2  85 rr              STA   eval_val_frac
00076Cr 2  64 rr              STZ   eval_type           ; $00 = number
00076Er 2  20 rr rr           JSR   eval_advance
000771r 2  4C rr rr           JMP   eval_check_infix    ; check for infix operator
000774r 2               
000774r 2               @quote:
000774r 2                     ; Point eval_val at the payload (length byte + chars)
000774r 2                     ; Pointer = ptr_lo/hi + TOK_PAYLOAD
000774r 2  18                 CLC
000775r 2  A5 rr              LDA   ptr_lo
000777r 2  69 03              ADC   #TOK_PAYLOAD
000779r 2  85 rr              STA   eval_val_lo
00077Br 2  A5 rr              LDA   ptr_hi
00077Dr 2  69 00              ADC   #0
00077Fr 2  85 rr              STA   eval_val_hi
000781r 2  64 rr              STZ   eval_val_frac
000783r 2  A9 01              LDA   #$01
000785r 2  85 rr              STA   eval_type           ; $01 = word
000787r 2  20 rr rr           JSR   eval_advance
00078Ar 2  18                 CLC
00078Br 2  60                 RTS
00078Cr 2               
00078Cr 2               @varref:
00078Cr 2                     ; Variable reference — :NAME
00078Cr 2                     ; Payload is length-prefixed name at token + TOK_PAYLOAD
00078Cr 2  18                 CLC
00078Dr 2  A5 rr              LDA   ptr_lo
00078Fr 2  69 03              ADC   #TOK_PAYLOAD
000791r 2  85 rr              STA   ptr_lo
000793r 2  A5 rr              LDA   ptr_hi
000795r 2  69 00              ADC   #0
000797r 2  85 rr              STA   ptr_hi
000799r 2  20 rr rr           JSR   var_get
00079Cr 2  90 30              BCC   @var_ok
00079Er 2               
00079Er 2                     ; Not found — print "NAME has no value"
00079Er 2                     ; ptr_lo/hi was clobbered by var_get, reload from eval_cur
00079Er 2  A5 rr              LDA   eval_cur_lo
0007A0r 2  85 rr              STA   ptr_lo
0007A2r 2  A5 rr              LDA   eval_cur_hi
0007A4r 2  85 rr              STA   ptr_hi
0007A6r 2  A0 03              LDY   #TOK_PAYLOAD          ; length byte
0007A8r 2  B1 rr              LDA   (ptr_lo),Y
0007AAr 2  AA                 TAX                         ; X = name length
0007ABr 2  A0 04              LDY   #TOK_PAYLOAD+1
0007ADr 2               @vr_name:
0007ADr 2  B1 rr              LDA   (ptr_lo),Y
0007AFr 2  8D 0E A0           STA   VGC_CHAROUT
0007B2r 2  C8                 INY
0007B3r 2  CA                 DEX
0007B4r 2  D0 F7              BNE   @vr_name
0007B6r 2  A2 00              LDX   #0
0007B8r 2               @vr_msg:
0007B8r 2  BD rr rr           LDA   str_no_value,X
0007BBr 2  F0 06              BEQ   @vr_done
0007BDr 2  8D 0E A0           STA   VGC_CHAROUT
0007C0r 2  E8                 INX
0007C1r 2  D0 F5              BNE   @vr_msg
0007C3r 2               @vr_done:
0007C3r 2  20 rr rr           JSR   eval_newline
0007C6r 2  20 rr rr           JSR   try_throw_error
0007C9r 2  20 rr rr           JSR   eval_advance
0007CCr 2  38                 SEC
0007CDr 2  60                 RTS
0007CEr 2               
0007CEr 2               @var_ok:
0007CEr 2                     ; eval_type and eval_val already set by var_get
0007CEr 2  20 rr rr           JSR   eval_advance
0007D1r 2  4C rr rr           JMP   eval_check_infix      ; allow :X + 5 etc.
0007D4r 2               
0007D4r 2               ; ---------------------------------------------------------------------
0007D4r 2               ; eval_newline — print CR+LF
0007D4r 2               ; ---------------------------------------------------------------------
0007D4r 2               eval_newline:
0007D4r 2  A9 0D              LDA   #$0D
0007D6r 2  8D 0E A0           STA   VGC_CHAROUT
0007D9r 2  A9 0A              LDA   #$0A
0007DBr 2  8D 0E A0           STA   VGC_CHAROUT
0007DEr 2  60                 RTS
0007DFr 2               
0007DFr 2               ; ---------------------------------------------------------------------
0007DFr 2               ; eval_check_infix — if next token is TOK_INFIX, evaluate binary op
0007DFr 2               ;   Entry: eval_val holds the left operand (primary value)
0007DFr 2               ;   Exit:  eval_val holds the result, carry clear = success
0007DFr 2               ; ---------------------------------------------------------------------
0007DFr 2               eval_check_infix:
0007DFr 2                     ; Is there a next token?
0007DFr 2  A5 rr              LDA   eval_cur_lo
0007E1r 2  05 rr              ORA   eval_cur_hi
0007E3r 2  F0 75              BEQ   @no_infix
0007E5r 2               
0007E5r 2                     ; Peek at the next token's tag
0007E5r 2  A5 rr              LDA   eval_cur_lo
0007E7r 2  85 rr              STA   ptr_lo
0007E9r 2  A5 rr              LDA   eval_cur_hi
0007EBr 2  85 rr              STA   ptr_hi
0007EDr 2  A0 00              LDY   #TOK_TAG
0007EFr 2  B1 rr              LDA   (ptr_lo),Y
0007F1r 2  C9 07              CMP   #TOK_INFIX
0007F3r 2  D0 65              BNE   @no_infix
0007F5r 2               
0007F5r 2                     ; Save the left operand to ZP scratch
0007F5r 2  A5 rr              LDA   eval_val_hi
0007F7r 2  85 rr              STA   eval_left_hi
0007F9r 2  A5 rr              LDA   eval_val_lo
0007FBr 2  85 rr              STA   eval_left_lo
0007FDr 2  A5 rr              LDA   eval_val_frac
0007FFr 2  85 rr              STA   eval_left_frac
000801r 2               
000801r 2                     ; Read operator character from payload
000801r 2  A0 03              LDY   #TOK_PAYLOAD
000803r 2  B1 rr              LDA   (ptr_lo),Y
000805r 2  85 rr              STA   eval_op
000807r 2               
000807r 2                     ; Advance past the infix token
000807r 2  20 rr rr           JSR   eval_advance
00080Ar 2               
00080Ar 2                     ; Push left operand and operator onto hardware stack so recursive
00080Ar 2                     ; proc_invoke calls (which may evaluate their own infix expressions)
00080Ar 2                     ; cannot clobber them.
00080Ar 2  A5 rr              LDA   eval_left_hi
00080Cr 2  48                 PHA
00080Dr 2  A5 rr              LDA   eval_left_lo
00080Fr 2  48                 PHA
000810r 2  A5 rr              LDA   eval_left_frac
000812r 2  48                 PHA
000813r 2  A5 rr              LDA   eval_op
000815r 2  48                 PHA
000816r 2               
000816r 2                     ; Evaluate the right operand (recursive call)
000816r 2  20 rr rr           JSR   eval_expr
000819r 2  B0 41              BCS   @err_rhs_pop
00081Br 2               
00081Br 2                     ; Restore left operand and operator from stack
00081Br 2  68                 PLA
00081Cr 2  85 rr              STA   eval_op
00081Er 2  68                 PLA
00081Fr 2  85 rr              STA   eval_left_frac
000821r 2  68                 PLA
000822r 2  85 rr              STA   eval_left_lo
000824r 2  68                 PLA
000825r 2  85 rr              STA   eval_left_hi
000827r 2               
000827r 2                     ; Dispatch based on operator character
000827r 2  A5 rr              LDA   eval_op
000829r 2  C9 2B              CMP   #'+'
00082Br 2  F0 35              BEQ   @do_add
00082Dr 2  C9 2D              CMP   #'-'
00082Fr 2  F0 46              BEQ   @do_sub
000831r 2  C9 2A              CMP   #'*'
000833r 2  F0 57              BEQ   @do_mul
000835r 2  C9 2F              CMP   #'/'
000837r 2  F0 75              BEQ   @do_div
000839r 2  C9 3E              CMP   #'>'
00083Br 2  D0 03              BNE   :+
00083Dr 2  4C rr rr           JMP   @do_gt
000840r 2  C9 3C        :     CMP   #'<'
000842r 2  D0 03              BNE   :+
000844r 2  4C rr rr           JMP   @do_lt
000847r 2  C9 3D        :     CMP   #'='
000849r 2  D0 03              BNE   :+
00084Br 2  4C rr rr           JMP   @do_eq
00084Er 2               :
00084Er 2                     ; Unknown operator — return left value unchanged
00084Er 2  A5 rr              LDA   eval_left_hi
000850r 2  85 rr              STA   eval_val_hi
000852r 2  A5 rr              LDA   eval_left_lo
000854r 2  85 rr              STA   eval_val_lo
000856r 2  A5 rr              LDA   eval_left_frac
000858r 2  85 rr              STA   eval_val_frac
00085Ar 2               
00085Ar 2               @no_infix:
00085Ar 2  18                 CLC
00085Br 2  60                 RTS
00085Cr 2               
00085Cr 2               @err_rhs_pop:
00085Cr 2                     ; Discard saved left operand + operator (4 bytes)
00085Cr 2  68                 PLA
00085Dr 2  68                 PLA
00085Er 2  68                 PLA
00085Fr 2  68                 PLA
000860r 2               @err_rhs:
000860r 2  38                 SEC
000861r 2  60                 RTS
000862r 2               
000862r 2                     ; ----- Addition: left + right (24-bit: frac, lo, hi) -----
000862r 2               @do_add:
000862r 2  18                 CLC
000863r 2  A5 rr              LDA   eval_left_frac
000865r 2  65 rr              ADC   eval_val_frac
000867r 2  85 rr              STA   eval_val_frac
000869r 2  A5 rr              LDA   eval_left_lo
00086Br 2  65 rr              ADC   eval_val_lo
00086Dr 2  85 rr              STA   eval_val_lo
00086Fr 2  A5 rr              LDA   eval_left_hi
000871r 2  65 rr              ADC   eval_val_hi
000873r 2  85 rr              STA   eval_val_hi
000875r 2  18                 CLC
000876r 2  60                 RTS
000877r 2               
000877r 2                     ; ----- Subtraction: left - right (24-bit) -----
000877r 2               @do_sub:
000877r 2  38                 SEC
000878r 2  A5 rr              LDA   eval_left_frac
00087Ar 2  E5 rr              SBC   eval_val_frac
00087Cr 2  85 rr              STA   eval_val_frac
00087Er 2  A5 rr              LDA   eval_left_lo
000880r 2  E5 rr              SBC   eval_val_lo
000882r 2  85 rr              STA   eval_val_lo
000884r 2  A5 rr              LDA   eval_left_hi
000886r 2  E5 rr              SBC   eval_val_hi
000888r 2  85 rr              STA   eval_val_hi
00088Ar 2  18                 CLC
00088Br 2  60                 RTS
00088Cr 2               
00088Cr 2                     ; ----- Multiplication: left * right via coprocessor -----
00088Cr 2                     ; Integer-only for this pass (frac ignored)
00088Cr 2               @do_mul:
00088Cr 2  A5 rr              LDA   eval_left_lo
00088Er 2  8D 20 BB           STA   MATH_MUL16_A_LO
000891r 2  A5 rr              LDA   eval_left_hi
000893r 2  8D 21 BB           STA   MATH_MUL16_A_HI
000896r 2  A5 rr              LDA   eval_val_lo
000898r 2  8D 22 BB           STA   MATH_MUL16_B_LO
00089Br 2  A5 rr              LDA   eval_val_hi
00089Dr 2  8D 23 BB           STA   MATH_MUL16_B_HI     ; write triggers multiply
0008A0r 2  AD 38 BB           LDA   MATH_RES0
0008A3r 2  85 rr              STA   eval_val_lo
0008A5r 2  AD 39 BB           LDA   MATH_RES1
0008A8r 2  85 rr              STA   eval_val_hi
0008AAr 2  64 rr              STZ   eval_val_frac
0008ACr 2  18                 CLC
0008ADr 2  60                 RTS
0008AEr 2               
0008AEr 2                     ; ----- Division: left / right via coprocessor -----
0008AEr 2                     ; Signed 32÷16: dividend = sign-extended left integer, divisor = right integer
0008AEr 2               @do_div:
0008AEr 2                     ; Check for divide by zero
0008AEr 2  A5 rr              LDA   eval_val_lo
0008B0r 2  05 rr              ORA   eval_val_hi
0008B2r 2  D0 08              BNE   @div_ok
0008B4r 2                     ; Division by zero — return 0
0008B4r 2  64 rr              STZ   eval_val_frac
0008B6r 2  64 rr              STZ   eval_val_lo
0008B8r 2  64 rr              STZ   eval_val_hi
0008BAr 2  18                 CLC
0008BBr 2  60                 RTS
0008BCr 2               @div_ok:
0008BCr 2                     ; Write 32-bit dividend (sign-extend left integer to 32 bits)
0008BCr 2  A5 rr              LDA   eval_left_lo
0008BEr 2  8D 28 BB           STA   MATH_DIV_N_LO
0008C1r 2  A5 rr              LDA   eval_left_hi
0008C3r 2  8D 29 BB           STA   MATH_DIV_N_1
0008C6r 2                     ; Sign-extend high word
0008C6r 2  A5 rr              LDA   eval_left_hi
0008C8r 2  09 7F              ORA   #$7F                 ; set bits 0-6
0008CAr 2  30 04              BMI   @neg_ext             ; if bit 7 was set, A=$FF (negative)
0008CCr 2  A9 00              LDA   #$00                 ; positive: extend with $00
0008CEr 2  80 00              BRA   @write_ext
0008D0r 2               @neg_ext:                        ; A is already $FF
0008D0r 2               @write_ext:
0008D0r 2  8D 2A BB           STA   MATH_DIV_N_2
0008D3r 2  8D 2B BB           STA   MATH_DIV_N_HI
0008D6r 2                     ; Write 16-bit divisor (right operand integer)
0008D6r 2  A5 rr              LDA   eval_val_lo
0008D8r 2  8D 2C BB           STA   MATH_DIV_D_LO
0008DBr 2  A5 rr              LDA   eval_val_hi
0008DDr 2  8D 2D BB           STA   MATH_DIV_D_HI       ; write triggers divide
0008E0r 2                     ; Read quotient from result
0008E0r 2  AD 38 BB           LDA   MATH_RES0
0008E3r 2  85 rr              STA   eval_val_lo
0008E5r 2  AD 39 BB           LDA   MATH_RES1
0008E8r 2  85 rr              STA   eval_val_hi
0008EAr 2  64 rr              STZ   eval_val_frac
0008ECr 2  18                 CLC
0008EDr 2  60                 RTS
0008EEr 2               
0008EEr 2                     ; ----- Equality: left = right (all 3 bytes must match) -----
0008EEr 2               @do_eq:
0008EEr 2  A5 rr              LDA   eval_left_hi
0008F0r 2  C5 rr              CMP   eval_val_hi
0008F2r 2  D0 64              BNE   @set_false
0008F4r 2  A5 rr              LDA   eval_left_lo
0008F6r 2  C5 rr              CMP   eval_val_lo
0008F8r 2  D0 5E              BNE   @set_false
0008FAr 2  A5 rr              LDA   eval_left_frac
0008FCr 2  C5 rr              CMP   eval_val_frac
0008FEr 2  D0 58              BNE   @set_false
000900r 2  80 4A              BRA   @set_true
000902r 2               
000902r 2                     ; ----- Greater than: left > right (signed 24-bit) -----
000902r 2               @do_gt:
000902r 2                     ; Compare hi bytes (signed)
000902r 2  A5 rr              LDA   eval_left_hi
000904r 2  38                 SEC
000905r 2  E5 rr              SBC   eval_val_hi
000907r 2  50 02              BVC   @gt_sign_ok           ; no overflow — N flag valid
000909r 2  49 80              EOR   #$80                  ; overflow — invert N to get true sign
00090Br 2               @gt_sign_ok:
00090Br 2  30 4B              BMI   @set_false            ; left_hi < right_hi → false
00090Dr 2                     ; If the subtraction was nonzero and positive, left > right
00090Dr 2  A5 rr              LDA   eval_left_hi
00090Fr 2  C5 rr              CMP   eval_val_hi
000911r 2  D0 39              BNE   @set_true             ; hi bytes differ, and left > right
000913r 2                     ; Hi bytes equal — compare lo bytes (unsigned)
000913r 2  A5 rr              LDA   eval_left_lo
000915r 2  C5 rr              CMP   eval_val_lo
000917r 2  D0 0A              BNE   @gt_lo_diff
000919r 2                     ; Lo bytes equal — compare frac bytes (unsigned)
000919r 2  A5 rr              LDA   eval_left_frac
00091Br 2  C5 rr              CMP   eval_val_frac
00091Dr 2  F0 39              BEQ   @set_false            ; all equal → not greater
00091Fr 2  B0 2B              BCS   @set_true
000921r 2  80 35              BRA   @set_false
000923r 2               @gt_lo_diff:
000923r 2  B0 27              BCS   @set_true
000925r 2  80 31              BRA   @set_false
000927r 2               
000927r 2                     ; ----- Less than: left < right (signed 24-bit) -----
000927r 2               @do_lt:
000927r 2                     ; Compare hi bytes (signed)
000927r 2  A5 rr              LDA   eval_left_hi
000929r 2  38                 SEC
00092Ar 2  E5 rr              SBC   eval_val_hi
00092Cr 2  50 02              BVC   @lt_sign_ok
00092Er 2  49 80              EOR   #$80
000930r 2               @lt_sign_ok:
000930r 2  30 1A              BMI   @set_true             ; left_hi < right_hi → true
000932r 2  A5 rr              LDA   eval_left_hi
000934r 2  C5 rr              CMP   eval_val_hi
000936r 2  D0 20              BNE   @set_false            ; left_hi > right_hi → false
000938r 2                     ; Hi bytes equal — compare lo bytes (unsigned)
000938r 2  A5 rr              LDA   eval_left_lo
00093Ar 2  C5 rr              CMP   eval_val_lo
00093Cr 2  D0 0A              BNE   @lt_lo_diff
00093Er 2                     ; Lo bytes equal — compare frac (unsigned)
00093Er 2  A5 rr              LDA   eval_left_frac
000940r 2  C5 rr              CMP   eval_val_frac
000942r 2  F0 14              BEQ   @set_false            ; equal → not less
000944r 2  90 06              BCC   @set_true
000946r 2  80 10              BRA   @set_false
000948r 2               @lt_lo_diff:
000948r 2  90 02              BCC   @set_true
00094Ar 2  80 0C              BRA   @set_false
00094Cr 2               
00094Cr 2                     ; ----- Set result to TRUE (1) or FALSE (0) -----
00094Cr 2               @set_true:
00094Cr 2  64 rr              STZ   eval_val_hi
00094Er 2  A9 01              LDA   #1
000950r 2  85 rr              STA   eval_val_lo
000952r 2  64 rr              STZ   eval_val_frac
000954r 2  64 rr              STZ   eval_type
000956r 2  18                 CLC
000957r 2  60                 RTS
000958r 2               
000958r 2               @set_false:
000958r 2  64 rr              STZ   eval_val_hi
00095Ar 2  64 rr              STZ   eval_val_lo
00095Cr 2  64 rr              STZ   eval_val_frac
00095Er 2  64 rr              STZ   eval_type
000960r 2  18                 CLC
000961r 2  60                 RTS
000962r 2               
000962r 2               ; ---------------------------------------------------------------------
000962r 2               ; print_number — print eval_val as a signed decimal number
000962r 2               ;   Input: eval_val_hi/lo/frac (16.8 fixed-point, signed)
000962r 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
000962r 2               ; ---------------------------------------------------------------------
000962r 2               print_number:
000962r 2                     ; Check sign — if negative, print '-' and negate
000962r 2  A5 rr              LDA   eval_val_hi
000964r 2  10 1E              BPL   @positive
000966r 2                     ; Print minus sign
000966r 2  A9 2D              LDA   #'-'
000968r 2  8D 0E A0           STA   VGC_CHAROUT
00096Br 2                     ; Negate 3-byte value (two's complement)
00096Br 2  A5 rr              LDA   eval_val_frac
00096Dr 2  49 FF              EOR   #$FF
00096Fr 2  18                 CLC
000970r 2  69 01              ADC   #1
000972r 2  85 rr              STA   eval_val_frac
000974r 2  A5 rr              LDA   eval_val_lo
000976r 2  49 FF              EOR   #$FF
000978r 2  69 00              ADC   #0
00097Ar 2  85 rr              STA   eval_val_lo
00097Cr 2  A5 rr              LDA   eval_val_hi
00097Er 2  49 FF              EOR   #$FF
000980r 2  69 00              ADC   #0
000982r 2  85 rr              STA   eval_val_hi
000984r 2               
000984r 2               @positive:
000984r 2                     ; Print integer part (eval_val_hi:eval_val_lo as 16-bit unsigned)
000984r 2  20 rr rr           JSR   print_uint16
000987r 2               
000987r 2                     ; Print fractional part if non-zero
000987r 2  A5 rr              LDA   eval_val_frac
000989r 2  D0 01              BNE   @has_frac
00098Br 2  60                 RTS
00098Cr 2               @has_frac:
00098Cr 2               
00098Cr 2                     ; Print decimal point
00098Cr 2  A9 2E              LDA   #'.'
00098Er 2  8D 0E A0           STA   VGC_CHAROUT
000991r 2               
000991r 2                     ; Convert frac byte to decimal digits
000991r 2                     ; frac * 10 / 256 = first digit, repeat with remainder
000991r 2  A5 rr              LDA   eval_val_frac
000993r 2  8D rr rr           STA   num_tmp_lo
000996r 2  9C rr rr           STZ   num_tmp_hi
000999r 2               
000999r 2                     ; First digit: (frac * 10) >> 8
000999r 2                     ; frac * 10 = (frac * 8) + (frac * 2)
000999r 2  AD rr rr           LDA   num_tmp_lo
00099Cr 2  0A                 ASL
00099Dr 2  8D rr rr           STA   num_val_lo          ; frac * 2
0009A0r 2  AD rr rr           LDA   num_tmp_hi
0009A3r 2  2A                 ROL
0009A4r 2  8D rr rr           STA   num_val_hi
0009A7r 2               
0009A7r 2  0E rr rr           ASL   num_val_lo
0009AAr 2  2E rr rr           ROL   num_val_hi
0009ADr 2  0E rr rr           ASL   num_val_lo
0009B0r 2  2E rr rr           ROL   num_val_hi          ; frac * 8
0009B3r 2               
0009B3r 2  18                 CLC
0009B4r 2  AD rr rr           LDA   num_tmp_lo
0009B7r 2  0A                 ASL                       ; frac * 2 (low byte)
0009B8r 2  6D rr rr           ADC   num_val_lo
0009BBr 2  8D rr rr           STA   num_val_lo
0009BEr 2  AD rr rr           LDA   num_tmp_hi
0009C1r 2  2A                 ROL
0009C2r 2  6D rr rr           ADC   num_val_hi
0009C5r 2  8D rr rr           STA   num_val_hi          ; num_val = frac * 10
0009C8r 2               
0009C8r 2                     ; High byte = first decimal digit
0009C8r 2  AD rr rr           LDA   num_val_hi
0009CBr 2  09 30              ORA   #'0'
0009CDr 2  8D 0E A0           STA   VGC_CHAROUT
0009D0r 2               
0009D0r 2                     ; Remainder = low byte → second digit
0009D0r 2  AD rr rr           LDA   num_val_lo
0009D3r 2  8D rr rr           STA   num_tmp_lo
0009D6r 2  9C rr rr           STZ   num_tmp_hi
0009D9r 2               
0009D9r 2                     ; Second digit: (remainder * 10) >> 8
0009D9r 2  AD rr rr           LDA   num_tmp_lo
0009DCr 2  0A                 ASL
0009DDr 2  8D rr rr           STA   num_val_lo
0009E0r 2  AD rr rr           LDA   num_tmp_hi
0009E3r 2  2A                 ROL
0009E4r 2  8D rr rr           STA   num_val_hi
0009E7r 2               
0009E7r 2  0E rr rr           ASL   num_val_lo
0009EAr 2  2E rr rr           ROL   num_val_hi
0009EDr 2  0E rr rr           ASL   num_val_lo
0009F0r 2  2E rr rr           ROL   num_val_hi
0009F3r 2               
0009F3r 2  18                 CLC
0009F4r 2  AD rr rr           LDA   num_tmp_lo
0009F7r 2  0A                 ASL
0009F8r 2  6D rr rr           ADC   num_val_lo
0009FBr 2  8D rr rr           STA   num_val_lo
0009FEr 2  AD rr rr           LDA   num_tmp_hi
000A01r 2  2A                 ROL
000A02r 2  6D rr rr           ADC   num_val_hi
000A05r 2  8D rr rr           STA   num_val_hi
000A08r 2               
000A08r 2                     ; High byte = second digit; skip if zero (trailing)
000A08r 2  AD rr rr           LDA   num_val_hi
000A0Br 2  F0 05              BEQ   @done
000A0Dr 2  09 30              ORA   #'0'
000A0Fr 2  8D 0E A0           STA   VGC_CHAROUT
000A12r 2               
000A12r 2               @done:
000A12r 2  60                 RTS
000A13r 2               
000A13r 2               ; ---------------------------------------------------------------------
000A13r 2               ; print_uint16 — print eval_val_hi:eval_val_lo as unsigned decimal
000A13r 2               ;   No leading zeros (except value 0 prints "0")
000A13r 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
000A13r 2               ; ---------------------------------------------------------------------
000A13r 2               print_uint16:
000A13r 2                     ; Copy to working regs
000A13r 2  A5 rr              LDA   eval_val_lo
000A15r 2  8D rr rr           STA   num_val_lo
000A18r 2  A5 rr              LDA   eval_val_hi
000A1Ar 2  8D rr rr           STA   num_val_hi
000A1Dr 2               
000A1Dr 2  A2 00              LDX   #0                  ; digit buffer index
000A1Fr 2  A0 00              LDY   #0                  ; power-of-10 table index
000A21r 2               
000A21r 2               @div_loop:
000A21r 2  9C rr rr           STZ   num_tmp_lo          ; digit counter for this power
000A24r 2               @sub_loop:
000A24r 2                     ; Subtract current power of 10
000A24r 2  38                 SEC
000A25r 2  AD rr rr           LDA   num_val_lo
000A28r 2  F9 rr rr           SBC   pow10_lo,Y
000A2Br 2  48                 PHA
000A2Cr 2  AD rr rr           LDA   num_val_hi
000A2Fr 2  F9 rr rr           SBC   pow10_hi,Y
000A32r 2  90 0C              BCC   @sub_done           ; underflow — done with this digit
000A34r 2  8D rr rr           STA   num_val_hi
000A37r 2  68                 PLA
000A38r 2  8D rr rr           STA   num_val_lo
000A3Br 2  EE rr rr           INC   num_tmp_lo
000A3Er 2  80 E4              BRA   @sub_loop
000A40r 2               @sub_done:
000A40r 2  68                 PLA                       ; discard low byte from failed subtract
000A41r 2  AD rr rr           LDA   num_tmp_lo
000A44r 2  9D rr rr           STA   pn_buf,X
000A47r 2  E8                 INX
000A48r 2  C8                 INY
000A49r 2  C0 05              CPY   #5                  ; 5 powers (10000,1000,100,10,1)
000A4Br 2  90 D4              BCC   @div_loop
000A4Dr 2               
000A4Dr 2                     ; Print digits, suppressing leading zeros
000A4Dr 2  A0 00              LDY   #0                  ; suppress flag (0=suppress)
000A4Fr 2  A2 00              LDX   #0
000A51r 2               @print_loop:
000A51r 2  BD rr rr           LDA   pn_buf,X
000A54r 2  D0 04              BNE   @nonzero
000A56r 2  C0 00              CPY   #0
000A58r 2  F0 07              BEQ   @maybe_skip        ; still suppressing
000A5Ar 2               @nonzero:
000A5Ar 2  A0 01              LDY   #1                  ; seen nonzero digit
000A5Cr 2  09 30              ORA   #'0'
000A5Er 2  8D 0E A0           STA   VGC_CHAROUT
000A61r 2               @maybe_skip:
000A61r 2  E8                 INX
000A62r 2  E0 04              CPX   #4
000A64r 2  90 EB              BCC   @print_loop
000A66r 2                     ; Always print the last digit (ones place)
000A66r 2  AD rr rr           LDA   pn_buf+4
000A69r 2  09 30              ORA   #'0'
000A6Br 2  8D 0E A0           STA   VGC_CHAROUT
000A6Er 2  60                 RTS
000A6Fr 2               
000A6Fr 2               ; ---------------------------------------------------------------------
000A6Fr 2               ; try_throw_error — if a CATCH with tag "ERROR" is active, unwind to it
000A6Fr 2               ;   Called after error messages are printed. If no catch is active or
000A6Fr 2               ;   the tag doesn't match "ERROR", this is a no-op (returns normally).
000A6Fr 2               ;   If a match is found, this NEVER RETURNS — it unwinds the stack
000A6Fr 2               ;   via TXS and jumps to the catch resume point.
000A6Fr 2               ; ---------------------------------------------------------------------
000A6Fr 2               try_throw_error:
000A6Fr 2  A5 rr              LDA   catch_active
000A71r 2  F0 3A              BEQ   @no_catch
000A73r 2               
000A73r 2                     ; Compare catch_tag against "ERROR" (5 chars, uppercased)
000A73r 2  A5 rr              LDA   catch_tag_lo
000A75r 2  85 rr              STA   ptr2_lo
000A77r 2  A5 rr              LDA   catch_tag_hi
000A79r 2  85 rr              STA   ptr2_hi
000A7Br 2  A9 rr              LDA   #<str_error_tag
000A7Dr 2  85 rr              STA   ptr_lo
000A7Fr 2  A9 rr              LDA   #>str_error_tag
000A81r 2  85 rr              STA   ptr_hi
000A83r 2  20 rr rr           JSR   catch_tags_equal
000A86r 2  90 25              BCC   @no_catch
000A88r 2               
000A88r 2                     ; Match! Unwind stack to catch point and resume.
000A88r 2  A6 rr              LDX   catch_sp
000A8Ar 2  9A                 TXS
000A8Br 2               
000A8Br 2                     ; Restore previous catch frame from the restored stack
000A8Br 2  68                 PLA
000A8Cr 2  85 rr              STA   catch_resume_hi
000A8Er 2  68                 PLA
000A8Fr 2  85 rr              STA   catch_resume_lo
000A91r 2  68                 PLA
000A92r 2  85 rr              STA   catch_sp
000A94r 2  68                 PLA
000A95r 2  85 rr              STA   catch_tag_hi
000A97r 2  68                 PLA
000A98r 2  85 rr              STA   catch_tag_lo
000A9Ar 2  68                 PLA
000A9Br 2  85 rr              STA   catch_active
000A9Dr 2               
000A9Dr 2                     ; Restore eval_in_body and discard saved tag pointer (3 bytes)
000A9Dr 2  68                 PLA
000A9Er 2  85 rr              STA   eval_in_body
000AA0r 2  68                 PLA                         ; tag_hi
000AA1r 2  68                 PLA                         ; tag_lo
000AA2r 2               
000AA2r 2                     ; Set eval_cur to resume point (past the caught body)
000AA2r 2  A5 rr              LDA   catch_resume_lo
000AA4r 2  85 rr              STA   eval_cur_lo
000AA6r 2  A5 rr              LDA   catch_resume_hi
000AA8r 2  85 rr              STA   eval_cur_hi
000AAAr 2               
000AAAr 2  4C rr rr           JMP   eval_continue
000AADr 2               
000AADr 2               @no_catch:
000AADr 2  60                 RTS
000AAEr 2               
000AAEr 2               ; ---------------------------------------------------------------------
000AAEr 2               ; catch_tags_equal — compare two length-prefixed strings (case-insensitive)
000AAEr 2               ;   Input: ptr_lo/hi = string A, ptr2_lo/hi = string B
000AAEr 2               ;   Output: carry set = equal, carry clear = not equal
000AAEr 2               ;   Clobbers: A, X, Y
000AAEr 2               ; ---------------------------------------------------------------------
000AAEr 2               catch_tags_equal:
000AAEr 2  A0 00              LDY   #0
000AB0r 2  B1 rr              LDA   (ptr_lo),Y           ; length of A
000AB2r 2  8D rr rr           STA   num_tmp_lo            ; temp: len A
000AB5r 2  B1 rr              LDA   (ptr2_lo),Y          ; length of B
000AB7r 2  CD rr rr           CMP   num_tmp_lo
000ABAr 2  D0 2D              BNE   @ne
000ABCr 2               
000ABCr 2                     ; Lengths match — compare chars
000ABCr 2  AA                 TAX                         ; X = length
000ABDr 2  F0 28              BEQ   @eq                   ; both zero = equal
000ABFr 2  A0 01              LDY   #1
000AC1r 2               @cmp:
000AC1r 2  B1 rr              LDA   (ptr_lo),Y
000AC3r 2                     ; Uppercase A char
000AC3r 2  C9 61              CMP   #'a'
000AC5r 2  90 07              BCC   @a_up
000AC7r 2  C9 7B              CMP   #'z'+1
000AC9r 2  B0 03              BCS   @a_up
000ACBr 2  38                 SEC
000ACCr 2  E9 20              SBC   #$20
000ACEr 2               @a_up:
000ACEr 2  8D rr rr           STA   num_tmp_lo            ; uppercased A char
000AD1r 2               
000AD1r 2  B1 rr              LDA   (ptr2_lo),Y
000AD3r 2                     ; Uppercase B char
000AD3r 2  C9 61              CMP   #'a'
000AD5r 2  90 07              BCC   @b_up
000AD7r 2  C9 7B              CMP   #'z'+1
000AD9r 2  B0 03              BCS   @b_up
000ADBr 2  38                 SEC
000ADCr 2  E9 20              SBC   #$20
000ADEr 2               @b_up:
000ADEr 2  CD rr rr           CMP   num_tmp_lo
000AE1r 2  D0 06              BNE   @ne
000AE3r 2  C8                 INY
000AE4r 2  CA                 DEX
000AE5r 2  D0 DA              BNE   @cmp
000AE7r 2               
000AE7r 2               @eq:
000AE7r 2  38                 SEC
000AE8r 2  60                 RTS
000AE9r 2               @ne:
000AE9r 2  18                 CLC
000AEAr 2  60                 RTS
000AEBr 2               
000AEBr 2               ; =====================================================================
000AEBr 2               ; RODATA — evaluator strings and tables
000AEBr 2               ; =====================================================================
000AEBr 2               ; ---------------------------------------------------------------------
000AEBr 2               ; lookup_ext_cmd — search ext_cmd_table for the current TOK_WORD
000AEBr 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000AEBr 2               ;   Output: Carry clear = found, A = arity, EXT_CMD set
000AEBr 2               ;           Carry set = not found
000AEBr 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000AEBr 2               ; ---------------------------------------------------------------------
000AEBr 2               lookup_ext_cmd:
000AEBr 2                     ; Save table pointer in num_tmp_lo/hi
000AEBr 2  A9 rr              LDA   #<ext_cmd_table
000AEDr 2  8D rr rr           STA   num_tmp_lo
000AF0r 2  A9 rr              LDA   #>ext_cmd_table
000AF2r 2  8D rr rr           STA   num_tmp_hi
000AF5r 2               
000AF5r 2               @scan:
000AF5r 2                     ; Read name pointer from table
000AF5r 2  AD rr rr           LDA   num_tmp_lo
000AF8r 2  85 rr              STA   ptr2_lo
000AFAr 2  AD rr rr           LDA   num_tmp_hi
000AFDr 2  85 rr              STA   ptr2_hi
000AFFr 2  A0 00              LDY   #0
000B01r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000B03r 2  AA                 TAX
000B04r 2  C8                 INY
000B05r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000B07r 2  D0 06              BNE   @have_entry
000B09r 2  E0 00              CPX   #0
000B0Br 2  D0 02              BNE   @have_entry
000B0Dr 2                     ; Null pointer — end of table
000B0Dr 2  38                 SEC
000B0Er 2  60                 RTS
000B0Fr 2               
000B0Fr 2               @have_entry:
000B0Fr 2                     ; X = name_ptr_lo, A = name_ptr_hi
000B0Fr 2  85 rr              STA   ptr2_hi
000B11r 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000B13r 2               
000B13r 2                     ; Get token payload pointer
000B13r 2  A5 rr              LDA   eval_cur_lo
000B15r 2  85 rr              STA   ptr_lo
000B17r 2  A5 rr              LDA   eval_cur_hi
000B19r 2  85 rr              STA   ptr_hi
000B1Br 2               
000B1Br 2                     ; Compare length bytes
000B1Br 2  A0 00              LDY   #0
000B1Dr 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000B1Fr 2  A0 03              LDY   #TOK_PAYLOAD
000B21r 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000B23r 2  D0 30              BNE   @next
000B25r 2               
000B25r 2                     ; Lengths match — compare chars
000B25r 2  AA                 TAX                       ; X = length
000B26r 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000B28r 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000B2Ar 2               @cmp_loop:
000B2Ar 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000B2Cr 2  5A                 PHY
000B2Dr 2  A5 rr              LDA   tok_sign
000B2Fr 2  18                 CLC
000B30r 2  69 04              ADC   #TOK_PAYLOAD+1
000B32r 2  A8                 TAY
000B33r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000B35r 2  7A                 PLY
000B36r 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000B38r 2  D0 1B              BNE   @next
000B3Ar 2  C8                 INY
000B3Br 2  E6 rr              INC   tok_sign
000B3Dr 2  CA                 DEX
000B3Er 2  D0 EA              BNE   @cmp_loop
000B40r 2               
000B40r 2                     ; Match found — read cmd_id and arity
000B40r 2                     ; Table entry: name_ptr(2) + cmd_id(1) + arity(1)
000B40r 2  AD rr rr           LDA   num_tmp_lo
000B43r 2  85 rr              STA   ptr_lo
000B45r 2  AD rr rr           LDA   num_tmp_hi
000B48r 2  85 rr              STA   ptr_hi
000B4Ar 2  A0 02              LDY   #2
000B4Cr 2  B1 rr              LDA   (ptr_lo),Y         ; cmd_id
000B4Er 2  85 80              STA   EXT_CMD
000B50r 2  C8                 INY
000B51r 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000B53r 2  18                 CLC                       ; found
000B54r 2  60                 RTS
000B55r 2               
000B55r 2               @next:
000B55r 2  64 rr              STZ   tok_sign
000B57r 2                     ; Advance to next entry: +4 bytes (2 name + 1 cmd_id + 1 arity)
000B57r 2  18                 CLC
000B58r 2  AD rr rr           LDA   num_tmp_lo
000B5Br 2  69 04              ADC   #4
000B5Dr 2  8D rr rr           STA   num_tmp_lo
000B60r 2  90 03              BCC   :+
000B62r 2  EE rr rr           INC   num_tmp_hi
000B65r 2               :
000B65r 2  4C rr rr           JMP   @scan
000B68r 2               
000B68r 2               ; ---------------------------------------------------------------------
000B68r 2               ; ext_eval_args — evaluate X arguments and copy to EXT_ARG0..2 slots
000B68r 2               ;   Input: X = argument count (0-3)
000B68r 2               ;   Output: Carry clear = success, Carry set = error
000B68r 2               ;           EXT_ARGC set, EXT_ARG0..2 populated
000B68r 2               ;   Clobbers: A, X, Y
000B68r 2               ; ---------------------------------------------------------------------
000B68r 2               ext_eval_args:
000B68r 2  86 81              STX   EXT_ARGC
000B6Ar 2  E0 00              CPX   #0
000B6Cr 2  F0 65              BEQ   @done
000B6Er 2               
000B6Er 2                     ; Evaluate arg 0
000B6Er 2  DA                 PHX
000B6Fr 2  20 rr rr           JSR   eval_expr
000B72r 2  FA                 PLX
000B73r 2  B0 60              BCS   @err
000B75r 2  A5 rr              LDA   eval_type
000B77r 2  85 82              STA   EXT_ARG0_TYPE
000B79r 2  A5 rr              LDA   eval_val_hi
000B7Br 2  85 83              STA   EXT_ARG0_HI
000B7Dr 2  A5 rr              LDA   eval_val_lo
000B7Fr 2  85 84              STA   EXT_ARG0_LO
000B81r 2  A5 rr              LDA   eval_val_frac
000B83r 2  85 85              STA   EXT_ARG0_FRAC
000B85r 2  CA                 DEX
000B86r 2  F0 4B              BEQ   @done
000B88r 2               
000B88r 2                     ; Evaluate arg 1
000B88r 2  DA                 PHX
000B89r 2  20 rr rr           JSR   eval_expr
000B8Cr 2  FA                 PLX
000B8Dr 2  B0 46              BCS   @err
000B8Fr 2  A5 rr              LDA   eval_type
000B91r 2  85 86              STA   EXT_ARG1_TYPE
