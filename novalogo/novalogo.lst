000000r 1                     .include "ext_iface.inc"
000000r 2               ; ext_iface.inc — shared interface between NovaLogo base ROM and extension ROM
000000r 2               ;
000000r 2               ; These equates define the ZP mailbox used to pass arguments and results
000000r 2               ; between the base ROM and the extension ROM via the RAM trampoline.
000000r 2               ; Both ROMs include this file so addresses are always consistent.
000000r 2               ;
000000r 2               ; Addresses $80-$91 are outside the linker-managed ZEROPAGE segment
000000r 2               ; but inside true zero page RAM, accessible to both ROM banks.
000000r 2               
000000r 2               ; --- Command and argument count ---
000000r 2               EXT_CMD         = $80           ; command ID (set by base ROM before trampoline call)
000000r 2               EXT_ARGC        = $81           ; argument count
000000r 2               
000000r 2               ; --- Argument 0 ---
000000r 2               EXT_ARG0_TYPE   = $82           ; type: VAL_NUMBER=$00, VAL_WORD=$01, VAL_LIST=$02
000000r 2               EXT_ARG0_HI     = $83           ; value high byte
000000r 2               EXT_ARG0_LO     = $84           ; value low byte
000000r 2               EXT_ARG0_FRAC   = $85           ; fractional byte (16.8 fixed point)
000000r 2               
000000r 2               ; --- Argument 1 ---
000000r 2               EXT_ARG1_TYPE   = $86
000000r 2               EXT_ARG1_HI     = $87
000000r 2               EXT_ARG1_LO     = $88
000000r 2               EXT_ARG1_FRAC   = $89
000000r 2               
000000r 2               ; --- Argument 2 ---
000000r 2               EXT_ARG2_TYPE   = $8A
000000r 2               EXT_ARG2_HI     = $8B
000000r 2               EXT_ARG2_LO     = $8C
000000r 2               EXT_ARG2_FRAC   = $8D
000000r 2               
000000r 2               ; --- Result ---
000000r 2               EXT_RESULT_TYPE = $8E           ; return value type
000000r 2               EXT_RESULT_HI   = $8F           ; return value high byte
000000r 2               EXT_RESULT_LO   = $90           ; return value low byte
000000r 2               EXT_RESULT_FRAC = $91           ; return value fractional byte
000000r 2               
000000r 2               ; --- Command IDs ---
000000r 2               EXT_CMD_TEST    = $01           ; test command: returns arg0 + 1
000000r 2               EXT_CMD_FD      = $10           ; FD distance — move forward
000000r 2               EXT_CMD_BK      = $11           ; BK distance — move backward
000000r 2               EXT_CMD_RT      = $12           ; RT degrees — turn right
000000r 2               EXT_CMD_LT      = $13           ; LT degrees — turn left
000000r 2               EXT_CMD_CS      = $14           ; CS — clear screen, init turtle
000000r 2               EXT_CMD_PU      = $15           ; PU — pen up
000000r 2               EXT_CMD_PD      = $16           ; PD — pen down
000000r 2               EXT_CMD_ST      = $17           ; ST — show turtle
000000r 2               EXT_CMD_HT      = $18           ; HT — hide turtle
000000r 2               EXT_CMD_HOME    = $19           ; HOME — move to center, heading 0
000000r 2               EXT_CMD_TS      = $1A           ; TEXTSCREEN — full text mode
000000r 2               EXT_CMD_SS      = $1B           ; SPLITSCREEN — copper split
000000r 2               EXT_CMD_FS      = $1C           ; FULLSCREEN — full graphics mode
000000r 2               EXT_CMD_SETXY   = $1D           ; SETXY x y — move to position
000000r 2               EXT_CMD_SETX    = $1E           ; SETX x — set X only
000000r 2               EXT_CMD_SETY    = $1F           ; SETY y — set Y only
000000r 2               EXT_CMD_SETH    = $20           ; SETHEADING — set heading degrees
000000r 2               EXT_CMD_XCOR    = $21           ; XCOR — report turtle X
000000r 2               EXT_CMD_YCOR    = $22           ; YCOR — report turtle Y
000000r 2               EXT_CMD_HEADING = $23           ; HEADING — report heading degrees
000000r 2               EXT_CMD_PENDOWNP = $24          ; PENDOWN? — report pen state
000000r 2               EXT_CMD_SHOWNP  = $25           ; SHOWN? — report visibility
000000r 2               EXT_CMD_SETPC   = $26           ; SETPC color — set pen color
000000r 2               EXT_CMD_SETBG   = $27           ; SETBG color — set background color
000000r 2               EXT_CMD_TOWARDS = $28           ; TOWARDS x y — heading towards point
000000r 2               EXT_CMD_SETPOS  = $29           ; SETPOS [x y] — move to position from list
000000r 2               
000000r 2               ; --- VGC graphics commands ---
000000r 2               EXT_CMD_SETCOLOR = $30          ; SETCOLOR color — set VGC draw color
000000r 2               EXT_CMD_PLOT     = $31          ; PLOT x y — plot pixel
000000r 2               EXT_CMD_UNPLOT   = $32          ; UNPLOT x y — clear pixel
000000r 2               EXT_CMD_LINE     = $33          ; LINE x1 y1 x2 y2 — draw line
000000r 2               EXT_CMD_CIRCLE   = $34          ; CIRCLE x y r — draw circle
000000r 2               EXT_CMD_RECT     = $35          ; RECT x1 y1 x2 y2 — draw rectangle
000000r 2               EXT_CMD_FILLRECT = $36          ; FILL x1 y1 x2 y2 — filled rectangle
000000r 2               EXT_CMD_PAINT    = $37          ; PAINT x y — flood fill
000000r 2               
000000r 2               ; --- Sprite commands ---
000000r 2               EXT_CMD_SPRITE   = $40          ; SPRITE n x y — position and enable
000000r 2               EXT_CMD_SPRITEPOS = $41         ; SPRITEPOS n x y — reposition
000000r 2               EXT_CMD_SPRITEON = $42          ; SPRITEON n — enable sprite
000000r 2               EXT_CMD_SPRITEOFF = $43         ; SPRITEOFF n — disable sprite
000000r 2               EXT_CMD_SPRCOLLP = $44          ; SPRITECOLLISION? n — collision query
000000r 2               
000000r 2               ; --- Sound commands ---
000000r 2               EXT_CMD_TONE     = $45          ; TONE freq dur — play tone
000000r 2               EXT_CMD_NOISE    = $46          ; NOISE dur — noise burst
000000r 2               EXT_CMD_VOLUME   = $47          ; VOLUME vol — set SID master volume
000000r 2               
000000r 2               ; --- Timing commands ---
000000r 2               EXT_CMD_WAIT     = $48          ; WAIT n — wait N frames
000000r 2               EXT_CMD_WAITVBL  = $49          ; WAITVBL — wait for next VBL
000000r 2               EXT_CMD_TIMER    = $4A          ; TIMER — return frame counter
000000r 2               
000000r 2               ; --- Value types (match eval_type in eval.s) ---
000000r 2               .ifndef VAL_NUMBER
000000r 2               VAL_NUMBER      = $00
000000r 2               .endif
000000r 2               .ifndef VAL_WORD
000000r 2               VAL_WORD        = $01
000000r 2               .endif
000000r 2               .ifndef VAL_LIST
000000r 2               VAL_LIST        = $02
000000r 2               .endif
000000r 2               
000000r 2               ; --- Legacy turtle state ZP addresses ---
000000r 2               ; Extension ROMs that define NOVALOGO_TURTLE_STATE_EXTERNAL provide their own
000000r 2               ; persistent turtle storage and only use this file for the mailbox ABI.
000000r 2               .ifndef NOVALOGO_TURTLE_STATE_EXTERNAL
000000r 2               TURTLE_X_FRAC   = $92
000000r 2               TURTLE_X_LO     = $93
000000r 2               TURTLE_X_HI     = $94
000000r 2               TURTLE_Y_FRAC   = $95
000000r 2               TURTLE_Y_LO     = $96
000000r 2               TURTLE_Y_HI     = $97
000000r 2               TURTLE_HEADING_LO = $98
000000r 2               TURTLE_HEADING_HI = $99
000000r 2               TURTLE_PEN      = $9A
000000r 2               TURTLE_SHOWN    = $9B
000000r 2               TURTLE_COLOR    = $9C
000000r 2               TURTLE_SPRITE   = $9D
000000r 2               TURTLE_INITED   = $9E
000000r 2               .endif
000000r 2               
000000r 2               ; --- Argument 3 (for 4+ arg commands like LINE, RECT, FILL) ---
000000r 2               EXT_ARG3_TYPE   = $9F
000000r 2               EXT_ARG3_HI     = $A0
000000r 2               EXT_ARG3_LO     = $A1
000000r 2               EXT_ARG3_FRAC   = $A2
000000r 2               
000000r 2               ; --- Trampoline location in RAM ---
000000r 2               EXT_TRAMPOLINE  = $0270         ; RAM address where trampoline code is copied
000000r 2               EXT_TRAMP_SIZE  = 14            ; size of trampoline code in bytes
000000r 2               
000000r 1                     .include "heap.s"
000000r 2               ; heap.s — bump allocator with GC headers for NovaLogo
000000r 2               ; Heap range: $0400 to HEAP_END-1.
000000r 2               
000000r 2               HEAP_START = $0400
000000r 2               HEAP_END   = $9C00          ; one past last usable byte; $9C00-$9FFF are NDK/extension BSS
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; ZEROPAGE segment — heap and general-purpose pointer variables
000000r 2               ; =====================================================================
000000r 2                     .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        heap_ptr:     .res 2          ; current heap allocation pointer
000002r 2  xx           ptr_lo:       .res 1          ; general-purpose pointer (low byte)
000003r 2  xx           ptr_hi:       .res 1          ; general-purpose pointer (high byte)
000004r 2               
000004r 2               ; =====================================================================
000004r 2               ; BSS segment — heap scratch
000004r 2               ; =====================================================================
000004r 2                     .segment "BSS"
000000r 2               
000000r 2  xx           ha_type:      .res 1          ; saved alloc type for heap_alloc
000001r 2  xx           ha_paysz:     .res 1          ; saved payload size for heap_alloc
000002r 2  xx           ha_gc_ran:    .res 1          ; flag: GC already attempted
000003r 2               
000003r 2               ; =====================================================================
000003r 2               ; CODE segment — heap routines
000003r 2               ; =====================================================================
000003r 2                     .segment "CODE"
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; heap_init — reset heap to empty
000000r 2               ;   Clobbers: A
000000r 2               ; ---------------------------------------------------------------------
000000r 2               heap_init:
000000r 2  A9 00              LDA   #<HEAP_START
000002r 2  85 rr              STA   heap_ptr
000004r 2  A9 04              LDA   #>HEAP_START
000006r 2  85 rr              STA   heap_ptr+1
000008r 2  60                 RTS
000009r 2               
000009r 2               ; ---------------------------------------------------------------------
000009r 2               ; heap_alloc — allocate A bytes with a 2-byte GC header
000009r 2               ;   Input:  A = payload size (bytes the caller wants)
000009r 2               ;           X = allocation type (ATYPE_*)
000009r 2               ;   Output: ptr_lo/ptr_hi = pointer to payload (header is at -2)
000009r 2               ;           Carry clear = success, Carry set = out of memory
000009r 2               ;   Clobbers: A, X, Y
000009r 2               ;
000009r 2               ;   Header layout at (returned_ptr - 2):
000009r 2               ;     +0: alloc_tag  = type (bits 6-0), mark cleared (bit 7 = 0)
000009r 2               ;     +1: alloc_size = payload + 2
000009r 2               ; ---------------------------------------------------------------------
000009r 2               heap_alloc:
000009r 2  8D rr rr           STA   ha_paysz
00000Cr 2  8E rr rr           STX   ha_type
00000Fr 2  9C rr rr           STZ   ha_gc_ran
000012r 2               
000012r 2               @retry:
000012r 2                     ; total = payload + 2
000012r 2  AD rr rr           LDA   ha_paysz
000015r 2  18                 CLC
000016r 2  69 02              ADC   #GC_HDR_BYTES
000018r 2               
000018r 2                     ; Save current heap_ptr → ptr_lo/hi (allocation base)
000018r 2  A6 rr              LDX   heap_ptr
00001Ar 2  86 rr              STX   ptr_lo
00001Cr 2  A6 rr              LDX   heap_ptr+1
00001Er 2  86 rr              STX   ptr_hi
000020r 2               
000020r 2                     ; Advance heap_ptr by total
000020r 2  18                 CLC
000021r 2  65 rr              ADC   heap_ptr
000023r 2  85 rr              STA   heap_ptr
000025r 2  A9 00              LDA   #0
000027r 2  65 rr              ADC   heap_ptr+1
000029r 2  85 rr              STA   heap_ptr+1
00002Br 2               
00002Br 2                     ; Check against HEAP_END
00002Br 2  C9 9C              CMP   #>HEAP_END
00002Dr 2  90 21              BCC   @ok
00002Fr 2  D0 08              BNE   @oom
000031r 2  A5 rr              LDA   heap_ptr
000033r 2  C9 00              CMP   #<HEAP_END
000035r 2  90 19              BCC   @ok
000037r 2  F0 17              BEQ   @ok
000039r 2               
000039r 2               @oom:
000039r 2                     ; Restore heap_ptr
000039r 2  A5 rr              LDA   ptr_lo
00003Br 2  85 rr              STA   heap_ptr
00003Dr 2  A5 rr              LDA   ptr_hi
00003Fr 2  85 rr              STA   heap_ptr+1
000041r 2               
000041r 2                     ; Already tried GC?
000041r 2  AD rr rr           LDA   ha_gc_ran
000044r 2  D0 08              BNE   @fail
000046r 2  EE rr rr           INC   ha_gc_ran
000049r 2               
000049r 2                     ; Run GC and retry
000049r 2  20 rr rr           JSR   gc_collect
00004Cr 2  80 C4              BRA   @retry
00004Er 2               
00004Er 2               @fail:
00004Er 2  38                 SEC
00004Fr 2  60                 RTS
000050r 2               
000050r 2               @ok:
000050r 2                     ; Write header at allocation base (ptr_lo/hi)
000050r 2  A0 00              LDY   #GC_HDR_TAG
000052r 2  AD rr rr           LDA   ha_type
000055r 2  91 rr              STA   (ptr_lo),Y
000057r 2               
000057r 2  A0 01              LDY   #GC_HDR_SIZE
000059r 2  AD rr rr           LDA   ha_paysz
00005Cr 2  18                 CLC
00005Dr 2  69 02              ADC   #GC_HDR_BYTES
00005Fr 2  91 rr              STA   (ptr_lo),Y
000061r 2               
000061r 2                     ; Advance ptr_lo/hi past header → payload pointer
000061r 2  18                 CLC
000062r 2  A5 rr              LDA   ptr_lo
000064r 2  69 02              ADC   #GC_HDR_BYTES
000066r 2  85 rr              STA   ptr_lo
000068r 2  A5 rr              LDA   ptr_hi
00006Ar 2  69 00              ADC   #0
00006Cr 2  85 rr              STA   ptr_hi
00006Er 2               
00006Er 2  18                 CLC
00006Fr 2  60                 RTS
000070r 2               
000070r 1                     .include "tokens.s"
000070r 2               ; tokens.s — token node format and constants for NovaLogo
000070r 2               
000070r 2               ; Token type constants
000070r 2               TOK_WORD     = $01            ; payload: length byte + chars
000070r 2               TOK_NUMBER   = $02            ; payload: 3 bytes (hi, lo, frac) — 16.8 fixed-point
000070r 2               TOK_LBRACKET = $03            ; no payload
000070r 2               TOK_RBRACKET = $04            ; no payload
000070r 2               TOK_VARREF   = $05            ; payload: length byte + chars (name after :)
000070r 2               TOK_QUOTE    = $06            ; payload: length byte + chars (word after ")
000070r 2               TOK_INFIX    = $07            ; payload: 1 byte (operator char)
000070r 2               TOK_LPAREN   = $08            ; no payload
000070r 2               TOK_RPAREN   = $09            ; no payload
000070r 2               
000070r 2               ; Token node layout:
000070r 2               ;   Offset 0: tag byte (TOK_* constant)
000070r 2               ;   Offset 1: next pointer low byte
000070r 2               ;   Offset 2: next pointer high byte ($00/$00 = end of list)
000070r 2               ;   Offset 3+: payload (varies by type)
000070r 2               ;
000070r 2               ; Total size: 3 + payload_size
000070r 2               ;   TOK_WORD/VARREF/QUOTE: 3 + 1 + len (length byte + chars)
000070r 2               ;   TOK_NUMBER: 3 + 3 = 6 bytes
000070r 2               ;   TOK_LBRACKET/RBRACKET/LPAREN/RPAREN: 3 bytes (no payload)
000070r 2               ;   TOK_INFIX: 3 + 1 = 4 bytes
000070r 2               
000070r 2               TOK_TAG      = 0              ; offset to tag byte
000070r 2               TOK_NEXT_LO  = 1              ; offset to next pointer low
000070r 2               TOK_NEXT_HI  = 2              ; offset to next pointer high
000070r 2               TOK_PAYLOAD  = 3              ; offset to start of payload
000070r 2               
000070r 1                     .include "tokenizer.s"
000070r 2               ; tokenizer.s — scan input_buf into a linked list of token nodes
000070r 2               
000070r 2               ; =====================================================================
000070r 2               ; ZEROPAGE segment — tokenizer variables
000070r 2               ; =====================================================================
000070r 2                     .segment "ZEROPAGE"
000004r 2               
000004r 2  xx           tok_head_lo:  .res 1          ; head of token list (first token)
000005r 2  xx           tok_head_hi:  .res 1
000006r 2  xx           tok_tail_lo:  .res 1          ; tail of token list (for appending)
000007r 2  xx           tok_tail_hi:  .res 1
000008r 2  xx           tok_src:      .res 1          ; current scan position in input_buf
000009r 2  xx           ptr2_lo:      .res 1          ; second general-purpose pointer (low byte)
00000Ar 2  xx           ptr2_hi:      .res 1          ; second general-purpose pointer (high byte)
00000Br 2  xx           tok_sign:     .res 1          ; sign flag for number parsing (0=pos, 1=neg)
00000Cr 2               
00000Cr 2               ; =====================================================================
00000Cr 2               ; BSS segment — scratch for number parsing
00000Cr 2               ; =====================================================================
00000Cr 2                     .segment "BSS"
000003r 2               
000003r 2  xx           num_val_lo:   .res 1          ; integer accumulator low
000004r 2  xx           num_val_hi:   .res 1          ; integer accumulator high
000005r 2  xx           num_tmp_lo:   .res 1          ; temp for multiply / frac result
000006r 2  xx           num_tmp_hi:   .res 1          ; temp for multiply / frac raw
000007r 2               
000007r 2               ; =====================================================================
000007r 2               ; CODE segment — tokenizer routines
000007r 2               ; =====================================================================
000007r 2                     .segment "CODE"
000070r 2               
000070r 2               ; ---------------------------------------------------------------------
000070r 2               ; tokenize_line — scan input_buf and build a linked list of tokens
000070r 2               ;   Input:  input_buf contains null-terminated text
000070r 2               ;   Output: tok_head_lo/hi = first token ($0000 if empty line)
000070r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi
000070r 2               ; ---------------------------------------------------------------------
000070r 2               tokenize_line:
000070r 2  64 rr              STZ   tok_head_lo
000072r 2  64 rr              STZ   tok_head_hi
000074r 2  64 rr              STZ   tok_tail_lo
000076r 2  64 rr              STZ   tok_tail_hi
000078r 2  64 rr              STZ   tok_src
00007Ar 2                     ; fall through to scan loop
00007Ar 2               
00007Ar 2               ; Non-local entry for scan loop — reachable from all routines
00007Ar 2               tok_scan_next:
00007Ar 2                     ; --- skip whitespace ---
00007Ar 2  A6 rr              LDX   tok_src
00007Cr 2               @skip_ws:
00007Cr 2  BD rr rr           LDA   input_buf,X
00007Fr 2  C9 20              CMP   #$20                 ; space
000081r 2  F0 04              BEQ   @ws_next
000083r 2  C9 09              CMP   #$09                 ; tab
000085r 2  D0 03              BNE   @ws_done
000087r 2               @ws_next:
000087r 2  E8                 INX
000088r 2  80 F2              BRA   @skip_ws
00008Ar 2               @ws_done:
00008Ar 2  86 rr              STX   tok_src
00008Cr 2               
00008Cr 2                     ; --- check for end of input ---
00008Cr 2  C9 00              CMP   #0
00008Er 2  D0 01              BNE   @not_end
000090r 2  60                 RTS                        ; done — list complete
000091r 2               @not_end:
000091r 2               
000091r 2                     ; --- colon → TOK_VARREF ---
000091r 2  C9 3A              CMP   #':'
000093r 2  D0 05              BNE   @not_colon
000095r 2  E6 rr              INC   tok_src              ; skip ':'
000097r 2  4C rr rr           JMP   tok_scan_varref
00009Ar 2               @not_colon:
00009Ar 2               
00009Ar 2                     ; --- quote → TOK_QUOTE ---
00009Ar 2  C9 22              CMP   #'"'
00009Cr 2  D0 05              BNE   @not_quote
00009Er 2  E6 rr              INC   tok_src              ; skip '"'
0000A0r 2  4C rr rr           JMP   tok_scan_quote
0000A3r 2               @not_quote:
0000A3r 2               
0000A3r 2                     ; --- brackets ---
0000A3r 2  C9 5B              CMP   #'['
0000A5r 2  D0 05              BNE   @not_lb
0000A7r 2  A9 03              LDA   #TOK_LBRACKET
0000A9r 2  4C rr rr           JMP   tok_emit_simple
0000ACr 2               @not_lb:
0000ACr 2  C9 5D              CMP   #']'
0000AEr 2  D0 05              BNE   @not_rb
0000B0r 2  A9 04              LDA   #TOK_RBRACKET
0000B2r 2  4C rr rr           JMP   tok_emit_simple
0000B5r 2               @not_rb:
0000B5r 2               
0000B5r 2                     ; --- parens ---
0000B5r 2  C9 28              CMP   #'('
0000B7r 2  D0 05              BNE   @not_lp
0000B9r 2  A9 08              LDA   #TOK_LPAREN
0000BBr 2  4C rr rr           JMP   tok_emit_simple
0000BEr 2               @not_lp:
0000BEr 2  C9 29              CMP   #')'
0000C0r 2  D0 05              BNE   @not_rp
0000C2r 2  A9 09              LDA   #TOK_RPAREN
0000C4r 2  4C rr rr           JMP   tok_emit_simple
0000C7r 2               @not_rp:
0000C7r 2               
0000C7r 2                     ; --- infix operators (not minus) ---
0000C7r 2  C9 2B              CMP   #'+'
0000C9r 2  F0 16              BEQ   @is_infix
0000CBr 2  C9 2A              CMP   #'*'
0000CDr 2  F0 12              BEQ   @is_infix
0000CFr 2  C9 2F              CMP   #'/'
0000D1r 2  F0 0E              BEQ   @is_infix
0000D3r 2  C9 3C              CMP   #'<'
0000D5r 2  F0 0A              BEQ   @is_infix
0000D7r 2  C9 3E              CMP   #'>'
0000D9r 2  F0 06              BEQ   @is_infix
0000DBr 2  C9 3D              CMP   #'='
0000DDr 2  F0 02              BEQ   @is_infix
0000DFr 2  80 03              BRA   @not_infix
0000E1r 2               @is_infix:
0000E1r 2  4C rr rr           JMP   tok_emit_infix
0000E4r 2               @not_infix:
0000E4r 2               
0000E4r 2                     ; --- minus: could be infix or negative number ---
0000E4r 2  C9 2D              CMP   #'-'
0000E6r 2  D0 15              BNE   @not_minus
0000E8r 2                     ; peek at next character
0000E8r 2  A6 rr              LDX   tok_src
0000EAr 2  BD rr rr           LDA   input_buf+1,X
0000EDr 2  C9 30              CMP   #'0'
0000EFr 2  90 04              BCC   @minus_infix
0000F1r 2  C9 3A              CMP   #'9'+1
0000F3r 2  90 05              BCC   @minus_number
0000F5r 2               @minus_infix:
0000F5r 2  A9 2D              LDA   #'-'
0000F7r 2  4C rr rr           JMP   tok_emit_infix
0000FAr 2               @minus_number:
0000FAr 2  4C rr rr           JMP   tok_parse_number
0000FDr 2               @not_minus:
0000FDr 2               
0000FDr 2                     ; --- digit → TOK_NUMBER ---
0000FDr 2  C9 30              CMP   #'0'
0000FFr 2  90 04              BCC   @not_digit
000101r 2  C9 3A              CMP   #'9'+1
000103r 2  90 03              BCC   @is_digit
000105r 2               @not_digit:
000105r 2               
000105r 2                     ; --- default: TOK_WORD ---
000105r 2  4C rr rr           JMP   tok_scan_word
000108r 2               
000108r 2               @is_digit:
000108r 2  4C rr rr           JMP   tok_parse_number
00010Br 2               
00010Br 2               ; ---------------------------------------------------------------------
00010Br 2               ; tok_emit_simple — emit a 3-byte node (tag only, no payload)
00010Br 2               ;   Input: A = tag byte, tok_src points at the character
00010Br 2               ; ---------------------------------------------------------------------
00010Br 2               tok_emit_simple:
00010Br 2  48                 PHA                        ; save tag
00010Cr 2  A9 03              LDA   #3
00010Er 2  A2 01              LDX   #ATYPE_TOKEN
000110r 2  20 rr rr           JSR   heap_alloc
000113r 2  B0 13              BCS   @oom
000115r 2  68                 PLA
000116r 2  A0 00              LDY   #TOK_TAG
000118r 2  91 rr              STA   (ptr_lo),Y
00011Ar 2  A0 01              LDY   #TOK_NEXT_LO
00011Cr 2  A9 00              LDA   #0
00011Er 2  91 rr              STA   (ptr_lo),Y
000120r 2  C8                 INY
000121r 2  91 rr              STA   (ptr_lo),Y
000123r 2  E6 rr              INC   tok_src              ; advance past the character
000125r 2  4C rr rr           JMP   tok_append_node
000128r 2               @oom:
000128r 2  68                 PLA
000129r 2  60                 RTS
00012Ar 2               
00012Ar 2               ; ---------------------------------------------------------------------
00012Ar 2               ; tok_emit_infix — emit a 4-byte node (tag + operator char)
00012Ar 2               ;   Input: A = operator character, tok_src points at the operator
00012Ar 2               ; ---------------------------------------------------------------------
00012Ar 2               tok_emit_infix:
00012Ar 2  48                 PHA                        ; save operator char
00012Br 2  A9 04              LDA   #4
00012Dr 2  A2 01              LDX   #ATYPE_TOKEN
00012Fr 2  20 rr rr           JSR   heap_alloc
000132r 2  B0 19              BCS   @oom
000134r 2  A0 00              LDY   #TOK_TAG
000136r 2  A9 07              LDA   #TOK_INFIX
000138r 2  91 rr              STA   (ptr_lo),Y
00013Ar 2  A0 01              LDY   #TOK_NEXT_LO
00013Cr 2  A9 00              LDA   #0
00013Er 2  91 rr              STA   (ptr_lo),Y
000140r 2  C8                 INY
000141r 2  91 rr              STA   (ptr_lo),Y
000143r 2  A0 03              LDY   #TOK_PAYLOAD
000145r 2  68                 PLA
000146r 2  91 rr              STA   (ptr_lo),Y
000148r 2  E6 rr              INC   tok_src
00014Ar 2  4C rr rr           JMP   tok_append_node
00014Dr 2               @oom:
00014Dr 2  68                 PLA
00014Er 2  60                 RTS
00014Fr 2               
00014Fr 2               ; ---------------------------------------------------------------------
00014Fr 2               ; tok_scan_word — scan a word into TOK_WORD (uppercased)
00014Fr 2               ;   tok_src points at first character
00014Fr 2               ; ---------------------------------------------------------------------
00014Fr 2               tok_scan_word:
00014Fr 2  A6 rr              LDX   tok_src
000151r 2  A0 00              LDY   #0                   ; length counter
000153r 2               @count:
000153r 2  BD rr rr           LDA   input_buf,X
000156r 2  20 rr rr           JSR   is_word_char
000159r 2  90 04              BCC   @counted
00015Br 2  E8                 INX
00015Cr 2  C8                 INY
00015Dr 2  80 F4              BRA   @count
00015Fr 2               @counted:
00015Fr 2  98                 TYA
000160r 2  F0 53              BEQ   @empty
000162r 2  48                 PHA                        ; save length
000163r 2  18                 CLC
000164r 2  69 04              ADC   #4                   ; node = 3 header + 1 length + chars
000166r 2  A2 01              LDX   #ATYPE_TOKEN
000168r 2  20 rr rr           JSR   heap_alloc
00016Br 2  B0 47              BCS   @oom
00016Dr 2                     ; tag
00016Dr 2  A0 00              LDY   #TOK_TAG
00016Fr 2  A9 01              LDA   #TOK_WORD
000171r 2  91 rr              STA   (ptr_lo),Y
000173r 2                     ; next = null
000173r 2  A0 01              LDY   #TOK_NEXT_LO
000175r 2  A9 00              LDA   #0
000177r 2  91 rr              STA   (ptr_lo),Y
000179r 2  C8                 INY
00017Ar 2  91 rr              STA   (ptr_lo),Y
00017Cr 2                     ; length byte
00017Cr 2  68                 PLA
00017Dr 2  48                 PHA
00017Er 2  A0 03              LDY   #TOK_PAYLOAD
000180r 2  91 rr              STA   (ptr_lo),Y
000182r 2                     ; copy chars with uppercasing
000182r 2  68                 PLA
000183r 2  AA                 TAX                        ; X = remaining
000184r 2  A0 04              LDY   #TOK_PAYLOAD+1       ; Y = dest offset
000186r 2  9C rr rr           STZ   num_tmp_lo           ; source offset from tok_src
000189r 2               @copy:
000189r 2  DA                 PHX
00018Ar 2  AD rr rr           LDA   num_tmp_lo
00018Dr 2  18                 CLC
00018Er 2  65 rr              ADC   tok_src
000190r 2  AA                 TAX
000191r 2  BD rr rr           LDA   input_buf,X
000194r 2  C9 61              CMP   #'a'
000196r 2  90 07              BCC   @noup
000198r 2  C9 7B              CMP   #'z'+1
00019Ar 2  B0 03              BCS   @noup
00019Cr 2  38                 SEC
00019Dr 2  E9 20              SBC   #$20
00019Fr 2               @noup:
00019Fr 2  91 rr              STA   (ptr_lo),Y
0001A1r 2  C8                 INY
0001A2r 2  EE rr rr           INC   num_tmp_lo
0001A5r 2  FA                 PLX
0001A6r 2  CA                 DEX
0001A7r 2  D0 E0              BNE   @copy
0001A9r 2                     ; advance tok_src
0001A9r 2  AD rr rr           LDA   num_tmp_lo
0001ACr 2  18                 CLC
0001ADr 2  65 rr              ADC   tok_src
0001AFr 2  85 rr              STA   tok_src
0001B1r 2  4C rr rr           JMP   tok_append_node
0001B4r 2               @oom:
0001B4r 2  68                 PLA
0001B5r 2               @empty:
0001B5r 2  60                 RTS
0001B6r 2               
0001B6r 2               ; ---------------------------------------------------------------------
0001B6r 2               ; tok_scan_varref — scan TOK_VARREF after ':'
0001B6r 2               ;   tok_src points at first char after ':'
0001B6r 2               ; ---------------------------------------------------------------------
0001B6r 2               tok_scan_varref:
0001B6r 2  A6 rr              LDX   tok_src
0001B8r 2  A0 00              LDY   #0
0001BAr 2               @count:
0001BAr 2  BD rr rr           LDA   input_buf,X
0001BDr 2  20 rr rr           JSR   is_word_char
0001C0r 2  90 04              BCC   @counted
0001C2r 2  E8                 INX
0001C3r 2  C8                 INY
0001C4r 2  80 F4              BRA   @count
0001C6r 2               @counted:
0001C6r 2  98                 TYA
0001C7r 2  F0 53              BEQ   @empty
0001C9r 2  48                 PHA
0001CAr 2  18                 CLC
0001CBr 2  69 04              ADC   #4
0001CDr 2  A2 01              LDX   #ATYPE_TOKEN
0001CFr 2  20 rr rr           JSR   heap_alloc
0001D2r 2  B0 47              BCS   @oom
0001D4r 2  A0 00              LDY   #TOK_TAG
0001D6r 2  A9 05              LDA   #TOK_VARREF
0001D8r 2  91 rr              STA   (ptr_lo),Y
0001DAr 2  A0 01              LDY   #TOK_NEXT_LO
0001DCr 2  A9 00              LDA   #0
0001DEr 2  91 rr              STA   (ptr_lo),Y
0001E0r 2  C8                 INY
0001E1r 2  91 rr              STA   (ptr_lo),Y
0001E3r 2  68                 PLA
0001E4r 2  48                 PHA
0001E5r 2  A0 03              LDY   #TOK_PAYLOAD
0001E7r 2  91 rr              STA   (ptr_lo),Y
0001E9r 2  68                 PLA
0001EAr 2  AA                 TAX
0001EBr 2  A0 04              LDY   #TOK_PAYLOAD+1
0001EDr 2  9C rr rr           STZ   num_tmp_lo
0001F0r 2               @copy:
0001F0r 2  DA                 PHX
0001F1r 2  AD rr rr           LDA   num_tmp_lo
0001F4r 2  18                 CLC
0001F5r 2  65 rr              ADC   tok_src
0001F7r 2  AA                 TAX
0001F8r 2  BD rr rr           LDA   input_buf,X
0001FBr 2  C9 61              CMP   #'a'
0001FDr 2  90 07              BCC   @noup
0001FFr 2  C9 7B              CMP   #'z'+1
000201r 2  B0 03              BCS   @noup
000203r 2  38                 SEC
000204r 2  E9 20              SBC   #$20
000206r 2               @noup:
000206r 2  91 rr              STA   (ptr_lo),Y
000208r 2  C8                 INY
000209r 2  EE rr rr           INC   num_tmp_lo
00020Cr 2  FA                 PLX
00020Dr 2  CA                 DEX
00020Er 2  D0 E0              BNE   @copy
000210r 2  AD rr rr           LDA   num_tmp_lo
000213r 2  18                 CLC
000214r 2  65 rr              ADC   tok_src
000216r 2  85 rr              STA   tok_src
000218r 2  4C rr rr           JMP   tok_append_node
00021Br 2               @oom:
00021Br 2  68                 PLA
00021Cr 2               @empty:
00021Cr 2  60                 RTS
00021Dr 2               
00021Dr 2               ; ---------------------------------------------------------------------
00021Dr 2               ; tok_scan_quote — scan TOK_QUOTE after '"'
00021Dr 2               ;   tok_src points at first char after '"'
00021Dr 2               ; ---------------------------------------------------------------------
00021Dr 2               tok_scan_quote:
00021Dr 2  A6 rr              LDX   tok_src
00021Fr 2  A0 00              LDY   #0
000221r 2               @count:
000221r 2  BD rr rr           LDA   input_buf,X
000224r 2  20 rr rr           JSR   is_word_char
000227r 2  90 04              BCC   @counted
000229r 2  E8                 INX
00022Ar 2  C8                 INY
00022Br 2  80 F4              BRA   @count
00022Dr 2               @counted:
00022Dr 2  98                 TYA
00022Er 2  F0 48              BEQ   @empty
000230r 2  48                 PHA
000231r 2  18                 CLC
000232r 2  69 04              ADC   #4
000234r 2  A2 01              LDX   #ATYPE_TOKEN
000236r 2  20 rr rr           JSR   heap_alloc
000239r 2  B0 3C              BCS   @oom
00023Br 2  A0 00              LDY   #TOK_TAG
00023Dr 2  A9 06              LDA   #TOK_QUOTE
00023Fr 2  91 rr              STA   (ptr_lo),Y
000241r 2  A0 01              LDY   #TOK_NEXT_LO
000243r 2  A9 00              LDA   #0
000245r 2  91 rr              STA   (ptr_lo),Y
000247r 2  C8                 INY
000248r 2  91 rr              STA   (ptr_lo),Y
00024Ar 2  68                 PLA
00024Br 2  48                 PHA
00024Cr 2  A0 03              LDY   #TOK_PAYLOAD
00024Er 2  91 rr              STA   (ptr_lo),Y
000250r 2                     ; Copy characters — no uppercasing for quotes
000250r 2  68                 PLA
000251r 2  AA                 TAX
000252r 2  A0 04              LDY   #TOK_PAYLOAD+1
000254r 2  9C rr rr           STZ   num_tmp_lo
000257r 2               @copy:
000257r 2  DA                 PHX
000258r 2  AD rr rr           LDA   num_tmp_lo
00025Br 2  18                 CLC
00025Cr 2  65 rr              ADC   tok_src
00025Er 2  AA                 TAX
00025Fr 2  BD rr rr           LDA   input_buf,X
000262r 2  91 rr              STA   (ptr_lo),Y
000264r 2  C8                 INY
000265r 2  EE rr rr           INC   num_tmp_lo
000268r 2  FA                 PLX
000269r 2  CA                 DEX
00026Ar 2  D0 EB              BNE   @copy
00026Cr 2  AD rr rr           LDA   num_tmp_lo
00026Fr 2  18                 CLC
000270r 2  65 rr              ADC   tok_src
000272r 2  85 rr              STA   tok_src
000274r 2  4C rr rr           JMP   tok_append_node
000277r 2               @oom:
000277r 2  68                 PLA
000278r 2               @empty:
000278r 2  60                 RTS
000279r 2               
000279r 2               ; ---------------------------------------------------------------------
000279r 2               ; tok_parse_number — parse decimal integer[.fraction] into TOK_NUMBER
000279r 2               ;   tok_src points at first digit or '-'
000279r 2               ;   Payload: 3 bytes = int_hi, int_lo, frac (16.8 fixed-point)
000279r 2               ; ---------------------------------------------------------------------
000279r 2               tok_parse_number:
000279r 2  9C rr rr           STZ   num_val_lo
00027Cr 2  9C rr rr           STZ   num_val_hi
00027Fr 2  64 rr              STZ   tok_sign              ; 0 = positive
000281r 2  A6 rr              LDX   tok_src
000283r 2  BD rr rr           LDA   input_buf,X
000286r 2  C9 2D              CMP   #'-'
000288r 2  D0 06              BNE   @parse_int
00028Ar 2  A9 01              LDA   #1
00028Cr 2  85 rr              STA   tok_sign
00028Er 2  E6 rr              INC   tok_src
000290r 2               
000290r 2                     ; Parse integer digits
000290r 2               @parse_int:
000290r 2  A6 rr              LDX   tok_src
000292r 2  BD rr rr           LDA   input_buf,X
000295r 2  C9 30              CMP   #'0'
000297r 2  90 48              BCC   @int_done
000299r 2  C9 3A              CMP   #'9'+1
00029Br 2  B0 44              BCS   @int_done
00029Dr 2  38                 SEC
00029Er 2  E9 30              SBC   #'0'                 ; A = digit 0..9
0002A0r 2  48                 PHA                        ; save digit
0002A1r 2               
0002A1r 2                     ; Multiply num_val by 10: (val << 3) + (val << 1)
0002A1r 2                     ; Compute val << 1
0002A1r 2  AD rr rr           LDA   num_val_lo
0002A4r 2  0A                 ASL
0002A5r 2  8D rr rr           STA   num_tmp_lo
0002A8r 2  AD rr rr           LDA   num_val_hi
0002ABr 2  2A                 ROL
0002ACr 2  8D rr rr           STA   num_tmp_hi           ; tmp = val * 2
0002AFr 2               
0002AFr 2                     ; Compute val << 3 = (val * 2) << 2
0002AFr 2  0E rr rr           ASL   num_tmp_lo
0002B2r 2  2E rr rr           ROL   num_tmp_hi
0002B5r 2  0E rr rr           ASL   num_tmp_lo
0002B8r 2  2E rr rr           ROL   num_tmp_hi           ; tmp = val * 8
0002BBr 2               
0002BBr 2                     ; val*10 = val*8 + val*2. We need val*2 again.
0002BBr 2  AD rr rr           LDA   num_val_lo
0002BEr 2  0A                 ASL
0002BFr 2  18                 CLC
0002C0r 2  6D rr rr           ADC   num_tmp_lo
0002C3r 2  8D rr rr           STA   num_val_lo
0002C6r 2  AD rr rr           LDA   num_val_hi
0002C9r 2  2A                 ROL
0002CAr 2  6D rr rr           ADC   num_tmp_hi
0002CDr 2  8D rr rr           STA   num_val_hi           ; num_val = val*10
0002D0r 2               
0002D0r 2                     ; Add digit
0002D0r 2  68                 PLA
0002D1r 2  18                 CLC
0002D2r 2  6D rr rr           ADC   num_val_lo
0002D5r 2  8D rr rr           STA   num_val_lo
0002D8r 2  90 03              BCC   @no_carry
0002DAr 2  EE rr rr           INC   num_val_hi
0002DDr 2               @no_carry:
0002DDr 2  E6 rr              INC   tok_src
0002DFr 2  80 AF              BRA   @parse_int
0002E1r 2               
0002E1r 2               @int_done:
0002E1r 2                     ; Parse fractional part
0002E1r 2  9C rr rr           STZ   num_tmp_lo           ; frac result
0002E4r 2  A6 rr              LDX   tok_src
0002E6r 2  BD rr rr           LDA   input_buf,X
0002E9r 2  C9 2E              CMP   #'.'
0002EBr 2  D0 67              BNE   @apply_sign
0002EDr 2  E6 rr              INC   tok_src
0002EFr 2               
0002EFr 2                     ; Parse up to 2 fractional digits
0002EFr 2  9C rr rr           STZ   num_tmp_hi           ; frac_raw accumulator
0002F2r 2  A0 00              LDY   #0                   ; digit count
0002F4r 2               @frac_loop:
0002F4r 2  C0 02              CPY   #2
0002F6r 2  B0 2E              BCS   @frac_skip
0002F8r 2  A6 rr              LDX   tok_src
0002FAr 2  BD rr rr           LDA   input_buf,X
0002FDr 2  C9 30              CMP   #'0'
0002FFr 2  90 36              BCC   @frac_conv
000301r 2  C9 3A              CMP   #'9'+1
000303r 2  B0 32              BCS   @frac_conv
000305r 2  38                 SEC
000306r 2  E9 30              SBC   #'0'
000308r 2  48                 PHA
000309r 2                     ; frac_raw = frac_raw * 10 + digit
000309r 2  AD rr rr           LDA   num_tmp_hi
00030Cr 2  0A                 ASL
00030Dr 2  8D rr rr           STA   num_tmp_lo           ; *2
000310r 2  0A                 ASL
000311r 2  0A                 ASL                        ; A = val*8
000312r 2  18                 CLC
000313r 2  6D rr rr           ADC   num_tmp_lo           ; A = val*10
000316r 2  8D rr rr           STA   num_tmp_hi
000319r 2  68                 PLA
00031Ar 2  18                 CLC
00031Br 2  6D rr rr           ADC   num_tmp_hi
00031Er 2  8D rr rr           STA   num_tmp_hi
000321r 2  E6 rr              INC   tok_src
000323r 2  C8                 INY
000324r 2  80 CE              BRA   @frac_loop
000326r 2               
000326r 2               @frac_skip:
000326r 2                     ; skip remaining digits after '.'
000326r 2  A6 rr              LDX   tok_src
000328r 2  BD rr rr           LDA   input_buf,X
00032Br 2  C9 30              CMP   #'0'
00032Dr 2  90 08              BCC   @frac_conv
00032Fr 2  C9 3A              CMP   #'9'+1
000331r 2  B0 04              BCS   @frac_conv
000333r 2  E6 rr              INC   tok_src
000335r 2  80 EF              BRA   @frac_skip
000337r 2               
000337r 2               @frac_conv:
000337r 2                     ; If only 1 digit, multiply by 10
000337r 2  C0 01              CPY   #1
000339r 2  D0 10              BNE   @frac_2d
00033Br 2  AD rr rr           LDA   num_tmp_hi
00033Er 2  0A                 ASL
00033Fr 2  8D rr rr           STA   num_tmp_lo
000342r 2  0A                 ASL
000343r 2  0A                 ASL
000344r 2  18                 CLC
000345r 2  6D rr rr           ADC   num_tmp_lo
000348r 2  8D rr rr           STA   num_tmp_hi
00034Br 2               @frac_2d:
00034Br 2                     ; Convert centesimal (0..99) → 8-bit fraction
00034Br 2  AD rr rr           LDA   num_tmp_hi
00034Er 2  20 rr rr           JSR   frac_to_byte
000351r 2  8D rr rr           STA   num_tmp_lo
000354r 2               
000354r 2               @apply_sign:
000354r 2                     ; Apply sign (negate 16.8 via two's complement if negative)
000354r 2  A5 rr              LDA   tok_sign
000356r 2  F0 1F              BEQ   @emit_num
000358r 2                     ; Negate: complement and add 1 across all 3 bytes
000358r 2  AD rr rr           LDA   num_tmp_lo           ; frac
00035Br 2  49 FF              EOR   #$FF
00035Dr 2  18                 CLC
00035Er 2  69 01              ADC   #1
000360r 2  8D rr rr           STA   num_tmp_lo
000363r 2  AD rr rr           LDA   num_val_lo
000366r 2  49 FF              EOR   #$FF
000368r 2  69 00              ADC   #0
00036Ar 2  8D rr rr           STA   num_val_lo
00036Dr 2  AD rr rr           LDA   num_val_hi
000370r 2  49 FF              EOR   #$FF
000372r 2  69 00              ADC   #0
000374r 2  8D rr rr           STA   num_val_hi
000377r 2               
000377r 2               @emit_num:
000377r 2                     ; Allocate 6-byte node
000377r 2  A9 06              LDA   #6
000379r 2  A2 01              LDX   #ATYPE_TOKEN
00037Br 2  20 rr rr           JSR   heap_alloc
00037Er 2  B0 25              BCS   @oom
000380r 2  A0 00              LDY   #TOK_TAG
000382r 2  A9 02              LDA   #TOK_NUMBER
000384r 2  91 rr              STA   (ptr_lo),Y
000386r 2  A0 01              LDY   #TOK_NEXT_LO
000388r 2  A9 00              LDA   #0
00038Ar 2  91 rr              STA   (ptr_lo),Y
00038Cr 2  C8                 INY
00038Dr 2  91 rr              STA   (ptr_lo),Y
00038Fr 2                     ; Payload: [hi, lo, frac]
00038Fr 2  A0 03              LDY   #TOK_PAYLOAD
000391r 2  AD rr rr           LDA   num_val_hi
000394r 2  91 rr              STA   (ptr_lo),Y
000396r 2  C8                 INY
000397r 2  AD rr rr           LDA   num_val_lo
00039Ar 2  91 rr              STA   (ptr_lo),Y
00039Cr 2  C8                 INY
00039Dr 2  AD rr rr           LDA   num_tmp_lo
0003A0r 2  91 rr              STA   (ptr_lo),Y
0003A2r 2  4C rr rr           JMP   tok_append_node
0003A5r 2               @oom:
0003A5r 2  60                 RTS
0003A6r 2               
0003A6r 2               ; ---------------------------------------------------------------------
0003A6r 2               ; frac_to_byte — convert centesimal fraction (0..99) to 8-bit (0..252)
0003A6r 2               ;   Input: A = centesimal value (0..99)
0003A6r 2               ;   Output: A = 8-bit fractional byte
0003A6r 2               ;   Method: (A * 256) / 100 via 16÷8 long division
0003A6r 2               ;   Clobbers: X, Y
0003A6r 2               ; ---------------------------------------------------------------------
0003A6r 2               frac_to_byte:
0003A6r 2                     ; dividend = A:$00 (A*256), divisor = 100
0003A6r 2  8D rr rr           STA   num_tmp_hi
0003A9r 2  9C rr rr           STZ   num_tmp_lo
0003ACr 2  A2 00              LDX   #0                   ; remainder
0003AEr 2  A0 10              LDY   #16                  ; 16-bit division
0003B0r 2               @div:
0003B0r 2  0E rr rr           ASL   num_tmp_lo
0003B3r 2  2E rr rr           ROL   num_tmp_hi
0003B6r 2  8A                 TXA
0003B7r 2  2A                 ROL
0003B8r 2  AA                 TAX
0003B9r 2  E0 64              CPX   #100
0003BBr 2  90 08              BCC   @nosub
0003BDr 2  8A                 TXA
0003BEr 2  38                 SEC
0003BFr 2  E9 64              SBC   #100
0003C1r 2  AA                 TAX
0003C2r 2  EE rr rr           INC   num_tmp_lo
0003C5r 2               @nosub:
0003C5r 2  88                 DEY
0003C6r 2  D0 E8              BNE   @div
0003C8r 2  AD rr rr           LDA   num_tmp_lo           ; quotient low byte
0003CBr 2  60                 RTS
0003CCr 2               
0003CCr 2               ; ---------------------------------------------------------------------
0003CCr 2               ; tok_append_node — link ptr_lo/hi into the list, continue scanning
0003CCr 2               ; ---------------------------------------------------------------------
0003CCr 2               tok_append_node:
0003CCr 2  A5 rr              LDA   tok_head_lo
0003CEr 2  05 rr              ORA   tok_head_hi
0003D0r 2  D0 0F              BNE   @link
0003D2r 2                     ; Empty list: head = tail = new node
0003D2r 2  A5 rr              LDA   ptr_lo
0003D4r 2  85 rr              STA   tok_head_lo
0003D6r 2  85 rr              STA   tok_tail_lo
0003D8r 2  A5 rr              LDA   ptr_hi
0003DAr 2  85 rr              STA   tok_head_hi
0003DCr 2  85 rr              STA   tok_tail_hi
0003DEr 2  4C rr rr           JMP   tok_scan_next
0003E1r 2               @link:
0003E1r 2                     ; tail->next = new node
0003E1r 2  A5 rr              LDA   tok_tail_lo
0003E3r 2  85 rr              STA   ptr2_lo
0003E5r 2  A5 rr              LDA   tok_tail_hi
0003E7r 2  85 rr              STA   ptr2_hi
0003E9r 2  A0 01              LDY   #TOK_NEXT_LO
0003EBr 2  A5 rr              LDA   ptr_lo
0003EDr 2  91 rr              STA   (ptr2_lo),Y
0003EFr 2  C8                 INY
0003F0r 2  A5 rr              LDA   ptr_hi
0003F2r 2  91 rr              STA   (ptr2_lo),Y
0003F4r 2                     ; tail = new node
0003F4r 2  A5 rr              LDA   ptr_lo
0003F6r 2  85 rr              STA   tok_tail_lo
0003F8r 2  A5 rr              LDA   ptr_hi
0003FAr 2  85 rr              STA   tok_tail_hi
0003FCr 2  4C rr rr           JMP   tok_scan_next
0003FFr 2               
0003FFr 2               ; ---------------------------------------------------------------------
0003FFr 2               ; is_word_char — test if A is a valid word character
0003FFr 2               ;   Returns: carry set = word char, carry clear = delimiter
0003FFr 2               ;   Preserves: X
0003FFr 2               ; ---------------------------------------------------------------------
0003FFr 2               is_word_char:
0003FFr 2  C9 00              CMP   #0
000401r 2  F0 36              BEQ   @no
000403r 2  C9 20              CMP   #$20
000405r 2  F0 32              BEQ   @no
000407r 2  C9 09              CMP   #$09
000409r 2  F0 2E              BEQ   @no
00040Br 2  C9 5B              CMP   #'['
00040Dr 2  F0 2A              BEQ   @no
00040Fr 2  C9 5D              CMP   #']'
000411r 2  F0 26              BEQ   @no
000413r 2  C9 28              CMP   #'('
000415r 2  F0 22              BEQ   @no
000417r 2  C9 29              CMP   #')'
000419r 2  F0 1E              BEQ   @no
00041Br 2  C9 2B              CMP   #'+'
00041Dr 2  F0 1A              BEQ   @no
00041Fr 2  C9 2D              CMP   #'-'
000421r 2  F0 16              BEQ   @no
000423r 2  C9 2A              CMP   #'*'
000425r 2  F0 12              BEQ   @no
000427r 2  C9 2F              CMP   #'/'
000429r 2  F0 0E              BEQ   @no
00042Br 2  C9 3C              CMP   #'<'
00042Dr 2  F0 0A              BEQ   @no
00042Fr 2  C9 3E              CMP   #'>'
000431r 2  F0 06              BEQ   @no
000433r 2  C9 3D              CMP   #'='
000435r 2  F0 02              BEQ   @no
000437r 2  38                 SEC
000438r 2  60                 RTS
000439r 2               @no:
000439r 2  18                 CLC
00043Ar 2  60                 RTS
00043Br 2               
00043Br 2               ; =====================================================================
00043Br 2               ; print_token_count — walk the token list, count, print "N TOKENS\n"
00043Br 2               ; =====================================================================
00043Br 2               print_token_count:
00043Br 2  A2 00              LDX   #0
00043Dr 2  A5 rr              LDA   tok_head_lo
00043Fr 2  85 rr              STA   ptr2_lo
000441r 2  A5 rr              LDA   tok_head_hi
000443r 2  85 rr              STA   ptr2_hi
000445r 2               @walk:
000445r 2  A5 rr              LDA   ptr2_lo
000447r 2  05 rr              ORA   ptr2_hi
000449r 2  F0 10              BEQ   @print
00044Br 2  E8                 INX
00044Cr 2  A0 01              LDY   #TOK_NEXT_LO
00044Er 2  B1 rr              LDA   (ptr2_lo),Y
000450r 2  48                 PHA
000451r 2  C8                 INY
000452r 2  B1 rr              LDA   (ptr2_lo),Y
000454r 2  85 rr              STA   ptr2_hi
000456r 2  68                 PLA
000457r 2  85 rr              STA   ptr2_lo
000459r 2  80 EA              BRA   @walk
00045Br 2               @print:
00045Br 2  8A                 TXA
00045Cr 2  20 rr rr           JSR   print_byte_decimal
00045Fr 2  A2 00              LDX   #0
000461r 2               @str:
000461r 2  BD rr rr           LDA   str_tokens,X
000464r 2  F0 06              BEQ   @nl
000466r 2  8D 0E A0           STA   VGC_CHAROUT
000469r 2  E8                 INX
00046Ar 2  D0 F5              BNE   @str
00046Cr 2               @nl:
00046Cr 2  A9 0D              LDA   #$0D
00046Er 2  8D 0E A0           STA   VGC_CHAROUT
000471r 2  A9 0A              LDA   #$0A
000473r 2  8D 0E A0           STA   VGC_CHAROUT
000476r 2  60                 RTS
000477r 2               
000477r 2               ; ---------------------------------------------------------------------
000477r 2               ; print_byte_decimal — print A as 1-3 decimal digits (no leading zeros)
000477r 2               ;   Input: A = value 0..255
000477r 2               ; ---------------------------------------------------------------------
000477r 2               print_byte_decimal:
000477r 2  A2 00              LDX   #0                   ; suppress leading zeros
000479r 2  A0 00              LDY   #0
00047Br 2               @hundreds:
00047Br 2  C9 64              CMP   #100
00047Dr 2  90 06              BCC   @tens_setup
00047Fr 2  38                 SEC
000480r 2  E9 64              SBC   #100
000482r 2  C8                 INY
000483r 2  80 F6              BRA   @hundreds
000485r 2               @tens_setup:
000485r 2  48                 PHA
000486r 2  98                 TYA
000487r 2  F0 07              BEQ   @skip_h
000489r 2  09 30              ORA   #'0'
00048Br 2  8D 0E A0           STA   VGC_CHAROUT
00048Er 2  A2 01              LDX   #1
000490r 2               @skip_h:
000490r 2  68                 PLA
000491r 2  A0 00              LDY   #0
000493r 2               @tens:
000493r 2  C9 0A              CMP   #10
000495r 2  90 06              BCC   @ones
000497r 2  38                 SEC
000498r 2  E9 0A              SBC   #10
00049Ar 2  C8                 INY
00049Br 2  80 F6              BRA   @tens
00049Dr 2               @ones:
00049Dr 2  48                 PHA
00049Er 2  98                 TYA
