002F7Fr 2  AA                 TAX
002F80r 2  C8                 INY
002F81r 2  B1 rr              LDA   (ptr_lo),Y
002F83r 2  85 rr              STA   proc_entry_hi
002F85r 2  86 rr              STX   proc_entry_lo
002F87r 2  80 C5              BRA   @walk
