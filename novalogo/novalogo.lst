00061Er 2               
00061Er 1                     .include "vars.s"
00061Er 2               ; vars.s — variable storage for NovaLogo (MAKE / :reference)
00061Er 2               ;
00061Er 2               ; Variables are stored as a linked list of heap entries.
00061Er 2               ; Entry layout:
00061Er 2               ;   +0: next_lo  (2 bytes — pointer to next entry, or $0000)
00061Er 2               ;   +1: next_hi
00061Er 2               ;   +2: name_len (1 byte)
00061Er 2               ;   +3: name chars (name_len bytes, uppercased)
00061Er 2               ;   +3+name_len: value_type (1 byte: $00=number, $01=word)
00061Er 2               ;   +4+name_len: val_hi  (or ptr_lo for word)
00061Er 2               ;   +5+name_len: val_lo  (or ptr_hi for word)
00061Er 2               ;   +6+name_len: val_frac (0 for word)
00061Er 2               ;   +7+name_len: pad     (0)
00061Er 2               ;
00061Er 2               ; Total entry size = 8 + name_len bytes.
00061Er 2               
00061Er 2               ; Entry field offsets (relative to entry base)
00061Er 2               VAR_NEXT_LO  = 0
00061Er 2               VAR_NEXT_HI  = 1
00061Er 2               VAR_NAME_LEN = 2
00061Er 2               VAR_NAME     = 3              ; first char of name
00061Er 2               
00061Er 2               ; =====================================================================
00061Er 2               ; ZEROPAGE segment — variable list head + scratch
00061Er 2               ; =====================================================================
00061Er 2                     .segment "ZEROPAGE"
000037r 2               
000037r 2  xx           var_head_lo:    .res 1        ; head of variable linked list
000038r 2  xx           var_head_hi:    .res 1
000039r 2  xx           var_entry_lo:   .res 1        ; current entry pointer (walk scratch)
00003Ar 2  xx           var_entry_hi:   .res 1
00003Br 2  xx           var_name_lo:    .res 1        ; saved name pointer for set/get
00003Cr 2  xx           var_name_hi:    .res 1
00003Dr 2               
00003Dr 2               ; =====================================================================
00003Dr 2               ; CODE segment — variable routines
00003Dr 2               ; =====================================================================
00003Dr 2                     .segment "CODE"
002646r 2               
002646r 2               ; ---------------------------------------------------------------------
002646r 2               ; var_init — initialize variable list to empty
002646r 2               ;   Called once at cold_start
002646r 2               ; ---------------------------------------------------------------------
002646r 2               var_init:
002646r 2  64 rr              STZ   var_head_lo
002648r 2  64 rr              STZ   var_head_hi
00264Ar 2  60                 RTS
00264Br 2               
00264Br 2               ; ---------------------------------------------------------------------
00264Br 2               ; var_set — store a value under a variable name
00264Br 2               ;   Input: ptr_lo/hi → length-prefixed name string (in token node)
00264Br 2               ;          eval_type, eval_val_hi/lo/frac = value to store
00264Br 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, var_entry, var_name
00264Br 2               ; ---------------------------------------------------------------------
00264Br 2               var_set:
00264Br 2                     ; Save name pointer — we need it after the walk
00264Br 2  A5 rr              LDA   ptr_lo
00264Dr 2  85 rr              STA   var_name_lo
00264Fr 2  A5 rr              LDA   ptr_hi
002651r 2  85 rr              STA   var_name_hi
002653r 2               
002653r 2                     ; Walk the list looking for an existing entry with this name
002653r 2  A5 rr              LDA   var_head_lo
002655r 2  85 rr              STA   var_entry_lo
002657r 2  A5 rr              LDA   var_head_hi
002659r 2  85 rr              STA   var_entry_hi
00265Br 2               
00265Br 2               @walk:
00265Br 2                     ; End of list?
00265Br 2  A5 rr              LDA   var_entry_lo
00265Dr 2  05 rr              ORA   var_entry_hi
00265Fr 2  F0 44              BEQ   @not_found
002661r 2               
002661r 2                     ; Compare name in entry against var_name
002661r 2  20 rr rr           JSR   var_names_equal
002664r 2  B0 16              BCS   @found
002666r 2               
002666r 2                     ; Advance to next entry
002666r 2  A5 rr              LDA   var_entry_lo
002668r 2  85 rr              STA   ptr2_lo
00266Ar 2  A5 rr              LDA   var_entry_hi
00266Cr 2  85 rr              STA   ptr2_hi
00266Er 2  A0 00              LDY   #VAR_NEXT_LO
002670r 2  B1 rr              LDA   (ptr2_lo),Y
002672r 2  AA                 TAX
002673r 2  C8                 INY
002674r 2  B1 rr              LDA   (ptr2_lo),Y
002676r 2  85 rr              STA   var_entry_hi
002678r 2  86 rr              STX   var_entry_lo
00267Ar 2  80 DF              BRA   @walk
00267Cr 2               
00267Cr 2               @found:
00267Cr 2                     ; Overwrite value in place
00267Cr 2                     ; Value starts at entry + 3 + name_len
00267Cr 2  A5 rr              LDA   var_entry_lo
00267Er 2  85 rr              STA   ptr2_lo
002680r 2  A5 rr              LDA   var_entry_hi
002682r 2  85 rr              STA   ptr2_hi
002684r 2  A0 02              LDY   #VAR_NAME_LEN
002686r 2  B1 rr              LDA   (ptr2_lo),Y          ; name_len
002688r 2  18                 CLC
002689r 2  69 03              ADC   #VAR_NAME             ; A = 3 + name_len = offset to value_type
00268Br 2  A8                 TAY
00268Cr 2  A5 rr              LDA   eval_type
00268Er 2  91 rr              STA   (ptr2_lo),Y
002690r 2  C8                 INY
002691r 2  A5 rr              LDA   eval_val_hi
002693r 2  91 rr              STA   (ptr2_lo),Y
002695r 2  C8                 INY
002696r 2  A5 rr              LDA   eval_val_lo
002698r 2  91 rr              STA   (ptr2_lo),Y
00269Ar 2  C8                 INY
00269Br 2  A5 rr              LDA   eval_val_frac
00269Dr 2  91 rr              STA   (ptr2_lo),Y
00269Fr 2  C8                 INY
0026A0r 2  A9 00              LDA   #0
0026A2r 2  91 rr              STA   (ptr2_lo),Y          ; pad
0026A4r 2  60                 RTS
0026A5r 2               
0026A5r 2               @not_found:
0026A5r 2                     ; Allocate a new entry: 8 + name_len bytes
0026A5r 2                     ; Read name_len from the name string
0026A5r 2  A5 rr              LDA   var_name_lo
0026A7r 2  85 rr              STA   ptr_lo
0026A9r 2  A5 rr              LDA   var_name_hi
0026ABr 2  85 rr              STA   ptr_hi
0026ADr 2  A0 00              LDY   #0
0026AFr 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
0026B1r 2  48                 PHA                         ; save name_len
0026B2r 2  18                 CLC
0026B3r 2  69 08              ADC   #8                    ; total entry size
0026B5r 2  A2 03              LDX   #ATYPE_VAR
0026B7r 2  20 rr rr           JSR   heap_alloc
0026BAr 2  B0 62              BCS   @oom
0026BCr 2               
0026BCr 2                     ; ptr_lo/hi now points to new entry
0026BCr 2                     ; Set next → current head
0026BCr 2  A0 00              LDY   #VAR_NEXT_LO
0026BEr 2  A5 rr              LDA   var_head_lo
0026C0r 2  91 rr              STA   (ptr_lo),Y
0026C2r 2  C8                 INY
0026C3r 2  A5 rr              LDA   var_head_hi
0026C5r 2  91 rr              STA   (ptr_lo),Y
0026C7r 2               
0026C7r 2                     ; Copy name_len
0026C7r 2  68                 PLA                         ; A = name_len
0026C8r 2  48                 PHA                         ; keep it on stack
0026C9r 2  A0 02              LDY   #VAR_NAME_LEN
0026CBr 2  91 rr              STA   (ptr_lo),Y
0026CDr 2               
0026CDr 2                     ; Copy name chars (uppercased) from var_name source
0026CDr 2  68                 PLA                         ; A = name_len
0026CEr 2  AA                 TAX                         ; X = remaining chars
0026CFr 2  F0 2C              BEQ   @name_done            ; zero-length name (shouldn't happen)
0026D1r 2  A0 03              LDY   #VAR_NAME             ; dest offset in entry
0026D3r 2  9C rr rr           STZ   num_tmp_lo            ; source offset counter
0026D6r 2               
0026D6r 2               @copy_name:
0026D6r 2  DA                 PHX
0026D7r 2  5A                 PHY
0026D8r 2                     ; Read source char
0026D8r 2  A5 rr              LDA   var_name_lo
0026DAr 2  85 rr              STA   ptr2_lo
0026DCr 2  A5 rr              LDA   var_name_hi
0026DEr 2  85 rr              STA   ptr2_hi
0026E0r 2  AD rr rr           LDA   num_tmp_lo
0026E3r 2  1A                 INC                         ; skip length byte → offset = idx + 1
0026E4r 2  A8                 TAY
0026E5r 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
0026E7r 2                     ; Uppercase
0026E7r 2  C9 61              CMP   #'a'
0026E9r 2  90 07              BCC   @noup
0026EBr 2  C9 7B              CMP   #'z'+1
0026EDr 2  B0 03              BCS   @noup
0026EFr 2  38                 SEC
0026F0r 2  E9 20              SBC   #$20
0026F2r 2               @noup:
0026F2r 2  7A                 PLY                         ; restore dest offset
0026F3r 2  91 rr              STA   (ptr_lo),Y           ; write to entry
0026F5r 2  C8                 INY
0026F6r 2  EE rr rr           INC   num_tmp_lo
0026F9r 2  FA                 PLX
0026FAr 2  CA                 DEX
0026FBr 2  D0 D9              BNE   @copy_name
0026FDr 2               
0026FDr 2               @name_done:
0026FDr 2                     ; Write value after name
0026FDr 2                     ; Y is already at VAR_NAME + name_len = value_type offset
0026FDr 2  A5 rr              LDA   eval_type
0026FFr 2  91 rr              STA   (ptr_lo),Y
002701r 2  C8                 INY
002702r 2  A5 rr              LDA   eval_val_hi
002704r 2  91 rr              STA   (ptr_lo),Y
002706r 2  C8                 INY
002707r 2  A5 rr              LDA   eval_val_lo
002709r 2  91 rr              STA   (ptr_lo),Y
00270Br 2  C8                 INY
00270Cr 2  A5 rr              LDA   eval_val_frac
00270Er 2  91 rr              STA   (ptr_lo),Y
002710r 2  C8                 INY
002711r 2  A9 00              LDA   #0
002713r 2  91 rr              STA   (ptr_lo),Y           ; pad
002715r 2               
002715r 2                     ; Prepend to list: head = new entry
002715r 2  A5 rr              LDA   ptr_lo
002717r 2  85 rr              STA   var_head_lo
002719r 2  A5 rr              LDA   ptr_hi
00271Br 2  85 rr              STA   var_head_hi
00271Dr 2  60                 RTS
00271Er 2               
00271Er 2               @oom:
00271Er 2  68                 PLA                         ; discard saved name_len
00271Fr 2  60                 RTS
002720r 2               
002720r 2               ; ---------------------------------------------------------------------
002720r 2               ; var_get — look up a variable by name
002720r 2               ;   Input: ptr_lo/hi → length-prefixed name string
002720r 2               ;   Output: Carry clear = found, eval_type/eval_val set
002720r 2               ;           Carry set = not found
002720r 2               ;   Clobbers: A, X, Y, ptr2, var_entry, var_name
002720r 2               ; ---------------------------------------------------------------------
002720r 2               var_get:
002720r 2                     ; Save name pointer
002720r 2  A5 rr              LDA   ptr_lo
002722r 2  85 rr              STA   var_name_lo
002724r 2  A5 rr              LDA   ptr_hi
002726r 2  85 rr              STA   var_name_hi
002728r 2               
002728r 2                     ; Walk the list
002728r 2  A5 rr              LDA   var_head_lo
00272Ar 2  85 rr              STA   var_entry_lo
00272Cr 2  A5 rr              LDA   var_head_hi
00272Er 2  85 rr              STA   var_entry_hi
002730r 2               
002730r 2               @walk:
002730r 2  A5 rr              LDA   var_entry_lo
002732r 2  05 rr              ORA   var_entry_hi
002734r 2  F0 40              BEQ   @not_found
002736r 2               
002736r 2  20 rr rr           JSR   var_names_equal
002739r 2  B0 16              BCS   @found
00273Br 2               
00273Br 2                     ; Advance to next
00273Br 2  A5 rr              LDA   var_entry_lo
00273Dr 2  85 rr              STA   ptr2_lo
00273Fr 2  A5 rr              LDA   var_entry_hi
002741r 2  85 rr              STA   ptr2_hi
002743r 2  A0 00              LDY   #VAR_NEXT_LO
002745r 2  B1 rr              LDA   (ptr2_lo),Y
002747r 2  AA                 TAX
002748r 2  C8                 INY
002749r 2  B1 rr              LDA   (ptr2_lo),Y
00274Br 2  85 rr              STA   var_entry_hi
00274Dr 2  86 rr              STX   var_entry_lo
00274Fr 2  80 DF              BRA   @walk
002751r 2               
002751r 2               @found:
002751r 2                     ; Read value from entry + 3 + name_len
002751r 2  A5 rr              LDA   var_entry_lo
002753r 2  85 rr              STA   ptr2_lo
002755r 2  A5 rr              LDA   var_entry_hi
002757r 2  85 rr              STA   ptr2_hi
002759r 2  A0 02              LDY   #VAR_NAME_LEN
00275Br 2  B1 rr              LDA   (ptr2_lo),Y
00275Dr 2  18                 CLC
00275Er 2  69 03              ADC   #VAR_NAME
002760r 2  A8                 TAY
002761r 2  B1 rr              LDA   (ptr2_lo),Y          ; value_type
002763r 2  85 rr              STA   eval_type
002765r 2  C8                 INY
002766r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_hi
002768r 2  85 rr              STA   eval_val_hi
00276Ar 2  C8                 INY
00276Br 2  B1 rr              LDA   (ptr2_lo),Y          ; val_lo
00276Dr 2  85 rr              STA   eval_val_lo
00276Fr 2  C8                 INY
002770r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_frac
002772r 2  85 rr              STA   eval_val_frac
002774r 2  18                 CLC
002775r 2  60                 RTS
002776r 2               
002776r 2               @not_found:
002776r 2  38                 SEC
002777r 2  60                 RTS
002778r 2               
002778r 2               ; ---------------------------------------------------------------------
002778r 2               ; var_names_equal — compare name at var_name_lo/hi against entry at var_entry
002778r 2               ;   The name source is length-prefixed (from token / quote).
002778r 2               ;   The entry stores: name_len at +2, chars at +3 (already uppercased).
002778r 2               ;   The source name chars are uppercased during comparison.
002778r 2               ;   Returns: Carry set = equal, Carry clear = not equal
002778r 2               ;   Clobbers: A, X, Y, ptr2
002778r 2               ; ---------------------------------------------------------------------
002778r 2               var_names_equal:
002778r 2                     ; Read source name length
002778r 2  A5 rr              LDA   var_name_lo
00277Ar 2  85 rr              STA   ptr2_lo
00277Cr 2  A5 rr              LDA   var_name_hi
00277Er 2  85 rr              STA   ptr2_hi
002780r 2  A0 00              LDY   #0
002782r 2  B1 rr              LDA   (ptr2_lo),Y          ; source name_len
002784r 2  AA                 TAX                         ; X = source name_len
002785r 2               
002785r 2                     ; Read entry name length
002785r 2  A5 rr              LDA   var_entry_lo
002787r 2  85 rr              STA   ptr2_lo
002789r 2  A5 rr              LDA   var_entry_hi
00278Br 2  85 rr              STA   ptr2_hi
00278Dr 2  A0 02              LDY   #VAR_NAME_LEN
00278Fr 2  B1 rr              LDA   (ptr2_lo),Y          ; entry name_len
002791r 2               
002791r 2                     ; Compare lengths
002791r 2  8E rr rr           STX   num_tmp_lo            ; save source length
002794r 2  CD rr rr           CMP   num_tmp_lo
002797r 2  D0 43              BNE   @ne
002799r 2               
002799r 2                     ; Lengths match — compare chars
002799r 2  E0 00              CPX   #0
00279Br 2  F0 3B              BEQ   @eq                   ; both zero-length — equal
00279Dr 2  A0 00              LDY   #0                    ; char index
00279Fr 2               
00279Fr 2               @cmp_loop:
00279Fr 2  DA                 PHX
0027A0r 2  5A                 PHY
0027A1r 2                     ; Read source char (var_name + 1 + Y)
0027A1r 2  A5 rr              LDA   var_name_lo
0027A3r 2  85 rr              STA   ptr2_lo
0027A5r 2  A5 rr              LDA   var_name_hi
0027A7r 2  85 rr              STA   ptr2_hi
0027A9r 2  98                 TYA
0027AAr 2  1A                 INC                         ; skip length byte
0027ABr 2  A8                 TAY
0027ACr 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
0027AEr 2                     ; Uppercase it
0027AEr 2  C9 61              CMP   #'a'
0027B0r 2  90 07              BCC   @noup
0027B2r 2  C9 7B              CMP   #'z'+1
0027B4r 2  B0 03              BCS   @noup
0027B6r 2  38                 SEC
0027B7r 2  E9 20              SBC   #$20
0027B9r 2               @noup:
0027B9r 2  8D rr rr           STA   num_tmp_hi            ; temp: uppercased source char
0027BCr 2               
0027BCr 2                     ; Read entry char (var_entry + VAR_NAME + Y)
0027BCr 2  7A                 PLY                         ; restore char index
0027BDr 2  5A                 PHY
0027BEr 2  A5 rr              LDA   var_entry_lo
0027C0r 2  85 rr              STA   ptr2_lo
0027C2r 2  A5 rr              LDA   var_entry_hi
0027C4r 2  85 rr              STA   ptr2_hi
0027C6r 2  98                 TYA
0027C7r 2  18                 CLC
0027C8r 2  69 03              ADC   #VAR_NAME
0027CAr 2  A8                 TAY
0027CBr 2  B1 rr              LDA   (ptr2_lo),Y          ; entry char (already uppercase)
0027CDr 2               
0027CDr 2  CD rr rr           CMP   num_tmp_hi
0027D0r 2                     ; 65C02: PLY/PLX clobber flags! Must branch BEFORE pulling.
0027D0r 2  D0 08              BNE   @ne_pull
0027D2r 2               
0027D2r 2  7A                 PLY
0027D3r 2  FA                 PLX
0027D4r 2  C8                 INY
0027D5r 2  CA                 DEX
0027D6r 2  D0 C7              BNE   @cmp_loop
0027D8r 2               
0027D8r 2               @eq:
0027D8r 2  38                 SEC                         ; equal
0027D9r 2  60                 RTS
0027DAr 2               
0027DAr 2               @ne_pull:
0027DAr 2  7A                 PLY                         ; clean up stack
0027DBr 2  FA                 PLX
0027DCr 2               @ne:
0027DCr 2  18                 CLC                         ; not equal
0027DDr 2  60                 RTS
0027DEr 2               
0027DEr 1                     .include "procedures.s"
0027DEr 2               ; procedures.s — user-defined procedure storage and invocation
0027DEr 2               ;
0027DEr 2               ; Procedure record layout (heap-allocated linked list):
0027DEr 2               ;   +0: next_lo
0027DEr 2               ;   +1: next_hi    (pointer to next procedure, or $0000)
0027DEr 2               ;   +2: name_len   (1 byte)
0027DEr 2               ;   +3..3+NL-1: name chars (uppercased)
0027DEr 2               ;   +3+NL: param_count (1 byte)
0027DEr 2               ;   For each param:
0027DEr 2               ;     1 byte: param_name_len
0027DEr 2               ;     N bytes: param_name chars (uppercased)
0027DEr 2               ;   After all params:
0027DEr 2               ;     2 bytes: body_len_lo, body_len_hi (16-bit)
0027DEr 2               ;     body_len bytes: body text (lines separated by $0A)
0027DEr 2               
0027DEr 2               ; =====================================================================
0027DEr 2               ; ZEROPAGE segment — procedure variables
0027DEr 2               ; =====================================================================
0027DEr 2                     .segment "ZEROPAGE"
00003Dr 2               
00003Dr 2  xx           proc_head_lo:     .res 1        ; head of procedure directory
00003Er 2  xx           proc_head_hi:     .res 1
00003Fr 2  xx           proc_entry_lo:    .res 1        ; current entry pointer (walk scratch)
000040r 2  xx           proc_entry_hi:    .res 1
000041r 2  xx           proc_ptr_lo:      .res 1        ; scratch pointer for proc operations
000042r 2  xx           proc_ptr_hi:      .res 1
000043r 2  xx           proc_body_len_lo: .res 1        ; body length during collection / invocation
000044r 2  xx           proc_body_len_hi: .res 1
000045r 2  xx           proc_param_cnt:   .res 1        ; param count during define / invoke
000046r 2  xx           proc_name_len:    .res 1        ; name length scratch
000047r 2  xx           proc_rec_off:     .res 1        ; offset into record during invoke
000048r 2               
000048r 2               ; =====================================================================
000048r 2               ; BSS segment — temporary buffers
000048r 2               ; =====================================================================
000048r 2                     .segment "BSS"
00000Fr 2               
00000Fr 2  xx xx xx xx  proc_body_buf:    .res 2048     ; editor text buffer: "TO ..\n<body>\nEND\n"
000013r 2  xx xx xx xx  
000017r 2  xx xx xx xx  
00080Fr 2  xx xx xx xx  proc_name_buf:    .res 32       ; procedure name: length-prefixed
000813r 2  xx xx xx xx  
000817r 2  xx xx xx xx  
00082Fr 2  xx xx xx xx  proc_param_buf:   .res 128      ; packed: count, [len,chars]... each param
000833r 2  xx xx xx xx  
000837r 2  xx xx xx xx  
0008AFr 2  xx           proc_param_end:   .res 1        ; write offset into proc_param_buf
0008B0r 2  xx xx xx xx  proc_editor_title:.res 36       ; "TO <name>" + NUL, passed to the shared editor
0008B4r 2  xx xx xx xx  
0008B8r 2  xx xx xx xx  
0008D4r 2  xx           proc_body_src_lo: .res 1        ; pointer to the body text proc_build_record copies
0008D5r 2  xx           proc_body_src_hi: .res 1
0008D6r 2  xx           proc_edit_cur_lo: .res 1        ; initial editor cursor offset (start of body line)
0008D7r 2  xx           proc_edit_cur_hi: .res 1
0008D8r 2  xx           proc_scan_off_lo: .res 1        ; 16-bit scan offset for body extraction
0008D9r 2  xx           proc_scan_off_hi: .res 1
0008DAr 2  xx           proc_brk_depth:   .res 1        ; bracket/paren nesting depth while accumulating a statement
0008DBr 2  xx           proc_tmp:         .res 1        ; scratch byte (EDIT record→buffer copy)
0008DCr 2               
0008DCr 2               ; Save area for eval state during procedure invocation
0008DCr 2  xx           save_eval_cur_lo: .res 1
0008DDr 2  xx           save_eval_cur_hi: .res 1
0008DEr 2  xx           save_tok_head_lo: .res 1
0008DFr 2  xx           save_tok_head_hi: .res 1
0008E0r 2  xx           save_tok_tail_lo: .res 1
0008E1r 2  xx           save_tok_tail_hi: .res 1
0008E2r 2  xx xx xx xx  save_input_buf:   .res 128      ; save outer input_buf during proc body exec
0008E6r 2  xx xx xx xx  
0008EAr 2  xx xx xx xx  
000962r 2  xx           save_heap_ptr_lo: .res 1        ; save heap for token re-use
000963r 2  xx           save_heap_ptr_hi: .res 1
000964r 2               
000964r 2               ; Param-binding scratch: length-prefixed name built here for var_set
000964r 2  xx xx xx xx  param_name_tmp:   .res 32
000968r 2  xx xx xx xx  
00096Cr 2  xx xx xx xx  
000984r 2               
000984r 2               ; =====================================================================
000984r 2               ; CODE segment — procedure routines
000984r 2               ; =====================================================================
000984r 2                     .segment "CODE"
0027DEr 2               
0027DEr 2               ; ---------------------------------------------------------------------
0027DEr 2               ; proc_init — initialize procedure directory to empty
0027DEr 2               ; ---------------------------------------------------------------------
0027DEr 2               proc_init:
0027DEr 2  64 rr              STZ   proc_head_lo
0027E0r 2  64 rr              STZ   proc_head_hi
0027E2r 2  64 rr              STZ   proc_stopped
0027E4r 2  60                 RTS
0027E5r 2               
0027E5r 2               ; ---------------------------------------------------------------------
0027E5r 2               ; proc_collect — enter TO/END multi-line collection mode
0027E5r 2               ;   Called from main_loop after detecting TO as first token.
0027E5r 2               ;   eval_cur_lo/hi has been advanced past the TO token.
0027E5r 2               ; ---------------------------------------------------------------------
0027E5r 2               proc_collect:
0027E5r 2                     ; Next token should be the procedure name (TOK_WORD)
0027E5r 2  A5 rr              LDA   eval_cur_lo
0027E7r 2  05 rr              ORA   eval_cur_hi
0027E9r 2  D0 03              BNE   @have_name
0027EBr 2  4C rr rr           JMP   @err_noname
0027EEr 2               @have_name:
0027EEr 2  A5 rr              LDA   eval_cur_lo
0027F0r 2  85 rr              STA   ptr_lo
0027F2r 2  A5 rr              LDA   eval_cur_hi
0027F4r 2  85 rr              STA   ptr_hi
0027F6r 2  A0 00              LDY   #TOK_TAG
0027F8r 2  B1 rr              LDA   (ptr_lo),Y
0027FAr 2  C9 01              CMP   #TOK_WORD
0027FCr 2  F0 03              BEQ   @name_ok
0027FEr 2  4C rr rr           JMP   @err_noname
002801r 2               @name_ok:
002801r 2                     ; Copy procedure name to proc_name_buf (length-prefixed)
002801r 2  A0 03              LDY   #TOK_PAYLOAD
002803r 2  B1 rr              LDA   (ptr_lo),Y           ; name length
002805r 2  8D rr rr           STA   proc_name_buf
002808r 2  85 rr              STA   proc_name_len
00280Ar 2  AA                 TAX                         ; X = char count
00280Br 2  A0 04              LDY   #TOK_PAYLOAD+1
00280Dr 2  A9 00              LDA   #0
00280Fr 2  85 rr              STA   proc_rec_off          ; dest index in name_buf
002811r 2               @copy_name:
002811r 2  E0 00              CPX   #0
002813r 2  F0 0F              BEQ   @name_copied
002815r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased by tokenizer
002817r 2  5A                 PHY
002818r 2  A4 rr              LDY   proc_rec_off
00281Ar 2  99 rr rr           STA   proc_name_buf+1,Y
00281Dr 2  E6 rr              INC   proc_rec_off
00281Fr 2  7A                 PLY
002820r 2  C8                 INY
002821r 2  CA                 DEX
002822r 2  80 ED              BRA   @copy_name
002824r 2               @name_copied:
002824r 2               
002824r 2                     ; Advance past the name token
002824r 2  20 rr rr           JSR   eval_advance
002827r 2               
002827r 2                     ; Parse parameter names (TOK_VARREF tokens: :SIZE :COLOR etc.)
002827r 2  64 rr              STZ   proc_param_cnt
002829r 2  A9 01              LDA   #1                    ; dest offset (skip count byte at [0])
00282Br 2  8D rr rr           STA   proc_param_end
00282Er 2               
00282Er 2               @parse_params:
00282Er 2  A5 rr              LDA   eval_cur_lo
002830r 2  05 rr              ORA   eval_cur_hi
002832r 2  F0 47              BEQ   @params_done
002834r 2  A5 rr              LDA   eval_cur_lo
002836r 2  85 rr              STA   ptr_lo
002838r 2  A5 rr              LDA   eval_cur_hi
00283Ar 2  85 rr              STA   ptr_hi
00283Cr 2  A0 00              LDY   #TOK_TAG
00283Er 2  B1 rr              LDA   (ptr_lo),Y
002840r 2  C9 05              CMP   #TOK_VARREF
002842r 2  D0 37              BNE   @params_done
002844r 2               
002844r 2  E6 rr              INC   proc_param_cnt
002846r 2  A0 03              LDY   #TOK_PAYLOAD
002848r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
00284Ar 2  AE rr rr           LDX   proc_param_end
00284Dr 2  9D rr rr           STA   proc_param_buf,X     ; store length
002850r 2  E8                 INX
002851r 2  A8                 TAY                         ; Y = char count to copy
002852r 2  64 rr              STZ   proc_rec_off          ; source char index
002854r 2               
002854r 2               @copy_param_ch:
002854r 2  C0 00              CPY   #0
002856r 2  F0 1B              BEQ   @param_ch_done
002858r 2                     ; Read source char from token
002858r 2  A5 rr              LDA   eval_cur_lo
00285Ar 2  85 rr              STA   ptr_lo
00285Cr 2  A5 rr              LDA   eval_cur_hi
00285Er 2  85 rr              STA   ptr_hi
002860r 2  5A                 PHY
002861r 2  A5 rr              LDA   proc_rec_off
002863r 2  18                 CLC
002864r 2  69 04              ADC   #TOK_PAYLOAD+1
002866r 2  A8                 TAY
002867r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased
002869r 2  7A                 PLY
00286Ar 2                     ; Write to proc_param_buf
00286Ar 2  9D rr rr           STA   proc_param_buf,X
00286Dr 2  E8                 INX
00286Er 2  E6 rr              INC   proc_rec_off
002870r 2  88                 DEY
002871r 2  80 E1              BRA   @copy_param_ch
002873r 2               @param_ch_done:
002873r 2  8E rr rr           STX   proc_param_end
002876r 2               
002876r 2  20 rr rr           JSR   eval_advance
002879r 2  80 B3              BRA   @parse_params
00287Br 2               
00287Br 2               @params_done:
00287Br 2  A5 rr              LDA   proc_param_cnt
00287Dr 2  8D rr rr           STA   proc_param_buf        ; count byte at [0]
002880r 2               
002880r 2                     ; Initialize body buffer
002880r 2  64 rr              STZ   proc_body_len_lo
002882r 2  64 rr              STZ   proc_body_len_hi
002884r 2               
002884r 2                     ; Open the shared EDITUI editor on an empty body buffer. Carry set means
002884r 2                     ; the user asked to save (Ctrl-S / "Save First") before exiting.
002884r 2  20 rr rr           JSR   proc_open_editor
002887r 2  B0 01              BCS   @body_done
002889r 2  60                 RTS
00288Ar 2               
00288Ar 2                     ; Print "NAME DEFINED\n"
00288Ar 2               @body_done:
00288Ar 2  20 rr rr           JSR   proc_print_defined
00288Dr 2  60                 RTS
00288Er 2               
00288Er 2               @err_noname:
00288Er 2  20 rr rr           JSR   print_inl
002891r 2  54 4F 20 4E        .byte "TO NEEDS A NAME", 0
002895r 2  45 45 44 53  
002899r 2  20 41 20 4E  
0028A1r 2  20 rr rr           JSR   eval_newline
0028A4r 2  60                 RTS
0028A5r 2               
0028A5r 2               ; ---------------------------------------------------------------------
0028A5r 2               ; proc_print_defined — print "<name> DEFINED\n" (name from proc_name_buf).
0028A5r 2               ; ---------------------------------------------------------------------
0028A5r 2               proc_print_defined:
0028A5r 2  A6 rr              LDX   proc_name_len
0028A7r 2  A0 00              LDY   #0
0028A9r 2               @pn:
0028A9r 2  E0 00              CPX   #0
0028ABr 2  F0 0A              BEQ   @pd
0028ADr 2  B9 rr rr           LDA   proc_name_buf+1,Y
0028B0r 2  8D 0E A0           STA   VGC_CHAROUT
0028B3r 2  C8                 INY
0028B4r 2  CA                 DEX
0028B5r 2  80 F2              BRA   @pn
0028B7r 2               @pd:
0028B7r 2  20 rr rr           JSR   print_inl
0028BAr 2  20 44 45 46        .byte " DEFINED", 0
0028BEr 2  49 4E 45 44  
0028C2r 2  00           
0028C3r 2  20 rr rr           JSR   eval_newline
0028C6r 2  60                 RTS
0028C7r 2               
0028C7r 2               ; ---------------------------------------------------------------------
0028C7r 2               ; proc_build_header — write the "TO <name> :params" first line into
0028C7r 2               ;   proc_body_buf (no trailing newline). Built with 8-bit Y since the header
0028C7r 2               ;   is always < 256 bytes (name<=31, params<=127). Returns Y = header length.
0028C7r 2               ;   Inputs: proc_name_buf/proc_name_len, proc_param_buf/proc_param_end.
0028C7r 2               ; ---------------------------------------------------------------------
0028C7r 2               proc_build_header:
0028C7r 2  A0 00              LDY   #0
0028C9r 2  A9 54              LDA   #'T'
0028CBr 2  99 rr rr           STA   proc_body_buf,Y
0028CEr 2  C8                 INY
0028CFr 2  A9 4F              LDA   #'O'
0028D1r 2  99 rr rr           STA   proc_body_buf,Y
0028D4r 2  C8                 INY
0028D5r 2  A9 20              LDA   #' '
0028D7r 2  99 rr rr           STA   proc_body_buf,Y
0028DAr 2  C8                 INY
0028DBr 2  A2 00              LDX   #0                     ; name source index
0028DDr 2               @nm:
0028DDr 2  E4 rr              CPX   proc_name_len
0028DFr 2  B0 0A              BCS   @nm_done
0028E1r 2  BD rr rr           LDA   proc_name_buf+1,X
0028E4r 2  99 rr rr           STA   proc_body_buf,Y
0028E7r 2  C8                 INY
0028E8r 2  E8                 INX
0028E9r 2  80 F2              BRA   @nm
0028EBr 2               @nm_done:
0028EBr 2                     ; params: " :" + chars, walking proc_param_buf[1..proc_param_end)
0028EBr 2  A2 01              LDX   #1
0028EDr 2               @pp:
0028EDr 2  EC rr rr           CPX   proc_param_end
0028F0r 2  B0 22              BCS   @pp_done
0028F2r 2  A9 20              LDA   #' '
0028F4r 2  99 rr rr           STA   proc_body_buf,Y
0028F7r 2  C8                 INY
0028F8r 2  A9 3A              LDA   #':'
0028FAr 2  99 rr rr           STA   proc_body_buf,Y
0028FDr 2  C8                 INY
0028FEr 2  BD rr rr           LDA   proc_param_buf,X       ; this param's char count
002901r 2  85 rr              STA   proc_rec_off
002903r 2  E8                 INX
002904r 2               @ppc:
002904r 2  A5 rr              LDA   proc_rec_off
002906r 2  F0 E5              BEQ   @pp
002908r 2  BD rr rr           LDA   proc_param_buf,X
00290Br 2  99 rr rr           STA   proc_body_buf,Y
00290Er 2  C8                 INY
00290Fr 2  E8                 INX
002910r 2  C6 rr              DEC   proc_rec_off
002912r 2  80 F0              BRA   @ppc
002914r 2               @pp_done:
002914r 2  60                 RTS
002915r 2               
002915r 2               proc_open_editor:
002915r 2                     ; build "TO <name> :params" header, then append an empty body "  ".
002915r 2  20 rr rr           JSR   proc_build_header
002918r 2                     ; Y = line-1 length. The body line is line 1's '\n' + 2 indent spaces,
002918r 2                     ; so the cursor lands at offset (line1 + 3).
002918r 2  98                 TYA
002919r 2  18                 CLC
00291Ar 2  69 03              ADC   #3
00291Cr 2  8D rr rr           STA   proc_edit_cur_lo
00291Fr 2  A9 00              LDA   #0
002921r 2  69 00              ADC   #0
002923r 2  8D rr rr           STA   proc_edit_cur_hi
002926r 2                     ; append "\n  \nEND\n"
002926r 2  A9 0A              LDA   #$0A
002928r 2  99 rr rr           STA   proc_body_buf,Y
00292Br 2  C8                 INY
00292Cr 2  A9 20              LDA   #' '
00292Er 2  99 rr rr           STA   proc_body_buf,Y
002931r 2  C8                 INY
002932r 2  99 rr rr           STA   proc_body_buf,Y
002935r 2  C8                 INY
002936r 2  A9 0A              LDA   #$0A
002938r 2  99 rr rr           STA   proc_body_buf,Y
00293Br 2  C8                 INY
00293Cr 2  A9 45              LDA   #'E'
00293Er 2  99 rr rr           STA   proc_body_buf,Y
002941r 2  C8                 INY
002942r 2  A9 4E              LDA   #'N'
002944r 2  99 rr rr           STA   proc_body_buf,Y
002947r 2  C8                 INY
002948r 2  A9 44              LDA   #'D'
00294Ar 2  99 rr rr           STA   proc_body_buf,Y
00294Dr 2  C8                 INY
00294Er 2  A9 0A              LDA   #$0A
002950r 2  99 rr rr           STA   proc_body_buf,Y
002953r 2  C8                 INY
002954r 2  84 rr              STY   proc_body_len_lo
002956r 2  64 rr              STZ   proc_body_len_hi
002958r 2               
002958r 2               ; ---------------------------------------------------------------------
002958r 2               ; proc_edit_run — shared tail: build the editor title, hand proc_body_buf
002958r 2               ;   (with proc_body_len + proc_edit_cur already set) to the EDITUI editor, and
002958r 2               ;   on save extract the body + (re)build the procedure record.
002958r 2               ;   Returns: carry set = saved, carry clear = abandoned.
002958r 2               ; ---------------------------------------------------------------------
002958r 2               proc_edit_run:
002958r 2                     ; --- title "TO <name>" + NUL for the editor's title band ---
002958r 2  A9 54              LDA   #'T'
00295Ar 2  8D rr rr           STA   proc_editor_title+0
00295Dr 2  A9 4F              LDA   #'O'
00295Fr 2  8D rr rr           STA   proc_editor_title+1
002962r 2  A9 20              LDA   #' '
002964r 2  8D rr rr           STA   proc_editor_title+2
002967r 2  A2 00              LDX   #0
002969r 2  A0 03              LDY   #3
00296Br 2               @tt:
00296Br 2  E4 rr              CPX   proc_name_len
00296Dr 2  B0 0A              BCS   @tt_done
00296Fr 2  BD rr rr           LDA   proc_name_buf+1,X
002972r 2  99 rr rr           STA   proc_editor_title,Y
002975r 2  E8                 INX
002976r 2  C8                 INY
002977r 2  80 F2              BRA   @tt
002979r 2               @tt_done:
002979r 2  A9 00              LDA   #0
00297Br 2  99 rr rr           STA   proc_editor_title,Y
00297Er 2               
00297Er 2                     ; --- mailbox: ARG0=buf ARG1=len ARG2=cap ARG3=title; cursor in FRAC bytes
00297Er 2  A9 rr              LDA   #<proc_body_buf
002980r 2  85 84              STA   EXT_ARG0_LO
002982r 2  A9 rr              LDA   #>proc_body_buf
002984r 2  85 83              STA   EXT_ARG0_HI
002986r 2  A5 rr              LDA   proc_body_len_lo
002988r 2  85 88              STA   EXT_ARG1_LO
00298Ar 2  A5 rr              LDA   proc_body_len_hi
00298Cr 2  85 87              STA   EXT_ARG1_HI
00298Er 2  A9 00              LDA   #<2048
002990r 2  85 8C              STA   EXT_ARG2_LO
002992r 2  A9 08              LDA   #>2048
002994r 2  85 8B              STA   EXT_ARG2_HI
002996r 2  A9 rr              LDA   #<proc_editor_title
002998r 2  85 A1              STA   EXT_ARG3_LO
00299Ar 2  A9 rr              LDA   #>proc_editor_title
00299Cr 2  85 A0              STA   EXT_ARG3_HI
00299Er 2  AD rr rr           LDA   proc_edit_cur_lo
0029A1r 2  85 8D              STA   EXT_ARG2_FRAC          ; initial cursor offset (see ext_iface.inc)
0029A3r 2  AD rr rr           LDA   proc_edit_cur_hi
0029A6r 2  85 A2              STA   EXT_ARG3_FRAC
0029A8r 2               
0029A8r 2  A9 4B              LDA   #EXT_CMD_EDIT
0029AAr 2  85 80              STA   EXT_CMD
0029ACr 2  20 rr rr           JSR   ensure_ext_resident    ; re-page host ext into bank 1 if a module clobbered it
0029AFr 2  20 70 02           JSR   EXT_TRAMPOLINE         ; swap to ext ROM, run editor, swap back
0029B2r 2               
0029B2r 2                     ; editor returns the final buffer length in ARG1
0029B2r 2  A5 88              LDA   EXT_ARG1_LO
0029B4r 2  85 rr              STA   proc_body_len_lo
0029B6r 2  A5 87              LDA   EXT_ARG1_HI
0029B8r 2  85 rr              STA   proc_body_len_hi
0029BAr 2               
0029BAr 2  A5 8F              LDA   EXT_RESULT_HI
0029BCr 2  F0 08              BEQ   @abandoned
0029BEr 2                     ; Strip line 1 + the END line -> proc_body_src/proc_body_len = body only.
0029BEr 2  20 rr rr           JSR   proc_extract_body
0029C1r 2  20 rr rr           JSR   proc_build_record
0029C4r 2  38                 SEC
0029C5r 2  60                 RTS
0029C6r 2               @abandoned:
0029C6r 2  18                 CLC
0029C7r 2  60                 RTS
0029C8r 2               
0029C8r 2               ; ---------------------------------------------------------------------
0029C8r 2               ; proc_buf_put — append A to proc_body_buf at ptr2, advancing ptr2 and the
0029C8r 2               ;   16-bit proc_body_len counter. Preserves A; clobbers Y.
0029C8r 2               ; ---------------------------------------------------------------------
0029C8r 2               proc_buf_put:
0029C8r 2  A0 00              LDY   #0
0029CAr 2  91 rr              STA   (ptr2_lo),Y
0029CCr 2  E6 rr              INC   ptr2_lo
0029CEr 2  D0 02              BNE   :+
0029D0r 2  E6 rr              INC   ptr2_hi
0029D2r 2  E6 rr        :     INC   proc_body_len_lo
0029D4r 2  D0 02              BNE   :+
0029D6r 2  E6 rr              INC   proc_body_len_hi
0029D8r 2  60           :     RTS
0029D9r 2               
0029D9r 2               ; ---------------------------------------------------------------------
0029D9r 2               ; proc_record_to_buffers — unpack the procedure record at proc_entry into the
0029D9r 2               ;   collect buffers so it can be edited and rebuilt:
0029D9r 2               ;     proc_name_buf/proc_name_len, proc_param_buf/proc_param_cnt/proc_param_end,
0029D9r 2               ;     and proc_body_src/proc_body_len = the record's body text (ptr + length).
0029D9r 2               ;   The name+param region is < 256 bytes so 8-bit Y indexing is safe there.
0029D9r 2               ; ---------------------------------------------------------------------
0029D9r 2               proc_record_to_buffers:
0029D9r 2  A5 rr              LDA   proc_entry_lo
0029DBr 2  85 rr              STA   ptr_lo
0029DDr 2  A5 rr              LDA   proc_entry_hi
0029DFr 2  85 rr              STA   ptr_hi
0029E1r 2                     ; --- name (record +2 = len, +3.. = chars) ---
0029E1r 2  A0 02              LDY   #2
0029E3r 2  B1 rr              LDA   (ptr_lo),Y
0029E5r 2  8D rr rr           STA   proc_name_buf
0029E8r 2  85 rr              STA   proc_name_len
0029EAr 2  C8                 INY                         ; Y=3 -> first name char
0029EBr 2  A2 00              LDX   #0
0029EDr 2               @rb_nm:
0029EDr 2  E4 rr              CPX   proc_name_len
0029EFr 2  B0 09              BCS   @rb_nm_done
0029F1r 2  B1 rr              LDA   (ptr_lo),Y
0029F3r 2  9D rr rr           STA   proc_name_buf+1,X
0029F6r 2  C8                 INY
0029F7r 2  E8                 INX
0029F8r 2  80 F3              BRA   @rb_nm
0029FAr 2               @rb_nm_done:
0029FAr 2                     ; --- param_count then packed params ---
0029FAr 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
0029FCr 2  85 rr              STA   proc_param_cnt
0029FEr 2  8D rr rr           STA   proc_param_buf        ; [0] = count
002A01r 2  8D rr rr           STA   proc_tmp              ; remaining params
002A04r 2  C8                 INY                         ; Y -> first param len
002A05r 2  A2 01              LDX   #1                    ; dest index into proc_param_buf
002A07r 2               @rb_param:
002A07r 2  AD rr rr           LDA   proc_tmp
002A0Ar 2  F0 1B              BEQ   @rb_params_done
002A0Cr 2  CE rr rr           DEC   proc_tmp
002A0Fr 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002A11r 2  9D rr rr           STA   proc_param_buf,X
002A14r 2  85 rr              STA   proc_rec_off          ; char counter
002A16r 2  C8                 INY
002A17r 2  E8                 INX
002A18r 2               @rb_pchars:
002A18r 2  A5 rr              LDA   proc_rec_off
002A1Ar 2  F0 EB              BEQ   @rb_param
002A1Cr 2  C6 rr              DEC   proc_rec_off
002A1Er 2  B1 rr              LDA   (ptr_lo),Y
002A20r 2  9D rr rr           STA   proc_param_buf,X
002A23r 2  C8                 INY
002A24r 2  E8                 INX
002A25r 2  80 F1              BRA   @rb_pchars
002A27r 2               @rb_params_done:
002A27r 2  8E rr rr           STX   proc_param_end
002A2Ar 2                     ; Y -> body_len_lo within the record. Compute absolute pointer.
002A2Ar 2  98                 TYA
002A2Br 2  18                 CLC
002A2Cr 2  65 rr              ADC   proc_entry_lo
002A2Er 2  85 rr              STA   ptr_lo
002A30r 2  A5 rr              LDA   proc_entry_hi
002A32r 2  69 00              ADC   #0
002A34r 2  85 rr              STA   ptr_hi               ; ptr -> body_len_lo
002A36r 2  A0 00              LDY   #0
002A38r 2  B1 rr              LDA   (ptr_lo),Y
002A3Ar 2  85 rr              STA   proc_body_len_lo     ; record body length
002A3Cr 2  C8                 INY
002A3Dr 2  B1 rr              LDA   (ptr_lo),Y
002A3Fr 2  85 rr              STA   proc_body_len_hi
002A41r 2  18                 CLC                         ; body src = ptr + 2
002A42r 2  A5 rr              LDA   ptr_lo
002A44r 2  69 02              ADC   #2
002A46r 2  8D rr rr           STA   proc_body_src_lo
002A49r 2  A5 rr              LDA   ptr_hi
002A4Br 2  69 00              ADC   #0
002A4Dr 2  8D rr rr           STA   proc_body_src_hi
002A50r 2  60                 RTS
002A51r 2               
002A51r 2               ; ---------------------------------------------------------------------
002A51r 2               ; proc_edit_reconstruct — build the full editable text "TO <name> :params\n
002A51r 2               ;   <body>END\n" into proc_body_buf from the collect buffers + the record body
002A51r 2               ;   (proc_body_src/proc_body_len set by proc_record_to_buffers). Sets
002A51r 2               ;   proc_body_len = total buffer length and proc_edit_cur = start of the body.
002A51r 2               ; ---------------------------------------------------------------------
002A51r 2               proc_edit_reconstruct:
002A51r 2                     ; Save the record body src/len before proc_body_len is repurposed.
002A51r 2  AD rr rr           LDA   proc_body_src_lo
002A54r 2  85 rr              STA   proc_ptr_lo
002A56r 2  AD rr rr           LDA   proc_body_src_hi
002A59r 2  85 rr              STA   proc_ptr_hi
002A5Br 2  A5 rr              LDA   proc_body_len_lo
002A5Dr 2  8D rr rr           STA   num_tmp_lo
002A60r 2  A5 rr              LDA   proc_body_len_hi
002A62r 2  8D rr rr           STA   num_tmp_hi
002A65r 2                     ; Header "TO name params" (8-bit), then a newline.
002A65r 2  20 rr rr           JSR   proc_build_header     ; Y = header length
002A68r 2  A9 0A              LDA   #$0A
002A6Ar 2  99 rr rr           STA   proc_body_buf,Y
002A6Dr 2  C8                 INY                         ; Y = body-line start offset
002A6Er 2  8C rr rr           STY   proc_edit_cur_lo
002A71r 2  9C rr rr           STZ   proc_edit_cur_hi
002A74r 2  84 rr              STY   proc_body_len_lo
002A76r 2  64 rr              STZ   proc_body_len_hi
002A78r 2                     ; dest pointer ptr2 = proc_body_buf + Y
002A78r 2  98                 TYA
002A79r 2  18                 CLC
002A7Ar 2  69 rr              ADC   #<proc_body_buf
002A7Cr 2  85 rr              STA   ptr2_lo
002A7Er 2  A9 rr              LDA   #>proc_body_buf
002A80r 2  69 00              ADC   #0
002A82r 2  85 rr              STA   ptr2_hi
002A84r 2                     ; copy the record body (num_tmp bytes from proc_ptr)
002A84r 2               @rc_body:
002A84r 2  AD rr rr           LDA   num_tmp_lo
002A87r 2  0D rr rr           ORA   num_tmp_hi
002A8Ar 2  F0 1A              BEQ   @rc_body_done
002A8Cr 2  A0 00              LDY   #0
002A8Er 2  B1 rr              LDA   (proc_ptr_lo),Y
002A90r 2  20 rr rr           JSR   proc_buf_put
002A93r 2  E6 rr              INC   proc_ptr_lo
002A95r 2  D0 02              BNE   :+
002A97r 2  E6 rr              INC   proc_ptr_hi
002A99r 2  AD rr rr     :     LDA   num_tmp_lo
002A9Cr 2  D0 03              BNE   @rc_dec
002A9Er 2  CE rr rr           DEC   num_tmp_hi
002AA1r 2               @rc_dec:
002AA1r 2  CE rr rr           DEC   num_tmp_lo
002AA4r 2  80 DE              BRA   @rc_body
002AA6r 2               @rc_body_done:
002AA6r 2                     ; append "END" + newline
002AA6r 2  A9 45              LDA   #'E'
002AA8r 2  20 rr rr           JSR   proc_buf_put
002AABr 2  A9 4E              LDA   #'N'
002AADr 2  20 rr rr           JSR   proc_buf_put
002AB0r 2  A9 44              LDA   #'D'
002AB2r 2  20 rr rr           JSR   proc_buf_put
002AB5r 2  A9 0A              LDA   #$0A
002AB7r 2  20 rr rr           JSR   proc_buf_put
002ABAr 2  60                 RTS
002ABBr 2               
002ABBr 2               ; ---------------------------------------------------------------------
002ABBr 2               ; proc_edit — handle "EDIT <name>" / "ED <name>". eval_cur is at the name
002ABBr 2               ;   token. If the procedure exists, reopen it in the editor pre-filled with its
002ABBr 2               ;   current definition; otherwise fall back to the TO collector (create it).
002ABBr 2               ; ---------------------------------------------------------------------
002ABBr 2               proc_edit:
002ABBr 2  A5 rr              LDA   eval_cur_lo
002ABDr 2  05 rr              ORA   eval_cur_hi
002ABFr 2  F0 14              BEQ   @to_collect
002AC1r 2  20 rr rr           JSR   proc_lookup
002AC4r 2  B0 0F              BCS   @to_collect          ; unknown -> create via the TO collector
002AC6r 2  20 rr rr           JSR   proc_record_to_buffers
002AC9r 2  20 rr rr           JSR   proc_edit_reconstruct
002ACCr 2  20 rr rr           JSR   proc_edit_run
002ACFr 2  90 03              BCC   @done                ; abandoned
002AD1r 2  20 rr rr           JSR   proc_print_defined
002AD4r 2               @done:
002AD4r 2  60                 RTS
002AD5r 2               @to_collect:
002AD5r 2  4C rr rr           JMP   proc_collect
002AD8r 2               
002AD8r 2               ; ---------------------------------------------------------------------
002AD8r 2               ; proc_extract_body — narrow proc_body_buf/proc_body_len down to just the body:
002AD8r 2               ;   everything after the first '\n' (line 1) up to (not including) the line that
002AD8r 2               ;   reads "END". Sets proc_body_src_lo/hi + proc_body_len_lo/hi.
002AD8r 2               ; ---------------------------------------------------------------------
002AD8r 2               proc_extract_body:
002AD8r 2  A9 rr              LDA   #<proc_body_buf
002ADAr 2  85 rr              STA   proc_ptr_lo
002ADCr 2  A9 rr              LDA   #>proc_body_buf
002ADEr 2  85 rr              STA   proc_ptr_hi
002AE0r 2  9C rr rr           STZ   proc_scan_off_lo
002AE3r 2  9C rr rr           STZ   proc_scan_off_hi
002AE6r 2               @find_nl:
002AE6r 2  20 rr rr           JSR   proc_scan_at_end
002AE9r 2  B0 4F              BCS   @whole                ; no newline -> whole buffer is the body
002AEBr 2  A0 00              LDY   #0
002AEDr 2  B1 rr              LDA   (proc_ptr_lo),Y
002AEFr 2  20 rr rr           JSR   proc_scan_advance
002AF2r 2  C9 0A              CMP   #$0A
002AF4r 2  D0 F0              BNE   @find_nl
002AF6r 2                     ; body starts here
002AF6r 2  A5 rr              LDA   proc_ptr_lo
002AF8r 2  8D rr rr           STA   proc_body_src_lo
002AFBr 2  A5 rr              LDA   proc_ptr_hi
002AFDr 2  8D rr rr           STA   proc_body_src_hi
002B00r 2  AD rr rr           LDA   proc_scan_off_lo
002B03r 2  8D rr rr           STA   num_tmp_lo            ; body-start offset
002B06r 2  AD rr rr           LDA   proc_scan_off_hi
002B09r 2  8D rr rr           STA   num_tmp_hi
002B0Cr 2               @line:
002B0Cr 2  20 rr rr           JSR   proc_scan_at_end
002B0Fr 2  B0 17              BCS   @body_end             ; ran off the end -> body = rest
002B11r 2  20 rr rr           JSR   proc_line_is_end
002B14r 2  B0 12              BCS   @body_end             ; this line is "END" -> stop
002B16r 2               @skip:
002B16r 2  20 rr rr           JSR   proc_scan_at_end
002B19r 2  B0 0D              BCS   @body_end
002B1Br 2  A0 00              LDY   #0
002B1Dr 2  B1 rr              LDA   (proc_ptr_lo),Y
002B1Fr 2  20 rr rr           JSR   proc_scan_advance
002B22r 2  C9 0A              CMP   #$0A
002B24r 2  D0 F0              BNE   @skip
002B26r 2  80 E4              BRA   @line
002B28r 2               @body_end:
002B28r 2  38                 SEC
002B29r 2  AD rr rr           LDA   proc_scan_off_lo
002B2Cr 2  ED rr rr           SBC   num_tmp_lo
002B2Fr 2  85 rr              STA   proc_body_len_lo
002B31r 2  AD rr rr           LDA   proc_scan_off_hi
002B34r 2  ED rr rr           SBC   num_tmp_hi
002B37r 2  85 rr              STA   proc_body_len_hi
002B39r 2  60                 RTS
002B3Ar 2               @whole:
002B3Ar 2  A9 rr              LDA   #<proc_body_buf
002B3Cr 2  8D rr rr           STA   proc_body_src_lo
002B3Fr 2  A9 rr              LDA   #>proc_body_buf
002B41r 2  8D rr rr           STA   proc_body_src_hi
002B44r 2  60                 RTS
002B45r 2               
002B45r 2               ; carry set if proc_scan_off >= proc_body_len
002B45r 2               proc_scan_at_end:
002B45r 2  AD rr rr           LDA   proc_scan_off_lo
002B48r 2  C5 rr              CMP   proc_body_len_lo
002B4Ar 2  AD rr rr           LDA   proc_scan_off_hi
002B4Dr 2  E5 rr              SBC   proc_body_len_hi
002B4Fr 2  60                 RTS
002B50r 2               
002B50r 2               ; advance the scan pointer + offset by one byte
002B50r 2               proc_scan_advance:
002B50r 2  E6 rr              INC   proc_ptr_lo
002B52r 2  D0 02              BNE   :+
002B54r 2  E6 rr              INC   proc_ptr_hi
002B56r 2  EE rr rr     :     INC   proc_scan_off_lo
002B59r 2  D0 03              BNE   :+
002B5Br 2  EE rr rr           INC   proc_scan_off_hi
002B5Er 2  60           :     RTS
002B5Fr 2               
002B5Fr 2               ; proc_line_is_end — carry set if the line at proc_ptr is exactly "END" followed
002B5Fr 2               ; by '\n' or end-of-buffer. Needs room for 3 chars (off+3 <= len). Non-destructive.
002B5Fr 2               proc_line_is_end:
002B5Fr 2                     ; proc_entry = proc_scan_off + 3
002B5Fr 2  18                 CLC
002B60r 2  AD rr rr           LDA   proc_scan_off_lo
002B63r 2  69 03              ADC   #3
002B65r 2  85 rr              STA   proc_entry_lo
002B67r 2  AD rr rr           LDA   proc_scan_off_hi
002B6Ar 2  69 00              ADC   #0
002B6Cr 2  85 rr              STA   proc_entry_hi
002B6Er 2                     ; need off+3 <= len, i.e. NOT (off+3 > len) == NOT (len < off+3)
002B6Er 2  A5 rr              LDA   proc_body_len_lo
002B70r 2  C5 rr              CMP   proc_entry_lo
002B72r 2  A5 rr              LDA   proc_body_len_hi
002B74r 2  E5 rr              SBC   proc_entry_hi
002B76r 2  90 2B              BCC   @no                   ; len < off+3 -> not enough room
002B78r 2  A0 00              LDY   #0
002B7Ar 2  B1 rr              LDA   (proc_ptr_lo),Y
002B7Cr 2  C9 45              CMP   #'E'
002B7Er 2  D0 23              BNE   @no
002B80r 2  C8                 INY
002B81r 2  B1 rr              LDA   (proc_ptr_lo),Y
002B83r 2  C9 4E              CMP   #'N'
002B85r 2  D0 1C              BNE   @no
002B87r 2  C8                 INY
002B88r 2  B1 rr              LDA   (proc_ptr_lo),Y
002B8Ar 2  C9 44              CMP   #'D'
002B8Cr 2  D0 15              BNE   @no
002B8Er 2                     ; 4th byte: '\n', or off+3 == len (END at buffer end)
002B8Er 2  A5 rr              LDA   proc_entry_lo
002B90r 2  C5 rr              CMP   proc_body_len_lo
002B92r 2  D0 06              BNE   @check_nl
002B94r 2  A5 rr              LDA   proc_entry_hi
002B96r 2  C5 rr              CMP   proc_body_len_hi
002B98r 2  F0 07              BEQ   @yes                  ; off+3 == len
002B9Ar 2               @check_nl:
002B9Ar 2  C8                 INY
002B9Br 2  B1 rr              LDA   (proc_ptr_lo),Y
002B9Dr 2  C9 0A              CMP   #$0A
002B9Fr 2  D0 02              BNE   @no
002BA1r 2               @yes:
002BA1r 2  38                 SEC
002BA2r 2  60                 RTS
002BA3r 2               @no:
002BA3r 2  18                 CLC
002BA4r 2  60                 RTS
002BA5r 2               
002BA5r 2               ; ---------------------------------------------------------------------
002BA5r 2               ; heap_alloc_big — allocate for procedure records (16-bit payload)
002BA5r 2               ;   Input:  proc_ptr_lo/hi = record data size (16-bit)
002BA5r 2               ;   Output: proc_entry_lo/hi = pointer to record data (payload+2)
002BA5r 2               ;           Carry clear = success, Carry set = OOM
002BA5r 2               ;
002BA5r 2               ;   Layout: [GC_HDR_TAG, GC_HDR_SIZE=0, total_lo, total_hi, ...data...]
002BA5r 2               ;   GC header (2 bytes) + 16-bit size (2 bytes) + record data.
002BA5r 2               ;   Total allocation = record_data_size + 4.
002BA5r 2               ;   GC_HDR_SIZE = 0 tells GC to read 16-bit total from payload[0..1].
002BA5r 2               ;   proc_entry points to data (base+4).
002BA5r 2               ;
002BA5r 2               ;   Clobbers: A, Y, ptr_lo/hi
002BA5r 2               ; ---------------------------------------------------------------------
002BA5r 2               heap_alloc_big:
002BA5r 2                     ; Total allocation = data_size + 4 (2 hdr + 2 size field)
002BA5r 2  18                 CLC
002BA6r 2  A5 rr              LDA   proc_ptr_lo
002BA8r 2  69 04              ADC   #4
002BAAr 2  48                 PHA                        ; save total_lo
002BABr 2  A5 rr              LDA   proc_ptr_hi
002BADr 2  69 00              ADC   #0
002BAFr 2  48                 PHA                        ; save total_hi
002BB0r 2               
002BB0r 2                     ; Save current heap_ptr as base
002BB0r 2  A5 rr              LDA   heap_ptr
002BB2r 2  85 rr              STA   proc_entry_lo
002BB4r 2  A5 rr              LDA   heap_ptr+1
002BB6r 2  85 rr              STA   proc_entry_hi
002BB8r 2               
002BB8r 2                     ; Advance heap_ptr by total
002BB8r 2  BA                 TSX
002BB9r 2  18                 CLC
002BBAr 2  A5 rr              LDA   heap_ptr
002BBCr 2  7D 02 01           ADC   $0102,X              ; total_lo
002BBFr 2  85 rr              STA   heap_ptr
002BC1r 2  A5 rr              LDA   heap_ptr+1
002BC3r 2  7D 01 01           ADC   $0101,X              ; total_hi
002BC6r 2  85 rr              STA   heap_ptr+1
002BC8r 2               
002BC8r 2                     ; OOM check
002BC8r 2  C9 98              CMP   #>HEAP_END
002BCAr 2  90 16              BCC   @big_ok
002BCCr 2  D0 08              BNE   @big_oom
002BCEr 2  A5 rr              LDA   heap_ptr
002BD0r 2  C9 00              CMP   #<HEAP_END
002BD2r 2  90 0E              BCC   @big_ok
002BD4r 2  F0 0C              BEQ   @big_ok
002BD6r 2               @big_oom:
002BD6r 2  A5 rr              LDA   proc_entry_lo
002BD8r 2  85 rr              STA   heap_ptr
002BDAr 2  A5 rr              LDA   proc_entry_hi
002BDCr 2  85 rr              STA   heap_ptr+1
002BDEr 2  68                 PLA
002BDFr 2  68                 PLA
002BE0r 2  38                 SEC
002BE1r 2  60                 RTS
002BE2r 2               @big_ok:
002BE2r 2                     ; Write header at base (proc_entry = base here)
002BE2r 2  A5 rr              LDA   proc_entry_lo
002BE4r 2  85 rr              STA   ptr_lo
002BE6r 2  A5 rr              LDA   proc_entry_hi
002BE8r 2  85 rr              STA   ptr_hi
002BEAr 2               
002BEAr 2  A0 00              LDY   #GC_HDR_TAG
002BECr 2  A9 04              LDA   #ATYPE_PROC
002BEEr 2  91 rr              STA   (ptr_lo),Y
002BF0r 2               
002BF0r 2  A0 01              LDY   #GC_HDR_SIZE
002BF2r 2  A9 00              LDA   #0                    ; 0 = 16-bit size at payload[0..1]
002BF4r 2  91 rr              STA   (ptr_lo),Y
002BF6r 2               
002BF6r 2                     ; Write 16-bit total at payload offsets 0,1 (base+2, base+3)
002BF6r 2  68                 PLA                        ; total_hi
002BF7r 2  A0 03              LDY   #GC_HDR_BYTES+1       ; base+3
002BF9r 2  91 rr              STA   (ptr_lo),Y
002BFBr 2  68                 PLA                        ; total_lo
002BFCr 2  A0 02              LDY   #GC_HDR_BYTES         ; base+2
002BFEr 2  91 rr              STA   (ptr_lo),Y
002C00r 2               
002C00r 2                     ; Advance proc_entry to point past header+size field = base+4
002C00r 2                     ; This is where the record data starts
002C00r 2  18                 CLC
002C01r 2  A5 rr              LDA   proc_entry_lo
002C03r 2  69 04              ADC   #4
002C05r 2  85 rr              STA   proc_entry_lo
002C07r 2  A5 rr              LDA   proc_entry_hi
002C09r 2  69 00              ADC   #0
002C0Br 2  85 rr              STA   proc_entry_hi
002C0Dr 2               
002C0Dr 2  18                 CLC
002C0Er 2  60                 RTS
002C0Fr 2               
002C0Fr 2               ; ---------------------------------------------------------------------
002C0Fr 2               ; proc_build_record — allocate and populate a procedure heap record
002C0Fr 2               ;   Uses: proc_name_buf, proc_param_buf/proc_param_end,
002C0Fr 2               ;         proc_body_buf/proc_body_len
002C0Fr 2               ; ---------------------------------------------------------------------
002C0Fr 2               proc_build_record:
002C0Fr 2                     ; Calculate total record size
002C0Fr 2                     ; 2 (next) + 1 (name_len) + name_len
002C0Fr 2                     ; + 1 (param_count) + (proc_param_end - 1) param packed bytes
002C0Fr 2                     ; + 2 (body_len) + body_len
002C0Fr 2                     ;
002C0Fr 2                     ; We build the total in proc_ptr_lo:proc_ptr_hi (16-bit)
002C0Fr 2               
002C0Fr 2  A9 04              LDA   #4                    ; 2(next) + 1(name_len) + 1(param_count)
002C11r 2  18                 CLC
002C12r 2  6D rr rr           ADC   proc_name_buf         ; + name_len
002C15r 2  85 rr              STA   proc_ptr_lo
002C17r 2  A9 00              LDA   #0
002C19r 2  85 rr              STA   proc_ptr_hi
002C1Br 2               
002C1Br 2                     ; + param packed bytes (proc_param_end - 1)
002C1Br 2  AD rr rr           LDA   proc_param_end
002C1Er 2  38                 SEC
002C1Fr 2  E9 01              SBC   #1
002C21r 2  18                 CLC
002C22r 2  65 rr              ADC   proc_ptr_lo
002C24r 2  85 rr              STA   proc_ptr_lo
002C26r 2  90 02              BCC   :+
002C28r 2  E6 rr              INC   proc_ptr_hi
002C2Ar 2               :
002C2Ar 2                     ; + 2 (body_len field)
002C2Ar 2  18                 CLC
002C2Br 2  A5 rr              LDA   proc_ptr_lo
002C2Dr 2  69 02              ADC   #2
002C2Fr 2  85 rr              STA   proc_ptr_lo
002C31r 2  90 02              BCC   :+
002C33r 2  E6 rr              INC   proc_ptr_hi
002C35r 2               :
002C35r 2                     ; + body_len
002C35r 2  18                 CLC
002C36r 2  A5 rr              LDA   proc_ptr_lo
002C38r 2  65 rr              ADC   proc_body_len_lo
002C3Ar 2  85 rr              STA   proc_ptr_lo
002C3Cr 2  A5 rr              LDA   proc_ptr_hi
002C3Er 2  65 rr              ADC   proc_body_len_hi
002C40r 2  85 rr              STA   proc_ptr_hi
002C42r 2               
002C42r 2                     ; Allocate with GC header (16-bit size via heap_alloc_big)
002C42r 2                     ; proc_ptr_lo/hi = payload size
002C42r 2  20 rr rr           JSR   heap_alloc_big
002C45r 2  90 01              BCC   @ok
002C47r 2  60                 RTS                        ; OOM
002C48r 2               @ok:
002C48r 2                     ; Fill the record using (ptr_lo),Y indirect addressing
002C48r 2                     ; We track Y as the write offset. For records > 256 bytes
002C48r 2                     ; we bump ptr_hi when Y wraps.
002C48r 2  A5 rr              LDA   proc_entry_lo
002C4Ar 2  85 rr              STA   ptr_lo
002C4Cr 2  A5 rr              LDA   proc_entry_hi
002C4Er 2  85 rr              STA   ptr_hi
002C50r 2               
002C50r 2                     ; +0,+1: next pointer = current proc_head
002C50r 2  A0 00              LDY   #0
002C52r 2  A5 rr              LDA   proc_head_lo
002C54r 2  91 rr              STA   (ptr_lo),Y
002C56r 2  C8                 INY
002C57r 2  A5 rr              LDA   proc_head_hi
002C59r 2  91 rr              STA   (ptr_lo),Y
002C5Br 2               
002C5Br 2                     ; +2: name_len
002C5Br 2  C8                 INY
002C5Cr 2  AD rr rr           LDA   proc_name_buf
002C5Fr 2  91 rr              STA   (ptr_lo),Y
002C61r 2               
002C61r 2                     ; +3..+3+NL-1: name chars
002C61r 2  AE rr rr           LDX   proc_name_buf         ; X = char count
002C64r 2  64 rr              STZ   proc_rec_off          ; source index
002C66r 2               @bld_name:
002C66r 2  E0 00              CPX   #0
002C68r 2  F0 13              BEQ   @bld_name_done
002C6Ar 2  C8                 INY
002C6Br 2  D0 02              BNE   :+
002C6Dr 2  E6 rr              INC   ptr_hi
002C6Fr 2  DA           :     PHX
002C70r 2  A6 rr              LDX   proc_rec_off
002C72r 2  BD rr rr           LDA   proc_name_buf+1,X
002C75r 2  FA                 PLX
002C76r 2  91 rr              STA   (ptr_lo),Y
002C78r 2  E6 rr              INC   proc_rec_off
002C7Ar 2  CA                 DEX
002C7Br 2  80 E9              BRA   @bld_name
002C7Dr 2               @bld_name_done:
002C7Dr 2               
002C7Dr 2                     ; +3+NL: param_count
002C7Dr 2  C8                 INY
002C7Er 2  D0 02              BNE   :+
002C80r 2  E6 rr              INC   ptr_hi
002C82r 2  A5 rr        :     LDA   proc_param_cnt
002C84r 2  91 rr              STA   (ptr_lo),Y
002C86r 2               
002C86r 2                     ; Copy packed param data from proc_param_buf[1..proc_param_end-1]
002C86r 2  AD rr rr           LDA   proc_param_end
002C89r 2  C9 02              CMP   #2                    ; at least 1 = there are params
002C8Br 2  90 14              BCC   @bld_params_done
002C8Dr 2  A2 01              LDX   #1                    ; source index (skip count byte)
002C8Fr 2               @bld_param:
002C8Fr 2  EC rr rr           CPX   proc_param_end
002C92r 2  B0 0D              BCS   @bld_params_done
002C94r 2  C8                 INY
002C95r 2  D0 02              BNE   :+
002C97r 2  E6 rr              INC   ptr_hi
002C99r 2  BD rr rr     :     LDA   proc_param_buf,X
002C9Cr 2  91 rr              STA   (ptr_lo),Y
002C9Er 2  E8                 INX
002C9Fr 2  80 EE              BRA   @bld_param
002CA1r 2               @bld_params_done:
002CA1r 2               
002CA1r 2                     ; body_len_lo, body_len_hi
002CA1r 2  C8                 INY
002CA2r 2  D0 02              BNE   :+
002CA4r 2  E6 rr              INC   ptr_hi
002CA6r 2  A5 rr        :     LDA   proc_body_len_lo
002CA8r 2  91 rr              STA   (ptr_lo),Y
002CAAr 2  C8                 INY
002CABr 2  D0 02              BNE   :+
002CADr 2  E6 rr              INC   ptr_hi
002CAFr 2  A5 rr        :     LDA   proc_body_len_hi
002CB1r 2  91 rr              STA   (ptr_lo),Y
002CB3r 2               
002CB3r 2                     ; Copy body text (proc_body_src points at the body region of the buffer)
002CB3r 2  A5 rr              LDA   proc_body_len_lo
002CB5r 2  05 rr              ORA   proc_body_len_hi
002CB7r 2  F0 3A              BEQ   @bld_body_done
002CB9r 2               
002CB9r 2  AD rr rr           LDA   proc_body_src_lo
002CBCr 2  85 rr              STA   proc_ptr_lo
002CBEr 2  AD rr rr           LDA   proc_body_src_hi
002CC1r 2  85 rr              STA   proc_ptr_hi
002CC3r 2                     ; 16-bit counter
002CC3r 2  A5 rr              LDA   proc_body_len_lo
002CC5r 2  8D rr rr           STA   num_tmp_lo
002CC8r 2  A5 rr              LDA   proc_body_len_hi
002CCAr 2  8D rr rr           STA   num_tmp_hi
002CCDr 2               
002CCDr 2               @bld_body:
002CCDr 2  C8                 INY
002CCEr 2  D0 02              BNE   :+
002CD0r 2  E6 rr              INC   ptr_hi
002CD2r 2  5A           :     PHY
002CD3r 2  A0 00              LDY   #0
002CD5r 2  B1 rr              LDA   (proc_ptr_lo),Y
002CD7r 2  7A                 PLY
002CD8r 2  91 rr              STA   (ptr_lo),Y
002CDAr 2                     ; Advance source
002CDAr 2  E6 rr              INC   proc_ptr_lo
002CDCr 2  D0 02              BNE   :+
002CDEr 2  E6 rr              INC   proc_ptr_hi
002CE0r 2               :     ; Decrement counter
002CE0r 2  AD rr rr           LDA   num_tmp_lo
002CE3r 2  D0 03              BNE   @bld_dec_lo
002CE5r 2  CE rr rr           DEC   num_tmp_hi
002CE8r 2               @bld_dec_lo:
002CE8r 2  CE rr rr           DEC   num_tmp_lo
002CEBr 2  AD rr rr           LDA   num_tmp_lo
002CEEr 2  0D rr rr           ORA   num_tmp_hi
002CF1r 2  D0 DA              BNE   @bld_body
002CF3r 2               
002CF3r 2               @bld_body_done:
002CF3r 2                     ; Prepend to directory
002CF3r 2  A5 rr              LDA   proc_entry_lo
002CF5r 2  85 rr              STA   proc_head_lo
002CF7r 2  A5 rr              LDA   proc_entry_hi
002CF9r 2  85 rr              STA   proc_head_hi
002CFBr 2  60                 RTS
002CFCr 2               
002CFCr 2               ; ---------------------------------------------------------------------
002CFCr 2               ; proc_lookup — search for a procedure by name
002CFCr 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
002CFCr 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002CFCr 2               ;           carry set = not found
002CFCr 2               ; ---------------------------------------------------------------------
002CFCr 2               proc_lookup:
002CFCr 2  A5 rr              LDA   proc_head_lo
002CFEr 2  85 rr              STA   proc_entry_lo
002D00r 2  A5 rr              LDA   proc_head_hi
002D02r 2  85 rr              STA   proc_entry_hi
002D04r 2               
002D04r 2               @walk:
002D04r 2  A5 rr              LDA   proc_entry_lo
002D06r 2  05 rr              ORA   proc_entry_hi
002D08r 2  F0 0C              BEQ   @not_found
002D0Ar 2               
002D0Ar 2  20 rr rr           JSR   proc_names_equal
002D0Dr 2  B0 05              BCS   @found
002D0Fr 2               
002D0Fr 2                     ; Follow next pointer
002D0Fr 2  20 rr rr           JSR   proc_next
002D12r 2  80 F0              BRA   @walk
002D14r 2               
002D14r 2               @found:
002D14r 2  18                 CLC
002D15r 2  60                 RTS
002D16r 2               @not_found:
002D16r 2  38                 SEC
002D17r 2  60                 RTS
002D18r 2               
002D18r 2               ; ---------------------------------------------------------------------
002D18r 2               ; proc_next — advance proc_entry_lo/hi to the next record it links to.
002D18r 2               ;   In/out: proc_entry_lo/hi.  Clobbers: A, X, Y, ptr_lo/hi.
002D18r 2               ; ---------------------------------------------------------------------
002D18r 2               proc_next:
002D18r 2  A5 rr              LDA   proc_entry_lo
002D1Ar 2  85 rr              STA   ptr_lo
002D1Cr 2  A5 rr              LDA   proc_entry_hi
002D1Er 2  85 rr              STA   ptr_hi
002D20r 2  A0 00              LDY   #0
002D22r 2  B1 rr              LDA   (ptr_lo),Y
002D24r 2  AA                 TAX
002D25r 2  C8                 INY
002D26r 2  B1 rr              LDA   (ptr_lo),Y
002D28r 2  85 rr              STA   proc_entry_hi
002D2Ar 2  86 rr              STX   proc_entry_lo
002D2Cr 2  60                 RTS
002D2Dr 2               
002D2Dr 2               ; ---------------------------------------------------------------------
002D2Dr 2               ; proc_names_equal — compare token word vs record name
002D2Dr 2               ;   Input: eval_cur_lo/hi = TOK_WORD, proc_entry_lo/hi = record
002D2Dr 2               ;   Returns: carry set = equal, carry clear = not equal
002D2Dr 2               ; ---------------------------------------------------------------------
002D2Dr 2               proc_names_equal:
002D2Dr 2                     ; Token name length
002D2Dr 2  A5 rr              LDA   eval_cur_lo
002D2Fr 2  85 rr              STA   ptr_lo
002D31r 2  A5 rr              LDA   eval_cur_hi
002D33r 2  85 rr              STA   ptr_hi
002D35r 2  A0 03              LDY   #TOK_PAYLOAD
002D37r 2  B1 rr              LDA   (ptr_lo),Y
002D39r 2  85 rr              STA   proc_name_len         ; token name length
002D3Br 2               
002D3Br 2                     ; Record name length
002D3Br 2  A5 rr              LDA   proc_entry_lo
002D3Dr 2  85 rr              STA   ptr_lo
002D3Fr 2  A5 rr              LDA   proc_entry_hi
002D41r 2  85 rr              STA   ptr_hi
002D43r 2  A0 02              LDY   #2
002D45r 2  B1 rr              LDA   (ptr_lo),Y
002D47r 2               
002D47r 2  C5 rr              CMP   proc_name_len
002D49r 2  D0 37              BNE   @ne
002D4Br 2               
002D4Br 2                     ; Lengths match — compare chars
002D4Br 2  AA                 TAX                         ; X = length
002D4Cr 2  F0 30              BEQ   @eq
002D4Er 2  A0 00              LDY   #0                    ; char index
002D50r 2               @cmp:
002D50r 2  DA                 PHX
002D51r 2  5A                 PHY
002D52r 2                     ; Token char at eval_cur + TOK_PAYLOAD + 1 + charIdx
002D52r 2  A5 rr              LDA   eval_cur_lo
002D54r 2  85 rr              STA   ptr_lo
002D56r 2  A5 rr              LDA   eval_cur_hi
002D58r 2  85 rr              STA   ptr_hi
002D5Ar 2  98                 TYA
002D5Br 2  18                 CLC
002D5Cr 2  69 04              ADC   #TOK_PAYLOAD+1
002D5Er 2  A8                 TAY
002D5Fr 2  B1 rr              LDA   (ptr_lo),Y
002D61r 2  85 rr              STA   proc_rec_off          ; temp: token char
002D63r 2               
002D63r 2                     ; Record char at proc_entry + 3 + charIdx
002D63r 2  7A                 PLY
002D64r 2  5A                 PHY
002D65r 2  A5 rr              LDA   proc_entry_lo
002D67r 2  85 rr              STA   ptr_lo
002D69r 2  A5 rr              LDA   proc_entry_hi
002D6Br 2  85 rr              STA   ptr_hi
002D6Dr 2  98                 TYA
002D6Er 2  18                 CLC
002D6Fr 2  69 03              ADC   #3
002D71r 2  A8                 TAY
002D72r 2  B1 rr              LDA   (ptr_lo),Y
002D74r 2               
002D74r 2  C5 rr              CMP   proc_rec_off
002D76r 2  D0 08              BNE   @ne_pop
002D78r 2  7A                 PLY
002D79r 2  FA                 PLX
002D7Ar 2  C8                 INY
002D7Br 2  CA                 DEX
002D7Cr 2  D0 D2              BNE   @cmp
002D7Er 2               @eq:
002D7Er 2  38                 SEC
002D7Fr 2  60                 RTS
002D80r 2               @ne_pop:
002D80r 2  7A                 PLY
002D81r 2  FA                 PLX
002D82r 2               @ne:
002D82r 2  18                 CLC
002D83r 2  60                 RTS
002D84r 2               
002D84r 2               ; ---------------------------------------------------------------------
002D84r 2               ; proc_invoke — invoke a user-defined procedure
002D84r 2               ;   Input: eval_cur_lo/hi = TOK_WORD token (the procedure name)
002D84r 2               ;          proc_entry_lo/hi = matching procedure record
002D84r 2               ;   On exit: JMPs to eval_loop or eval_body to continue.
002D84r 2               ; ---------------------------------------------------------------------
002D84r 2               proc_invoke:
002D84r 2                     ; Save outer tokenizer and eval state on the hardware stack.
002D84r 2                     ; We push: tok_head(2), tok_tail(2), eval_in_body(1),
002D84r 2                     ;          proc_stopped(1) = 6 bytes.
002D84r 2                     ; input_buf is saved to BSS (128 bytes too large for stack).
002D84r 2  A5 rr              LDA   tok_head_lo
002D86r 2  48                 PHA
002D87r 2  A5 rr              LDA   tok_head_hi
002D89r 2  48                 PHA
002D8Ar 2  A5 rr              LDA   tok_tail_lo
002D8Cr 2  48                 PHA
002D8Dr 2  A5 rr              LDA   tok_tail_hi
002D8Fr 2  48                 PHA
002D90r 2  A5 rr              LDA   eval_in_body
002D92r 2  48                 PHA
002D93r 2  A5 rr              LDA   proc_stopped
002D95r 2  48                 PHA
002D96r 2               
002D96r 2                     ; Save input_buf to BSS save area
002D96r 2  A2 00              LDX   #0
002D98r 2               @save_ib:
002D98r 2  BD rr rr           LDA   input_buf,X
002D9Br 2  9D rr rr           STA   save_input_buf,X
002D9Er 2  E8                 INX
002D9Fr 2  E0 80              CPX   #128
002DA1r 2  D0 F5              BNE   @save_ib
002DA3r 2               
002DA3r 2                     ; Advance eval_cur past the procedure name token
002DA3r 2  20 rr rr           JSR   eval_advance
002DA6r 2               
002DA6r 2                     ; --- Bind parameters ---
002DA6r 2                     ; Navigate to param_count in the record:
002DA6r 2                     ;   offset = 3 + name_len
002DA6r 2  A5 rr              LDA   proc_entry_lo
002DA8r 2  85 rr              STA   ptr_lo
002DAAr 2  A5 rr              LDA   proc_entry_hi
002DACr 2  85 rr              STA   ptr_hi
002DAEr 2  A0 02              LDY   #2
002DB0r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002DB2r 2  18                 CLC
002DB3r 2  69 03              ADC   #3
002DB5r 2  A8                 TAY                         ; Y = offset to param_count
002DB6r 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002DB8r 2  85 rr              STA   proc_param_cnt
002DBAr 2  C8                 INY                         ; Y = offset to first param name
002DBBr 2  84 rr              STY   proc_rec_off          ; save record offset
002DBDr 2               
002DBDr 2  A5 rr              LDA   proc_param_cnt
002DBFr 2  F0 5C              BEQ   @bind_done
002DC1r 2               
002DC1r 2  A6 rr              LDX   proc_param_cnt
002DC3r 2               @bind_loop:
002DC3r 2  DA                 PHX                         ; save remaining param count
002DC4r 2               
002DC4r 2                     ; First: evaluate the next argument from the caller's token stream.
002DC4r 2                     ; eval_cur still points into the caller's token list.
002DC4r 2  20 rr rr           JSR   eval_expr
002DC7r 2  90 03              BCC   @arg_ok
002DC9r 2  4C rr rr           JMP   @bind_err
002DCCr 2               @arg_ok:
002DCCr 2               
002DCCr 2                     ; eval_val now holds the argument value.
002DCCr 2                     ; Push value onto stack (type + 3 value bytes = 4 bytes)
002DCCr 2  A5 rr              LDA   eval_val_frac
002DCEr 2  48                 PHA
002DCFr 2  A5 rr              LDA   eval_val_lo
002DD1r 2  48                 PHA
002DD2r 2  A5 rr              LDA   eval_val_hi
002DD4r 2  48                 PHA
002DD5r 2  A5 rr              LDA   eval_type
002DD7r 2  48                 PHA
002DD8r 2               
002DD8r 2                     ; Build the param name as a length-prefixed string in param_name_tmp
002DD8r 2                     ; Read from record at proc_entry + proc_rec_off
002DD8r 2  A5 rr              LDA   proc_entry_lo
002DDAr 2  85 rr              STA   ptr_lo
002DDCr 2  A5 rr              LDA   proc_entry_hi
002DDEr 2  85 rr              STA   ptr_hi
002DE0r 2  A4 rr              LDY   proc_rec_off
002DE2r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002DE4r 2  8D rr rr           STA   param_name_tmp        ; length byte
002DE7r 2  AA                 TAX                         ; X = char count
002DE8r 2  A9 00              LDA   #0
002DEAr 2  85 rr              STA   proc_name_len         ; dest offset in param_name_tmp
002DECr 2               @bind_ch:
002DECr 2  E0 00              CPX   #0
002DEEr 2  F0 0F              BEQ   @bind_ch_done
002DF0r 2  C8                 INY
002DF1r 2  B1 rr              LDA   (ptr_lo),Y
002DF3r 2  DA                 PHX
002DF4r 2  A6 rr              LDX   proc_name_len
002DF6r 2  9D rr rr           STA   param_name_tmp+1,X
002DF9r 2  E6 rr              INC   proc_name_len
002DFBr 2  FA                 PLX
002DFCr 2  CA                 DEX
002DFDr 2  80 ED              BRA   @bind_ch
002DFFr 2               @bind_ch_done:
002DFFr 2                     ; Advance proc_rec_off past this param
002DFFr 2  C8                 INY
002E00r 2  84 rr              STY   proc_rec_off
002E02r 2               
002E02r 2                     ; Pop value from stack back into eval_val
002E02r 2  68                 PLA
002E03r 2  85 rr              STA   eval_type
002E05r 2  68                 PLA
002E06r 2  85 rr              STA   eval_val_hi
002E08r 2  68                 PLA
002E09r 2  85 rr              STA   eval_val_lo
002E0Br 2  68                 PLA
002E0Cr 2  85 rr              STA   eval_val_frac
002E0Er 2               
002E0Er 2                     ; Call var_set with ptr_lo/hi → param_name_tmp
002E0Er 2  A9 rr              LDA   #<param_name_tmp
002E10r 2  85 rr              STA   ptr_lo
002E12r 2  A9 rr              LDA   #>param_name_tmp
002E14r 2  85 rr              STA   ptr_hi
002E16r 2  20 rr rr           JSR   var_set
002E19r 2               
002E19r 2  FA                 PLX                         ; restore remaining count
002E1Ar 2  CA                 DEX
002E1Br 2  D0 A6              BNE   @bind_loop
002E1Dr 2               
002E1Dr 2               @bind_done:
002E1Dr 2                     ; Save heap pointer AFTER param binding so var_set allocations persist.
002E1Dr 2                     ; Body tokenization will reuse heap from this point each line.
002E1Dr 2  A5 rr              LDA   heap_ptr
002E1Fr 2  8D rr rr           STA   save_heap_ptr_lo
002E22r 2  A5 rr              LDA   heap_ptr+1
002E24r 2  8D rr rr           STA   save_heap_ptr_hi
002E27r 2               
002E27r 2                     ; Save eval_cur (resume point after all args consumed from caller)
002E27r 2  A5 rr              LDA   eval_cur_lo
002E29r 2  8D rr rr           STA   save_eval_cur_lo
002E2Cr 2  A5 rr              LDA   eval_cur_hi
002E2Er 2  8D rr rr           STA   save_eval_cur_hi
002E31r 2               
002E31r 2                     ; --- Execute the body ---
002E31r 2                     ; Navigate to body in the record:
002E31r 2                     ;   proc_rec_off now points past all params.
002E31r 2                     ;   Next 2 bytes = body_len, then body text.
002E31r 2  A5 rr              LDA   proc_entry_lo
002E33r 2  85 rr              STA   ptr_lo
002E35r 2  A5 rr              LDA   proc_entry_hi
002E37r 2  85 rr              STA   ptr_hi
002E39r 2  A4 rr              LDY   proc_rec_off
002E3Br 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_lo
002E3Dr 2  85 rr              STA   proc_body_len_lo
002E3Fr 2  C8                 INY
002E40r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_hi
002E42r 2  85 rr              STA   proc_body_len_hi
002E44r 2  C8                 INY                         ; Y = offset to body text start
002E45r 2  84 rr              STY   proc_rec_off
002E47r 2               
002E47r 2                     ; Compute absolute pointer to body text start
002E47r 2  18                 CLC
002E48r 2  A5 rr              LDA   proc_entry_lo
002E4Ar 2  65 rr              ADC   proc_rec_off
002E4Cr 2  85 rr              STA   proc_ptr_lo
002E4Er 2  A5 rr              LDA   proc_entry_hi
002E50r 2  69 00              ADC   #0
002E52r 2  85 rr              STA   proc_ptr_hi
002E54r 2               
002E54r 2                     ; Process body line by line: find each $0A, copy line to input_buf,
002E54r 2                     ; tokenize, eval, repeat.
002E54r 2                     ; proc_ptr = current position in body text
002E54r 2                     ; proc_body_len = remaining bytes
002E54r 2               
002E54r 2                     ; Clear STOP/OUTPUT flag before executing body
002E54r 2  64 rr              STZ   proc_stopped
002E56r 2               
002E56r 2               @exec_line:
002E56r 2                     ; Any body text remaining?
002E56r 2  A5 rr              LDA   proc_body_len_lo
002E58r 2  05 rr              ORA   proc_body_len_hi
002E5Ar 2  D0 03              BNE   @have_body
002E5Cr 2  4C rr rr           JMP   @exec_done
002E5Fr 2               @have_body:
002E5Fr 2               
002E5Fr 2                     ; Reset heap for this statement's tokens (reuse token heap each statement)
002E5Fr 2  AD rr rr           LDA   save_heap_ptr_lo
002E62r 2  85 rr              STA   heap_ptr
002E64r 2  AD rr rr           LDA   save_heap_ptr_hi
002E67r 2  85 rr              STA   heap_ptr+1
002E69r 2               
002E69r 2                     ; Accumulate physical lines into one logical statement: keep copying lines
002E69r 2                     ; into input_buf until bracket/paren depth returns to 0, so a [ ... ] or
002E69r 2                     ; ( ... ) that spans several lines is pieced together before we tokenize.
002E69r 2  A2 00              LDX   #0                    ; input_buf index
002E6Br 2  9C rr rr           STZ   proc_brk_depth
002E6Er 2               @line_ch:
002E6Er 2  A5 rr              LDA   proc_body_len_lo
002E70r 2  05 rr              ORA   proc_body_len_hi
002E72r 2  F0 71              BEQ   @line_eol             ; no more body text -> end of last line
002E74r 2               
002E74r 2  A0 00              LDY   #0
002E76r 2  B1 rr              LDA   (proc_ptr_lo),Y      ; read body char
002E78r 2  C9 0A              CMP   #$0A
002E7Ar 2  F0 5B              BEQ   @line_nl
002E7Cr 2  C9 3B              CMP   #';'                 ; comment -> skip rest of physical line
002E7Er 2  F0 37              BEQ   @line_comment
002E80r 2               
002E80r 2                     ; Store char in input_buf, tracking bracket/paren nesting depth.
002E80r 2  9D rr rr           STA   input_buf,X
002E83r 2  E8                 INX
002E84r 2  C9 5B              CMP   #'['
002E86r 2  F0 20              BEQ   @brk_inc
002E88r 2  C9 28              CMP   #'('
002E8Ar 2  F0 1C              BEQ   @brk_inc
002E8Cr 2  C9 5D              CMP   #']'
002E8Er 2  F0 1D              BEQ   @brk_dec
002E90r 2  C9 29              CMP   #')'
002E92r 2  F0 19              BEQ   @brk_dec
002E94r 2               @brk_done:
002E94r 2                     ; Advance body pointer
002E94r 2  E6 rr              INC   proc_ptr_lo
002E96r 2  D0 02              BNE   :+
002E98r 2  E6 rr              INC   proc_ptr_hi
002E9Ar 2               :     ; Decrement remaining
002E9Ar 2  A5 rr              LDA   proc_body_len_lo
002E9Cr 2  D0 02              BNE   @ln_dec_lo
002E9Er 2  C6 rr              DEC   proc_body_len_hi
002EA0r 2               @ln_dec_lo:
002EA0r 2  C6 rr              DEC   proc_body_len_lo
002EA2r 2                     ; Guard against input_buf overflow (~120 chars per statement).
002EA2r 2  E0 78              CPX   #120
002EA4r 2  B0 3F              BCS   @line_eol
002EA6r 2  80 C6              BRA   @line_ch
002EA8r 2               
002EA8r 2               @brk_inc:
002EA8r 2  EE rr rr           INC   proc_brk_depth
002EABr 2  80 E7              BRA   @brk_done
002EADr 2               @brk_dec:
002EADr 2  AD rr rr           LDA   proc_brk_depth
002EB0r 2  F0 E2              BEQ   @brk_done             ; floor at 0
002EB2r 2  CE rr rr           DEC   proc_brk_depth
002EB5r 2  80 DD              BRA   @brk_done
002EB7r 2               
002EB7r 2               @line_comment:
002EB7r 2                     ; ';' begins a comment: advance past the rest of this physical line
002EB7r 2                     ; without copying, so comment text (and any brackets in it) is ignored.
002EB7r 2  A5 rr              LDA   proc_body_len_lo
002EB9r 2  05 rr              ORA   proc_body_len_hi
002EBBr 2  F0 28              BEQ   @line_eol             ; comment runs to end of body
002EBDr 2  A0 00              LDY   #0
002EBFr 2  B1 rr              LDA   (proc_ptr_lo),Y
002EC1r 2  48                 PHA                         ; remember if this was the newline
002EC2r 2  E6 rr              INC   proc_ptr_lo
002EC4r 2  D0 02              BNE   :+
002EC6r 2  E6 rr              INC   proc_ptr_hi
002EC8r 2  A5 rr        :     LDA   proc_body_len_lo
002ECAr 2  D0 02              BNE   @cmt_dec
002ECCr 2  C6 rr              DEC   proc_body_len_hi
002ECEr 2               @cmt_dec:
002ECEr 2  C6 rr              DEC   proc_body_len_lo
002ED0r 2  68                 PLA
002ED1r 2  C9 0A              CMP   #$0A
002ED3r 2  D0 E2              BNE   @line_comment         ; keep skipping comment chars
002ED5r 2  80 0E              BRA   @line_eol             ; consumed the newline -> end of physical line
002ED7r 2               
002ED7r 2               @line_nl:
002ED7r 2                     ; Skip the $0A
002ED7r 2  E6 rr              INC   proc_ptr_lo
002ED9r 2  D0 02              BNE   :+
002EDBr 2  E6 rr              INC   proc_ptr_hi
002EDDr 2  A5 rr        :     LDA   proc_body_len_lo
002EDFr 2  D0 02              BNE   @ln2_dec_lo
002EE1r 2  C6 rr              DEC   proc_body_len_hi
002EE3r 2               @ln2_dec_lo:
002EE3r 2  C6 rr              DEC   proc_body_len_lo
002EE5r 2                     ; fall through to end-of-physical-line decision
002EE5r 2               
002EE5r 2               @line_eol:
002EE5r 2                     ; End of a physical line. If brackets/parens are still open AND there is
002EE5r 2                     ; more body to read AND room in the buffer, append a separating space and
002EE5r 2                     ; keep accumulating; otherwise the statement is complete.
002EE5r 2  AD rr rr           LDA   proc_brk_depth
002EE8r 2  F0 13              BEQ   @line_end             ; balanced -> execute
002EEAr 2  A5 rr              LDA   proc_body_len_lo
002EECr 2  05 rr              ORA   proc_body_len_hi
002EEEr 2  F0 0D              BEQ   @line_end             ; no more lines -> execute (eval will report)
002EF0r 2  E0 78              CPX   #120
002EF2r 2  B0 09              BCS   @line_end             ; buffer full -> execute
002EF4r 2  A9 20              LDA   #' '                  ; join lines with whitespace
002EF6r 2  9D rr rr           STA   input_buf,X
002EF9r 2  E8                 INX
002EFAr 2  4C rr rr           JMP   @line_ch
002EFDr 2               
002EFDr 2               @line_end:
002EFDr 2                     ; Null-terminate input_buf
002EFDr 2  9E rr rr           STZ   input_buf,X
002F00r 2               
002F00r 2                     ; Tokenize this line
002F00r 2  20 rr rr           JSR   tokenize_line
002F03r 2               
002F03r 2                     ; Save body-loop state that recursive proc_invoke would clobber.
002F03r 2                     ; BSS save areas (save_heap_ptr, save_eval_cur) plus ZP body-loop
002F03r 2                     ; variables (proc_ptr, proc_body_len) all need protection.
002F03r 2  A5 rr              LDA   proc_ptr_lo
002F05r 2  48                 PHA
002F06r 2  A5 rr              LDA   proc_ptr_hi
002F08r 2  48                 PHA
002F09r 2  A5 rr              LDA   proc_body_len_lo
002F0Br 2  48                 PHA
002F0Cr 2  A5 rr              LDA   proc_body_len_hi
002F0Er 2  48                 PHA
002F0Fr 2  AD rr rr           LDA   save_heap_ptr_lo
002F12r 2  48                 PHA
002F13r 2  AD rr rr           LDA   save_heap_ptr_hi
002F16r 2  48                 PHA
002F17r 2  AD rr rr           LDA   save_eval_cur_lo
002F1Ar 2  48                 PHA
002F1Br 2  AD rr rr           LDA   save_eval_cur_hi
002F1Er 2  48                 PHA
002F1Fr 2               
002F1Fr 2                     ; Eval this line (full eval — not body mode)
002F1Fr 2  20 rr rr           JSR   eval_line
002F22r 2               
002F22r 2                     ; Restore body-loop state
002F22r 2  68                 PLA
002F23r 2  8D rr rr           STA   save_eval_cur_hi
002F26r 2  68                 PLA
002F27r 2  8D rr rr           STA   save_eval_cur_lo
002F2Ar 2  68                 PLA
002F2Br 2  8D rr rr           STA   save_heap_ptr_hi
002F2Er 2  68                 PLA
002F2Fr 2  8D rr rr           STA   save_heap_ptr_lo
002F32r 2  68                 PLA
002F33r 2  85 rr              STA   proc_body_len_hi
002F35r 2  68                 PLA
002F36r 2  85 rr              STA   proc_body_len_lo
002F38r 2  68                 PLA
002F39r 2  85 rr              STA   proc_ptr_hi
002F3Br 2  68                 PLA
002F3Cr 2  85 rr              STA   proc_ptr_lo
002F3Er 2               
002F3Er 2                     ; Check if STOP or OUTPUT was called — stop processing lines
002F3Er 2  A5 rr              LDA   proc_stopped
002F40r 2  D0 03              BNE   @exec_done
002F42r 2               
002F42r 2  4C rr rr           JMP   @exec_line
002F45r 2               
002F45r 2               @exec_done:
002F45r 2                     ; Restore heap pointer (procedures stay, but per-line tokens freed)
002F45r 2  AD rr rr           LDA   save_heap_ptr_lo
002F48r 2  85 rr              STA   heap_ptr
002F4Ar 2  AD rr rr           LDA   save_heap_ptr_hi
002F4Dr 2  85 rr              STA   heap_ptr+1
002F4Fr 2               
002F4Fr 2                     ; Restore input_buf
002F4Fr 2  A2 00              LDX   #0
002F51r 2               @rest_ib:
002F51r 2  BD rr rr           LDA   save_input_buf,X
002F54r 2  9D rr rr           STA   input_buf,X
002F57r 2  E8                 INX
002F58r 2  E0 80              CPX   #128
002F5Ar 2  D0 F5              BNE   @rest_ib
002F5Cr 2               
002F5Cr 2                     ; Restore eval_cur to the resume point in the caller's token stream
002F5Cr 2  AD rr rr           LDA   save_eval_cur_lo
002F5Fr 2  85 rr              STA   eval_cur_lo
002F61r 2  AD rr rr           LDA   save_eval_cur_hi
002F64r 2  85 rr              STA   eval_cur_hi
002F66r 2               
002F66r 2                     ; Restore outer state from stack.
002F66r 2                     ; X returns this invocation's proc_stopped to the caller.
002F66r 2                     ; Stack layout (top to bottom):
002F66r 2                     ;   saved_proc_stopped, eval_in_body, tok_tail_hi, tok_tail_lo,
002F66r 2                     ;   tok_head_hi, tok_head_lo
002F66r 2  A6 rr              LDX   proc_stopped          ; X = this proc's exit state
002F68r 2  68                 PLA                         ; pop saved outer proc_stopped
002F69r 2  85 rr              STA   proc_stopped          ; restore outer proc_stopped
002F6Br 2  68                 PLA
002F6Cr 2  85 rr              STA   eval_in_body
002F6Er 2  68                 PLA
002F6Fr 2  85 rr              STA   tok_tail_hi
002F71r 2  68                 PLA
002F72r 2  85 rr              STA   tok_tail_lo
002F74r 2  68                 PLA
002F75r 2  85 rr              STA   tok_head_hi
002F77r 2  68                 PLA
002F78r 2  85 rr              STA   tok_head_lo
002F7Ar 2               
002F7Ar 2                     ; Return with X = exit status ($00=normal, $01=STOP, $02=OUTPUT)
002F7Ar 2  60                 RTS
002F7Br 2               
002F7Br 2               @bind_err:
002F7Br 2  FA                 PLX                         ; discard remaining param count
002F7Cr 2                     ; Print error
002F7Cr 2  A2 00              LDX   #0
002F7Er 2               @be_lp:
002F7Er 2  BD rr rr           LDA   str_notenough,X
002F81r 2  F0 06              BEQ   @be_done
002F83r 2  8D 0E A0           STA   VGC_CHAROUT
002F86r 2  E8                 INX
002F87r 2  D0 F5              BNE   @be_lp
002F89r 2               @be_done:
002F89r 2  20 rr rr           JSR   eval_newline
002F8Cr 2                     ; Restore input_buf and stack, skip body execution
002F8Cr 2  A2 00              LDX   #0
002F8Er 2               @be_rest_ib:
002F8Er 2  BD rr rr           LDA   save_input_buf,X
002F91r 2  9D rr rr           STA   input_buf,X
002F94r 2  E8                 INX
002F95r 2  E0 80              CPX   #128
002F97r 2  D0 F5              BNE   @be_rest_ib
002F99r 2                     ; Restore stack (6 bytes: proc_stopped, eval_in_body, tok_tail, tok_head)
002F99r 2  A2 00              LDX   #$00                  ; X = normal exit status
002F9Br 2  68                 PLA                         ; saved proc_stopped
002F9Cr 2  85 rr              STA   proc_stopped
002F9Er 2  68                 PLA
002F9Fr 2  85 rr              STA   eval_in_body
002FA1r 2  68                 PLA
002FA2r 2  85 rr              STA   tok_tail_hi
002FA4r 2  68                 PLA
002FA5r 2  85 rr              STA   tok_tail_lo
002FA7r 2  68                 PLA
002FA8r 2  85 rr              STA   tok_head_hi
002FAAr 2  68                 PLA
002FABr 2  85 rr              STA   tok_head_lo
002FADr 2  60                 RTS
002FAEr 2               
002FAEr 2               ; ---------------------------------------------------------------------
002FAEr 2               ; proc_find_by_name — search proc_head for a procedure by name string
002FAEr 2               ;   Input: ptr_lo/hi = length-prefixed name string (e.g. from eval_val)
002FAEr 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002FAEr 2               ;           carry set = not found
002FAEr 2               ;   Clobbers: A, X, Y, proc_entry, proc_name_len, proc_rec_off
002FAEr 2               ; ---------------------------------------------------------------------
002FAEr 2               proc_find_by_name:
002FAEr 2                     ; Save search name pointer
002FAEr 2  A5 rr              LDA   ptr_lo
002FB0r 2  85 rr              STA   var_name_lo             ; reuse var scratch as search ptr
002FB2r 2  A5 rr              LDA   ptr_hi
002FB4r 2  85 rr              STA   var_name_hi
002FB6r 2               
002FB6r 2  A5 rr              LDA   proc_head_lo
002FB8r 2  85 rr              STA   proc_entry_lo
002FBAr 2  A5 rr              LDA   proc_head_hi
002FBCr 2  85 rr              STA   proc_entry_hi
002FBEr 2               
002FBEr 2               @walk:
002FBEr 2  A5 rr              LDA   proc_entry_lo
002FC0r 2  05 rr              ORA   proc_entry_hi
002FC2r 2  F0 55              BEQ   @not_found
002FC4r 2               
002FC4r 2                     ; Compare name lengths
002FC4r 2  A5 rr              LDA   var_name_lo
002FC6r 2  85 rr              STA   ptr_lo
002FC8r 2  A5 rr              LDA   var_name_hi
002FCAr 2  85 rr              STA   ptr_hi
002FCCr 2  A0 00              LDY   #0
002FCEr 2  B1 rr              LDA   (ptr_lo),Y             ; search name length
002FD0r 2  85 rr              STA   proc_name_len
002FD2r 2               
002FD2r 2  A5 rr              LDA   proc_entry_lo
002FD4r 2  85 rr              STA   ptr_lo
002FD6r 2  A5 rr              LDA   proc_entry_hi
002FD8r 2  85 rr              STA   ptr_hi
002FDAr 2  A0 02              LDY   #2
002FDCr 2  B1 rr              LDA   (ptr_lo),Y             ; record name length
002FDEr 2  C5 rr              CMP   proc_name_len
002FE0r 2  D0 32              BNE   @next
002FE2r 2               
002FE2r 2                     ; Lengths match — compare chars
002FE2r 2  AA                 TAX                           ; X = length
