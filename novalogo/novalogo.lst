002D17r 2  D0 02              BNE   @ln2_dec_lo
002D19r 2  C6 rr              DEC   proc_body_len_hi
002D1Br 2               @ln2_dec_lo:
002D1Br 2  C6 rr              DEC   proc_body_len_lo
002D1Dr 2                     ; fall through to end-of-physical-line decision
002D1Dr 2               
002D1Dr 2               @line_eol:
002D1Dr 2                     ; End of a physical line. If brackets/parens are still open AND there is
002D1Dr 2                     ; more body to read AND room in the buffer, append a separating space and
002D1Dr 2                     ; keep accumulating; otherwise the statement is complete.
002D1Dr 2  AD rr rr           LDA   proc_brk_depth
002D20r 2  F0 13              BEQ   @line_end             ; balanced -> execute
002D22r 2  A5 rr              LDA   proc_body_len_lo
002D24r 2  05 rr              ORA   proc_body_len_hi
002D26r 2  F0 0D              BEQ   @line_end             ; no more lines -> execute (eval will report)
002D28r 2  E0 78              CPX   #120
002D2Ar 2  B0 09              BCS   @line_end             ; buffer full -> execute
002D2Cr 2  A9 20              LDA   #' '                  ; join lines with whitespace
002D2Er 2  9D rr rr           STA   input_buf,X
002D31r 2  E8                 INX
002D32r 2  4C rr rr           JMP   @line_ch
002D35r 2               
002D35r 2               @line_end:
002D35r 2                     ; Null-terminate input_buf
002D35r 2  9E rr rr           STZ   input_buf,X
002D38r 2               
002D38r 2                     ; Tokenize this line
002D38r 2  20 rr rr           JSR   tokenize_line
