000169r 2               ; ---------------------------------------------------------------------
000169r 2               ; tok_scan_word — scan a word into TOK_WORD (uppercased)
000169r 2               ;   tok_src points at first character
000169r 2               ; ---------------------------------------------------------------------
000169r 2               tok_scan_word:
000169r 2  A6 rr              LDX   tok_src
00016Br 2  A0 00              LDY   #0                   ; length counter
00016Dr 2               @count:
00016Dr 2  BD rr rr           LDA   input_buf,X
000170r 2  20 rr rr           JSR   is_word_char
000173r 2  90 04              BCC   @counted
000175r 2  E8                 INX
000176r 2  C8                 INY
000177r 2  80 F4              BRA   @count
000179r 2               @counted:
000179r 2  98                 TYA
00017Ar 2  F0 53              BEQ   @empty
00017Cr 2  48                 PHA                        ; save length
00017Dr 2  18                 CLC
00017Er 2  69 04              ADC   #4                   ; node = 3 header + 1 length + chars
000180r 2  A2 01              LDX   #ATYPE_TOKEN
000182r 2  20 rr rr           JSR   heap_alloc
000185r 2  B0 47              BCS   @oom
000187r 2                     ; tag
000187r 2  A0 00              LDY   #TOK_TAG
000189r 2  A9 01              LDA   #TOK_WORD
00018Br 2  91 rr              STA   (ptr_lo),Y
00018Dr 2                     ; next = null
00018Dr 2  A0 01              LDY   #TOK_NEXT_LO
00018Fr 2  A9 00              LDA   #0
000191r 2  91 rr              STA   (ptr_lo),Y
000193r 2  C8                 INY
000194r 2  91 rr              STA   (ptr_lo),Y
