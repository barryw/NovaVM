001E86r 2  F0 6F              BEQ   @mem_false
001E88r 2               
001E88r 2  A5 rr              LDA   list_ptr_lo
001E8Ar 2  85 rr              STA   ptr_lo
001E8Cr 2  A5 rr              LDA   list_ptr_hi
001E8Er 2  85 rr              STA   ptr_hi
001E90r 2               
001E90r 2                     ; Compare type
001E90r 2  A0 01              LDY   #CONS_CAR_TYPE
001E92r 2  B1 rr              LDA   (ptr_lo),Y
001E94r 2  BA                 TSX
001E95r 2  DD 01 01           CMP   $0101,X
001E98r 2  D0 46              BNE   @mem_next
001E9Ar 2               
001E9Ar 2                     ; Types match — compare values
001E9Ar 2  C9 00              CMP   #VAL_NUMBER
001E9Cr 2  D0 1D              BNE   @mem_cmp_ptr
001E9Er 2               
001E9Er 2                     ; Compare number: hi, lo, frac
001E9Er 2  A0 02              LDY   #CONS_CAR_HI
001EA0r 2  B1 rr              LDA   (ptr_lo),Y
001EA2r 2  DD 02 01           CMP   $0102,X
001EA5r 2  D0 39              BNE   @mem_next
001EA7r 2  A0 03              LDY   #CONS_CAR_LO
001EA9r 2  B1 rr              LDA   (ptr_lo),Y
001EABr 2  DD 03 01           CMP   $0103,X
001EAEr 2  D0 30              BNE   @mem_next
001EB0r 2  A0 04              LDY   #CONS_CAR_FRAC
001EB2r 2  B1 rr              LDA   (ptr_lo),Y
001EB4r 2  DD 04 01           CMP   $0104,X
001EB7r 2  D0 27              BNE   @mem_next
001EB9r 2  80 12              BRA   @mem_true
001EBBr 2               
001EBBr 2               @mem_cmp_ptr:
001EBBr 2  A0 02              LDY   #CONS_CAR_HI
001EBDr 2  B1 rr              LDA   (ptr_lo),Y
001EBFr 2  DD 02 01           CMP   $0102,X
001EC2r 2  D0 1C              BNE   @mem_next
