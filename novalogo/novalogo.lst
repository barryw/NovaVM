0021CFr 2               
0021CFr 2                     ; Pop first list pointer
0021CFr 2  68                 PLA                           ; frac (unused)
0021D0r 2  68                 PLA                           ; lo
0021D1r 2  85 rr              STA   list_head_lo
0021D3r 2  68                 PLA                           ; hi
0021D4r 2  85 rr              STA   list_head_hi
