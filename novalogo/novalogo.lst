0021C7r 2                     ; Pop second list pointer
0021C7r 2  68                 PLA                           ; frac (unused)
0021C8r 2  68                 PLA                           ; lo
0021C9r 2  85 rr              STA   list_tail_lo
0021CBr 2  68                 PLA                           ; hi
0021CCr 2  85 rr              STA   list_tail_hi
