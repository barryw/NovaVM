001560r 2  48                 PHA
001561r 2  A5 rr              LDA   eval_cur_hi
001563r 2  48                 PHA
001564r 2               
001564r 2                     ; Read a line from keyboard into input_buf
001564r 2  20 rr rr           JSR   read_line
001567r 2                     ; Tokenize it
001567r 2  20 rr rr           JSR   tokenize_line
00156Ar 2               
00156Ar 2                     ; Walk tokens and build a list
00156Ar 2  64 rr              STZ   z:list_head_lo
00156Cr 2  64 rr              STZ   z:list_head_hi
00156Er 2  64 rr              STZ   z:list_tail_lo
001570r 2  64 rr              STZ   z:list_tail_hi
001572r 2               
001572r 2  A5 rr              LDA   tok_head_lo
001574r 2  85 rr              STA   eval_cur_lo
