00068Dr 1                     .include "lists.s"
00068Dr 2               ; lists.s — list data type, cons pairs, and list operations for NovaLogo
00068Dr 2               ;
00068Dr 2               ; Cons pair format on heap (7 bytes):
00068Dr 2               ;   +0: tag byte ($10 = CONS_PAIR)
00068Dr 2               ;   +1: car_type ($00=number, $01=word, $02=list)
00068Dr 2               ;   +2: car_hi
00068Dr 2               ;   +3: car_lo
00068Dr 2               ;   +4: car_frac (only meaningful for numbers)
00068Dr 2               ;   +5: cdr_lo (pointer to next cons pair, or $0000 for empty)
00068Dr 2               ;   +6: cdr_hi
00068Dr 2               
00068Dr 2               CONS_PAIR  = $10
00068Dr 2               CONS_SIZE  = 7
00068Dr 2               
00068Dr 2               ; Value type constants
00068Dr 2               .ifndef VAL_NUMBER
00068Dr 2               VAL_NUMBER = $00
00068Dr 2               .endif
00068Dr 2               .ifndef VAL_WORD
00068Dr 2               VAL_WORD   = $01
00068Dr 2               .endif
00068Dr 2               .ifndef VAL_LIST
00068Dr 2               VAL_LIST   = $02
00068Dr 2               .endif
00068Dr 2               
00068Dr 2               ; Cons pair field offsets
00068Dr 2               CONS_TAG      = 0
00068Dr 2               CONS_CAR_TYPE = 1
00068Dr 2               CONS_CAR_HI   = 2
00068Dr 2               CONS_CAR_LO   = 3
00068Dr 2               CONS_CAR_FRAC = 4
00068Dr 2               CONS_CDR_LO   = 5
00068Dr 2               CONS_CDR_HI   = 6
00068Dr 2               
00068Dr 2               ; =====================================================================
00068Dr 2               ; ZEROPAGE segment — list scratch variables
00068Dr 2               ; =====================================================================
00068Dr 2                     .segment "ZEROPAGE"
00002Er 2               
00002Er 2  xx           list_head_lo:   .res 1    ; head of list being built
00002Fr 2  xx           list_head_hi:   .res 1
000030r 2  xx           list_tail_lo:   .res 1    ; tail of list being built
000031r 2  xx           list_tail_hi:   .res 1
000032r 2  xx           list_ptr_lo:    .res 1    ; general list walk pointer
000033r 2  xx           list_ptr_hi:    .res 1
000034r 2  xx           list_count_lo:  .res 1    ; 16-bit counter for COUNT / ITEM
000035r 2  xx           list_count_hi:  .res 1
000036r 2               
000036r 2               ; =====================================================================
000036r 2               ; CODE segment — list building and operations
000036r 2               ; =====================================================================
000036r 2                     .segment "CODE"
001827r 2               
001827r 2               ; ---------------------------------------------------------------------
001827r 2               ; eval_list — build a list from tokens between [ and ]
001827r 2               ;   Entry: eval_cur points at the first token AFTER the [
001827r 2               ;   Exit:  eval_type = VAL_LIST, eval_val_lo/hi = head cons pair ptr
001827r 2               ;          eval_cur advanced past the matching ]
001827r 2               ;          Carry clear = success
001827r 2               ; ---------------------------------------------------------------------
001827r 2               eval_list:
001827r 2  64 rr              STZ   list_head_lo
001829r 2  64 rr              STZ   list_head_hi
00182Br 2  64 rr              STZ   list_tail_lo
00182Dr 2  64 rr              STZ   list_tail_hi
00182Fr 2               
00182Fr 2               @next_element:
00182Fr 2  A5 rr              LDA   eval_cur_lo
001831r 2  05 rr              ORA   eval_cur_hi
001833r 2  D0 03              BNE   :+
001835r 2  4C rr rr           JMP   @err_no_bracket
001838r 2               :
001838r 2  A5 rr              LDA   eval_cur_lo
00183Ar 2  85 rr              STA   ptr_lo
00183Cr 2  A5 rr              LDA   eval_cur_hi
00183Er 2  85 rr              STA   ptr_hi
001840r 2  A0 00              LDY   #TOK_TAG
001842r 2  B1 rr              LDA   (ptr_lo),Y
001844r 2               
001844r 2  C9 04              CMP   #TOK_RBRACKET
001846r 2  D0 03              BNE   :+
001848r 2  4C rr rr           JMP   @end_list
00184Br 2               :
00184Br 2  C9 02              CMP   #TOK_NUMBER
00184Dr 2  D0 03              BNE   :+
00184Fr 2  4C rr rr           JMP   @list_number
001852r 2  C9 01        :     CMP   #TOK_WORD
001854r 2  F0 10              BEQ   @list_word_jmp
001856r 2  C9 06              CMP   #TOK_QUOTE
001858r 2  F0 0C              BEQ   @list_word_jmp
00185Ar 2  C9 03              CMP   #TOK_LBRACKET
00185Cr 2  D0 03              BNE   :+
00185Er 2  4C rr rr           JMP   @list_sublist
001861r 2               :     ; Unknown token type in list — skip it
001861r 2  20 rr rr           JSR   eval_advance
001864r 2  80 C9              BRA   @next_element
001866r 2               
001866r 2               @list_word_jmp:
001866r 2  4C rr rr           JMP   @list_word
001869r 2               
001869r 2               @list_number:
001869r 2  A0 03              LDY   #TOK_PAYLOAD
00186Br 2  B1 rr              LDA   (ptr_lo),Y
00186Dr 2  85 rr              STA   eval_val_hi
00186Fr 2  C8                 INY
001870r 2  B1 rr              LDA   (ptr_lo),Y
001872r 2  85 rr              STA   eval_val_lo
001874r 2  C8                 INY
001875r 2  B1 rr              LDA   (ptr_lo),Y
001877r 2  85 rr              STA   eval_val_frac
001879r 2  A9 00              LDA   #VAL_NUMBER
00187Br 2  85 rr              STA   eval_type
00187Dr 2  20 rr rr           JSR   eval_advance
001880r 2  4C rr rr           JMP   @alloc_cell
001883r 2               
001883r 2               @list_word:
001883r 2  A0 03              LDY   #TOK_PAYLOAD
001885r 2  B1 rr              LDA   (ptr_lo),Y
001887r 2  48                 PHA
001888r 2  1A                 INC
001889r 2  A2 05              LDX   #ATYPE_STRING
00188Br 2  20 rr rr           JSR   heap_alloc
00188Er 2  90 04              BCC   :+
001890r 2  68                 PLA
001891r 2  4C rr rr           JMP   @oom
001894r 2  A5 rr        :     LDA   eval_cur_lo
001896r 2  85 rr              STA   ptr2_lo
001898r 2  A5 rr              LDA   eval_cur_hi
00189Ar 2  85 rr              STA   ptr2_hi
00189Cr 2  68                 PLA
00189Dr 2  48                 PHA
00189Er 2  A0 00              LDY   #0
0018A0r 2  91 rr              STA   (ptr_lo),Y
0018A2r 2  68                 PLA
0018A3r 2  AA                 TAX
0018A4r 2  F0 1B              BEQ   @word_done
0018A6r 2  A0 01              LDY   #1
0018A8r 2  9C rr rr           STZ   num_tmp_lo
0018ABr 2               @copy_word_ch:
0018ABr 2  DA                 PHX
0018ACr 2  5A                 PHY
0018ADr 2  AD rr rr           LDA   num_tmp_lo
0018B0r 2  18                 CLC
0018B1r 2  69 04              ADC   #TOK_PAYLOAD+1
0018B3r 2  A8                 TAY
0018B4r 2  B1 rr              LDA   (ptr2_lo),Y
0018B6r 2  7A                 PLY
0018B7r 2  91 rr              STA   (ptr_lo),Y
0018B9r 2  C8                 INY
0018BAr 2  EE rr rr           INC   num_tmp_lo
0018BDr 2  FA                 PLX
0018BEr 2  CA                 DEX
0018BFr 2  D0 EA              BNE   @copy_word_ch
0018C1r 2               @word_done:
0018C1r 2  A5 rr              LDA   ptr_lo
0018C3r 2  85 rr              STA   eval_val_lo
0018C5r 2  A5 rr              LDA   ptr_hi
0018C7r 2  85 rr              STA   eval_val_hi
0018C9r 2  64 rr              STZ   eval_val_frac
0018CBr 2  A9 01              LDA   #VAL_WORD
0018CDr 2  85 rr              STA   eval_type
0018CFr 2  20 rr rr           JSR   eval_advance
0018D2r 2  4C rr rr           JMP   @alloc_cell
0018D5r 2               
0018D5r 2               @list_sublist:
0018D5r 2  20 rr rr           JSR   eval_advance
0018D8r 2  A5 rr              LDA   list_head_lo
0018DAr 2  48                 PHA
0018DBr 2  A5 rr              LDA   list_head_hi
0018DDr 2  48                 PHA
0018DEr 2  A5 rr              LDA   list_tail_lo
0018E0r 2  48                 PHA
0018E1r 2  A5 rr              LDA   list_tail_hi
0018E3r 2  48                 PHA
0018E4r 2  20 rr rr           JSR   eval_list
0018E7r 2  90 06              BCC   @sublist_ok
0018E9r 2                     ; Error — clean up stack
0018E9r 2  68                 PLA
0018EAr 2  68                 PLA
0018EBr 2  68                 PLA
0018ECr 2  68                 PLA
0018EDr 2  38                 SEC
0018EEr 2  60                 RTS
0018EFr 2               @sublist_ok:
0018EFr 2  68                 PLA
