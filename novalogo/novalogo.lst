001D39r 2  A0 05              LDY   #CONS_CDR_LO
001D3Br 2  A9 00              LDA   #0
001D3Dr 2  91 rr              STA   (ptr_lo),Y
001D3Fr 2  A0 06              LDY   #CONS_CDR_HI
001D41r 2  91 rr              STA   (ptr_lo),Y
001D43r 2               
001D43r 2                     ; Link into new list
001D43r 2  A5 rr              LDA   list_head_lo
001D45r 2  05 rr              ORA   list_head_hi
001D47r 2  D0 0E              BNE   @bl_link
001D49r 2                     ; First cell
001D49r 2  A5 rr              LDA   ptr_lo
001D4Br 2  85 rr              STA   list_head_lo
001D4Dr 2  85 rr              STA   list_tail_lo
001D4Fr 2  A5 rr              LDA   ptr_hi
001D51r 2  85 rr              STA   list_head_hi
001D53r 2  85 rr              STA   list_tail_hi
001D55r 2  80 1C              BRA   @bl_next
