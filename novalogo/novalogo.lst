002C8Cr 2                     ; tokenize, eval, repeat.
002C8Cr 2                     ; proc_ptr = current position in body text
002C8Cr 2                     ; proc_body_len = remaining bytes
002C8Cr 2               
002C8Cr 2                     ; Clear STOP/OUTPUT flag before executing body
002C8Cr 2  64 rr              STZ   proc_stopped
002C8Er 2               
002C8Er 2               @exec_line:
002C8Er 2                     ; Any body text remaining?
002C8Er 2  A5 rr              LDA   proc_body_len_lo
002C90r 2  05 rr              ORA   proc_body_len_hi
002C92r 2  D0 03              BNE   @have_body
002C94r 2  4C rr rr           JMP   @exec_done
002C97r 2               @have_body:
002C97r 2               
002C97r 2                     ; Reset heap for this statement's tokens (reuse token heap each statement)
002C97r 2  AD rr rr           LDA   save_heap_ptr_lo
002C9Ar 2  85 rr              STA   heap_ptr
002C9Cr 2  AD rr rr           LDA   save_heap_ptr_hi
002C9Fr 2  85 rr              STA   heap_ptr+1
002CA1r 2               
002CA1r 2                     ; Accumulate physical lines into one logical statement: keep copying lines
002CA1r 2                     ; into input_buf until bracket/paren depth returns to 0, so a [ ... ] or
002CA1r 2                     ; ( ... ) that spans several lines is pieced together before we tokenize.
002CA1r 2  A2 00              LDX   #0                    ; input_buf index
002CA3r 2  9C rr rr           STZ   proc_brk_depth
002CA6r 2               @line_ch:
002CA6r 2  A5 rr              LDA   proc_body_len_lo
002CA8r 2  05 rr              ORA   proc_body_len_hi
002CAAr 2  F0 71              BEQ   @line_eol             ; no more body text -> end of last line
002CACr 2               
002CACr 2  A0 00              LDY   #0
002CAEr 2  B1 rr              LDA   (proc_ptr_lo),Y      ; read body char
002CB0r 2  C9 0A              CMP   #$0A
002CB2r 2  F0 5B              BEQ   @line_nl
002CB4r 2  C9 3B              CMP   #';'                 ; comment -> skip rest of physical line
002CB6r 2  F0 37              BEQ   @line_comment
002CB8r 2               
002CB8r 2                     ; Store char in input_buf, tracking bracket/paren nesting depth.
002CB8r 2  9D rr rr           STA   input_buf,X
002CBBr 2  E8                 INX
002CBCr 2  C9 5B              CMP   #'['
002CBEr 2  F0 20              BEQ   @brk_inc
002CC0r 2  C9 28              CMP   #'('
002CC2r 2  F0 1C              BEQ   @brk_inc
002CC4r 2  C9 5D              CMP   #']'
002CC6r 2  F0 1D              BEQ   @brk_dec
002CC8r 2  C9 29              CMP   #')'
002CCAr 2  F0 19              BEQ   @brk_dec
002CCCr 2               @brk_done:
002CCCr 2                     ; Advance body pointer
002CCCr 2  E6 rr              INC   proc_ptr_lo
002CCEr 2  D0 02              BNE   :+
002CD0r 2  E6 rr              INC   proc_ptr_hi
002CD2r 2               :     ; Decrement remaining
002CD2r 2  A5 rr              LDA   proc_body_len_lo
002CD4r 2  D0 02              BNE   @ln_dec_lo
002CD6r 2  C6 rr              DEC   proc_body_len_hi
002CD8r 2               @ln_dec_lo:
002CD8r 2  C6 rr              DEC   proc_body_len_lo
002CDAr 2                     ; Guard against input_buf overflow (~120 chars per statement).
002CDAr 2  E0 78              CPX   #120
002CDCr 2  B0 3F              BCS   @line_eol
002CDEr 2  80 C6              BRA   @line_ch
002CE0r 2               
002CE0r 2               @brk_inc:
002CE0r 2  EE rr rr           INC   proc_brk_depth
002CE3r 2  80 E7              BRA   @brk_done
002CE5r 2               @brk_dec:
002CE5r 2  AD rr rr           LDA   proc_brk_depth
002CE8r 2  F0 E2              BEQ   @brk_done             ; floor at 0
002CEAr 2  CE rr rr           DEC   proc_brk_depth
002CEDr 2  80 DD              BRA   @brk_done
002CEFr 2               
002CEFr 2               @line_comment:
002CEFr 2                     ; ';' begins a comment: advance past the rest of this physical line
002CEFr 2                     ; without copying, so comment text (and any brackets in it) is ignored.
002CEFr 2  A5 rr              LDA   proc_body_len_lo
002CF1r 2  05 rr              ORA   proc_body_len_hi
002CF3r 2  F0 28              BEQ   @line_eol             ; comment runs to end of body
002CF5r 2  A0 00              LDY   #0
002CF7r 2  B1 rr              LDA   (proc_ptr_lo),Y
002CF9r 2  48                 PHA                         ; remember if this was the newline
002CFAr 2  E6 rr              INC   proc_ptr_lo
002CFCr 2  D0 02              BNE   :+
002CFEr 2  E6 rr              INC   proc_ptr_hi
002D00r 2  A5 rr        :     LDA   proc_body_len_lo
002D02r 2  D0 02              BNE   @cmt_dec
002D04r 2  C6 rr              DEC   proc_body_len_hi
002D06r 2               @cmt_dec:
002D06r 2  C6 rr              DEC   proc_body_len_lo
