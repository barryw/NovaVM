000F52r 2  B0 10              BCS   @err_bracket
000F54r 2  4C rr rr           JMP   eval_continue
000F57r 2               
000F57r 2               @is_true:
000F57r 2                     ; TRUE: execute first body, skip second
000F57r 2  20 rr rr           JSR   exec_body_block
