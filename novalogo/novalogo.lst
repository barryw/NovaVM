00133Dr 2                     ; --- Main loop ---
00133Dr 2               @wu_loop:
00133Dr 2  A5 rr              LDA   proc_stopped
00133Fr 2  D0 38              BNE   @wu_done
001341r 2               
001341r 2                     ; Evaluate condition: set eval_cur to cond_start, run body
001341r 2  A5 rr              LDA   cond_start_lo
001343r 2  85 rr              STA   eval_cur_lo
001345r 2  A5 rr              LDA   cond_start_hi
001347r 2  85 rr              STA   eval_cur_hi
001349r 2  A9 01              LDA   #$01
00134Br 2  85 rr              STA   eval_in_body
00134Dr 2               
00134Dr 2                     ; We need to evaluate an expression from the condition body.
00134Dr 2                     ; The condition block contains an expression, so use eval_expr.
00134Dr 2  20 rr rr           JSR   eval_expr
001350r 2  B0 27              BCS   @wu_done                ; eval error = stop
001352r 2               
001352r 2                     ; Check result: nonzero integer = true
001352r 2  A5 rr              LDA   eval_val_lo
001354r 2  05 rr              ORA   eval_val_hi
001356r 2                     ; Result in A: nonzero = true condition
001356r 2               
001356r 2                     ; Read mode from stack to decide behavior
001356r 2                     ; Mode is at the bottom of our saved state block.
001356r 2                     ; Stack layout (top-down): eval_in_body, cond_start_hi/lo,
001356r 2                     ;   body_resume_hi/lo, body_start_hi/lo, mode
001356r 2                     ; That's 8 bytes deep from current SP.
001356r 2  BA                 TSX
001357r 2  BC 08 01           LDY   $0108,X                 ; mode: 0=WHILE, 1=UNTIL
00135Ar 2               
00135Ar 2  C0 00              CPY   #0
00135Cr 2  D0 06              BNE   @wu_until_check
00135Er 2               
00135Er 2                     ; WHILE: if condition is false (zero), stop
00135Er 2  C9 00              CMP   #0                      ; A still has lo|hi result
001360r 2  F0 17              BEQ   @wu_done
001362r 2  80 04              BRA   @wu_exec_body
001364r 2               
001364r 2               @wu_until_check:
001364r 2                     ; UNTIL: if condition is true (nonzero), stop
001364r 2  C9 00              CMP   #0
001366r 2  D0 11              BNE   @wu_done
001368r 2               
001368r 2               @wu_exec_body:
001368r 2                     ; Execute body
001368r 2  A5 rr              LDA   body_start_lo
00136Ar 2  85 rr              STA   eval_cur_lo
00136Cr 2  A5 rr              LDA   body_start_hi
00136Er 2  85 rr              STA   eval_cur_hi
001370r 2  A9 01              LDA   #$01
001372r 2  85 rr              STA   eval_in_body
001374r 2  20 rr rr           JSR   eval_body
001377r 2               
001377r 2  80 C4              BRA   @wu_loop
001379r 2               
001379r 2               @wu_done:
001379r 2                     ; Restore outer state
001379r 2  68                 PLA
00137Ar 2  85 rr              STA   eval_in_body
00137Cr 2  68                 PLA
00137Dr 2  85 rr              STA   cond_start_hi
00137Fr 2  68                 PLA
001380r 2  85 rr              STA   cond_start_lo
001382r 2  68                 PLA
001383r 2  85 rr              STA   body_resume_hi
001385r 2  68                 PLA
001386r 2  85 rr              STA   body_resume_lo
001388r 2  68                 PLA
001389r 2  85 rr              STA   body_start_hi
00138Br 2  68                 PLA
00138Cr 2  85 rr              STA   body_start_lo
00138Er 2  68                 PLA                           ; discard mode byte
00138Fr 2               
00138Fr 2                     ; Resume past the body
00138Fr 2  A5 rr              LDA   body_resume_lo
001391r 2  85 rr              STA   eval_cur_lo
001393r 2  A5 rr              LDA   body_resume_hi
001395r 2  85 rr              STA   eval_cur_hi
001397r 2  4C rr rr           JMP   eval_continue
00139Ar 2               
00139Ar 2               wu_err_bracket:
