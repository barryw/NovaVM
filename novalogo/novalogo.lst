0014A1r 2               ; do_readlist — READLIST: read a line, return as a list
0014A1r 2               ;   Arity 0, no arguments. Reporter.
0014A1r 2               ;   Calls read_line, tokenize_line, then walks tokens building a list.
0014A1r 2               ; ---------------------------------------------------------------------
0014A1r 2               do_readlist:
0014A1r 2                     ; Save tokenizer state (we'll overwrite tok_head/tok_tail)
0014A1r 2  A5 rr              LDA   tok_head_lo
0014A3r 2  48                 PHA
0014A4r 2  A5 rr              LDA   tok_head_hi
0014A6r 2  48                 PHA
0014A7r 2  A5 rr              LDA   tok_tail_lo
0014A9r 2  48                 PHA
0014AAr 2  A5 rr              LDA   tok_tail_hi
0014ACr 2  48                 PHA
0014ADr 2  A5 rr              LDA   eval_cur_lo
0014AFr 2  48                 PHA
0014B0r 2  A5 rr              LDA   eval_cur_hi
0014B2r 2  48                 PHA
0014B3r 2               
0014B3r 2                     ; Read a line from keyboard into input_buf
0014B3r 2  20 rr rr           JSR   read_line
0014B6r 2                     ; Tokenize it
0014B6r 2  20 rr rr           JSR   tokenize_line
0014B9r 2               
0014B9r 2                     ; Walk tokens and build a list
0014B9r 2  64 rr              STZ   z:list_head_lo
0014BBr 2  64 rr              STZ   z:list_head_hi
0014BDr 2  64 rr              STZ   z:list_tail_lo
0014BFr 2  64 rr              STZ   z:list_tail_hi
