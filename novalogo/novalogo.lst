00148Dr 2  20 rr rr           JSR   read_line
001490r 2                     ; Tokenize it
001490r 2  20 rr rr           JSR   tokenize_line
001493r 2               
001493r 2                     ; Walk tokens and build a list
001493r 2  64 rr              STZ   z:list_head_lo
001495r 2  64 rr              STZ   z:list_head_hi
001497r 2  64 rr              STZ   z:list_tail_lo
001499r 2  64 rr              STZ   z:list_tail_hi
