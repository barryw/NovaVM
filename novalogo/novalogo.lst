001413r 2               
001413r 2                     ; Check result: nonzero integer = true
001413r 2  A5 rr              LDA   eval_val_lo
001415r 2  05 rr              ORA   eval_val_hi
001417r 2                     ; Result in A: nonzero = true condition
001417r 2               
001417r 2                     ; Read mode from stack to decide behavior
001417r 2                     ; Mode is at the bottom of our saved state block.
001417r 2                     ; Stack layout (top-down): eval_in_body, cond_start_hi/lo,
001417r 2                     ;   body_resume_hi/lo, body_start_hi/lo, mode
