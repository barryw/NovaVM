000F6Ar 2               @err:
000F6Ar 2  A2 rr              LDX   #<str_ifelse_err
000F6Cr 2  A0 rr              LDY   #>str_ifelse_err
000F6Er 2                     ; fall through
000F6Er 2               
000F6Er 2               ifelse_print_err:
000F6Er 2  86 rr              STX   ptr_lo
000F70r 2  84 rr              STY   ptr_hi
000F72r 2  A0 00              LDY   #0
000F74r 2               @lp:
000F74r 2  B1 rr              LDA   (ptr_lo),Y
000F76r 2  F0 06              BEQ   @done
