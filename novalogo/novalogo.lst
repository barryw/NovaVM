001962r 2               ; ---------------------------------------------------------------------
001962r 2               ; print_list — print a list value to screen with brackets
001962r 2               ;   Entry: eval_val_lo/hi = head cons pair pointer (or $0000)
001962r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr
001962r 2               ; ---------------------------------------------------------------------
001962r 2               print_list:
001962r 2  A9 5B              LDA   #'['
001964r 2  8D 0E A0           STA   VGC_CHAROUT
001967r 2               
001967r 2  A5 rr              LDA   eval_val_lo
001969r 2  85 rr              STA   list_ptr_lo
00196Br 2  A5 rr              LDA   eval_val_hi
00196Dr 2  85 rr              STA   list_ptr_hi
00196Fr 2               
00196Fr 2  A2 00              LDX   #0                  ; 0 = first element (no leading space)
001971r 2               
001971r 2               @pl_loop:
001971r 2  A5 rr              LDA   list_ptr_lo
001973r 2  05 rr              ORA   list_ptr_hi
001975r 2  D0 03              BNE   :+
001977r 2  4C rr rr           JMP   @pl_done
00197Ar 2               :
00197Ar 2  E0 00              CPX   #0
00197Cr 2  F0 05              BEQ   @pl_no_space
00197Er 2  A9 20              LDA   #' '
001980r 2  8D 0E A0           STA   VGC_CHAROUT
001983r 2               @pl_no_space:
001983r 2  A2 01              LDX   #1
001985r 2               
001985r 2  A5 rr              LDA   list_ptr_lo
001987r 2  85 rr              STA   ptr_lo
001989r 2  A5 rr              LDA   list_ptr_hi
00198Br 2  85 rr              STA   ptr_hi
00198Dr 2  A0 01              LDY   #CONS_CAR_TYPE
00198Fr 2  B1 rr              LDA   (ptr_lo),Y
001991r 2  C9 02              CMP   #VAL_LIST
001993r 2  F0 2C              BEQ   @pl_sublist
001995r 2  C9 01              CMP   #VAL_WORD
001997r 2  D0 03              BNE   :+
001999r 2  4C rr rr           JMP   @pl_word
00199Cr 2               :
00199Cr 2                     ; Number
00199Cr 2  DA                 PHX
00199Dr 2  A5 rr              LDA   list_ptr_lo
00199Fr 2  48                 PHA
0019A0r 2  A5 rr              LDA   list_ptr_hi
0019A2r 2  48                 PHA
0019A3r 2  A0 02              LDY   #CONS_CAR_HI
0019A5r 2  B1 rr              LDA   (ptr_lo),Y
0019A7r 2  85 rr              STA   eval_val_hi
0019A9r 2  A0 03              LDY   #CONS_CAR_LO
0019ABr 2  B1 rr              LDA   (ptr_lo),Y
0019ADr 2  85 rr              STA   eval_val_lo
0019AFr 2  A0 04              LDY   #CONS_CAR_FRAC
0019B1r 2  B1 rr              LDA   (ptr_lo),Y
0019B3r 2  85 rr              STA   eval_val_frac
0019B5r 2  20 rr rr           JSR   print_number
0019B8r 2  68                 PLA
0019B9r 2  85 rr              STA   list_ptr_hi
0019BBr 2  68                 PLA
0019BCr 2  85 rr              STA   list_ptr_lo
0019BEr 2  FA                 PLX
0019BFr 2  80 4A              BRA   @pl_advance
0019C1r 2               
0019C1r 2               @pl_sublist:
0019C1r 2  DA                 PHX
0019C2r 2  A5 rr              LDA   list_ptr_lo
0019C4r 2  48                 PHA
