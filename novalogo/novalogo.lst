002267r 2               ; ---------------------------------------------------------------------
002267r 2               ; do_word — WORD val1 val2: concatenate two words into one
002267r 2               ;   Arity 0: evaluates its own arguments
002267r 2               ; ---------------------------------------------------------------------
002267r 2               do_word:
002267r 2                     ; Evaluate first arg (must be a word)
002267r 2  20 rr rr           JSR   eval_expr
00226Ar 2  90 03              BCC   :+
00226Cr 2  4C rr rr           JMP   @err
00226Fr 2               :
00226Fr 2  A5 rr              LDA   eval_type
002271r 2  C9 01              CMP   #VAL_WORD
002273r 2  F0 03              BEQ   :+
002275r 2  4C rr rr           JMP   @err_type
002278r 2               :
002278r 2                     ; Save first word pointer
002278r 2  A5 rr              LDA   eval_val_lo
00227Ar 2  48                 PHA
00227Br 2  A5 rr              LDA   eval_val_hi
00227Dr 2  48                 PHA
00227Er 2               
00227Er 2                     ; Evaluate second arg (must be a word)
00227Er 2  20 rr rr           JSR   eval_expr
002281r 2  90 05              BCC   :+
002283r 2  68                 PLA
002284r 2  68                 PLA
002285r 2  4C rr rr           JMP   @err
002288r 2               :
002288r 2  A5 rr              LDA   eval_type
00228Ar 2  C9 01              CMP   #VAL_WORD
00228Cr 2  F0 03              BEQ   :+
00228Er 2  4C rr rr           JMP   @err_type_pop2
002291r 2               :
002291r 2               
002291r 2                     ; eval_val = second word, stack has first word ptr
002291r 2                     ; Read lengths
002291r 2  A5 rr              LDA   eval_val_lo
002293r 2  85 rr              STA   ptr2_lo
002295r 2  A5 rr              LDA   eval_val_hi
002297r 2  85 rr              STA   ptr2_hi
002299r 2  A0 00              LDY   #0
00229Br 2  B1 rr              LDA   (ptr2_lo),Y            ; second word length
00229Dr 2  85 rr              STA   list_count_lo           ; save len2
00229Fr 2               
00229Fr 2                     ; Read first word length from stack
00229Fr 2  68                 PLA
0022A0r 2  85 rr              STA   list_head_hi            ; first word ptr hi
0022A2r 2  68                 PLA
0022A3r 2  85 rr              STA   list_head_lo            ; first word ptr lo
0022A5r 2  A5 rr              LDA   list_head_lo
0022A7r 2  85 rr              STA   ptr_lo
0022A9r 2  A5 rr              LDA   list_head_hi
0022ABr 2  85 rr              STA   ptr_hi
0022ADr 2  A0 00              LDY   #0
0022AFr 2  B1 rr              LDA   (ptr_lo),Y             ; first word length
0022B1r 2  85 rr              STA   list_count_hi           ; save len1
0022B3r 2               
0022B3r 2                     ; Allocate new string: 1 (length byte) + len1 + len2
0022B3r 2  18                 CLC
0022B4r 2  65 rr              ADC   list_count_lo
0022B6r 2  1A                 INC                           ; +1 for length byte
0022B7r 2  A2 05              LDX   #ATYPE_STRING
0022B9r 2  20 rr rr           JSR   heap_alloc
0022BCr 2  B0 6F              BCS   @err_oom
0022BEr 2               
0022BEr 2                     ; Write combined length
0022BEr 2  A5 rr              LDA   list_count_hi
0022C0r 2  18                 CLC
0022C1r 2  65 rr              ADC   list_count_lo
0022C3r 2  A0 00              LDY   #0
0022C5r 2  91 rr              STA   (ptr_lo),Y
0022C7r 2               
0022C7r 2                     ; Copy first word's chars
0022C7r 2  A6 rr              LDX   list_count_hi           ; len1
0022C9r 2  F0 23              BEQ   @w_copy2
0022CBr 2  A5 rr              LDA   list_head_lo
0022CDr 2  85 rr              STA   ptr2_lo
0022CFr 2  A5 rr              LDA   list_head_hi
0022D1r 2  85 rr              STA   ptr2_hi
0022D3r 2  A0 01              LDY   #1                     ; dest offset in new string
0022D5r 2  9C rr rr           STZ   num_tmp_lo              ; source offset
0022D8r 2               @w_c1:
0022D8r 2  DA                 PHX
0022D9r 2  5A                 PHY
0022DAr 2  AD rr rr           LDA   num_tmp_lo
0022DDr 2  1A                 INC                           ; skip length byte in source
0022DEr 2  A8                 TAY
0022DFr 2  B1 rr              LDA   (ptr2_lo),Y            ; source char
0022E1r 2  7A                 PLY
0022E2r 2  91 rr              STA   (ptr_lo),Y             ; dest char
0022E4r 2  C8                 INY
0022E5r 2  EE rr rr           INC   num_tmp_lo
0022E8r 2  FA                 PLX
0022E9r 2  CA                 DEX
0022EAr 2  D0 EC              BNE   @w_c1
0022ECr 2               
0022ECr 2                     ; Y is already at the next dest offset
0022ECr 2  80 02              BRA   @w_copy2_start
0022EEr 2               
0022EEr 2               @w_copy2:
0022EEr 2  A0 01              LDY   #1                     ; start at offset 1 if len1 was 0
0022F0r 2               @w_copy2_start:
0022F0r 2                     ; Copy second word's chars
0022F0r 2  A6 rr              LDX   list_count_lo           ; len2
0022F2r 2  F0 1F              BEQ   @w_done
0022F4r 2  A5 rr              LDA   eval_val_lo
0022F6r 2  85 rr              STA   ptr2_lo
0022F8r 2  A5 rr              LDA   eval_val_hi
0022FAr 2  85 rr              STA   ptr2_hi
0022FCr 2  9C rr rr           STZ   num_tmp_lo
0022FFr 2               @w_c2:
0022FFr 2  DA                 PHX
002300r 2  5A                 PHY
002301r 2  AD rr rr           LDA   num_tmp_lo
002304r 2  1A                 INC
002305r 2  A8                 TAY
002306r 2  B1 rr              LDA   (ptr2_lo),Y
002308r 2  7A                 PLY
002309r 2  91 rr              STA   (ptr_lo),Y
00230Br 2  C8                 INY
00230Cr 2  EE rr rr           INC   num_tmp_lo
00230Fr 2  FA                 PLX
002310r 2  CA                 DEX
002311r 2  D0 EC              BNE   @w_c2
002313r 2               
002313r 2               @w_done:
002313r 2                     ; Return the new word
002313r 2  A9 01              LDA   #VAL_WORD
002315r 2  85 rr              STA   eval_type
002317r 2  A5 rr              LDA   ptr_lo
002319r 2  85 rr              STA   eval_val_lo
00231Br 2  A5 rr              LDA   ptr_hi
00231Dr 2  85 rr              STA   eval_val_hi
00231Fr 2  64 rr              STZ   eval_val_frac
002321r 2  4C rr rr           JMP   eval_continue
002324r 2               
002324r 2               @err_type_pop2:
002324r 2  68                 PLA
002325r 2  68                 PLA
002326r 2               @err_type:
002326r 2  A2 rr              LDX   #<str_word_type
002328r 2  A0 rr              LDY   #>str_word_type
00232Ar 2  4C rr rr           JMP   list_print_err
00232Dr 2               @err_oom:
00232Dr 2               @err:
00232Dr 2  A2 rr              LDX   #<str_word_err
00232Fr 2  A0 rr              LDY   #>str_word_err
002331r 2  4C rr rr           JMP   list_print_err
002334r 2               
002334r 2               ; ---------------------------------------------------------------------
002334r 2               ; do_run — RUN list: evaluate a list as Logo code
002334r 2               ;   Arity 0: evaluates its own argument
002334r 2               ;
002334r 2               ;   Strategy: convert list to text in input_buf, then save evaluator
002334r 2               ;   state, tokenize_line + eval_line, restore state.
002334r 2               ; ---------------------------------------------------------------------
002334r 2               do_run:
002334r 2  20 rr rr           JSR   eval_expr
002337r 2  90 03              BCC   :+
002339r 2  4C rr rr           JMP   @err
00233Cr 2               :
00233Cr 2  A5 rr              LDA   eval_type
00233Er 2  C9 02              CMP   #VAL_LIST
002340r 2  D0 43              BNE   @err_type
002342r 2               
002342r 2                     ; Save eval_cur on stack (we'll resume here after RUN)
002342r 2  A5 rr              LDA   eval_cur_lo
002344r 2  48                 PHA
002345r 2  A5 rr              LDA   eval_cur_hi
002347r 2  48                 PHA
002348r 2               
002348r 2                     ; Render the list into input_buf as text
002348r 2                     ; eval_val_lo/hi = list head
002348r 2  64 rr              STZ   z:buf_idx               ; reset write position
00234Ar 2  20 rr rr           JSR   render_list_to_buf
00234Dr 2               
00234Dr 2                     ; Null-terminate input_buf
00234Dr 2  A6 rr              LDX   z:buf_idx
00234Fr 2  9E rr rr           STZ   input_buf,X
002352r 2               
002352r 2                     ; Save tokenizer and eval state (same pattern as proc_invoke)
002352r 2  A5 rr              LDA   tok_head_lo
002354r 2  48                 PHA
002355r 2  A5 rr              LDA   tok_head_hi
002357r 2  48                 PHA
002358r 2  A5 rr              LDA   tok_tail_lo
00235Ar 2  48                 PHA
00235Br 2  A5 rr              LDA   tok_tail_hi
00235Dr 2  48                 PHA
00235Er 2  A5 rr              LDA   eval_in_body
002360r 2  48                 PHA
002361r 2  A5 rr              LDA   eval_reporter
002363r 2  48                 PHA
002364r 2               
002364r 2                     ; Tokenize the reconstructed line
002364r 2  20 rr rr           JSR   tokenize_line
002367r 2               
002367r 2                     ; Evaluate it
002367r 2  20 rr rr           JSR   eval_line
00236Ar 2               
00236Ar 2                     ; Restore tokenizer/eval state
00236Ar 2  68                 PLA
00236Br 2  85 rr              STA   eval_reporter
00236Dr 2  68                 PLA
00236Er 2  85 rr              STA   eval_in_body
002370r 2  68                 PLA
002371r 2  85 rr              STA   tok_tail_hi
002373r 2  68                 PLA
002374r 2  85 rr              STA   tok_tail_lo
002376r 2  68                 PLA
002377r 2  85 rr              STA   tok_head_hi
002379r 2  68                 PLA
00237Ar 2  85 rr              STA   tok_head_lo
00237Cr 2               
00237Cr 2                     ; Restore eval_cur
00237Cr 2  68                 PLA
00237Dr 2  85 rr              STA   eval_cur_hi
00237Fr 2  68                 PLA
002380r 2  85 rr              STA   eval_cur_lo
002382r 2               
002382r 2  4C rr rr           JMP   eval_continue
002385r 2               
002385r 2               @err_type:
002385r 2  A2 rr              LDX   #<str_run_type
002387r 2  A0 rr              LDY   #>str_run_type
002389r 2  4C rr rr           JMP   list_print_err
00238Cr 2               @err:
00238Cr 2  A2 rr              LDX   #<str_run_err
00238Er 2  A0 rr              LDY   #>str_run_err
002390r 2  4C rr rr           JMP   list_print_err
002393r 2               
002393r 2               ; ---------------------------------------------------------------------
002393r 2               ; render_list_to_buf — render list elements into input_buf as text
002393r 2               ;   Entry: eval_val_lo/hi = list head pointer
002393r 2               ;          buf_idx = current write position in input_buf
002393r 2               ;   Exit:  buf_idx updated
002393r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr, list_count
002393r 2               ; ---------------------------------------------------------------------
002393r 2               render_list_to_buf:
002393r 2  A5 rr              LDA   eval_val_lo
002395r 2  85 rr              STA   list_ptr_lo
002397r 2  A5 rr              LDA   eval_val_hi
002399r 2  85 rr              STA   list_ptr_hi
00239Br 2  A2 00              LDX   #0                     ; 0 = first element (no leading space)
00239Dr 2               
00239Dr 2               @rl_loop:
00239Dr 2  A5 rr              LDA   list_ptr_lo
00239Fr 2  05 rr              ORA   list_ptr_hi
0023A1r 2  D0 01              BNE   :+
0023A3r 2  60                 RTS                           ; end of list
0023A4r 2               :
0023A4r 2                     ; Add space before non-first elements
0023A4r 2  E0 00              CPX   #0
0023A6r 2  F0 0F              BEQ   @rl_no_space
0023A8r 2  A5 rr              LDA   z:buf_idx
0023AAr 2  C9 7E              CMP   #126
0023ACr 2  90 01              BCC   :+
0023AEr 2  60                 RTS                           ; buffer full — truncate
0023AFr 2               :
0023AFr 2  A8                 TAY
0023B0r 2  A9 20              LDA   #' '
0023B2r 2  99 rr rr           STA   input_buf,Y
0023B5r 2  E6 rr              INC   z:buf_idx
0023B7r 2               @rl_no_space:
0023B7r 2  A2 01              LDX   #1                     ; subsequent elements get space
0023B9r 2               
0023B9r 2                     ; Read car type
0023B9r 2  A5 rr              LDA   list_ptr_lo
0023BBr 2  85 rr              STA   ptr_lo
0023BDr 2  A5 rr              LDA   list_ptr_hi
0023BFr 2  85 rr              STA   ptr_hi
0023C1r 2  A0 01              LDY   #CONS_CAR_TYPE
0023C3r 2  B1 rr              LDA   (ptr_lo),Y
0023C5r 2               
0023C5r 2  C9 02              CMP   #VAL_LIST
0023C7r 2  F0 62              BEQ   @rl_sublist
0023C9r 2  C9 01              CMP   #VAL_WORD
0023CBr 2  F0 25              BEQ   @rl_word
0023CDr 2               
0023CDr 2                     ; Number: render to input_buf
0023CDr 2  DA                 PHX
0023CEr 2  A5 rr              LDA   list_ptr_lo
0023D0r 2  48                 PHA
0023D1r 2  A5 rr              LDA   list_ptr_hi
0023D3r 2  48                 PHA
0023D4r 2                     ; Load the number value
0023D4r 2  A0 02              LDY   #CONS_CAR_HI
0023D6r 2  B1 rr              LDA   (ptr_lo),Y
0023D8r 2  85 rr              STA   eval_val_hi
0023DAr 2  A0 03              LDY   #CONS_CAR_LO
0023DCr 2  B1 rr              LDA   (ptr_lo),Y
0023DEr 2  85 rr              STA   eval_val_lo
0023E0r 2  A0 04              LDY   #CONS_CAR_FRAC
0023E2r 2  B1 rr              LDA   (ptr_lo),Y
0023E4r 2  85 rr              STA   eval_val_frac
0023E6r 2  20 rr rr           JSR   render_number_to_buf
0023E9r 2  68                 PLA
0023EAr 2  85 rr              STA   list_ptr_hi
0023ECr 2  68                 PLA
0023EDr 2  85 rr              STA   list_ptr_lo
0023EFr 2  FA                 PLX
0023F0r 2  80 72              BRA   @rl_advance
0023F2r 2               
0023F2r 2               @rl_word:
0023F2r 2  DA                 PHX
0023F3r 2  A5 rr              LDA   list_ptr_lo
0023F5r 2  48                 PHA
0023F6r 2  A5 rr              LDA   list_ptr_hi
0023F8r 2  48                 PHA
0023F9r 2                     ; Get word string pointer
0023F9r 2  A0 03              LDY   #CONS_CAR_LO
0023FBr 2  B1 rr              LDA   (ptr_lo),Y
0023FDr 2  85 rr              STA   ptr2_lo
0023FFr 2  A0 02              LDY   #CONS_CAR_HI
002401r 2  B1 rr              LDA   (ptr_lo),Y
002403r 2  85 rr              STA   ptr2_hi
002405r 2                     ; Copy word chars to buf
002405r 2  A0 00              LDY   #0
002407r 2  B1 rr              LDA   (ptr2_lo),Y            ; length
002409r 2  AA                 TAX
00240Ar 2  F0 16              BEQ   @rl_word_done
00240Cr 2  C8                 INY
00240Dr 2               @rl_wch:
00240Dr 2  A5 rr              LDA   z:buf_idx
00240Fr 2  C9 7E              CMP   #126
002411r 2  B0 0F              BCS   @rl_word_done
002413r 2  B1 rr              LDA   (ptr2_lo),Y
002415r 2  5A                 PHY
002416r 2  A4 rr              LDY   z:buf_idx
002418r 2  99 rr rr           STA   input_buf,Y
00241Br 2  E6 rr              INC   z:buf_idx
00241Dr 2  7A                 PLY
00241Er 2  C8                 INY
00241Fr 2  CA                 DEX
002420r 2  D0 EB              BNE   @rl_wch
002422r 2               @rl_word_done:
002422r 2  68                 PLA
002423r 2  85 rr              STA   list_ptr_hi
002425r 2  68                 PLA
002426r 2  85 rr              STA   list_ptr_lo
002428r 2  FA                 PLX
002429r 2  80 39              BRA   @rl_advance
00242Br 2               
00242Br 2               @rl_sublist:
00242Br 2  DA                 PHX
00242Cr 2  A5 rr              LDA   list_ptr_lo
00242Er 2  48                 PHA
00242Fr 2  A5 rr              LDA   list_ptr_hi
002431r 2  48                 PHA
002432r 2                     ; Write '[' to buf
002432r 2  A5 rr              LDA   z:buf_idx
002434r 2  C9 7E              CMP   #126
002436r 2  B0 25              BCS   @rl_sub_done
002438r 2  A8                 TAY
002439r 2  A9 5B              LDA   #'['
00243Br 2  99 rr rr           STA   input_buf,Y
00243Er 2  E6 rr              INC   z:buf_idx
002440r 2                     ; Get sublist pointer and recurse
002440r 2  A0 03              LDY   #CONS_CAR_LO
002442r 2  B1 rr              LDA   (ptr_lo),Y
002444r 2  85 rr              STA   eval_val_lo
002446r 2  A0 02              LDY   #CONS_CAR_HI
002448r 2  B1 rr              LDA   (ptr_lo),Y
00244Ar 2  85 rr              STA   eval_val_hi
00244Cr 2  20 rr rr           JSR   render_list_to_buf
00244Fr 2                     ; Write ']' to buf
00244Fr 2  A5 rr              LDA   z:buf_idx
002451r 2  C9 7E              CMP   #126
002453r 2  B0 08              BCS   @rl_sub_done
002455r 2  A8                 TAY
002456r 2  A9 5D              LDA   #']'
002458r 2  99 rr rr           STA   input_buf,Y
00245Br 2  E6 rr              INC   z:buf_idx
00245Dr 2               @rl_sub_done:
00245Dr 2  68                 PLA
00245Er 2  85 rr              STA   list_ptr_hi
002460r 2  68                 PLA
002461r 2  85 rr              STA   list_ptr_lo
002463r 2  FA                 PLX
002464r 2               
002464r 2               @rl_advance:
002464r 2                     ; Follow cdr
002464r 2  A5 rr              LDA   list_ptr_lo
002466r 2  85 rr              STA   ptr_lo
002468r 2  A5 rr              LDA   list_ptr_hi
00246Ar 2  85 rr              STA   ptr_hi
00246Cr 2  A0 05              LDY   #CONS_CDR_LO
00246Er 2  B1 rr              LDA   (ptr_lo),Y
002470r 2  AA                 TAX
002471r 2  A0 06              LDY   #CONS_CDR_HI
002473r 2  B1 rr              LDA   (ptr_lo),Y
002475r 2  85 rr              STA   list_ptr_hi
002477r 2  86 rr              STX   list_ptr_lo
002479r 2  A2 01              LDX   #1                     ; always space after first element
00247Br 2  4C rr rr           JMP   @rl_loop
00247Er 2               
00247Er 2               @rl_trunc:
00247Er 2  60                 RTS
00247Fr 2               
00247Fr 2               ; ---------------------------------------------------------------------
00247Fr 2               ; render_number_to_buf — render eval_val as decimal into input_buf
00247Fr 2               ;   Entry: eval_val_hi/lo/frac = number value
00247Fr 2               ;          buf_idx = current write position
00247Fr 2               ;   Exit:  buf_idx updated
00247Fr 2               ;   Clobbers: A, X, Y, num_val, num_tmp, pn_buf
00247Fr 2               ; ---------------------------------------------------------------------
00247Fr 2               render_number_to_buf:
00247Fr 2                     ; Handle sign
00247Fr 2  A5 rr              LDA   eval_val_hi
002481r 2  10 22              BPL   @rn_positive
002483r 2                     ; Write '-'
002483r 2  A4 rr              LDY   z:buf_idx
002485r 2  A9 2D              LDA   #'-'
002487r 2  99 rr rr           STA   input_buf,Y
00248Ar 2  E6 rr              INC   z:buf_idx
00248Cr 2                     ; Negate
00248Cr 2  A5 rr              LDA   eval_val_frac
00248Er 2  49 FF              EOR   #$FF
002490r 2  18                 CLC
002491r 2  69 01              ADC   #1
002493r 2  85 rr              STA   eval_val_frac
002495r 2  A5 rr              LDA   eval_val_lo
002497r 2  49 FF              EOR   #$FF
002499r 2  69 00              ADC   #0
00249Br 2  85 rr              STA   eval_val_lo
00249Dr 2  A5 rr              LDA   eval_val_hi
00249Fr 2  49 FF              EOR   #$FF
0024A1r 2  69 00              ADC   #0
0024A3r 2  85 rr              STA   eval_val_hi
0024A5r 2               
0024A5r 2               @rn_positive:
0024A5r 2                     ; Render integer part using power-of-10 subtraction
0024A5r 2  A5 rr              LDA   eval_val_lo
0024A7r 2  8D rr rr           STA   num_val_lo
0024AAr 2  A5 rr              LDA   eval_val_hi
0024ACr 2  8D rr rr           STA   num_val_hi
0024AFr 2               
0024AFr 2  A2 00              LDX   #0                     ; digit buffer index
0024B1r 2  A0 00              LDY   #0                     ; power-of-10 index
0024B3r 2               @rn_div:
0024B3r 2  9C rr rr           STZ   num_tmp_lo
0024B6r 2               @rn_sub:
0024B6r 2  38                 SEC
0024B7r 2  AD rr rr           LDA   num_val_lo
0024BAr 2  F9 rr rr           SBC   pow10_lo,Y
0024BDr 2  48                 PHA
0024BEr 2  AD rr rr           LDA   num_val_hi
0024C1r 2  F9 rr rr           SBC   pow10_hi,Y
0024C4r 2  90 0C              BCC   @rn_sub_done
0024C6r 2  8D rr rr           STA   num_val_hi
0024C9r 2  68                 PLA
0024CAr 2  8D rr rr           STA   num_val_lo
0024CDr 2  EE rr rr           INC   num_tmp_lo
0024D0r 2  80 E4              BRA   @rn_sub
0024D2r 2               @rn_sub_done:
0024D2r 2  68                 PLA
0024D3r 2  AD rr rr           LDA   num_tmp_lo
0024D6r 2  9D rr rr           STA   pn_buf,X
0024D9r 2  E8                 INX
0024DAr 2  C8                 INY
0024DBr 2  C0 05              CPY   #5
0024DDr 2  90 D4              BCC   @rn_div
0024DFr 2               
0024DFr 2                     ; Write digits suppressing leading zeros
0024DFr 2  A0 00              LDY   #0                     ; suppress flag
0024E1r 2  A2 00              LDX   #0
0024E3r 2               @rn_print:
0024E3r 2  BD rr rr           LDA   pn_buf,X
0024E6r 2  D0 04              BNE   @rn_nonzero
0024E8r 2  C0 00              CPY   #0
0024EAr 2  F0 0D              BEQ   @rn_skip
0024ECr 2               @rn_nonzero:
0024ECr 2  A0 01              LDY   #1
0024EEr 2  09 30              ORA   #'0'
0024F0r 2  DA                 PHX
0024F1r 2  A6 rr              LDX   z:buf_idx
0024F3r 2  9D rr rr           STA   input_buf,X
0024F6r 2  E6 rr              INC   z:buf_idx
0024F8r 2  FA                 PLX
0024F9r 2               @rn_skip:
0024F9r 2  E8                 INX
0024FAr 2  E0 04              CPX   #4
0024FCr 2  90 E5              BCC   @rn_print
0024FEr 2                     ; Always write ones digit
0024FEr 2  AD rr rr           LDA   pn_buf+4
002501r 2  09 30              ORA   #'0'
002503r 2  A6 rr              LDX   z:buf_idx
002505r 2  9D rr rr           STA   input_buf,X
002508r 2  E6 rr              INC   z:buf_idx
00250Ar 2               
00250Ar 2                     ; Fractional part
00250Ar 2  A5 rr              LDA   eval_val_frac
00250Cr 2  D0 01              BNE   @rn_has_frac
00250Er 2  60                 RTS
00250Fr 2               @rn_has_frac:
00250Fr 2                     ; Write '.'
00250Fr 2  A6 rr              LDX   z:buf_idx
002511r 2  A9 2E              LDA   #'.'
002513r 2  9D rr rr           STA   input_buf,X
002516r 2  E6 rr              INC   z:buf_idx
002518r 2                     ; First frac digit
002518r 2  A5 rr              LDA   eval_val_frac
00251Ar 2  8D rr rr           STA   num_tmp_lo
00251Dr 2  9C rr rr           STZ   num_tmp_hi
002520r 2  AD rr rr           LDA   num_tmp_lo
002523r 2  0A                 ASL
002524r 2  8D rr rr           STA   num_val_lo
002527r 2  AD rr rr           LDA   num_tmp_hi
00252Ar 2  2A                 ROL
00252Br 2  8D rr rr           STA   num_val_hi
00252Er 2  0E rr rr           ASL   num_val_lo
002531r 2  2E rr rr           ROL   num_val_hi
002534r 2  0E rr rr           ASL   num_val_lo
002537r 2  2E rr rr           ROL   num_val_hi
00253Ar 2  18                 CLC
00253Br 2  AD rr rr           LDA   num_tmp_lo
00253Er 2  0A                 ASL
00253Fr 2  6D rr rr           ADC   num_val_lo
002542r 2  8D rr rr           STA   num_val_lo
002545r 2  AD rr rr           LDA   num_tmp_hi
002548r 2  2A                 ROL
002549r 2  6D rr rr           ADC   num_val_hi
00254Cr 2  8D rr rr           STA   num_val_hi
00254Fr 2                     ; High byte = digit
00254Fr 2  AD rr rr           LDA   num_val_hi
002552r 2  09 30              ORA   #'0'
002554r 2  A6 rr              LDX   z:buf_idx
002556r 2  9D rr rr           STA   input_buf,X
002559r 2  E6 rr              INC   z:buf_idx
00255Br 2                     ; Second frac digit
00255Br 2  AD rr rr           LDA   num_val_lo
00255Er 2  8D rr rr           STA   num_tmp_lo
002561r 2  9C rr rr           STZ   num_tmp_hi
002564r 2  AD rr rr           LDA   num_tmp_lo
002567r 2  0A                 ASL
002568r 2  8D rr rr           STA   num_val_lo
00256Br 2  AD rr rr           LDA   num_tmp_hi
00256Er 2  2A                 ROL
00256Fr 2  8D rr rr           STA   num_val_hi
002572r 2  0E rr rr           ASL   num_val_lo
002575r 2  2E rr rr           ROL   num_val_hi
002578r 2  0E rr rr           ASL   num_val_lo
00257Br 2  2E rr rr           ROL   num_val_hi
00257Er 2  18                 CLC
00257Fr 2  AD rr rr           LDA   num_tmp_lo
002582r 2  0A                 ASL
002583r 2  6D rr rr           ADC   num_val_lo
002586r 2  8D rr rr           STA   num_val_lo
002589r 2  AD rr rr           LDA   num_tmp_hi
00258Cr 2  2A                 ROL
00258Dr 2  6D rr rr           ADC   num_val_hi
002590r 2  8D rr rr           STA   num_val_hi
002593r 2  AD rr rr           LDA   num_val_hi
002596r 2  F0 09              BEQ   @rn_done                ; skip trailing zero
002598r 2  09 30              ORA   #'0'
00259Ar 2  A6 rr              LDX   z:buf_idx
00259Cr 2  9D rr rr           STA   input_buf,X
00259Fr 2  E6 rr              INC   z:buf_idx
0025A1r 2               @rn_done:
0025A1r 2  60                 RTS
