0002FCr 2               ; =====================================================================
0002FCr 2                     .segment "CODE"
000BA0r 2               
000BA0r 2               ; ---------------------------------------------------------------------
000BA0r 2               ; lookup_builtin — search builtin table for the current TOK_WORD
000BA0r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000BA0r 2               ;   Output: Carry clear = found, ptr2_lo/hi = handler addr, A = arity
000BA0r 2               ;           Carry set = not found
000BA0r 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000BA0r 2               ; ---------------------------------------------------------------------
000BA0r 2               lookup_builtin:
000BA0r 2                     ; Save table pointer in num_tmp_lo/hi
000BA0r 2  A9 rr              LDA   #<builtin_table
000BA2r 2  8D rr rr           STA   num_tmp_lo
000BA5r 2  A9 rr              LDA   #>builtin_table
000BA7r 2  8D rr rr           STA   num_tmp_hi
000BAAr 2               
000BAAr 2               @scan:
000BAAr 2                     ; Read name pointer from table
000BAAr 2  AD rr rr           LDA   num_tmp_lo
000BADr 2  85 rr              STA   ptr2_lo
000BAFr 2  AD rr rr           LDA   num_tmp_hi
000BB2r 2  85 rr              STA   ptr2_hi
000BB4r 2  A0 00              LDY   #0
000BB6r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000BB8r 2  AA                 TAX
000BB9r 2  C8                 INY
000BBAr 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000BBCr 2  D0 06              BNE   @have_entry
000BBEr 2  E0 00              CPX   #0
000BC0r 2  D0 02              BNE   @have_entry
000BC2r 2                     ; Null pointer — end of table
000BC2r 2  38                 SEC
000BC3r 2  60                 RTS
000BC4r 2               
000BC4r 2               @have_entry:
000BC4r 2                     ; X = name_ptr_lo, A = name_ptr_hi
000BC4r 2                     ; Compare the table name against the token payload
000BC4r 2                     ; Token payload: at eval_cur + TOK_PAYLOAD = length byte + chars
000BC4r 2  85 rr              STA   ptr2_hi
000BC6r 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000BC8r 2               
000BC8r 2                     ; Get token payload pointer
000BC8r 2  A5 rr              LDA   eval_cur_lo
000BCAr 2  85 rr              STA   ptr_lo
000BCCr 2  A5 rr              LDA   eval_cur_hi
000BCEr 2  85 rr              STA   ptr_hi
000BD0r 2               
000BD0r 2                     ; Compare length bytes
000BD0r 2  A0 00              LDY   #0
000BD2r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000BD4r 2  A0 03              LDY   #TOK_PAYLOAD
000BD6r 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000BD8r 2  D0 45              BNE   @next
000BDAr 2               
000BDAr 2                     ; Lengths match — compare chars
000BDAr 2  AA                 TAX                       ; X = length
000BDBr 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000BDDr 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000BDFr 2               @cmp_loop:
000BDFr 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000BE1r 2  5A                 PHY
000BE2r 2                     ; Compute token char offset: TOK_PAYLOAD + 1 + tok_sign
000BE2r 2  A5 rr              LDA   tok_sign
000BE4r 2  18                 CLC
000BE5r 2  69 04              ADC   #TOK_PAYLOAD+1
000BE7r 2  A8                 TAY
000BE8r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000BEAr 2  7A                 PLY
000BEBr 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000BEDr 2  D0 30              BNE   @next
000BEFr 2  C8                 INY
000BF0r 2  E6 rr              INC   tok_sign
000BF2r 2  CA                 DEX
000BF3r 2  D0 EA              BNE   @cmp_loop
000BF5r 2               
000BF5r 2                     ; Match found — read handler address and arity
000BF5r 2                     ; Table entry: name_ptr(2) + handler_addr(2) + arity(1)
000BF5r 2                     ; handler is at table_base + 2, arity at table_base + 4
000BF5r 2  AD rr rr           LDA   num_tmp_lo
000BF8r 2  85 rr              STA   ptr2_lo
000BFAr 2  AD rr rr           LDA   num_tmp_hi
000BFDr 2  85 rr              STA   ptr2_hi
000BFFr 2  A0 02              LDY   #2
000C01r 2  B1 rr              LDA   (ptr2_lo),Y        ; handler low
000C03r 2  AA                 TAX
000C04r 2  C8                 INY
000C05r 2  B1 rr              LDA   (ptr2_lo),Y        ; handler high
000C07r 2  85 rr              STA   ptr2_hi
000C09r 2  86 rr              STX   ptr2_lo             ; ptr2 = handler address
000C0Br 2  A0 04              LDY   #4
000C0Dr 2  B1 rr              LDA   (ptr2_lo),Y        ; — wrong, we already overwrote ptr2
000C0Fr 2                     ; Fix: re-read arity from table using num_tmp as base
000C0Fr 2  AD rr rr           LDA   num_tmp_lo
000C12r 2  85 rr              STA   ptr_lo
000C14r 2  AD rr rr           LDA   num_tmp_hi
000C17r 2  85 rr              STA   ptr_hi
000C19r 2  A0 04              LDY   #4
000C1Br 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000C1Dr 2  18                 CLC                       ; found
000C1Er 2  60                 RTS
000C1Fr 2               
000C1Fr 2               @next:
000C1Fr 2  64 rr              STZ   tok_sign            ; reset comparison counter
000C21r 2                     ; Advance to next entry: +5 bytes (2 name + 2 handler + 1 arity)
000C21r 2  18                 CLC
000C22r 2  AD rr rr           LDA   num_tmp_lo
000C25r 2  69 05              ADC   #5
000C27r 2  8D rr rr           STA   num_tmp_lo
000C2Ar 2  90 03              BCC   @next2
000C2Cr 2  EE rr rr           INC   num_tmp_hi
000C2Fr 2               @next2:
000C2Fr 2  4C rr rr           JMP   @scan
000C32r 2               
000C32r 2               ; ---------------------------------------------------------------------
000C32r 2               ; do_print — PRINT <expr>: evaluate arg and print with newline
000C32r 2               ;   Entry: eval_val/eval_type already set with the argument
000C32r 2               ;   Must JMP to eval_continue when done
000C32r 2               ; ---------------------------------------------------------------------
000C32r 2               do_print:
000C32r 2  A5 rr              LDA   eval_type
000C34r 2  C9 02              CMP   #VAL_LIST
000C36r 2  F0 0D              BEQ   @list
000C38r 2  C9 01              CMP   #VAL_WORD
000C3Ar 2  F0 12              BEQ   @word
000C3Cr 2               
000C3Cr 2                     ; Print number
000C3Cr 2  20 rr rr           JSR   print_number
000C3Fr 2  20 rr rr           JSR   eval_newline
000C42r 2  4C rr rr           JMP   eval_continue
000C45r 2               
000C45r 2               @list:
000C45r 2  20 rr rr           JSR   print_list
000C48r 2  20 rr rr           JSR   eval_newline
000C4Br 2  4C rr rr           JMP   eval_continue
000C4Er 2               
000C4Er 2               @word:
000C4Er 2                     ; Print quoted word — eval_val_lo/hi points at length+chars
000C4Er 2  A5 rr              LDA   eval_val_lo
000C50r 2  85 rr              STA   ptr_lo
000C52r 2  A5 rr              LDA   eval_val_hi
000C54r 2  85 rr              STA   ptr_hi
000C56r 2  A0 00              LDY   #0
000C58r 2  B1 rr              LDA   (ptr_lo),Y         ; length
000C5Ar 2  AA                 TAX
000C5Br 2  C8                 INY
000C5Cr 2               @wch:
000C5Cr 2  B1 rr              LDA   (ptr_lo),Y
000C5Er 2  8D 0E A0           STA   VGC_CHAROUT
000C61r 2  C8                 INY
000C62r 2  CA                 DEX
000C63r 2  D0 F7              BNE   @wch
000C65r 2  20 rr rr           JSR   eval_newline
000C68r 2  4C rr rr           JMP   eval_continue
000C6Br 2               
000C6Br 2               ; ---------------------------------------------------------------------
000C6Br 2               ; do_type — TYPE <expr>: like PRINT but no newline
000C6Br 2               ; ---------------------------------------------------------------------
000C6Br 2               do_type:
000C6Br 2  A5 rr              LDA   eval_type
000C6Dr 2  C9 02              CMP   #VAL_LIST
000C6Fr 2  F0 0A              BEQ   @list
000C71r 2  C9 01              CMP   #VAL_WORD
000C73r 2  F0 0C              BEQ   @word
000C75r 2               
000C75r 2                     ; Print number (no newline)
000C75r 2  20 rr rr           JSR   print_number
000C78r 2  4C rr rr           JMP   eval_continue
000C7Br 2               
000C7Br 2               @list:
000C7Br 2  20 rr rr           JSR   print_list
000C7Er 2  4C rr rr           JMP   eval_continue
000C81r 2               
000C81r 2               @word:
000C81r 2  A5 rr              LDA   eval_val_lo
000C83r 2  85 rr              STA   ptr_lo
000C85r 2  A5 rr              LDA   eval_val_hi
000C87r 2  85 rr              STA   ptr_hi
000C89r 2  A0 00              LDY   #0
000C8Br 2  B1 rr              LDA   (ptr_lo),Y
000C8Dr 2  AA                 TAX
000C8Er 2  C8                 INY
000C8Fr 2               @wch:
000C8Fr 2  B1 rr              LDA   (ptr_lo),Y
000C91r 2  8D 0E A0           STA   VGC_CHAROUT
000C94r 2  C8                 INY
000C95r 2  CA                 DEX
000C96r 2  D0 F7              BNE   @wch
000C98r 2  4C rr rr           JMP   eval_continue
000C9Br 2               
000C9Br 2               ; ---------------------------------------------------------------------
000C9Br 2               ; do_make — MAKE "name value: store a variable
000C9Br 2               ;   Arity 0 — we do our own argument evaluation
000C9Br 2               ;   1. eval_expr → name (must be TOK_QUOTE → word type)
000C9Br 2               ;   2. save name pointer
000C9Br 2               ;   3. eval_expr → value
000C9Br 2               ;   4. var_set(saved name, current value)
000C9Br 2               ; ---------------------------------------------------------------------
000C9Br 2               do_make:
000C9Br 2                     ; Evaluate first argument: the name (a quoted word)
000C9Br 2  20 rr rr           JSR   eval_expr
000C9Er 2  B0 1F              BCS   @err
000CA0r 2               
000CA0r 2                     ; Must be a word (type $01)
000CA0r 2  A5 rr              LDA   eval_type
000CA2r 2  C9 01              CMP   #$01
000CA4r 2  D0 19              BNE   @err
000CA6r 2               
000CA6r 2                     ; Save the name pointer (points into token payload: len + chars)
000CA6r 2  A5 rr              LDA   eval_val_lo
000CA8r 2  48                 PHA
000CA9r 2  A5 rr              LDA   eval_val_hi
000CABr 2  48                 PHA
000CACr 2               
000CACr 2                     ; Evaluate second argument: the value
000CACr 2  20 rr rr           JSR   eval_expr
000CAFr 2  B0 0C              BCS   @err_pop
000CB1r 2               
000CB1r 2                     ; Set up ptr_lo/hi → saved name, eval_val holds value
000CB1r 2  68                 PLA
000CB2r 2  85 rr              STA   ptr_hi
000CB4r 2  68                 PLA
000CB5r 2  85 rr              STA   ptr_lo
000CB7r 2               
000CB7r 2  20 rr rr           JSR   var_set
000CBAr 2  4C rr rr           JMP   eval_continue
000CBDr 2               
000CBDr 2               @err_pop:
000CBDr 2  68                 PLA
000CBEr 2  68                 PLA
000CBFr 2               @err:
000CBFr 2                     ; Print error
000CBFr 2  20 rr rr           JSR   print_inl
000CC2r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO MAKE", 0
000CC6r 2  45 4E 4F 55  
000CCAr 2  47 48 20 49  
000CDCr 2  20 rr rr           JSR   eval_newline
000CDFr 2  4C rr rr           JMP   eval_continue
000CE2r 2               
000CE2r 2               ; ---------------------------------------------------------------------
000CE2r 2               ; do_repeat — REPEAT count [body]
000CE2r 2               ;   Arity 0 — handles its own argument parsing
000CE2r 2               ;   1. Evaluate count expression
000CE2r 2               ;   2. Locate the bracketed body [...]
000CE2r 2               ;   3. Execute the body count times
000CE2r 2               ;   4. Resume after the closing ]
000CE2r 2               ;
000CE2r 2               ;   Nesting: saves/restores repeat state (body_start, body_resume,
000CE2r 2               ;   repeat_count, eval_in_body) on the hardware stack so nested
000CE2r 2               ;   REPEAT works correctly.
000CE2r 2               ; ---------------------------------------------------------------------
000CE2r 2               
000CE2r 2                     .segment "ZEROPAGE"
000021r 2  xx           repeat_count_lo:  .res 1
000022r 2  xx           repeat_count_hi:  .res 1
000023r 2  xx           body_start_lo:    .res 1       ; first token after [
000024r 2  xx           body_start_hi:    .res 1
000025r 2  xx           body_resume_lo:   .res 1       ; token after ]
000026r 2  xx           body_resume_hi:   .res 1
000027r 2  xx           repcount:         .res 1       ; 1-based REPCOUNT within REPEAT loop
000028r 2  xx           for_cur_lo:       .res 1       ; FOR loop current value low
000029r 2  xx           for_cur_hi:       .res 1       ; FOR loop current value high
00002Ar 2  xx           for_end_lo:       .res 1       ; FOR loop end value low
00002Br 2  xx           for_end_hi:       .res 1       ; FOR loop end value high
00002Cr 2  xx           cond_start_lo:    .res 1       ; WHILE/UNTIL condition start low
00002Dr 2  xx           cond_start_hi:    .res 1       ; WHILE/UNTIL condition start high
00002Er 2               
00002Er 2                     .segment "CODE"
000CE2r 2               
000CE2r 2               do_repeat:
000CE2r 2                     ; --- Evaluate the count argument ---
000CE2r 2  20 rr rr           JSR   eval_expr
000CE5r 2  90 03              BCC   @count_ok
000CE7r 2  4C rr rr           JMP   @err_args             ; carry set = no token
000CEAr 2               @count_ok:
000CEAr 2                     ; Count must be a number
000CEAr 2  A5 rr              LDA   eval_type
000CECr 2  F0 03              BEQ   @type_ok
000CEEr 2  4C rr rr           JMP   @err_args
000CF1r 2               @type_ok:
000CF1r 2               
000CF1r 2                     ; --- Save outer repeat state for nesting ---
000CF1r 2  A5 rr              LDA   repcount
000CF3r 2  48                 PHA
000CF4r 2  A5 rr              LDA   repeat_count_lo
000CF6r 2  48                 PHA
000CF7r 2  A5 rr              LDA   repeat_count_hi
000CF9r 2  48                 PHA
000CFAr 2  A5 rr              LDA   body_start_lo
000CFCr 2  48                 PHA
000CFDr 2  A5 rr              LDA   body_start_hi
000CFFr 2  48                 PHA
000D00r 2  A5 rr              LDA   body_resume_lo
000D02r 2  48                 PHA
000D03r 2  A5 rr              LDA   body_resume_hi
000D05r 2  48                 PHA
000D06r 2  A5 rr              LDA   eval_in_body
000D08r 2  48                 PHA
000D09r 2               
000D09r 2                     ; Store count (integer part only, clamped to 0 if negative)
000D09r 2  A5 rr              LDA   eval_val_hi
000D0Br 2  30 08              BMI   @zero_count           ; negative = treat as 0
000D0Dr 2  85 rr              STA   repeat_count_hi
000D0Fr 2  A5 rr              LDA   eval_val_lo
000D11r 2  85 rr              STA   repeat_count_lo
000D13r 2  80 04              BRA   @find_body
000D15r 2               
000D15r 2               @zero_count:
000D15r 2  64 rr              STZ   repeat_count_lo
000D17r 2  64 rr              STZ   repeat_count_hi
000D19r 2               
000D19r 2               @find_body:
000D19r 2                     ; --- Current token must be TOK_LBRACKET ---
000D19r 2  A5 rr              LDA   eval_cur_lo
000D1Br 2  05 rr              ORA   eval_cur_hi
000D1Dr 2  D0 03              BNE   @have_tok
000D1Fr 2  4C rr rr           JMP   @err_bracket_pop
000D22r 2               @have_tok:
000D22r 2  A5 rr              LDA   eval_cur_lo
000D24r 2  85 rr              STA   ptr_lo
000D26r 2  A5 rr              LDA   eval_cur_hi
000D28r 2  85 rr              STA   ptr_hi
000D2Ar 2  A0 00              LDY   #TOK_TAG
000D2Cr 2  B1 rr              LDA   (ptr_lo),Y
000D2Er 2  C9 03              CMP   #TOK_LBRACKET
000D30r 2  F0 03              BEQ   @is_bracket
000D32r 2  4C rr rr           JMP   @err_bracket_pop
000D35r 2               @is_bracket:
000D35r 2               
000D35r 2                     ; Advance past the [
000D35r 2  20 rr rr           JSR   eval_advance
000D38r 2               
000D38r 2                     ; Save body start (first token after [)
000D38r 2  A5 rr              LDA   eval_cur_lo
000D3Ar 2  85 rr              STA   body_start_lo
000D3Cr 2  A5 rr              LDA   eval_cur_hi
000D3Er 2  85 rr              STA   body_start_hi
000D40r 2               
000D40r 2                     ; --- Scan forward to find the matching ] ---
000D40r 2  A2 01              LDX   #1                    ; depth (we've consumed the [)
000D42r 2               @scan:
000D42r 2  A5 rr              LDA   eval_cur_lo
000D44r 2  05 rr              ORA   eval_cur_hi
000D46r 2  D0 03              BNE   @scan_ok
000D48r 2  4C rr rr           JMP   @err_bracket_pop
000D4Br 2               @scan_ok:
000D4Br 2  A5 rr              LDA   eval_cur_lo
000D4Dr 2  85 rr              STA   ptr_lo
000D4Fr 2  A5 rr              LDA   eval_cur_hi
000D51r 2  85 rr              STA   ptr_hi
000D53r 2  A0 00              LDY   #TOK_TAG
000D55r 2  B1 rr              LDA   (ptr_lo),Y
000D57r 2               
000D57r 2  C9 03              CMP   #TOK_LBRACKET
000D59r 2  D0 03              BNE   @scan_not_lb
000D5Br 2  E8                 INX
000D5Cr 2  80 07              BRA   @scan_next
000D5Er 2               @scan_not_lb:
000D5Er 2  C9 04              CMP   #TOK_RBRACKET
000D60r 2  D0 03              BNE   @scan_next
000D62r 2  CA                 DEX
000D63r 2  F0 07              BEQ   @scan_found           ; depth == 0, found matching ]
000D65r 2               @scan_next:
000D65r 2  DA                 PHX                        ; save depth across eval_advance
000D66r 2  20 rr rr           JSR   eval_advance
000D69r 2  FA                 PLX
000D6Ar 2  80 D6              BRA   @scan
000D6Cr 2               
000D6Cr 2               @scan_found:
000D6Cr 2                     ; eval_cur is at the matching ]. Save resume point (token after ]).
000D6Cr 2  20 rr rr           JSR   eval_advance
000D6Fr 2  A5 rr              LDA   eval_cur_lo
000D71r 2  85 rr              STA   body_resume_lo
000D73r 2  A5 rr              LDA   eval_cur_hi
000D75r 2  85 rr              STA   body_resume_hi
000D77r 2               
000D77r 2                     ; --- Initialize repcount and execute the body repeat_count times ---
000D77r 2  A9 01              LDA   #1
000D79r 2  85 rr              STA   repcount
000D7Br 2               @loop:
000D7Br 2                     ; Check if STOP/OUTPUT was signaled
000D7Br 2  A5 rr              LDA   proc_stopped
000D7Dr 2  D0 27              BNE   @loop_done
000D7Fr 2               
000D7Fr 2                     ; Check if count is zero
000D7Fr 2  A5 rr              LDA   repeat_count_lo
000D81r 2  05 rr              ORA   repeat_count_hi
000D83r 2  F0 21              BEQ   @loop_done
000D85r 2               
000D85r 2                     ; Set eval_cur to body start
000D85r 2  A5 rr              LDA   body_start_lo
000D87r 2  85 rr              STA   eval_cur_lo
000D89r 2  A5 rr              LDA   body_start_hi
000D8Br 2  85 rr              STA   eval_cur_hi
000D8Dr 2               
000D8Dr 2                     ; Set body mode and call eval_body
000D8Dr 2  A9 01              LDA   #$01
000D8Fr 2  85 rr              STA   eval_in_body
000D91r 2  20 rr rr           JSR   eval_body
000D94r 2               
000D94r 2                     ; Increment repcount (capped at 255)
000D94r 2  A5 rr              LDA   repcount
000D96r 2  C9 FF              CMP   #$FF
000D98r 2  B0 02              BCS   :+
000D9Ar 2  E6 rr              INC   repcount
000D9Cr 2               :
000D9Cr 2                     ; Decrement count (16-bit)
000D9Cr 2  A5 rr              LDA   repeat_count_lo
000D9Er 2  D0 02              BNE   @dec_lo
000DA0r 2  C6 rr              DEC   repeat_count_hi
000DA2r 2               @dec_lo:
000DA2r 2  C6 rr              DEC   repeat_count_lo
000DA4r 2  80 D5              BRA   @loop
000DA6r 2               
000DA6r 2               @loop_done:
000DA6r 2                     ; Resume past THIS REPEAT's ] BEFORE restoring outer state — restore pops
000DA6r 2                     ; body_resume back to the enclosing REPEAT's value, so reading it after the
000DA6r 2                     ; restore would resume at the wrong token (trailing commands never run).
000DA6r 2  A5 rr              LDA   body_resume_lo
000DA8r 2  85 rr              STA   eval_cur_lo
000DAAr 2  A5 rr              LDA   body_resume_hi
000DACr 2  85 rr              STA   eval_cur_hi
000DAEr 2                     ; --- Restore outer state ---
000DAEr 2  20 rr rr           JSR   repeat_restore_state
000DB1r 2  4C rr rr           JMP   eval_continue
000DB4r 2               
000DB4r 2               @err_bracket_pop:
000DB4r 2                     ; Restore stack before printing error
000DB4r 2  20 rr rr           JSR   repeat_restore_state
000DB7r 2                     ; Fall through to error message
000DB7r 2  20 rr rr           JSR   print_inl
000DBAr 2  52 45 50 45        .byte "REPEAT NEEDS [ BODY ]", 0
000DBEr 2  41 54 20 4E  
000DC2r 2  45 45 44 53  
000DD0r 2  20 rr rr           JSR   eval_newline
000DD3r 2  4C rr rr           JMP   eval_continue
000DD6r 2               
000DD6r 2               @err_args:
000DD6r 2  20 rr rr           JSR   print_inl
000DD9r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO REPEAT", 0
000DDDr 2  45 4E 4F 55  
000DE1r 2  47 48 20 49  
000DF5r 2  20 rr rr           JSR   eval_newline
000DF8r 2  4C rr rr           JMP   eval_continue
000DFBr 2               
000DFBr 2               ; ---------------------------------------------------------------------
000DFBr 2               ; repeat_restore_state — pop 7 saved bytes from stack to ZP
000DFBr 2               ;   Restores eval_in_body, body_resume, body_start, repeat_count
000DFBr 2               ;   Must be called via JSR (uses return address on stack correctly)
000DFBr 2               ; ---------------------------------------------------------------------
000DFBr 2               repeat_restore_state:
000DFBr 2                     ; Pull our return address, pop 8 saved bytes, push RA, RTS.
000DFBr 2  68                 PLA
000DFCr 2  85 rr              STA   handler_lo            ; save return address low
000DFEr 2  68                 PLA
000DFFr 2  85 rr              STA   handler_hi            ; save return address high
000E01r 2               
000E01r 2  68                 PLA
000E02r 2  85 rr              STA   eval_in_body
000E04r 2  68                 PLA
000E05r 2  85 rr              STA   body_resume_hi
000E07r 2  68                 PLA
000E08r 2  85 rr              STA   body_resume_lo
000E0Ar 2  68                 PLA
000E0Br 2  85 rr              STA   body_start_hi
000E0Dr 2  68                 PLA
000E0Er 2  85 rr              STA   body_start_lo
000E10r 2  68                 PLA
000E11r 2  85 rr              STA   repeat_count_hi
000E13r 2  68                 PLA
000E14r 2  85 rr              STA   repeat_count_lo
000E16r 2  68                 PLA
000E17r 2  85 rr              STA   repcount
000E19r 2               
000E19r 2  A5 rr              LDA   handler_hi
000E1Br 2  48                 PHA
000E1Cr 2  A5 rr              LDA   handler_lo
000E1Er 2  48                 PHA
000E1Fr 2  60                 RTS
000E20r 2               
000E20r 2               ; ---------------------------------------------------------------------
000E20r 2               ; skip_list_body — advance eval_cur past a [...] block without executing
000E20r 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000E20r 2               ;   Exit:  eval_cur points at the token after the matching TOK_RBRACKET
000E20r 2               ;          Carry clear = success, Carry set = missing bracket
000E20r 2               ;   Clobbers: A, X, Y, ptr_lo/hi
000E20r 2               ; ---------------------------------------------------------------------
000E20r 2               skip_list_body:
000E20r 2                     ; Verify current token is TOK_LBRACKET
000E20r 2  A5 rr              LDA   eval_cur_lo
000E22r 2  05 rr              ORA   eval_cur_hi
000E24r 2  F0 41              BEQ   @err
000E26r 2  A5 rr              LDA   eval_cur_lo
000E28r 2  85 rr              STA   ptr_lo
000E2Ar 2  A5 rr              LDA   eval_cur_hi
000E2Cr 2  85 rr              STA   ptr_hi
000E2Er 2  A0 00              LDY   #TOK_TAG
000E30r 2  B1 rr              LDA   (ptr_lo),Y
000E32r 2  C9 03              CMP   #TOK_LBRACKET
000E34r 2  D0 31              BNE   @err
000E36r 2               
000E36r 2                     ; Advance past the [
000E36r 2  20 rr rr           JSR   eval_advance
000E39r 2  A2 01              LDX   #1                    ; depth = 1
000E3Br 2               
000E3Br 2               @scan:
000E3Br 2  A5 rr              LDA   eval_cur_lo
000E3Dr 2  05 rr              ORA   eval_cur_hi
000E3Fr 2  F0 26              BEQ   @err                  ; ran out of tokens
000E41r 2  A5 rr              LDA   eval_cur_lo
000E43r 2  85 rr              STA   ptr_lo
000E45r 2  A5 rr              LDA   eval_cur_hi
000E47r 2  85 rr              STA   ptr_hi
000E49r 2  A0 00              LDY   #TOK_TAG
000E4Br 2  B1 rr              LDA   (ptr_lo),Y
000E4Dr 2               
000E4Dr 2  C9 03              CMP   #TOK_LBRACKET
000E4Fr 2  D0 03              BNE   @not_lb
000E51r 2  E8                 INX
000E52r 2  80 07              BRA   @scan_next
000E54r 2               @not_lb:
000E54r 2  C9 04              CMP   #TOK_RBRACKET
000E56r 2  D0 03              BNE   @scan_next
000E58r 2  CA                 DEX
000E59r 2  F0 07              BEQ   @found                 ; depth == 0 -> matched
000E5Br 2               @scan_next:
000E5Br 2  DA                 PHX
000E5Cr 2  20 rr rr           JSR   eval_advance
000E5Fr 2  FA                 PLX
000E60r 2  80 D9              BRA   @scan
000E62r 2               
000E62r 2               @found:
000E62r 2                     ; eval_cur is at the matching ]. Advance past it.
000E62r 2  20 rr rr           JSR   eval_advance
000E65r 2  18                 CLC
000E66r 2  60                 RTS
000E67r 2               
000E67r 2               @err:
000E67r 2  38                 SEC
000E68r 2  60                 RTS
