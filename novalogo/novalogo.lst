00020Br 2  AD rr rr           LDA   num_tmp_lo
00020Er 2  18                 CLC
00020Fr 2  65 rr              ADC   tok_src
000211r 2  AA                 TAX
000212r 2  BD rr rr           LDA   input_buf,X
000215r 2  C9 61              CMP   #'a'
000217r 2  90 07              BCC   @noup
000219r 2  C9 7B              CMP   #'z'+1
00021Br 2  B0 03              BCS   @noup
