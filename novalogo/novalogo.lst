002DEEr 2  A5 rr              LDA   proc_head_lo
002DF0r 2  85 rr              STA   proc_entry_lo
002DF2r 2  A5 rr              LDA   proc_head_hi
002DF4r 2  85 rr              STA   proc_entry_hi
002DF6r 2               
