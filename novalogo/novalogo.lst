002010r 2  BA                 TSX
002011r 2  BD 02 01           LDA   $0102,X
002014r 2  A0 03              LDY   #CONS_CAR_LO
002016r 2  91 rr              STA   (ptr_lo),Y
002018r 2                     ; frac
002018r 2  68                 PLA                           ; restore frac
002019r 2  A0 04              LDY   #CONS_CAR_FRAC
00201Br 2  91 rr              STA   (ptr_lo),Y
00201Dr 2                     ; cdr = null
00201Dr 2  A0 05              LDY   #CONS_CDR_LO
00201Fr 2  A9 00              LDA   #0
002021r 2  91 rr              STA   (ptr_lo),Y
002023r 2  A0 06              LDY   #CONS_CDR_HI
002025r 2  91 rr              STA   (ptr_lo),Y
002027r 2               
002027r 2                     ; Clean remaining 3 bytes of second value from stack
002027r 2  68                 PLA
002028r 2  68                 PLA
002029r 2  68                 PLA
00202Ar 2               
