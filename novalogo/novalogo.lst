002309r 2               ; ---------------------------------------------------------------------
002309r 2               ; render_list_to_buf — render list elements into input_buf as text
002309r 2               ;   Entry: eval_val_lo/hi = list head pointer
002309r 2               ;          buf_idx = current write position in input_buf
002309r 2               ;   Exit:  buf_idx updated
002309r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr, list_count
002309r 2               ; ---------------------------------------------------------------------
002309r 2               render_list_to_buf:
002309r 2  A5 rr              LDA   eval_val_lo
00230Br 2  85 rr              STA   list_ptr_lo
00230Dr 2  A5 rr              LDA   eval_val_hi
00230Fr 2  85 rr              STA   list_ptr_hi
002311r 2  A2 00              LDX   #0                     ; 0 = first element (no leading space)
002313r 2               
002313r 2               @rl_loop:
002313r 2  A5 rr              LDA   list_ptr_lo
002315r 2  05 rr              ORA   list_ptr_hi
002317r 2  D0 01              BNE   :+
002319r 2  60                 RTS                           ; end of list
00231Ar 2               :
00231Ar 2                     ; Add space before non-first elements
00231Ar 2  E0 00              CPX   #0
00231Cr 2  F0 0F              BEQ   @rl_no_space
00231Er 2  A5 rr              LDA   z:buf_idx
002320r 2  C9 7E              CMP   #126
002322r 2  90 01              BCC   :+
002324r 2  60                 RTS                           ; buffer full — truncate
002325r 2               :
002325r 2  A8                 TAY
002326r 2  A9 20              LDA   #' '
002328r 2  99 rr rr           STA   input_buf,Y
00232Br 2  E6 rr              INC   z:buf_idx
00232Dr 2               @rl_no_space:
00232Dr 2  A2 01              LDX   #1                     ; subsequent elements get space
00232Fr 2               
00232Fr 2                     ; Read car type
00232Fr 2  A5 rr              LDA   list_ptr_lo
002331r 2  85 rr              STA   ptr_lo
002333r 2  A5 rr              LDA   list_ptr_hi
002335r 2  85 rr              STA   ptr_hi
002337r 2  A0 01              LDY   #CONS_CAR_TYPE
002339r 2  B1 rr              LDA   (ptr_lo),Y
00233Br 2               
00233Br 2  C9 02              CMP   #VAL_LIST
00233Dr 2  F0 62              BEQ   @rl_sublist
00233Fr 2  C9 01              CMP   #VAL_WORD
002341r 2  F0 25              BEQ   @rl_word
002343r 2               
002343r 2                     ; Number: render to input_buf
002343r 2  DA                 PHX
002344r 2  A5 rr              LDA   list_ptr_lo
002346r 2  48                 PHA
002347r 2  A5 rr              LDA   list_ptr_hi
002349r 2  48                 PHA
00234Ar 2                     ; Load the number value
00234Ar 2  A0 02              LDY   #CONS_CAR_HI
00234Cr 2  B1 rr              LDA   (ptr_lo),Y
00234Er 2  85 rr              STA   eval_val_hi
002350r 2  A0 03              LDY   #CONS_CAR_LO
002352r 2  B1 rr              LDA   (ptr_lo),Y
002354r 2  85 rr              STA   eval_val_lo
002356r 2  A0 04              LDY   #CONS_CAR_FRAC
002358r 2  B1 rr              LDA   (ptr_lo),Y
00235Ar 2  85 rr              STA   eval_val_frac
00235Cr 2  20 rr rr           JSR   render_number_to_buf
00235Fr 2  68                 PLA
002360r 2  85 rr              STA   list_ptr_hi
002362r 2  68                 PLA
002363r 2  85 rr              STA   list_ptr_lo
002365r 2  FA                 PLX
002366r 2  80 72              BRA   @rl_advance
002368r 2               
002368r 2               @rl_word:
002368r 2  DA                 PHX
002369r 2  A5 rr              LDA   list_ptr_lo
00236Br 2  48                 PHA
00236Cr 2  A5 rr              LDA   list_ptr_hi
00236Er 2  48                 PHA
00236Fr 2                     ; Get word string pointer
00236Fr 2  A0 03              LDY   #CONS_CAR_LO
002371r 2  B1 rr              LDA   (ptr_lo),Y
002373r 2  85 rr              STA   ptr2_lo
002375r 2  A0 02              LDY   #CONS_CAR_HI
002377r 2  B1 rr              LDA   (ptr_lo),Y
002379r 2  85 rr              STA   ptr2_hi
00237Br 2                     ; Copy word chars to buf
00237Br 2  A0 00              LDY   #0
00237Dr 2  B1 rr              LDA   (ptr2_lo),Y            ; length
00237Fr 2  AA                 TAX
002380r 2  F0 16              BEQ   @rl_word_done
002382r 2  C8                 INY
002383r 2               @rl_wch:
002383r 2  A5 rr              LDA   z:buf_idx
002385r 2  C9 7E              CMP   #126
002387r 2  B0 0F              BCS   @rl_word_done
002389r 2  B1 rr              LDA   (ptr2_lo),Y
00238Br 2  5A                 PHY
00238Cr 2  A4 rr              LDY   z:buf_idx
00238Er 2  99 rr rr           STA   input_buf,Y
002391r 2  E6 rr              INC   z:buf_idx
002393r 2  7A                 PLY
002394r 2  C8                 INY
002395r 2  CA                 DEX
002396r 2  D0 EB              BNE   @rl_wch
002398r 2               @rl_word_done:
002398r 2  68                 PLA
002399r 2  85 rr              STA   list_ptr_hi
00239Br 2  68                 PLA
00239Cr 2  85 rr              STA   list_ptr_lo
00239Er 2  FA                 PLX
00239Fr 2  80 39              BRA   @rl_advance
0023A1r 2               
0023A1r 2               @rl_sublist:
0023A1r 2  DA                 PHX
0023A2r 2  A5 rr              LDA   list_ptr_lo
0023A4r 2  48                 PHA
0023A5r 2  A5 rr              LDA   list_ptr_hi
0023A7r 2  48                 PHA
0023A8r 2                     ; Write '[' to buf
0023A8r 2  A5 rr              LDA   z:buf_idx
0023AAr 2  C9 7E              CMP   #126
0023ACr 2  B0 25              BCS   @rl_sub_done
0023AEr 2  A8                 TAY
0023AFr 2  A9 5B              LDA   #'['
0023B1r 2  99 rr rr           STA   input_buf,Y
0023B4r 2  E6 rr              INC   z:buf_idx
0023B6r 2                     ; Get sublist pointer and recurse
0023B6r 2  A0 03              LDY   #CONS_CAR_LO
0023B8r 2  B1 rr              LDA   (ptr_lo),Y
0023BAr 2  85 rr              STA   eval_val_lo
0023BCr 2  A0 02              LDY   #CONS_CAR_HI
0023BEr 2  B1 rr              LDA   (ptr_lo),Y
0023C0r 2  85 rr              STA   eval_val_hi
0023C2r 2  20 rr rr           JSR   render_list_to_buf
0023C5r 2                     ; Write ']' to buf
0023C5r 2  A5 rr              LDA   z:buf_idx
0023C7r 2  C9 7E              CMP   #126
0023C9r 2  B0 08              BCS   @rl_sub_done
0023CBr 2  A8                 TAY
0023CCr 2  A9 5D              LDA   #']'
0023CEr 2  99 rr rr           STA   input_buf,Y
0023D1r 2  E6 rr              INC   z:buf_idx
0023D3r 2               @rl_sub_done:
0023D3r 2  68                 PLA
0023D4r 2  85 rr              STA   list_ptr_hi
0023D6r 2  68                 PLA
0023D7r 2  85 rr              STA   list_ptr_lo
0023D9r 2  FA                 PLX
0023DAr 2               
0023DAr 2               @rl_advance:
0023DAr 2                     ; Follow cdr
0023DAr 2  A5 rr              LDA   list_ptr_lo
0023DCr 2  85 rr              STA   ptr_lo
0023DEr 2  A5 rr              LDA   list_ptr_hi
0023E0r 2  85 rr              STA   ptr_hi
0023E2r 2  A0 05              LDY   #CONS_CDR_LO
0023E4r 2  B1 rr              LDA   (ptr_lo),Y
0023E6r 2  AA                 TAX
0023E7r 2  A0 06              LDY   #CONS_CDR_HI
0023E9r 2  B1 rr              LDA   (ptr_lo),Y
0023EBr 2  85 rr              STA   list_ptr_hi
0023EDr 2  86 rr              STX   list_ptr_lo
0023EFr 2  A2 01              LDX   #1                     ; always space after first element
0023F1r 2  4C rr rr           JMP   @rl_loop
0023F4r 2               
0023F4r 2               @rl_trunc:
0023F4r 2  60                 RTS
0023F5r 2               
0023F5r 2               ; ---------------------------------------------------------------------
0023F5r 2               ; render_number_to_buf — render eval_val as decimal into input_buf
0023F5r 2               ;   Entry: eval_val_hi/lo/frac = number value
0023F5r 2               ;          buf_idx = current write position
0023F5r 2               ;   Exit:  buf_idx updated
0023F5r 2               ;   Clobbers: A, X, Y, num_val, num_tmp, pn_buf
0023F5r 2               ; ---------------------------------------------------------------------
0023F5r 2               render_number_to_buf:
0023F5r 2                     ; Handle sign
0023F5r 2  A5 rr              LDA   eval_val_hi
0023F7r 2  10 22              BPL   @rn_positive
0023F9r 2                     ; Write '-'
0023F9r 2  A4 rr              LDY   z:buf_idx
0023FBr 2  A9 2D              LDA   #'-'
0023FDr 2  99 rr rr           STA   input_buf,Y
002400r 2  E6 rr              INC   z:buf_idx
002402r 2                     ; Negate
002402r 2  A5 rr              LDA   eval_val_frac
002404r 2  49 FF              EOR   #$FF
002406r 2  18                 CLC
002407r 2  69 01              ADC   #1
002409r 2  85 rr              STA   eval_val_frac
00240Br 2  A5 rr              LDA   eval_val_lo
00240Dr 2  49 FF              EOR   #$FF
00240Fr 2  69 00              ADC   #0
002411r 2  85 rr              STA   eval_val_lo
002413r 2  A5 rr              LDA   eval_val_hi
002415r 2  49 FF              EOR   #$FF
002417r 2  69 00              ADC   #0
002419r 2  85 rr              STA   eval_val_hi
00241Br 2               
00241Br 2               @rn_positive:
00241Br 2                     ; Render integer part using power-of-10 subtraction
00241Br 2  A5 rr              LDA   eval_val_lo
00241Dr 2  8D rr rr           STA   num_val_lo
002420r 2  A5 rr              LDA   eval_val_hi
002422r 2  8D rr rr           STA   num_val_hi
002425r 2               
002425r 2  A2 00              LDX   #0                     ; digit buffer index
002427r 2  A0 00              LDY   #0                     ; power-of-10 index
002429r 2               @rn_div:
002429r 2  9C rr rr           STZ   num_tmp_lo
00242Cr 2               @rn_sub:
00242Cr 2  38                 SEC
00242Dr 2  AD rr rr           LDA   num_val_lo
002430r 2  F9 rr rr           SBC   pow10_lo,Y
002433r 2  48                 PHA
002434r 2  AD rr rr           LDA   num_val_hi
002437r 2  F9 rr rr           SBC   pow10_hi,Y
00243Ar 2  90 0C              BCC   @rn_sub_done
00243Cr 2  8D rr rr           STA   num_val_hi
00243Fr 2  68                 PLA
002440r 2  8D rr rr           STA   num_val_lo
002443r 2  EE rr rr           INC   num_tmp_lo
002446r 2  80 E4              BRA   @rn_sub
002448r 2               @rn_sub_done:
002448r 2  68                 PLA
002449r 2  AD rr rr           LDA   num_tmp_lo
00244Cr 2  9D rr rr           STA   pn_buf,X
00244Fr 2  E8                 INX
002450r 2  C8                 INY
002451r 2  C0 05              CPY   #5
002453r 2  90 D4              BCC   @rn_div
002455r 2               
002455r 2                     ; Write digits suppressing leading zeros
002455r 2  A0 00              LDY   #0                     ; suppress flag
002457r 2  A2 00              LDX   #0
002459r 2               @rn_print:
002459r 2  BD rr rr           LDA   pn_buf,X
00245Cr 2  D0 04              BNE   @rn_nonzero
00245Er 2  C0 00              CPY   #0
002460r 2  F0 0D              BEQ   @rn_skip
002462r 2               @rn_nonzero:
002462r 2  A0 01              LDY   #1
002464r 2  09 30              ORA   #'0'
002466r 2  DA                 PHX
002467r 2  A6 rr              LDX   z:buf_idx
002469r 2  9D rr rr           STA   input_buf,X
00246Cr 2  E6 rr              INC   z:buf_idx
00246Er 2  FA                 PLX
00246Fr 2               @rn_skip:
00246Fr 2  E8                 INX
002470r 2  E0 04              CPX   #4
002472r 2  90 E5              BCC   @rn_print
002474r 2                     ; Always write ones digit
002474r 2  AD rr rr           LDA   pn_buf+4
002477r 2  09 30              ORA   #'0'
002479r 2  A6 rr              LDX   z:buf_idx
00247Br 2  9D rr rr           STA   input_buf,X
00247Er 2  E6 rr              INC   z:buf_idx
002480r 2               
002480r 2                     ; Fractional part
002480r 2  A5 rr              LDA   eval_val_frac
002482r 2  D0 01              BNE   @rn_has_frac
002484r 2  60                 RTS
002485r 2               @rn_has_frac:
002485r 2                     ; Write '.'
002485r 2  A6 rr              LDX   z:buf_idx
002487r 2  A9 2E              LDA   #'.'
002489r 2  9D rr rr           STA   input_buf,X
00248Cr 2  E6 rr              INC   z:buf_idx
00248Er 2                     ; First frac digit
00248Er 2  A5 rr              LDA   eval_val_frac
002490r 2  8D rr rr           STA   num_tmp_lo
002493r 2  9C rr rr           STZ   num_tmp_hi
002496r 2  AD rr rr           LDA   num_tmp_lo
002499r 2  0A                 ASL
00249Ar 2  8D rr rr           STA   num_val_lo
00249Dr 2  AD rr rr           LDA   num_tmp_hi
0024A0r 2  2A                 ROL
0024A1r 2  8D rr rr           STA   num_val_hi
0024A4r 2  0E rr rr           ASL   num_val_lo
0024A7r 2  2E rr rr           ROL   num_val_hi
0024AAr 2  0E rr rr           ASL   num_val_lo
0024ADr 2  2E rr rr           ROL   num_val_hi
0024B0r 2  18                 CLC
0024B1r 2  AD rr rr           LDA   num_tmp_lo
0024B4r 2  0A                 ASL
0024B5r 2  6D rr rr           ADC   num_val_lo
0024B8r 2  8D rr rr           STA   num_val_lo
0024BBr 2  AD rr rr           LDA   num_tmp_hi
0024BEr 2  2A                 ROL
0024BFr 2  6D rr rr           ADC   num_val_hi
0024C2r 2  8D rr rr           STA   num_val_hi
0024C5r 2                     ; High byte = digit
0024C5r 2  AD rr rr           LDA   num_val_hi
0024C8r 2  09 30              ORA   #'0'
0024CAr 2  A6 rr              LDX   z:buf_idx
0024CCr 2  9D rr rr           STA   input_buf,X
0024CFr 2  E6 rr              INC   z:buf_idx
0024D1r 2                     ; Second frac digit
0024D1r 2  AD rr rr           LDA   num_val_lo
0024D4r 2  8D rr rr           STA   num_tmp_lo
0024D7r 2  9C rr rr           STZ   num_tmp_hi
0024DAr 2  AD rr rr           LDA   num_tmp_lo
0024DDr 2  0A                 ASL
0024DEr 2  8D rr rr           STA   num_val_lo
0024E1r 2  AD rr rr           LDA   num_tmp_hi
0024E4r 2  2A                 ROL
0024E5r 2  8D rr rr           STA   num_val_hi
0024E8r 2  0E rr rr           ASL   num_val_lo
0024EBr 2  2E rr rr           ROL   num_val_hi
0024EEr 2  0E rr rr           ASL   num_val_lo
0024F1r 2  2E rr rr           ROL   num_val_hi
0024F4r 2  18                 CLC
0024F5r 2  AD rr rr           LDA   num_tmp_lo
0024F8r 2  0A                 ASL
0024F9r 2  6D rr rr           ADC   num_val_lo
0024FCr 2  8D rr rr           STA   num_val_lo
0024FFr 2  AD rr rr           LDA   num_tmp_hi
002502r 2  2A                 ROL
002503r 2  6D rr rr           ADC   num_val_hi
002506r 2  8D rr rr           STA   num_val_hi
002509r 2  AD rr rr           LDA   num_val_hi
00250Cr 2  F0 09              BEQ   @rn_done                ; skip trailing zero
00250Er 2  09 30              ORA   #'0'
002510r 2  A6 rr              LDX   z:buf_idx
002512r 2  9D rr rr           STA   input_buf,X
002515r 2  E6 rr              INC   z:buf_idx
002517r 2               @rn_done:
002517r 2  60                 RTS
