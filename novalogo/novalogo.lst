002C8Dr 2  85 rr              STA   proc_entry_lo
002C8Fr 2  A5 rr              LDA   proc_head_hi
002C91r 2  85 rr              STA   proc_entry_hi
002C93r 2               
002C93r 2               @walk:
002C93r 2  A5 rr              LDA   proc_entry_lo
002C95r 2  05 rr              ORA   proc_entry_hi
002C97r 2  F0 35              BEQ   @done
002C99r 2               
002C99r 2                     ; Print name
002C99r 2  A5 rr              LDA   proc_entry_lo
002C9Br 2  85 rr              STA   ptr_lo
002C9Dr 2  A5 rr              LDA   proc_entry_hi
002C9Fr 2  85 rr              STA   ptr_hi
002CA1r 2  A0 02              LDY   #2
002CA3r 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002CA5r 2  AA                 TAX
002CA6r 2  F0 0B              BEQ   @skip_name
002CA8r 2  A0 03              LDY   #3
002CAAr 2               @pch:
002CAAr 2  B1 rr              LDA   (ptr_lo),Y
002CACr 2  8D 0E A0           STA   VGC_CHAROUT
002CAFr 2  C8                 INY
002CB0r 2  CA                 DEX
002CB1r 2  D0 F7              BNE   @pch
002CB3r 2               @skip_name:
002CB3r 2  A9 20              LDA   #' '
002CB5r 2  8D 0E A0           STA   VGC_CHAROUT
002CB8r 2               
002CB8r 2                     ; Follow next
002CB8r 2  A5 rr              LDA   proc_entry_lo
002CBAr 2  85 rr              STA   ptr_lo
002CBCr 2  A5 rr              LDA   proc_entry_hi
002CBEr 2  85 rr              STA   ptr_hi
002CC0r 2  A0 00              LDY   #0
002CC2r 2  B1 rr              LDA   (ptr_lo),Y
002CC4r 2  AA                 TAX
002CC5r 2  C8                 INY
002CC6r 2  B1 rr              LDA   (ptr_lo),Y
002CC8r 2  85 rr              STA   proc_entry_hi
002CCAr 2  86 rr              STX   proc_entry_lo
002CCCr 2  80 C5              BRA   @walk
002CCEr 2               
002CCEr 2               @done:
002CCEr 2  20 rr rr           JSR   eval_newline
002CD1r 2  4C rr rr           JMP   eval_continue
002CD4r 2               
002CD4r 2               ; ---------------------------------------------------------------------
002CD4r 2               ; do_po — PO "name: print procedure definition
002CD4r 2               ;   Arity 0 — evaluates its own argument
002CD4r 2               ; ---------------------------------------------------------------------
002CD4r 2               do_po:
002CD4r 2  20 rr rr           JSR   eval_expr
002CD7r 2  90 03              BCC   @po_type_ok
002CD9r 2  4C rr rr           JMP   @err
002CDCr 2               @po_type_ok:
002CDCr 2  A5 rr              LDA   eval_type
002CDEr 2  C9 01              CMP   #VAL_WORD
002CE0r 2  F0 03              BEQ   @po_word_ok
002CE2r 2  4C rr rr           JMP   @err
002CE5r 2               @po_word_ok:
002CE5r 2               
002CE5r 2                     ; Look up by name
002CE5r 2  A5 rr              LDA   eval_val_lo
002CE7r 2  85 rr              STA   ptr_lo
002CE9r 2  A5 rr              LDA   eval_val_hi
002CEBr 2  85 rr              STA   ptr_hi
002CEDr 2  20 rr rr           JSR   proc_find_by_name
002CF0r 2  90 03              BCC   @po_found
002CF2r 2  4C rr rr           JMP   @err_notfound
002CF5r 2               @po_found:
002CF5r 2               
002CF5r 2                     ; proc_entry_lo/hi = record
002CF5r 2                     ; Print "TO "
002CF5r 2  A9 54              LDA   #'T'
002CF7r 2  8D 0E A0           STA   VGC_CHAROUT
002CFAr 2  A9 4F              LDA   #'O'
002CFCr 2  8D 0E A0           STA   VGC_CHAROUT
002CFFr 2  A9 20              LDA   #' '
002D01r 2  8D 0E A0           STA   VGC_CHAROUT
002D04r 2               
002D04r 2                     ; Print name
002D04r 2  A5 rr              LDA   proc_entry_lo
002D06r 2  85 rr              STA   ptr_lo
002D08r 2  A5 rr              LDA   proc_entry_hi
002D0Ar 2  85 rr              STA   ptr_hi
002D0Cr 2  A0 02              LDY   #2
002D0Er 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002D10r 2  AA                 TAX
002D11r 2  85 rr              STA   proc_name_len
002D13r 2  F0 0B              BEQ   @po_params
002D15r 2  A0 03              LDY   #3
002D17r 2               @po_name_ch:
002D17r 2  B1 rr              LDA   (ptr_lo),Y
002D19r 2  8D 0E A0           STA   VGC_CHAROUT
002D1Cr 2  C8                 INY
002D1Dr 2  CA                 DEX
002D1Er 2  D0 F7              BNE   @po_name_ch
002D20r 2               
002D20r 2               @po_params:
002D20r 2                     ; Y = 3 + name_len = offset to param_count
002D20r 2  A5 rr              LDA   proc_name_len
002D22r 2  18                 CLC
002D23r 2  69 03              ADC   #3
002D25r 2  A8                 TAY
002D26r 2  B1 rr              LDA   (ptr_lo),Y             ; param_count
002D28r 2  85 rr              STA   proc_param_cnt
002D2Ar 2  C8                 INY                           ; offset to first param
002D2Br 2  84 rr              STY   proc_rec_off
002D2Dr 2               
002D2Dr 2  A5 rr              LDA   proc_param_cnt
002D2Fr 2  F0 2E              BEQ   @po_header_done
002D31r 2               
002D31r 2  A6 rr              LDX   proc_param_cnt
002D33r 2               @po_param:
002D33r 2                     ; Print " :"
002D33r 2  A9 20              LDA   #' '
002D35r 2  8D 0E A0           STA   VGC_CHAROUT
002D38r 2  A9 3A              LDA   #':'
002D3Ar 2  8D 0E A0           STA   VGC_CHAROUT
002D3Dr 2               
002D3Dr 2                     ; Read param name length
002D3Dr 2  A5 rr              LDA   proc_entry_lo
002D3Fr 2  85 rr              STA   ptr_lo
002D41r 2  A5 rr              LDA   proc_entry_hi
002D43r 2  85 rr              STA   ptr_hi
002D45r 2  A4 rr              LDY   proc_rec_off
002D47r 2  B1 rr              LDA   (ptr_lo),Y             ; param name length
002D49r 2  DA                 PHX
002D4Ar 2  AA                 TAX                           ; X = chars to print
002D4Br 2  C8                 INY
002D4Cr 2               @po_pch:
002D4Cr 2  E0 00              CPX   #0
002D4Er 2  F0 09              BEQ   @po_param_done
002D50r 2  B1 rr              LDA   (ptr_lo),Y
002D52r 2  8D 0E A0           STA   VGC_CHAROUT
002D55r 2  C8                 INY
002D56r 2  CA                 DEX
002D57r 2  80 F3              BRA   @po_pch
002D59r 2               @po_param_done:
002D59r 2  84 rr              STY   proc_rec_off
002D5Br 2  FA                 PLX
002D5Cr 2  CA                 DEX
002D5Dr 2  D0 D4              BNE   @po_param
002D5Fr 2               
002D5Fr 2               @po_header_done:
002D5Fr 2  20 rr rr           JSR   eval_newline
002D62r 2               
002D62r 2                     ; Read body_len
002D62r 2  A5 rr              LDA   proc_entry_lo
002D64r 2  85 rr              STA   ptr_lo
002D66r 2  A5 rr              LDA   proc_entry_hi
002D68r 2  85 rr              STA   ptr_hi
002D6Ar 2  A4 rr              LDY   proc_rec_off
002D6Cr 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_lo
002D6Er 2  85 rr              STA   proc_body_len_lo
002D70r 2  C8                 INY
002D71r 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_hi
002D73r 2  85 rr              STA   proc_body_len_hi
002D75r 2  C8                 INY                           ; Y = offset to body text
002D76r 2               
002D76r 2                     ; Compute absolute pointer to body
002D76r 2  84 rr              STY   proc_rec_off
002D78r 2  18                 CLC
002D79r 2  A5 rr              LDA   proc_entry_lo
002D7Br 2  65 rr              ADC   proc_rec_off
002D7Dr 2  85 rr              STA   proc_ptr_lo
002D7Fr 2  A5 rr              LDA   proc_entry_hi
002D81r 2  69 00              ADC   #0
002D83r 2  85 rr              STA   proc_ptr_hi
002D85r 2               
002D85r 2                     ; Print body text, converting $0A to CR+LF
002D85r 2               @po_body:
002D85r 2  A5 rr              LDA   proc_body_len_lo
002D87r 2  05 rr              ORA   proc_body_len_hi
002D89r 2  F0 20              BEQ   @po_end
002D8Br 2               
002D8Br 2  A0 00              LDY   #0
002D8Dr 2  B1 rr              LDA   (proc_ptr_lo),Y
002D8Fr 2  C9 0A              CMP   #$0A
002D91r 2  D0 05              BNE   @po_char
002D93r 2  20 rr rr           JSR   eval_newline
002D96r 2  80 03              BRA   @po_advance
002D98r 2               @po_char:
002D98r 2  8D 0E A0           STA   VGC_CHAROUT
002D9Br 2               @po_advance:
002D9Br 2  E6 rr              INC   proc_ptr_lo
002D9Dr 2  D0 02              BNE   :+
002D9Fr 2  E6 rr              INC   proc_ptr_hi
002DA1r 2  A5 rr        :     LDA   proc_body_len_lo
002DA3r 2  D0 02              BNE   :+
002DA5r 2  C6 rr              DEC   proc_body_len_hi
002DA7r 2  C6 rr        :     DEC   proc_body_len_lo
002DA9r 2  80 DA              BRA   @po_body
002DABr 2               
002DABr 2               @po_end:
002DABr 2                     ; Print "END"
002DABr 2  A9 45              LDA   #'E'
002DADr 2  8D 0E A0           STA   VGC_CHAROUT
002DB0r 2  A9 4E              LDA   #'N'
002DB2r 2  8D 0E A0           STA   VGC_CHAROUT
002DB5r 2  A9 44              LDA   #'D'
002DB7r 2  8D 0E A0           STA   VGC_CHAROUT
002DBAr 2  20 rr rr           JSR   eval_newline
002DBDr 2  4C rr rr           JMP   eval_continue
002DC0r 2               
002DC0r 2               @err:
