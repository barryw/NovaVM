0023ADr 2  F0 62              BEQ   @rl_sublist
0023AFr 2  C9 01              CMP   #VAL_WORD
0023B1r 2  F0 25              BEQ   @rl_word
0023B3r 2               
0023B3r 2                     ; Number: render to input_buf
0023B3r 2  DA                 PHX
0023B4r 2  A5 rr              LDA   list_ptr_lo
0023B6r 2  48                 PHA
0023B7r 2  A5 rr              LDA   list_ptr_hi
0023B9r 2  48                 PHA
0023BAr 2                     ; Load the number value
0023BAr 2  A0 02              LDY   #CONS_CAR_HI
0023BCr 2  B1 rr              LDA   (ptr_lo),Y
0023BEr 2  85 rr              STA   eval_val_hi
0023C0r 2  A0 03              LDY   #CONS_CAR_LO
0023C2r 2  B1 rr              LDA   (ptr_lo),Y
0023C4r 2  85 rr              STA   eval_val_lo
0023C6r 2  A0 04              LDY   #CONS_CAR_FRAC
0023C8r 2  B1 rr              LDA   (ptr_lo),Y
0023CAr 2  85 rr              STA   eval_val_frac
0023CCr 2  20 rr rr           JSR   render_number_to_buf
0023CFr 2  68                 PLA
0023D0r 2  85 rr              STA   list_ptr_hi
0023D2r 2  68                 PLA
0023D3r 2  85 rr              STA   list_ptr_lo
0023D5r 2  FA                 PLX
0023D6r 2  80 72              BRA   @rl_advance
0023D8r 2               
0023D8r 2               @rl_word:
0023D8r 2  DA                 PHX
0023D9r 2  A5 rr              LDA   list_ptr_lo
0023DBr 2  48                 PHA
0023DCr 2  A5 rr              LDA   list_ptr_hi
0023DEr 2  48                 PHA
0023DFr 2                     ; Get word string pointer
0023DFr 2  A0 03              LDY   #CONS_CAR_LO
0023E1r 2  B1 rr              LDA   (ptr_lo),Y
0023E3r 2  85 rr              STA   ptr2_lo
0023E5r 2  A0 02              LDY   #CONS_CAR_HI
0023E7r 2  B1 rr              LDA   (ptr_lo),Y
