00217Fr 2  85 rr              STA   list_ptr_hi
002181r 2               @se_walk:
002181r 2  A5 rr              LDA   list_ptr_lo
002183r 2  85 rr              STA   ptr_lo
002185r 2  A5 rr              LDA   list_ptr_hi
002187r 2  85 rr              STA   ptr_hi
