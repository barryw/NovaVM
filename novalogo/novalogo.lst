00149Cr 2  20 rr rr           JSR   tokenize_line
00149Fr 2               
00149Fr 2                     ; Walk tokens and build a list
00149Fr 2  64 rr              STZ   z:list_head_lo
0014A1r 2  64 rr              STZ   z:list_head_hi
