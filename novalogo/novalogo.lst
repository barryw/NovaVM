000F9Er 2               
000F9Er 2                     ; Save tag pointer and eval_in_body temporarily (3 bytes)
000F9Er 2  A5 rr              LDA   eval_val_lo
000FA0r 2  48                 PHA
000FA1r 2  A5 rr              LDA   eval_val_hi
000FA3r 2  48                 PHA
000FA4r 2  A5 rr              LDA   eval_in_body
000FA6r 2  48                 PHA
000FA7r 2               
000FA7r 2                     ; Push previous catch frame onto the 6502 stack (6 bytes)
000FA7r 2  A5 rr              LDA   catch_active
000FA9r 2  48                 PHA
000FAAr 2  A5 rr              LDA   catch_tag_lo
000FACr 2  48                 PHA
000FADr 2  A5 rr              LDA   catch_tag_hi
000FAFr 2  48                 PHA
000FB0r 2  A5 rr              LDA   catch_sp
000FB2r 2  48                 PHA
000FB3r 2  A5 rr              LDA   catch_resume_lo
000FB5r 2  48                 PHA
000FB6r 2  A5 rr              LDA   catch_resume_hi
000FB8r 2  48                 PHA
000FB9r 2               
000FB9r 2                     ; Set up the tag pointer from saved values
000FB9r 2                     ; Stack (top to bottom): prev_frame(6), eval_in_body, eval_val_hi, eval_val_lo
000FB9r 2                     ; $0101+X = SP+1 = top. eval_in_body at SP+7, eval_val_hi at SP+8, eval_val_lo at SP+9
000FB9r 2  BA                 TSX
000FBAr 2  BD 08 01           LDA   $0108,X               ; eval_val_hi = tag ptr high
000FBDr 2  85 rr              STA   catch_tag_hi
000FBFr 2  BD 09 01           LDA   $0109,X               ; eval_val_lo = tag ptr low
000FC2r 2  85 rr              STA   catch_tag_lo
000FC4r 2               
000FC4r 2                     ; Save stack pointer NOW — this is the unwind target.
000FC4r 2                     ; When a THROW matches, TXS restores to this SP, and the
000FC4r 2                     ; 6 PLA instructions below will pop the previous frame.
000FC4r 2  BA                 TSX
000FC5r 2  86 rr              STX   catch_sp
000FC7r 2               
000FC7r 2                     ; Activate the catch
000FC7r 2  A9 01              LDA   #$01
000FC9r 2  85 rr              STA   catch_active
000FCBr 2               
000FCBr 2                     ; We need to find the resume point PAST the body's ].
000FCBr 2                     ; Scan ahead to find it, then come back and execute the body.
000FCBr 2                     ; Save body start location first.
000FCBr 2  A5 rr              LDA   eval_cur_lo
000FCDr 2  48                 PHA                         ; save body-start lo
000FCEr 2  A5 rr              LDA   eval_cur_hi
000FD0r 2  48                 PHA                         ; save body-start hi
000FD1r 2               
000FD1r 2                     ; Scan past the body [...] to find resume point
000FD1r 2  20 rr rr           JSR   skip_list_body
000FD4r 2  B0 31              BCS   @err_bracket_pop
