000F14r 2  4C rr rr           JMP   eval_continue
000F17r 2               
000F17r 2               ; ---------------------------------------------------------------------
000F17r 2               ; do_catch — CATCH "tag [body]: execute body, catching errors/throws
000F17r 2               ;   Arity 0 — handles its own argument parsing
000F17r 2               ;   1. Evaluate tag argument (quoted word)
000F17r 2               ;   2. Save current catch frame (for nesting) on the 6502 stack
000F17r 2               ;   3. Set up new catch frame with tag and stack pointer
000F17r 2               ;   4. Execute the body
000F17r 2               ;   5. On normal completion: restore previous catch frame, continue
000F17r 2               ;   On THROW match: try_throw_error or do_throw restores SP from
000F17r 2               ;   catch frame, which unwinds back to step 5's stack context.
000F17r 2               ; ---------------------------------------------------------------------
000F17r 2               do_catch:
000F17r 2                     ; Evaluate tag argument (e.g., "ERROR)
000F17r 2  20 rr rr           JSR   eval_expr
000F1Ar 2  90 03              BCC   @tag_ok
000F1Cr 2  4C rr rr           JMP   @err_tag
000F1Fr 2               @tag_ok:
000F1Fr 2               
000F1Fr 2                     ; Must be a word
000F1Fr 2  A5 rr              LDA   eval_type
000F21r 2  C9 01              CMP   #VAL_WORD
000F23r 2  F0 03              BEQ   @type_ok
000F25r 2  4C rr rr           JMP   @err_tag
000F28r 2               @type_ok:
000F28r 2               
000F28r 2                     ; Save tag pointer and eval_in_body temporarily (3 bytes)
000F28r 2  A5 rr              LDA   eval_val_lo
000F2Ar 2  48                 PHA
000F2Br 2  A5 rr              LDA   eval_val_hi
000F2Dr 2  48                 PHA
000F2Er 2  A5 rr              LDA   eval_in_body
000F30r 2  48                 PHA
000F31r 2               
000F31r 2                     ; Push previous catch frame onto the 6502 stack (6 bytes)
000F31r 2  A5 rr              LDA   catch_active
000F33r 2  48                 PHA
000F34r 2  A5 rr              LDA   catch_tag_lo
000F36r 2  48                 PHA
000F37r 2  A5 rr              LDA   catch_tag_hi
000F39r 2  48                 PHA
000F3Ar 2  A5 rr              LDA   catch_sp
000F3Cr 2  48                 PHA
000F3Dr 2  A5 rr              LDA   catch_resume_lo
000F3Fr 2  48                 PHA
000F40r 2  A5 rr              LDA   catch_resume_hi
000F42r 2  48                 PHA
000F43r 2               
000F43r 2                     ; Set up the tag pointer from saved values
000F43r 2                     ; Stack (top to bottom): prev_frame(6), eval_in_body, eval_val_hi, eval_val_lo
000F43r 2                     ; $0101+X = SP+1 = top. eval_in_body at SP+7, eval_val_hi at SP+8, eval_val_lo at SP+9
000F43r 2  BA                 TSX
000F44r 2  BD 08 01           LDA   $0108,X               ; eval_val_hi = tag ptr high
000F47r 2  85 rr              STA   catch_tag_hi
000F49r 2  BD 09 01           LDA   $0109,X               ; eval_val_lo = tag ptr low
000F4Cr 2  85 rr              STA   catch_tag_lo
000F4Er 2               
000F4Er 2                     ; Save stack pointer NOW — this is the unwind target.
000F4Er 2                     ; When a THROW matches, TXS restores to this SP, and the
000F4Er 2                     ; 6 PLA instructions below will pop the previous frame.
000F4Er 2  BA                 TSX
000F4Fr 2  86 rr              STX   catch_sp
000F51r 2               
000F51r 2                     ; Activate the catch
000F51r 2  A9 01              LDA   #$01
000F53r 2  85 rr              STA   catch_active
000F55r 2               
000F55r 2                     ; We need to find the resume point PAST the body's ].
000F55r 2                     ; Scan ahead to find it, then come back and execute the body.
000F55r 2                     ; Save body start location first.
000F55r 2  A5 rr              LDA   eval_cur_lo
000F57r 2  48                 PHA                         ; save body-start lo
000F58r 2  A5 rr              LDA   eval_cur_hi
000F5Ar 2  48                 PHA                         ; save body-start hi
000F5Br 2               
000F5Br 2                     ; Scan past the body [...] to find resume point
000F5Br 2  20 rr rr           JSR   skip_list_body
000F5Er 2  B0 31              BCS   @err_bracket_pop
000F60r 2               
000F60r 2                     ; eval_cur is now past the ]. Save as resume point.
000F60r 2  A5 rr              LDA   eval_cur_lo
000F62r 2  85 rr              STA   catch_resume_lo
000F64r 2  A5 rr              LDA   eval_cur_hi
000F66r 2  85 rr              STA   catch_resume_hi
000F68r 2               
000F68r 2                     ; Restore body start
000F68r 2  68                 PLA
000F69r 2  85 rr              STA   eval_cur_hi
000F6Br 2  68                 PLA
000F6Cr 2  85 rr              STA   eval_cur_lo
000F6Er 2               
000F6Er 2                     ; Execute the body
000F6Er 2  20 rr rr           JSR   exec_body_block
000F71r 2               
000F71r 2                     ; Body completed normally — restore previous catch frame
000F71r 2                     ; (Stack still has: prev_frame(6), tag_hi, tag_lo at the bottom)
000F71r 2  68                 PLA
000F72r 2  85 rr              STA   catch_resume_hi
000F74r 2  68                 PLA
000F75r 2  85 rr              STA   catch_resume_lo
000F77r 2  68                 PLA
000F78r 2  85 rr              STA   catch_sp
000F7Ar 2  68                 PLA
000F7Br 2  85 rr              STA   catch_tag_hi
000F7Dr 2  68                 PLA
000F7Er 2  85 rr              STA   catch_tag_lo
000F80r 2  68                 PLA
000F81r 2  85 rr              STA   catch_active
000F83r 2               
000F83r 2                     ; Discard saved eval_in_body + tag ptr (3 bytes)
000F83r 2  68                 PLA                         ; eval_in_body
000F84r 2  68                 PLA                         ; tag_hi
000F85r 2  68                 PLA                         ; tag_lo
000F86r 2               
000F86r 2                     ; Set eval_cur past the body
000F86r 2  A5 rr              LDA   catch_resume_lo
000F88r 2  85 rr              STA   eval_cur_lo
000F8Ar 2  A5 rr              LDA   catch_resume_hi
000F8Cr 2  85 rr              STA   eval_cur_hi
000F8Er 2  4C rr rr           JMP   eval_continue
000F91r 2               
000F91r 2               @err_bracket_pop:
000F91r 2                     ; Clean up: body-start was partially popped by skip_list_body error
000F91r 2  68                 PLA                         ; body_start_hi
000F92r 2  68                 PLA                         ; body_start_lo
000F93r 2                     ; Restore previous catch frame
000F93r 2  68                 PLA
000F94r 2  85 rr              STA   catch_resume_hi
000F96r 2  68                 PLA
000F97r 2  85 rr              STA   catch_resume_lo
000F99r 2  68                 PLA
000F9Ar 2  85 rr              STA   catch_sp
000F9Cr 2  68                 PLA
000F9Dr 2  85 rr              STA   catch_tag_hi
000F9Fr 2  68                 PLA
000FA0r 2  85 rr              STA   catch_tag_lo
000FA2r 2  68                 PLA
000FA3r 2  85 rr              STA   catch_active
000FA5r 2                     ; Discard saved eval_in_body + tag ptr (3 bytes)
000FA5r 2  68                 PLA
000FA6r 2  68                 PLA
000FA7r 2  68                 PLA
000FA8r 2                     ; Print bracket error
000FA8r 2  A2 rr              LDX   #<str_catch_bracket
000FAAr 2  A0 rr              LDY   #>str_catch_bracket
000FACr 2  4C rr rr           JMP   list_print_err
000FAFr 2               
000FAFr 2               @err_tag:
000FAFr 2  A2 rr              LDX   #<str_catch_name
000FB1r 2  A0 rr              LDY   #>str_catch_name
000FB3r 2  4C rr rr           JMP   err_nei
000FB6r 2               
000FB6r 2               ; ---------------------------------------------------------------------
000FB6r 2               ; do_throw — THROW "tag: unwind to matching CATCH
000FB6r 2               ;   Arity 0 — handles its own argument parsing
000FB6r 2               ;   1. Evaluate tag argument
000FB6r 2               ;   2. If catch is active and tags match: unwind via TXS
000FB6r 2               ;   3. If no match: print error
000FB6r 2               ; ---------------------------------------------------------------------
000FB6r 2               do_throw:
000FB6r 2                     ; Evaluate tag argument
000FB6r 2  20 rr rr           JSR   eval_expr
000FB9r 2  B0 7C              BCS   @err_tag
000FBBr 2               
000FBBr 2                     ; Must be a word
000FBBr 2  A5 rr              LDA   eval_type
000FBDr 2  C9 01              CMP   #VAL_WORD
000FBFr 2  D0 76              BNE   @err_tag
000FC1r 2               
000FC1r 2                     ; Is a catch frame active?
000FC1r 2  A5 rr              LDA   catch_active
000FC3r 2  F0 3A              BEQ   @no_catch
000FC5r 2               
000FC5r 2                     ; Compare tags: eval_val_lo/hi vs catch_tag_lo/hi
000FC5r 2  A5 rr              LDA   eval_val_lo
000FC7r 2  85 rr              STA   ptr_lo
000FC9r 2  A5 rr              LDA   eval_val_hi
000FCBr 2  85 rr              STA   ptr_hi
000FCDr 2  A5 rr              LDA   catch_tag_lo
000FCFr 2  85 rr              STA   ptr2_lo
000FD1r 2  A5 rr              LDA   catch_tag_hi
000FD3r 2  85 rr              STA   ptr2_hi
000FD5r 2  20 rr rr           JSR   catch_tags_equal
000FD8r 2  90 25              BCC   @no_catch
000FDAr 2               
000FDAr 2                     ; Match! Unwind stack to catch point.
000FDAr 2  A6 rr              LDX   catch_sp
000FDCr 2  9A                 TXS
000FDDr 2               
000FDDr 2                     ; Restore previous catch frame from the restored stack
000FDDr 2  68                 PLA
000FDEr 2  85 rr              STA   catch_resume_hi
000FE0r 2  68                 PLA
000FE1r 2  85 rr              STA   catch_resume_lo
000FE3r 2  68                 PLA
000FE4r 2  85 rr              STA   catch_sp
000FE6r 2  68                 PLA
000FE7r 2  85 rr              STA   catch_tag_hi
000FE9r 2  68                 PLA
000FEAr 2  85 rr              STA   catch_tag_lo
000FECr 2  68                 PLA
000FEDr 2  85 rr              STA   catch_active
000FEFr 2               
000FEFr 2                     ; Restore eval_in_body and discard saved tag pointer (3 bytes)
000FEFr 2  68                 PLA
000FF0r 2  85 rr              STA   eval_in_body
000FF2r 2  68                 PLA                         ; tag_hi
000FF3r 2  68                 PLA                         ; tag_lo
000FF4r 2               
000FF4r 2                     ; Set eval_cur to resume point (past the caught body)
000FF4r 2  A5 rr              LDA   catch_resume_lo
000FF6r 2  85 rr              STA   eval_cur_lo
000FF8r 2  A5 rr              LDA   catch_resume_hi
000FFAr 2  85 rr              STA   eval_cur_hi
000FFCr 2               
000FFCr 2  4C rr rr           JMP   eval_continue
000FFFr 2               
000FFFr 2               @no_catch:
000FFFr 2                     ; Print "CAN'T FIND CATCH TAG " + the tag
000FFFr 2  20 rr rr           JSR   print_inl
