000E1Er 2               
000E1Er 2               ; ---------------------------------------------------------------------
000E1Er 2               ; repeat_restore_state — pop 7 saved bytes from stack to ZP
000E1Er 2               ;   Restores eval_in_body, body_resume, body_start, repeat_count
000E1Er 2               ;   Must be called via JSR (uses return address on stack correctly)
000E1Er 2               ; ---------------------------------------------------------------------
000E1Er 2               repeat_restore_state:
000E1Er 2                     ; Pull our return address, pop 8 saved bytes, push RA, RTS.
000E1Er 2  68                 PLA
000E1Fr 2  85 rr              STA   handler_lo            ; save return address low
000E21r 2  68                 PLA
000E22r 2  85 rr              STA   handler_hi            ; save return address high
000E24r 2               
000E24r 2  68                 PLA
000E25r 2  85 rr              STA   eval_in_body
000E27r 2  68                 PLA
000E28r 2  85 rr              STA   body_resume_hi
000E2Ar 2  68                 PLA
000E2Br 2  85 rr              STA   body_resume_lo
000E2Dr 2  68                 PLA
000E2Er 2  85 rr              STA   body_start_hi
000E30r 2  68                 PLA
000E31r 2  85 rr              STA   body_start_lo
000E33r 2  68                 PLA
000E34r 2  85 rr              STA   repeat_count_hi
000E36r 2  68                 PLA
000E37r 2  85 rr              STA   repeat_count_lo
000E39r 2  68                 PLA
000E3Ar 2  85 rr              STA   repcount
000E3Cr 2               
000E3Cr 2  A5 rr              LDA   handler_hi
000E3Er 2  48                 PHA
000E3Fr 2  A5 rr              LDA   handler_lo
000E41r 2  48                 PHA
000E42r 2  60                 RTS
000E43r 2               
000E43r 2               ; ---------------------------------------------------------------------
000E43r 2               ; print_byte_hex — print A as 2 hex digits
000E43r 2               ; ---------------------------------------------------------------------
000E43r 2               print_byte_hex:
000E43r 2  48                 PHA
000E44r 2  4A                 LSR
000E45r 2  4A                 LSR
000E46r 2  4A                 LSR
000E47r 2  4A                 LSR
000E48r 2  20 rr rr           JSR   @nibble
000E4Br 2  68                 PLA
000E4Cr 2  29 0F              AND   #$0F
000E4Er 2  20 rr rr           JSR   @nibble
000E51r 2  60                 RTS
000E52r 2               @nibble:
000E52r 2  C9 0A              CMP   #$0A
000E54r 2  90 02              BCC   @digit
000E56r 2  69 06              ADC   #$06               ; carry is set, so adds 7
000E58r 2               @digit:
000E58r 2  69 30              ADC   #'0'
000E5Ar 2  8D 0E A0           STA   VGC_CHAROUT
000E5Dr 2  60                 RTS
000E5Er 2               
000E5Er 2               ; ---------------------------------------------------------------------
000E5Er 2               ; skip_list_body — advance eval_cur past a [...] block without executing
000E5Er 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000E5Er 2               ;   Exit:  eval_cur points at the token after the matching TOK_RBRACKET
000E5Er 2               ;          Carry clear = success, Carry set = missing bracket
000E5Er 2               ;   Clobbers: A, X, Y, ptr_lo/hi
000E5Er 2               ; ---------------------------------------------------------------------
000E5Er 2               skip_list_body:
000E5Er 2                     ; Verify current token is TOK_LBRACKET
000E5Er 2  A5 rr              LDA   eval_cur_lo
000E60r 2  05 rr              ORA   eval_cur_hi
000E62r 2  F0 41              BEQ   @err
000E64r 2  A5 rr              LDA   eval_cur_lo
000E66r 2  85 rr              STA   ptr_lo
000E68r 2  A5 rr              LDA   eval_cur_hi
000E6Ar 2  85 rr              STA   ptr_hi
000E6Cr 2  A0 00              LDY   #TOK_TAG
000E6Er 2  B1 rr              LDA   (ptr_lo),Y
000E70r 2  C9 03              CMP   #TOK_LBRACKET
000E72r 2  D0 31              BNE   @err
000E74r 2               
000E74r 2                     ; Advance past the [
000E74r 2  20 rr rr           JSR   eval_advance
000E77r 2  A2 01              LDX   #1                    ; depth = 1
000E79r 2               
000E79r 2               @scan:
000E79r 2  A5 rr              LDA   eval_cur_lo
000E7Br 2  05 rr              ORA   eval_cur_hi
000E7Dr 2  F0 26              BEQ   @err                  ; ran out of tokens
000E7Fr 2  A5 rr              LDA   eval_cur_lo
000E81r 2  85 rr              STA   ptr_lo
000E83r 2  A5 rr              LDA   eval_cur_hi
000E85r 2  85 rr              STA   ptr_hi
000E87r 2  A0 00              LDY   #TOK_TAG
000E89r 2  B1 rr              LDA   (ptr_lo),Y
000E8Br 2               
000E8Br 2  C9 03              CMP   #TOK_LBRACKET
000E8Dr 2  D0 03              BNE   @not_lb
000E8Fr 2  E8                 INX
000E90r 2  80 07              BRA   @scan_next
000E92r 2               @not_lb:
000E92r 2  C9 04              CMP   #TOK_RBRACKET
000E94r 2  D0 03              BNE   @scan_next
000E96r 2  CA                 DEX
000E97r 2  F0 07              BEQ   @found                 ; depth == 0 -> matched
000E99r 2               @scan_next:
000E99r 2  DA                 PHX
000E9Ar 2  20 rr rr           JSR   eval_advance
000E9Dr 2  FA                 PLX
000E9Er 2  80 D9              BRA   @scan
000EA0r 2               
000EA0r 2               @found:
000EA0r 2                     ; eval_cur is at the matching ]. Advance past it.
000EA0r 2  20 rr rr           JSR   eval_advance
000EA3r 2  18                 CLC
000EA4r 2  60                 RTS
000EA5r 2               
000EA5r 2               @err:
000EA5r 2  38                 SEC
000EA6r 2  60                 RTS
000EA7r 2               
000EA7r 2               ; ---------------------------------------------------------------------
000EA7r 2               ; exec_body_block — execute a [...] body once
000EA7r 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000EA7r 2               ;   Exit:  eval_cur points past the matching ], carry clear = ok
000EA7r 2               ;          Carry set = bracket error
000EA7r 2               ;   Saves/restores body_resume, eval_in_body for nesting.
000EA7r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, body_start/resume, eval_in_body
000EA7r 2               ; ---------------------------------------------------------------------
000EA7r 2               exec_body_block:
000EA7r 2                     ; Verify current token is [
000EA7r 2  A5 rr              LDA   eval_cur_lo
000EA9r 2  05 rr              ORA   eval_cur_hi
000EABr 2  F0 7B              BEQ   @err
000EADr 2  A5 rr              LDA   eval_cur_lo
000EAFr 2  85 rr              STA   ptr_lo
000EB1r 2  A5 rr              LDA   eval_cur_hi
000EB3r 2  85 rr              STA   ptr_hi
000EB5r 2  A0 00              LDY   #TOK_TAG
000EB7r 2  B1 rr              LDA   (ptr_lo),Y
000EB9r 2  C9 03              CMP   #TOK_LBRACKET
000EBBr 2  D0 6B              BNE   @err
000EBDr 2               
000EBDr 2                     ; Advance past [
000EBDr 2  20 rr rr           JSR   eval_advance
000EC0r 2               
000EC0r 2                     ; Save outer state for nesting
000EC0r 2  A5 rr              LDA   body_resume_lo
000EC2r 2  48                 PHA
000EC3r 2  A5 rr              LDA   body_resume_hi
000EC5r 2  48                 PHA
000EC6r 2  A5 rr              LDA   eval_in_body
000EC8r 2  48                 PHA
000EC9r 2               
000EC9r 2                     ; Save body start
000EC9r 2  A5 rr              LDA   eval_cur_lo
000ECBr 2  48                 PHA
000ECCr 2  A5 rr              LDA   eval_cur_hi
000ECEr 2  48                 PHA
000ECFr 2               
000ECFr 2                     ; Scan forward for matching ]
000ECFr 2  A2 01              LDX   #1
000ED1r 2               @scan:
000ED1r 2  A5 rr              LDA   eval_cur_lo
000ED3r 2  05 rr              ORA   eval_cur_hi
000ED5r 2  F0 4C              BEQ   @err_pop5
000ED7r 2  A5 rr              LDA   eval_cur_lo
000ED9r 2  85 rr              STA   ptr_lo
000EDBr 2  A5 rr              LDA   eval_cur_hi
000EDDr 2  85 rr              STA   ptr_hi
000EDFr 2  A0 00              LDY   #TOK_TAG
000EE1r 2  B1 rr              LDA   (ptr_lo),Y
000EE3r 2  C9 03              CMP   #TOK_LBRACKET
000EE5r 2  D0 03              BNE   @not_lb
000EE7r 2  E8                 INX
000EE8r 2  80 07              BRA   @scan_next
000EEAr 2               @not_lb:
000EEAr 2  C9 04              CMP   #TOK_RBRACKET
000EECr 2  D0 03              BNE   @scan_next
000EEEr 2  CA                 DEX
000EEFr 2  F0 07              BEQ   @found
000EF1r 2               @scan_next:
000EF1r 2  DA                 PHX
000EF2r 2  20 rr rr           JSR   eval_advance
000EF5r 2  FA                 PLX
000EF6r 2  80 D9              BRA   @scan
000EF8r 2               
000EF8r 2               @found:
000EF8r 2                     ; Advance past ] for resume point
000EF8r 2  20 rr rr           JSR   eval_advance
000EFBr 2  A5 rr              LDA   eval_cur_lo
000EFDr 2  85 rr              STA   body_resume_lo
000EFFr 2  A5 rr              LDA   eval_cur_hi
000F01r 2  85 rr              STA   body_resume_hi
000F03r 2               
000F03r 2                     ; Restore body start
000F03r 2  68                 PLA
000F04r 2  85 rr              STA   eval_cur_hi
000F06r 2  68                 PLA
000F07r 2  85 rr              STA   eval_cur_lo
000F09r 2               
000F09r 2                     ; Execute the body
000F09r 2  A9 01              LDA   #$01
000F0Br 2  85 rr              STA   eval_in_body
000F0Dr 2  20 rr rr           JSR   eval_body
000F10r 2               
000F10r 2                     ; Restore outer state
000F10r 2  68                 PLA
000F11r 2  85 rr              STA   eval_in_body
000F13r 2  68                 PLA
000F14r 2  85 rr              STA   body_resume_hi
000F16r 2  68                 PLA
000F17r 2  85 rr              STA   body_resume_lo
000F19r 2               
000F19r 2                     ; Set eval_cur past the ]
000F19r 2  A5 rr              LDA   body_resume_lo
000F1Br 2  85 rr              STA   eval_cur_lo
000F1Dr 2  A5 rr              LDA   body_resume_hi
000F1Fr 2  85 rr              STA   eval_cur_hi
000F21r 2  18                 CLC
000F22r 2  60                 RTS
000F23r 2               
000F23r 2               @err_pop5:
000F23r 2  68                 PLA
000F24r 2  68                 PLA
000F25r 2  68                 PLA
000F26r 2  68                 PLA
000F27r 2  68                 PLA
000F28r 2               @err:
000F28r 2  38                 SEC
000F29r 2  60                 RTS
000F2Ar 2               
000F2Ar 2               ; ---------------------------------------------------------------------
000F2Ar 2               ; do_if — IF condition [body]
000F2Ar 2               ;   Arity 0 — handles its own argument parsing
000F2Ar 2               ; ---------------------------------------------------------------------
000F2Ar 2               do_if:
000F2Ar 2  20 rr rr           JSR   eval_expr
000F2Dr 2  B0 1C              BCS   @err
000F2Fr 2               
000F2Fr 2                     ; Nonzero integer part = true
000F2Fr 2  A5 rr              LDA   eval_val_lo
000F31r 2  05 rr              ORA   eval_val_hi
000F33r 2  D0 08              BNE   @true
000F35r 2               
000F35r 2                     ; False — skip the body
000F35r 2  20 rr rr           JSR   skip_list_body
000F38r 2  B0 0B              BCS   @err_bracket
000F3Ar 2  4C rr rr           JMP   eval_continue
000F3Dr 2               
000F3Dr 2               @true:
000F3Dr 2  20 rr rr           JSR   exec_body_block
000F40r 2  B0 03              BCS   @err_bracket
000F42r 2  4C rr rr           JMP   eval_continue
000F45r 2               
000F45r 2               @err_bracket:
000F45r 2  A2 rr              LDX   #<str_if_bracket
000F47r 2  A0 rr              LDY   #>str_if_bracket
000F49r 2  80 04              BRA   if_print_err
000F4Br 2               @err:
000F4Br 2  A2 rr              LDX   #<str_if_err
000F4Dr 2  A0 rr              LDY   #>str_if_err
000F4Fr 2                     ; fall through
000F4Fr 2               
000F4Fr 2               if_print_err:
000F4Fr 2  86 rr              STX   ptr_lo
000F51r 2  84 rr              STY   ptr_hi
000F53r 2  A0 00              LDY   #0
000F55r 2               @lp:
000F55r 2  B1 rr              LDA   (ptr_lo),Y
000F57r 2  F0 06              BEQ   @done
000F59r 2  8D 0E A0           STA   VGC_CHAROUT
000F5Cr 2  C8                 INY
000F5Dr 2  D0 F6              BNE   @lp
000F5Fr 2               @done:
000F5Fr 2  20 rr rr           JSR   eval_newline
000F62r 2  4C rr rr           JMP   eval_continue
000F65r 2               
000F65r 2               ; ---------------------------------------------------------------------
000F65r 2               ; do_ifelse — IFELSE condition [true-body] [false-body]
000F65r 2               ;   Arity 0 — handles its own argument parsing
000F65r 2               ; ---------------------------------------------------------------------
000F65r 2               do_ifelse:
000F65r 2  20 rr rr           JSR   eval_expr
000F68r 2  B0 26              BCS   @err
000F6Ar 2               
000F6Ar 2  A5 rr              LDA   eval_val_lo
000F6Cr 2  05 rr              ORA   eval_val_hi
000F6Er 2  D0 0D              BNE   @is_true
000F70r 2               
000F70r 2                     ; FALSE: skip first body, execute second
000F70r 2  20 rr rr           JSR   skip_list_body
000F73r 2  B0 15              BCS   @err_bracket
000F75r 2  20 rr rr           JSR   exec_body_block
000F78r 2  B0 10              BCS   @err_bracket
000F7Ar 2  4C rr rr           JMP   eval_continue
000F7Dr 2               
000F7Dr 2               @is_true:
000F7Dr 2                     ; TRUE: execute first body, skip second
000F7Dr 2  20 rr rr           JSR   exec_body_block
000F80r 2  B0 08              BCS   @err_bracket
000F82r 2  20 rr rr           JSR   skip_list_body
000F85r 2  B0 03              BCS   @err_bracket
000F87r 2  4C rr rr           JMP   eval_continue
000F8Ar 2               
000F8Ar 2               @err_bracket:
000F8Ar 2  A2 rr              LDX   #<str_ifelse_bracket
000F8Cr 2  A0 rr              LDY   #>str_ifelse_bracket
000F8Er 2  80 04              BRA   ifelse_print_err
000F90r 2               @err:
000F90r 2  A2 rr              LDX   #<str_ifelse_err
000F92r 2  A0 rr              LDY   #>str_ifelse_err
000F94r 2                     ; fall through
000F94r 2               
000F94r 2               ifelse_print_err:
000F94r 2  86 rr              STX   ptr_lo
000F96r 2  84 rr              STY   ptr_hi
000F98r 2  A0 00              LDY   #0
000F9Ar 2               @lp:
000F9Ar 2  B1 rr              LDA   (ptr_lo),Y
000F9Cr 2  F0 06              BEQ   @done
000F9Er 2  8D 0E A0           STA   VGC_CHAROUT
000FA1r 2  C8                 INY
000FA2r 2  D0 F6              BNE   @lp
000FA4r 2               @done:
000FA4r 2  20 rr rr           JSR   eval_newline
000FA7r 2  4C rr rr           JMP   eval_continue
000FAAr 2               
000FAAr 2               ; ---------------------------------------------------------------------
000FAAr 2               ; do_stop — STOP: exit current procedure immediately (no return value)
000FAAr 2               ;   Arity 0, no arguments
000FAAr 2               ; ---------------------------------------------------------------------
000FAAr 2               do_stop:
000FAAr 2  A9 01              LDA   #$01
000FACr 2  85 rr              STA   proc_stopped
000FAEr 2  4C rr rr           JMP   eval_continue
000FB1r 2               
000FB1r 2               ; ---------------------------------------------------------------------
000FB1r 2               ; do_output — OUTPUT expr: exit procedure with a return value
000FB1r 2               ;   Arity 0 — handles its own argument evaluation
000FB1r 2               ; ---------------------------------------------------------------------
000FB1r 2               do_output:
000FB1r 2  20 rr rr           JSR   eval_expr           ; evaluate the expression
000FB4r 2  A9 02              LDA   #$02
000FB6r 2  85 rr              STA   proc_stopped        ; signal OUTPUT
000FB8r 2                     ; eval_type/eval_val holds the return value
000FB8r 2  4C rr rr           JMP   eval_continue
000FBBr 2               
000FBBr 2               ; ---------------------------------------------------------------------
000FBBr 2               ; do_catch — CATCH "tag [body]: execute body, catching errors/throws
000FBBr 2               ;   Arity 0 — handles its own argument parsing
000FBBr 2               ;   1. Evaluate tag argument (quoted word)
000FBBr 2               ;   2. Save current catch frame (for nesting) on the 6502 stack
000FBBr 2               ;   3. Set up new catch frame with tag and stack pointer
000FBBr 2               ;   4. Execute the body
000FBBr 2               ;   5. On normal completion: restore previous catch frame, continue
000FBBr 2               ;   On THROW match: try_throw_error or do_throw restores SP from
000FBBr 2               ;   catch frame, which unwinds back to step 5's stack context.
000FBBr 2               ; ---------------------------------------------------------------------
000FBBr 2               do_catch:
000FBBr 2                     ; Evaluate tag argument (e.g., "ERROR)
000FBBr 2  20 rr rr           JSR   eval_expr
000FBEr 2  90 03              BCC   @tag_ok
000FC0r 2  4C rr rr           JMP   @err_tag
000FC3r 2               @tag_ok:
000FC3r 2               
000FC3r 2                     ; Must be a word
000FC3r 2  A5 rr              LDA   eval_type
000FC5r 2  C9 01              CMP   #VAL_WORD
000FC7r 2  F0 03              BEQ   @type_ok
000FC9r 2  4C rr rr           JMP   @err_tag
000FCCr 2               @type_ok:
000FCCr 2               
000FCCr 2                     ; Save tag pointer and eval_in_body temporarily (3 bytes)
000FCCr 2  A5 rr              LDA   eval_val_lo
000FCEr 2  48                 PHA
000FCFr 2  A5 rr              LDA   eval_val_hi
000FD1r 2  48                 PHA
000FD2r 2  A5 rr              LDA   eval_in_body
000FD4r 2  48                 PHA
000FD5r 2               
000FD5r 2                     ; Push previous catch frame onto the 6502 stack (6 bytes)
000FD5r 2  A5 rr              LDA   catch_active
000FD7r 2  48                 PHA
000FD8r 2  A5 rr              LDA   catch_tag_lo
000FDAr 2  48                 PHA
000FDBr 2  A5 rr              LDA   catch_tag_hi
000FDDr 2  48                 PHA
000FDEr 2  A5 rr              LDA   catch_sp
000FE0r 2  48                 PHA
000FE1r 2  A5 rr              LDA   catch_resume_lo
000FE3r 2  48                 PHA
000FE4r 2  A5 rr              LDA   catch_resume_hi
000FE6r 2  48                 PHA
000FE7r 2               
000FE7r 2                     ; Set up the tag pointer from saved values
000FE7r 2                     ; Stack (top to bottom): prev_frame(6), eval_in_body, eval_val_hi, eval_val_lo
000FE7r 2                     ; $0101+X = SP+1 = top. eval_in_body at SP+7, eval_val_hi at SP+8, eval_val_lo at SP+9
000FE7r 2  BA                 TSX
000FE8r 2  BD 08 01           LDA   $0108,X               ; eval_val_hi = tag ptr high
000FEBr 2  85 rr              STA   catch_tag_hi
000FEDr 2  BD 09 01           LDA   $0109,X               ; eval_val_lo = tag ptr low
000FF0r 2  85 rr              STA   catch_tag_lo
000FF2r 2               
000FF2r 2                     ; Save stack pointer NOW — this is the unwind target.
000FF2r 2                     ; When a THROW matches, TXS restores to this SP, and the
000FF2r 2                     ; 6 PLA instructions below will pop the previous frame.
000FF2r 2  BA                 TSX
000FF3r 2  86 rr              STX   catch_sp
000FF5r 2               
000FF5r 2                     ; Activate the catch
000FF5r 2  A9 01              LDA   #$01
000FF7r 2  85 rr              STA   catch_active
000FF9r 2               
000FF9r 2                     ; We need to find the resume point PAST the body's ].
000FF9r 2                     ; Scan ahead to find it, then come back and execute the body.
000FF9r 2                     ; Save body start location first.
000FF9r 2  A5 rr              LDA   eval_cur_lo
000FFBr 2  48                 PHA                         ; save body-start lo
000FFCr 2  A5 rr              LDA   eval_cur_hi
000FFEr 2  48                 PHA                         ; save body-start hi
000FFFr 2               
000FFFr 2                     ; Scan past the body [...] to find resume point
000FFFr 2  20 rr rr           JSR   skip_list_body
001002r 2  B0 31              BCS   @err_bracket_pop
001004r 2               
001004r 2                     ; eval_cur is now past the ]. Save as resume point.
001004r 2  A5 rr              LDA   eval_cur_lo
001006r 2  85 rr              STA   catch_resume_lo
001008r 2  A5 rr              LDA   eval_cur_hi
00100Ar 2  85 rr              STA   catch_resume_hi
00100Cr 2               
00100Cr 2                     ; Restore body start
00100Cr 2  68                 PLA
00100Dr 2  85 rr              STA   eval_cur_hi
00100Fr 2  68                 PLA
001010r 2  85 rr              STA   eval_cur_lo
001012r 2               
001012r 2                     ; Execute the body
001012r 2  20 rr rr           JSR   exec_body_block
001015r 2               
001015r 2                     ; Body completed normally — restore previous catch frame
001015r 2                     ; (Stack still has: prev_frame(6), tag_hi, tag_lo at the bottom)
001015r 2  68                 PLA
001016r 2  85 rr              STA   catch_resume_hi
001018r 2  68                 PLA
001019r 2  85 rr              STA   catch_resume_lo
00101Br 2  68                 PLA
00101Cr 2  85 rr              STA   catch_sp
00101Er 2  68                 PLA
00101Fr 2  85 rr              STA   catch_tag_hi
001021r 2  68                 PLA
001022r 2  85 rr              STA   catch_tag_lo
001024r 2  68                 PLA
001025r 2  85 rr              STA   catch_active
001027r 2               
001027r 2                     ; Discard saved eval_in_body + tag ptr (3 bytes)
001027r 2  68                 PLA                         ; eval_in_body
001028r 2  68                 PLA                         ; tag_hi
001029r 2  68                 PLA                         ; tag_lo
00102Ar 2               
00102Ar 2                     ; Set eval_cur past the body
00102Ar 2  A5 rr              LDA   catch_resume_lo
00102Cr 2  85 rr              STA   eval_cur_lo
00102Er 2  A5 rr              LDA   catch_resume_hi
001030r 2  85 rr              STA   eval_cur_hi
001032r 2  4C rr rr           JMP   eval_continue
