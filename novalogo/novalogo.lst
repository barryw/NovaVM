002D61r 2                     ; Compute absolute pointer to body text start
002D61r 2  18                 CLC
002D62r 2  A5 rr              LDA   proc_entry_lo
002D64r 2  65 rr              ADC   proc_rec_off
002D66r 2  85 rr              STA   proc_ptr_lo
002D68r 2  A5 rr              LDA   proc_entry_hi
