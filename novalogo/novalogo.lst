0022F9r 2               ; ---------------------------------------------------------------------
0022F9r 2               ; do_run — RUN list: evaluate a list as Logo code
0022F9r 2               ;   Arity 0: evaluates its own argument
0022F9r 2               ;
0022F9r 2               ;   Strategy: convert list to text in input_buf, then save evaluator
0022F9r 2               ;   state, tokenize_line + eval_line, restore state.
0022F9r 2               ; ---------------------------------------------------------------------
0022F9r 2               do_run:
0022F9r 2  20 rr rr           JSR   eval_expr
0022FCr 2  90 03              BCC   :+
0022FEr 2  4C rr rr           JMP   @err
002301r 2               :
002301r 2  A5 rr              LDA   eval_type
002303r 2  C9 02              CMP   #VAL_LIST
002305r 2  D0 43              BNE   @err_type
002307r 2               
002307r 2                     ; Save eval_cur on stack (we'll resume here after RUN)
002307r 2  A5 rr              LDA   eval_cur_lo
002309r 2  48                 PHA
00230Ar 2  A5 rr              LDA   eval_cur_hi
00230Cr 2  48                 PHA
00230Dr 2               
00230Dr 2                     ; Render the list into input_buf as text
00230Dr 2                     ; eval_val_lo/hi = list head
00230Dr 2  64 rr              STZ   z:buf_idx               ; reset write position
00230Fr 2  20 rr rr           JSR   render_list_to_buf
002312r 2               
002312r 2                     ; Null-terminate input_buf
002312r 2  A6 rr              LDX   z:buf_idx
002314r 2  9E rr rr           STZ   input_buf,X
002317r 2               
002317r 2                     ; Save tokenizer and eval state (same pattern as proc_invoke)
002317r 2  A5 rr              LDA   tok_head_lo
002319r 2  48                 PHA
00231Ar 2  A5 rr              LDA   tok_head_hi
00231Cr 2  48                 PHA
00231Dr 2  A5 rr              LDA   tok_tail_lo
00231Fr 2  48                 PHA
002320r 2  A5 rr              LDA   tok_tail_hi
002322r 2  48                 PHA
002323r 2  A5 rr              LDA   eval_in_body
002325r 2  48                 PHA
002326r 2  A5 rr              LDA   eval_reporter
002328r 2  48                 PHA
002329r 2               
002329r 2                     ; Tokenize the reconstructed line
002329r 2  20 rr rr           JSR   tokenize_line
00232Cr 2               
00232Cr 2                     ; Evaluate it
00232Cr 2  20 rr rr           JSR   eval_line
00232Fr 2               
00232Fr 2                     ; Restore tokenizer/eval state
00232Fr 2  68                 PLA
002330r 2  85 rr              STA   eval_reporter
002332r 2  68                 PLA
002333r 2  85 rr              STA   eval_in_body
002335r 2  68                 PLA
002336r 2  85 rr              STA   tok_tail_hi
002338r 2  68                 PLA
002339r 2  85 rr              STA   tok_tail_lo
00233Br 2  68                 PLA
00233Cr 2  85 rr              STA   tok_head_hi
00233Er 2  68                 PLA
00233Fr 2  85 rr              STA   tok_head_lo
002341r 2               
002341r 2                     ; Restore eval_cur
002341r 2  68                 PLA
002342r 2  85 rr              STA   eval_cur_hi
002344r 2  68                 PLA
002345r 2  85 rr              STA   eval_cur_lo
002347r 2               
002347r 2  4C rr rr           JMP   eval_continue
00234Ar 2               
00234Ar 2               @err_type:
00234Ar 2  A2 rr              LDX   #<str_run_type
00234Cr 2  A0 rr              LDY   #>str_run_type
00234Er 2  4C rr rr           JMP   list_print_err
002351r 2               @err:
002351r 2  A2 rr              LDX   #<str_run_err
002353r 2  A0 rr              LDY   #>str_run_err
002355r 2  4C rr rr           JMP   list_print_err
