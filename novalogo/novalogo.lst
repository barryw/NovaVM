001586r 2  4C rr rr           JMP   @rl_alloc_cell
001589r 2               
001589r 2               @rl_alloc_cell:
001589r 2  A9 07              LDA   #CONS_SIZE
00158Br 2  A2 02              LDX   #ATYPE_CONS
00158Dr 2  20 rr rr           JSR   heap_alloc
001590r 2  90 03              BCC   @rl_alloc_ok
001592r 2  4C rr rr           JMP   @rl_oom
001595r 2               @rl_alloc_ok:
001595r 2  A0 00              LDY   #CONS_TAG
001597r 2  A9 10              LDA   #CONS_PAIR
001599r 2  91 rr              STA   (ptr_lo),Y
00159Br 2  A0 01              LDY   #CONS_CAR_TYPE
00159Dr 2  A5 rr              LDA   eval_type
00159Fr 2  91 rr              STA   (ptr_lo),Y
0015A1r 2  A0 02              LDY   #CONS_CAR_HI
0015A3r 2  A5 rr              LDA   eval_val_hi
0015A5r 2  91 rr              STA   (ptr_lo),Y
0015A7r 2  A0 03              LDY   #CONS_CAR_LO
0015A9r 2  A5 rr              LDA   eval_val_lo
0015ABr 2  91 rr              STA   (ptr_lo),Y
0015ADr 2  A0 04              LDY   #CONS_CAR_FRAC
0015AFr 2  A5 rr              LDA   eval_val_frac
0015B1r 2  91 rr              STA   (ptr_lo),Y
0015B3r 2  A0 05              LDY   #CONS_CDR_LO
0015B5r 2  A9 00              LDA   #0
0015B7r 2  91 rr              STA   (ptr_lo),Y
0015B9r 2  A0 06              LDY   #CONS_CDR_HI
0015BBr 2  91 rr              STA   (ptr_lo),Y
0015BDr 2               
0015BDr 2                     ; Link into list
0015BDr 2  A5 rr              LDA   z:list_head_lo
0015BFr 2  05 rr              ORA   z:list_head_hi
0015C1r 2  D0 0F              BNE   @rl_link_tail
0015C3r 2  A5 rr              LDA   ptr_lo
0015C5r 2  85 rr              STA   z:list_head_lo
0015C7r 2  85 rr              STA   z:list_tail_lo
0015C9r 2  A5 rr              LDA   ptr_hi
0015CBr 2  85 rr              STA   z:list_head_hi
0015CDr 2  85 rr              STA   z:list_tail_hi
0015CFr 2  4C rr rr           JMP   @rl_next
0015D2r 2               
0015D2r 2               @rl_link_tail:
0015D2r 2  A5 rr              LDA   z:list_tail_lo
0015D4r 2  85 rr              STA   ptr2_lo
0015D6r 2  A5 rr              LDA   z:list_tail_hi
0015D8r 2  85 rr              STA   ptr2_hi
0015DAr 2  A0 05              LDY   #CONS_CDR_LO
0015DCr 2  A5 rr              LDA   ptr_lo
0015DEr 2  91 rr              STA   (ptr2_lo),Y
0015E0r 2  A0 06              LDY   #CONS_CDR_HI
0015E2r 2  A5 rr              LDA   ptr_hi
0015E4r 2  91 rr              STA   (ptr2_lo),Y
0015E6r 2  A5 rr              LDA   ptr_lo
0015E8r 2  85 rr              STA   z:list_tail_lo
0015EAr 2  A5 rr              LDA   ptr_hi
0015ECr 2  85 rr              STA   z:list_tail_hi
0015EEr 2  4C rr rr           JMP   @rl_next
0015F1r 2               
0015F1r 2               @rl_build_done:
0015F1r 2                     ; Restore tokenizer state
0015F1r 2  68                 PLA
0015F2r 2  85 rr              STA   eval_cur_hi
0015F4r 2  68                 PLA
0015F5r 2  85 rr              STA   eval_cur_lo
0015F7r 2  68                 PLA
0015F8r 2  85 rr              STA   tok_tail_hi
0015FAr 2  68                 PLA
0015FBr 2  85 rr              STA   tok_tail_lo
0015FDr 2  68                 PLA
0015FEr 2  85 rr              STA   tok_head_hi
001600r 2  68                 PLA
001601r 2  85 rr              STA   tok_head_lo
001603r 2               
001603r 2                     ; Return the list
001603r 2  A9 02              LDA   #VAL_LIST
001605r 2  85 rr              STA   eval_type
001607r 2  A5 rr              LDA   z:list_head_lo
001609r 2  85 rr              STA   eval_val_lo
00160Br 2  A5 rr              LDA   z:list_head_hi
00160Dr 2  85 rr              STA   eval_val_hi
00160Fr 2  64 rr              STZ   eval_val_frac
001611r 2  4C rr rr           JMP   eval_continue
001614r 2               
001614r 2               @rl_oom:
001614r 2                     ; Restore tokenizer state before error
001614r 2  68                 PLA
001615r 2  85 rr              STA   eval_cur_hi
001617r 2  68                 PLA
001618r 2  85 rr              STA   eval_cur_lo
00161Ar 2  68                 PLA
00161Br 2  85 rr              STA   tok_tail_hi
00161Dr 2  68                 PLA
00161Er 2  85 rr              STA   tok_tail_lo
001620r 2  68                 PLA
001621r 2  85 rr              STA   tok_head_hi
001623r 2  68                 PLA
001624r 2  85 rr              STA   tok_head_lo
001626r 2  A2 rr              LDX   #<str_oom
001628r 2  A0 rr              LDY   #>str_oom
00162Ar 2  4C rr rr           JMP   list_print_err
00162Dr 2               
00162Dr 2               ; ---------------------------------------------------------------------
00162Dr 2               ; do_char — CHAR n: convert ASCII code to 1-char word
00162Dr 2               ;   Arity 0: evaluates its own argument
00162Dr 2               ; ---------------------------------------------------------------------
00162Dr 2               do_char:
00162Dr 2  20 rr rr           JSR   eval_expr
001630r 2  B0 09              BCS   @err
001632r 2                     ; Must be a number
001632r 2  A5 rr              LDA   eval_type
001634r 2  D0 05              BNE   @err
001636r 2                     ; Low byte of number is the ASCII code
001636r 2  A5 rr              LDA   eval_val_lo
001638r 2  4C rr rr           JMP   alloc_one_char_word
00163Br 2               @err:
00163Br 2  A2 rr              LDX   #<str_char_err
00163Dr 2  A0 rr              LDY   #>str_char_err
00163Fr 2  4C rr rr           JMP   list_print_err
001642r 2               
001642r 2               ; ---------------------------------------------------------------------
001642r 2               ; do_ascii — ASCII word: return ASCII code of first character
001642r 2               ;   Arity 0: evaluates its own argument
001642r 2               ; ---------------------------------------------------------------------
001642r 2               do_ascii:
001642r 2  20 rr rr           JSR   eval_expr
001645r 2  B0 23              BCS   @err
001647r 2                     ; Must be a word
001647r 2  A5 rr              LDA   eval_type
001649r 2  C9 01              CMP   #VAL_WORD
00164Br 2  D0 1D              BNE   @err_type
00164Dr 2                     ; eval_val_lo/hi points at length-prefixed string
00164Dr 2  A5 rr              LDA   eval_val_lo
00164Fr 2  85 rr              STA   ptr_lo
001651r 2  A5 rr              LDA   eval_val_hi
001653r 2  85 rr              STA   ptr_hi
001655r 2  A0 00              LDY   #0
001657r 2  B1 rr              LDA   (ptr_lo),Y           ; length
001659r 2  F0 0F              BEQ   @err_empty            ; empty word
00165Br 2  A0 01              LDY   #1
00165Dr 2  B1 rr              LDA   (ptr_lo),Y           ; first character
00165Fr 2  85 rr              STA   eval_val_lo
001661r 2  64 rr              STZ   eval_val_hi
001663r 2  64 rr              STZ   eval_val_frac
001665r 2  64 rr              STZ   eval_type             ; VAL_NUMBER
001667r 2  4C rr rr           JMP   eval_continue
00166Ar 2               @err_type:
00166Ar 2               @err_empty:
00166Ar 2               @err:
00166Ar 2  A2 rr              LDX   #<str_ascii_err
00166Cr 2  A0 rr              LDY   #>str_ascii_err
00166Er 2  4C rr rr           JMP   list_print_err
001671r 2               
001671r 2               ; =====================================================================
001671r 2               ; Math functions and type predicates
001671r 2               ; =====================================================================
001671r 2               
001671r 2               ; ---------------------------------------------------------------------
001671r 2               ; return_number — set eval_val from eval_val_lo/hi, clear frac+type
001671r 2               ;   Entry: eval_val_lo/hi already set
001671r 2               ;   Jumps to eval_continue
001671r 2               ; ---------------------------------------------------------------------
001671r 2               return_number:
001671r 2  64 rr              STZ   eval_val_frac
001673r 2  64 rr              STZ   eval_type
001675r 2  4C rr rr           JMP   eval_continue
001678r 2               
001678r 2               ; ---------------------------------------------------------------------
001678r 2               ; return_signed_byte — sign-extend A into eval_val as 16.8 number
001678r 2               ;   Entry: A = signed byte (-128..+127)
001678r 2               ;   Jumps to eval_continue
001678r 2               ; ---------------------------------------------------------------------
001678r 2               return_signed_byte:
001678r 2  85 rr              STA   eval_val_lo
00167Ar 2  10 04              BPL   @pos
00167Cr 2  A9 FF              LDA   #$FF
00167Er 2  80 02              BRA   @set
001680r 2  A9 00        @pos: LDA   #$00
001682r 2  85 rr        @set: STA   eval_val_hi
001684r 2  80 EB              BRA   return_number
001686r 2               
001686r 2               ; ---------------------------------------------------------------------
001686r 2               ; predicate_result — set eval_val to 1 (Z set) or 0 (Z clear)
001686r 2               ;   Entry: Z flag from CMP
001686r 2               ;   Jumps to eval_continue
001686r 2               ; ---------------------------------------------------------------------
001686r 2               predicate_result:
001686r 2  F0 04              BEQ   @true
001688r 2  64 rr              STZ   eval_val_lo
00168Ar 2  80 04              BRA   @done
00168Cr 2               @true:
00168Cr 2  A9 01              LDA   #1
00168Er 2  85 rr              STA   eval_val_lo
001690r 2               @done:
001690r 2  64 rr              STZ   eval_val_hi
001692r 2  80 DD              BRA   return_number
001694r 2               
001694r 2               ; ---------------------------------------------------------------------
001694r 2               ; degrees_to_u8 — convert eval_val (degrees 0-360) to u8 angle (0-255)
001694r 2               ;   Uses MUL16 coprocessor: angle = degrees * 91 / 128
001694r 2               ;   Actually: write degrees to MUL16 A, 91 to B, read RES1 (high byte)
001694r 2               ;   Then shift right once (divide by 2) since 91/256=0.355, we want 91/128
001694r 2               ;   Wait, let me recalculate: degrees * 91 >> 7
001694r 2               ;   MUL16 gives degrees*91 in RES1:RES0. We want bits [14:7] of that.
001694r 2               ;   RES1 is bits [15:8]. But we want >>7 which is RES1<<1 | RES0>>7.
001694r 2               ;   Simpler: degrees * 182 / 256 = RES1 of (degrees * 182). Let's use 182.
001694r 2               ;   Output: A = u8 angle
001694r 2               ;   Clobbers: uses math coprocessor regs
001694r 2               ; ---------------------------------------------------------------------
001694r 2               degrees_to_u8:
001694r 2  A5 rr              LDA   eval_val_lo
001696r 2  8D 20 BB           STA   MATH_MUL16_A_LO
001699r 2  A5 rr              LDA   eval_val_hi
00169Br 2  8D 21 BB           STA   MATH_MUL16_A_HI
00169Er 2  A9 B6              LDA   #182
0016A0r 2  8D 22 BB           STA   MATH_MUL16_B_LO
0016A3r 2  9C 23 BB           STZ   MATH_MUL16_B_HI       ; trigger multiply
0016A6r 2  AD 39 BB           LDA   MATH_RES1              ; high byte = degrees * 182 / 256
0016A9r 2  60                 RTS
0016AAr 2               
0016AAr 2               ; ---------------------------------------------------------------------
0016AAr 2               ; do_sin — SIN degrees: return sin as signed byte (-128..+127)
0016AAr 2               ; ---------------------------------------------------------------------
0016AAr 2               do_sin:
0016AAr 2  20 rr rr           JSR   eval_expr
0016ADr 2  B0 0C              BCS   @err
0016AFr 2  20 rr rr           JSR   degrees_to_u8
0016B2r 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
0016B5r 2  AD 38 BB           LDA   MATH_RES0              ; sin result (signed 1.7)
0016B8r 2  4C rr rr           JMP   return_signed_byte
0016BBr 2               @err:
0016BBr 2  38                 SEC
0016BCr 2  60                 RTS
0016BDr 2               
0016BDr 2               ; ---------------------------------------------------------------------
0016BDr 2               ; do_cos — COS degrees: return cos as signed byte (-128..+127)
0016BDr 2               ; ---------------------------------------------------------------------
0016BDr 2               do_cos:
0016BDr 2  20 rr rr           JSR   eval_expr
0016C0r 2  B0 0C              BCS   @err
0016C2r 2  20 rr rr           JSR   degrees_to_u8
0016C5r 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
0016C8r 2  AD 39 BB           LDA   MATH_RES1              ; cos result (signed 1.7)
0016CBr 2  4C rr rr           JMP   return_signed_byte
0016CEr 2               @err:
0016CEr 2  38                 SEC
0016CFr 2  60                 RTS
0016D0r 2               
0016D0r 2               ; ---------------------------------------------------------------------
0016D0r 2               ; do_abs — ABS n: return absolute value
0016D0r 2               ; ---------------------------------------------------------------------
0016D0r 2               do_abs:
0016D0r 2  20 rr rr           JSR   eval_expr
0016D3r 2  B0 22              BCS   @err
0016D5r 2  A5 rr              LDA   eval_val_hi
0016D7r 2  10 19              BPL   @done                  ; already positive
0016D9r 2                     ; Negate 24-bit value
0016D9r 2  A5 rr              LDA   eval_val_frac
0016DBr 2  49 FF              EOR   #$FF
0016DDr 2  18                 CLC
0016DEr 2  69 01              ADC   #1
0016E0r 2  85 rr              STA   eval_val_frac
0016E2r 2  A5 rr              LDA   eval_val_lo
0016E4r 2  49 FF              EOR   #$FF
0016E6r 2  69 00              ADC   #0
0016E8r 2  85 rr              STA   eval_val_lo
0016EAr 2  A5 rr              LDA   eval_val_hi
0016ECr 2  49 FF              EOR   #$FF
0016EEr 2  69 00              ADC   #0
0016F0r 2  85 rr              STA   eval_val_hi
0016F2r 2               @done:
0016F2r 2  64 rr              STZ   eval_type
0016F4r 2  4C rr rr           JMP   eval_continue
0016F7r 2               @err:
0016F7r 2  38                 SEC
0016F8r 2  60                 RTS
0016F9r 2               
0016F9r 2               ; ---------------------------------------------------------------------
0016F9r 2               ; do_int — INT n: truncate fractional part
0016F9r 2               ; ---------------------------------------------------------------------
0016F9r 2               do_int:
0016F9r 2  20 rr rr           JSR   eval_expr
0016FCr 2  B0 07              BCS   @err
0016FEr 2  64 rr              STZ   eval_val_frac
001700r 2  64 rr              STZ   eval_type
001702r 2  4C rr rr           JMP   eval_continue
001705r 2               @err:
001705r 2  38                 SEC
001706r 2  60                 RTS
001707r 2               
001707r 2               ; ---------------------------------------------------------------------
001707r 2               ; do_round — ROUND n: round to nearest integer
001707r 2               ; ---------------------------------------------------------------------
001707r 2               do_round:
001707r 2  20 rr rr           JSR   eval_expr
00170Ar 2  B0 19              BCS   @err
00170Cr 2  A5 rr              LDA   eval_val_frac
00170Er 2  C9 80              CMP   #128
001710r 2  90 0C              BCC   @trunc
001712r 2                     ; Round up: increment integer part
001712r 2  A5 rr              LDA   eval_val_hi
001714r 2  10 02              BPL   @pos_round
001716r 2                     ; Negative: actually round toward zero = truncate
001716r 2  80 06              BRA   @trunc
001718r 2               @pos_round:
001718r 2  E6 rr              INC   eval_val_lo
00171Ar 2  D0 02              BNE   @trunc
00171Cr 2  E6 rr              INC   eval_val_hi
00171Er 2               @trunc:
00171Er 2  64 rr              STZ   eval_val_frac
001720r 2  64 rr              STZ   eval_type
001722r 2  4C rr rr           JMP   eval_continue
001725r 2               @err:
001725r 2  38                 SEC
001726r 2  60                 RTS
001727r 2               
001727r 2               ; ---------------------------------------------------------------------
001727r 2               ; do_random — RANDOM n: return random number 0..n-1
001727r 2               ;   Uses math coprocessor RNG + MUL16 to scale
001727r 2               ; ---------------------------------------------------------------------
001727r 2               do_random:
001727r 2  20 rr rr           JSR   eval_expr
00172Ar 2  B0 1D              BCS   @err
00172Cr 2                     ; RNG byte * n / 256 gives 0..n-1
00172Cr 2  AD 37 BB           LDA   MATH_RNG
00172Fr 2  8D 20 BB           STA   MATH_MUL16_A_LO
001732r 2  9C 21 BB           STZ   MATH_MUL16_A_HI
001735r 2  A5 rr              LDA   eval_val_lo
001737r 2  8D 22 BB           STA   MATH_MUL16_B_LO
00173Ar 2  A5 rr              LDA   eval_val_hi
00173Cr 2  8D 23 BB           STA   MATH_MUL16_B_HI       ; trigger
00173Fr 2  AD 39 BB           LDA   MATH_RES1              ; high byte of (rng * n) = rng*n/256
001742r 2  85 rr              STA   eval_val_lo
001744r 2  64 rr              STZ   eval_val_hi
001746r 2  4C rr rr           JMP   return_number
001749r 2               @err:
001749r 2  38                 SEC
00174Ar 2  60                 RTS
00174Br 2               
00174Br 2               ; ---------------------------------------------------------------------
00174Br 2               ; do_sqrt — SQRT n: approximate sqrt via DIST_APPROX(n, 0)
00174Br 2               ; ---------------------------------------------------------------------
00174Br 2               do_sqrt:
00174Br 2  20 rr rr           JSR   eval_expr
00174Er 2  B0 1D              BCS   @err
001750r 2  A5 rr              LDA   eval_val_lo
001752r 2  8D 33 BB           STA   MATH_DIST_DX_LO
001755r 2  A5 rr              LDA   eval_val_hi
001757r 2  8D 34 BB           STA   MATH_DIST_DX_HI
00175Ar 2  9C 35 BB           STZ   MATH_DIST_DY_LO
00175Dr 2  9C 36 BB           STZ   MATH_DIST_DY_HI       ; trigger (write to DY_HI triggers)
001760r 2  AD 38 BB           LDA   MATH_RES0
001763r 2  85 rr              STA   eval_val_lo
001765r 2  AD 39 BB           LDA   MATH_RES1
001768r 2  85 rr              STA   eval_val_hi
00176Ar 2  4C rr rr           JMP   return_number
00176Dr 2               @err:
00176Dr 2  38                 SEC
00176Er 2  60                 RTS
00176Fr 2               
00176Fr 2               ; ---------------------------------------------------------------------
00176Fr 2               ; do_remainder — REMAINDER a b: return a mod b via DIV coprocessor
00176Fr 2               ; ---------------------------------------------------------------------
00176Fr 2               do_remainder:
00176Fr 2  20 rr rr           JSR   eval_expr              ; first arg (a)
001772r 2  B0 49              BCS   @err
001774r 2  A5 rr              LDA   eval_val_lo
001776r 2  48                 PHA
001777r 2  A5 rr              LDA   eval_val_hi
001779r 2  48                 PHA
00177Ar 2  20 rr rr           JSR   eval_expr              ; second arg (b)
00177Dr 2  B0 3C              BCS   @err_pop
00177Fr 2                     ; b in eval_val, a on stack
00177Fr 2                     ; Check divide by zero
00177Fr 2  A5 rr              LDA   eval_val_lo
001781r 2  05 rr              ORA   eval_val_hi
001783r 2  F0 2D              BEQ   @zero_pop
001785r 2                     ; Set up 32÷16 division: dividend=a, divisor=b
001785r 2  68                 PLA
001786r 2  8D 29 BB           STA   MATH_DIV_N_1           ; a_hi
001789r 2  AA                 TAX                          ; save for sign-extend
00178Ar 2  68                 PLA
00178Br 2  8D 28 BB           STA   MATH_DIV_N_LO          ; a_lo
00178Er 2                     ; Sign-extend a
00178Er 2  8A                 TXA
00178Fr 2  09 7F              ORA   #$7F
001791r 2  30 02              BMI   @neg_a
001793r 2  A9 00              LDA   #$00
001795r 2               @neg_a:                            ; A=$FF if negative
001795r 2  8D 2A BB           STA   MATH_DIV_N_2
001798r 2  8D 2B BB           STA   MATH_DIV_N_HI
00179Br 2  A5 rr              LDA   eval_val_lo
00179Dr 2  8D 2C BB           STA   MATH_DIV_D_LO
0017A0r 2  A5 rr              LDA   eval_val_hi
0017A2r 2  8D 2D BB           STA   MATH_DIV_D_HI          ; trigger
0017A5r 2                     ; Remainder is in RES2:RES3 (actually check what the copro returns)
0017A5r 2                     ; The math copro returns quotient in RES0:RES1, remainder in RES2:RES3
0017A5r 2  AD 3A BB           LDA   MATH_RES2
0017A8r 2  85 rr              STA   eval_val_lo
0017AAr 2  AD 3B BB           LDA   MATH_RES3
0017ADr 2  85 rr              STA   eval_val_hi
0017AFr 2  4C rr rr           JMP   return_number
0017B2r 2               @zero_pop:
0017B2r 2  68                 PLA
0017B3r 2  68                 PLA
0017B4r 2  64 rr              STZ   eval_val_lo
0017B6r 2  64 rr              STZ   eval_val_hi
0017B8r 2  4C rr rr           JMP   return_number
0017BBr 2               @err_pop:
0017BBr 2  68                 PLA
0017BCr 2  68                 PLA
0017BDr 2               @err:
0017BDr 2  38                 SEC
0017BEr 2  60                 RTS
0017BFr 2               
0017BFr 2               ; ---------------------------------------------------------------------
0017BFr 2               ; do_not — NOT expr: return 1 if expr is 0, else 0
0017BFr 2               ; ---------------------------------------------------------------------
0017BFr 2               do_not:
0017BFr 2  20 rr rr           JSR   eval_expr
0017C2r 2  B0 13              BCS   @err
0017C4r 2  A5 rr              LDA   eval_val_lo
0017C6r 2  05 rr              ORA   eval_val_hi
0017C8r 2                     ; If zero, set result to 1. If nonzero, set to 0.
0017C8r 2  D0 06              BNE   @false
0017CAr 2  A9 01              LDA   #1
0017CCr 2  85 rr              STA   eval_val_lo
0017CEr 2  80 02              BRA   @done
0017D0r 2               @false:
0017D0r 2  64 rr              STZ   eval_val_lo
0017D2r 2               @done:
0017D2r 2  64 rr              STZ   eval_val_hi
0017D4r 2  4C rr rr           JMP   return_number
0017D7r 2               @err:
0017D7r 2  38                 SEC
0017D8r 2  60                 RTS
0017D9r 2               
0017D9r 2               ; ---------------------------------------------------------------------
0017D9r 2               ; do_and — AND a b: return 1 if both nonzero, else 0
0017D9r 2               ; ---------------------------------------------------------------------
0017D9r 2               do_and:
0017D9r 2  20 rr rr           JSR   eval_expr
0017DCr 2  B0 1E              BCS   @err
0017DEr 2  A5 rr              LDA   eval_val_lo
0017E0r 2  05 rr              ORA   eval_val_hi
0017E2r 2  F0 11              BEQ   @false                 ; first arg is 0 → short-circuit
0017E4r 2  20 rr rr           JSR   eval_expr
0017E7r 2  B0 13              BCS   @err
0017E9r 2  A5 rr              LDA   eval_val_lo
0017EBr 2  05 rr              ORA   eval_val_hi
0017EDr 2  F0 06              BEQ   @false
0017EFr 2  A9 01              LDA   #1
0017F1r 2  85 rr              STA   eval_val_lo
0017F3r 2  80 02              BRA   @done
0017F5r 2               @false:
0017F5r 2  64 rr              STZ   eval_val_lo
0017F7r 2               @done:
0017F7r 2  64 rr              STZ   eval_val_hi
0017F9r 2  4C rr rr           JMP   return_number
0017FCr 2               @err:
0017FCr 2  38                 SEC
0017FDr 2  60                 RTS
0017FEr 2               
0017FEr 2               ; ---------------------------------------------------------------------
0017FEr 2               ; do_or — OR a b: return 1 if either nonzero, else 0
0017FEr 2               ; ---------------------------------------------------------------------
0017FEr 2               do_or:
0017FEr 2  20 rr rr           JSR   eval_expr
001801r 2  B0 1E              BCS   @err
001803r 2  A5 rr              LDA   eval_val_lo
001805r 2  05 rr              ORA   eval_val_hi
001807r 2  D0 0F              BNE   @true                  ; first arg nonzero → short-circuit
001809r 2  20 rr rr           JSR   eval_expr
00180Cr 2  B0 13              BCS   @err
00180Er 2  A5 rr              LDA   eval_val_lo
001810r 2  05 rr              ORA   eval_val_hi
001812r 2  D0 04              BNE   @true
001814r 2  64 rr              STZ   eval_val_lo
001816r 2  80 04              BRA   @done
001818r 2               @true:
001818r 2  A9 01              LDA   #1
00181Ar 2  85 rr              STA   eval_val_lo
00181Cr 2               @done:
