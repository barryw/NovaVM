000F5Fr 2  B0 03              BCS   @err_bracket
000F61r 2  4C rr rr           JMP   eval_continue
000F64r 2               
000F64r 2               @err_bracket:
000F64r 2  A2 rr              LDX   #<str_ifelse_bracket
000F66r 2  A0 rr              LDY   #>str_ifelse_bracket
