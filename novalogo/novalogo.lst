001472r 2  D0 03              BNE   :+
001474r 2  4C rr rr           JMP   @rl_sublist
001477r 2               :     ; Skip other tokens (brackets, infix, etc.)
001477r 2  20 rr rr           JSR   eval_advance
00147Ar 2  80 D0              BRA   @rl_next
00147Cr 2               
00147Cr 2               @rl_word_jmp:
00147Cr 2  4C rr rr           JMP   @rl_word
00147Fr 2               
00147Fr 2               @rl_number:
00147Fr 2  A0 03              LDY   #TOK_PAYLOAD
001481r 2  B1 rr              LDA   (ptr_lo),Y
001483r 2  85 rr              STA   eval_val_hi
001485r 2  C8                 INY
001486r 2  B1 rr              LDA   (ptr_lo),Y
001488r 2  85 rr              STA   eval_val_lo
00148Ar 2  C8                 INY
00148Br 2  B1 rr              LDA   (ptr_lo),Y
00148Dr 2  85 rr              STA   eval_val_frac
00148Fr 2  A9 00              LDA   #VAL_NUMBER
001491r 2  85 rr              STA   eval_type
001493r 2  20 rr rr           JSR   eval_advance
001496r 2  4C rr rr           JMP   @rl_alloc_cell
001499r 2               
001499r 2               @rl_word:
001499r 2                     ; Allocate string on heap and copy word from token payload
001499r 2  A0 03              LDY   #TOK_PAYLOAD
00149Br 2  B1 rr              LDA   (ptr_lo),Y           ; length
00149Dr 2  48                 PHA
00149Er 2  1A                 INC                        ; +1 for length byte
00149Fr 2  A2 05              LDX   #ATYPE_STRING
0014A1r 2  20 rr rr           JSR   heap_alloc
0014A4r 2  90 04              BCC   :+
0014A6r 2  68                 PLA
0014A7r 2  4C rr rr           JMP   @rl_oom
0014AAr 2               :     ; Re-read source token (ptr_lo clobbered by heap_alloc)
0014AAr 2  A5 rr              LDA   eval_cur_lo
0014ACr 2  85 rr              STA   ptr2_lo
0014AEr 2  A5 rr              LDA   eval_cur_hi
0014B0r 2  85 rr              STA   ptr2_hi
0014B2r 2  68                 PLA
0014B3r 2  48                 PHA
0014B4r 2  A0 00              LDY   #0
0014B6r 2  91 rr              STA   (ptr_lo),Y           ; store length
0014B8r 2  68                 PLA
0014B9r 2  AA                 TAX
0014BAr 2  F0 1B              BEQ   @rl_word_done
0014BCr 2  A0 01              LDY   #1
0014BEr 2  9C rr rr           STZ   num_tmp_lo
0014C1r 2               @rl_wch:
0014C1r 2  DA                 PHX
0014C2r 2  5A                 PHY
0014C3r 2  AD rr rr           LDA   num_tmp_lo
0014C6r 2  18                 CLC
0014C7r 2  69 04              ADC   #TOK_PAYLOAD+1
0014C9r 2  A8                 TAY
0014CAr 2  B1 rr              LDA   (ptr2_lo),Y
0014CCr 2  7A                 PLY
0014CDr 2  91 rr              STA   (ptr_lo),Y
0014CFr 2  C8                 INY
0014D0r 2  EE rr rr           INC   num_tmp_lo
0014D3r 2  FA                 PLX
0014D4r 2  CA                 DEX
0014D5r 2  D0 EA              BNE   @rl_wch
0014D7r 2               @rl_word_done:
0014D7r 2  A5 rr              LDA   ptr_lo
0014D9r 2  85 rr              STA   eval_val_lo
0014DBr 2  A5 rr              LDA   ptr_hi
0014DDr 2  85 rr              STA   eval_val_hi
0014DFr 2  64 rr              STZ   eval_val_frac
0014E1r 2  A9 01              LDA   #VAL_WORD
0014E3r 2  85 rr              STA   eval_type
0014E5r 2  20 rr rr           JSR   eval_advance
0014E8r 2  4C rr rr           JMP   @rl_alloc_cell
0014EBr 2               
0014EBr 2               @rl_sublist:
0014EBr 2                     ; Use eval_list to build the sublist (advances past matching ])
0014EBr 2  20 rr rr           JSR   eval_advance
0014EEr 2  A5 rr              LDA   z:list_head_lo
0014F0r 2  48                 PHA
0014F1r 2  A5 rr              LDA   z:list_head_hi
0014F3r 2  48                 PHA
0014F4r 2  A5 rr              LDA   z:list_tail_lo
0014F6r 2  48                 PHA
0014F7r 2  A5 rr              LDA   z:list_tail_hi
0014F9r 2  48                 PHA
0014FAr 2  20 rr rr           JSR   eval_list
0014FDr 2  68                 PLA
0014FEr 2  85 rr              STA   z:list_tail_hi
001500r 2  68                 PLA
001501r 2  85 rr              STA   z:list_tail_lo
001503r 2  68                 PLA
001504r 2  85 rr              STA   z:list_head_hi
001506r 2  68                 PLA
001507r 2  85 rr              STA   z:list_head_lo
001509r 2                     ; eval_type = VAL_LIST, eval_val = sublist head
001509r 2  4C rr rr           JMP   @rl_alloc_cell
00150Cr 2               
00150Cr 2               @rl_alloc_cell:
00150Cr 2  A9 07              LDA   #CONS_SIZE
00150Er 2  A2 02              LDX   #ATYPE_CONS
001510r 2  20 rr rr           JSR   heap_alloc
001513r 2  90 03              BCC   @rl_alloc_ok
001515r 2  4C rr rr           JMP   @rl_oom
001518r 2               @rl_alloc_ok:
001518r 2  A0 00              LDY   #CONS_TAG
00151Ar 2  A9 10              LDA   #CONS_PAIR
00151Cr 2  91 rr              STA   (ptr_lo),Y
00151Er 2  A0 01              LDY   #CONS_CAR_TYPE
001520r 2  A5 rr              LDA   eval_type
001522r 2  91 rr              STA   (ptr_lo),Y
001524r 2  A0 02              LDY   #CONS_CAR_HI
001526r 2  A5 rr              LDA   eval_val_hi
001528r 2  91 rr              STA   (ptr_lo),Y
00152Ar 2  A0 03              LDY   #CONS_CAR_LO
00152Cr 2  A5 rr              LDA   eval_val_lo
00152Er 2  91 rr              STA   (ptr_lo),Y
001530r 2  A0 04              LDY   #CONS_CAR_FRAC
001532r 2  A5 rr              LDA   eval_val_frac
001534r 2  91 rr              STA   (ptr_lo),Y
001536r 2  A0 05              LDY   #CONS_CDR_LO
001538r 2  A9 00              LDA   #0
00153Ar 2  91 rr              STA   (ptr_lo),Y
00153Cr 2  A0 06              LDY   #CONS_CDR_HI
00153Er 2  91 rr              STA   (ptr_lo),Y
001540r 2               
001540r 2                     ; Link into list
001540r 2  A5 rr              LDA   z:list_head_lo
001542r 2  05 rr              ORA   z:list_head_hi
001544r 2  D0 0F              BNE   @rl_link_tail
001546r 2  A5 rr              LDA   ptr_lo
001548r 2  85 rr              STA   z:list_head_lo
00154Ar 2  85 rr              STA   z:list_tail_lo
00154Cr 2  A5 rr              LDA   ptr_hi
00154Er 2  85 rr              STA   z:list_head_hi
001550r 2  85 rr              STA   z:list_tail_hi
001552r 2  4C rr rr           JMP   @rl_next
001555r 2               
001555r 2               @rl_link_tail:
001555r 2  A5 rr              LDA   z:list_tail_lo
001557r 2  85 rr              STA   ptr2_lo
001559r 2  A5 rr              LDA   z:list_tail_hi
00155Br 2  85 rr              STA   ptr2_hi
00155Dr 2  A0 05              LDY   #CONS_CDR_LO
00155Fr 2  A5 rr              LDA   ptr_lo
001561r 2  91 rr              STA   (ptr2_lo),Y
001563r 2  A0 06              LDY   #CONS_CDR_HI
001565r 2  A5 rr              LDA   ptr_hi
001567r 2  91 rr              STA   (ptr2_lo),Y
001569r 2  A5 rr              LDA   ptr_lo
00156Br 2  85 rr              STA   z:list_tail_lo
00156Dr 2  A5 rr              LDA   ptr_hi
00156Fr 2  85 rr              STA   z:list_tail_hi
001571r 2  4C rr rr           JMP   @rl_next
001574r 2               
001574r 2               @rl_build_done:
001574r 2                     ; Restore tokenizer state
001574r 2  68                 PLA
001575r 2  85 rr              STA   eval_cur_hi
001577r 2  68                 PLA
001578r 2  85 rr              STA   eval_cur_lo
00157Ar 2  68                 PLA
00157Br 2  85 rr              STA   tok_tail_hi
00157Dr 2  68                 PLA
00157Er 2  85 rr              STA   tok_tail_lo
001580r 2  68                 PLA
001581r 2  85 rr              STA   tok_head_hi
001583r 2  68                 PLA
001584r 2  85 rr              STA   tok_head_lo
001586r 2               
001586r 2                     ; Return the list
001586r 2  A9 02              LDA   #VAL_LIST
001588r 2  85 rr              STA   eval_type
00158Ar 2  A5 rr              LDA   z:list_head_lo
00158Cr 2  85 rr              STA   eval_val_lo
00158Er 2  A5 rr              LDA   z:list_head_hi
001590r 2  85 rr              STA   eval_val_hi
001592r 2  64 rr              STZ   eval_val_frac
001594r 2  4C rr rr           JMP   eval_continue
001597r 2               
001597r 2               @rl_oom:
001597r 2                     ; Restore tokenizer state before error
001597r 2  68                 PLA
001598r 2  85 rr              STA   eval_cur_hi
00159Ar 2  68                 PLA
00159Br 2  85 rr              STA   eval_cur_lo
00159Dr 2  68                 PLA
00159Er 2  85 rr              STA   tok_tail_hi
0015A0r 2  68                 PLA
0015A1r 2  85 rr              STA   tok_tail_lo
0015A3r 2  68                 PLA
0015A4r 2  85 rr              STA   tok_head_hi
0015A6r 2  68                 PLA
0015A7r 2  85 rr              STA   tok_head_lo
0015A9r 2  A2 rr              LDX   #<str_oom
0015ABr 2  A0 rr              LDY   #>str_oom
0015ADr 2  4C rr rr           JMP   list_print_err
0015B0r 2               
0015B0r 2               ; ---------------------------------------------------------------------
0015B0r 2               ; do_char — CHAR n: convert ASCII code to 1-char word
0015B0r 2               ;   Arity 0: evaluates its own argument
0015B0r 2               ; ---------------------------------------------------------------------
0015B0r 2               do_char:
0015B0r 2  20 rr rr           JSR   eval_expr
0015B3r 2  B0 09              BCS   @err
0015B5r 2                     ; Must be a number
0015B5r 2  A5 rr              LDA   eval_type
0015B7r 2  D0 05              BNE   @err
0015B9r 2                     ; Low byte of number is the ASCII code
0015B9r 2  A5 rr              LDA   eval_val_lo
0015BBr 2  4C rr rr           JMP   alloc_one_char_word
0015BEr 2               @err:
0015BEr 2  A2 rr              LDX   #<str_char_name
0015C0r 2  A0 rr              LDY   #>str_char_name
0015C2r 2  4C rr rr           JMP   err_nei
0015C5r 2               
0015C5r 2               ; ---------------------------------------------------------------------
0015C5r 2               ; do_ascii — ASCII word: return ASCII code of first character
0015C5r 2               ;   Arity 0: evaluates its own argument
0015C5r 2               ; ---------------------------------------------------------------------
0015C5r 2               do_ascii:
0015C5r 2  20 rr rr           JSR   eval_expr
0015C8r 2  B0 23              BCS   @err
0015CAr 2                     ; Must be a word
0015CAr 2  A5 rr              LDA   eval_type
0015CCr 2  C9 01              CMP   #VAL_WORD
0015CEr 2  D0 1D              BNE   @err_type
0015D0r 2                     ; eval_val_lo/hi points at length-prefixed string
0015D0r 2  A5 rr              LDA   eval_val_lo
0015D2r 2  85 rr              STA   ptr_lo
0015D4r 2  A5 rr              LDA   eval_val_hi
0015D6r 2  85 rr              STA   ptr_hi
0015D8r 2  A0 00              LDY   #0
0015DAr 2  B1 rr              LDA   (ptr_lo),Y           ; length
0015DCr 2  F0 0F              BEQ   @err_empty            ; empty word
0015DEr 2  A0 01              LDY   #1
0015E0r 2  B1 rr              LDA   (ptr_lo),Y           ; first character
0015E2r 2  85 rr              STA   eval_val_lo
0015E4r 2  64 rr              STZ   eval_val_hi
0015E6r 2  64 rr              STZ   eval_val_frac
0015E8r 2  64 rr              STZ   eval_type             ; VAL_NUMBER
0015EAr 2  4C rr rr           JMP   eval_continue
0015EDr 2               @err_type:
0015EDr 2               @err_empty:
0015EDr 2               @err:
0015EDr 2  A2 rr              LDX   #<str_ascii_name
0015EFr 2  A0 rr              LDY   #>str_ascii_name
0015F1r 2  4C rr rr           JMP   err_nei
0015F4r 2               
0015F4r 2               ; =====================================================================
0015F4r 2               ; Math functions and type predicates
0015F4r 2               ; =====================================================================
0015F4r 2               
0015F4r 2               ; ---------------------------------------------------------------------
0015F4r 2               ; return_number — set eval_val from eval_val_lo/hi, clear frac+type
0015F4r 2               ;   Entry: eval_val_lo/hi already set
0015F4r 2               ;   Jumps to eval_continue
0015F4r 2               ; ---------------------------------------------------------------------
0015F4r 2               return_number:
0015F4r 2  64 rr              STZ   eval_val_frac
0015F6r 2  64 rr              STZ   eval_type
0015F8r 2  4C rr rr           JMP   eval_continue
0015FBr 2               
0015FBr 2               ; ---------------------------------------------------------------------
0015FBr 2               ; return_signed_byte — sign-extend A into eval_val as 16.8 number
0015FBr 2               ;   Entry: A = signed byte (-128..+127)
0015FBr 2               ;   Jumps to eval_continue
0015FBr 2               ; ---------------------------------------------------------------------
0015FBr 2               return_signed_byte:
0015FBr 2  85 rr              STA   eval_val_lo
0015FDr 2  10 04              BPL   @pos
0015FFr 2  A9 FF              LDA   #$FF
001601r 2  80 02              BRA   @set
001603r 2  A9 00        @pos: LDA   #$00
001605r 2  85 rr        @set: STA   eval_val_hi
001607r 2  80 EB              BRA   return_number
001609r 2               
001609r 2               ; ---------------------------------------------------------------------
001609r 2               ; predicate_result — set eval_val to 1 (Z set) or 0 (Z clear)
001609r 2               ;   Entry: Z flag from CMP
001609r 2               ;   Jumps to eval_continue
001609r 2               ; ---------------------------------------------------------------------
001609r 2               predicate_result:
001609r 2  F0 04              BEQ   @true
00160Br 2  64 rr              STZ   eval_val_lo
00160Dr 2  80 04              BRA   @done
00160Fr 2               @true:
00160Fr 2  A9 01              LDA   #1
001611r 2  85 rr              STA   eval_val_lo
001613r 2               @done:
001613r 2  64 rr              STZ   eval_val_hi
001615r 2  80 DD              BRA   return_number
001617r 2               
001617r 2               ; ---------------------------------------------------------------------
001617r 2               ; degrees_to_u8 — convert eval_val (degrees 0-360) to u8 angle (0-255)
001617r 2               ;   Uses MUL16 coprocessor: angle = degrees * 91 / 128
001617r 2               ;   Actually: write degrees to MUL16 A, 91 to B, read RES1 (high byte)
001617r 2               ;   Then shift right once (divide by 2) since 91/256=0.355, we want 91/128
001617r 2               ;   Wait, let me recalculate: degrees * 91 >> 7
001617r 2               ;   MUL16 gives degrees*91 in RES1:RES0. We want bits [14:7] of that.
001617r 2               ;   RES1 is bits [15:8]. But we want >>7 which is RES1<<1 | RES0>>7.
001617r 2               ;   Simpler: degrees * 182 / 256 = RES1 of (degrees * 182). Let's use 182.
001617r 2               ;   Output: A = u8 angle
001617r 2               ;   Clobbers: uses math coprocessor regs
001617r 2               ; ---------------------------------------------------------------------
001617r 2               degrees_to_u8:
001617r 2  A5 rr              LDA   eval_val_lo
001619r 2  8D 20 BB           STA   MATH_MUL16_A_LO
00161Cr 2  A5 rr              LDA   eval_val_hi
00161Er 2  8D 21 BB           STA   MATH_MUL16_A_HI
001621r 2  A9 B6              LDA   #182
001623r 2  8D 22 BB           STA   MATH_MUL16_B_LO
001626r 2  9C 23 BB           STZ   MATH_MUL16_B_HI       ; trigger multiply
001629r 2  AD 39 BB           LDA   MATH_RES1              ; high byte = degrees * 182 / 256
00162Cr 2  60                 RTS
00162Dr 2               
00162Dr 2               ; ---------------------------------------------------------------------
00162Dr 2               ; do_sin — SIN degrees: return sin as signed byte (-128..+127)
00162Dr 2               ; ---------------------------------------------------------------------
00162Dr 2               do_sin:
00162Dr 2  20 rr rr           JSR   eval_expr
001630r 2  B0 0C              BCS   @err
001632r 2  20 rr rr           JSR   degrees_to_u8
001635r 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
001638r 2  AD 38 BB           LDA   MATH_RES0              ; sin result (signed 1.7)
00163Br 2  4C rr rr           JMP   return_signed_byte
00163Er 2               @err:
00163Er 2  38                 SEC
00163Fr 2  60                 RTS
001640r 2               
001640r 2               ; ---------------------------------------------------------------------
001640r 2               ; do_cos — COS degrees: return cos as signed byte (-128..+127)
001640r 2               ; ---------------------------------------------------------------------
001640r 2               do_cos:
001640r 2  20 rr rr           JSR   eval_expr
001643r 2  B0 0C              BCS   @err
001645r 2  20 rr rr           JSR   degrees_to_u8
001648r 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
00164Br 2  AD 39 BB           LDA   MATH_RES1              ; cos result (signed 1.7)
00164Er 2  4C rr rr           JMP   return_signed_byte
001651r 2               @err:
001651r 2  38                 SEC
001652r 2  60                 RTS
001653r 2               
001653r 2               ; ---------------------------------------------------------------------
001653r 2               ; do_abs — ABS n: return absolute value
001653r 2               ; ---------------------------------------------------------------------
001653r 2               do_abs:
001653r 2  20 rr rr           JSR   eval_expr
001656r 2  B0 22              BCS   @err
001658r 2  A5 rr              LDA   eval_val_hi
00165Ar 2  10 19              BPL   @done                  ; already positive
00165Cr 2                     ; Negate 24-bit value
00165Cr 2  A5 rr              LDA   eval_val_frac
00165Er 2  49 FF              EOR   #$FF
001660r 2  18                 CLC
001661r 2  69 01              ADC   #1
001663r 2  85 rr              STA   eval_val_frac
001665r 2  A5 rr              LDA   eval_val_lo
001667r 2  49 FF              EOR   #$FF
001669r 2  69 00              ADC   #0
00166Br 2  85 rr              STA   eval_val_lo
00166Dr 2  A5 rr              LDA   eval_val_hi
00166Fr 2  49 FF              EOR   #$FF
001671r 2  69 00              ADC   #0
001673r 2  85 rr              STA   eval_val_hi
001675r 2               @done:
001675r 2  64 rr              STZ   eval_type
001677r 2  4C rr rr           JMP   eval_continue
00167Ar 2               @err:
00167Ar 2  38                 SEC
00167Br 2  60                 RTS
00167Cr 2               
00167Cr 2               ; ---------------------------------------------------------------------
00167Cr 2               ; do_int — INT n: truncate fractional part
00167Cr 2               ; ---------------------------------------------------------------------
00167Cr 2               do_int:
00167Cr 2  20 rr rr           JSR   eval_expr
00167Fr 2  B0 07              BCS   @err
001681r 2  64 rr              STZ   eval_val_frac
001683r 2  64 rr              STZ   eval_type
001685r 2  4C rr rr           JMP   eval_continue
001688r 2               @err:
001688r 2  38                 SEC
001689r 2  60                 RTS
00168Ar 2               
00168Ar 2               ; ---------------------------------------------------------------------
00168Ar 2               ; do_round — ROUND n: round to nearest integer
00168Ar 2               ; ---------------------------------------------------------------------
00168Ar 2               do_round:
00168Ar 2  20 rr rr           JSR   eval_expr
00168Dr 2  B0 19              BCS   @err
00168Fr 2  A5 rr              LDA   eval_val_frac
001691r 2  C9 80              CMP   #128
001693r 2  90 0C              BCC   @trunc
001695r 2                     ; Round up: increment integer part
001695r 2  A5 rr              LDA   eval_val_hi
001697r 2  10 02              BPL   @pos_round
001699r 2                     ; Negative: actually round toward zero = truncate
001699r 2  80 06              BRA   @trunc
00169Br 2               @pos_round:
00169Br 2  E6 rr              INC   eval_val_lo
00169Dr 2  D0 02              BNE   @trunc
00169Fr 2  E6 rr              INC   eval_val_hi
0016A1r 2               @trunc:
0016A1r 2  64 rr              STZ   eval_val_frac
0016A3r 2  64 rr              STZ   eval_type
0016A5r 2  4C rr rr           JMP   eval_continue
0016A8r 2               @err:
0016A8r 2  38                 SEC
0016A9r 2  60                 RTS
0016AAr 2               
0016AAr 2               ; ---------------------------------------------------------------------
0016AAr 2               ; do_random — RANDOM n: return random number 0..n-1
0016AAr 2               ;   Uses math coprocessor RNG + MUL16 to scale
0016AAr 2               ; ---------------------------------------------------------------------
0016AAr 2               do_random:
0016AAr 2  20 rr rr           JSR   eval_expr
0016ADr 2  B0 1D              BCS   @err
0016AFr 2                     ; RNG byte * n / 256 gives 0..n-1
0016AFr 2  AD 37 BB           LDA   MATH_RNG
0016B2r 2  8D 20 BB           STA   MATH_MUL16_A_LO
0016B5r 2  9C 21 BB           STZ   MATH_MUL16_A_HI
0016B8r 2  A5 rr              LDA   eval_val_lo
0016BAr 2  8D 22 BB           STA   MATH_MUL16_B_LO
0016BDr 2  A5 rr              LDA   eval_val_hi
0016BFr 2  8D 23 BB           STA   MATH_MUL16_B_HI       ; trigger
0016C2r 2  AD 39 BB           LDA   MATH_RES1              ; high byte of (rng * n) = rng*n/256
0016C5r 2  85 rr              STA   eval_val_lo
0016C7r 2  64 rr              STZ   eval_val_hi
0016C9r 2  4C rr rr           JMP   return_number
0016CCr 2               @err:
0016CCr 2  38                 SEC
0016CDr 2  60                 RTS
0016CEr 2               
0016CEr 2               ; ---------------------------------------------------------------------
0016CEr 2               ; do_sqrt — SQRT n: approximate sqrt via DIST_APPROX(n, 0)
0016CEr 2               ; ---------------------------------------------------------------------
0016CEr 2               do_sqrt:
0016CEr 2  20 rr rr           JSR   eval_expr
0016D1r 2  B0 1D              BCS   @err
0016D3r 2  A5 rr              LDA   eval_val_lo
0016D5r 2  8D 33 BB           STA   MATH_DIST_DX_LO
0016D8r 2  A5 rr              LDA   eval_val_hi
0016DAr 2  8D 34 BB           STA   MATH_DIST_DX_HI
0016DDr 2  9C 35 BB           STZ   MATH_DIST_DY_LO
0016E0r 2  9C 36 BB           STZ   MATH_DIST_DY_HI       ; trigger (write to DY_HI triggers)
0016E3r 2  AD 38 BB           LDA   MATH_RES0
0016E6r 2  85 rr              STA   eval_val_lo
0016E8r 2  AD 39 BB           LDA   MATH_RES1
0016EBr 2  85 rr              STA   eval_val_hi
0016EDr 2  4C rr rr           JMP   return_number
0016F0r 2               @err:
0016F0r 2  38                 SEC
0016F1r 2  60                 RTS
0016F2r 2               
0016F2r 2               ; ---------------------------------------------------------------------
0016F2r 2               ; do_remainder — REMAINDER a b: return a mod b via DIV coprocessor
0016F2r 2               ; ---------------------------------------------------------------------
0016F2r 2               do_remainder:
0016F2r 2  20 rr rr           JSR   eval_expr              ; first arg (a)
0016F5r 2  B0 49              BCS   @err
0016F7r 2  A5 rr              LDA   eval_val_lo
0016F9r 2  48                 PHA
0016FAr 2  A5 rr              LDA   eval_val_hi
0016FCr 2  48                 PHA
0016FDr 2  20 rr rr           JSR   eval_expr              ; second arg (b)
001700r 2  B0 3C              BCS   @err_pop
001702r 2                     ; b in eval_val, a on stack
001702r 2                     ; Check divide by zero
001702r 2  A5 rr              LDA   eval_val_lo
001704r 2  05 rr              ORA   eval_val_hi
001706r 2  F0 2D              BEQ   @zero_pop
001708r 2                     ; Set up 32÷16 division: dividend=a, divisor=b
001708r 2  68                 PLA
001709r 2  8D 29 BB           STA   MATH_DIV_N_1           ; a_hi
00170Cr 2  AA                 TAX                          ; save for sign-extend
00170Dr 2  68                 PLA
00170Er 2  8D 28 BB           STA   MATH_DIV_N_LO          ; a_lo
001711r 2                     ; Sign-extend a
001711r 2  8A                 TXA
001712r 2  09 7F              ORA   #$7F
001714r 2  30 02              BMI   @neg_a
001716r 2  A9 00              LDA   #$00
001718r 2               @neg_a:                            ; A=$FF if negative
001718r 2  8D 2A BB           STA   MATH_DIV_N_2
00171Br 2  8D 2B BB           STA   MATH_DIV_N_HI
00171Er 2  A5 rr              LDA   eval_val_lo
001720r 2  8D 2C BB           STA   MATH_DIV_D_LO
001723r 2  A5 rr              LDA   eval_val_hi
001725r 2  8D 2D BB           STA   MATH_DIV_D_HI          ; trigger
001728r 2                     ; Remainder is in RES2:RES3 (actually check what the copro returns)
001728r 2                     ; The math copro returns quotient in RES0:RES1, remainder in RES2:RES3
001728r 2  AD 3A BB           LDA   MATH_RES2
00172Br 2  85 rr              STA   eval_val_lo
00172Dr 2  AD 3B BB           LDA   MATH_RES3
001730r 2  85 rr              STA   eval_val_hi
001732r 2  4C rr rr           JMP   return_number
001735r 2               @zero_pop:
001735r 2  68                 PLA
001736r 2  68                 PLA
001737r 2  64 rr              STZ   eval_val_lo
001739r 2  64 rr              STZ   eval_val_hi
00173Br 2  4C rr rr           JMP   return_number
00173Er 2               @err_pop:
00173Er 2  68                 PLA
00173Fr 2  68                 PLA
001740r 2               @err:
001740r 2  38                 SEC
001741r 2  60                 RTS
001742r 2               
001742r 2               ; ---------------------------------------------------------------------
001742r 2               ; do_not — NOT expr: return 1 if expr is 0, else 0
001742r 2               ; ---------------------------------------------------------------------
001742r 2               do_not:
001742r 2  20 rr rr           JSR   eval_expr
001745r 2  B0 13              BCS   @err
001747r 2  A5 rr              LDA   eval_val_lo
001749r 2  05 rr              ORA   eval_val_hi
00174Br 2                     ; If zero, set result to 1. If nonzero, set to 0.
00174Br 2  D0 06              BNE   @false
00174Dr 2  A9 01              LDA   #1
00174Fr 2  85 rr              STA   eval_val_lo
001751r 2  80 02              BRA   @done
001753r 2               @false:
001753r 2  64 rr              STZ   eval_val_lo
001755r 2               @done:
001755r 2  64 rr              STZ   eval_val_hi
001757r 2  4C rr rr           JMP   return_number
00175Ar 2               @err:
00175Ar 2  38                 SEC
00175Br 2  60                 RTS
00175Cr 2               
00175Cr 2               ; ---------------------------------------------------------------------
00175Cr 2               ; do_and — AND a b: return 1 if both nonzero, else 0
00175Cr 2               ; ---------------------------------------------------------------------
00175Cr 2               do_and:
00175Cr 2  20 rr rr           JSR   eval_expr
00175Fr 2  B0 1E              BCS   @err
001761r 2  A5 rr              LDA   eval_val_lo
001763r 2  05 rr              ORA   eval_val_hi
001765r 2  F0 11              BEQ   @false                 ; first arg is 0 → short-circuit
001767r 2  20 rr rr           JSR   eval_expr
00176Ar 2  B0 13              BCS   @err
00176Cr 2  A5 rr              LDA   eval_val_lo
00176Er 2  05 rr              ORA   eval_val_hi
001770r 2  F0 06              BEQ   @false
001772r 2  A9 01              LDA   #1
001774r 2  85 rr              STA   eval_val_lo
001776r 2  80 02              BRA   @done
001778r 2               @false:
001778r 2  64 rr              STZ   eval_val_lo
00177Ar 2               @done:
00177Ar 2  64 rr              STZ   eval_val_hi
00177Cr 2  4C rr rr           JMP   return_number
00177Fr 2               @err:
00177Fr 2  38                 SEC
001780r 2  60                 RTS
001781r 2               
001781r 2               ; ---------------------------------------------------------------------
001781r 2               ; do_or — OR a b: return 1 if either nonzero, else 0
001781r 2               ; ---------------------------------------------------------------------
001781r 2               do_or:
001781r 2  20 rr rr           JSR   eval_expr
001784r 2  B0 1E              BCS   @err
001786r 2  A5 rr              LDA   eval_val_lo
001788r 2  05 rr              ORA   eval_val_hi
00178Ar 2  D0 0F              BNE   @true                  ; first arg nonzero → short-circuit
00178Cr 2  20 rr rr           JSR   eval_expr
00178Fr 2  B0 13              BCS   @err
001791r 2  A5 rr              LDA   eval_val_lo
001793r 2  05 rr              ORA   eval_val_hi
001795r 2  D0 04              BNE   @true
001797r 2  64 rr              STZ   eval_val_lo
001799r 2  80 04              BRA   @done
00179Br 2               @true:
00179Br 2  A9 01              LDA   #1
00179Dr 2  85 rr              STA   eval_val_lo
00179Fr 2               @done:
00179Fr 2  64 rr              STZ   eval_val_hi
0017A1r 2  4C rr rr           JMP   return_number
0017A4r 2               @err:
0017A4r 2  38                 SEC
0017A5r 2  60                 RTS
0017A6r 2               
