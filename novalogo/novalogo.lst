000000r 2               
000000r 2               ; Host RNG result byte aliases. FIO.CMD_RNG returns little-endian bytes here.
000000r 2               ; @label FIO.RNG0
000000r 2               ; @kind u8
000000r 2               ; @symbol FIO_RNG0
000000r 2               ; @summary Low byte returned by FIO.CMD_RNG.
000000r 2               .ifndef FIO_RNG0
000000r 2               FIO_RNG0         = FIO_SRCL
000000r 2               .endif
000000r 2               ; @label FIO.RNG1
000000r 2               ; @kind u8
000000r 2               ; @symbol FIO_RNG1
000000r 2               ; @summary Second byte returned by FIO.CMD_RNG.
000000r 2               .ifndef FIO_RNG1
000000r 2               FIO_RNG1         = FIO_SRCH
000000r 2               .endif
000000r 2               ; @label FIO.RNG2
000000r 2               ; @kind u8
000000r 2               ; @symbol FIO_RNG2
000000r 2               ; @summary Third byte returned by FIO.CMD_RNG.
000000r 2               .ifndef FIO_RNG2
000000r 2               FIO_RNG2         = FIO_ENDL
