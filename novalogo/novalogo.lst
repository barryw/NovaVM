002444r 2               ; ---------------------------------------------------------------------
002444r 2               ; render_number_to_buf — render eval_val as decimal into input_buf
002444r 2               ;   Entry: eval_val_hi/lo/frac = number value
002444r 2               ;          buf_idx = current write position
002444r 2               ;   Exit:  buf_idx updated
002444r 2               ;   Clobbers: A, X, Y, num_val, num_tmp, pn_buf
002444r 2               ; ---------------------------------------------------------------------
002444r 2               render_number_to_buf:
002444r 2                     ; Handle sign
002444r 2  A5 rr              LDA   eval_val_hi
002446r 2  10 22              BPL   @rn_positive
002448r 2                     ; Write '-'
002448r 2  A4 rr              LDY   z:buf_idx
00244Ar 2  A9 2D              LDA   #'-'
00244Cr 2  99 rr rr           STA   input_buf,Y
00244Fr 2  E6 rr              INC   z:buf_idx
002451r 2                     ; Negate
002451r 2  A5 rr              LDA   eval_val_frac
002453r 2  49 FF              EOR   #$FF
002455r 2  18                 CLC
002456r 2  69 01              ADC   #1
002458r 2  85 rr              STA   eval_val_frac
00245Ar 2  A5 rr              LDA   eval_val_lo
00245Cr 2  49 FF              EOR   #$FF
00245Er 2  69 00              ADC   #0
002460r 2  85 rr              STA   eval_val_lo
002462r 2  A5 rr              LDA   eval_val_hi
002464r 2  49 FF              EOR   #$FF
002466r 2  69 00              ADC   #0
002468r 2  85 rr              STA   eval_val_hi
00246Ar 2               
00246Ar 2               @rn_positive:
00246Ar 2                     ; Render integer part using power-of-10 subtraction
00246Ar 2  A5 rr              LDA   eval_val_lo
00246Cr 2  8D rr rr           STA   num_val_lo
00246Fr 2  A5 rr              LDA   eval_val_hi
002471r 2  8D rr rr           STA   num_val_hi
002474r 2               
002474r 2  A2 00              LDX   #0                     ; digit buffer index
002476r 2  A0 00              LDY   #0                     ; power-of-10 index
002478r 2               @rn_div:
002478r 2  9C rr rr           STZ   num_tmp_lo
00247Br 2               @rn_sub:
00247Br 2  38                 SEC
00247Cr 2  AD rr rr           LDA   num_val_lo
00247Fr 2  F9 rr rr           SBC   pow10_lo,Y
002482r 2  48                 PHA
002483r 2  AD rr rr           LDA   num_val_hi
002486r 2  F9 rr rr           SBC   pow10_hi,Y
002489r 2  90 0C              BCC   @rn_sub_done
00248Br 2  8D rr rr           STA   num_val_hi
00248Er 2  68                 PLA
00248Fr 2  8D rr rr           STA   num_val_lo
002492r 2  EE rr rr           INC   num_tmp_lo
002495r 2  80 E4              BRA   @rn_sub
002497r 2               @rn_sub_done:
002497r 2  68                 PLA
002498r 2  AD rr rr           LDA   num_tmp_lo
00249Br 2  9D rr rr           STA   pn_buf,X
00249Er 2  E8                 INX
00249Fr 2  C8                 INY
0024A0r 2  C0 05              CPY   #5
0024A2r 2  90 D4              BCC   @rn_div
0024A4r 2               
0024A4r 2                     ; Write digits suppressing leading zeros
0024A4r 2  A0 00              LDY   #0                     ; suppress flag
0024A6r 2  A2 00              LDX   #0
0024A8r 2               @rn_print:
0024A8r 2  BD rr rr           LDA   pn_buf,X
0024ABr 2  D0 04              BNE   @rn_nonzero
0024ADr 2  C0 00              CPY   #0
0024AFr 2  F0 0D              BEQ   @rn_skip
0024B1r 2               @rn_nonzero:
0024B1r 2  A0 01              LDY   #1
0024B3r 2  09 30              ORA   #'0'
0024B5r 2  DA                 PHX
0024B6r 2  A6 rr              LDX   z:buf_idx
0024B8r 2  9D rr rr           STA   input_buf,X
0024BBr 2  E6 rr              INC   z:buf_idx
0024BDr 2  FA                 PLX
0024BEr 2               @rn_skip:
0024BEr 2  E8                 INX
0024BFr 2  E0 04              CPX   #4
0024C1r 2  90 E5              BCC   @rn_print
0024C3r 2                     ; Always write ones digit
0024C3r 2  AD rr rr           LDA   pn_buf+4
0024C6r 2  09 30              ORA   #'0'
0024C8r 2  A6 rr              LDX   z:buf_idx
0024CAr 2  9D rr rr           STA   input_buf,X
0024CDr 2  E6 rr              INC   z:buf_idx
0024CFr 2               
0024CFr 2                     ; Fractional part
0024CFr 2  A5 rr              LDA   eval_val_frac
0024D1r 2  D0 01              BNE   @rn_has_frac
0024D3r 2  60                 RTS
0024D4r 2               @rn_has_frac:
0024D4r 2                     ; Write '.'
0024D4r 2  A6 rr              LDX   z:buf_idx
0024D6r 2  A9 2E              LDA   #'.'
0024D8r 2  9D rr rr           STA   input_buf,X
0024DBr 2  E6 rr              INC   z:buf_idx
0024DDr 2                     ; First frac digit
0024DDr 2  A5 rr              LDA   eval_val_frac
0024DFr 2  8D rr rr           STA   num_tmp_lo
0024E2r 2  9C rr rr           STZ   num_tmp_hi
0024E5r 2  AD rr rr           LDA   num_tmp_lo
0024E8r 2  0A                 ASL
0024E9r 2  8D rr rr           STA   num_val_lo
0024ECr 2  AD rr rr           LDA   num_tmp_hi
0024EFr 2  2A                 ROL
0024F0r 2  8D rr rr           STA   num_val_hi
0024F3r 2  0E rr rr           ASL   num_val_lo
0024F6r 2  2E rr rr           ROL   num_val_hi
0024F9r 2  0E rr rr           ASL   num_val_lo
0024FCr 2  2E rr rr           ROL   num_val_hi
0024FFr 2  18                 CLC
002500r 2  AD rr rr           LDA   num_tmp_lo
002503r 2  0A                 ASL
002504r 2  6D rr rr           ADC   num_val_lo
002507r 2  8D rr rr           STA   num_val_lo
00250Ar 2  AD rr rr           LDA   num_tmp_hi
00250Dr 2  2A                 ROL
00250Er 2  6D rr rr           ADC   num_val_hi
002511r 2  8D rr rr           STA   num_val_hi
002514r 2                     ; High byte = digit
002514r 2  AD rr rr           LDA   num_val_hi
002517r 2  09 30              ORA   #'0'
002519r 2  A6 rr              LDX   z:buf_idx
00251Br 2  9D rr rr           STA   input_buf,X
00251Er 2  E6 rr              INC   z:buf_idx
002520r 2                     ; Second frac digit
002520r 2  AD rr rr           LDA   num_val_lo
002523r 2  8D rr rr           STA   num_tmp_lo
002526r 2  9C rr rr           STZ   num_tmp_hi
002529r 2  AD rr rr           LDA   num_tmp_lo
00252Cr 2  0A                 ASL
00252Dr 2  8D rr rr           STA   num_val_lo
002530r 2  AD rr rr           LDA   num_tmp_hi
002533r 2  2A                 ROL
002534r 2  8D rr rr           STA   num_val_hi
002537r 2  0E rr rr           ASL   num_val_lo
00253Ar 2  2E rr rr           ROL   num_val_hi
00253Dr 2  0E rr rr           ASL   num_val_lo
002540r 2  2E rr rr           ROL   num_val_hi
002543r 2  18                 CLC
002544r 2  AD rr rr           LDA   num_tmp_lo
002547r 2  0A                 ASL
002548r 2  6D rr rr           ADC   num_val_lo
00254Br 2  8D rr rr           STA   num_val_lo
00254Er 2  AD rr rr           LDA   num_tmp_hi
002551r 2  2A                 ROL
002552r 2  6D rr rr           ADC   num_val_hi
002555r 2  8D rr rr           STA   num_val_hi
002558r 2  AD rr rr           LDA   num_val_hi
00255Br 2  F0 09              BEQ   @rn_done                ; skip trailing zero
00255Dr 2  09 30              ORA   #'0'
00255Fr 2  A6 rr              LDX   z:buf_idx
002561r 2  9D rr rr           STA   input_buf,X
002564r 2  E6 rr              INC   z:buf_idx
002566r 2               @rn_done:
002566r 2  60                 RTS
