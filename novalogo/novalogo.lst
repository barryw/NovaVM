001410r 2  A6 rr              LDX   z:buf_idx
001412r 2  E0 7E              CPX   #126
001414r 2  B0 E1              BCS   @rw_poll             ; buffer full
001416r 2  9D rr rr           STA   input_buf,X
001419r 2  8D 0E A0           STA   VGC_CHAROUT
