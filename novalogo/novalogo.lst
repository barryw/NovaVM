000261r 2  C8                 INY
000262r 2  91 rr              STA   (ptr_lo),Y
000264r 2  68                 PLA
000265r 2  48                 PHA
000266r 2  A0 03              LDY   #TOK_PAYLOAD
000268r 2  91 rr              STA   (ptr_lo),Y
00026Ar 2                     ; Copy characters — no uppercasing for quotes
