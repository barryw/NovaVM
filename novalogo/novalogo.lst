00314Dr 2               ; do_erase — ERASE "name: remove procedure from directory
00314Dr 2               ;   Arity 0 — evaluates its own argument
00314Dr 2               ; ---------------------------------------------------------------------
00314Dr 2               do_erase:
00314Dr 2  20 rr rr           JSR   eval_expr
003150r 2  90 03              BCC   @er_type_ok
003152r 2  4C rr rr           JMP   @err
003155r 2               @er_type_ok:
003155r 2  A5 rr              LDA   eval_type
003157r 2  C9 01              CMP   #VAL_WORD
003159r 2  F0 03              BEQ   @er_word_ok
00315Br 2  4C rr rr           JMP   @err
00315Er 2               @er_word_ok:
00315Er 2               
00315Er 2                     ; Save name pointer
00315Er 2  A5 rr              LDA   eval_val_lo
003160r 2  85 rr              STA   var_name_lo
003162r 2  A5 rr              LDA   eval_val_hi
003164r 2  85 rr              STA   var_name_hi
003166r 2               
003166r 2                     ; Walk proc_head with prev tracking
003166r 2                     ; prev = address of "next" pointer to patch (starts as &proc_head)
003166r 2  A9 rr              LDA   #<proc_head_lo
003168r 2  85 rr              STA   proc_ptr_lo             ; prev_ptr_lo
00316Ar 2  A9 rr              LDA   #>proc_head_lo
00316Cr 2  85 rr              STA   proc_ptr_hi             ; prev_ptr_hi (ZP, so high byte = 0)
00316Er 2               
00316Er 2  A5 rr              LDA   proc_head_lo
003170r 2  85 rr              STA   proc_entry_lo
003172r 2  A5 rr              LDA   proc_head_hi
003174r 2  85 rr              STA   proc_entry_hi
003176r 2               
003176r 2               @walk:
003176r 2  A5 rr              LDA   proc_entry_lo
003178r 2  05 rr              ORA   proc_entry_hi
00317Ar 2  D0 03              BNE   @walk_ok
00317Cr 2  4C rr rr           JMP   @not_found
00317Fr 2               @walk_ok:
00317Fr 2               
00317Fr 2                     ; Compare name
00317Fr 2  A5 rr              LDA   var_name_lo
003181r 2  85 rr              STA   ptr_lo
003183r 2  A5 rr              LDA   var_name_hi
003185r 2  85 rr              STA   ptr_hi
003187r 2  A0 00              LDY   #0
003189r 2  B1 rr              LDA   (ptr_lo),Y             ; search name len
00318Br 2  85 rr              STA   proc_name_len
00318Dr 2               
00318Dr 2  A5 rr              LDA   proc_entry_lo
00318Fr 2  85 rr              STA   ptr_lo
