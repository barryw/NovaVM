001476r 2  A0 rr              LDY   #>str_oom
001478r 2  4C rr rr           JMP   list_print_err
00147Br 2               
00147Br 2               ; ---------------------------------------------------------------------
00147Br 2               ; do_readlist — READLIST: read a line, return as a list
00147Br 2               ;   Arity 0, no arguments. Reporter.
00147Br 2               ;   Calls read_line, tokenize_line, then walks tokens building a list.
00147Br 2               ; ---------------------------------------------------------------------
