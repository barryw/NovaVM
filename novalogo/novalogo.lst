001073r 2  85 rr              STA   ptr2_lo
001075r 2  A5 rr              LDA   catch_tag_hi
001077r 2  85 rr              STA   ptr2_hi
001079r 2  20 rr rr           JSR   catch_tags_equal
00107Cr 2  90 25              BCC   @no_catch
00107Er 2               
00107Er 2                     ; Match! Unwind stack to catch point.
00107Er 2  A6 rr              LDX   catch_sp
001080r 2  9A                 TXS
001081r 2               
001081r 2                     ; Restore previous catch frame from the restored stack
001081r 2  68                 PLA
001082r 2  85 rr              STA   catch_resume_hi
001084r 2  68                 PLA
001085r 2  85 rr              STA   catch_resume_lo
001087r 2  68                 PLA
001088r 2  85 rr              STA   catch_sp
00108Ar 2  68                 PLA
00108Br 2  85 rr              STA   catch_tag_hi
00108Dr 2  68                 PLA
00108Er 2  85 rr              STA   catch_tag_lo
001090r 2  68                 PLA
001091r 2  85 rr              STA   catch_active
001093r 2               
