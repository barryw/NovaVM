0013D7r 2  A9 01              LDA   #1
0013D9r 2  A0 00              LDY   #0
0013DBr 2  91 rr              STA   (ptr_lo),Y          ; store length = 1
0013DDr 2  A5 rr              LDA   ptr_lo
0013DFr 2  85 rr              STA   eval_val_lo
0013E1r 2  A5 rr              LDA   ptr_hi
0013E3r 2  85 rr              STA   eval_val_hi
