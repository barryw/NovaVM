002ECEr 2  85 rr              STA   var_name_hi
002ED0r 2               
002ED0r 2  A5 rr              LDA   proc_head_lo
002ED2r 2  85 rr              STA   proc_entry_lo
002ED4r 2  A5 rr              LDA   proc_head_hi
002ED6r 2  85 rr              STA   proc_entry_hi
