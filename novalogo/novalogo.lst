001349r 2                     ; --- Main loop ---
001349r 2               @wu_loop:
001349r 2  A5 rr              LDA   proc_stopped
00134Br 2  D0 38              BNE   @wu_done
00134Dr 2               
00134Dr 2                     ; Evaluate condition: set eval_cur to cond_start, run body
00134Dr 2  A5 rr              LDA   cond_start_lo
00134Fr 2  85 rr              STA   eval_cur_lo
001351r 2  A5 rr              LDA   cond_start_hi
001353r 2  85 rr              STA   eval_cur_hi
001355r 2  A9 01              LDA   #$01
001357r 2  85 rr              STA   eval_in_body
001359r 2               
001359r 2                     ; We need to evaluate an expression from the condition body.
001359r 2                     ; The condition block contains an expression, so use eval_expr.
001359r 2  20 rr rr           JSR   eval_expr
00135Cr 2  B0 27              BCS   @wu_done                ; eval error = stop
00135Er 2               
00135Er 2                     ; Check result: nonzero integer = true
00135Er 2  A5 rr              LDA   eval_val_lo
001360r 2  05 rr              ORA   eval_val_hi
001362r 2                     ; Result in A: nonzero = true condition
001362r 2               
001362r 2                     ; Read mode from stack to decide behavior
001362r 2                     ; Mode is at the bottom of our saved state block.
001362r 2                     ; Stack layout (top-down): eval_in_body, cond_start_hi/lo,
001362r 2                     ;   body_resume_hi/lo, body_start_hi/lo, mode
001362r 2                     ; That's 8 bytes deep from current SP.
001362r 2  BA                 TSX
001363r 2  BC 08 01           LDY   $0108,X                 ; mode: 0=WHILE, 1=UNTIL
001366r 2               
001366r 2  C0 00              CPY   #0
001368r 2  D0 06              BNE   @wu_until_check
00136Ar 2               
00136Ar 2                     ; WHILE: if condition is false (zero), stop
00136Ar 2  C9 00              CMP   #0                      ; A still has lo|hi result
00136Cr 2  F0 17              BEQ   @wu_done
00136Er 2  80 04              BRA   @wu_exec_body
001370r 2               
001370r 2               @wu_until_check:
001370r 2                     ; UNTIL: if condition is true (nonzero), stop
001370r 2  C9 00              CMP   #0
001372r 2  D0 11              BNE   @wu_done
001374r 2               
001374r 2               @wu_exec_body:
001374r 2                     ; Execute body
001374r 2  A5 rr              LDA   body_start_lo
