0030EDr 2  85 rr              STA   proc_body_len_lo
0030EFr 2  C8                 INY
0030F0r 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_hi
0030F2r 2  85 rr              STA   proc_body_len_hi
0030F4r 2  C8                 INY                           ; Y = offset to body text
0030F5r 2               
0030F5r 2                     ; Compute absolute pointer to body
0030F5r 2  84 rr              STY   proc_rec_off
0030F7r 2  18                 CLC
0030F8r 2  A5 rr              LDA   proc_entry_lo
0030FAr 2  65 rr              ADC   proc_rec_off
