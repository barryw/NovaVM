0013EEr 2                     ; A = character — fall through to alloc_one_char_word
0013EEr 2               
0013EEr 2               ; ---------------------------------------------------------------------
0013EEr 2               ; alloc_one_char_word — allocate a 1-char word on heap from A
0013EEr 2               ;   Input: A = character byte
