00213Dr 2  91 rr              STA   (ptr_lo),Y
00213Fr 2  BD 07 01           LDA   $0107,X                 ; first hi
002142r 2  A0 02              LDY   #CONS_CAR_HI
002144r 2  91 rr              STA   (ptr_lo),Y
002146r 2  BD 06 01           LDA   $0106,X                 ; first lo
002149r 2  A0 03              LDY   #CONS_CAR_LO
00214Br 2  91 rr              STA   (ptr_lo),Y
00214Dr 2  BD 05 01           LDA   $0105,X                 ; first frac
002150r 2  A0 04              LDY   #CONS_CAR_FRAC
002152r 2  91 rr              STA   (ptr_lo),Y
002154r 2  A0 05              LDY   #CONS_CDR_LO
002156r 2  A9 00              LDA   #0
002158r 2  91 rr              STA   (ptr_lo),Y
00215Ar 2  A0 06              LDY   #CONS_CDR_HI
00215Cr 2  91 rr              STA   (ptr_lo),Y
00215Er 2                     ; Update first value on stack to be VAL_LIST
00215Er 2  A9 02              LDA   #VAL_LIST
002160r 2  9D 08 01           STA   $0108,X                 ; type = list
002163r 2  A5 rr              LDA   ptr_hi
002165r 2  9D 07 01           STA   $0107,X                 ; hi = ptr_hi
002168r 2  A5 rr              LDA   ptr_lo
00216Ar 2  9D 06 01           STA   $0106,X                 ; lo = ptr_lo
00216Dr 2  A9 00              LDA   #0
00216Fr 2  9D 05 01           STA   $0105,X                 ; frac = 0
002172r 2               
002172r 2               @first_is_list:
002172r 2                     ; Process second arg: if not list, wrap it
002172r 2  BA                 TSX
002173r 2  BD 04 01           LDA   $0104,X                 ; second type
002176r 2  C9 02              CMP   #VAL_LIST
002178r 2  F0 4D              BEQ   @second_is_list
00217Ar 2               
00217Ar 2                     ; Wrap second value
00217Ar 2  A9 07              LDA   #CONS_SIZE
00217Cr 2  A2 02              LDX   #ATYPE_CONS
