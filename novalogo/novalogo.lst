001603r 2  D0 EA              BNE   @rl_wch
001605r 2               @rl_word_done:
001605r 2  A5 rr              LDA   ptr_lo
001607r 2  85 rr              STA   eval_val_lo
001609r 2  A5 rr              LDA   ptr_hi
00160Br 2  85 rr              STA   eval_val_hi
00160Dr 2  64 rr              STZ   eval_val_frac
00160Fr 2  A9 01              LDA   #VAL_WORD
001611r 2  85 rr              STA   eval_type
001613r 2  20 rr rr           JSR   eval_advance
001616r 2  4C rr rr           JMP   @rl_alloc_cell
001619r 2               
001619r 2               @rl_sublist:
001619r 2                     ; Use eval_list to build the sublist (advances past matching ])
001619r 2  20 rr rr           JSR   eval_advance
00161Cr 2  A5 rr              LDA   z:list_head_lo
00161Er 2  48                 PHA
00161Fr 2  A5 rr              LDA   z:list_head_hi
001621r 2  48                 PHA
001622r 2  A5 rr              LDA   z:list_tail_lo
001624r 2  48                 PHA
001625r 2  A5 rr              LDA   z:list_tail_hi
001627r 2  48                 PHA
001628r 2  20 rr rr           JSR   eval_list
00162Br 2  68                 PLA
00162Cr 2  85 rr              STA   z:list_tail_hi
00162Er 2  68                 PLA
00162Fr 2  85 rr              STA   z:list_tail_lo
001631r 2  68                 PLA
001632r 2  85 rr              STA   z:list_head_hi
001634r 2  68                 PLA
001635r 2  85 rr              STA   z:list_head_lo
001637r 2                     ; eval_type = VAL_LIST, eval_val = sublist head
001637r 2  4C rr rr           JMP   @rl_alloc_cell
00163Ar 2               
00163Ar 2               @rl_alloc_cell:
00163Ar 2  A9 07              LDA   #CONS_SIZE
00163Cr 2  A2 02              LDX   #ATYPE_CONS
00163Er 2  20 rr rr           JSR   heap_alloc
001641r 2  90 03              BCC   @rl_alloc_ok
001643r 2  4C rr rr           JMP   @rl_oom
001646r 2               @rl_alloc_ok:
001646r 2  A0 00              LDY   #CONS_TAG
001648r 2  A9 10              LDA   #CONS_PAIR
00164Ar 2  91 rr              STA   (ptr_lo),Y
00164Cr 2  A0 01              LDY   #CONS_CAR_TYPE
00164Er 2  A5 rr              LDA   eval_type
001650r 2  91 rr              STA   (ptr_lo),Y
001652r 2  A0 02              LDY   #CONS_CAR_HI
001654r 2  A5 rr              LDA   eval_val_hi
001656r 2  91 rr              STA   (ptr_lo),Y
001658r 2  A0 03              LDY   #CONS_CAR_LO
00165Ar 2  A5 rr              LDA   eval_val_lo
00165Cr 2  91 rr              STA   (ptr_lo),Y
00165Er 2  A0 04              LDY   #CONS_CAR_FRAC
001660r 2  A5 rr              LDA   eval_val_frac
001662r 2  91 rr              STA   (ptr_lo),Y
001664r 2  A0 05              LDY   #CONS_CDR_LO
001666r 2  A9 00              LDA   #0
001668r 2  91 rr              STA   (ptr_lo),Y
00166Ar 2  A0 06              LDY   #CONS_CDR_HI
00166Cr 2  91 rr              STA   (ptr_lo),Y
00166Er 2               
00166Er 2                     ; Link into list
00166Er 2  A5 rr              LDA   z:list_head_lo
001670r 2  05 rr              ORA   z:list_head_hi
001672r 2  D0 0F              BNE   @rl_link_tail
001674r 2  A5 rr              LDA   ptr_lo
001676r 2  85 rr              STA   z:list_head_lo
001678r 2  85 rr              STA   z:list_tail_lo
00167Ar 2  A5 rr              LDA   ptr_hi
00167Cr 2  85 rr              STA   z:list_head_hi
00167Er 2  85 rr              STA   z:list_tail_hi
001680r 2  4C rr rr           JMP   @rl_next
001683r 2               
001683r 2               @rl_link_tail:
001683r 2  A5 rr              LDA   z:list_tail_lo
001685r 2  85 rr              STA   ptr2_lo
001687r 2  A5 rr              LDA   z:list_tail_hi
001689r 2  85 rr              STA   ptr2_hi
00168Br 2  A0 05              LDY   #CONS_CDR_LO
00168Dr 2  A5 rr              LDA   ptr_lo
00168Fr 2  91 rr              STA   (ptr2_lo),Y
001691r 2  A0 06              LDY   #CONS_CDR_HI
001693r 2  A5 rr              LDA   ptr_hi
001695r 2  91 rr              STA   (ptr2_lo),Y
001697r 2  A5 rr              LDA   ptr_lo
001699r 2  85 rr              STA   z:list_tail_lo
00169Br 2  A5 rr              LDA   ptr_hi
00169Dr 2  85 rr              STA   z:list_tail_hi
00169Fr 2  4C rr rr           JMP   @rl_next
0016A2r 2               
0016A2r 2               @rl_build_done:
0016A2r 2                     ; Restore tokenizer state
0016A2r 2  68                 PLA
0016A3r 2  85 rr              STA   eval_cur_hi
0016A5r 2  68                 PLA
0016A6r 2  85 rr              STA   eval_cur_lo
0016A8r 2  68                 PLA
0016A9r 2  85 rr              STA   tok_tail_hi
0016ABr 2  68                 PLA
0016ACr 2  85 rr              STA   tok_tail_lo
0016AEr 2  68                 PLA
0016AFr 2  85 rr              STA   tok_head_hi
0016B1r 2  68                 PLA
0016B2r 2  85 rr              STA   tok_head_lo
0016B4r 2               
0016B4r 2                     ; Return the list
0016B4r 2  A9 02              LDA   #VAL_LIST
0016B6r 2  85 rr              STA   eval_type
0016B8r 2  A5 rr              LDA   z:list_head_lo
0016BAr 2  85 rr              STA   eval_val_lo
0016BCr 2  A5 rr              LDA   z:list_head_hi
0016BEr 2  85 rr              STA   eval_val_hi
0016C0r 2  64 rr              STZ   eval_val_frac
0016C2r 2  4C rr rr           JMP   eval_continue
0016C5r 2               
0016C5r 2               @rl_oom:
0016C5r 2                     ; Restore tokenizer state before error
0016C5r 2  68                 PLA
0016C6r 2  85 rr              STA   eval_cur_hi
0016C8r 2  68                 PLA
0016C9r 2  85 rr              STA   eval_cur_lo
0016CBr 2  68                 PLA
0016CCr 2  85 rr              STA   tok_tail_hi
0016CEr 2  68                 PLA
0016CFr 2  85 rr              STA   tok_tail_lo
0016D1r 2  68                 PLA
0016D2r 2  85 rr              STA   tok_head_hi
0016D4r 2  68                 PLA
0016D5r 2  85 rr              STA   tok_head_lo
0016D7r 2  A2 rr              LDX   #<str_oom
0016D9r 2  A0 rr              LDY   #>str_oom
0016DBr 2  4C rr rr           JMP   list_print_err
0016DEr 2               
0016DEr 2               ; ---------------------------------------------------------------------
0016DEr 2               ; do_char — CHAR n: convert ASCII code to 1-char word
0016DEr 2               ;   Arity 0: evaluates its own argument
0016DEr 2               ; ---------------------------------------------------------------------
0016DEr 2               do_char:
0016DEr 2  20 rr rr           JSR   eval_expr
0016E1r 2  B0 09              BCS   @err
0016E3r 2                     ; Must be a number
0016E3r 2  A5 rr              LDA   eval_type
0016E5r 2  D0 05              BNE   @err
0016E7r 2                     ; Low byte of number is the ASCII code
0016E7r 2  A5 rr              LDA   eval_val_lo
0016E9r 2  4C rr rr           JMP   alloc_one_char_word
0016ECr 2               @err:
0016ECr 2  A2 rr              LDX   #<str_char_name
0016EEr 2  A0 rr              LDY   #>str_char_name
0016F0r 2  4C rr rr           JMP   err_nei
0016F3r 2               
0016F3r 2               ; ---------------------------------------------------------------------
0016F3r 2               ; do_ascii — ASCII word: return ASCII code of first character
0016F3r 2               ;   Arity 0: evaluates its own argument
0016F3r 2               ; ---------------------------------------------------------------------
0016F3r 2               do_ascii:
0016F3r 2  20 rr rr           JSR   eval_expr
0016F6r 2  B0 23              BCS   @err
0016F8r 2                     ; Must be a word
0016F8r 2  A5 rr              LDA   eval_type
0016FAr 2  C9 01              CMP   #VAL_WORD
0016FCr 2  D0 1D              BNE   @err_type
0016FEr 2                     ; eval_val_lo/hi points at length-prefixed string
0016FEr 2  A5 rr              LDA   eval_val_lo
001700r 2  85 rr              STA   ptr_lo
001702r 2  A5 rr              LDA   eval_val_hi
001704r 2  85 rr              STA   ptr_hi
001706r 2  A0 00              LDY   #0
001708r 2  B1 rr              LDA   (ptr_lo),Y           ; length
00170Ar 2  F0 0F              BEQ   @err_empty            ; empty word
00170Cr 2  A0 01              LDY   #1
00170Er 2  B1 rr              LDA   (ptr_lo),Y           ; first character
001710r 2  85 rr              STA   eval_val_lo
001712r 2  64 rr              STZ   eval_val_hi
001714r 2  64 rr              STZ   eval_val_frac
001716r 2  64 rr              STZ   eval_type             ; VAL_NUMBER
001718r 2  4C rr rr           JMP   eval_continue
00171Br 2               @err_type:
00171Br 2               @err_empty:
00171Br 2               @err:
00171Br 2  A2 rr              LDX   #<str_ascii_name
00171Dr 2  A0 rr              LDY   #>str_ascii_name
00171Fr 2  4C rr rr           JMP   err_nei
001722r 2               
001722r 2               ; =====================================================================
001722r 2               ; Math functions and type predicates
001722r 2               ; =====================================================================
001722r 2               
001722r 2               ; ---------------------------------------------------------------------
001722r 2               ; return_number — set eval_val from eval_val_lo/hi, clear frac+type
001722r 2               ;   Entry: eval_val_lo/hi already set
001722r 2               ;   Jumps to eval_continue
001722r 2               ; ---------------------------------------------------------------------
001722r 2               return_number:
001722r 2  64 rr              STZ   eval_val_frac
001724r 2  64 rr              STZ   eval_type
001726r 2  4C rr rr           JMP   eval_continue
001729r 2               
001729r 2               ; ---------------------------------------------------------------------
001729r 2               ; return_signed_byte — sign-extend A into eval_val as 16.8 number
001729r 2               ;   Entry: A = signed byte (-128..+127)
001729r 2               ;   Jumps to eval_continue
001729r 2               ; ---------------------------------------------------------------------
001729r 2               return_signed_byte:
001729r 2  85 rr              STA   eval_val_lo
00172Br 2  10 04              BPL   @pos
00172Dr 2  A9 FF              LDA   #$FF
00172Fr 2  80 02              BRA   @set
001731r 2  A9 00        @pos: LDA   #$00
001733r 2  85 rr        @set: STA   eval_val_hi
001735r 2  80 EB              BRA   return_number
001737r 2               
001737r 2               ; ---------------------------------------------------------------------
001737r 2               ; predicate_result — set eval_val to 1 (Z set) or 0 (Z clear)
001737r 2               ;   Entry: Z flag from CMP
001737r 2               ;   Jumps to eval_continue
001737r 2               ; ---------------------------------------------------------------------
001737r 2               predicate_result:
001737r 2  F0 04              BEQ   @true
001739r 2  64 rr              STZ   eval_val_lo
00173Br 2  80 04              BRA   @done
00173Dr 2               @true:
00173Dr 2  A9 01              LDA   #1
00173Fr 2  85 rr              STA   eval_val_lo
001741r 2               @done:
001741r 2  64 rr              STZ   eval_val_hi
001743r 2  80 DD              BRA   return_number
001745r 2               
001745r 2               ; ---------------------------------------------------------------------
001745r 2               ; degrees_to_u8 — convert eval_val (degrees 0-360) to u8 angle (0-255)
001745r 2               ;   Uses MUL16 coprocessor: angle = degrees * 91 / 128
001745r 2               ;   Actually: write degrees to MUL16 A, 91 to B, read RES1 (high byte)
001745r 2               ;   Then shift right once (divide by 2) since 91/256=0.355, we want 91/128
001745r 2               ;   Wait, let me recalculate: degrees * 91 >> 7
001745r 2               ;   MUL16 gives degrees*91 in RES1:RES0. We want bits [14:7] of that.
001745r 2               ;   RES1 is bits [15:8]. But we want >>7 which is RES1<<1 | RES0>>7.
001745r 2               ;   Simpler: degrees * 182 / 256 = RES1 of (degrees * 182). Let's use 182.
001745r 2               ;   Output: A = u8 angle
001745r 2               ;   Clobbers: uses math coprocessor regs
001745r 2               ; ---------------------------------------------------------------------
001745r 2               degrees_to_u8:
001745r 2  A5 rr              LDA   eval_val_lo
001747r 2  8D 20 BB           STA   MATH_MUL16_A_LO
00174Ar 2  A5 rr              LDA   eval_val_hi
00174Cr 2  8D 21 BB           STA   MATH_MUL16_A_HI
00174Fr 2  A9 B6              LDA   #182
001751r 2  8D 22 BB           STA   MATH_MUL16_B_LO
001754r 2  9C 23 BB           STZ   MATH_MUL16_B_HI       ; trigger multiply
001757r 2  AD 39 BB           LDA   MATH_RES1              ; high byte = degrees * 182 / 256
00175Ar 2  60                 RTS
00175Br 2               
00175Br 2               ; ---------------------------------------------------------------------
00175Br 2               ; do_sin — SIN degrees: return sin as signed byte (-128..+127)
00175Br 2               ; ---------------------------------------------------------------------
00175Br 2               do_sin:
00175Br 2  20 rr rr           JSR   eval_expr
00175Er 2  B0 0C              BCS   @err
001760r 2  20 rr rr           JSR   degrees_to_u8
001763r 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
001766r 2  AD 38 BB           LDA   MATH_RES0              ; sin result (signed 1.7)
001769r 2  4C rr rr           JMP   return_signed_byte
00176Cr 2               @err:
00176Cr 2  38                 SEC
00176Dr 2  60                 RTS
00176Er 2               
00176Er 2               ; ---------------------------------------------------------------------
00176Er 2               ; do_cos — COS degrees: return cos as signed byte (-128..+127)
00176Er 2               ; ---------------------------------------------------------------------
00176Er 2               do_cos:
00176Er 2  20 rr rr           JSR   eval_expr
001771r 2  B0 0C              BCS   @err
001773r 2  20 rr rr           JSR   degrees_to_u8
001776r 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
001779r 2  AD 39 BB           LDA   MATH_RES1              ; cos result (signed 1.7)
00177Cr 2  4C rr rr           JMP   return_signed_byte
00177Fr 2               @err:
00177Fr 2  38                 SEC
001780r 2  60                 RTS
001781r 2               
001781r 2               ; ---------------------------------------------------------------------
001781r 2               ; do_abs — ABS n: return absolute value
001781r 2               ; ---------------------------------------------------------------------
001781r 2               do_abs:
001781r 2  20 rr rr           JSR   eval_expr
001784r 2  B0 22              BCS   @err
001786r 2  A5 rr              LDA   eval_val_hi
001788r 2  10 19              BPL   @done                  ; already positive
00178Ar 2                     ; Negate 24-bit value
00178Ar 2  A5 rr              LDA   eval_val_frac
00178Cr 2  49 FF              EOR   #$FF
00178Er 2  18                 CLC
00178Fr 2  69 01              ADC   #1
001791r 2  85 rr              STA   eval_val_frac
001793r 2  A5 rr              LDA   eval_val_lo
001795r 2  49 FF              EOR   #$FF
001797r 2  69 00              ADC   #0
001799r 2  85 rr              STA   eval_val_lo
00179Br 2  A5 rr              LDA   eval_val_hi
00179Dr 2  49 FF              EOR   #$FF
00179Fr 2  69 00              ADC   #0
0017A1r 2  85 rr              STA   eval_val_hi
0017A3r 2               @done:
0017A3r 2  64 rr              STZ   eval_type
0017A5r 2  4C rr rr           JMP   eval_continue
0017A8r 2               @err:
0017A8r 2  38                 SEC
0017A9r 2  60                 RTS
0017AAr 2               
0017AAr 2               ; ---------------------------------------------------------------------
0017AAr 2               ; do_int — INT n: truncate fractional part
0017AAr 2               ; ---------------------------------------------------------------------
0017AAr 2               do_int:
0017AAr 2  20 rr rr           JSR   eval_expr
0017ADr 2  B0 07              BCS   @err
0017AFr 2  64 rr              STZ   eval_val_frac
0017B1r 2  64 rr              STZ   eval_type
0017B3r 2  4C rr rr           JMP   eval_continue
0017B6r 2               @err:
0017B6r 2  38                 SEC
0017B7r 2  60                 RTS
0017B8r 2               
0017B8r 2               ; ---------------------------------------------------------------------
0017B8r 2               ; do_round — ROUND n: round to nearest integer
0017B8r 2               ; ---------------------------------------------------------------------
0017B8r 2               do_round:
0017B8r 2  20 rr rr           JSR   eval_expr
0017BBr 2  B0 19              BCS   @err
0017BDr 2  A5 rr              LDA   eval_val_frac
0017BFr 2  C9 80              CMP   #128
0017C1r 2  90 0C              BCC   @trunc
0017C3r 2                     ; Round up: increment integer part
0017C3r 2  A5 rr              LDA   eval_val_hi
0017C5r 2  10 02              BPL   @pos_round
0017C7r 2                     ; Negative: actually round toward zero = truncate
0017C7r 2  80 06              BRA   @trunc
0017C9r 2               @pos_round:
0017C9r 2  E6 rr              INC   eval_val_lo
0017CBr 2  D0 02              BNE   @trunc
0017CDr 2  E6 rr              INC   eval_val_hi
0017CFr 2               @trunc:
0017CFr 2  64 rr              STZ   eval_val_frac
0017D1r 2  64 rr              STZ   eval_type
0017D3r 2  4C rr rr           JMP   eval_continue
0017D6r 2               @err:
0017D6r 2  38                 SEC
0017D7r 2  60                 RTS
0017D8r 2               
0017D8r 2               ; ---------------------------------------------------------------------
0017D8r 2               ; do_random — RANDOM n: return random number 0..n-1
0017D8r 2               ;   Uses math coprocessor RNG + MUL16 to scale
0017D8r 2               ; ---------------------------------------------------------------------
0017D8r 2               do_random:
0017D8r 2  20 rr rr           JSR   eval_expr
0017DBr 2  B0 1D              BCS   @err
0017DDr 2                     ; RNG byte * n / 256 gives 0..n-1
0017DDr 2  AD 37 BB           LDA   MATH_RNG
0017E0r 2  8D 20 BB           STA   MATH_MUL16_A_LO
0017E3r 2  9C 21 BB           STZ   MATH_MUL16_A_HI
0017E6r 2  A5 rr              LDA   eval_val_lo
0017E8r 2  8D 22 BB           STA   MATH_MUL16_B_LO
0017EBr 2  A5 rr              LDA   eval_val_hi
0017EDr 2  8D 23 BB           STA   MATH_MUL16_B_HI       ; trigger
0017F0r 2  AD 39 BB           LDA   MATH_RES1              ; high byte of (rng * n) = rng*n/256
0017F3r 2  85 rr              STA   eval_val_lo
0017F5r 2  64 rr              STZ   eval_val_hi
0017F7r 2  4C rr rr           JMP   return_number
0017FAr 2               @err:
0017FAr 2  38                 SEC
0017FBr 2  60                 RTS
0017FCr 2               
0017FCr 2               ; ---------------------------------------------------------------------
0017FCr 2               ; do_sqrt — SQRT n: approximate sqrt via DIST_APPROX(n, 0)
0017FCr 2               ; ---------------------------------------------------------------------
0017FCr 2               do_sqrt:
0017FCr 2  20 rr rr           JSR   eval_expr
0017FFr 2  B0 1D              BCS   @err
001801r 2  A5 rr              LDA   eval_val_lo
001803r 2  8D 33 BB           STA   MATH_DIST_DX_LO
001806r 2  A5 rr              LDA   eval_val_hi
001808r 2  8D 34 BB           STA   MATH_DIST_DX_HI
00180Br 2  9C 35 BB           STZ   MATH_DIST_DY_LO
00180Er 2  9C 36 BB           STZ   MATH_DIST_DY_HI       ; trigger (write to DY_HI triggers)
001811r 2  AD 38 BB           LDA   MATH_RES0
001814r 2  85 rr              STA   eval_val_lo
001816r 2  AD 39 BB           LDA   MATH_RES1
001819r 2  85 rr              STA   eval_val_hi
00181Br 2  4C rr rr           JMP   return_number
00181Er 2               @err:
00181Er 2  38                 SEC
00181Fr 2  60                 RTS
001820r 2               
001820r 2               ; ---------------------------------------------------------------------
001820r 2               ; do_remainder — REMAINDER a b: return a mod b via DIV coprocessor
001820r 2               ; ---------------------------------------------------------------------
001820r 2               do_remainder:
001820r 2  20 rr rr           JSR   eval_expr              ; first arg (a)
001823r 2  B0 49              BCS   @err
001825r 2  A5 rr              LDA   eval_val_lo
001827r 2  48                 PHA
001828r 2  A5 rr              LDA   eval_val_hi
00182Ar 2  48                 PHA
00182Br 2  20 rr rr           JSR   eval_expr              ; second arg (b)
00182Er 2  B0 3C              BCS   @err_pop
001830r 2                     ; b in eval_val, a on stack
001830r 2                     ; Check divide by zero
001830r 2  A5 rr              LDA   eval_val_lo
001832r 2  05 rr              ORA   eval_val_hi
001834r 2  F0 2D              BEQ   @zero_pop
001836r 2                     ; Set up 32÷16 division: dividend=a, divisor=b
001836r 2  68                 PLA
001837r 2  8D 29 BB           STA   MATH_DIV_N_1           ; a_hi
00183Ar 2  AA                 TAX                          ; save for sign-extend
00183Br 2  68                 PLA
00183Cr 2  8D 28 BB           STA   MATH_DIV_N_LO          ; a_lo
00183Fr 2                     ; Sign-extend a
00183Fr 2  8A                 TXA
001840r 2  09 7F              ORA   #$7F
001842r 2  30 02              BMI   @neg_a
001844r 2  A9 00              LDA   #$00
001846r 2               @neg_a:                            ; A=$FF if negative
001846r 2  8D 2A BB           STA   MATH_DIV_N_2
001849r 2  8D 2B BB           STA   MATH_DIV_N_HI
00184Cr 2  A5 rr              LDA   eval_val_lo
00184Er 2  8D 2C BB           STA   MATH_DIV_D_LO
001851r 2  A5 rr              LDA   eval_val_hi
001853r 2  8D 2D BB           STA   MATH_DIV_D_HI          ; trigger
001856r 2                     ; Remainder is in RES2:RES3 (actually check what the copro returns)
001856r 2                     ; The math copro returns quotient in RES0:RES1, remainder in RES2:RES3
001856r 2  AD 3A BB           LDA   MATH_RES2
001859r 2  85 rr              STA   eval_val_lo
00185Br 2  AD 3B BB           LDA   MATH_RES3
00185Er 2  85 rr              STA   eval_val_hi
001860r 2  4C rr rr           JMP   return_number
001863r 2               @zero_pop:
001863r 2  68                 PLA
001864r 2  68                 PLA
001865r 2  64 rr              STZ   eval_val_lo
001867r 2  64 rr              STZ   eval_val_hi
001869r 2  4C rr rr           JMP   return_number
00186Cr 2               @err_pop:
00186Cr 2  68                 PLA
00186Dr 2  68                 PLA
00186Er 2               @err:
00186Er 2  38                 SEC
00186Fr 2  60                 RTS
001870r 2               
001870r 2               ; ---------------------------------------------------------------------
001870r 2               ; do_not — NOT expr: return 1 if expr is 0, else 0
001870r 2               ; ---------------------------------------------------------------------
001870r 2               do_not:
001870r 2  20 rr rr           JSR   eval_expr
001873r 2  B0 13              BCS   @err
001875r 2  A5 rr              LDA   eval_val_lo
001877r 2  05 rr              ORA   eval_val_hi
001879r 2                     ; If zero, set result to 1. If nonzero, set to 0.
001879r 2  D0 06              BNE   @false
00187Br 2  A9 01              LDA   #1
00187Dr 2  85 rr              STA   eval_val_lo
00187Fr 2  80 02              BRA   @done
001881r 2               @false:
001881r 2  64 rr              STZ   eval_val_lo
001883r 2               @done:
001883r 2  64 rr              STZ   eval_val_hi
001885r 2  4C rr rr           JMP   return_number
001888r 2               @err:
001888r 2  38                 SEC
001889r 2  60                 RTS
00188Ar 2               
00188Ar 2               ; ---------------------------------------------------------------------
00188Ar 2               ; do_and — AND a b: return 1 if both nonzero, else 0
00188Ar 2               ; ---------------------------------------------------------------------
00188Ar 2               do_and:
00188Ar 2  20 rr rr           JSR   eval_expr
00188Dr 2  B0 1E              BCS   @err
00188Fr 2  A5 rr              LDA   eval_val_lo
001891r 2  05 rr              ORA   eval_val_hi
001893r 2  F0 11              BEQ   @false                 ; first arg is 0 → short-circuit
001895r 2  20 rr rr           JSR   eval_expr
001898r 2  B0 13              BCS   @err
