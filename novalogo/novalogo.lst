0009DEr 1                     .include "vars.s"
0009DEr 2               ; vars.s — variable storage for NovaLogo (MAKE / :reference)
0009DEr 2               ;
0009DEr 2               ; Variables are stored as a linked list of heap entries.
0009DEr 2               ; Entry layout:
0009DEr 2               ;   +0: next_lo  (2 bytes — pointer to next entry, or $0000)
0009DEr 2               ;   +1: next_hi
0009DEr 2               ;   +2: name_len (1 byte)
0009DEr 2               ;   +3: name chars (name_len bytes, uppercased)
0009DEr 2               ;   +3+name_len: value_type (1 byte: $00=number, $01=word)
0009DEr 2               ;   +4+name_len: val_hi  (or ptr_lo for word)
0009DEr 2               ;   +5+name_len: val_lo  (or ptr_hi for word)
0009DEr 2               ;   +6+name_len: val_frac (0 for word)
0009DEr 2               ;   +7+name_len: pad     (0)
0009DEr 2               ;
0009DEr 2               ; Total entry size = 8 + name_len bytes.
0009DEr 2               
0009DEr 2               ; Entry field offsets (relative to entry base)
0009DEr 2               VAR_NEXT_LO  = 0
0009DEr 2               VAR_NEXT_HI  = 1
0009DEr 2               VAR_NAME_LEN = 2
0009DEr 2               VAR_NAME     = 3              ; first char of name
0009DEr 2               
0009DEr 2               ; =====================================================================
0009DEr 2               ; ZEROPAGE segment — variable list head + scratch
0009DEr 2               ; =====================================================================
0009DEr 2                     .segment "ZEROPAGE"
000036r 2               
000036r 2  xx           var_head_lo:    .res 1        ; head of variable linked list
000037r 2  xx           var_head_hi:    .res 1
000038r 2  xx           var_entry_lo:   .res 1        ; current entry pointer (walk scratch)
000039r 2  xx           var_entry_hi:   .res 1
00003Ar 2  xx           var_name_lo:    .res 1        ; saved name pointer for set/get
00003Br 2  xx           var_name_hi:    .res 1
00003Cr 2               
00003Cr 2               ; =====================================================================
00003Cr 2               ; CODE segment — variable routines
00003Cr 2               ; =====================================================================
00003Cr 2                     .segment "CODE"
002588r 2               
002588r 2               ; ---------------------------------------------------------------------
002588r 2               ; var_init — initialize variable list to empty
002588r 2               ;   Called once at cold_start
002588r 2               ; ---------------------------------------------------------------------
002588r 2               var_init:
002588r 2  64 rr              STZ   var_head_lo
00258Ar 2  64 rr              STZ   var_head_hi
00258Cr 2  60                 RTS
00258Dr 2               
00258Dr 2               ; ---------------------------------------------------------------------
00258Dr 2               ; var_set — store a value under a variable name
00258Dr 2               ;   Input: ptr_lo/hi → length-prefixed name string (in token node)
00258Dr 2               ;          eval_type, eval_val_hi/lo/frac = value to store
00258Dr 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, var_entry, var_name
00258Dr 2               ; ---------------------------------------------------------------------
00258Dr 2               var_set:
00258Dr 2                     ; Save name pointer — we need it after the walk
00258Dr 2  A5 rr              LDA   ptr_lo
00258Fr 2  85 rr              STA   var_name_lo
002591r 2  A5 rr              LDA   ptr_hi
002593r 2  85 rr              STA   var_name_hi
002595r 2               
002595r 2                     ; Walk the list looking for an existing entry with this name
002595r 2  A5 rr              LDA   var_head_lo
002597r 2  85 rr              STA   var_entry_lo
002599r 2  A5 rr              LDA   var_head_hi
00259Br 2  85 rr              STA   var_entry_hi
00259Dr 2               
00259Dr 2               @walk:
00259Dr 2                     ; End of list?
00259Dr 2  A5 rr              LDA   var_entry_lo
00259Fr 2  05 rr              ORA   var_entry_hi
0025A1r 2  F0 44              BEQ   @not_found
0025A3r 2               
0025A3r 2                     ; Compare name in entry against var_name
0025A3r 2  20 rr rr           JSR   var_names_equal
0025A6r 2  B0 16              BCS   @found
0025A8r 2               
0025A8r 2                     ; Advance to next entry
0025A8r 2  A5 rr              LDA   var_entry_lo
0025AAr 2  85 rr              STA   ptr2_lo
0025ACr 2  A5 rr              LDA   var_entry_hi
0025AEr 2  85 rr              STA   ptr2_hi
0025B0r 2  A0 00              LDY   #VAR_NEXT_LO
0025B2r 2  B1 rr              LDA   (ptr2_lo),Y
0025B4r 2  AA                 TAX
0025B5r 2  C8                 INY
0025B6r 2  B1 rr              LDA   (ptr2_lo),Y
0025B8r 2  85 rr              STA   var_entry_hi
0025BAr 2  86 rr              STX   var_entry_lo
0025BCr 2  80 DF              BRA   @walk
0025BEr 2               
0025BEr 2               @found:
0025BEr 2                     ; Overwrite value in place
0025BEr 2                     ; Value starts at entry + 3 + name_len
0025BEr 2  A5 rr              LDA   var_entry_lo
0025C0r 2  85 rr              STA   ptr2_lo
0025C2r 2  A5 rr              LDA   var_entry_hi
0025C4r 2  85 rr              STA   ptr2_hi
0025C6r 2  A0 02              LDY   #VAR_NAME_LEN
0025C8r 2  B1 rr              LDA   (ptr2_lo),Y          ; name_len
0025CAr 2  18                 CLC
0025CBr 2  69 03              ADC   #VAR_NAME             ; A = 3 + name_len = offset to value_type
0025CDr 2  A8                 TAY
0025CEr 2  A5 rr              LDA   eval_type
0025D0r 2  91 rr              STA   (ptr2_lo),Y
0025D2r 2  C8                 INY
0025D3r 2  A5 rr              LDA   eval_val_hi
0025D5r 2  91 rr              STA   (ptr2_lo),Y
0025D7r 2  C8                 INY
0025D8r 2  A5 rr              LDA   eval_val_lo
0025DAr 2  91 rr              STA   (ptr2_lo),Y
0025DCr 2  C8                 INY
0025DDr 2  A5 rr              LDA   eval_val_frac
0025DFr 2  91 rr              STA   (ptr2_lo),Y
0025E1r 2  C8                 INY
0025E2r 2  A9 00              LDA   #0
0025E4r 2  91 rr              STA   (ptr2_lo),Y          ; pad
0025E6r 2  60                 RTS
0025E7r 2               
0025E7r 2               @not_found:
0025E7r 2                     ; Allocate a new entry: 8 + name_len bytes
0025E7r 2                     ; Read name_len from the name string
0025E7r 2  A5 rr              LDA   var_name_lo
0025E9r 2  85 rr              STA   ptr_lo
0025EBr 2  A5 rr              LDA   var_name_hi
0025EDr 2  85 rr              STA   ptr_hi
0025EFr 2  A0 00              LDY   #0
0025F1r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
0025F3r 2  48                 PHA                         ; save name_len
0025F4r 2  18                 CLC
0025F5r 2  69 08              ADC   #8                    ; total entry size
0025F7r 2  A2 03              LDX   #ATYPE_VAR
0025F9r 2  20 rr rr           JSR   heap_alloc
0025FCr 2  B0 62              BCS   @oom
0025FEr 2               
0025FEr 2                     ; ptr_lo/hi now points to new entry
0025FEr 2                     ; Set next → current head
0025FEr 2  A0 00              LDY   #VAR_NEXT_LO
002600r 2  A5 rr              LDA   var_head_lo
002602r 2  91 rr              STA   (ptr_lo),Y
002604r 2  C8                 INY
002605r 2  A5 rr              LDA   var_head_hi
002607r 2  91 rr              STA   (ptr_lo),Y
002609r 2               
002609r 2                     ; Copy name_len
002609r 2  68                 PLA                         ; A = name_len
00260Ar 2  48                 PHA                         ; keep it on stack
00260Br 2  A0 02              LDY   #VAR_NAME_LEN
00260Dr 2  91 rr              STA   (ptr_lo),Y
00260Fr 2               
00260Fr 2                     ; Copy name chars (uppercased) from var_name source
00260Fr 2  68                 PLA                         ; A = name_len
002610r 2  AA                 TAX                         ; X = remaining chars
002611r 2  F0 2C              BEQ   @name_done            ; zero-length name (shouldn't happen)
002613r 2  A0 03              LDY   #VAR_NAME             ; dest offset in entry
002615r 2  9C rr rr           STZ   num_tmp_lo            ; source offset counter
002618r 2               
002618r 2               @copy_name:
002618r 2  DA                 PHX
002619r 2  5A                 PHY
00261Ar 2                     ; Read source char
00261Ar 2  A5 rr              LDA   var_name_lo
00261Cr 2  85 rr              STA   ptr2_lo
00261Er 2  A5 rr              LDA   var_name_hi
002620r 2  85 rr              STA   ptr2_hi
002622r 2  AD rr rr           LDA   num_tmp_lo
002625r 2  1A                 INC                         ; skip length byte → offset = idx + 1
002626r 2  A8                 TAY
002627r 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
002629r 2                     ; Uppercase
002629r 2  C9 61              CMP   #'a'
00262Br 2  90 07              BCC   @noup
00262Dr 2  C9 7B              CMP   #'z'+1
00262Fr 2  B0 03              BCS   @noup
002631r 2  38                 SEC
002632r 2  E9 20              SBC   #$20
002634r 2               @noup:
002634r 2  7A                 PLY                         ; restore dest offset
002635r 2  91 rr              STA   (ptr_lo),Y           ; write to entry
002637r 2  C8                 INY
002638r 2  EE rr rr           INC   num_tmp_lo
00263Br 2  FA                 PLX
00263Cr 2  CA                 DEX
00263Dr 2  D0 D9              BNE   @copy_name
00263Fr 2               
00263Fr 2               @name_done:
00263Fr 2                     ; Write value after name
00263Fr 2                     ; Y is already at VAR_NAME + name_len = value_type offset
00263Fr 2  A5 rr              LDA   eval_type
002641r 2  91 rr              STA   (ptr_lo),Y
002643r 2  C8                 INY
002644r 2  A5 rr              LDA   eval_val_hi
002646r 2  91 rr              STA   (ptr_lo),Y
002648r 2  C8                 INY
002649r 2  A5 rr              LDA   eval_val_lo
00264Br 2  91 rr              STA   (ptr_lo),Y
00264Dr 2  C8                 INY
00264Er 2  A5 rr              LDA   eval_val_frac
002650r 2  91 rr              STA   (ptr_lo),Y
002652r 2  C8                 INY
002653r 2  A9 00              LDA   #0
002655r 2  91 rr              STA   (ptr_lo),Y           ; pad
002657r 2               
002657r 2                     ; Prepend to list: head = new entry
002657r 2  A5 rr              LDA   ptr_lo
002659r 2  85 rr              STA   var_head_lo
00265Br 2  A5 rr              LDA   ptr_hi
00265Dr 2  85 rr              STA   var_head_hi
00265Fr 2  60                 RTS
002660r 2               
002660r 2               @oom:
002660r 2  68                 PLA                         ; discard saved name_len
002661r 2  60                 RTS
002662r 2               
002662r 2               ; ---------------------------------------------------------------------
002662r 2               ; var_get — look up a variable by name
002662r 2               ;   Input: ptr_lo/hi → length-prefixed name string
002662r 2               ;   Output: Carry clear = found, eval_type/eval_val set
002662r 2               ;           Carry set = not found
002662r 2               ;   Clobbers: A, X, Y, ptr2, var_entry, var_name
002662r 2               ; ---------------------------------------------------------------------
002662r 2               var_get:
002662r 2                     ; Save name pointer
002662r 2  A5 rr              LDA   ptr_lo
002664r 2  85 rr              STA   var_name_lo
002666r 2  A5 rr              LDA   ptr_hi
002668r 2  85 rr              STA   var_name_hi
00266Ar 2               
00266Ar 2                     ; Walk the list
00266Ar 2  A5 rr              LDA   var_head_lo
00266Cr 2  85 rr              STA   var_entry_lo
00266Er 2  A5 rr              LDA   var_head_hi
002670r 2  85 rr              STA   var_entry_hi
002672r 2               
002672r 2               @walk:
002672r 2  A5 rr              LDA   var_entry_lo
002674r 2  05 rr              ORA   var_entry_hi
002676r 2  F0 40              BEQ   @not_found
002678r 2               
002678r 2  20 rr rr           JSR   var_names_equal
00267Br 2  B0 16              BCS   @found
00267Dr 2               
00267Dr 2                     ; Advance to next
00267Dr 2  A5 rr              LDA   var_entry_lo
00267Fr 2  85 rr              STA   ptr2_lo
002681r 2  A5 rr              LDA   var_entry_hi
002683r 2  85 rr              STA   ptr2_hi
002685r 2  A0 00              LDY   #VAR_NEXT_LO
002687r 2  B1 rr              LDA   (ptr2_lo),Y
002689r 2  AA                 TAX
00268Ar 2  C8                 INY
00268Br 2  B1 rr              LDA   (ptr2_lo),Y
00268Dr 2  85 rr              STA   var_entry_hi
00268Fr 2  86 rr              STX   var_entry_lo
002691r 2  80 DF              BRA   @walk
002693r 2               
002693r 2               @found:
002693r 2                     ; Read value from entry + 3 + name_len
002693r 2  A5 rr              LDA   var_entry_lo
002695r 2  85 rr              STA   ptr2_lo
002697r 2  A5 rr              LDA   var_entry_hi
002699r 2  85 rr              STA   ptr2_hi
00269Br 2  A0 02              LDY   #VAR_NAME_LEN
00269Dr 2  B1 rr              LDA   (ptr2_lo),Y
00269Fr 2  18                 CLC
0026A0r 2  69 03              ADC   #VAR_NAME
0026A2r 2  A8                 TAY
0026A3r 2  B1 rr              LDA   (ptr2_lo),Y          ; value_type
0026A5r 2  85 rr              STA   eval_type
0026A7r 2  C8                 INY
0026A8r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_hi
0026AAr 2  85 rr              STA   eval_val_hi
0026ACr 2  C8                 INY
0026ADr 2  B1 rr              LDA   (ptr2_lo),Y          ; val_lo
0026AFr 2  85 rr              STA   eval_val_lo
0026B1r 2  C8                 INY
0026B2r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_frac
0026B4r 2  85 rr              STA   eval_val_frac
0026B6r 2  18                 CLC
0026B7r 2  60                 RTS
0026B8r 2               
0026B8r 2               @not_found:
0026B8r 2  38                 SEC
0026B9r 2  60                 RTS
0026BAr 2               
0026BAr 2               ; ---------------------------------------------------------------------
0026BAr 2               ; var_names_equal — compare name at var_name_lo/hi against entry at var_entry
0026BAr 2               ;   The name source is length-prefixed (from token / quote).
0026BAr 2               ;   The entry stores: name_len at +2, chars at +3 (already uppercased).
0026BAr 2               ;   The source name chars are uppercased during comparison.
0026BAr 2               ;   Returns: Carry set = equal, Carry clear = not equal
0026BAr 2               ;   Clobbers: A, X, Y, ptr2
0026BAr 2               ; ---------------------------------------------------------------------
0026BAr 2               var_names_equal:
0026BAr 2                     ; Read source name length
0026BAr 2  A5 rr              LDA   var_name_lo
0026BCr 2  85 rr              STA   ptr2_lo
0026BEr 2  A5 rr              LDA   var_name_hi
0026C0r 2  85 rr              STA   ptr2_hi
0026C2r 2  A0 00              LDY   #0
0026C4r 2  B1 rr              LDA   (ptr2_lo),Y          ; source name_len
0026C6r 2  AA                 TAX                         ; X = source name_len
0026C7r 2               
0026C7r 2                     ; Read entry name length
0026C7r 2  A5 rr              LDA   var_entry_lo
0026C9r 2  85 rr              STA   ptr2_lo
0026CBr 2  A5 rr              LDA   var_entry_hi
0026CDr 2  85 rr              STA   ptr2_hi
0026CFr 2  A0 02              LDY   #VAR_NAME_LEN
0026D1r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry name_len
0026D3r 2               
0026D3r 2                     ; Compare lengths
0026D3r 2  8E rr rr           STX   num_tmp_lo            ; save source length
0026D6r 2  CD rr rr           CMP   num_tmp_lo
0026D9r 2  D0 43              BNE   @ne
0026DBr 2               
0026DBr 2                     ; Lengths match — compare chars
0026DBr 2  E0 00              CPX   #0
0026DDr 2  F0 3B              BEQ   @eq                   ; both zero-length — equal
0026DFr 2  A0 00              LDY   #0                    ; char index
0026E1r 2               
0026E1r 2               @cmp_loop:
0026E1r 2  DA                 PHX
0026E2r 2  5A                 PHY
0026E3r 2                     ; Read source char (var_name + 1 + Y)
0026E3r 2  A5 rr              LDA   var_name_lo
0026E5r 2  85 rr              STA   ptr2_lo
0026E7r 2  A5 rr              LDA   var_name_hi
0026E9r 2  85 rr              STA   ptr2_hi
0026EBr 2  98                 TYA
0026ECr 2  1A                 INC                         ; skip length byte
0026EDr 2  A8                 TAY
0026EEr 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
0026F0r 2                     ; Uppercase it
0026F0r 2  C9 61              CMP   #'a'
0026F2r 2  90 07              BCC   @noup
0026F4r 2  C9 7B              CMP   #'z'+1
0026F6r 2  B0 03              BCS   @noup
0026F8r 2  38                 SEC
0026F9r 2  E9 20              SBC   #$20
0026FBr 2               @noup:
0026FBr 2  8D rr rr           STA   num_tmp_hi            ; temp: uppercased source char
0026FEr 2               
0026FEr 2                     ; Read entry char (var_entry + VAR_NAME + Y)
0026FEr 2  7A                 PLY                         ; restore char index
0026FFr 2  5A                 PHY
002700r 2  A5 rr              LDA   var_entry_lo
002702r 2  85 rr              STA   ptr2_lo
002704r 2  A5 rr              LDA   var_entry_hi
002706r 2  85 rr              STA   ptr2_hi
002708r 2  98                 TYA
002709r 2  18                 CLC
00270Ar 2  69 03              ADC   #VAR_NAME
00270Cr 2  A8                 TAY
00270Dr 2  B1 rr              LDA   (ptr2_lo),Y          ; entry char (already uppercase)
00270Fr 2               
00270Fr 2  CD rr rr           CMP   num_tmp_hi
002712r 2                     ; 65C02: PLY/PLX clobber flags! Must branch BEFORE pulling.
002712r 2  D0 08              BNE   @ne_pull
002714r 2               
002714r 2  7A                 PLY
002715r 2  FA                 PLX
002716r 2  C8                 INY
002717r 2  CA                 DEX
002718r 2  D0 C7              BNE   @cmp_loop
00271Ar 2               
00271Ar 2               @eq:
00271Ar 2  38                 SEC                         ; equal
00271Br 2  60                 RTS
00271Cr 2               
00271Cr 2               @ne_pull:
00271Cr 2  7A                 PLY                         ; clean up stack
00271Dr 2  FA                 PLX
00271Er 2               @ne:
00271Er 2  18                 CLC                         ; not equal
00271Fr 2  60                 RTS
002720r 2               
002720r 1                     .include "procedures.s"
002720r 2               ; procedures.s — user-defined procedure storage and invocation
002720r 2               ;
002720r 2               ; Procedure record layout (heap-allocated linked list):
002720r 2               ;   +0: next_lo
002720r 2               ;   +1: next_hi    (pointer to next procedure, or $0000)
002720r 2               ;   +2: name_len   (1 byte)
002720r 2               ;   +3..3+NL-1: name chars (uppercased)
002720r 2               ;   +3+NL: param_count (1 byte)
002720r 2               ;   For each param:
002720r 2               ;     1 byte: param_name_len
002720r 2               ;     N bytes: param_name chars (uppercased)
002720r 2               ;   After all params:
002720r 2               ;     2 bytes: body_len_lo, body_len_hi (16-bit)
002720r 2               ;     body_len bytes: body text (lines separated by $0A)
002720r 2               
002720r 2               ; =====================================================================
002720r 2               ; ZEROPAGE segment — procedure variables
002720r 2               ; =====================================================================
002720r 2                     .segment "ZEROPAGE"
00003Cr 2               
00003Cr 2  xx           proc_head_lo:     .res 1        ; head of procedure directory
00003Dr 2  xx           proc_head_hi:     .res 1
00003Er 2  xx           proc_entry_lo:    .res 1        ; current entry pointer (walk scratch)
00003Fr 2  xx           proc_entry_hi:    .res 1
000040r 2  xx           proc_ptr_lo:      .res 1        ; scratch pointer for proc operations
000041r 2  xx           proc_ptr_hi:      .res 1
000042r 2  xx           proc_body_len_lo: .res 1        ; body length during collection / invocation
000043r 2  xx           proc_body_len_hi: .res 1
000044r 2  xx           proc_param_cnt:   .res 1        ; param count during define / invoke
000045r 2  xx           proc_name_len:    .res 1        ; name length scratch
000046r 2  xx           proc_rec_off:     .res 1        ; offset into record during invoke
000047r 2               
000047r 2               ; =====================================================================
000047r 2               ; BSS segment — temporary buffers
000047r 2               ; =====================================================================
000047r 2                     .segment "BSS"
00000Fr 2               
00000Fr 2  xx xx xx xx  proc_body_buf:    .res 2048     ; editor text buffer: "TO ..\n<body>\nEND\n"
000013r 2  xx xx xx xx  
000017r 2  xx xx xx xx  
00080Fr 2  xx xx xx xx  proc_name_buf:    .res 32       ; procedure name: length-prefixed
000813r 2  xx xx xx xx  
000817r 2  xx xx xx xx  
00082Fr 2  xx xx xx xx  proc_param_buf:   .res 128      ; packed: count, [len,chars]... each param
000833r 2  xx xx xx xx  
000837r 2  xx xx xx xx  
0008AFr 2  xx           proc_param_end:   .res 1        ; write offset into proc_param_buf
0008B0r 2  xx xx xx xx  proc_editor_title:.res 36       ; "TO <name>" + NUL, passed to the shared editor
0008B4r 2  xx xx xx xx  
0008B8r 2  xx xx xx xx  
0008D4r 2  xx           proc_body_src_lo: .res 1        ; pointer to the body text proc_build_record copies
0008D5r 2  xx           proc_body_src_hi: .res 1
0008D6r 2  xx           proc_edit_cur_lo: .res 1        ; initial editor cursor offset (start of body line)
0008D7r 2  xx           proc_edit_cur_hi: .res 1
0008D8r 2  xx           proc_scan_off_lo: .res 1        ; 16-bit scan offset for body extraction
0008D9r 2  xx           proc_scan_off_hi: .res 1
0008DAr 2               
0008DAr 2               ; Save area for eval state during procedure invocation
0008DAr 2  xx           save_eval_cur_lo: .res 1
0008DBr 2  xx           save_eval_cur_hi: .res 1
0008DCr 2  xx           save_tok_head_lo: .res 1
0008DDr 2  xx           save_tok_head_hi: .res 1
0008DEr 2  xx           save_tok_tail_lo: .res 1
0008DFr 2  xx           save_tok_tail_hi: .res 1
0008E0r 2  xx xx xx xx  save_input_buf:   .res 128      ; save outer input_buf during proc body exec
0008E4r 2  xx xx xx xx  
0008E8r 2  xx xx xx xx  
000960r 2  xx           save_heap_ptr_lo: .res 1        ; save heap for token re-use
000961r 2  xx           save_heap_ptr_hi: .res 1
000962r 2               
000962r 2               ; Param-binding scratch: length-prefixed name built here for var_set
000962r 2  xx xx xx xx  param_name_tmp:   .res 32
000966r 2  xx xx xx xx  
00096Ar 2  xx xx xx xx  
000982r 2               
000982r 2               ; =====================================================================
000982r 2               ; CODE segment — procedure routines
000982r 2               ; =====================================================================
000982r 2                     .segment "CODE"
002720r 2               
002720r 2               ; ---------------------------------------------------------------------
002720r 2               ; proc_init — initialize procedure directory to empty
002720r 2               ; ---------------------------------------------------------------------
002720r 2               proc_init:
002720r 2  64 rr              STZ   proc_head_lo
002722r 2  64 rr              STZ   proc_head_hi
002724r 2  64 rr              STZ   proc_stopped
002726r 2  60                 RTS
002727r 2               
002727r 2               ; ---------------------------------------------------------------------
002727r 2               ; proc_collect — enter TO/END multi-line collection mode
002727r 2               ;   Called from main_loop after detecting TO as first token.
002727r 2               ;   eval_cur_lo/hi has been advanced past the TO token.
002727r 2               ; ---------------------------------------------------------------------
002727r 2               proc_collect:
002727r 2                     ; Next token should be the procedure name (TOK_WORD)
002727r 2  A5 rr              LDA   eval_cur_lo
002729r 2  05 rr              ORA   eval_cur_hi
00272Br 2  D0 03              BNE   @have_name
00272Dr 2  4C rr rr           JMP   @err_noname
002730r 2               @have_name:
002730r 2  A5 rr              LDA   eval_cur_lo
002732r 2  85 rr              STA   ptr_lo
002734r 2  A5 rr              LDA   eval_cur_hi
002736r 2  85 rr              STA   ptr_hi
002738r 2  A0 00              LDY   #TOK_TAG
00273Ar 2  B1 rr              LDA   (ptr_lo),Y
00273Cr 2  C9 01              CMP   #TOK_WORD
00273Er 2  F0 03              BEQ   @name_ok
002740r 2  4C rr rr           JMP   @err_noname
002743r 2               @name_ok:
002743r 2                     ; Copy procedure name to proc_name_buf (length-prefixed)
002743r 2  A0 03              LDY   #TOK_PAYLOAD
002745r 2  B1 rr              LDA   (ptr_lo),Y           ; name length
002747r 2  8D rr rr           STA   proc_name_buf
00274Ar 2  85 rr              STA   proc_name_len
00274Cr 2  AA                 TAX                         ; X = char count
00274Dr 2  A0 04              LDY   #TOK_PAYLOAD+1
00274Fr 2  A9 00              LDA   #0
002751r 2  85 rr              STA   proc_rec_off          ; dest index in name_buf
002753r 2               @copy_name:
002753r 2  E0 00              CPX   #0
002755r 2  F0 0F              BEQ   @name_copied
002757r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased by tokenizer
002759r 2  5A                 PHY
00275Ar 2  A4 rr              LDY   proc_rec_off
00275Cr 2  99 rr rr           STA   proc_name_buf+1,Y
00275Fr 2  E6 rr              INC   proc_rec_off
002761r 2  7A                 PLY
002762r 2  C8                 INY
002763r 2  CA                 DEX
002764r 2  80 ED              BRA   @copy_name
002766r 2               @name_copied:
002766r 2               
002766r 2                     ; Advance past the name token
002766r 2  20 rr rr           JSR   eval_advance
002769r 2               
002769r 2                     ; Parse parameter names (TOK_VARREF tokens: :SIZE :COLOR etc.)
002769r 2  64 rr              STZ   proc_param_cnt
00276Br 2  A9 01              LDA   #1                    ; dest offset (skip count byte at [0])
00276Dr 2  8D rr rr           STA   proc_param_end
002770r 2               
002770r 2               @parse_params:
002770r 2  A5 rr              LDA   eval_cur_lo
002772r 2  05 rr              ORA   eval_cur_hi
002774r 2  F0 47              BEQ   @params_done
002776r 2  A5 rr              LDA   eval_cur_lo
002778r 2  85 rr              STA   ptr_lo
00277Ar 2  A5 rr              LDA   eval_cur_hi
00277Cr 2  85 rr              STA   ptr_hi
00277Er 2  A0 00              LDY   #TOK_TAG
002780r 2  B1 rr              LDA   (ptr_lo),Y
002782r 2  C9 05              CMP   #TOK_VARREF
002784r 2  D0 37              BNE   @params_done
002786r 2               
002786r 2  E6 rr              INC   proc_param_cnt
002788r 2  A0 03              LDY   #TOK_PAYLOAD
00278Ar 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
00278Cr 2  AE rr rr           LDX   proc_param_end
00278Fr 2  9D rr rr           STA   proc_param_buf,X     ; store length
002792r 2  E8                 INX
002793r 2  A8                 TAY                         ; Y = char count to copy
002794r 2  64 rr              STZ   proc_rec_off          ; source char index
002796r 2               
002796r 2               @copy_param_ch:
002796r 2  C0 00              CPY   #0
002798r 2  F0 1B              BEQ   @param_ch_done
00279Ar 2                     ; Read source char from token
00279Ar 2  A5 rr              LDA   eval_cur_lo
00279Cr 2  85 rr              STA   ptr_lo
00279Er 2  A5 rr              LDA   eval_cur_hi
0027A0r 2  85 rr              STA   ptr_hi
0027A2r 2  5A                 PHY
0027A3r 2  A5 rr              LDA   proc_rec_off
0027A5r 2  18                 CLC
0027A6r 2  69 04              ADC   #TOK_PAYLOAD+1
0027A8r 2  A8                 TAY
0027A9r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased
0027ABr 2  7A                 PLY
0027ACr 2                     ; Write to proc_param_buf
0027ACr 2  9D rr rr           STA   proc_param_buf,X
0027AFr 2  E8                 INX
0027B0r 2  E6 rr              INC   proc_rec_off
0027B2r 2  88                 DEY
0027B3r 2  80 E1              BRA   @copy_param_ch
0027B5r 2               @param_ch_done:
0027B5r 2  8E rr rr           STX   proc_param_end
0027B8r 2               
0027B8r 2  20 rr rr           JSR   eval_advance
0027BBr 2  80 B3              BRA   @parse_params
0027BDr 2               
0027BDr 2               @params_done:
0027BDr 2  A5 rr              LDA   proc_param_cnt
0027BFr 2  8D rr rr           STA   proc_param_buf        ; count byte at [0]
0027C2r 2               
0027C2r 2                     ; Initialize body buffer
0027C2r 2  64 rr              STZ   proc_body_len_lo
0027C4r 2  64 rr              STZ   proc_body_len_hi
0027C6r 2               
0027C6r 2                     ; Open the shared EDITUI editor on an empty body buffer. Carry set means
0027C6r 2                     ; the user asked to save (Ctrl-S / "Save First") before exiting.
0027C6r 2  20 rr rr           JSR   proc_open_editor
0027C9r 2  B0 01              BCS   @body_done
0027CBr 2  60                 RTS
0027CCr 2               
0027CCr 2                     ; Print "NAME DEFINED\n"
0027CCr 2               @body_done:
0027CCr 2  A6 rr              LDX   proc_name_len
0027CEr 2  A0 00              LDY   #0
0027D0r 2               @print_name:
0027D0r 2  E0 00              CPX   #0
0027D2r 2  F0 0A              BEQ   @print_def
0027D4r 2  B9 rr rr           LDA   proc_name_buf+1,Y
0027D7r 2  8D 0E A0           STA   VGC_CHAROUT
0027DAr 2  C8                 INY
0027DBr 2  CA                 DEX
0027DCr 2  80 F2              BRA   @print_name
0027DEr 2               @print_def:
0027DEr 2  A2 00              LDX   #0
0027E0r 2               @pd_lp:
0027E0r 2  BD rr rr           LDA   str_defined,X
0027E3r 2  F0 06              BEQ   @pd_done
0027E5r 2  8D 0E A0           STA   VGC_CHAROUT
0027E8r 2  E8                 INX
0027E9r 2  D0 F5              BNE   @pd_lp
0027EBr 2               @pd_done:
0027EBr 2  20 rr rr           JSR   eval_newline
0027EEr 2  60                 RTS
0027EFr 2               
0027EFr 2               @err_noname:
0027EFr 2  A2 00              LDX   #0
0027F1r 2               @en_lp:
0027F1r 2  BD rr rr           LDA   str_to_needs_name,X
0027F4r 2  F0 06              BEQ   @en_done
0027F6r 2  8D 0E A0           STA   VGC_CHAROUT
0027F9r 2  E8                 INX
0027FAr 2  D0 F5              BNE   @en_lp
0027FCr 2               @en_done:
0027FCr 2  20 rr rr           JSR   eval_newline
0027FFr 2  60                 RTS
002800r 2               
002800r 2               ; ---------------------------------------------------------------------
002800r 2               ; proc_open_editor — run the shared EDITUI editor on an empty body buffer.
002800r 2               ;   Builds the editor title "TO <name>", hands the buffer/cap/title to the
002800r 2               ;   extension's EXT_CMD_EDIT, then on return builds the procedure record from
002800r 2               ;   the edited body when the user asked to save.
002800r 2               ;   Inputs:  proc_name_buf / proc_name_len, proc_param_buf (already parsed)
002800r 2               ;   Returns: carry set = saved (record built), carry clear = abandoned
002800r 2               ; ---------------------------------------------------------------------
002800r 2               proc_open_editor:
002800r 2                     ; --- build the scaffold "TO <name> :params\n  \nEND\n" in proc_body_buf.
002800r 2                     ; Y is the 8-bit write index (the scaffold is always < 256 bytes: name<=31,
002800r 2                     ; params<=127, plus a dozen structure bytes).
002800r 2  A0 00              LDY   #0
002802r 2  A9 54              LDA   #'T'
002804r 2  99 rr rr           STA   proc_body_buf,Y
002807r 2  C8                 INY
002808r 2  A9 4F              LDA   #'O'
00280Ar 2  99 rr rr           STA   proc_body_buf,Y
00280Dr 2  C8                 INY
00280Er 2  A9 20              LDA   #' '
002810r 2  99 rr rr           STA   proc_body_buf,Y
002813r 2  C8                 INY
002814r 2  A2 00              LDX   #0                     ; name source index
002816r 2               @nm:
002816r 2  E4 rr              CPX   proc_name_len
002818r 2  B0 0A              BCS   @nm_done
00281Ar 2  BD rr rr           LDA   proc_name_buf+1,X
00281Dr 2  99 rr rr           STA   proc_body_buf,Y
002820r 2  C8                 INY
002821r 2  E8                 INX
002822r 2  80 F2              BRA   @nm
002824r 2               @nm_done:
002824r 2                     ; params: " :" + chars, walking proc_param_buf[1..proc_param_end)
002824r 2  A2 01              LDX   #1
002826r 2               @pp:
002826r 2  EC rr rr           CPX   proc_param_end
002829r 2  B0 22              BCS   @pp_done
00282Br 2  A9 20              LDA   #' '
00282Dr 2  99 rr rr           STA   proc_body_buf,Y
002830r 2  C8                 INY
002831r 2  A9 3A              LDA   #':'
002833r 2  99 rr rr           STA   proc_body_buf,Y
002836r 2  C8                 INY
002837r 2  BD rr rr           LDA   proc_param_buf,X       ; this param's char count
00283Ar 2  85 rr              STA   proc_rec_off
00283Cr 2  E8                 INX
00283Dr 2               @ppc:
00283Dr 2  A5 rr              LDA   proc_rec_off
00283Fr 2  F0 E5              BEQ   @pp
002841r 2  BD rr rr           LDA   proc_param_buf,X
002844r 2  99 rr rr           STA   proc_body_buf,Y
002847r 2  C8                 INY
002848r 2  E8                 INX
002849r 2  C6 rr              DEC   proc_rec_off
00284Br 2  80 F0              BRA   @ppc
00284Dr 2               @pp_done:
00284Dr 2                     ; Y = line-1 length. The body line is line 1's '\n' + 2 indent spaces,
00284Dr 2                     ; so the cursor lands at offset (line1 + 3).
00284Dr 2  98                 TYA
00284Er 2  18                 CLC
00284Fr 2  69 03              ADC   #3
002851r 2  8D rr rr           STA   proc_edit_cur_lo
002854r 2  A9 00              LDA   #0
002856r 2  69 00              ADC   #0
002858r 2  8D rr rr           STA   proc_edit_cur_hi
00285Br 2                     ; append "\n  \nEND\n"
00285Br 2  A9 0A              LDA   #$0A
00285Dr 2  99 rr rr           STA   proc_body_buf,Y
002860r 2  C8                 INY
002861r 2  A9 20              LDA   #' '
002863r 2  99 rr rr           STA   proc_body_buf,Y
002866r 2  C8                 INY
002867r 2  99 rr rr           STA   proc_body_buf,Y
00286Ar 2  C8                 INY
00286Br 2  A9 0A              LDA   #$0A
00286Dr 2  99 rr rr           STA   proc_body_buf,Y
002870r 2  C8                 INY
002871r 2  A9 45              LDA   #'E'
002873r 2  99 rr rr           STA   proc_body_buf,Y
002876r 2  C8                 INY
002877r 2  A9 4E              LDA   #'N'
002879r 2  99 rr rr           STA   proc_body_buf,Y
00287Cr 2  C8                 INY
00287Dr 2  A9 44              LDA   #'D'
00287Fr 2  99 rr rr           STA   proc_body_buf,Y
002882r 2  C8                 INY
002883r 2  A9 0A              LDA   #$0A
002885r 2  99 rr rr           STA   proc_body_buf,Y
002888r 2  C8                 INY
002889r 2  84 rr              STY   proc_body_len_lo
00288Br 2  64 rr              STZ   proc_body_len_hi
00288Dr 2               
00288Dr 2                     ; --- title "TO <name>" + NUL for the editor's title band ---
00288Dr 2  A9 54              LDA   #'T'
00288Fr 2  8D rr rr           STA   proc_editor_title+0
002892r 2  A9 4F              LDA   #'O'
002894r 2  8D rr rr           STA   proc_editor_title+1
002897r 2  A9 20              LDA   #' '
002899r 2  8D rr rr           STA   proc_editor_title+2
00289Cr 2  A2 00              LDX   #0
00289Er 2  A0 03              LDY   #3
0028A0r 2               @tt:
0028A0r 2  E4 rr              CPX   proc_name_len
0028A2r 2  B0 0A              BCS   @tt_done
0028A4r 2  BD rr rr           LDA   proc_name_buf+1,X
0028A7r 2  99 rr rr           STA   proc_editor_title,Y
0028AAr 2  E8                 INX
0028ABr 2  C8                 INY
0028ACr 2  80 F2              BRA   @tt
0028AEr 2               @tt_done:
0028AEr 2  A9 00              LDA   #0
0028B0r 2  99 rr rr           STA   proc_editor_title,Y
0028B3r 2               
0028B3r 2                     ; --- mailbox: ARG0=buf ARG1=len ARG2=cap ARG3=title; cursor in FRAC bytes
0028B3r 2  A9 rr              LDA   #<proc_body_buf
0028B5r 2  85 84              STA   EXT_ARG0_LO
0028B7r 2  A9 rr              LDA   #>proc_body_buf
0028B9r 2  85 83              STA   EXT_ARG0_HI
0028BBr 2  A5 rr              LDA   proc_body_len_lo
0028BDr 2  85 88              STA   EXT_ARG1_LO
0028BFr 2  A5 rr              LDA   proc_body_len_hi
0028C1r 2  85 87              STA   EXT_ARG1_HI
0028C3r 2  A9 00              LDA   #<2048
0028C5r 2  85 8C              STA   EXT_ARG2_LO
0028C7r 2  A9 08              LDA   #>2048
0028C9r 2  85 8B              STA   EXT_ARG2_HI
0028CBr 2  A9 rr              LDA   #<proc_editor_title
0028CDr 2  85 A1              STA   EXT_ARG3_LO
0028CFr 2  A9 rr              LDA   #>proc_editor_title
0028D1r 2  85 A0              STA   EXT_ARG3_HI
0028D3r 2  AD rr rr           LDA   proc_edit_cur_lo
0028D6r 2  85 8D              STA   EXT_ARG2_FRAC          ; initial cursor offset (see ext_iface.inc)
0028D8r 2  AD rr rr           LDA   proc_edit_cur_hi
0028DBr 2  85 A2              STA   EXT_ARG3_FRAC
0028DDr 2               
0028DDr 2  A9 4B              LDA   #EXT_CMD_EDIT
0028DFr 2  85 80              STA   EXT_CMD
0028E1r 2  20 70 02           JSR   EXT_TRAMPOLINE         ; swap to ext ROM, run editor, swap back
0028E4r 2               
0028E4r 2                     ; editor returns the final buffer length in ARG1
0028E4r 2  A5 88              LDA   EXT_ARG1_LO
0028E6r 2  85 rr              STA   proc_body_len_lo
0028E8r 2  A5 87              LDA   EXT_ARG1_HI
0028EAr 2  85 rr              STA   proc_body_len_hi
0028ECr 2               
0028ECr 2  A5 8F              LDA   EXT_RESULT_HI
0028EEr 2  F0 08              BEQ   @abandoned
0028F0r 2                     ; Strip line 1 + the END line -> proc_body_src/proc_body_len = body only.
0028F0r 2  20 rr rr           JSR   proc_extract_body
0028F3r 2  20 rr rr           JSR   proc_build_record
0028F6r 2  38                 SEC
0028F7r 2  60                 RTS
0028F8r 2               @abandoned:
0028F8r 2  18                 CLC
0028F9r 2  60                 RTS
0028FAr 2               
0028FAr 2               ; ---------------------------------------------------------------------
0028FAr 2               ; proc_extract_body — narrow proc_body_buf/proc_body_len down to just the body:
0028FAr 2               ;   everything after the first '\n' (line 1) up to (not including) the line that
0028FAr 2               ;   reads "END". Sets proc_body_src_lo/hi + proc_body_len_lo/hi.
0028FAr 2               ; ---------------------------------------------------------------------
0028FAr 2               proc_extract_body:
0028FAr 2  A9 rr              LDA   #<proc_body_buf
0028FCr 2  85 rr              STA   proc_ptr_lo
0028FEr 2  A9 rr              LDA   #>proc_body_buf
002900r 2  85 rr              STA   proc_ptr_hi
002902r 2  9C rr rr           STZ   proc_scan_off_lo
002905r 2  9C rr rr           STZ   proc_scan_off_hi
002908r 2               @find_nl:
002908r 2  20 rr rr           JSR   proc_scan_at_end
00290Br 2  B0 4F              BCS   @whole                ; no newline -> whole buffer is the body
00290Dr 2  A0 00              LDY   #0
00290Fr 2  B1 rr              LDA   (proc_ptr_lo),Y
002911r 2  20 rr rr           JSR   proc_scan_advance
002914r 2  C9 0A              CMP   #$0A
002916r 2  D0 F0              BNE   @find_nl
002918r 2                     ; body starts here
002918r 2  A5 rr              LDA   proc_ptr_lo
00291Ar 2  8D rr rr           STA   proc_body_src_lo
00291Dr 2  A5 rr              LDA   proc_ptr_hi
00291Fr 2  8D rr rr           STA   proc_body_src_hi
002922r 2  AD rr rr           LDA   proc_scan_off_lo
002925r 2  8D rr rr           STA   num_tmp_lo            ; body-start offset
002928r 2  AD rr rr           LDA   proc_scan_off_hi
00292Br 2  8D rr rr           STA   num_tmp_hi
00292Er 2               @line:
00292Er 2  20 rr rr           JSR   proc_scan_at_end
002931r 2  B0 17              BCS   @body_end             ; ran off the end -> body = rest
002933r 2  20 rr rr           JSR   proc_line_is_end
002936r 2  B0 12              BCS   @body_end             ; this line is "END" -> stop
002938r 2               @skip:
002938r 2  20 rr rr           JSR   proc_scan_at_end
00293Br 2  B0 0D              BCS   @body_end
00293Dr 2  A0 00              LDY   #0
00293Fr 2  B1 rr              LDA   (proc_ptr_lo),Y
002941r 2  20 rr rr           JSR   proc_scan_advance
002944r 2  C9 0A              CMP   #$0A
002946r 2  D0 F0              BNE   @skip
002948r 2  80 E4              BRA   @line
00294Ar 2               @body_end:
00294Ar 2  38                 SEC
00294Br 2  AD rr rr           LDA   proc_scan_off_lo
00294Er 2  ED rr rr           SBC   num_tmp_lo
002951r 2  85 rr              STA   proc_body_len_lo
002953r 2  AD rr rr           LDA   proc_scan_off_hi
002956r 2  ED rr rr           SBC   num_tmp_hi
002959r 2  85 rr              STA   proc_body_len_hi
00295Br 2  60                 RTS
00295Cr 2               @whole:
00295Cr 2  A9 rr              LDA   #<proc_body_buf
00295Er 2  8D rr rr           STA   proc_body_src_lo
002961r 2  A9 rr              LDA   #>proc_body_buf
002963r 2  8D rr rr           STA   proc_body_src_hi
002966r 2  60                 RTS
002967r 2               
002967r 2               ; carry set if proc_scan_off >= proc_body_len
002967r 2               proc_scan_at_end:
002967r 2  AD rr rr           LDA   proc_scan_off_lo
00296Ar 2  C5 rr              CMP   proc_body_len_lo
00296Cr 2  AD rr rr           LDA   proc_scan_off_hi
00296Fr 2  E5 rr              SBC   proc_body_len_hi
002971r 2  60                 RTS
002972r 2               
002972r 2               ; advance the scan pointer + offset by one byte
002972r 2               proc_scan_advance:
002972r 2  E6 rr              INC   proc_ptr_lo
002974r 2  D0 02              BNE   :+
002976r 2  E6 rr              INC   proc_ptr_hi
002978r 2  EE rr rr     :     INC   proc_scan_off_lo
00297Br 2  D0 03              BNE   :+
00297Dr 2  EE rr rr           INC   proc_scan_off_hi
002980r 2  60           :     RTS
002981r 2               
002981r 2               ; proc_line_is_end — carry set if the line at proc_ptr is exactly "END" followed
002981r 2               ; by '\n' or end-of-buffer. Needs room for 3 chars (off+3 <= len). Non-destructive.
002981r 2               proc_line_is_end:
002981r 2                     ; proc_entry = proc_scan_off + 3
002981r 2  18                 CLC
002982r 2  AD rr rr           LDA   proc_scan_off_lo
002985r 2  69 03              ADC   #3
002987r 2  85 rr              STA   proc_entry_lo
002989r 2  AD rr rr           LDA   proc_scan_off_hi
00298Cr 2  69 00              ADC   #0
00298Er 2  85 rr              STA   proc_entry_hi
002990r 2                     ; need off+3 <= len, i.e. NOT (off+3 > len) == NOT (len < off+3)
002990r 2  A5 rr              LDA   proc_body_len_lo
002992r 2  C5 rr              CMP   proc_entry_lo
002994r 2  A5 rr              LDA   proc_body_len_hi
002996r 2  E5 rr              SBC   proc_entry_hi
002998r 2  90 2B              BCC   @no                   ; len < off+3 -> not enough room
00299Ar 2  A0 00              LDY   #0
00299Cr 2  B1 rr              LDA   (proc_ptr_lo),Y
00299Er 2  C9 45              CMP   #'E'
0029A0r 2  D0 23              BNE   @no
0029A2r 2  C8                 INY
0029A3r 2  B1 rr              LDA   (proc_ptr_lo),Y
0029A5r 2  C9 4E              CMP   #'N'
0029A7r 2  D0 1C              BNE   @no
0029A9r 2  C8                 INY
0029AAr 2  B1 rr              LDA   (proc_ptr_lo),Y
0029ACr 2  C9 44              CMP   #'D'
0029AEr 2  D0 15              BNE   @no
0029B0r 2                     ; 4th byte: '\n', or off+3 == len (END at buffer end)
0029B0r 2  A5 rr              LDA   proc_entry_lo
0029B2r 2  C5 rr              CMP   proc_body_len_lo
0029B4r 2  D0 06              BNE   @check_nl
0029B6r 2  A5 rr              LDA   proc_entry_hi
0029B8r 2  C5 rr              CMP   proc_body_len_hi
0029BAr 2  F0 07              BEQ   @yes                  ; off+3 == len
0029BCr 2               @check_nl:
0029BCr 2  C8                 INY
0029BDr 2  B1 rr              LDA   (proc_ptr_lo),Y
0029BFr 2  C9 0A              CMP   #$0A
0029C1r 2  D0 02              BNE   @no
0029C3r 2               @yes:
0029C3r 2  38                 SEC
0029C4r 2  60                 RTS
0029C5r 2               @no:
0029C5r 2  18                 CLC
0029C6r 2  60                 RTS
0029C7r 2               
0029C7r 2               ; ---------------------------------------------------------------------
0029C7r 2               ; heap_alloc_big — allocate for procedure records (16-bit payload)
0029C7r 2               ;   Input:  proc_ptr_lo/hi = record data size (16-bit)
0029C7r 2               ;   Output: proc_entry_lo/hi = pointer to record data (payload+2)
0029C7r 2               ;           Carry clear = success, Carry set = OOM
0029C7r 2               ;
0029C7r 2               ;   Layout: [GC_HDR_TAG, GC_HDR_SIZE=0, total_lo, total_hi, ...data...]
0029C7r 2               ;   GC header (2 bytes) + 16-bit size (2 bytes) + record data.
0029C7r 2               ;   Total allocation = record_data_size + 4.
0029C7r 2               ;   GC_HDR_SIZE = 0 tells GC to read 16-bit total from payload[0..1].
0029C7r 2               ;   proc_entry points to data (base+4).
0029C7r 2               ;
0029C7r 2               ;   Clobbers: A, Y, ptr_lo/hi
0029C7r 2               ; ---------------------------------------------------------------------
0029C7r 2               heap_alloc_big:
0029C7r 2                     ; Total allocation = data_size + 4 (2 hdr + 2 size field)
0029C7r 2  18                 CLC
0029C8r 2  A5 rr              LDA   proc_ptr_lo
0029CAr 2  69 04              ADC   #4
0029CCr 2  48                 PHA                        ; save total_lo
0029CDr 2  A5 rr              LDA   proc_ptr_hi
0029CFr 2  69 00              ADC   #0
0029D1r 2  48                 PHA                        ; save total_hi
0029D2r 2               
0029D2r 2                     ; Save current heap_ptr as base
0029D2r 2  A5 rr              LDA   heap_ptr
0029D4r 2  85 rr              STA   proc_entry_lo
0029D6r 2  A5 rr              LDA   heap_ptr+1
0029D8r 2  85 rr              STA   proc_entry_hi
0029DAr 2               
0029DAr 2                     ; Advance heap_ptr by total
0029DAr 2  BA                 TSX
0029DBr 2  18                 CLC
0029DCr 2  A5 rr              LDA   heap_ptr
0029DEr 2  7D 02 01           ADC   $0102,X              ; total_lo
0029E1r 2  85 rr              STA   heap_ptr
0029E3r 2  A5 rr              LDA   heap_ptr+1
0029E5r 2  7D 01 01           ADC   $0101,X              ; total_hi
0029E8r 2  85 rr              STA   heap_ptr+1
0029EAr 2               
0029EAr 2                     ; OOM check
0029EAr 2  C9 98              CMP   #>HEAP_END
0029ECr 2  90 16              BCC   @big_ok
0029EEr 2  D0 08              BNE   @big_oom
0029F0r 2  A5 rr              LDA   heap_ptr
0029F2r 2  C9 00              CMP   #<HEAP_END
0029F4r 2  90 0E              BCC   @big_ok
0029F6r 2  F0 0C              BEQ   @big_ok
0029F8r 2               @big_oom:
0029F8r 2  A5 rr              LDA   proc_entry_lo
0029FAr 2  85 rr              STA   heap_ptr
0029FCr 2  A5 rr              LDA   proc_entry_hi
0029FEr 2  85 rr              STA   heap_ptr+1
002A00r 2  68                 PLA
002A01r 2  68                 PLA
002A02r 2  38                 SEC
002A03r 2  60                 RTS
002A04r 2               @big_ok:
002A04r 2                     ; Write header at base (proc_entry = base here)
002A04r 2  A5 rr              LDA   proc_entry_lo
002A06r 2  85 rr              STA   ptr_lo
002A08r 2  A5 rr              LDA   proc_entry_hi
002A0Ar 2  85 rr              STA   ptr_hi
002A0Cr 2               
002A0Cr 2  A0 00              LDY   #GC_HDR_TAG
002A0Er 2  A9 04              LDA   #ATYPE_PROC
002A10r 2  91 rr              STA   (ptr_lo),Y
002A12r 2               
002A12r 2  A0 01              LDY   #GC_HDR_SIZE
002A14r 2  A9 00              LDA   #0                    ; 0 = 16-bit size at payload[0..1]
002A16r 2  91 rr              STA   (ptr_lo),Y
002A18r 2               
002A18r 2                     ; Write 16-bit total at payload offsets 0,1 (base+2, base+3)
002A18r 2  68                 PLA                        ; total_hi
002A19r 2  A0 03              LDY   #GC_HDR_BYTES+1       ; base+3
002A1Br 2  91 rr              STA   (ptr_lo),Y
002A1Dr 2  68                 PLA                        ; total_lo
002A1Er 2  A0 02              LDY   #GC_HDR_BYTES         ; base+2
002A20r 2  91 rr              STA   (ptr_lo),Y
002A22r 2               
002A22r 2                     ; Advance proc_entry to point past header+size field = base+4
002A22r 2                     ; This is where the record data starts
002A22r 2  18                 CLC
002A23r 2  A5 rr              LDA   proc_entry_lo
002A25r 2  69 04              ADC   #4
002A27r 2  85 rr              STA   proc_entry_lo
002A29r 2  A5 rr              LDA   proc_entry_hi
002A2Br 2  69 00              ADC   #0
002A2Dr 2  85 rr              STA   proc_entry_hi
002A2Fr 2               
002A2Fr 2  18                 CLC
002A30r 2  60                 RTS
002A31r 2               
002A31r 2               ; ---------------------------------------------------------------------
002A31r 2               ; proc_build_record — allocate and populate a procedure heap record
002A31r 2               ;   Uses: proc_name_buf, proc_param_buf/proc_param_end,
002A31r 2               ;         proc_body_buf/proc_body_len
002A31r 2               ; ---------------------------------------------------------------------
002A31r 2               proc_build_record:
002A31r 2                     ; Calculate total record size
002A31r 2                     ; 2 (next) + 1 (name_len) + name_len
002A31r 2                     ; + 1 (param_count) + (proc_param_end - 1) param packed bytes
002A31r 2                     ; + 2 (body_len) + body_len
002A31r 2                     ;
002A31r 2                     ; We build the total in proc_ptr_lo:proc_ptr_hi (16-bit)
002A31r 2               
002A31r 2  A9 04              LDA   #4                    ; 2(next) + 1(name_len) + 1(param_count)
002A33r 2  18                 CLC
002A34r 2  6D rr rr           ADC   proc_name_buf         ; + name_len
002A37r 2  85 rr              STA   proc_ptr_lo
002A39r 2  A9 00              LDA   #0
002A3Br 2  85 rr              STA   proc_ptr_hi
002A3Dr 2               
002A3Dr 2                     ; + param packed bytes (proc_param_end - 1)
002A3Dr 2  AD rr rr           LDA   proc_param_end
002A40r 2  38                 SEC
002A41r 2  E9 01              SBC   #1
002A43r 2  18                 CLC
002A44r 2  65 rr              ADC   proc_ptr_lo
002A46r 2  85 rr              STA   proc_ptr_lo
002A48r 2  90 02              BCC   :+
002A4Ar 2  E6 rr              INC   proc_ptr_hi
002A4Cr 2               :
002A4Cr 2                     ; + 2 (body_len field)
002A4Cr 2  18                 CLC
002A4Dr 2  A5 rr              LDA   proc_ptr_lo
002A4Fr 2  69 02              ADC   #2
002A51r 2  85 rr              STA   proc_ptr_lo
002A53r 2  90 02              BCC   :+
002A55r 2  E6 rr              INC   proc_ptr_hi
002A57r 2               :
002A57r 2                     ; + body_len
002A57r 2  18                 CLC
002A58r 2  A5 rr              LDA   proc_ptr_lo
002A5Ar 2  65 rr              ADC   proc_body_len_lo
002A5Cr 2  85 rr              STA   proc_ptr_lo
002A5Er 2  A5 rr              LDA   proc_ptr_hi
002A60r 2  65 rr              ADC   proc_body_len_hi
002A62r 2  85 rr              STA   proc_ptr_hi
002A64r 2               
002A64r 2                     ; Allocate with GC header (16-bit size via heap_alloc_big)
002A64r 2                     ; proc_ptr_lo/hi = payload size
002A64r 2  20 rr rr           JSR   heap_alloc_big
002A67r 2  90 01              BCC   @ok
002A69r 2  60                 RTS                        ; OOM
002A6Ar 2               @ok:
002A6Ar 2                     ; Fill the record using (ptr_lo),Y indirect addressing
002A6Ar 2                     ; We track Y as the write offset. For records > 256 bytes
002A6Ar 2                     ; we bump ptr_hi when Y wraps.
002A6Ar 2  A5 rr              LDA   proc_entry_lo
002A6Cr 2  85 rr              STA   ptr_lo
002A6Er 2  A5 rr              LDA   proc_entry_hi
002A70r 2  85 rr              STA   ptr_hi
002A72r 2               
002A72r 2                     ; +0,+1: next pointer = current proc_head
002A72r 2  A0 00              LDY   #0
002A74r 2  A5 rr              LDA   proc_head_lo
002A76r 2  91 rr              STA   (ptr_lo),Y
002A78r 2  C8                 INY
002A79r 2  A5 rr              LDA   proc_head_hi
002A7Br 2  91 rr              STA   (ptr_lo),Y
002A7Dr 2               
002A7Dr 2                     ; +2: name_len
002A7Dr 2  C8                 INY
002A7Er 2  AD rr rr           LDA   proc_name_buf
002A81r 2  91 rr              STA   (ptr_lo),Y
002A83r 2               
002A83r 2                     ; +3..+3+NL-1: name chars
002A83r 2  AE rr rr           LDX   proc_name_buf         ; X = char count
002A86r 2  64 rr              STZ   proc_rec_off          ; source index
002A88r 2               @bld_name:
002A88r 2  E0 00              CPX   #0
002A8Ar 2  F0 13              BEQ   @bld_name_done
002A8Cr 2  C8                 INY
002A8Dr 2  D0 02              BNE   :+
002A8Fr 2  E6 rr              INC   ptr_hi
002A91r 2  DA           :     PHX
002A92r 2  A6 rr              LDX   proc_rec_off
002A94r 2  BD rr rr           LDA   proc_name_buf+1,X
002A97r 2  FA                 PLX
002A98r 2  91 rr              STA   (ptr_lo),Y
002A9Ar 2  E6 rr              INC   proc_rec_off
002A9Cr 2  CA                 DEX
002A9Dr 2  80 E9              BRA   @bld_name
002A9Fr 2               @bld_name_done:
002A9Fr 2               
002A9Fr 2                     ; +3+NL: param_count
002A9Fr 2  C8                 INY
002AA0r 2  D0 02              BNE   :+
002AA2r 2  E6 rr              INC   ptr_hi
002AA4r 2  A5 rr        :     LDA   proc_param_cnt
002AA6r 2  91 rr              STA   (ptr_lo),Y
002AA8r 2               
002AA8r 2                     ; Copy packed param data from proc_param_buf[1..proc_param_end-1]
002AA8r 2  AD rr rr           LDA   proc_param_end
002AABr 2  C9 02              CMP   #2                    ; at least 1 = there are params
002AADr 2  90 14              BCC   @bld_params_done
002AAFr 2  A2 01              LDX   #1                    ; source index (skip count byte)
002AB1r 2               @bld_param:
002AB1r 2  EC rr rr           CPX   proc_param_end
002AB4r 2  B0 0D              BCS   @bld_params_done
002AB6r 2  C8                 INY
002AB7r 2  D0 02              BNE   :+
002AB9r 2  E6 rr              INC   ptr_hi
002ABBr 2  BD rr rr     :     LDA   proc_param_buf,X
002ABEr 2  91 rr              STA   (ptr_lo),Y
002AC0r 2  E8                 INX
002AC1r 2  80 EE              BRA   @bld_param
002AC3r 2               @bld_params_done:
002AC3r 2               
002AC3r 2                     ; body_len_lo, body_len_hi
002AC3r 2  C8                 INY
002AC4r 2  D0 02              BNE   :+
002AC6r 2  E6 rr              INC   ptr_hi
002AC8r 2  A5 rr        :     LDA   proc_body_len_lo
002ACAr 2  91 rr              STA   (ptr_lo),Y
002ACCr 2  C8                 INY
002ACDr 2  D0 02              BNE   :+
002ACFr 2  E6 rr              INC   ptr_hi
002AD1r 2  A5 rr        :     LDA   proc_body_len_hi
002AD3r 2  91 rr              STA   (ptr_lo),Y
002AD5r 2               
002AD5r 2                     ; Copy body text (proc_body_src points at the body region of the buffer)
002AD5r 2  A5 rr              LDA   proc_body_len_lo
002AD7r 2  05 rr              ORA   proc_body_len_hi
002AD9r 2  F0 3A              BEQ   @bld_body_done
002ADBr 2               
002ADBr 2  AD rr rr           LDA   proc_body_src_lo
002ADEr 2  85 rr              STA   proc_ptr_lo
002AE0r 2  AD rr rr           LDA   proc_body_src_hi
002AE3r 2  85 rr              STA   proc_ptr_hi
002AE5r 2                     ; 16-bit counter
002AE5r 2  A5 rr              LDA   proc_body_len_lo
002AE7r 2  8D rr rr           STA   num_tmp_lo
002AEAr 2  A5 rr              LDA   proc_body_len_hi
002AECr 2  8D rr rr           STA   num_tmp_hi
002AEFr 2               
002AEFr 2               @bld_body:
002AEFr 2  C8                 INY
002AF0r 2  D0 02              BNE   :+
002AF2r 2  E6 rr              INC   ptr_hi
002AF4r 2  5A           :     PHY
002AF5r 2  A0 00              LDY   #0
002AF7r 2  B1 rr              LDA   (proc_ptr_lo),Y
002AF9r 2  7A                 PLY
002AFAr 2  91 rr              STA   (ptr_lo),Y
002AFCr 2                     ; Advance source
002AFCr 2  E6 rr              INC   proc_ptr_lo
002AFEr 2  D0 02              BNE   :+
002B00r 2  E6 rr              INC   proc_ptr_hi
002B02r 2               :     ; Decrement counter
002B02r 2  AD rr rr           LDA   num_tmp_lo
002B05r 2  D0 03              BNE   @bld_dec_lo
002B07r 2  CE rr rr           DEC   num_tmp_hi
002B0Ar 2               @bld_dec_lo:
002B0Ar 2  CE rr rr           DEC   num_tmp_lo
002B0Dr 2  AD rr rr           LDA   num_tmp_lo
002B10r 2  0D rr rr           ORA   num_tmp_hi
002B13r 2  D0 DA              BNE   @bld_body
002B15r 2               
002B15r 2               @bld_body_done:
002B15r 2                     ; Prepend to directory
002B15r 2  A5 rr              LDA   proc_entry_lo
002B17r 2  85 rr              STA   proc_head_lo
002B19r 2  A5 rr              LDA   proc_entry_hi
002B1Br 2  85 rr              STA   proc_head_hi
002B1Dr 2  60                 RTS
002B1Er 2               
002B1Er 2               ; ---------------------------------------------------------------------
002B1Er 2               ; proc_lookup — search for a procedure by name
002B1Er 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
002B1Er 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002B1Er 2               ;           carry set = not found
002B1Er 2               ; ---------------------------------------------------------------------
002B1Er 2               proc_lookup:
002B1Er 2  A5 rr              LDA   proc_head_lo
002B20r 2  85 rr              STA   proc_entry_lo
002B22r 2  A5 rr              LDA   proc_head_hi
002B24r 2  85 rr              STA   proc_entry_hi
002B26r 2               
002B26r 2               @walk:
002B26r 2  A5 rr              LDA   proc_entry_lo
002B28r 2  05 rr              ORA   proc_entry_hi
002B2Ar 2  F0 1D              BEQ   @not_found
002B2Cr 2               
002B2Cr 2  20 rr rr           JSR   proc_names_equal
002B2Fr 2  B0 16              BCS   @found
002B31r 2               
002B31r 2                     ; Follow next pointer
002B31r 2  A5 rr              LDA   proc_entry_lo
002B33r 2  85 rr              STA   ptr_lo
002B35r 2  A5 rr              LDA   proc_entry_hi
002B37r 2  85 rr              STA   ptr_hi
002B39r 2  A0 00              LDY   #0
002B3Br 2  B1 rr              LDA   (ptr_lo),Y
002B3Dr 2  AA                 TAX
002B3Er 2  C8                 INY
002B3Fr 2  B1 rr              LDA   (ptr_lo),Y
002B41r 2  85 rr              STA   proc_entry_hi
002B43r 2  86 rr              STX   proc_entry_lo
002B45r 2  80 DF              BRA   @walk
002B47r 2               
002B47r 2               @found:
002B47r 2  18                 CLC
002B48r 2  60                 RTS
002B49r 2               @not_found:
002B49r 2  38                 SEC
002B4Ar 2  60                 RTS
002B4Br 2               
002B4Br 2               ; ---------------------------------------------------------------------
002B4Br 2               ; proc_names_equal — compare token word vs record name
002B4Br 2               ;   Input: eval_cur_lo/hi = TOK_WORD, proc_entry_lo/hi = record
002B4Br 2               ;   Returns: carry set = equal, carry clear = not equal
002B4Br 2               ; ---------------------------------------------------------------------
002B4Br 2               proc_names_equal:
002B4Br 2                     ; Token name length
002B4Br 2  A5 rr              LDA   eval_cur_lo
002B4Dr 2  85 rr              STA   ptr_lo
002B4Fr 2  A5 rr              LDA   eval_cur_hi
002B51r 2  85 rr              STA   ptr_hi
002B53r 2  A0 03              LDY   #TOK_PAYLOAD
002B55r 2  B1 rr              LDA   (ptr_lo),Y
002B57r 2  85 rr              STA   proc_name_len         ; token name length
002B59r 2               
002B59r 2                     ; Record name length
002B59r 2  A5 rr              LDA   proc_entry_lo
002B5Br 2  85 rr              STA   ptr_lo
002B5Dr 2  A5 rr              LDA   proc_entry_hi
002B5Fr 2  85 rr              STA   ptr_hi
002B61r 2  A0 02              LDY   #2
002B63r 2  B1 rr              LDA   (ptr_lo),Y
002B65r 2               
002B65r 2  C5 rr              CMP   proc_name_len
002B67r 2  D0 37              BNE   @ne
002B69r 2               
002B69r 2                     ; Lengths match — compare chars
002B69r 2  AA                 TAX                         ; X = length
002B6Ar 2  F0 30              BEQ   @eq
002B6Cr 2  A0 00              LDY   #0                    ; char index
002B6Er 2               @cmp:
002B6Er 2  DA                 PHX
002B6Fr 2  5A                 PHY
002B70r 2                     ; Token char at eval_cur + TOK_PAYLOAD + 1 + charIdx
002B70r 2  A5 rr              LDA   eval_cur_lo
002B72r 2  85 rr              STA   ptr_lo
002B74r 2  A5 rr              LDA   eval_cur_hi
002B76r 2  85 rr              STA   ptr_hi
002B78r 2  98                 TYA
002B79r 2  18                 CLC
002B7Ar 2  69 04              ADC   #TOK_PAYLOAD+1
002B7Cr 2  A8                 TAY
002B7Dr 2  B1 rr              LDA   (ptr_lo),Y
002B7Fr 2  85 rr              STA   proc_rec_off          ; temp: token char
002B81r 2               
002B81r 2                     ; Record char at proc_entry + 3 + charIdx
002B81r 2  7A                 PLY
002B82r 2  5A                 PHY
002B83r 2  A5 rr              LDA   proc_entry_lo
002B85r 2  85 rr              STA   ptr_lo
002B87r 2  A5 rr              LDA   proc_entry_hi
002B89r 2  85 rr              STA   ptr_hi
002B8Br 2  98                 TYA
002B8Cr 2  18                 CLC
002B8Dr 2  69 03              ADC   #3
002B8Fr 2  A8                 TAY
002B90r 2  B1 rr              LDA   (ptr_lo),Y
002B92r 2               
002B92r 2  C5 rr              CMP   proc_rec_off
002B94r 2  D0 08              BNE   @ne_pop
002B96r 2  7A                 PLY
002B97r 2  FA                 PLX
002B98r 2  C8                 INY
002B99r 2  CA                 DEX
002B9Ar 2  D0 D2              BNE   @cmp
002B9Cr 2               @eq:
002B9Cr 2  38                 SEC
002B9Dr 2  60                 RTS
002B9Er 2               @ne_pop:
002B9Er 2  7A                 PLY
002B9Fr 2  FA                 PLX
002BA0r 2               @ne:
002BA0r 2  18                 CLC
002BA1r 2  60                 RTS
002BA2r 2               
002BA2r 2               ; ---------------------------------------------------------------------
002BA2r 2               ; proc_invoke — invoke a user-defined procedure
002BA2r 2               ;   Input: eval_cur_lo/hi = TOK_WORD token (the procedure name)
002BA2r 2               ;          proc_entry_lo/hi = matching procedure record
002BA2r 2               ;   On exit: JMPs to eval_loop or eval_body to continue.
002BA2r 2               ; ---------------------------------------------------------------------
002BA2r 2               proc_invoke:
002BA2r 2                     ; Save outer tokenizer and eval state on the hardware stack.
002BA2r 2                     ; We push: tok_head(2), tok_tail(2), eval_in_body(1),
002BA2r 2                     ;          proc_stopped(1) = 6 bytes.
002BA2r 2                     ; input_buf is saved to BSS (128 bytes too large for stack).
002BA2r 2  A5 rr              LDA   tok_head_lo
002BA4r 2  48                 PHA
002BA5r 2  A5 rr              LDA   tok_head_hi
002BA7r 2  48                 PHA
002BA8r 2  A5 rr              LDA   tok_tail_lo
002BAAr 2  48                 PHA
002BABr 2  A5 rr              LDA   tok_tail_hi
002BADr 2  48                 PHA
002BAEr 2  A5 rr              LDA   eval_in_body
002BB0r 2  48                 PHA
002BB1r 2  A5 rr              LDA   proc_stopped
002BB3r 2  48                 PHA
002BB4r 2               
002BB4r 2                     ; Save input_buf to BSS save area
002BB4r 2  A2 00              LDX   #0
002BB6r 2               @save_ib:
002BB6r 2  BD rr rr           LDA   input_buf,X
002BB9r 2  9D rr rr           STA   save_input_buf,X
002BBCr 2  E8                 INX
002BBDr 2  E0 80              CPX   #128
002BBFr 2  D0 F5              BNE   @save_ib
002BC1r 2               
002BC1r 2                     ; Advance eval_cur past the procedure name token
002BC1r 2  20 rr rr           JSR   eval_advance
002BC4r 2               
002BC4r 2                     ; --- Bind parameters ---
002BC4r 2                     ; Navigate to param_count in the record:
002BC4r 2                     ;   offset = 3 + name_len
002BC4r 2  A5 rr              LDA   proc_entry_lo
002BC6r 2  85 rr              STA   ptr_lo
002BC8r 2  A5 rr              LDA   proc_entry_hi
002BCAr 2  85 rr              STA   ptr_hi
002BCCr 2  A0 02              LDY   #2
002BCEr 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002BD0r 2  18                 CLC
002BD1r 2  69 03              ADC   #3
002BD3r 2  A8                 TAY                         ; Y = offset to param_count
002BD4r 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002BD6r 2  85 rr              STA   proc_param_cnt
002BD8r 2  C8                 INY                         ; Y = offset to first param name
002BD9r 2  84 rr              STY   proc_rec_off          ; save record offset
002BDBr 2               
002BDBr 2  A5 rr              LDA   proc_param_cnt
002BDDr 2  F0 5C              BEQ   @bind_done
002BDFr 2               
002BDFr 2  A6 rr              LDX   proc_param_cnt
002BE1r 2               @bind_loop:
002BE1r 2  DA                 PHX                         ; save remaining param count
002BE2r 2               
002BE2r 2                     ; First: evaluate the next argument from the caller's token stream.
002BE2r 2                     ; eval_cur still points into the caller's token list.
002BE2r 2  20 rr rr           JSR   eval_expr
002BE5r 2  90 03              BCC   @arg_ok
002BE7r 2  4C rr rr           JMP   @bind_err
002BEAr 2               @arg_ok:
002BEAr 2               
002BEAr 2                     ; eval_val now holds the argument value.
002BEAr 2                     ; Push value onto stack (type + 3 value bytes = 4 bytes)
002BEAr 2  A5 rr              LDA   eval_val_frac
002BECr 2  48                 PHA
002BEDr 2  A5 rr              LDA   eval_val_lo
002BEFr 2  48                 PHA
002BF0r 2  A5 rr              LDA   eval_val_hi
002BF2r 2  48                 PHA
002BF3r 2  A5 rr              LDA   eval_type
002BF5r 2  48                 PHA
002BF6r 2               
002BF6r 2                     ; Build the param name as a length-prefixed string in param_name_tmp
002BF6r 2                     ; Read from record at proc_entry + proc_rec_off
002BF6r 2  A5 rr              LDA   proc_entry_lo
002BF8r 2  85 rr              STA   ptr_lo
002BFAr 2  A5 rr              LDA   proc_entry_hi
002BFCr 2  85 rr              STA   ptr_hi
002BFEr 2  A4 rr              LDY   proc_rec_off
002C00r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002C02r 2  8D rr rr           STA   param_name_tmp        ; length byte
002C05r 2  AA                 TAX                         ; X = char count
002C06r 2  A9 00              LDA   #0
002C08r 2  85 rr              STA   proc_name_len         ; dest offset in param_name_tmp
002C0Ar 2               @bind_ch:
002C0Ar 2  E0 00              CPX   #0
002C0Cr 2  F0 0F              BEQ   @bind_ch_done
002C0Er 2  C8                 INY
002C0Fr 2  B1 rr              LDA   (ptr_lo),Y
002C11r 2  DA                 PHX
002C12r 2  A6 rr              LDX   proc_name_len
002C14r 2  9D rr rr           STA   param_name_tmp+1,X
002C17r 2  E6 rr              INC   proc_name_len
002C19r 2  FA                 PLX
002C1Ar 2  CA                 DEX
002C1Br 2  80 ED              BRA   @bind_ch
002C1Dr 2               @bind_ch_done:
002C1Dr 2                     ; Advance proc_rec_off past this param
002C1Dr 2  C8                 INY
002C1Er 2  84 rr              STY   proc_rec_off
002C20r 2               
002C20r 2                     ; Pop value from stack back into eval_val
002C20r 2  68                 PLA
002C21r 2  85 rr              STA   eval_type
002C23r 2  68                 PLA
002C24r 2  85 rr              STA   eval_val_hi
002C26r 2  68                 PLA
002C27r 2  85 rr              STA   eval_val_lo
002C29r 2  68                 PLA
002C2Ar 2  85 rr              STA   eval_val_frac
002C2Cr 2               
002C2Cr 2                     ; Call var_set with ptr_lo/hi → param_name_tmp
002C2Cr 2  A9 rr              LDA   #<param_name_tmp
002C2Er 2  85 rr              STA   ptr_lo
002C30r 2  A9 rr              LDA   #>param_name_tmp
002C32r 2  85 rr              STA   ptr_hi
002C34r 2  20 rr rr           JSR   var_set
002C37r 2               
002C37r 2  FA                 PLX                         ; restore remaining count
002C38r 2  CA                 DEX
002C39r 2  D0 A6              BNE   @bind_loop
002C3Br 2               
002C3Br 2               @bind_done:
002C3Br 2                     ; Save heap pointer AFTER param binding so var_set allocations persist.
002C3Br 2                     ; Body tokenization will reuse heap from this point each line.
002C3Br 2  A5 rr              LDA   heap_ptr
002C3Dr 2  8D rr rr           STA   save_heap_ptr_lo
002C40r 2  A5 rr              LDA   heap_ptr+1
002C42r 2  8D rr rr           STA   save_heap_ptr_hi
002C45r 2               
002C45r 2                     ; Save eval_cur (resume point after all args consumed from caller)
002C45r 2  A5 rr              LDA   eval_cur_lo
002C47r 2  8D rr rr           STA   save_eval_cur_lo
002C4Ar 2  A5 rr              LDA   eval_cur_hi
002C4Cr 2  8D rr rr           STA   save_eval_cur_hi
002C4Fr 2               
002C4Fr 2                     ; --- Execute the body ---
002C4Fr 2                     ; Navigate to body in the record:
002C4Fr 2                     ;   proc_rec_off now points past all params.
002C4Fr 2                     ;   Next 2 bytes = body_len, then body text.
002C4Fr 2  A5 rr              LDA   proc_entry_lo
002C51r 2  85 rr              STA   ptr_lo
002C53r 2  A5 rr              LDA   proc_entry_hi
002C55r 2  85 rr              STA   ptr_hi
002C57r 2  A4 rr              LDY   proc_rec_off
002C59r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_lo
002C5Br 2  85 rr              STA   proc_body_len_lo
002C5Dr 2  C8                 INY
002C5Er 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_hi
002C60r 2  85 rr              STA   proc_body_len_hi
002C62r 2  C8                 INY                         ; Y = offset to body text start
002C63r 2  84 rr              STY   proc_rec_off
002C65r 2               
002C65r 2                     ; Compute absolute pointer to body text start
002C65r 2  18                 CLC
002C66r 2  A5 rr              LDA   proc_entry_lo
002C68r 2  65 rr              ADC   proc_rec_off
002C6Ar 2  85 rr              STA   proc_ptr_lo
002C6Cr 2  A5 rr              LDA   proc_entry_hi
002C6Er 2  69 00              ADC   #0
002C70r 2  85 rr              STA   proc_ptr_hi
002C72r 2               
002C72r 2                     ; Process body line by line: find each $0A, copy line to input_buf,
002C72r 2                     ; tokenize, eval, repeat.
002C72r 2                     ; proc_ptr = current position in body text
002C72r 2                     ; proc_body_len = remaining bytes
002C72r 2               
002C72r 2                     ; Clear STOP/OUTPUT flag before executing body
002C72r 2  64 rr              STZ   proc_stopped
002C74r 2               
002C74r 2               @exec_line:
002C74r 2                     ; Any body text remaining?
002C74r 2  A5 rr              LDA   proc_body_len_lo
002C76r 2  05 rr              ORA   proc_body_len_hi
002C78r 2  D0 03              BNE   @have_body
002C7Ar 2  4C rr rr           JMP   @exec_done
002C7Dr 2               @have_body:
002C7Dr 2               
002C7Dr 2                     ; Reset heap for this line's tokens (reuse token heap each line)
002C7Dr 2  AD rr rr           LDA   save_heap_ptr_lo
002C80r 2  85 rr              STA   heap_ptr
002C82r 2  AD rr rr           LDA   save_heap_ptr_hi
002C85r 2  85 rr              STA   heap_ptr+1
002C87r 2               
002C87r 2                     ; Copy characters from body to input_buf until $0A or end
002C87r 2  A2 00              LDX   #0                    ; input_buf index
002C89r 2               @line_ch:
002C89r 2  A5 rr              LDA   proc_body_len_lo
002C8Br 2  05 rr              ORA   proc_body_len_hi
002C8Dr 2  F0 2A              BEQ   @line_end             ; no more body text
002C8Fr 2               
002C8Fr 2  A0 00              LDY   #0
002C91r 2  B1 rr              LDA   (proc_ptr_lo),Y      ; read body char
002C93r 2  C9 0A              CMP   #$0A
002C95r 2  F0 14              BEQ   @line_nl
002C97r 2               
002C97r 2                     ; Store in input_buf
002C97r 2  9D rr rr           STA   input_buf,X
002C9Ar 2  E8                 INX
002C9Br 2               
002C9Br 2                     ; Advance body pointer
002C9Br 2  E6 rr              INC   proc_ptr_lo
002C9Dr 2  D0 02              BNE   :+
002C9Fr 2  E6 rr              INC   proc_ptr_hi
002CA1r 2               :     ; Decrement remaining
002CA1r 2  A5 rr              LDA   proc_body_len_lo
002CA3r 2  D0 02              BNE   @ln_dec_lo
002CA5r 2  C6 rr              DEC   proc_body_len_hi
002CA7r 2               @ln_dec_lo:
002CA7r 2  C6 rr              DEC   proc_body_len_lo
002CA9r 2  80 DE              BRA   @line_ch
002CABr 2               
002CABr 2               @line_nl:
002CABr 2                     ; Skip the $0A
002CABr 2  E6 rr              INC   proc_ptr_lo
002CADr 2  D0 02              BNE   :+
002CAFr 2  E6 rr              INC   proc_ptr_hi
002CB1r 2  A5 rr        :     LDA   proc_body_len_lo
002CB3r 2  D0 02              BNE   @ln2_dec_lo
002CB5r 2  C6 rr              DEC   proc_body_len_hi
002CB7r 2               @ln2_dec_lo:
002CB7r 2  C6 rr              DEC   proc_body_len_lo
002CB9r 2               
002CB9r 2               @line_end:
002CB9r 2                     ; Null-terminate input_buf
002CB9r 2  9E rr rr           STZ   input_buf,X
002CBCr 2               
002CBCr 2                     ; Tokenize this line
002CBCr 2  20 rr rr           JSR   tokenize_line
002CBFr 2               
002CBFr 2                     ; Save body-loop state that recursive proc_invoke would clobber.
002CBFr 2                     ; BSS save areas (save_heap_ptr, save_eval_cur) plus ZP body-loop
002CBFr 2                     ; variables (proc_ptr, proc_body_len) all need protection.
002CBFr 2  A5 rr              LDA   proc_ptr_lo
002CC1r 2  48                 PHA
002CC2r 2  A5 rr              LDA   proc_ptr_hi
002CC4r 2  48                 PHA
002CC5r 2  A5 rr              LDA   proc_body_len_lo
002CC7r 2  48                 PHA
002CC8r 2  A5 rr              LDA   proc_body_len_hi
002CCAr 2  48                 PHA
002CCBr 2  AD rr rr           LDA   save_heap_ptr_lo
002CCEr 2  48                 PHA
002CCFr 2  AD rr rr           LDA   save_heap_ptr_hi
002CD2r 2  48                 PHA
002CD3r 2  AD rr rr           LDA   save_eval_cur_lo
002CD6r 2  48                 PHA
002CD7r 2  AD rr rr           LDA   save_eval_cur_hi
002CDAr 2  48                 PHA
002CDBr 2               
002CDBr 2                     ; Eval this line (full eval — not body mode)
002CDBr 2  20 rr rr           JSR   eval_line
002CDEr 2               
002CDEr 2                     ; Restore body-loop state
002CDEr 2  68                 PLA
002CDFr 2  8D rr rr           STA   save_eval_cur_hi
002CE2r 2  68                 PLA
002CE3r 2  8D rr rr           STA   save_eval_cur_lo
002CE6r 2  68                 PLA
002CE7r 2  8D rr rr           STA   save_heap_ptr_hi
002CEAr 2  68                 PLA
002CEBr 2  8D rr rr           STA   save_heap_ptr_lo
002CEEr 2  68                 PLA
002CEFr 2  85 rr              STA   proc_body_len_hi
002CF1r 2  68                 PLA
002CF2r 2  85 rr              STA   proc_body_len_lo
002CF4r 2  68                 PLA
002CF5r 2  85 rr              STA   proc_ptr_hi
002CF7r 2  68                 PLA
002CF8r 2  85 rr              STA   proc_ptr_lo
002CFAr 2               
002CFAr 2                     ; Check if STOP or OUTPUT was called — stop processing lines
002CFAr 2  A5 rr              LDA   proc_stopped
002CFCr 2  D0 03              BNE   @exec_done
002CFEr 2               
002CFEr 2  4C rr rr           JMP   @exec_line
002D01r 2               
002D01r 2               @exec_done:
002D01r 2                     ; Restore heap pointer (procedures stay, but per-line tokens freed)
002D01r 2  AD rr rr           LDA   save_heap_ptr_lo
002D04r 2  85 rr              STA   heap_ptr
002D06r 2  AD rr rr           LDA   save_heap_ptr_hi
002D09r 2  85 rr              STA   heap_ptr+1
002D0Br 2               
002D0Br 2                     ; Restore input_buf
002D0Br 2  A2 00              LDX   #0
002D0Dr 2               @rest_ib:
002D0Dr 2  BD rr rr           LDA   save_input_buf,X
002D10r 2  9D rr rr           STA   input_buf,X
002D13r 2  E8                 INX
002D14r 2  E0 80              CPX   #128
002D16r 2  D0 F5              BNE   @rest_ib
002D18r 2               
002D18r 2                     ; Restore eval_cur to the resume point in the caller's token stream
002D18r 2  AD rr rr           LDA   save_eval_cur_lo
002D1Br 2  85 rr              STA   eval_cur_lo
002D1Dr 2  AD rr rr           LDA   save_eval_cur_hi
002D20r 2  85 rr              STA   eval_cur_hi
002D22r 2               
002D22r 2                     ; Restore outer state from stack.
002D22r 2                     ; X returns this invocation's proc_stopped to the caller.
002D22r 2                     ; Stack layout (top to bottom):
002D22r 2                     ;   saved_proc_stopped, eval_in_body, tok_tail_hi, tok_tail_lo,
002D22r 2                     ;   tok_head_hi, tok_head_lo
002D22r 2  A6 rr              LDX   proc_stopped          ; X = this proc's exit state
002D24r 2  68                 PLA                         ; pop saved outer proc_stopped
002D25r 2  85 rr              STA   proc_stopped          ; restore outer proc_stopped
002D27r 2  68                 PLA
002D28r 2  85 rr              STA   eval_in_body
002D2Ar 2  68                 PLA
002D2Br 2  85 rr              STA   tok_tail_hi
002D2Dr 2  68                 PLA
002D2Er 2  85 rr              STA   tok_tail_lo
002D30r 2  68                 PLA
002D31r 2  85 rr              STA   tok_head_hi
002D33r 2  68                 PLA
002D34r 2  85 rr              STA   tok_head_lo
002D36r 2               
002D36r 2                     ; Return with X = exit status ($00=normal, $01=STOP, $02=OUTPUT)
002D36r 2  60                 RTS
002D37r 2               
002D37r 2               @bind_err:
002D37r 2  FA                 PLX                         ; discard remaining param count
002D38r 2                     ; Print error
002D38r 2  A2 00              LDX   #0
002D3Ar 2               @be_lp:
002D3Ar 2  BD rr rr           LDA   str_notenough,X
002D3Dr 2  F0 06              BEQ   @be_done
002D3Fr 2  8D 0E A0           STA   VGC_CHAROUT
002D42r 2  E8                 INX
002D43r 2  D0 F5              BNE   @be_lp
002D45r 2               @be_done:
002D45r 2  20 rr rr           JSR   eval_newline
002D48r 2                     ; Restore input_buf and stack, skip body execution
002D48r 2  A2 00              LDX   #0
002D4Ar 2               @be_rest_ib:
002D4Ar 2  BD rr rr           LDA   save_input_buf,X
002D4Dr 2  9D rr rr           STA   input_buf,X
002D50r 2  E8                 INX
002D51r 2  E0 80              CPX   #128
002D53r 2  D0 F5              BNE   @be_rest_ib
002D55r 2                     ; Restore stack (6 bytes: proc_stopped, eval_in_body, tok_tail, tok_head)
002D55r 2  A2 00              LDX   #$00                  ; X = normal exit status
002D57r 2  68                 PLA                         ; saved proc_stopped
002D58r 2  85 rr              STA   proc_stopped
002D5Ar 2  68                 PLA
002D5Br 2  85 rr              STA   eval_in_body
002D5Dr 2  68                 PLA
002D5Er 2  85 rr              STA   tok_tail_hi
002D60r 2  68                 PLA
002D61r 2  85 rr              STA   tok_tail_lo
002D63r 2  68                 PLA
002D64r 2  85 rr              STA   tok_head_hi
002D66r 2  68                 PLA
002D67r 2  85 rr              STA   tok_head_lo
002D69r 2  60                 RTS
002D6Ar 2               
002D6Ar 2               ; ---------------------------------------------------------------------
002D6Ar 2               ; proc_find_by_name — search proc_head for a procedure by name string
002D6Ar 2               ;   Input: ptr_lo/hi = length-prefixed name string (e.g. from eval_val)
002D6Ar 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002D6Ar 2               ;           carry set = not found
002D6Ar 2               ;   Clobbers: A, X, Y, proc_entry, proc_name_len, proc_rec_off
002D6Ar 2               ; ---------------------------------------------------------------------
002D6Ar 2               proc_find_by_name:
002D6Ar 2                     ; Save search name pointer
002D6Ar 2  A5 rr              LDA   ptr_lo
002D6Cr 2  85 rr              STA   var_name_lo             ; reuse var scratch as search ptr
002D6Er 2  A5 rr              LDA   ptr_hi
002D70r 2  85 rr              STA   var_name_hi
002D72r 2               
002D72r 2  A5 rr              LDA   proc_head_lo
002D74r 2  85 rr              STA   proc_entry_lo
002D76r 2  A5 rr              LDA   proc_head_hi
002D78r 2  85 rr              STA   proc_entry_hi
002D7Ar 2               
002D7Ar 2               @walk:
002D7Ar 2  A5 rr              LDA   proc_entry_lo
002D7Cr 2  05 rr              ORA   proc_entry_hi
002D7Er 2  F0 66              BEQ   @not_found
002D80r 2               
002D80r 2                     ; Compare name lengths
002D80r 2  A5 rr              LDA   var_name_lo
002D82r 2  85 rr              STA   ptr_lo
002D84r 2  A5 rr              LDA   var_name_hi
002D86r 2  85 rr              STA   ptr_hi
002D88r 2  A0 00              LDY   #0
002D8Ar 2  B1 rr              LDA   (ptr_lo),Y             ; search name length
002D8Cr 2  85 rr              STA   proc_name_len
002D8Er 2               
002D8Er 2  A5 rr              LDA   proc_entry_lo
002D90r 2  85 rr              STA   ptr_lo
002D92r 2  A5 rr              LDA   proc_entry_hi
002D94r 2  85 rr              STA   ptr_hi
002D96r 2  A0 02              LDY   #2
002D98r 2  B1 rr              LDA   (ptr_lo),Y             ; record name length
002D9Ar 2  C5 rr              CMP   proc_name_len
002D9Cr 2  D0 32              BNE   @next
002D9Er 2               
002D9Er 2                     ; Lengths match — compare chars
002D9Er 2  AA                 TAX                           ; X = length
002D9Fr 2  F0 2C              BEQ   @found                  ; both zero = match
002DA1r 2  A0 00              LDY   #0
002DA3r 2               @cmp:
002DA3r 2  DA                 PHX
002DA4r 2  5A                 PHY
002DA5r 2                     ; Search char
002DA5r 2  A5 rr              LDA   var_name_lo
002DA7r 2  85 rr              STA   ptr_lo
002DA9r 2  A5 rr              LDA   var_name_hi
002DABr 2  85 rr              STA   ptr_hi
002DADr 2  C8                 INY                           ; +1 for length byte
002DAEr 2  B1 rr              LDA   (ptr_lo),Y
002DB0r 2  85 rr              STA   proc_rec_off            ; temp: search char
002DB2r 2               
002DB2r 2                     ; Record char
002DB2r 2  7A                 PLY
002DB3r 2  A5 rr              LDA   proc_entry_lo
002DB5r 2  85 rr              STA   ptr_lo
002DB7r 2  A5 rr              LDA   proc_entry_hi
002DB9r 2  85 rr              STA   ptr_hi
002DBBr 2  5A                 PHY
002DBCr 2  98                 TYA
002DBDr 2  18                 CLC
002DBEr 2  69 03              ADC   #3                      ; record name starts at offset 3
002DC0r 2  A8                 TAY
002DC1r 2  B1 rr              LDA   (ptr_lo),Y
002DC3r 2  7A                 PLY
002DC4r 2  C5 rr              CMP   proc_rec_off
002DC6r 2  D0 07              BNE   @ne_pop
002DC8r 2  FA                 PLX
002DC9r 2  C8                 INY
002DCAr 2  CA                 DEX
002DCBr 2  D0 D6              BNE   @cmp
002DCDr 2               
002DCDr 2               @found:
002DCDr 2  18                 CLC
002DCEr 2  60                 RTS
002DCFr 2               
002DCFr 2               @ne_pop:
002DCFr 2  FA                 PLX
002DD0r 2               @next:
002DD0r 2                     ; Follow next pointer
002DD0r 2  A5 rr              LDA   proc_entry_lo
002DD2r 2  85 rr              STA   ptr_lo
002DD4r 2  A5 rr              LDA   proc_entry_hi
002DD6r 2  85 rr              STA   ptr_hi
002DD8r 2  A0 00              LDY   #0
002DDAr 2  B1 rr              LDA   (ptr_lo),Y
002DDCr 2  AA                 TAX
002DDDr 2  C8                 INY
002DDEr 2  B1 rr              LDA   (ptr_lo),Y
002DE0r 2  85 rr              STA   proc_entry_hi
002DE2r 2  86 rr              STX   proc_entry_lo
002DE4r 2  80 94              BRA   @walk
002DE6r 2               
002DE6r 2               @not_found:
002DE6r 2  38                 SEC
002DE7r 2  60                 RTS
002DE8r 2               
002DE8r 2               ; ---------------------------------------------------------------------
002DE8r 2               ; do_pots — POTS: print all procedure names
002DE8r 2               ;   Arity 0, no arguments.
002DE8r 2               ; ---------------------------------------------------------------------
002DE8r 2               do_pots:
002DE8r 2  A5 rr              LDA   proc_head_lo
002DEAr 2  85 rr              STA   proc_entry_lo
002DECr 2  A5 rr              LDA   proc_head_hi
002DEEr 2  85 rr              STA   proc_entry_hi
002DF0r 2               
002DF0r 2               @walk:
002DF0r 2  A5 rr              LDA   proc_entry_lo
002DF2r 2  05 rr              ORA   proc_entry_hi
002DF4r 2  F0 35              BEQ   @done
002DF6r 2               
002DF6r 2                     ; Print name
002DF6r 2  A5 rr              LDA   proc_entry_lo
002DF8r 2  85 rr              STA   ptr_lo
002DFAr 2  A5 rr              LDA   proc_entry_hi
002DFCr 2  85 rr              STA   ptr_hi
002DFEr 2  A0 02              LDY   #2
002E00r 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002E02r 2  AA                 TAX
002E03r 2  F0 0B              BEQ   @skip_name
002E05r 2  A0 03              LDY   #3
002E07r 2               @pch:
002E07r 2  B1 rr              LDA   (ptr_lo),Y
002E09r 2  8D 0E A0           STA   VGC_CHAROUT
002E0Cr 2  C8                 INY
002E0Dr 2  CA                 DEX
002E0Er 2  D0 F7              BNE   @pch
002E10r 2               @skip_name:
002E10r 2  A9 20              LDA   #' '
002E12r 2  8D 0E A0           STA   VGC_CHAROUT
002E15r 2               
002E15r 2                     ; Follow next
002E15r 2  A5 rr              LDA   proc_entry_lo
002E17r 2  85 rr              STA   ptr_lo
002E19r 2  A5 rr              LDA   proc_entry_hi
002E1Br 2  85 rr              STA   ptr_hi
002E1Dr 2  A0 00              LDY   #0
002E1Fr 2  B1 rr              LDA   (ptr_lo),Y
002E21r 2  AA                 TAX
002E22r 2  C8                 INY
002E23r 2  B1 rr              LDA   (ptr_lo),Y
002E25r 2  85 rr              STA   proc_entry_hi
002E27r 2  86 rr              STX   proc_entry_lo
002E29r 2  80 C5              BRA   @walk
002E2Br 2               
002E2Br 2               @done:
002E2Br 2  20 rr rr           JSR   eval_newline
002E2Er 2  4C rr rr           JMP   eval_continue
002E31r 2               
002E31r 2               ; ---------------------------------------------------------------------
002E31r 2               ; do_po — PO "name: print procedure definition
002E31r 2               ;   Arity 0 — evaluates its own argument
002E31r 2               ; ---------------------------------------------------------------------
002E31r 2               do_po:
002E31r 2  20 rr rr           JSR   eval_expr
002E34r 2  90 03              BCC   @po_type_ok
002E36r 2  4C rr rr           JMP   @err
002E39r 2               @po_type_ok:
002E39r 2  A5 rr              LDA   eval_type
002E3Br 2  C9 01              CMP   #VAL_WORD
002E3Dr 2  F0 03              BEQ   @po_word_ok
002E3Fr 2  4C rr rr           JMP   @err
002E42r 2               @po_word_ok:
002E42r 2               
002E42r 2                     ; Look up by name
002E42r 2  A5 rr              LDA   eval_val_lo
002E44r 2  85 rr              STA   ptr_lo
002E46r 2  A5 rr              LDA   eval_val_hi
002E48r 2  85 rr              STA   ptr_hi
002E4Ar 2  20 rr rr           JSR   proc_find_by_name
002E4Dr 2  90 03              BCC   @po_found
002E4Fr 2  4C rr rr           JMP   @err_notfound
002E52r 2               @po_found:
002E52r 2               
002E52r 2                     ; proc_entry_lo/hi = record
002E52r 2                     ; Print "TO "
002E52r 2  A9 54              LDA   #'T'
002E54r 2  8D 0E A0           STA   VGC_CHAROUT
002E57r 2  A9 4F              LDA   #'O'
002E59r 2  8D 0E A0           STA   VGC_CHAROUT
002E5Cr 2  A9 20              LDA   #' '
002E5Er 2  8D 0E A0           STA   VGC_CHAROUT
002E61r 2               
002E61r 2                     ; Print name
002E61r 2  A5 rr              LDA   proc_entry_lo
002E63r 2  85 rr              STA   ptr_lo
002E65r 2  A5 rr              LDA   proc_entry_hi
002E67r 2  85 rr              STA   ptr_hi
002E69r 2  A0 02              LDY   #2
002E6Br 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002E6Dr 2  AA                 TAX
002E6Er 2  85 rr              STA   proc_name_len
002E70r 2  F0 0B              BEQ   @po_params
002E72r 2  A0 03              LDY   #3
002E74r 2               @po_name_ch:
002E74r 2  B1 rr              LDA   (ptr_lo),Y
002E76r 2  8D 0E A0           STA   VGC_CHAROUT
002E79r 2  C8                 INY
002E7Ar 2  CA                 DEX
002E7Br 2  D0 F7              BNE   @po_name_ch
002E7Dr 2               
002E7Dr 2               @po_params:
002E7Dr 2                     ; Y = 3 + name_len = offset to param_count
002E7Dr 2  A5 rr              LDA   proc_name_len
002E7Fr 2  18                 CLC
002E80r 2  69 03              ADC   #3
002E82r 2  A8                 TAY
002E83r 2  B1 rr              LDA   (ptr_lo),Y             ; param_count
002E85r 2  85 rr              STA   proc_param_cnt
002E87r 2  C8                 INY                           ; offset to first param
002E88r 2  84 rr              STY   proc_rec_off
002E8Ar 2               
002E8Ar 2  A5 rr              LDA   proc_param_cnt
002E8Cr 2  F0 2E              BEQ   @po_header_done
002E8Er 2               
002E8Er 2  A6 rr              LDX   proc_param_cnt
002E90r 2               @po_param:
002E90r 2                     ; Print " :"
002E90r 2  A9 20              LDA   #' '
002E92r 2  8D 0E A0           STA   VGC_CHAROUT
002E95r 2  A9 3A              LDA   #':'
002E97r 2  8D 0E A0           STA   VGC_CHAROUT
002E9Ar 2               
002E9Ar 2                     ; Read param name length
002E9Ar 2  A5 rr              LDA   proc_entry_lo
002E9Cr 2  85 rr              STA   ptr_lo
002E9Er 2  A5 rr              LDA   proc_entry_hi
002EA0r 2  85 rr              STA   ptr_hi
002EA2r 2  A4 rr              LDY   proc_rec_off
002EA4r 2  B1 rr              LDA   (ptr_lo),Y             ; param name length
002EA6r 2  DA                 PHX
002EA7r 2  AA                 TAX                           ; X = chars to print
002EA8r 2  C8                 INY
002EA9r 2               @po_pch:
002EA9r 2  E0 00              CPX   #0
002EABr 2  F0 09              BEQ   @po_param_done
002EADr 2  B1 rr              LDA   (ptr_lo),Y
002EAFr 2  8D 0E A0           STA   VGC_CHAROUT
002EB2r 2  C8                 INY
002EB3r 2  CA                 DEX
