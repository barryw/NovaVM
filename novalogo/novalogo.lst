002FB7r 2  8D 0E A0           STA   VGC_CHAROUT
002FBAr 2  A9 20              LDA   #' '
002FBCr 2  8D 0E A0           STA   VGC_CHAROUT
002FBFr 2               
002FBFr 2                     ; Print name
