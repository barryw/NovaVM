00019Dr 2  AA                 TAX                        ; X = remaining
00019Er 2  A0 04              LDY   #TOK_PAYLOAD+1       ; Y = dest offset
0001A0r 2  9C rr rr           STZ   num_tmp_lo           ; source offset from tok_src
