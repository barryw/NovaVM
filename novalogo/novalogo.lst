00031Er 2  10 E8 64 0A        .byte <10000, <1000, <100, <10, <1
000322r 2  01           
000323r 2               pow10_hi:
000323r 2  27 03 00 00        .byte >10000, >1000, >100, >10, >1
000327r 2  00           
000328r 2               
000328r 1                     .include "builtins.s"
000328r 2               ; builtins.s — built-in command table and handlers
000328r 2               
000328r 2               ; =====================================================================
000328r 2               ; CODE segment — builtin lookup and handlers
000328r 2               ; =====================================================================
000328r 2                     .segment "CODE"
000BD7r 2               
000BD7r 2               ; ---------------------------------------------------------------------
000BD7r 2               ; lookup_builtin — search builtin table for the current TOK_WORD
000BD7r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000BD7r 2               ;   Output: Carry clear = found, ptr2_lo/hi = handler addr, A = arity
000BD7r 2               ;           Carry set = not found
000BD7r 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000BD7r 2               ; ---------------------------------------------------------------------
000BD7r 2               lookup_builtin:
000BD7r 2                     ; Save table pointer in num_tmp_lo/hi
000BD7r 2  A9 rr              LDA   #<builtin_table
000BD9r 2  8D rr rr           STA   num_tmp_lo
000BDCr 2  A9 rr              LDA   #>builtin_table
000BDEr 2  8D rr rr           STA   num_tmp_hi
000BE1r 2               
000BE1r 2               @scan:
000BE1r 2                     ; Read name pointer from table
000BE1r 2  AD rr rr           LDA   num_tmp_lo
000BE4r 2  85 rr              STA   ptr2_lo
000BE6r 2  AD rr rr           LDA   num_tmp_hi
000BE9r 2  85 rr              STA   ptr2_hi
000BEBr 2  A0 00              LDY   #0
000BEDr 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000BEFr 2  AA                 TAX
000BF0r 2  C8                 INY
000BF1r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000BF3r 2  D0 06              BNE   @have_entry
000BF5r 2  E0 00              CPX   #0
000BF7r 2  D0 02              BNE   @have_entry
000BF9r 2                     ; Null pointer — end of table
000BF9r 2  38                 SEC
000BFAr 2  60                 RTS
000BFBr 2               
000BFBr 2               @have_entry:
000BFBr 2                     ; X = name_ptr_lo, A = name_ptr_hi
000BFBr 2                     ; Compare the table name against the token payload
000BFBr 2                     ; Token payload: at eval_cur + TOK_PAYLOAD = length byte + chars
000BFBr 2  85 rr              STA   ptr2_hi
000BFDr 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000BFFr 2               
000BFFr 2                     ; Get token payload pointer
000BFFr 2  A5 rr              LDA   eval_cur_lo
000C01r 2  85 rr              STA   ptr_lo
000C03r 2  A5 rr              LDA   eval_cur_hi
000C05r 2  85 rr              STA   ptr_hi
000C07r 2               
000C07r 2                     ; Compare length bytes
000C07r 2  A0 00              LDY   #0
000C09r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000C0Br 2  A0 03              LDY   #TOK_PAYLOAD
000C0Dr 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000C0Fr 2  D0 45              BNE   @next
000C11r 2               
000C11r 2                     ; Lengths match — compare chars
000C11r 2  AA                 TAX                       ; X = length
000C12r 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000C14r 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000C16r 2               @cmp_loop:
000C16r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000C18r 2  5A                 PHY
000C19r 2                     ; Compute token char offset: TOK_PAYLOAD + 1 + tok_sign
000C19r 2  A5 rr              LDA   tok_sign
000C1Br 2  18                 CLC
000C1Cr 2  69 04              ADC   #TOK_PAYLOAD+1
000C1Er 2  A8                 TAY
000C1Fr 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000C21r 2  7A                 PLY
000C22r 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000C24r 2  D0 30              BNE   @next
000C26r 2  C8                 INY
000C27r 2  E6 rr              INC   tok_sign
000C29r 2  CA                 DEX
000C2Ar 2  D0 EA              BNE   @cmp_loop
000C2Cr 2               
000C2Cr 2                     ; Match found — read handler address and arity
000C2Cr 2                     ; Table entry: name_ptr(2) + handler_addr(2) + arity(1)
000C2Cr 2                     ; handler is at table_base + 2, arity at table_base + 4
000C2Cr 2  AD rr rr           LDA   num_tmp_lo
000C2Fr 2  85 rr              STA   ptr2_lo
000C31r 2  AD rr rr           LDA   num_tmp_hi
000C34r 2  85 rr              STA   ptr2_hi
000C36r 2  A0 02              LDY   #2
000C38r 2  B1 rr              LDA   (ptr2_lo),Y        ; handler low
000C3Ar 2  AA                 TAX
000C3Br 2  C8                 INY
000C3Cr 2  B1 rr              LDA   (ptr2_lo),Y        ; handler high
000C3Er 2  85 rr              STA   ptr2_hi
000C40r 2  86 rr              STX   ptr2_lo             ; ptr2 = handler address
000C42r 2  A0 04              LDY   #4
000C44r 2  B1 rr              LDA   (ptr2_lo),Y        ; — wrong, we already overwrote ptr2
000C46r 2                     ; Fix: re-read arity from table using num_tmp as base
000C46r 2  AD rr rr           LDA   num_tmp_lo
000C49r 2  85 rr              STA   ptr_lo
000C4Br 2  AD rr rr           LDA   num_tmp_hi
000C4Er 2  85 rr              STA   ptr_hi
000C50r 2  A0 04              LDY   #4
000C52r 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000C54r 2  18                 CLC                       ; found
000C55r 2  60                 RTS
000C56r 2               
000C56r 2               @next:
000C56r 2  64 rr              STZ   tok_sign            ; reset comparison counter
000C58r 2                     ; Advance to next entry: +5 bytes (2 name + 2 handler + 1 arity)
000C58r 2  18                 CLC
000C59r 2  AD rr rr           LDA   num_tmp_lo
000C5Cr 2  69 05              ADC   #5
000C5Er 2  8D rr rr           STA   num_tmp_lo
000C61r 2  90 03              BCC   @next2
000C63r 2  EE rr rr           INC   num_tmp_hi
000C66r 2               @next2:
000C66r 2  4C rr rr           JMP   @scan
000C69r 2               
000C69r 2               ; ---------------------------------------------------------------------
000C69r 2               ; do_print — PRINT <expr>: evaluate arg and print with newline
000C69r 2               ;   Entry: eval_val/eval_type already set with the argument
000C69r 2               ;   Must JMP to eval_continue when done
000C69r 2               ; ---------------------------------------------------------------------
000C69r 2               do_print:
000C69r 2  A5 rr              LDA   eval_type
000C6Br 2  C9 02              CMP   #VAL_LIST
000C6Dr 2  F0 0D              BEQ   @list
000C6Fr 2  C9 01              CMP   #VAL_WORD
000C71r 2  F0 12              BEQ   @word
000C73r 2               
000C73r 2                     ; Print number
000C73r 2  20 rr rr           JSR   print_number
000C76r 2  20 rr rr           JSR   eval_newline
000C79r 2  4C rr rr           JMP   eval_continue
000C7Cr 2               
000C7Cr 2               @list:
000C7Cr 2  20 rr rr           JSR   print_list
000C7Fr 2  20 rr rr           JSR   eval_newline
000C82r 2  4C rr rr           JMP   eval_continue
000C85r 2               
000C85r 2               @word:
000C85r 2                     ; Print quoted word — eval_val_lo/hi points at length+chars
000C85r 2  A5 rr              LDA   eval_val_lo
000C87r 2  85 rr              STA   ptr_lo
000C89r 2  A5 rr              LDA   eval_val_hi
000C8Br 2  85 rr              STA   ptr_hi
000C8Dr 2  A0 00              LDY   #0
000C8Fr 2  B1 rr              LDA   (ptr_lo),Y         ; length
000C91r 2  AA                 TAX
000C92r 2  C8                 INY
000C93r 2               @wch:
000C93r 2  B1 rr              LDA   (ptr_lo),Y
000C95r 2  8D 0E A0           STA   VGC_CHAROUT
000C98r 2  C8                 INY
000C99r 2  CA                 DEX
000C9Ar 2  D0 F7              BNE   @wch
000C9Cr 2  20 rr rr           JSR   eval_newline
000C9Fr 2  4C rr rr           JMP   eval_continue
000CA2r 2               
000CA2r 2               ; ---------------------------------------------------------------------
000CA2r 2               ; do_type — TYPE <expr>: like PRINT but no newline
000CA2r 2               ; ---------------------------------------------------------------------
000CA2r 2               do_type:
000CA2r 2  A5 rr              LDA   eval_type
000CA4r 2  C9 02              CMP   #VAL_LIST
000CA6r 2  F0 0A              BEQ   @list
000CA8r 2  C9 01              CMP   #VAL_WORD
000CAAr 2  F0 0C              BEQ   @word
000CACr 2               
000CACr 2                     ; Print number (no newline)
000CACr 2  20 rr rr           JSR   print_number
000CAFr 2  4C rr rr           JMP   eval_continue
000CB2r 2               
000CB2r 2               @list:
000CB2r 2  20 rr rr           JSR   print_list
000CB5r 2  4C rr rr           JMP   eval_continue
000CB8r 2               
000CB8r 2               @word:
000CB8r 2  A5 rr              LDA   eval_val_lo
000CBAr 2  85 rr              STA   ptr_lo
000CBCr 2  A5 rr              LDA   eval_val_hi
000CBEr 2  85 rr              STA   ptr_hi
000CC0r 2  A0 00              LDY   #0
000CC2r 2  B1 rr              LDA   (ptr_lo),Y
000CC4r 2  AA                 TAX
000CC5r 2  C8                 INY
000CC6r 2               @wch:
000CC6r 2  B1 rr              LDA   (ptr_lo),Y
000CC8r 2  8D 0E A0           STA   VGC_CHAROUT
000CCBr 2  C8                 INY
000CCCr 2  CA                 DEX
000CCDr 2  D0 F7              BNE   @wch
000CCFr 2  4C rr rr           JMP   eval_continue
000CD2r 2               
000CD2r 2               ; ---------------------------------------------------------------------
000CD2r 2               ; do_make — MAKE "name value: store a variable
000CD2r 2               ;   Arity 0 — we do our own argument evaluation
000CD2r 2               ;   1. eval_expr → name (must be TOK_QUOTE → word type)
000CD2r 2               ;   2. save name pointer
000CD2r 2               ;   3. eval_expr → value
000CD2r 2               ;   4. var_set(saved name, current value)
000CD2r 2               ; ---------------------------------------------------------------------
000CD2r 2               do_make:
000CD2r 2                     ; Evaluate first argument: the name (a quoted word)
000CD2r 2  20 rr rr           JSR   eval_expr
000CD5r 2  B0 1F              BCS   @err
000CD7r 2               
000CD7r 2                     ; Must be a word (type $01)
000CD7r 2  A5 rr              LDA   eval_type
000CD9r 2  C9 01              CMP   #$01
000CDBr 2  D0 19              BNE   @err
000CDDr 2               
000CDDr 2                     ; Save the name pointer (points into token payload: len + chars)
000CDDr 2  A5 rr              LDA   eval_val_lo
000CDFr 2  48                 PHA
000CE0r 2  A5 rr              LDA   eval_val_hi
000CE2r 2  48                 PHA
000CE3r 2               
000CE3r 2                     ; Evaluate second argument: the value
000CE3r 2  20 rr rr           JSR   eval_expr
000CE6r 2  B0 0C              BCS   @err_pop
000CE8r 2               
000CE8r 2                     ; Set up ptr_lo/hi → saved name, eval_val holds value
000CE8r 2  68                 PLA
000CE9r 2  85 rr              STA   ptr_hi
000CEBr 2  68                 PLA
000CECr 2  85 rr              STA   ptr_lo
000CEEr 2               
000CEEr 2  20 rr rr           JSR   var_set
000CF1r 2  4C rr rr           JMP   eval_continue
000CF4r 2               
000CF4r 2               @err_pop:
000CF4r 2  68                 PLA
000CF5r 2  68                 PLA
000CF6r 2               @err:
000CF6r 2                     ; Print error
000CF6r 2  A2 00              LDX   #0
000CF8r 2               @ep:
000CF8r 2  BD rr rr           LDA   str_make_err,X
000CFBr 2  F0 06              BEQ   @ep_done
000CFDr 2  8D 0E A0           STA   VGC_CHAROUT
000D00r 2  E8                 INX
000D01r 2  D0 F5              BNE   @ep
000D03r 2               @ep_done:
000D03r 2  20 rr rr           JSR   eval_newline
000D06r 2  4C rr rr           JMP   eval_continue
000D09r 2               
000D09r 2               ; ---------------------------------------------------------------------
000D09r 2               ; do_repeat — REPEAT count [body]
000D09r 2               ;   Arity 0 — handles its own argument parsing
000D09r 2               ;   1. Evaluate count expression
000D09r 2               ;   2. Locate the bracketed body [...]
000D09r 2               ;   3. Execute the body count times
000D09r 2               ;   4. Resume after the closing ]
000D09r 2               ;
000D09r 2               ;   Nesting: saves/restores repeat state (body_start, body_resume,
000D09r 2               ;   repeat_count, eval_in_body) on the hardware stack so nested
000D09r 2               ;   REPEAT works correctly.
000D09r 2               ; ---------------------------------------------------------------------
000D09r 2               
000D09r 2                     .segment "ZEROPAGE"
000021r 2  xx           repeat_count_lo:  .res 1
000022r 2  xx           repeat_count_hi:  .res 1
000023r 2  xx           body_start_lo:    .res 1       ; first token after [
000024r 2  xx           body_start_hi:    .res 1
000025r 2  xx           body_resume_lo:   .res 1       ; token after ]
000026r 2  xx           body_resume_hi:   .res 1
000027r 2  xx           repcount:         .res 1       ; 1-based REPCOUNT within REPEAT loop
000028r 2  xx           for_cur_lo:       .res 1       ; FOR loop current value low
000029r 2  xx           for_cur_hi:       .res 1       ; FOR loop current value high
00002Ar 2  xx           for_end_lo:       .res 1       ; FOR loop end value low
00002Br 2  xx           for_end_hi:       .res 1       ; FOR loop end value high
00002Cr 2  xx           cond_start_lo:    .res 1       ; WHILE/UNTIL condition start low
00002Dr 2  xx           cond_start_hi:    .res 1       ; WHILE/UNTIL condition start high
00002Er 2               
00002Er 2                     .segment "CODE"
000D09r 2               
000D09r 2               do_repeat:
000D09r 2                     ; --- Evaluate the count argument ---
000D09r 2  20 rr rr           JSR   eval_expr
000D0Cr 2  90 03              BCC   @count_ok
000D0Er 2  4C rr rr           JMP   @err_args             ; carry set = no token
000D11r 2               @count_ok:
000D11r 2                     ; Count must be a number
000D11r 2  A5 rr              LDA   eval_type
000D13r 2  F0 03              BEQ   @type_ok
000D15r 2  4C rr rr           JMP   @err_args
000D18r 2               @type_ok:
000D18r 2               
000D18r 2                     ; --- Save outer repeat state for nesting ---
000D18r 2  A5 rr              LDA   repcount
000D1Ar 2  48                 PHA
000D1Br 2  A5 rr              LDA   repeat_count_lo
000D1Dr 2  48                 PHA
000D1Er 2  A5 rr              LDA   repeat_count_hi
000D20r 2  48                 PHA
000D21r 2  A5 rr              LDA   body_start_lo
000D23r 2  48                 PHA
000D24r 2  A5 rr              LDA   body_start_hi
000D26r 2  48                 PHA
000D27r 2  A5 rr              LDA   body_resume_lo
000D29r 2  48                 PHA
000D2Ar 2  A5 rr              LDA   body_resume_hi
000D2Cr 2  48                 PHA
000D2Dr 2  A5 rr              LDA   eval_in_body
000D2Fr 2  48                 PHA
000D30r 2               
000D30r 2                     ; Store count (integer part only, clamped to 0 if negative)
000D30r 2  A5 rr              LDA   eval_val_hi
000D32r 2  30 08              BMI   @zero_count           ; negative = treat as 0
000D34r 2  85 rr              STA   repeat_count_hi
000D36r 2  A5 rr              LDA   eval_val_lo
000D38r 2  85 rr              STA   repeat_count_lo
000D3Ar 2  80 04              BRA   @find_body
000D3Cr 2               
000D3Cr 2               @zero_count:
000D3Cr 2  64 rr              STZ   repeat_count_lo
000D3Er 2  64 rr              STZ   repeat_count_hi
000D40r 2               
000D40r 2               @find_body:
000D40r 2                     ; --- Current token must be TOK_LBRACKET ---
000D40r 2  A5 rr              LDA   eval_cur_lo
000D42r 2  05 rr              ORA   eval_cur_hi
000D44r 2  D0 03              BNE   @have_tok
000D46r 2  4C rr rr           JMP   @err_bracket_pop
000D49r 2               @have_tok:
000D49r 2  A5 rr              LDA   eval_cur_lo
000D4Br 2  85 rr              STA   ptr_lo
000D4Dr 2  A5 rr              LDA   eval_cur_hi
000D4Fr 2  85 rr              STA   ptr_hi
000D51r 2  A0 00              LDY   #TOK_TAG
000D53r 2  B1 rr              LDA   (ptr_lo),Y
000D55r 2  C9 03              CMP   #TOK_LBRACKET
000D57r 2  F0 03              BEQ   @is_bracket
000D59r 2  4C rr rr           JMP   @err_bracket_pop
000D5Cr 2               @is_bracket:
000D5Cr 2               
000D5Cr 2                     ; Advance past the [
000D5Cr 2  20 rr rr           JSR   eval_advance
000D5Fr 2               
000D5Fr 2                     ; Save body start (first token after [)
000D5Fr 2  A5 rr              LDA   eval_cur_lo
000D61r 2  85 rr              STA   body_start_lo
000D63r 2  A5 rr              LDA   eval_cur_hi
000D65r 2  85 rr              STA   body_start_hi
000D67r 2               
000D67r 2                     ; --- Scan forward to find the matching ] ---
000D67r 2  A2 01              LDX   #1                    ; depth (we've consumed the [)
000D69r 2               @scan:
000D69r 2  A5 rr              LDA   eval_cur_lo
000D6Br 2  05 rr              ORA   eval_cur_hi
000D6Dr 2  D0 03              BNE   @scan_ok
000D6Fr 2  4C rr rr           JMP   @err_bracket_pop
000D72r 2               @scan_ok:
000D72r 2  A5 rr              LDA   eval_cur_lo
000D74r 2  85 rr              STA   ptr_lo
000D76r 2  A5 rr              LDA   eval_cur_hi
000D78r 2  85 rr              STA   ptr_hi
000D7Ar 2  A0 00              LDY   #TOK_TAG
000D7Cr 2  B1 rr              LDA   (ptr_lo),Y
000D7Er 2               
000D7Er 2  C9 03              CMP   #TOK_LBRACKET
000D80r 2  D0 03              BNE   @scan_not_lb
000D82r 2  E8                 INX
000D83r 2  80 07              BRA   @scan_next
000D85r 2               @scan_not_lb:
000D85r 2  C9 04              CMP   #TOK_RBRACKET
000D87r 2  D0 03              BNE   @scan_next
000D89r 2  CA                 DEX
000D8Ar 2  F0 07              BEQ   @scan_found           ; depth == 0, found matching ]
000D8Cr 2               @scan_next:
000D8Cr 2  DA                 PHX                        ; save depth across eval_advance
000D8Dr 2  20 rr rr           JSR   eval_advance
000D90r 2  FA                 PLX
000D91r 2  80 D6              BRA   @scan
000D93r 2               
000D93r 2               @scan_found:
000D93r 2                     ; eval_cur is at the matching ]. Save resume point (token after ]).
000D93r 2  20 rr rr           JSR   eval_advance
000D96r 2  A5 rr              LDA   eval_cur_lo
000D98r 2  85 rr              STA   body_resume_lo
000D9Ar 2  A5 rr              LDA   eval_cur_hi
000D9Cr 2  85 rr              STA   body_resume_hi
000D9Er 2               
000D9Er 2                     ; --- Initialize repcount and execute the body repeat_count times ---
000D9Er 2  A9 01              LDA   #1
000DA0r 2  85 rr              STA   repcount
000DA2r 2               @loop:
000DA2r 2                     ; Check if STOP/OUTPUT was signaled
000DA2r 2  A5 rr              LDA   proc_stopped
000DA4r 2  D0 27              BNE   @loop_done
000DA6r 2               
000DA6r 2                     ; Check if count is zero
000DA6r 2  A5 rr              LDA   repeat_count_lo
000DA8r 2  05 rr              ORA   repeat_count_hi
000DAAr 2  F0 21              BEQ   @loop_done
000DACr 2               
000DACr 2                     ; Set eval_cur to body start
000DACr 2  A5 rr              LDA   body_start_lo
000DAEr 2  85 rr              STA   eval_cur_lo
000DB0r 2  A5 rr              LDA   body_start_hi
000DB2r 2  85 rr              STA   eval_cur_hi
000DB4r 2               
000DB4r 2                     ; Set body mode and call eval_body
000DB4r 2  A9 01              LDA   #$01
000DB6r 2  85 rr              STA   eval_in_body
000DB8r 2  20 rr rr           JSR   eval_body
000DBBr 2               
000DBBr 2                     ; Increment repcount (capped at 255)
000DBBr 2  A5 rr              LDA   repcount
000DBDr 2  C9 FF              CMP   #$FF
000DBFr 2  B0 02              BCS   :+
000DC1r 2  E6 rr              INC   repcount
000DC3r 2               :
000DC3r 2                     ; Decrement count (16-bit)
000DC3r 2  A5 rr              LDA   repeat_count_lo
000DC5r 2  D0 02              BNE   @dec_lo
000DC7r 2  C6 rr              DEC   repeat_count_hi
000DC9r 2               @dec_lo:
000DC9r 2  C6 rr              DEC   repeat_count_lo
000DCBr 2  80 D5              BRA   @loop
000DCDr 2               
000DCDr 2               @loop_done:
000DCDr 2                     ; Resume past THIS REPEAT's ] BEFORE restoring outer state — restore pops
000DCDr 2                     ; body_resume back to the enclosing REPEAT's value, so reading it after the
000DCDr 2                     ; restore would resume at the wrong token (trailing commands never run).
000DCDr 2  A5 rr              LDA   body_resume_lo
000DCFr 2  85 rr              STA   eval_cur_lo
000DD1r 2  A5 rr              LDA   body_resume_hi
000DD3r 2  85 rr              STA   eval_cur_hi
000DD5r 2                     ; --- Restore outer state ---
000DD5r 2  20 rr rr           JSR   repeat_restore_state
000DD8r 2  4C rr rr           JMP   eval_continue
000DDBr 2               
000DDBr 2               @err_bracket_pop:
000DDBr 2                     ; Restore stack before printing error
000DDBr 2  20 rr rr           JSR   repeat_restore_state
000DDEr 2                     ; Fall through to error message
000DDEr 2  A2 00              LDX   #0
000DE0r 2               @eb_lp:
000DE0r 2  BD rr rr           LDA   str_repeat_bracket,X
000DE3r 2  F0 06              BEQ   @eb_done
000DE5r 2  8D 0E A0           STA   VGC_CHAROUT
000DE8r 2  E8                 INX
000DE9r 2  D0 F5              BNE   @eb_lp
000DEBr 2               @eb_done:
000DEBr 2  20 rr rr           JSR   eval_newline
000DEEr 2  4C rr rr           JMP   eval_continue
000DF1r 2               
000DF1r 2               @err_args:
000DF1r 2  A2 00              LDX   #0
000DF3r 2               @ea_lp:
000DF3r 2  BD rr rr           LDA   str_repeat_err,X
000DF6r 2  F0 06              BEQ   @ea_done
000DF8r 2  8D 0E A0           STA   VGC_CHAROUT
000DFBr 2  E8                 INX
000DFCr 2  D0 F5              BNE   @ea_lp
000DFEr 2               @ea_done:
000DFEr 2  20 rr rr           JSR   eval_newline
000E01r 2  4C rr rr           JMP   eval_continue
000E04r 2               
000E04r 2               ; ---------------------------------------------------------------------
000E04r 2               ; repeat_restore_state — pop 7 saved bytes from stack to ZP
000E04r 2               ;   Restores eval_in_body, body_resume, body_start, repeat_count
000E04r 2               ;   Must be called via JSR (uses return address on stack correctly)
000E04r 2               ; ---------------------------------------------------------------------
000E04r 2               repeat_restore_state:
000E04r 2                     ; Pull our return address, pop 8 saved bytes, push RA, RTS.
000E04r 2  68                 PLA
000E05r 2  85 rr              STA   handler_lo            ; save return address low
000E07r 2  68                 PLA
000E08r 2  85 rr              STA   handler_hi            ; save return address high
000E0Ar 2               
000E0Ar 2  68                 PLA
000E0Br 2  85 rr              STA   eval_in_body
000E0Dr 2  68                 PLA
000E0Er 2  85 rr              STA   body_resume_hi
000E10r 2  68                 PLA
000E11r 2  85 rr              STA   body_resume_lo
000E13r 2  68                 PLA
000E14r 2  85 rr              STA   body_start_hi
000E16r 2  68                 PLA
000E17r 2  85 rr              STA   body_start_lo
000E19r 2  68                 PLA
000E1Ar 2  85 rr              STA   repeat_count_hi
000E1Cr 2  68                 PLA
000E1Dr 2  85 rr              STA   repeat_count_lo
000E1Fr 2  68                 PLA
000E20r 2  85 rr              STA   repcount
000E22r 2               
000E22r 2  A5 rr              LDA   handler_hi
000E24r 2  48                 PHA
000E25r 2  A5 rr              LDA   handler_lo
000E27r 2  48                 PHA
000E28r 2  60                 RTS
000E29r 2               
000E29r 2               ; ---------------------------------------------------------------------
000E29r 2               ; print_byte_hex — print A as 2 hex digits
000E29r 2               ; ---------------------------------------------------------------------
000E29r 2               print_byte_hex:
000E29r 2  48                 PHA
000E2Ar 2  4A                 LSR
000E2Br 2  4A                 LSR
000E2Cr 2  4A                 LSR
000E2Dr 2  4A                 LSR
000E2Er 2  20 rr rr           JSR   @nibble
000E31r 2  68                 PLA
000E32r 2  29 0F              AND   #$0F
000E34r 2  20 rr rr           JSR   @nibble
000E37r 2  60                 RTS
000E38r 2               @nibble:
000E38r 2  C9 0A              CMP   #$0A
000E3Ar 2  90 02              BCC   @digit
000E3Cr 2  69 06              ADC   #$06               ; carry is set, so adds 7
000E3Er 2               @digit:
000E3Er 2  69 30              ADC   #'0'
000E40r 2  8D 0E A0           STA   VGC_CHAROUT
000E43r 2  60                 RTS
000E44r 2               
000E44r 2               ; ---------------------------------------------------------------------
000E44r 2               ; skip_list_body — advance eval_cur past a [...] block without executing
000E44r 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000E44r 2               ;   Exit:  eval_cur points at the token after the matching TOK_RBRACKET
000E44r 2               ;          Carry clear = success, Carry set = missing bracket
000E44r 2               ;   Clobbers: A, X, Y, ptr_lo/hi
000E44r 2               ; ---------------------------------------------------------------------
000E44r 2               skip_list_body:
000E44r 2                     ; Verify current token is TOK_LBRACKET
000E44r 2  A5 rr              LDA   eval_cur_lo
000E46r 2  05 rr              ORA   eval_cur_hi
000E48r 2  F0 41              BEQ   @err
000E4Ar 2  A5 rr              LDA   eval_cur_lo
000E4Cr 2  85 rr              STA   ptr_lo
000E4Er 2  A5 rr              LDA   eval_cur_hi
000E50r 2  85 rr              STA   ptr_hi
000E52r 2  A0 00              LDY   #TOK_TAG
000E54r 2  B1 rr              LDA   (ptr_lo),Y
000E56r 2  C9 03              CMP   #TOK_LBRACKET
000E58r 2  D0 31              BNE   @err
000E5Ar 2               
000E5Ar 2                     ; Advance past the [
000E5Ar 2  20 rr rr           JSR   eval_advance
000E5Dr 2  A2 01              LDX   #1                    ; depth = 1
000E5Fr 2               
000E5Fr 2               @scan:
000E5Fr 2  A5 rr              LDA   eval_cur_lo
000E61r 2  05 rr              ORA   eval_cur_hi
000E63r 2  F0 26              BEQ   @err                  ; ran out of tokens
000E65r 2  A5 rr              LDA   eval_cur_lo
000E67r 2  85 rr              STA   ptr_lo
000E69r 2  A5 rr              LDA   eval_cur_hi
000E6Br 2  85 rr              STA   ptr_hi
000E6Dr 2  A0 00              LDY   #TOK_TAG
000E6Fr 2  B1 rr              LDA   (ptr_lo),Y
000E71r 2               
000E71r 2  C9 03              CMP   #TOK_LBRACKET
000E73r 2  D0 03              BNE   @not_lb
000E75r 2  E8                 INX
000E76r 2  80 07              BRA   @scan_next
000E78r 2               @not_lb:
000E78r 2  C9 04              CMP   #TOK_RBRACKET
000E7Ar 2  D0 03              BNE   @scan_next
000E7Cr 2  CA                 DEX
000E7Dr 2  F0 07              BEQ   @found                 ; depth == 0 -> matched
000E7Fr 2               @scan_next:
000E7Fr 2  DA                 PHX
000E80r 2  20 rr rr           JSR   eval_advance
000E83r 2  FA                 PLX
000E84r 2  80 D9              BRA   @scan
000E86r 2               
000E86r 2               @found:
000E86r 2                     ; eval_cur is at the matching ]. Advance past it.
000E86r 2  20 rr rr           JSR   eval_advance
000E89r 2  18                 CLC
000E8Ar 2  60                 RTS
000E8Br 2               
000E8Br 2               @err:
000E8Br 2  38                 SEC
000E8Cr 2  60                 RTS
000E8Dr 2               
000E8Dr 2               ; ---------------------------------------------------------------------
000E8Dr 2               ; exec_body_block — execute a [...] body once
000E8Dr 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000E8Dr 2               ;   Exit:  eval_cur points past the matching ], carry clear = ok
000E8Dr 2               ;          Carry set = bracket error
000E8Dr 2               ;   Saves/restores body_resume, eval_in_body for nesting.
000E8Dr 2               ;   Clobbers: A, X, Y, ptr_lo/hi, body_start/resume, eval_in_body
000E8Dr 2               ; ---------------------------------------------------------------------
000E8Dr 2               exec_body_block:
000E8Dr 2                     ; Verify current token is [
000E8Dr 2  A5 rr              LDA   eval_cur_lo
000E8Fr 2  05 rr              ORA   eval_cur_hi
000E91r 2  F0 7B              BEQ   @err
000E93r 2  A5 rr              LDA   eval_cur_lo
000E95r 2  85 rr              STA   ptr_lo
000E97r 2  A5 rr              LDA   eval_cur_hi
000E99r 2  85 rr              STA   ptr_hi
000E9Br 2  A0 00              LDY   #TOK_TAG
000E9Dr 2  B1 rr              LDA   (ptr_lo),Y
000E9Fr 2  C9 03              CMP   #TOK_LBRACKET
000EA1r 2  D0 6B              BNE   @err
000EA3r 2               
000EA3r 2                     ; Advance past [
000EA3r 2  20 rr rr           JSR   eval_advance
000EA6r 2               
000EA6r 2                     ; Save outer state for nesting
000EA6r 2  A5 rr              LDA   body_resume_lo
000EA8r 2  48                 PHA
000EA9r 2  A5 rr              LDA   body_resume_hi
000EABr 2  48                 PHA
000EACr 2  A5 rr              LDA   eval_in_body
000EAEr 2  48                 PHA
000EAFr 2               
000EAFr 2                     ; Save body start
000EAFr 2  A5 rr              LDA   eval_cur_lo
000EB1r 2  48                 PHA
000EB2r 2  A5 rr              LDA   eval_cur_hi
000EB4r 2  48                 PHA
000EB5r 2               
000EB5r 2                     ; Scan forward for matching ]
000EB5r 2  A2 01              LDX   #1
000EB7r 2               @scan:
000EB7r 2  A5 rr              LDA   eval_cur_lo
000EB9r 2  05 rr              ORA   eval_cur_hi
000EBBr 2  F0 4C              BEQ   @err_pop5
000EBDr 2  A5 rr              LDA   eval_cur_lo
000EBFr 2  85 rr              STA   ptr_lo
000EC1r 2  A5 rr              LDA   eval_cur_hi
000EC3r 2  85 rr              STA   ptr_hi
000EC5r 2  A0 00              LDY   #TOK_TAG
000EC7r 2  B1 rr              LDA   (ptr_lo),Y
000EC9r 2  C9 03              CMP   #TOK_LBRACKET
000ECBr 2  D0 03              BNE   @not_lb
000ECDr 2  E8                 INX
000ECEr 2  80 07              BRA   @scan_next
000ED0r 2               @not_lb:
000ED0r 2  C9 04              CMP   #TOK_RBRACKET
000ED2r 2  D0 03              BNE   @scan_next
000ED4r 2  CA                 DEX
000ED5r 2  F0 07              BEQ   @found
000ED7r 2               @scan_next:
000ED7r 2  DA                 PHX
000ED8r 2  20 rr rr           JSR   eval_advance
000EDBr 2  FA                 PLX
000EDCr 2  80 D9              BRA   @scan
000EDEr 2               
000EDEr 2               @found:
000EDEr 2                     ; Advance past ] for resume point
000EDEr 2  20 rr rr           JSR   eval_advance
000EE1r 2  A5 rr              LDA   eval_cur_lo
000EE3r 2  85 rr              STA   body_resume_lo
000EE5r 2  A5 rr              LDA   eval_cur_hi
000EE7r 2  85 rr              STA   body_resume_hi
000EE9r 2               
000EE9r 2                     ; Restore body start
000EE9r 2  68                 PLA
000EEAr 2  85 rr              STA   eval_cur_hi
000EECr 2  68                 PLA
000EEDr 2  85 rr              STA   eval_cur_lo
000EEFr 2               
000EEFr 2                     ; Execute the body
000EEFr 2  A9 01              LDA   #$01
000EF1r 2  85 rr              STA   eval_in_body
000EF3r 2  20 rr rr           JSR   eval_body
000EF6r 2               
000EF6r 2                     ; Restore outer state
000EF6r 2  68                 PLA
000EF7r 2  85 rr              STA   eval_in_body
000EF9r 2  68                 PLA
000EFAr 2  85 rr              STA   body_resume_hi
000EFCr 2  68                 PLA
000EFDr 2  85 rr              STA   body_resume_lo
000EFFr 2               
000EFFr 2                     ; Set eval_cur past the ]
000EFFr 2  A5 rr              LDA   body_resume_lo
000F01r 2  85 rr              STA   eval_cur_lo
000F03r 2  A5 rr              LDA   body_resume_hi
000F05r 2  85 rr              STA   eval_cur_hi
000F07r 2  18                 CLC
000F08r 2  60                 RTS
000F09r 2               
000F09r 2               @err_pop5:
000F09r 2  68                 PLA
000F0Ar 2  68                 PLA
000F0Br 2  68                 PLA
000F0Cr 2  68                 PLA
000F0Dr 2  68                 PLA
000F0Er 2               @err:
000F0Er 2  38                 SEC
000F0Fr 2  60                 RTS
000F10r 2               
000F10r 2               ; ---------------------------------------------------------------------
000F10r 2               ; do_if — IF condition [body]
000F10r 2               ;   Arity 0 — handles its own argument parsing
000F10r 2               ; ---------------------------------------------------------------------
000F10r 2               do_if:
000F10r 2  20 rr rr           JSR   eval_expr
000F13r 2  B0 1C              BCS   @err
000F15r 2               
000F15r 2                     ; Nonzero integer part = true
000F15r 2  A5 rr              LDA   eval_val_lo
000F17r 2  05 rr              ORA   eval_val_hi
000F19r 2  D0 08              BNE   @true
000F1Br 2               
000F1Br 2                     ; False — skip the body
000F1Br 2  20 rr rr           JSR   skip_list_body
000F1Er 2  B0 0B              BCS   @err_bracket
000F20r 2  4C rr rr           JMP   eval_continue
000F23r 2               
000F23r 2               @true:
000F23r 2  20 rr rr           JSR   exec_body_block
000F26r 2  B0 03              BCS   @err_bracket
000F28r 2  4C rr rr           JMP   eval_continue
000F2Br 2               
000F2Br 2               @err_bracket:
000F2Br 2  A2 rr              LDX   #<str_if_bracket
000F2Dr 2  A0 rr              LDY   #>str_if_bracket
000F2Fr 2  80 04              BRA   if_print_err
000F31r 2               @err:
000F31r 2  A2 rr              LDX   #<str_if_err
000F33r 2  A0 rr              LDY   #>str_if_err
000F35r 2                     ; fall through
000F35r 2               
000F35r 2               if_print_err:
000F35r 2  86 rr              STX   ptr_lo
000F37r 2  84 rr              STY   ptr_hi
000F39r 2  A0 00              LDY   #0
000F3Br 2               @lp:
000F3Br 2  B1 rr              LDA   (ptr_lo),Y
000F3Dr 2  F0 06              BEQ   @done
000F3Fr 2  8D 0E A0           STA   VGC_CHAROUT
000F42r 2  C8                 INY
000F43r 2  D0 F6              BNE   @lp
000F45r 2               @done:
000F45r 2  20 rr rr           JSR   eval_newline
000F48r 2  4C rr rr           JMP   eval_continue
000F4Br 2               
000F4Br 2               ; ---------------------------------------------------------------------
000F4Br 2               ; do_ifelse — IFELSE condition [true-body] [false-body]
000F4Br 2               ;   Arity 0 — handles its own argument parsing
000F4Br 2               ; ---------------------------------------------------------------------
000F4Br 2               do_ifelse:
000F4Br 2  20 rr rr           JSR   eval_expr
000F4Er 2  B0 26              BCS   @err
000F50r 2               
000F50r 2  A5 rr              LDA   eval_val_lo
000F52r 2  05 rr              ORA   eval_val_hi
000F54r 2  D0 0D              BNE   @is_true
000F56r 2               
000F56r 2                     ; FALSE: skip first body, execute second
000F56r 2  20 rr rr           JSR   skip_list_body
000F59r 2  B0 15              BCS   @err_bracket
000F5Br 2  20 rr rr           JSR   exec_body_block
000F5Er 2  B0 10              BCS   @err_bracket
000F60r 2  4C rr rr           JMP   eval_continue
000F63r 2               
000F63r 2               @is_true:
000F63r 2                     ; TRUE: execute first body, skip second
000F63r 2  20 rr rr           JSR   exec_body_block
000F66r 2  B0 08              BCS   @err_bracket
000F68r 2  20 rr rr           JSR   skip_list_body
000F6Br 2  B0 03              BCS   @err_bracket
000F6Dr 2  4C rr rr           JMP   eval_continue
000F70r 2               
000F70r 2               @err_bracket:
000F70r 2  A2 rr              LDX   #<str_ifelse_bracket
000F72r 2  A0 rr              LDY   #>str_ifelse_bracket
000F74r 2  80 04              BRA   ifelse_print_err
000F76r 2               @err:
000F76r 2  A2 rr              LDX   #<str_ifelse_err
000F78r 2  A0 rr              LDY   #>str_ifelse_err
000F7Ar 2                     ; fall through
000F7Ar 2               
000F7Ar 2               ifelse_print_err:
000F7Ar 2  86 rr              STX   ptr_lo
000F7Cr 2  84 rr              STY   ptr_hi
000F7Er 2  A0 00              LDY   #0
000F80r 2               @lp:
000F80r 2  B1 rr              LDA   (ptr_lo),Y
000F82r 2  F0 06              BEQ   @done
000F84r 2  8D 0E A0           STA   VGC_CHAROUT
000F87r 2  C8                 INY
000F88r 2  D0 F6              BNE   @lp
000F8Ar 2               @done:
000F8Ar 2  20 rr rr           JSR   eval_newline
000F8Dr 2  4C rr rr           JMP   eval_continue
000F90r 2               
000F90r 2               ; ---------------------------------------------------------------------
000F90r 2               ; do_stop — STOP: exit current procedure immediately (no return value)
000F90r 2               ;   Arity 0, no arguments
000F90r 2               ; ---------------------------------------------------------------------
000F90r 2               do_stop:
000F90r 2  A9 01              LDA   #$01
000F92r 2  85 rr              STA   proc_stopped
000F94r 2  4C rr rr           JMP   eval_continue
000F97r 2               
000F97r 2               ; ---------------------------------------------------------------------
000F97r 2               ; do_output — OUTPUT expr: exit procedure with a return value
000F97r 2               ;   Arity 0 — handles its own argument evaluation
000F97r 2               ; ---------------------------------------------------------------------
000F97r 2               do_output:
000F97r 2  20 rr rr           JSR   eval_expr           ; evaluate the expression
000F9Ar 2  A9 02              LDA   #$02
000F9Cr 2  85 rr              STA   proc_stopped        ; signal OUTPUT
000F9Er 2                     ; eval_type/eval_val holds the return value
000F9Er 2  4C rr rr           JMP   eval_continue
000FA1r 2               
000FA1r 2               ; ---------------------------------------------------------------------
000FA1r 2               ; do_catch — CATCH "tag [body]: execute body, catching errors/throws
000FA1r 2               ;   Arity 0 — handles its own argument parsing
000FA1r 2               ;   1. Evaluate tag argument (quoted word)
000FA1r 2               ;   2. Save current catch frame (for nesting) on the 6502 stack
000FA1r 2               ;   3. Set up new catch frame with tag and stack pointer
000FA1r 2               ;   4. Execute the body
000FA1r 2               ;   5. On normal completion: restore previous catch frame, continue
000FA1r 2               ;   On THROW match: try_throw_error or do_throw restores SP from
000FA1r 2               ;   catch frame, which unwinds back to step 5's stack context.
000FA1r 2               ; ---------------------------------------------------------------------
000FA1r 2               do_catch:
000FA1r 2                     ; Evaluate tag argument (e.g., "ERROR)
000FA1r 2  20 rr rr           JSR   eval_expr
000FA4r 2  90 03              BCC   @tag_ok
000FA6r 2  4C rr rr           JMP   @err_tag
000FA9r 2               @tag_ok:
000FA9r 2               
000FA9r 2                     ; Must be a word
000FA9r 2  A5 rr              LDA   eval_type
000FABr 2  C9 01              CMP   #VAL_WORD
000FADr 2  F0 03              BEQ   @type_ok
000FAFr 2  4C rr rr           JMP   @err_tag
000FB2r 2               @type_ok:
000FB2r 2               
000FB2r 2                     ; Save tag pointer and eval_in_body temporarily (3 bytes)
000FB2r 2  A5 rr              LDA   eval_val_lo
000FB4r 2  48                 PHA
000FB5r 2  A5 rr              LDA   eval_val_hi
000FB7r 2  48                 PHA
000FB8r 2  A5 rr              LDA   eval_in_body
000FBAr 2  48                 PHA
000FBBr 2               
000FBBr 2                     ; Push previous catch frame onto the 6502 stack (6 bytes)
000FBBr 2  A5 rr              LDA   catch_active
000FBDr 2  48                 PHA
000FBEr 2  A5 rr              LDA   catch_tag_lo
000FC0r 2  48                 PHA
000FC1r 2  A5 rr              LDA   catch_tag_hi
000FC3r 2  48                 PHA
000FC4r 2  A5 rr              LDA   catch_sp
000FC6r 2  48                 PHA
000FC7r 2  A5 rr              LDA   catch_resume_lo
000FC9r 2  48                 PHA
000FCAr 2  A5 rr              LDA   catch_resume_hi
000FCCr 2  48                 PHA
000FCDr 2               
000FCDr 2                     ; Set up the tag pointer from saved values
000FCDr 2                     ; Stack (top to bottom): prev_frame(6), eval_in_body, eval_val_hi, eval_val_lo
000FCDr 2                     ; $0101+X = SP+1 = top. eval_in_body at SP+7, eval_val_hi at SP+8, eval_val_lo at SP+9
000FCDr 2  BA                 TSX
000FCEr 2  BD 08 01           LDA   $0108,X               ; eval_val_hi = tag ptr high
000FD1r 2  85 rr              STA   catch_tag_hi
000FD3r 2  BD 09 01           LDA   $0109,X               ; eval_val_lo = tag ptr low
000FD6r 2  85 rr              STA   catch_tag_lo
000FD8r 2               
000FD8r 2                     ; Save stack pointer NOW — this is the unwind target.
000FD8r 2                     ; When a THROW matches, TXS restores to this SP, and the
000FD8r 2                     ; 6 PLA instructions below will pop the previous frame.
000FD8r 2  BA                 TSX
000FD9r 2  86 rr              STX   catch_sp
000FDBr 2               
000FDBr 2                     ; Activate the catch
000FDBr 2  A9 01              LDA   #$01
000FDDr 2  85 rr              STA   catch_active
000FDFr 2               
000FDFr 2                     ; We need to find the resume point PAST the body's ].
000FDFr 2                     ; Scan ahead to find it, then come back and execute the body.
000FDFr 2                     ; Save body start location first.
000FDFr 2  A5 rr              LDA   eval_cur_lo
000FE1r 2  48                 PHA                         ; save body-start lo
000FE2r 2  A5 rr              LDA   eval_cur_hi
000FE4r 2  48                 PHA                         ; save body-start hi
000FE5r 2               
000FE5r 2                     ; Scan past the body [...] to find resume point
000FE5r 2  20 rr rr           JSR   skip_list_body
000FE8r 2  B0 31              BCS   @err_bracket_pop
000FEAr 2               
000FEAr 2                     ; eval_cur is now past the ]. Save as resume point.
000FEAr 2  A5 rr              LDA   eval_cur_lo
000FECr 2  85 rr              STA   catch_resume_lo
000FEEr 2  A5 rr              LDA   eval_cur_hi
000FF0r 2  85 rr              STA   catch_resume_hi
000FF2r 2               
000FF2r 2                     ; Restore body start
000FF2r 2  68                 PLA
000FF3r 2  85 rr              STA   eval_cur_hi
000FF5r 2  68                 PLA
000FF6r 2  85 rr              STA   eval_cur_lo
000FF8r 2               
000FF8r 2                     ; Execute the body
000FF8r 2  20 rr rr           JSR   exec_body_block
000FFBr 2               
000FFBr 2                     ; Body completed normally — restore previous catch frame
000FFBr 2                     ; (Stack still has: prev_frame(6), tag_hi, tag_lo at the bottom)
000FFBr 2  68                 PLA
000FFCr 2  85 rr              STA   catch_resume_hi
000FFEr 2  68                 PLA
000FFFr 2  85 rr              STA   catch_resume_lo
001001r 2  68                 PLA
001002r 2  85 rr              STA   catch_sp
001004r 2  68                 PLA
001005r 2  85 rr              STA   catch_tag_hi
001007r 2  68                 PLA
001008r 2  85 rr              STA   catch_tag_lo
00100Ar 2  68                 PLA
00100Br 2  85 rr              STA   catch_active
00100Dr 2               
00100Dr 2                     ; Discard saved eval_in_body + tag ptr (3 bytes)
00100Dr 2  68                 PLA                         ; eval_in_body
00100Er 2  68                 PLA                         ; tag_hi
00100Fr 2  68                 PLA                         ; tag_lo
001010r 2               
001010r 2                     ; Set eval_cur past the body
001010r 2  A5 rr              LDA   catch_resume_lo
001012r 2  85 rr              STA   eval_cur_lo
001014r 2  A5 rr              LDA   catch_resume_hi
001016r 2  85 rr              STA   eval_cur_hi
001018r 2  4C rr rr           JMP   eval_continue
00101Br 2               
00101Br 2               @err_bracket_pop:
00101Br 2                     ; Clean up: body-start was partially popped by skip_list_body error
00101Br 2  68                 PLA                         ; body_start_hi
00101Cr 2  68                 PLA                         ; body_start_lo
00101Dr 2                     ; Restore previous catch frame
00101Dr 2  68                 PLA
00101Er 2  85 rr              STA   catch_resume_hi
001020r 2  68                 PLA
001021r 2  85 rr              STA   catch_resume_lo
001023r 2  68                 PLA
001024r 2  85 rr              STA   catch_sp
001026r 2  68                 PLA
001027r 2  85 rr              STA   catch_tag_hi
001029r 2  68                 PLA
00102Ar 2  85 rr              STA   catch_tag_lo
00102Cr 2  68                 PLA
00102Dr 2  85 rr              STA   catch_active
00102Fr 2                     ; Discard saved eval_in_body + tag ptr (3 bytes)
00102Fr 2  68                 PLA
001030r 2  68                 PLA
001031r 2  68                 PLA
001032r 2                     ; Print bracket error
001032r 2  A2 rr              LDX   #<str_catch_bracket
001034r 2  A0 rr              LDY   #>str_catch_bracket
001036r 2  80 04              BRA   catch_print_err
001038r 2               
001038r 2               @err_tag:
001038r 2  A2 rr              LDX   #<str_catch_err
00103Ar 2  A0 rr              LDY   #>str_catch_err
00103Cr 2                     ; fall through
00103Cr 2               
00103Cr 2               catch_print_err:
00103Cr 2  86 rr              STX   ptr_lo
00103Er 2  84 rr              STY   ptr_hi
