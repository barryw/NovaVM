002E91r 2               
002E91r 2                     ; Follow next
002E91r 2  A5 rr              LDA   proc_entry_lo
002E93r 2  85 rr              STA   ptr_lo
002E95r 2  A5 rr              LDA   proc_entry_hi
002E97r 2  85 rr              STA   ptr_hi
002E99r 2  A0 00              LDY   #0
002E9Br 2  B1 rr              LDA   (ptr_lo),Y
002E9Dr 2  AA                 TAX
002E9Er 2  C8                 INY
002E9Fr 2  B1 rr              LDA   (ptr_lo),Y
002EA1r 2  85 rr              STA   proc_entry_hi
002EA3r 2  86 rr              STX   proc_entry_lo
002EA5r 2  80 C5              BRA   @walk
002EA7r 2               
002EA7r 2               @done:
002EA7r 2  20 rr rr           JSR   eval_newline
002EAAr 2  4C rr rr           JMP   eval_continue
002EADr 2               
002EADr 2               ; ---------------------------------------------------------------------
002EADr 2               ; do_po — PO "name: print procedure definition
002EADr 2               ;   Arity 0 — evaluates its own argument
002EADr 2               ; ---------------------------------------------------------------------
002EADr 2               do_po:
002EADr 2  20 rr rr           JSR   eval_expr
002EB0r 2  90 03              BCC   @po_type_ok
002EB2r 2  4C rr rr           JMP   @err
002EB5r 2               @po_type_ok:
002EB5r 2  A5 rr              LDA   eval_type
002EB7r 2  C9 01              CMP   #VAL_WORD
002EB9r 2  F0 03              BEQ   @po_word_ok
002EBBr 2  4C rr rr           JMP   @err
002EBEr 2               @po_word_ok:
002EBEr 2               
002EBEr 2                     ; Look up by name
002EBEr 2  A5 rr              LDA   eval_val_lo
002EC0r 2  85 rr              STA   ptr_lo
002EC2r 2  A5 rr              LDA   eval_val_hi
002EC4r 2  85 rr              STA   ptr_hi
002EC6r 2  20 rr rr           JSR   proc_find_by_name
002EC9r 2  90 03              BCC   @po_found
002ECBr 2  4C rr rr           JMP   @err_notfound
002ECEr 2               @po_found:
002ECEr 2               
002ECEr 2                     ; proc_entry_lo/hi = record
002ECEr 2                     ; Print "TO "
002ECEr 2  A9 54              LDA   #'T'
002ED0r 2  8D 0E A0           STA   VGC_CHAROUT
002ED3r 2  A9 4F              LDA   #'O'
002ED5r 2  8D 0E A0           STA   VGC_CHAROUT
002ED8r 2  A9 20              LDA   #' '
002EDAr 2  8D 0E A0           STA   VGC_CHAROUT
002EDDr 2               
002EDDr 2                     ; Print name
002EDDr 2  A5 rr              LDA   proc_entry_lo
002EDFr 2  85 rr              STA   ptr_lo
002EE1r 2  A5 rr              LDA   proc_entry_hi
002EE3r 2  85 rr              STA   ptr_hi
002EE5r 2  A0 02              LDY   #2
002EE7r 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002EE9r 2  AA                 TAX
002EEAr 2  85 rr              STA   proc_name_len
002EECr 2  F0 0B              BEQ   @po_params
002EEEr 2  A0 03              LDY   #3
002EF0r 2               @po_name_ch:
002EF0r 2  B1 rr              LDA   (ptr_lo),Y
002EF2r 2  8D 0E A0           STA   VGC_CHAROUT
002EF5r 2  C8                 INY
002EF6r 2  CA                 DEX
002EF7r 2  D0 F7              BNE   @po_name_ch
002EF9r 2               
002EF9r 2               @po_params:
002EF9r 2                     ; Y = 3 + name_len = offset to param_count
002EF9r 2  A5 rr              LDA   proc_name_len
002EFBr 2  18                 CLC
002EFCr 2  69 03              ADC   #3
002EFEr 2  A8                 TAY
002EFFr 2  B1 rr              LDA   (ptr_lo),Y             ; param_count
002F01r 2  85 rr              STA   proc_param_cnt
002F03r 2  C8                 INY                           ; offset to first param
002F04r 2  84 rr              STY   proc_rec_off
002F06r 2               
002F06r 2  A5 rr              LDA   proc_param_cnt
002F08r 2  F0 2E              BEQ   @po_header_done
002F0Ar 2               
002F0Ar 2  A6 rr              LDX   proc_param_cnt
002F0Cr 2               @po_param:
002F0Cr 2                     ; Print " :"
002F0Cr 2  A9 20              LDA   #' '
002F0Er 2  8D 0E A0           STA   VGC_CHAROUT
002F11r 2  A9 3A              LDA   #':'
002F13r 2  8D 0E A0           STA   VGC_CHAROUT
002F16r 2               
002F16r 2                     ; Read param name length
002F16r 2  A5 rr              LDA   proc_entry_lo
002F18r 2  85 rr              STA   ptr_lo
002F1Ar 2  A5 rr              LDA   proc_entry_hi
002F1Cr 2  85 rr              STA   ptr_hi
002F1Er 2  A4 rr              LDY   proc_rec_off
002F20r 2  B1 rr              LDA   (ptr_lo),Y             ; param name length
002F22r 2  DA                 PHX
002F23r 2  AA                 TAX                           ; X = chars to print
002F24r 2  C8                 INY
002F25r 2               @po_pch:
002F25r 2  E0 00              CPX   #0
002F27r 2  F0 09              BEQ   @po_param_done
002F29r 2  B1 rr              LDA   (ptr_lo),Y
002F2Br 2  8D 0E A0           STA   VGC_CHAROUT
002F2Er 2  C8                 INY
002F2Fr 2  CA                 DEX
002F30r 2  80 F3              BRA   @po_pch
002F32r 2               @po_param_done:
002F32r 2  84 rr              STY   proc_rec_off
002F34r 2  FA                 PLX
002F35r 2  CA                 DEX
002F36r 2  D0 D4              BNE   @po_param
002F38r 2               
002F38r 2               @po_header_done:
002F38r 2  20 rr rr           JSR   eval_newline
002F3Br 2               
002F3Br 2                     ; Read body_len
002F3Br 2  A5 rr              LDA   proc_entry_lo
002F3Dr 2  85 rr              STA   ptr_lo
002F3Fr 2  A5 rr              LDA   proc_entry_hi
002F41r 2  85 rr              STA   ptr_hi
002F43r 2  A4 rr              LDY   proc_rec_off
002F45r 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_lo
002F47r 2  85 rr              STA   proc_body_len_lo
002F49r 2  C8                 INY
002F4Ar 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_hi
002F4Cr 2  85 rr              STA   proc_body_len_hi
002F4Er 2  C8                 INY                           ; Y = offset to body text
002F4Fr 2               
002F4Fr 2                     ; Compute absolute pointer to body
002F4Fr 2  84 rr              STY   proc_rec_off
002F51r 2  18                 CLC
002F52r 2  A5 rr              LDA   proc_entry_lo
002F54r 2  65 rr              ADC   proc_rec_off
002F56r 2  85 rr              STA   proc_ptr_lo
002F58r 2  A5 rr              LDA   proc_entry_hi
002F5Ar 2  69 00              ADC   #0
002F5Cr 2  85 rr              STA   proc_ptr_hi
002F5Er 2               
002F5Er 2                     ; Print body text, converting $0A to CR+LF
002F5Er 2               @po_body:
002F5Er 2  A5 rr              LDA   proc_body_len_lo
002F60r 2  05 rr              ORA   proc_body_len_hi
002F62r 2  F0 20              BEQ   @po_end
002F64r 2               
002F64r 2  A0 00              LDY   #0
002F66r 2  B1 rr              LDA   (proc_ptr_lo),Y
002F68r 2  C9 0A              CMP   #$0A
002F6Ar 2  D0 05              BNE   @po_char
002F6Cr 2  20 rr rr           JSR   eval_newline
002F6Fr 2  80 03              BRA   @po_advance
002F71r 2               @po_char:
002F71r 2  8D 0E A0           STA   VGC_CHAROUT
002F74r 2               @po_advance:
002F74r 2  E6 rr              INC   proc_ptr_lo
002F76r 2  D0 02              BNE   :+
002F78r 2  E6 rr              INC   proc_ptr_hi
002F7Ar 2  A5 rr        :     LDA   proc_body_len_lo
002F7Cr 2  D0 02              BNE   :+
002F7Er 2  C6 rr              DEC   proc_body_len_hi
002F80r 2  C6 rr        :     DEC   proc_body_len_lo
002F82r 2  80 DA              BRA   @po_body
002F84r 2               
002F84r 2               @po_end:
002F84r 2                     ; Print "END"
002F84r 2  A9 45              LDA   #'E'
002F86r 2  8D 0E A0           STA   VGC_CHAROUT
002F89r 2  A9 4E              LDA   #'N'
002F8Br 2  8D 0E A0           STA   VGC_CHAROUT
002F8Er 2  A9 44              LDA   #'D'
002F90r 2  8D 0E A0           STA   VGC_CHAROUT
002F93r 2  20 rr rr           JSR   eval_newline
002F96r 2  4C rr rr           JMP   eval_continue
002F99r 2               
002F99r 2               @err:
002F99r 2  A2 rr              LDX   #<str_po_err
002F9Br 2  A0 rr              LDY   #>str_po_err
002F9Dr 2  4C rr rr           JMP   list_print_err
002FA0r 2               @err_notfound:
002FA0r 2  A2 rr              LDX   #<str_idk
002FA2r 2  A0 rr              LDY   #>str_idk
002FA4r 2  4C rr rr           JMP   list_print_err
002FA7r 2               
002FA7r 2               ; ---------------------------------------------------------------------
002FA7r 2               ; do_erase — ERASE "name: remove procedure from directory
002FA7r 2               ;   Arity 0 — evaluates its own argument
002FA7r 2               ; ---------------------------------------------------------------------
002FA7r 2               do_erase:
002FA7r 2  20 rr rr           JSR   eval_expr
002FAAr 2  90 03              BCC   @er_type_ok
002FACr 2  4C rr rr           JMP   @err
002FAFr 2               @er_type_ok:
002FAFr 2  A5 rr              LDA   eval_type
002FB1r 2  C9 01              CMP   #VAL_WORD
002FB3r 2  F0 03              BEQ   @er_word_ok
002FB5r 2  4C rr rr           JMP   @err
002FB8r 2               @er_word_ok:
002FB8r 2               
002FB8r 2                     ; Save name pointer
002FB8r 2  A5 rr              LDA   eval_val_lo
002FBAr 2  85 rr              STA   var_name_lo
002FBCr 2  A5 rr              LDA   eval_val_hi
002FBEr 2  85 rr              STA   var_name_hi
002FC0r 2               
002FC0r 2                     ; Walk proc_head with prev tracking
002FC0r 2                     ; prev = address of "next" pointer to patch (starts as &proc_head)
002FC0r 2  A9 rr              LDA   #<proc_head_lo
002FC2r 2  85 rr              STA   proc_ptr_lo             ; prev_ptr_lo
002FC4r 2  A9 rr              LDA   #>proc_head_lo
002FC6r 2  85 rr              STA   proc_ptr_hi             ; prev_ptr_hi (ZP, so high byte = 0)
002FC8r 2               
002FC8r 2  A5 rr              LDA   proc_head_lo
002FCAr 2  85 rr              STA   proc_entry_lo
002FCCr 2  A5 rr              LDA   proc_head_hi
002FCEr 2  85 rr              STA   proc_entry_hi
002FD0r 2               
002FD0r 2               @walk:
002FD0r 2  A5 rr              LDA   proc_entry_lo
002FD2r 2  05 rr              ORA   proc_entry_hi
002FD4r 2  D0 03              BNE   @walk_ok
002FD6r 2  4C rr rr           JMP   @not_found
002FD9r 2               @walk_ok:
002FD9r 2               
002FD9r 2                     ; Compare name
002FD9r 2  A5 rr              LDA   var_name_lo
002FDBr 2  85 rr              STA   ptr_lo
002FDDr 2  A5 rr              LDA   var_name_hi
002FDFr 2  85 rr              STA   ptr_hi
002FE1r 2  A0 00              LDY   #0
002FE3r 2  B1 rr              LDA   (ptr_lo),Y             ; search name len
002FE5r 2  85 rr              STA   proc_name_len
002FE7r 2               
002FE7r 2  A5 rr              LDA   proc_entry_lo
002FE9r 2  85 rr              STA   ptr_lo
002FEBr 2  A5 rr              LDA   proc_entry_hi
002FEDr 2  85 rr              STA   ptr_hi
002FEFr 2  A0 02              LDY   #2
002FF1r 2  B1 rr              LDA   (ptr_lo),Y             ; record name len
002FF3r 2  C5 rr              CMP   proc_name_len
002FF5r 2  D0 32              BNE   @erase_next
002FF7r 2               
002FF7r 2  AA                 TAX
002FF8r 2  F0 4D              BEQ   @erase_match            ; both empty = match
002FFAr 2  A0 00              LDY   #0
002FFCr 2               @ecmp:
002FFCr 2  DA                 PHX
002FFDr 2  5A                 PHY
002FFEr 2  A5 rr              LDA   var_name_lo
003000r 2  85 rr              STA   ptr_lo
003002r 2  A5 rr              LDA   var_name_hi
003004r 2  85 rr              STA   ptr_hi
003006r 2  C8                 INY
003007r 2  B1 rr              LDA   (ptr_lo),Y             ; search char
003009r 2  85 rr              STA   proc_rec_off
00300Br 2               
00300Br 2  7A                 PLY
00300Cr 2  A5 rr              LDA   proc_entry_lo
00300Er 2  85 rr              STA   ptr_lo
003010r 2  A5 rr              LDA   proc_entry_hi
003012r 2  85 rr              STA   ptr_hi
003014r 2  5A                 PHY
003015r 2  98                 TYA
003016r 2  18                 CLC
003017r 2  69 03              ADC   #3
003019r 2  A8                 TAY
00301Ar 2  B1 rr              LDA   (ptr_lo),Y             ; record char
00301Cr 2  7A                 PLY
00301Dr 2  C5 rr              CMP   proc_rec_off
00301Fr 2  D0 07              BNE   @ecmp_ne
003021r 2  FA                 PLX
003022r 2  C8                 INY
003023r 2  CA                 DEX
003024r 2  D0 D6              BNE   @ecmp
003026r 2  80 1F              BRA   @erase_match
003028r 2               
003028r 2               @ecmp_ne:
003028r 2  FA                 PLX
003029r 2               
003029r 2               @erase_next:
003029r 2                     ; prev = &current->next (proc_entry + 0)
003029r 2  A5 rr              LDA   proc_entry_lo
00302Br 2  85 rr              STA   proc_ptr_lo
00302Dr 2  A5 rr              LDA   proc_entry_hi
00302Fr 2  85 rr              STA   proc_ptr_hi
003031r 2                     ; current = current->next
003031r 2  A5 rr              LDA   proc_entry_lo
003033r 2  85 rr              STA   ptr_lo
003035r 2  A5 rr              LDA   proc_entry_hi
003037r 2  85 rr              STA   ptr_hi
003039r 2  A0 00              LDY   #0
00303Br 2  B1 rr              LDA   (ptr_lo),Y
00303Dr 2  AA                 TAX
00303Er 2  C8                 INY
00303Fr 2  B1 rr              LDA   (ptr_lo),Y
003041r 2  85 rr              STA   proc_entry_hi
003043r 2  86 rr              STX   proc_entry_lo
003045r 2  80 89              BRA   @walk
003047r 2               
003047r 2               @erase_match:
003047r 2                     ; Unlink: *prev = current->next
003047r 2                     ; Read current->next
003047r 2  A5 rr              LDA   proc_entry_lo
003049r 2  85 rr              STA   ptr_lo
00304Br 2  A5 rr              LDA   proc_entry_hi
00304Dr 2  85 rr              STA   ptr_hi
00304Fr 2  A0 00              LDY   #0
003051r 2  B1 rr              LDA   (ptr_lo),Y             ; next_lo
003053r 2  AA                 TAX
003054r 2  C8                 INY
003055r 2  B1 rr              LDA   (ptr_lo),Y             ; next_hi
003057r 2               
003057r 2                     ; Write to prev
003057r 2  A0 00              LDY   #0
003059r 2  A5 rr              LDA   proc_ptr_lo
00305Br 2  85 rr              STA   ptr_lo
00305Dr 2  A5 rr              LDA   proc_ptr_hi
00305Fr 2  85 rr              STA   ptr_hi
003061r 2  8A                 TXA
003062r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_lo = next_lo
003064r 2  C8                 INY
003065r 2  A5 rr              LDA   proc_entry_lo
003067r 2  85 rr              STA   ptr_lo
003069r 2  A5 rr              LDA   proc_entry_hi
00306Br 2  85 rr              STA   ptr_hi
00306Dr 2  A0 01              LDY   #1
00306Fr 2  B1 rr              LDA   (ptr_lo),Y             ; re-read next_hi
003071r 2  A0 01              LDY   #1
003073r 2  A5 rr              LDA   proc_ptr_lo
003075r 2  85 rr              STA   ptr_lo
003077r 2  A5 rr              LDA   proc_ptr_hi
003079r 2  85 rr              STA   ptr_hi
00307Br 2  A5 rr              LDA   proc_entry_lo
00307Dr 2  85 rr              STA   ptr2_lo
00307Fr 2  A5 rr              LDA   proc_entry_hi
003081r 2  85 rr              STA   ptr2_hi
003083r 2  A0 01              LDY   #1
003085r 2  B1 rr              LDA   (ptr2_lo),Y            ; next_hi
003087r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_hi = next_hi
003089r 2               
003089r 2  4C rr rr           JMP   eval_continue
00308Cr 2               
00308Cr 2               @not_found:
00308Cr 2  A2 rr              LDX   #<str_idk
00308Er 2  A0 rr              LDY   #>str_idk
003090r 2  4C rr rr           JMP   list_print_err
003093r 2               @err:
003093r 2  A2 rr              LDX   #<str_erase_err
003095r 2  A0 rr              LDY   #>str_erase_err
003097r 2  4C rr rr           JMP   list_print_err
00309Ar 2               
00309Ar 2               ; ---------------------------------------------------------------------
00309Ar 2               ; do_apply — APPLY "proc [args]: call procedure with args from list
00309Ar 2               ;   Arity 0 — evaluates its own arguments
00309Ar 2               ;   Strategy: build "name arg1 arg2 ..." in input_buf, tokenize+eval.
00309Ar 2               ; ---------------------------------------------------------------------
00309Ar 2               do_apply:
00309Ar 2                     ; Evaluate first arg: procedure name (quoted word)
00309Ar 2  20 rr rr           JSR   eval_expr
00309Dr 2  90 03              BCC   @ap_type_ok
00309Fr 2  4C rr rr           JMP   @err
0030A2r 2               @ap_type_ok:
0030A2r 2  A5 rr              LDA   eval_type
0030A4r 2  C9 01              CMP   #VAL_WORD
0030A6r 2  F0 03              BEQ   @ap_word_ok
0030A8r 2  4C rr rr           JMP   @err
0030ABr 2               @ap_word_ok:
0030ABr 2               
0030ABr 2                     ; Copy proc name to input_buf
0030ABr 2  A5 rr              LDA   eval_val_lo
0030ADr 2  85 rr              STA   ptr_lo
0030AFr 2  A5 rr              LDA   eval_val_hi
0030B1r 2  85 rr              STA   ptr_hi
0030B3r 2  64 rr              STZ   z:buf_idx
0030B5r 2  A0 00              LDY   #0
0030B7r 2  B1 rr              LDA   (ptr_lo),Y             ; name length
0030B9r 2  AA                 TAX
0030BAr 2  F0 10              BEQ   @apply_args
0030BCr 2  C8                 INY
0030BDr 2               @apply_name:
0030BDr 2  B1 rr              LDA   (ptr_lo),Y
0030BFr 2  5A                 PHY
0030C0r 2  A4 rr              LDY   z:buf_idx
0030C2r 2  99 rr rr           STA   input_buf,Y
0030C5r 2  E6 rr              INC   z:buf_idx
0030C7r 2  7A                 PLY
0030C8r 2  C8                 INY
0030C9r 2  CA                 DEX
0030CAr 2  D0 F1              BNE   @apply_name
0030CCr 2               
0030CCr 2               @apply_args:
0030CCr 2                     ; Evaluate second arg: list of arguments
0030CCr 2  20 rr rr           JSR   eval_expr
0030CFr 2  B0 5B              BCS   @err
0030D1r 2  A5 rr              LDA   eval_type
0030D3r 2  C9 02              CMP   #VAL_LIST
0030D5r 2  D0 55              BNE   @err
0030D7r 2               
0030D7r 2                     ; Render list elements to input_buf (after name)
0030D7r 2                     ; eval_val_lo/hi = list head
0030D7r 2  A5 rr              LDA   eval_val_lo
0030D9r 2  05 rr              ORA   eval_val_hi
0030DBr 2  F0 11              BEQ   @apply_run              ; empty arg list, just run name
0030DDr 2               
0030DDr 2                     ; Use render_list_to_buf — it prepends space before elements
0030DDr 2                     ; but we need a space before the first arg too
0030DDr 2  A5 rr              LDA   z:buf_idx
0030DFr 2  C9 7E              CMP   #126
0030E1r 2  B0 0B              BCS   @apply_run
0030E3r 2  A8                 TAY
0030E4r 2  A9 20              LDA   #' '
0030E6r 2  99 rr rr           STA   input_buf,Y
0030E9r 2  E6 rr              INC   z:buf_idx
0030EBr 2               
0030EBr 2                     ; render_list_to_buf expects eval_val set
0030EBr 2  20 rr rr           JSR   render_list_to_buf
0030EEr 2               
0030EEr 2               @apply_run:
0030EEr 2                     ; Null-terminate
0030EEr 2  A6 rr              LDX   z:buf_idx
0030F0r 2  9E rr rr           STZ   input_buf,X
0030F3r 2               
0030F3r 2                     ; Save eval state and tokenize+eval (same pattern as do_run)
0030F3r 2  A5 rr              LDA   eval_cur_lo
0030F5r 2  48                 PHA
0030F6r 2  A5 rr              LDA   eval_cur_hi
0030F8r 2  48                 PHA
0030F9r 2  A5 rr              LDA   tok_head_lo
0030FBr 2  48                 PHA
0030FCr 2  A5 rr              LDA   tok_head_hi
0030FEr 2  48                 PHA
0030FFr 2  A5 rr              LDA   tok_tail_lo
003101r 2  48                 PHA
003102r 2  A5 rr              LDA   tok_tail_hi
003104r 2  48                 PHA
003105r 2  A5 rr              LDA   eval_in_body
003107r 2  48                 PHA
003108r 2  A5 rr              LDA   eval_reporter
00310Ar 2  48                 PHA
00310Br 2               
00310Br 2  20 rr rr           JSR   tokenize_line
00310Er 2  20 rr rr           JSR   eval_line
003111r 2               
003111r 2  68                 PLA
003112r 2  85 rr              STA   eval_reporter
003114r 2  68                 PLA
003115r 2  85 rr              STA   eval_in_body
003117r 2  68                 PLA
003118r 2  85 rr              STA   tok_tail_hi
00311Ar 2  68                 PLA
00311Br 2  85 rr              STA   tok_tail_lo
00311Dr 2  68                 PLA
00311Er 2  85 rr              STA   tok_head_hi
003120r 2  68                 PLA
003121r 2  85 rr              STA   tok_head_lo
003123r 2  68                 PLA
003124r 2  85 rr              STA   eval_cur_hi
003126r 2  68                 PLA
003127r 2  85 rr              STA   eval_cur_lo
003129r 2               
003129r 2  4C rr rr           JMP   eval_continue
00312Cr 2               
00312Cr 2               @err:
00312Cr 2  A2 rr              LDX   #<str_apply_err
00312Er 2  A0 rr              LDY   #>str_apply_err
003130r 2  4C rr rr           JMP   list_print_err
003133r 2               
003133r 2               ; =====================================================================
003133r 2               ; RODATA — procedure strings
003133r 2               ; =====================================================================
003133r 2                     .segment "RODATA"
0009DEr 2               
0009DEr 2               str_defined:
0009DEr 2  20 44 45 46        .byte " DEFINED", 0
0009E2r 2  49 4E 45 44  
0009E6r 2  00           
0009E7r 2               
0009E7r 2               str_to_needs_name:
0009E7r 2  54 4F 20 4E        .byte "TO NEEDS A NAME", 0
0009EBr 2  45 45 44 53  
0009EFr 2  20 41 20 4E  
0009F7r 2               
0009F7r 2               str_po_err:
0009F7r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO PO", 0
0009FBr 2  45 4E 4F 55  
0009FFr 2  47 48 20 49  
000A0Fr 2               
000A0Fr 2               str_erase_err:
000A0Fr 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO ERASE", 0
000A13r 2  45 4E 4F 55  
000A17r 2  47 48 20 49  
000A2Ar 2               
000A2Ar 2               str_apply_err:
000A2Ar 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO APPLY", 0
000A2Er 2  45 4E 4F 55  
000A32r 2  47 48 20 49  
000A45r 2               
000A45r 2               ; Builtin name strings for workspace commands
000A45r 2               str_po_name:
000A45r 2  02 50 4F           .byte 2, "PO"
000A48r 2               str_printout_name:
000A48r 2  08 50 52 49        .byte 8, "PRINTOUT"
000A4Cr 2  4E 54 4F 55  
000A50r 2  54           
000A51r 2               str_pots_name:
000A51r 2  04 50 4F 54        .byte 4, "POTS"
000A55r 2  53           
000A56r 2               str_printtitles_name:
000A56r 2  0B 50 52 49        .byte 11, "PRINTTITLES"
000A5Ar 2  4E 54 54 49  
000A5Er 2  54 4C 45 53  
000A62r 2               str_erase_name:
000A62r 2  05 45 52 41        .byte 5, "ERASE"
000A66r 2  53 45        
000A68r 2               str_apply_name:
000A68r 2  05 41 50 50        .byte 5, "APPLY"
000A6Cr 2  4C 59        
000A6Er 2               
000A6Er 1                     .include "gc.s"
000A6Er 2               ; gc.s — mark-sweep garbage collector for NovaLogo
000A6Er 2               ;
000A6Er 2               ; Allocation header (prepended by heap_alloc):
000A6Er 2               ;   +0: alloc_tag  (bit 7 = mark, bits 6-0 = type)
000A6Er 2               ;   +1: alloc_size (total size including header; 0 = use 16-bit size at +2/+3)
000A6Er 2               ;
000A6Er 2               ; Type constants (bits 6-0 of alloc_tag):
000A6Er 2               ATYPE_FREE   = $00
000A6Er 2               ATYPE_TOKEN  = $01
000A6Er 2               ATYPE_CONS   = $02
000A6Er 2               ATYPE_VAR    = $03
000A6Er 2               ATYPE_PROC   = $04
000A6Er 2               ATYPE_STRING = $05
000A6Er 2               
000A6Er 2               ; Header layout offsets (relative to allocation base, NOT payload)
000A6Er 2               GC_HDR_TAG   = 0
000A6Er 2               GC_HDR_SIZE  = 1
000A6Er 2               GC_HDR_BYTES = 2              ; overhead per allocation
000A6Er 2               
000A6Er 2               ; Mark bit
000A6Er 2               ALLOC_MARK_BIT = $80
000A6Er 2               
000A6Er 2               ; =====================================================================
000A6Er 2               ; ZEROPAGE segment — GC variables
000A6Er 2               ; =====================================================================
000A6Er 2                     .segment "ZEROPAGE"
000047r 2               
000047r 2  xx           gc_ptr_lo:    .res 1          ; GC walk pointer low
000048r 2  xx           gc_ptr_hi:    .res 1          ; GC walk pointer high
000049r 2  xx           gc_tmp_lo:    .res 1          ; GC temp low
00004Ar 2  xx           gc_tmp_hi:    .res 1          ; GC temp high
00004Br 2  xx           gc_mark_lo:   .res 1          ; node-to-mark pointer low
00004Cr 2  xx           gc_mark_hi:   .res 1          ; node-to-mark pointer high
00004Dr 2               
00004Dr 2               ; =====================================================================
00004Dr 2               ; CODE segment — GC routines
00004Dr 2               ; =====================================================================
00004Dr 2                     .segment "CODE"
003133r 2               
003133r 2               ; ---------------------------------------------------------------------
003133r 2               ; gc_collect — run a full mark-sweep garbage collection cycle
003133r 2               ;   1. Clear all mark bits
003133r 2               ;   2. Mark all reachable objects from roots
003133r 2               ;   3. Sweep: coalesce all unmarked blocks and reset heap_ptr
003133r 2               ;
003133r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_tmp, gc_mark, ptr_lo/hi, ptr2_lo/hi
003133r 2               ; ---------------------------------------------------------------------
003133r 2               gc_collect:
003133r 2                     ; Phase 1: Clear all mark bits by walking the heap linearly
003133r 2  A9 00              LDA   #<HEAP_START
003135r 2  85 rr              STA   gc_ptr_lo
003137r 2  A9 04              LDA   #>HEAP_START
003139r 2  85 rr              STA   gc_ptr_hi
00313Br 2               
00313Br 2               @clear_loop:
00313Br 2                     ; Have we reached heap_ptr (end of allocated space)?
00313Br 2  A5 rr              LDA   gc_ptr_hi
00313Dr 2  C5 rr              CMP   heap_ptr+1
00313Fr 2  90 08              BCC   @clear_one
003141r 2  D0 41              BNE   @clear_done
003143r 2  A5 rr              LDA   gc_ptr_lo
003145r 2  C5 rr              CMP   heap_ptr
003147r 2  B0 3B              BCS   @clear_done
003149r 2               
003149r 2               @clear_one:
003149r 2                     ; Clear mark bit on this allocation
003149r 2  A5 rr              LDA   gc_ptr_lo
00314Br 2  85 rr              STA   ptr_lo
00314Dr 2  A5 rr              LDA   gc_ptr_hi
00314Fr 2  85 rr              STA   ptr_hi
003151r 2  A0 00              LDY   #GC_HDR_TAG
003153r 2  B1 rr              LDA   (ptr_lo),Y
003155r 2  29 7F              AND   #<~ALLOC_MARK_BIT    ; clear bit 7
003157r 2  91 rr              STA   (ptr_lo),Y
003159r 2               
003159r 2                     ; Advance by alloc_size
003159r 2  A0 01              LDY   #GC_HDR_SIZE
00315Br 2  B1 rr              LDA   (ptr_lo),Y
00315Dr 2  F0 0B              BEQ   @clear_big           ; size=0 means 16-bit size at +2/+3
00315Fr 2  18                 CLC
003160r 2  65 rr              ADC   gc_ptr_lo
003162r 2  85 rr              STA   gc_ptr_lo
003164r 2  90 D5              BCC   @clear_loop
003166r 2  E6 rr              INC   gc_ptr_hi
003168r 2  80 D1              BRA   @clear_loop
00316Ar 2               
00316Ar 2               @clear_big:
00316Ar 2                     ; 16-bit size at payload offset 0 and 1 (header +2 and +3)
00316Ar 2  A0 02              LDY   #GC_HDR_BYTES
00316Cr 2  B1 rr              LDA   (ptr_lo),Y
00316Er 2  85 rr              STA   gc_tmp_lo
003170r 2  C8                 INY
003171r 2  B1 rr              LDA   (ptr_lo),Y
003173r 2  85 rr              STA   gc_tmp_hi
003175r 2  18                 CLC
003176r 2  A5 rr              LDA   gc_ptr_lo
003178r 2  65 rr              ADC   gc_tmp_lo
00317Ar 2  85 rr              STA   gc_ptr_lo
00317Cr 2  A5 rr              LDA   gc_ptr_hi
00317Er 2  65 rr              ADC   gc_tmp_hi
003180r 2  85 rr              STA   gc_ptr_hi
003182r 2  80 B7              BRA   @clear_loop
003184r 2               
003184r 2               @clear_done:
003184r 2               
003184r 2                     ; Phase 2: Mark all reachable objects
003184r 2                     ; Root 1: variable list (var_head)
003184r 2  20 rr rr           JSR   gc_mark_vars
003187r 2               
003187r 2                     ; Root 2: procedure list (proc_head)
003187r 2  20 rr rr           JSR   gc_mark_procs
00318Ar 2               
00318Ar 2                     ; Root 3: current token list (tok_head)
00318Ar 2  20 rr rr           JSR   gc_mark_token_list
00318Dr 2               
00318Dr 2                     ; Phase 3: Sweep — find the highest marked allocation,
00318Dr 2                     ; reset heap_ptr to just past it. This works because we
00318Dr 2                     ; use a bump allocator with no free list; all unmarked
00318Dr 2                     ; allocations between marked ones become wasted space,
00318Dr 2                     ; but in practice the permanent objects (vars, procs) are
00318Dr 2                     ; allocated early and the ephemeral ones (tokens, cons,
00318Dr 2                     ; strings) are allocated later and all unmarked — so
00318Dr 2                     ; heap_ptr shrinks back dramatically.
00318Dr 2                     ;
00318Dr 2                     ; Walk the heap forward; track the highest end-address
00318Dr 2                     ; of any marked allocation.
00318Dr 2  A9 00              LDA   #<HEAP_START
00318Fr 2  85 rr              STA   gc_ptr_lo
003191r 2  A9 04              LDA   #>HEAP_START
003193r 2  85 rr              STA   gc_ptr_hi
003195r 2                     ; gc_tmp = highest marked end (start at HEAP_START = nothing marked)
003195r 2  A9 00              LDA   #<HEAP_START
003197r 2  85 rr              STA   gc_tmp_lo
003199r 2  A9 04              LDA   #>HEAP_START
00319Br 2  85 rr              STA   gc_tmp_hi
00319Dr 2               
00319Dr 2               @sweep_loop:
00319Dr 2                     ; Reached end of allocated space?
00319Dr 2  A5 rr              LDA   gc_ptr_hi
00319Fr 2  C5 rr              CMP   heap_ptr+1
0031A1r 2  90 08              BCC   @sweep_one
0031A3r 2  D0 49              BNE   @sweep_done
0031A5r 2  A5 rr              LDA   gc_ptr_lo
0031A7r 2  C5 rr              CMP   heap_ptr
0031A9r 2  B0 43              BCS   @sweep_done
0031ABr 2               
0031ABr 2               @sweep_one:
0031ABr 2  A5 rr              LDA   gc_ptr_lo
0031ADr 2  85 rr              STA   ptr_lo
0031AFr 2  A5 rr              LDA   gc_ptr_hi
0031B1r 2  85 rr              STA   ptr_hi
0031B3r 2               
0031B3r 2                     ; Get size of this allocation
0031B3r 2  A0 01              LDY   #GC_HDR_SIZE
0031B5r 2  B1 rr              LDA   (ptr_lo),Y
0031B7r 2  F0 06              BEQ   @sweep_big
0031B9r 2  85 rr              STA   gc_mark_lo            ; use gc_mark_lo as temp for size
0031BBr 2  64 rr              STZ   gc_mark_hi
0031BDr 2  80 0B              BRA   @sweep_check_mark
0031BFr 2               
0031BFr 2               @sweep_big:
0031BFr 2  A0 02              LDY   #GC_HDR_BYTES
0031C1r 2  B1 rr              LDA   (ptr_lo),Y
0031C3r 2  85 rr              STA   gc_mark_lo
0031C5r 2  C8                 INY
0031C6r 2  B1 rr              LDA   (ptr_lo),Y
0031C8r 2  85 rr              STA   gc_mark_hi
0031CAr 2               
0031CAr 2               @sweep_check_mark:
0031CAr 2                     ; Is this allocation marked?
0031CAr 2  A0 00              LDY   #GC_HDR_TAG
0031CCr 2  B1 rr              LDA   (ptr_lo),Y
0031CEr 2  29 80              AND   #ALLOC_MARK_BIT
0031D0r 2  F0 0D              BEQ   @sweep_advance        ; not marked — skip
0031D2r 2               
0031D2r 2                     ; Marked — compute end address = gc_ptr + size
0031D2r 2  18                 CLC
0031D3r 2  A5 rr              LDA   gc_ptr_lo
0031D5r 2  65 rr              ADC   gc_mark_lo
0031D7r 2  85 rr              STA   gc_tmp_lo             ; update highest end
0031D9r 2  A5 rr              LDA   gc_ptr_hi
0031DBr 2  65 rr              ADC   gc_mark_hi
0031DDr 2  85 rr              STA   gc_tmp_hi
0031DFr 2               
0031DFr 2               @sweep_advance:
0031DFr 2                     ; Advance gc_ptr by size
0031DFr 2  18                 CLC
0031E0r 2  A5 rr              LDA   gc_ptr_lo
0031E2r 2  65 rr              ADC   gc_mark_lo
0031E4r 2  85 rr              STA   gc_ptr_lo
0031E6r 2  A5 rr              LDA   gc_ptr_hi
0031E8r 2  65 rr              ADC   gc_mark_hi
0031EAr 2  85 rr              STA   gc_ptr_hi
0031ECr 2  80 AF              BRA   @sweep_loop
0031EEr 2               
0031EEr 2               @sweep_done:
0031EEr 2                     ; Set heap_ptr to highest marked end
0031EEr 2  A5 rr              LDA   gc_tmp_lo
0031F0r 2  85 rr              STA   heap_ptr
0031F2r 2  A5 rr              LDA   gc_tmp_hi
0031F4r 2  85 rr              STA   heap_ptr+1
0031F6r 2  60                 RTS
0031F7r 2               
0031F7r 2               ; ---------------------------------------------------------------------
0031F7r 2               ; gc_mark_node — mark a single allocation given a payload pointer
0031F7r 2               ;   Input: gc_mark_lo/hi = pointer to payload (header is at -2)
0031F7r 2               ;   If pointer is $0000 or below HEAP_START, skip.
0031F7r 2               ;   Clobbers: A, Y (preserves gc_mark_lo/hi)
0031F7r 2               ; ---------------------------------------------------------------------
0031F7r 2               gc_mark_node:
0031F7r 2                     ; Null check
0031F7r 2  A5 rr              LDA   gc_mark_lo
0031F9r 2  05 rr              ORA   gc_mark_hi
0031FBr 2  F0 21              BEQ   @done
0031FDr 2               
0031FDr 2                     ; Compute header address = payload - 2
0031FDr 2  A5 rr              LDA   gc_mark_lo
0031FFr 2  38                 SEC
003200r 2  E9 02              SBC   #GC_HDR_BYTES
003202r 2  85 rr              STA   ptr_lo
003204r 2  A5 rr              LDA   gc_mark_hi
003206r 2  E9 00              SBC   #0
003208r 2  85 rr              STA   ptr_hi
00320Ar 2               
00320Ar 2                     ; Range check: must be >= HEAP_START
00320Ar 2  C9 04              CMP   #>HEAP_START
00320Cr 2  90 10              BCC   @done
00320Er 2  D0 06              BNE   @in_range
003210r 2  A5 rr              LDA   ptr_lo
003212r 2  C9 00              CMP   #<HEAP_START
003214r 2  90 08              BCC   @done
003216r 2               @in_range:
003216r 2               
003216r 2                     ; Set mark bit
003216r 2  A0 00              LDY   #GC_HDR_TAG
003218r 2  B1 rr              LDA   (ptr_lo),Y
00321Ar 2  09 80              ORA   #ALLOC_MARK_BIT
00321Cr 2  91 rr              STA   (ptr_lo),Y
00321Er 2               @done:
00321Er 2  60                 RTS
00321Fr 2               
00321Fr 2               ; ---------------------------------------------------------------------
00321Fr 2               ; gc_mark_vars — walk the variable linked list and mark each entry
00321Fr 2               ;   Also marks any list values pointed to by variables.
00321Fr 2               ;   Clobbers: A, X, Y, gc_ptr, gc_mark, ptr_lo/hi, ptr2_lo/hi
00321Fr 2               ; ---------------------------------------------------------------------
00321Fr 2               gc_mark_vars:
00321Fr 2  A5 rr              LDA   var_head_lo
003221r 2  85 rr              STA   gc_ptr_lo
003223r 2  A5 rr              LDA   var_head_hi
003225r 2  85 rr              STA   gc_ptr_hi
003227r 2               
003227r 2               @walk:
003227r 2  A5 rr              LDA   gc_ptr_lo
003229r 2  05 rr              ORA   gc_ptr_hi
00322Br 2  D0 01              BNE   @have_var
00322Dr 2  60                 RTS
00322Er 2               @have_var:
00322Er 2               
00322Er 2                     ; Mark this var entry
00322Er 2  A5 rr              LDA   gc_ptr_lo
003230r 2  85 rr              STA   gc_mark_lo
003232r 2  A5 rr              LDA   gc_ptr_hi
003234r 2  85 rr              STA   gc_mark_hi
003236r 2  20 rr rr           JSR   gc_mark_node
003239r 2               
003239r 2                     ; Read the variable's value — if it's a list, mark the list
003239r 2  A5 rr              LDA   gc_ptr_lo
00323Br 2  85 rr              STA   ptr_lo
00323Dr 2  A5 rr              LDA   gc_ptr_hi
00323Fr 2  85 rr              STA   ptr_hi
003241r 2  A0 02              LDY   #VAR_NAME_LEN
003243r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
003245r 2  18                 CLC
003246r 2  69 03              ADC   #VAR_NAME             ; offset to value_type
003248r 2  A8                 TAY
003249r 2  B1 rr              LDA   (ptr_lo),Y           ; value_type
00324Br 2  C9 02              CMP   #VAL_LIST
00324Dr 2  D0 23              BNE   @var_check_word
00324Fr 2                     ; It's a list — get the list head pointer and mark the list
00324Fr 2  C8                 INY
003250r 2  B1 rr              LDA   (ptr_lo),Y           ; val_hi (actually car_hi)
003252r 2  85 rr              STA   gc_tmp_hi
003254r 2  C8                 INY
003255r 2  B1 rr              LDA   (ptr_lo),Y           ; val_lo
003257r 2  85 rr              STA   gc_tmp_lo
003259r 2                     ; Save gc_ptr across recursive mark
003259r 2  A5 rr              LDA   gc_ptr_lo
00325Br 2  48                 PHA
00325Cr 2  A5 rr              LDA   gc_ptr_hi
00325Er 2  48                 PHA
00325Fr 2  A5 rr              LDA   gc_tmp_lo
003261r 2  85 rr              STA   gc_mark_lo
003263r 2  A5 rr              LDA   gc_tmp_hi
003265r 2  85 rr              STA   gc_mark_hi
003267r 2  20 rr rr           JSR   gc_mark_list
00326Ar 2  68                 PLA
00326Br 2  85 rr              STA   gc_ptr_hi
00326Dr 2  68                 PLA
00326Er 2  85 rr              STA   gc_ptr_lo
003270r 2  80 25              BRA   @var_next
003272r 2               
003272r 2               @var_check_word:
003272r 2  C9 01              CMP   #VAL_WORD
003274r 2  D0 21              BNE   @var_next
003276r 2                     ; It's a word — mark the string allocation
003276r 2  C8                 INY
003277r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_hi for word
003279r 2  85 rr              STA   gc_tmp_hi
00327Br 2  C8                 INY
00327Cr 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_lo for word
00327Er 2  85 rr              STA   gc_tmp_lo
003280r 2  A5 rr              LDA   gc_ptr_lo
003282r 2  48                 PHA
003283r 2  A5 rr              LDA   gc_ptr_hi
003285r 2  48                 PHA
003286r 2  A5 rr              LDA   gc_tmp_lo
003288r 2  85 rr              STA   gc_mark_lo
00328Ar 2  A5 rr              LDA   gc_tmp_hi
00328Cr 2  85 rr              STA   gc_mark_hi
00328Er 2  20 rr rr           JSR   gc_mark_node
003291r 2  68                 PLA
003292r 2  85 rr              STA   gc_ptr_hi
003294r 2  68                 PLA
003295r 2  85 rr              STA   gc_ptr_lo
003297r 2               
003297r 2               @var_next:
003297r 2                     ; Follow next pointer
003297r 2  A5 rr              LDA   gc_ptr_lo
003299r 2  85 rr              STA   ptr_lo
00329Br 2  A5 rr              LDA   gc_ptr_hi
00329Dr 2  85 rr              STA   ptr_hi
00329Fr 2  A0 00              LDY   #VAR_NEXT_LO
0032A1r 2  B1 rr              LDA   (ptr_lo),Y
0032A3r 2  AA                 TAX
0032A4r 2  C8                 INY
0032A5r 2  B1 rr              LDA   (ptr_lo),Y
0032A7r 2  85 rr              STA   gc_ptr_hi
0032A9r 2  86 rr              STX   gc_ptr_lo
0032ABr 2  4C rr rr           JMP   @walk
0032AEr 2               
0032AEr 2               ; ---------------------------------------------------------------------
0032AEr 2               ; gc_mark_procs — walk the procedure list and mark each record
0032AEr 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
0032AEr 2               ; ---------------------------------------------------------------------
0032AEr 2               gc_mark_procs:
0032AEr 2  A5 rr              LDA   proc_head_lo
0032B0r 2  85 rr              STA   gc_ptr_lo
0032B2r 2  A5 rr              LDA   proc_head_hi
0032B4r 2  85 rr              STA   gc_ptr_hi
0032B6r 2               
0032B6r 2               @walk:
0032B6r 2  A5 rr              LDA   gc_ptr_lo
0032B8r 2  05 rr              ORA   gc_ptr_hi
0032BAr 2  F0 2B              BEQ   @done
0032BCr 2               
0032BCr 2                     ; Mark this procedure record.
0032BCr 2                     ; proc_entry points to record data (base+4); header is at base+0.
0032BCr 2                     ; Subtract 4 to get the header address for marking.
0032BCr 2  A5 rr              LDA   gc_ptr_lo
0032BEr 2  38                 SEC
0032BFr 2  E9 04              SBC   #4
0032C1r 2  85 rr              STA   ptr_lo
0032C3r 2  A5 rr              LDA   gc_ptr_hi
0032C5r 2  E9 00              SBC   #0
0032C7r 2  85 rr              STA   ptr_hi
0032C9r 2                     ; Set mark bit directly at the header
0032C9r 2  A0 00              LDY   #GC_HDR_TAG
0032CBr 2  B1 rr              LDA   (ptr_lo),Y
0032CDr 2  09 80              ORA   #ALLOC_MARK_BIT
0032CFr 2  91 rr              STA   (ptr_lo),Y
0032D1r 2               
0032D1r 2                     ; Follow next pointer (at record data offset 0)
0032D1r 2  A5 rr              LDA   gc_ptr_lo
0032D3r 2  85 rr              STA   ptr_lo
0032D5r 2  A5 rr              LDA   gc_ptr_hi
0032D7r 2  85 rr              STA   ptr_hi
0032D9r 2  A0 00              LDY   #0                    ; next_lo at offset 0
0032DBr 2  B1 rr              LDA   (ptr_lo),Y
0032DDr 2  AA                 TAX
0032DEr 2  C8                 INY
0032DFr 2  B1 rr              LDA   (ptr_lo),Y
0032E1r 2  85 rr              STA   gc_ptr_hi
0032E3r 2  86 rr              STX   gc_ptr_lo
0032E5r 2  80 CF              BRA   @walk
0032E7r 2               
0032E7r 2               @done:
0032E7r 2  60                 RTS
0032E8r 2               
0032E8r 2               ; ---------------------------------------------------------------------
0032E8r 2               ; gc_mark_token_list — walk tok_head linked list and mark each token
0032E8r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
0032E8r 2               ; ---------------------------------------------------------------------
0032E8r 2               gc_mark_token_list:
0032E8r 2  A5 rr              LDA   tok_head_lo
0032EAr 2  85 rr              STA   gc_ptr_lo
0032ECr 2  A5 rr              LDA   tok_head_hi
0032EEr 2  85 rr              STA   gc_ptr_hi
0032F0r 2               
0032F0r 2               @walk:
0032F0r 2  A5 rr              LDA   gc_ptr_lo
0032F2r 2  05 rr              ORA   gc_ptr_hi
0032F4r 2  F0 21              BEQ   @done
0032F6r 2               
0032F6r 2                     ; Mark this token
0032F6r 2  A5 rr              LDA   gc_ptr_lo
0032F8r 2  85 rr              STA   gc_mark_lo
0032FAr 2  A5 rr              LDA   gc_ptr_hi
0032FCr 2  85 rr              STA   gc_mark_hi
0032FEr 2  20 rr rr           JSR   gc_mark_node
003301r 2               
003301r 2                     ; Follow next pointer (at payload offsets TOK_NEXT_LO/HI)
003301r 2  A5 rr              LDA   gc_ptr_lo
003303r 2  85 rr              STA   ptr_lo
003305r 2  A5 rr              LDA   gc_ptr_hi
003307r 2  85 rr              STA   ptr_hi
003309r 2  A0 01              LDY   #TOK_NEXT_LO
00330Br 2  B1 rr              LDA   (ptr_lo),Y
00330Dr 2  AA                 TAX
00330Er 2  C8                 INY
00330Fr 2  B1 rr              LDA   (ptr_lo),Y
003311r 2  85 rr              STA   gc_ptr_hi
003313r 2  86 rr              STX   gc_ptr_lo
003315r 2  80 D9              BRA   @walk
003317r 2               
003317r 2               @done:
003317r 2  60                 RTS
003318r 2               
003318r 2               ; ---------------------------------------------------------------------
003318r 2               ; gc_mark_list — recursively mark a cons-pair list
003318r 2               ;   Input: gc_mark_lo/hi = head cons pair pointer (payload)
003318r 2               ;   Marks each cons cell, and recursively marks sublists and word strings.
003318r 2               ;   Clobbers: A, X, Y, gc_mark, gc_ptr, ptr_lo/hi
003318r 2               ; ---------------------------------------------------------------------
003318r 2               gc_mark_list:
003318r 2                     ; Use gc_ptr to walk the list, gc_mark for marking
003318r 2  A5 rr              LDA   gc_mark_lo
00331Ar 2  85 rr              STA   gc_ptr_lo
00331Cr 2  A5 rr              LDA   gc_mark_hi
00331Er 2  85 rr              STA   gc_ptr_hi
003320r 2               
003320r 2               @walk:
003320r 2  A5 rr              LDA   gc_ptr_lo
003322r 2  05 rr              ORA   gc_ptr_hi
003324r 2  F0 70              BEQ   @done
003326r 2               
003326r 2                     ; Mark this cons pair
003326r 2  A5 rr              LDA   gc_ptr_lo
003328r 2  85 rr              STA   gc_mark_lo
00332Ar 2  A5 rr              LDA   gc_ptr_hi
00332Cr 2  85 rr              STA   gc_mark_hi
00332Er 2  20 rr rr           JSR   gc_mark_node
003331r 2               
003331r 2                     ; Check car_type: if list, recursively mark sublist
003331r 2                     ; if word, mark the string
003331r 2  A5 rr              LDA   gc_ptr_lo
003333r 2  85 rr              STA   ptr_lo
003335r 2  A5 rr              LDA   gc_ptr_hi
003337r 2  85 rr              STA   ptr_hi
003339r 2  A0 01              LDY   #CONS_CAR_TYPE
00333Br 2  B1 rr              LDA   (ptr_lo),Y
00333Dr 2  C9 02              CMP   #VAL_LIST
00333Fr 2  F0 23              BEQ   @car_list
003341r 2  C9 01              CMP   #VAL_WORD
003343r 2  F0 02              BEQ   @car_word
003345r 2  80 38              BRA   @follow_cdr
003347r 2               
003347r 2               @car_word:
003347r 2                     ; Mark the word string allocation
003347r 2  A0 03              LDY   #CONS_CAR_LO
003349r 2  B1 rr              LDA   (ptr_lo),Y
00334Br 2  85 rr              STA   gc_mark_lo
00334Dr 2  A0 02              LDY   #CONS_CAR_HI
00334Fr 2  B1 rr              LDA   (ptr_lo),Y
003351r 2  85 rr              STA   gc_mark_hi
003353r 2                     ; Save gc_ptr across mark
003353r 2  A5 rr              LDA   gc_ptr_lo
003355r 2  48                 PHA
003356r 2  A5 rr              LDA   gc_ptr_hi
003358r 2  48                 PHA
003359r 2  20 rr rr           JSR   gc_mark_node
00335Cr 2  68                 PLA
00335Dr 2  85 rr              STA   gc_ptr_hi
00335Fr 2  68                 PLA
003360r 2  85 rr              STA   gc_ptr_lo
003362r 2  80 1B              BRA   @follow_cdr
003364r 2               
003364r 2               @car_list:
003364r 2                     ; Recursively mark the sublist
003364r 2  A0 03              LDY   #CONS_CAR_LO
003366r 2  B1 rr              LDA   (ptr_lo),Y
003368r 2  85 rr              STA   gc_mark_lo
00336Ar 2  A0 02              LDY   #CONS_CAR_HI
00336Cr 2  B1 rr              LDA   (ptr_lo),Y
00336Er 2  85 rr              STA   gc_mark_hi
003370r 2                     ; Save gc_ptr across recursive call
003370r 2  A5 rr              LDA   gc_ptr_lo
003372r 2  48                 PHA
003373r 2  A5 rr              LDA   gc_ptr_hi
003375r 2  48                 PHA
003376r 2  20 rr rr           JSR   gc_mark_list          ; recursive
003379r 2  68                 PLA
00337Ar 2  85 rr              STA   gc_ptr_hi
00337Cr 2  68                 PLA
00337Dr 2  85 rr              STA   gc_ptr_lo
00337Fr 2               
00337Fr 2               @follow_cdr:
00337Fr 2                     ; Follow cdr to next cons pair
00337Fr 2  A5 rr              LDA   gc_ptr_lo
003381r 2  85 rr              STA   ptr_lo
003383r 2  A5 rr              LDA   gc_ptr_hi
003385r 2  85 rr              STA   ptr_hi
003387r 2  A0 05              LDY   #CONS_CDR_LO
003389r 2  B1 rr              LDA   (ptr_lo),Y
00338Br 2  AA                 TAX
00338Cr 2  A0 06              LDY   #CONS_CDR_HI
00338Er 2  B1 rr              LDA   (ptr_lo),Y
003390r 2  85 rr              STA   gc_ptr_hi
003392r 2  86 rr              STX   gc_ptr_lo
003394r 2  80 8A              BRA   @walk
003396r 2               
003396r 2               @done:
003396r 2  60                 RTS
003397r 2               
003397r 1               
003397r 1               ; =====================================================================
003397r 1               ; ZEROPAGE segment — interpreter zero-page variables
003397r 1               ; =====================================================================
003397r 1                     .segment "ZEROPAGE"
00004Dr 1               
00004Dr 1  xx           buf_idx:      .res 1          ; current position in input_buf
00004Er 1               
00004Er 1               ; =====================================================================
00004Er 1               ; BSS segment — runtime buffers
00004Er 1               ; =====================================================================
00004Er 1                     .segment "BSS"
000983r 1               
000983r 1  xx xx xx xx  input_buf:    .res 128        ; input line buffer
000987r 1  xx xx xx xx  
00098Br 1  xx xx xx xx  
000A03r 1               
000A03r 1               ; =====================================================================
000A03r 1               ; CODE segment — cold start and main loop
000A03r 1               ; =====================================================================
000A03r 1                     .segment "CODE"
003397r 1               
003397r 1               cold_start:
003397r 1                     ; Copy extension ROM trampoline to RAM
003397r 1  A2 0D              LDX   #EXT_TRAMP_SIZE-1
003399r 1               @copy_tramp:
003399r 1  BD rr rr           LDA   ext_tramp_src,X
00339Cr 1  9D 70 02           STA   EXT_TRAMPOLINE,X
00339Fr 1  CA                 DEX
0033A0r 1  10 F7              BPL   @copy_tramp
0033A2r 1               
0033A2r 1                     ; Zero NovaLogo turtle/graphics state ($9F00..$9F1F) so each session starts
0033A2r 1                     ; in a known mode. The extension pins its turtle state here (extension.s
0033A2r 1                     ; TURTLE_STATE_BASE=$9F00); RAM is stale across soft-reboot on HW, and a
0033A2r 1                     ; stale graphics-mode/inited flag breaks auto-switch and re-init.
0033A2r 1  A2 1F              LDX   #$1F
0033A4r 1               @zero_turtle:
0033A4r 1  9E 00 9F           STZ   $9F00,X
0033A7r 1  CA                 DEX
0033A8r 1  10 FA              BPL   @zero_turtle
0033AAr 1               
0033AAr 1  20 rr rr           JSR   heap_init
0033ADr 1  20 rr rr           JSR   var_init
0033B0r 1  20 rr rr           JSR   proc_init
0033B3r 1  64 rr              STZ   catch_active
0033B5r 1  9C 0A A0           STZ   VGC_CURSEN
0033B8r 1  20 rr rr           JSR   print_banner
0033BBr 1  20 rr rr           JSR   print_prompt
0033BEr 1               
0033BEr 1               main_loop:
0033BEr 1  20 rr rr           JSR   read_line
0033C1r 1  9C 0A A0           STZ   VGC_CURSEN
0033C4r 1  20 rr rr           JSR   tokenize_line
0033C7r 1  20 rr rr           JSR   check_to_command
0033CAr 1  B0 03              BCS   @was_to               ; carry set = TO was handled
0033CCr 1  20 rr rr           JSR   eval_line
0033CFr 1               @was_to:
0033CFr 1                     ; Reclaim dead heap objects (tokens, list cells, etc.)
0033CFr 1  20 rr rr           JSR   gc_collect
0033D2r 1  20 rr rr           JSR   print_prompt
0033D5r 1  80 E7              BRA   main_loop
0033D7r 1               
0033D7r 1               ; ---------------------------------------------------------------------
0033D7r 1               ; check_to_command — check if first token is TO; if so, collect procedure
0033D7r 1               ;   Output: carry set = was TO (proc_collect called), carry clear = not TO
0033D7r 1               ;   Clobbers: A, Y, ptr_lo/hi, eval_cur
0033D7r 1               ; ---------------------------------------------------------------------
0033D7r 1               check_to_command:
0033D7r 1                     ; Is there a token list?
0033D7r 1  A5 rr              LDA   tok_head_lo
0033D9r 1  05 rr              ORA   tok_head_hi
0033DBr 1  F0 37              BEQ   @not_to
0033DDr 1               
0033DDr 1                     ; Check first token: must be TOK_WORD
0033DDr 1  A5 rr              LDA   tok_head_lo
0033DFr 1  85 rr              STA   ptr_lo
0033E1r 1  A5 rr              LDA   tok_head_hi
0033E3r 1  85 rr              STA   ptr_hi
0033E5r 1  A0 00              LDY   #TOK_TAG
0033E7r 1  B1 rr              LDA   (ptr_lo),Y
0033E9r 1  C9 01              CMP   #TOK_WORD
0033EBr 1  D0 27              BNE   @not_to
0033EDr 1               
0033EDr 1                     ; Check if word is "TO" (2 chars, 'T','O')
0033EDr 1  A0 03              LDY   #TOK_PAYLOAD
0033EFr 1  B1 rr              LDA   (ptr_lo),Y           ; length
0033F1r 1  C9 02              CMP   #2
0033F3r 1  D0 1F              BNE   @not_to
0033F5r 1  A0 04              LDY   #TOK_PAYLOAD+1
0033F7r 1  B1 rr              LDA   (ptr_lo),Y
0033F9r 1  C9 54              CMP   #'T'
0033FBr 1  D0 17              BNE   @not_to
0033FDr 1  C8                 INY
0033FEr 1  B1 rr              LDA   (ptr_lo),Y
003400r 1  C9 4F              CMP   #'O'
003402r 1  D0 10              BNE   @not_to
003404r 1               
003404r 1                     ; It's TO — set up eval_cur past the TO token and call proc_collect
003404r 1  A5 rr              LDA   tok_head_lo
003406r 1  85 rr              STA   eval_cur_lo
003408r 1  A5 rr              LDA   tok_head_hi
00340Ar 1  85 rr              STA   eval_cur_hi
00340Cr 1  20 rr rr           JSR   eval_advance          ; advance past TO token
00340Fr 1  20 rr rr           JSR   proc_collect
003412r 1  38                 SEC
003413r 1  60                 RTS
003414r 1               
003414r 1               @not_to:
003414r 1  18                 CLC
003415r 1  60                 RTS
003416r 1               
003416r 1               ; ---------------------------------------------------------------------
003416r 1               ; read_line — read a line of input into input_buf, null-terminated
003416r 1               ;   On return: input_buf contains the line, buf_idx = length
003416r 1               ; ---------------------------------------------------------------------
003416r 1               read_line:
003416r 1  64 rr              STZ   buf_idx            ; reset buffer index to 0
003418r 1  A9 01              LDA   #$01
00341Ar 1  8D 0A A0           STA   VGC_CURSEN
00341Dr 1               
00341Dr 1               @poll:
00341Dr 1  AD 0F A0           LDA   VGC_CHARIN         ; poll keyboard
003420r 1  F0 FB              BEQ   @poll              ; no key waiting — spin
003422r 1               
003422r 1                     ; --- handle CR ($0D) ---
003422r 1  C9 0D              CMP   #$0D
003424r 1  D0 39              BNE   @not_cr
003426r 1                     ; End of a typed line. If brackets/parens are still open, keep reading so
003426r 1                     ; a multi-line statement can be entered right at the prompt.
003426r 1  20 rr rr           JSR   line_bracket_depth
003429r 1  F0 24              BEQ   @cr_finish
00342Br 1  A6 rr              LDX   buf_idx
00342Dr 1  E0 78              CPX   #120
00342Fr 1  B0 1E              BCS   @cr_finish         ; buffer nearly full — stop accumulating
003431r 1  A9 0A              LDA   #$0A               ; newline separator (tokenizer treats it as space)
003433r 1  9D rr rr           STA   input_buf,X
003436r 1  E6 rr              INC   buf_idx
003438r 1  A9 0D              LDA   #$0D
00343Ar 1  8D 0E A0           STA   VGC_CHAROUT
00343Dr 1  A9 0A              LDA   #$0A
00343Fr 1  8D 0E A0           STA   VGC_CHAROUT
003442r 1  A9 7E              LDA   #'~'               ; continuation prompt
003444r 1  8D 0E A0           STA   VGC_CHAROUT
003447r 1  A9 20              LDA   #' '
003449r 1  8D 0E A0           STA   VGC_CHAROUT
00344Cr 1  4C rr rr           JMP   @poll
00344Fr 1               @cr_finish:
00344Fr 1  A6 rr              LDX   buf_idx
003451r 1  9E rr rr           STZ   input_buf,X        ; null-terminate
003454r 1  A9 0D              LDA   #$0D
003456r 1  8D 0E A0           STA   VGC_CHAROUT        ; carriage return
003459r 1  A9 0A              LDA   #$0A
00345Br 1  8D 0E A0           STA   VGC_CHAROUT        ; line feed
00345Er 1  60                 RTS
00345Fr 1               
00345Fr 1               @not_cr:
00345Fr 1                     ; --- handle backspace ($08, $14, $7F) ---
00345Fr 1  C9 08              CMP   #$08
003461r 1  F0 18              BEQ   @backspace
003463r 1  C9 14              CMP   #$14
003465r 1  F0 14              BEQ   @backspace
003467r 1  C9 7F              CMP   #$7F
003469r 1  F0 10              BEQ   @backspace
00346Br 1               
00346Br 1                     ; --- buffer full? ---
00346Br 1  A6 rr              LDX   buf_idx
00346Dr 1  E0 7F              CPX   #127
00346Fr 1  B0 AC              BCS   @poll              ; at capacity — ignore keystroke
003471r 1               
003471r 1                     ; --- store and echo printable character ---
003471r 1  9D rr rr           STA   input_buf,X        ; store in buffer
003474r 1  8D 0E A0           STA   VGC_CHAROUT        ; echo to screen
003477r 1  E6 rr              INC   buf_idx
003479r 1  80 A2              BRA   @poll
00347Br 1               
00347Br 1               @backspace:
00347Br 1  A6 rr              LDX   buf_idx
00347Dr 1  F0 9E              BEQ   @poll              ; nothing to delete — ignore
00347Fr 1  CA                 DEX
003480r 1  86 rr              STX   buf_idx
003482r 1  A9 08              LDA   #$08
003484r 1  8D 0E A0           STA   VGC_CHAROUT        ; move cursor left and erase
003487r 1  80 94              BRA   @poll
003489r 1               
003489r 1               ; ---------------------------------------------------------------------
003489r 1               ; line_bracket_depth — net count of unclosed '[' and '(' in input_buf[0..buf_idx),
003489r 1               ;   ignoring text inside ';' comments. Returns depth in A (Z set if balanced).
003489r 1               ;   Clobbers: A, X, Y.
003489r 1               ; ---------------------------------------------------------------------
003489r 1               line_bracket_depth:
003489r 1  A2 00              LDX   #0                 ; scan index
00348Br 1  A0 00              LDY   #0                 ; depth
00348Dr 1               @bd_loop:
00348Dr 1  E4 rr              CPX   buf_idx
00348Fr 1  B0 32              BCS   @bd_done
003491r 1  BD rr rr           LDA   input_buf,X
003494r 1  C9 3B              CMP   #';'
003496r 1  F0 1D              BEQ   @bd_comment
003498r 1  C9 5B              CMP   #'['
00349Ar 1  F0 0F              BEQ   @bd_inc
00349Cr 1  C9 28              CMP   #'('
00349Er 1  F0 0B              BEQ   @bd_inc
0034A0r 1  C9 5D              CMP   #']'
0034A2r 1  F0 0A              BEQ   @bd_dec
0034A4r 1  C9 29              CMP   #')'
0034A6r 1  F0 06              BEQ   @bd_dec
0034A8r 1               @bd_next:
0034A8r 1  E8                 INX
0034A9r 1  80 E2              BRA   @bd_loop
0034ABr 1               @bd_inc:
0034ABr 1  C8                 INY
0034ACr 1  80 FA              BRA   @bd_next
0034AEr 1               @bd_dec:
0034AEr 1  C0 00              CPY   #0
0034B0r 1  F0 F6              BEQ   @bd_next           ; floor at 0
0034B2r 1  88                 DEY
0034B3r 1  80 F3              BRA   @bd_next
0034B5r 1               @bd_comment:
0034B5r 1  E8                 INX                      ; skip ';' and everything up to a newline
0034B6r 1  E4 rr              CPX   buf_idx
0034B8r 1  B0 09              BCS   @bd_done
0034BAr 1  BD rr rr           LDA   input_buf,X
0034BDr 1  C9 0A              CMP   #$0A
0034BFr 1  D0 F4              BNE   @bd_comment
0034C1r 1  80 E5              BRA   @bd_next           ; resume scanning after the newline
0034C3r 1               @bd_done:
0034C3r 1  98                 TYA                      ; depth -> A, sets Z if zero
0034C4r 1  60                 RTS
0034C5r 1               
0034C5r 1               ; ---------------------------------------------------------------------
0034C5r 1               ; print_prompt — prints "? " to the screen
0034C5r 1               ; ---------------------------------------------------------------------
0034C5r 1               print_prompt:
0034C5r 1  A2 00              LDX   #0
0034C7r 1  BD rr rr     @lp:  LDA   str_prompt,X
0034CAr 1  F0 06              BEQ   @done
0034CCr 1  8D 0E A0           STA   VGC_CHAROUT
0034CFr 1  E8                 INX
0034D0r 1  D0 F5              BNE   @lp
0034D2r 1               @done:
0034D2r 1  A9 01              LDA   #$01
0034D4r 1  8D 0A A0           STA   VGC_CURSEN
0034D7r 1  60                 RTS
0034D8r 1               
0034D8r 1               ; ---------------------------------------------------------------------
0034D8r 1               ; print_banner — prints title and current available heap bytes
0034D8r 1               ; ---------------------------------------------------------------------
0034D8r 1               print_banner:
0034D8r 1  A2 00              LDX   #0
0034DAr 1               @title:
0034DAr 1  BD rr rr           LDA   str_banner_title,X
0034DDr 1  F0 06              BEQ   @free
0034DFr 1  8D 0E A0           STA   VGC_CHAROUT
0034E2r 1  E8                 INX
0034E3r 1  D0 F5              BNE   @title
0034E5r 1               
0034E5r 1               @free:
0034E5r 1  38                 SEC
0034E6r 1  A9 00              LDA   #<HEAP_END
0034E8r 1  E5 rr              SBC   heap_ptr
0034EAr 1  85 rr              STA   eval_val_lo
0034ECr 1  A9 98              LDA   #>HEAP_END
0034EEr 1  E5 rr              SBC   heap_ptr+1
0034F0r 1  85 rr              STA   eval_val_hi
0034F2r 1  38                 SEC
0034F3r 1  A5 rr              LDA   eval_val_lo
0034F5r 1  E9 02              SBC   #GC_HDR_BYTES
0034F7r 1  85 rr              STA   eval_val_lo
0034F9r 1  A5 rr              LDA   eval_val_hi
0034FBr 1  E9 00              SBC   #0
0034FDr 1  85 rr              STA   eval_val_hi
0034FFr 1  64 rr              STZ   eval_val_frac
003501r 1  20 rr rr           JSR   print_uint16
003504r 1               
003504r 1  A2 00              LDX   #0
003506r 1               @suffix:
003506r 1  BD rr rr           LDA   str_bytes_free,X
003509r 1  F0 06              BEQ   @done
00350Br 1  8D 0E A0           STA   VGC_CHAROUT
00350Er 1  E8                 INX
00350Fr 1  D0 F5              BNE   @suffix
003511r 1               @done:
003511r 1  60                 RTS
003512r 1               
003512r 1               ; =====================================================================
003512r 1               ; RODATA segment — string constants
003512r 1               ; =====================================================================
003512r 1                     .segment "RODATA"
000A6Er 1               
000A6Er 1               str_banner_title:
000A6Er 1  4E 6F 76 61        .byte "Nova LOGO v1.0", $0D, $0A
000A72r 1  20 4C 4F 47  
000A76r 1  4F 20 76 31  
000A7Er 1  00                 .byte 0
000A7Fr 1               str_bytes_free:
000A7Fr 1  20 42 59 54        .byte " BYTES FREE", $0D, $0A, $0D, $0A
000A83r 1  45 53 20 46  
000A87r 1  52 45 45 0D  
000A8Er 1  00                 .byte 0
000A8Fr 1               
000A8Fr 1               str_prompt:
000A8Fr 1  3F 20 00           .byte "? ", 0
000A92r 1               
000A92r 1               ; Extension ROM trampoline — copied to RAM at $0270 during cold_start.
000A92r 1               ; Swaps to extension ROM, calls entry, swaps back to Logo ROM.
000A92r 1               ext_tramp_src:
000A92r 1  A9 04              .byte $A9, ROMSWAP_EXTENSION  ; LDA #ROMSWAP_EXTENSION
000A94r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000A97r 1  20 00 C0           .byte $20, $00, $C0          ; JSR $C000
000A9Ar 1  A9 05              .byte $A9, ROMSWAP_LOGO      ; LDA #ROMSWAP_LOGO
000A9Cr 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000A9Fr 1  60                 .byte $60                     ; RTS
000AA0r 1               
000AA0r 1               ; =====================================================================
000AA0r 1               ; MONITOR segment — reset handler at $FFD7
000AA0r 1               ; =====================================================================
000AA0r 1                     .segment "MONITOR"
000000r 1                     .org  $FFD7
00FFD7  1               
00FFD7  1               RES_vec:
00FFD7  1  D8                 CLD                     ; clear decimal mode
00FFD8  1  A2 FF              LDX   #$FF              ; empty stack
00FFDA  1  9A                 TXS                     ; set the stack
00FFDB  1  4C rr rr           JMP   cold_start
00FFDE  1               
00FFDE  1               ; IRQ/NMI stubs
00FFDE  1               NMI_stub:
00FFDE  1  40                 RTI
00FFDF  1               
00FFDF  1               IRQ_stub:
00FFDF  1  40                 RTI
00FFE0  1               
00FFE0  1               ; =====================================================================
00FFE0  1               ; VECTORS segment — 6502 hardware vectors at $FFFA
00FFE0  1               ; =====================================================================
00FFE0  1                     .segment "VECTORS"
00FFE0  1                     .org  $FFFA
00FFFA  1               
00FFFA  1  DE FF              .word NMI_stub           ; $FFFA — NMI vector
00FFFC  1  D7 FF              .word RES_vec            ; $FFFC — RESET vector
00FFFE  1  DF FF              .word IRQ_stub           ; $FFFE — IRQ vector
00FFFE  1               
