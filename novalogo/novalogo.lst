00222Cr 2               ; ---------------------------------------------------------------------
00222Cr 2               ; do_word — WORD val1 val2: concatenate two words into one
00222Cr 2               ;   Arity 0: evaluates its own arguments
00222Cr 2               ; ---------------------------------------------------------------------
00222Cr 2               do_word:
00222Cr 2                     ; Evaluate first arg (must be a word)
00222Cr 2  20 rr rr           JSR   eval_expr
00222Fr 2  90 03              BCC   :+
002231r 2  4C rr rr           JMP   @err
002234r 2               :
002234r 2  A5 rr              LDA   eval_type
002236r 2  C9 01              CMP   #VAL_WORD
002238r 2  F0 03              BEQ   :+
00223Ar 2  4C rr rr           JMP   @err_type
00223Dr 2               :
00223Dr 2                     ; Save first word pointer
00223Dr 2  A5 rr              LDA   eval_val_lo
00223Fr 2  48                 PHA
002240r 2  A5 rr              LDA   eval_val_hi
002242r 2  48                 PHA
002243r 2               
002243r 2                     ; Evaluate second arg (must be a word)
002243r 2  20 rr rr           JSR   eval_expr
002246r 2  90 05              BCC   :+
002248r 2  68                 PLA
002249r 2  68                 PLA
00224Ar 2  4C rr rr           JMP   @err
00224Dr 2               :
00224Dr 2  A5 rr              LDA   eval_type
00224Fr 2  C9 01              CMP   #VAL_WORD
002251r 2  F0 03              BEQ   :+
002253r 2  4C rr rr           JMP   @err_type_pop2
002256r 2               :
002256r 2               
002256r 2                     ; eval_val = second word, stack has first word ptr
002256r 2                     ; Read lengths
002256r 2  A5 rr              LDA   eval_val_lo
002258r 2  85 rr              STA   ptr2_lo
00225Ar 2  A5 rr              LDA   eval_val_hi
00225Cr 2  85 rr              STA   ptr2_hi
00225Er 2  A0 00              LDY   #0
002260r 2  B1 rr              LDA   (ptr2_lo),Y            ; second word length
002262r 2  85 rr              STA   list_count_lo           ; save len2
002264r 2               
002264r 2                     ; Read first word length from stack
002264r 2  68                 PLA
002265r 2  85 rr              STA   list_head_hi            ; first word ptr hi
002267r 2  68                 PLA
002268r 2  85 rr              STA   list_head_lo            ; first word ptr lo
00226Ar 2  A5 rr              LDA   list_head_lo
00226Cr 2  85 rr              STA   ptr_lo
00226Er 2  A5 rr              LDA   list_head_hi
002270r 2  85 rr              STA   ptr_hi
002272r 2  A0 00              LDY   #0
002274r 2  B1 rr              LDA   (ptr_lo),Y             ; first word length
002276r 2  85 rr              STA   list_count_hi           ; save len1
002278r 2               
002278r 2                     ; Allocate new string: 1 (length byte) + len1 + len2
002278r 2  18                 CLC
002279r 2  65 rr              ADC   list_count_lo
00227Br 2  1A                 INC                           ; +1 for length byte
00227Cr 2  A2 05              LDX   #ATYPE_STRING
00227Er 2  20 rr rr           JSR   heap_alloc
002281r 2  B0 6F              BCS   @err_oom
002283r 2               
002283r 2                     ; Write combined length
002283r 2  A5 rr              LDA   list_count_hi
002285r 2  18                 CLC
002286r 2  65 rr              ADC   list_count_lo
002288r 2  A0 00              LDY   #0
00228Ar 2  91 rr              STA   (ptr_lo),Y
00228Cr 2               
00228Cr 2                     ; Copy first word's chars
00228Cr 2  A6 rr              LDX   list_count_hi           ; len1
00228Er 2  F0 23              BEQ   @w_copy2
002290r 2  A5 rr              LDA   list_head_lo
002292r 2  85 rr              STA   ptr2_lo
002294r 2  A5 rr              LDA   list_head_hi
002296r 2  85 rr              STA   ptr2_hi
002298r 2  A0 01              LDY   #1                     ; dest offset in new string
00229Ar 2  9C rr rr           STZ   num_tmp_lo              ; source offset
00229Dr 2               @w_c1:
00229Dr 2  DA                 PHX
00229Er 2  5A                 PHY
00229Fr 2  AD rr rr           LDA   num_tmp_lo
0022A2r 2  1A                 INC                           ; skip length byte in source
0022A3r 2  A8                 TAY
0022A4r 2  B1 rr              LDA   (ptr2_lo),Y            ; source char
0022A6r 2  7A                 PLY
0022A7r 2  91 rr              STA   (ptr_lo),Y             ; dest char
0022A9r 2  C8                 INY
0022AAr 2  EE rr rr           INC   num_tmp_lo
0022ADr 2  FA                 PLX
0022AEr 2  CA                 DEX
0022AFr 2  D0 EC              BNE   @w_c1
0022B1r 2               
0022B1r 2                     ; Y is already at the next dest offset
0022B1r 2  80 02              BRA   @w_copy2_start
0022B3r 2               
0022B3r 2               @w_copy2:
0022B3r 2  A0 01              LDY   #1                     ; start at offset 1 if len1 was 0
0022B5r 2               @w_copy2_start:
0022B5r 2                     ; Copy second word's chars
0022B5r 2  A6 rr              LDX   list_count_lo           ; len2
0022B7r 2  F0 1F              BEQ   @w_done
0022B9r 2  A5 rr              LDA   eval_val_lo
0022BBr 2  85 rr              STA   ptr2_lo
0022BDr 2  A5 rr              LDA   eval_val_hi
0022BFr 2  85 rr              STA   ptr2_hi
0022C1r 2  9C rr rr           STZ   num_tmp_lo
0022C4r 2               @w_c2:
0022C4r 2  DA                 PHX
0022C5r 2  5A                 PHY
0022C6r 2  AD rr rr           LDA   num_tmp_lo
0022C9r 2  1A                 INC
0022CAr 2  A8                 TAY
0022CBr 2  B1 rr              LDA   (ptr2_lo),Y
0022CDr 2  7A                 PLY
0022CEr 2  91 rr              STA   (ptr_lo),Y
0022D0r 2  C8                 INY
0022D1r 2  EE rr rr           INC   num_tmp_lo
0022D4r 2  FA                 PLX
0022D5r 2  CA                 DEX
0022D6r 2  D0 EC              BNE   @w_c2
0022D8r 2               
0022D8r 2               @w_done:
0022D8r 2                     ; Return the new word
0022D8r 2  A9 01              LDA   #VAL_WORD
0022DAr 2  85 rr              STA   eval_type
0022DCr 2  A5 rr              LDA   ptr_lo
0022DEr 2  85 rr              STA   eval_val_lo
0022E0r 2  A5 rr              LDA   ptr_hi
0022E2r 2  85 rr              STA   eval_val_hi
0022E4r 2  64 rr              STZ   eval_val_frac
0022E6r 2  4C rr rr           JMP   eval_continue
0022E9r 2               
0022E9r 2               @err_type_pop2:
0022E9r 2  68                 PLA
0022EAr 2  68                 PLA
0022EBr 2               @err_type:
0022EBr 2  A2 rr              LDX   #<str_word_type
0022EDr 2  A0 rr              LDY   #>str_word_type
0022EFr 2  4C rr rr           JMP   list_print_err
0022F2r 2               @err_oom:
