0005CAr 2               
0005CAr 1                     .include "lists.s"
0005CAr 2               ; lists.s — list data type, cons pairs, and list operations for NovaLogo
0005CAr 2               ;
0005CAr 2               ; Cons pair format on heap (7 bytes):
0005CAr 2               ;   +0: tag byte ($10 = CONS_PAIR)
0005CAr 2               ;   +1: car_type ($00=number, $01=word, $02=list)
0005CAr 2               ;   +2: car_hi
0005CAr 2               ;   +3: car_lo
0005CAr 2               ;   +4: car_frac (only meaningful for numbers)
0005CAr 2               ;   +5: cdr_lo (pointer to next cons pair, or $0000 for empty)
0005CAr 2               ;   +6: cdr_hi
0005CAr 2               
0005CAr 2               CONS_PAIR  = $10
0005CAr 2               CONS_SIZE  = 7
0005CAr 2               
0005CAr 2               ; Value type constants
0005CAr 2               .ifndef VAL_NUMBER
0005CAr 2               VAL_NUMBER = $00
0005CAr 2               .endif
0005CAr 2               .ifndef VAL_WORD
0005CAr 2               VAL_WORD   = $01
0005CAr 2               .endif
0005CAr 2               .ifndef VAL_LIST
0005CAr 2               VAL_LIST   = $02
0005CAr 2               .endif
0005CAr 2               
0005CAr 2               ; Cons pair field offsets
0005CAr 2               CONS_TAG      = 0
0005CAr 2               CONS_CAR_TYPE = 1
0005CAr 2               CONS_CAR_HI   = 2
0005CAr 2               CONS_CAR_LO   = 3
0005CAr 2               CONS_CAR_FRAC = 4
0005CAr 2               CONS_CDR_LO   = 5
0005CAr 2               CONS_CDR_HI   = 6
0005CAr 2               
0005CAr 2               ; =====================================================================
0005CAr 2               ; ZEROPAGE segment — list scratch variables
0005CAr 2               ; =====================================================================
0005CAr 2                     .segment "ZEROPAGE"
00002Er 2               
00002Er 2  xx           list_head_lo:   .res 1    ; head of list being built
00002Fr 2  xx           list_head_hi:   .res 1
000030r 2  xx           list_tail_lo:   .res 1    ; tail of list being built
000031r 2  xx           list_tail_hi:   .res 1
000032r 2  xx           list_ptr_lo:    .res 1    ; general list walk pointer
000033r 2  xx           list_ptr_hi:    .res 1
000034r 2  xx           list_count_lo:  .res 1    ; 16-bit counter for COUNT / ITEM
000035r 2  xx           list_count_hi:  .res 1
000036r 2               
000036r 2               ; =====================================================================
000036r 2               ; CODE segment — list building and operations
000036r 2               ; =====================================================================
000036r 2                     .segment "CODE"
001812r 2               
001812r 2               ; ---------------------------------------------------------------------
001812r 2               ; eval_list — build a list from tokens between [ and ]
001812r 2               ;   Entry: eval_cur points at the first token AFTER the [
001812r 2               ;   Exit:  eval_type = VAL_LIST, eval_val_lo/hi = head cons pair ptr
001812r 2               ;          eval_cur advanced past the matching ]
001812r 2               ;          Carry clear = success
001812r 2               ; ---------------------------------------------------------------------
001812r 2               eval_list:
001812r 2  64 rr              STZ   list_head_lo
001814r 2  64 rr              STZ   list_head_hi
001816r 2  64 rr              STZ   list_tail_lo
001818r 2  64 rr              STZ   list_tail_hi
00181Ar 2               
00181Ar 2               @next_element:
00181Ar 2  A5 rr              LDA   eval_cur_lo
00181Cr 2  05 rr              ORA   eval_cur_hi
00181Er 2  D0 03              BNE   :+
001820r 2  4C rr rr           JMP   @err_no_bracket
001823r 2               :
001823r 2  A5 rr              LDA   eval_cur_lo
001825r 2  85 rr              STA   ptr_lo
001827r 2  A5 rr              LDA   eval_cur_hi
001829r 2  85 rr              STA   ptr_hi
00182Br 2  A0 00              LDY   #TOK_TAG
00182Dr 2  B1 rr              LDA   (ptr_lo),Y
00182Fr 2               
00182Fr 2  C9 04              CMP   #TOK_RBRACKET
001831r 2  D0 03              BNE   :+
001833r 2  4C rr rr           JMP   @end_list
001836r 2               :
001836r 2  C9 02              CMP   #TOK_NUMBER
001838r 2  D0 03              BNE   :+
00183Ar 2  4C rr rr           JMP   @list_number
00183Dr 2  C9 01        :     CMP   #TOK_WORD
00183Fr 2  F0 10              BEQ   @list_word_jmp
001841r 2  C9 06              CMP   #TOK_QUOTE
001843r 2  F0 0C              BEQ   @list_word_jmp
001845r 2  C9 03              CMP   #TOK_LBRACKET
001847r 2  D0 03              BNE   :+
001849r 2  4C rr rr           JMP   @list_sublist
00184Cr 2               :     ; Unknown token type in list — skip it
00184Cr 2  20 rr rr           JSR   eval_advance
00184Fr 2  80 C9              BRA   @next_element
001851r 2               
001851r 2               @list_word_jmp:
001851r 2  4C rr rr           JMP   @list_word
001854r 2               
001854r 2               @list_number:
001854r 2  A0 03              LDY   #TOK_PAYLOAD
001856r 2  B1 rr              LDA   (ptr_lo),Y
001858r 2  85 rr              STA   eval_val_hi
00185Ar 2  C8                 INY
00185Br 2  B1 rr              LDA   (ptr_lo),Y
00185Dr 2  85 rr              STA   eval_val_lo
00185Fr 2  C8                 INY
001860r 2  B1 rr              LDA   (ptr_lo),Y
001862r 2  85 rr              STA   eval_val_frac
001864r 2  A9 00              LDA   #VAL_NUMBER
001866r 2  85 rr              STA   eval_type
001868r 2  20 rr rr           JSR   eval_advance
00186Br 2  4C rr rr           JMP   @alloc_cell
00186Er 2               
00186Er 2               @list_word:
00186Er 2  A0 03              LDY   #TOK_PAYLOAD
001870r 2  B1 rr              LDA   (ptr_lo),Y
001872r 2  48                 PHA
001873r 2  1A                 INC
001874r 2  A2 05              LDX   #ATYPE_STRING
001876r 2  20 rr rr           JSR   heap_alloc
001879r 2  90 04              BCC   :+
00187Br 2  68                 PLA
00187Cr 2  4C rr rr           JMP   @oom
00187Fr 2  A5 rr        :     LDA   eval_cur_lo
001881r 2  85 rr              STA   ptr2_lo
001883r 2  A5 rr              LDA   eval_cur_hi
001885r 2  85 rr              STA   ptr2_hi
001887r 2  68                 PLA
001888r 2  48                 PHA
001889r 2  A0 00              LDY   #0
00188Br 2  91 rr              STA   (ptr_lo),Y
00188Dr 2  68                 PLA
00188Er 2  AA                 TAX
00188Fr 2  F0 1B              BEQ   @word_done
001891r 2  A0 01              LDY   #1
001893r 2  9C rr rr           STZ   num_tmp_lo
001896r 2               @copy_word_ch:
001896r 2  DA                 PHX
001897r 2  5A                 PHY
001898r 2  AD rr rr           LDA   num_tmp_lo
00189Br 2  18                 CLC
00189Cr 2  69 04              ADC   #TOK_PAYLOAD+1
00189Er 2  A8                 TAY
00189Fr 2  B1 rr              LDA   (ptr2_lo),Y
0018A1r 2  7A                 PLY
0018A2r 2  91 rr              STA   (ptr_lo),Y
0018A4r 2  C8                 INY
0018A5r 2  EE rr rr           INC   num_tmp_lo
0018A8r 2  FA                 PLX
0018A9r 2  CA                 DEX
0018AAr 2  D0 EA              BNE   @copy_word_ch
0018ACr 2               @word_done:
0018ACr 2  A5 rr              LDA   ptr_lo
0018AEr 2  85 rr              STA   eval_val_lo
0018B0r 2  A5 rr              LDA   ptr_hi
0018B2r 2  85 rr              STA   eval_val_hi
0018B4r 2  64 rr              STZ   eval_val_frac
0018B6r 2  A9 01              LDA   #VAL_WORD
0018B8r 2  85 rr              STA   eval_type
0018BAr 2  20 rr rr           JSR   eval_advance
0018BDr 2  4C rr rr           JMP   @alloc_cell
0018C0r 2               
0018C0r 2               @list_sublist:
0018C0r 2  20 rr rr           JSR   eval_advance
0018C3r 2  A5 rr              LDA   list_head_lo
0018C5r 2  48                 PHA
0018C6r 2  A5 rr              LDA   list_head_hi
0018C8r 2  48                 PHA
0018C9r 2  A5 rr              LDA   list_tail_lo
0018CBr 2  48                 PHA
0018CCr 2  A5 rr              LDA   list_tail_hi
0018CEr 2  48                 PHA
0018CFr 2  20 rr rr           JSR   eval_list
0018D2r 2  90 06              BCC   @sublist_ok
0018D4r 2                     ; Error — clean up stack
0018D4r 2  68                 PLA
0018D5r 2  68                 PLA
0018D6r 2  68                 PLA
0018D7r 2  68                 PLA
0018D8r 2  38                 SEC
0018D9r 2  60                 RTS
0018DAr 2               @sublist_ok:
0018DAr 2  68                 PLA
0018DBr 2  85 rr              STA   list_tail_hi
0018DDr 2  68                 PLA
0018DEr 2  85 rr              STA   list_tail_lo
0018E0r 2  68                 PLA
0018E1r 2  85 rr              STA   list_head_hi
0018E3r 2  68                 PLA
0018E4r 2  85 rr              STA   list_head_lo
0018E6r 2                     ; eval_type already VAL_LIST, eval_val has sublist ptr
0018E6r 2                     ; fall through to @alloc_cell
0018E6r 2               
0018E6r 2               @alloc_cell:
0018E6r 2  A9 07              LDA   #CONS_SIZE
0018E8r 2  A2 02              LDX   #ATYPE_CONS
0018EAr 2  20 rr rr           JSR   heap_alloc
0018EDr 2  B0 71              BCS   @oom
0018EFr 2  A0 00              LDY   #CONS_TAG
0018F1r 2  A9 10              LDA   #CONS_PAIR
0018F3r 2  91 rr              STA   (ptr_lo),Y
0018F5r 2  A0 01              LDY   #CONS_CAR_TYPE
0018F7r 2  A5 rr              LDA   eval_type
0018F9r 2  91 rr              STA   (ptr_lo),Y
0018FBr 2  A0 02              LDY   #CONS_CAR_HI
0018FDr 2  A5 rr              LDA   eval_val_hi
0018FFr 2  91 rr              STA   (ptr_lo),Y
001901r 2  A0 03              LDY   #CONS_CAR_LO
001903r 2  A5 rr              LDA   eval_val_lo
001905r 2  91 rr              STA   (ptr_lo),Y
001907r 2  A0 04              LDY   #CONS_CAR_FRAC
001909r 2  A5 rr              LDA   eval_val_frac
00190Br 2  91 rr              STA   (ptr_lo),Y
00190Dr 2  A0 05              LDY   #CONS_CDR_LO
00190Fr 2  A9 00              LDA   #0
001911r 2  91 rr              STA   (ptr_lo),Y
001913r 2  A0 06              LDY   #CONS_CDR_HI
001915r 2  91 rr              STA   (ptr_lo),Y
001917r 2               
001917r 2                     ; Link into list
001917r 2  A5 rr              LDA   list_head_lo
001919r 2  05 rr              ORA   list_head_hi
00191Br 2  D0 0F              BNE   @link_tail
00191Dr 2               
00191Dr 2  A5 rr              LDA   ptr_lo
00191Fr 2  85 rr              STA   list_head_lo
001921r 2  85 rr              STA   list_tail_lo
001923r 2  A5 rr              LDA   ptr_hi
001925r 2  85 rr              STA   list_head_hi
001927r 2  85 rr              STA   list_tail_hi
001929r 2  4C rr rr           JMP   @next_element
00192Cr 2               
00192Cr 2               @link_tail:
00192Cr 2  A5 rr              LDA   list_tail_lo
00192Er 2  85 rr              STA   ptr2_lo
001930r 2  A5 rr              LDA   list_tail_hi
001932r 2  85 rr              STA   ptr2_hi
001934r 2  A0 05              LDY   #CONS_CDR_LO
001936r 2  A5 rr              LDA   ptr_lo
001938r 2  91 rr              STA   (ptr2_lo),Y
00193Ar 2  A0 06              LDY   #CONS_CDR_HI
00193Cr 2  A5 rr              LDA   ptr_hi
00193Er 2  91 rr              STA   (ptr2_lo),Y
001940r 2  A5 rr              LDA   ptr_lo
001942r 2  85 rr              STA   list_tail_lo
001944r 2  A5 rr              LDA   ptr_hi
001946r 2  85 rr              STA   list_tail_hi
001948r 2  4C rr rr           JMP   @next_element
00194Br 2               
00194Br 2               @end_list:
00194Br 2  20 rr rr           JSR   eval_advance
00194Er 2  A9 02              LDA   #VAL_LIST
001950r 2  85 rr              STA   eval_type
001952r 2  A5 rr              LDA   list_head_lo
001954r 2  85 rr              STA   eval_val_lo
001956r 2  A5 rr              LDA   list_head_hi
001958r 2  85 rr              STA   eval_val_hi
00195Ar 2  64 rr              STZ   eval_val_frac
00195Cr 2  18                 CLC
00195Dr 2  60                 RTS
00195Er 2               
00195Er 2               @err_no_bracket:
00195Er 2  38                 SEC
00195Fr 2  60                 RTS
001960r 2               
