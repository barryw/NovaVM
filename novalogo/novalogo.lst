00068Dr 1                     .include "lists.s"
00068Dr 2               ; lists.s — list data type, cons pairs, and list operations for NovaLogo
00068Dr 2               ;
00068Dr 2               ; Cons pair format on heap (7 bytes):
00068Dr 2               ;   +0: tag byte ($10 = CONS_PAIR)
00068Dr 2               ;   +1: car_type ($00=number, $01=word, $02=list)
00068Dr 2               ;   +2: car_hi
00068Dr 2               ;   +3: car_lo
00068Dr 2               ;   +4: car_frac (only meaningful for numbers)
00068Dr 2               ;   +5: cdr_lo (pointer to next cons pair, or $0000 for empty)
00068Dr 2               ;   +6: cdr_hi
00068Dr 2               
00068Dr 2               CONS_PAIR  = $10
00068Dr 2               CONS_SIZE  = 7
00068Dr 2               
00068Dr 2               ; Value type constants
00068Dr 2               .ifndef VAL_NUMBER
00068Dr 2               VAL_NUMBER = $00
00068Dr 2               .endif
00068Dr 2               .ifndef VAL_WORD
00068Dr 2               VAL_WORD   = $01
00068Dr 2               .endif
00068Dr 2               .ifndef VAL_LIST
00068Dr 2               VAL_LIST   = $02
00068Dr 2               .endif
00068Dr 2               
00068Dr 2               ; Cons pair field offsets
00068Dr 2               CONS_TAG      = 0
00068Dr 2               CONS_CAR_TYPE = 1
00068Dr 2               CONS_CAR_HI   = 2
00068Dr 2               CONS_CAR_LO   = 3
00068Dr 2               CONS_CAR_FRAC = 4
00068Dr 2               CONS_CDR_LO   = 5
00068Dr 2               CONS_CDR_HI   = 6
00068Dr 2               
00068Dr 2               ; =====================================================================
00068Dr 2               ; ZEROPAGE segment — list scratch variables
00068Dr 2               ; =====================================================================
00068Dr 2                     .segment "ZEROPAGE"
00002Er 2               
00002Er 2  xx           list_head_lo:   .res 1    ; head of list being built
00002Fr 2  xx           list_head_hi:   .res 1
000030r 2  xx           list_tail_lo:   .res 1    ; tail of list being built
000031r 2  xx           list_tail_hi:   .res 1
000032r 2  xx           list_ptr_lo:    .res 1    ; general list walk pointer
000033r 2  xx           list_ptr_hi:    .res 1
000034r 2  xx           list_count_lo:  .res 1    ; 16-bit counter for COUNT / ITEM
000035r 2  xx           list_count_hi:  .res 1
000036r 2               
000036r 2               ; =====================================================================
000036r 2               ; CODE segment — list building and operations
000036r 2               ; =====================================================================
000036r 2                     .segment "CODE"
00184Dr 2               
00184Dr 2               ; ---------------------------------------------------------------------
00184Dr 2               ; eval_list — build a list from tokens between [ and ]
00184Dr 2               ;   Entry: eval_cur points at the first token AFTER the [
00184Dr 2               ;   Exit:  eval_type = VAL_LIST, eval_val_lo/hi = head cons pair ptr
00184Dr 2               ;          eval_cur advanced past the matching ]
00184Dr 2               ;          Carry clear = success
00184Dr 2               ; ---------------------------------------------------------------------
00184Dr 2               eval_list:
00184Dr 2  64 rr              STZ   list_head_lo
00184Fr 2  64 rr              STZ   list_head_hi
001851r 2  64 rr              STZ   list_tail_lo
001853r 2  64 rr              STZ   list_tail_hi
001855r 2               
001855r 2               @next_element:
001855r 2  A5 rr              LDA   eval_cur_lo
001857r 2  05 rr              ORA   eval_cur_hi
001859r 2  D0 03              BNE   :+
00185Br 2  4C rr rr           JMP   @err_no_bracket
00185Er 2               :
00185Er 2  A5 rr              LDA   eval_cur_lo
001860r 2  85 rr              STA   ptr_lo
001862r 2  A5 rr              LDA   eval_cur_hi
001864r 2  85 rr              STA   ptr_hi
001866r 2  A0 00              LDY   #TOK_TAG
001868r 2  B1 rr              LDA   (ptr_lo),Y
00186Ar 2               
00186Ar 2  C9 04              CMP   #TOK_RBRACKET
00186Cr 2  D0 03              BNE   :+
00186Er 2  4C rr rr           JMP   @end_list
001871r 2               :
001871r 2  C9 02              CMP   #TOK_NUMBER
001873r 2  D0 03              BNE   :+
001875r 2  4C rr rr           JMP   @list_number
001878r 2  C9 01        :     CMP   #TOK_WORD
00187Ar 2  F0 10              BEQ   @list_word_jmp
00187Cr 2  C9 06              CMP   #TOK_QUOTE
00187Er 2  F0 0C              BEQ   @list_word_jmp
001880r 2  C9 03              CMP   #TOK_LBRACKET
001882r 2  D0 03              BNE   :+
