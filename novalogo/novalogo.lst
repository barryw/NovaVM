002DA1r 2  85 rr              STA   proc_stopped          ; restore outer proc_stopped
002DA3r 2  68                 PLA
002DA4r 2  85 rr              STA   eval_in_body
002DA6r 2  68                 PLA
002DA7r 2  85 rr              STA   tok_tail_hi
002DA9r 2  68                 PLA
002DAAr 2  85 rr              STA   tok_tail_lo
002DACr 2  68                 PLA
002DADr 2  85 rr              STA   tok_head_hi
002DAFr 2  68                 PLA
002DB0r 2  85 rr              STA   tok_head_lo
002DB2r 2               
