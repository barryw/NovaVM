00106Dr 2  48                 PHA
00106Er 2  A5 rr              LDA   catch_resume_hi
001070r 2  48                 PHA
001071r 2               
001071r 2                     ; Set up the tag pointer from saved values
001071r 2                     ; Stack (top to bottom): prev_frame(6), eval_in_body, eval_val_hi, eval_val_lo
001071r 2                     ; $0101+X = SP+1 = top. eval_in_body at SP+7, eval_val_hi at SP+8, eval_val_lo at SP+9
001071r 2  BA                 TSX
001072r 2  BD 08 01           LDA   $0108,X               ; eval_val_hi = tag ptr high
001075r 2  85 rr              STA   catch_tag_hi
