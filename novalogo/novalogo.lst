0021B3r 2  68                 PLA                           ; lo
0021B4r 2  85 rr              STA   list_tail_lo
0021B6r 2  68                 PLA                           ; hi
0021B7r 2  85 rr              STA   list_tail_hi
0021B9r 2  68                 PLA                           ; type (unused, known VAL_LIST)
0021BAr 2               
0021BAr 2                     ; Pop first list pointer
0021BAr 2  68                 PLA                           ; frac (unused)
0021BBr 2  68                 PLA                           ; lo
0021BCr 2  85 rr              STA   list_head_lo
0021BEr 2  68                 PLA                           ; hi
0021BFr 2  85 rr              STA   list_head_hi
0021C1r 2  68                 PLA                           ; type (unused)
0021C2r 2               
0021C2r 2                     ; If first list is empty, return second
0021C2r 2  A5 rr              LDA   list_head_lo
0021C4r 2  05 rr              ORA   list_head_hi
0021C6r 2  F0 44              BEQ   @se_return_second
0021C8r 2               
0021C8r 2                     ; Walk to end of first list, patch cdr to second
0021C8r 2  A5 rr              LDA   list_head_lo
