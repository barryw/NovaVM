00142Fr 2  A6 rr              LDX   z:buf_idx
001431r 2  E0 7E              CPX   #126
001433r 2  B0 E1              BCS   @rw_poll             ; buffer full
001435r 2  9D rr rr           STA   input_buf,X
001438r 2  8D 0E A0           STA   VGC_CHAROUT
00143Br 2  E6 rr              INC   z:buf_idx
00143Dr 2  80 D7              BRA   @rw_poll
00143Fr 2               
00143Fr 2               @rw_bs:
00143Fr 2  A6 rr              LDX   z:buf_idx
001441r 2  F0 D3              BEQ   @rw_poll
001443r 2  CA                 DEX
001444r 2  86 rr              STX   z:buf_idx
001446r 2  A9 08              LDA   #$08
001448r 2  8D 0E A0           STA   VGC_CHAROUT
00144Br 2  80 C9              BRA   @rw_poll
00144Dr 2               
00144Dr 2               @rw_done:
00144Dr 2                     ; Echo CR/LF
00144Dr 2  48                 PHA
00144Er 2  A9 0D              LDA   #$0D
001450r 2  8D 0E A0           STA   VGC_CHAROUT
001453r 2  A9 0A              LDA   #$0A
001455r 2  8D 0E A0           STA   VGC_CHAROUT
001458r 2  68                 PLA
001459r 2                     ; Allocate word: 1 (len) + buf_idx (chars)
001459r 2  A5 rr              LDA   z:buf_idx
00145Br 2  1A                 INC                        ; +1 for length byte
00145Cr 2  A2 05              LDX   #ATYPE_STRING
00145Er 2  20 rr rr           JSR   heap_alloc
001461r 2  B0 30              BCS   @rw_oom
001463r 2                     ; Write length
001463r 2  A5 rr              LDA   z:buf_idx
001465r 2  A0 00              LDY   #0
001467r 2  91 rr              STA   (ptr_lo),Y
001469r 2                     ; Copy chars
001469r 2  AA                 TAX
00146Ar 2  F0 16              BEQ   @rw_set
00146Cr 2  A0 01              LDY   #1
00146Er 2  9C rr rr           STZ   num_tmp_lo
001471r 2               @rw_copy:
001471r 2  5A                 PHY
001472r 2  AC rr rr           LDY   num_tmp_lo
001475r 2  B9 rr rr           LDA   input_buf,Y
001478r 2  7A                 PLY
001479r 2  91 rr              STA   (ptr_lo),Y
00147Br 2  C8                 INY
00147Cr 2  EE rr rr           INC   num_tmp_lo
00147Fr 2  CA                 DEX
001480r 2  D0 EF              BNE   @rw_copy
001482r 2               @rw_set:
001482r 2  A5 rr              LDA   ptr_lo
001484r 2  85 rr              STA   eval_val_lo
001486r 2  A5 rr              LDA   ptr_hi
001488r 2  85 rr              STA   eval_val_hi
00148Ar 2  A9 01              LDA   #VAL_WORD
00148Cr 2  85 rr              STA   eval_type
00148Er 2  64 rr              STZ   eval_val_frac
001490r 2  4C rr rr           JMP   eval_continue
001493r 2               @rw_oom:
001493r 2  A2 rr              LDX   #<str_oom
001495r 2  A0 rr              LDY   #>str_oom
001497r 2  4C rr rr           JMP   list_print_err
00149Ar 2               
00149Ar 2               ; ---------------------------------------------------------------------
00149Ar 2               ; do_readlist — READLIST: read a line, return as a list
00149Ar 2               ;   Arity 0, no arguments. Reporter.
00149Ar 2               ;   Calls read_line, tokenize_line, then walks tokens building a list.
00149Ar 2               ; ---------------------------------------------------------------------
00149Ar 2               do_readlist:
00149Ar 2                     ; Save tokenizer state (we'll overwrite tok_head/tok_tail)
00149Ar 2  A5 rr              LDA   tok_head_lo
00149Cr 2  48                 PHA
00149Dr 2  A5 rr              LDA   tok_head_hi
00149Fr 2  48                 PHA
0014A0r 2  A5 rr              LDA   tok_tail_lo
0014A2r 2  48                 PHA
0014A3r 2  A5 rr              LDA   tok_tail_hi
0014A5r 2  48                 PHA
0014A6r 2  A5 rr              LDA   eval_cur_lo
0014A8r 2  48                 PHA
0014A9r 2  A5 rr              LDA   eval_cur_hi
0014ABr 2  48                 PHA
0014ACr 2               
0014ACr 2                     ; Read a line from keyboard into input_buf
0014ACr 2  20 rr rr           JSR   read_line
0014AFr 2                     ; Tokenize it
0014AFr 2  20 rr rr           JSR   tokenize_line
0014B2r 2               
0014B2r 2                     ; Walk tokens and build a list
0014B2r 2  64 rr              STZ   z:list_head_lo
0014B4r 2  64 rr              STZ   z:list_head_hi
0014B6r 2  64 rr              STZ   z:list_tail_lo
0014B8r 2  64 rr              STZ   z:list_tail_hi
0014BAr 2               
0014BAr 2  A5 rr              LDA   tok_head_lo
0014BCr 2  85 rr              STA   eval_cur_lo
0014BEr 2  A5 rr              LDA   tok_head_hi
0014C0r 2  85 rr              STA   eval_cur_hi
0014C2r 2               
0014C2r 2               @rl_next:
0014C2r 2  A5 rr              LDA   eval_cur_lo
0014C4r 2  05 rr              ORA   eval_cur_hi
0014C6r 2  D0 03              BNE   @rl_have_tok
0014C8r 2  4C rr rr           JMP   @rl_build_done
0014CBr 2               @rl_have_tok:
0014CBr 2               
0014CBr 2  A5 rr              LDA   eval_cur_lo
0014CDr 2  85 rr              STA   ptr_lo
0014CFr 2  A5 rr              LDA   eval_cur_hi
0014D1r 2  85 rr              STA   ptr_hi
0014D3r 2  A0 00              LDY   #TOK_TAG
0014D5r 2  B1 rr              LDA   (ptr_lo),Y
0014D7r 2               
0014D7r 2  C9 02              CMP   #TOK_NUMBER
0014D9r 2  D0 03              BNE   :+
0014DBr 2  4C rr rr           JMP   @rl_number
0014DEr 2  C9 01        :     CMP   #TOK_WORD
0014E0r 2  F0 10              BEQ   @rl_word_jmp
0014E2r 2  C9 06              CMP   #TOK_QUOTE
0014E4r 2  F0 0C              BEQ   @rl_word_jmp
0014E6r 2  C9 03              CMP   #TOK_LBRACKET
0014E8r 2  D0 03              BNE   :+
0014EAr 2  4C rr rr           JMP   @rl_sublist
0014EDr 2               :     ; Skip other tokens (brackets, infix, etc.)
0014EDr 2  20 rr rr           JSR   eval_advance
0014F0r 2  80 D0              BRA   @rl_next
0014F2r 2               
0014F2r 2               @rl_word_jmp:
0014F2r 2  4C rr rr           JMP   @rl_word
0014F5r 2               
0014F5r 2               @rl_number:
0014F5r 2  A0 03              LDY   #TOK_PAYLOAD
0014F7r 2  B1 rr              LDA   (ptr_lo),Y
0014F9r 2  85 rr              STA   eval_val_hi
0014FBr 2  C8                 INY
0014FCr 2  B1 rr              LDA   (ptr_lo),Y
0014FEr 2  85 rr              STA   eval_val_lo
001500r 2  C8                 INY
001501r 2  B1 rr              LDA   (ptr_lo),Y
001503r 2  85 rr              STA   eval_val_frac
001505r 2  A9 00              LDA   #VAL_NUMBER
001507r 2  85 rr              STA   eval_type
001509r 2  20 rr rr           JSR   eval_advance
00150Cr 2  4C rr rr           JMP   @rl_alloc_cell
00150Fr 2               
00150Fr 2               @rl_word:
00150Fr 2                     ; Allocate string on heap and copy word from token payload
00150Fr 2  A0 03              LDY   #TOK_PAYLOAD
001511r 2  B1 rr              LDA   (ptr_lo),Y           ; length
001513r 2  48                 PHA
001514r 2  1A                 INC                        ; +1 for length byte
001515r 2  A2 05              LDX   #ATYPE_STRING
001517r 2  20 rr rr           JSR   heap_alloc
00151Ar 2  90 04              BCC   :+
00151Cr 2  68                 PLA
00151Dr 2  4C rr rr           JMP   @rl_oom
001520r 2               :     ; Re-read source token (ptr_lo clobbered by heap_alloc)
001520r 2  A5 rr              LDA   eval_cur_lo
001522r 2  85 rr              STA   ptr2_lo
001524r 2  A5 rr              LDA   eval_cur_hi
001526r 2  85 rr              STA   ptr2_hi
001528r 2  68                 PLA
001529r 2  48                 PHA
00152Ar 2  A0 00              LDY   #0
00152Cr 2  91 rr              STA   (ptr_lo),Y           ; store length
00152Er 2  68                 PLA
00152Fr 2  AA                 TAX
001530r 2  F0 1B              BEQ   @rl_word_done
001532r 2  A0 01              LDY   #1
001534r 2  9C rr rr           STZ   num_tmp_lo
001537r 2               @rl_wch:
001537r 2  DA                 PHX
001538r 2  5A                 PHY
001539r 2  AD rr rr           LDA   num_tmp_lo
00153Cr 2  18                 CLC
00153Dr 2  69 04              ADC   #TOK_PAYLOAD+1
00153Fr 2  A8                 TAY
001540r 2  B1 rr              LDA   (ptr2_lo),Y
001542r 2  7A                 PLY
001543r 2  91 rr              STA   (ptr_lo),Y
001545r 2  C8                 INY
001546r 2  EE rr rr           INC   num_tmp_lo
001549r 2  FA                 PLX
00154Ar 2  CA                 DEX
00154Br 2  D0 EA              BNE   @rl_wch
00154Dr 2               @rl_word_done:
00154Dr 2  A5 rr              LDA   ptr_lo
00154Fr 2  85 rr              STA   eval_val_lo
001551r 2  A5 rr              LDA   ptr_hi
001553r 2  85 rr              STA   eval_val_hi
001555r 2  64 rr              STZ   eval_val_frac
001557r 2  A9 01              LDA   #VAL_WORD
001559r 2  85 rr              STA   eval_type
00155Br 2  20 rr rr           JSR   eval_advance
00155Er 2  4C rr rr           JMP   @rl_alloc_cell
001561r 2               
001561r 2               @rl_sublist:
001561r 2                     ; Use eval_list to build the sublist (advances past matching ])
001561r 2  20 rr rr           JSR   eval_advance
001564r 2  A5 rr              LDA   z:list_head_lo
001566r 2  48                 PHA
001567r 2  A5 rr              LDA   z:list_head_hi
001569r 2  48                 PHA
00156Ar 2  A5 rr              LDA   z:list_tail_lo
00156Cr 2  48                 PHA
00156Dr 2  A5 rr              LDA   z:list_tail_hi
00156Fr 2  48                 PHA
001570r 2  20 rr rr           JSR   eval_list
001573r 2  68                 PLA
001574r 2  85 rr              STA   z:list_tail_hi
001576r 2  68                 PLA
001577r 2  85 rr              STA   z:list_tail_lo
001579r 2  68                 PLA
00157Ar 2  85 rr              STA   z:list_head_hi
00157Cr 2  68                 PLA
00157Dr 2  85 rr              STA   z:list_head_lo
00157Fr 2                     ; eval_type = VAL_LIST, eval_val = sublist head
00157Fr 2  4C rr rr           JMP   @rl_alloc_cell
001582r 2               
001582r 2               @rl_alloc_cell:
001582r 2  A9 07              LDA   #CONS_SIZE
001584r 2  A2 02              LDX   #ATYPE_CONS
001586r 2  20 rr rr           JSR   heap_alloc
001589r 2  90 03              BCC   @rl_alloc_ok
00158Br 2  4C rr rr           JMP   @rl_oom
00158Er 2               @rl_alloc_ok:
00158Er 2  A0 00              LDY   #CONS_TAG
001590r 2  A9 10              LDA   #CONS_PAIR
001592r 2  91 rr              STA   (ptr_lo),Y
001594r 2  A0 01              LDY   #CONS_CAR_TYPE
001596r 2  A5 rr              LDA   eval_type
001598r 2  91 rr              STA   (ptr_lo),Y
00159Ar 2  A0 02              LDY   #CONS_CAR_HI
00159Cr 2  A5 rr              LDA   eval_val_hi
00159Er 2  91 rr              STA   (ptr_lo),Y
0015A0r 2  A0 03              LDY   #CONS_CAR_LO
0015A2r 2  A5 rr              LDA   eval_val_lo
0015A4r 2  91 rr              STA   (ptr_lo),Y
0015A6r 2  A0 04              LDY   #CONS_CAR_FRAC
0015A8r 2  A5 rr              LDA   eval_val_frac
0015AAr 2  91 rr              STA   (ptr_lo),Y
0015ACr 2  A0 05              LDY   #CONS_CDR_LO
0015AEr 2  A9 00              LDA   #0
0015B0r 2  91 rr              STA   (ptr_lo),Y
0015B2r 2  A0 06              LDY   #CONS_CDR_HI
0015B4r 2  91 rr              STA   (ptr_lo),Y
0015B6r 2               
0015B6r 2                     ; Link into list
0015B6r 2  A5 rr              LDA   z:list_head_lo
0015B8r 2  05 rr              ORA   z:list_head_hi
0015BAr 2  D0 0F              BNE   @rl_link_tail
0015BCr 2  A5 rr              LDA   ptr_lo
0015BEr 2  85 rr              STA   z:list_head_lo
0015C0r 2  85 rr              STA   z:list_tail_lo
0015C2r 2  A5 rr              LDA   ptr_hi
0015C4r 2  85 rr              STA   z:list_head_hi
0015C6r 2  85 rr              STA   z:list_tail_hi
0015C8r 2  4C rr rr           JMP   @rl_next
0015CBr 2               
0015CBr 2               @rl_link_tail:
0015CBr 2  A5 rr              LDA   z:list_tail_lo
0015CDr 2  85 rr              STA   ptr2_lo
0015CFr 2  A5 rr              LDA   z:list_tail_hi
0015D1r 2  85 rr              STA   ptr2_hi
0015D3r 2  A0 05              LDY   #CONS_CDR_LO
0015D5r 2  A5 rr              LDA   ptr_lo
0015D7r 2  91 rr              STA   (ptr2_lo),Y
0015D9r 2  A0 06              LDY   #CONS_CDR_HI
0015DBr 2  A5 rr              LDA   ptr_hi
0015DDr 2  91 rr              STA   (ptr2_lo),Y
0015DFr 2  A5 rr              LDA   ptr_lo
0015E1r 2  85 rr              STA   z:list_tail_lo
0015E3r 2  A5 rr              LDA   ptr_hi
0015E5r 2  85 rr              STA   z:list_tail_hi
0015E7r 2  4C rr rr           JMP   @rl_next
0015EAr 2               
0015EAr 2               @rl_build_done:
0015EAr 2                     ; Restore tokenizer state
0015EAr 2  68                 PLA
0015EBr 2  85 rr              STA   eval_cur_hi
0015EDr 2  68                 PLA
0015EEr 2  85 rr              STA   eval_cur_lo
0015F0r 2  68                 PLA
0015F1r 2  85 rr              STA   tok_tail_hi
0015F3r 2  68                 PLA
0015F4r 2  85 rr              STA   tok_tail_lo
0015F6r 2  68                 PLA
0015F7r 2  85 rr              STA   tok_head_hi
0015F9r 2  68                 PLA
0015FAr 2  85 rr              STA   tok_head_lo
0015FCr 2               
0015FCr 2                     ; Return the list
0015FCr 2  A9 02              LDA   #VAL_LIST
0015FEr 2  85 rr              STA   eval_type
001600r 2  A5 rr              LDA   z:list_head_lo
001602r 2  85 rr              STA   eval_val_lo
001604r 2  A5 rr              LDA   z:list_head_hi
001606r 2  85 rr              STA   eval_val_hi
001608r 2  64 rr              STZ   eval_val_frac
00160Ar 2  4C rr rr           JMP   eval_continue
00160Dr 2               
00160Dr 2               @rl_oom:
00160Dr 2                     ; Restore tokenizer state before error
00160Dr 2  68                 PLA
00160Er 2  85 rr              STA   eval_cur_hi
001610r 2  68                 PLA
001611r 2  85 rr              STA   eval_cur_lo
001613r 2  68                 PLA
001614r 2  85 rr              STA   tok_tail_hi
001616r 2  68                 PLA
001617r 2  85 rr              STA   tok_tail_lo
001619r 2  68                 PLA
00161Ar 2  85 rr              STA   tok_head_hi
00161Cr 2  68                 PLA
00161Dr 2  85 rr              STA   tok_head_lo
00161Fr 2  A2 rr              LDX   #<str_oom
001621r 2  A0 rr              LDY   #>str_oom
001623r 2  4C rr rr           JMP   list_print_err
001626r 2               
001626r 2               ; ---------------------------------------------------------------------
001626r 2               ; do_char — CHAR n: convert ASCII code to 1-char word
001626r 2               ;   Arity 0: evaluates its own argument
001626r 2               ; ---------------------------------------------------------------------
001626r 2               do_char:
001626r 2  20 rr rr           JSR   eval_expr
001629r 2  B0 09              BCS   @err
00162Br 2                     ; Must be a number
00162Br 2  A5 rr              LDA   eval_type
00162Dr 2  D0 05              BNE   @err
00162Fr 2                     ; Low byte of number is the ASCII code
00162Fr 2  A5 rr              LDA   eval_val_lo
001631r 2  4C rr rr           JMP   alloc_one_char_word
001634r 2               @err:
001634r 2  A2 rr              LDX   #<str_char_name
001636r 2  A0 rr              LDY   #>str_char_name
001638r 2  4C rr rr           JMP   err_nei
00163Br 2               
00163Br 2               ; ---------------------------------------------------------------------
00163Br 2               ; do_ascii — ASCII word: return ASCII code of first character
00163Br 2               ;   Arity 0: evaluates its own argument
00163Br 2               ; ---------------------------------------------------------------------
00163Br 2               do_ascii:
00163Br 2  20 rr rr           JSR   eval_expr
00163Er 2  B0 23              BCS   @err
001640r 2                     ; Must be a word
001640r 2  A5 rr              LDA   eval_type
001642r 2  C9 01              CMP   #VAL_WORD
001644r 2  D0 1D              BNE   @err_type
001646r 2                     ; eval_val_lo/hi points at length-prefixed string
001646r 2  A5 rr              LDA   eval_val_lo
001648r 2  85 rr              STA   ptr_lo
00164Ar 2  A5 rr              LDA   eval_val_hi
00164Cr 2  85 rr              STA   ptr_hi
00164Er 2  A0 00              LDY   #0
001650r 2  B1 rr              LDA   (ptr_lo),Y           ; length
001652r 2  F0 0F              BEQ   @err_empty            ; empty word
001654r 2  A0 01              LDY   #1
001656r 2  B1 rr              LDA   (ptr_lo),Y           ; first character
001658r 2  85 rr              STA   eval_val_lo
00165Ar 2  64 rr              STZ   eval_val_hi
00165Cr 2  64 rr              STZ   eval_val_frac
00165Er 2  64 rr              STZ   eval_type             ; VAL_NUMBER
001660r 2  4C rr rr           JMP   eval_continue
001663r 2               @err_type:
001663r 2               @err_empty:
001663r 2               @err:
001663r 2  A2 rr              LDX   #<str_ascii_name
001665r 2  A0 rr              LDY   #>str_ascii_name
001667r 2  4C rr rr           JMP   err_nei
00166Ar 2               
00166Ar 2               ; =====================================================================
00166Ar 2               ; Math functions and type predicates
00166Ar 2               ; =====================================================================
00166Ar 2               
00166Ar 2               ; ---------------------------------------------------------------------
00166Ar 2               ; return_number — set eval_val from eval_val_lo/hi, clear frac+type
00166Ar 2               ;   Entry: eval_val_lo/hi already set
00166Ar 2               ;   Jumps to eval_continue
00166Ar 2               ; ---------------------------------------------------------------------
00166Ar 2               return_number:
00166Ar 2  64 rr              STZ   eval_val_frac
00166Cr 2  64 rr              STZ   eval_type
00166Er 2  4C rr rr           JMP   eval_continue
001671r 2               
001671r 2               ; ---------------------------------------------------------------------
001671r 2               ; return_signed_byte — sign-extend A into eval_val as 16.8 number
001671r 2               ;   Entry: A = signed byte (-128..+127)
001671r 2               ;   Jumps to eval_continue
001671r 2               ; ---------------------------------------------------------------------
001671r 2               return_signed_byte:
001671r 2  85 rr              STA   eval_val_lo
001673r 2  10 04              BPL   @pos
001675r 2  A9 FF              LDA   #$FF
001677r 2  80 02              BRA   @set
001679r 2  A9 00        @pos: LDA   #$00
00167Br 2  85 rr        @set: STA   eval_val_hi
00167Dr 2  80 EB              BRA   return_number
00167Fr 2               
00167Fr 2               ; ---------------------------------------------------------------------
00167Fr 2               ; predicate_result — set eval_val to 1 (Z set) or 0 (Z clear)
00167Fr 2               ;   Entry: Z flag from CMP
00167Fr 2               ;   Jumps to eval_continue
00167Fr 2               ; ---------------------------------------------------------------------
00167Fr 2               predicate_result:
00167Fr 2  F0 04              BEQ   @true
001681r 2  64 rr              STZ   eval_val_lo
001683r 2  80 04              BRA   @done
001685r 2               @true:
001685r 2  A9 01              LDA   #1
001687r 2  85 rr              STA   eval_val_lo
001689r 2               @done:
001689r 2  64 rr              STZ   eval_val_hi
00168Br 2  80 DD              BRA   return_number
00168Dr 2               
00168Dr 2               ; ---------------------------------------------------------------------
00168Dr 2               ; degrees_to_u8 — convert eval_val (degrees 0-360) to u8 angle (0-255)
00168Dr 2               ;   Uses MUL16 coprocessor: angle = degrees * 91 / 128
00168Dr 2               ;   Actually: write degrees to MUL16 A, 91 to B, read RES1 (high byte)
00168Dr 2               ;   Then shift right once (divide by 2) since 91/256=0.355, we want 91/128
00168Dr 2               ;   Wait, let me recalculate: degrees * 91 >> 7
00168Dr 2               ;   MUL16 gives degrees*91 in RES1:RES0. We want bits [14:7] of that.
00168Dr 2               ;   RES1 is bits [15:8]. But we want >>7 which is RES1<<1 | RES0>>7.
00168Dr 2               ;   Simpler: degrees * 182 / 256 = RES1 of (degrees * 182). Let's use 182.
00168Dr 2               ;   Output: A = u8 angle
00168Dr 2               ;   Clobbers: uses math coprocessor regs
00168Dr 2               ; ---------------------------------------------------------------------
00168Dr 2               degrees_to_u8:
00168Dr 2  A5 rr              LDA   eval_val_lo
00168Fr 2  8D 20 BB           STA   MATH_MUL16_A_LO
001692r 2  A5 rr              LDA   eval_val_hi
001694r 2  8D 21 BB           STA   MATH_MUL16_A_HI
001697r 2  A9 B6              LDA   #182
001699r 2  8D 22 BB           STA   MATH_MUL16_B_LO
00169Cr 2  9C 23 BB           STZ   MATH_MUL16_B_HI       ; trigger multiply
00169Fr 2  AD 39 BB           LDA   MATH_RES1              ; high byte = degrees * 182 / 256
0016A2r 2  60                 RTS
0016A3r 2               
0016A3r 2               ; ---------------------------------------------------------------------
0016A3r 2               ; do_sin — SIN degrees: return sin as signed byte (-128..+127)
0016A3r 2               ; ---------------------------------------------------------------------
0016A3r 2               do_sin:
0016A3r 2  20 rr rr           JSR   eval_expr
0016A6r 2  B0 0C              BCS   @err
0016A8r 2  20 rr rr           JSR   degrees_to_u8
0016ABr 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
0016AEr 2  AD 38 BB           LDA   MATH_RES0              ; sin result (signed 1.7)
0016B1r 2  4C rr rr           JMP   return_signed_byte
0016B4r 2               @err:
0016B4r 2  38                 SEC
0016B5r 2  60                 RTS
0016B6r 2               
0016B6r 2               ; ---------------------------------------------------------------------
0016B6r 2               ; do_cos — COS degrees: return cos as signed byte (-128..+127)
0016B6r 2               ; ---------------------------------------------------------------------
0016B6r 2               do_cos:
0016B6r 2  20 rr rr           JSR   eval_expr
0016B9r 2  B0 0C              BCS   @err
0016BBr 2  20 rr rr           JSR   degrees_to_u8
0016BEr 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
0016C1r 2  AD 39 BB           LDA   MATH_RES1              ; cos result (signed 1.7)
0016C4r 2  4C rr rr           JMP   return_signed_byte
0016C7r 2               @err:
0016C7r 2  38                 SEC
0016C8r 2  60                 RTS
0016C9r 2               
0016C9r 2               ; ---------------------------------------------------------------------
0016C9r 2               ; do_abs — ABS n: return absolute value
0016C9r 2               ; ---------------------------------------------------------------------
0016C9r 2               do_abs:
0016C9r 2  20 rr rr           JSR   eval_expr
0016CCr 2  B0 22              BCS   @err
0016CEr 2  A5 rr              LDA   eval_val_hi
0016D0r 2  10 19              BPL   @done                  ; already positive
0016D2r 2                     ; Negate 24-bit value
0016D2r 2  A5 rr              LDA   eval_val_frac
0016D4r 2  49 FF              EOR   #$FF
0016D6r 2  18                 CLC
0016D7r 2  69 01              ADC   #1
0016D9r 2  85 rr              STA   eval_val_frac
0016DBr 2  A5 rr              LDA   eval_val_lo
0016DDr 2  49 FF              EOR   #$FF
0016DFr 2  69 00              ADC   #0
0016E1r 2  85 rr              STA   eval_val_lo
0016E3r 2  A5 rr              LDA   eval_val_hi
0016E5r 2  49 FF              EOR   #$FF
0016E7r 2  69 00              ADC   #0
0016E9r 2  85 rr              STA   eval_val_hi
0016EBr 2               @done:
0016EBr 2  64 rr              STZ   eval_type
0016EDr 2  4C rr rr           JMP   eval_continue
0016F0r 2               @err:
0016F0r 2  38                 SEC
0016F1r 2  60                 RTS
0016F2r 2               
0016F2r 2               ; ---------------------------------------------------------------------
0016F2r 2               ; do_int — INT n: truncate fractional part
0016F2r 2               ; ---------------------------------------------------------------------
0016F2r 2               do_int:
0016F2r 2  20 rr rr           JSR   eval_expr
0016F5r 2  B0 07              BCS   @err
0016F7r 2  64 rr              STZ   eval_val_frac
0016F9r 2  64 rr              STZ   eval_type
0016FBr 2  4C rr rr           JMP   eval_continue
0016FEr 2               @err:
0016FEr 2  38                 SEC
0016FFr 2  60                 RTS
001700r 2               
001700r 2               ; ---------------------------------------------------------------------
001700r 2               ; do_round — ROUND n: round to nearest integer
001700r 2               ; ---------------------------------------------------------------------
001700r 2               do_round:
001700r 2  20 rr rr           JSR   eval_expr
001703r 2  B0 19              BCS   @err
001705r 2  A5 rr              LDA   eval_val_frac
001707r 2  C9 80              CMP   #128
001709r 2  90 0C              BCC   @trunc
00170Br 2                     ; Round up: increment integer part
00170Br 2  A5 rr              LDA   eval_val_hi
00170Dr 2  10 02              BPL   @pos_round
00170Fr 2                     ; Negative: actually round toward zero = truncate
00170Fr 2  80 06              BRA   @trunc
001711r 2               @pos_round:
001711r 2  E6 rr              INC   eval_val_lo
001713r 2  D0 02              BNE   @trunc
001715r 2  E6 rr              INC   eval_val_hi
001717r 2               @trunc:
001717r 2  64 rr              STZ   eval_val_frac
001719r 2  64 rr              STZ   eval_type
00171Br 2  4C rr rr           JMP   eval_continue
00171Er 2               @err:
00171Er 2  38                 SEC
00171Fr 2  60                 RTS
001720r 2               
001720r 2               ; ---------------------------------------------------------------------
001720r 2               ; do_random — RANDOM n: return random number 0..n-1
001720r 2               ;   Uses math coprocessor RNG + MUL16 to scale
001720r 2               ; ---------------------------------------------------------------------
001720r 2               do_random:
001720r 2  20 rr rr           JSR   eval_expr
001723r 2  B0 1D              BCS   @err
001725r 2                     ; RNG byte * n / 256 gives 0..n-1
001725r 2  AD 37 BB           LDA   MATH_RNG
001728r 2  8D 20 BB           STA   MATH_MUL16_A_LO
00172Br 2  9C 21 BB           STZ   MATH_MUL16_A_HI
00172Er 2  A5 rr              LDA   eval_val_lo
001730r 2  8D 22 BB           STA   MATH_MUL16_B_LO
001733r 2  A5 rr              LDA   eval_val_hi
001735r 2  8D 23 BB           STA   MATH_MUL16_B_HI       ; trigger
001738r 2  AD 39 BB           LDA   MATH_RES1              ; high byte of (rng * n) = rng*n/256
00173Br 2  85 rr              STA   eval_val_lo
00173Dr 2  64 rr              STZ   eval_val_hi
00173Fr 2  4C rr rr           JMP   return_number
001742r 2               @err:
001742r 2  38                 SEC
001743r 2  60                 RTS
001744r 2               
001744r 2               ; ---------------------------------------------------------------------
001744r 2               ; do_sqrt — SQRT n: approximate sqrt via DIST_APPROX(n, 0)
001744r 2               ; ---------------------------------------------------------------------
001744r 2               do_sqrt:
001744r 2  20 rr rr           JSR   eval_expr
001747r 2  B0 1D              BCS   @err
001749r 2  A5 rr              LDA   eval_val_lo
00174Br 2  8D 33 BB           STA   MATH_DIST_DX_LO
00174Er 2  A5 rr              LDA   eval_val_hi
001750r 2  8D 34 BB           STA   MATH_DIST_DX_HI
001753r 2  9C 35 BB           STZ   MATH_DIST_DY_LO
001756r 2  9C 36 BB           STZ   MATH_DIST_DY_HI       ; trigger (write to DY_HI triggers)
001759r 2  AD 38 BB           LDA   MATH_RES0
00175Cr 2  85 rr              STA   eval_val_lo
00175Er 2  AD 39 BB           LDA   MATH_RES1
001761r 2  85 rr              STA   eval_val_hi
001763r 2  4C rr rr           JMP   return_number
001766r 2               @err:
001766r 2  38                 SEC
001767r 2  60                 RTS
001768r 2               
001768r 2               ; ---------------------------------------------------------------------
001768r 2               ; do_remainder — REMAINDER a b: return a mod b via DIV coprocessor
001768r 2               ; ---------------------------------------------------------------------
001768r 2               do_remainder:
001768r 2  20 rr rr           JSR   eval_expr              ; first arg (a)
00176Br 2  B0 49              BCS   @err
00176Dr 2  A5 rr              LDA   eval_val_lo
00176Fr 2  48                 PHA
001770r 2  A5 rr              LDA   eval_val_hi
001772r 2  48                 PHA
001773r 2  20 rr rr           JSR   eval_expr              ; second arg (b)
001776r 2  B0 3C              BCS   @err_pop
001778r 2                     ; b in eval_val, a on stack
001778r 2                     ; Check divide by zero
001778r 2  A5 rr              LDA   eval_val_lo
00177Ar 2  05 rr              ORA   eval_val_hi
00177Cr 2  F0 2D              BEQ   @zero_pop
00177Er 2                     ; Set up 32÷16 division: dividend=a, divisor=b
00177Er 2  68                 PLA
00177Fr 2  8D 29 BB           STA   MATH_DIV_N_1           ; a_hi
001782r 2  AA                 TAX                          ; save for sign-extend
001783r 2  68                 PLA
001784r 2  8D 28 BB           STA   MATH_DIV_N_LO          ; a_lo
001787r 2                     ; Sign-extend a
001787r 2  8A                 TXA
001788r 2  09 7F              ORA   #$7F
00178Ar 2  30 02              BMI   @neg_a
00178Cr 2  A9 00              LDA   #$00
00178Er 2               @neg_a:                            ; A=$FF if negative
00178Er 2  8D 2A BB           STA   MATH_DIV_N_2
001791r 2  8D 2B BB           STA   MATH_DIV_N_HI
001794r 2  A5 rr              LDA   eval_val_lo
001796r 2  8D 2C BB           STA   MATH_DIV_D_LO
001799r 2  A5 rr              LDA   eval_val_hi
00179Br 2  8D 2D BB           STA   MATH_DIV_D_HI          ; trigger
00179Er 2                     ; Remainder is in RES2:RES3 (actually check what the copro returns)
00179Er 2                     ; The math copro returns quotient in RES0:RES1, remainder in RES2:RES3
00179Er 2  AD 3A BB           LDA   MATH_RES2
0017A1r 2  85 rr              STA   eval_val_lo
0017A3r 2  AD 3B BB           LDA   MATH_RES3
0017A6r 2  85 rr              STA   eval_val_hi
0017A8r 2  4C rr rr           JMP   return_number
0017ABr 2               @zero_pop:
0017ABr 2  68                 PLA
0017ACr 2  68                 PLA
0017ADr 2  64 rr              STZ   eval_val_lo
0017AFr 2  64 rr              STZ   eval_val_hi
0017B1r 2  4C rr rr           JMP   return_number
0017B4r 2               @err_pop:
0017B4r 2  68                 PLA
0017B5r 2  68                 PLA
0017B6r 2               @err:
0017B6r 2  38                 SEC
0017B7r 2  60                 RTS
0017B8r 2               
0017B8r 2               ; ---------------------------------------------------------------------
0017B8r 2               ; do_not — NOT expr: return 1 if expr is 0, else 0
0017B8r 2               ; ---------------------------------------------------------------------
0017B8r 2               do_not:
0017B8r 2  20 rr rr           JSR   eval_expr
0017BBr 2  B0 13              BCS   @err
0017BDr 2  A5 rr              LDA   eval_val_lo
0017BFr 2  05 rr              ORA   eval_val_hi
0017C1r 2                     ; If zero, set result to 1. If nonzero, set to 0.
0017C1r 2  D0 06              BNE   @false
0017C3r 2  A9 01              LDA   #1
0017C5r 2  85 rr              STA   eval_val_lo
0017C7r 2  80 02              BRA   @done
0017C9r 2               @false:
0017C9r 2  64 rr              STZ   eval_val_lo
0017CBr 2               @done:
0017CBr 2  64 rr              STZ   eval_val_hi
0017CDr 2  4C rr rr           JMP   return_number
0017D0r 2               @err:
0017D0r 2  38                 SEC
0017D1r 2  60                 RTS
0017D2r 2               
0017D2r 2               ; ---------------------------------------------------------------------
0017D2r 2               ; do_and — AND a b: return 1 if both nonzero, else 0
0017D2r 2               ; ---------------------------------------------------------------------
0017D2r 2               do_and:
0017D2r 2  20 rr rr           JSR   eval_expr
0017D5r 2  B0 1E              BCS   @err
0017D7r 2  A5 rr              LDA   eval_val_lo
0017D9r 2  05 rr              ORA   eval_val_hi
0017DBr 2  F0 11              BEQ   @false                 ; first arg is 0 → short-circuit
0017DDr 2  20 rr rr           JSR   eval_expr
0017E0r 2  B0 13              BCS   @err
0017E2r 2  A5 rr              LDA   eval_val_lo
0017E4r 2  05 rr              ORA   eval_val_hi
0017E6r 2  F0 06              BEQ   @false
0017E8r 2  A9 01              LDA   #1
0017EAr 2  85 rr              STA   eval_val_lo
0017ECr 2  80 02              BRA   @done
0017EEr 2               @false:
0017EEr 2  64 rr              STZ   eval_val_lo
0017F0r 2               @done:
0017F0r 2  64 rr              STZ   eval_val_hi
0017F2r 2  4C rr rr           JMP   return_number
0017F5r 2               @err:
0017F5r 2  38                 SEC
0017F6r 2  60                 RTS
0017F7r 2               
0017F7r 2               ; ---------------------------------------------------------------------
0017F7r 2               ; do_or — OR a b: return 1 if either nonzero, else 0
0017F7r 2               ; ---------------------------------------------------------------------
0017F7r 2               do_or:
0017F7r 2  20 rr rr           JSR   eval_expr
0017FAr 2  B0 1E              BCS   @err
0017FCr 2  A5 rr              LDA   eval_val_lo
0017FEr 2  05 rr              ORA   eval_val_hi
001800r 2  D0 0F              BNE   @true                  ; first arg nonzero → short-circuit
001802r 2  20 rr rr           JSR   eval_expr
001805r 2  B0 13              BCS   @err
001807r 2  A5 rr              LDA   eval_val_lo
001809r 2  05 rr              ORA   eval_val_hi
00180Br 2  D0 04              BNE   @true
00180Dr 2  64 rr              STZ   eval_val_lo
00180Fr 2  80 04              BRA   @done
001811r 2               @true:
001811r 2  A9 01              LDA   #1
001813r 2  85 rr              STA   eval_val_lo
001815r 2               @done:
001815r 2  64 rr              STZ   eval_val_hi
001817r 2  4C rr rr           JMP   return_number
00181Ar 2               @err:
00181Ar 2  38                 SEC
00181Br 2  60                 RTS
00181Cr 2               
00181Cr 2               ; ---------------------------------------------------------------------
00181Cr 2               ; Type predicates — NUMBER?, WORD?, LIST?
00181Cr 2               ; ---------------------------------------------------------------------
00181Cr 2               do_numberp:
