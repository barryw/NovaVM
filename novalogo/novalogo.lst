002465r 2               ; ---------------------------------------------------------------------
002465r 2               ; render_number_to_buf — render eval_val as decimal into input_buf
002465r 2               ;   Entry: eval_val_hi/lo/frac = number value
002465r 2               ;          buf_idx = current write position
002465r 2               ;   Exit:  buf_idx updated
002465r 2               ;   Clobbers: A, X, Y, num_val, num_tmp, pn_buf
002465r 2               ; ---------------------------------------------------------------------
002465r 2               render_number_to_buf:
002465r 2                     ; Handle sign
002465r 2  A5 rr              LDA   eval_val_hi
002467r 2  10 22              BPL   @rn_positive
002469r 2                     ; Write '-'
002469r 2  A4 rr              LDY   z:buf_idx
00246Br 2  A9 2D              LDA   #'-'
00246Dr 2  99 rr rr           STA   input_buf,Y
002470r 2  E6 rr              INC   z:buf_idx
002472r 2                     ; Negate
002472r 2  A5 rr              LDA   eval_val_frac
002474r 2  49 FF              EOR   #$FF
002476r 2  18                 CLC
002477r 2  69 01              ADC   #1
002479r 2  85 rr              STA   eval_val_frac
00247Br 2  A5 rr              LDA   eval_val_lo
00247Dr 2  49 FF              EOR   #$FF
00247Fr 2  69 00              ADC   #0
002481r 2  85 rr              STA   eval_val_lo
002483r 2  A5 rr              LDA   eval_val_hi
002485r 2  49 FF              EOR   #$FF
002487r 2  69 00              ADC   #0
002489r 2  85 rr              STA   eval_val_hi
00248Br 2               
00248Br 2               @rn_positive:
00248Br 2                     ; Render integer part using power-of-10 subtraction
00248Br 2  A5 rr              LDA   eval_val_lo
00248Dr 2  8D rr rr           STA   num_val_lo
002490r 2  A5 rr              LDA   eval_val_hi
002492r 2  8D rr rr           STA   num_val_hi
002495r 2               
002495r 2  A2 00              LDX   #0                     ; digit buffer index
002497r 2  A0 00              LDY   #0                     ; power-of-10 index
002499r 2               @rn_div:
002499r 2  9C rr rr           STZ   num_tmp_lo
00249Cr 2               @rn_sub:
00249Cr 2  38                 SEC
00249Dr 2  AD rr rr           LDA   num_val_lo
0024A0r 2  F9 rr rr           SBC   pow10_lo,Y
0024A3r 2  48                 PHA
0024A4r 2  AD rr rr           LDA   num_val_hi
0024A7r 2  F9 rr rr           SBC   pow10_hi,Y
0024AAr 2  90 0C              BCC   @rn_sub_done
0024ACr 2  8D rr rr           STA   num_val_hi
0024AFr 2  68                 PLA
0024B0r 2  8D rr rr           STA   num_val_lo
0024B3r 2  EE rr rr           INC   num_tmp_lo
0024B6r 2  80 E4              BRA   @rn_sub
0024B8r 2               @rn_sub_done:
0024B8r 2  68                 PLA
0024B9r 2  AD rr rr           LDA   num_tmp_lo
