000FDEr 2                     ; Restore body start
000FDEr 2  68                 PLA
000FDFr 2  85 rr              STA   eval_cur_hi
000FE1r 2  68                 PLA
000FE2r 2  85 rr              STA   eval_cur_lo
000FE4r 2               
000FE4r 2                     ; Execute the body
000FE4r 2  20 rr rr           JSR   exec_body_block
000FE7r 2               
000FE7r 2                     ; Body completed normally — restore previous catch frame
000FE7r 2                     ; (Stack still has: prev_frame(6), tag_hi, tag_lo at the bottom)
000FE7r 2  68                 PLA
000FE8r 2  85 rr              STA   catch_resume_hi
000FEAr 2  68                 PLA
