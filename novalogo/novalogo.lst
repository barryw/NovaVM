0013FCr 2                     ; Check for CR
0013FCr 2  C9 0D              CMP   #$0D
0013FEr 2  F0 2E              BEQ   @rw_done
001400r 2                     ; Check for space
001400r 2  C9 20              CMP   #' '
001402r 2  F0 2A              BEQ   @rw_done
001404r 2                     ; Check for backspace
001404r 2  C9 08              CMP   #$08
001406r 2  F0 18              BEQ   @rw_bs
001408r 2  C9 14              CMP   #$14
00140Ar 2  F0 14              BEQ   @rw_bs
00140Cr 2  C9 7F              CMP   #$7F
00140Er 2  F0 10              BEQ   @rw_bs
