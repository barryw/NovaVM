000F84r 2               ; ---------------------------------------------------------------------
000F84r 2               ; do_stop — STOP: exit current procedure immediately (no return value)
000F84r 2               ;   Arity 0, no arguments
000F84r 2               ; ---------------------------------------------------------------------
000F84r 2               do_stop:
000F84r 2  A9 01              LDA   #$01
000F86r 2  85 rr              STA   proc_stopped
000F88r 2  4C rr rr           JMP   eval_continue
000F8Br 2               
000F8Br 2               ; ---------------------------------------------------------------------
000F8Br 2               ; do_output — OUTPUT expr: exit procedure with a return value
000F8Br 2               ;   Arity 0 — handles its own argument evaluation
000F8Br 2               ; ---------------------------------------------------------------------
000F8Br 2               do_output:
000F8Br 2  20 rr rr           JSR   eval_expr           ; evaluate the expression
000F8Er 2  A9 02              LDA   #$02
000F90r 2  85 rr              STA   proc_stopped        ; signal OUTPUT
000F92r 2                     ; eval_type/eval_val holds the return value
000F92r 2  4C rr rr           JMP   eval_continue
000F95r 2               
000F95r 2               ; ---------------------------------------------------------------------
000F95r 2               ; do_catch — CATCH "tag [body]: execute body, catching errors/throws
000F95r 2               ;   Arity 0 — handles its own argument parsing
000F95r 2               ;   1. Evaluate tag argument (quoted word)
000F95r 2               ;   2. Save current catch frame (for nesting) on the 6502 stack
000F95r 2               ;   3. Set up new catch frame with tag and stack pointer
000F95r 2               ;   4. Execute the body
000F95r 2               ;   5. On normal completion: restore previous catch frame, continue
000F95r 2               ;   On THROW match: try_throw_error or do_throw restores SP from
000F95r 2               ;   catch frame, which unwinds back to step 5's stack context.
000F95r 2               ; ---------------------------------------------------------------------
000F95r 2               do_catch:
000F95r 2                     ; Evaluate tag argument (e.g., "ERROR)
000F95r 2  20 rr rr           JSR   eval_expr
000F98r 2  90 03              BCC   @tag_ok
000F9Ar 2  4C rr rr           JMP   @err_tag
000F9Dr 2               @tag_ok:
000F9Dr 2               
000F9Dr 2                     ; Must be a word
000F9Dr 2  A5 rr              LDA   eval_type
000F9Fr 2  C9 01              CMP   #VAL_WORD
000FA1r 2  F0 03              BEQ   @type_ok
000FA3r 2  4C rr rr           JMP   @err_tag
000FA6r 2               @type_ok:
000FA6r 2               
000FA6r 2                     ; Save tag pointer and eval_in_body temporarily (3 bytes)
000FA6r 2  A5 rr              LDA   eval_val_lo
000FA8r 2  48                 PHA
000FA9r 2  A5 rr              LDA   eval_val_hi
000FABr 2  48                 PHA
000FACr 2  A5 rr              LDA   eval_in_body
000FAEr 2  48                 PHA
000FAFr 2               
000FAFr 2                     ; Push previous catch frame onto the 6502 stack (6 bytes)
000FAFr 2  A5 rr              LDA   catch_active
000FB1r 2  48                 PHA
000FB2r 2  A5 rr              LDA   catch_tag_lo
000FB4r 2  48                 PHA
000FB5r 2  A5 rr              LDA   catch_tag_hi
000FB7r 2  48                 PHA
000FB8r 2  A5 rr              LDA   catch_sp
000FBAr 2  48                 PHA
000FBBr 2  A5 rr              LDA   catch_resume_lo
000FBDr 2  48                 PHA
000FBEr 2  A5 rr              LDA   catch_resume_hi
000FC0r 2  48                 PHA
000FC1r 2               
000FC1r 2                     ; Set up the tag pointer from saved values
000FC1r 2                     ; Stack (top to bottom): prev_frame(6), eval_in_body, eval_val_hi, eval_val_lo
000FC1r 2                     ; $0101+X = SP+1 = top. eval_in_body at SP+7, eval_val_hi at SP+8, eval_val_lo at SP+9
000FC1r 2  BA                 TSX
000FC2r 2  BD 08 01           LDA   $0108,X               ; eval_val_hi = tag ptr high
000FC5r 2  85 rr              STA   catch_tag_hi
000FC7r 2  BD 09 01           LDA   $0109,X               ; eval_val_lo = tag ptr low
000FCAr 2  85 rr              STA   catch_tag_lo
000FCCr 2               
000FCCr 2                     ; Save stack pointer NOW — this is the unwind target.
000FCCr 2                     ; When a THROW matches, TXS restores to this SP, and the
000FCCr 2                     ; 6 PLA instructions below will pop the previous frame.
000FCCr 2  BA                 TSX
000FCDr 2  86 rr              STX   catch_sp
000FCFr 2               
000FCFr 2                     ; Activate the catch
000FCFr 2  A9 01              LDA   #$01
000FD1r 2  85 rr              STA   catch_active
000FD3r 2               
000FD3r 2                     ; We need to find the resume point PAST the body's ].
000FD3r 2                     ; Scan ahead to find it, then come back and execute the body.
000FD3r 2                     ; Save body start location first.
000FD3r 2  A5 rr              LDA   eval_cur_lo
000FD5r 2  48                 PHA                         ; save body-start lo
000FD6r 2  A5 rr              LDA   eval_cur_hi
000FD8r 2  48                 PHA                         ; save body-start hi
000FD9r 2               
000FD9r 2                     ; Scan past the body [...] to find resume point
000FD9r 2  20 rr rr           JSR   skip_list_body
000FDCr 2  B0 31              BCS   @err_bracket_pop
000FDEr 2               
000FDEr 2                     ; eval_cur is now past the ]. Save as resume point.
000FDEr 2  A5 rr              LDA   eval_cur_lo
000FE0r 2  85 rr              STA   catch_resume_lo
000FE2r 2  A5 rr              LDA   eval_cur_hi
000FE4r 2  85 rr              STA   catch_resume_hi
000FE6r 2               
000FE6r 2                     ; Restore body start
000FE6r 2  68                 PLA
000FE7r 2  85 rr              STA   eval_cur_hi
000FE9r 2  68                 PLA
000FEAr 2  85 rr              STA   eval_cur_lo
000FECr 2               
000FECr 2                     ; Execute the body
000FECr 2  20 rr rr           JSR   exec_body_block
000FEFr 2               
000FEFr 2                     ; Body completed normally — restore previous catch frame
000FEFr 2                     ; (Stack still has: prev_frame(6), tag_hi, tag_lo at the bottom)
000FEFr 2  68                 PLA
000FF0r 2  85 rr              STA   catch_resume_hi
000FF2r 2  68                 PLA
000FF3r 2  85 rr              STA   catch_resume_lo
000FF5r 2  68                 PLA
000FF6r 2  85 rr              STA   catch_sp
000FF8r 2  68                 PLA
000FF9r 2  85 rr              STA   catch_tag_hi
000FFBr 2  68                 PLA
000FFCr 2  85 rr              STA   catch_tag_lo
000FFEr 2  68                 PLA
000FFFr 2  85 rr              STA   catch_active
001001r 2               
001001r 2                     ; Discard saved eval_in_body + tag ptr (3 bytes)
001001r 2  68                 PLA                         ; eval_in_body
001002r 2  68                 PLA                         ; tag_hi
001003r 2  68                 PLA                         ; tag_lo
001004r 2               
001004r 2                     ; Set eval_cur past the body
001004r 2  A5 rr              LDA   catch_resume_lo
001006r 2  85 rr              STA   eval_cur_lo
001008r 2  A5 rr              LDA   catch_resume_hi
00100Ar 2  85 rr              STA   eval_cur_hi
00100Cr 2  4C rr rr           JMP   eval_continue
00100Fr 2               
00100Fr 2               @err_bracket_pop:
00100Fr 2                     ; Clean up: body-start was partially popped by skip_list_body error
00100Fr 2  68                 PLA                         ; body_start_hi
001010r 2  68                 PLA                         ; body_start_lo
001011r 2                     ; Restore previous catch frame
001011r 2  68                 PLA
001012r 2  85 rr              STA   catch_resume_hi
001014r 2  68                 PLA
001015r 2  85 rr              STA   catch_resume_lo
001017r 2  68                 PLA
001018r 2  85 rr              STA   catch_sp
00101Ar 2  68                 PLA
00101Br 2  85 rr              STA   catch_tag_hi
00101Dr 2  68                 PLA
00101Er 2  85 rr              STA   catch_tag_lo
001020r 2  68                 PLA
001021r 2  85 rr              STA   catch_active
001023r 2                     ; Discard saved eval_in_body + tag ptr (3 bytes)
001023r 2  68                 PLA
001024r 2  68                 PLA
001025r 2  68                 PLA
001026r 2                     ; Print bracket error
001026r 2  A2 rr              LDX   #<str_catch_bracket
001028r 2  A0 rr              LDY   #>str_catch_bracket
00102Ar 2  80 04              BRA   catch_print_err
00102Cr 2               
00102Cr 2               @err_tag:
00102Cr 2  A2 rr              LDX   #<str_catch_err
00102Er 2  A0 rr              LDY   #>str_catch_err
001030r 2                     ; fall through
001030r 2               
001030r 2               catch_print_err:
001030r 2  86 rr              STX   ptr_lo
001032r 2  84 rr              STY   ptr_hi
001034r 2  A0 00              LDY   #0
001036r 2               @lp:
001036r 2  B1 rr              LDA   (ptr_lo),Y
001038r 2  F0 06              BEQ   @done
00103Ar 2  8D 0E A0           STA   VGC_CHAROUT
00103Dr 2  C8                 INY
00103Er 2  D0 F6              BNE   @lp
