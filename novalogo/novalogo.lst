001322r 2               
001322r 2                     ; We need to evaluate an expression from the condition body.
001322r 2                     ; The condition block contains an expression, so use eval_expr.
001322r 2  20 rr rr           JSR   eval_expr
001325r 2  B0 27              BCS   @wu_done                ; eval error = stop
001327r 2               
001327r 2                     ; Check result: nonzero integer = true
001327r 2  A5 rr              LDA   eval_val_lo
001329r 2  05 rr              ORA   eval_val_hi
00132Br 2                     ; Result in A: nonzero = true condition
00132Br 2               
00132Br 2                     ; Read mode from stack to decide behavior
00132Br 2                     ; Mode is at the bottom of our saved state block.
00132Br 2                     ; Stack layout (top-down): eval_in_body, cond_start_hi/lo,
00132Br 2                     ;   body_resume_hi/lo, body_start_hi/lo, mode
00132Br 2                     ; That's 8 bytes deep from current SP.
