0013AEr 2               ; ---------------------------------------------------------------------
0013AEr 2               ; do_readchar — READCHAR: wait for keypress, return as 1-char word
0013AEr 2               ;   Arity 0, no arguments. Reporter.
0013AEr 2               ; ---------------------------------------------------------------------
0013AEr 2               do_readchar:
0013AEr 2                     ; Poll until a key is pressed
0013AEr 2               @wait:
0013AEr 2  AD 0F A0           LDA   VGC_CHARIN
0013B1r 2  F0 FB              BEQ   @wait
0013B3r 2                     ; A = character — fall through to alloc_one_char_word
0013B3r 2               
0013B3r 2               ; ---------------------------------------------------------------------
0013B3r 2               ; alloc_one_char_word — allocate a 1-char word on heap from A
0013B3r 2               ;   Input: A = character byte
0013B3r 2               ;   Output: eval_type=VAL_WORD, eval_val=pointer to len+char
0013B3r 2               ;   Jumps to eval_continue
0013B3r 2               ; ---------------------------------------------------------------------
0013B3r 2               alloc_one_char_word:
0013B3r 2  48                 PHA                       ; save character
0013B4r 2  A9 02              LDA   #2                  ; 1 byte length + 1 byte char
0013B6r 2  A2 05              LDX   #ATYPE_STRING
0013B8r 2  20 rr rr           JSR   heap_alloc
0013BBr 2  68                 PLA
0013BCr 2  B0 1B              BCS   @oom
0013BEr 2  A0 01              LDY   #1
0013C0r 2  91 rr              STA   (ptr_lo),Y          ; store char
0013C2r 2  A9 01              LDA   #1
0013C4r 2  A0 00              LDY   #0
0013C6r 2  91 rr              STA   (ptr_lo),Y          ; store length = 1
0013C8r 2  A5 rr              LDA   ptr_lo
0013CAr 2  85 rr              STA   eval_val_lo
0013CCr 2  A5 rr              LDA   ptr_hi
0013CEr 2  85 rr              STA   eval_val_hi
0013D0r 2  A9 01              LDA   #VAL_WORD
0013D2r 2  85 rr              STA   eval_type
0013D4r 2  64 rr              STZ   eval_val_frac
0013D6r 2  4C rr rr           JMP   eval_continue
0013D9r 2               @oom:
0013D9r 2  A2 rr              LDX   #<str_oom
0013DBr 2  A0 rr              LDY   #>str_oom
0013DDr 2  4C rr rr           JMP   list_print_err
0013E0r 2               
0013E0r 2               ; ---------------------------------------------------------------------
0013E0r 2               ; do_readword — READWORD: read chars until space/CR, return as word
0013E0r 2               ;   Arity 0, no arguments. Reporter.
0013E0r 2               ;   Uses input_buf as scratch (safe — main input already consumed).
0013E0r 2               ; ---------------------------------------------------------------------
0013E0r 2               do_readword:
0013E0r 2  64 rr              STZ   z:buf_idx
0013E2r 2               @rw_poll:
0013E2r 2  AD 0F A0           LDA   VGC_CHARIN
0013E5r 2  F0 FB              BEQ   @rw_poll
0013E7r 2                     ; Check for CR
0013E7r 2  C9 0D              CMP   #$0D
0013E9r 2  F0 2E              BEQ   @rw_done
0013EBr 2                     ; Check for space
0013EBr 2  C9 20              CMP   #' '
0013EDr 2  F0 2A              BEQ   @rw_done
0013EFr 2                     ; Check for backspace
0013EFr 2  C9 08              CMP   #$08
0013F1r 2  F0 18              BEQ   @rw_bs
0013F3r 2  C9 14              CMP   #$14
0013F5r 2  F0 14              BEQ   @rw_bs
0013F7r 2  C9 7F              CMP   #$7F
0013F9r 2  F0 10              BEQ   @rw_bs
0013FBr 2                     ; Store and echo
0013FBr 2  A6 rr              LDX   z:buf_idx
0013FDr 2  E0 7E              CPX   #126
0013FFr 2  B0 E1              BCS   @rw_poll             ; buffer full
001401r 2  9D rr rr           STA   input_buf,X
001404r 2  8D 0E A0           STA   VGC_CHAROUT
001407r 2  E6 rr              INC   z:buf_idx
001409r 2  80 D7              BRA   @rw_poll
00140Br 2               
00140Br 2               @rw_bs:
00140Br 2  A6 rr              LDX   z:buf_idx
00140Dr 2  F0 D3              BEQ   @rw_poll
00140Fr 2  CA                 DEX
001410r 2  86 rr              STX   z:buf_idx
001412r 2  A9 08              LDA   #$08
001414r 2  8D 0E A0           STA   VGC_CHAROUT
001417r 2  80 C9              BRA   @rw_poll
001419r 2               
001419r 2               @rw_done:
001419r 2                     ; Echo CR/LF
001419r 2  48                 PHA
00141Ar 2  A9 0D              LDA   #$0D
00141Cr 2  8D 0E A0           STA   VGC_CHAROUT
00141Fr 2  A9 0A              LDA   #$0A
001421r 2  8D 0E A0           STA   VGC_CHAROUT
001424r 2  68                 PLA
001425r 2                     ; Allocate word: 1 (len) + buf_idx (chars)
001425r 2  A5 rr              LDA   z:buf_idx
001427r 2  1A                 INC                        ; +1 for length byte
001428r 2  A2 05              LDX   #ATYPE_STRING
00142Ar 2  20 rr rr           JSR   heap_alloc
00142Dr 2  B0 30              BCS   @rw_oom
00142Fr 2                     ; Write length
00142Fr 2  A5 rr              LDA   z:buf_idx
001431r 2  A0 00              LDY   #0
001433r 2  91 rr              STA   (ptr_lo),Y
001435r 2                     ; Copy chars
001435r 2  AA                 TAX
001436r 2  F0 16              BEQ   @rw_set
001438r 2  A0 01              LDY   #1
00143Ar 2  9C rr rr           STZ   num_tmp_lo
00143Dr 2               @rw_copy:
00143Dr 2  5A                 PHY
00143Er 2  AC rr rr           LDY   num_tmp_lo
001441r 2  B9 rr rr           LDA   input_buf,Y
001444r 2  7A                 PLY
001445r 2  91 rr              STA   (ptr_lo),Y
001447r 2  C8                 INY
001448r 2  EE rr rr           INC   num_tmp_lo
00144Br 2  CA                 DEX
00144Cr 2  D0 EF              BNE   @rw_copy
00144Er 2               @rw_set:
00144Er 2  A5 rr              LDA   ptr_lo
001450r 2  85 rr              STA   eval_val_lo
001452r 2  A5 rr              LDA   ptr_hi
001454r 2  85 rr              STA   eval_val_hi
001456r 2  A9 01              LDA   #VAL_WORD
001458r 2  85 rr              STA   eval_type
00145Ar 2  64 rr              STZ   eval_val_frac
00145Cr 2  4C rr rr           JMP   eval_continue
00145Fr 2               @rw_oom:
00145Fr 2  A2 rr              LDX   #<str_oom
001461r 2  A0 rr              LDY   #>str_oom
001463r 2  4C rr rr           JMP   list_print_err
001466r 2               
001466r 2               ; ---------------------------------------------------------------------
001466r 2               ; do_readlist — READLIST: read a line, return as a list
001466r 2               ;   Arity 0, no arguments. Reporter.
001466r 2               ;   Calls read_line, tokenize_line, then walks tokens building a list.
001466r 2               ; ---------------------------------------------------------------------
001466r 2               do_readlist:
001466r 2                     ; Save tokenizer state (we'll overwrite tok_head/tok_tail)
001466r 2  A5 rr              LDA   tok_head_lo
001468r 2  48                 PHA
001469r 2  A5 rr              LDA   tok_head_hi
00146Br 2  48                 PHA
00146Cr 2  A5 rr              LDA   tok_tail_lo
00146Er 2  48                 PHA
00146Fr 2  A5 rr              LDA   tok_tail_hi
001471r 2  48                 PHA
001472r 2  A5 rr              LDA   eval_cur_lo
001474r 2  48                 PHA
001475r 2  A5 rr              LDA   eval_cur_hi
001477r 2  48                 PHA
001478r 2               
001478r 2                     ; Read a line from keyboard into input_buf
001478r 2  20 rr rr           JSR   read_line
00147Br 2                     ; Tokenize it
00147Br 2  20 rr rr           JSR   tokenize_line
00147Er 2               
00147Er 2                     ; Walk tokens and build a list
00147Er 2  64 rr              STZ   z:list_head_lo
001480r 2  64 rr              STZ   z:list_head_hi
001482r 2  64 rr              STZ   z:list_tail_lo
001484r 2  64 rr              STZ   z:list_tail_hi
001486r 2               
001486r 2  A5 rr              LDA   tok_head_lo
001488r 2  85 rr              STA   eval_cur_lo
00148Ar 2  A5 rr              LDA   tok_head_hi
00148Cr 2  85 rr              STA   eval_cur_hi
00148Er 2               
00148Er 2               @rl_next:
00148Er 2  A5 rr              LDA   eval_cur_lo
001490r 2  05 rr              ORA   eval_cur_hi
001492r 2  D0 03              BNE   @rl_have_tok
001494r 2  4C rr rr           JMP   @rl_build_done
001497r 2               @rl_have_tok:
001497r 2               
001497r 2  A5 rr              LDA   eval_cur_lo
001499r 2  85 rr              STA   ptr_lo
00149Br 2  A5 rr              LDA   eval_cur_hi
00149Dr 2  85 rr              STA   ptr_hi
00149Fr 2  A0 00              LDY   #TOK_TAG
0014A1r 2  B1 rr              LDA   (ptr_lo),Y
0014A3r 2               
0014A3r 2  C9 02              CMP   #TOK_NUMBER
0014A5r 2  D0 03              BNE   :+
0014A7r 2  4C rr rr           JMP   @rl_number
0014AAr 2  C9 01        :     CMP   #TOK_WORD
0014ACr 2  F0 10              BEQ   @rl_word_jmp
0014AEr 2  C9 06              CMP   #TOK_QUOTE
0014B0r 2  F0 0C              BEQ   @rl_word_jmp
0014B2r 2  C9 03              CMP   #TOK_LBRACKET
0014B4r 2  D0 03              BNE   :+
0014B6r 2  4C rr rr           JMP   @rl_sublist
0014B9r 2               :     ; Skip other tokens (brackets, infix, etc.)
0014B9r 2  20 rr rr           JSR   eval_advance
0014BCr 2  80 D0              BRA   @rl_next
0014BEr 2               
0014BEr 2               @rl_word_jmp:
0014BEr 2  4C rr rr           JMP   @rl_word
0014C1r 2               
0014C1r 2               @rl_number:
0014C1r 2  A0 03              LDY   #TOK_PAYLOAD
0014C3r 2  B1 rr              LDA   (ptr_lo),Y
0014C5r 2  85 rr              STA   eval_val_hi
0014C7r 2  C8                 INY
0014C8r 2  B1 rr              LDA   (ptr_lo),Y
0014CAr 2  85 rr              STA   eval_val_lo
0014CCr 2  C8                 INY
0014CDr 2  B1 rr              LDA   (ptr_lo),Y
0014CFr 2  85 rr              STA   eval_val_frac
0014D1r 2  A9 00              LDA   #VAL_NUMBER
0014D3r 2  85 rr              STA   eval_type
0014D5r 2  20 rr rr           JSR   eval_advance
0014D8r 2  4C rr rr           JMP   @rl_alloc_cell
0014DBr 2               
0014DBr 2               @rl_word:
0014DBr 2                     ; Allocate string on heap and copy word from token payload
0014DBr 2  A0 03              LDY   #TOK_PAYLOAD
0014DDr 2  B1 rr              LDA   (ptr_lo),Y           ; length
0014DFr 2  48                 PHA
0014E0r 2  1A                 INC                        ; +1 for length byte
0014E1r 2  A2 05              LDX   #ATYPE_STRING
0014E3r 2  20 rr rr           JSR   heap_alloc
0014E6r 2  90 04              BCC   :+
0014E8r 2  68                 PLA
0014E9r 2  4C rr rr           JMP   @rl_oom
0014ECr 2               :     ; Re-read source token (ptr_lo clobbered by heap_alloc)
0014ECr 2  A5 rr              LDA   eval_cur_lo
0014EEr 2  85 rr              STA   ptr2_lo
0014F0r 2  A5 rr              LDA   eval_cur_hi
0014F2r 2  85 rr              STA   ptr2_hi
0014F4r 2  68                 PLA
0014F5r 2  48                 PHA
0014F6r 2  A0 00              LDY   #0
0014F8r 2  91 rr              STA   (ptr_lo),Y           ; store length
0014FAr 2  68                 PLA
0014FBr 2  AA                 TAX
0014FCr 2  F0 1B              BEQ   @rl_word_done
0014FEr 2  A0 01              LDY   #1
001500r 2  9C rr rr           STZ   num_tmp_lo
001503r 2               @rl_wch:
001503r 2  DA                 PHX
001504r 2  5A                 PHY
001505r 2  AD rr rr           LDA   num_tmp_lo
001508r 2  18                 CLC
001509r 2  69 04              ADC   #TOK_PAYLOAD+1
00150Br 2  A8                 TAY
00150Cr 2  B1 rr              LDA   (ptr2_lo),Y
00150Er 2  7A                 PLY
00150Fr 2  91 rr              STA   (ptr_lo),Y
001511r 2  C8                 INY
001512r 2  EE rr rr           INC   num_tmp_lo
001515r 2  FA                 PLX
001516r 2  CA                 DEX
001517r 2  D0 EA              BNE   @rl_wch
001519r 2               @rl_word_done:
001519r 2  A5 rr              LDA   ptr_lo
00151Br 2  85 rr              STA   eval_val_lo
00151Dr 2  A5 rr              LDA   ptr_hi
00151Fr 2  85 rr              STA   eval_val_hi
001521r 2  64 rr              STZ   eval_val_frac
001523r 2  A9 01              LDA   #VAL_WORD
001525r 2  85 rr              STA   eval_type
001527r 2  20 rr rr           JSR   eval_advance
00152Ar 2  4C rr rr           JMP   @rl_alloc_cell
00152Dr 2               
00152Dr 2               @rl_sublist:
00152Dr 2                     ; Use eval_list to build the sublist (advances past matching ])
00152Dr 2  20 rr rr           JSR   eval_advance
001530r 2  A5 rr              LDA   z:list_head_lo
001532r 2  48                 PHA
001533r 2  A5 rr              LDA   z:list_head_hi
001535r 2  48                 PHA
001536r 2  A5 rr              LDA   z:list_tail_lo
001538r 2  48                 PHA
001539r 2  A5 rr              LDA   z:list_tail_hi
00153Br 2  48                 PHA
00153Cr 2  20 rr rr           JSR   eval_list
00153Fr 2  68                 PLA
001540r 2  85 rr              STA   z:list_tail_hi
001542r 2  68                 PLA
001543r 2  85 rr              STA   z:list_tail_lo
001545r 2  68                 PLA
001546r 2  85 rr              STA   z:list_head_hi
001548r 2  68                 PLA
001549r 2  85 rr              STA   z:list_head_lo
00154Br 2                     ; eval_type = VAL_LIST, eval_val = sublist head
00154Br 2  4C rr rr           JMP   @rl_alloc_cell
00154Er 2               
00154Er 2               @rl_alloc_cell:
00154Er 2  A9 07              LDA   #CONS_SIZE
001550r 2  A2 02              LDX   #ATYPE_CONS
001552r 2  20 rr rr           JSR   heap_alloc
001555r 2  90 03              BCC   @rl_alloc_ok
001557r 2  4C rr rr           JMP   @rl_oom
00155Ar 2               @rl_alloc_ok:
00155Ar 2  A0 00              LDY   #CONS_TAG
00155Cr 2  A9 10              LDA   #CONS_PAIR
00155Er 2  91 rr              STA   (ptr_lo),Y
001560r 2  A0 01              LDY   #CONS_CAR_TYPE
001562r 2  A5 rr              LDA   eval_type
001564r 2  91 rr              STA   (ptr_lo),Y
001566r 2  A0 02              LDY   #CONS_CAR_HI
001568r 2  A5 rr              LDA   eval_val_hi
00156Ar 2  91 rr              STA   (ptr_lo),Y
00156Cr 2  A0 03              LDY   #CONS_CAR_LO
00156Er 2  A5 rr              LDA   eval_val_lo
001570r 2  91 rr              STA   (ptr_lo),Y
001572r 2  A0 04              LDY   #CONS_CAR_FRAC
001574r 2  A5 rr              LDA   eval_val_frac
001576r 2  91 rr              STA   (ptr_lo),Y
001578r 2  A0 05              LDY   #CONS_CDR_LO
00157Ar 2  A9 00              LDA   #0
00157Cr 2  91 rr              STA   (ptr_lo),Y
00157Er 2  A0 06              LDY   #CONS_CDR_HI
001580r 2  91 rr              STA   (ptr_lo),Y
001582r 2               
001582r 2                     ; Link into list
001582r 2  A5 rr              LDA   z:list_head_lo
001584r 2  05 rr              ORA   z:list_head_hi
001586r 2  D0 0F              BNE   @rl_link_tail
001588r 2  A5 rr              LDA   ptr_lo
00158Ar 2  85 rr              STA   z:list_head_lo
00158Cr 2  85 rr              STA   z:list_tail_lo
00158Er 2  A5 rr              LDA   ptr_hi
001590r 2  85 rr              STA   z:list_head_hi
001592r 2  85 rr              STA   z:list_tail_hi
001594r 2  4C rr rr           JMP   @rl_next
001597r 2               
001597r 2               @rl_link_tail:
001597r 2  A5 rr              LDA   z:list_tail_lo
001599r 2  85 rr              STA   ptr2_lo
00159Br 2  A5 rr              LDA   z:list_tail_hi
00159Dr 2  85 rr              STA   ptr2_hi
00159Fr 2  A0 05              LDY   #CONS_CDR_LO
0015A1r 2  A5 rr              LDA   ptr_lo
0015A3r 2  91 rr              STA   (ptr2_lo),Y
0015A5r 2  A0 06              LDY   #CONS_CDR_HI
0015A7r 2  A5 rr              LDA   ptr_hi
0015A9r 2  91 rr              STA   (ptr2_lo),Y
0015ABr 2  A5 rr              LDA   ptr_lo
0015ADr 2  85 rr              STA   z:list_tail_lo
0015AFr 2  A5 rr              LDA   ptr_hi
0015B1r 2  85 rr              STA   z:list_tail_hi
0015B3r 2  4C rr rr           JMP   @rl_next
0015B6r 2               
0015B6r 2               @rl_build_done:
0015B6r 2                     ; Restore tokenizer state
0015B6r 2  68                 PLA
0015B7r 2  85 rr              STA   eval_cur_hi
0015B9r 2  68                 PLA
0015BAr 2  85 rr              STA   eval_cur_lo
0015BCr 2  68                 PLA
0015BDr 2  85 rr              STA   tok_tail_hi
0015BFr 2  68                 PLA
0015C0r 2  85 rr              STA   tok_tail_lo
0015C2r 2  68                 PLA
0015C3r 2  85 rr              STA   tok_head_hi
0015C5r 2  68                 PLA
0015C6r 2  85 rr              STA   tok_head_lo
0015C8r 2               
