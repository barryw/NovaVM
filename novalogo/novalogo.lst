001D13r 2               :
001D13r 2                     ; Re-read source cell (ptr_lo/hi was clobbered by heap_alloc)
001D13r 2  A5 rr              LDA   list_ptr_lo
001D15r 2  85 rr              STA   ptr2_lo
001D17r 2  A5 rr              LDA   list_ptr_hi
001D19r 2  85 rr              STA   ptr2_hi
