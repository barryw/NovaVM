000000r 1                     .include "ext_iface.inc"
000000r 2               ; ext_iface.inc — shared interface between NovaLogo base ROM and extension ROM
000000r 2               ;
000000r 2               ; These equates define the ZP mailbox used to pass arguments and results
000000r 2               ; between the base ROM and the extension ROM via the RAM trampoline.
000000r 2               ; Both ROMs include this file so addresses are always consistent.
000000r 2               ;
000000r 2               ; Addresses $80-$91 are outside the linker-managed ZEROPAGE segment
000000r 2               ; but inside true zero page RAM, accessible to both ROM banks.
000000r 2               
000000r 2               ; --- Command and argument count ---
000000r 2               EXT_CMD         = $80           ; command ID (set by base ROM before trampoline call)
000000r 2               EXT_ARGC        = $81           ; argument count
000000r 2               
000000r 2               ; --- Argument 0 ---
000000r 2               EXT_ARG0_TYPE   = $82           ; type: VAL_NUMBER=$00, VAL_WORD=$01, VAL_LIST=$02
000000r 2               EXT_ARG0_HI     = $83           ; value high byte
000000r 2               EXT_ARG0_LO     = $84           ; value low byte
000000r 2               EXT_ARG0_FRAC   = $85           ; fractional byte (16.8 fixed point)
000000r 2               
000000r 2               ; --- Argument 1 ---
000000r 2               EXT_ARG1_TYPE   = $86
000000r 2               EXT_ARG1_HI     = $87
000000r 2               EXT_ARG1_LO     = $88
000000r 2               EXT_ARG1_FRAC   = $89
000000r 2               
000000r 2               ; --- Argument 2 ---
000000r 2               EXT_ARG2_TYPE   = $8A
000000r 2               EXT_ARG2_HI     = $8B
000000r 2               EXT_ARG2_LO     = $8C
000000r 2               EXT_ARG2_FRAC   = $8D
000000r 2               
000000r 2               ; --- Result ---
000000r 2               EXT_RESULT_TYPE = $8E           ; return value type
000000r 2               EXT_RESULT_HI   = $8F           ; return value high byte
000000r 2               EXT_RESULT_LO   = $90           ; return value low byte
000000r 2               EXT_RESULT_FRAC = $91           ; return value fractional byte
000000r 2               
000000r 2               ; --- Command IDs ---
000000r 2               EXT_CMD_TEST    = $01           ; test command: returns arg0 + 1
000000r 2               EXT_CMD_FD      = $10           ; FD distance — move forward
000000r 2               EXT_CMD_BK      = $11           ; BK distance — move backward
000000r 2               EXT_CMD_RT      = $12           ; RT degrees — turn right
000000r 2               EXT_CMD_LT      = $13           ; LT degrees — turn left
000000r 2               EXT_CMD_CS      = $14           ; CS — clear screen, init turtle
000000r 2               EXT_CMD_PU      = $15           ; PU — pen up
000000r 2               EXT_CMD_PD      = $16           ; PD — pen down
000000r 2               EXT_CMD_ST      = $17           ; ST — show turtle
000000r 2               EXT_CMD_HT      = $18           ; HT — hide turtle
000000r 2               EXT_CMD_HOME    = $19           ; HOME — move to center, heading 0
000000r 2               EXT_CMD_TS      = $1A           ; TEXTSCREEN — full text mode
000000r 2               EXT_CMD_SS      = $1B           ; SPLITSCREEN — copper split
000000r 2               EXT_CMD_FS      = $1C           ; FULLSCREEN — full graphics mode
000000r 2               EXT_CMD_SETXY   = $1D           ; SETXY x y — move to position
000000r 2               EXT_CMD_SETX    = $1E           ; SETX x — set X only
000000r 2               EXT_CMD_SETY    = $1F           ; SETY y — set Y only
000000r 2               EXT_CMD_SETH    = $20           ; SETHEADING — set heading degrees
000000r 2               EXT_CMD_XCOR    = $21           ; XCOR — report turtle X
000000r 2               EXT_CMD_YCOR    = $22           ; YCOR — report turtle Y
000000r 2               EXT_CMD_HEADING = $23           ; HEADING — report heading degrees
000000r 2               EXT_CMD_PENDOWNP = $24          ; PENDOWN? — report pen state
000000r 2               EXT_CMD_SHOWNP  = $25           ; SHOWN? — report visibility
000000r 2               EXT_CMD_SETPC   = $26           ; SETPC color — set pen color
000000r 2               EXT_CMD_SETBG   = $27           ; SETBG color — set background color
000000r 2               EXT_CMD_TOWARDS = $28           ; TOWARDS x y — heading towards point
000000r 2               EXT_CMD_SETPOS  = $29           ; SETPOS [x y] — move to position from list
000000r 2               
000000r 2               ; --- VGC graphics commands ---
000000r 2               EXT_CMD_SETCOLOR = $30          ; SETCOLOR color — set VGC draw color
000000r 2               EXT_CMD_PLOT     = $31          ; PLOT x y — plot pixel
000000r 2               EXT_CMD_UNPLOT   = $32          ; UNPLOT x y — clear pixel
000000r 2               EXT_CMD_LINE     = $33          ; LINE x1 y1 x2 y2 — draw line
000000r 2               EXT_CMD_CIRCLE   = $34          ; CIRCLE x y r — draw circle
000000r 2               EXT_CMD_RECT     = $35          ; RECT x1 y1 x2 y2 — draw rectangle
000000r 2               EXT_CMD_FILLRECT = $36          ; FILL x1 y1 x2 y2 — filled rectangle
000000r 2               EXT_CMD_PAINT    = $37          ; PAINT x y — flood fill
000000r 2               
000000r 2               ; --- Sprite commands ---
000000r 2               EXT_CMD_SPRITE   = $40          ; SPRITE n x y — position and enable
000000r 2               EXT_CMD_SPRITEPOS = $41         ; SPRITEPOS n x y — reposition
000000r 2               EXT_CMD_SPRITEON = $42          ; SPRITEON n — enable sprite
000000r 2               EXT_CMD_SPRITEOFF = $43         ; SPRITEOFF n — disable sprite
000000r 2               EXT_CMD_SPRCOLLP = $44          ; SPRITECOLLISION? n — collision query
000000r 2               
000000r 2               ; --- Sound commands ---
000000r 2               EXT_CMD_TONE     = $45          ; TONE freq dur — play tone
000000r 2               EXT_CMD_NOISE    = $46          ; NOISE dur — noise burst
000000r 2               EXT_CMD_VOLUME   = $47          ; VOLUME vol — set SID master volume
000000r 2               
000000r 2               ; --- Timing commands ---
000000r 2               EXT_CMD_WAIT     = $48          ; WAIT n — wait N frames
000000r 2               EXT_CMD_WAITVBL  = $49          ; WAITVBL — wait for next VBL
000000r 2               EXT_CMD_TIMER    = $4A          ; TIMER — return frame counter
000000r 2               
000000r 2               ; --- Editor command ---
000000r 2               ; EXT_CMD_EDIT — open the shared EDITUI/EDITBUF editor on a RAM text buffer.
000000r 2               ;   In:  ARG0 = buffer ptr (lo/hi)   ARG1 = current length (lo/hi)
000000r 2               ;        ARG2 = capacity (lo/hi)     ARG3 = NUL-terminated title ptr (lo/hi)
000000r 2               ;        ARG2_FRAC:ARG3_FRAC = initial cursor byte offset (lo:hi) — the unused
000000r 2               ;        fractional bytes of the cap/title pointer args carry the cursor.
000000r 2               ;   Out: RESULT_LO = editbuf exit reason (EDITBUF_EXIT_*)
000000r 2               ;        RESULT_HI = nonzero if the user requested a save (Ctrl-S / "Save First")
000000r 2               ;        ARG1 (lo/hi) = final buffer length
000000r 2               EXT_CMD_EDIT     = $4B          ; EDIT — run the shared text editor
000000r 2               
000000r 2               ; --- Value types (match eval_type in eval.s) ---
000000r 2               .ifndef VAL_NUMBER
000000r 2               VAL_NUMBER      = $00
000000r 2               .endif
000000r 2               .ifndef VAL_WORD
000000r 2               VAL_WORD        = $01
000000r 2               .endif
000000r 2               .ifndef VAL_LIST
000000r 2               VAL_LIST        = $02
000000r 2               .endif
000000r 2               
000000r 2               ; --- Legacy turtle state ZP addresses ---
000000r 2               ; Extension ROMs that define NOVALOGO_TURTLE_STATE_EXTERNAL provide their own
000000r 2               ; persistent turtle storage and only use this file for the mailbox ABI.
000000r 2               .ifndef NOVALOGO_TURTLE_STATE_EXTERNAL
000000r 2               TURTLE_X_FRAC   = $92
000000r 2               TURTLE_X_LO     = $93
000000r 2               TURTLE_X_HI     = $94
000000r 2               TURTLE_Y_FRAC   = $95
000000r 2               TURTLE_Y_LO     = $96
000000r 2               TURTLE_Y_HI     = $97
000000r 2               TURTLE_HEADING_LO = $98
000000r 2               TURTLE_HEADING_HI = $99
000000r 2               TURTLE_PEN      = $9A
000000r 2               TURTLE_SHOWN    = $9B
000000r 2               TURTLE_COLOR    = $9C
000000r 2               TURTLE_SPRITE   = $9D
000000r 2               TURTLE_INITED   = $9E
000000r 2               .endif
000000r 2               
000000r 2               ; --- Argument 3 (for 4+ arg commands like LINE, RECT, FILL) ---
000000r 2               EXT_ARG3_TYPE   = $9F
000000r 2               EXT_ARG3_HI     = $A0
000000r 2               EXT_ARG3_LO     = $A1
000000r 2               EXT_ARG3_FRAC   = $A2
000000r 2               
000000r 2               ; --- Trampoline location in RAM ---
000000r 2               EXT_TRAMPOLINE  = $0270         ; RAM address where trampoline code is copied
000000r 2               EXT_TRAMP_SIZE  = 14            ; size of trampoline code in bytes
000000r 2               
000000r 1                     .include "heap.s"
000000r 2               ; heap.s — bump allocator with GC headers for NovaLogo
000000r 2               ; Heap range: $0400 to HEAP_END-1.
000000r 2               
000000r 2               HEAP_START = $0400
000000r 2               HEAP_END   = $9800          ; one past last usable byte. $9800-$9BFF = editor BSS
000000r 2                                           ; (extension), $9C00-$9F10 = pinned turtle work+state.
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; ZEROPAGE segment — heap and general-purpose pointer variables
000000r 2               ; =====================================================================
000000r 2                     .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        heap_ptr:     .res 2          ; current heap allocation pointer
000002r 2  xx           ptr_lo:       .res 1          ; general-purpose pointer (low byte)
000003r 2  xx           ptr_hi:       .res 1          ; general-purpose pointer (high byte)
000004r 2               
000004r 2               ; =====================================================================
000004r 2               ; BSS segment — heap scratch
000004r 2               ; =====================================================================
000004r 2                     .segment "BSS"
000000r 2               
000000r 2  xx           ha_type:      .res 1          ; saved alloc type for heap_alloc
000001r 2  xx           ha_paysz:     .res 1          ; saved payload size for heap_alloc
000002r 2  xx           ha_gc_ran:    .res 1          ; flag: GC already attempted
000003r 2               
000003r 2               ; =====================================================================
000003r 2               ; CODE segment — heap routines
000003r 2               ; =====================================================================
000003r 2                     .segment "CODE"
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; heap_init — reset heap to empty
000000r 2               ;   Clobbers: A
000000r 2               ; ---------------------------------------------------------------------
000000r 2               heap_init:
000000r 2  A9 00              LDA   #<HEAP_START
000002r 2  85 rr              STA   heap_ptr
000004r 2  A9 04              LDA   #>HEAP_START
000006r 2  85 rr              STA   heap_ptr+1
000008r 2  60                 RTS
000009r 2               
000009r 2               ; ---------------------------------------------------------------------
000009r 2               ; heap_alloc — allocate A bytes with a 2-byte GC header
000009r 2               ;   Input:  A = payload size (bytes the caller wants)
000009r 2               ;           X = allocation type (ATYPE_*)
000009r 2               ;   Output: ptr_lo/ptr_hi = pointer to payload (header is at -2)
000009r 2               ;           Carry clear = success, Carry set = out of memory
000009r 2               ;   Clobbers: A, X, Y
000009r 2               ;
000009r 2               ;   Header layout at (returned_ptr - 2):
000009r 2               ;     +0: alloc_tag  = type (bits 6-0), mark cleared (bit 7 = 0)
000009r 2               ;     +1: alloc_size = payload + 2
000009r 2               ; ---------------------------------------------------------------------
000009r 2               heap_alloc:
000009r 2  8D rr rr           STA   ha_paysz
00000Cr 2  8E rr rr           STX   ha_type
00000Fr 2  9C rr rr           STZ   ha_gc_ran
000012r 2               
000012r 2               @retry:
000012r 2                     ; total = payload + 2
000012r 2  AD rr rr           LDA   ha_paysz
000015r 2  18                 CLC
000016r 2  69 02              ADC   #GC_HDR_BYTES
000018r 2               
000018r 2                     ; Save current heap_ptr → ptr_lo/hi (allocation base)
000018r 2  A6 rr              LDX   heap_ptr
00001Ar 2  86 rr              STX   ptr_lo
00001Cr 2  A6 rr              LDX   heap_ptr+1
00001Er 2  86 rr              STX   ptr_hi
000020r 2               
000020r 2                     ; Advance heap_ptr by total
000020r 2  18                 CLC
000021r 2  65 rr              ADC   heap_ptr
000023r 2  85 rr              STA   heap_ptr
000025r 2  A9 00              LDA   #0
000027r 2  65 rr              ADC   heap_ptr+1
000029r 2  85 rr              STA   heap_ptr+1
00002Br 2               
00002Br 2                     ; Check against HEAP_END
00002Br 2  C9 98              CMP   #>HEAP_END
00002Dr 2  90 21              BCC   @ok
00002Fr 2  D0 08              BNE   @oom
000031r 2  A5 rr              LDA   heap_ptr
000033r 2  C9 00              CMP   #<HEAP_END
000035r 2  90 19              BCC   @ok
000037r 2  F0 17              BEQ   @ok
000039r 2               
000039r 2               @oom:
000039r 2                     ; Restore heap_ptr
000039r 2  A5 rr              LDA   ptr_lo
00003Br 2  85 rr              STA   heap_ptr
00003Dr 2  A5 rr              LDA   ptr_hi
00003Fr 2  85 rr              STA   heap_ptr+1
000041r 2               
000041r 2                     ; Already tried GC?
000041r 2  AD rr rr           LDA   ha_gc_ran
000044r 2  D0 08              BNE   @fail
000046r 2  EE rr rr           INC   ha_gc_ran
000049r 2               
000049r 2                     ; Run GC and retry
000049r 2  20 rr rr           JSR   gc_collect
00004Cr 2  80 C4              BRA   @retry
00004Er 2               
00004Er 2               @fail:
00004Er 2  38                 SEC
00004Fr 2  60                 RTS
000050r 2               
000050r 2               @ok:
000050r 2                     ; Write header at allocation base (ptr_lo/hi)
000050r 2  A0 00              LDY   #GC_HDR_TAG
000052r 2  AD rr rr           LDA   ha_type
000055r 2  91 rr              STA   (ptr_lo),Y
000057r 2               
000057r 2  A0 01              LDY   #GC_HDR_SIZE
000059r 2  AD rr rr           LDA   ha_paysz
00005Cr 2  18                 CLC
00005Dr 2  69 02              ADC   #GC_HDR_BYTES
00005Fr 2  91 rr              STA   (ptr_lo),Y
000061r 2               
000061r 2                     ; Advance ptr_lo/hi past header → payload pointer
000061r 2  18                 CLC
000062r 2  A5 rr              LDA   ptr_lo
000064r 2  69 02              ADC   #GC_HDR_BYTES
000066r 2  85 rr              STA   ptr_lo
000068r 2  A5 rr              LDA   ptr_hi
00006Ar 2  69 00              ADC   #0
00006Cr 2  85 rr              STA   ptr_hi
00006Er 2               
00006Er 2  18                 CLC
00006Fr 2  60                 RTS
000070r 2               
000070r 1                     .include "tokens.s"
000070r 2               ; tokens.s — token node format and constants for NovaLogo
000070r 2               
000070r 2               ; Token type constants
000070r 2               TOK_WORD     = $01            ; payload: length byte + chars
000070r 2               TOK_NUMBER   = $02            ; payload: 3 bytes (hi, lo, frac) — 16.8 fixed-point
000070r 2               TOK_LBRACKET = $03            ; no payload
000070r 2               TOK_RBRACKET = $04            ; no payload
000070r 2               TOK_VARREF   = $05            ; payload: length byte + chars (name after :)
000070r 2               TOK_QUOTE    = $06            ; payload: length byte + chars (word after ")
000070r 2               TOK_INFIX    = $07            ; payload: 1 byte (operator char)
000070r 2               TOK_LPAREN   = $08            ; no payload
000070r 2               TOK_RPAREN   = $09            ; no payload
000070r 2               
000070r 2               ; Token node layout:
000070r 2               ;   Offset 0: tag byte (TOK_* constant)
000070r 2               ;   Offset 1: next pointer low byte
000070r 2               ;   Offset 2: next pointer high byte ($00/$00 = end of list)
000070r 2               ;   Offset 3+: payload (varies by type)
000070r 2               ;
000070r 2               ; Total size: 3 + payload_size
000070r 2               ;   TOK_WORD/VARREF/QUOTE: 3 + 1 + len (length byte + chars)
000070r 2               ;   TOK_NUMBER: 3 + 3 = 6 bytes
000070r 2               ;   TOK_LBRACKET/RBRACKET/LPAREN/RPAREN: 3 bytes (no payload)
000070r 2               ;   TOK_INFIX: 3 + 1 = 4 bytes
000070r 2               
000070r 2               TOK_TAG      = 0              ; offset to tag byte
000070r 2               TOK_NEXT_LO  = 1              ; offset to next pointer low
000070r 2               TOK_NEXT_HI  = 2              ; offset to next pointer high
000070r 2               TOK_PAYLOAD  = 3              ; offset to start of payload
000070r 2               
000070r 1                     .include "tokenizer.s"
000070r 2               ; tokenizer.s — scan input_buf into a linked list of token nodes
000070r 2               
000070r 2               ; =====================================================================
000070r 2               ; ZEROPAGE segment — tokenizer variables
000070r 2               ; =====================================================================
000070r 2                     .segment "ZEROPAGE"
000004r 2               
000004r 2  xx           tok_head_lo:  .res 1          ; head of token list (first token)
000005r 2  xx           tok_head_hi:  .res 1
000006r 2  xx           tok_tail_lo:  .res 1          ; tail of token list (for appending)
000007r 2  xx           tok_tail_hi:  .res 1
000008r 2  xx           tok_src:      .res 1          ; current scan position in input_buf
000009r 2  xx           ptr2_lo:      .res 1          ; second general-purpose pointer (low byte)
00000Ar 2  xx           ptr2_hi:      .res 1          ; second general-purpose pointer (high byte)
00000Br 2  xx           tok_sign:     .res 1          ; sign flag for number parsing (0=pos, 1=neg)
00000Cr 2               
00000Cr 2               ; =====================================================================
00000Cr 2               ; BSS segment — scratch for number parsing
00000Cr 2               ; =====================================================================
00000Cr 2                     .segment "BSS"
000003r 2               
000003r 2  xx           num_val_lo:   .res 1          ; integer accumulator low
000004r 2  xx           num_val_hi:   .res 1          ; integer accumulator high
000005r 2  xx           num_tmp_lo:   .res 1          ; temp for multiply / frac result
000006r 2  xx           num_tmp_hi:   .res 1          ; temp for multiply / frac raw
000007r 2               
000007r 2               ; =====================================================================
000007r 2               ; CODE segment — tokenizer routines
000007r 2               ; =====================================================================
000007r 2                     .segment "CODE"
000070r 2               
000070r 2               ; ---------------------------------------------------------------------
000070r 2               ; tokenize_line — scan input_buf and build a linked list of tokens
000070r 2               ;   Input:  input_buf contains null-terminated text
000070r 2               ;   Output: tok_head_lo/hi = first token ($0000 if empty line)
000070r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi
000070r 2               ; ---------------------------------------------------------------------
000070r 2               tokenize_line:
000070r 2  64 rr              STZ   tok_head_lo
000072r 2  64 rr              STZ   tok_head_hi
000074r 2  64 rr              STZ   tok_tail_lo
000076r 2  64 rr              STZ   tok_tail_hi
000078r 2  64 rr              STZ   tok_src
00007Ar 2                     ; fall through to scan loop
00007Ar 2               
00007Ar 2               ; Non-local entry for scan loop — reachable from all routines
00007Ar 2               tok_scan_next:
00007Ar 2                     ; --- skip whitespace ---
00007Ar 2  A6 rr              LDX   tok_src
00007Cr 2               @skip_ws:
00007Cr 2  BD rr rr           LDA   input_buf,X
00007Fr 2  C9 20              CMP   #$20                 ; space
000081r 2  F0 12              BEQ   @ws_next
000083r 2  C9 09              CMP   #$09                 ; tab
000085r 2  F0 0E              BEQ   @ws_next
000087r 2  C9 0A              CMP   #$0A                 ; newline
000089r 2  F0 0A              BEQ   @ws_next
00008Br 2  C9 0D              CMP   #$0D                 ; carriage return
00008Dr 2  F0 06              BEQ   @ws_next
00008Fr 2  C9 3B              CMP   #';'                 ; comment -> skip to end of line
000091r 2  F0 05              BEQ   @ws_comment
000093r 2  80 0F              BRA   @ws_done
000095r 2               @ws_next:
000095r 2  E8                 INX
000096r 2  80 E4              BRA   @skip_ws
000098r 2               @ws_comment:
000098r 2  E8                 INX
000099r 2  BD rr rr           LDA   input_buf,X
00009Cr 2  F0 06              BEQ   @ws_done             ; null terminator -> end of input (A=0)
00009Er 2  C9 0A              CMP   #$0A
0000A0r 2  D0 F6              BNE   @ws_comment
0000A2r 2  80 F1              BRA   @ws_next             ; skip the newline, keep scanning
0000A4r 2               @ws_done:
0000A4r 2  86 rr              STX   tok_src
0000A6r 2               
0000A6r 2                     ; --- check for end of input ---
0000A6r 2  C9 00              CMP   #0
0000A8r 2  D0 01              BNE   @not_end
0000AAr 2  60                 RTS                        ; done — list complete
0000ABr 2               @not_end:
0000ABr 2               
0000ABr 2                     ; --- colon → TOK_VARREF ---
0000ABr 2  C9 3A              CMP   #':'
0000ADr 2  D0 05              BNE   @not_colon
0000AFr 2  E6 rr              INC   tok_src              ; skip ':'
0000B1r 2  4C rr rr           JMP   tok_scan_varref
0000B4r 2               @not_colon:
0000B4r 2               
0000B4r 2                     ; --- quote → TOK_QUOTE ---
0000B4r 2  C9 22              CMP   #'"'
0000B6r 2  D0 05              BNE   @not_quote
0000B8r 2  E6 rr              INC   tok_src              ; skip '"'
0000BAr 2  4C rr rr           JMP   tok_scan_quote
0000BDr 2               @not_quote:
0000BDr 2               
0000BDr 2                     ; --- brackets ---
0000BDr 2  C9 5B              CMP   #'['
0000BFr 2  D0 05              BNE   @not_lb
0000C1r 2  A9 03              LDA   #TOK_LBRACKET
0000C3r 2  4C rr rr           JMP   tok_emit_simple
0000C6r 2               @not_lb:
0000C6r 2  C9 5D              CMP   #']'
0000C8r 2  D0 05              BNE   @not_rb
0000CAr 2  A9 04              LDA   #TOK_RBRACKET
0000CCr 2  4C rr rr           JMP   tok_emit_simple
0000CFr 2               @not_rb:
0000CFr 2               
0000CFr 2                     ; --- parens ---
0000CFr 2  C9 28              CMP   #'('
0000D1r 2  D0 05              BNE   @not_lp
0000D3r 2  A9 08              LDA   #TOK_LPAREN
0000D5r 2  4C rr rr           JMP   tok_emit_simple
0000D8r 2               @not_lp:
0000D8r 2  C9 29              CMP   #')'
0000DAr 2  D0 05              BNE   @not_rp
0000DCr 2  A9 09              LDA   #TOK_RPAREN
0000DEr 2  4C rr rr           JMP   tok_emit_simple
0000E1r 2               @not_rp:
0000E1r 2               
0000E1r 2                     ; --- infix operators (not minus) ---
0000E1r 2  C9 2B              CMP   #'+'
0000E3r 2  F0 16              BEQ   @is_infix
0000E5r 2  C9 2A              CMP   #'*'
0000E7r 2  F0 12              BEQ   @is_infix
0000E9r 2  C9 2F              CMP   #'/'
0000EBr 2  F0 0E              BEQ   @is_infix
0000EDr 2  C9 3C              CMP   #'<'
0000EFr 2  F0 0A              BEQ   @is_infix
0000F1r 2  C9 3E              CMP   #'>'
0000F3r 2  F0 06              BEQ   @is_infix
0000F5r 2  C9 3D              CMP   #'='
0000F7r 2  F0 02              BEQ   @is_infix
0000F9r 2  80 03              BRA   @not_infix
0000FBr 2               @is_infix:
0000FBr 2  4C rr rr           JMP   tok_emit_infix
0000FEr 2               @not_infix:
0000FEr 2               
0000FEr 2                     ; --- minus: could be infix or negative number ---
0000FEr 2  C9 2D              CMP   #'-'
000100r 2  D0 15              BNE   @not_minus
000102r 2                     ; peek at next character
000102r 2  A6 rr              LDX   tok_src
000104r 2  BD rr rr           LDA   input_buf+1,X
000107r 2  C9 30              CMP   #'0'
000109r 2  90 04              BCC   @minus_infix
00010Br 2  C9 3A              CMP   #'9'+1
00010Dr 2  90 05              BCC   @minus_number
00010Fr 2               @minus_infix:
00010Fr 2  A9 2D              LDA   #'-'
000111r 2  4C rr rr           JMP   tok_emit_infix
000114r 2               @minus_number:
000114r 2  4C rr rr           JMP   tok_parse_number
000117r 2               @not_minus:
000117r 2               
000117r 2                     ; --- digit → TOK_NUMBER ---
000117r 2  C9 30              CMP   #'0'
000119r 2  90 04              BCC   @not_digit
00011Br 2  C9 3A              CMP   #'9'+1
00011Dr 2  90 03              BCC   @is_digit
00011Fr 2               @not_digit:
00011Fr 2               
00011Fr 2                     ; --- default: TOK_WORD ---
00011Fr 2  4C rr rr           JMP   tok_scan_word
000122r 2               
000122r 2               @is_digit:
000122r 2  4C rr rr           JMP   tok_parse_number
000125r 2               
000125r 2               ; ---------------------------------------------------------------------
000125r 2               ; tok_emit_simple — emit a 3-byte node (tag only, no payload)
000125r 2               ;   Input: A = tag byte, tok_src points at the character
000125r 2               ; ---------------------------------------------------------------------
000125r 2               tok_emit_simple:
000125r 2  48                 PHA                        ; save tag
000126r 2  A9 03              LDA   #3
000128r 2  A2 01              LDX   #ATYPE_TOKEN
00012Ar 2  20 rr rr           JSR   heap_alloc
00012Dr 2  B0 13              BCS   @oom
00012Fr 2  68                 PLA
000130r 2  A0 00              LDY   #TOK_TAG
000132r 2  91 rr              STA   (ptr_lo),Y
000134r 2  A0 01              LDY   #TOK_NEXT_LO
000136r 2  A9 00              LDA   #0
000138r 2  91 rr              STA   (ptr_lo),Y
00013Ar 2  C8                 INY
00013Br 2  91 rr              STA   (ptr_lo),Y
00013Dr 2  E6 rr              INC   tok_src              ; advance past the character
00013Fr 2  4C rr rr           JMP   tok_append_node
000142r 2               @oom:
000142r 2  68                 PLA
000143r 2  60                 RTS
000144r 2               
000144r 2               ; ---------------------------------------------------------------------
000144r 2               ; tok_emit_infix — emit a 4-byte node (tag + operator char)
000144r 2               ;   Input: A = operator character, tok_src points at the operator
000144r 2               ; ---------------------------------------------------------------------
000144r 2               tok_emit_infix:
000144r 2  48                 PHA                        ; save operator char
000145r 2  A9 04              LDA   #4
000147r 2  A2 01              LDX   #ATYPE_TOKEN
000149r 2  20 rr rr           JSR   heap_alloc
00014Cr 2  B0 19              BCS   @oom
00014Er 2  A0 00              LDY   #TOK_TAG
000150r 2  A9 07              LDA   #TOK_INFIX
000152r 2  91 rr              STA   (ptr_lo),Y
000154r 2  A0 01              LDY   #TOK_NEXT_LO
000156r 2  A9 00              LDA   #0
000158r 2  91 rr              STA   (ptr_lo),Y
00015Ar 2  C8                 INY
00015Br 2  91 rr              STA   (ptr_lo),Y
00015Dr 2  A0 03              LDY   #TOK_PAYLOAD
00015Fr 2  68                 PLA
000160r 2  91 rr              STA   (ptr_lo),Y
000162r 2  E6 rr              INC   tok_src
000164r 2  4C rr rr           JMP   tok_append_node
