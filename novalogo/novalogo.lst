001552r 2               ; do_readlist — READLIST: read a line, return as a list
001552r 2               ;   Arity 0, no arguments. Reporter.
001552r 2               ;   Calls read_line, tokenize_line, then walks tokens building a list.
001552r 2               ; ---------------------------------------------------------------------
001552r 2               do_readlist:
001552r 2                     ; Save tokenizer state (we'll overwrite tok_head/tok_tail)
001552r 2  A5 rr              LDA   tok_head_lo
001554r 2  48                 PHA
001555r 2  A5 rr              LDA   tok_head_hi
001557r 2  48                 PHA
001558r 2  A5 rr              LDA   tok_tail_lo
00155Ar 2  48                 PHA
00155Br 2  A5 rr              LDA   tok_tail_hi
