000655r 2  20 rr rr           JSR   try_throw_error
000658r 2  60                 RTS
000659r 2               
000659r 2               @truly_unknown:
000659r 2                     ; Print "I don't know how to " + the word (inside body)
000659r 2  A2 00              LDX   #0
00065Br 2               @unk_lp:
00065Br 2  BD rr rr           LDA   str_idk,X
00065Er 2  F0 06              BEQ   @unk_word
000660r 2  8D 0E A0           STA   VGC_CHAROUT
000663r 2  E8                 INX
000664r 2  D0 F5              BNE   @unk_lp
000666r 2               @unk_word:
000666r 2  A5 rr              LDA   eval_cur_lo
000668r 2  85 rr              STA   ptr_lo
00066Ar 2  A5 rr              LDA   eval_cur_hi
00066Cr 2  85 rr              STA   ptr_hi
00066Er 2  A0 03              LDY   #TOK_PAYLOAD
000670r 2  B1 rr              LDA   (ptr_lo),Y
000672r 2  AA                 TAX
000673r 2  A0 04              LDY   #TOK_PAYLOAD+1
000675r 2               @unk_ch:
000675r 2  B1 rr              LDA   (ptr_lo),Y
000677r 2  8D 0E A0           STA   VGC_CHAROUT
00067Ar 2  C8                 INY
00067Br 2  CA                 DEX
00067Cr 2  D0 F7              BNE   @unk_ch
00067Er 2  20 rr rr           JSR   eval_newline
000681r 2  20 rr rr           JSR   try_throw_error
000684r 2  60                 RTS
000685r 2               
000685r 2               ; ---------------------------------------------------------------------
000685r 2               ; eval_advance — advance eval_cur to the next token in the list
000685r 2               ;   Reads next pointer from current token, stores in eval_cur
000685r 2               ; ---------------------------------------------------------------------
000685r 2               eval_advance:
000685r 2  A5 rr              LDA   eval_cur_lo
000687r 2  85 rr              STA   ptr_lo
000689r 2  A5 rr              LDA   eval_cur_hi
00068Br 2  85 rr              STA   ptr_hi
00068Dr 2  A0 01              LDY   #TOK_NEXT_LO
00068Fr 2  B1 rr              LDA   (ptr_lo),Y
000691r 2  AA                 TAX
000692r 2  C8                 INY
000693r 2  B1 rr              LDA   (ptr_lo),Y
000695r 2  85 rr              STA   eval_cur_hi
000697r 2  86 rr              STX   eval_cur_lo
000699r 2  60                 RTS
00069Ar 2               
00069Ar 2               ; ---------------------------------------------------------------------
00069Ar 2               ; eval_expr — evaluate one expression from the current token
00069Ar 2               ;   Output: eval_type, eval_val_hi/lo/frac set
00069Ar 2               ;           Carry clear = success, Carry set = error (no token)
00069Ar 2               ;   Advances eval_cur past the consumed token
00069Ar 2               ; ---------------------------------------------------------------------
00069Ar 2               eval_expr:
00069Ar 2                     ; Check for end of list
00069Ar 2  A5 rr              LDA   eval_cur_lo
00069Cr 2  05 rr              ORA   eval_cur_hi
00069Er 2  D0 02              BNE   @have_token
0006A0r 2  38                 SEC                       ; no more tokens
0006A1r 2  60                 RTS
0006A2r 2               
0006A2r 2               @have_token:
0006A2r 2  A5 rr              LDA   eval_cur_lo
0006A4r 2  85 rr              STA   ptr_lo
0006A6r 2  A5 rr              LDA   eval_cur_hi
0006A8r 2  85 rr              STA   ptr_hi
0006AAr 2  A0 00              LDY   #TOK_TAG
0006ACr 2  B1 rr              LDA   (ptr_lo),Y
0006AEr 2               
0006AEr 2  C9 02              CMP   #TOK_NUMBER
0006B0r 2  D0 03              BNE   :+
0006B2r 2  4C rr rr           JMP   @number
0006B5r 2  C9 06        :     CMP   #TOK_QUOTE
0006B7r 2  D0 03              BNE   :+
0006B9r 2  4C rr rr           JMP   @quote
0006BCr 2  C9 05        :     CMP   #TOK_VARREF
0006BEr 2  D0 03              BNE   :+
0006C0r 2  4C rr rr           JMP   @varref
0006C3r 2  C9 01        :     CMP   #TOK_WORD
0006C5r 2  F0 06              BEQ   @word_expr
0006C7r 2  C9 03              CMP   #TOK_LBRACKET
0006C9r 2  F0 19              BEQ   @list_literal
0006CBr 2                     ; Anything else is an error
0006CBr 2  38                 SEC
0006CCr 2  60                 RTS
0006CDr 2               
0006CDr 2               @word_expr:
0006CDr 2                     ; Could be a reporter procedure (returns a value via OUTPUT)
0006CDr 2  20 rr rr           JSR   proc_lookup
0006D0r 2  B0 19              BCS   @word_not_proc        ; not a procedure — try builtins
0006D2r 2                     ; It's a procedure — invoke it
0006D2r 2  20 rr rr           JSR   proc_invoke
0006D5r 2                     ; X = exit status: $02 = OUTPUT (eval_val has value), else no value
0006D5r 2  E0 02              CPX   #$02
0006D7r 2  F0 08              BEQ   @word_has_val
0006D9r 2                     ; No OUTPUT — set result to 0
0006D9r 2  64 rr              STZ   eval_val_hi
0006DBr 2  64 rr              STZ   eval_val_lo
0006DDr 2  64 rr              STZ   eval_val_frac
0006DFr 2  64 rr              STZ   eval_type
0006E1r 2               @word_has_val:
0006E1r 2  4C rr rr           JMP   eval_check_infix      ; allow DOUBLE 5 + 3 etc.
0006E4r 2               
0006E4r 2               @list_literal:
0006E4r 2                     ; Advance past the [
0006E4r 2  20 rr rr           JSR   eval_advance
0006E7r 2                     ; Build list from tokens until ]
0006E7r 2  20 rr rr           JSR   eval_list
0006EAr 2                     ; eval_type = VAL_LIST, eval_val = head pointer
0006EAr 2                     ; Carry already set/clear from eval_list
0006EAr 2  60                 RTS
0006EBr 2               
0006EBr 2               @word_not_proc:
0006EBr 2                     ; Not a user proc — try built-in reporter
0006EBr 2  20 rr rr           JSR   lookup_builtin
0006EEr 2  B0 37              BCS   @word_unknown
0006F0r 2                     ; Found: ptr2_lo/hi = handler addr, A = arity
0006F0r 2                     ; Save handler address
0006F0r 2  A6 rr              LDX   ptr2_lo
0006F2r 2  86 rr              STX   handler_lo
0006F4r 2  A6 rr              LDX   ptr2_hi
0006F6r 2  86 rr              STX   handler_hi
0006F8r 2  AA                 TAX                       ; X = arity
0006F9r 2  DA                 PHX                       ; save arity across eval_advance
0006FAr 2                     ; Advance past the command word
0006FAr 2  20 rr rr           JSR   eval_advance
0006FDr 2  FA                 PLX                       ; restore arity
0006FEr 2                     ; Evaluate arguments (X = arity count)
0006FEr 2  E0 00              CPX   #0
000700r 2  F0 16              BEQ   @call_reporter
000702r 2                     ; Save handler address — eval_expr may clobber it
000702r 2  A5 rr              LDA   handler_hi
000704r 2  48                 PHA
000705r 2  A5 rr              LDA   handler_lo
000707r 2  48                 PHA
000708r 2               @rpt_eval_args:
000708r 2  DA                 PHX
000709r 2  20 rr rr           JSR   eval_expr
00070Cr 2  B0 14              BCS   @rpt_arg_error
00070Er 2  FA                 PLX
00070Fr 2  CA                 DEX
000710r 2  D0 F6              BNE   @rpt_eval_args
000712r 2                     ; Restore handler address
000712r 2  68                 PLA
000713r 2  85 rr              STA   handler_lo
000715r 2  68                 PLA
000716r 2  85 rr              STA   handler_hi
000718r 2               @call_reporter:
000718r 2                     ; Set reporter mode so eval_continue returns here instead of looping
000718r 2  A9 01              LDA   #$01
00071Ar 2  85 rr              STA   eval_reporter
00071Cr 2                     ; Call via JSR to trampoline — handler JMPs to eval_continue
00071Cr 2                     ; which sees eval_reporter and does CLC + RTS back here.
00071Cr 2  20 rr rr           JSR   jmp_handler
00071Fr 2                     ; eval_val now set by the handler
00071Fr 2  4C rr rr           JMP   eval_check_infix
000722r 2               
000722r 2               @rpt_arg_error:
000722r 2  FA                 PLX                       ; discard saved arity counter
000723r 2  68                 PLA
000724r 2  68                 PLA                       ; discard saved handler address
000725r 2  38                 SEC
000726r 2  60                 RTS
000727r 2               
000727r 2               @word_unknown:
000727r 2                     ; Try extension command table as reporter
000727r 2  20 rr rr           JSR   lookup_ext_cmd
00072Ar 2  B0 22              BCS   @word_really_unknown
00072Cr 2                     ; Found: A = arity, EXT_CMD set
00072Cr 2  AA                 TAX
00072Dr 2  DA                 PHX
00072Er 2  20 rr rr           JSR   eval_advance
000731r 2  FA                 PLX
000732r 2  20 rr rr           JSR   ext_eval_args
000735r 2  B0 17              BCS   @word_really_unknown
000737r 2  20 70 02           JSR   EXT_TRAMPOLINE
00073Ar 2                     ; Copy result back to eval_val
00073Ar 2  A5 8E              LDA   EXT_RESULT_TYPE
00073Cr 2  85 rr              STA   eval_type
00073Er 2  A5 8F              LDA   EXT_RESULT_HI
000740r 2  85 rr              STA   eval_val_hi
000742r 2  A5 90              LDA   EXT_RESULT_LO
000744r 2  85 rr              STA   eval_val_lo
000746r 2  A5 91              LDA   EXT_RESULT_FRAC
000748r 2  85 rr              STA   eval_val_frac
00074Ar 2  18                 CLC
00074Br 2  4C rr rr           JMP   eval_check_infix
00074Er 2               
00074Er 2               @word_really_unknown:
00074Er 2  38                 SEC
00074Fr 2  60                 RTS
000750r 2               
000750r 2               @number:
000750r 2                     ; Copy 3-byte payload to eval_val
000750r 2  A0 03              LDY   #TOK_PAYLOAD
000752r 2  B1 rr              LDA   (ptr_lo),Y         ; int_hi
000754r 2  85 rr              STA   eval_val_hi
000756r 2  C8                 INY
000757r 2  B1 rr              LDA   (ptr_lo),Y         ; int_lo
000759r 2  85 rr              STA   eval_val_lo
00075Br 2  C8                 INY
00075Cr 2  B1 rr              LDA   (ptr_lo),Y         ; frac
00075Er 2  85 rr              STA   eval_val_frac
000760r 2  64 rr              STZ   eval_type           ; $00 = number
000762r 2  20 rr rr           JSR   eval_advance
000765r 2  4C rr rr           JMP   eval_check_infix    ; check for infix operator
000768r 2               
000768r 2               @quote:
000768r 2                     ; Point eval_val at the payload (length byte + chars)
000768r 2                     ; Pointer = ptr_lo/hi + TOK_PAYLOAD
000768r 2  18                 CLC
000769r 2  A5 rr              LDA   ptr_lo
00076Br 2  69 03              ADC   #TOK_PAYLOAD
00076Dr 2  85 rr              STA   eval_val_lo
00076Fr 2  A5 rr              LDA   ptr_hi
000771r 2  69 00              ADC   #0
000773r 2  85 rr              STA   eval_val_hi
000775r 2  64 rr              STZ   eval_val_frac
000777r 2  A9 01              LDA   #$01
000779r 2  85 rr              STA   eval_type           ; $01 = word
00077Br 2  20 rr rr           JSR   eval_advance
00077Er 2  18                 CLC
00077Fr 2  60                 RTS
000780r 2               
000780r 2               @varref:
000780r 2                     ; Variable reference — :NAME
000780r 2                     ; Payload is length-prefixed name at token + TOK_PAYLOAD
000780r 2  18                 CLC
000781r 2  A5 rr              LDA   ptr_lo
000783r 2  69 03              ADC   #TOK_PAYLOAD
000785r 2  85 rr              STA   ptr_lo
000787r 2  A5 rr              LDA   ptr_hi
000789r 2  69 00              ADC   #0
00078Br 2  85 rr              STA   ptr_hi
00078Dr 2  20 rr rr           JSR   var_get
000790r 2  90 30              BCC   @var_ok
000792r 2               
000792r 2                     ; Not found — print "NAME has no value"
000792r 2                     ; ptr_lo/hi was clobbered by var_get, reload from eval_cur
000792r 2  A5 rr              LDA   eval_cur_lo
000794r 2  85 rr              STA   ptr_lo
000796r 2  A5 rr              LDA   eval_cur_hi
000798r 2  85 rr              STA   ptr_hi
00079Ar 2  A0 03              LDY   #TOK_PAYLOAD          ; length byte
00079Cr 2  B1 rr              LDA   (ptr_lo),Y
00079Er 2  AA                 TAX                         ; X = name length
00079Fr 2  A0 04              LDY   #TOK_PAYLOAD+1
0007A1r 2               @vr_name:
0007A1r 2  B1 rr              LDA   (ptr_lo),Y
0007A3r 2  8D 0E A0           STA   VGC_CHAROUT
0007A6r 2  C8                 INY
0007A7r 2  CA                 DEX
0007A8r 2  D0 F7              BNE   @vr_name
0007AAr 2  A2 00              LDX   #0
0007ACr 2               @vr_msg:
0007ACr 2  BD rr rr           LDA   str_no_value,X
0007AFr 2  F0 06              BEQ   @vr_done
0007B1r 2  8D 0E A0           STA   VGC_CHAROUT
0007B4r 2  E8                 INX
0007B5r 2  D0 F5              BNE   @vr_msg
0007B7r 2               @vr_done:
0007B7r 2  20 rr rr           JSR   eval_newline
0007BAr 2  20 rr rr           JSR   try_throw_error
0007BDr 2  20 rr rr           JSR   eval_advance
0007C0r 2  38                 SEC
0007C1r 2  60                 RTS
0007C2r 2               
0007C2r 2               @var_ok:
0007C2r 2                     ; eval_type and eval_val already set by var_get
0007C2r 2  20 rr rr           JSR   eval_advance
0007C5r 2  4C rr rr           JMP   eval_check_infix      ; allow :X + 5 etc.
0007C8r 2               
0007C8r 2               ; ---------------------------------------------------------------------
0007C8r 2               ; eval_newline — print CR+LF
0007C8r 2               ; ---------------------------------------------------------------------
0007C8r 2               eval_newline:
0007C8r 2  A9 0D              LDA   #$0D
0007CAr 2  8D 0E A0           STA   VGC_CHAROUT
0007CDr 2  A9 0A              LDA   #$0A
0007CFr 2  8D 0E A0           STA   VGC_CHAROUT
0007D2r 2  60                 RTS
0007D3r 2               
0007D3r 2               ; ---------------------------------------------------------------------
0007D3r 2               ; eval_check_infix — if next token is TOK_INFIX, evaluate binary op
0007D3r 2               ;   Entry: eval_val holds the left operand (primary value)
0007D3r 2               ;   Exit:  eval_val holds the result, carry clear = success
0007D3r 2               ; ---------------------------------------------------------------------
0007D3r 2               eval_check_infix:
0007D3r 2                     ; Is there a next token?
0007D3r 2  A5 rr              LDA   eval_cur_lo
0007D5r 2  05 rr              ORA   eval_cur_hi
0007D7r 2  F0 75              BEQ   @no_infix
0007D9r 2               
0007D9r 2                     ; Peek at the next token's tag
0007D9r 2  A5 rr              LDA   eval_cur_lo
0007DBr 2  85 rr              STA   ptr_lo
0007DDr 2  A5 rr              LDA   eval_cur_hi
0007DFr 2  85 rr              STA   ptr_hi
0007E1r 2  A0 00              LDY   #TOK_TAG
0007E3r 2  B1 rr              LDA   (ptr_lo),Y
0007E5r 2  C9 07              CMP   #TOK_INFIX
0007E7r 2  D0 65              BNE   @no_infix
0007E9r 2               
0007E9r 2                     ; Save the left operand to ZP scratch
0007E9r 2  A5 rr              LDA   eval_val_hi
0007EBr 2  85 rr              STA   eval_left_hi
0007EDr 2  A5 rr              LDA   eval_val_lo
0007EFr 2  85 rr              STA   eval_left_lo
0007F1r 2  A5 rr              LDA   eval_val_frac
0007F3r 2  85 rr              STA   eval_left_frac
0007F5r 2               
0007F5r 2                     ; Read operator character from payload
0007F5r 2  A0 03              LDY   #TOK_PAYLOAD
0007F7r 2  B1 rr              LDA   (ptr_lo),Y
0007F9r 2  85 rr              STA   eval_op
0007FBr 2               
0007FBr 2                     ; Advance past the infix token
0007FBr 2  20 rr rr           JSR   eval_advance
0007FEr 2               
0007FEr 2                     ; Push left operand and operator onto hardware stack so recursive
0007FEr 2                     ; proc_invoke calls (which may evaluate their own infix expressions)
0007FEr 2                     ; cannot clobber them.
0007FEr 2  A5 rr              LDA   eval_left_hi
000800r 2  48                 PHA
000801r 2  A5 rr              LDA   eval_left_lo
000803r 2  48                 PHA
000804r 2  A5 rr              LDA   eval_left_frac
000806r 2  48                 PHA
000807r 2  A5 rr              LDA   eval_op
000809r 2  48                 PHA
00080Ar 2               
00080Ar 2                     ; Evaluate the right operand (recursive call)
00080Ar 2  20 rr rr           JSR   eval_expr
00080Dr 2  B0 41              BCS   @err_rhs_pop
00080Fr 2               
00080Fr 2                     ; Restore left operand and operator from stack
00080Fr 2  68                 PLA
000810r 2  85 rr              STA   eval_op
000812r 2  68                 PLA
000813r 2  85 rr              STA   eval_left_frac
000815r 2  68                 PLA
000816r 2  85 rr              STA   eval_left_lo
000818r 2  68                 PLA
000819r 2  85 rr              STA   eval_left_hi
00081Br 2               
00081Br 2                     ; Dispatch based on operator character
00081Br 2  A5 rr              LDA   eval_op
00081Dr 2  C9 2B              CMP   #'+'
00081Fr 2  F0 35              BEQ   @do_add
000821r 2  C9 2D              CMP   #'-'
000823r 2  F0 46              BEQ   @do_sub
000825r 2  C9 2A              CMP   #'*'
000827r 2  F0 57              BEQ   @do_mul
000829r 2  C9 2F              CMP   #'/'
00082Br 2  F0 75              BEQ   @do_div
00082Dr 2  C9 3E              CMP   #'>'
00082Fr 2  D0 03              BNE   :+
000831r 2  4C rr rr           JMP   @do_gt
000834r 2  C9 3C        :     CMP   #'<'
000836r 2  D0 03              BNE   :+
000838r 2  4C rr rr           JMP   @do_lt
00083Br 2  C9 3D        :     CMP   #'='
00083Dr 2  D0 03              BNE   :+
00083Fr 2  4C rr rr           JMP   @do_eq
000842r 2               :
000842r 2                     ; Unknown operator — return left value unchanged
000842r 2  A5 rr              LDA   eval_left_hi
000844r 2  85 rr              STA   eval_val_hi
000846r 2  A5 rr              LDA   eval_left_lo
000848r 2  85 rr              STA   eval_val_lo
00084Ar 2  A5 rr              LDA   eval_left_frac
00084Cr 2  85 rr              STA   eval_val_frac
00084Er 2               
00084Er 2               @no_infix:
00084Er 2  18                 CLC
00084Fr 2  60                 RTS
000850r 2               
000850r 2               @err_rhs_pop:
000850r 2                     ; Discard saved left operand + operator (4 bytes)
000850r 2  68                 PLA
000851r 2  68                 PLA
000852r 2  68                 PLA
000853r 2  68                 PLA
000854r 2               @err_rhs:
000854r 2  38                 SEC
000855r 2  60                 RTS
000856r 2               
000856r 2                     ; ----- Addition: left + right (24-bit: frac, lo, hi) -----
000856r 2               @do_add:
000856r 2  18                 CLC
000857r 2  A5 rr              LDA   eval_left_frac
000859r 2  65 rr              ADC   eval_val_frac
00085Br 2  85 rr              STA   eval_val_frac
00085Dr 2  A5 rr              LDA   eval_left_lo
00085Fr 2  65 rr              ADC   eval_val_lo
000861r 2  85 rr              STA   eval_val_lo
000863r 2  A5 rr              LDA   eval_left_hi
000865r 2  65 rr              ADC   eval_val_hi
000867r 2  85 rr              STA   eval_val_hi
000869r 2  18                 CLC
00086Ar 2  60                 RTS
00086Br 2               
00086Br 2                     ; ----- Subtraction: left - right (24-bit) -----
00086Br 2               @do_sub:
00086Br 2  38                 SEC
00086Cr 2  A5 rr              LDA   eval_left_frac
00086Er 2  E5 rr              SBC   eval_val_frac
000870r 2  85 rr              STA   eval_val_frac
000872r 2  A5 rr              LDA   eval_left_lo
000874r 2  E5 rr              SBC   eval_val_lo
000876r 2  85 rr              STA   eval_val_lo
000878r 2  A5 rr              LDA   eval_left_hi
00087Ar 2  E5 rr              SBC   eval_val_hi
00087Cr 2  85 rr              STA   eval_val_hi
00087Er 2  18                 CLC
00087Fr 2  60                 RTS
000880r 2               
000880r 2                     ; ----- Multiplication: left * right via coprocessor -----
000880r 2                     ; Integer-only for this pass (frac ignored)
000880r 2               @do_mul:
000880r 2  A5 rr              LDA   eval_left_lo
000882r 2  8D 20 BB           STA   MATH_MUL16_A_LO
000885r 2  A5 rr              LDA   eval_left_hi
000887r 2  8D 21 BB           STA   MATH_MUL16_A_HI
00088Ar 2  A5 rr              LDA   eval_val_lo
00088Cr 2  8D 22 BB           STA   MATH_MUL16_B_LO
00088Fr 2  A5 rr              LDA   eval_val_hi
000891r 2  8D 23 BB           STA   MATH_MUL16_B_HI     ; write triggers multiply
000894r 2  AD 38 BB           LDA   MATH_RES0
000897r 2  85 rr              STA   eval_val_lo
000899r 2  AD 39 BB           LDA   MATH_RES1
00089Cr 2  85 rr              STA   eval_val_hi
00089Er 2  64 rr              STZ   eval_val_frac
0008A0r 2  18                 CLC
0008A1r 2  60                 RTS
0008A2r 2               
0008A2r 2                     ; ----- Division: left / right via coprocessor -----
0008A2r 2                     ; Signed 32÷16: dividend = sign-extended left integer, divisor = right integer
0008A2r 2               @do_div:
0008A2r 2                     ; Check for divide by zero
0008A2r 2  A5 rr              LDA   eval_val_lo
0008A4r 2  05 rr              ORA   eval_val_hi
0008A6r 2  D0 08              BNE   @div_ok
0008A8r 2                     ; Division by zero — return 0
0008A8r 2  64 rr              STZ   eval_val_frac
0008AAr 2  64 rr              STZ   eval_val_lo
0008ACr 2  64 rr              STZ   eval_val_hi
0008AEr 2  18                 CLC
0008AFr 2  60                 RTS
0008B0r 2               @div_ok:
0008B0r 2                     ; Write 32-bit dividend (sign-extend left integer to 32 bits)
0008B0r 2  A5 rr              LDA   eval_left_lo
0008B2r 2  8D 28 BB           STA   MATH_DIV_N_LO
0008B5r 2  A5 rr              LDA   eval_left_hi
0008B7r 2  8D 29 BB           STA   MATH_DIV_N_1
0008BAr 2                     ; Sign-extend high word
0008BAr 2  A5 rr              LDA   eval_left_hi
0008BCr 2  09 7F              ORA   #$7F                 ; set bits 0-6
0008BEr 2  30 04              BMI   @neg_ext             ; if bit 7 was set, A=$FF (negative)
0008C0r 2  A9 00              LDA   #$00                 ; positive: extend with $00
0008C2r 2  80 00              BRA   @write_ext
0008C4r 2               @neg_ext:                        ; A is already $FF
0008C4r 2               @write_ext:
0008C4r 2  8D 2A BB           STA   MATH_DIV_N_2
0008C7r 2  8D 2B BB           STA   MATH_DIV_N_HI
0008CAr 2                     ; Write 16-bit divisor (right operand integer)
0008CAr 2  A5 rr              LDA   eval_val_lo
0008CCr 2  8D 2C BB           STA   MATH_DIV_D_LO
0008CFr 2  A5 rr              LDA   eval_val_hi
0008D1r 2  8D 2D BB           STA   MATH_DIV_D_HI       ; write triggers divide
0008D4r 2                     ; Read quotient from result
0008D4r 2  AD 38 BB           LDA   MATH_RES0
0008D7r 2  85 rr              STA   eval_val_lo
0008D9r 2  AD 39 BB           LDA   MATH_RES1
0008DCr 2  85 rr              STA   eval_val_hi
0008DEr 2  64 rr              STZ   eval_val_frac
0008E0r 2  18                 CLC
0008E1r 2  60                 RTS
0008E2r 2               
0008E2r 2                     ; ----- Equality: left = right (all 3 bytes must match) -----
0008E2r 2               @do_eq:
0008E2r 2  A5 rr              LDA   eval_left_hi
0008E4r 2  C5 rr              CMP   eval_val_hi
0008E6r 2  D0 64              BNE   @set_false
0008E8r 2  A5 rr              LDA   eval_left_lo
0008EAr 2  C5 rr              CMP   eval_val_lo
0008ECr 2  D0 5E              BNE   @set_false
0008EEr 2  A5 rr              LDA   eval_left_frac
0008F0r 2  C5 rr              CMP   eval_val_frac
0008F2r 2  D0 58              BNE   @set_false
0008F4r 2  80 4A              BRA   @set_true
0008F6r 2               
0008F6r 2                     ; ----- Greater than: left > right (signed 24-bit) -----
0008F6r 2               @do_gt:
0008F6r 2                     ; Compare hi bytes (signed)
0008F6r 2  A5 rr              LDA   eval_left_hi
0008F8r 2  38                 SEC
0008F9r 2  E5 rr              SBC   eval_val_hi
0008FBr 2  50 02              BVC   @gt_sign_ok           ; no overflow — N flag valid
0008FDr 2  49 80              EOR   #$80                  ; overflow — invert N to get true sign
0008FFr 2               @gt_sign_ok:
0008FFr 2  30 4B              BMI   @set_false            ; left_hi < right_hi → false
000901r 2                     ; If the subtraction was nonzero and positive, left > right
000901r 2  A5 rr              LDA   eval_left_hi
000903r 2  C5 rr              CMP   eval_val_hi
000905r 2  D0 39              BNE   @set_true             ; hi bytes differ, and left > right
000907r 2                     ; Hi bytes equal — compare lo bytes (unsigned)
000907r 2  A5 rr              LDA   eval_left_lo
000909r 2  C5 rr              CMP   eval_val_lo
00090Br 2  D0 0A              BNE   @gt_lo_diff
00090Dr 2                     ; Lo bytes equal — compare frac bytes (unsigned)
00090Dr 2  A5 rr              LDA   eval_left_frac
00090Fr 2  C5 rr              CMP   eval_val_frac
000911r 2  F0 39              BEQ   @set_false            ; all equal → not greater
000913r 2  B0 2B              BCS   @set_true
000915r 2  80 35              BRA   @set_false
000917r 2               @gt_lo_diff:
000917r 2  B0 27              BCS   @set_true
000919r 2  80 31              BRA   @set_false
00091Br 2               
00091Br 2                     ; ----- Less than: left < right (signed 24-bit) -----
00091Br 2               @do_lt:
00091Br 2                     ; Compare hi bytes (signed)
00091Br 2  A5 rr              LDA   eval_left_hi
00091Dr 2  38                 SEC
00091Er 2  E5 rr              SBC   eval_val_hi
000920r 2  50 02              BVC   @lt_sign_ok
000922r 2  49 80              EOR   #$80
000924r 2               @lt_sign_ok:
000924r 2  30 1A              BMI   @set_true             ; left_hi < right_hi → true
000926r 2  A5 rr              LDA   eval_left_hi
000928r 2  C5 rr              CMP   eval_val_hi
00092Ar 2  D0 20              BNE   @set_false            ; left_hi > right_hi → false
00092Cr 2                     ; Hi bytes equal — compare lo bytes (unsigned)
00092Cr 2  A5 rr              LDA   eval_left_lo
00092Er 2  C5 rr              CMP   eval_val_lo
000930r 2  D0 0A              BNE   @lt_lo_diff
000932r 2                     ; Lo bytes equal — compare frac (unsigned)
000932r 2  A5 rr              LDA   eval_left_frac
000934r 2  C5 rr              CMP   eval_val_frac
000936r 2  F0 14              BEQ   @set_false            ; equal → not less
000938r 2  90 06              BCC   @set_true
00093Ar 2  80 10              BRA   @set_false
00093Cr 2               @lt_lo_diff:
00093Cr 2  90 02              BCC   @set_true
00093Er 2  80 0C              BRA   @set_false
000940r 2               
000940r 2                     ; ----- Set result to TRUE (1) or FALSE (0) -----
000940r 2               @set_true:
000940r 2  64 rr              STZ   eval_val_hi
000942r 2  A9 01              LDA   #1
000944r 2  85 rr              STA   eval_val_lo
000946r 2  64 rr              STZ   eval_val_frac
000948r 2  64 rr              STZ   eval_type
00094Ar 2  18                 CLC
00094Br 2  60                 RTS
00094Cr 2               
00094Cr 2               @set_false:
00094Cr 2  64 rr              STZ   eval_val_hi
00094Er 2  64 rr              STZ   eval_val_lo
000950r 2  64 rr              STZ   eval_val_frac
000952r 2  64 rr              STZ   eval_type
000954r 2  18                 CLC
000955r 2  60                 RTS
000956r 2               
000956r 2               ; ---------------------------------------------------------------------
000956r 2               ; print_number — print eval_val as a signed decimal number
000956r 2               ;   Input: eval_val_hi/lo/frac (16.8 fixed-point, signed)
000956r 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
000956r 2               ; ---------------------------------------------------------------------
000956r 2               print_number:
000956r 2                     ; Check sign — if negative, print '-' and negate
000956r 2  A5 rr              LDA   eval_val_hi
000958r 2  10 1E              BPL   @positive
00095Ar 2                     ; Print minus sign
00095Ar 2  A9 2D              LDA   #'-'
00095Cr 2  8D 0E A0           STA   VGC_CHAROUT
00095Fr 2                     ; Negate 3-byte value (two's complement)
00095Fr 2  A5 rr              LDA   eval_val_frac
000961r 2  49 FF              EOR   #$FF
000963r 2  18                 CLC
000964r 2  69 01              ADC   #1
000966r 2  85 rr              STA   eval_val_frac
000968r 2  A5 rr              LDA   eval_val_lo
00096Ar 2  49 FF              EOR   #$FF
00096Cr 2  69 00              ADC   #0
00096Er 2  85 rr              STA   eval_val_lo
000970r 2  A5 rr              LDA   eval_val_hi
000972r 2  49 FF              EOR   #$FF
000974r 2  69 00              ADC   #0
000976r 2  85 rr              STA   eval_val_hi
000978r 2               
000978r 2               @positive:
000978r 2                     ; Print integer part (eval_val_hi:eval_val_lo as 16-bit unsigned)
000978r 2  20 rr rr           JSR   print_uint16
00097Br 2               
00097Br 2                     ; Print fractional part if non-zero
00097Br 2  A5 rr              LDA   eval_val_frac
00097Dr 2  D0 01              BNE   @has_frac
00097Fr 2  60                 RTS
000980r 2               @has_frac:
000980r 2               
000980r 2                     ; Print decimal point
000980r 2  A9 2E              LDA   #'.'
000982r 2  8D 0E A0           STA   VGC_CHAROUT
000985r 2               
000985r 2                     ; Convert frac byte to decimal digits
000985r 2                     ; frac * 10 / 256 = first digit, repeat with remainder
000985r 2  A5 rr              LDA   eval_val_frac
000987r 2  8D rr rr           STA   num_tmp_lo
00098Ar 2  9C rr rr           STZ   num_tmp_hi
00098Dr 2               
00098Dr 2                     ; First digit: (frac * 10) >> 8
00098Dr 2                     ; frac * 10 = (frac * 8) + (frac * 2)
00098Dr 2  AD rr rr           LDA   num_tmp_lo
000990r 2  0A                 ASL
000991r 2  8D rr rr           STA   num_val_lo          ; frac * 2
000994r 2  AD rr rr           LDA   num_tmp_hi
000997r 2  2A                 ROL
000998r 2  8D rr rr           STA   num_val_hi
00099Br 2               
00099Br 2  0E rr rr           ASL   num_val_lo
00099Er 2  2E rr rr           ROL   num_val_hi
0009A1r 2  0E rr rr           ASL   num_val_lo
0009A4r 2  2E rr rr           ROL   num_val_hi          ; frac * 8
0009A7r 2               
0009A7r 2  18                 CLC
0009A8r 2  AD rr rr           LDA   num_tmp_lo
0009ABr 2  0A                 ASL                       ; frac * 2 (low byte)
0009ACr 2  6D rr rr           ADC   num_val_lo
0009AFr 2  8D rr rr           STA   num_val_lo
0009B2r 2  AD rr rr           LDA   num_tmp_hi
0009B5r 2  2A                 ROL
0009B6r 2  6D rr rr           ADC   num_val_hi
0009B9r 2  8D rr rr           STA   num_val_hi          ; num_val = frac * 10
0009BCr 2               
0009BCr 2                     ; High byte = first decimal digit
0009BCr 2  AD rr rr           LDA   num_val_hi
0009BFr 2  09 30              ORA   #'0'
0009C1r 2  8D 0E A0           STA   VGC_CHAROUT
0009C4r 2               
0009C4r 2                     ; Remainder = low byte → second digit
0009C4r 2  AD rr rr           LDA   num_val_lo
0009C7r 2  8D rr rr           STA   num_tmp_lo
0009CAr 2  9C rr rr           STZ   num_tmp_hi
0009CDr 2               
0009CDr 2                     ; Second digit: (remainder * 10) >> 8
0009CDr 2  AD rr rr           LDA   num_tmp_lo
0009D0r 2  0A                 ASL
0009D1r 2  8D rr rr           STA   num_val_lo
0009D4r 2  AD rr rr           LDA   num_tmp_hi
0009D7r 2  2A                 ROL
0009D8r 2  8D rr rr           STA   num_val_hi
0009DBr 2               
0009DBr 2  0E rr rr           ASL   num_val_lo
0009DEr 2  2E rr rr           ROL   num_val_hi
0009E1r 2  0E rr rr           ASL   num_val_lo
0009E4r 2  2E rr rr           ROL   num_val_hi
0009E7r 2               
0009E7r 2  18                 CLC
0009E8r 2  AD rr rr           LDA   num_tmp_lo
0009EBr 2  0A                 ASL
0009ECr 2  6D rr rr           ADC   num_val_lo
0009EFr 2  8D rr rr           STA   num_val_lo
0009F2r 2  AD rr rr           LDA   num_tmp_hi
0009F5r 2  2A                 ROL
0009F6r 2  6D rr rr           ADC   num_val_hi
0009F9r 2  8D rr rr           STA   num_val_hi
0009FCr 2               
0009FCr 2                     ; High byte = second digit; skip if zero (trailing)
0009FCr 2  AD rr rr           LDA   num_val_hi
0009FFr 2  F0 05              BEQ   @done
000A01r 2  09 30              ORA   #'0'
000A03r 2  8D 0E A0           STA   VGC_CHAROUT
000A06r 2               
000A06r 2               @done:
000A06r 2  60                 RTS
000A07r 2               
000A07r 2               ; ---------------------------------------------------------------------
000A07r 2               ; print_uint16 — print eval_val_hi:eval_val_lo as unsigned decimal
000A07r 2               ;   No leading zeros (except value 0 prints "0")
000A07r 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
000A07r 2               ; ---------------------------------------------------------------------
000A07r 2               print_uint16:
000A07r 2                     ; Copy to working regs
000A07r 2  A5 rr              LDA   eval_val_lo
000A09r 2  8D rr rr           STA   num_val_lo
000A0Cr 2  A5 rr              LDA   eval_val_hi
000A0Er 2  8D rr rr           STA   num_val_hi
000A11r 2               
000A11r 2  A2 00              LDX   #0                  ; digit buffer index
000A13r 2  A0 00              LDY   #0                  ; power-of-10 table index
000A15r 2               
000A15r 2               @div_loop:
000A15r 2  9C rr rr           STZ   num_tmp_lo          ; digit counter for this power
000A18r 2               @sub_loop:
000A18r 2                     ; Subtract current power of 10
000A18r 2  38                 SEC
000A19r 2  AD rr rr           LDA   num_val_lo
000A1Cr 2  F9 rr rr           SBC   pow10_lo,Y
000A1Fr 2  48                 PHA
000A20r 2  AD rr rr           LDA   num_val_hi
000A23r 2  F9 rr rr           SBC   pow10_hi,Y
000A26r 2  90 0C              BCC   @sub_done           ; underflow — done with this digit
000A28r 2  8D rr rr           STA   num_val_hi
000A2Br 2  68                 PLA
000A2Cr 2  8D rr rr           STA   num_val_lo
000A2Fr 2  EE rr rr           INC   num_tmp_lo
000A32r 2  80 E4              BRA   @sub_loop
000A34r 2               @sub_done:
000A34r 2  68                 PLA                       ; discard low byte from failed subtract
000A35r 2  AD rr rr           LDA   num_tmp_lo
000A38r 2  9D rr rr           STA   pn_buf,X
000A3Br 2  E8                 INX
000A3Cr 2  C8                 INY
000A3Dr 2  C0 05              CPY   #5                  ; 5 powers (10000,1000,100,10,1)
000A3Fr 2  90 D4              BCC   @div_loop
000A41r 2               
000A41r 2                     ; Print digits, suppressing leading zeros
000A41r 2  A0 00              LDY   #0                  ; suppress flag (0=suppress)
000A43r 2  A2 00              LDX   #0
000A45r 2               @print_loop:
000A45r 2  BD rr rr           LDA   pn_buf,X
000A48r 2  D0 04              BNE   @nonzero
000A4Ar 2  C0 00              CPY   #0
000A4Cr 2  F0 07              BEQ   @maybe_skip        ; still suppressing
000A4Er 2               @nonzero:
000A4Er 2  A0 01              LDY   #1                  ; seen nonzero digit
000A50r 2  09 30              ORA   #'0'
000A52r 2  8D 0E A0           STA   VGC_CHAROUT
000A55r 2               @maybe_skip:
000A55r 2  E8                 INX
000A56r 2  E0 04              CPX   #4
000A58r 2  90 EB              BCC   @print_loop
000A5Ar 2                     ; Always print the last digit (ones place)
000A5Ar 2  AD rr rr           LDA   pn_buf+4
000A5Dr 2  09 30              ORA   #'0'
000A5Fr 2  8D 0E A0           STA   VGC_CHAROUT
000A62r 2  60                 RTS
000A63r 2               
000A63r 2               ; ---------------------------------------------------------------------
000A63r 2               ; try_throw_error — if a CATCH with tag "ERROR" is active, unwind to it
000A63r 2               ;   Called after error messages are printed. If no catch is active or
000A63r 2               ;   the tag doesn't match "ERROR", this is a no-op (returns normally).
000A63r 2               ;   If a match is found, this NEVER RETURNS — it unwinds the stack
000A63r 2               ;   via TXS and jumps to the catch resume point.
000A63r 2               ; ---------------------------------------------------------------------
000A63r 2               try_throw_error:
000A63r 2  A5 rr              LDA   catch_active
000A65r 2  F0 3A              BEQ   @no_catch
000A67r 2               
000A67r 2                     ; Compare catch_tag against "ERROR" (5 chars, uppercased)
000A67r 2  A5 rr              LDA   catch_tag_lo
000A69r 2  85 rr              STA   ptr2_lo
000A6Br 2  A5 rr              LDA   catch_tag_hi
000A6Dr 2  85 rr              STA   ptr2_hi
000A6Fr 2  A9 rr              LDA   #<str_error_tag
000A71r 2  85 rr              STA   ptr_lo
000A73r 2  A9 rr              LDA   #>str_error_tag
000A75r 2  85 rr              STA   ptr_hi
000A77r 2  20 rr rr           JSR   catch_tags_equal
000A7Ar 2  90 25              BCC   @no_catch
000A7Cr 2               
000A7Cr 2                     ; Match! Unwind stack to catch point and resume.
000A7Cr 2  A6 rr              LDX   catch_sp
000A7Er 2  9A                 TXS
000A7Fr 2               
000A7Fr 2                     ; Restore previous catch frame from the restored stack
000A7Fr 2  68                 PLA
000A80r 2  85 rr              STA   catch_resume_hi
000A82r 2  68                 PLA
000A83r 2  85 rr              STA   catch_resume_lo
000A85r 2  68                 PLA
000A86r 2  85 rr              STA   catch_sp
000A88r 2  68                 PLA
000A89r 2  85 rr              STA   catch_tag_hi
000A8Br 2  68                 PLA
000A8Cr 2  85 rr              STA   catch_tag_lo
000A8Er 2  68                 PLA
000A8Fr 2  85 rr              STA   catch_active
000A91r 2               
000A91r 2                     ; Restore eval_in_body and discard saved tag pointer (3 bytes)
000A91r 2  68                 PLA
000A92r 2  85 rr              STA   eval_in_body
000A94r 2  68                 PLA                         ; tag_hi
000A95r 2  68                 PLA                         ; tag_lo
000A96r 2               
000A96r 2                     ; Set eval_cur to resume point (past the caught body)
000A96r 2  A5 rr              LDA   catch_resume_lo
000A98r 2  85 rr              STA   eval_cur_lo
000A9Ar 2  A5 rr              LDA   catch_resume_hi
000A9Cr 2  85 rr              STA   eval_cur_hi
000A9Er 2               
000A9Er 2  4C rr rr           JMP   eval_continue
000AA1r 2               
000AA1r 2               @no_catch:
000AA1r 2  60                 RTS
000AA2r 2               
000AA2r 2               ; ---------------------------------------------------------------------
000AA2r 2               ; catch_tags_equal — compare two length-prefixed strings (case-insensitive)
000AA2r 2               ;   Input: ptr_lo/hi = string A, ptr2_lo/hi = string B
000AA2r 2               ;   Output: carry set = equal, carry clear = not equal
000AA2r 2               ;   Clobbers: A, X, Y
000AA2r 2               ; ---------------------------------------------------------------------
000AA2r 2               catch_tags_equal:
000AA2r 2  A0 00              LDY   #0
000AA4r 2  B1 rr              LDA   (ptr_lo),Y           ; length of A
000AA6r 2  8D rr rr           STA   num_tmp_lo            ; temp: len A
000AA9r 2  B1 rr              LDA   (ptr2_lo),Y          ; length of B
000AABr 2  CD rr rr           CMP   num_tmp_lo
000AAEr 2  D0 2D              BNE   @ne
000AB0r 2               
000AB0r 2                     ; Lengths match — compare chars
000AB0r 2  AA                 TAX                         ; X = length
000AB1r 2  F0 28              BEQ   @eq                   ; both zero = equal
000AB3r 2  A0 01              LDY   #1
000AB5r 2               @cmp:
000AB5r 2  B1 rr              LDA   (ptr_lo),Y
000AB7r 2                     ; Uppercase A char
000AB7r 2  C9 61              CMP   #'a'
000AB9r 2  90 07              BCC   @a_up
000ABBr 2  C9 7B              CMP   #'z'+1
000ABDr 2  B0 03              BCS   @a_up
000ABFr 2  38                 SEC
000AC0r 2  E9 20              SBC   #$20
000AC2r 2               @a_up:
000AC2r 2  8D rr rr           STA   num_tmp_lo            ; uppercased A char
000AC5r 2               
000AC5r 2  B1 rr              LDA   (ptr2_lo),Y
000AC7r 2                     ; Uppercase B char
000AC7r 2  C9 61              CMP   #'a'
000AC9r 2  90 07              BCC   @b_up
000ACBr 2  C9 7B              CMP   #'z'+1
000ACDr 2  B0 03              BCS   @b_up
000ACFr 2  38                 SEC
000AD0r 2  E9 20              SBC   #$20
000AD2r 2               @b_up:
000AD2r 2  CD rr rr           CMP   num_tmp_lo
000AD5r 2  D0 06              BNE   @ne
000AD7r 2  C8                 INY
000AD8r 2  CA                 DEX
000AD9r 2  D0 DA              BNE   @cmp
000ADBr 2               
000ADBr 2               @eq:
000ADBr 2  38                 SEC
000ADCr 2  60                 RTS
000ADDr 2               @ne:
000ADDr 2  18                 CLC
000ADEr 2  60                 RTS
000ADFr 2               
000ADFr 2               ; =====================================================================
000ADFr 2               ; RODATA — evaluator strings and tables
000ADFr 2               ; =====================================================================
000ADFr 2               ; ---------------------------------------------------------------------
000ADFr 2               ; lookup_ext_cmd — search ext_cmd_table for the current TOK_WORD
000ADFr 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000ADFr 2               ;   Output: Carry clear = found, A = arity, EXT_CMD set
000ADFr 2               ;           Carry set = not found
000ADFr 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000ADFr 2               ; ---------------------------------------------------------------------
000ADFr 2               lookup_ext_cmd:
000ADFr 2                     ; Save table pointer in num_tmp_lo/hi
000ADFr 2  A9 rr              LDA   #<ext_cmd_table
000AE1r 2  8D rr rr           STA   num_tmp_lo
000AE4r 2  A9 rr              LDA   #>ext_cmd_table
000AE6r 2  8D rr rr           STA   num_tmp_hi
000AE9r 2               
000AE9r 2               @scan:
000AE9r 2                     ; Read name pointer from table
000AE9r 2  AD rr rr           LDA   num_tmp_lo
000AECr 2  85 rr              STA   ptr2_lo
000AEEr 2  AD rr rr           LDA   num_tmp_hi
000AF1r 2  85 rr              STA   ptr2_hi
000AF3r 2  A0 00              LDY   #0
000AF5r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000AF7r 2  AA                 TAX
000AF8r 2  C8                 INY
000AF9r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000AFBr 2  D0 06              BNE   @have_entry
000AFDr 2  E0 00              CPX   #0
000AFFr 2  D0 02              BNE   @have_entry
000B01r 2                     ; Null pointer — end of table
000B01r 2  38                 SEC
000B02r 2  60                 RTS
000B03r 2               
000B03r 2               @have_entry:
000B03r 2                     ; X = name_ptr_lo, A = name_ptr_hi
000B03r 2  85 rr              STA   ptr2_hi
000B05r 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000B07r 2               
000B07r 2                     ; Get token payload pointer
000B07r 2  A5 rr              LDA   eval_cur_lo
000B09r 2  85 rr              STA   ptr_lo
000B0Br 2  A5 rr              LDA   eval_cur_hi
000B0Dr 2  85 rr              STA   ptr_hi
000B0Fr 2               
000B0Fr 2                     ; Compare length bytes
000B0Fr 2  A0 00              LDY   #0
000B11r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000B13r 2  A0 03              LDY   #TOK_PAYLOAD
000B15r 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000B17r 2  D0 30              BNE   @next
000B19r 2               
000B19r 2                     ; Lengths match — compare chars
000B19r 2  AA                 TAX                       ; X = length
000B1Ar 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000B1Cr 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000B1Er 2               @cmp_loop:
000B1Er 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000B20r 2  5A                 PHY
000B21r 2  A5 rr              LDA   tok_sign
000B23r 2  18                 CLC
000B24r 2  69 04              ADC   #TOK_PAYLOAD+1
000B26r 2  A8                 TAY
000B27r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000B29r 2  7A                 PLY
000B2Ar 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000B2Cr 2  D0 1B              BNE   @next
000B2Er 2  C8                 INY
000B2Fr 2  E6 rr              INC   tok_sign
000B31r 2  CA                 DEX
000B32r 2  D0 EA              BNE   @cmp_loop
000B34r 2               
000B34r 2                     ; Match found — read cmd_id and arity
000B34r 2                     ; Table entry: name_ptr(2) + cmd_id(1) + arity(1)
000B34r 2  AD rr rr           LDA   num_tmp_lo
000B37r 2  85 rr              STA   ptr_lo
000B39r 2  AD rr rr           LDA   num_tmp_hi
000B3Cr 2  85 rr              STA   ptr_hi
000B3Er 2  A0 02              LDY   #2
000B40r 2  B1 rr              LDA   (ptr_lo),Y         ; cmd_id
000B42r 2  85 80              STA   EXT_CMD
000B44r 2  C8                 INY
000B45r 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000B47r 2  18                 CLC                       ; found
000B48r 2  60                 RTS
000B49r 2               
000B49r 2               @next:
000B49r 2  64 rr              STZ   tok_sign
000B4Br 2                     ; Advance to next entry: +4 bytes (2 name + 1 cmd_id + 1 arity)
000B4Br 2  18                 CLC
000B4Cr 2  AD rr rr           LDA   num_tmp_lo
000B4Fr 2  69 04              ADC   #4
000B51r 2  8D rr rr           STA   num_tmp_lo
000B54r 2  90 03              BCC   :+
000B56r 2  EE rr rr           INC   num_tmp_hi
000B59r 2               :
000B59r 2  4C rr rr           JMP   @scan
000B5Cr 2               
000B5Cr 2               ; ---------------------------------------------------------------------
000B5Cr 2               ; ext_eval_args — evaluate X arguments and copy to EXT_ARG0..2 slots
000B5Cr 2               ;   Input: X = argument count (0-3)
000B5Cr 2               ;   Output: Carry clear = success, Carry set = error
000B5Cr 2               ;           EXT_ARGC set, EXT_ARG0..2 populated
000B5Cr 2               ;   Clobbers: A, X, Y
000B5Cr 2               ; ---------------------------------------------------------------------
000B5Cr 2               ext_eval_args:
000B5Cr 2  86 81              STX   EXT_ARGC
000B5Er 2  E0 00              CPX   #0
000B60r 2  F0 65              BEQ   @done
000B62r 2               
000B62r 2                     ; Evaluate arg 0
000B62r 2  DA                 PHX
000B63r 2  20 rr rr           JSR   eval_expr
000B66r 2  FA                 PLX
000B67r 2  B0 60              BCS   @err
000B69r 2  A5 rr              LDA   eval_type
000B6Br 2  85 82              STA   EXT_ARG0_TYPE
000B6Dr 2  A5 rr              LDA   eval_val_hi
000B6Fr 2  85 83              STA   EXT_ARG0_HI
000B71r 2  A5 rr              LDA   eval_val_lo
000B73r 2  85 84              STA   EXT_ARG0_LO
000B75r 2  A5 rr              LDA   eval_val_frac
000B77r 2  85 85              STA   EXT_ARG0_FRAC
000B79r 2  CA                 DEX
000B7Ar 2  F0 4B              BEQ   @done
000B7Cr 2               
000B7Cr 2                     ; Evaluate arg 1
000B7Cr 2  DA                 PHX
000B7Dr 2  20 rr rr           JSR   eval_expr
000B80r 2  FA                 PLX
000B81r 2  B0 46              BCS   @err
000B83r 2  A5 rr              LDA   eval_type
000B85r 2  85 86              STA   EXT_ARG1_TYPE
000B87r 2  A5 rr              LDA   eval_val_hi
000B89r 2  85 87              STA   EXT_ARG1_HI
000B8Br 2  A5 rr              LDA   eval_val_lo
000B8Dr 2  85 88              STA   EXT_ARG1_LO
000B8Fr 2  A5 rr              LDA   eval_val_frac
000B91r 2  85 89              STA   EXT_ARG1_FRAC
000B93r 2  CA                 DEX
000B94r 2  F0 31              BEQ   @done
000B96r 2               
000B96r 2                     ; Evaluate arg 2
000B96r 2  DA                 PHX
000B97r 2  20 rr rr           JSR   eval_expr
000B9Ar 2  FA                 PLX
000B9Br 2  B0 2C              BCS   @err
000B9Dr 2  A5 rr              LDA   eval_type
000B9Fr 2  85 8A              STA   EXT_ARG2_TYPE
000BA1r 2  A5 rr              LDA   eval_val_hi
000BA3r 2  85 8B              STA   EXT_ARG2_HI
000BA5r 2  A5 rr              LDA   eval_val_lo
000BA7r 2  85 8C              STA   EXT_ARG2_LO
000BA9r 2  A5 rr              LDA   eval_val_frac
000BABr 2  85 8D              STA   EXT_ARG2_FRAC
000BADr 2  CA                 DEX
000BAEr 2  F0 17              BEQ   @done
000BB0r 2               
000BB0r 2                     ; Evaluate arg 3 (for LINE, RECT, FILL etc.)
000BB0r 2  DA                 PHX
000BB1r 2  20 rr rr           JSR   eval_expr
000BB4r 2  FA                 PLX
000BB5r 2  B0 12              BCS   @err
000BB7r 2  A5 rr              LDA   eval_type
000BB9r 2  85 9F              STA   EXT_ARG3_TYPE
000BBBr 2  A5 rr              LDA   eval_val_hi
000BBDr 2  85 A0              STA   EXT_ARG3_HI
000BBFr 2  A5 rr              LDA   eval_val_lo
000BC1r 2  85 A1              STA   EXT_ARG3_LO
000BC3r 2  A5 rr              LDA   eval_val_frac
000BC5r 2  85 A2              STA   EXT_ARG3_FRAC
000BC7r 2               
000BC7r 2               @done:
000BC7r 2  18                 CLC
000BC8r 2  60                 RTS
000BC9r 2               @err:
000BC9r 2  38                 SEC
000BCAr 2  60                 RTS
000BCBr 2               
000BCBr 2                     .segment "RODATA"
000008r 2               
000008r 2               ; Extension command table: name_ptr(2) + cmd_id(1) + arity(1)
000008r 2               ; Terminated by $0000 sentinel.
000008r 2               ext_cmd_table:
000008r 2  rr rr              .word str_ext_test_name
00000Ar 2  01                 .byte EXT_CMD_TEST
