0023A5r 2               
0023A5r 2                     ; Read car type
0023A5r 2  A5 rr              LDA   list_ptr_lo
0023A7r 2  85 rr              STA   ptr_lo
0023A9r 2  A5 rr              LDA   list_ptr_hi
0023ABr 2  85 rr              STA   ptr_hi
