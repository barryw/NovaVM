002164r 2  68                 PLA                           ; lo
002165r 2  85 rr              STA   list_tail_lo
002167r 2  68                 PLA                           ; hi
002168r 2  85 rr              STA   list_tail_hi
00216Ar 2  68                 PLA                           ; type (unused, known VAL_LIST)
00216Br 2               
00216Br 2                     ; Pop first list pointer
00216Br 2  68                 PLA                           ; frac (unused)
00216Cr 2  68                 PLA                           ; lo
00216Dr 2  85 rr              STA   list_head_lo
00216Fr 2  68                 PLA                           ; hi
002170r 2  85 rr              STA   list_head_hi
