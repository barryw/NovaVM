0005B9r 2               
0005B9r 1                     .include "lists.s"
0005B9r 2               ; lists.s — list data type, cons pairs, and list operations for NovaLogo
0005B9r 2               ;
0005B9r 2               ; Cons pair format on heap (7 bytes):
0005B9r 2               ;   +0: tag byte ($10 = CONS_PAIR)
0005B9r 2               ;   +1: car_type ($00=number, $01=word, $02=list)
0005B9r 2               ;   +2: car_hi
0005B9r 2               ;   +3: car_lo
0005B9r 2               ;   +4: car_frac (only meaningful for numbers)
0005B9r 2               ;   +5: cdr_lo (pointer to next cons pair, or $0000 for empty)
0005B9r 2               ;   +6: cdr_hi
0005B9r 2               
0005B9r 2               CONS_PAIR  = $10
0005B9r 2               CONS_SIZE  = 7
0005B9r 2               
0005B9r 2               ; Value type constants
0005B9r 2               .ifndef VAL_NUMBER
0005B9r 2               VAL_NUMBER = $00
0005B9r 2               .endif
0005B9r 2               .ifndef VAL_WORD
0005B9r 2               VAL_WORD   = $01
0005B9r 2               .endif
0005B9r 2               .ifndef VAL_LIST
0005B9r 2               VAL_LIST   = $02
0005B9r 2               .endif
0005B9r 2               
0005B9r 2               ; Cons pair field offsets
0005B9r 2               CONS_TAG      = 0
0005B9r 2               CONS_CAR_TYPE = 1
0005B9r 2               CONS_CAR_HI   = 2
0005B9r 2               CONS_CAR_LO   = 3
0005B9r 2               CONS_CAR_FRAC = 4
0005B9r 2               CONS_CDR_LO   = 5
0005B9r 2               CONS_CDR_HI   = 6
0005B9r 2               
0005B9r 2               ; =====================================================================
0005B9r 2               ; ZEROPAGE segment — list scratch variables
0005B9r 2               ; =====================================================================
0005B9r 2                     .segment "ZEROPAGE"
00002Fr 2               
00002Fr 2  xx           list_head_lo:   .res 1    ; head of list being built
000030r 2  xx           list_head_hi:   .res 1
000031r 2  xx           list_tail_lo:   .res 1    ; tail of list being built
000032r 2  xx           list_tail_hi:   .res 1
000033r 2  xx           list_ptr_lo:    .res 1    ; general list walk pointer
000034r 2  xx           list_ptr_hi:    .res 1
000035r 2  xx           list_count_lo:  .res 1    ; 16-bit counter for COUNT / ITEM
000036r 2  xx           list_count_hi:  .res 1
000037r 2               
000037r 2               ; =====================================================================
000037r 2               ; CODE segment — list building and operations
000037r 2               ; =====================================================================
000037r 2                     .segment "CODE"
001874r 2               
001874r 2               ; ---------------------------------------------------------------------
001874r 2               ; eval_list — build a list from tokens between [ and ]
001874r 2               ;   Entry: eval_cur points at the first token AFTER the [
001874r 2               ;   Exit:  eval_type = VAL_LIST, eval_val_lo/hi = head cons pair ptr
001874r 2               ;          eval_cur advanced past the matching ]
001874r 2               ;          Carry clear = success
001874r 2               ; ---------------------------------------------------------------------
001874r 2               eval_list:
001874r 2  64 rr              STZ   list_head_lo
001876r 2  64 rr              STZ   list_head_hi
001878r 2  64 rr              STZ   list_tail_lo
00187Ar 2  64 rr              STZ   list_tail_hi
00187Cr 2               
00187Cr 2               @next_element:
00187Cr 2  A5 rr              LDA   eval_cur_lo
00187Er 2  05 rr              ORA   eval_cur_hi
001880r 2  D0 03              BNE   :+
001882r 2  4C rr rr           JMP   @err_no_bracket
001885r 2               :
001885r 2  A5 rr              LDA   eval_cur_lo
001887r 2  85 rr              STA   ptr_lo
001889r 2  A5 rr              LDA   eval_cur_hi
00188Br 2  85 rr              STA   ptr_hi
00188Dr 2  A0 00              LDY   #TOK_TAG
00188Fr 2  B1 rr              LDA   (ptr_lo),Y
001891r 2               
001891r 2  C9 04              CMP   #TOK_RBRACKET
001893r 2  D0 03              BNE   :+
001895r 2  4C rr rr           JMP   @end_list
001898r 2               :
001898r 2  C9 02              CMP   #TOK_NUMBER
00189Ar 2  D0 03              BNE   :+
00189Cr 2  4C rr rr           JMP   @list_number
00189Fr 2  C9 01        :     CMP   #TOK_WORD
0018A1r 2  F0 10              BEQ   @list_word_jmp
0018A3r 2  C9 06              CMP   #TOK_QUOTE
0018A5r 2  F0 0C              BEQ   @list_word_jmp
0018A7r 2  C9 03              CMP   #TOK_LBRACKET
0018A9r 2  D0 03              BNE   :+
0018ABr 2  4C rr rr           JMP   @list_sublist
0018AEr 2               :     ; Unknown token type in list — skip it
0018AEr 2  20 rr rr           JSR   eval_advance
0018B1r 2  80 C9              BRA   @next_element
0018B3r 2               
0018B3r 2               @list_word_jmp:
0018B3r 2  4C rr rr           JMP   @list_word
0018B6r 2               
0018B6r 2               @list_number:
0018B6r 2  A0 03              LDY   #TOK_PAYLOAD
0018B8r 2  B1 rr              LDA   (ptr_lo),Y
0018BAr 2  85 rr              STA   eval_val_hi
0018BCr 2  C8                 INY
0018BDr 2  B1 rr              LDA   (ptr_lo),Y
0018BFr 2  85 rr              STA   eval_val_lo
0018C1r 2  C8                 INY
0018C2r 2  B1 rr              LDA   (ptr_lo),Y
0018C4r 2  85 rr              STA   eval_val_frac
0018C6r 2  A9 00              LDA   #VAL_NUMBER
0018C8r 2  85 rr              STA   eval_type
0018CAr 2  20 rr rr           JSR   eval_advance
0018CDr 2  4C rr rr           JMP   @alloc_cell
0018D0r 2               
0018D0r 2               @list_word:
0018D0r 2  A0 03              LDY   #TOK_PAYLOAD
0018D2r 2  B1 rr              LDA   (ptr_lo),Y
0018D4r 2  48                 PHA
0018D5r 2  1A                 INC
0018D6r 2  A2 05              LDX   #ATYPE_STRING
0018D8r 2  20 rr rr           JSR   heap_alloc
0018DBr 2  90 04              BCC   :+
0018DDr 2  68                 PLA
0018DEr 2  4C rr rr           JMP   @oom
0018E1r 2  A5 rr        :     LDA   eval_cur_lo
0018E3r 2  85 rr              STA   ptr2_lo
0018E5r 2  A5 rr              LDA   eval_cur_hi
0018E7r 2  85 rr              STA   ptr2_hi
0018E9r 2  68                 PLA
0018EAr 2  48                 PHA
0018EBr 2  A0 00              LDY   #0
0018EDr 2  91 rr              STA   (ptr_lo),Y
0018EFr 2  68                 PLA
0018F0r 2  AA                 TAX
0018F1r 2  F0 1B              BEQ   @word_done
0018F3r 2  A0 01              LDY   #1
0018F5r 2  9C rr rr           STZ   num_tmp_lo
0018F8r 2               @copy_word_ch:
0018F8r 2  DA                 PHX
0018F9r 2  5A                 PHY
0018FAr 2  AD rr rr           LDA   num_tmp_lo
0018FDr 2  18                 CLC
0018FEr 2  69 04              ADC   #TOK_PAYLOAD+1
001900r 2  A8                 TAY
001901r 2  B1 rr              LDA   (ptr2_lo),Y
001903r 2  7A                 PLY
001904r 2  91 rr              STA   (ptr_lo),Y
001906r 2  C8                 INY
001907r 2  EE rr rr           INC   num_tmp_lo
00190Ar 2  FA                 PLX
00190Br 2  CA                 DEX
00190Cr 2  D0 EA              BNE   @copy_word_ch
00190Er 2               @word_done:
00190Er 2  A5 rr              LDA   ptr_lo
001910r 2  85 rr              STA   eval_val_lo
001912r 2  A5 rr              LDA   ptr_hi
001914r 2  85 rr              STA   eval_val_hi
001916r 2  64 rr              STZ   eval_val_frac
001918r 2  A9 01              LDA   #VAL_WORD
00191Ar 2  85 rr              STA   eval_type
00191Cr 2  20 rr rr           JSR   eval_advance
00191Fr 2  4C rr rr           JMP   @alloc_cell
001922r 2               
001922r 2               @list_sublist:
001922r 2  20 rr rr           JSR   eval_advance
001925r 2  A5 rr              LDA   list_head_lo
001927r 2  48                 PHA
001928r 2  A5 rr              LDA   list_head_hi
00192Ar 2  48                 PHA
00192Br 2  A5 rr              LDA   list_tail_lo
00192Dr 2  48                 PHA
00192Er 2  A5 rr              LDA   list_tail_hi
001930r 2  48                 PHA
001931r 2  20 rr rr           JSR   eval_list
001934r 2  90 06              BCC   @sublist_ok
001936r 2                     ; Error — clean up stack
001936r 2  68                 PLA
001937r 2  68                 PLA
001938r 2  68                 PLA
001939r 2  68                 PLA
00193Ar 2  38                 SEC
00193Br 2  60                 RTS
00193Cr 2               @sublist_ok:
00193Cr 2  68                 PLA
00193Dr 2  85 rr              STA   list_tail_hi
00193Fr 2  68                 PLA
001940r 2  85 rr              STA   list_tail_lo
001942r 2  68                 PLA
001943r 2  85 rr              STA   list_head_hi
001945r 2  68                 PLA
001946r 2  85 rr              STA   list_head_lo
001948r 2                     ; eval_type already VAL_LIST, eval_val has sublist ptr
001948r 2                     ; fall through to @alloc_cell
001948r 2               
001948r 2               @alloc_cell:
001948r 2  A9 07              LDA   #CONS_SIZE
00194Ar 2  A2 02              LDX   #ATYPE_CONS
00194Cr 2  20 rr rr           JSR   heap_alloc
00194Fr 2  B0 71              BCS   @oom
001951r 2  A0 00              LDY   #CONS_TAG
001953r 2  A9 10              LDA   #CONS_PAIR
001955r 2  91 rr              STA   (ptr_lo),Y
001957r 2  A0 01              LDY   #CONS_CAR_TYPE
001959r 2  A5 rr              LDA   eval_type
00195Br 2  91 rr              STA   (ptr_lo),Y
00195Dr 2  A0 02              LDY   #CONS_CAR_HI
00195Fr 2  A5 rr              LDA   eval_val_hi
001961r 2  91 rr              STA   (ptr_lo),Y
001963r 2  A0 03              LDY   #CONS_CAR_LO
001965r 2  A5 rr              LDA   eval_val_lo
001967r 2  91 rr              STA   (ptr_lo),Y
001969r 2  A0 04              LDY   #CONS_CAR_FRAC
00196Br 2  A5 rr              LDA   eval_val_frac
00196Dr 2  91 rr              STA   (ptr_lo),Y
00196Fr 2  A0 05              LDY   #CONS_CDR_LO
001971r 2  A9 00              LDA   #0
001973r 2  91 rr              STA   (ptr_lo),Y
001975r 2  A0 06              LDY   #CONS_CDR_HI
001977r 2  91 rr              STA   (ptr_lo),Y
001979r 2               
001979r 2                     ; Link into list
001979r 2  A5 rr              LDA   list_head_lo
00197Br 2  05 rr              ORA   list_head_hi
00197Dr 2  D0 0F              BNE   @link_tail
00197Fr 2               
00197Fr 2  A5 rr              LDA   ptr_lo
001981r 2  85 rr              STA   list_head_lo
001983r 2  85 rr              STA   list_tail_lo
001985r 2  A5 rr              LDA   ptr_hi
001987r 2  85 rr              STA   list_head_hi
001989r 2  85 rr              STA   list_tail_hi
00198Br 2  4C rr rr           JMP   @next_element
00198Er 2               
00198Er 2               @link_tail:
00198Er 2  A5 rr              LDA   list_tail_lo
001990r 2  85 rr              STA   ptr2_lo
001992r 2  A5 rr              LDA   list_tail_hi
001994r 2  85 rr              STA   ptr2_hi
001996r 2  A0 05              LDY   #CONS_CDR_LO
001998r 2  A5 rr              LDA   ptr_lo
00199Ar 2  91 rr              STA   (ptr2_lo),Y
00199Cr 2  A0 06              LDY   #CONS_CDR_HI
00199Er 2  A5 rr              LDA   ptr_hi
0019A0r 2  91 rr              STA   (ptr2_lo),Y
0019A2r 2  A5 rr              LDA   ptr_lo
0019A4r 2  85 rr              STA   list_tail_lo
0019A6r 2  A5 rr              LDA   ptr_hi
0019A8r 2  85 rr              STA   list_tail_hi
0019AAr 2  4C rr rr           JMP   @next_element
0019ADr 2               
0019ADr 2               @end_list:
0019ADr 2  20 rr rr           JSR   eval_advance
0019B0r 2  A9 02              LDA   #VAL_LIST
0019B2r 2  85 rr              STA   eval_type
0019B4r 2  A5 rr              LDA   list_head_lo
0019B6r 2  85 rr              STA   eval_val_lo
0019B8r 2  A5 rr              LDA   list_head_hi
0019BAr 2  85 rr              STA   eval_val_hi
0019BCr 2  64 rr              STZ   eval_val_frac
0019BEr 2  18                 CLC
0019BFr 2  60                 RTS
0019C0r 2               
0019C0r 2               @err_no_bracket:
0019C0r 2  38                 SEC
0019C1r 2  60                 RTS
0019C2r 2               
0019C2r 2               @oom:
0019C2r 2  38                 SEC
0019C3r 2  60                 RTS
0019C4r 2               
0019C4r 2               ; ---------------------------------------------------------------------
0019C4r 2               ; print_list — print a list value to screen with brackets
0019C4r 2               ;   Entry: eval_val_lo/hi = head cons pair pointer (or $0000)
0019C4r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr
0019C4r 2               ; ---------------------------------------------------------------------
0019C4r 2               print_list:
0019C4r 2  A9 5B              LDA   #'['
0019C6r 2  8D 0E A0           STA   VGC_CHAROUT
0019C9r 2               
0019C9r 2  A5 rr              LDA   eval_val_lo
0019CBr 2  85 rr              STA   list_ptr_lo
0019CDr 2  A5 rr              LDA   eval_val_hi
0019CFr 2  85 rr              STA   list_ptr_hi
0019D1r 2               
0019D1r 2  A2 00              LDX   #0                  ; 0 = first element (no leading space)
0019D3r 2               
0019D3r 2               @pl_loop:
0019D3r 2  A5 rr              LDA   list_ptr_lo
0019D5r 2  05 rr              ORA   list_ptr_hi
0019D7r 2  D0 03              BNE   :+
0019D9r 2  4C rr rr           JMP   @pl_done
0019DCr 2               :
0019DCr 2  E0 00              CPX   #0
0019DEr 2  F0 05              BEQ   @pl_no_space
0019E0r 2  A9 20              LDA   #' '
0019E2r 2  8D 0E A0           STA   VGC_CHAROUT
0019E5r 2               @pl_no_space:
0019E5r 2  A2 01              LDX   #1
0019E7r 2               
0019E7r 2  A5 rr              LDA   list_ptr_lo
0019E9r 2  85 rr              STA   ptr_lo
0019EBr 2  A5 rr              LDA   list_ptr_hi
0019EDr 2  85 rr              STA   ptr_hi
0019EFr 2  A0 01              LDY   #CONS_CAR_TYPE
0019F1r 2  B1 rr              LDA   (ptr_lo),Y
0019F3r 2  C9 02              CMP   #VAL_LIST
0019F5r 2  F0 2C              BEQ   @pl_sublist
0019F7r 2  C9 01              CMP   #VAL_WORD
0019F9r 2  D0 03              BNE   :+
0019FBr 2  4C rr rr           JMP   @pl_word
0019FEr 2               :
0019FEr 2                     ; Number
0019FEr 2  DA                 PHX
0019FFr 2  A5 rr              LDA   list_ptr_lo
001A01r 2  48                 PHA
001A02r 2  A5 rr              LDA   list_ptr_hi
001A04r 2  48                 PHA
001A05r 2  A0 02              LDY   #CONS_CAR_HI
001A07r 2  B1 rr              LDA   (ptr_lo),Y
001A09r 2  85 rr              STA   eval_val_hi
001A0Br 2  A0 03              LDY   #CONS_CAR_LO
001A0Dr 2  B1 rr              LDA   (ptr_lo),Y
001A0Fr 2  85 rr              STA   eval_val_lo
001A11r 2  A0 04              LDY   #CONS_CAR_FRAC
001A13r 2  B1 rr              LDA   (ptr_lo),Y
001A15r 2  85 rr              STA   eval_val_frac
001A17r 2  20 rr rr           JSR   print_number
001A1Ar 2  68                 PLA
001A1Br 2  85 rr              STA   list_ptr_hi
001A1Dr 2  68                 PLA
001A1Er 2  85 rr              STA   list_ptr_lo
001A20r 2  FA                 PLX
001A21r 2  80 4A              BRA   @pl_advance
001A23r 2               
001A23r 2               @pl_sublist:
001A23r 2  DA                 PHX
001A24r 2  A5 rr              LDA   list_ptr_lo
001A26r 2  48                 PHA
001A27r 2  A5 rr              LDA   list_ptr_hi
