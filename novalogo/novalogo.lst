0020F8r 2  68                 PLA
0020F9r 2  68                 PLA
0020FAr 2               @err:
0020FAr 2  A2 rr              LDX   #<str_list_err
0020FCr 2  A0 rr              LDY   #>str_list_err
0020FEr 2  4C rr rr           JMP   list_print_err
002101r 2               
002101r 2               ; ---------------------------------------------------------------------
002101r 2               ; do_sentence — SENTENCE val1 val2: concatenate two values as flat list
002101r 2               ;   Non-list args are wrapped as single-element lists first.
002101r 2               ;   Arity 0: evaluates its own arguments
002101r 2               ; ---------------------------------------------------------------------
002101r 2               do_sentence:
002101r 2                     ; Evaluate first arg
002101r 2  20 rr rr           JSR   eval_expr
002104r 2  90 03              BCC   :+
002106r 2  4C rr rr           JMP   @err
002109r 2               :
002109r 2                     ; Save first value
002109r 2  A5 rr              LDA   eval_type
00210Br 2  48                 PHA
00210Cr 2  A5 rr              LDA   eval_val_hi
00210Er 2  48                 PHA
00210Fr 2  A5 rr              LDA   eval_val_lo
002111r 2  48                 PHA
002112r 2  A5 rr              LDA   eval_val_frac
002114r 2  48                 PHA
002115r 2               
002115r 2                     ; Evaluate second arg
002115r 2  20 rr rr           JSR   eval_expr
002118r 2  90 03              BCC   :+
00211Ar 2  4C rr rr           JMP   @err_pop4
00211Dr 2               :
00211Dr 2                     ; Save second value
00211Dr 2  A5 rr              LDA   eval_type
00211Fr 2  48                 PHA
002120r 2  A5 rr              LDA   eval_val_hi
002122r 2  48                 PHA
002123r 2  A5 rr              LDA   eval_val_lo
002125r 2  48                 PHA
002126r 2  A5 rr              LDA   eval_val_frac
002128r 2  48                 PHA
002129r 2               
002129r 2                     ; Process first arg: if not list, wrap in single-element list
002129r 2                     ; First value is at stack offset 4..7 (under second value)
002129r 2  BA                 TSX
00212Ar 2  BD 08 01           LDA   $0108,X                 ; first type
00212Dr 2  C9 02              CMP   #VAL_LIST
00212Fr 2  F0 4D              BEQ   @first_is_list
002131r 2               
002131r 2                     ; Wrap first value as single-element list
002131r 2  A9 07              LDA   #CONS_SIZE
002133r 2  A2 02              LDX   #ATYPE_CONS
002135r 2  20 rr rr           JSR   heap_alloc
002138r 2  90 03              BCC   :+
00213Ar 2  4C rr rr           JMP   @oom_pop8
00213Dr 2               :
00213Dr 2  A0 00              LDY   #CONS_TAG
00213Fr 2  A9 10              LDA   #CONS_PAIR
002141r 2  91 rr              STA   (ptr_lo),Y
002143r 2  BA                 TSX
002144r 2  BD 08 01           LDA   $0108,X                 ; first type
002147r 2  A0 01              LDY   #CONS_CAR_TYPE
002149r 2  91 rr              STA   (ptr_lo),Y
00214Br 2  BD 07 01           LDA   $0107,X                 ; first hi
00214Er 2  A0 02              LDY   #CONS_CAR_HI
002150r 2  91 rr              STA   (ptr_lo),Y
002152r 2  BD 06 01           LDA   $0106,X                 ; first lo
002155r 2  A0 03              LDY   #CONS_CAR_LO
002157r 2  91 rr              STA   (ptr_lo),Y
002159r 2  BD 05 01           LDA   $0105,X                 ; first frac
00215Cr 2  A0 04              LDY   #CONS_CAR_FRAC
00215Er 2  91 rr              STA   (ptr_lo),Y
002160r 2  A0 05              LDY   #CONS_CDR_LO
002162r 2  A9 00              LDA   #0
002164r 2  91 rr              STA   (ptr_lo),Y
002166r 2  A0 06              LDY   #CONS_CDR_HI
002168r 2  91 rr              STA   (ptr_lo),Y
00216Ar 2                     ; Update first value on stack to be VAL_LIST
00216Ar 2  A9 02              LDA   #VAL_LIST
00216Cr 2  9D 08 01           STA   $0108,X                 ; type = list
00216Fr 2  A5 rr              LDA   ptr_hi
002171r 2  9D 07 01           STA   $0107,X                 ; hi = ptr_hi
002174r 2  A5 rr              LDA   ptr_lo
002176r 2  9D 06 01           STA   $0106,X                 ; lo = ptr_lo
002179r 2  A9 00              LDA   #0
00217Br 2  9D 05 01           STA   $0105,X                 ; frac = 0
00217Er 2               
00217Er 2               @first_is_list:
00217Er 2                     ; Process second arg: if not list, wrap it
00217Er 2  BA                 TSX
00217Fr 2  BD 04 01           LDA   $0104,X                 ; second type
002182r 2  C9 02              CMP   #VAL_LIST
002184r 2  F0 4D              BEQ   @second_is_list
002186r 2               
002186r 2                     ; Wrap second value
002186r 2  A9 07              LDA   #CONS_SIZE
002188r 2  A2 02              LDX   #ATYPE_CONS
00218Ar 2  20 rr rr           JSR   heap_alloc
00218Dr 2  90 03              BCC   :+
00218Fr 2  4C rr rr           JMP   @oom_pop8
002192r 2               :
002192r 2  A0 00              LDY   #CONS_TAG
002194r 2  A9 10              LDA   #CONS_PAIR
002196r 2  91 rr              STA   (ptr_lo),Y
002198r 2  BA                 TSX
002199r 2  BD 04 01           LDA   $0104,X                 ; second type
00219Cr 2  A0 01              LDY   #CONS_CAR_TYPE
00219Er 2  91 rr              STA   (ptr_lo),Y
0021A0r 2  BD 03 01           LDA   $0103,X                 ; second hi
0021A3r 2  A0 02              LDY   #CONS_CAR_HI
0021A5r 2  91 rr              STA   (ptr_lo),Y
0021A7r 2  BD 02 01           LDA   $0102,X                 ; second lo
0021AAr 2  A0 03              LDY   #CONS_CAR_LO
0021ACr 2  91 rr              STA   (ptr_lo),Y
0021AEr 2  BD 01 01           LDA   $0101,X                 ; second frac
0021B1r 2  A0 04              LDY   #CONS_CAR_FRAC
0021B3r 2  91 rr              STA   (ptr_lo),Y
0021B5r 2  A0 05              LDY   #CONS_CDR_LO
0021B7r 2  A9 00              LDA   #0
0021B9r 2  91 rr              STA   (ptr_lo),Y
0021BBr 2  A0 06              LDY   #CONS_CDR_HI
0021BDr 2  91 rr              STA   (ptr_lo),Y
0021BFr 2                     ; Update second value on stack
0021BFr 2  A9 02              LDA   #VAL_LIST
0021C1r 2  9D 04 01           STA   $0104,X
0021C4r 2  A5 rr              LDA   ptr_hi
0021C6r 2  9D 03 01           STA   $0103,X
0021C9r 2  A5 rr              LDA   ptr_lo
0021CBr 2  9D 02 01           STA   $0102,X
0021CEr 2  A9 00              LDA   #0
0021D0r 2  9D 01 01           STA   $0101,X
0021D3r 2               
0021D3r 2               @second_is_list:
0021D3r 2                     ; Pop second list pointer
0021D3r 2  68                 PLA                           ; frac (unused)
0021D4r 2  68                 PLA                           ; lo
0021D5r 2  85 rr              STA   list_tail_lo
0021D7r 2  68                 PLA                           ; hi
0021D8r 2  85 rr              STA   list_tail_hi
0021DAr 2  68                 PLA                           ; type (unused, known VAL_LIST)
0021DBr 2               
0021DBr 2                     ; Pop first list pointer
0021DBr 2  68                 PLA                           ; frac (unused)
0021DCr 2  68                 PLA                           ; lo
0021DDr 2  85 rr              STA   list_head_lo
0021DFr 2  68                 PLA                           ; hi
0021E0r 2  85 rr              STA   list_head_hi
0021E2r 2  68                 PLA                           ; type (unused)
0021E3r 2               
0021E3r 2                     ; If first list is empty, return second
0021E3r 2  A5 rr              LDA   list_head_lo
0021E5r 2  05 rr              ORA   list_head_hi
0021E7r 2  F0 44              BEQ   @se_return_second
0021E9r 2               
0021E9r 2                     ; Walk to end of first list, patch cdr to second
0021E9r 2  A5 rr              LDA   list_head_lo
0021EBr 2  85 rr              STA   list_ptr_lo
0021EDr 2  A5 rr              LDA   list_head_hi
0021EFr 2  85 rr              STA   list_ptr_hi
0021F1r 2               @se_walk:
0021F1r 2  A5 rr              LDA   list_ptr_lo
0021F3r 2  85 rr              STA   ptr_lo
0021F5r 2  A5 rr              LDA   list_ptr_hi
0021F7r 2  85 rr              STA   ptr_hi
0021F9r 2  A0 05              LDY   #CONS_CDR_LO
0021FBr 2  B1 rr              LDA   (ptr_lo),Y
0021FDr 2  AA                 TAX
0021FEr 2  A0 06              LDY   #CONS_CDR_HI
002200r 2  B1 rr              LDA   (ptr_lo),Y
002202r 2  09 00              ORA   #0
002204r 2  D0 04              BNE   @se_next
002206r 2  E0 00              CPX   #0
002208r 2  F0 06              BEQ   @se_found_last
00220Ar 2               @se_next:
00220Ar 2  85 rr              STA   list_ptr_hi
00220Cr 2  86 rr              STX   list_ptr_lo
00220Er 2  80 E1              BRA   @se_walk
002210r 2               
002210r 2               @se_found_last:
002210r 2                     ; Patch last cell's cdr to second list
002210r 2  A0 05              LDY   #CONS_CDR_LO
002212r 2  A5 rr              LDA   list_tail_lo
002214r 2  91 rr              STA   (ptr_lo),Y
002216r 2  A0 06              LDY   #CONS_CDR_HI
002218r 2  A5 rr              LDA   list_tail_hi
00221Ar 2  91 rr              STA   (ptr_lo),Y
00221Cr 2               
00221Cr 2                     ; Return first list head
00221Cr 2  A9 02              LDA   #VAL_LIST
00221Er 2  85 rr              STA   eval_type
002220r 2  A5 rr              LDA   list_head_lo
002222r 2  85 rr              STA   eval_val_lo
002224r 2  A5 rr              LDA   list_head_hi
002226r 2  85 rr              STA   eval_val_hi
002228r 2  64 rr              STZ   eval_val_frac
00222Ar 2  4C rr rr           JMP   eval_continue
00222Dr 2               
00222Dr 2               @se_return_second:
00222Dr 2  A9 02              LDA   #VAL_LIST
00222Fr 2  85 rr              STA   eval_type
002231r 2  A5 rr              LDA   list_tail_lo
002233r 2  85 rr              STA   eval_val_lo
002235r 2  A5 rr              LDA   list_tail_hi
002237r 2  85 rr              STA   eval_val_hi
002239r 2  64 rr              STZ   eval_val_frac
00223Br 2  4C rr rr           JMP   eval_continue
00223Er 2               
00223Er 2               @oom_pop8:
00223Er 2  68                 PLA
00223Fr 2  68                 PLA
002240r 2  68                 PLA
002241r 2  68                 PLA
002242r 2               @err_pop4:
002242r 2  68                 PLA
002243r 2  68                 PLA
002244r 2  68                 PLA
002245r 2  68                 PLA
002246r 2               @err:
002246r 2  A2 rr              LDX   #<str_sentence_err
002248r 2  A0 rr              LDY   #>str_sentence_err
00224Ar 2  4C rr rr           JMP   list_print_err
00224Dr 2               
00224Dr 2               ; ---------------------------------------------------------------------
00224Dr 2               ; do_word — WORD val1 val2: concatenate two words into one
00224Dr 2               ;   Arity 0: evaluates its own arguments
00224Dr 2               ; ---------------------------------------------------------------------
00224Dr 2               do_word:
00224Dr 2                     ; Evaluate first arg (must be a word)
00224Dr 2  20 rr rr           JSR   eval_expr
002250r 2  90 03              BCC   :+
002252r 2  4C rr rr           JMP   @err
002255r 2               :
002255r 2  A5 rr              LDA   eval_type
002257r 2  C9 01              CMP   #VAL_WORD
002259r 2  F0 03              BEQ   :+
00225Br 2  4C rr rr           JMP   @err_type
00225Er 2               :
00225Er 2                     ; Save first word pointer
00225Er 2  A5 rr              LDA   eval_val_lo
002260r 2  48                 PHA
002261r 2  A5 rr              LDA   eval_val_hi
002263r 2  48                 PHA
002264r 2               
002264r 2                     ; Evaluate second arg (must be a word)
002264r 2  20 rr rr           JSR   eval_expr
002267r 2  90 05              BCC   :+
002269r 2  68                 PLA
00226Ar 2  68                 PLA
00226Br 2  4C rr rr           JMP   @err
00226Er 2               :
00226Er 2  A5 rr              LDA   eval_type
002270r 2  C9 01              CMP   #VAL_WORD
002272r 2  F0 03              BEQ   :+
002274r 2  4C rr rr           JMP   @err_type_pop2
002277r 2               :
002277r 2               
002277r 2                     ; eval_val = second word, stack has first word ptr
002277r 2                     ; Read lengths
002277r 2  A5 rr              LDA   eval_val_lo
002279r 2  85 rr              STA   ptr2_lo
00227Br 2  A5 rr              LDA   eval_val_hi
00227Dr 2  85 rr              STA   ptr2_hi
00227Fr 2  A0 00              LDY   #0
002281r 2  B1 rr              LDA   (ptr2_lo),Y            ; second word length
002283r 2  85 rr              STA   list_count_lo           ; save len2
002285r 2               
002285r 2                     ; Read first word length from stack
002285r 2  68                 PLA
002286r 2  85 rr              STA   list_head_hi            ; first word ptr hi
002288r 2  68                 PLA
002289r 2  85 rr              STA   list_head_lo            ; first word ptr lo
00228Br 2  A5 rr              LDA   list_head_lo
00228Dr 2  85 rr              STA   ptr_lo
00228Fr 2  A5 rr              LDA   list_head_hi
002291r 2  85 rr              STA   ptr_hi
002293r 2  A0 00              LDY   #0
002295r 2  B1 rr              LDA   (ptr_lo),Y             ; first word length
002297r 2  85 rr              STA   list_count_hi           ; save len1
002299r 2               
002299r 2                     ; Allocate new string: 1 (length byte) + len1 + len2
002299r 2  18                 CLC
00229Ar 2  65 rr              ADC   list_count_lo
00229Cr 2  1A                 INC                           ; +1 for length byte
00229Dr 2  A2 05              LDX   #ATYPE_STRING
00229Fr 2  20 rr rr           JSR   heap_alloc
0022A2r 2  B0 6F              BCS   @err_oom
0022A4r 2               
0022A4r 2                     ; Write combined length
0022A4r 2  A5 rr              LDA   list_count_hi
0022A6r 2  18                 CLC
0022A7r 2  65 rr              ADC   list_count_lo
0022A9r 2  A0 00              LDY   #0
0022ABr 2  91 rr              STA   (ptr_lo),Y
0022ADr 2               
0022ADr 2                     ; Copy first word's chars
0022ADr 2  A6 rr              LDX   list_count_hi           ; len1
0022AFr 2  F0 23              BEQ   @w_copy2
0022B1r 2  A5 rr              LDA   list_head_lo
0022B3r 2  85 rr              STA   ptr2_lo
0022B5r 2  A5 rr              LDA   list_head_hi
0022B7r 2  85 rr              STA   ptr2_hi
0022B9r 2  A0 01              LDY   #1                     ; dest offset in new string
0022BBr 2  9C rr rr           STZ   num_tmp_lo              ; source offset
0022BEr 2               @w_c1:
0022BEr 2  DA                 PHX
0022BFr 2  5A                 PHY
0022C0r 2  AD rr rr           LDA   num_tmp_lo
0022C3r 2  1A                 INC                           ; skip length byte in source
0022C4r 2  A8                 TAY
0022C5r 2  B1 rr              LDA   (ptr2_lo),Y            ; source char
0022C7r 2  7A                 PLY
0022C8r 2  91 rr              STA   (ptr_lo),Y             ; dest char
0022CAr 2  C8                 INY
0022CBr 2  EE rr rr           INC   num_tmp_lo
0022CEr 2  FA                 PLX
0022CFr 2  CA                 DEX
0022D0r 2  D0 EC              BNE   @w_c1
0022D2r 2               
0022D2r 2                     ; Y is already at the next dest offset
0022D2r 2  80 02              BRA   @w_copy2_start
0022D4r 2               
0022D4r 2               @w_copy2:
0022D4r 2  A0 01              LDY   #1                     ; start at offset 1 if len1 was 0
0022D6r 2               @w_copy2_start:
0022D6r 2                     ; Copy second word's chars
0022D6r 2  A6 rr              LDX   list_count_lo           ; len2
0022D8r 2  F0 1F              BEQ   @w_done
0022DAr 2  A5 rr              LDA   eval_val_lo
0022DCr 2  85 rr              STA   ptr2_lo
0022DEr 2  A5 rr              LDA   eval_val_hi
0022E0r 2  85 rr              STA   ptr2_hi
0022E2r 2  9C rr rr           STZ   num_tmp_lo
0022E5r 2               @w_c2:
0022E5r 2  DA                 PHX
0022E6r 2  5A                 PHY
0022E7r 2  AD rr rr           LDA   num_tmp_lo
0022EAr 2  1A                 INC
0022EBr 2  A8                 TAY
0022ECr 2  B1 rr              LDA   (ptr2_lo),Y
0022EEr 2  7A                 PLY
0022EFr 2  91 rr              STA   (ptr_lo),Y
0022F1r 2  C8                 INY
0022F2r 2  EE rr rr           INC   num_tmp_lo
0022F5r 2  FA                 PLX
0022F6r 2  CA                 DEX
0022F7r 2  D0 EC              BNE   @w_c2
0022F9r 2               
0022F9r 2               @w_done:
0022F9r 2                     ; Return the new word
0022F9r 2  A9 01              LDA   #VAL_WORD
0022FBr 2  85 rr              STA   eval_type
0022FDr 2  A5 rr              LDA   ptr_lo
0022FFr 2  85 rr              STA   eval_val_lo
002301r 2  A5 rr              LDA   ptr_hi
002303r 2  85 rr              STA   eval_val_hi
002305r 2  64 rr              STZ   eval_val_frac
002307r 2  4C rr rr           JMP   eval_continue
00230Ar 2               
00230Ar 2               @err_type_pop2:
00230Ar 2  68                 PLA
00230Br 2  68                 PLA
00230Cr 2               @err_type:
00230Cr 2  A2 rr              LDX   #<str_word_type
00230Er 2  A0 rr              LDY   #>str_word_type
002310r 2  4C rr rr           JMP   list_print_err
002313r 2               @err_oom:
002313r 2               @err:
002313r 2  A2 rr              LDX   #<str_word_err
002315r 2  A0 rr              LDY   #>str_word_err
002317r 2  4C rr rr           JMP   list_print_err
00231Ar 2               
00231Ar 2               ; ---------------------------------------------------------------------
00231Ar 2               ; do_run — RUN list: evaluate a list as Logo code
00231Ar 2               ;   Arity 0: evaluates its own argument
00231Ar 2               ;
00231Ar 2               ;   Strategy: convert list to text in input_buf, then save evaluator
00231Ar 2               ;   state, tokenize_line + eval_line, restore state.
00231Ar 2               ; ---------------------------------------------------------------------
00231Ar 2               do_run:
00231Ar 2  20 rr rr           JSR   eval_expr
00231Dr 2  90 03              BCC   :+
00231Fr 2  4C rr rr           JMP   @err
002322r 2               :
002322r 2  A5 rr              LDA   eval_type
002324r 2  C9 02              CMP   #VAL_LIST
002326r 2  D0 43              BNE   @err_type
002328r 2               
002328r 2                     ; Save eval_cur on stack (we'll resume here after RUN)
002328r 2  A5 rr              LDA   eval_cur_lo
00232Ar 2  48                 PHA
00232Br 2  A5 rr              LDA   eval_cur_hi
00232Dr 2  48                 PHA
00232Er 2               
00232Er 2                     ; Render the list into input_buf as text
00232Er 2                     ; eval_val_lo/hi = list head
00232Er 2  64 rr              STZ   z:buf_idx               ; reset write position
002330r 2  20 rr rr           JSR   render_list_to_buf
002333r 2               
002333r 2                     ; Null-terminate input_buf
002333r 2  A6 rr              LDX   z:buf_idx
002335r 2  9E rr rr           STZ   input_buf,X
002338r 2               
002338r 2                     ; Save tokenizer and eval state (same pattern as proc_invoke)
002338r 2  A5 rr              LDA   tok_head_lo
00233Ar 2  48                 PHA
00233Br 2  A5 rr              LDA   tok_head_hi
00233Dr 2  48                 PHA
00233Er 2  A5 rr              LDA   tok_tail_lo
002340r 2  48                 PHA
002341r 2  A5 rr              LDA   tok_tail_hi
002343r 2  48                 PHA
002344r 2  A5 rr              LDA   eval_in_body
002346r 2  48                 PHA
002347r 2  A5 rr              LDA   eval_reporter
002349r 2  48                 PHA
00234Ar 2               
00234Ar 2                     ; Tokenize the reconstructed line
00234Ar 2  20 rr rr           JSR   tokenize_line
00234Dr 2               
00234Dr 2                     ; Evaluate it
00234Dr 2  20 rr rr           JSR   eval_line
002350r 2               
002350r 2                     ; Restore tokenizer/eval state
002350r 2  68                 PLA
002351r 2  85 rr              STA   eval_reporter
002353r 2  68                 PLA
002354r 2  85 rr              STA   eval_in_body
002356r 2  68                 PLA
002357r 2  85 rr              STA   tok_tail_hi
002359r 2  68                 PLA
00235Ar 2  85 rr              STA   tok_tail_lo
00235Cr 2  68                 PLA
00235Dr 2  85 rr              STA   tok_head_hi
00235Fr 2  68                 PLA
002360r 2  85 rr              STA   tok_head_lo
002362r 2               
002362r 2                     ; Restore eval_cur
002362r 2  68                 PLA
002363r 2  85 rr              STA   eval_cur_hi
002365r 2  68                 PLA
002366r 2  85 rr              STA   eval_cur_lo
002368r 2               
002368r 2  4C rr rr           JMP   eval_continue
00236Br 2               
00236Br 2               @err_type:
00236Br 2  A2 rr              LDX   #<str_run_type
00236Dr 2  A0 rr              LDY   #>str_run_type
00236Fr 2  4C rr rr           JMP   list_print_err
002372r 2               @err:
002372r 2  A2 rr              LDX   #<str_run_err
002374r 2  A0 rr              LDY   #>str_run_err
002376r 2  4C rr rr           JMP   list_print_err
002379r 2               
002379r 2               ; ---------------------------------------------------------------------
002379r 2               ; render_list_to_buf — render list elements into input_buf as text
002379r 2               ;   Entry: eval_val_lo/hi = list head pointer
002379r 2               ;          buf_idx = current write position in input_buf
002379r 2               ;   Exit:  buf_idx updated
002379r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr, list_count
002379r 2               ; ---------------------------------------------------------------------
002379r 2               render_list_to_buf:
002379r 2  A5 rr              LDA   eval_val_lo
00237Br 2  85 rr              STA   list_ptr_lo
00237Dr 2  A5 rr              LDA   eval_val_hi
00237Fr 2  85 rr              STA   list_ptr_hi
002381r 2  A2 00              LDX   #0                     ; 0 = first element (no leading space)
002383r 2               
002383r 2               @rl_loop:
002383r 2  A5 rr              LDA   list_ptr_lo
002385r 2  05 rr              ORA   list_ptr_hi
002387r 2  D0 01              BNE   :+
002389r 2  60                 RTS                           ; end of list
00238Ar 2               :
00238Ar 2                     ; Add space before non-first elements
00238Ar 2  E0 00              CPX   #0
00238Cr 2  F0 0F              BEQ   @rl_no_space
00238Er 2  A5 rr              LDA   z:buf_idx
002390r 2  C9 7E              CMP   #126
002392r 2  90 01              BCC   :+
002394r 2  60                 RTS                           ; buffer full — truncate
002395r 2               :
002395r 2  A8                 TAY
002396r 2  A9 20              LDA   #' '
002398r 2  99 rr rr           STA   input_buf,Y
00239Br 2  E6 rr              INC   z:buf_idx
00239Dr 2               @rl_no_space:
00239Dr 2  A2 01              LDX   #1                     ; subsequent elements get space
00239Fr 2               
00239Fr 2                     ; Read car type
00239Fr 2  A5 rr              LDA   list_ptr_lo
0023A1r 2  85 rr              STA   ptr_lo
0023A3r 2  A5 rr              LDA   list_ptr_hi
0023A5r 2  85 rr              STA   ptr_hi
0023A7r 2  A0 01              LDY   #CONS_CAR_TYPE
0023A9r 2  B1 rr              LDA   (ptr_lo),Y
