001410r 2               @wait:
001410r 2  AD 0F A0           LDA   VGC_CHARIN
001413r 2  F0 FB              BEQ   @wait
001415r 2                     ; A = character — fall through to alloc_one_char_word
001415r 2               
001415r 2               ; ---------------------------------------------------------------------
001415r 2               ; alloc_one_char_word — allocate a 1-char word on heap from A
001415r 2               ;   Input: A = character byte
001415r 2               ;   Output: eval_type=VAL_WORD, eval_val=pointer to len+char
001415r 2               ;   Jumps to eval_continue
001415r 2               ; ---------------------------------------------------------------------
001415r 2               alloc_one_char_word:
001415r 2  48                 PHA                       ; save character
001416r 2  A9 02              LDA   #2                  ; 1 byte length + 1 byte char
001418r 2  A2 05              LDX   #ATYPE_STRING
00141Ar 2  20 rr rr           JSR   heap_alloc
00141Dr 2  68                 PLA
00141Er 2  B0 1B              BCS   @oom
001420r 2  A0 01              LDY   #1
001422r 2  91 rr              STA   (ptr_lo),Y          ; store char
001424r 2  A9 01              LDA   #1
001426r 2  A0 00              LDY   #0
001428r 2  91 rr              STA   (ptr_lo),Y          ; store length = 1
00142Ar 2  A5 rr              LDA   ptr_lo
00142Cr 2  85 rr              STA   eval_val_lo
00142Er 2  A5 rr              LDA   ptr_hi
001430r 2  85 rr              STA   eval_val_hi
001432r 2  A9 01              LDA   #VAL_WORD
001434r 2  85 rr              STA   eval_type
001436r 2  64 rr              STZ   eval_val_frac
001438r 2  4C rr rr           JMP   eval_continue
00143Br 2               @oom:
00143Br 2  A2 rr              LDX   #<str_oom
00143Dr 2  A0 rr              LDY   #>str_oom
00143Fr 2  4C rr rr           JMP   list_print_err
001442r 2               
001442r 2               ; ---------------------------------------------------------------------
001442r 2               ; do_readword — READWORD: read chars until space/CR, return as word
001442r 2               ;   Arity 0, no arguments. Reporter.
001442r 2               ;   Uses input_buf as scratch (safe — main input already consumed).
001442r 2               ; ---------------------------------------------------------------------
001442r 2               do_readword:
001442r 2  64 rr              STZ   z:buf_idx
001444r 2               @rw_poll:
001444r 2  AD 0F A0           LDA   VGC_CHARIN
001447r 2  F0 FB              BEQ   @rw_poll
001449r 2                     ; Check for CR
001449r 2  C9 0D              CMP   #$0D
00144Br 2  F0 2E              BEQ   @rw_done
00144Dr 2                     ; Check for space
00144Dr 2  C9 20              CMP   #' '
00144Fr 2  F0 2A              BEQ   @rw_done
001451r 2                     ; Check for backspace
001451r 2  C9 08              CMP   #$08
001453r 2  F0 18              BEQ   @rw_bs
001455r 2  C9 14              CMP   #$14
001457r 2  F0 14              BEQ   @rw_bs
001459r 2  C9 7F              CMP   #$7F
00145Br 2  F0 10              BEQ   @rw_bs
00145Dr 2                     ; Store and echo
00145Dr 2  A6 rr              LDX   z:buf_idx
00145Fr 2  E0 7E              CPX   #126
001461r 2  B0 E1              BCS   @rw_poll             ; buffer full
001463r 2  9D rr rr           STA   input_buf,X
001466r 2  8D 0E A0           STA   VGC_CHAROUT
001469r 2  E6 rr              INC   z:buf_idx
00146Br 2  80 D7              BRA   @rw_poll
00146Dr 2               
00146Dr 2               @rw_bs:
00146Dr 2  A6 rr              LDX   z:buf_idx
00146Fr 2  F0 D3              BEQ   @rw_poll
001471r 2  CA                 DEX
001472r 2  86 rr              STX   z:buf_idx
001474r 2  A9 08              LDA   #$08
001476r 2  8D 0E A0           STA   VGC_CHAROUT
001479r 2  80 C9              BRA   @rw_poll
00147Br 2               
00147Br 2               @rw_done:
00147Br 2                     ; Echo CR/LF
00147Br 2  48                 PHA
00147Cr 2  A9 0D              LDA   #$0D
00147Er 2  8D 0E A0           STA   VGC_CHAROUT
001481r 2  A9 0A              LDA   #$0A
001483r 2  8D 0E A0           STA   VGC_CHAROUT
001486r 2  68                 PLA
001487r 2                     ; Allocate word: 1 (len) + buf_idx (chars)
001487r 2  A5 rr              LDA   z:buf_idx
001489r 2  1A                 INC                        ; +1 for length byte
00148Ar 2  A2 05              LDX   #ATYPE_STRING
00148Cr 2  20 rr rr           JSR   heap_alloc
00148Fr 2  B0 30              BCS   @rw_oom
001491r 2                     ; Write length
001491r 2  A5 rr              LDA   z:buf_idx
001493r 2  A0 00              LDY   #0
001495r 2  91 rr              STA   (ptr_lo),Y
001497r 2                     ; Copy chars
001497r 2  AA                 TAX
001498r 2  F0 16              BEQ   @rw_set
00149Ar 2  A0 01              LDY   #1
00149Cr 2  9C rr rr           STZ   num_tmp_lo
00149Fr 2               @rw_copy:
00149Fr 2  5A                 PHY
0014A0r 2  AC rr rr           LDY   num_tmp_lo
0014A3r 2  B9 rr rr           LDA   input_buf,Y
0014A6r 2  7A                 PLY
0014A7r 2  91 rr              STA   (ptr_lo),Y
0014A9r 2  C8                 INY
0014AAr 2  EE rr rr           INC   num_tmp_lo
0014ADr 2  CA                 DEX
0014AEr 2  D0 EF              BNE   @rw_copy
0014B0r 2               @rw_set:
0014B0r 2  A5 rr              LDA   ptr_lo
0014B2r 2  85 rr              STA   eval_val_lo
0014B4r 2  A5 rr              LDA   ptr_hi
0014B6r 2  85 rr              STA   eval_val_hi
0014B8r 2  A9 01              LDA   #VAL_WORD
0014BAr 2  85 rr              STA   eval_type
0014BCr 2  64 rr              STZ   eval_val_frac
0014BEr 2  4C rr rr           JMP   eval_continue
0014C1r 2               @rw_oom:
0014C1r 2  A2 rr              LDX   #<str_oom
0014C3r 2  A0 rr              LDY   #>str_oom
0014C5r 2  4C rr rr           JMP   list_print_err
0014C8r 2               
0014C8r 2               ; ---------------------------------------------------------------------
0014C8r 2               ; do_readlist — READLIST: read a line, return as a list
0014C8r 2               ;   Arity 0, no arguments. Reporter.
0014C8r 2               ;   Calls read_line, tokenize_line, then walks tokens building a list.
0014C8r 2               ; ---------------------------------------------------------------------
0014C8r 2               do_readlist:
0014C8r 2                     ; Save tokenizer state (we'll overwrite tok_head/tok_tail)
0014C8r 2  A5 rr              LDA   tok_head_lo
0014CAr 2  48                 PHA
0014CBr 2  A5 rr              LDA   tok_head_hi
0014CDr 2  48                 PHA
0014CEr 2  A5 rr              LDA   tok_tail_lo
0014D0r 2  48                 PHA
0014D1r 2  A5 rr              LDA   tok_tail_hi
0014D3r 2  48                 PHA
0014D4r 2  A5 rr              LDA   eval_cur_lo
0014D6r 2  48                 PHA
0014D7r 2  A5 rr              LDA   eval_cur_hi
0014D9r 2  48                 PHA
0014DAr 2               
0014DAr 2                     ; Read a line from keyboard into input_buf
0014DAr 2  20 rr rr           JSR   read_line
0014DDr 2                     ; Tokenize it
0014DDr 2  20 rr rr           JSR   tokenize_line
0014E0r 2               
0014E0r 2                     ; Walk tokens and build a list
0014E0r 2  64 rr              STZ   z:list_head_lo
0014E2r 2  64 rr              STZ   z:list_head_hi
0014E4r 2  64 rr              STZ   z:list_tail_lo
0014E6r 2  64 rr              STZ   z:list_tail_hi
0014E8r 2               
0014E8r 2  A5 rr              LDA   tok_head_lo
0014EAr 2  85 rr              STA   eval_cur_lo
0014ECr 2  A5 rr              LDA   tok_head_hi
0014EEr 2  85 rr              STA   eval_cur_hi
0014F0r 2               
0014F0r 2               @rl_next:
0014F0r 2  A5 rr              LDA   eval_cur_lo
0014F2r 2  05 rr              ORA   eval_cur_hi
0014F4r 2  D0 03              BNE   @rl_have_tok
0014F6r 2  4C rr rr           JMP   @rl_build_done
0014F9r 2               @rl_have_tok:
0014F9r 2               
0014F9r 2  A5 rr              LDA   eval_cur_lo
0014FBr 2  85 rr              STA   ptr_lo
0014FDr 2  A5 rr              LDA   eval_cur_hi
0014FFr 2  85 rr              STA   ptr_hi
001501r 2  A0 00              LDY   #TOK_TAG
001503r 2  B1 rr              LDA   (ptr_lo),Y
001505r 2               
001505r 2  C9 02              CMP   #TOK_NUMBER
001507r 2  D0 03              BNE   :+
001509r 2  4C rr rr           JMP   @rl_number
00150Cr 2  C9 01        :     CMP   #TOK_WORD
00150Er 2  F0 10              BEQ   @rl_word_jmp
001510r 2  C9 06              CMP   #TOK_QUOTE
001512r 2  F0 0C              BEQ   @rl_word_jmp
001514r 2  C9 03              CMP   #TOK_LBRACKET
001516r 2  D0 03              BNE   :+
001518r 2  4C rr rr           JMP   @rl_sublist
00151Br 2               :     ; Skip other tokens (brackets, infix, etc.)
00151Br 2  20 rr rr           JSR   eval_advance
00151Er 2  80 D0              BRA   @rl_next
001520r 2               
001520r 2               @rl_word_jmp:
001520r 2  4C rr rr           JMP   @rl_word
001523r 2               
001523r 2               @rl_number:
001523r 2  A0 03              LDY   #TOK_PAYLOAD
001525r 2  B1 rr              LDA   (ptr_lo),Y
001527r 2  85 rr              STA   eval_val_hi
001529r 2  C8                 INY
00152Ar 2  B1 rr              LDA   (ptr_lo),Y
00152Cr 2  85 rr              STA   eval_val_lo
00152Er 2  C8                 INY
00152Fr 2  B1 rr              LDA   (ptr_lo),Y
001531r 2  85 rr              STA   eval_val_frac
001533r 2  A9 00              LDA   #VAL_NUMBER
001535r 2  85 rr              STA   eval_type
001537r 2  20 rr rr           JSR   eval_advance
00153Ar 2  4C rr rr           JMP   @rl_alloc_cell
00153Dr 2               
00153Dr 2               @rl_word:
00153Dr 2                     ; Allocate string on heap and copy word from token payload
00153Dr 2  A0 03              LDY   #TOK_PAYLOAD
00153Fr 2  B1 rr              LDA   (ptr_lo),Y           ; length
001541r 2  48                 PHA
001542r 2  1A                 INC                        ; +1 for length byte
001543r 2  A2 05              LDX   #ATYPE_STRING
001545r 2  20 rr rr           JSR   heap_alloc
001548r 2  90 04              BCC   :+
00154Ar 2  68                 PLA
00154Br 2  4C rr rr           JMP   @rl_oom
00154Er 2               :     ; Re-read source token (ptr_lo clobbered by heap_alloc)
00154Er 2  A5 rr              LDA   eval_cur_lo
001550r 2  85 rr              STA   ptr2_lo
001552r 2  A5 rr              LDA   eval_cur_hi
001554r 2  85 rr              STA   ptr2_hi
001556r 2  68                 PLA
001557r 2  48                 PHA
001558r 2  A0 00              LDY   #0
00155Ar 2  91 rr              STA   (ptr_lo),Y           ; store length
00155Cr 2  68                 PLA
00155Dr 2  AA                 TAX
00155Er 2  F0 1B              BEQ   @rl_word_done
001560r 2  A0 01              LDY   #1
001562r 2  9C rr rr           STZ   num_tmp_lo
001565r 2               @rl_wch:
001565r 2  DA                 PHX
001566r 2  5A                 PHY
001567r 2  AD rr rr           LDA   num_tmp_lo
00156Ar 2  18                 CLC
00156Br 2  69 04              ADC   #TOK_PAYLOAD+1
00156Dr 2  A8                 TAY
00156Er 2  B1 rr              LDA   (ptr2_lo),Y
001570r 2  7A                 PLY
001571r 2  91 rr              STA   (ptr_lo),Y
001573r 2  C8                 INY
001574r 2  EE rr rr           INC   num_tmp_lo
001577r 2  FA                 PLX
001578r 2  CA                 DEX
001579r 2  D0 EA              BNE   @rl_wch
00157Br 2               @rl_word_done:
00157Br 2  A5 rr              LDA   ptr_lo
00157Dr 2  85 rr              STA   eval_val_lo
00157Fr 2  A5 rr              LDA   ptr_hi
001581r 2  85 rr              STA   eval_val_hi
001583r 2  64 rr              STZ   eval_val_frac
001585r 2  A9 01              LDA   #VAL_WORD
001587r 2  85 rr              STA   eval_type
001589r 2  20 rr rr           JSR   eval_advance
00158Cr 2  4C rr rr           JMP   @rl_alloc_cell
00158Fr 2               
00158Fr 2               @rl_sublist:
00158Fr 2                     ; Use eval_list to build the sublist (advances past matching ])
00158Fr 2  20 rr rr           JSR   eval_advance
001592r 2  A5 rr              LDA   z:list_head_lo
001594r 2  48                 PHA
001595r 2  A5 rr              LDA   z:list_head_hi
001597r 2  48                 PHA
001598r 2  A5 rr              LDA   z:list_tail_lo
00159Ar 2  48                 PHA
00159Br 2  A5 rr              LDA   z:list_tail_hi
00159Dr 2  48                 PHA
00159Er 2  20 rr rr           JSR   eval_list
0015A1r 2  68                 PLA
0015A2r 2  85 rr              STA   z:list_tail_hi
0015A4r 2  68                 PLA
0015A5r 2  85 rr              STA   z:list_tail_lo
0015A7r 2  68                 PLA
0015A8r 2  85 rr              STA   z:list_head_hi
0015AAr 2  68                 PLA
0015ABr 2  85 rr              STA   z:list_head_lo
0015ADr 2                     ; eval_type = VAL_LIST, eval_val = sublist head
0015ADr 2  4C rr rr           JMP   @rl_alloc_cell
0015B0r 2               
0015B0r 2               @rl_alloc_cell:
0015B0r 2  A9 07              LDA   #CONS_SIZE
0015B2r 2  A2 02              LDX   #ATYPE_CONS
0015B4r 2  20 rr rr           JSR   heap_alloc
0015B7r 2  90 03              BCC   @rl_alloc_ok
0015B9r 2  4C rr rr           JMP   @rl_oom
0015BCr 2               @rl_alloc_ok:
0015BCr 2  A0 00              LDY   #CONS_TAG
0015BEr 2  A9 10              LDA   #CONS_PAIR
0015C0r 2  91 rr              STA   (ptr_lo),Y
0015C2r 2  A0 01              LDY   #CONS_CAR_TYPE
0015C4r 2  A5 rr              LDA   eval_type
0015C6r 2  91 rr              STA   (ptr_lo),Y
0015C8r 2  A0 02              LDY   #CONS_CAR_HI
0015CAr 2  A5 rr              LDA   eval_val_hi
0015CCr 2  91 rr              STA   (ptr_lo),Y
0015CEr 2  A0 03              LDY   #CONS_CAR_LO
0015D0r 2  A5 rr              LDA   eval_val_lo
0015D2r 2  91 rr              STA   (ptr_lo),Y
0015D4r 2  A0 04              LDY   #CONS_CAR_FRAC
0015D6r 2  A5 rr              LDA   eval_val_frac
0015D8r 2  91 rr              STA   (ptr_lo),Y
0015DAr 2  A0 05              LDY   #CONS_CDR_LO
0015DCr 2  A9 00              LDA   #0
0015DEr 2  91 rr              STA   (ptr_lo),Y
0015E0r 2  A0 06              LDY   #CONS_CDR_HI
0015E2r 2  91 rr              STA   (ptr_lo),Y
0015E4r 2               
0015E4r 2                     ; Link into list
0015E4r 2  A5 rr              LDA   z:list_head_lo
0015E6r 2  05 rr              ORA   z:list_head_hi
0015E8r 2  D0 0F              BNE   @rl_link_tail
0015EAr 2  A5 rr              LDA   ptr_lo
0015ECr 2  85 rr              STA   z:list_head_lo
0015EEr 2  85 rr              STA   z:list_tail_lo
0015F0r 2  A5 rr              LDA   ptr_hi
0015F2r 2  85 rr              STA   z:list_head_hi
0015F4r 2  85 rr              STA   z:list_tail_hi
0015F6r 2  4C rr rr           JMP   @rl_next
0015F9r 2               
0015F9r 2               @rl_link_tail:
0015F9r 2  A5 rr              LDA   z:list_tail_lo
0015FBr 2  85 rr              STA   ptr2_lo
0015FDr 2  A5 rr              LDA   z:list_tail_hi
0015FFr 2  85 rr              STA   ptr2_hi
001601r 2  A0 05              LDY   #CONS_CDR_LO
001603r 2  A5 rr              LDA   ptr_lo
001605r 2  91 rr              STA   (ptr2_lo),Y
001607r 2  A0 06              LDY   #CONS_CDR_HI
001609r 2  A5 rr              LDA   ptr_hi
00160Br 2  91 rr              STA   (ptr2_lo),Y
00160Dr 2  A5 rr              LDA   ptr_lo
00160Fr 2  85 rr              STA   z:list_tail_lo
001611r 2  A5 rr              LDA   ptr_hi
001613r 2  85 rr              STA   z:list_tail_hi
001615r 2  4C rr rr           JMP   @rl_next
001618r 2               
001618r 2               @rl_build_done:
001618r 2                     ; Restore tokenizer state
001618r 2  68                 PLA
001619r 2  85 rr              STA   eval_cur_hi
00161Br 2  68                 PLA
00161Cr 2  85 rr              STA   eval_cur_lo
00161Er 2  68                 PLA
00161Fr 2  85 rr              STA   tok_tail_hi
001621r 2  68                 PLA
001622r 2  85 rr              STA   tok_tail_lo
001624r 2  68                 PLA
001625r 2  85 rr              STA   tok_head_hi
001627r 2  68                 PLA
001628r 2  85 rr              STA   tok_head_lo
00162Ar 2               
00162Ar 2                     ; Return the list
00162Ar 2  A9 02              LDA   #VAL_LIST
00162Cr 2  85 rr              STA   eval_type
00162Er 2  A5 rr              LDA   z:list_head_lo
001630r 2  85 rr              STA   eval_val_lo
001632r 2  A5 rr              LDA   z:list_head_hi
001634r 2  85 rr              STA   eval_val_hi
001636r 2  64 rr              STZ   eval_val_frac
001638r 2  4C rr rr           JMP   eval_continue
00163Br 2               
00163Br 2               @rl_oom:
00163Br 2                     ; Restore tokenizer state before error
00163Br 2  68                 PLA
00163Cr 2  85 rr              STA   eval_cur_hi
00163Er 2  68                 PLA
00163Fr 2  85 rr              STA   eval_cur_lo
001641r 2  68                 PLA
001642r 2  85 rr              STA   tok_tail_hi
001644r 2  68                 PLA
001645r 2  85 rr              STA   tok_tail_lo
001647r 2  68                 PLA
001648r 2  85 rr              STA   tok_head_hi
00164Ar 2  68                 PLA
00164Br 2  85 rr              STA   tok_head_lo
00164Dr 2  A2 rr              LDX   #<str_oom
00164Fr 2  A0 rr              LDY   #>str_oom
001651r 2  4C rr rr           JMP   list_print_err
001654r 2               
001654r 2               ; ---------------------------------------------------------------------
001654r 2               ; do_char — CHAR n: convert ASCII code to 1-char word
001654r 2               ;   Arity 0: evaluates its own argument
001654r 2               ; ---------------------------------------------------------------------
001654r 2               do_char:
001654r 2  20 rr rr           JSR   eval_expr
001657r 2  B0 09              BCS   @err
001659r 2                     ; Must be a number
001659r 2  A5 rr              LDA   eval_type
00165Br 2  D0 05              BNE   @err
00165Dr 2                     ; Low byte of number is the ASCII code
00165Dr 2  A5 rr              LDA   eval_val_lo
00165Fr 2  4C rr rr           JMP   alloc_one_char_word
001662r 2               @err:
001662r 2  A2 rr              LDX   #<str_char_name
001664r 2  A0 rr              LDY   #>str_char_name
001666r 2  4C rr rr           JMP   err_nei
001669r 2               
001669r 2               ; ---------------------------------------------------------------------
001669r 2               ; do_ascii — ASCII word: return ASCII code of first character
001669r 2               ;   Arity 0: evaluates its own argument
001669r 2               ; ---------------------------------------------------------------------
001669r 2               do_ascii:
001669r 2  20 rr rr           JSR   eval_expr
00166Cr 2  B0 23              BCS   @err
00166Er 2                     ; Must be a word
00166Er 2  A5 rr              LDA   eval_type
001670r 2  C9 01              CMP   #VAL_WORD
001672r 2  D0 1D              BNE   @err_type
001674r 2                     ; eval_val_lo/hi points at length-prefixed string
001674r 2  A5 rr              LDA   eval_val_lo
001676r 2  85 rr              STA   ptr_lo
001678r 2  A5 rr              LDA   eval_val_hi
00167Ar 2  85 rr              STA   ptr_hi
00167Cr 2  A0 00              LDY   #0
00167Er 2  B1 rr              LDA   (ptr_lo),Y           ; length
001680r 2  F0 0F              BEQ   @err_empty            ; empty word
001682r 2  A0 01              LDY   #1
001684r 2  B1 rr              LDA   (ptr_lo),Y           ; first character
001686r 2  85 rr              STA   eval_val_lo
001688r 2  64 rr              STZ   eval_val_hi
00168Ar 2  64 rr              STZ   eval_val_frac
00168Cr 2  64 rr              STZ   eval_type             ; VAL_NUMBER
00168Er 2  4C rr rr           JMP   eval_continue
001691r 2               @err_type:
001691r 2               @err_empty:
001691r 2               @err:
001691r 2  A2 rr              LDX   #<str_ascii_name
001693r 2  A0 rr              LDY   #>str_ascii_name
001695r 2  4C rr rr           JMP   err_nei
001698r 2               
001698r 2               ; =====================================================================
001698r 2               ; Math functions and type predicates
001698r 2               ; =====================================================================
001698r 2               
001698r 2               ; ---------------------------------------------------------------------
001698r 2               ; return_number — set eval_val from eval_val_lo/hi, clear frac+type
001698r 2               ;   Entry: eval_val_lo/hi already set
001698r 2               ;   Jumps to eval_continue
001698r 2               ; ---------------------------------------------------------------------
001698r 2               return_number:
001698r 2  64 rr              STZ   eval_val_frac
00169Ar 2  64 rr              STZ   eval_type
00169Cr 2  4C rr rr           JMP   eval_continue
00169Fr 2               
00169Fr 2               ; ---------------------------------------------------------------------
00169Fr 2               ; return_signed_byte — sign-extend A into eval_val as 16.8 number
00169Fr 2               ;   Entry: A = signed byte (-128..+127)
00169Fr 2               ;   Jumps to eval_continue
00169Fr 2               ; ---------------------------------------------------------------------
00169Fr 2               return_signed_byte:
00169Fr 2  85 rr              STA   eval_val_lo
0016A1r 2  10 04              BPL   @pos
0016A3r 2  A9 FF              LDA   #$FF
0016A5r 2  80 02              BRA   @set
0016A7r 2  A9 00        @pos: LDA   #$00
0016A9r 2  85 rr        @set: STA   eval_val_hi
0016ABr 2  80 EB              BRA   return_number
0016ADr 2               
0016ADr 2               ; ---------------------------------------------------------------------
0016ADr 2               ; predicate_result — set eval_val to 1 (Z set) or 0 (Z clear)
0016ADr 2               ;   Entry: Z flag from CMP
0016ADr 2               ;   Jumps to eval_continue
0016ADr 2               ; ---------------------------------------------------------------------
0016ADr 2               predicate_result:
0016ADr 2  F0 04              BEQ   @true
0016AFr 2  64 rr              STZ   eval_val_lo
0016B1r 2  80 04              BRA   @done
0016B3r 2               @true:
0016B3r 2  A9 01              LDA   #1
0016B5r 2  85 rr              STA   eval_val_lo
0016B7r 2               @done:
0016B7r 2  64 rr              STZ   eval_val_hi
0016B9r 2  80 DD              BRA   return_number
0016BBr 2               
0016BBr 2               ; ---------------------------------------------------------------------
0016BBr 2               ; degrees_to_u8 — convert eval_val (degrees 0-360) to u8 angle (0-255)
0016BBr 2               ;   Uses MUL16 coprocessor: angle = degrees * 91 / 128
0016BBr 2               ;   Actually: write degrees to MUL16 A, 91 to B, read RES1 (high byte)
0016BBr 2               ;   Then shift right once (divide by 2) since 91/256=0.355, we want 91/128
0016BBr 2               ;   Wait, let me recalculate: degrees * 91 >> 7
0016BBr 2               ;   MUL16 gives degrees*91 in RES1:RES0. We want bits [14:7] of that.
0016BBr 2               ;   RES1 is bits [15:8]. But we want >>7 which is RES1<<1 | RES0>>7.
0016BBr 2               ;   Simpler: degrees * 182 / 256 = RES1 of (degrees * 182). Let's use 182.
0016BBr 2               ;   Output: A = u8 angle
0016BBr 2               ;   Clobbers: uses math coprocessor regs
0016BBr 2               ; ---------------------------------------------------------------------
0016BBr 2               degrees_to_u8:
0016BBr 2  A5 rr              LDA   eval_val_lo
0016BDr 2  8D 20 BB           STA   MATH_MUL16_A_LO
0016C0r 2  A5 rr              LDA   eval_val_hi
0016C2r 2  8D 21 BB           STA   MATH_MUL16_A_HI
0016C5r 2  A9 B6              LDA   #182
0016C7r 2  8D 22 BB           STA   MATH_MUL16_B_LO
0016CAr 2  9C 23 BB           STZ   MATH_MUL16_B_HI       ; trigger multiply
0016CDr 2  AD 39 BB           LDA   MATH_RES1              ; high byte = degrees * 182 / 256
0016D0r 2  60                 RTS
0016D1r 2               
0016D1r 2               ; ---------------------------------------------------------------------
0016D1r 2               ; do_sin — SIN degrees: return sin as signed byte (-128..+127)
0016D1r 2               ; ---------------------------------------------------------------------
0016D1r 2               do_sin:
0016D1r 2  20 rr rr           JSR   eval_expr
0016D4r 2  B0 0C              BCS   @err
0016D6r 2  20 rr rr           JSR   degrees_to_u8
0016D9r 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
0016DCr 2  AD 38 BB           LDA   MATH_RES0              ; sin result (signed 1.7)
0016DFr 2  4C rr rr           JMP   return_signed_byte
0016E2r 2               @err:
0016E2r 2  38                 SEC
0016E3r 2  60                 RTS
0016E4r 2               
0016E4r 2               ; ---------------------------------------------------------------------
0016E4r 2               ; do_cos — COS degrees: return cos as signed byte (-128..+127)
0016E4r 2               ; ---------------------------------------------------------------------
0016E4r 2               do_cos:
0016E4r 2  20 rr rr           JSR   eval_expr
0016E7r 2  B0 0C              BCS   @err
0016E9r 2  20 rr rr           JSR   degrees_to_u8
0016ECr 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
0016EFr 2  AD 39 BB           LDA   MATH_RES1              ; cos result (signed 1.7)
0016F2r 2  4C rr rr           JMP   return_signed_byte
0016F5r 2               @err:
0016F5r 2  38                 SEC
0016F6r 2  60                 RTS
0016F7r 2               
0016F7r 2               ; ---------------------------------------------------------------------
0016F7r 2               ; do_abs — ABS n: return absolute value
0016F7r 2               ; ---------------------------------------------------------------------
0016F7r 2               do_abs:
0016F7r 2  20 rr rr           JSR   eval_expr
0016FAr 2  B0 22              BCS   @err
0016FCr 2  A5 rr              LDA   eval_val_hi
0016FEr 2  10 19              BPL   @done                  ; already positive
001700r 2                     ; Negate 24-bit value
001700r 2  A5 rr              LDA   eval_val_frac
001702r 2  49 FF              EOR   #$FF
001704r 2  18                 CLC
001705r 2  69 01              ADC   #1
001707r 2  85 rr              STA   eval_val_frac
001709r 2  A5 rr              LDA   eval_val_lo
00170Br 2  49 FF              EOR   #$FF
00170Dr 2  69 00              ADC   #0
00170Fr 2  85 rr              STA   eval_val_lo
001711r 2  A5 rr              LDA   eval_val_hi
001713r 2  49 FF              EOR   #$FF
001715r 2  69 00              ADC   #0
001717r 2  85 rr              STA   eval_val_hi
001719r 2               @done:
001719r 2  64 rr              STZ   eval_type
00171Br 2  4C rr rr           JMP   eval_continue
00171Er 2               @err:
00171Er 2  38                 SEC
00171Fr 2  60                 RTS
001720r 2               
001720r 2               ; ---------------------------------------------------------------------
001720r 2               ; do_int — INT n: truncate fractional part
001720r 2               ; ---------------------------------------------------------------------
001720r 2               do_int:
001720r 2  20 rr rr           JSR   eval_expr
001723r 2  B0 07              BCS   @err
001725r 2  64 rr              STZ   eval_val_frac
001727r 2  64 rr              STZ   eval_type
001729r 2  4C rr rr           JMP   eval_continue
00172Cr 2               @err:
00172Cr 2  38                 SEC
00172Dr 2  60                 RTS
00172Er 2               
00172Er 2               ; ---------------------------------------------------------------------
00172Er 2               ; do_round — ROUND n: round to nearest integer
00172Er 2               ; ---------------------------------------------------------------------
00172Er 2               do_round:
00172Er 2  20 rr rr           JSR   eval_expr
001731r 2  B0 19              BCS   @err
001733r 2  A5 rr              LDA   eval_val_frac
001735r 2  C9 80              CMP   #128
001737r 2  90 0C              BCC   @trunc
001739r 2                     ; Round up: increment integer part
001739r 2  A5 rr              LDA   eval_val_hi
00173Br 2  10 02              BPL   @pos_round
00173Dr 2                     ; Negative: actually round toward zero = truncate
00173Dr 2  80 06              BRA   @trunc
00173Fr 2               @pos_round:
00173Fr 2  E6 rr              INC   eval_val_lo
001741r 2  D0 02              BNE   @trunc
001743r 2  E6 rr              INC   eval_val_hi
001745r 2               @trunc:
001745r 2  64 rr              STZ   eval_val_frac
001747r 2  64 rr              STZ   eval_type
001749r 2  4C rr rr           JMP   eval_continue
00174Cr 2               @err:
00174Cr 2  38                 SEC
00174Dr 2  60                 RTS
00174Er 2               
00174Er 2               ; ---------------------------------------------------------------------
00174Er 2               ; do_random — RANDOM n: return random number 0..n-1
00174Er 2               ;   Uses math coprocessor RNG + MUL16 to scale
00174Er 2               ; ---------------------------------------------------------------------
00174Er 2               do_random:
00174Er 2  20 rr rr           JSR   eval_expr
001751r 2  B0 1D              BCS   @err
001753r 2                     ; RNG byte * n / 256 gives 0..n-1
001753r 2  AD 37 BB           LDA   MATH_RNG
001756r 2  8D 20 BB           STA   MATH_MUL16_A_LO
001759r 2  9C 21 BB           STZ   MATH_MUL16_A_HI
00175Cr 2  A5 rr              LDA   eval_val_lo
00175Er 2  8D 22 BB           STA   MATH_MUL16_B_LO
001761r 2  A5 rr              LDA   eval_val_hi
001763r 2  8D 23 BB           STA   MATH_MUL16_B_HI       ; trigger
001766r 2  AD 39 BB           LDA   MATH_RES1              ; high byte of (rng * n) = rng*n/256
001769r 2  85 rr              STA   eval_val_lo
00176Br 2  64 rr              STZ   eval_val_hi
00176Dr 2  4C rr rr           JMP   return_number
001770r 2               @err:
001770r 2  38                 SEC
001771r 2  60                 RTS
001772r 2               
001772r 2               ; ---------------------------------------------------------------------
001772r 2               ; do_sqrt — SQRT n: approximate sqrt via DIST_APPROX(n, 0)
001772r 2               ; ---------------------------------------------------------------------
001772r 2               do_sqrt:
001772r 2  20 rr rr           JSR   eval_expr
001775r 2  B0 1D              BCS   @err
001777r 2  A5 rr              LDA   eval_val_lo
001779r 2  8D 33 BB           STA   MATH_DIST_DX_LO
00177Cr 2  A5 rr              LDA   eval_val_hi
00177Er 2  8D 34 BB           STA   MATH_DIST_DX_HI
001781r 2  9C 35 BB           STZ   MATH_DIST_DY_LO
001784r 2  9C 36 BB           STZ   MATH_DIST_DY_HI       ; trigger (write to DY_HI triggers)
001787r 2  AD 38 BB           LDA   MATH_RES0
00178Ar 2  85 rr              STA   eval_val_lo
00178Cr 2  AD 39 BB           LDA   MATH_RES1
00178Fr 2  85 rr              STA   eval_val_hi
001791r 2  4C rr rr           JMP   return_number
001794r 2               @err:
001794r 2  38                 SEC
001795r 2  60                 RTS
001796r 2               
001796r 2               ; ---------------------------------------------------------------------
001796r 2               ; do_remainder — REMAINDER a b: return a mod b via DIV coprocessor
001796r 2               ; ---------------------------------------------------------------------
001796r 2               do_remainder:
001796r 2  20 rr rr           JSR   eval_expr              ; first arg (a)
001799r 2  B0 49              BCS   @err
00179Br 2  A5 rr              LDA   eval_val_lo
00179Dr 2  48                 PHA
00179Er 2  A5 rr              LDA   eval_val_hi
0017A0r 2  48                 PHA
0017A1r 2  20 rr rr           JSR   eval_expr              ; second arg (b)
0017A4r 2  B0 3C              BCS   @err_pop
0017A6r 2                     ; b in eval_val, a on stack
0017A6r 2                     ; Check divide by zero
0017A6r 2  A5 rr              LDA   eval_val_lo
0017A8r 2  05 rr              ORA   eval_val_hi
0017AAr 2  F0 2D              BEQ   @zero_pop
0017ACr 2                     ; Set up 32÷16 division: dividend=a, divisor=b
0017ACr 2  68                 PLA
0017ADr 2  8D 29 BB           STA   MATH_DIV_N_1           ; a_hi
0017B0r 2  AA                 TAX                          ; save for sign-extend
0017B1r 2  68                 PLA
0017B2r 2  8D 28 BB           STA   MATH_DIV_N_LO          ; a_lo
0017B5r 2                     ; Sign-extend a
0017B5r 2  8A                 TXA
0017B6r 2  09 7F              ORA   #$7F
0017B8r 2  30 02              BMI   @neg_a
0017BAr 2  A9 00              LDA   #$00
0017BCr 2               @neg_a:                            ; A=$FF if negative
0017BCr 2  8D 2A BB           STA   MATH_DIV_N_2
0017BFr 2  8D 2B BB           STA   MATH_DIV_N_HI
0017C2r 2  A5 rr              LDA   eval_val_lo
0017C4r 2  8D 2C BB           STA   MATH_DIV_D_LO
0017C7r 2  A5 rr              LDA   eval_val_hi
0017C9r 2  8D 2D BB           STA   MATH_DIV_D_HI          ; trigger
0017CCr 2                     ; Remainder is in RES2:RES3 (actually check what the copro returns)
0017CCr 2                     ; The math copro returns quotient in RES0:RES1, remainder in RES2:RES3
0017CCr 2  AD 3A BB           LDA   MATH_RES2
0017CFr 2  85 rr              STA   eval_val_lo
0017D1r 2  AD 3B BB           LDA   MATH_RES3
0017D4r 2  85 rr              STA   eval_val_hi
0017D6r 2  4C rr rr           JMP   return_number
0017D9r 2               @zero_pop:
0017D9r 2  68                 PLA
0017DAr 2  68                 PLA
0017DBr 2  64 rr              STZ   eval_val_lo
0017DDr 2  64 rr              STZ   eval_val_hi
0017DFr 2  4C rr rr           JMP   return_number
0017E2r 2               @err_pop:
0017E2r 2  68                 PLA
0017E3r 2  68                 PLA
0017E4r 2               @err:
0017E4r 2  38                 SEC
0017E5r 2  60                 RTS
0017E6r 2               
0017E6r 2               ; ---------------------------------------------------------------------
0017E6r 2               ; do_not — NOT expr: return 1 if expr is 0, else 0
0017E6r 2               ; ---------------------------------------------------------------------
0017E6r 2               do_not:
0017E6r 2  20 rr rr           JSR   eval_expr
0017E9r 2  B0 13              BCS   @err
0017EBr 2  A5 rr              LDA   eval_val_lo
0017EDr 2  05 rr              ORA   eval_val_hi
0017EFr 2                     ; If zero, set result to 1. If nonzero, set to 0.
0017EFr 2  D0 06              BNE   @false
0017F1r 2  A9 01              LDA   #1
0017F3r 2  85 rr              STA   eval_val_lo
0017F5r 2  80 02              BRA   @done
0017F7r 2               @false:
0017F7r 2  64 rr              STZ   eval_val_lo
0017F9r 2               @done:
0017F9r 2  64 rr              STZ   eval_val_hi
0017FBr 2  4C rr rr           JMP   return_number
0017FEr 2               @err:
0017FEr 2  38                 SEC
0017FFr 2  60                 RTS
001800r 2               
001800r 2               ; ---------------------------------------------------------------------
001800r 2               ; do_and — AND a b: return 1 if both nonzero, else 0
001800r 2               ; ---------------------------------------------------------------------
001800r 2               do_and:
001800r 2  20 rr rr           JSR   eval_expr
001803r 2  B0 1E              BCS   @err
001805r 2  A5 rr              LDA   eval_val_lo
001807r 2  05 rr              ORA   eval_val_hi
001809r 2  F0 11              BEQ   @false                 ; first arg is 0 → short-circuit
00180Br 2  20 rr rr           JSR   eval_expr
00180Er 2  B0 13              BCS   @err
001810r 2  A5 rr              LDA   eval_val_lo
001812r 2  05 rr              ORA   eval_val_hi
001814r 2  F0 06              BEQ   @false
001816r 2  A9 01              LDA   #1
001818r 2  85 rr              STA   eval_val_lo
00181Ar 2  80 02              BRA   @done
00181Cr 2               @false:
00181Cr 2  64 rr              STZ   eval_val_lo
00181Er 2               @done:
00181Er 2  64 rr              STZ   eval_val_hi
001820r 2  4C rr rr           JMP   return_number
001823r 2               @err:
001823r 2  38                 SEC
001824r 2  60                 RTS
001825r 2               
001825r 2               ; ---------------------------------------------------------------------
001825r 2               ; do_or — OR a b: return 1 if either nonzero, else 0
001825r 2               ; ---------------------------------------------------------------------
001825r 2               do_or:
001825r 2  20 rr rr           JSR   eval_expr
001828r 2  B0 1E              BCS   @err
00182Ar 2  A5 rr              LDA   eval_val_lo
00182Cr 2  05 rr              ORA   eval_val_hi
00182Er 2  D0 0F              BNE   @true                  ; first arg nonzero → short-circuit
001830r 2  20 rr rr           JSR   eval_expr
001833r 2  B0 13              BCS   @err
001835r 2  A5 rr              LDA   eval_val_lo
001837r 2  05 rr              ORA   eval_val_hi
001839r 2  D0 04              BNE   @true
00183Br 2  64 rr              STZ   eval_val_lo
00183Dr 2  80 04              BRA   @done
00183Fr 2               @true:
00183Fr 2  A9 01              LDA   #1
001841r 2  85 rr              STA   eval_val_lo
001843r 2               @done:
001843r 2  64 rr              STZ   eval_val_hi
001845r 2  4C rr rr           JMP   return_number
001848r 2               @err:
001848r 2  38                 SEC
001849r 2  60                 RTS
00184Ar 2               
00184Ar 2               ; ---------------------------------------------------------------------
00184Ar 2               ; Type predicates — NUMBER?, WORD?, LIST?
00184Ar 2               ; ---------------------------------------------------------------------
00184Ar 2               do_numberp:
00184Ar 2  20 rr rr           JSR   eval_expr
00184Dr 2  B0 07              BCS   @err
00184Fr 2  A5 rr              LDA   eval_type
001851r 2  C9 00              CMP   #VAL_NUMBER
001853r 2  4C rr rr           JMP   predicate_result
001856r 2               @err:
001856r 2  38                 SEC
001857r 2  60                 RTS
001858r 2               
001858r 2               do_wordp:
001858r 2  20 rr rr           JSR   eval_expr
00185Br 2  B0 07              BCS   @err
00185Dr 2  A5 rr              LDA   eval_type
00185Fr 2  C9 01              CMP   #VAL_WORD
001861r 2  4C rr rr           JMP   predicate_result
001864r 2               @err:
001864r 2  38                 SEC
001865r 2  60                 RTS
001866r 2               
001866r 2               do_listp:
001866r 2  20 rr rr           JSR   eval_expr
001869r 2  B0 07              BCS   @err
00186Br 2  A5 rr              LDA   eval_type
00186Dr 2  C9 02              CMP   #VAL_LIST
00186Fr 2  4C rr rr           JMP   predicate_result
001872r 2               @err:
001872r 2  38                 SEC
001873r 2  60                 RTS
