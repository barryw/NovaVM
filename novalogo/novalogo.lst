002291r 2                     ; Pop second list pointer
002291r 2  68                 PLA                           ; frac (unused)
002292r 2  68                 PLA                           ; lo
002293r 2  85 rr              STA   list_tail_lo
002295r 2  68                 PLA                           ; hi
002296r 2  85 rr              STA   list_tail_hi
002298r 2  68                 PLA                           ; type (unused, known VAL_LIST)
002299r 2               
002299r 2                     ; Pop first list pointer
002299r 2  68                 PLA                           ; frac (unused)
00229Ar 2  68                 PLA                           ; lo
00229Br 2  85 rr              STA   list_head_lo
00229Dr 2  68                 PLA                           ; hi
00229Er 2  85 rr              STA   list_head_hi
0022A0r 2  68                 PLA                           ; type (unused)
0022A1r 2               
0022A1r 2                     ; If first list is empty, return second
0022A1r 2  A5 rr              LDA   list_head_lo
0022A3r 2  05 rr              ORA   list_head_hi
0022A5r 2  F0 44              BEQ   @se_return_second
0022A7r 2               
0022A7r 2                     ; Walk to end of first list, patch cdr to second
0022A7r 2  A5 rr              LDA   list_head_lo
0022A9r 2  85 rr              STA   list_ptr_lo
0022ABr 2  A5 rr              LDA   list_head_hi
0022ADr 2  85 rr              STA   list_ptr_hi
0022AFr 2               @se_walk:
0022AFr 2  A5 rr              LDA   list_ptr_lo
0022B1r 2  85 rr              STA   ptr_lo
0022B3r 2  A5 rr              LDA   list_ptr_hi
0022B5r 2  85 rr              STA   ptr_hi
0022B7r 2  A0 05              LDY   #CONS_CDR_LO
0022B9r 2  B1 rr              LDA   (ptr_lo),Y
0022BBr 2  AA                 TAX
0022BCr 2  A0 06              LDY   #CONS_CDR_HI
0022BEr 2  B1 rr              LDA   (ptr_lo),Y
0022C0r 2  09 00              ORA   #0
0022C2r 2  D0 04              BNE   @se_next
0022C4r 2  E0 00              CPX   #0
0022C6r 2  F0 06              BEQ   @se_found_last
0022C8r 2               @se_next:
