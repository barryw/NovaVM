00237Fr 2               ; ---------------------------------------------------------------------
00237Fr 2               ; render_list_to_buf — render list elements into input_buf as text
00237Fr 2               ;   Entry: eval_val_lo/hi = list head pointer
00237Fr 2               ;          buf_idx = current write position in input_buf
00237Fr 2               ;   Exit:  buf_idx updated
00237Fr 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr, list_count
