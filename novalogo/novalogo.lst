00241Cr 2  B0 25              BCS   @rl_sub_done
00241Er 2  A8                 TAY
00241Fr 2  A9 5B              LDA   #'['
002421r 2  99 rr rr           STA   input_buf,Y
002424r 2  E6 rr              INC   z:buf_idx
002426r 2                     ; Get sublist pointer and recurse
002426r 2  A0 03              LDY   #CONS_CAR_LO
002428r 2  B1 rr              LDA   (ptr_lo),Y
00242Ar 2  85 rr              STA   eval_val_lo
00242Cr 2  A0 02              LDY   #CONS_CAR_HI
00242Er 2  B1 rr              LDA   (ptr_lo),Y
002430r 2  85 rr              STA   eval_val_hi
002432r 2  20 rr rr           JSR   render_list_to_buf
002435r 2                     ; Write ']' to buf
002435r 2  A5 rr              LDA   z:buf_idx
