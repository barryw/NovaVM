000000r 1                     .include "libabi.inc"
000000r 2               ; libabi.inc — paged shared-library ABI (mailbox, module header, page-in MMIO).
000000r 2               ; Included by every runtime foundation, every module, and the loader.
000000r 2               ; Design: docs/plans/2026-06-03-paged-library-loader-3b-design.md
000000r 2               
000000r 2               .ifndef LIBABI_INC_INCLUDED
000000r 2               LIBABI_INC_INCLUDED = 1
000000r 2               
000000r 2               ; --- Page-in (PGD) MMIO — shipped RTL ---
000000r 2               PGD_CMD          = $BA76
000000r 2               PGD_STATUS       = $BA77
000000r 2               PGD_SRCL         = $BA78
000000r 2               PGD_SRCM         = $BA79
000000r 2               PGD_SRCH         = $BA7A
000000r 2               PGD_WORDSL       = $BA7B
000000r 2               PGD_WORDSH       = $BA7C
000000r 2               PGD_START        = $01            ; write to PGD_CMD to begin
000000r 2               PGD_ST_BUSY      = $01            ; PGD_STATUS bit0
000000r 2               PGD_ST_DONE      = $02            ; PGD_STATUS bit1 (done/ok)
000000r 2               
000000r 2               ; --- Canonical mailbox (fixed low-RAM, carved $0300-$031F in every runtime) ---
000000r 2               LIB_MBOX         = $0300
000000r 2               LIB_MOD_ID       = LIB_MBOX+0     ; $0300  target module id
000000r 2               LIB_FN_ID        = LIB_MBOX+1     ; $0301  function id within module
000000r 2               LIB_STATUS       = LIB_MBOX+2     ; $0302  0=OK else error code
000000r 2               LIB_ARG0         = LIB_MBOX+3     ; $0303  32-bit LE cell
000000r 2               LIB_ARG1         = LIB_MBOX+7     ; $0307
000000r 2               LIB_ARG2         = LIB_MBOX+11    ; $030B
000000r 2               LIB_ARG3         = LIB_MBOX+15    ; $030F
000000r 2               LIB_RESULT       = LIB_MBOX+19    ; $0313  32-bit LE cell
000000r 2               LIB_HOME_BANK    = LIB_MBOX+23    ; $0317  runtime's REG_ROMSWAP home value (set at boot)
000000r 2               LIB_RESIDENT     = LIB_MBOX+24    ; $0318  currently-mapped module id ($00=none)
000000r 2               LIB_SCRATCH      = LIB_MBOX+25    ; $0319-$031F  7 bytes loader/module scratch
000000r 2               LIB_MBOX_END     = LIB_MBOX+32    ; $0320 (exclusive)
000000r 2               
000000r 2               ; --- Resident loader band (fixed low-RAM, carved $0320-$041F in every runtime) ---
000000r 2               ; lib_call (libcall.s, not PIC) lives here. One canonical libcall.bin built at
000000r 2               ; ORG $0320 (runtime/asm/libcall_resident.cfg); each runtime reserves the band
000000r 2               ; and POKEs/JSRs it. 256 B leaves headroom over the 157 B loader. The $9C00
000000r 2               ; build (tests/asm/libcall_blob.cfg) is isolated harness scaffolding, not this.
000000r 2               LIB_LOADER_BAND     = LIB_MBOX_END    ; $0320  resident loader entry (== lib_call)
000000r 2               LIB_LOADER_BAND_END = $0420           ; (exclusive)
000000r 2               
000000r 2               ; --- Module-private ZP pointer for (zp),Y BYTES deref (cross-runtime free) ---
000000r 2               LIB_ZP           = $14            ; $14-$17 reserved for module pointer pairs
000000r 2               
000000r 2               ; --- Value type tags (compile-time, declared in fn signatures; not on the wire) ---
000000r 2               LT_INT           = $00            ; 32-bit signed (also 16.16 fixed)
000000r 2               LT_BYTES         = $01            ; ARG cell = ptr16,len16
000000r 2               LT_BOOL          = $02
000000r 2               
000000r 2               ; --- Status / error codes ---
000000r 2               LERR_OK          = $00
000000r 2               LERR_BAD_MAGIC   = $80
000000r 2               LERR_BAD_MODULE  = $81
000000r 2               LERR_BAD_VER     = $82
000000r 2               LERR_NO_FN       = $83
000000r 2               
000000r 2               ; --- Module header (image is ORG $C000) ---
000000r 2               MOD_ENTRY        = $C000          ; JMP dispatch (trampoline JSRs here)
000000r 2               MOD_MAGIC        = $C003          ; 2 bytes
000000r 2               MOD_MOD_ID       = $C005
000000r 2               MOD_VERSION      = $C006
000000r 2               MOD_FNCOUNT      = $C007
000000r 2               ; reserved $C008-$C009
000000r 2               MOD_MAGIC0       = $4E            ; 'N'
000000r 2               MOD_MAGIC1       = $4C            ; 'L'
000000r 2               LIB_ABI_VERSION  = $01
000000r 2               
000000r 2               ; --- Module ids ---
000000r 2               MODULE_ID_NONE     = $00
000000r 2               MODULE_ID_GRAPHICS = $01
000000r 2               MODULE_ID_SOUND    = $02
000000r 2               MODULE_ID_SYSTEM   = $03
000000r 2               MODULE_ID_TEST     = $7F
000000r 2               
000000r 2               ; --- XRAM library shelf (option A: fixed, unmanaged high 256KB) ---
000000r 2               SHELF_BASE_L     = $00
000000r 2               SHELF_BASE_M     = $00
000000r 2               SHELF_BASE_H     = $06            ; $060000
000000r 2               SHELF_SLOT_WORDS = $2000          ; 8192 words = 16KB per slot
000000r 2               
000000r 2               ; --- Host-extension re-page (4c.0c: coexistence of legacy ext + paged modules) ---
000000r 2               ; LIB_RESIDENT marker meaning "the active runtime's OWN extension is in bank 1"
000000r 2               ; (distinct from every module id $01-$7F and from $00=none). A legacy ext command
000000r 2               ; checks LIB_RESIDENT; if not $FF it re-pages the host ext from XRAM before calling.
000000r 2               LIB_RESIDENT_HOSTEXT = $FF
000000r 2               ; XRAM address $07C000 where the active runtime's extension is staged for re-page.
000000r 2               ; NOT a modtab module slot — disjoint from module slots 0-2 ($060000/$064000/$068000)
000000r 2               ; and within the 512KB XRAM. NovaHost must stage the active runtime's extensionRom
000000r 2               ; here on HW (firmware follow-on); this task does the emulator side.
000000r 2               HOST_EXT_XRAM_L  = $00
000000r 2               HOST_EXT_XRAM_M  = $C0
000000r 2               HOST_EXT_XRAM_H  = $07            ; $07C000
000000r 2               
000000r 2               .endif ; LIBABI_INC_INCLUDED
000000r 2               
000000r 1                     .include "libgraphics.inc"   ; GFN_* ids for lib_call(GRAPHICS) routing (self-guards + re-includes libabi.inc)
000000r 2               ; libgraphics.inc — GRAPHICS module (MODULE_ID_GRAPHICS = $01) fn-id contract.
000000r 2               ;
000000r 2               ; The canonical paged graphics library: the superset of every NDK graphics
000000r 2               ; driver, callable identically by every runtime through the Phase-3 lib_call ABI.
000000r 2               ; Built once (modules/graphics/graphics.s), staged to XRAM $060000, paged into
000000r 2               ; bank 1 on first lib_call.
000000r 2               ;
000000r 2               ; CALLING CONVENTION (caller side, see libabi.inc):
000000r 2               ;   LIB_MOD_ID ($0300) = MODULE_ID_GRAPHICS
000000r 2               ;   LIB_FN_ID  ($0301) = one of the GFN_* ids below
000000r 2               ;   LIB_ARG0..3 ($0303/$0307/$030B/$030F) = 32-bit LE arg cells
000000r 2               ;       - signed-16 X/Y values occupy the LOW word of a cell (high word ignored).
000000r 2               ;       - BYTES args pack ptr16 in the low word, len16 in the high word.
000000r 2               ;   JSR lib_call
000000r 2               ;   -> LIB_RESULT ($0313) = 32-bit LE result (for reporter-style fns)
000000r 2               ;   -> LIB_STATUS ($0302) = LERR_OK ($00) or an error code
000000r 2               ;
000000r 2               ; Each fn is a thin leaf wrapper: read the arg cells -> load the driver's
000000r 2               ; VGC_P*/register/struct inputs -> JSR the NDK driver entry -> write
000000r 2               ; LIB_RESULT/LIB_STATUS. fn-ids are grouped per domain with room to grow.
000000r 2               
000000r 2               .ifndef LIBGRAPHICS_INC
000000r 2               LIBGRAPHICS_INC = 1
000000r 2               
000000r 2               .include "libabi.inc"            ; MODULE_ID_GRAPHICS, LIB_* mailbox cells, LERR_*
000000r 3               ; libabi.inc — paged shared-library ABI (mailbox, module header, page-in MMIO).
000000r 3               ; Included by every runtime foundation, every module, and the loader.
000000r 3               ; Design: docs/plans/2026-06-03-paged-library-loader-3b-design.md
000000r 3               
000000r 3               .ifndef LIBABI_INC_INCLUDED
000000r 3               LIBABI_INC_INCLUDED = 1
000000r 3               
000000r 3               ; --- Page-in (PGD) MMIO — shipped RTL ---
000000r 3               PGD_CMD          = $BA76
000000r 3               PGD_STATUS       = $BA77
000000r 3               PGD_SRCL         = $BA78
000000r 3               PGD_SRCM         = $BA79
000000r 3               PGD_SRCH         = $BA7A
000000r 3               PGD_WORDSL       = $BA7B
000000r 3               PGD_WORDSH       = $BA7C
000000r 3               PGD_START        = $01            ; write to PGD_CMD to begin
000000r 3               PGD_ST_BUSY      = $01            ; PGD_STATUS bit0
000000r 3               PGD_ST_DONE      = $02            ; PGD_STATUS bit1 (done/ok)
000000r 3               
000000r 3               ; --- Canonical mailbox (fixed low-RAM, carved $0300-$031F in every runtime) ---
000000r 3               LIB_MBOX         = $0300
000000r 3               LIB_MOD_ID       = LIB_MBOX+0     ; $0300  target module id
000000r 3               LIB_FN_ID        = LIB_MBOX+1     ; $0301  function id within module
000000r 3               LIB_STATUS       = LIB_MBOX+2     ; $0302  0=OK else error code
000000r 3               LIB_ARG0         = LIB_MBOX+3     ; $0303  32-bit LE cell
000000r 3               LIB_ARG1         = LIB_MBOX+7     ; $0307
000000r 3               LIB_ARG2         = LIB_MBOX+11    ; $030B
000000r 3               LIB_ARG3         = LIB_MBOX+15    ; $030F
000000r 3               LIB_RESULT       = LIB_MBOX+19    ; $0313  32-bit LE cell
000000r 3               LIB_HOME_BANK    = LIB_MBOX+23    ; $0317  runtime's REG_ROMSWAP home value (set at boot)
000000r 3               LIB_RESIDENT     = LIB_MBOX+24    ; $0318  currently-mapped module id ($00=none)
000000r 3               LIB_SCRATCH      = LIB_MBOX+25    ; $0319-$031F  7 bytes loader/module scratch
000000r 3               LIB_MBOX_END     = LIB_MBOX+32    ; $0320 (exclusive)
000000r 3               
000000r 3               ; --- Resident loader band (fixed low-RAM, carved $0320-$041F in every runtime) ---
000000r 3               ; lib_call (libcall.s, not PIC) lives here. One canonical libcall.bin built at
000000r 3               ; ORG $0320 (runtime/asm/libcall_resident.cfg); each runtime reserves the band
000000r 3               ; and POKEs/JSRs it. 256 B leaves headroom over the 157 B loader. The $9C00
000000r 3               ; build (tests/asm/libcall_blob.cfg) is isolated harness scaffolding, not this.
000000r 3               LIB_LOADER_BAND     = LIB_MBOX_END    ; $0320  resident loader entry (== lib_call)
000000r 3               LIB_LOADER_BAND_END = $0420           ; (exclusive)
000000r 3               
000000r 3               ; --- Module-private ZP pointer for (zp),Y BYTES deref (cross-runtime free) ---
000000r 3               LIB_ZP           = $14            ; $14-$17 reserved for module pointer pairs
000000r 3               
000000r 3               ; --- Value type tags (compile-time, declared in fn signatures; not on the wire) ---
000000r 3               LT_INT           = $00            ; 32-bit signed (also 16.16 fixed)
000000r 3               LT_BYTES         = $01            ; ARG cell = ptr16,len16
000000r 3               LT_BOOL          = $02
000000r 3               
000000r 3               ; --- Status / error codes ---
000000r 3               LERR_OK          = $00
000000r 3               LERR_BAD_MAGIC   = $80
000000r 3               LERR_BAD_MODULE  = $81
000000r 3               LERR_BAD_VER     = $82
000000r 3               LERR_NO_FN       = $83
000000r 3               
000000r 3               ; --- Module header (image is ORG $C000) ---
000000r 3               MOD_ENTRY        = $C000          ; JMP dispatch (trampoline JSRs here)
000000r 3               MOD_MAGIC        = $C003          ; 2 bytes
000000r 3               MOD_MOD_ID       = $C005
000000r 3               MOD_VERSION      = $C006
000000r 3               MOD_FNCOUNT      = $C007
000000r 3               ; reserved $C008-$C009
000000r 3               MOD_MAGIC0       = $4E            ; 'N'
000000r 3               MOD_MAGIC1       = $4C            ; 'L'
000000r 3               LIB_ABI_VERSION  = $01
000000r 3               
000000r 3               ; --- Module ids ---
000000r 3               MODULE_ID_NONE     = $00
000000r 3               MODULE_ID_GRAPHICS = $01
000000r 3               MODULE_ID_SOUND    = $02
000000r 3               MODULE_ID_SYSTEM   = $03
000000r 3               MODULE_ID_TEST     = $7F
000000r 3               
000000r 3               ; --- XRAM library shelf (option A: fixed, unmanaged high 256KB) ---
000000r 3               SHELF_BASE_L     = $00
000000r 3               SHELF_BASE_M     = $00
000000r 3               SHELF_BASE_H     = $06            ; $060000
000000r 3               SHELF_SLOT_WORDS = $2000          ; 8192 words = 16KB per slot
000000r 3               
000000r 3               ; --- Host-extension re-page (4c.0c: coexistence of legacy ext + paged modules) ---
000000r 3               ; LIB_RESIDENT marker meaning "the active runtime's OWN extension is in bank 1"
000000r 3               ; (distinct from every module id $01-$7F and from $00=none). A legacy ext command
000000r 3               ; checks LIB_RESIDENT; if not $FF it re-pages the host ext from XRAM before calling.
000000r 3               LIB_RESIDENT_HOSTEXT = $FF
000000r 3               ; XRAM address $07C000 where the active runtime's extension is staged for re-page.
000000r 3               ; NOT a modtab module slot — disjoint from module slots 0-2 ($060000/$064000/$068000)
000000r 3               ; and within the 512KB XRAM. NovaHost must stage the active runtime's extensionRom
000000r 3               ; here on HW (firmware follow-on); this task does the emulator side.
000000r 3               HOST_EXT_XRAM_L  = $00
000000r 3               HOST_EXT_XRAM_M  = $C0
000000r 3               HOST_EXT_XRAM_H  = $07            ; $07C000
000000r 3               
000000r 3               .endif ; LIBABI_INC_INCLUDED
000000r 3               
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $00-$0F  draw  (driver: vgc.s — vgc_gcls/gcolor/plot/unplot/line/circle/
000000r 2               ;                 rect/fill/paint/gtext; primitives issue VCMD_* via vgc_cmd
000000r 2               ;                 and the wrapper waits via vgc_wait_cmd)
000000r 2               ; =====================================================================
000000r 2               GFN_GCLS      = $00   ; ()                                  -> vgc_gcls
000000r 2               GFN_GCOLOR    = $01   ; (color:ARG0)                        -> VGC_P0; vgc_gcolor
000000r 2               GFN_PLOT      = $02   ; (x:ARG0 s16, y:ARG1 s16)            -> VGC_P0..P3; vgc_plot
000000r 2               GFN_UNPLOT    = $03   ; (x:ARG0, y:ARG1)                    -> VGC_P0..P3; vgc_unplot
000000r 2               GFN_LINE      = $04   ; (x0:ARG0,y0:ARG1,x1:ARG2,y1:ARG3)   -> VGC_P0..P7; vgc_line
000000r 2               GFN_CIRCLE    = $05   ; (cx:ARG0,cy:ARG1,rx:ARG2,ry:ARG3)   -> VGC_P0..P7; vgc_circle (ry=rx if 0 -> ellipse superset)
000000r 2               GFN_RECT      = $06   ; (x0,y0,x1,y1:ARG0..3)               -> VGC_P0..P7; vgc_rect
000000r 2               GFN_FILL      = $07   ; (x0,y0,x1,y1:ARG0..3)               -> VGC_P0..P7; vgc_fill
000000r 2               GFN_PAINT     = $08   ; (x:ARG0, y:ARG1)                    -> VGC_P0..P3; vgc_paint
000000r 2               GFN_GTEXT     = $09   ; (x:ARG0, y:ARG1, BYTES str:ARG2)    -> VGC_P0..P5 + FIO_NAME; vgc_gtext
000000r 2               ;             $0A-$0F reserved
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $10-$1F  text / mode  (driver: vgc.s text-side)
000000r 2               ;   COLOR(fg,bg,border) FONT MODE REVERSE/off FLASH/off LOCATE CLS CLSWIN
000000r 2               ;   DISPLAYon/off  -> vgc_set_fg/bg/border, vgc_set_font, vgc_set_mode,
000000r 2               ;   vgc_reverse_default/off, vgc_flash_on/off, vgc_locate, vgc_cls,
000000r 2               ;   vgc_display_on/off.
000000r 2               ;
000000r 2               ; Arg-register conventions, verified against runtime/asm/vgc.s:
000000r 2               ;   - vgc_set_fg/bg/border take X (STX VGC_FGCOL/BGCOL/BORDER) — pure register
000000r 2               ;     stores, no VGC command issued, no wait needed.
000000r 2               ;   - vgc_set_font / vgc_set_mode take X (STX VGC_FONT / VGC_MODE) — register
000000r 2               ;     stores, no wait.
000000r 2               ;   - vgc_locate reads VGC_P0 (col) -> VGC_CURSX and VGC_P1 (row) -> VGC_CURSY,
000000r 2               ;     so the wrapper loads ARG0->VGC_P0, ARG1->VGC_P1 — register stores, no wait.
000000r 2               ;   - vgc_reverse_default/off, vgc_flash_on/off mutate VGC_TXTFLAGS only — no wait.
000000r 2               ;   - vgc_display_on/off store $0F/$00 to VGC_DIMMER — register store, no wait.
000000r 2               ;   - vgc_cls issues a char-out ($0C form-feed) command and waits internally.
000000r 2               ;
000000r 2               ; NOTE: vtext.s (region/cursor/puts, 16 ops) does NOT fit alongside these in
000000r 2               ; $10-$1F; it gets its own fn-id range in a later batch. CLSWIN has no driver
000000r 2               ; entry in vgc.s, so GFN_CLSWIN is reserved here and stubbed to gfn_unimpl
000000r 2               ; (-> LERR_NO_FN) until a window-clear driver routine exists.
000000r 2               GFN_COLOR      = $10   ; (fg:ARG0, bg:ARG1, border:ARG2) -> vgc_set_fg/bg/border (X each)
000000r 2               GFN_FONT       = $11   ; (slot:ARG0)                      -> X; vgc_set_font
000000r 2               GFN_MODE       = $12   ; (mode:ARG0)                      -> X; vgc_set_mode
000000r 2               GFN_REVERSE    = $13   ; ()  reverse-on                   -> vgc_reverse_default
000000r 2               GFN_REVERSEOFF = $14   ; ()                               -> vgc_reverse_off
000000r 2               GFN_FLASH      = $15   ; ()                               -> vgc_flash_on
000000r 2               GFN_FLASHOFF   = $16   ; ()                               -> vgc_flash_off
000000r 2               GFN_LOCATE     = $17   ; (col:ARG0, row:ARG1)             -> VGC_P0/P1; vgc_locate
000000r 2               GFN_CLS        = $18   ; ()                               -> vgc_cls (issues cmd, waits)
000000r 2               GFN_CLSWIN     = $19   ; ()  clear active window          -> STUB (no vgc entry) -> gfn_unimpl
000000r 2               GFN_DISPLAYON  = $1A   ; ()                               -> vgc_display_on  (VGC_DIMMER=$0F)
000000r 2               GFN_DISPLAYOFF = $1B   ; ()                               -> vgc_display_off (VGC_DIMMER=$00)
000000r 2               ;             $1C-$1F reserved
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $20-$3F  hw-sprite  (driver: runtime/asm/sprite.s)
000000r 2               ;   define/row/clear/copy/pos/enable/disable/flip/priority/shape/setreg/
000000r 2               ;   getx/gety + collision API (status/mask/clear/read-clear/irq)
000000r 2               ;
000000r 2               ; Arg-register conventions, VERIFIED against runtime/asm/sprite.s and the VGC
000000r 2               ; ExecuteSpriteCommand mapping (VirtualGraphicsController.cs): VGC_P<n> is the
000000r 2               ; command register $A011+n; the sprite engine reads P0=sprite-index for every
000000r 2               ; command. Sprite X is a full 16-bit (signed) value (low byte VGC_SPR_XL, high
000000r 2               ; byte VGC_SPR_XH); sprite Y is a single unsigned byte (VGC_SPR_YL; the YH field
000000r 2               ; is reserved/no-op). So only X carries the s16 contract for sprites.
000000r 2               ;
000000r 2               ; Command-issuing ops (define/row/clear/copy/pos/enable/disable/flip/priority)
000000r 2               ; go through sprite_command -> STA VGC_CMD; the wrapper waits via vgc_wait_cmd
000000r 2               ; (busy bit reads 0 in the emulator -> no-op wait) and sets STATUS=OK.
000000r 2               ; Register-store ops (shape/setreg) write the $A040 sprite attribute block
000000r 2               ; directly -> no command, no wait. Reporter ops (getx/gety + every collision
000000r 2               ; read) copy the driver's A/Y return into LIB_RESULT (4-byte LE, high bytes
000000r 2               ; zeroed) then STATUS=OK.
000000r 2               ;
000000r 2               ; Layouts (ARGn low word unless noted; index is 0-15):
000000r 2               GFN_SPR_DEFINE   = $20  ; (idx:ARG0, x:ARG1 0-15, y:ARG2 0-15, color:ARG3) -> P0/P1/P2/P3; VCMD_SPRDEF
000000r 2               GFN_SPR_ROW      = $21  ; (idx:ARG0, row:ARG1, bytes0_3:ARG2, bytes4_7:ARG3) -> P0/P1, P2..P9; sprite_row
000000r 2               GFN_SPR_CLEAR    = $22  ; (idx:ARG0)                       -> P0; sprite_clear
000000r 2               GFN_SPR_COPY     = $23  ; (src:ARG0, dst:ARG1)             -> P0/P1; sprite_copy
000000r 2               GFN_SPR_POS      = $24  ; (idx:ARG0, x:ARG1 s16, y:ARG2)   -> P0, P1/P2(=x), P3(=y); sprite_pos
000000r 2               GFN_SPR_ENABLE   = $25  ; (idx:ARG0)                       -> P0; sprite_enable
000000r 2               GFN_SPR_DISABLE  = $26  ; (idx:ARG0)                       -> P0; sprite_disable
000000r 2               GFN_SPR_FLIP     = $27  ; (idx:ARG0, flags:ARG1)           -> P0/P1; sprite_flip
000000r 2               GFN_SPR_PRIORITY = $28  ; (idx:ARG0, pri:ARG1)             -> P0/P1; sprite_priority
000000r 2               GFN_SPR_SHAPE    = $29  ; (idx:ARG0, shape:ARG1)           -> X/A; sprite_set_shape (reg store)
000000r 2               GFN_SPR_SETREG   = $2A  ; (idx:ARG0, field:ARG1, val:ARG2) -> X/Y/A; sprite_set_reg8 (reg store)
000000r 2               GFN_SPR_SETREG16 = $2B  ; (idx:ARG0, field:ARG1, val16:ARG2) -> X/Y/NVR0L,NVR0H; sprite_set_reg16
000000r 2               GFN_SPR_GETX     = $2C  ; (idx:ARG0) reporter -> RESULT = 16-bit X (A=hi,Y=lo); sprite_get_x
000000r 2               GFN_SPR_GETY     = $2D  ; (idx:ARG0) reporter -> RESULT = Y byte (in Y); sprite_get_y
000000r 2               ;             $2E-$2F reserved
000000r 2               ; --- sprite-sprite collision API ($30-$35) ---
000000r 2               GFN_SPR_COLL_STATUS    = $30  ; () reporter -> RESULT = VGC_COLLST low byte (A); sprite_collision_status
000000r 2               GFN_SPR_COLL_MASK      = $31  ; () reporter -> RESULT = 16-bit mask (A=hi,Y=lo); sprite_collision_mask
000000r 2               GFN_SPR_COLL_CLEAR     = $32  ; () clear mask + ack IRQ; sprite_collision_clear
000000r 2               GFN_SPR_COLL_READCLEAR = $33  ; () reporter -> RESULT = 16-bit mask, then clear; sprite_collision_read_clear
000000r 2               GFN_SPR_COLL_IRQON     = $34  ; () enable sprite-sprite collision IRQ (+CLI); sprite_collision_irq_enable
000000r 2               GFN_SPR_COLL_IRQOFF    = $35  ; () disable sprite-sprite collision IRQ; sprite_collision_irq_disable
000000r 2               ; --- sprite-background collision API ($36-$3B) ---
000000r 2               GFN_SPR_BG_STATUS      = $36  ; () reporter -> RESULT = VGC_COLLBG low byte (A); sprite_background_collision_status
000000r 2               GFN_SPR_BG_MASK        = $37  ; () reporter -> RESULT = 16-bit mask (A=hi,Y=lo); sprite_background_collision_mask
000000r 2               GFN_SPR_BG_CLEAR       = $38  ; () clear bg mask + ack IRQ; sprite_background_clear
000000r 2               GFN_SPR_BG_READCLEAR   = $39  ; () reporter -> RESULT = 16-bit mask, then clear; sprite_background_read_clear
000000r 2               GFN_SPR_BG_IRQON       = $3A  ; () enable sprite-bg collision IRQ (+CLI); sprite_background_irq_enable
000000r 2               GFN_SPR_BG_IRQOFF      = $3B  ; () disable sprite-bg collision IRQ; sprite_background_irq_disable
000000r 2               ;             $3C-$3F reserved
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $40-$4F  copper  (drivers: copper.s + copper_split.s)
000000r 2               ;   list/add/clear/on/off/use/end/split/set_reg/set_sprite_reg
000000r 2               ;
000000r 2               ; Arg-register conventions, VERIFIED against runtime/asm/copper.s,
000000r 2               ; copper.inc, copper_split.s, copper_split.inc and the VGC
000000r 2               ; ExecuteCopperCommand mapping (VirtualGraphicsController.cs).
000000r 2               ;
000000r 2               ; The copper is a raster co-processor: it edits up to 128 display "lists" of
000000r 2               ; (scanline-position, VGC-register, value) write events, then plays them back
000000r 2               ; against the active list every frame. The driver entries issue VCMD_COPPER*
000000r 2               ; via copper_command (STA VGC_CMD); the wrapper waits via vgc_wait_cmd and sets
000000r 2               ; STATUS=OK. copper_add reads its inputs from VGC_P0..P5:
000000r 2               ;   P0/P1 = x (column, 0..GfxWidth-1), P2 = y (scanline, 0..GfxHeight-1),
000000r 2               ;   P3/P4 = register specifier, P5 = value. Position = y*GfxWidth + x.
000000r 2               ;
000000r 2               ; set_reg / set_sprite_reg: copper.s exposes copper_set_reg_index (A=reg index
000000r 2               ; -> P3/P4) and copper_set_sprite_reg (X=sprite index, A=field offset -> P3/P4)
000000r 2               ; as register-prep helpers — neither issues a command on its own, exactly as
000000r 2               ; copper_split_mode composes copper_set_reg_index + copper_add internally. The
000000r 2               ; standalone helpers leave no observable bus effect, so GFN_COPPER_SET_REG /
000000r 2               ; GFN_COPPER_SET_SPRITE_REG expose the COMPLETE add-a-register-write op: load
000000r 2               ; x/y/value into P0/P1/P2/P5, prep the register specifier into P3/P4 via the
000000r 2               ; matching helper, then issue copper_add. The result is an observable
000000r 2               ; CopperEvent on the active list.
000000r 2               ;
000000r 2               ; Layouts (ARGn low word unless noted):
000000r 2               GFN_COPPER_LIST       = $40  ; (idx:ARG0)                         -> P0; copper_list (VCMD_COPPERLIST)
000000r 2               GFN_COPPER_ADD        = $41  ; (x:ARG0 s16, y:ARG1, reg:ARG2, val:ARG3) -> P0/P1,P2,P3/P4,P5; copper_add
000000r 2               GFN_COPPER_CLEAR      = $42  ; ()                                 -> copper_clear (VCMD_COPPERCLR)
000000r 2               GFN_COPPER_ON         = $43  ; ()                                 -> copper_on   (VCMD_COPPERENA)
000000r 2               GFN_COPPER_OFF        = $44  ; ()                                 -> copper_off  (VCMD_COPPERDIS)
000000r 2               GFN_COPPER_USE        = $45  ; (idx:ARG0)                         -> P0; copper_use (VCMD_COPPERUSE)
000000r 2               GFN_COPPER_END        = $46  ; ()                                 -> copper_list_end (VCMD_COPPEREND)
000000r 2               GFN_COPPER_SPLIT      = $47  ; (idx:ARG0, splitY:ARG1, mode0:ARG2, mode1:ARG3) -> P0..P3; copper_split_mode
000000r 2               GFN_COPPER_SET_REG    = $48  ; (x:ARG0 s16, y:ARG1, regIndex:ARG2, val:ARG3)
000000r 2                                            ;   -> P0/P1=x, P2=y, copper_set_reg_index(A=regIndex)->P3/P4,
000000r 2                                            ;      P5=val, copper_add. Observable CopperEvent.
000000r 2               GFN_COPPER_SET_SPRITE_REG = $49 ; (x:ARG0 s16, y:ARG1, sprIdx|field:ARG2, val:ARG3)
000000r 2                                            ;   ARG2 low byte = sprite index, byte 1 = VGC_SPR_*_OFF field.
000000r 2                                            ;   -> P0/P1=x, P2=y, copper_set_sprite_reg(X=sprIdx,A=field)->P3/P4,
000000r 2                                            ;      P5=val, copper_add. Observable CopperEvent.
000000r 2               ;             $4A-$4F reserved
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $50-$5F  blit / dma  (drivers: runtime/asm/blitter.s + runtime/asm/dma.s)
000000r 2               ;   blitcopy blitfill blit-start blit-wait dmacopy dmafill
000000r 2               ;   + blit status/err/count + dma status/err/count reporters
000000r 2               ;
000000r 2               ; Arg-register conventions, VERIFIED against runtime/asm/blitter.s+blitter.inc,
000000r 2               ; runtime/asm/dma.s+dma.inc, and the BLT_*/DMA_* register map in nova.inc
000000r 2               ; (mirrored by VirtualBlitterController / VirtualDmaController on the bus).
000000r 2               ;
000000r 2               ; Both controllers are 24-bit-address, length/size-bounded engines over a set of
000000r 2               ; unified memory "spaces" (CPU=0, VGC_CHAR=1, VGC_COLOR=2, VGC_GFX=3,
000000r 2               ; VGC_SPRITE=4, XRAM=5, VGC_TEXTATTR=7 — BLT_SPACE_* alias the DMA_SPACE_*).
000000r 2               ; The drivers load the hardware registers, write *_CMD_REG = *_CMD_START, then
000000r 2               ; spin in *_wait on *_STATUS_REG until it leaves BUSY; they return A=0 on OK,
000000r 2               ; A=1 on error (detail left in *_ERRCODE_REG). The wrappers marshal the ARG
000000r 2               ; cells into the hardware registers, JSR the driver, and set STATUS=OK (the
000000r 2               ; driver already self-waited; the reporters expose the controller's status/
000000r 2               ; errcode/count for callers that want the detail).
000000r 2               ;
000000r 2               ; DMA is a 1-D bulk move: src/dst are flat 24-bit offsets within their space.
000000r 2               ;   ARG0: byte0=srcSpace, byte1=dstSpace, byte2=fillValue (fill only)
000000r 2               ;   ARG1: src offset (24-bit, low 3 bytes; ignored by fill)
000000r 2               ;   ARG2: dst offset (24-bit, low 3 bytes)
000000r 2               ;   ARG3: length    (24-bit, low 3 bytes)
000000r 2               ;
000000r 2               ; BLIT is a 2-D rectangular move. To keep the op within 4 arg cells the wrapper
000000r 2               ; uses a tightly-packed rectangle: srcStride = dstStride = width (no padding
000000r 2               ; between rows). Callers needing arbitrary strides drive the BLT_* registers
000000r 2               ; directly + GFN_BLIT_START / GFN_BLIT_WAIT.
000000r 2               ;   ARG0: byte0=srcSpace, byte1=dstSpace, byte2=fillValue (fill only)
000000r 2               ;   ARG1: src offset (24-bit; ignored by fill)
000000r 2               ;   ARG2: dst offset (24-bit)
000000r 2               ;   ARG3: byte0/1 = width (16-bit), byte2/3 = height (16-bit)
000000r 2               ;
000000r 2               ; Reporters write LIB_RESULT (4-byte LE, high bytes zeroed) then STATUS=OK:
000000r 2               ;   *_STATUS -> the controller status byte (BUSY/OK/ERROR),
000000r 2               ;   *_ERR    -> the controller error byte (0 = none),
000000r 2               ;   *_COUNT  -> 24-bit bytes-moved counter (3 register bytes -> RESULT low 24 bits).
000000r 2               GFN_BLITCOPY    = $50  ; (ARG0=spaces+fill, ARG1=src, ARG2=dst, ARG3=w|h) -> blitter_copy
000000r 2               GFN_BLITFILL    = $51  ; (ARG0=dstSpace+fill, ARG2=dst, ARG3=w|h)         -> blitter_fill
000000r 2               GFN_BLIT_START  = $52  ; () issue BLT_CMD_START on pre-loaded regs + wait  -> blitter_start_copy
000000r 2               GFN_BLIT_WAIT   = $53  ; () poll BLT_STATUS to completion                  -> blitter_wait
000000r 2               GFN_DMACOPY     = $54  ; (ARG0=spaces+fill, ARG1=src, ARG2=dst, ARG3=len) -> dma_copy
000000r 2               GFN_DMAFILL     = $55  ; (ARG0=dstSpace+fill, ARG2=dst, ARG3=len)         -> dma_fill
000000r 2               GFN_BLIT_STATUS = $56  ; () reporter -> RESULT = BLT_STATUS_REG byte
000000r 2               GFN_BLIT_ERR    = $57  ; () reporter -> RESULT = BLT_ERRCODE_REG byte
000000r 2               GFN_BLIT_COUNT  = $58  ; () reporter -> RESULT = 24-bit BLT bytes-written
000000r 2               GFN_DMA_STATUS  = $59  ; () reporter -> RESULT = DMA_STATUS_REG byte
000000r 2               GFN_DMA_ERR     = $5A  ; () reporter -> RESULT = DMA_ERRCODE_REG byte
000000r 2               GFN_DMA_COUNT   = $5B  ; () reporter -> RESULT = 24-bit DMA bytes-moved
000000r 2               ;             $5C-$5F reserved
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $60-$7F  vsprite  (driver: runtime/asm/vsprite.s — batch 4b.7)
000000r 2               ;   blit/fill/rotate/save-restore-bg/gfx_* + scene compositor
000000r 2               ;
000000r 2               ; THE MARSHALLING PROBLEM. A virtual sprite needs far more state than the four
000000r 2               ; 16-byte arg cells can carry: src/dst/bg/orig/rot 24-bit addresses + 16-bit
000000r 2               ; w/h + strides + colorkey + flags + angle + x/y, and the scene ops take a
000000r 2               ; descriptor LIST. vsprite.s keeps all that state in a CONTIGUOUS BSS block
000000r 2               ; (VSPRITE_SRCSPACE..VSPRITE_SCENE_WORKSTRH, set directly by callers), so the
000000r 2               ; ABI is: the caller fills a struct in shared RAM laid out byte-for-byte as that
000000r 2               ; block, and passes it as a single BYTES arg. Every vsprite op shares this one
000000r 2               ; copy-then-run shape.
000000r 2               ;
000000r 2               ;   ARG0 = BYTES(ptr16 in the low word, len16 in the high word) of a caller
000000r 2               ;          struct that mirrors the VSPRITE config block starting at field
000000r 2               ;          offset 0 = VSPRITE_SRCSPACE. The wrapper copies `len` bytes (clamped
000000r 2               ;          to GFX_VS_CFG_MAX) into the module's VSPRITE_* BSS via (LIB_ZP),Y,
000000r 2               ;          then JSRs the driver entry. Callers only need to fill the prefix of
000000r 2               ;          the struct their op @requires; trailing fields may be omitted by
000000r 2               ;          passing a shorter len.
000000r 2               ;
000000r 2               ; Config-struct field offsets (VERIFIED against the BSS order in vsprite.s and
000000r 2               ; the VSPRITE_DESC_* layout in vsprite.inc). These are byte offsets from the
000000r 2               ; start of the caller struct == offsets into the VSPRITE_* BSS block:
000000r 2               GFX_VS_OFF_SRCSPACE   = 0
000000r 2               GFX_VS_OFF_DSTSPACE   = 1
000000r 2               GFX_VS_OFF_SRCADDRL   = 2
000000r 2               GFX_VS_OFF_SRCADDRM   = 3
000000r 2               GFX_VS_OFF_SRCADDRH   = 4
000000r 2               GFX_VS_OFF_DSTADDRL   = 5
000000r 2               GFX_VS_OFF_DSTADDRM   = 6
000000r 2               GFX_VS_OFF_DSTADDRH   = 7
000000r 2               GFX_VS_OFF_WIDTHL     = 8
000000r 2               GFX_VS_OFF_WIDTHH     = 9
000000r 2               GFX_VS_OFF_HEIGHTL    = 10
000000r 2               GFX_VS_OFF_HEIGHTH    = 11
000000r 2               GFX_VS_OFF_SRCSTRL    = 12
000000r 2               GFX_VS_OFF_SRCSTRH    = 13
000000r 2               GFX_VS_OFF_DSTSTRL    = 14
000000r 2               GFX_VS_OFF_DSTSTRH    = 15
000000r 2               GFX_VS_OFF_BGSPACE    = 16
000000r 2               GFX_VS_OFF_BGADDRL    = 17
000000r 2               GFX_VS_OFF_BGADDRM    = 18
000000r 2               GFX_VS_OFF_BGADDRH    = 19
000000r 2               GFX_VS_OFF_BGSTRL     = 20
000000r 2               GFX_VS_OFF_BGSTRH     = 21
000000r 2               GFX_VS_OFF_COLORKEY   = 22
000000r 2               GFX_VS_OFF_ORIGSPACE  = 23
000000r 2               GFX_VS_OFF_ORIGADDRL  = 24
000000r 2               GFX_VS_OFF_ORIGADDRM  = 25
000000r 2               GFX_VS_OFF_ORIGADDRH  = 26
000000r 2               GFX_VS_OFF_ORIGSTRL   = 27
000000r 2               GFX_VS_OFF_ORIGSTRH   = 28
000000r 2               GFX_VS_OFF_ROTSPACE   = 29
000000r 2               GFX_VS_OFF_ROTADDRL   = 30
000000r 2               GFX_VS_OFF_ROTADDRM   = 31
000000r 2               GFX_VS_OFF_ROTADDRH   = 32
000000r 2               GFX_VS_OFF_ROTSTRL    = 33
000000r 2               GFX_VS_OFF_ROTSTRH    = 34
000000r 2               GFX_VS_OFF_ROTANGLE   = 35
000000r 2               GFX_VS_OFF_FILLVALUE  = 36
000000r 2               GFX_VS_OFF_FLAGS      = 37
000000r 2               GFX_VS_OFF_XL         = 38
000000r 2               GFX_VS_OFF_XH         = 39
000000r 2               GFX_VS_OFF_Y          = 40
000000r 2               ; scene block (only the scene ops need these; SCENE_REMAIN at offset 44 is an
000000r 2               ; internal counter reset by the driver, so it is harmless to copy over):
000000r 2               GFX_VS_OFF_SCENE_ADDRL    = 41
000000r 2               GFX_VS_OFF_SCENE_ADDRH    = 42
000000r 2               GFX_VS_OFF_SCENE_COUNT    = 43
000000r 2               GFX_VS_OFF_SCENE_XL       = 45
000000r 2               GFX_VS_OFF_SCENE_XH       = 46
000000r 2               GFX_VS_OFF_SCENE_Y        = 47
000000r 2               GFX_VS_OFF_SCENE_WIDTHL   = 48
000000r 2               GFX_VS_OFF_SCENE_WIDTHH   = 49
000000r 2               GFX_VS_OFF_SCENE_HEIGHTL  = 50
000000r 2               GFX_VS_OFF_SCENE_HEIGHTH  = 51
000000r 2               GFX_VS_OFF_SCENE_WORKSPACE= 52
000000r 2               GFX_VS_OFF_SCENE_WORKADDRL= 53
000000r 2               GFX_VS_OFF_SCENE_WORKADDRM= 54
000000r 2               GFX_VS_OFF_SCENE_WORKADDRH= 55
000000r 2               GFX_VS_OFF_SCENE_WORKSTRL = 56
000000r 2               GFX_VS_OFF_SCENE_WORKSTRH = 57
000000r 2               ; Maximum config bytes the wrapper will copy (covers the whole caller-facing
000000r 2               ; block through SCENE_WORKSTRH; never touches the driver-internal OFFL/OFFH).
000000r 2               GFX_VS_CFG_MAX            = 58
000000r 2               ;
000000r 2               ; @out mapping: every vsprite op returns A=0 (ok) / A=1 (error) per its @out.
000000r 2               ; The wrappers map A!=0 -> LIB_STATUS = LERR_VSPRITE_FAIL and A==0 -> LERR_OK,
000000r 2               ; and additionally publish A into LIB_RESULT (byte 0; bytes 1-3 zeroed) so a
000000r 2               ; caller can read the raw driver result without inspecting only STATUS. The
000000r 2               ; void-return state op (USE_ORIGINAL/USE_ROTATED also return A=0) follow the
000000r 2               ; same rule.
000000r 2               ;
000000r 2               ; WAIT MODEL (VERIFIED against vsprite.s + blitter.s): vsprite_gfx_blit,
000000r 2               ; vsprite_gfx_save_bg, vsprite_gfx_restore_bg, vsprite_gfx_fill, vsprite_fill,
000000r 2               ; vsprite_rotate and the scene helpers all reach the blitter via
000000r 2               ; blitter_start_copy/blitter_fill -> blitter_wait, which self-spins on
000000r 2               ; BLT_STATUS until not-BUSY (the emulator completes the blit synchronously on
000000r 2               ; the BLT_CMD write). So none of these need a pumped bus. ONLY the two
000000r 2               ; frame-pacing rotate variants (vsprite_gfx_rotate_blit / _keyed) additionally
000000r 2               ; poll VGC_FRAME via vsprite_wait_frame, which only advances when the bus is
000000r 2               ; pumped (AdvanceCycles) -> those two are flagged PUMPED below.
000000r 2               LERR_VSPRITE_FAIL = $84   ; vsprite driver returned A=1 (blitter error / bad geometry)
000000r 2               
000000r 2               ; Layouts (ARG0 = BYTES(cfg struct) for every op unless noted):
000000r 2               GFN_VS_BLIT              = $60 ; (cfg) -> vsprite_blit (rect copy, self-waits)
000000r 2               GFN_VS_BLIT_START        = $61 ; (cfg) -> vsprite_blit_start (issue, no wait)
000000r 2               GFN_VS_FILL              = $62 ; (cfg) -> vsprite_fill (rect fill, self-waits)
000000r 2               GFN_VS_USE_ORIGINAL      = $63 ; (cfg) -> vsprite_use_original (SRC* := ORIG*)
000000r 2               GFN_VS_USE_ROTATED       = $64 ; (cfg) -> vsprite_use_rotated  (SRC* := ROT*)
000000r 2               GFN_VS_ROTATE            = $65 ; (cfg) -> vsprite_rotate (rotate ORIG->ROT, self-waits)
000000r 2               GFN_VS_GFX_BLIT          = $66 ; (cfg) -> vsprite_gfx_blit (blit at X/Y, self-waits)
000000r 2               GFN_VS_GFX_BLIT_START    = $67 ; (cfg) -> vsprite_gfx_blit_start (issue, no wait)
000000r 2               GFN_VS_GFX_FILL          = $68 ; (cfg) -> vsprite_gfx_fill (fill at X/Y, self-waits)
000000r 2               GFN_VS_GFX_SAVE_BG       = $69 ; (cfg) -> vsprite_gfx_save_bg (gfx->BG, self-waits)
000000r 2               GFN_VS_GFX_RESTORE_BG    = $6A ; (cfg) -> vsprite_gfx_restore_bg (BG->gfx, self-waits)
000000r 2               GFN_VS_GFX_ROTATE_BLIT   = $6B ; (cfg) -> vsprite_gfx_rotate_blit (rotate+frame-wait+blit) PUMPED
000000r 2               GFN_VS_GFX_ROTATE_BLIT_KEYED  = $6C ; (cfg) -> vsprite_gfx_rotate_blit_keyed (colorkey) PUMPED
000000r 2               GFN_VS_GFX_ROTATE_BLIT_NOWAIT = $6D ; (cfg) -> vsprite_gfx_rotate_blit_nowait (no frame wait)
000000r 2               GFN_VS_SCENE_BEGIN       = $6E ; (cfg incl scene table) -> vsprite_scene_begin (restore old bgs)
000000r 2               GFN_VS_SCENE_COMMIT      = $6F ; (cfg incl scene table) -> vsprite_scene_commit (save+draw)
000000r 2               GFN_VS_SCENE_DRAW        = $70 ; (cfg incl scene table) -> vsprite_scene_draw (draw only)
000000r 2               GFN_VS_SCENE_COMMIT_ATOMIC = $71 ; (cfg incl scene+work) -> vsprite_scene_commit_atomic
000000r 2               ;             $72-$7F reserved
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $80-$9F  msprite / meta-sprite  (driver: runtime/asm/msprite.s — batch 4b.8)
000000r 2               ;   spawn/destroy/show/hide/pos/frame/anim/priority/transcolor/tick/commit
000000r 2               ;
000000r 2               ; A meta-sprite OBJECT owns a contiguous range of hardware sprites and is moved/
000000r 2               ; animated as one unit. The driver keeps all object state in a module-owned BSS
000000r 2               ; table (MSPRITE_OBJ_* arrays, MSPRITE_HW_OWNER); commit writes the owned hardware
000000r 2               ; sprite attribute registers ($A040+) for every dirty visible object, so the
000000r 2               ; effect is observable via the real VGC sprite state. NOTE: the driver assumes a
000000r 2               ; ZEROED object table (no explicit init fn is in §2 scope); every runtime that
000000r 2               ; uses msprite starts from a cold BSS band, which satisfies that.
000000r 2               ;
000000r 2               ; Arg-register conventions, VERIFIED against runtime/asm/msprite.inc + msprite.s
000000r 2               ; (@in/@out/@requires):
000000r 2               ;
000000r 2               ;   SPAWN reads a VISUAL DESCRIPTOR via the MSPRITE_DESC_L/H pointer cell. The
000000r 2               ;   descriptor is a caller-owned record: byte0 = part count (1..MSPRITE_MAX_PARTS),
000000r 2               ;   byte1 = flags, then `part count` part records of 4 bytes (dx, dy, shape-base,
000000r 2               ;   flags). ARG0 is a BYTES arg whose ptr16 (low word) is written straight into
000000r 2               ;   MSPRITE_DESC_L/H (the descriptor stays resident in caller RAM; the len word is
000000r 2               ;   ignored — the driver reads part-count from the descriptor itself). SPAWN
000000r 2               ;   returns the new object handle in A ($FF on failure) plus a code in
000000r 2               ;   MSPRITE_RESULT. The wrapper publishes the handle to LIB_RESULT byte 0 and maps
000000r 2               ;   the failure to LIB_STATUS (handle $FF -> LERR_MSPRITE_FAIL, else LERR_OK).
000000r 2               ;
000000r 2               ;   Per-object ops take the object HANDLE in ARG0 -> A. Extra inputs:
000000r 2               ;     POS:   x(s16)=ARG1 -> NVR0L/NVR0H, y=ARG2 -> Y register.
000000r 2               ;     FRAME: frame#=ARG1 -> X register.
000000r 2               ;     ANIM:  anim descriptor ptr16 = ARG1 BYTES low word -> MSPRITE_ANIM_L/H.
000000r 2               ;     PRIORITY / TRANSCOLOR: value=ARG1 -> X register.
000000r 2               ;     DESTROY/SHOW/HIDE/COMMIT_ONE: handle only.
000000r 2               ;   Each returns a result code in A; the wrapper maps A!=OK -> LERR_MSPRITE_FAIL.
000000r 2               ;
000000r 2               ;   TICK and COMMIT are engine-wide (no args); both return A=0 (always OK).
000000r 2               ;
000000r 2               LERR_MSPRITE_FAIL = $85   ; msprite driver returned a non-OK result / $FF handle
000000r 2               
000000r 2               GFN_MS_SPAWN       = $80  ; (BYTES desc:ARG0) -> MSPRITE_DESC_L/H; msprite_spawn
000000r 2                                         ;   RESULT = object handle (A); $FF -> LERR_MSPRITE_FAIL
000000r 2               GFN_MS_DESTROY     = $81  ; (handle:ARG0)            -> A; msprite_destroy
000000r 2               GFN_MS_SHOW        = $82  ; (handle:ARG0)            -> A; msprite_show
000000r 2               GFN_MS_HIDE        = $83  ; (handle:ARG0)            -> A; msprite_hide
000000r 2               GFN_MS_POS         = $84  ; (handle:ARG0, x:ARG1 s16, y:ARG2) -> A, NVR0L/H, Y; msprite_set_pos
000000r 2               GFN_MS_FRAME       = $85  ; (handle:ARG0, frame:ARG1) -> A, X; msprite_set_frame
000000r 2               GFN_MS_ANIM        = $86  ; (handle:ARG0, BYTES anim:ARG1) -> A, MSPRITE_ANIM_L/H; msprite_set_anim
000000r 2               GFN_MS_PRIORITY    = $87  ; (handle:ARG0, pri:ARG1)  -> A, X; msprite_set_priority
000000r 2               GFN_MS_TRANSCOLOR  = $88  ; (handle:ARG0, color:ARG1) -> A, X; msprite_set_transcolor
000000r 2               GFN_MS_TICK        = $89  ; ()                       -> msprite_tick (advance anim timers)
000000r 2               GFN_MS_COMMIT      = $8A  ; ()                       -> msprite_commit (write all dirty -> hw)
000000r 2               GFN_MS_COMMIT_ONE  = $8B  ; (handle:ARG0)            -> A; msprite_commit_one
000000r 2               ;             $8C-$9F reserved
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $A0-$AF  image / mem  (drivers: vgc.s mem-I/O + fio.s GSAVE/GLOAD + nvg.s)
000000r 2               ;   MEMREAD MEMWRITE VPEEK VPOKE GSAVE GLOAD NVGload x4   (batch 4b.9)
000000r 2               ;
000000r 2               ; THREE driver families, three marshalling shapes, all VERIFIED against the
000000r 2               ; sources:
000000r 2               ;
000000r 2               ;  1. VGC byte memory I/O (vgc.s vgc_mem_read / vgc_mem_write). Both issue a
000000r 2               ;     VCMD_MEMREAD/MEMWRITE through VGC_CMD and self-wait via vgc_wait_cmd. The
000000r 2               ;     ExecuteMemoryCommand register map (VirtualGraphicsController.cs) is:
000000r 2               ;       VGC_P0 = space (a VGC_PLANE_* id), VGC_P1/P2 = 16-bit address,
000000r 2               ;       VGC_P3 = value (write input / read OUTPUT), VGC_P4 = autoinc flags
000000r 2               ;       (bit0). The wrapper clears VGC_P4 so each op touches exactly one byte.
000000r 2               ;     MEMREAD/VPEEK are reporters: after the command, VGC_P3 holds the byte ->
000000r 2               ;     LIB_RESULT (4-byte LE, high bytes zeroed) + STATUS=OK.
000000r 2               ;     VPEEK/VPOKE are the gfx-plane forms: identical to MEMREAD/MEMWRITE with
000000r 2               ;     the space fixed to VGC_PLANE_GFX, so ARG0 carries the gfx offset directly
000000r 2               ;     (no space arg).
000000r 2               ;
000000r 2               ;  2. File save/load of a VGC memory space to/from a .gfx file (fio.s
000000r 2               ;     fio_gsave / fio_gload -> FIO_CMD_GSAVE/GLOAD via fio_exec; self-waits on
000000r 2               ;     FIO_STATUS, returns A=0 OK / A=1 error). The FileIoController DoGSave/
000000r 2               ;     DoGLoad read FIO_GSPACE = space, FIO_GADDRL/H = 16-bit address, FIO_GLENL/H
000000r 2               ;     = 16-bit length, and FIO_NAME/FIO_NAMELEN = filename. The wrapper marshals
000000r 2               ;     the BYTES filename into FIO_NAME/FIO_NAMELEN exactly as GTEXT does, loads
000000r 2               ;     the three graphics registers, and JSRs the driver. Result A!=0 ->
000000r 2               ;     LERR_FILE_FAIL, A==0 -> OK; A is also published to LIB_RESULT byte 0.
000000r 2               ;
000000r 2               ;  3. NVG image load into the gfx plane (nvg.s nvg_load / nvg_load_at /
000000r 2               ;     nvg_load_named / nvg_load_named_at). nvg_load(_at) read the filename from
000000r 2               ;     FIO_NAME/FIO_NAMELEN; the _named variants read it from the FIO_ARG_NAME*
000000r 2               ;     ZP cells and self-copy. All four clear the gfx plane then decode the file
000000r 2               ;     via FIO_CMD_NVGLOAD (host-side NVG1 decoder) and return A=0/1. The _AT
000000r 2               ;     variants take a destination offset in NVG_ADDRL/H (= FIO_GADDRL/H). Every
000000r 2               ;     NVGload wrapper takes ARG0 = BYTES filename; the _AT/_NAMED_AT variants
000000r 2               ;     additionally take a 16-bit dest offset in ARG1. Result A!=0 ->
000000r 2               ;     LERR_IMAGE_FAIL, A==0 -> OK; A is also published to LIB_RESULT byte 0.
000000r 2               ;
000000r 2               ;     NVGload HARDWARE effect is host-decoder + real-file dependent (no NVG1
000000r 2               ;     fixture is decodable in the unit-test harness), so these are proven on the
000000r 2               ;     loader axis (dispatch + register marshalling + A=error mapping for the
000000r 2               ;     missing-file path) only. MEMREAD/MEMWRITE/VPEEK/VPOKE and GSAVE/GLOAD are
000000r 2               ;     proven end-to-end against the real VGC/FileIoController on Axis 2.
000000r 2               GFX_MEMSPACE_GFX = $03      ; VGC_PLANE_GFX — VPEEK/VPOKE fixed space
000000r 2               LERR_FILE_FAIL   = $86      ; fio_gsave/gload returned A=1 (FIO error / bad geometry)
000000r 2               LERR_IMAGE_FAIL  = $87      ; nvg_load* returned A=1 (host decode / missing file)
000000r 2               
000000r 2               ; Layouts (ARGn low word unless noted; BYTES args pack ptr16 low / len16 high):
000000r 2               GFN_MEMREAD          = $A0  ; (space:ARG0, addr:ARG1) reporter -> RESULT = byte; vgc_mem_read
000000r 2               GFN_MEMWRITE         = $A1  ; (space:ARG0, addr:ARG1, value:ARG2) -> vgc_mem_write
000000r 2               GFN_VPEEK            = $A2  ; (offset:ARG0) reporter -> RESULT = gfx byte; vgc_mem_read (space=gfx)
000000r 2               GFN_VPOKE            = $A3  ; (offset:ARG0, value:ARG1) -> vgc_mem_write (space=gfx)
000000r 2               GFN_GSAVE            = $A4  ; (space:ARG0, addr:ARG1, len:ARG2, BYTES name:ARG3) -> fio_gsave
000000r 2               GFN_GLOAD            = $A5  ; (space:ARG0, addr:ARG1, len:ARG2, BYTES name:ARG3) -> fio_gload
000000r 2               GFN_NVGLOAD          = $A6  ; (BYTES name:ARG0)                  -> nvg_load (offset 0)
000000r 2               GFN_NVGLOAD_AT       = $A7  ; (BYTES name:ARG0, dest:ARG1)       -> nvg_load_at
000000r 2               GFN_NVGLOAD_NAMED    = $A8  ; (BYTES name:ARG0)                  -> nvg_load_named (named-arg path)
000000r 2               GFN_NVGLOAD_NAMED_AT = $A9  ; (BYTES name:ARG0, dest:ARG1)       -> nvg_load_named_at
000000r 2               ;             $AA-$AF reserved
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $B0-$BF  turtle-render  (the rendering ops the resident turtle calls in 4c)
000000r 2               ;   draw-line / draw+rotate turtle-icon sprite / erase-icon / ensure-gfx-mode
000000r 2               ; (constants filled in batch 4b.10)
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $C0-$CF  anim  (driver: runtime/asm/anim.s — batch 4b.11) — superset
000000r 2               ; extension beyond design §2.
000000r 2               ;   init/start/stop/tick/tick_one/set_frame/load_xram_shapes/load_disk_shapes
000000r 2               ;
000000r 2               ; Track-based sprite animation. The driver keeps an 8-track table + a set of
000000r 2               ; descriptor/target/shape-load pseudo-registers in its module-owned BSS block
000000r 2               ; (ANIM_DESC_L/H, ANIM_TARGET, ANIM_TARGET_TYPE, ANIM_SHAPE, ANIM_COUNT,
000000r 2               ; ANIM_XADDR*, ANIM_FILE*, ANIM_NAME*). The wrappers marshal the ARG cells into
000000r 2               ; those BSS cells, JSR the driver entry, then map the result. anim pulls dma/fio/
000000r 2               ; pager/msprite — all already co-assembled by earlier batches (dedup'd by the
000000r 2               ; .ifndef guards), pager.s is the one new dependency (CODE only, ZP via NVR*
000000r 2               ; aliases). The descriptor for ANIM.START stays RESIDENT in caller RAM: ARG0 is a
000000r 2               ; BYTES arg whose ptr16 (low word) is written straight into ANIM_DESC_L/H.
000000r 2               ;
000000r 2               ; Arg-register conventions, VERIFIED against runtime/asm/anim.inc + anim.s
000000r 2               ; (@in/@out/@requires):
000000r 2               ;
000000r 2               ;   START reads ANIM_DESC_L/H + ANIM_TARGET + ANIM_TARGET_TYPE and returns the
000000r 2               ;   new track handle in A ($FF on failure). The wrapper publishes the handle to
000000r 2               ;   LIB_RESULT byte 0 and maps $FF -> LERR_ANIM_FAIL, else LERR_OK
000000r 2               ;   (finish_anim_start).
000000r 2               ;
000000r 2               ;   Per-track ops take the track HANDLE in A and return a result code in A
000000r 2               ;   (0 = OK); the wrapper publishes A to LIB_RESULT byte 0 and maps A!=0 ->
000000r 2               ;   LERR_ANIM_FAIL (finish_anim). SET_FRAME additionally takes the frame in X.
000000r 2               ;
000000r 2               ;   INIT/TICK always return A=0 -> OK (finish_anim too).
000000r 2               ;
000000r 2               ;   LOAD_XRAM_SHAPES / LOAD_DISK_SHAPES read the shape-load pseudo-registers and
000000r 2               ;   return A=0/1; finish_anim maps A!=0 -> LERR_ANIM_FAIL.
000000r 2               ;
000000r 2               ; None of the anim ops issue a VGC *command* on the wrapper's behalf (the shape
000000r 2               ; loaders drive DMA/pager which self-wait inside the driver), so the wrappers
000000r 2               ; need no command wait.
000000r 2               LERR_ANIM_FAIL = $88   ; anim driver returned a non-OK result / $FF handle
000000r 2               
000000r 2               ; Layouts (ARGn low word unless noted; BYTES args pack ptr16 low / len16 high):
000000r 2               GFN_ANIM_INIT        = $C0  ; ()                                  -> anim_init (A=0)
000000r 2               GFN_ANIM_START       = $C1  ; (BYTES desc:ARG0, target:ARG1, type:ARG2)
000000r 2                                           ;   -> ANIM_DESC_L/H, ANIM_TARGET, ANIM_TARGET_TYPE; anim_start
000000r 2                                           ;   RESULT byte 0 = track handle (A); $FF -> LERR_ANIM_FAIL
000000r 2               GFN_ANIM_STOP        = $C2  ; (handle:ARG0)                       -> A; anim_stop
000000r 2               GFN_ANIM_TICK        = $C3  ; ()                                  -> anim_tick (A=0)
000000r 2               GFN_ANIM_TICK_ONE    = $C4  ; (handle:ARG0)                       -> A; anim_tick_one
000000r 2               GFN_ANIM_SET_FRAME   = $C5  ; (handle:ARG0, frame:ARG1)           -> A, X; anim_set_frame
000000r 2               GFN_ANIM_LOAD_XRAM   = $C6  ; (shape:ARG0, count:ARG1, xaddr24:ARG2)
000000r 2                                           ;   -> ANIM_SHAPE, ANIM_COUNT, ANIM_XADDRL/M/H; anim_load_xram_shapes
000000r 2               GFN_ANIM_LOAD_DISK   = $C7  ; (shape:ARG0, count:ARG1, file24:ARG2, BYTES name:ARG3)
000000r 2                                           ;   -> ANIM_SHAPE, ANIM_COUNT, ANIM_FILEL/M/H,
000000r 2                                           ;      ANIM_NAMEPTR_L/H + ANIM_NAMELEN; anim_load_disk_shapes
000000r 2               ;             $C8-$CF reserved
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; $D0-$DF  tween (driver: runtime/asm/tween.s — batch 4b.11) — superset
000000r 2               ; extension beyond design §2.
000000r 2               ;   begin / eval{,_linear,_ease_in,_ease_out,_ease_in_out} /
000000r 2               ;          step{,_linear,_ease_in,_ease_out,_ease_in_out}
000000r 2               ;
000000r 2               ; Pure 16-bit easing math; no hardware. All state lives in the driver's
000000r 2               ; module-owned TWEEN_* BSS cells: software writes START/END/DURATION/FRAME/MODE,
000000r 2               ; evaluates, then reads VALUEL/H, DONE, PROGRESS, EASE. This is the register-
000000r 2               ; shaped ABI documented in tween.inc.
000000r 2               ;
000000r 2               ; MARSHALLING (uniform across every tween op, VERIFIED against tween.s
000000r 2               ; @requires): the wrapper loads the five input cells from the ARG cells before
000000r 2               ; the driver runs:
000000r 2               ;   ARG0 low word  -> TWEEN_STARTL/H   (start value, s16)
000000r 2               ;   ARG1 low word  -> TWEEN_ENDL/H     (end value, s16)
000000r 2               ;   ARG2 byte0     -> TWEEN_DURATION   (frames; 0 snaps to end)
000000r 2               ;   ARG2 byte1     -> TWEEN_MODE       (0 linear / 1 in / 2 out / 3 in-out)
000000r 2               ;   ARG3 byte0     -> TWEEN_FRAME      (current frame; step ops increment it)
000000r 2               ; The fixed-curve eval/step variants force TWEEN_MODE themselves, so ARG2 byte1
000000r 2               ; is a don't-care for those — but loading it uniformly is harmless.
000000r 2               ;
000000r 2               ; RESULT (reporter, VERIFIED against tween.s @out): after the driver runs the
000000r 2               ; wrapper packs the readbacks into LIB_RESULT (4-byte LE):
000000r 2               ;   byte 0 = TWEEN_VALUEL, byte 1 = TWEEN_VALUEH  (the 16-bit computed value),
000000r 2               ;   byte 2 = TWEEN_DONE    (non-zero at end),
000000r 2               ;   byte 3 = TWEEN_PROGRESS (normalized 0..255).
000000r 2               ; STATUS is always LERR_OK (the math never fails). TWEEN_EASE remains readable
000000r 2               ; via a direct cell peek for callers that need it; the 4-byte result carries the
000000r 2               ; three fields the contract calls for.
000000r 2               GFN_TWEEN_BEGIN            = $D0  ; (start:ARG0, end:ARG1, duration:ARG2) -> tween_begin
000000r 2               GFN_TWEEN_EVAL             = $D1  ; (start,end,dur,mode:ARG0..2, frame:ARG3) -> tween_eval
000000r 2               GFN_TWEEN_EVAL_LINEAR      = $D2  ; (start,end,dur:ARG0..2, frame:ARG3) -> tween_eval_linear
000000r 2               GFN_TWEEN_EVAL_EASE_IN     = $D3  ; (start,end,dur:ARG0..2, frame:ARG3) -> tween_eval_ease_in
000000r 2               GFN_TWEEN_EVAL_EASE_OUT    = $D4  ; (start,end,dur:ARG0..2, frame:ARG3) -> tween_eval_ease_out
000000r 2               GFN_TWEEN_EVAL_EASE_IN_OUT = $D5  ; (start,end,dur:ARG0..2, frame:ARG3) -> tween_eval_ease_in_out
000000r 2               GFN_TWEEN_STEP             = $D6  ; (start,end,dur,mode:ARG0..2, frame:ARG3) -> tween_step
000000r 2               GFN_TWEEN_STEP_LINEAR      = $D7  ; (start,end,dur:ARG0..2, frame:ARG3) -> tween_step_linear
000000r 2               GFN_TWEEN_STEP_EASE_IN     = $D8  ; (start,end,dur:ARG0..2, frame:ARG3) -> tween_step_ease_in
000000r 2               GFN_TWEEN_STEP_EASE_OUT    = $D9  ; (start,end,dur:ARG0..2, frame:ARG3) -> tween_step_ease_out
000000r 2               GFN_TWEEN_STEP_EASE_IN_OUT = $DA  ; (start,end,dur:ARG0..2, frame:ARG3) -> tween_step_ease_in_out
000000r 2               ;             $DB-$DF reserved
000000r 2               
000000r 2               .endif
000000r 2               
000000r 1                     .include "ext_iface.inc"
000000r 2               ; ext_iface.inc — shared interface between NovaLogo base ROM and extension ROM
000000r 2               ;
000000r 2               ; These equates define the ZP mailbox used to pass arguments and results
000000r 2               ; between the base ROM and the extension ROM via the RAM trampoline.
000000r 2               ; Both ROMs include this file so addresses are always consistent.
000000r 2               ;
000000r 2               ; Addresses $80-$91 are outside the linker-managed ZEROPAGE segment
000000r 2               ; but inside true zero page RAM, accessible to both ROM banks.
000000r 2               
000000r 2               ; --- Command and argument count ---
000000r 2               EXT_CMD         = $80           ; command ID (set by base ROM before trampoline call)
000000r 2               EXT_ARGC        = $81           ; argument count
000000r 2               
000000r 2               ; --- Argument 0 ---
000000r 2               EXT_ARG0_TYPE   = $82           ; type: VAL_NUMBER=$00, VAL_WORD=$01, VAL_LIST=$02
000000r 2               EXT_ARG0_HI     = $83           ; value high byte
000000r 2               EXT_ARG0_LO     = $84           ; value low byte
000000r 2               EXT_ARG0_FRAC   = $85           ; fractional byte (16.8 fixed point)
000000r 2               
000000r 2               ; --- Argument 1 ---
000000r 2               EXT_ARG1_TYPE   = $86
000000r 2               EXT_ARG1_HI     = $87
000000r 2               EXT_ARG1_LO     = $88
000000r 2               EXT_ARG1_FRAC   = $89
000000r 2               
000000r 2               ; --- Argument 2 ---
000000r 2               EXT_ARG2_TYPE   = $8A
000000r 2               EXT_ARG2_HI     = $8B
000000r 2               EXT_ARG2_LO     = $8C
000000r 2               EXT_ARG2_FRAC   = $8D
000000r 2               
000000r 2               ; --- Result ---
000000r 2               EXT_RESULT_TYPE = $8E           ; return value type
000000r 2               EXT_RESULT_HI   = $8F           ; return value high byte
000000r 2               EXT_RESULT_LO   = $90           ; return value low byte
000000r 2               EXT_RESULT_FRAC = $91           ; return value fractional byte
000000r 2               
000000r 2               ; --- Command IDs ---
000000r 2               EXT_CMD_TEST    = $01           ; test command: returns arg0 + 1
000000r 2               EXT_CMD_FD      = $10           ; FD distance — move forward
000000r 2               EXT_CMD_BK      = $11           ; BK distance — move backward
000000r 2               EXT_CMD_RT      = $12           ; RT degrees — turn right
000000r 2               EXT_CMD_LT      = $13           ; LT degrees — turn left
000000r 2               EXT_CMD_CS      = $14           ; CS — clear screen, init turtle
000000r 2               EXT_CMD_PU      = $15           ; PU — pen up
000000r 2               EXT_CMD_PD      = $16           ; PD — pen down
000000r 2               EXT_CMD_ST      = $17           ; ST — show turtle
000000r 2               EXT_CMD_HT      = $18           ; HT — hide turtle
000000r 2               EXT_CMD_HOME    = $19           ; HOME — move to center, heading 0
000000r 2               EXT_CMD_TS      = $1A           ; TEXTSCREEN — full text mode
000000r 2               EXT_CMD_SS      = $1B           ; SPLITSCREEN — copper split
000000r 2               EXT_CMD_FS      = $1C           ; FULLSCREEN — full graphics mode
000000r 2               EXT_CMD_SETXY   = $1D           ; SETXY x y — move to position
000000r 2               EXT_CMD_SETX    = $1E           ; SETX x — set X only
000000r 2               EXT_CMD_SETY    = $1F           ; SETY y — set Y only
000000r 2               EXT_CMD_SETH    = $20           ; SETHEADING — set heading degrees
000000r 2               EXT_CMD_XCOR    = $21           ; XCOR — report turtle X
000000r 2               EXT_CMD_YCOR    = $22           ; YCOR — report turtle Y
000000r 2               EXT_CMD_HEADING = $23           ; HEADING — report heading degrees
000000r 2               EXT_CMD_PENDOWNP = $24          ; PENDOWN? — report pen state
000000r 2               EXT_CMD_SHOWNP  = $25           ; SHOWN? — report visibility
000000r 2               EXT_CMD_SETPC   = $26           ; SETPC color — set pen color
000000r 2               EXT_CMD_SETBG   = $27           ; SETBG color — set background color
000000r 2               EXT_CMD_TOWARDS = $28           ; TOWARDS x y — heading towards point
000000r 2               EXT_CMD_SETPOS  = $29           ; SETPOS [x y] — move to position from list
000000r 2               
000000r 2               ; --- VGC graphics commands ---
000000r 2               EXT_CMD_SETCOLOR = $30          ; SETCOLOR color — set VGC draw color
000000r 2               EXT_CMD_PLOT     = $31          ; PLOT x y — plot pixel
000000r 2               EXT_CMD_UNPLOT   = $32          ; UNPLOT x y — clear pixel
000000r 2               EXT_CMD_LINE     = $33          ; LINE x1 y1 x2 y2 — draw line
000000r 2               EXT_CMD_CIRCLE   = $34          ; CIRCLE x y r — draw circle
000000r 2               EXT_CMD_RECT     = $35          ; RECT x1 y1 x2 y2 — draw rectangle
000000r 2               EXT_CMD_FILLRECT = $36          ; FILL x1 y1 x2 y2 — filled rectangle
000000r 2               EXT_CMD_PAINT    = $37          ; PAINT x y — flood fill
000000r 2               
000000r 2               ; --- Sprite commands ---
000000r 2               EXT_CMD_SPRITE   = $40          ; SPRITE n x y — position and enable
000000r 2               EXT_CMD_SPRITEPOS = $41         ; SPRITEPOS n x y — reposition
000000r 2               EXT_CMD_SPRITEON = $42          ; SPRITEON n — enable sprite
000000r 2               EXT_CMD_SPRITEOFF = $43         ; SPRITEOFF n — disable sprite
000000r 2               EXT_CMD_SPRCOLLP = $44          ; SPRITECOLLISION? n — collision query
000000r 2               
000000r 2               ; --- Sound commands ---
000000r 2               EXT_CMD_TONE     = $45          ; TONE freq dur — play tone
000000r 2               EXT_CMD_NOISE    = $46          ; NOISE dur — noise burst
000000r 2               EXT_CMD_VOLUME   = $47          ; VOLUME vol — set SID master volume
000000r 2               
000000r 2               ; --- Timing commands ---
000000r 2               EXT_CMD_WAIT     = $48          ; WAIT n — wait N frames
000000r 2               EXT_CMD_WAITVBL  = $49          ; WAITVBL — wait for next VBL
000000r 2               EXT_CMD_TIMER    = $4A          ; TIMER — return frame counter
000000r 2               
000000r 2               ; --- Editor command ---
000000r 2               ; EXT_CMD_EDIT — open the shared EDITUI/EDITBUF editor on a RAM text buffer.
000000r 2               ;   In:  ARG0 = buffer ptr (lo/hi)   ARG1 = current length (lo/hi)
000000r 2               ;        ARG2 = capacity (lo/hi)     ARG3 = NUL-terminated title ptr (lo/hi)
000000r 2               ;        ARG2_FRAC:ARG3_FRAC = initial cursor byte offset (lo:hi) — the unused
000000r 2               ;        fractional bytes of the cap/title pointer args carry the cursor.
000000r 2               ;   Out: RESULT_LO = editbuf exit reason (EDITBUF_EXIT_*)
000000r 2               ;        RESULT_HI = nonzero if the user requested a save (Ctrl-S / "Save First")
000000r 2               ;        ARG1 (lo/hi) = final buffer length
000000r 2               EXT_CMD_EDIT     = $4B          ; EDIT — run the shared text editor
000000r 2               
000000r 2               ; --- Value types (match eval_type in eval.s) ---
000000r 2               .ifndef VAL_NUMBER
000000r 2               VAL_NUMBER      = $00
000000r 2               .endif
000000r 2               .ifndef VAL_WORD
000000r 2               VAL_WORD        = $01
000000r 2               .endif
000000r 2               .ifndef VAL_LIST
000000r 2               VAL_LIST        = $02
000000r 2               .endif
000000r 2               
000000r 2               ; --- Legacy turtle state ZP addresses ---
000000r 2               ; Extension ROMs that define NOVALOGO_TURTLE_STATE_EXTERNAL provide their own
000000r 2               ; persistent turtle storage and only use this file for the mailbox ABI.
000000r 2               .ifndef NOVALOGO_TURTLE_STATE_EXTERNAL
000000r 2               TURTLE_X_FRAC   = $92
000000r 2               TURTLE_X_LO     = $93
000000r 2               TURTLE_X_HI     = $94
000000r 2               TURTLE_Y_FRAC   = $95
000000r 2               TURTLE_Y_LO     = $96
000000r 2               TURTLE_Y_HI     = $97
000000r 2               TURTLE_HEADING_LO = $98
000000r 2               TURTLE_HEADING_HI = $99
000000r 2               TURTLE_PEN      = $9A
000000r 2               TURTLE_SHOWN    = $9B
000000r 2               TURTLE_COLOR    = $9C
000000r 2               TURTLE_SPRITE   = $9D
000000r 2               TURTLE_INITED   = $9E
000000r 2               .endif
000000r 2               
000000r 2               ; --- Argument 3 (for 4+ arg commands like LINE, RECT, FILL) ---
000000r 2               EXT_ARG3_TYPE   = $9F
000000r 2               EXT_ARG3_HI     = $A0
000000r 2               EXT_ARG3_LO     = $A1
000000r 2               EXT_ARG3_FRAC   = $A2
000000r 2               
000000r 2               ; --- Trampoline location in RAM ---
000000r 2               EXT_TRAMPOLINE  = $0270         ; RAM address where trampoline code is copied
000000r 2               EXT_TRAMP_SIZE  = 14            ; size of trampoline code in bytes
000000r 2               
000000r 1                     .include "heap.s"
000000r 2               ; heap.s — bump allocator with GC headers for NovaLogo
000000r 2               ; Heap range: $0500 to HEAP_END-1.
000000r 2               ; $0300-$031F = cross-runtime library mailbox (libabi.inc LIB_MBOX);
000000r 2               ; $0320-$041F = resident library loader band (libcall.s). Both reserved.
000000r 2               
000000r 2               HEAP_START = $0500
000000r 2               HEAP_END   = $9800          ; one past last usable byte. $9800-$9BFF = editor BSS
000000r 2                                           ; (extension), $9C00-$9F10 = pinned turtle work+state.
000000r 2               
000000r 2               ; =====================================================================
000000r 2               ; ZEROPAGE segment — heap and general-purpose pointer variables
000000r 2               ; =====================================================================
000000r 2                     .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        heap_ptr:     .res 2          ; current heap allocation pointer
000002r 2  xx           ptr_lo:       .res 1          ; general-purpose pointer (low byte)
000003r 2  xx           ptr_hi:       .res 1          ; general-purpose pointer (high byte)
000004r 2               
000004r 2               ; =====================================================================
000004r 2               ; BSS segment — heap scratch
000004r 2               ; =====================================================================
000004r 2                     .segment "BSS"
000000r 2               
000000r 2  xx           ha_type:      .res 1          ; saved alloc type for heap_alloc
000001r 2  xx           ha_paysz:     .res 1          ; saved payload size for heap_alloc
000002r 2  xx           ha_gc_ran:    .res 1          ; flag: GC already attempted
000003r 2               
000003r 2               ; =====================================================================
000003r 2               ; CODE segment — heap routines
000003r 2               ; =====================================================================
000003r 2                     .segment "CODE"
000000r 2               
000000r 2               ; ---------------------------------------------------------------------
000000r 2               ; heap_init — reset heap to empty
000000r 2               ;   Clobbers: A
000000r 2               ; ---------------------------------------------------------------------
000000r 2               heap_init:
000000r 2  A9 00              LDA   #<HEAP_START
000002r 2  85 rr              STA   heap_ptr
000004r 2  A9 05              LDA   #>HEAP_START
000006r 2  85 rr              STA   heap_ptr+1
000008r 2  60                 RTS
000009r 2               
000009r 2               ; ---------------------------------------------------------------------
000009r 2               ; heap_alloc — allocate A bytes with a 2-byte GC header
000009r 2               ;   Input:  A = payload size (bytes the caller wants)
000009r 2               ;           X = allocation type (ATYPE_*)
000009r 2               ;   Output: ptr_lo/ptr_hi = pointer to payload (header is at -2)
000009r 2               ;           Carry clear = success, Carry set = out of memory
000009r 2               ;   Clobbers: A, X, Y
000009r 2               ;
000009r 2               ;   Header layout at (returned_ptr - 2):
000009r 2               ;     +0: alloc_tag  = type (bits 6-0), mark cleared (bit 7 = 0)
000009r 2               ;     +1: alloc_size = payload + 2
000009r 2               ; ---------------------------------------------------------------------
000009r 2               heap_alloc:
000009r 2  8D rr rr           STA   ha_paysz
00000Cr 2  8E rr rr           STX   ha_type
00000Fr 2  9C rr rr           STZ   ha_gc_ran
000012r 2               
000012r 2               @retry:
000012r 2                     ; total = payload + 2
000012r 2  AD rr rr           LDA   ha_paysz
000015r 2  18                 CLC
000016r 2  69 02              ADC   #GC_HDR_BYTES
000018r 2               
000018r 2                     ; Save current heap_ptr → ptr_lo/hi (allocation base)
000018r 2  A6 rr              LDX   heap_ptr
00001Ar 2  86 rr              STX   ptr_lo
00001Cr 2  A6 rr              LDX   heap_ptr+1
00001Er 2  86 rr              STX   ptr_hi
000020r 2               
000020r 2                     ; Advance heap_ptr by total
000020r 2  18                 CLC
000021r 2  65 rr              ADC   heap_ptr
000023r 2  85 rr              STA   heap_ptr
000025r 2  A9 00              LDA   #0
000027r 2  65 rr              ADC   heap_ptr+1
000029r 2  85 rr              STA   heap_ptr+1
00002Br 2               
00002Br 2                     ; Check against HEAP_END
00002Br 2  C9 98              CMP   #>HEAP_END
00002Dr 2  90 21              BCC   @ok
00002Fr 2  D0 08              BNE   @oom
000031r 2  A5 rr              LDA   heap_ptr
000033r 2  C9 00              CMP   #<HEAP_END
000035r 2  90 19              BCC   @ok
000037r 2  F0 17              BEQ   @ok
000039r 2               
000039r 2               @oom:
000039r 2                     ; Restore heap_ptr
000039r 2  A5 rr              LDA   ptr_lo
00003Br 2  85 rr              STA   heap_ptr
00003Dr 2  A5 rr              LDA   ptr_hi
00003Fr 2  85 rr              STA   heap_ptr+1
000041r 2               
000041r 2                     ; Already tried GC?
000041r 2  AD rr rr           LDA   ha_gc_ran
000044r 2  D0 08              BNE   @fail
000046r 2  EE rr rr           INC   ha_gc_ran
000049r 2               
000049r 2                     ; Run GC and retry
000049r 2  20 rr rr           JSR   gc_collect
00004Cr 2  80 C4              BRA   @retry
00004Er 2               
00004Er 2               @fail:
00004Er 2  38                 SEC
00004Fr 2  60                 RTS
000050r 2               
000050r 2               @ok:
000050r 2                     ; Write header at allocation base (ptr_lo/hi)
000050r 2  A0 00              LDY   #GC_HDR_TAG
000052r 2  AD rr rr           LDA   ha_type
000055r 2  91 rr              STA   (ptr_lo),Y
000057r 2               
000057r 2  A0 01              LDY   #GC_HDR_SIZE
000059r 2  AD rr rr           LDA   ha_paysz
00005Cr 2  18                 CLC
00005Dr 2  69 02              ADC   #GC_HDR_BYTES
00005Fr 2  91 rr              STA   (ptr_lo),Y
000061r 2               
000061r 2                     ; Advance ptr_lo/hi past header → payload pointer
000061r 2  18                 CLC
000062r 2  A5 rr              LDA   ptr_lo
000064r 2  69 02              ADC   #GC_HDR_BYTES
000066r 2  85 rr              STA   ptr_lo
000068r 2  A5 rr              LDA   ptr_hi
00006Ar 2  69 00              ADC   #0
00006Cr 2  85 rr              STA   ptr_hi
00006Er 2               
00006Er 2  18                 CLC
00006Fr 2  60                 RTS
000070r 2               
000070r 1                     .include "tokens.s"
000070r 2               ; tokens.s — token node format and constants for NovaLogo
000070r 2               
000070r 2               ; Token type constants
000070r 2               TOK_WORD     = $01            ; payload: length byte + chars
000070r 2               TOK_NUMBER   = $02            ; payload: 3 bytes (hi, lo, frac) — 16.8 fixed-point
000070r 2               TOK_LBRACKET = $03            ; no payload
000070r 2               TOK_RBRACKET = $04            ; no payload
000070r 2               TOK_VARREF   = $05            ; payload: length byte + chars (name after :)
000070r 2               TOK_QUOTE    = $06            ; payload: length byte + chars (word after ")
000070r 2               TOK_INFIX    = $07            ; payload: 1 byte (operator char)
000070r 2               TOK_LPAREN   = $08            ; no payload
000070r 2               TOK_RPAREN   = $09            ; no payload
000070r 2               
000070r 2               ; Token node layout:
000070r 2               ;   Offset 0: tag byte (TOK_* constant)
000070r 2               ;   Offset 1: next pointer low byte
000070r 2               ;   Offset 2: next pointer high byte ($00/$00 = end of list)
000070r 2               ;   Offset 3+: payload (varies by type)
000070r 2               ;
000070r 2               ; Total size: 3 + payload_size
000070r 2               ;   TOK_WORD/VARREF/QUOTE: 3 + 1 + len (length byte + chars)
000070r 2               ;   TOK_NUMBER: 3 + 3 = 6 bytes
000070r 2               ;   TOK_LBRACKET/RBRACKET/LPAREN/RPAREN: 3 bytes (no payload)
000070r 2               ;   TOK_INFIX: 3 + 1 = 4 bytes
000070r 2               
000070r 2               TOK_TAG      = 0              ; offset to tag byte
000070r 2               TOK_NEXT_LO  = 1              ; offset to next pointer low
000070r 2               TOK_NEXT_HI  = 2              ; offset to next pointer high
000070r 2               TOK_PAYLOAD  = 3              ; offset to start of payload
000070r 2               
000070r 1                     .include "tokenizer.s"
000070r 2               ; tokenizer.s — scan input_buf into a linked list of token nodes
000070r 2               
000070r 2               ; =====================================================================
000070r 2               ; ZEROPAGE segment — tokenizer variables
000070r 2               ; =====================================================================
000070r 2                     .segment "ZEROPAGE"
000004r 2               
000004r 2  xx           tok_head_lo:  .res 1          ; head of token list (first token)
000005r 2  xx           tok_head_hi:  .res 1
000006r 2  xx           tok_tail_lo:  .res 1          ; tail of token list (for appending)
000007r 2  xx           tok_tail_hi:  .res 1
000008r 2  xx           tok_src:      .res 1          ; current scan position in input_buf
000009r 2  xx           ptr2_lo:      .res 1          ; second general-purpose pointer (low byte)
00000Ar 2  xx           ptr2_hi:      .res 1          ; second general-purpose pointer (high byte)
00000Br 2  xx           tok_sign:     .res 1          ; sign flag for number parsing (0=pos, 1=neg)
00000Cr 2               
00000Cr 2               ; =====================================================================
00000Cr 2               ; BSS segment — scratch for number parsing
00000Cr 2               ; =====================================================================
00000Cr 2                     .segment "BSS"
000003r 2               
000003r 2  xx           num_val_lo:   .res 1          ; integer accumulator low
000004r 2  xx           num_val_hi:   .res 1          ; integer accumulator high
000005r 2  xx           num_tmp_lo:   .res 1          ; temp for multiply / frac result
000006r 2  xx           num_tmp_hi:   .res 1          ; temp for multiply / frac raw
000007r 2               
000007r 2               ; =====================================================================
000007r 2               ; CODE segment — tokenizer routines
000007r 2               ; =====================================================================
000007r 2                     .segment "CODE"
000070r 2               
000070r 2               ; ---------------------------------------------------------------------
000070r 2               ; tokenize_line — scan input_buf and build a linked list of tokens
000070r 2               ;   Input:  input_buf contains null-terminated text
000070r 2               ;   Output: tok_head_lo/hi = first token ($0000 if empty line)
000070r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi
000070r 2               ; ---------------------------------------------------------------------
000070r 2               tokenize_line:
000070r 2  64 rr              STZ   tok_head_lo
000072r 2  64 rr              STZ   tok_head_hi
000074r 2  64 rr              STZ   tok_tail_lo
000076r 2  64 rr              STZ   tok_tail_hi
000078r 2  64 rr              STZ   tok_src
00007Ar 2                     ; fall through to scan loop
00007Ar 2               
00007Ar 2               ; Non-local entry for scan loop — reachable from all routines
00007Ar 2               tok_scan_next:
00007Ar 2                     ; --- skip whitespace ---
00007Ar 2  A6 rr              LDX   tok_src
00007Cr 2               @skip_ws:
00007Cr 2  BD rr rr           LDA   input_buf,X
00007Fr 2  C9 20              CMP   #$20                 ; space
000081r 2  F0 12              BEQ   @ws_next
000083r 2  C9 09              CMP   #$09                 ; tab
000085r 2  F0 0E              BEQ   @ws_next
000087r 2  C9 0A              CMP   #$0A                 ; newline
000089r 2  F0 0A              BEQ   @ws_next
00008Br 2  C9 0D              CMP   #$0D                 ; carriage return
00008Dr 2  F0 06              BEQ   @ws_next
00008Fr 2  C9 3B              CMP   #';'                 ; comment -> skip to end of line
000091r 2  F0 05              BEQ   @ws_comment
000093r 2  80 0F              BRA   @ws_done
000095r 2               @ws_next:
000095r 2  E8                 INX
000096r 2  80 E4              BRA   @skip_ws
000098r 2               @ws_comment:
000098r 2  E8                 INX
000099r 2  BD rr rr           LDA   input_buf,X
00009Cr 2  F0 06              BEQ   @ws_done             ; null terminator -> end of input (A=0)
00009Er 2  C9 0A              CMP   #$0A
0000A0r 2  D0 F6              BNE   @ws_comment
0000A2r 2  80 F1              BRA   @ws_next             ; skip the newline, keep scanning
0000A4r 2               @ws_done:
0000A4r 2  86 rr              STX   tok_src
0000A6r 2               
0000A6r 2                     ; --- check for end of input ---
0000A6r 2  C9 00              CMP   #0
0000A8r 2  D0 01              BNE   @not_end
0000AAr 2  60                 RTS                        ; done — list complete
0000ABr 2               @not_end:
0000ABr 2               
0000ABr 2                     ; --- colon → TOK_VARREF ---
0000ABr 2  C9 3A              CMP   #':'
0000ADr 2  D0 05              BNE   @not_colon
0000AFr 2  E6 rr              INC   tok_src              ; skip ':'
0000B1r 2  4C rr rr           JMP   tok_scan_varref
0000B4r 2               @not_colon:
0000B4r 2               
0000B4r 2                     ; --- quote → TOK_QUOTE ---
0000B4r 2  C9 22              CMP   #'"'
0000B6r 2  D0 05              BNE   @not_quote
0000B8r 2  E6 rr              INC   tok_src              ; skip '"'
0000BAr 2  4C rr rr           JMP   tok_scan_quote
0000BDr 2               @not_quote:
0000BDr 2               
0000BDr 2                     ; --- brackets ---
0000BDr 2  C9 5B              CMP   #'['
0000BFr 2  D0 05              BNE   @not_lb
0000C1r 2  A9 03              LDA   #TOK_LBRACKET
0000C3r 2  4C rr rr           JMP   tok_emit_simple
0000C6r 2               @not_lb:
0000C6r 2  C9 5D              CMP   #']'
0000C8r 2  D0 05              BNE   @not_rb
0000CAr 2  A9 04              LDA   #TOK_RBRACKET
0000CCr 2  4C rr rr           JMP   tok_emit_simple
0000CFr 2               @not_rb:
0000CFr 2               
0000CFr 2                     ; --- parens ---
0000CFr 2  C9 28              CMP   #'('
0000D1r 2  D0 05              BNE   @not_lp
0000D3r 2  A9 08              LDA   #TOK_LPAREN
0000D5r 2  4C rr rr           JMP   tok_emit_simple
0000D8r 2               @not_lp:
0000D8r 2  C9 29              CMP   #')'
0000DAr 2  D0 05              BNE   @not_rp
0000DCr 2  A9 09              LDA   #TOK_RPAREN
0000DEr 2  4C rr rr           JMP   tok_emit_simple
0000E1r 2               @not_rp:
0000E1r 2               
0000E1r 2                     ; --- infix operators (not minus) ---
0000E1r 2  C9 2B              CMP   #'+'
0000E3r 2  F0 16              BEQ   @is_infix
0000E5r 2  C9 2A              CMP   #'*'
0000E7r 2  F0 12              BEQ   @is_infix
0000E9r 2  C9 2F              CMP   #'/'
0000EBr 2  F0 0E              BEQ   @is_infix
0000EDr 2  C9 3C              CMP   #'<'
0000EFr 2  F0 0A              BEQ   @is_infix
0000F1r 2  C9 3E              CMP   #'>'
0000F3r 2  F0 06              BEQ   @is_infix
0000F5r 2  C9 3D              CMP   #'='
0000F7r 2  F0 02              BEQ   @is_infix
0000F9r 2  80 03              BRA   @not_infix
0000FBr 2               @is_infix:
0000FBr 2  4C rr rr           JMP   tok_emit_infix
0000FEr 2               @not_infix:
0000FEr 2               
0000FEr 2                     ; --- minus: could be infix or negative number ---
0000FEr 2  C9 2D              CMP   #'-'
000100r 2  D0 15              BNE   @not_minus
000102r 2                     ; peek at next character
000102r 2  A6 rr              LDX   tok_src
000104r 2  BD rr rr           LDA   input_buf+1,X
000107r 2  C9 30              CMP   #'0'
000109r 2  90 04              BCC   @minus_infix
00010Br 2  C9 3A              CMP   #'9'+1
00010Dr 2  90 05              BCC   @minus_number
00010Fr 2               @minus_infix:
00010Fr 2  A9 2D              LDA   #'-'
000111r 2  4C rr rr           JMP   tok_emit_infix
000114r 2               @minus_number:
000114r 2  4C rr rr           JMP   tok_parse_number
000117r 2               @not_minus:
000117r 2               
000117r 2                     ; --- digit → TOK_NUMBER ---
000117r 2  C9 30              CMP   #'0'
000119r 2  90 04              BCC   @not_digit
00011Br 2  C9 3A              CMP   #'9'+1
00011Dr 2  90 03              BCC   @is_digit
00011Fr 2               @not_digit:
00011Fr 2               
00011Fr 2                     ; --- default: TOK_WORD ---
00011Fr 2  4C rr rr           JMP   tok_scan_word
000122r 2               
000122r 2               @is_digit:
000122r 2  4C rr rr           JMP   tok_parse_number
000125r 2               
000125r 2               ; ---------------------------------------------------------------------
000125r 2               ; tok_emit_simple — emit a 3-byte node (tag only, no payload)
000125r 2               ;   Input: A = tag byte, tok_src points at the character
000125r 2               ; ---------------------------------------------------------------------
000125r 2               tok_emit_simple:
000125r 2  48                 PHA                        ; save tag
000126r 2  A9 03              LDA   #3
000128r 2  A2 01              LDX   #ATYPE_TOKEN
00012Ar 2  20 rr rr           JSR   heap_alloc
00012Dr 2  B0 13              BCS   @oom
00012Fr 2  68                 PLA
000130r 2  A0 00              LDY   #TOK_TAG
000132r 2  91 rr              STA   (ptr_lo),Y
000134r 2  A0 01              LDY   #TOK_NEXT_LO
000136r 2  A9 00              LDA   #0
000138r 2  91 rr              STA   (ptr_lo),Y
00013Ar 2  C8                 INY
00013Br 2  91 rr              STA   (ptr_lo),Y
00013Dr 2  E6 rr              INC   tok_src              ; advance past the character
00013Fr 2  4C rr rr           JMP   tok_append_node
000142r 2               @oom:
000142r 2  68                 PLA
000143r 2  60                 RTS
000144r 2               
000144r 2               ; ---------------------------------------------------------------------
000144r 2               ; tok_emit_infix — emit a 4-byte node (tag + operator char)
000144r 2               ;   Input: A = operator character, tok_src points at the operator
000144r 2               ; ---------------------------------------------------------------------
000144r 2               tok_emit_infix:
000144r 2  48                 PHA                        ; save operator char
000145r 2  A9 04              LDA   #4
000147r 2  A2 01              LDX   #ATYPE_TOKEN
000149r 2  20 rr rr           JSR   heap_alloc
00014Cr 2  B0 19              BCS   @oom
00014Er 2  A0 00              LDY   #TOK_TAG
000150r 2  A9 07              LDA   #TOK_INFIX
000152r 2  91 rr              STA   (ptr_lo),Y
000154r 2  A0 01              LDY   #TOK_NEXT_LO
000156r 2  A9 00              LDA   #0
000158r 2  91 rr              STA   (ptr_lo),Y
00015Ar 2  C8                 INY
00015Br 2  91 rr              STA   (ptr_lo),Y
00015Dr 2  A0 03              LDY   #TOK_PAYLOAD
00015Fr 2  68                 PLA
000160r 2  91 rr              STA   (ptr_lo),Y
000162r 2  E6 rr              INC   tok_src
000164r 2  4C rr rr           JMP   tok_append_node
000167r 2               @oom:
000167r 2  68                 PLA
000168r 2  60                 RTS
000169r 2               
000169r 2               ; ---------------------------------------------------------------------
000169r 2               ; tok_scan_word — scan a word into TOK_WORD (uppercased)
000169r 2               ;   tok_src points at first character
000169r 2               ; ---------------------------------------------------------------------
000169r 2               tok_scan_word:
000169r 2  A6 rr              LDX   tok_src
00016Br 2  A0 00              LDY   #0                   ; length counter
00016Dr 2               @count:
00016Dr 2  BD rr rr           LDA   input_buf,X
000170r 2  20 rr rr           JSR   is_word_char
000173r 2  90 04              BCC   @counted
000175r 2  E8                 INX
000176r 2  C8                 INY
000177r 2  80 F4              BRA   @count
000179r 2               @counted:
000179r 2  98                 TYA
00017Ar 2  F0 53              BEQ   @empty
00017Cr 2  48                 PHA                        ; save length
00017Dr 2  18                 CLC
00017Er 2  69 04              ADC   #4                   ; node = 3 header + 1 length + chars
000180r 2  A2 01              LDX   #ATYPE_TOKEN
000182r 2  20 rr rr           JSR   heap_alloc
000185r 2  B0 47              BCS   @oom
000187r 2                     ; tag
000187r 2  A0 00              LDY   #TOK_TAG
000189r 2  A9 01              LDA   #TOK_WORD
00018Br 2  91 rr              STA   (ptr_lo),Y
00018Dr 2                     ; next = null
00018Dr 2  A0 01              LDY   #TOK_NEXT_LO
00018Fr 2  A9 00              LDA   #0
000191r 2  91 rr              STA   (ptr_lo),Y
000193r 2  C8                 INY
000194r 2  91 rr              STA   (ptr_lo),Y
000196r 2                     ; length byte
000196r 2  68                 PLA
000197r 2  48                 PHA
000198r 2  A0 03              LDY   #TOK_PAYLOAD
00019Ar 2  91 rr              STA   (ptr_lo),Y
00019Cr 2                     ; copy chars with uppercasing
00019Cr 2  68                 PLA
00019Dr 2  AA                 TAX                        ; X = remaining
00019Er 2  A0 04              LDY   #TOK_PAYLOAD+1       ; Y = dest offset
0001A0r 2  9C rr rr           STZ   num_tmp_lo           ; source offset from tok_src
0001A3r 2               @copy:
0001A3r 2  DA                 PHX
0001A4r 2  AD rr rr           LDA   num_tmp_lo
0001A7r 2  18                 CLC
0001A8r 2  65 rr              ADC   tok_src
0001AAr 2  AA                 TAX
0001ABr 2  BD rr rr           LDA   input_buf,X
0001AEr 2  C9 61              CMP   #'a'
0001B0r 2  90 07              BCC   @noup
0001B2r 2  C9 7B              CMP   #'z'+1
0001B4r 2  B0 03              BCS   @noup
0001B6r 2  38                 SEC
0001B7r 2  E9 20              SBC   #$20
0001B9r 2               @noup:
0001B9r 2  91 rr              STA   (ptr_lo),Y
0001BBr 2  C8                 INY
0001BCr 2  EE rr rr           INC   num_tmp_lo
0001BFr 2  FA                 PLX
0001C0r 2  CA                 DEX
0001C1r 2  D0 E0              BNE   @copy
0001C3r 2                     ; advance tok_src
0001C3r 2  AD rr rr           LDA   num_tmp_lo
0001C6r 2  18                 CLC
0001C7r 2  65 rr              ADC   tok_src
0001C9r 2  85 rr              STA   tok_src
0001CBr 2  4C rr rr           JMP   tok_append_node
0001CEr 2               @oom:
0001CEr 2  68                 PLA
0001CFr 2               @empty:
0001CFr 2  60                 RTS
0001D0r 2               
0001D0r 2               ; ---------------------------------------------------------------------
0001D0r 2               ; tok_scan_varref — scan TOK_VARREF after ':'
0001D0r 2               ;   tok_src points at first char after ':'
0001D0r 2               ; ---------------------------------------------------------------------
0001D0r 2               tok_scan_varref:
0001D0r 2  A6 rr              LDX   tok_src
0001D2r 2  A0 00              LDY   #0
0001D4r 2               @count:
0001D4r 2  BD rr rr           LDA   input_buf,X
0001D7r 2  20 rr rr           JSR   is_word_char
0001DAr 2  90 04              BCC   @counted
0001DCr 2  E8                 INX
0001DDr 2  C8                 INY
0001DEr 2  80 F4              BRA   @count
0001E0r 2               @counted:
0001E0r 2  98                 TYA
0001E1r 2  F0 53              BEQ   @empty
0001E3r 2  48                 PHA
0001E4r 2  18                 CLC
0001E5r 2  69 04              ADC   #4
0001E7r 2  A2 01              LDX   #ATYPE_TOKEN
0001E9r 2  20 rr rr           JSR   heap_alloc
0001ECr 2  B0 47              BCS   @oom
0001EEr 2  A0 00              LDY   #TOK_TAG
0001F0r 2  A9 05              LDA   #TOK_VARREF
0001F2r 2  91 rr              STA   (ptr_lo),Y
0001F4r 2  A0 01              LDY   #TOK_NEXT_LO
0001F6r 2  A9 00              LDA   #0
0001F8r 2  91 rr              STA   (ptr_lo),Y
0001FAr 2  C8                 INY
0001FBr 2  91 rr              STA   (ptr_lo),Y
0001FDr 2  68                 PLA
0001FEr 2  48                 PHA
0001FFr 2  A0 03              LDY   #TOK_PAYLOAD
000201r 2  91 rr              STA   (ptr_lo),Y
000203r 2  68                 PLA
000204r 2  AA                 TAX
000205r 2  A0 04              LDY   #TOK_PAYLOAD+1
000207r 2  9C rr rr           STZ   num_tmp_lo
00020Ar 2               @copy:
00020Ar 2  DA                 PHX
00020Br 2  AD rr rr           LDA   num_tmp_lo
00020Er 2  18                 CLC
00020Fr 2  65 rr              ADC   tok_src
000211r 2  AA                 TAX
000212r 2  BD rr rr           LDA   input_buf,X
000215r 2  C9 61              CMP   #'a'
000217r 2  90 07              BCC   @noup
000219r 2  C9 7B              CMP   #'z'+1
00021Br 2  B0 03              BCS   @noup
00021Dr 2  38                 SEC
00021Er 2  E9 20              SBC   #$20
000220r 2               @noup:
000220r 2  91 rr              STA   (ptr_lo),Y
000222r 2  C8                 INY
000223r 2  EE rr rr           INC   num_tmp_lo
000226r 2  FA                 PLX
000227r 2  CA                 DEX
000228r 2  D0 E0              BNE   @copy
00022Ar 2  AD rr rr           LDA   num_tmp_lo
00022Dr 2  18                 CLC
00022Er 2  65 rr              ADC   tok_src
000230r 2  85 rr              STA   tok_src
000232r 2  4C rr rr           JMP   tok_append_node
000235r 2               @oom:
000235r 2  68                 PLA
000236r 2               @empty:
000236r 2  60                 RTS
000237r 2               
000237r 2               ; ---------------------------------------------------------------------
000237r 2               ; tok_scan_quote — scan TOK_QUOTE after '"'
000237r 2               ;   tok_src points at first char after '"'
000237r 2               ; ---------------------------------------------------------------------
000237r 2               tok_scan_quote:
000237r 2  A6 rr              LDX   tok_src
000239r 2  A0 00              LDY   #0
00023Br 2               @count:
00023Br 2  BD rr rr           LDA   input_buf,X
00023Er 2  20 rr rr           JSR   is_word_char
000241r 2  90 04              BCC   @counted
000243r 2  E8                 INX
000244r 2  C8                 INY
000245r 2  80 F4              BRA   @count
000247r 2               @counted:
000247r 2  98                 TYA
000248r 2  F0 48              BEQ   @empty
00024Ar 2  48                 PHA
00024Br 2  18                 CLC
00024Cr 2  69 04              ADC   #4
00024Er 2  A2 01              LDX   #ATYPE_TOKEN
000250r 2  20 rr rr           JSR   heap_alloc
000253r 2  B0 3C              BCS   @oom
000255r 2  A0 00              LDY   #TOK_TAG
000257r 2  A9 06              LDA   #TOK_QUOTE
000259r 2  91 rr              STA   (ptr_lo),Y
00025Br 2  A0 01              LDY   #TOK_NEXT_LO
00025Dr 2  A9 00              LDA   #0
00025Fr 2  91 rr              STA   (ptr_lo),Y
000261r 2  C8                 INY
000262r 2  91 rr              STA   (ptr_lo),Y
000264r 2  68                 PLA
000265r 2  48                 PHA
000266r 2  A0 03              LDY   #TOK_PAYLOAD
000268r 2  91 rr              STA   (ptr_lo),Y
00026Ar 2                     ; Copy characters — no uppercasing for quotes
00026Ar 2  68                 PLA
00026Br 2  AA                 TAX
00026Cr 2  A0 04              LDY   #TOK_PAYLOAD+1
00026Er 2  9C rr rr           STZ   num_tmp_lo
000271r 2               @copy:
000271r 2  DA                 PHX
000272r 2  AD rr rr           LDA   num_tmp_lo
000275r 2  18                 CLC
000276r 2  65 rr              ADC   tok_src
000278r 2  AA                 TAX
000279r 2  BD rr rr           LDA   input_buf,X
00027Cr 2  91 rr              STA   (ptr_lo),Y
00027Er 2  C8                 INY
00027Fr 2  EE rr rr           INC   num_tmp_lo
000282r 2  FA                 PLX
000283r 2  CA                 DEX
000284r 2  D0 EB              BNE   @copy
000286r 2  AD rr rr           LDA   num_tmp_lo
000289r 2  18                 CLC
00028Ar 2  65 rr              ADC   tok_src
00028Cr 2  85 rr              STA   tok_src
00028Er 2  4C rr rr           JMP   tok_append_node
000291r 2               @oom:
000291r 2  68                 PLA
000292r 2               @empty:
000292r 2  60                 RTS
000293r 2               
000293r 2               ; ---------------------------------------------------------------------
000293r 2               ; tok_parse_number — parse decimal integer[.fraction] into TOK_NUMBER
000293r 2               ;   tok_src points at first digit or '-'
000293r 2               ;   Payload: 3 bytes = int_hi, int_lo, frac (16.8 fixed-point)
000293r 2               ; ---------------------------------------------------------------------
000293r 2               tok_parse_number:
000293r 2  9C rr rr           STZ   num_val_lo
000296r 2  9C rr rr           STZ   num_val_hi
000299r 2  64 rr              STZ   tok_sign              ; 0 = positive
00029Br 2  A6 rr              LDX   tok_src
00029Dr 2  BD rr rr           LDA   input_buf,X
0002A0r 2  C9 2D              CMP   #'-'
0002A2r 2  D0 06              BNE   @parse_int
0002A4r 2  A9 01              LDA   #1
0002A6r 2  85 rr              STA   tok_sign
0002A8r 2  E6 rr              INC   tok_src
0002AAr 2               
0002AAr 2                     ; Parse integer digits
0002AAr 2               @parse_int:
0002AAr 2  A6 rr              LDX   tok_src
0002ACr 2  BD rr rr           LDA   input_buf,X
0002AFr 2  C9 30              CMP   #'0'
0002B1r 2  90 54              BCC   @int_done
0002B3r 2  C9 3A              CMP   #'9'+1
0002B5r 2  B0 50              BCS   @int_done
0002B7r 2  38                 SEC
0002B8r 2  E9 30              SBC   #'0'                 ; A = digit 0..9
0002BAr 2  48                 PHA                        ; save digit
0002BBr 2               
0002BBr 2                     ; Multiply num_val by 10: (val << 3) + (val << 1)
0002BBr 2                     ; Compute val << 1
0002BBr 2  AD rr rr           LDA   num_val_lo
0002BEr 2  0A                 ASL
0002BFr 2  8D rr rr           STA   num_tmp_lo
0002C2r 2  AD rr rr           LDA   num_val_hi
0002C5r 2  2A                 ROL
0002C6r 2  8D rr rr           STA   num_tmp_hi           ; tmp = val * 2
0002C9r 2               
0002C9r 2                     ; Compute val << 3 = (val * 2) << 2
0002C9r 2  0E rr rr           ASL   num_tmp_lo
0002CCr 2  2E rr rr           ROL   num_tmp_hi
0002CFr 2  0E rr rr           ASL   num_tmp_lo
0002D2r 2  2E rr rr           ROL   num_tmp_hi           ; tmp = val * 8
0002D5r 2               
0002D5r 2                     ; val*10 = val*8 + val*2. Recompute val*2 into num_val first, with a
0002D5r 2                     ; proper 16-bit shift (ASL low, ROL high) so the carry out of the low
0002D5r 2                     ; byte reaches the high byte — then add val*8. (The previous version
0002D5r 2                     ; fused the shift and add and CLC'd away that carry, dropping 256 from
0002D5r 2                     ; any value whose low byte had bit 7 set, e.g. 4242 -> 3986.)
0002D5r 2  AD rr rr           LDA   num_val_lo
0002D8r 2  0A                 ASL
0002D9r 2  8D rr rr           STA   num_val_lo
0002DCr 2  AD rr rr           LDA   num_val_hi
0002DFr 2  2A                 ROL
0002E0r 2  8D rr rr           STA   num_val_hi           ; num_val = val * 2
0002E3r 2               
0002E3r 2  18                 CLC
0002E4r 2  AD rr rr           LDA   num_val_lo
0002E7r 2  6D rr rr           ADC   num_tmp_lo
0002EAr 2  8D rr rr           STA   num_val_lo
0002EDr 2  AD rr rr           LDA   num_val_hi
0002F0r 2  6D rr rr           ADC   num_tmp_hi
0002F3r 2  8D rr rr           STA   num_val_hi           ; num_val = val*2 + val*8 = val*10
0002F6r 2               
0002F6r 2                     ; Add digit
0002F6r 2  68                 PLA
0002F7r 2  18                 CLC
0002F8r 2  6D rr rr           ADC   num_val_lo
0002FBr 2  8D rr rr           STA   num_val_lo
0002FEr 2  90 03              BCC   @no_carry
000300r 2  EE rr rr           INC   num_val_hi
000303r 2               @no_carry:
000303r 2  E6 rr              INC   tok_src
000305r 2  80 A3              BRA   @parse_int
000307r 2               
000307r 2               @int_done:
000307r 2                     ; Parse fractional part
000307r 2  9C rr rr           STZ   num_tmp_lo           ; frac result
00030Ar 2  A6 rr              LDX   tok_src
00030Cr 2  BD rr rr           LDA   input_buf,X
00030Fr 2  C9 2E              CMP   #'.'
000311r 2  D0 67              BNE   @apply_sign
000313r 2  E6 rr              INC   tok_src
000315r 2               
000315r 2                     ; Parse up to 2 fractional digits
000315r 2  9C rr rr           STZ   num_tmp_hi           ; frac_raw accumulator
000318r 2  A0 00              LDY   #0                   ; digit count
00031Ar 2               @frac_loop:
00031Ar 2  C0 02              CPY   #2
00031Cr 2  B0 2E              BCS   @frac_skip
00031Er 2  A6 rr              LDX   tok_src
000320r 2  BD rr rr           LDA   input_buf,X
000323r 2  C9 30              CMP   #'0'
000325r 2  90 36              BCC   @frac_conv
000327r 2  C9 3A              CMP   #'9'+1
000329r 2  B0 32              BCS   @frac_conv
00032Br 2  38                 SEC
00032Cr 2  E9 30              SBC   #'0'
00032Er 2  48                 PHA
00032Fr 2                     ; frac_raw = frac_raw * 10 + digit
00032Fr 2  AD rr rr           LDA   num_tmp_hi
000332r 2  0A                 ASL
000333r 2  8D rr rr           STA   num_tmp_lo           ; *2
000336r 2  0A                 ASL
000337r 2  0A                 ASL                        ; A = val*8
000338r 2  18                 CLC
000339r 2  6D rr rr           ADC   num_tmp_lo           ; A = val*10
00033Cr 2  8D rr rr           STA   num_tmp_hi
00033Fr 2  68                 PLA
000340r 2  18                 CLC
000341r 2  6D rr rr           ADC   num_tmp_hi
000344r 2  8D rr rr           STA   num_tmp_hi
000347r 2  E6 rr              INC   tok_src
000349r 2  C8                 INY
00034Ar 2  80 CE              BRA   @frac_loop
00034Cr 2               
00034Cr 2               @frac_skip:
00034Cr 2                     ; skip remaining digits after '.'
00034Cr 2  A6 rr              LDX   tok_src
00034Er 2  BD rr rr           LDA   input_buf,X
000351r 2  C9 30              CMP   #'0'
000353r 2  90 08              BCC   @frac_conv
000355r 2  C9 3A              CMP   #'9'+1
000357r 2  B0 04              BCS   @frac_conv
000359r 2  E6 rr              INC   tok_src
00035Br 2  80 EF              BRA   @frac_skip
00035Dr 2               
00035Dr 2               @frac_conv:
00035Dr 2                     ; If only 1 digit, multiply by 10
00035Dr 2  C0 01              CPY   #1
00035Fr 2  D0 10              BNE   @frac_2d
000361r 2  AD rr rr           LDA   num_tmp_hi
000364r 2  0A                 ASL
000365r 2  8D rr rr           STA   num_tmp_lo
000368r 2  0A                 ASL
000369r 2  0A                 ASL
00036Ar 2  18                 CLC
00036Br 2  6D rr rr           ADC   num_tmp_lo
00036Er 2  8D rr rr           STA   num_tmp_hi
000371r 2               @frac_2d:
000371r 2                     ; Convert centesimal (0..99) → 8-bit fraction
000371r 2  AD rr rr           LDA   num_tmp_hi
000374r 2  20 rr rr           JSR   frac_to_byte
000377r 2  8D rr rr           STA   num_tmp_lo
00037Ar 2               
00037Ar 2               @apply_sign:
00037Ar 2                     ; Apply sign (negate 16.8 via two's complement if negative)
00037Ar 2  A5 rr              LDA   tok_sign
00037Cr 2  F0 1F              BEQ   @emit_num
00037Er 2                     ; Negate: complement and add 1 across all 3 bytes
00037Er 2  AD rr rr           LDA   num_tmp_lo           ; frac
000381r 2  49 FF              EOR   #$FF
000383r 2  18                 CLC
000384r 2  69 01              ADC   #1
000386r 2  8D rr rr           STA   num_tmp_lo
000389r 2  AD rr rr           LDA   num_val_lo
00038Cr 2  49 FF              EOR   #$FF
00038Er 2  69 00              ADC   #0
000390r 2  8D rr rr           STA   num_val_lo
000393r 2  AD rr rr           LDA   num_val_hi
000396r 2  49 FF              EOR   #$FF
000398r 2  69 00              ADC   #0
00039Ar 2  8D rr rr           STA   num_val_hi
00039Dr 2               
00039Dr 2               @emit_num:
00039Dr 2                     ; Allocate 6-byte node
00039Dr 2  A9 06              LDA   #6
00039Fr 2  A2 01              LDX   #ATYPE_TOKEN
0003A1r 2  20 rr rr           JSR   heap_alloc
0003A4r 2  B0 25              BCS   @oom
0003A6r 2  A0 00              LDY   #TOK_TAG
0003A8r 2  A9 02              LDA   #TOK_NUMBER
0003AAr 2  91 rr              STA   (ptr_lo),Y
0003ACr 2  A0 01              LDY   #TOK_NEXT_LO
0003AEr 2  A9 00              LDA   #0
0003B0r 2  91 rr              STA   (ptr_lo),Y
0003B2r 2  C8                 INY
0003B3r 2  91 rr              STA   (ptr_lo),Y
0003B5r 2                     ; Payload: [hi, lo, frac]
0003B5r 2  A0 03              LDY   #TOK_PAYLOAD
0003B7r 2  AD rr rr           LDA   num_val_hi
0003BAr 2  91 rr              STA   (ptr_lo),Y
0003BCr 2  C8                 INY
0003BDr 2  AD rr rr           LDA   num_val_lo
0003C0r 2  91 rr              STA   (ptr_lo),Y
0003C2r 2  C8                 INY
0003C3r 2  AD rr rr           LDA   num_tmp_lo
0003C6r 2  91 rr              STA   (ptr_lo),Y
0003C8r 2  4C rr rr           JMP   tok_append_node
0003CBr 2               @oom:
0003CBr 2  60                 RTS
0003CCr 2               
0003CCr 2               ; ---------------------------------------------------------------------
0003CCr 2               ; frac_to_byte — convert centesimal fraction (0..99) to 8-bit (0..252)
0003CCr 2               ;   Input: A = centesimal value (0..99)
0003CCr 2               ;   Output: A = 8-bit fractional byte
0003CCr 2               ;   Method: (A * 256) / 100 via 16÷8 long division
0003CCr 2               ;   Clobbers: X, Y
0003CCr 2               ; ---------------------------------------------------------------------
0003CCr 2               frac_to_byte:
0003CCr 2                     ; dividend = A:$00 (A*256), divisor = 100
0003CCr 2  8D rr rr           STA   num_tmp_hi
0003CFr 2  9C rr rr           STZ   num_tmp_lo
0003D2r 2  A2 00              LDX   #0                   ; remainder
0003D4r 2  A0 10              LDY   #16                  ; 16-bit division
0003D6r 2               @div:
0003D6r 2  0E rr rr           ASL   num_tmp_lo
0003D9r 2  2E rr rr           ROL   num_tmp_hi
0003DCr 2  8A                 TXA
0003DDr 2  2A                 ROL
0003DEr 2  AA                 TAX
0003DFr 2  E0 64              CPX   #100
0003E1r 2  90 08              BCC   @nosub
0003E3r 2  8A                 TXA
0003E4r 2  38                 SEC
0003E5r 2  E9 64              SBC   #100
0003E7r 2  AA                 TAX
0003E8r 2  EE rr rr           INC   num_tmp_lo
0003EBr 2               @nosub:
0003EBr 2  88                 DEY
0003ECr 2  D0 E8              BNE   @div
0003EEr 2  AD rr rr           LDA   num_tmp_lo           ; quotient low byte
0003F1r 2  60                 RTS
0003F2r 2               
0003F2r 2               ; ---------------------------------------------------------------------
0003F2r 2               ; tok_append_node — link ptr_lo/hi into the list, continue scanning
0003F2r 2               ; ---------------------------------------------------------------------
0003F2r 2               tok_append_node:
0003F2r 2  A5 rr              LDA   tok_head_lo
0003F4r 2  05 rr              ORA   tok_head_hi
0003F6r 2  D0 0F              BNE   @link
0003F8r 2                     ; Empty list: head = tail = new node
0003F8r 2  A5 rr              LDA   ptr_lo
0003FAr 2  85 rr              STA   tok_head_lo
0003FCr 2  85 rr              STA   tok_tail_lo
0003FEr 2  A5 rr              LDA   ptr_hi
000400r 2  85 rr              STA   tok_head_hi
000402r 2  85 rr              STA   tok_tail_hi
000404r 2  4C rr rr           JMP   tok_scan_next
000407r 2               @link:
000407r 2                     ; tail->next = new node
000407r 2  A5 rr              LDA   tok_tail_lo
000409r 2  85 rr              STA   ptr2_lo
00040Br 2  A5 rr              LDA   tok_tail_hi
00040Dr 2  85 rr              STA   ptr2_hi
00040Fr 2  A0 01              LDY   #TOK_NEXT_LO
000411r 2  A5 rr              LDA   ptr_lo
000413r 2  91 rr              STA   (ptr2_lo),Y
000415r 2  C8                 INY
000416r 2  A5 rr              LDA   ptr_hi
000418r 2  91 rr              STA   (ptr2_lo),Y
00041Ar 2                     ; tail = new node
00041Ar 2  A5 rr              LDA   ptr_lo
00041Cr 2  85 rr              STA   tok_tail_lo
00041Er 2  A5 rr              LDA   ptr_hi
000420r 2  85 rr              STA   tok_tail_hi
000422r 2  4C rr rr           JMP   tok_scan_next
000425r 2               
000425r 2               ; ---------------------------------------------------------------------
000425r 2               ; is_word_char — test if A is a valid word character
000425r 2               ;   Returns: carry set = word char, carry clear = delimiter
000425r 2               ;   Preserves: X
000425r 2               ; ---------------------------------------------------------------------
000425r 2               is_word_char:
000425r 2  C9 00              CMP   #0
000427r 2  F0 36              BEQ   @no
000429r 2  C9 20              CMP   #$20
00042Br 2  F0 32              BEQ   @no
00042Dr 2  C9 09              CMP   #$09
00042Fr 2  F0 2E              BEQ   @no
000431r 2  C9 5B              CMP   #'['
000433r 2  F0 2A              BEQ   @no
000435r 2  C9 5D              CMP   #']'
000437r 2  F0 26              BEQ   @no
000439r 2  C9 28              CMP   #'('
00043Br 2  F0 22              BEQ   @no
00043Dr 2  C9 29              CMP   #')'
00043Fr 2  F0 1E              BEQ   @no
000441r 2  C9 2B              CMP   #'+'
000443r 2  F0 1A              BEQ   @no
000445r 2  C9 2D              CMP   #'-'
000447r 2  F0 16              BEQ   @no
000449r 2  C9 2A              CMP   #'*'
00044Br 2  F0 12              BEQ   @no
00044Dr 2  C9 2F              CMP   #'/'
00044Fr 2  F0 0E              BEQ   @no
000451r 2  C9 3C              CMP   #'<'
000453r 2  F0 0A              BEQ   @no
000455r 2  C9 3E              CMP   #'>'
000457r 2  F0 06              BEQ   @no
000459r 2  C9 3D              CMP   #'='
00045Br 2  F0 02              BEQ   @no
00045Dr 2  38                 SEC
00045Er 2  60                 RTS
00045Fr 2               @no:
00045Fr 2  18                 CLC
000460r 2  60                 RTS
000461r 2               
000461r 2               
000461r 1                     .include "eval.s"
000461r 2               ; eval.s — evaluator: walk token list and dispatch commands
000461r 2               
000461r 2               ; =====================================================================
000461r 2               ; ZEROPAGE segment — evaluator variables
000461r 2               ; =====================================================================
000461r 2                     .segment "ZEROPAGE"
00000Cr 2               
00000Cr 2  xx           eval_type:      .res 1    ; result type: $00=number, $01=word
00000Dr 2  xx           eval_val_hi:    .res 1    ; number high byte or word ptr high
00000Er 2  xx           eval_val_lo:    .res 1    ; number low byte or word ptr low
00000Fr 2  xx           eval_val_frac:  .res 1    ; number fractional byte
000010r 2  xx           eval_cur_lo:    .res 1    ; current token pointer (low)
000011r 2  xx           eval_cur_hi:    .res 1    ; current token pointer (high)
000012r 2  xx           eval_left_hi:   .res 1    ; saved left operand high byte
000013r 2  xx           eval_left_lo:   .res 1    ; saved left operand low byte
000014r 2  xx           eval_left_frac: .res 1    ; saved left operand fractional byte
000015r 2  xx           eval_op:        .res 1    ; infix operator character
000016r 2  xx           handler_lo:     .res 1    ; saved handler address for JMP
000017r 2  xx           handler_hi:     .res 1
000018r 2  xx           eval_in_body:   .res 1    ; $00 = normal eval_loop, $01 = in body
000019r 2  xx           proc_stopped:   .res 1    ; $00 = running, $01 = STOP, $02 = OUTPUT
00001Ar 2  xx           eval_reporter:  .res 1    ; $00 = normal, $01 = reporter mode (return from eval_continue)
00001Br 2  xx           ext_mod_id:     .res 1    ; looked-up ext_cmd_table module_id (MODULE_ID_NONE=legacy path)
00001Cr 2               
00001Cr 2               ; --- Catch frame for CATCH/THROW error handling ---
00001Cr 2  xx           catch_active:   .res 1    ; $00 = no catch, $01 = catch active
00001Dr 2  xx           catch_tag_lo:   .res 1    ; pointer to tag word (length-prefixed)
00001Er 2  xx           catch_tag_hi:   .res 1
00001Fr 2  xx           catch_sp:       .res 1    ; saved 6502 stack pointer for unwinding
000020r 2  xx           catch_resume_lo: .res 1   ; eval_cur to resume at (past the body's ])
000021r 2  xx           catch_resume_hi: .res 1
000022r 2               
000022r 2               ; =====================================================================
000022r 2               ; BSS segment — scratch for number printing
000022r 2               ; =====================================================================
000022r 2                     .segment "BSS"
000007r 2               
000007r 2  xx xx xx xx  pn_buf:         .res 8    ; decimal digit buffer for print_number
00000Br 2  xx xx xx xx  
00000Fr 2               
00000Fr 2               ; =====================================================================
00000Fr 2               ; CODE segment — evaluator routines
00000Fr 2               ; =====================================================================
00000Fr 2                     .segment "CODE"
000461r 2               
000461r 2               ; ---------------------------------------------------------------------
000461r 2               ; eval_line — evaluate the token list built by tokenize_line
000461r 2               ;   Input:  tok_head_lo/hi = first token
000461r 2               ;   Output: commands executed, errors printed
000461r 2               ; ---------------------------------------------------------------------
000461r 2               eval_line:
000461r 2  64 rr              STZ   eval_in_body
000463r 2  64 rr              STZ   proc_stopped
000465r 2  64 rr              STZ   eval_reporter
000467r 2  A5 rr              LDA   tok_head_lo
000469r 2  85 rr              STA   eval_cur_lo
00046Br 2  A5 rr              LDA   tok_head_hi
00046Dr 2  85 rr              STA   eval_cur_hi
00046Fr 2               
00046Fr 2               eval_loop:
00046Fr 2                     ; Check if STOP/OUTPUT was signaled — bail out
00046Fr 2  A5 rr              LDA   proc_stopped
000471r 2  D0 1B              BNE   @bail_out
000473r 2               
000473r 2                     ; Check for end of list
000473r 2  A5 rr              LDA   eval_cur_lo
000475r 2  05 rr              ORA   eval_cur_hi
000477r 2  F0 15              BEQ   @bail_out
000479r 2               
000479r 2                     ; Read tag of current token
000479r 2  A5 rr              LDA   eval_cur_lo
00047Br 2  85 rr              STA   ptr_lo
00047Dr 2  A5 rr              LDA   eval_cur_hi
00047Fr 2  85 rr              STA   ptr_hi
000481r 2  A0 00              LDY   #TOK_TAG
000483r 2  B1 rr              LDA   (ptr_lo),Y
000485r 2               
000485r 2                     ; Dispatch based on tag
000485r 2  C9 01              CMP   #TOK_WORD
000487r 2  F0 06              BEQ   @do_command
000489r 2               
000489r 2                     ; Bare expression — skip it for now (could error)
000489r 2                     ; Advance to next token
000489r 2  20 rr rr           JSR   eval_advance
00048Cr 2  80 E1              BRA   eval_loop
00048Er 2               
00048Er 2               @bail_out:
00048Er 2  60                 RTS
00048Fr 2               
00048Fr 2               @do_command:
00048Fr 2                     ; Look up the word in the builtin table
00048Fr 2  20 rr rr           JSR   lookup_builtin
000492r 2  B0 31              BCS   @unknown
000494r 2               
000494r 2                     ; Found: handler addr is in ptr2_lo/hi, arity in A
000494r 2                     ; Save handler address — eval_expr may clobber ptr2
000494r 2  A6 rr              LDX   ptr2_lo
000496r 2  86 rr              STX   handler_lo
000498r 2  A6 rr              LDX   ptr2_hi
00049Ar 2  86 rr              STX   handler_hi
00049Cr 2                     ; Save arity across eval_advance (which clobbers X)
00049Cr 2  AA                 TAX
00049Dr 2  DA                 PHX
00049Er 2                     ; Advance past the command word token
00049Er 2  20 rr rr           JSR   eval_advance
0004A1r 2  FA                 PLX
0004A2r 2               
0004A2r 2                     ; Evaluate arguments (X = arity count)
0004A2r 2  E0 00              CPX   #0
0004A4r 2  F0 16              BEQ   @call_handler
0004A6r 2                     ; Save handler address — eval_expr may invoke proc_invoke which
0004A6r 2                     ; clobbers handler_lo/hi via inner eval_loop dispatch
0004A6r 2  A5 rr              LDA   handler_hi
0004A8r 2  48                 PHA
0004A9r 2  A5 rr              LDA   handler_lo
0004ABr 2  48                 PHA
0004ACr 2               @eval_args:
0004ACr 2  DA                 PHX                   ; save remaining arg count
0004ADr 2  20 rr rr           JSR   eval_expr
0004B0r 2  B0 0D              BCS   @arg_error
0004B2r 2  FA                 PLX
0004B3r 2  CA                 DEX
0004B4r 2  D0 F6              BNE   @eval_args
0004B6r 2                     ; Restore handler address
0004B6r 2  68                 PLA
0004B7r 2  85 rr              STA   handler_lo
0004B9r 2  68                 PLA
0004BAr 2  85 rr              STA   handler_hi
0004BCr 2               
0004BCr 2               @call_handler:
0004BCr 2                     ; Call the handler via indirect JMP
0004BCr 2  6C rr rr           JMP   (handler_lo)
0004BFr 2                     ; handlers must JMP back to eval_loop via eval_continue
0004BFr 2               
0004BFr 2               @arg_error:
0004BFr 2  FA                 PLX                   ; discard saved arity counter
0004C0r 2                     ; Discard saved handler address
0004C0r 2  68                 PLA
0004C1r 2  68                 PLA
0004C2r 2                     ; Print error and abort line
0004C2r 2  4C rr rr           JMP   err_notenough_throw
0004C5r 2               
0004C5r 2               @unknown:
0004C5r 2                     ; Try user-defined procedures before erroring
0004C5r 2  20 rr rr           JSR   proc_lookup
0004C8r 2  B0 06              BCS   @try_ext_cmd
0004CAr 2                     ; Found a procedure — invoke it (proc_stopped restored internally)
0004CAr 2  20 rr rr           JSR   proc_invoke
0004CDr 2  4C rr rr           JMP   eval_loop
0004D0r 2               
0004D0r 2               @try_ext_cmd:
0004D0r 2                     ; Try extension command table before giving up
0004D0r 2  20 rr rr           JSR   lookup_ext_cmd
0004D3r 2  B0 14              BCS   @truly_unknown
0004D5r 2                     ; Found: A = arity, ext_cmd set.
0004D5r 2                     ; Advance past the command word token.
0004D5r 2  AA                 TAX                       ; X = arity
0004D6r 2  DA                 PHX
0004D7r 2  20 rr rr           JSR   eval_advance
0004DAr 2  FA                 PLX
0004DBr 2                     ; Evaluate arguments and copy to ext_arg slots
0004DBr 2  20 rr rr           JSR   ext_eval_args
0004DEr 2  B0 06              BCS   @ext_arg_err
0004E0r 2                     ; Dispatch: legacy trampoline or paged-library lib_call (branches on
0004E0r 2                     ; ext_mod_id). Result left in eval_val.
0004E0r 2  20 rr rr           JSR   ext_invoke
0004E3r 2  4C rr rr           JMP   eval_continue
0004E6r 2               
0004E6r 2               @ext_arg_err:
0004E6r 2  4C rr rr           JMP   err_notenough_throw
0004E9r 2               
0004E9r 2               @truly_unknown:
0004E9r 2                     ; Print "I don't know how to " + the word
0004E9r 2  4C rr rr           JMP   err_idk_word
0004ECr 2               
0004ECr 2               @done:
0004ECr 2  60                 RTS
0004EDr 2               
0004EDr 2               ; ---------------------------------------------------------------------
0004EDr 2               ; eval_continue — handlers JMP here to resume the eval loop
0004EDr 2               ;   If eval_in_body != 0, resumes body execution instead
0004EDr 2               ; ---------------------------------------------------------------------
0004EDr 2               ; ---------------------------------------------------------------------
0004EDr 2               ; jmp_handler — trampoline for calling builtins from reporter position
0004EDr 2               ; ---------------------------------------------------------------------
0004EDr 2               jmp_handler:
0004EDr 2  6C rr rr           JMP   (handler_lo)
0004F0r 2               
0004F0r 2               eval_continue:
0004F0r 2                     ; If in reporter mode, return to eval_expr instead of looping
0004F0r 2  A5 rr              LDA   eval_reporter
0004F2r 2  D0 07              BNE   @reporter_return
0004F4r 2  A5 rr              LDA   eval_in_body
0004F6r 2  D0 07              BNE   eval_body
0004F8r 2  4C rr rr           JMP   eval_loop
0004FBr 2               
0004FBr 2               @reporter_return:
0004FBr 2  64 rr              STZ   eval_reporter
0004FDr 2  18                 CLC
0004FEr 2  60                 RTS
0004FFr 2               
0004FFr 2               ; ---------------------------------------------------------------------
0004FFr 2               ; eval_body — execute tokens within a body until TOK_RBRACKET at depth 0
0004FFr 2               ;   Entry: eval_cur is at the next token to execute inside the body
0004FFr 2               ;   Exit:  eval_cur points at the TOK_RBRACKET that ended the body
0004FFr 2               ;   eval_in_body must be $01 on entry
0004FFr 2               ; ---------------------------------------------------------------------
0004FFr 2               eval_body:
0004FFr 2                     ; Check if STOP/OUTPUT was signaled — bail out immediately
0004FFr 2  A5 rr              LDA   proc_stopped
000501r 2  D0 55              BNE   @done
000503r 2               
000503r 2                     ; Check for end of list (safety — malformed input)
000503r 2  A5 rr              LDA   eval_cur_lo
000505r 2  05 rr              ORA   eval_cur_hi
000507r 2  F0 4F              BEQ   @done
000509r 2               
000509r 2                     ; Read tag of current token
000509r 2  A5 rr              LDA   eval_cur_lo
00050Br 2  85 rr              STA   ptr_lo
00050Dr 2  A5 rr              LDA   eval_cur_hi
00050Fr 2  85 rr              STA   ptr_hi
000511r 2  A0 00              LDY   #TOK_TAG
000513r 2  B1 rr              LDA   (ptr_lo),Y
000515r 2               
000515r 2                     ; Hit the closing bracket? We're done with this body pass.
000515r 2  C9 04              CMP   #TOK_RBRACKET
000517r 2  F0 3F              BEQ   @done
000519r 2               
000519r 2                     ; Dispatch command words (same as eval_loop)
000519r 2  C9 01              CMP   #TOK_WORD
00051Br 2  F0 05              BEQ   @do_command
00051Dr 2               
00051Dr 2                     ; Skip non-word tokens (bare numbers, brackets inside expressions, etc.)
00051Dr 2  20 rr rr           JSR   eval_advance
000520r 2  80 DD              BRA   eval_body
000522r 2               
000522r 2               @do_command:
000522r 2                     ; Same dispatch as eval_loop — look up builtin, eval args, call handler
000522r 2  20 rr rr           JSR   lookup_builtin
000525r 2  B0 32              BCS   @unknown
000527r 2               
000527r 2  A6 rr              LDX   ptr2_lo
000529r 2  86 rr              STX   handler_lo
00052Br 2  A6 rr              LDX   ptr2_hi
00052Dr 2  86 rr              STX   handler_hi
00052Fr 2  AA                 TAX
000530r 2  DA                 PHX
000531r 2  20 rr rr           JSR   eval_advance
000534r 2  FA                 PLX
000535r 2               
000535r 2  E0 00              CPX   #0
000537r 2  F0 16              BEQ   @call_handler
000539r 2                     ; Save handler address — eval_expr may invoke proc_invoke
000539r 2  A5 rr              LDA   handler_hi
00053Br 2  48                 PHA
00053Cr 2  A5 rr              LDA   handler_lo
00053Er 2  48                 PHA
00053Fr 2               @eval_args:
00053Fr 2  DA                 PHX
000540r 2  20 rr rr           JSR   eval_expr
000543r 2  B0 0D              BCS   @arg_error
000545r 2  FA                 PLX
000546r 2  CA                 DEX
000547r 2  D0 F6              BNE   @eval_args
000549r 2                     ; Restore handler address
000549r 2  68                 PLA
00054Ar 2  85 rr              STA   handler_lo
00054Cr 2  68                 PLA
00054Dr 2  85 rr              STA   handler_hi
00054Fr 2               
00054Fr 2               @call_handler:
00054Fr 2  6C rr rr           JMP   (handler_lo)
000552r 2                     ; handler JMPs to eval_continue, which routes back here
000552r 2               
000552r 2               @arg_error:
000552r 2  FA                 PLX
000553r 2  68                 PLA
000554r 2  68                 PLA
000555r 2  4C rr rr           JMP   err_notenough_throw
000558r 2               
000558r 2               @done:
000558r 2  60                 RTS
000559r 2               
000559r 2               @unknown:
000559r 2                     ; Try user-defined procedures before erroring (inside body)
000559r 2  20 rr rr           JSR   proc_lookup
00055Cr 2  B0 06              BCS   @try_ext_cmd
00055Er 2  20 rr rr           JSR   proc_invoke
000561r 2  4C rr rr           JMP   eval_body
000564r 2               
000564r 2               @try_ext_cmd:
000564r 2                     ; Try extension command table before giving up (inside body)
000564r 2  20 rr rr           JSR   lookup_ext_cmd
000567r 2  B0 14              BCS   @truly_unknown
000569r 2  AA                 TAX
00056Ar 2  DA                 PHX
00056Br 2  20 rr rr           JSR   eval_advance
00056Er 2  FA                 PLX
00056Fr 2  20 rr rr           JSR   ext_eval_args
000572r 2  B0 06              BCS   @body_ext_err
000574r 2                     ; Dispatch: legacy trampoline or paged-library lib_call (branches on
000574r 2                     ; ext_mod_id). Result left in eval_val.
000574r 2  20 rr rr           JSR   ext_invoke
000577r 2  4C rr rr           JMP   eval_continue
00057Ar 2               
00057Ar 2               @body_ext_err:
00057Ar 2  4C rr rr           JMP   err_notenough_throw
00057Dr 2               
00057Dr 2               @truly_unknown:
00057Dr 2                     ; Print "I don't know how to " + the word (inside body)
00057Dr 2  4C rr rr           JMP   err_idk_word
000580r 2               
000580r 2               ; ---------------------------------------------------------------------
000580r 2               ; eval_advance — advance eval_cur to the next token in the list
000580r 2               ;   Reads next pointer from current token, stores in eval_cur
000580r 2               ; ---------------------------------------------------------------------
000580r 2               eval_advance:
000580r 2  A5 rr              LDA   eval_cur_lo
000582r 2  85 rr              STA   ptr_lo
000584r 2  A5 rr              LDA   eval_cur_hi
000586r 2  85 rr              STA   ptr_hi
000588r 2  A0 01              LDY   #TOK_NEXT_LO
00058Ar 2  B1 rr              LDA   (ptr_lo),Y
00058Cr 2  AA                 TAX
00058Dr 2  C8                 INY
00058Er 2  B1 rr              LDA   (ptr_lo),Y
000590r 2  85 rr              STA   eval_cur_hi
000592r 2  86 rr              STX   eval_cur_lo
000594r 2  60                 RTS
000595r 2               
000595r 2               ; ---------------------------------------------------------------------
000595r 2               ; eval_expr — evaluate one expression from the current token
000595r 2               ;   Output: eval_type, eval_val_hi/lo/frac set
000595r 2               ;           Carry clear = success, Carry set = error (no token)
000595r 2               ;   Advances eval_cur past the consumed token
000595r 2               ; ---------------------------------------------------------------------
000595r 2               eval_expr:
000595r 2                     ; Check for end of list
000595r 2  A5 rr              LDA   eval_cur_lo
000597r 2  05 rr              ORA   eval_cur_hi
000599r 2  D0 02              BNE   @have_token
00059Br 2  38                 SEC                       ; no more tokens
00059Cr 2  60                 RTS
00059Dr 2               
00059Dr 2               @have_token:
00059Dr 2  A5 rr              LDA   eval_cur_lo
00059Fr 2  85 rr              STA   ptr_lo
0005A1r 2  A5 rr              LDA   eval_cur_hi
0005A3r 2  85 rr              STA   ptr_hi
0005A5r 2  A0 00              LDY   #TOK_TAG
0005A7r 2  B1 rr              LDA   (ptr_lo),Y
0005A9r 2               
0005A9r 2  C9 02              CMP   #TOK_NUMBER
0005ABr 2  D0 03              BNE   :+
0005ADr 2  4C rr rr           JMP   @number
0005B0r 2  C9 06        :     CMP   #TOK_QUOTE
0005B2r 2  D0 03              BNE   :+
0005B4r 2  4C rr rr           JMP   @quote
0005B7r 2  C9 05        :     CMP   #TOK_VARREF
0005B9r 2  D0 03              BNE   :+
0005BBr 2  4C rr rr           JMP   @varref
0005BEr 2  C9 01        :     CMP   #TOK_WORD
0005C0r 2  F0 06              BEQ   @word_expr
0005C2r 2  C9 03              CMP   #TOK_LBRACKET
0005C4r 2  F0 19              BEQ   @list_literal
0005C6r 2                     ; Anything else is an error
0005C6r 2  38                 SEC
0005C7r 2  60                 RTS
0005C8r 2               
0005C8r 2               @word_expr:
0005C8r 2                     ; Could be a reporter procedure (returns a value via OUTPUT)
0005C8r 2  20 rr rr           JSR   proc_lookup
0005CBr 2  B0 19              BCS   @word_not_proc        ; not a procedure — try builtins
0005CDr 2                     ; It's a procedure — invoke it
0005CDr 2  20 rr rr           JSR   proc_invoke
0005D0r 2                     ; X = exit status: $02 = OUTPUT (eval_val has value), else no value
0005D0r 2  E0 02              CPX   #$02
0005D2r 2  F0 08              BEQ   @word_has_val
0005D4r 2                     ; No OUTPUT — set result to 0
0005D4r 2  64 rr              STZ   eval_val_hi
0005D6r 2  64 rr              STZ   eval_val_lo
0005D8r 2  64 rr              STZ   eval_val_frac
0005DAr 2  64 rr              STZ   eval_type
0005DCr 2               @word_has_val:
0005DCr 2  4C rr rr           JMP   eval_check_infix      ; allow DOUBLE 5 + 3 etc.
0005DFr 2               
0005DFr 2               @list_literal:
0005DFr 2                     ; Advance past the [
0005DFr 2  20 rr rr           JSR   eval_advance
0005E2r 2                     ; Build list from tokens until ]
0005E2r 2  20 rr rr           JSR   eval_list
0005E5r 2                     ; eval_type = VAL_LIST, eval_val = head pointer
0005E5r 2                     ; Carry already set/clear from eval_list
0005E5r 2  60                 RTS
0005E6r 2               
0005E6r 2               @word_not_proc:
0005E6r 2                     ; Not a user proc — try built-in reporter
0005E6r 2  20 rr rr           JSR   lookup_builtin
0005E9r 2  B0 37              BCS   @word_unknown
0005EBr 2                     ; Found: ptr2_lo/hi = handler addr, A = arity
0005EBr 2                     ; Save handler address
0005EBr 2  A6 rr              LDX   ptr2_lo
0005EDr 2  86 rr              STX   handler_lo
0005EFr 2  A6 rr              LDX   ptr2_hi
0005F1r 2  86 rr              STX   handler_hi
0005F3r 2  AA                 TAX                       ; X = arity
0005F4r 2  DA                 PHX                       ; save arity across eval_advance
0005F5r 2                     ; Advance past the command word
0005F5r 2  20 rr rr           JSR   eval_advance
0005F8r 2  FA                 PLX                       ; restore arity
0005F9r 2                     ; Evaluate arguments (X = arity count)
0005F9r 2  E0 00              CPX   #0
0005FBr 2  F0 16              BEQ   @call_reporter
0005FDr 2                     ; Save handler address — eval_expr may clobber it
0005FDr 2  A5 rr              LDA   handler_hi
0005FFr 2  48                 PHA
000600r 2  A5 rr              LDA   handler_lo
000602r 2  48                 PHA
000603r 2               @rpt_eval_args:
000603r 2  DA                 PHX
000604r 2  20 rr rr           JSR   eval_expr
000607r 2  B0 14              BCS   @rpt_arg_error
000609r 2  FA                 PLX
00060Ar 2  CA                 DEX
00060Br 2  D0 F6              BNE   @rpt_eval_args
00060Dr 2                     ; Restore handler address
00060Dr 2  68                 PLA
00060Er 2  85 rr              STA   handler_lo
000610r 2  68                 PLA
000611r 2  85 rr              STA   handler_hi
000613r 2               @call_reporter:
000613r 2                     ; Set reporter mode so eval_continue returns here instead of looping
000613r 2  A9 01              LDA   #$01
000615r 2  85 rr              STA   eval_reporter
000617r 2                     ; Call via JSR to trampoline — handler JMPs to eval_continue
000617r 2                     ; which sees eval_reporter and does CLC + RTS back here.
000617r 2  20 rr rr           JSR   jmp_handler
00061Ar 2                     ; eval_val now set by the handler
00061Ar 2  4C rr rr           JMP   eval_check_infix
00061Dr 2               
00061Dr 2               @rpt_arg_error:
00061Dr 2  FA                 PLX                       ; discard saved arity counter
00061Er 2  68                 PLA
00061Fr 2  68                 PLA                       ; discard saved handler address
000620r 2  38                 SEC
000621r 2  60                 RTS
000622r 2               
000622r 2               @word_unknown:
000622r 2                     ; Try extension command table as reporter
000622r 2  20 rr rr           JSR   lookup_ext_cmd
000625r 2  B0 12              BCS   @word_really_unknown
000627r 2                     ; Found: A = arity, EXT_CMD set
000627r 2  AA                 TAX
000628r 2  DA                 PHX
000629r 2  20 rr rr           JSR   eval_advance
00062Cr 2  FA                 PLX
00062Dr 2  20 rr rr           JSR   ext_eval_args
000630r 2  B0 07              BCS   @word_really_unknown
000632r 2                     ; Dispatch: legacy trampoline or paged-library lib_call (branches on
000632r 2                     ; ext_mod_id). Result left in eval_val.
000632r 2  20 rr rr           JSR   ext_invoke
000635r 2  18                 CLC
000636r 2  4C rr rr           JMP   eval_check_infix
000639r 2               
000639r 2               @word_really_unknown:
000639r 2  38                 SEC
00063Ar 2  60                 RTS
00063Br 2               
00063Br 2               @number:
00063Br 2                     ; Copy 3-byte payload to eval_val
00063Br 2  A0 03              LDY   #TOK_PAYLOAD
00063Dr 2  B1 rr              LDA   (ptr_lo),Y         ; int_hi
00063Fr 2  85 rr              STA   eval_val_hi
000641r 2  C8                 INY
000642r 2  B1 rr              LDA   (ptr_lo),Y         ; int_lo
000644r 2  85 rr              STA   eval_val_lo
000646r 2  C8                 INY
000647r 2  B1 rr              LDA   (ptr_lo),Y         ; frac
000649r 2  85 rr              STA   eval_val_frac
00064Br 2  64 rr              STZ   eval_type           ; $00 = number
00064Dr 2  20 rr rr           JSR   eval_advance
000650r 2  4C rr rr           JMP   eval_check_infix    ; check for infix operator
000653r 2               
000653r 2               @quote:
000653r 2                     ; Point eval_val at the payload (length byte + chars)
000653r 2                     ; Pointer = ptr_lo/hi + TOK_PAYLOAD
000653r 2  18                 CLC
000654r 2  A5 rr              LDA   ptr_lo
000656r 2  69 03              ADC   #TOK_PAYLOAD
000658r 2  85 rr              STA   eval_val_lo
00065Ar 2  A5 rr              LDA   ptr_hi
00065Cr 2  69 00              ADC   #0
00065Er 2  85 rr              STA   eval_val_hi
000660r 2  64 rr              STZ   eval_val_frac
000662r 2  A9 01              LDA   #$01
000664r 2  85 rr              STA   eval_type           ; $01 = word
000666r 2  20 rr rr           JSR   eval_advance
000669r 2  18                 CLC
00066Ar 2  60                 RTS
00066Br 2               
00066Br 2               @varref:
00066Br 2                     ; Variable reference — :NAME
00066Br 2                     ; Payload is length-prefixed name at token + TOK_PAYLOAD
00066Br 2  18                 CLC
00066Cr 2  A5 rr              LDA   ptr_lo
00066Er 2  69 03              ADC   #TOK_PAYLOAD
000670r 2  85 rr              STA   ptr_lo
000672r 2  A5 rr              LDA   ptr_hi
000674r 2  69 00              ADC   #0
000676r 2  85 rr              STA   ptr_hi
000678r 2  20 rr rr           JSR   var_get
00067Br 2  90 34              BCC   @var_ok
00067Dr 2               
00067Dr 2                     ; Not found — print "NAME has no value"
00067Dr 2                     ; ptr_lo/hi was clobbered by var_get, reload from eval_cur
00067Dr 2  A5 rr              LDA   eval_cur_lo
00067Fr 2  85 rr              STA   ptr_lo
000681r 2  A5 rr              LDA   eval_cur_hi
000683r 2  85 rr              STA   ptr_hi
000685r 2  A0 03              LDY   #TOK_PAYLOAD          ; length byte
000687r 2  B1 rr              LDA   (ptr_lo),Y
000689r 2  AA                 TAX                         ; X = name length
00068Ar 2  A0 04              LDY   #TOK_PAYLOAD+1
00068Cr 2               @vr_name:
00068Cr 2  B1 rr              LDA   (ptr_lo),Y
00068Er 2  8D 0E A0           STA   VGC_CHAROUT
000691r 2  C8                 INY
000692r 2  CA                 DEX
000693r 2  D0 F7              BNE   @vr_name
000695r 2  20 rr rr           JSR   print_inl
000698r 2  20 48 41 53        .byte " HAS NO VALUE", 0
00069Cr 2  20 4E 4F 20  
0006A0r 2  56 41 4C 55  
0006A6r 2  20 rr rr           JSR   eval_newline
0006A9r 2  20 rr rr           JSR   try_throw_error
0006ACr 2  20 rr rr           JSR   eval_advance
0006AFr 2  38                 SEC
0006B0r 2  60                 RTS
0006B1r 2               
0006B1r 2               @var_ok:
0006B1r 2                     ; eval_type and eval_val already set by var_get
0006B1r 2  20 rr rr           JSR   eval_advance
0006B4r 2  4C rr rr           JMP   eval_check_infix      ; allow :X + 5 etc.
0006B7r 2               
0006B7r 2               ; ---------------------------------------------------------------------
0006B7r 2               ; eval_newline — print CR+LF
0006B7r 2               ; ---------------------------------------------------------------------
0006B7r 2               eval_newline:
0006B7r 2  A9 0D              LDA   #$0D
0006B9r 2  8D 0E A0           STA   VGC_CHAROUT
0006BCr 2  A9 0A              LDA   #$0A
0006BEr 2  8D 0E A0           STA   VGC_CHAROUT
0006C1r 2  60                 RTS
0006C2r 2               
0006C2r 2               ; ---------------------------------------------------------------------
0006C2r 2               ; print_inl — print the null-terminated string that immediately follows the
0006C2r 2               ;   JSR in the instruction stream, then resume execution after the 0.
0006C2r 2               ;   Usage:  JSR print_inl
0006C2r 2               ;           .byte "TEXT", 0
0006C2r 2               ;   Clobbers: A, Y, ptr_lo, ptr_hi.
0006C2r 2               ; ---------------------------------------------------------------------
0006C2r 2               print_inl:
0006C2r 2  68                 PLA
0006C3r 2  85 rr              STA   ptr_lo
0006C5r 2  68                 PLA
0006C6r 2  85 rr              STA   ptr_hi          ; ptr = (return addr)-1 = (inline string addr)-1
0006C8r 2  A0 00              LDY   #0
0006CAr 2               @pi_lp:
0006CAr 2  C8                 INY
0006CBr 2  B1 rr              LDA   (ptr_lo),Y
0006CDr 2  F0 05              BEQ   @pi_done
0006CFr 2  8D 0E A0           STA   VGC_CHAROUT
0006D2r 2  80 F6              BRA   @pi_lp
0006D4r 2               @pi_done:
0006D4r 2  98                 TYA
0006D5r 2  18                 CLC
0006D6r 2  65 rr              ADC   ptr_lo
0006D8r 2  85 rr              STA   ptr_lo          ; ptr_lo = low(ptr+Y)
0006DAr 2  A5 rr              LDA   ptr_hi
0006DCr 2  69 00              ADC   #0              ; A = high(ptr+Y)
0006DEr 2  48                 PHA                   ; push high of (ptr+Y)
0006DFr 2  A5 rr              LDA   ptr_lo
0006E1r 2  48                 PHA                   ; push low
0006E2r 2  60                 RTS                   ; RTS jumps to (ptr+Y)+1 = byte after the 0
0006E3r 2               
0006E3r 2               ; =====================================================================
0006E3r 2               ; Message composer (4a) — no error string is stored whole. Every error
0006E3r 2               ; message is composed at print time from shared fragments + the command's
0006E3r 2               ; existing length-prefixed *_name string. Family helpers fall through into
0006E3r 2               ; list_print_err's shared newline+continue tail (err_nl_continue).
0006E3r 2               ; =====================================================================
0006E3r 2               
0006E3r 2               ; print_cstr_xy — print a null-terminated string.
0006E3r 2               ;   In: X/Y = lo/hi pointer.  Clobbers: A, Y, ptr_lo/hi.
0006E3r 2               print_cstr_xy:
0006E3r 2  86 rr              STX   ptr_lo
0006E5r 2  84 rr              STY   ptr_hi
0006E7r 2  A0 00              LDY   #0
0006E9r 2               @pc_lp:
0006E9r 2  B1 rr              LDA   (ptr_lo),Y
0006EBr 2  F0 06              BEQ   @pc_done
0006EDr 2  8D 0E A0           STA   VGC_CHAROUT
0006F0r 2  C8                 INY
0006F1r 2  D0 F6              BNE   @pc_lp
0006F3r 2               @pc_done:
0006F3r 2  60                 RTS
0006F4r 2               
0006F4r 2               ; print_name_xy — print a length-prefixed name ( .byte len,"TEXT" ).
0006F4r 2               ;   In: X/Y = lo/hi pointer.  Clobbers: A, X, Y, ptr_lo/hi.
0006F4r 2               print_name_xy:
0006F4r 2  86 rr              STX   ptr_lo
0006F6r 2  84 rr              STY   ptr_hi
0006F8r 2  A0 00              LDY   #0
0006FAr 2  B1 rr              LDA   (ptr_lo),Y      ; length
0006FCr 2  F0 0A              BEQ   @pn_done
0006FEr 2  AA                 TAX
0006FFr 2               @pn_lp:
0006FFr 2  C8                 INY
000700r 2  B1 rr              LDA   (ptr_lo),Y
000702r 2  8D 0E A0           STA   VGC_CHAROUT
000705r 2  CA                 DEX
000706r 2  D0 F7              BNE   @pn_lp
000708r 2               @pn_done:
000708r 2  60                 RTS
000709r 2               
000709r 2               ; --- family error helpers: enter with X/Y = command's *_name string ptr ---
000709r 2               
000709r 2               ; "NOT ENOUGH INPUTS TO <name>"  (reuses str_notenough so "NOT ENOUGH INPUTS"
000709r 2               ; is never stored twice)
000709r 2               err_nei:
000709r 2  8E rr rr           STX   num_tmp_lo            ; save name ptr across the fragment prints
00070Cr 2  8C rr rr           STY   num_tmp_hi
00070Fr 2  A2 rr              LDX   #<str_notenough
000711r 2  A0 rr              LDY   #>str_notenough
000713r 2  20 rr rr           JSR   print_cstr_xy         ; "NOT ENOUGH INPUTS"
000716r 2  A2 rr              LDX   #<frag_to
000718r 2  A0 rr              LDY   #>frag_to
00071Ar 2  20 rr rr           JSR   print_cstr_xy         ; " TO "
00071Dr 2  AE rr rr           LDX   num_tmp_lo
000720r 2  AC rr rr           LDY   num_tmp_hi
000723r 2  20 rr rr           JSR   print_name_xy         ; the command name
000726r 2  4C rr rr           JMP   err_nl_continue       ; newline + abandon line
000729r 2               
000729r 2               ; "<name> DOESN'T LIKE "  (note: trailing space, no value — matches the ROM)
000729r 2               err_doesnt_like:
000729r 2  20 rr rr           JSR   print_name_xy
00072Cr 2  A2 rr              LDX   #<frag_dl
00072Er 2  A0 rr              LDY   #>frag_dl
000730r 2  4C rr rr           JMP   list_print_err
000733r 2               
000733r 2               ; "<name> NEEDS A LIST"
000733r 2               err_needs_list:
000733r 2  20 rr rr           JSR   print_name_xy
000736r 2  A2 rr              LDX   #<frag_needs_list
000738r 2  A0 rr              LDY   #>frag_needs_list
00073Ar 2  4C rr rr           JMP   list_print_err
00073Dr 2               
00073Dr 2               ; "<name> INDEX OUT OF RANGE"
00073Dr 2               err_index_range:
00073Dr 2  20 rr rr           JSR   print_name_xy
000740r 2  A2 rr              LDX   #<frag_index_range
000742r 2  A0 rr              LDY   #>frag_index_range
000744r 2  4C rr rr           JMP   list_print_err
000747r 2               
000747r 2               ; "<name> DOESN'T LIKE [] AS INPUT"
000747r 2               err_dl_empty:
000747r 2  20 rr rr           JSR   print_name_xy
00074Ar 2  A2 rr              LDX   #<frag_dl
00074Cr 2  A0 rr              LDY   #>frag_dl
00074Er 2  20 rr rr           JSR   print_cstr_xy         ; " DOESN'T LIKE "
000751r 2  A2 rr              LDX   #<frag_as_input
000753r 2  A0 rr              LDY   #>frag_as_input
000755r 2  4C rr rr           JMP   list_print_err        ; "[] AS INPUT" + newline + continue
000758r 2               
000758r 2               ; "<name> DOESN'T LIKE THIS INPUT"
000758r 2               err_dl_this:
000758r 2  20 rr rr           JSR   print_name_xy
00075Br 2  A2 rr              LDX   #<frag_dl
00075Dr 2  A0 rr              LDY   #>frag_dl
00075Fr 2  20 rr rr           JSR   print_cstr_xy         ; " DOESN'T LIKE "
000762r 2  A2 rr              LDX   #<frag_this_input
000764r 2  A0 rr              LDY   #>frag_this_input
000766r 2  4C rr rr           JMP   list_print_err        ; "THIS INPUT" + newline + continue
000769r 2               
000769r 2               ; --- throw-tailed error helpers (arg/unknown paths inside eval_loop/eval_body;
000769r 2               ;     these are catchable, so they end in try_throw_error, NOT eval_continue) ---
000769r 2               
000769r 2               ; "NOT ENOUGH INPUTS" (generic, no command name) + throw-tail
000769r 2               err_notenough_throw:
000769r 2  A2 rr              LDX   #<str_notenough
00076Br 2  A0 rr              LDY   #>str_notenough
00076Dr 2  20 rr rr           JSR   print_cstr_xy
000770r 2  4C rr rr           JMP   err_throw
000773r 2               
000773r 2               ; "I DON'T KNOW HOW TO " + the current token's word + throw-tail
000773r 2               err_idk_word:
000773r 2  A2 rr              LDX   #<str_idk
000775r 2  A0 rr              LDY   #>str_idk
000777r 2  20 rr rr           JSR   print_cstr_xy
00077Ar 2  20 rr rr           JSR   print_token_word
00077Dr 2               err_throw:                        ; <- fall-through from err_idk_word
00077Dr 2  20 rr rr           JSR   eval_newline
000780r 2  20 rr rr           JSR   try_throw_error
000783r 2  60                 RTS
000784r 2               
000784r 2               ; print_token_word — print the length-prefixed word in the current token
000784r 2               ;   (eval_cur + TOK_PAYLOAD).  Clobbers A, X, Y, ptr_lo/hi.
000784r 2               print_token_word:
000784r 2  A5 rr              LDA   eval_cur_lo
000786r 2  85 rr              STA   ptr_lo
000788r 2  A5 rr              LDA   eval_cur_hi
00078Ar 2  85 rr              STA   ptr_hi
00078Cr 2  A0 03              LDY   #TOK_PAYLOAD          ; length byte
00078Er 2  B1 rr              LDA   (ptr_lo),Y
000790r 2  AA                 TAX
000791r 2  A0 04              LDY   #TOK_PAYLOAD+1        ; first char
000793r 2               @ptw_lp:
000793r 2  B1 rr              LDA   (ptr_lo),Y
000795r 2  8D 0E A0           STA   VGC_CHAROUT
000798r 2  C8                 INY
000799r 2  CA                 DEX
00079Ar 2  D0 F7              BNE   @ptw_lp
00079Cr 2  60                 RTS
00079Dr 2               
00079Dr 2               ; ---------------------------------------------------------------------
00079Dr 2               ; eval_check_infix — if next token is TOK_INFIX, evaluate binary op
00079Dr 2               ;   Entry: eval_val holds the left operand (primary value)
00079Dr 2               ;   Exit:  eval_val holds the result, carry clear = success
00079Dr 2               ; ---------------------------------------------------------------------
00079Dr 2               eval_check_infix:
00079Dr 2                     ; Is there a next token?
00079Dr 2  A5 rr              LDA   eval_cur_lo
00079Fr 2  05 rr              ORA   eval_cur_hi
0007A1r 2  F0 75              BEQ   @no_infix
0007A3r 2               
0007A3r 2                     ; Peek at the next token's tag
0007A3r 2  A5 rr              LDA   eval_cur_lo
0007A5r 2  85 rr              STA   ptr_lo
0007A7r 2  A5 rr              LDA   eval_cur_hi
0007A9r 2  85 rr              STA   ptr_hi
0007ABr 2  A0 00              LDY   #TOK_TAG
0007ADr 2  B1 rr              LDA   (ptr_lo),Y
0007AFr 2  C9 07              CMP   #TOK_INFIX
0007B1r 2  D0 65              BNE   @no_infix
0007B3r 2               
0007B3r 2                     ; Save the left operand to ZP scratch
0007B3r 2  A5 rr              LDA   eval_val_hi
0007B5r 2  85 rr              STA   eval_left_hi
0007B7r 2  A5 rr              LDA   eval_val_lo
0007B9r 2  85 rr              STA   eval_left_lo
0007BBr 2  A5 rr              LDA   eval_val_frac
0007BDr 2  85 rr              STA   eval_left_frac
0007BFr 2               
0007BFr 2                     ; Read operator character from payload
0007BFr 2  A0 03              LDY   #TOK_PAYLOAD
0007C1r 2  B1 rr              LDA   (ptr_lo),Y
0007C3r 2  85 rr              STA   eval_op
0007C5r 2               
0007C5r 2                     ; Advance past the infix token
0007C5r 2  20 rr rr           JSR   eval_advance
0007C8r 2               
0007C8r 2                     ; Push left operand and operator onto hardware stack so recursive
0007C8r 2                     ; proc_invoke calls (which may evaluate their own infix expressions)
0007C8r 2                     ; cannot clobber them.
0007C8r 2  A5 rr              LDA   eval_left_hi
0007CAr 2  48                 PHA
0007CBr 2  A5 rr              LDA   eval_left_lo
0007CDr 2  48                 PHA
0007CEr 2  A5 rr              LDA   eval_left_frac
0007D0r 2  48                 PHA
0007D1r 2  A5 rr              LDA   eval_op
0007D3r 2  48                 PHA
0007D4r 2               
0007D4r 2                     ; Evaluate the right operand (recursive call)
0007D4r 2  20 rr rr           JSR   eval_expr
0007D7r 2  B0 41              BCS   @err_rhs_pop
0007D9r 2               
0007D9r 2                     ; Restore left operand and operator from stack
0007D9r 2  68                 PLA
0007DAr 2  85 rr              STA   eval_op
0007DCr 2  68                 PLA
0007DDr 2  85 rr              STA   eval_left_frac
0007DFr 2  68                 PLA
0007E0r 2  85 rr              STA   eval_left_lo
0007E2r 2  68                 PLA
0007E3r 2  85 rr              STA   eval_left_hi
0007E5r 2               
0007E5r 2                     ; Dispatch based on operator character
0007E5r 2  A5 rr              LDA   eval_op
0007E7r 2  C9 2B              CMP   #'+'
0007E9r 2  F0 35              BEQ   @do_add
0007EBr 2  C9 2D              CMP   #'-'
0007EDr 2  F0 46              BEQ   @do_sub
0007EFr 2  C9 2A              CMP   #'*'
0007F1r 2  F0 57              BEQ   @do_mul
0007F3r 2  C9 2F              CMP   #'/'
0007F5r 2  F0 75              BEQ   @do_div
0007F7r 2  C9 3E              CMP   #'>'
0007F9r 2  D0 03              BNE   :+
0007FBr 2  4C rr rr           JMP   @do_gt
0007FEr 2  C9 3C        :     CMP   #'<'
000800r 2  D0 03              BNE   :+
000802r 2  4C rr rr           JMP   @do_lt
000805r 2  C9 3D        :     CMP   #'='
000807r 2  D0 03              BNE   :+
000809r 2  4C rr rr           JMP   @do_eq
00080Cr 2               :
00080Cr 2                     ; Unknown operator — return left value unchanged
00080Cr 2  A5 rr              LDA   eval_left_hi
00080Er 2  85 rr              STA   eval_val_hi
000810r 2  A5 rr              LDA   eval_left_lo
000812r 2  85 rr              STA   eval_val_lo
000814r 2  A5 rr              LDA   eval_left_frac
000816r 2  85 rr              STA   eval_val_frac
000818r 2               
000818r 2               @no_infix:
000818r 2  18                 CLC
000819r 2  60                 RTS
00081Ar 2               
00081Ar 2               @err_rhs_pop:
00081Ar 2                     ; Discard saved left operand + operator (4 bytes)
00081Ar 2  68                 PLA
00081Br 2  68                 PLA
00081Cr 2  68                 PLA
00081Dr 2  68                 PLA
00081Er 2               @err_rhs:
00081Er 2  38                 SEC
00081Fr 2  60                 RTS
000820r 2               
000820r 2                     ; ----- Addition: left + right (24-bit: frac, lo, hi) -----
000820r 2               @do_add:
000820r 2  18                 CLC
000821r 2  A5 rr              LDA   eval_left_frac
000823r 2  65 rr              ADC   eval_val_frac
000825r 2  85 rr              STA   eval_val_frac
000827r 2  A5 rr              LDA   eval_left_lo
000829r 2  65 rr              ADC   eval_val_lo
00082Br 2  85 rr              STA   eval_val_lo
00082Dr 2  A5 rr              LDA   eval_left_hi
00082Fr 2  65 rr              ADC   eval_val_hi
000831r 2  85 rr              STA   eval_val_hi
000833r 2  18                 CLC
000834r 2  60                 RTS
000835r 2               
000835r 2                     ; ----- Subtraction: left - right (24-bit) -----
000835r 2               @do_sub:
000835r 2  38                 SEC
000836r 2  A5 rr              LDA   eval_left_frac
000838r 2  E5 rr              SBC   eval_val_frac
00083Ar 2  85 rr              STA   eval_val_frac
00083Cr 2  A5 rr              LDA   eval_left_lo
00083Er 2  E5 rr              SBC   eval_val_lo
000840r 2  85 rr              STA   eval_val_lo
000842r 2  A5 rr              LDA   eval_left_hi
000844r 2  E5 rr              SBC   eval_val_hi
000846r 2  85 rr              STA   eval_val_hi
000848r 2  18                 CLC
000849r 2  60                 RTS
00084Ar 2               
00084Ar 2                     ; ----- Multiplication: left * right via coprocessor -----
00084Ar 2                     ; Integer-only for this pass (frac ignored)
00084Ar 2               @do_mul:
00084Ar 2  A5 rr              LDA   eval_left_lo
00084Cr 2  8D 20 BB           STA   MATH_MUL16_A_LO
00084Fr 2  A5 rr              LDA   eval_left_hi
000851r 2  8D 21 BB           STA   MATH_MUL16_A_HI
000854r 2  A5 rr              LDA   eval_val_lo
000856r 2  8D 22 BB           STA   MATH_MUL16_B_LO
000859r 2  A5 rr              LDA   eval_val_hi
00085Br 2  8D 23 BB           STA   MATH_MUL16_B_HI     ; write triggers multiply
00085Er 2  AD 38 BB           LDA   MATH_RES0
000861r 2  85 rr              STA   eval_val_lo
000863r 2  AD 39 BB           LDA   MATH_RES1
000866r 2  85 rr              STA   eval_val_hi
000868r 2  64 rr              STZ   eval_val_frac
00086Ar 2  18                 CLC
00086Br 2  60                 RTS
00086Cr 2               
00086Cr 2                     ; ----- Division: left / right via coprocessor -----
00086Cr 2                     ; Signed 32÷16: dividend = sign-extended left integer, divisor = right integer
00086Cr 2               @do_div:
00086Cr 2                     ; Check for divide by zero
00086Cr 2  A5 rr              LDA   eval_val_lo
00086Er 2  05 rr              ORA   eval_val_hi
000870r 2  D0 08              BNE   @div_ok
000872r 2                     ; Division by zero — return 0
000872r 2  64 rr              STZ   eval_val_frac
000874r 2  64 rr              STZ   eval_val_lo
000876r 2  64 rr              STZ   eval_val_hi
000878r 2  18                 CLC
000879r 2  60                 RTS
00087Ar 2               @div_ok:
00087Ar 2                     ; Write 32-bit dividend (sign-extend left integer to 32 bits)
00087Ar 2  A5 rr              LDA   eval_left_lo
00087Cr 2  8D 28 BB           STA   MATH_DIV_N_LO
00087Fr 2  A5 rr              LDA   eval_left_hi
000881r 2  8D 29 BB           STA   MATH_DIV_N_1
000884r 2                     ; Sign-extend high word
000884r 2  A5 rr              LDA   eval_left_hi
000886r 2  09 7F              ORA   #$7F                 ; set bits 0-6
000888r 2  30 04              BMI   @neg_ext             ; if bit 7 was set, A=$FF (negative)
00088Ar 2  A9 00              LDA   #$00                 ; positive: extend with $00
00088Cr 2  80 00              BRA   @write_ext
00088Er 2               @neg_ext:                        ; A is already $FF
00088Er 2               @write_ext:
00088Er 2  8D 2A BB           STA   MATH_DIV_N_2
000891r 2  8D 2B BB           STA   MATH_DIV_N_HI
000894r 2                     ; Write 16-bit divisor (right operand integer)
000894r 2  A5 rr              LDA   eval_val_lo
000896r 2  8D 2C BB           STA   MATH_DIV_D_LO
000899r 2  A5 rr              LDA   eval_val_hi
00089Br 2  8D 2D BB           STA   MATH_DIV_D_HI       ; write triggers divide
00089Er 2                     ; Read quotient from result
00089Er 2  AD 38 BB           LDA   MATH_RES0
0008A1r 2  85 rr              STA   eval_val_lo
0008A3r 2  AD 39 BB           LDA   MATH_RES1
0008A6r 2  85 rr              STA   eval_val_hi
0008A8r 2  64 rr              STZ   eval_val_frac
0008AAr 2  18                 CLC
0008ABr 2  60                 RTS
0008ACr 2               
0008ACr 2                     ; ----- Equality: left = right (all 3 bytes must match) -----
0008ACr 2               @do_eq:
0008ACr 2  A5 rr              LDA   eval_left_hi
0008AEr 2  C5 rr              CMP   eval_val_hi
0008B0r 2  D0 64              BNE   @set_false
0008B2r 2  A5 rr              LDA   eval_left_lo
0008B4r 2  C5 rr              CMP   eval_val_lo
0008B6r 2  D0 5E              BNE   @set_false
0008B8r 2  A5 rr              LDA   eval_left_frac
0008BAr 2  C5 rr              CMP   eval_val_frac
0008BCr 2  D0 58              BNE   @set_false
0008BEr 2  80 4A              BRA   @set_true
0008C0r 2               
0008C0r 2                     ; ----- Greater than: left > right (signed 24-bit) -----
0008C0r 2               @do_gt:
0008C0r 2                     ; Compare hi bytes (signed)
0008C0r 2  A5 rr              LDA   eval_left_hi
0008C2r 2  38                 SEC
0008C3r 2  E5 rr              SBC   eval_val_hi
0008C5r 2  50 02              BVC   @gt_sign_ok           ; no overflow — N flag valid
0008C7r 2  49 80              EOR   #$80                  ; overflow — invert N to get true sign
0008C9r 2               @gt_sign_ok:
0008C9r 2  30 4B              BMI   @set_false            ; left_hi < right_hi → false
0008CBr 2                     ; If the subtraction was nonzero and positive, left > right
0008CBr 2  A5 rr              LDA   eval_left_hi
0008CDr 2  C5 rr              CMP   eval_val_hi
0008CFr 2  D0 39              BNE   @set_true             ; hi bytes differ, and left > right
0008D1r 2                     ; Hi bytes equal — compare lo bytes (unsigned)
0008D1r 2  A5 rr              LDA   eval_left_lo
0008D3r 2  C5 rr              CMP   eval_val_lo
0008D5r 2  D0 0A              BNE   @gt_lo_diff
0008D7r 2                     ; Lo bytes equal — compare frac bytes (unsigned)
0008D7r 2  A5 rr              LDA   eval_left_frac
0008D9r 2  C5 rr              CMP   eval_val_frac
0008DBr 2  F0 39              BEQ   @set_false            ; all equal → not greater
0008DDr 2  B0 2B              BCS   @set_true
0008DFr 2  80 35              BRA   @set_false
0008E1r 2               @gt_lo_diff:
0008E1r 2  B0 27              BCS   @set_true
0008E3r 2  80 31              BRA   @set_false
0008E5r 2               
0008E5r 2                     ; ----- Less than: left < right (signed 24-bit) -----
0008E5r 2               @do_lt:
0008E5r 2                     ; Compare hi bytes (signed)
0008E5r 2  A5 rr              LDA   eval_left_hi
0008E7r 2  38                 SEC
0008E8r 2  E5 rr              SBC   eval_val_hi
0008EAr 2  50 02              BVC   @lt_sign_ok
0008ECr 2  49 80              EOR   #$80
0008EEr 2               @lt_sign_ok:
0008EEr 2  30 1A              BMI   @set_true             ; left_hi < right_hi → true
0008F0r 2  A5 rr              LDA   eval_left_hi
0008F2r 2  C5 rr              CMP   eval_val_hi
0008F4r 2  D0 20              BNE   @set_false            ; left_hi > right_hi → false
0008F6r 2                     ; Hi bytes equal — compare lo bytes (unsigned)
0008F6r 2  A5 rr              LDA   eval_left_lo
0008F8r 2  C5 rr              CMP   eval_val_lo
0008FAr 2  D0 0A              BNE   @lt_lo_diff
0008FCr 2                     ; Lo bytes equal — compare frac (unsigned)
0008FCr 2  A5 rr              LDA   eval_left_frac
0008FEr 2  C5 rr              CMP   eval_val_frac
000900r 2  F0 14              BEQ   @set_false            ; equal → not less
000902r 2  90 06              BCC   @set_true
000904r 2  80 10              BRA   @set_false
000906r 2               @lt_lo_diff:
000906r 2  90 02              BCC   @set_true
000908r 2  80 0C              BRA   @set_false
00090Ar 2               
00090Ar 2                     ; ----- Set result to TRUE (1) or FALSE (0) -----
00090Ar 2               @set_true:
00090Ar 2  64 rr              STZ   eval_val_hi
00090Cr 2  A9 01              LDA   #1
00090Er 2  85 rr              STA   eval_val_lo
000910r 2  64 rr              STZ   eval_val_frac
000912r 2  64 rr              STZ   eval_type
000914r 2  18                 CLC
000915r 2  60                 RTS
000916r 2               
000916r 2               @set_false:
000916r 2  64 rr              STZ   eval_val_hi
000918r 2  64 rr              STZ   eval_val_lo
00091Ar 2  64 rr              STZ   eval_val_frac
00091Cr 2  64 rr              STZ   eval_type
00091Er 2  18                 CLC
00091Fr 2  60                 RTS
000920r 2               
000920r 2               ; ---------------------------------------------------------------------
000920r 2               ; print_number — print eval_val as a signed decimal number
000920r 2               ;   Input: eval_val_hi/lo/frac (16.8 fixed-point, signed)
000920r 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
000920r 2               ; ---------------------------------------------------------------------
000920r 2               print_number:
000920r 2                     ; Check sign — if negative, print '-' and negate
000920r 2  A5 rr              LDA   eval_val_hi
000922r 2  10 1E              BPL   @positive
000924r 2                     ; Print minus sign
000924r 2  A9 2D              LDA   #'-'
000926r 2  8D 0E A0           STA   VGC_CHAROUT
000929r 2                     ; Negate 3-byte value (two's complement)
000929r 2  A5 rr              LDA   eval_val_frac
00092Br 2  49 FF              EOR   #$FF
00092Dr 2  18                 CLC
00092Er 2  69 01              ADC   #1
000930r 2  85 rr              STA   eval_val_frac
000932r 2  A5 rr              LDA   eval_val_lo
000934r 2  49 FF              EOR   #$FF
000936r 2  69 00              ADC   #0
000938r 2  85 rr              STA   eval_val_lo
00093Ar 2  A5 rr              LDA   eval_val_hi
00093Cr 2  49 FF              EOR   #$FF
00093Er 2  69 00              ADC   #0
000940r 2  85 rr              STA   eval_val_hi
000942r 2               
000942r 2               @positive:
000942r 2                     ; Print integer part (eval_val_hi:eval_val_lo as 16-bit unsigned)
000942r 2  20 rr rr           JSR   print_uint16
000945r 2               
000945r 2                     ; Print fractional part if non-zero
000945r 2  A5 rr              LDA   eval_val_frac
000947r 2  D0 01              BNE   @has_frac
000949r 2  60                 RTS
00094Ar 2               @has_frac:
00094Ar 2               
00094Ar 2                     ; Print decimal point
00094Ar 2  A9 2E              LDA   #'.'
00094Cr 2  8D 0E A0           STA   VGC_CHAROUT
00094Fr 2               
00094Fr 2                     ; Convert frac byte to decimal digits
00094Fr 2                     ; frac * 10 / 256 = first digit, repeat with remainder
00094Fr 2  A5 rr              LDA   eval_val_frac
000951r 2  8D rr rr           STA   num_tmp_lo
000954r 2  9C rr rr           STZ   num_tmp_hi
000957r 2               
000957r 2                     ; First digit: (frac * 10) >> 8
000957r 2                     ; frac * 10 = (frac * 8) + (frac * 2)
000957r 2  AD rr rr           LDA   num_tmp_lo
00095Ar 2  0A                 ASL
00095Br 2  8D rr rr           STA   num_val_lo          ; frac * 2
00095Er 2  AD rr rr           LDA   num_tmp_hi
000961r 2  2A                 ROL
000962r 2  8D rr rr           STA   num_val_hi
000965r 2               
000965r 2  0E rr rr           ASL   num_val_lo
000968r 2  2E rr rr           ROL   num_val_hi
00096Br 2  0E rr rr           ASL   num_val_lo
00096Er 2  2E rr rr           ROL   num_val_hi          ; frac * 8
000971r 2               
000971r 2  18                 CLC
000972r 2  AD rr rr           LDA   num_tmp_lo
000975r 2  0A                 ASL                       ; frac * 2 (low byte)
000976r 2  6D rr rr           ADC   num_val_lo
000979r 2  8D rr rr           STA   num_val_lo
00097Cr 2  AD rr rr           LDA   num_tmp_hi
00097Fr 2  2A                 ROL
000980r 2  6D rr rr           ADC   num_val_hi
000983r 2  8D rr rr           STA   num_val_hi          ; num_val = frac * 10
000986r 2               
000986r 2                     ; High byte = first decimal digit
000986r 2  AD rr rr           LDA   num_val_hi
000989r 2  09 30              ORA   #'0'
00098Br 2  8D 0E A0           STA   VGC_CHAROUT
00098Er 2               
00098Er 2                     ; Remainder = low byte → second digit
00098Er 2  AD rr rr           LDA   num_val_lo
000991r 2  8D rr rr           STA   num_tmp_lo
000994r 2  9C rr rr           STZ   num_tmp_hi
000997r 2               
000997r 2                     ; Second digit: (remainder * 10) >> 8
000997r 2  AD rr rr           LDA   num_tmp_lo
00099Ar 2  0A                 ASL
00099Br 2  8D rr rr           STA   num_val_lo
00099Er 2  AD rr rr           LDA   num_tmp_hi
0009A1r 2  2A                 ROL
0009A2r 2  8D rr rr           STA   num_val_hi
0009A5r 2               
0009A5r 2  0E rr rr           ASL   num_val_lo
0009A8r 2  2E rr rr           ROL   num_val_hi
0009ABr 2  0E rr rr           ASL   num_val_lo
0009AEr 2  2E rr rr           ROL   num_val_hi
0009B1r 2               
0009B1r 2  18                 CLC
0009B2r 2  AD rr rr           LDA   num_tmp_lo
0009B5r 2  0A                 ASL
0009B6r 2  6D rr rr           ADC   num_val_lo
0009B9r 2  8D rr rr           STA   num_val_lo
0009BCr 2  AD rr rr           LDA   num_tmp_hi
0009BFr 2  2A                 ROL
0009C0r 2  6D rr rr           ADC   num_val_hi
0009C3r 2  8D rr rr           STA   num_val_hi
0009C6r 2               
0009C6r 2                     ; High byte = second digit; skip if zero (trailing)
0009C6r 2  AD rr rr           LDA   num_val_hi
0009C9r 2  F0 05              BEQ   @done
0009CBr 2  09 30              ORA   #'0'
0009CDr 2  8D 0E A0           STA   VGC_CHAROUT
0009D0r 2               
0009D0r 2               @done:
0009D0r 2  60                 RTS
0009D1r 2               
0009D1r 2               ; ---------------------------------------------------------------------
0009D1r 2               ; print_uint16 — print eval_val_hi:eval_val_lo as unsigned decimal
0009D1r 2               ;   No leading zeros (except value 0 prints "0")
0009D1r 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
0009D1r 2               ; ---------------------------------------------------------------------
0009D1r 2               print_uint16:
0009D1r 2                     ; Copy to working regs
0009D1r 2  A5 rr              LDA   eval_val_lo
0009D3r 2  8D rr rr           STA   num_val_lo
0009D6r 2  A5 rr              LDA   eval_val_hi
0009D8r 2  8D rr rr           STA   num_val_hi
0009DBr 2               
0009DBr 2  A2 00              LDX   #0                  ; digit buffer index
0009DDr 2  A0 00              LDY   #0                  ; power-of-10 table index
0009DFr 2               
0009DFr 2               @div_loop:
0009DFr 2  9C rr rr           STZ   num_tmp_lo          ; digit counter for this power
0009E2r 2               @sub_loop:
0009E2r 2                     ; Subtract current power of 10
0009E2r 2  38                 SEC
0009E3r 2  AD rr rr           LDA   num_val_lo
0009E6r 2  F9 rr rr           SBC   pow10_lo,Y
0009E9r 2  48                 PHA
0009EAr 2  AD rr rr           LDA   num_val_hi
0009EDr 2  F9 rr rr           SBC   pow10_hi,Y
0009F0r 2  90 0C              BCC   @sub_done           ; underflow — done with this digit
0009F2r 2  8D rr rr           STA   num_val_hi
0009F5r 2  68                 PLA
0009F6r 2  8D rr rr           STA   num_val_lo
0009F9r 2  EE rr rr           INC   num_tmp_lo
0009FCr 2  80 E4              BRA   @sub_loop
0009FEr 2               @sub_done:
0009FEr 2  68                 PLA                       ; discard low byte from failed subtract
0009FFr 2  AD rr rr           LDA   num_tmp_lo
000A02r 2  9D rr rr           STA   pn_buf,X
000A05r 2  E8                 INX
000A06r 2  C8                 INY
000A07r 2  C0 05              CPY   #5                  ; 5 powers (10000,1000,100,10,1)
000A09r 2  90 D4              BCC   @div_loop
000A0Br 2               
000A0Br 2                     ; Print digits, suppressing leading zeros
000A0Br 2  A0 00              LDY   #0                  ; suppress flag (0=suppress)
000A0Dr 2  A2 00              LDX   #0
000A0Fr 2               @print_loop:
000A0Fr 2  BD rr rr           LDA   pn_buf,X
000A12r 2  D0 04              BNE   @nonzero
000A14r 2  C0 00              CPY   #0
000A16r 2  F0 07              BEQ   @maybe_skip        ; still suppressing
000A18r 2               @nonzero:
000A18r 2  A0 01              LDY   #1                  ; seen nonzero digit
000A1Ar 2  09 30              ORA   #'0'
000A1Cr 2  8D 0E A0           STA   VGC_CHAROUT
000A1Fr 2               @maybe_skip:
000A1Fr 2  E8                 INX
000A20r 2  E0 04              CPX   #4
000A22r 2  90 EB              BCC   @print_loop
000A24r 2                     ; Always print the last digit (ones place)
000A24r 2  AD rr rr           LDA   pn_buf+4
000A27r 2  09 30              ORA   #'0'
000A29r 2  8D 0E A0           STA   VGC_CHAROUT
000A2Cr 2  60                 RTS
000A2Dr 2               
000A2Dr 2               ; ---------------------------------------------------------------------
000A2Dr 2               ; try_throw_error — if a CATCH with tag "ERROR" is active, unwind to it
000A2Dr 2               ;   Called after error messages are printed. If no catch is active or
000A2Dr 2               ;   the tag doesn't match "ERROR", this is a no-op (returns normally).
000A2Dr 2               ;   If a match is found, this NEVER RETURNS — it unwinds the stack
000A2Dr 2               ;   via TXS and jumps to the catch resume point.
000A2Dr 2               ; ---------------------------------------------------------------------
000A2Dr 2               try_throw_error:
000A2Dr 2  A5 rr              LDA   catch_active
000A2Fr 2  F0 3A              BEQ   @no_catch
000A31r 2               
000A31r 2                     ; Compare catch_tag against "ERROR" (5 chars, uppercased)
000A31r 2  A5 rr              LDA   catch_tag_lo
000A33r 2  85 rr              STA   ptr2_lo
000A35r 2  A5 rr              LDA   catch_tag_hi
000A37r 2  85 rr              STA   ptr2_hi
000A39r 2  A9 rr              LDA   #<str_error_tag
000A3Br 2  85 rr              STA   ptr_lo
000A3Dr 2  A9 rr              LDA   #>str_error_tag
000A3Fr 2  85 rr              STA   ptr_hi
000A41r 2  20 rr rr           JSR   catch_tags_equal
000A44r 2  90 25              BCC   @no_catch
000A46r 2               
000A46r 2                     ; Match! Unwind stack to catch point and resume.
000A46r 2  A6 rr              LDX   catch_sp
000A48r 2  9A                 TXS
000A49r 2               
000A49r 2                     ; Restore previous catch frame from the restored stack
000A49r 2  68                 PLA
000A4Ar 2  85 rr              STA   catch_resume_hi
000A4Cr 2  68                 PLA
000A4Dr 2  85 rr              STA   catch_resume_lo
000A4Fr 2  68                 PLA
000A50r 2  85 rr              STA   catch_sp
000A52r 2  68                 PLA
000A53r 2  85 rr              STA   catch_tag_hi
000A55r 2  68                 PLA
000A56r 2  85 rr              STA   catch_tag_lo
000A58r 2  68                 PLA
000A59r 2  85 rr              STA   catch_active
000A5Br 2               
000A5Br 2                     ; Restore eval_in_body and discard saved tag pointer (3 bytes)
000A5Br 2  68                 PLA
000A5Cr 2  85 rr              STA   eval_in_body
000A5Er 2  68                 PLA                         ; tag_hi
000A5Fr 2  68                 PLA                         ; tag_lo
000A60r 2               
000A60r 2                     ; Set eval_cur to resume point (past the caught body)
000A60r 2  A5 rr              LDA   catch_resume_lo
000A62r 2  85 rr              STA   eval_cur_lo
000A64r 2  A5 rr              LDA   catch_resume_hi
000A66r 2  85 rr              STA   eval_cur_hi
000A68r 2               
000A68r 2  4C rr rr           JMP   eval_continue
000A6Br 2               
000A6Br 2               @no_catch:
000A6Br 2  60                 RTS
000A6Cr 2               
000A6Cr 2               ; ---------------------------------------------------------------------
000A6Cr 2               ; catch_tags_equal — compare two length-prefixed strings (case-insensitive)
000A6Cr 2               ;   Input: ptr_lo/hi = string A, ptr2_lo/hi = string B
000A6Cr 2               ;   Output: carry set = equal, carry clear = not equal
000A6Cr 2               ;   Clobbers: A, X, Y
000A6Cr 2               ; ---------------------------------------------------------------------
000A6Cr 2               catch_tags_equal:
000A6Cr 2  A0 00              LDY   #0
000A6Er 2  B1 rr              LDA   (ptr_lo),Y           ; length of A
000A70r 2  8D rr rr           STA   num_tmp_lo            ; temp: len A
000A73r 2  B1 rr              LDA   (ptr2_lo),Y          ; length of B
000A75r 2  CD rr rr           CMP   num_tmp_lo
000A78r 2  D0 2D              BNE   @ne
000A7Ar 2               
000A7Ar 2                     ; Lengths match — compare chars
000A7Ar 2  AA                 TAX                         ; X = length
000A7Br 2  F0 28              BEQ   @eq                   ; both zero = equal
000A7Dr 2  A0 01              LDY   #1
000A7Fr 2               @cmp:
000A7Fr 2  B1 rr              LDA   (ptr_lo),Y
000A81r 2                     ; Uppercase A char
000A81r 2  C9 61              CMP   #'a'
000A83r 2  90 07              BCC   @a_up
000A85r 2  C9 7B              CMP   #'z'+1
000A87r 2  B0 03              BCS   @a_up
000A89r 2  38                 SEC
000A8Ar 2  E9 20              SBC   #$20
000A8Cr 2               @a_up:
000A8Cr 2  8D rr rr           STA   num_tmp_lo            ; uppercased A char
000A8Fr 2               
000A8Fr 2  B1 rr              LDA   (ptr2_lo),Y
000A91r 2                     ; Uppercase B char
000A91r 2  C9 61              CMP   #'a'
000A93r 2  90 07              BCC   @b_up
000A95r 2  C9 7B              CMP   #'z'+1
000A97r 2  B0 03              BCS   @b_up
000A99r 2  38                 SEC
000A9Ar 2  E9 20              SBC   #$20
000A9Cr 2               @b_up:
000A9Cr 2  CD rr rr           CMP   num_tmp_lo
000A9Fr 2  D0 06              BNE   @ne
000AA1r 2  C8                 INY
000AA2r 2  CA                 DEX
000AA3r 2  D0 DA              BNE   @cmp
000AA5r 2               
000AA5r 2               @eq:
000AA5r 2  38                 SEC
000AA6r 2  60                 RTS
000AA7r 2               @ne:
000AA7r 2  18                 CLC
000AA8r 2  60                 RTS
000AA9r 2               
000AA9r 2               ; =====================================================================
000AA9r 2               ; RODATA — evaluator strings and tables
000AA9r 2               ; =====================================================================
000AA9r 2               ; ---------------------------------------------------------------------
000AA9r 2               ; lookup_ext_cmd — search ext_cmd_table for the current TOK_WORD
000AA9r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000AA9r 2               ;   Output: Carry clear = found, A = arity, EXT_CMD set
000AA9r 2               ;           Carry set = not found
000AA9r 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000AA9r 2               ; ---------------------------------------------------------------------
000AA9r 2               lookup_ext_cmd:
000AA9r 2                     ; Save table pointer in num_tmp_lo/hi
000AA9r 2  A9 rr              LDA   #<ext_cmd_table
000AABr 2  8D rr rr           STA   num_tmp_lo
000AAEr 2  A9 rr              LDA   #>ext_cmd_table
000AB0r 2  8D rr rr           STA   num_tmp_hi
000AB3r 2               
000AB3r 2               @scan:
000AB3r 2                     ; Read name pointer from table
000AB3r 2  AD rr rr           LDA   num_tmp_lo
000AB6r 2  85 rr              STA   ptr2_lo
000AB8r 2  AD rr rr           LDA   num_tmp_hi
000ABBr 2  85 rr              STA   ptr2_hi
000ABDr 2  A0 00              LDY   #0
000ABFr 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000AC1r 2  AA                 TAX
000AC2r 2  C8                 INY
000AC3r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000AC5r 2  D0 06              BNE   @have_entry
000AC7r 2  E0 00              CPX   #0
000AC9r 2  D0 02              BNE   @have_entry
000ACBr 2                     ; Null pointer — end of table
000ACBr 2  38                 SEC
000ACCr 2  60                 RTS
000ACDr 2               
000ACDr 2               @have_entry:
000ACDr 2                     ; X = name_ptr_lo, A = name_ptr_hi
000ACDr 2  85 rr              STA   ptr2_hi
000ACFr 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000AD1r 2               
000AD1r 2                     ; Get token payload pointer
000AD1r 2  A5 rr              LDA   eval_cur_lo
000AD3r 2  85 rr              STA   ptr_lo
000AD5r 2  A5 rr              LDA   eval_cur_hi
000AD7r 2  85 rr              STA   ptr_hi
000AD9r 2               
000AD9r 2                     ; Compare length bytes
000AD9r 2  A0 00              LDY   #0
000ADBr 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000ADDr 2  A0 03              LDY   #TOK_PAYLOAD
000ADFr 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000AE1r 2  D0 35              BNE   @next
000AE3r 2               
000AE3r 2                     ; Lengths match — compare chars
000AE3r 2  AA                 TAX                       ; X = length
000AE4r 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000AE6r 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000AE8r 2               @cmp_loop:
000AE8r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000AEAr 2  5A                 PHY
000AEBr 2  A5 rr              LDA   tok_sign
000AEDr 2  18                 CLC
000AEEr 2  69 04              ADC   #TOK_PAYLOAD+1
000AF0r 2  A8                 TAY
000AF1r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000AF3r 2  7A                 PLY
000AF4r 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000AF6r 2  D0 20              BNE   @next
000AF8r 2  C8                 INY
000AF9r 2  E6 rr              INC   tok_sign
000AFBr 2  CA                 DEX
000AFCr 2  D0 EA              BNE   @cmp_loop
000AFEr 2               
000AFEr 2                     ; Match found — read module_id, fn_id and arity
000AFEr 2                     ; Table entry: name_ptr(2) + module_id(1) + fn_id(1) + arity(1)
000AFEr 2  AD rr rr           LDA   num_tmp_lo
000B01r 2  85 rr              STA   ptr_lo
000B03r 2  AD rr rr           LDA   num_tmp_hi
000B06r 2  85 rr              STA   ptr_hi
000B08r 2  A0 02              LDY   #2
000B0Ar 2  B1 rr              LDA   (ptr_lo),Y         ; module_id
000B0Cr 2  85 rr              STA   ext_mod_id
000B0Er 2  C8                 INY
000B0Fr 2  B1 rr              LDA   (ptr_lo),Y         ; fn_id (legacy EXT_CMD value)
000B11r 2  85 80              STA   EXT_CMD
000B13r 2  C8                 INY
000B14r 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000B16r 2  18                 CLC                       ; found
000B17r 2  60                 RTS
000B18r 2               
000B18r 2               @next:
000B18r 2  64 rr              STZ   tok_sign
000B1Ar 2                     ; Advance to next entry: +5 bytes (2 name + 1 module_id + 1 fn_id + 1 arity)
000B1Ar 2  18                 CLC
000B1Br 2  AD rr rr           LDA   num_tmp_lo
000B1Er 2  69 05              ADC   #5
000B20r 2  8D rr rr           STA   num_tmp_lo
000B23r 2  90 03              BCC   :+
000B25r 2  EE rr rr           INC   num_tmp_hi
000B28r 2               :
000B28r 2  4C rr rr           JMP   @scan
000B2Br 2               
000B2Br 2               ; ---------------------------------------------------------------------
000B2Br 2               ; ext_eval_args — evaluate X arguments and copy to EXT_ARG0..2 slots
000B2Br 2               ;   Input: X = argument count (0-3)
000B2Br 2               ;   Output: Carry clear = success, Carry set = error
000B2Br 2               ;           EXT_ARGC set, EXT_ARG0..2 populated
000B2Br 2               ;   Clobbers: A, X, Y
000B2Br 2               ; ---------------------------------------------------------------------
000B2Br 2               ext_eval_args:
000B2Br 2  86 81              STX   EXT_ARGC
000B2Dr 2  E0 00              CPX   #0
000B2Fr 2  F0 65              BEQ   @done
000B31r 2               
000B31r 2                     ; Evaluate arg 0
000B31r 2  DA                 PHX
000B32r 2  20 rr rr           JSR   eval_expr
000B35r 2  FA                 PLX
000B36r 2  B0 60              BCS   @err
000B38r 2  A5 rr              LDA   eval_type
000B3Ar 2  85 82              STA   EXT_ARG0_TYPE
000B3Cr 2  A5 rr              LDA   eval_val_hi
000B3Er 2  85 83              STA   EXT_ARG0_HI
000B40r 2  A5 rr              LDA   eval_val_lo
000B42r 2  85 84              STA   EXT_ARG0_LO
000B44r 2  A5 rr              LDA   eval_val_frac
000B46r 2  85 85              STA   EXT_ARG0_FRAC
000B48r 2  CA                 DEX
000B49r 2  F0 4B              BEQ   @done
000B4Br 2               
000B4Br 2                     ; Evaluate arg 1
000B4Br 2  DA                 PHX
000B4Cr 2  20 rr rr           JSR   eval_expr
000B4Fr 2  FA                 PLX
000B50r 2  B0 46              BCS   @err
000B52r 2  A5 rr              LDA   eval_type
000B54r 2  85 86              STA   EXT_ARG1_TYPE
000B56r 2  A5 rr              LDA   eval_val_hi
000B58r 2  85 87              STA   EXT_ARG1_HI
000B5Ar 2  A5 rr              LDA   eval_val_lo
000B5Cr 2  85 88              STA   EXT_ARG1_LO
000B5Er 2  A5 rr              LDA   eval_val_frac
000B60r 2  85 89              STA   EXT_ARG1_FRAC
000B62r 2  CA                 DEX
000B63r 2  F0 31              BEQ   @done
000B65r 2               
000B65r 2                     ; Evaluate arg 2
000B65r 2  DA                 PHX
000B66r 2  20 rr rr           JSR   eval_expr
000B69r 2  FA                 PLX
000B6Ar 2  B0 2C              BCS   @err
000B6Cr 2  A5 rr              LDA   eval_type
000B6Er 2  85 8A              STA   EXT_ARG2_TYPE
000B70r 2  A5 rr              LDA   eval_val_hi
000B72r 2  85 8B              STA   EXT_ARG2_HI
000B74r 2  A5 rr              LDA   eval_val_lo
000B76r 2  85 8C              STA   EXT_ARG2_LO
000B78r 2  A5 rr              LDA   eval_val_frac
000B7Ar 2  85 8D              STA   EXT_ARG2_FRAC
000B7Cr 2  CA                 DEX
000B7Dr 2  F0 17              BEQ   @done
000B7Fr 2               
000B7Fr 2                     ; Evaluate arg 3 (for LINE, RECT, FILL etc.)
000B7Fr 2  DA                 PHX
000B80r 2  20 rr rr           JSR   eval_expr
000B83r 2  FA                 PLX
000B84r 2  B0 12              BCS   @err
000B86r 2  A5 rr              LDA   eval_type
000B88r 2  85 9F              STA   EXT_ARG3_TYPE
000B8Ar 2  A5 rr              LDA   eval_val_hi
000B8Cr 2  85 A0              STA   EXT_ARG3_HI
000B8Er 2  A5 rr              LDA   eval_val_lo
000B90r 2  85 A1              STA   EXT_ARG3_LO
000B92r 2  A5 rr              LDA   eval_val_frac
000B94r 2  85 A2              STA   EXT_ARG3_FRAC
000B96r 2               
000B96r 2               @done:
000B96r 2  18                 CLC
000B97r 2  60                 RTS
000B98r 2               @err:
000B98r 2  38                 SEC
000B99r 2  60                 RTS
000B9Ar 2               
000B9Ar 2               ; ---------------------------------------------------------------------
000B9Ar 2               ; ensure_ext_resident — guarantee the active runtime's OWN extension is mapped
000B9Ar 2               ;   in bank 1 before a legacy EXT_TRAMPOLINE (JSR $C000) call. A prior
000B9Ar 2               ;   lib_call(MODULE) page-in physically overwrote bank 1 with the module; this
000B9Ar 2               ;   re-pages the host ext (staged in XRAM at $07C000) back into bank 1 on demand.
000B9Ar 2               ;
000B9Ar 2               ;   At boot the host ext IS in bank 1 (cold_start seeds LIB_RESIDENT=$FF), so the
000B9Ar 2               ;   common case is a cheap HIT (no page-in, no behaviour change for legacy cmds).
000B9Ar 2               ;
000B9Ar 2               ;   No PGD_STATUS poll — matches lib_call, which relies on the page-in completing
000B9Ar 2               ;   synchronously / CPU stall. Clobbers A. Caller has no live A/X/Y across this.
000B9Ar 2               ; ---------------------------------------------------------------------
000B9Ar 2               ensure_ext_resident:
000B9Ar 2  AD 18 03           LDA   LIB_RESIDENT
000B9Dr 2  C9 FF              CMP   #LIB_RESIDENT_HOSTEXT
000B9Fr 2  F0 23              BEQ   @done                 ; ext already in bank 1 -> nothing to do (HIT)
000BA1r 2  A9 00              LDA   #HOST_EXT_XRAM_L
000BA3r 2  8D 78 BA           STA   PGD_SRCL
000BA6r 2  A9 C0              LDA   #HOST_EXT_XRAM_M
000BA8r 2  8D 79 BA           STA   PGD_SRCM
000BABr 2  A9 07              LDA   #HOST_EXT_XRAM_H
000BADr 2  8D 7A BA           STA   PGD_SRCH
000BB0r 2  A9 00              LDA   #<SHELF_SLOT_WORDS
000BB2r 2  8D 7B BA           STA   PGD_WORDSL
000BB5r 2  A9 20              LDA   #>SHELF_SLOT_WORDS
000BB7r 2  8D 7C BA           STA   PGD_WORDSH
000BBAr 2  A9 01              LDA   #PGD_START
000BBCr 2  8D 76 BA           STA   PGD_CMD               ; DMA host ext -> bank 1 (CPU stalls on HW; sync on emu)
000BBFr 2  A9 FF              LDA   #LIB_RESIDENT_HOSTEXT
000BC1r 2  8D 18 03           STA   LIB_RESIDENT
000BC4r 2               @done:
000BC4r 2  60                 RTS
000BC5r 2               
000BC5r 2               ; --- Logo-foundation adapter sentinel (4c.1-3) ---
000BC5r 2               ; A pseudo-module-id used in ext_cmd_table for Logo commands that do NOT 1:1-map
000BC5r 2               ; to a single GFN. ext_invoke recognizes it and runs a local adapter routine that
000BC5r 2               ; issues one-or-more real lib_call(GRAPHICS) sequences. $FE is distinct from real
000BC5r 2               ; module ids ($01-$7F), from MODULE_ID_NONE ($00) and from LIB_RESIDENT_HOSTEXT
000BC5r 2               ; ($FF). EXT_CMD holds the adapter index for these entries.
000BC5r 2               MODULE_ID_GFXADAPTER = $FE
000BC5r 2               GADAPT_SPRITE        = $00        ; SPRITE n x y  -> GFN_SPR_POS then GFN_SPR_ENABLE
000BC5r 2               GADAPT_SPRCOLLP      = $01        ; SPRITECOLLISION? n -> GFN_SPR_COLL_MASK, test bit n
000BC5r 2               
000BC5r 2               ; ext_invoke — dispatch the looked-up extension command and leave its
000BC5r 2               ;   result in eval_type/eval_val_hi/eval_val_lo/eval_val_frac, then RTS.
000BC5r 2               ;
000BC5r 2               ;   Entry: args already evaluated (EXT_ARG0..3 + EXT_ARGC populated),
000BC5r 2               ;          EXT_CMD = fn_id, ext_mod_id = module_id.
000BC5r 2               ;
000BC5r 2               ;   Branches on ext_mod_id:
000BC5r 2               ;     MODULE_ID_NONE       -> legacy RAM trampoline (JSR EXT_TRAMPOLINE).
000BC5r 2               ;     MODULE_ID_GFXADAPTER -> Logo-foundation adapter (multi-call composite).
000BC5r 2               ;     other non-zero       -> canonical paged-library lib_call mailbox.
000BC5r 2               ;
000BC5r 2               ;   The arg cells are converted to LIB_ARGn FIRST (so both the single-lib_call
000BC5r 2               ;   path and the adapters share the same converted cells), then we branch.
000BC5r 2               ;
000BC5r 2               ;   Clobbers: A, X, Y. May JMP err_idk_word on a lib error (no return).
000BC5r 2               ; ---------------------------------------------------------------------
000BC5r 2               ext_invoke:
000BC5r 2  A5 rr              LDA   ext_mod_id
000BC7r 2  D0 17              BNE   @convert_args         ; non-zero module id -> paged-library / adapter path
000BC9r 2               
000BC9r 2               ; --- Legacy path: RAM trampoline to extension ROM ---
000BC9r 2  20 rr rr           JSR   ensure_ext_resident   ; re-page host ext into bank 1 if a module clobbered it
000BCCr 2  20 70 02           JSR   EXT_TRAMPOLINE
000BCFr 2  A5 8E              LDA   EXT_RESULT_TYPE
000BD1r 2  85 rr              STA   eval_type
000BD3r 2  A5 8F              LDA   EXT_RESULT_HI
000BD5r 2  85 rr              STA   eval_val_hi
000BD7r 2  A5 90              LDA   EXT_RESULT_LO
000BD9r 2  85 rr              STA   eval_val_lo
000BDBr 2  A5 91              LDA   EXT_RESULT_FRAC
000BDDr 2  85 rr              STA   eval_val_frac
000BDFr 2  60                 RTS
000BE0r 2               
000BE0r 2               ; --- lib_call / adapter path: convert args, then branch on module id ---
000BE0r 2               @convert_args:
000BE0r 2                     ; Convert EXT_ARGn (Logo 16.8: TYPE/HI/LO/FRAC) -> LIB_ARGn (32-bit LE).
000BE0r 2                     ; The GRAPHICS module reads each cell's low word as a signed s16, so map
000BE0r 2                     ; HI:LO into the cell low word, sign-extend into the high word, and DROP
000BE0r 2                     ; the fractional byte.
000BE0r 2                     ;   LIB_ARGn+0 = EXT_ARGn_LO   LIB_ARGn+1 = EXT_ARGn_HI
000BE0r 2                     ;   LIB_ARGn+2 = LIB_ARGn+3 = $FF if EXT_ARGn_HI bit7 set else $00
000BE0r 2                     ;
000BE0r 2                     ; FIRST zero all 16 LIB_ARG bytes so any cell n >= EXT_ARGC reads as 0.
000BE0r 2                     ; This is what makes CIRCLE (arity 3) leave ARG3(ry)=0 -> ry=rx (a circle),
000BE0r 2                     ; and is harmless for every other command.
000BE0r 2  A2 0F              LDX   #15
000BE2r 2               @zero_args:
000BE2r 2  9E 03 03           STZ   LIB_ARG0,X
000BE5r 2  CA                 DEX
000BE6r 2  10 FA              BPL   @zero_args
000BE8r 2               
000BE8r 2  A6 81              LDX   EXT_ARGC
000BEAr 2                     ; arg 0
000BEAr 2  E0 01              CPX   #1
000BECr 2  90 58              BCC   @args_done
000BEEr 2  A5 84              LDA   EXT_ARG0_LO
000BF0r 2  8D 03 03           STA   LIB_ARG0+0
000BF3r 2  A5 83              LDA   EXT_ARG0_HI
000BF5r 2  8D 04 03           STA   LIB_ARG0+1            ; STA does not alter A; A still = HI byte
000BF8r 2  20 rr rr           JSR   @sign_of_a            ; A = $FF if HI bit7 set, else $00
000BFBr 2  8D 05 03           STA   LIB_ARG0+2
000BFEr 2  8D 06 03           STA   LIB_ARG0+3
000C01r 2                     ; arg 1
000C01r 2  E0 02              CPX   #2
000C03r 2  90 41              BCC   @args_done
000C05r 2  A5 88              LDA   EXT_ARG1_LO
000C07r 2  8D 07 03           STA   LIB_ARG1+0
000C0Ar 2  A5 87              LDA   EXT_ARG1_HI
000C0Cr 2  8D 08 03           STA   LIB_ARG1+1
000C0Fr 2  20 rr rr           JSR   @sign_of_a
000C12r 2  8D 09 03           STA   LIB_ARG1+2
000C15r 2  8D 0A 03           STA   LIB_ARG1+3
000C18r 2                     ; arg 2
000C18r 2  E0 03              CPX   #3
000C1Ar 2  90 2A              BCC   @args_done
000C1Cr 2  A5 8C              LDA   EXT_ARG2_LO
000C1Er 2  8D 0B 03           STA   LIB_ARG2+0
000C21r 2  A5 8B              LDA   EXT_ARG2_HI
000C23r 2  8D 0C 03           STA   LIB_ARG2+1
000C26r 2  20 rr rr           JSR   @sign_of_a
000C29r 2  8D 0D 03           STA   LIB_ARG2+2
000C2Cr 2  8D 0E 03           STA   LIB_ARG2+3
000C2Fr 2                     ; arg 3
000C2Fr 2  E0 04              CPX   #4
000C31r 2  90 13              BCC   @args_done
000C33r 2  A5 A1              LDA   EXT_ARG3_LO
000C35r 2  8D 0F 03           STA   LIB_ARG3+0
000C38r 2  A5 A0              LDA   EXT_ARG3_HI
000C3Ar 2  8D 10 03           STA   LIB_ARG3+1
000C3Dr 2  20 rr rr           JSR   @sign_of_a
000C40r 2  8D 11 03           STA   LIB_ARG3+2
000C43r 2  8D 12 03           STA   LIB_ARG3+3
000C46r 2               
000C46r 2               @args_done:
000C46r 2                     ; Branch: adapter (multi-call composite) vs. plain single lib_call.
000C46r 2  A5 rr              LDA   ext_mod_id
000C48r 2  C9 FE              CMP   #MODULE_ID_GFXADAPTER
000C4Ar 2  F0 26              BEQ   @adapter
000C4Cr 2               
000C4Cr 2               ; --- plain single lib_call: drive the canonical mailbox at $0300 ---
000C4Cr 2               @lib_call:
000C4Cr 2                     ; Populate module/function selectors and call the resident loader.
000C4Cr 2  A5 rr              LDA   ext_mod_id
000C4Er 2  8D 00 03           STA   LIB_MOD_ID
000C51r 2  A5 80              LDA   EXT_CMD
000C53r 2  8D 01 03           STA   LIB_FN_ID
000C56r 2  20 20 03           JSR   LIB_LOADER_BAND       ; == JSR $0320 (resident lib_call)
000C59r 2               
000C59r 2                     ; A non-zero status aborts the line.
000C59r 2  AD 02 03           LDA   LIB_STATUS
000C5Cr 2  D0 11              BNE   @lib_err
000C5Er 2               
000C5Er 2                     ; Copy LIB_RESULT low word into eval_val as a Logo integer.
000C5Er 2  AD 13 03           LDA   LIB_RESULT+0
000C61r 2  85 rr              STA   eval_val_lo
000C63r 2  AD 14 03           LDA   LIB_RESULT+1
000C66r 2  85 rr              STA   eval_val_hi
000C68r 2  64 rr              STZ   eval_val_frac
000C6Ar 2  A9 00              LDA   #VAL_NUMBER
000C6Cr 2  85 rr              STA   eval_type
000C6Er 2  60                 RTS
000C6Fr 2               
000C6Fr 2               @lib_err:
000C6Fr 2  4C rr rr           JMP   err_idk_word
000C72r 2               
000C72r 2               ; --- adapter dispatch: EXT_CMD holds the adapter index ---
000C72r 2               @adapter:
000C72r 2  A5 80              LDA   EXT_CMD
000C74r 2  C9 00              CMP   #GADAPT_SPRITE
000C76r 2  F0 11              BEQ   logo_adapt_sprite
000C78r 2  C9 01              CMP   #GADAPT_SPRCOLLP
000C7Ar 2  F0 3F              BEQ   logo_adapt_sprcollp
000C7Cr 2                     ; Unknown adapter index — treat as unknown word.
000C7Cr 2  4C rr rr           JMP   err_idk_word
000C7Fr 2               
000C7Fr 2               ; @sign_of_a — sign-extend the s8 high byte in A to a full byte:
000C7Fr 2               ;   returns A = $FF if A bit7 was set, else A = $00. Preserves X/Y.
000C7Fr 2               @sign_of_a:
000C7Fr 2  29 80              AND   #$80                  ; isolate bit7
000C81r 2  F0 03              BEQ   @sign_zero
000C83r 2  A9 FF              LDA   #$FF
000C85r 2  60                 RTS
000C86r 2               @sign_zero:
000C86r 2  A9 00              LDA   #$00
000C88r 2  60                 RTS
000C89r 2               
000C89r 2               ; ---------------------------------------------------------------------
000C89r 2               ; logo_adapt_sprite — SPRITE n x y: position the sprite then enable it.
000C89r 2               ;   Args (n,x,y) are already in LIB_ARG0/1/2. GFN_SPR_POS reads ARG0/1/2 and
000C89r 2               ;   GFN_SPR_ENABLE reads ARG0, so the SAME converted cells serve both calls.
000C89r 2               ;   Command (no value): leaves eval_type=VAL_NUMBER, eval_val=0.
000C89r 2               ;   Clobbers A, X, Y. May JMP err_idk_word on a lib error (no return).
000C89r 2               ; ---------------------------------------------------------------------
000C89r 2               logo_adapt_sprite:
000C89r 2  A9 01              LDA   #MODULE_ID_GRAPHICS
000C8Br 2  8D 00 03           STA   LIB_MOD_ID
000C8Er 2  A9 24              LDA   #GFN_SPR_POS
000C90r 2  8D 01 03           STA   LIB_FN_ID
000C93r 2  20 20 03           JSR   LIB_LOADER_BAND
000C96r 2  AD 02 03           LDA   LIB_STATUS
000C99r 2  D0 1D              BNE   @adapt_err
000C9Br 2                     ; re-arm selectors (LIB_MOD_ID may be clobbered across the call) and enable
000C9Br 2  A9 01              LDA   #MODULE_ID_GRAPHICS
000C9Dr 2  8D 00 03           STA   LIB_MOD_ID
000CA0r 2  A9 25              LDA   #GFN_SPR_ENABLE
000CA2r 2  8D 01 03           STA   LIB_FN_ID
000CA5r 2  20 20 03           JSR   LIB_LOADER_BAND
000CA8r 2  AD 02 03           LDA   LIB_STATUS
000CABr 2  D0 0B              BNE   @adapt_err
000CADr 2  64 rr              STZ   eval_val_lo
000CAFr 2  64 rr              STZ   eval_val_hi
000CB1r 2  64 rr              STZ   eval_val_frac
000CB3r 2  A9 00              LDA   #VAL_NUMBER
000CB5r 2  85 rr              STA   eval_type
000CB7r 2  60                 RTS
000CB8r 2               @adapt_err:
000CB8r 2  4C rr rr           JMP   err_idk_word
000CBBr 2               
000CBBr 2               ; ---------------------------------------------------------------------
000CBBr 2               ; logo_adapt_sprcollp — SPRITECOLLISION? n: report whether sprite n collided.
000CBBr 2               ;   lib_call GFN_SPR_COLL_MASK -> LIB_RESULT low word = 16-bit collision mask
000CBBr 2               ;   (byte0 = sprites 0-7, byte1 = sprites 8-15). Test bit n (n = EXT_ARG0_LO,
000CBBr 2               ;   the converted ARG0 low byte) and set eval_val = 0/1 bool.
000CBBr 2               ;   Reporter: leaves eval_type=VAL_NUMBER, eval_val = the bool.
000CBBr 2               ;   Clobbers A, X, Y. May JMP err_idk_word on a lib error (no return).
000CBBr 2               ; ---------------------------------------------------------------------
000CBBr 2               logo_adapt_sprcollp:
000CBBr 2  A9 01              LDA   #MODULE_ID_GRAPHICS
000CBDr 2  8D 00 03           STA   LIB_MOD_ID
000CC0r 2  A9 31              LDA   #GFN_SPR_COLL_MASK
000CC2r 2  8D 01 03           STA   LIB_FN_ID
000CC5r 2  20 20 03           JSR   LIB_LOADER_BAND
000CC8r 2  AD 02 03           LDA   LIB_STATUS
000CCBr 2  D0 28              BNE   @adapt_err
000CCDr 2                     ; Select the mask byte holding sprite n, and the bit index within it.
000CCDr 2  A5 84              LDA   EXT_ARG0_LO           ; sprite index n
000CCFr 2  C9 08              CMP   #8
000CD1r 2  B0 06              BCS   @hi_byte
000CD3r 2                     ; sprites 0-7: low byte of mask = LIB_RESULT+0
000CD3r 2  AA                 TAX
000CD4r 2  AD 13 03           LDA   LIB_RESULT+0
000CD7r 2  80 07              BRA   @test_bit
000CD9r 2               @hi_byte:
000CD9r 2                     ; sprites 8-15: high byte of mask = LIB_RESULT+1, bit index n-8
000CD9r 2  38                 SEC
000CDAr 2  E9 08              SBC   #8
000CDCr 2  AA                 TAX
000CDDr 2  AD 14 03           LDA   LIB_RESULT+1
000CE0r 2               @test_bit:
000CE0r 2  E0 00              CPX   #0
000CE2r 2  F0 04              BEQ   @check
000CE4r 2               @shift:
000CE4r 2  4A                 LSR
000CE5r 2  CA                 DEX
000CE6r 2  D0 FC              BNE   @shift
000CE8r 2               @check:
000CE8r 2  29 01              AND   #$01
000CEAr 2  85 rr              STA   eval_val_lo
000CECr 2  64 rr              STZ   eval_val_hi
000CEEr 2  64 rr              STZ   eval_val_frac
000CF0r 2  A9 00              LDA   #VAL_NUMBER
000CF2r 2  85 rr              STA   eval_type
000CF4r 2  60                 RTS
000CF5r 2               @adapt_err:
000CF5r 2  4C rr rr           JMP   err_idk_word
000CF8r 2               
000CF8r 2                     .segment "RODATA"
000000r 2               
