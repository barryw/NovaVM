002DBCr 2  E0 78              CPX   #120
002DBEr 2  B0 3F              BCS   @line_eol
002DC0r 2  80 C6              BRA   @line_ch
002DC2r 2               
002DC2r 2               @brk_inc:
002DC2r 2  EE rr rr           INC   proc_brk_depth
002DC5r 2  80 E7              BRA   @brk_done
002DC7r 2               @brk_dec:
002DC7r 2  AD rr rr           LDA   proc_brk_depth
002DCAr 2  F0 E2              BEQ   @brk_done             ; floor at 0
