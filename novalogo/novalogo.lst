002F5Ar 2  85 rr              STA   ptr_hi
002F5Cr 2  A0 02              LDY   #2
002F5Er 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002F60r 2  AA                 TAX
002F61r 2  F0 0B              BEQ   @skip_name
002F63r 2  A0 03              LDY   #3
002F65r 2               @pch:
