0017D0r 2               ; ---------------------------------------------------------------------
0017D0r 2               ; eval_list — build a list from tokens between [ and ]
0017D0r 2               ;   Entry: eval_cur points at the first token AFTER the [
0017D0r 2               ;   Exit:  eval_type = VAL_LIST, eval_val_lo/hi = head cons pair ptr
0017D0r 2               ;          eval_cur advanced past the matching ]
0017D0r 2               ;          Carry clear = success
0017D0r 2               ; ---------------------------------------------------------------------
0017D0r 2               eval_list:
0017D0r 2  64 rr              STZ   list_head_lo
0017D2r 2  64 rr              STZ   list_head_hi
