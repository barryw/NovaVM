0013C3r 2               ; ---------------------------------------------------------------------
0013C3r 2               ; do_readchar — READCHAR: wait for keypress, return as 1-char word
0013C3r 2               ;   Arity 0, no arguments. Reporter.
0013C3r 2               ; ---------------------------------------------------------------------
0013C3r 2               do_readchar:
0013C3r 2                     ; Poll until a key is pressed
0013C3r 2               @wait:
0013C3r 2  AD 0F A0           LDA   VGC_CHARIN
0013C6r 2  F0 FB              BEQ   @wait
0013C8r 2                     ; A = character — fall through to alloc_one_char_word
0013C8r 2               
0013C8r 2               ; ---------------------------------------------------------------------
0013C8r 2               ; alloc_one_char_word — allocate a 1-char word on heap from A
0013C8r 2               ;   Input: A = character byte
0013C8r 2               ;   Output: eval_type=VAL_WORD, eval_val=pointer to len+char
0013C8r 2               ;   Jumps to eval_continue
0013C8r 2               ; ---------------------------------------------------------------------
0013C8r 2               alloc_one_char_word:
0013C8r 2  48                 PHA                       ; save character
0013C9r 2  A9 02              LDA   #2                  ; 1 byte length + 1 byte char
0013CBr 2  A2 05              LDX   #ATYPE_STRING
0013CDr 2  20 rr rr           JSR   heap_alloc
0013D0r 2  68                 PLA
0013D1r 2  B0 1B              BCS   @oom
0013D3r 2  A0 01              LDY   #1
