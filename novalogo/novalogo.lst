002DCEr 2               
002DCEr 2               ; ---------------------------------------------------------------------
002DCEr 2               ; do_erase — ERASE "name: remove procedure from directory
002DCEr 2               ;   Arity 0 — evaluates its own argument
002DCEr 2               ; ---------------------------------------------------------------------
002DCEr 2               do_erase:
002DCEr 2  20 rr rr           JSR   eval_expr
002DD1r 2  90 03              BCC   @er_type_ok
002DD3r 2  4C rr rr           JMP   @err
002DD6r 2               @er_type_ok:
002DD6r 2  A5 rr              LDA   eval_type
002DD8r 2  C9 01              CMP   #VAL_WORD
002DDAr 2  F0 03              BEQ   @er_word_ok
002DDCr 2  4C rr rr           JMP   @err
002DDFr 2               @er_word_ok:
002DDFr 2               
002DDFr 2                     ; Save name pointer
002DDFr 2  A5 rr              LDA   eval_val_lo
002DE1r 2  85 rr              STA   var_name_lo
002DE3r 2  A5 rr              LDA   eval_val_hi
002DE5r 2  85 rr              STA   var_name_hi
002DE7r 2               
002DE7r 2                     ; Walk proc_head with prev tracking
002DE7r 2                     ; prev = address of "next" pointer to patch (starts as &proc_head)
002DE7r 2  A9 rr              LDA   #<proc_head_lo
002DE9r 2  85 rr              STA   proc_ptr_lo             ; prev_ptr_lo
002DEBr 2  A9 rr              LDA   #>proc_head_lo
002DEDr 2  85 rr              STA   proc_ptr_hi             ; prev_ptr_hi (ZP, so high byte = 0)
002DEFr 2               
002DEFr 2  A5 rr              LDA   proc_head_lo
002DF1r 2  85 rr              STA   proc_entry_lo
002DF3r 2  A5 rr              LDA   proc_head_hi
002DF5r 2  85 rr              STA   proc_entry_hi
002DF7r 2               
002DF7r 2               @walk:
002DF7r 2  A5 rr              LDA   proc_entry_lo
002DF9r 2  05 rr              ORA   proc_entry_hi
002DFBr 2  D0 03              BNE   @walk_ok
002DFDr 2  4C rr rr           JMP   @not_found
002E00r 2               @walk_ok:
002E00r 2               
002E00r 2                     ; Compare name
002E00r 2  A5 rr              LDA   var_name_lo
002E02r 2  85 rr              STA   ptr_lo
002E04r 2  A5 rr              LDA   var_name_hi
002E06r 2  85 rr              STA   ptr_hi
002E08r 2  A0 00              LDY   #0
002E0Ar 2  B1 rr              LDA   (ptr_lo),Y             ; search name len
002E0Cr 2  85 rr              STA   proc_name_len
002E0Er 2               
002E0Er 2  A5 rr              LDA   proc_entry_lo
002E10r 2  85 rr              STA   ptr_lo
002E12r 2  A5 rr              LDA   proc_entry_hi
002E14r 2  85 rr              STA   ptr_hi
002E16r 2  A0 02              LDY   #2
002E18r 2  B1 rr              LDA   (ptr_lo),Y             ; record name len
002E1Ar 2  C5 rr              CMP   proc_name_len
002E1Cr 2  D0 32              BNE   @erase_next
002E1Er 2               
002E1Er 2  AA                 TAX
002E1Fr 2  F0 4D              BEQ   @erase_match            ; both empty = match
002E21r 2  A0 00              LDY   #0
002E23r 2               @ecmp:
002E23r 2  DA                 PHX
002E24r 2  5A                 PHY
002E25r 2  A5 rr              LDA   var_name_lo
002E27r 2  85 rr              STA   ptr_lo
002E29r 2  A5 rr              LDA   var_name_hi
002E2Br 2  85 rr              STA   ptr_hi
002E2Dr 2  C8                 INY
002E2Er 2  B1 rr              LDA   (ptr_lo),Y             ; search char
002E30r 2  85 rr              STA   proc_rec_off
002E32r 2               
002E32r 2  7A                 PLY
002E33r 2  A5 rr              LDA   proc_entry_lo
002E35r 2  85 rr              STA   ptr_lo
002E37r 2  A5 rr              LDA   proc_entry_hi
002E39r 2  85 rr              STA   ptr_hi
002E3Br 2  5A                 PHY
002E3Cr 2  98                 TYA
002E3Dr 2  18                 CLC
002E3Er 2  69 03              ADC   #3
002E40r 2  A8                 TAY
002E41r 2  B1 rr              LDA   (ptr_lo),Y             ; record char
002E43r 2  7A                 PLY
002E44r 2  C5 rr              CMP   proc_rec_off
002E46r 2  D0 07              BNE   @ecmp_ne
002E48r 2  FA                 PLX
002E49r 2  C8                 INY
002E4Ar 2  CA                 DEX
002E4Br 2  D0 D6              BNE   @ecmp
002E4Dr 2  80 1F              BRA   @erase_match
002E4Fr 2               
002E4Fr 2               @ecmp_ne:
002E4Fr 2  FA                 PLX
002E50r 2               
002E50r 2               @erase_next:
002E50r 2                     ; prev = &current->next (proc_entry + 0)
002E50r 2  A5 rr              LDA   proc_entry_lo
002E52r 2  85 rr              STA   proc_ptr_lo
002E54r 2  A5 rr              LDA   proc_entry_hi
002E56r 2  85 rr              STA   proc_ptr_hi
002E58r 2                     ; current = current->next
002E58r 2  A5 rr              LDA   proc_entry_lo
002E5Ar 2  85 rr              STA   ptr_lo
002E5Cr 2  A5 rr              LDA   proc_entry_hi
002E5Er 2  85 rr              STA   ptr_hi
002E60r 2  A0 00              LDY   #0
002E62r 2  B1 rr              LDA   (ptr_lo),Y
002E64r 2  AA                 TAX
002E65r 2  C8                 INY
002E66r 2  B1 rr              LDA   (ptr_lo),Y
002E68r 2  85 rr              STA   proc_entry_hi
002E6Ar 2  86 rr              STX   proc_entry_lo
002E6Cr 2  80 89              BRA   @walk
002E6Er 2               
002E6Er 2               @erase_match:
002E6Er 2                     ; Unlink: *prev = current->next
002E6Er 2                     ; Read current->next
002E6Er 2  A5 rr              LDA   proc_entry_lo
002E70r 2  85 rr              STA   ptr_lo
002E72r 2  A5 rr              LDA   proc_entry_hi
002E74r 2  85 rr              STA   ptr_hi
002E76r 2  A0 00              LDY   #0
002E78r 2  B1 rr              LDA   (ptr_lo),Y             ; next_lo
002E7Ar 2  AA                 TAX
002E7Br 2  C8                 INY
002E7Cr 2  B1 rr              LDA   (ptr_lo),Y             ; next_hi
002E7Er 2               
002E7Er 2                     ; Write to prev
002E7Er 2  A0 00              LDY   #0
002E80r 2  A5 rr              LDA   proc_ptr_lo
002E82r 2  85 rr              STA   ptr_lo
002E84r 2  A5 rr              LDA   proc_ptr_hi
002E86r 2  85 rr              STA   ptr_hi
002E88r 2  8A                 TXA
002E89r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_lo = next_lo
002E8Br 2  C8                 INY
002E8Cr 2  A5 rr              LDA   proc_entry_lo
002E8Er 2  85 rr              STA   ptr_lo
002E90r 2  A5 rr              LDA   proc_entry_hi
002E92r 2  85 rr              STA   ptr_hi
002E94r 2  A0 01              LDY   #1
002E96r 2  B1 rr              LDA   (ptr_lo),Y             ; re-read next_hi
002E98r 2  A0 01              LDY   #1
002E9Ar 2  A5 rr              LDA   proc_ptr_lo
002E9Cr 2  85 rr              STA   ptr_lo
002E9Er 2  A5 rr              LDA   proc_ptr_hi
002EA0r 2  85 rr              STA   ptr_hi
002EA2r 2  A5 rr              LDA   proc_entry_lo
002EA4r 2  85 rr              STA   ptr2_lo
002EA6r 2  A5 rr              LDA   proc_entry_hi
002EA8r 2  85 rr              STA   ptr2_hi
002EAAr 2  A0 01              LDY   #1
002EACr 2  B1 rr              LDA   (ptr2_lo),Y            ; next_hi
002EAEr 2  91 rr              STA   (ptr_lo),Y             ; prev->next_hi = next_hi
002EB0r 2               
002EB0r 2  4C rr rr           JMP   eval_continue
002EB3r 2               
002EB3r 2               @not_found:
002EB3r 2  A2 rr              LDX   #<str_idk
002EB5r 2  A0 rr              LDY   #>str_idk
002EB7r 2  4C rr rr           JMP   list_print_err
002EBAr 2               @err:
002EBAr 2  A2 rr              LDX   #<str_erase_err
002EBCr 2  A0 rr              LDY   #>str_erase_err
002EBEr 2  4C rr rr           JMP   list_print_err
002EC1r 2               
002EC1r 2               ; ---------------------------------------------------------------------
002EC1r 2               ; do_apply — APPLY "proc [args]: call procedure with args from list
002EC1r 2               ;   Arity 0 — evaluates its own arguments
002EC1r 2               ;   Strategy: build "name arg1 arg2 ..." in input_buf, tokenize+eval.
002EC1r 2               ; ---------------------------------------------------------------------
002EC1r 2               do_apply:
002EC1r 2                     ; Evaluate first arg: procedure name (quoted word)
002EC1r 2  20 rr rr           JSR   eval_expr
002EC4r 2  90 03              BCC   @ap_type_ok
002EC6r 2  4C rr rr           JMP   @err
002EC9r 2               @ap_type_ok:
002EC9r 2  A5 rr              LDA   eval_type
002ECBr 2  C9 01              CMP   #VAL_WORD
002ECDr 2  F0 03              BEQ   @ap_word_ok
002ECFr 2  4C rr rr           JMP   @err
002ED2r 2               @ap_word_ok:
002ED2r 2               
002ED2r 2                     ; Copy proc name to input_buf
002ED2r 2  A5 rr              LDA   eval_val_lo
002ED4r 2  85 rr              STA   ptr_lo
002ED6r 2  A5 rr              LDA   eval_val_hi
002ED8r 2  85 rr              STA   ptr_hi
002EDAr 2  64 rr              STZ   z:buf_idx
002EDCr 2  A0 00              LDY   #0
002EDEr 2  B1 rr              LDA   (ptr_lo),Y             ; name length
002EE0r 2  AA                 TAX
002EE1r 2  F0 10              BEQ   @apply_args
002EE3r 2  C8                 INY
002EE4r 2               @apply_name:
002EE4r 2  B1 rr              LDA   (ptr_lo),Y
002EE6r 2  5A                 PHY
002EE7r 2  A4 rr              LDY   z:buf_idx
002EE9r 2  99 rr rr           STA   input_buf,Y
002EECr 2  E6 rr              INC   z:buf_idx
002EEEr 2  7A                 PLY
002EEFr 2  C8                 INY
002EF0r 2  CA                 DEX
002EF1r 2  D0 F1              BNE   @apply_name
002EF3r 2               
002EF3r 2               @apply_args:
002EF3r 2                     ; Evaluate second arg: list of arguments
002EF3r 2  20 rr rr           JSR   eval_expr
002EF6r 2  B0 5B              BCS   @err
002EF8r 2  A5 rr              LDA   eval_type
002EFAr 2  C9 02              CMP   #VAL_LIST
002EFCr 2  D0 55              BNE   @err
002EFEr 2               
002EFEr 2                     ; Render list elements to input_buf (after name)
002EFEr 2                     ; eval_val_lo/hi = list head
002EFEr 2  A5 rr              LDA   eval_val_lo
002F00r 2  05 rr              ORA   eval_val_hi
002F02r 2  F0 11              BEQ   @apply_run              ; empty arg list, just run name
002F04r 2               
002F04r 2                     ; Use render_list_to_buf — it prepends space before elements
002F04r 2                     ; but we need a space before the first arg too
002F04r 2  A5 rr              LDA   z:buf_idx
002F06r 2  C9 7E              CMP   #126
002F08r 2  B0 0B              BCS   @apply_run
002F0Ar 2  A8                 TAY
002F0Br 2  A9 20              LDA   #' '
002F0Dr 2  99 rr rr           STA   input_buf,Y
002F10r 2  E6 rr              INC   z:buf_idx
002F12r 2               
002F12r 2                     ; render_list_to_buf expects eval_val set
002F12r 2  20 rr rr           JSR   render_list_to_buf
002F15r 2               
002F15r 2               @apply_run:
002F15r 2                     ; Null-terminate
002F15r 2  A6 rr              LDX   z:buf_idx
002F17r 2  9E rr rr           STZ   input_buf,X
002F1Ar 2               
002F1Ar 2                     ; Save eval state and tokenize+eval (same pattern as do_run)
002F1Ar 2  A5 rr              LDA   eval_cur_lo
002F1Cr 2  48                 PHA
002F1Dr 2  A5 rr              LDA   eval_cur_hi
002F1Fr 2  48                 PHA
002F20r 2  A5 rr              LDA   tok_head_lo
002F22r 2  48                 PHA
002F23r 2  A5 rr              LDA   tok_head_hi
002F25r 2  48                 PHA
002F26r 2  A5 rr              LDA   tok_tail_lo
002F28r 2  48                 PHA
002F29r 2  A5 rr              LDA   tok_tail_hi
002F2Br 2  48                 PHA
002F2Cr 2  A5 rr              LDA   eval_in_body
002F2Er 2  48                 PHA
002F2Fr 2  A5 rr              LDA   eval_reporter
002F31r 2  48                 PHA
002F32r 2               
002F32r 2  20 rr rr           JSR   tokenize_line
002F35r 2  20 rr rr           JSR   eval_line
002F38r 2               
002F38r 2  68                 PLA
002F39r 2  85 rr              STA   eval_reporter
002F3Br 2  68                 PLA
002F3Cr 2  85 rr              STA   eval_in_body
002F3Er 2  68                 PLA
002F3Fr 2  85 rr              STA   tok_tail_hi
002F41r 2  68                 PLA
002F42r 2  85 rr              STA   tok_tail_lo
002F44r 2  68                 PLA
002F45r 2  85 rr              STA   tok_head_hi
002F47r 2  68                 PLA
002F48r 2  85 rr              STA   tok_head_lo
002F4Ar 2  68                 PLA
002F4Br 2  85 rr              STA   eval_cur_hi
002F4Dr 2  68                 PLA
002F4Er 2  85 rr              STA   eval_cur_lo
002F50r 2               
002F50r 2  4C rr rr           JMP   eval_continue
002F53r 2               
002F53r 2               @err:
002F53r 2  A2 rr              LDX   #<str_apply_err
002F55r 2  A0 rr              LDY   #>str_apply_err
002F57r 2  4C rr rr           JMP   list_print_err
002F5Ar 2               
002F5Ar 2               ; =====================================================================
002F5Ar 2               ; RODATA — procedure strings
002F5Ar 2               ; =====================================================================
002F5Ar 2                     .segment "RODATA"
0009DEr 2               
0009DEr 2               str_defined:
0009DEr 2  20 44 45 46        .byte " DEFINED", 0
0009E2r 2  49 4E 45 44  
0009E6r 2  00           
0009E7r 2               
0009E7r 2               str_to_needs_name:
0009E7r 2  54 4F 20 4E        .byte "TO NEEDS A NAME", 0
0009EBr 2  45 45 44 53  
0009EFr 2  20 41 20 4E  
0009F7r 2               
0009F7r 2               str_po_err:
0009F7r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO PO", 0
0009FBr 2  45 4E 4F 55  
0009FFr 2  47 48 20 49  
000A0Fr 2               
000A0Fr 2               str_erase_err:
000A0Fr 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO ERASE", 0
000A13r 2  45 4E 4F 55  
000A17r 2  47 48 20 49  
000A2Ar 2               
000A2Ar 2               str_apply_err:
000A2Ar 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO APPLY", 0
000A2Er 2  45 4E 4F 55  
000A32r 2  47 48 20 49  
000A45r 2               
000A45r 2               ; Builtin name strings for workspace commands
000A45r 2               str_po_name:
000A45r 2  02 50 4F           .byte 2, "PO"
000A48r 2               str_printout_name:
000A48r 2  08 50 52 49        .byte 8, "PRINTOUT"
000A4Cr 2  4E 54 4F 55  
000A50r 2  54           
000A51r 2               str_pots_name:
000A51r 2  04 50 4F 54        .byte 4, "POTS"
000A55r 2  53           
000A56r 2               str_printtitles_name:
000A56r 2  0B 50 52 49        .byte 11, "PRINTTITLES"
000A5Ar 2  4E 54 54 49  
000A5Er 2  54 4C 45 53  
000A62r 2               str_erase_name:
000A62r 2  05 45 52 41        .byte 5, "ERASE"
000A66r 2  53 45        
000A68r 2               str_apply_name:
000A68r 2  05 41 50 50        .byte 5, "APPLY"
000A6Cr 2  4C 59        
000A6Er 2               
000A6Er 1                     .include "gc.s"
000A6Er 2               ; gc.s — mark-sweep garbage collector for NovaLogo
000A6Er 2               ;
000A6Er 2               ; Allocation header (prepended by heap_alloc):
000A6Er 2               ;   +0: alloc_tag  (bit 7 = mark, bits 6-0 = type)
000A6Er 2               ;   +1: alloc_size (total size including header; 0 = use 16-bit size at +2/+3)
000A6Er 2               ;
000A6Er 2               ; Type constants (bits 6-0 of alloc_tag):
000A6Er 2               ATYPE_FREE   = $00
000A6Er 2               ATYPE_TOKEN  = $01
000A6Er 2               ATYPE_CONS   = $02
000A6Er 2               ATYPE_VAR    = $03
000A6Er 2               ATYPE_PROC   = $04
000A6Er 2               ATYPE_STRING = $05
000A6Er 2               
000A6Er 2               ; Header layout offsets (relative to allocation base, NOT payload)
000A6Er 2               GC_HDR_TAG   = 0
000A6Er 2               GC_HDR_SIZE  = 1
000A6Er 2               GC_HDR_BYTES = 2              ; overhead per allocation
000A6Er 2               
000A6Er 2               ; Mark bit
000A6Er 2               ALLOC_MARK_BIT = $80
000A6Er 2               
000A6Er 2               ; =====================================================================
000A6Er 2               ; ZEROPAGE segment — GC variables
000A6Er 2               ; =====================================================================
000A6Er 2                     .segment "ZEROPAGE"
000047r 2               
000047r 2  xx           gc_ptr_lo:    .res 1          ; GC walk pointer low
000048r 2  xx           gc_ptr_hi:    .res 1          ; GC walk pointer high
000049r 2  xx           gc_tmp_lo:    .res 1          ; GC temp low
00004Ar 2  xx           gc_tmp_hi:    .res 1          ; GC temp high
00004Br 2  xx           gc_mark_lo:   .res 1          ; node-to-mark pointer low
00004Cr 2  xx           gc_mark_hi:   .res 1          ; node-to-mark pointer high
00004Dr 2               
00004Dr 2               ; =====================================================================
00004Dr 2               ; CODE segment — GC routines
00004Dr 2               ; =====================================================================
00004Dr 2                     .segment "CODE"
002F5Ar 2               
002F5Ar 2               ; ---------------------------------------------------------------------
002F5Ar 2               ; gc_collect — run a full mark-sweep garbage collection cycle
002F5Ar 2               ;   1. Clear all mark bits
002F5Ar 2               ;   2. Mark all reachable objects from roots
002F5Ar 2               ;   3. Sweep: coalesce all unmarked blocks and reset heap_ptr
002F5Ar 2               ;
002F5Ar 2               ;   Clobbers: A, X, Y, gc_ptr, gc_tmp, gc_mark, ptr_lo/hi, ptr2_lo/hi
002F5Ar 2               ; ---------------------------------------------------------------------
002F5Ar 2               gc_collect:
002F5Ar 2                     ; Phase 1: Clear all mark bits by walking the heap linearly
002F5Ar 2  A9 00              LDA   #<HEAP_START
002F5Cr 2  85 rr              STA   gc_ptr_lo
002F5Er 2  A9 04              LDA   #>HEAP_START
002F60r 2  85 rr              STA   gc_ptr_hi
002F62r 2               
002F62r 2               @clear_loop:
002F62r 2                     ; Have we reached heap_ptr (end of allocated space)?
002F62r 2  A5 rr              LDA   gc_ptr_hi
002F64r 2  C5 rr              CMP   heap_ptr+1
002F66r 2  90 08              BCC   @clear_one
002F68r 2  D0 41              BNE   @clear_done
002F6Ar 2  A5 rr              LDA   gc_ptr_lo
002F6Cr 2  C5 rr              CMP   heap_ptr
002F6Er 2  B0 3B              BCS   @clear_done
002F70r 2               
002F70r 2               @clear_one:
002F70r 2                     ; Clear mark bit on this allocation
002F70r 2  A5 rr              LDA   gc_ptr_lo
002F72r 2  85 rr              STA   ptr_lo
002F74r 2  A5 rr              LDA   gc_ptr_hi
002F76r 2  85 rr              STA   ptr_hi
002F78r 2  A0 00              LDY   #GC_HDR_TAG
002F7Ar 2  B1 rr              LDA   (ptr_lo),Y
002F7Cr 2  29 7F              AND   #<~ALLOC_MARK_BIT    ; clear bit 7
002F7Er 2  91 rr              STA   (ptr_lo),Y
002F80r 2               
002F80r 2                     ; Advance by alloc_size
002F80r 2  A0 01              LDY   #GC_HDR_SIZE
002F82r 2  B1 rr              LDA   (ptr_lo),Y
002F84r 2  F0 0B              BEQ   @clear_big           ; size=0 means 16-bit size at +2/+3
002F86r 2  18                 CLC
002F87r 2  65 rr              ADC   gc_ptr_lo
002F89r 2  85 rr              STA   gc_ptr_lo
002F8Br 2  90 D5              BCC   @clear_loop
002F8Dr 2  E6 rr              INC   gc_ptr_hi
002F8Fr 2  80 D1              BRA   @clear_loop
002F91r 2               
002F91r 2               @clear_big:
002F91r 2                     ; 16-bit size at payload offset 0 and 1 (header +2 and +3)
002F91r 2  A0 02              LDY   #GC_HDR_BYTES
002F93r 2  B1 rr              LDA   (ptr_lo),Y
002F95r 2  85 rr              STA   gc_tmp_lo
002F97r 2  C8                 INY
002F98r 2  B1 rr              LDA   (ptr_lo),Y
002F9Ar 2  85 rr              STA   gc_tmp_hi
002F9Cr 2  18                 CLC
002F9Dr 2  A5 rr              LDA   gc_ptr_lo
002F9Fr 2  65 rr              ADC   gc_tmp_lo
002FA1r 2  85 rr              STA   gc_ptr_lo
002FA3r 2  A5 rr              LDA   gc_ptr_hi
002FA5r 2  65 rr              ADC   gc_tmp_hi
002FA7r 2  85 rr              STA   gc_ptr_hi
002FA9r 2  80 B7              BRA   @clear_loop
002FABr 2               
002FABr 2               @clear_done:
002FABr 2               
002FABr 2                     ; Phase 2: Mark all reachable objects
002FABr 2                     ; Root 1: variable list (var_head)
002FABr 2  20 rr rr           JSR   gc_mark_vars
002FAEr 2               
002FAEr 2                     ; Root 2: procedure list (proc_head)
002FAEr 2  20 rr rr           JSR   gc_mark_procs
002FB1r 2               
002FB1r 2                     ; Root 3: current token list (tok_head)
002FB1r 2  20 rr rr           JSR   gc_mark_token_list
002FB4r 2               
002FB4r 2                     ; Phase 3: Sweep — find the highest marked allocation,
002FB4r 2                     ; reset heap_ptr to just past it. This works because we
002FB4r 2                     ; use a bump allocator with no free list; all unmarked
002FB4r 2                     ; allocations between marked ones become wasted space,
002FB4r 2                     ; but in practice the permanent objects (vars, procs) are
002FB4r 2                     ; allocated early and the ephemeral ones (tokens, cons,
002FB4r 2                     ; strings) are allocated later and all unmarked — so
002FB4r 2                     ; heap_ptr shrinks back dramatically.
002FB4r 2                     ;
002FB4r 2                     ; Walk the heap forward; track the highest end-address
002FB4r 2                     ; of any marked allocation.
002FB4r 2  A9 00              LDA   #<HEAP_START
002FB6r 2  85 rr              STA   gc_ptr_lo
002FB8r 2  A9 04              LDA   #>HEAP_START
002FBAr 2  85 rr              STA   gc_ptr_hi
002FBCr 2                     ; gc_tmp = highest marked end (start at HEAP_START = nothing marked)
002FBCr 2  A9 00              LDA   #<HEAP_START
002FBEr 2  85 rr              STA   gc_tmp_lo
002FC0r 2  A9 04              LDA   #>HEAP_START
002FC2r 2  85 rr              STA   gc_tmp_hi
002FC4r 2               
002FC4r 2               @sweep_loop:
002FC4r 2                     ; Reached end of allocated space?
002FC4r 2  A5 rr              LDA   gc_ptr_hi
002FC6r 2  C5 rr              CMP   heap_ptr+1
002FC8r 2  90 08              BCC   @sweep_one
002FCAr 2  D0 49              BNE   @sweep_done
002FCCr 2  A5 rr              LDA   gc_ptr_lo
002FCEr 2  C5 rr              CMP   heap_ptr
002FD0r 2  B0 43              BCS   @sweep_done
002FD2r 2               
002FD2r 2               @sweep_one:
002FD2r 2  A5 rr              LDA   gc_ptr_lo
002FD4r 2  85 rr              STA   ptr_lo
002FD6r 2  A5 rr              LDA   gc_ptr_hi
002FD8r 2  85 rr              STA   ptr_hi
002FDAr 2               
002FDAr 2                     ; Get size of this allocation
002FDAr 2  A0 01              LDY   #GC_HDR_SIZE
002FDCr 2  B1 rr              LDA   (ptr_lo),Y
002FDEr 2  F0 06              BEQ   @sweep_big
002FE0r 2  85 rr              STA   gc_mark_lo            ; use gc_mark_lo as temp for size
002FE2r 2  64 rr              STZ   gc_mark_hi
002FE4r 2  80 0B              BRA   @sweep_check_mark
002FE6r 2               
002FE6r 2               @sweep_big:
002FE6r 2  A0 02              LDY   #GC_HDR_BYTES
002FE8r 2  B1 rr              LDA   (ptr_lo),Y
002FEAr 2  85 rr              STA   gc_mark_lo
002FECr 2  C8                 INY
002FEDr 2  B1 rr              LDA   (ptr_lo),Y
002FEFr 2  85 rr              STA   gc_mark_hi
002FF1r 2               
002FF1r 2               @sweep_check_mark:
002FF1r 2                     ; Is this allocation marked?
002FF1r 2  A0 00              LDY   #GC_HDR_TAG
002FF3r 2  B1 rr              LDA   (ptr_lo),Y
002FF5r 2  29 80              AND   #ALLOC_MARK_BIT
002FF7r 2  F0 0D              BEQ   @sweep_advance        ; not marked — skip
002FF9r 2               
002FF9r 2                     ; Marked — compute end address = gc_ptr + size
002FF9r 2  18                 CLC
002FFAr 2  A5 rr              LDA   gc_ptr_lo
002FFCr 2  65 rr              ADC   gc_mark_lo
002FFEr 2  85 rr              STA   gc_tmp_lo             ; update highest end
003000r 2  A5 rr              LDA   gc_ptr_hi
003002r 2  65 rr              ADC   gc_mark_hi
003004r 2  85 rr              STA   gc_tmp_hi
003006r 2               
003006r 2               @sweep_advance:
003006r 2                     ; Advance gc_ptr by size
003006r 2  18                 CLC
003007r 2  A5 rr              LDA   gc_ptr_lo
003009r 2  65 rr              ADC   gc_mark_lo
00300Br 2  85 rr              STA   gc_ptr_lo
00300Dr 2  A5 rr              LDA   gc_ptr_hi
00300Fr 2  65 rr              ADC   gc_mark_hi
003011r 2  85 rr              STA   gc_ptr_hi
003013r 2  80 AF              BRA   @sweep_loop
003015r 2               
003015r 2               @sweep_done:
003015r 2                     ; Set heap_ptr to highest marked end
003015r 2  A5 rr              LDA   gc_tmp_lo
003017r 2  85 rr              STA   heap_ptr
003019r 2  A5 rr              LDA   gc_tmp_hi
00301Br 2  85 rr              STA   heap_ptr+1
00301Dr 2  60                 RTS
00301Er 2               
00301Er 2               ; ---------------------------------------------------------------------
00301Er 2               ; gc_mark_node — mark a single allocation given a payload pointer
00301Er 2               ;   Input: gc_mark_lo/hi = pointer to payload (header is at -2)
00301Er 2               ;   If pointer is $0000 or below HEAP_START, skip.
00301Er 2               ;   Clobbers: A, Y (preserves gc_mark_lo/hi)
00301Er 2               ; ---------------------------------------------------------------------
00301Er 2               gc_mark_node:
00301Er 2                     ; Null check
00301Er 2  A5 rr              LDA   gc_mark_lo
003020r 2  05 rr              ORA   gc_mark_hi
003022r 2  F0 21              BEQ   @done
003024r 2               
003024r 2                     ; Compute header address = payload - 2
003024r 2  A5 rr              LDA   gc_mark_lo
003026r 2  38                 SEC
003027r 2  E9 02              SBC   #GC_HDR_BYTES
003029r 2  85 rr              STA   ptr_lo
00302Br 2  A5 rr              LDA   gc_mark_hi
00302Dr 2  E9 00              SBC   #0
00302Fr 2  85 rr              STA   ptr_hi
003031r 2               
003031r 2                     ; Range check: must be >= HEAP_START
003031r 2  C9 04              CMP   #>HEAP_START
003033r 2  90 10              BCC   @done
003035r 2  D0 06              BNE   @in_range
003037r 2  A5 rr              LDA   ptr_lo
003039r 2  C9 00              CMP   #<HEAP_START
00303Br 2  90 08              BCC   @done
00303Dr 2               @in_range:
00303Dr 2               
00303Dr 2                     ; Set mark bit
00303Dr 2  A0 00              LDY   #GC_HDR_TAG
00303Fr 2  B1 rr              LDA   (ptr_lo),Y
003041r 2  09 80              ORA   #ALLOC_MARK_BIT
003043r 2  91 rr              STA   (ptr_lo),Y
003045r 2               @done:
003045r 2  60                 RTS
003046r 2               
003046r 2               ; ---------------------------------------------------------------------
003046r 2               ; gc_mark_vars — walk the variable linked list and mark each entry
003046r 2               ;   Also marks any list values pointed to by variables.
003046r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_mark, ptr_lo/hi, ptr2_lo/hi
003046r 2               ; ---------------------------------------------------------------------
003046r 2               gc_mark_vars:
003046r 2  A5 rr              LDA   var_head_lo
003048r 2  85 rr              STA   gc_ptr_lo
00304Ar 2  A5 rr              LDA   var_head_hi
00304Cr 2  85 rr              STA   gc_ptr_hi
00304Er 2               
00304Er 2               @walk:
00304Er 2  A5 rr              LDA   gc_ptr_lo
003050r 2  05 rr              ORA   gc_ptr_hi
003052r 2  D0 01              BNE   @have_var
003054r 2  60                 RTS
003055r 2               @have_var:
003055r 2               
003055r 2                     ; Mark this var entry
003055r 2  A5 rr              LDA   gc_ptr_lo
003057r 2  85 rr              STA   gc_mark_lo
003059r 2  A5 rr              LDA   gc_ptr_hi
00305Br 2  85 rr              STA   gc_mark_hi
00305Dr 2  20 rr rr           JSR   gc_mark_node
003060r 2               
003060r 2                     ; Read the variable's value — if it's a list, mark the list
003060r 2  A5 rr              LDA   gc_ptr_lo
003062r 2  85 rr              STA   ptr_lo
003064r 2  A5 rr              LDA   gc_ptr_hi
003066r 2  85 rr              STA   ptr_hi
003068r 2  A0 02              LDY   #VAR_NAME_LEN
00306Ar 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
00306Cr 2  18                 CLC
00306Dr 2  69 03              ADC   #VAR_NAME             ; offset to value_type
00306Fr 2  A8                 TAY
003070r 2  B1 rr              LDA   (ptr_lo),Y           ; value_type
003072r 2  C9 02              CMP   #VAL_LIST
003074r 2  D0 23              BNE   @var_check_word
003076r 2                     ; It's a list — get the list head pointer and mark the list
003076r 2  C8                 INY
003077r 2  B1 rr              LDA   (ptr_lo),Y           ; val_hi (actually car_hi)
003079r 2  85 rr              STA   gc_tmp_hi
00307Br 2  C8                 INY
00307Cr 2  B1 rr              LDA   (ptr_lo),Y           ; val_lo
00307Er 2  85 rr              STA   gc_tmp_lo
003080r 2                     ; Save gc_ptr across recursive mark
003080r 2  A5 rr              LDA   gc_ptr_lo
003082r 2  48                 PHA
003083r 2  A5 rr              LDA   gc_ptr_hi
003085r 2  48                 PHA
003086r 2  A5 rr              LDA   gc_tmp_lo
003088r 2  85 rr              STA   gc_mark_lo
00308Ar 2  A5 rr              LDA   gc_tmp_hi
00308Cr 2  85 rr              STA   gc_mark_hi
00308Er 2  20 rr rr           JSR   gc_mark_list
003091r 2  68                 PLA
003092r 2  85 rr              STA   gc_ptr_hi
003094r 2  68                 PLA
003095r 2  85 rr              STA   gc_ptr_lo
003097r 2  80 25              BRA   @var_next
003099r 2               
003099r 2               @var_check_word:
003099r 2  C9 01              CMP   #VAL_WORD
00309Br 2  D0 21              BNE   @var_next
00309Dr 2                     ; It's a word — mark the string allocation
00309Dr 2  C8                 INY
00309Er 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_hi for word
0030A0r 2  85 rr              STA   gc_tmp_hi
0030A2r 2  C8                 INY
0030A3r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_lo for word
0030A5r 2  85 rr              STA   gc_tmp_lo
0030A7r 2  A5 rr              LDA   gc_ptr_lo
0030A9r 2  48                 PHA
0030AAr 2  A5 rr              LDA   gc_ptr_hi
0030ACr 2  48                 PHA
0030ADr 2  A5 rr              LDA   gc_tmp_lo
0030AFr 2  85 rr              STA   gc_mark_lo
0030B1r 2  A5 rr              LDA   gc_tmp_hi
0030B3r 2  85 rr              STA   gc_mark_hi
0030B5r 2  20 rr rr           JSR   gc_mark_node
0030B8r 2  68                 PLA
0030B9r 2  85 rr              STA   gc_ptr_hi
0030BBr 2  68                 PLA
0030BCr 2  85 rr              STA   gc_ptr_lo
0030BEr 2               
0030BEr 2               @var_next:
0030BEr 2                     ; Follow next pointer
0030BEr 2  A5 rr              LDA   gc_ptr_lo
0030C0r 2  85 rr              STA   ptr_lo
0030C2r 2  A5 rr              LDA   gc_ptr_hi
0030C4r 2  85 rr              STA   ptr_hi
0030C6r 2  A0 00              LDY   #VAR_NEXT_LO
0030C8r 2  B1 rr              LDA   (ptr_lo),Y
0030CAr 2  AA                 TAX
0030CBr 2  C8                 INY
0030CCr 2  B1 rr              LDA   (ptr_lo),Y
0030CEr 2  85 rr              STA   gc_ptr_hi
0030D0r 2  86 rr              STX   gc_ptr_lo
0030D2r 2  4C rr rr           JMP   @walk
0030D5r 2               
0030D5r 2               ; ---------------------------------------------------------------------
0030D5r 2               ; gc_mark_procs — walk the procedure list and mark each record
0030D5r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
0030D5r 2               ; ---------------------------------------------------------------------
0030D5r 2               gc_mark_procs:
0030D5r 2  A5 rr              LDA   proc_head_lo
0030D7r 2  85 rr              STA   gc_ptr_lo
0030D9r 2  A5 rr              LDA   proc_head_hi
0030DBr 2  85 rr              STA   gc_ptr_hi
0030DDr 2               
0030DDr 2               @walk:
0030DDr 2  A5 rr              LDA   gc_ptr_lo
0030DFr 2  05 rr              ORA   gc_ptr_hi
0030E1r 2  F0 2B              BEQ   @done
0030E3r 2               
0030E3r 2                     ; Mark this procedure record.
0030E3r 2                     ; proc_entry points to record data (base+4); header is at base+0.
0030E3r 2                     ; Subtract 4 to get the header address for marking.
0030E3r 2  A5 rr              LDA   gc_ptr_lo
0030E5r 2  38                 SEC
0030E6r 2  E9 04              SBC   #4
0030E8r 2  85 rr              STA   ptr_lo
0030EAr 2  A5 rr              LDA   gc_ptr_hi
0030ECr 2  E9 00              SBC   #0
0030EEr 2  85 rr              STA   ptr_hi
0030F0r 2                     ; Set mark bit directly at the header
0030F0r 2  A0 00              LDY   #GC_HDR_TAG
0030F2r 2  B1 rr              LDA   (ptr_lo),Y
0030F4r 2  09 80              ORA   #ALLOC_MARK_BIT
0030F6r 2  91 rr              STA   (ptr_lo),Y
0030F8r 2               
0030F8r 2                     ; Follow next pointer (at record data offset 0)
0030F8r 2  A5 rr              LDA   gc_ptr_lo
0030FAr 2  85 rr              STA   ptr_lo
0030FCr 2  A5 rr              LDA   gc_ptr_hi
0030FEr 2  85 rr              STA   ptr_hi
003100r 2  A0 00              LDY   #0                    ; next_lo at offset 0
003102r 2  B1 rr              LDA   (ptr_lo),Y
003104r 2  AA                 TAX
003105r 2  C8                 INY
003106r 2  B1 rr              LDA   (ptr_lo),Y
003108r 2  85 rr              STA   gc_ptr_hi
00310Ar 2  86 rr              STX   gc_ptr_lo
00310Cr 2  80 CF              BRA   @walk
00310Er 2               
00310Er 2               @done:
00310Er 2  60                 RTS
00310Fr 2               
00310Fr 2               ; ---------------------------------------------------------------------
00310Fr 2               ; gc_mark_token_list — walk tok_head linked list and mark each token
00310Fr 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
00310Fr 2               ; ---------------------------------------------------------------------
00310Fr 2               gc_mark_token_list:
00310Fr 2  A5 rr              LDA   tok_head_lo
003111r 2  85 rr              STA   gc_ptr_lo
003113r 2  A5 rr              LDA   tok_head_hi
003115r 2  85 rr              STA   gc_ptr_hi
003117r 2               
003117r 2               @walk:
003117r 2  A5 rr              LDA   gc_ptr_lo
003119r 2  05 rr              ORA   gc_ptr_hi
00311Br 2  F0 21              BEQ   @done
00311Dr 2               
00311Dr 2                     ; Mark this token
00311Dr 2  A5 rr              LDA   gc_ptr_lo
00311Fr 2  85 rr              STA   gc_mark_lo
003121r 2  A5 rr              LDA   gc_ptr_hi
003123r 2  85 rr              STA   gc_mark_hi
003125r 2  20 rr rr           JSR   gc_mark_node
003128r 2               
003128r 2                     ; Follow next pointer (at payload offsets TOK_NEXT_LO/HI)
003128r 2  A5 rr              LDA   gc_ptr_lo
00312Ar 2  85 rr              STA   ptr_lo
00312Cr 2  A5 rr              LDA   gc_ptr_hi
00312Er 2  85 rr              STA   ptr_hi
003130r 2  A0 01              LDY   #TOK_NEXT_LO
003132r 2  B1 rr              LDA   (ptr_lo),Y
003134r 2  AA                 TAX
003135r 2  C8                 INY
003136r 2  B1 rr              LDA   (ptr_lo),Y
003138r 2  85 rr              STA   gc_ptr_hi
00313Ar 2  86 rr              STX   gc_ptr_lo
00313Cr 2  80 D9              BRA   @walk
00313Er 2               
00313Er 2               @done:
00313Er 2  60                 RTS
00313Fr 2               
00313Fr 2               ; ---------------------------------------------------------------------
00313Fr 2               ; gc_mark_list — recursively mark a cons-pair list
00313Fr 2               ;   Input: gc_mark_lo/hi = head cons pair pointer (payload)
00313Fr 2               ;   Marks each cons cell, and recursively marks sublists and word strings.
00313Fr 2               ;   Clobbers: A, X, Y, gc_mark, gc_ptr, ptr_lo/hi
00313Fr 2               ; ---------------------------------------------------------------------
00313Fr 2               gc_mark_list:
00313Fr 2                     ; Use gc_ptr to walk the list, gc_mark for marking
00313Fr 2  A5 rr              LDA   gc_mark_lo
003141r 2  85 rr              STA   gc_ptr_lo
003143r 2  A5 rr              LDA   gc_mark_hi
003145r 2  85 rr              STA   gc_ptr_hi
003147r 2               
003147r 2               @walk:
003147r 2  A5 rr              LDA   gc_ptr_lo
003149r 2  05 rr              ORA   gc_ptr_hi
00314Br 2  F0 70              BEQ   @done
00314Dr 2               
00314Dr 2                     ; Mark this cons pair
00314Dr 2  A5 rr              LDA   gc_ptr_lo
00314Fr 2  85 rr              STA   gc_mark_lo
003151r 2  A5 rr              LDA   gc_ptr_hi
003153r 2  85 rr              STA   gc_mark_hi
003155r 2  20 rr rr           JSR   gc_mark_node
003158r 2               
003158r 2                     ; Check car_type: if list, recursively mark sublist
003158r 2                     ; if word, mark the string
003158r 2  A5 rr              LDA   gc_ptr_lo
00315Ar 2  85 rr              STA   ptr_lo
00315Cr 2  A5 rr              LDA   gc_ptr_hi
00315Er 2  85 rr              STA   ptr_hi
003160r 2  A0 01              LDY   #CONS_CAR_TYPE
003162r 2  B1 rr              LDA   (ptr_lo),Y
003164r 2  C9 02              CMP   #VAL_LIST
003166r 2  F0 23              BEQ   @car_list
003168r 2  C9 01              CMP   #VAL_WORD
00316Ar 2  F0 02              BEQ   @car_word
00316Cr 2  80 38              BRA   @follow_cdr
00316Er 2               
00316Er 2               @car_word:
00316Er 2                     ; Mark the word string allocation
00316Er 2  A0 03              LDY   #CONS_CAR_LO
003170r 2  B1 rr              LDA   (ptr_lo),Y
003172r 2  85 rr              STA   gc_mark_lo
003174r 2  A0 02              LDY   #CONS_CAR_HI
003176r 2  B1 rr              LDA   (ptr_lo),Y
003178r 2  85 rr              STA   gc_mark_hi
00317Ar 2                     ; Save gc_ptr across mark
00317Ar 2  A5 rr              LDA   gc_ptr_lo
00317Cr 2  48                 PHA
00317Dr 2  A5 rr              LDA   gc_ptr_hi
00317Fr 2  48                 PHA
003180r 2  20 rr rr           JSR   gc_mark_node
003183r 2  68                 PLA
003184r 2  85 rr              STA   gc_ptr_hi
003186r 2  68                 PLA
003187r 2  85 rr              STA   gc_ptr_lo
003189r 2  80 1B              BRA   @follow_cdr
00318Br 2               
00318Br 2               @car_list:
00318Br 2                     ; Recursively mark the sublist
00318Br 2  A0 03              LDY   #CONS_CAR_LO
00318Dr 2  B1 rr              LDA   (ptr_lo),Y
00318Fr 2  85 rr              STA   gc_mark_lo
003191r 2  A0 02              LDY   #CONS_CAR_HI
003193r 2  B1 rr              LDA   (ptr_lo),Y
003195r 2  85 rr              STA   gc_mark_hi
003197r 2                     ; Save gc_ptr across recursive call
003197r 2  A5 rr              LDA   gc_ptr_lo
003199r 2  48                 PHA
00319Ar 2  A5 rr              LDA   gc_ptr_hi
00319Cr 2  48                 PHA
00319Dr 2  20 rr rr           JSR   gc_mark_list          ; recursive
0031A0r 2  68                 PLA
0031A1r 2  85 rr              STA   gc_ptr_hi
0031A3r 2  68                 PLA
0031A4r 2  85 rr              STA   gc_ptr_lo
0031A6r 2               
0031A6r 2               @follow_cdr:
0031A6r 2                     ; Follow cdr to next cons pair
0031A6r 2  A5 rr              LDA   gc_ptr_lo
0031A8r 2  85 rr              STA   ptr_lo
0031AAr 2  A5 rr              LDA   gc_ptr_hi
0031ACr 2  85 rr              STA   ptr_hi
0031AEr 2  A0 05              LDY   #CONS_CDR_LO
0031B0r 2  B1 rr              LDA   (ptr_lo),Y
0031B2r 2  AA                 TAX
0031B3r 2  A0 06              LDY   #CONS_CDR_HI
0031B5r 2  B1 rr              LDA   (ptr_lo),Y
0031B7r 2  85 rr              STA   gc_ptr_hi
0031B9r 2  86 rr              STX   gc_ptr_lo
0031BBr 2  80 8A              BRA   @walk
0031BDr 2               
0031BDr 2               @done:
0031BDr 2  60                 RTS
0031BEr 2               
0031BEr 1               
0031BEr 1               ; =====================================================================
0031BEr 1               ; ZEROPAGE segment — interpreter zero-page variables
0031BEr 1               ; =====================================================================
0031BEr 1                     .segment "ZEROPAGE"
00004Dr 1               
00004Dr 1  xx           buf_idx:      .res 1          ; current position in input_buf
00004Er 1               
00004Er 1               ; =====================================================================
00004Er 1               ; BSS segment — runtime buffers
00004Er 1               ; =====================================================================
00004Er 1                     .segment "BSS"
000958r 1               
000958r 1  xx xx xx xx  input_buf:    .res 128        ; input line buffer
00095Cr 1  xx xx xx xx  
000960r 1  xx xx xx xx  
0009D8r 1               
0009D8r 1               ; =====================================================================
0009D8r 1               ; CODE segment — cold start and main loop
0009D8r 1               ; =====================================================================
0009D8r 1                     .segment "CODE"
0031BEr 1               
0031BEr 1               cold_start:
0031BEr 1                     ; Copy extension ROM trampoline to RAM
0031BEr 1  A2 0D              LDX   #EXT_TRAMP_SIZE-1
0031C0r 1               @copy_tramp:
0031C0r 1  BD rr rr           LDA   ext_tramp_src,X
0031C3r 1  9D 70 02           STA   EXT_TRAMPOLINE,X
0031C6r 1  CA                 DEX
0031C7r 1  10 F7              BPL   @copy_tramp
0031C9r 1               
0031C9r 1  20 rr rr           JSR   heap_init
0031CCr 1  20 rr rr           JSR   var_init
0031CFr 1  20 rr rr           JSR   proc_init
0031D2r 1  64 rr              STZ   catch_active
0031D4r 1  9C 0A A0           STZ   VGC_CURSEN
0031D7r 1  20 rr rr           JSR   print_banner
0031DAr 1  20 rr rr           JSR   print_prompt
0031DDr 1               
0031DDr 1               main_loop:
0031DDr 1  20 rr rr           JSR   read_line
0031E0r 1  9C 0A A0           STZ   VGC_CURSEN
0031E3r 1  20 rr rr           JSR   tokenize_line
0031E6r 1  20 rr rr           JSR   check_to_command
0031E9r 1  B0 03              BCS   @was_to               ; carry set = TO was handled
0031EBr 1  20 rr rr           JSR   eval_line
0031EEr 1               @was_to:
0031EEr 1                     ; Reclaim dead heap objects (tokens, list cells, etc.)
0031EEr 1  20 rr rr           JSR   gc_collect
0031F1r 1  20 rr rr           JSR   print_prompt
0031F4r 1  80 E7              BRA   main_loop
0031F6r 1               
0031F6r 1               ; ---------------------------------------------------------------------
0031F6r 1               ; check_to_command — check if first token is TO; if so, collect procedure
0031F6r 1               ;   Output: carry set = was TO (proc_collect called), carry clear = not TO
0031F6r 1               ;   Clobbers: A, Y, ptr_lo/hi, eval_cur
0031F6r 1               ; ---------------------------------------------------------------------
0031F6r 1               check_to_command:
0031F6r 1                     ; Is there a token list?
0031F6r 1  A5 rr              LDA   tok_head_lo
0031F8r 1  05 rr              ORA   tok_head_hi
0031FAr 1  F0 37              BEQ   @not_to
0031FCr 1               
0031FCr 1                     ; Check first token: must be TOK_WORD
0031FCr 1  A5 rr              LDA   tok_head_lo
0031FEr 1  85 rr              STA   ptr_lo
003200r 1  A5 rr              LDA   tok_head_hi
003202r 1  85 rr              STA   ptr_hi
003204r 1  A0 00              LDY   #TOK_TAG
003206r 1  B1 rr              LDA   (ptr_lo),Y
003208r 1  C9 01              CMP   #TOK_WORD
00320Ar 1  D0 27              BNE   @not_to
00320Cr 1               
00320Cr 1                     ; Check if word is "TO" (2 chars, 'T','O')
00320Cr 1  A0 03              LDY   #TOK_PAYLOAD
00320Er 1  B1 rr              LDA   (ptr_lo),Y           ; length
003210r 1  C9 02              CMP   #2
003212r 1  D0 1F              BNE   @not_to
003214r 1  A0 04              LDY   #TOK_PAYLOAD+1
003216r 1  B1 rr              LDA   (ptr_lo),Y
003218r 1  C9 54              CMP   #'T'
00321Ar 1  D0 17              BNE   @not_to
00321Cr 1  C8                 INY
00321Dr 1  B1 rr              LDA   (ptr_lo),Y
00321Fr 1  C9 4F              CMP   #'O'
003221r 1  D0 10              BNE   @not_to
003223r 1               
003223r 1                     ; It's TO — set up eval_cur past the TO token and call proc_collect
003223r 1  A5 rr              LDA   tok_head_lo
003225r 1  85 rr              STA   eval_cur_lo
003227r 1  A5 rr              LDA   tok_head_hi
003229r 1  85 rr              STA   eval_cur_hi
00322Br 1  20 rr rr           JSR   eval_advance          ; advance past TO token
00322Er 1  20 rr rr           JSR   proc_collect
003231r 1  38                 SEC
003232r 1  60                 RTS
003233r 1               
003233r 1               @not_to:
003233r 1  18                 CLC
003234r 1  60                 RTS
003235r 1               
003235r 1               ; ---------------------------------------------------------------------
003235r 1               ; read_line — read a line of input into input_buf, null-terminated
003235r 1               ;   On return: input_buf contains the line, buf_idx = length
003235r 1               ; ---------------------------------------------------------------------
003235r 1               read_line:
003235r 1  64 rr              STZ   buf_idx            ; reset buffer index to 0
003237r 1  A9 01              LDA   #$01
003239r 1  8D 0A A0           STA   VGC_CURSEN
00323Cr 1               
00323Cr 1               @poll:
00323Cr 1  AD 0F A0           LDA   VGC_CHARIN         ; poll keyboard
00323Fr 1  F0 FB              BEQ   @poll              ; no key waiting — spin
003241r 1               
003241r 1                     ; --- handle CR ($0D) ---
003241r 1  C9 0D              CMP   #$0D
003243r 1  D0 10              BNE   @not_cr
003245r 1  A6 rr              LDX   buf_idx
003247r 1  9E rr rr           STZ   input_buf,X        ; null-terminate
00324Ar 1  A9 0D              LDA   #$0D
00324Cr 1  8D 0E A0           STA   VGC_CHAROUT        ; carriage return
00324Fr 1  A9 0A              LDA   #$0A
003251r 1  8D 0E A0           STA   VGC_CHAROUT        ; line feed
003254r 1  60                 RTS
003255r 1               
003255r 1               @not_cr:
003255r 1                     ; --- handle backspace ($08, $14, $7F) ---
003255r 1  C9 08              CMP   #$08
003257r 1  F0 18              BEQ   @backspace
003259r 1  C9 14              CMP   #$14
00325Br 1  F0 14              BEQ   @backspace
00325Dr 1  C9 7F              CMP   #$7F
00325Fr 1  F0 10              BEQ   @backspace
003261r 1               
003261r 1                     ; --- buffer full? ---
003261r 1  A6 rr              LDX   buf_idx
003263r 1  E0 7F              CPX   #127
003265r 1  B0 D5              BCS   @poll              ; at capacity — ignore keystroke
003267r 1               
003267r 1                     ; --- store and echo printable character ---
003267r 1  9D rr rr           STA   input_buf,X        ; store in buffer
00326Ar 1  8D 0E A0           STA   VGC_CHAROUT        ; echo to screen
00326Dr 1  E6 rr              INC   buf_idx
00326Fr 1  80 CB              BRA   @poll
003271r 1               
003271r 1               @backspace:
003271r 1  A6 rr              LDX   buf_idx
003273r 1  F0 C7              BEQ   @poll              ; nothing to delete — ignore
003275r 1  CA                 DEX
003276r 1  86 rr              STX   buf_idx
003278r 1  A9 08              LDA   #$08
00327Ar 1  8D 0E A0           STA   VGC_CHAROUT        ; move cursor left and erase
00327Dr 1  80 BD              BRA   @poll
00327Fr 1               
00327Fr 1               ; ---------------------------------------------------------------------
00327Fr 1               ; print_prompt — prints "? " to the screen
00327Fr 1               ; ---------------------------------------------------------------------
00327Fr 1               print_prompt:
00327Fr 1  A2 00              LDX   #0
003281r 1  BD rr rr     @lp:  LDA   str_prompt,X
003284r 1  F0 06              BEQ   @done
003286r 1  8D 0E A0           STA   VGC_CHAROUT
003289r 1  E8                 INX
00328Ar 1  D0 F5              BNE   @lp
00328Cr 1               @done:
00328Cr 1  A9 01              LDA   #$01
00328Er 1  8D 0A A0           STA   VGC_CURSEN
003291r 1  60                 RTS
003292r 1               
003292r 1               ; ---------------------------------------------------------------------
003292r 1               ; print_banner — prints title and current available heap bytes
003292r 1               ; ---------------------------------------------------------------------
003292r 1               print_banner:
003292r 1  A2 00              LDX   #0
003294r 1               @title:
003294r 1  BD rr rr           LDA   str_banner_title,X
003297r 1  F0 06              BEQ   @free
003299r 1  8D 0E A0           STA   VGC_CHAROUT
00329Cr 1  E8                 INX
00329Dr 1  D0 F5              BNE   @title
00329Fr 1               
00329Fr 1               @free:
00329Fr 1  38                 SEC
0032A0r 1  A9 00              LDA   #<HEAP_END
0032A2r 1  E5 rr              SBC   heap_ptr
0032A4r 1  85 rr              STA   eval_val_lo
0032A6r 1  A9 9C              LDA   #>HEAP_END
0032A8r 1  E5 rr              SBC   heap_ptr+1
0032AAr 1  85 rr              STA   eval_val_hi
0032ACr 1  38                 SEC
0032ADr 1  A5 rr              LDA   eval_val_lo
0032AFr 1  E9 02              SBC   #GC_HDR_BYTES
0032B1r 1  85 rr              STA   eval_val_lo
0032B3r 1  A5 rr              LDA   eval_val_hi
0032B5r 1  E9 00              SBC   #0
0032B7r 1  85 rr              STA   eval_val_hi
0032B9r 1  64 rr              STZ   eval_val_frac
0032BBr 1  20 rr rr           JSR   print_uint16
0032BEr 1               
0032BEr 1  A2 00              LDX   #0
0032C0r 1               @suffix:
0032C0r 1  BD rr rr           LDA   str_bytes_free,X
0032C3r 1  F0 06              BEQ   @done
0032C5r 1  8D 0E A0           STA   VGC_CHAROUT
0032C8r 1  E8                 INX
0032C9r 1  D0 F5              BNE   @suffix
0032CBr 1               @done:
0032CBr 1  60                 RTS
0032CCr 1               
0032CCr 1               ; =====================================================================
0032CCr 1               ; RODATA segment — string constants
0032CCr 1               ; =====================================================================
0032CCr 1                     .segment "RODATA"
000A6Er 1               
000A6Er 1               str_banner_title:
000A6Er 1  4E 6F 76 61        .byte "Nova LOGO v1.0", $0D, $0A
000A72r 1  20 4C 4F 47  
000A76r 1  4F 20 76 31  
000A7Er 1  00                 .byte 0
000A7Fr 1               str_bytes_free:
000A7Fr 1  20 42 59 54        .byte " BYTES FREE", $0D, $0A, $0D, $0A
000A83r 1  45 53 20 46  
000A87r 1  52 45 45 0D  
000A8Er 1  00                 .byte 0
000A8Fr 1               
000A8Fr 1               str_prompt:
000A8Fr 1  3F 20 00           .byte "? ", 0
000A92r 1               
000A92r 1               ; Extension ROM trampoline — copied to RAM at $0270 during cold_start.
000A92r 1               ; Swaps to extension ROM, calls entry, swaps back to Logo ROM.
000A92r 1               ext_tramp_src:
000A92r 1  A9 04              .byte $A9, ROMSWAP_EXTENSION  ; LDA #ROMSWAP_EXTENSION
000A94r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000A97r 1  20 00 C0           .byte $20, $00, $C0          ; JSR $C000
000A9Ar 1  A9 05              .byte $A9, ROMSWAP_LOGO      ; LDA #ROMSWAP_LOGO
000A9Cr 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000A9Fr 1  60                 .byte $60                     ; RTS
000AA0r 1               
000AA0r 1               ; =====================================================================
000AA0r 1               ; MONITOR segment — reset handler at $FFD7
000AA0r 1               ; =====================================================================
000AA0r 1                     .segment "MONITOR"
000000r 1                     .org  $FFD7
00FFD7  1               
00FFD7  1               RES_vec:
00FFD7  1  D8                 CLD                     ; clear decimal mode
00FFD8  1  A2 FF              LDX   #$FF              ; empty stack
00FFDA  1  9A                 TXS                     ; set the stack
00FFDB  1  4C rr rr           JMP   cold_start
00FFDE  1               
00FFDE  1               ; IRQ/NMI stubs
00FFDE  1               NMI_stub:
00FFDE  1  40                 RTI
00FFDF  1               
00FFDF  1               IRQ_stub:
00FFDF  1  40                 RTI
00FFE0  1               
00FFE0  1               ; =====================================================================
00FFE0  1               ; VECTORS segment — 6502 hardware vectors at $FFFA
00FFE0  1               ; =====================================================================
00FFE0  1                     .segment "VECTORS"
00FFE0  1                     .org  $FFFA
00FFFA  1               
00FFFA  1  DE FF              .word NMI_stub           ; $FFFA — NMI vector
00FFFC  1  D7 FF              .word RES_vec            ; $FFFC — RESET vector
00FFFE  1  DF FF              .word IRQ_stub           ; $FFFE — IRQ vector
00FFFE  1               
