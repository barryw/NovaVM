00227Er 2  4C rr rr           JMP   err_nei
002281r 2               
002281r 2               ; ---------------------------------------------------------------------
002281r 2               ; do_word — WORD val1 val2: concatenate two words into one
002281r 2               ;   Arity 0: evaluates its own arguments
002281r 2               ; ---------------------------------------------------------------------
002281r 2               do_word:
002281r 2                     ; Evaluate first arg (must be a word)
002281r 2  20 rr rr           JSR   eval_expr
002284r 2  90 03              BCC   :+
002286r 2  4C rr rr           JMP   @err
002289r 2               :
002289r 2  A5 rr              LDA   eval_type
00228Br 2  C9 01              CMP   #VAL_WORD
00228Dr 2  F0 03              BEQ   :+
00228Fr 2  4C rr rr           JMP   @err_type
002292r 2               :
002292r 2                     ; Save first word pointer
002292r 2  A5 rr              LDA   eval_val_lo
002294r 2  48                 PHA
002295r 2  A5 rr              LDA   eval_val_hi
002297r 2  48                 PHA
002298r 2               
002298r 2                     ; Evaluate second arg (must be a word)
002298r 2  20 rr rr           JSR   eval_expr
00229Br 2  90 05              BCC   :+
00229Dr 2  68                 PLA
00229Er 2  68                 PLA
00229Fr 2  4C rr rr           JMP   @err
0022A2r 2               :
0022A2r 2  A5 rr              LDA   eval_type
0022A4r 2  C9 01              CMP   #VAL_WORD
0022A6r 2  F0 03              BEQ   :+
0022A8r 2  4C rr rr           JMP   @err_type_pop2
0022ABr 2               :
0022ABr 2               
0022ABr 2                     ; eval_val = second word, stack has first word ptr
0022ABr 2                     ; Read lengths
0022ABr 2  A5 rr              LDA   eval_val_lo
0022ADr 2  85 rr              STA   ptr2_lo
0022AFr 2  A5 rr              LDA   eval_val_hi
0022B1r 2  85 rr              STA   ptr2_hi
0022B3r 2  A0 00              LDY   #0
0022B5r 2  B1 rr              LDA   (ptr2_lo),Y            ; second word length
0022B7r 2  85 rr              STA   list_count_lo           ; save len2
0022B9r 2               
0022B9r 2                     ; Read first word length from stack
0022B9r 2  68                 PLA
0022BAr 2  85 rr              STA   list_head_hi            ; first word ptr hi
0022BCr 2  68                 PLA
0022BDr 2  85 rr              STA   list_head_lo            ; first word ptr lo
0022BFr 2  A5 rr              LDA   list_head_lo
0022C1r 2  85 rr              STA   ptr_lo
0022C3r 2  A5 rr              LDA   list_head_hi
0022C5r 2  85 rr              STA   ptr_hi
0022C7r 2  A0 00              LDY   #0
0022C9r 2  B1 rr              LDA   (ptr_lo),Y             ; first word length
0022CBr 2  85 rr              STA   list_count_hi           ; save len1
0022CDr 2               
0022CDr 2                     ; Allocate new string: 1 (length byte) + len1 + len2
0022CDr 2  18                 CLC
0022CEr 2  65 rr              ADC   list_count_lo
0022D0r 2  1A                 INC                           ; +1 for length byte
0022D1r 2  A2 05              LDX   #ATYPE_STRING
0022D3r 2  20 rr rr           JSR   heap_alloc
0022D6r 2  B0 6F              BCS   @err_oom
0022D8r 2               
0022D8r 2                     ; Write combined length
0022D8r 2  A5 rr              LDA   list_count_hi
0022DAr 2  18                 CLC
0022DBr 2  65 rr              ADC   list_count_lo
0022DDr 2  A0 00              LDY   #0
0022DFr 2  91 rr              STA   (ptr_lo),Y
0022E1r 2               
0022E1r 2                     ; Copy first word's chars
0022E1r 2  A6 rr              LDX   list_count_hi           ; len1
0022E3r 2  F0 23              BEQ   @w_copy2
0022E5r 2  A5 rr              LDA   list_head_lo
0022E7r 2  85 rr              STA   ptr2_lo
0022E9r 2  A5 rr              LDA   list_head_hi
0022EBr 2  85 rr              STA   ptr2_hi
0022EDr 2  A0 01              LDY   #1                     ; dest offset in new string
0022EFr 2  9C rr rr           STZ   num_tmp_lo              ; source offset
0022F2r 2               @w_c1:
0022F2r 2  DA                 PHX
0022F3r 2  5A                 PHY
0022F4r 2  AD rr rr           LDA   num_tmp_lo
0022F7r 2  1A                 INC                           ; skip length byte in source
0022F8r 2  A8                 TAY
0022F9r 2  B1 rr              LDA   (ptr2_lo),Y            ; source char
0022FBr 2  7A                 PLY
0022FCr 2  91 rr              STA   (ptr_lo),Y             ; dest char
0022FEr 2  C8                 INY
0022FFr 2  EE rr rr           INC   num_tmp_lo
002302r 2  FA                 PLX
002303r 2  CA                 DEX
002304r 2  D0 EC              BNE   @w_c1
002306r 2               
002306r 2                     ; Y is already at the next dest offset
002306r 2  80 02              BRA   @w_copy2_start
002308r 2               
002308r 2               @w_copy2:
002308r 2  A0 01              LDY   #1                     ; start at offset 1 if len1 was 0
00230Ar 2               @w_copy2_start:
00230Ar 2                     ; Copy second word's chars
00230Ar 2  A6 rr              LDX   list_count_lo           ; len2
00230Cr 2  F0 1F              BEQ   @w_done
00230Er 2  A5 rr              LDA   eval_val_lo
002310r 2  85 rr              STA   ptr2_lo
002312r 2  A5 rr              LDA   eval_val_hi
002314r 2  85 rr              STA   ptr2_hi
002316r 2  9C rr rr           STZ   num_tmp_lo
002319r 2               @w_c2:
002319r 2  DA                 PHX
00231Ar 2  5A                 PHY
00231Br 2  AD rr rr           LDA   num_tmp_lo
00231Er 2  1A                 INC
00231Fr 2  A8                 TAY
002320r 2  B1 rr              LDA   (ptr2_lo),Y
002322r 2  7A                 PLY
002323r 2  91 rr              STA   (ptr_lo),Y
002325r 2  C8                 INY
002326r 2  EE rr rr           INC   num_tmp_lo
002329r 2  FA                 PLX
00232Ar 2  CA                 DEX
00232Br 2  D0 EC              BNE   @w_c2
00232Dr 2               
00232Dr 2               @w_done:
00232Dr 2                     ; Return the new word
00232Dr 2  A9 01              LDA   #VAL_WORD
00232Fr 2  85 rr              STA   eval_type
002331r 2  A5 rr              LDA   ptr_lo
002333r 2  85 rr              STA   eval_val_lo
002335r 2  A5 rr              LDA   ptr_hi
002337r 2  85 rr              STA   eval_val_hi
002339r 2  64 rr              STZ   eval_val_frac
00233Br 2  4C rr rr           JMP   eval_continue
00233Er 2               
00233Er 2               @err_type_pop2:
00233Er 2  68                 PLA
00233Fr 2  68                 PLA
002340r 2               @err_type:
002340r 2  A2 rr              LDX   #<str_word_name
002342r 2  A0 rr              LDY   #>str_word_name
002344r 2  4C rr rr           JMP   err_dl_this
002347r 2               @err_oom:
002347r 2               @err:
002347r 2  A2 rr              LDX   #<str_word_name
002349r 2  A0 rr              LDY   #>str_word_name
00234Br 2  4C rr rr           JMP   err_nei
00234Er 2               
00234Er 2               ; ---------------------------------------------------------------------
00234Er 2               ; do_run — RUN list: evaluate a list as Logo code
00234Er 2               ;   Arity 0: evaluates its own argument
00234Er 2               ;
00234Er 2               ;   Strategy: convert list to text in input_buf, then save evaluator
00234Er 2               ;   state, tokenize_line + eval_line, restore state.
00234Er 2               ; ---------------------------------------------------------------------
00234Er 2               do_run:
00234Er 2  20 rr rr           JSR   eval_expr
002351r 2  90 03              BCC   :+
002353r 2  4C rr rr           JMP   @err
002356r 2               :
002356r 2  A5 rr              LDA   eval_type
002358r 2  C9 02              CMP   #VAL_LIST
00235Ar 2  D0 43              BNE   @err_type
00235Cr 2               
00235Cr 2                     ; Save eval_cur on stack (we'll resume here after RUN)
00235Cr 2  A5 rr              LDA   eval_cur_lo
00235Er 2  48                 PHA
00235Fr 2  A5 rr              LDA   eval_cur_hi
002361r 2  48                 PHA
002362r 2               
002362r 2                     ; Render the list into input_buf as text
002362r 2                     ; eval_val_lo/hi = list head
002362r 2  64 rr              STZ   z:buf_idx               ; reset write position
002364r 2  20 rr rr           JSR   render_list_to_buf
002367r 2               
002367r 2                     ; Null-terminate input_buf
002367r 2  A6 rr              LDX   z:buf_idx
002369r 2  9E rr rr           STZ   input_buf,X
00236Cr 2               
00236Cr 2                     ; Save tokenizer and eval state (same pattern as proc_invoke)
00236Cr 2  A5 rr              LDA   tok_head_lo
00236Er 2  48                 PHA
00236Fr 2  A5 rr              LDA   tok_head_hi
002371r 2  48                 PHA
002372r 2  A5 rr              LDA   tok_tail_lo
002374r 2  48                 PHA
002375r 2  A5 rr              LDA   tok_tail_hi
002377r 2  48                 PHA
002378r 2  A5 rr              LDA   eval_in_body
00237Ar 2  48                 PHA
00237Br 2  A5 rr              LDA   eval_reporter
00237Dr 2  48                 PHA
00237Er 2               
00237Er 2                     ; Tokenize the reconstructed line
00237Er 2  20 rr rr           JSR   tokenize_line
002381r 2               
002381r 2                     ; Evaluate it
002381r 2  20 rr rr           JSR   eval_line
002384r 2               
002384r 2                     ; Restore tokenizer/eval state
002384r 2  68                 PLA
002385r 2  85 rr              STA   eval_reporter
002387r 2  68                 PLA
002388r 2  85 rr              STA   eval_in_body
00238Ar 2  68                 PLA
00238Br 2  85 rr              STA   tok_tail_hi
00238Dr 2  68                 PLA
00238Er 2  85 rr              STA   tok_tail_lo
002390r 2  68                 PLA
002391r 2  85 rr              STA   tok_head_hi
002393r 2  68                 PLA
002394r 2  85 rr              STA   tok_head_lo
002396r 2               
002396r 2                     ; Restore eval_cur
002396r 2  68                 PLA
002397r 2  85 rr              STA   eval_cur_hi
002399r 2  68                 PLA
00239Ar 2  85 rr              STA   eval_cur_lo
00239Cr 2               
00239Cr 2  4C rr rr           JMP   eval_continue
00239Fr 2               
00239Fr 2               @err_type:
00239Fr 2  A2 rr              LDX   #<str_run_name
0023A1r 2  A0 rr              LDY   #>str_run_name
0023A3r 2  4C rr rr           JMP   err_needs_list
0023A6r 2               @err:
0023A6r 2  A2 rr              LDX   #<str_run_name
0023A8r 2  A0 rr              LDY   #>str_run_name
0023AAr 2  4C rr rr           JMP   err_nei
0023ADr 2               
0023ADr 2               ; ---------------------------------------------------------------------
0023ADr 2               ; render_list_to_buf — render list elements into input_buf as text
0023ADr 2               ;   Entry: eval_val_lo/hi = list head pointer
0023ADr 2               ;          buf_idx = current write position in input_buf
0023ADr 2               ;   Exit:  buf_idx updated
0023ADr 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr, list_count
0023ADr 2               ; ---------------------------------------------------------------------
0023ADr 2               render_list_to_buf:
0023ADr 2  A5 rr              LDA   eval_val_lo
0023AFr 2  85 rr              STA   list_ptr_lo
0023B1r 2  A5 rr              LDA   eval_val_hi
0023B3r 2  85 rr              STA   list_ptr_hi
0023B5r 2  A2 00              LDX   #0                     ; 0 = first element (no leading space)
0023B7r 2               
0023B7r 2               @rl_loop:
0023B7r 2  A5 rr              LDA   list_ptr_lo
0023B9r 2  05 rr              ORA   list_ptr_hi
0023BBr 2  D0 01              BNE   :+
0023BDr 2  60                 RTS                           ; end of list
0023BEr 2               :
0023BEr 2                     ; Add space before non-first elements
0023BEr 2  E0 00              CPX   #0
0023C0r 2  F0 0F              BEQ   @rl_no_space
0023C2r 2  A5 rr              LDA   z:buf_idx
0023C4r 2  C9 7E              CMP   #126
0023C6r 2  90 01              BCC   :+
0023C8r 2  60                 RTS                           ; buffer full — truncate
0023C9r 2               :
0023C9r 2  A8                 TAY
0023CAr 2  A9 20              LDA   #' '
0023CCr 2  99 rr rr           STA   input_buf,Y
0023CFr 2  E6 rr              INC   z:buf_idx
0023D1r 2               @rl_no_space:
0023D1r 2  A2 01              LDX   #1                     ; subsequent elements get space
0023D3r 2               
0023D3r 2                     ; Read car type
0023D3r 2  A5 rr              LDA   list_ptr_lo
0023D5r 2  85 rr              STA   ptr_lo
0023D7r 2  A5 rr              LDA   list_ptr_hi
0023D9r 2  85 rr              STA   ptr_hi
0023DBr 2  A0 01              LDY   #CONS_CAR_TYPE
0023DDr 2  B1 rr              LDA   (ptr_lo),Y
0023DFr 2               
0023DFr 2  C9 02              CMP   #VAL_LIST
0023E1r 2  F0 62              BEQ   @rl_sublist
0023E3r 2  C9 01              CMP   #VAL_WORD
0023E5r 2  F0 25              BEQ   @rl_word
0023E7r 2               
0023E7r 2                     ; Number: render to input_buf
0023E7r 2  DA                 PHX
0023E8r 2  A5 rr              LDA   list_ptr_lo
0023EAr 2  48                 PHA
0023EBr 2  A5 rr              LDA   list_ptr_hi
0023EDr 2  48                 PHA
0023EEr 2                     ; Load the number value
0023EEr 2  A0 02              LDY   #CONS_CAR_HI
0023F0r 2  B1 rr              LDA   (ptr_lo),Y
0023F2r 2  85 rr              STA   eval_val_hi
0023F4r 2  A0 03              LDY   #CONS_CAR_LO
0023F6r 2  B1 rr              LDA   (ptr_lo),Y
0023F8r 2  85 rr              STA   eval_val_lo
0023FAr 2  A0 04              LDY   #CONS_CAR_FRAC
0023FCr 2  B1 rr              LDA   (ptr_lo),Y
0023FEr 2  85 rr              STA   eval_val_frac
002400r 2  20 rr rr           JSR   render_number_to_buf
002403r 2  68                 PLA
002404r 2  85 rr              STA   list_ptr_hi
002406r 2  68                 PLA
002407r 2  85 rr              STA   list_ptr_lo
002409r 2  FA                 PLX
00240Ar 2  80 72              BRA   @rl_advance
00240Cr 2               
00240Cr 2               @rl_word:
00240Cr 2  DA                 PHX
00240Dr 2  A5 rr              LDA   list_ptr_lo
00240Fr 2  48                 PHA
002410r 2  A5 rr              LDA   list_ptr_hi
002412r 2  48                 PHA
002413r 2                     ; Get word string pointer
002413r 2  A0 03              LDY   #CONS_CAR_LO
002415r 2  B1 rr              LDA   (ptr_lo),Y
002417r 2  85 rr              STA   ptr2_lo
002419r 2  A0 02              LDY   #CONS_CAR_HI
00241Br 2  B1 rr              LDA   (ptr_lo),Y
00241Dr 2  85 rr              STA   ptr2_hi
00241Fr 2                     ; Copy word chars to buf
00241Fr 2  A0 00              LDY   #0
002421r 2  B1 rr              LDA   (ptr2_lo),Y            ; length
002423r 2  AA                 TAX
002424r 2  F0 16              BEQ   @rl_word_done
002426r 2  C8                 INY
002427r 2               @rl_wch:
002427r 2  A5 rr              LDA   z:buf_idx
002429r 2  C9 7E              CMP   #126
00242Br 2  B0 0F              BCS   @rl_word_done
00242Dr 2  B1 rr              LDA   (ptr2_lo),Y
00242Fr 2  5A                 PHY
002430r 2  A4 rr              LDY   z:buf_idx
002432r 2  99 rr rr           STA   input_buf,Y
002435r 2  E6 rr              INC   z:buf_idx
002437r 2  7A                 PLY
002438r 2  C8                 INY
002439r 2  CA                 DEX
00243Ar 2  D0 EB              BNE   @rl_wch
00243Cr 2               @rl_word_done:
00243Cr 2  68                 PLA
00243Dr 2  85 rr              STA   list_ptr_hi
00243Fr 2  68                 PLA
002440r 2  85 rr              STA   list_ptr_lo
002442r 2  FA                 PLX
002443r 2  80 39              BRA   @rl_advance
002445r 2               
002445r 2               @rl_sublist:
002445r 2  DA                 PHX
002446r 2  A5 rr              LDA   list_ptr_lo
002448r 2  48                 PHA
002449r 2  A5 rr              LDA   list_ptr_hi
00244Br 2  48                 PHA
00244Cr 2                     ; Write '[' to buf
00244Cr 2  A5 rr              LDA   z:buf_idx
00244Er 2  C9 7E              CMP   #126
002450r 2  B0 25              BCS   @rl_sub_done
002452r 2  A8                 TAY
002453r 2  A9 5B              LDA   #'['
002455r 2  99 rr rr           STA   input_buf,Y
002458r 2  E6 rr              INC   z:buf_idx
00245Ar 2                     ; Get sublist pointer and recurse
00245Ar 2  A0 03              LDY   #CONS_CAR_LO
00245Cr 2  B1 rr              LDA   (ptr_lo),Y
00245Er 2  85 rr              STA   eval_val_lo
002460r 2  A0 02              LDY   #CONS_CAR_HI
002462r 2  B1 rr              LDA   (ptr_lo),Y
002464r 2  85 rr              STA   eval_val_hi
002466r 2  20 rr rr           JSR   render_list_to_buf
002469r 2                     ; Write ']' to buf
002469r 2  A5 rr              LDA   z:buf_idx
00246Br 2  C9 7E              CMP   #126
00246Dr 2  B0 08              BCS   @rl_sub_done
00246Fr 2  A8                 TAY
002470r 2  A9 5D              LDA   #']'
002472r 2  99 rr rr           STA   input_buf,Y
002475r 2  E6 rr              INC   z:buf_idx
002477r 2               @rl_sub_done:
002477r 2  68                 PLA
002478r 2  85 rr              STA   list_ptr_hi
00247Ar 2  68                 PLA
00247Br 2  85 rr              STA   list_ptr_lo
00247Dr 2  FA                 PLX
00247Er 2               
00247Er 2               @rl_advance:
00247Er 2                     ; Follow cdr
00247Er 2  A5 rr              LDA   list_ptr_lo
002480r 2  85 rr              STA   ptr_lo
002482r 2  A5 rr              LDA   list_ptr_hi
002484r 2  85 rr              STA   ptr_hi
002486r 2  A0 05              LDY   #CONS_CDR_LO
002488r 2  B1 rr              LDA   (ptr_lo),Y
00248Ar 2  AA                 TAX
00248Br 2  A0 06              LDY   #CONS_CDR_HI
00248Dr 2  B1 rr              LDA   (ptr_lo),Y
00248Fr 2  85 rr              STA   list_ptr_hi
002491r 2  86 rr              STX   list_ptr_lo
002493r 2  A2 01              LDX   #1                     ; always space after first element
002495r 2  4C rr rr           JMP   @rl_loop
002498r 2               
002498r 2               @rl_trunc:
002498r 2  60                 RTS
002499r 2               
002499r 2               ; ---------------------------------------------------------------------
002499r 2               ; render_number_to_buf — render eval_val as decimal into input_buf
002499r 2               ;   Entry: eval_val_hi/lo/frac = number value
002499r 2               ;          buf_idx = current write position
002499r 2               ;   Exit:  buf_idx updated
002499r 2               ;   Clobbers: A, X, Y, num_val, num_tmp, pn_buf
002499r 2               ; ---------------------------------------------------------------------
002499r 2               render_number_to_buf:
002499r 2                     ; Handle sign
002499r 2  A5 rr              LDA   eval_val_hi
00249Br 2  10 22              BPL   @rn_positive
00249Dr 2                     ; Write '-'
00249Dr 2  A4 rr              LDY   z:buf_idx
00249Fr 2  A9 2D              LDA   #'-'
0024A1r 2  99 rr rr           STA   input_buf,Y
0024A4r 2  E6 rr              INC   z:buf_idx
0024A6r 2                     ; Negate
0024A6r 2  A5 rr              LDA   eval_val_frac
0024A8r 2  49 FF              EOR   #$FF
0024AAr 2  18                 CLC
0024ABr 2  69 01              ADC   #1
0024ADr 2  85 rr              STA   eval_val_frac
0024AFr 2  A5 rr              LDA   eval_val_lo
0024B1r 2  49 FF              EOR   #$FF
0024B3r 2  69 00              ADC   #0
0024B5r 2  85 rr              STA   eval_val_lo
0024B7r 2  A5 rr              LDA   eval_val_hi
0024B9r 2  49 FF              EOR   #$FF
0024BBr 2  69 00              ADC   #0
0024BDr 2  85 rr              STA   eval_val_hi
0024BFr 2               
0024BFr 2               @rn_positive:
0024BFr 2                     ; Render integer part using power-of-10 subtraction
0024BFr 2  A5 rr              LDA   eval_val_lo
0024C1r 2  8D rr rr           STA   num_val_lo
0024C4r 2  A5 rr              LDA   eval_val_hi
0024C6r 2  8D rr rr           STA   num_val_hi
0024C9r 2               
0024C9r 2  A2 00              LDX   #0                     ; digit buffer index
0024CBr 2  A0 00              LDY   #0                     ; power-of-10 index
0024CDr 2               @rn_div:
0024CDr 2  9C rr rr           STZ   num_tmp_lo
0024D0r 2               @rn_sub:
0024D0r 2  38                 SEC
0024D1r 2  AD rr rr           LDA   num_val_lo
0024D4r 2  F9 rr rr           SBC   pow10_lo,Y
0024D7r 2  48                 PHA
0024D8r 2  AD rr rr           LDA   num_val_hi
0024DBr 2  F9 rr rr           SBC   pow10_hi,Y
0024DEr 2  90 0C              BCC   @rn_sub_done
0024E0r 2  8D rr rr           STA   num_val_hi
0024E3r 2  68                 PLA
0024E4r 2  8D rr rr           STA   num_val_lo
0024E7r 2  EE rr rr           INC   num_tmp_lo
0024EAr 2  80 E4              BRA   @rn_sub
0024ECr 2               @rn_sub_done:
0024ECr 2  68                 PLA
0024EDr 2  AD rr rr           LDA   num_tmp_lo
0024F0r 2  9D rr rr           STA   pn_buf,X
0024F3r 2  E8                 INX
0024F4r 2  C8                 INY
0024F5r 2  C0 05              CPY   #5
0024F7r 2  90 D4              BCC   @rn_div
0024F9r 2               
0024F9r 2                     ; Write digits suppressing leading zeros
0024F9r 2  A0 00              LDY   #0                     ; suppress flag
0024FBr 2  A2 00              LDX   #0
0024FDr 2               @rn_print:
0024FDr 2  BD rr rr           LDA   pn_buf,X
002500r 2  D0 04              BNE   @rn_nonzero
002502r 2  C0 00              CPY   #0
002504r 2  F0 0D              BEQ   @rn_skip
002506r 2               @rn_nonzero:
002506r 2  A0 01              LDY   #1
002508r 2  09 30              ORA   #'0'
00250Ar 2  DA                 PHX
00250Br 2  A6 rr              LDX   z:buf_idx
00250Dr 2  9D rr rr           STA   input_buf,X
002510r 2  E6 rr              INC   z:buf_idx
002512r 2  FA                 PLX
002513r 2               @rn_skip:
002513r 2  E8                 INX
002514r 2  E0 04              CPX   #4
002516r 2  90 E5              BCC   @rn_print
002518r 2                     ; Always write ones digit
002518r 2  AD rr rr           LDA   pn_buf+4
00251Br 2  09 30              ORA   #'0'
00251Dr 2  A6 rr              LDX   z:buf_idx
00251Fr 2  9D rr rr           STA   input_buf,X
002522r 2  E6 rr              INC   z:buf_idx
002524r 2               
002524r 2                     ; Fractional part
002524r 2  A5 rr              LDA   eval_val_frac
002526r 2  D0 01              BNE   @rn_has_frac
002528r 2  60                 RTS
002529r 2               @rn_has_frac:
002529r 2                     ; Write '.'
002529r 2  A6 rr              LDX   z:buf_idx
00252Br 2  A9 2E              LDA   #'.'
00252Dr 2  9D rr rr           STA   input_buf,X
002530r 2  E6 rr              INC   z:buf_idx
002532r 2                     ; First frac digit
002532r 2  A5 rr              LDA   eval_val_frac
002534r 2  8D rr rr           STA   num_tmp_lo
002537r 2  9C rr rr           STZ   num_tmp_hi
00253Ar 2  AD rr rr           LDA   num_tmp_lo
00253Dr 2  0A                 ASL
00253Er 2  8D rr rr           STA   num_val_lo
002541r 2  AD rr rr           LDA   num_tmp_hi
002544r 2  2A                 ROL
002545r 2  8D rr rr           STA   num_val_hi
002548r 2  0E rr rr           ASL   num_val_lo
00254Br 2  2E rr rr           ROL   num_val_hi
00254Er 2  0E rr rr           ASL   num_val_lo
002551r 2  2E rr rr           ROL   num_val_hi
002554r 2  18                 CLC
002555r 2  AD rr rr           LDA   num_tmp_lo
002558r 2  0A                 ASL
002559r 2  6D rr rr           ADC   num_val_lo
00255Cr 2  8D rr rr           STA   num_val_lo
00255Fr 2  AD rr rr           LDA   num_tmp_hi
002562r 2  2A                 ROL
002563r 2  6D rr rr           ADC   num_val_hi
002566r 2  8D rr rr           STA   num_val_hi
002569r 2                     ; High byte = digit
002569r 2  AD rr rr           LDA   num_val_hi
00256Cr 2  09 30              ORA   #'0'
00256Er 2  A6 rr              LDX   z:buf_idx
002570r 2  9D rr rr           STA   input_buf,X
002573r 2  E6 rr              INC   z:buf_idx
002575r 2                     ; Second frac digit
002575r 2  AD rr rr           LDA   num_val_lo
002578r 2  8D rr rr           STA   num_tmp_lo
00257Br 2  9C rr rr           STZ   num_tmp_hi
00257Er 2  AD rr rr           LDA   num_tmp_lo
002581r 2  0A                 ASL
002582r 2  8D rr rr           STA   num_val_lo
002585r 2  AD rr rr           LDA   num_tmp_hi
002588r 2  2A                 ROL
002589r 2  8D rr rr           STA   num_val_hi
00258Cr 2  0E rr rr           ASL   num_val_lo
00258Fr 2  2E rr rr           ROL   num_val_hi
002592r 2  0E rr rr           ASL   num_val_lo
002595r 2  2E rr rr           ROL   num_val_hi
002598r 2  18                 CLC
002599r 2  AD rr rr           LDA   num_tmp_lo
00259Cr 2  0A                 ASL
00259Dr 2  6D rr rr           ADC   num_val_lo
0025A0r 2  8D rr rr           STA   num_val_lo
0025A3r 2  AD rr rr           LDA   num_tmp_hi
0025A6r 2  2A                 ROL
0025A7r 2  6D rr rr           ADC   num_val_hi
0025AAr 2  8D rr rr           STA   num_val_hi
0025ADr 2  AD rr rr           LDA   num_val_hi
0025B0r 2  F0 09              BEQ   @rn_done                ; skip trailing zero
0025B2r 2  09 30              ORA   #'0'
0025B4r 2  A6 rr              LDX   z:buf_idx
0025B6r 2  9D rr rr           STA   input_buf,X
0025B9r 2  E6 rr              INC   z:buf_idx
0025BBr 2               @rn_done:
0025BBr 2  60                 RTS
0025BCr 2               
0025BCr 2               ; =====================================================================
0025BCr 2               ; RODATA — list error strings
0025BCr 2               ; =====================================================================
0025BCr 2                     .segment "RODATA"
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               
0005B9r 2               ; Builtin name strings for list operations
0005B9r 2               str_first_name:
0005B9r 2  05 46 49 52        .byte 5, "FIRST"
0005BDr 2  53 54        
0005BFr 2               str_butfirst_name:
0005BFr 2  08 42 55 54        .byte 8, "BUTFIRST"
0005C3r 2  46 49 52 53  
0005C7r 2  54           
0005C8r 2               str_bf_name:
0005C8r 2  02 42 46           .byte 2, "BF"
0005CBr 2               str_count_name:
0005CBr 2  05 43 4F 55        .byte 5, "COUNT"
0005CFr 2  4E 54        
0005D1r 2               str_emptyp_name:
0005D1r 2  06 45 4D 50        .byte 6, "EMPTY?"
0005D5r 2  54 59 3F     
0005D8r 2               str_last_name:
0005D8r 2  04 4C 41 53        .byte 4, "LAST"
0005DCr 2  54           
0005DDr 2               str_butlast_name:
0005DDr 2  07 42 55 54        .byte 7, "BUTLAST"
0005E1r 2  4C 41 53 54  
0005E5r 2               str_bl_name:
0005E5r 2  02 42 4C           .byte 2, "BL"
0005E8r 2               str_item_name:
0005E8r 2  04 49 54 45        .byte 4, "ITEM"
0005ECr 2  4D           
0005EDr 2               str_memberp_name:
0005EDr 2  07 4D 45 4D        .byte 7, "MEMBER?"
0005F1r 2  42 45 52 3F  
0005F5r 2               str_show_name:
0005F5r 2  04 53 48 4F        .byte 4, "SHOW"
0005F9r 2  57           
0005FAr 2               str_fput_name:
0005FAr 2  04 46 50 55        .byte 4, "FPUT"
0005FEr 2  54           
0005FFr 2               str_lput_name:
0005FFr 2  04 4C 50 55        .byte 4, "LPUT"
000603r 2  54           
000604r 2               str_list_name:
000604r 2  04 4C 49 53        .byte 4, "LIST"
000608r 2  54           
000609r 2               str_sentence_name:
000609r 2  08 53 45 4E        .byte 8, "SENTENCE"
00060Dr 2  54 45 4E 43  
000611r 2  45           
000612r 2               str_se_name:
000612r 2  02 53 45           .byte 2, "SE"
000615r 2               str_word_name:
000615r 2  04 57 4F 52        .byte 4, "WORD"
000619r 2  44           
00061Ar 2               str_run_name:
00061Ar 2  03 52 55 4E        .byte 3, "RUN"
00061Er 2               
00061Er 1                     .include "vars.s"
00061Er 2               ; vars.s — variable storage for NovaLogo (MAKE / :reference)
00061Er 2               ;
00061Er 2               ; Variables are stored as a linked list of heap entries.
00061Er 2               ; Entry layout:
00061Er 2               ;   +0: next_lo  (2 bytes — pointer to next entry, or $0000)
00061Er 2               ;   +1: next_hi
00061Er 2               ;   +2: name_len (1 byte)
00061Er 2               ;   +3: name chars (name_len bytes, uppercased)
00061Er 2               ;   +3+name_len: value_type (1 byte: $00=number, $01=word)
00061Er 2               ;   +4+name_len: val_hi  (or ptr_lo for word)
00061Er 2               ;   +5+name_len: val_lo  (or ptr_hi for word)
00061Er 2               ;   +6+name_len: val_frac (0 for word)
00061Er 2               ;   +7+name_len: pad     (0)
00061Er 2               ;
00061Er 2               ; Total entry size = 8 + name_len bytes.
00061Er 2               
00061Er 2               ; Entry field offsets (relative to entry base)
00061Er 2               VAR_NEXT_LO  = 0
00061Er 2               VAR_NEXT_HI  = 1
00061Er 2               VAR_NAME_LEN = 2
00061Er 2               VAR_NAME     = 3              ; first char of name
00061Er 2               
00061Er 2               ; =====================================================================
00061Er 2               ; ZEROPAGE segment — variable list head + scratch
00061Er 2               ; =====================================================================
00061Er 2                     .segment "ZEROPAGE"
000037r 2               
000037r 2  xx           var_head_lo:    .res 1        ; head of variable linked list
000038r 2  xx           var_head_hi:    .res 1
000039r 2  xx           var_entry_lo:   .res 1        ; current entry pointer (walk scratch)
00003Ar 2  xx           var_entry_hi:   .res 1
00003Br 2  xx           var_name_lo:    .res 1        ; saved name pointer for set/get
00003Cr 2  xx           var_name_hi:    .res 1
00003Dr 2               
00003Dr 2               ; =====================================================================
00003Dr 2               ; CODE segment — variable routines
00003Dr 2               ; =====================================================================
00003Dr 2                     .segment "CODE"
0025BCr 2               
0025BCr 2               ; ---------------------------------------------------------------------
0025BCr 2               ; var_init — initialize variable list to empty
0025BCr 2               ;   Called once at cold_start
0025BCr 2               ; ---------------------------------------------------------------------
0025BCr 2               var_init:
0025BCr 2  64 rr              STZ   var_head_lo
0025BEr 2  64 rr              STZ   var_head_hi
0025C0r 2  60                 RTS
0025C1r 2               
0025C1r 2               ; ---------------------------------------------------------------------
0025C1r 2               ; var_set — store a value under a variable name
0025C1r 2               ;   Input: ptr_lo/hi → length-prefixed name string (in token node)
0025C1r 2               ;          eval_type, eval_val_hi/lo/frac = value to store
0025C1r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, var_entry, var_name
0025C1r 2               ; ---------------------------------------------------------------------
0025C1r 2               var_set:
0025C1r 2                     ; Save name pointer — we need it after the walk
0025C1r 2  A5 rr              LDA   ptr_lo
0025C3r 2  85 rr              STA   var_name_lo
0025C5r 2  A5 rr              LDA   ptr_hi
0025C7r 2  85 rr              STA   var_name_hi
0025C9r 2               
0025C9r 2                     ; Walk the list looking for an existing entry with this name
0025C9r 2  A5 rr              LDA   var_head_lo
0025CBr 2  85 rr              STA   var_entry_lo
0025CDr 2  A5 rr              LDA   var_head_hi
0025CFr 2  85 rr              STA   var_entry_hi
0025D1r 2               
0025D1r 2               @walk:
0025D1r 2                     ; End of list?
0025D1r 2  A5 rr              LDA   var_entry_lo
0025D3r 2  05 rr              ORA   var_entry_hi
0025D5r 2  F0 44              BEQ   @not_found
0025D7r 2               
0025D7r 2                     ; Compare name in entry against var_name
0025D7r 2  20 rr rr           JSR   var_names_equal
0025DAr 2  B0 16              BCS   @found
0025DCr 2               
0025DCr 2                     ; Advance to next entry
0025DCr 2  A5 rr              LDA   var_entry_lo
0025DEr 2  85 rr              STA   ptr2_lo
0025E0r 2  A5 rr              LDA   var_entry_hi
0025E2r 2  85 rr              STA   ptr2_hi
0025E4r 2  A0 00              LDY   #VAR_NEXT_LO
0025E6r 2  B1 rr              LDA   (ptr2_lo),Y
0025E8r 2  AA                 TAX
0025E9r 2  C8                 INY
0025EAr 2  B1 rr              LDA   (ptr2_lo),Y
0025ECr 2  85 rr              STA   var_entry_hi
0025EEr 2  86 rr              STX   var_entry_lo
0025F0r 2  80 DF              BRA   @walk
0025F2r 2               
0025F2r 2               @found:
0025F2r 2                     ; Overwrite value in place
0025F2r 2                     ; Value starts at entry + 3 + name_len
0025F2r 2  A5 rr              LDA   var_entry_lo
0025F4r 2  85 rr              STA   ptr2_lo
0025F6r 2  A5 rr              LDA   var_entry_hi
0025F8r 2  85 rr              STA   ptr2_hi
0025FAr 2  A0 02              LDY   #VAR_NAME_LEN
0025FCr 2  B1 rr              LDA   (ptr2_lo),Y          ; name_len
0025FEr 2  18                 CLC
0025FFr 2  69 03              ADC   #VAR_NAME             ; A = 3 + name_len = offset to value_type
002601r 2  A8                 TAY
002602r 2  A5 rr              LDA   eval_type
002604r 2  91 rr              STA   (ptr2_lo),Y
002606r 2  C8                 INY
002607r 2  A5 rr              LDA   eval_val_hi
002609r 2  91 rr              STA   (ptr2_lo),Y
00260Br 2  C8                 INY
00260Cr 2  A5 rr              LDA   eval_val_lo
00260Er 2  91 rr              STA   (ptr2_lo),Y
002610r 2  C8                 INY
002611r 2  A5 rr              LDA   eval_val_frac
002613r 2  91 rr              STA   (ptr2_lo),Y
002615r 2  C8                 INY
002616r 2  A9 00              LDA   #0
002618r 2  91 rr              STA   (ptr2_lo),Y          ; pad
00261Ar 2  60                 RTS
00261Br 2               
00261Br 2               @not_found:
00261Br 2                     ; Allocate a new entry: 8 + name_len bytes
00261Br 2                     ; Read name_len from the name string
00261Br 2  A5 rr              LDA   var_name_lo
00261Dr 2  85 rr              STA   ptr_lo
00261Fr 2  A5 rr              LDA   var_name_hi
002621r 2  85 rr              STA   ptr_hi
002623r 2  A0 00              LDY   #0
002625r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002627r 2  48                 PHA                         ; save name_len
002628r 2  18                 CLC
002629r 2  69 08              ADC   #8                    ; total entry size
00262Br 2  A2 03              LDX   #ATYPE_VAR
00262Dr 2  20 rr rr           JSR   heap_alloc
002630r 2  B0 62              BCS   @oom
002632r 2               
002632r 2                     ; ptr_lo/hi now points to new entry
002632r 2                     ; Set next → current head
002632r 2  A0 00              LDY   #VAR_NEXT_LO
002634r 2  A5 rr              LDA   var_head_lo
002636r 2  91 rr              STA   (ptr_lo),Y
002638r 2  C8                 INY
002639r 2  A5 rr              LDA   var_head_hi
00263Br 2  91 rr              STA   (ptr_lo),Y
00263Dr 2               
00263Dr 2                     ; Copy name_len
00263Dr 2  68                 PLA                         ; A = name_len
00263Er 2  48                 PHA                         ; keep it on stack
00263Fr 2  A0 02              LDY   #VAR_NAME_LEN
002641r 2  91 rr              STA   (ptr_lo),Y
002643r 2               
002643r 2                     ; Copy name chars (uppercased) from var_name source
002643r 2  68                 PLA                         ; A = name_len
002644r 2  AA                 TAX                         ; X = remaining chars
002645r 2  F0 2C              BEQ   @name_done            ; zero-length name (shouldn't happen)
002647r 2  A0 03              LDY   #VAR_NAME             ; dest offset in entry
002649r 2  9C rr rr           STZ   num_tmp_lo            ; source offset counter
00264Cr 2               
00264Cr 2               @copy_name:
00264Cr 2  DA                 PHX
00264Dr 2  5A                 PHY
00264Er 2                     ; Read source char
00264Er 2  A5 rr              LDA   var_name_lo
002650r 2  85 rr              STA   ptr2_lo
002652r 2  A5 rr              LDA   var_name_hi
002654r 2  85 rr              STA   ptr2_hi
002656r 2  AD rr rr           LDA   num_tmp_lo
002659r 2  1A                 INC                         ; skip length byte → offset = idx + 1
00265Ar 2  A8                 TAY
00265Br 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
00265Dr 2                     ; Uppercase
00265Dr 2  C9 61              CMP   #'a'
00265Fr 2  90 07              BCC   @noup
002661r 2  C9 7B              CMP   #'z'+1
002663r 2  B0 03              BCS   @noup
002665r 2  38                 SEC
002666r 2  E9 20              SBC   #$20
002668r 2               @noup:
002668r 2  7A                 PLY                         ; restore dest offset
002669r 2  91 rr              STA   (ptr_lo),Y           ; write to entry
00266Br 2  C8                 INY
00266Cr 2  EE rr rr           INC   num_tmp_lo
00266Fr 2  FA                 PLX
002670r 2  CA                 DEX
002671r 2  D0 D9              BNE   @copy_name
002673r 2               
002673r 2               @name_done:
002673r 2                     ; Write value after name
002673r 2                     ; Y is already at VAR_NAME + name_len = value_type offset
002673r 2  A5 rr              LDA   eval_type
002675r 2  91 rr              STA   (ptr_lo),Y
002677r 2  C8                 INY
002678r 2  A5 rr              LDA   eval_val_hi
00267Ar 2  91 rr              STA   (ptr_lo),Y
00267Cr 2  C8                 INY
00267Dr 2  A5 rr              LDA   eval_val_lo
00267Fr 2  91 rr              STA   (ptr_lo),Y
002681r 2  C8                 INY
002682r 2  A5 rr              LDA   eval_val_frac
002684r 2  91 rr              STA   (ptr_lo),Y
002686r 2  C8                 INY
002687r 2  A9 00              LDA   #0
002689r 2  91 rr              STA   (ptr_lo),Y           ; pad
00268Br 2               
00268Br 2                     ; Prepend to list: head = new entry
00268Br 2  A5 rr              LDA   ptr_lo
00268Dr 2  85 rr              STA   var_head_lo
00268Fr 2  A5 rr              LDA   ptr_hi
002691r 2  85 rr              STA   var_head_hi
002693r 2  60                 RTS
002694r 2               
002694r 2               @oom:
002694r 2  68                 PLA                         ; discard saved name_len
002695r 2  60                 RTS
002696r 2               
002696r 2               ; ---------------------------------------------------------------------
002696r 2               ; var_get — look up a variable by name
002696r 2               ;   Input: ptr_lo/hi → length-prefixed name string
002696r 2               ;   Output: Carry clear = found, eval_type/eval_val set
002696r 2               ;           Carry set = not found
002696r 2               ;   Clobbers: A, X, Y, ptr2, var_entry, var_name
002696r 2               ; ---------------------------------------------------------------------
002696r 2               var_get:
002696r 2                     ; Save name pointer
002696r 2  A5 rr              LDA   ptr_lo
002698r 2  85 rr              STA   var_name_lo
00269Ar 2  A5 rr              LDA   ptr_hi
00269Cr 2  85 rr              STA   var_name_hi
00269Er 2               
00269Er 2                     ; Walk the list
00269Er 2  A5 rr              LDA   var_head_lo
0026A0r 2  85 rr              STA   var_entry_lo
0026A2r 2  A5 rr              LDA   var_head_hi
0026A4r 2  85 rr              STA   var_entry_hi
0026A6r 2               
0026A6r 2               @walk:
0026A6r 2  A5 rr              LDA   var_entry_lo
0026A8r 2  05 rr              ORA   var_entry_hi
0026AAr 2  F0 40              BEQ   @not_found
0026ACr 2               
0026ACr 2  20 rr rr           JSR   var_names_equal
0026AFr 2  B0 16              BCS   @found
0026B1r 2               
0026B1r 2                     ; Advance to next
0026B1r 2  A5 rr              LDA   var_entry_lo
0026B3r 2  85 rr              STA   ptr2_lo
0026B5r 2  A5 rr              LDA   var_entry_hi
0026B7r 2  85 rr              STA   ptr2_hi
0026B9r 2  A0 00              LDY   #VAR_NEXT_LO
0026BBr 2  B1 rr              LDA   (ptr2_lo),Y
0026BDr 2  AA                 TAX
0026BEr 2  C8                 INY
0026BFr 2  B1 rr              LDA   (ptr2_lo),Y
0026C1r 2  85 rr              STA   var_entry_hi
0026C3r 2  86 rr              STX   var_entry_lo
0026C5r 2  80 DF              BRA   @walk
0026C7r 2               
0026C7r 2               @found:
0026C7r 2                     ; Read value from entry + 3 + name_len
0026C7r 2  A5 rr              LDA   var_entry_lo
0026C9r 2  85 rr              STA   ptr2_lo
0026CBr 2  A5 rr              LDA   var_entry_hi
0026CDr 2  85 rr              STA   ptr2_hi
0026CFr 2  A0 02              LDY   #VAR_NAME_LEN
0026D1r 2  B1 rr              LDA   (ptr2_lo),Y
0026D3r 2  18                 CLC
0026D4r 2  69 03              ADC   #VAR_NAME
0026D6r 2  A8                 TAY
0026D7r 2  B1 rr              LDA   (ptr2_lo),Y          ; value_type
0026D9r 2  85 rr              STA   eval_type
0026DBr 2  C8                 INY
0026DCr 2  B1 rr              LDA   (ptr2_lo),Y          ; val_hi
0026DEr 2  85 rr              STA   eval_val_hi
0026E0r 2  C8                 INY
0026E1r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_lo
0026E3r 2  85 rr              STA   eval_val_lo
0026E5r 2  C8                 INY
0026E6r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_frac
0026E8r 2  85 rr              STA   eval_val_frac
0026EAr 2  18                 CLC
0026EBr 2  60                 RTS
0026ECr 2               
0026ECr 2               @not_found:
0026ECr 2  38                 SEC
0026EDr 2  60                 RTS
0026EEr 2               
0026EEr 2               ; ---------------------------------------------------------------------
0026EEr 2               ; var_names_equal — compare name at var_name_lo/hi against entry at var_entry
0026EEr 2               ;   The name source is length-prefixed (from token / quote).
0026EEr 2               ;   The entry stores: name_len at +2, chars at +3 (already uppercased).
0026EEr 2               ;   The source name chars are uppercased during comparison.
0026EEr 2               ;   Returns: Carry set = equal, Carry clear = not equal
0026EEr 2               ;   Clobbers: A, X, Y, ptr2
0026EEr 2               ; ---------------------------------------------------------------------
0026EEr 2               var_names_equal:
0026EEr 2                     ; Read source name length
0026EEr 2  A5 rr              LDA   var_name_lo
0026F0r 2  85 rr              STA   ptr2_lo
0026F2r 2  A5 rr              LDA   var_name_hi
0026F4r 2  85 rr              STA   ptr2_hi
0026F6r 2  A0 00              LDY   #0
0026F8r 2  B1 rr              LDA   (ptr2_lo),Y          ; source name_len
0026FAr 2  AA                 TAX                         ; X = source name_len
0026FBr 2               
0026FBr 2                     ; Read entry name length
0026FBr 2  A5 rr              LDA   var_entry_lo
0026FDr 2  85 rr              STA   ptr2_lo
0026FFr 2  A5 rr              LDA   var_entry_hi
002701r 2  85 rr              STA   ptr2_hi
002703r 2  A0 02              LDY   #VAR_NAME_LEN
002705r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry name_len
002707r 2               
002707r 2                     ; Compare lengths
002707r 2  8E rr rr           STX   num_tmp_lo            ; save source length
00270Ar 2  CD rr rr           CMP   num_tmp_lo
00270Dr 2  D0 43              BNE   @ne
00270Fr 2               
00270Fr 2                     ; Lengths match — compare chars
00270Fr 2  E0 00              CPX   #0
002711r 2  F0 3B              BEQ   @eq                   ; both zero-length — equal
002713r 2  A0 00              LDY   #0                    ; char index
002715r 2               
002715r 2               @cmp_loop:
002715r 2  DA                 PHX
002716r 2  5A                 PHY
002717r 2                     ; Read source char (var_name + 1 + Y)
002717r 2  A5 rr              LDA   var_name_lo
002719r 2  85 rr              STA   ptr2_lo
00271Br 2  A5 rr              LDA   var_name_hi
00271Dr 2  85 rr              STA   ptr2_hi
00271Fr 2  98                 TYA
002720r 2  1A                 INC                         ; skip length byte
002721r 2  A8                 TAY
002722r 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
002724r 2                     ; Uppercase it
002724r 2  C9 61              CMP   #'a'
002726r 2  90 07              BCC   @noup
002728r 2  C9 7B              CMP   #'z'+1
00272Ar 2  B0 03              BCS   @noup
00272Cr 2  38                 SEC
00272Dr 2  E9 20              SBC   #$20
00272Fr 2               @noup:
00272Fr 2  8D rr rr           STA   num_tmp_hi            ; temp: uppercased source char
002732r 2               
002732r 2                     ; Read entry char (var_entry + VAR_NAME + Y)
002732r 2  7A                 PLY                         ; restore char index
002733r 2  5A                 PHY
002734r 2  A5 rr              LDA   var_entry_lo
002736r 2  85 rr              STA   ptr2_lo
002738r 2  A5 rr              LDA   var_entry_hi
00273Ar 2  85 rr              STA   ptr2_hi
00273Cr 2  98                 TYA
00273Dr 2  18                 CLC
00273Er 2  69 03              ADC   #VAR_NAME
002740r 2  A8                 TAY
002741r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry char (already uppercase)
002743r 2               
002743r 2  CD rr rr           CMP   num_tmp_hi
002746r 2                     ; 65C02: PLY/PLX clobber flags! Must branch BEFORE pulling.
002746r 2  D0 08              BNE   @ne_pull
002748r 2               
002748r 2  7A                 PLY
002749r 2  FA                 PLX
00274Ar 2  C8                 INY
00274Br 2  CA                 DEX
00274Cr 2  D0 C7              BNE   @cmp_loop
00274Er 2               
00274Er 2               @eq:
00274Er 2  38                 SEC                         ; equal
00274Fr 2  60                 RTS
002750r 2               
002750r 2               @ne_pull:
002750r 2  7A                 PLY                         ; clean up stack
002751r 2  FA                 PLX
002752r 2               @ne:
002752r 2  18                 CLC                         ; not equal
002753r 2  60                 RTS
002754r 2               
002754r 1                     .include "procedures.s"
002754r 2               ; procedures.s — user-defined procedure storage and invocation
002754r 2               ;
002754r 2               ; Procedure record layout (heap-allocated linked list):
002754r 2               ;   +0: next_lo
002754r 2               ;   +1: next_hi    (pointer to next procedure, or $0000)
002754r 2               ;   +2: name_len   (1 byte)
002754r 2               ;   +3..3+NL-1: name chars (uppercased)
002754r 2               ;   +3+NL: param_count (1 byte)
002754r 2               ;   For each param:
002754r 2               ;     1 byte: param_name_len
002754r 2               ;     N bytes: param_name chars (uppercased)
002754r 2               ;   After all params:
002754r 2               ;     2 bytes: body_len_lo, body_len_hi (16-bit)
002754r 2               ;     body_len bytes: body text (lines separated by $0A)
002754r 2               
002754r 2               ; =====================================================================
002754r 2               ; ZEROPAGE segment — procedure variables
002754r 2               ; =====================================================================
002754r 2                     .segment "ZEROPAGE"
00003Dr 2               
00003Dr 2  xx           proc_head_lo:     .res 1        ; head of procedure directory
00003Er 2  xx           proc_head_hi:     .res 1
00003Fr 2  xx           proc_entry_lo:    .res 1        ; current entry pointer (walk scratch)
000040r 2  xx           proc_entry_hi:    .res 1
000041r 2  xx           proc_ptr_lo:      .res 1        ; scratch pointer for proc operations
000042r 2  xx           proc_ptr_hi:      .res 1
000043r 2  xx           proc_body_len_lo: .res 1        ; body length during collection / invocation
000044r 2  xx           proc_body_len_hi: .res 1
000045r 2  xx           proc_param_cnt:   .res 1        ; param count during define / invoke
000046r 2  xx           proc_name_len:    .res 1        ; name length scratch
000047r 2  xx           proc_rec_off:     .res 1        ; offset into record during invoke
000048r 2               
000048r 2               ; =====================================================================
000048r 2               ; BSS segment — temporary buffers
000048r 2               ; =====================================================================
000048r 2                     .segment "BSS"
00000Fr 2               
00000Fr 2  xx xx xx xx  proc_body_buf:    .res 2048     ; editor text buffer: "TO ..\n<body>\nEND\n"
000013r 2  xx xx xx xx  
000017r 2  xx xx xx xx  
00080Fr 2  xx xx xx xx  proc_name_buf:    .res 32       ; procedure name: length-prefixed
000813r 2  xx xx xx xx  
000817r 2  xx xx xx xx  
00082Fr 2  xx xx xx xx  proc_param_buf:   .res 128      ; packed: count, [len,chars]... each param
000833r 2  xx xx xx xx  
000837r 2  xx xx xx xx  
0008AFr 2  xx           proc_param_end:   .res 1        ; write offset into proc_param_buf
0008B0r 2  xx xx xx xx  proc_editor_title:.res 36       ; "TO <name>" + NUL, passed to the shared editor
0008B4r 2  xx xx xx xx  
0008B8r 2  xx xx xx xx  
0008D4r 2  xx           proc_body_src_lo: .res 1        ; pointer to the body text proc_build_record copies
0008D5r 2  xx           proc_body_src_hi: .res 1
0008D6r 2  xx           proc_edit_cur_lo: .res 1        ; initial editor cursor offset (start of body line)
0008D7r 2  xx           proc_edit_cur_hi: .res 1
0008D8r 2  xx           proc_scan_off_lo: .res 1        ; 16-bit scan offset for body extraction
0008D9r 2  xx           proc_scan_off_hi: .res 1
0008DAr 2  xx           proc_brk_depth:   .res 1        ; bracket/paren nesting depth while accumulating a statement
0008DBr 2  xx           proc_tmp:         .res 1        ; scratch byte (EDIT record→buffer copy)
0008DCr 2               
0008DCr 2               ; Save area for eval state during procedure invocation
0008DCr 2  xx           save_eval_cur_lo: .res 1
0008DDr 2  xx           save_eval_cur_hi: .res 1
0008DEr 2  xx           save_tok_head_lo: .res 1
0008DFr 2  xx           save_tok_head_hi: .res 1
0008E0r 2  xx           save_tok_tail_lo: .res 1
0008E1r 2  xx           save_tok_tail_hi: .res 1
0008E2r 2  xx xx xx xx  save_input_buf:   .res 128      ; save outer input_buf during proc body exec
0008E6r 2  xx xx xx xx  
0008EAr 2  xx xx xx xx  
000962r 2  xx           save_heap_ptr_lo: .res 1        ; save heap for token re-use
000963r 2  xx           save_heap_ptr_hi: .res 1
000964r 2               
000964r 2               ; Param-binding scratch: length-prefixed name built here for var_set
000964r 2  xx xx xx xx  param_name_tmp:   .res 32
000968r 2  xx xx xx xx  
00096Cr 2  xx xx xx xx  
000984r 2               
000984r 2               ; =====================================================================
000984r 2               ; CODE segment — procedure routines
000984r 2               ; =====================================================================
000984r 2                     .segment "CODE"
002754r 2               
002754r 2               ; ---------------------------------------------------------------------
002754r 2               ; proc_init — initialize procedure directory to empty
002754r 2               ; ---------------------------------------------------------------------
002754r 2               proc_init:
002754r 2  64 rr              STZ   proc_head_lo
002756r 2  64 rr              STZ   proc_head_hi
002758r 2  64 rr              STZ   proc_stopped
00275Ar 2  60                 RTS
00275Br 2               
00275Br 2               ; ---------------------------------------------------------------------
00275Br 2               ; proc_collect — enter TO/END multi-line collection mode
00275Br 2               ;   Called from main_loop after detecting TO as first token.
00275Br 2               ;   eval_cur_lo/hi has been advanced past the TO token.
00275Br 2               ; ---------------------------------------------------------------------
00275Br 2               proc_collect:
00275Br 2                     ; Next token should be the procedure name (TOK_WORD)
00275Br 2  A5 rr              LDA   eval_cur_lo
00275Dr 2  05 rr              ORA   eval_cur_hi
00275Fr 2  D0 03              BNE   @have_name
002761r 2  4C rr rr           JMP   @err_noname
002764r 2               @have_name:
002764r 2  A5 rr              LDA   eval_cur_lo
002766r 2  85 rr              STA   ptr_lo
002768r 2  A5 rr              LDA   eval_cur_hi
00276Ar 2  85 rr              STA   ptr_hi
00276Cr 2  A0 00              LDY   #TOK_TAG
00276Er 2  B1 rr              LDA   (ptr_lo),Y
002770r 2  C9 01              CMP   #TOK_WORD
002772r 2  F0 03              BEQ   @name_ok
002774r 2  4C rr rr           JMP   @err_noname
002777r 2               @name_ok:
002777r 2                     ; Copy procedure name to proc_name_buf (length-prefixed)
002777r 2  A0 03              LDY   #TOK_PAYLOAD
002779r 2  B1 rr              LDA   (ptr_lo),Y           ; name length
00277Br 2  8D rr rr           STA   proc_name_buf
00277Er 2  85 rr              STA   proc_name_len
002780r 2  AA                 TAX                         ; X = char count
002781r 2  A0 04              LDY   #TOK_PAYLOAD+1
002783r 2  A9 00              LDA   #0
002785r 2  85 rr              STA   proc_rec_off          ; dest index in name_buf
002787r 2               @copy_name:
002787r 2  E0 00              CPX   #0
002789r 2  F0 0F              BEQ   @name_copied
00278Br 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased by tokenizer
00278Dr 2  5A                 PHY
00278Er 2  A4 rr              LDY   proc_rec_off
002790r 2  99 rr rr           STA   proc_name_buf+1,Y
002793r 2  E6 rr              INC   proc_rec_off
002795r 2  7A                 PLY
002796r 2  C8                 INY
002797r 2  CA                 DEX
002798r 2  80 ED              BRA   @copy_name
00279Ar 2               @name_copied:
00279Ar 2               
00279Ar 2                     ; Advance past the name token
00279Ar 2  20 rr rr           JSR   eval_advance
00279Dr 2               
00279Dr 2                     ; Parse parameter names (TOK_VARREF tokens: :SIZE :COLOR etc.)
00279Dr 2  64 rr              STZ   proc_param_cnt
00279Fr 2  A9 01              LDA   #1                    ; dest offset (skip count byte at [0])
0027A1r 2  8D rr rr           STA   proc_param_end
0027A4r 2               
0027A4r 2               @parse_params:
0027A4r 2  A5 rr              LDA   eval_cur_lo
0027A6r 2  05 rr              ORA   eval_cur_hi
0027A8r 2  F0 47              BEQ   @params_done
0027AAr 2  A5 rr              LDA   eval_cur_lo
0027ACr 2  85 rr              STA   ptr_lo
0027AEr 2  A5 rr              LDA   eval_cur_hi
0027B0r 2  85 rr              STA   ptr_hi
0027B2r 2  A0 00              LDY   #TOK_TAG
0027B4r 2  B1 rr              LDA   (ptr_lo),Y
0027B6r 2  C9 05              CMP   #TOK_VARREF
0027B8r 2  D0 37              BNE   @params_done
0027BAr 2               
0027BAr 2  E6 rr              INC   proc_param_cnt
0027BCr 2  A0 03              LDY   #TOK_PAYLOAD
0027BEr 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
0027C0r 2  AE rr rr           LDX   proc_param_end
0027C3r 2  9D rr rr           STA   proc_param_buf,X     ; store length
0027C6r 2  E8                 INX
0027C7r 2  A8                 TAY                         ; Y = char count to copy
0027C8r 2  64 rr              STZ   proc_rec_off          ; source char index
0027CAr 2               
0027CAr 2               @copy_param_ch:
0027CAr 2  C0 00              CPY   #0
0027CCr 2  F0 1B              BEQ   @param_ch_done
0027CEr 2                     ; Read source char from token
0027CEr 2  A5 rr              LDA   eval_cur_lo
0027D0r 2  85 rr              STA   ptr_lo
0027D2r 2  A5 rr              LDA   eval_cur_hi
0027D4r 2  85 rr              STA   ptr_hi
0027D6r 2  5A                 PHY
0027D7r 2  A5 rr              LDA   proc_rec_off
0027D9r 2  18                 CLC
0027DAr 2  69 04              ADC   #TOK_PAYLOAD+1
0027DCr 2  A8                 TAY
0027DDr 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased
0027DFr 2  7A                 PLY
0027E0r 2                     ; Write to proc_param_buf
0027E0r 2  9D rr rr           STA   proc_param_buf,X
0027E3r 2  E8                 INX
0027E4r 2  E6 rr              INC   proc_rec_off
0027E6r 2  88                 DEY
0027E7r 2  80 E1              BRA   @copy_param_ch
0027E9r 2               @param_ch_done:
0027E9r 2  8E rr rr           STX   proc_param_end
0027ECr 2               
0027ECr 2  20 rr rr           JSR   eval_advance
0027EFr 2  80 B3              BRA   @parse_params
0027F1r 2               
0027F1r 2               @params_done:
0027F1r 2  A5 rr              LDA   proc_param_cnt
0027F3r 2  8D rr rr           STA   proc_param_buf        ; count byte at [0]
0027F6r 2               
0027F6r 2                     ; Initialize body buffer
0027F6r 2  64 rr              STZ   proc_body_len_lo
0027F8r 2  64 rr              STZ   proc_body_len_hi
0027FAr 2               
0027FAr 2                     ; Open the shared EDITUI editor on an empty body buffer. Carry set means
0027FAr 2                     ; the user asked to save (Ctrl-S / "Save First") before exiting.
0027FAr 2  20 rr rr           JSR   proc_open_editor
0027FDr 2  B0 01              BCS   @body_done
0027FFr 2  60                 RTS
002800r 2               
002800r 2                     ; Print "NAME DEFINED\n"
002800r 2               @body_done:
002800r 2  20 rr rr           JSR   proc_print_defined
002803r 2  60                 RTS
002804r 2               
002804r 2               @err_noname:
002804r 2  20 rr rr           JSR   print_inl
002807r 2  54 4F 20 4E        .byte "TO NEEDS A NAME", 0
00280Br 2  45 45 44 53  
00280Fr 2  20 41 20 4E  
002817r 2  20 rr rr           JSR   eval_newline
00281Ar 2  60                 RTS
00281Br 2               
00281Br 2               ; ---------------------------------------------------------------------
00281Br 2               ; proc_print_defined — print "<name> DEFINED\n" (name from proc_name_buf).
00281Br 2               ; ---------------------------------------------------------------------
00281Br 2               proc_print_defined:
00281Br 2  A6 rr              LDX   proc_name_len
00281Dr 2  A0 00              LDY   #0
00281Fr 2               @pn:
00281Fr 2  E0 00              CPX   #0
002821r 2  F0 0A              BEQ   @pd
002823r 2  B9 rr rr           LDA   proc_name_buf+1,Y
002826r 2  8D 0E A0           STA   VGC_CHAROUT
002829r 2  C8                 INY
00282Ar 2  CA                 DEX
00282Br 2  80 F2              BRA   @pn
00282Dr 2               @pd:
00282Dr 2  20 rr rr           JSR   print_inl
002830r 2  20 44 45 46        .byte " DEFINED", 0
002834r 2  49 4E 45 44  
002838r 2  00           
002839r 2  20 rr rr           JSR   eval_newline
00283Cr 2  60                 RTS
00283Dr 2               
00283Dr 2               ; ---------------------------------------------------------------------
00283Dr 2               ; proc_build_header — write the "TO <name> :params" first line into
00283Dr 2               ;   proc_body_buf (no trailing newline). Built with 8-bit Y since the header
00283Dr 2               ;   is always < 256 bytes (name<=31, params<=127). Returns Y = header length.
00283Dr 2               ;   Inputs: proc_name_buf/proc_name_len, proc_param_buf/proc_param_end.
00283Dr 2               ; ---------------------------------------------------------------------
00283Dr 2               proc_build_header:
00283Dr 2  A0 00              LDY   #0
00283Fr 2  A9 54              LDA   #'T'
002841r 2  99 rr rr           STA   proc_body_buf,Y
002844r 2  C8                 INY
002845r 2  A9 4F              LDA   #'O'
002847r 2  99 rr rr           STA   proc_body_buf,Y
00284Ar 2  C8                 INY
00284Br 2  A9 20              LDA   #' '
00284Dr 2  99 rr rr           STA   proc_body_buf,Y
002850r 2  C8                 INY
002851r 2  A2 00              LDX   #0                     ; name source index
002853r 2               @nm:
002853r 2  E4 rr              CPX   proc_name_len
002855r 2  B0 0A              BCS   @nm_done
002857r 2  BD rr rr           LDA   proc_name_buf+1,X
00285Ar 2  99 rr rr           STA   proc_body_buf,Y
00285Dr 2  C8                 INY
00285Er 2  E8                 INX
00285Fr 2  80 F2              BRA   @nm
002861r 2               @nm_done:
002861r 2                     ; params: " :" + chars, walking proc_param_buf[1..proc_param_end)
002861r 2  A2 01              LDX   #1
002863r 2               @pp:
002863r 2  EC rr rr           CPX   proc_param_end
002866r 2  B0 22              BCS   @pp_done
002868r 2  A9 20              LDA   #' '
00286Ar 2  99 rr rr           STA   proc_body_buf,Y
00286Dr 2  C8                 INY
00286Er 2  A9 3A              LDA   #':'
002870r 2  99 rr rr           STA   proc_body_buf,Y
002873r 2  C8                 INY
002874r 2  BD rr rr           LDA   proc_param_buf,X       ; this param's char count
002877r 2  85 rr              STA   proc_rec_off
002879r 2  E8                 INX
00287Ar 2               @ppc:
00287Ar 2  A5 rr              LDA   proc_rec_off
00287Cr 2  F0 E5              BEQ   @pp
00287Er 2  BD rr rr           LDA   proc_param_buf,X
002881r 2  99 rr rr           STA   proc_body_buf,Y
002884r 2  C8                 INY
002885r 2  E8                 INX
002886r 2  C6 rr              DEC   proc_rec_off
002888r 2  80 F0              BRA   @ppc
00288Ar 2               @pp_done:
00288Ar 2  60                 RTS
00288Br 2               
00288Br 2               proc_open_editor:
00288Br 2                     ; build "TO <name> :params" header, then append an empty body "  ".
00288Br 2  20 rr rr           JSR   proc_build_header
00288Er 2                     ; Y = line-1 length. The body line is line 1's '\n' + 2 indent spaces,
00288Er 2                     ; so the cursor lands at offset (line1 + 3).
00288Er 2  98                 TYA
00288Fr 2  18                 CLC
002890r 2  69 03              ADC   #3
002892r 2  8D rr rr           STA   proc_edit_cur_lo
002895r 2  A9 00              LDA   #0
002897r 2  69 00              ADC   #0
002899r 2  8D rr rr           STA   proc_edit_cur_hi
00289Cr 2                     ; append "\n  \nEND\n"
00289Cr 2  A9 0A              LDA   #$0A
00289Er 2  99 rr rr           STA   proc_body_buf,Y
0028A1r 2  C8                 INY
0028A2r 2  A9 20              LDA   #' '
0028A4r 2  99 rr rr           STA   proc_body_buf,Y
0028A7r 2  C8                 INY
0028A8r 2  99 rr rr           STA   proc_body_buf,Y
0028ABr 2  C8                 INY
0028ACr 2  A9 0A              LDA   #$0A
0028AEr 2  99 rr rr           STA   proc_body_buf,Y
0028B1r 2  C8                 INY
0028B2r 2  A9 45              LDA   #'E'
0028B4r 2  99 rr rr           STA   proc_body_buf,Y
0028B7r 2  C8                 INY
0028B8r 2  A9 4E              LDA   #'N'
0028BAr 2  99 rr rr           STA   proc_body_buf,Y
0028BDr 2  C8                 INY
0028BEr 2  A9 44              LDA   #'D'
0028C0r 2  99 rr rr           STA   proc_body_buf,Y
0028C3r 2  C8                 INY
0028C4r 2  A9 0A              LDA   #$0A
0028C6r 2  99 rr rr           STA   proc_body_buf,Y
0028C9r 2  C8                 INY
0028CAr 2  84 rr              STY   proc_body_len_lo
0028CCr 2  64 rr              STZ   proc_body_len_hi
0028CEr 2               
0028CEr 2               ; ---------------------------------------------------------------------
0028CEr 2               ; proc_edit_run — shared tail: build the editor title, hand proc_body_buf
0028CEr 2               ;   (with proc_body_len + proc_edit_cur already set) to the EDITUI editor, and
0028CEr 2               ;   on save extract the body + (re)build the procedure record.
0028CEr 2               ;   Returns: carry set = saved, carry clear = abandoned.
0028CEr 2               ; ---------------------------------------------------------------------
0028CEr 2               proc_edit_run:
0028CEr 2                     ; --- title "TO <name>" + NUL for the editor's title band ---
0028CEr 2  A9 54              LDA   #'T'
0028D0r 2  8D rr rr           STA   proc_editor_title+0
0028D3r 2  A9 4F              LDA   #'O'
0028D5r 2  8D rr rr           STA   proc_editor_title+1
0028D8r 2  A9 20              LDA   #' '
0028DAr 2  8D rr rr           STA   proc_editor_title+2
0028DDr 2  A2 00              LDX   #0
0028DFr 2  A0 03              LDY   #3
0028E1r 2               @tt:
0028E1r 2  E4 rr              CPX   proc_name_len
0028E3r 2  B0 0A              BCS   @tt_done
0028E5r 2  BD rr rr           LDA   proc_name_buf+1,X
0028E8r 2  99 rr rr           STA   proc_editor_title,Y
0028EBr 2  E8                 INX
0028ECr 2  C8                 INY
0028EDr 2  80 F2              BRA   @tt
0028EFr 2               @tt_done:
0028EFr 2  A9 00              LDA   #0
0028F1r 2  99 rr rr           STA   proc_editor_title,Y
0028F4r 2               
0028F4r 2                     ; --- mailbox: ARG0=buf ARG1=len ARG2=cap ARG3=title; cursor in FRAC bytes
0028F4r 2  A9 rr              LDA   #<proc_body_buf
0028F6r 2  85 84              STA   EXT_ARG0_LO
0028F8r 2  A9 rr              LDA   #>proc_body_buf
0028FAr 2  85 83              STA   EXT_ARG0_HI
0028FCr 2  A5 rr              LDA   proc_body_len_lo
0028FEr 2  85 88              STA   EXT_ARG1_LO
002900r 2  A5 rr              LDA   proc_body_len_hi
002902r 2  85 87              STA   EXT_ARG1_HI
002904r 2  A9 00              LDA   #<2048
002906r 2  85 8C              STA   EXT_ARG2_LO
002908r 2  A9 08              LDA   #>2048
00290Ar 2  85 8B              STA   EXT_ARG2_HI
00290Cr 2  A9 rr              LDA   #<proc_editor_title
00290Er 2  85 A1              STA   EXT_ARG3_LO
002910r 2  A9 rr              LDA   #>proc_editor_title
002912r 2  85 A0              STA   EXT_ARG3_HI
002914r 2  AD rr rr           LDA   proc_edit_cur_lo
002917r 2  85 8D              STA   EXT_ARG2_FRAC          ; initial cursor offset (see ext_iface.inc)
002919r 2  AD rr rr           LDA   proc_edit_cur_hi
00291Cr 2  85 A2              STA   EXT_ARG3_FRAC
00291Er 2               
00291Er 2  A9 4B              LDA   #EXT_CMD_EDIT
002920r 2  85 80              STA   EXT_CMD
002922r 2  20 rr rr           JSR   ensure_ext_resident    ; re-page host ext into bank 1 if a module clobbered it
002925r 2  20 70 02           JSR   EXT_TRAMPOLINE         ; swap to ext ROM, run editor, swap back
002928r 2               
002928r 2                     ; editor returns the final buffer length in ARG1
002928r 2  A5 88              LDA   EXT_ARG1_LO
00292Ar 2  85 rr              STA   proc_body_len_lo
00292Cr 2  A5 87              LDA   EXT_ARG1_HI
00292Er 2  85 rr              STA   proc_body_len_hi
002930r 2               
002930r 2  A5 8F              LDA   EXT_RESULT_HI
002932r 2  F0 08              BEQ   @abandoned
002934r 2                     ; Strip line 1 + the END line -> proc_body_src/proc_body_len = body only.
002934r 2  20 rr rr           JSR   proc_extract_body
002937r 2  20 rr rr           JSR   proc_build_record
00293Ar 2  38                 SEC
00293Br 2  60                 RTS
00293Cr 2               @abandoned:
00293Cr 2  18                 CLC
00293Dr 2  60                 RTS
00293Er 2               
00293Er 2               ; ---------------------------------------------------------------------
00293Er 2               ; proc_buf_put — append A to proc_body_buf at ptr2, advancing ptr2 and the
00293Er 2               ;   16-bit proc_body_len counter. Preserves A; clobbers Y.
00293Er 2               ; ---------------------------------------------------------------------
00293Er 2               proc_buf_put:
00293Er 2  A0 00              LDY   #0
002940r 2  91 rr              STA   (ptr2_lo),Y
002942r 2  E6 rr              INC   ptr2_lo
002944r 2  D0 02              BNE   :+
002946r 2  E6 rr              INC   ptr2_hi
002948r 2  E6 rr        :     INC   proc_body_len_lo
00294Ar 2  D0 02              BNE   :+
00294Cr 2  E6 rr              INC   proc_body_len_hi
00294Er 2  60           :     RTS
00294Fr 2               
00294Fr 2               ; ---------------------------------------------------------------------
00294Fr 2               ; proc_record_to_buffers — unpack the procedure record at proc_entry into the
00294Fr 2               ;   collect buffers so it can be edited and rebuilt:
00294Fr 2               ;     proc_name_buf/proc_name_len, proc_param_buf/proc_param_cnt/proc_param_end,
00294Fr 2               ;     and proc_body_src/proc_body_len = the record's body text (ptr + length).
00294Fr 2               ;   The name+param region is < 256 bytes so 8-bit Y indexing is safe there.
00294Fr 2               ; ---------------------------------------------------------------------
00294Fr 2               proc_record_to_buffers:
00294Fr 2  A5 rr              LDA   proc_entry_lo
002951r 2  85 rr              STA   ptr_lo
002953r 2  A5 rr              LDA   proc_entry_hi
002955r 2  85 rr              STA   ptr_hi
002957r 2                     ; --- name (record +2 = len, +3.. = chars) ---
002957r 2  A0 02              LDY   #2
002959r 2  B1 rr              LDA   (ptr_lo),Y
00295Br 2  8D rr rr           STA   proc_name_buf
00295Er 2  85 rr              STA   proc_name_len
002960r 2  C8                 INY                         ; Y=3 -> first name char
002961r 2  A2 00              LDX   #0
002963r 2               @rb_nm:
002963r 2  E4 rr              CPX   proc_name_len
002965r 2  B0 09              BCS   @rb_nm_done
002967r 2  B1 rr              LDA   (ptr_lo),Y
002969r 2  9D rr rr           STA   proc_name_buf+1,X
00296Cr 2  C8                 INY
00296Dr 2  E8                 INX
00296Er 2  80 F3              BRA   @rb_nm
002970r 2               @rb_nm_done:
002970r 2                     ; --- param_count then packed params ---
002970r 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002972r 2  85 rr              STA   proc_param_cnt
002974r 2  8D rr rr           STA   proc_param_buf        ; [0] = count
002977r 2  8D rr rr           STA   proc_tmp              ; remaining params
00297Ar 2  C8                 INY                         ; Y -> first param len
00297Br 2  A2 01              LDX   #1                    ; dest index into proc_param_buf
00297Dr 2               @rb_param:
00297Dr 2  AD rr rr           LDA   proc_tmp
002980r 2  F0 1B              BEQ   @rb_params_done
002982r 2  CE rr rr           DEC   proc_tmp
002985r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002987r 2  9D rr rr           STA   proc_param_buf,X
00298Ar 2  85 rr              STA   proc_rec_off          ; char counter
00298Cr 2  C8                 INY
00298Dr 2  E8                 INX
00298Er 2               @rb_pchars:
00298Er 2  A5 rr              LDA   proc_rec_off
002990r 2  F0 EB              BEQ   @rb_param
002992r 2  C6 rr              DEC   proc_rec_off
002994r 2  B1 rr              LDA   (ptr_lo),Y
002996r 2  9D rr rr           STA   proc_param_buf,X
002999r 2  C8                 INY
00299Ar 2  E8                 INX
00299Br 2  80 F1              BRA   @rb_pchars
00299Dr 2               @rb_params_done:
00299Dr 2  8E rr rr           STX   proc_param_end
0029A0r 2                     ; Y -> body_len_lo within the record. Compute absolute pointer.
0029A0r 2  98                 TYA
0029A1r 2  18                 CLC
0029A2r 2  65 rr              ADC   proc_entry_lo
0029A4r 2  85 rr              STA   ptr_lo
0029A6r 2  A5 rr              LDA   proc_entry_hi
0029A8r 2  69 00              ADC   #0
0029AAr 2  85 rr              STA   ptr_hi               ; ptr -> body_len_lo
0029ACr 2  A0 00              LDY   #0
0029AEr 2  B1 rr              LDA   (ptr_lo),Y
0029B0r 2  85 rr              STA   proc_body_len_lo     ; record body length
0029B2r 2  C8                 INY
0029B3r 2  B1 rr              LDA   (ptr_lo),Y
0029B5r 2  85 rr              STA   proc_body_len_hi
0029B7r 2  18                 CLC                         ; body src = ptr + 2
0029B8r 2  A5 rr              LDA   ptr_lo
0029BAr 2  69 02              ADC   #2
0029BCr 2  8D rr rr           STA   proc_body_src_lo
0029BFr 2  A5 rr              LDA   ptr_hi
0029C1r 2  69 00              ADC   #0
0029C3r 2  8D rr rr           STA   proc_body_src_hi
0029C6r 2  60                 RTS
0029C7r 2               
0029C7r 2               ; ---------------------------------------------------------------------
0029C7r 2               ; proc_edit_reconstruct — build the full editable text "TO <name> :params\n
0029C7r 2               ;   <body>END\n" into proc_body_buf from the collect buffers + the record body
0029C7r 2               ;   (proc_body_src/proc_body_len set by proc_record_to_buffers). Sets
0029C7r 2               ;   proc_body_len = total buffer length and proc_edit_cur = start of the body.
0029C7r 2               ; ---------------------------------------------------------------------
0029C7r 2               proc_edit_reconstruct:
0029C7r 2                     ; Save the record body src/len before proc_body_len is repurposed.
0029C7r 2  AD rr rr           LDA   proc_body_src_lo
0029CAr 2  85 rr              STA   proc_ptr_lo
0029CCr 2  AD rr rr           LDA   proc_body_src_hi
0029CFr 2  85 rr              STA   proc_ptr_hi
0029D1r 2  A5 rr              LDA   proc_body_len_lo
0029D3r 2  8D rr rr           STA   num_tmp_lo
0029D6r 2  A5 rr              LDA   proc_body_len_hi
0029D8r 2  8D rr rr           STA   num_tmp_hi
0029DBr 2                     ; Header "TO name params" (8-bit), then a newline.
0029DBr 2  20 rr rr           JSR   proc_build_header     ; Y = header length
0029DEr 2  A9 0A              LDA   #$0A
0029E0r 2  99 rr rr           STA   proc_body_buf,Y
0029E3r 2  C8                 INY                         ; Y = body-line start offset
0029E4r 2  8C rr rr           STY   proc_edit_cur_lo
0029E7r 2  9C rr rr           STZ   proc_edit_cur_hi
0029EAr 2  84 rr              STY   proc_body_len_lo
0029ECr 2  64 rr              STZ   proc_body_len_hi
0029EEr 2                     ; dest pointer ptr2 = proc_body_buf + Y
0029EEr 2  98                 TYA
0029EFr 2  18                 CLC
0029F0r 2  69 rr              ADC   #<proc_body_buf
0029F2r 2  85 rr              STA   ptr2_lo
0029F4r 2  A9 rr              LDA   #>proc_body_buf
0029F6r 2  69 00              ADC   #0
0029F8r 2  85 rr              STA   ptr2_hi
0029FAr 2                     ; copy the record body (num_tmp bytes from proc_ptr)
0029FAr 2               @rc_body:
0029FAr 2  AD rr rr           LDA   num_tmp_lo
0029FDr 2  0D rr rr           ORA   num_tmp_hi
002A00r 2  F0 1A              BEQ   @rc_body_done
002A02r 2  A0 00              LDY   #0
002A04r 2  B1 rr              LDA   (proc_ptr_lo),Y
002A06r 2  20 rr rr           JSR   proc_buf_put
002A09r 2  E6 rr              INC   proc_ptr_lo
002A0Br 2  D0 02              BNE   :+
002A0Dr 2  E6 rr              INC   proc_ptr_hi
002A0Fr 2  AD rr rr     :     LDA   num_tmp_lo
002A12r 2  D0 03              BNE   @rc_dec
002A14r 2  CE rr rr           DEC   num_tmp_hi
002A17r 2               @rc_dec:
002A17r 2  CE rr rr           DEC   num_tmp_lo
002A1Ar 2  80 DE              BRA   @rc_body
002A1Cr 2               @rc_body_done:
002A1Cr 2                     ; append "END" + newline
002A1Cr 2  A9 45              LDA   #'E'
002A1Er 2  20 rr rr           JSR   proc_buf_put
002A21r 2  A9 4E              LDA   #'N'
002A23r 2  20 rr rr           JSR   proc_buf_put
002A26r 2  A9 44              LDA   #'D'
002A28r 2  20 rr rr           JSR   proc_buf_put
002A2Br 2  A9 0A              LDA   #$0A
002A2Dr 2  20 rr rr           JSR   proc_buf_put
002A30r 2  60                 RTS
002A31r 2               
002A31r 2               ; ---------------------------------------------------------------------
002A31r 2               ; proc_edit — handle "EDIT <name>" / "ED <name>". eval_cur is at the name
002A31r 2               ;   token. If the procedure exists, reopen it in the editor pre-filled with its
002A31r 2               ;   current definition; otherwise fall back to the TO collector (create it).
002A31r 2               ; ---------------------------------------------------------------------
002A31r 2               proc_edit:
002A31r 2  A5 rr              LDA   eval_cur_lo
002A33r 2  05 rr              ORA   eval_cur_hi
002A35r 2  F0 14              BEQ   @to_collect
002A37r 2  20 rr rr           JSR   proc_lookup
002A3Ar 2  B0 0F              BCS   @to_collect          ; unknown -> create via the TO collector
002A3Cr 2  20 rr rr           JSR   proc_record_to_buffers
002A3Fr 2  20 rr rr           JSR   proc_edit_reconstruct
002A42r 2  20 rr rr           JSR   proc_edit_run
002A45r 2  90 03              BCC   @done                ; abandoned
002A47r 2  20 rr rr           JSR   proc_print_defined
002A4Ar 2               @done:
002A4Ar 2  60                 RTS
002A4Br 2               @to_collect:
002A4Br 2  4C rr rr           JMP   proc_collect
002A4Er 2               
002A4Er 2               ; ---------------------------------------------------------------------
002A4Er 2               ; proc_extract_body — narrow proc_body_buf/proc_body_len down to just the body:
002A4Er 2               ;   everything after the first '\n' (line 1) up to (not including) the line that
002A4Er 2               ;   reads "END". Sets proc_body_src_lo/hi + proc_body_len_lo/hi.
002A4Er 2               ; ---------------------------------------------------------------------
002A4Er 2               proc_extract_body:
002A4Er 2  A9 rr              LDA   #<proc_body_buf
002A50r 2  85 rr              STA   proc_ptr_lo
002A52r 2  A9 rr              LDA   #>proc_body_buf
002A54r 2  85 rr              STA   proc_ptr_hi
002A56r 2  9C rr rr           STZ   proc_scan_off_lo
002A59r 2  9C rr rr           STZ   proc_scan_off_hi
002A5Cr 2               @find_nl:
002A5Cr 2  20 rr rr           JSR   proc_scan_at_end
002A5Fr 2  B0 4F              BCS   @whole                ; no newline -> whole buffer is the body
002A61r 2  A0 00              LDY   #0
002A63r 2  B1 rr              LDA   (proc_ptr_lo),Y
002A65r 2  20 rr rr           JSR   proc_scan_advance
002A68r 2  C9 0A              CMP   #$0A
002A6Ar 2  D0 F0              BNE   @find_nl
002A6Cr 2                     ; body starts here
002A6Cr 2  A5 rr              LDA   proc_ptr_lo
002A6Er 2  8D rr rr           STA   proc_body_src_lo
002A71r 2  A5 rr              LDA   proc_ptr_hi
002A73r 2  8D rr rr           STA   proc_body_src_hi
002A76r 2  AD rr rr           LDA   proc_scan_off_lo
002A79r 2  8D rr rr           STA   num_tmp_lo            ; body-start offset
002A7Cr 2  AD rr rr           LDA   proc_scan_off_hi
002A7Fr 2  8D rr rr           STA   num_tmp_hi
002A82r 2               @line:
002A82r 2  20 rr rr           JSR   proc_scan_at_end
002A85r 2  B0 17              BCS   @body_end             ; ran off the end -> body = rest
002A87r 2  20 rr rr           JSR   proc_line_is_end
002A8Ar 2  B0 12              BCS   @body_end             ; this line is "END" -> stop
002A8Cr 2               @skip:
002A8Cr 2  20 rr rr           JSR   proc_scan_at_end
002A8Fr 2  B0 0D              BCS   @body_end
002A91r 2  A0 00              LDY   #0
002A93r 2  B1 rr              LDA   (proc_ptr_lo),Y
002A95r 2  20 rr rr           JSR   proc_scan_advance
002A98r 2  C9 0A              CMP   #$0A
002A9Ar 2  D0 F0              BNE   @skip
002A9Cr 2  80 E4              BRA   @line
002A9Er 2               @body_end:
002A9Er 2  38                 SEC
002A9Fr 2  AD rr rr           LDA   proc_scan_off_lo
002AA2r 2  ED rr rr           SBC   num_tmp_lo
002AA5r 2  85 rr              STA   proc_body_len_lo
002AA7r 2  AD rr rr           LDA   proc_scan_off_hi
002AAAr 2  ED rr rr           SBC   num_tmp_hi
002AADr 2  85 rr              STA   proc_body_len_hi
002AAFr 2  60                 RTS
002AB0r 2               @whole:
002AB0r 2  A9 rr              LDA   #<proc_body_buf
002AB2r 2  8D rr rr           STA   proc_body_src_lo
002AB5r 2  A9 rr              LDA   #>proc_body_buf
002AB7r 2  8D rr rr           STA   proc_body_src_hi
002ABAr 2  60                 RTS
002ABBr 2               
002ABBr 2               ; carry set if proc_scan_off >= proc_body_len
002ABBr 2               proc_scan_at_end:
002ABBr 2  AD rr rr           LDA   proc_scan_off_lo
002ABEr 2  C5 rr              CMP   proc_body_len_lo
002AC0r 2  AD rr rr           LDA   proc_scan_off_hi
002AC3r 2  E5 rr              SBC   proc_body_len_hi
002AC5r 2  60                 RTS
002AC6r 2               
002AC6r 2               ; advance the scan pointer + offset by one byte
002AC6r 2               proc_scan_advance:
002AC6r 2  E6 rr              INC   proc_ptr_lo
002AC8r 2  D0 02              BNE   :+
002ACAr 2  E6 rr              INC   proc_ptr_hi
002ACCr 2  EE rr rr     :     INC   proc_scan_off_lo
002ACFr 2  D0 03              BNE   :+
002AD1r 2  EE rr rr           INC   proc_scan_off_hi
002AD4r 2  60           :     RTS
002AD5r 2               
002AD5r 2               ; proc_line_is_end — carry set if the line at proc_ptr is exactly "END" followed
002AD5r 2               ; by '\n' or end-of-buffer. Needs room for 3 chars (off+3 <= len). Non-destructive.
002AD5r 2               proc_line_is_end:
002AD5r 2                     ; proc_entry = proc_scan_off + 3
002AD5r 2  18                 CLC
002AD6r 2  AD rr rr           LDA   proc_scan_off_lo
002AD9r 2  69 03              ADC   #3
002ADBr 2  85 rr              STA   proc_entry_lo
002ADDr 2  AD rr rr           LDA   proc_scan_off_hi
002AE0r 2  69 00              ADC   #0
002AE2r 2  85 rr              STA   proc_entry_hi
002AE4r 2                     ; need off+3 <= len, i.e. NOT (off+3 > len) == NOT (len < off+3)
002AE4r 2  A5 rr              LDA   proc_body_len_lo
002AE6r 2  C5 rr              CMP   proc_entry_lo
002AE8r 2  A5 rr              LDA   proc_body_len_hi
002AEAr 2  E5 rr              SBC   proc_entry_hi
002AECr 2  90 2B              BCC   @no                   ; len < off+3 -> not enough room
002AEEr 2  A0 00              LDY   #0
002AF0r 2  B1 rr              LDA   (proc_ptr_lo),Y
002AF2r 2  C9 45              CMP   #'E'
002AF4r 2  D0 23              BNE   @no
002AF6r 2  C8                 INY
002AF7r 2  B1 rr              LDA   (proc_ptr_lo),Y
002AF9r 2  C9 4E              CMP   #'N'
002AFBr 2  D0 1C              BNE   @no
002AFDr 2  C8                 INY
002AFEr 2  B1 rr              LDA   (proc_ptr_lo),Y
002B00r 2  C9 44              CMP   #'D'
002B02r 2  D0 15              BNE   @no
002B04r 2                     ; 4th byte: '\n', or off+3 == len (END at buffer end)
002B04r 2  A5 rr              LDA   proc_entry_lo
002B06r 2  C5 rr              CMP   proc_body_len_lo
002B08r 2  D0 06              BNE   @check_nl
002B0Ar 2  A5 rr              LDA   proc_entry_hi
002B0Cr 2  C5 rr              CMP   proc_body_len_hi
002B0Er 2  F0 07              BEQ   @yes                  ; off+3 == len
002B10r 2               @check_nl:
002B10r 2  C8                 INY
002B11r 2  B1 rr              LDA   (proc_ptr_lo),Y
002B13r 2  C9 0A              CMP   #$0A
002B15r 2  D0 02              BNE   @no
002B17r 2               @yes:
002B17r 2  38                 SEC
002B18r 2  60                 RTS
002B19r 2               @no:
002B19r 2  18                 CLC
002B1Ar 2  60                 RTS
002B1Br 2               
002B1Br 2               ; ---------------------------------------------------------------------
002B1Br 2               ; heap_alloc_big — allocate for procedure records (16-bit payload)
002B1Br 2               ;   Input:  proc_ptr_lo/hi = record data size (16-bit)
002B1Br 2               ;   Output: proc_entry_lo/hi = pointer to record data (payload+2)
002B1Br 2               ;           Carry clear = success, Carry set = OOM
002B1Br 2               ;
002B1Br 2               ;   Layout: [GC_HDR_TAG, GC_HDR_SIZE=0, total_lo, total_hi, ...data...]
002B1Br 2               ;   GC header (2 bytes) + 16-bit size (2 bytes) + record data.
002B1Br 2               ;   Total allocation = record_data_size + 4.
002B1Br 2               ;   GC_HDR_SIZE = 0 tells GC to read 16-bit total from payload[0..1].
002B1Br 2               ;   proc_entry points to data (base+4).
002B1Br 2               ;
002B1Br 2               ;   Clobbers: A, Y, ptr_lo/hi
002B1Br 2               ; ---------------------------------------------------------------------
002B1Br 2               heap_alloc_big:
002B1Br 2                     ; Total allocation = data_size + 4 (2 hdr + 2 size field)
002B1Br 2  18                 CLC
002B1Cr 2  A5 rr              LDA   proc_ptr_lo
002B1Er 2  69 04              ADC   #4
002B20r 2  48                 PHA                        ; save total_lo
002B21r 2  A5 rr              LDA   proc_ptr_hi
002B23r 2  69 00              ADC   #0
002B25r 2  48                 PHA                        ; save total_hi
002B26r 2               
002B26r 2                     ; Save current heap_ptr as base
002B26r 2  A5 rr              LDA   heap_ptr
002B28r 2  85 rr              STA   proc_entry_lo
002B2Ar 2  A5 rr              LDA   heap_ptr+1
002B2Cr 2  85 rr              STA   proc_entry_hi
002B2Er 2               
002B2Er 2                     ; Advance heap_ptr by total
002B2Er 2  BA                 TSX
002B2Fr 2  18                 CLC
002B30r 2  A5 rr              LDA   heap_ptr
002B32r 2  7D 02 01           ADC   $0102,X              ; total_lo
002B35r 2  85 rr              STA   heap_ptr
002B37r 2  A5 rr              LDA   heap_ptr+1
002B39r 2  7D 01 01           ADC   $0101,X              ; total_hi
002B3Cr 2  85 rr              STA   heap_ptr+1
002B3Er 2               
002B3Er 2                     ; OOM check
002B3Er 2  C9 98              CMP   #>HEAP_END
002B40r 2  90 16              BCC   @big_ok
002B42r 2  D0 08              BNE   @big_oom
002B44r 2  A5 rr              LDA   heap_ptr
002B46r 2  C9 00              CMP   #<HEAP_END
002B48r 2  90 0E              BCC   @big_ok
002B4Ar 2  F0 0C              BEQ   @big_ok
002B4Cr 2               @big_oom:
002B4Cr 2  A5 rr              LDA   proc_entry_lo
002B4Er 2  85 rr              STA   heap_ptr
002B50r 2  A5 rr              LDA   proc_entry_hi
002B52r 2  85 rr              STA   heap_ptr+1
002B54r 2  68                 PLA
002B55r 2  68                 PLA
002B56r 2  38                 SEC
002B57r 2  60                 RTS
002B58r 2               @big_ok:
002B58r 2                     ; Write header at base (proc_entry = base here)
002B58r 2  A5 rr              LDA   proc_entry_lo
002B5Ar 2  85 rr              STA   ptr_lo
002B5Cr 2  A5 rr              LDA   proc_entry_hi
002B5Er 2  85 rr              STA   ptr_hi
002B60r 2               
002B60r 2  A0 00              LDY   #GC_HDR_TAG
002B62r 2  A9 04              LDA   #ATYPE_PROC
002B64r 2  91 rr              STA   (ptr_lo),Y
002B66r 2               
002B66r 2  A0 01              LDY   #GC_HDR_SIZE
002B68r 2  A9 00              LDA   #0                    ; 0 = 16-bit size at payload[0..1]
002B6Ar 2  91 rr              STA   (ptr_lo),Y
002B6Cr 2               
002B6Cr 2                     ; Write 16-bit total at payload offsets 0,1 (base+2, base+3)
002B6Cr 2  68                 PLA                        ; total_hi
002B6Dr 2  A0 03              LDY   #GC_HDR_BYTES+1       ; base+3
002B6Fr 2  91 rr              STA   (ptr_lo),Y
002B71r 2  68                 PLA                        ; total_lo
002B72r 2  A0 02              LDY   #GC_HDR_BYTES         ; base+2
002B74r 2  91 rr              STA   (ptr_lo),Y
002B76r 2               
002B76r 2                     ; Advance proc_entry to point past header+size field = base+4
002B76r 2                     ; This is where the record data starts
002B76r 2  18                 CLC
002B77r 2  A5 rr              LDA   proc_entry_lo
002B79r 2  69 04              ADC   #4
002B7Br 2  85 rr              STA   proc_entry_lo
002B7Dr 2  A5 rr              LDA   proc_entry_hi
002B7Fr 2  69 00              ADC   #0
002B81r 2  85 rr              STA   proc_entry_hi
002B83r 2               
002B83r 2  18                 CLC
002B84r 2  60                 RTS
002B85r 2               
002B85r 2               ; ---------------------------------------------------------------------
002B85r 2               ; proc_build_record — allocate and populate a procedure heap record
002B85r 2               ;   Uses: proc_name_buf, proc_param_buf/proc_param_end,
002B85r 2               ;         proc_body_buf/proc_body_len
002B85r 2               ; ---------------------------------------------------------------------
002B85r 2               proc_build_record:
002B85r 2                     ; Calculate total record size
002B85r 2                     ; 2 (next) + 1 (name_len) + name_len
002B85r 2                     ; + 1 (param_count) + (proc_param_end - 1) param packed bytes
002B85r 2                     ; + 2 (body_len) + body_len
002B85r 2                     ;
002B85r 2                     ; We build the total in proc_ptr_lo:proc_ptr_hi (16-bit)
002B85r 2               
002B85r 2  A9 04              LDA   #4                    ; 2(next) + 1(name_len) + 1(param_count)
002B87r 2  18                 CLC
002B88r 2  6D rr rr           ADC   proc_name_buf         ; + name_len
002B8Br 2  85 rr              STA   proc_ptr_lo
002B8Dr 2  A9 00              LDA   #0
002B8Fr 2  85 rr              STA   proc_ptr_hi
002B91r 2               
002B91r 2                     ; + param packed bytes (proc_param_end - 1)
002B91r 2  AD rr rr           LDA   proc_param_end
002B94r 2  38                 SEC
002B95r 2  E9 01              SBC   #1
002B97r 2  18                 CLC
002B98r 2  65 rr              ADC   proc_ptr_lo
002B9Ar 2  85 rr              STA   proc_ptr_lo
002B9Cr 2  90 02              BCC   :+
002B9Er 2  E6 rr              INC   proc_ptr_hi
002BA0r 2               :
002BA0r 2                     ; + 2 (body_len field)
002BA0r 2  18                 CLC
002BA1r 2  A5 rr              LDA   proc_ptr_lo
002BA3r 2  69 02              ADC   #2
002BA5r 2  85 rr              STA   proc_ptr_lo
002BA7r 2  90 02              BCC   :+
002BA9r 2  E6 rr              INC   proc_ptr_hi
002BABr 2               :
002BABr 2                     ; + body_len
002BABr 2  18                 CLC
002BACr 2  A5 rr              LDA   proc_ptr_lo
002BAEr 2  65 rr              ADC   proc_body_len_lo
002BB0r 2  85 rr              STA   proc_ptr_lo
002BB2r 2  A5 rr              LDA   proc_ptr_hi
002BB4r 2  65 rr              ADC   proc_body_len_hi
002BB6r 2  85 rr              STA   proc_ptr_hi
002BB8r 2               
002BB8r 2                     ; Allocate with GC header (16-bit size via heap_alloc_big)
002BB8r 2                     ; proc_ptr_lo/hi = payload size
002BB8r 2  20 rr rr           JSR   heap_alloc_big
002BBBr 2  90 01              BCC   @ok
002BBDr 2  60                 RTS                        ; OOM
002BBEr 2               @ok:
002BBEr 2                     ; Fill the record using (ptr_lo),Y indirect addressing
002BBEr 2                     ; We track Y as the write offset. For records > 256 bytes
002BBEr 2                     ; we bump ptr_hi when Y wraps.
002BBEr 2  A5 rr              LDA   proc_entry_lo
002BC0r 2  85 rr              STA   ptr_lo
002BC2r 2  A5 rr              LDA   proc_entry_hi
002BC4r 2  85 rr              STA   ptr_hi
002BC6r 2               
002BC6r 2                     ; +0,+1: next pointer = current proc_head
002BC6r 2  A0 00              LDY   #0
002BC8r 2  A5 rr              LDA   proc_head_lo
002BCAr 2  91 rr              STA   (ptr_lo),Y
002BCCr 2  C8                 INY
002BCDr 2  A5 rr              LDA   proc_head_hi
002BCFr 2  91 rr              STA   (ptr_lo),Y
002BD1r 2               
002BD1r 2                     ; +2: name_len
002BD1r 2  C8                 INY
002BD2r 2  AD rr rr           LDA   proc_name_buf
002BD5r 2  91 rr              STA   (ptr_lo),Y
002BD7r 2               
002BD7r 2                     ; +3..+3+NL-1: name chars
002BD7r 2  AE rr rr           LDX   proc_name_buf         ; X = char count
002BDAr 2  64 rr              STZ   proc_rec_off          ; source index
002BDCr 2               @bld_name:
002BDCr 2  E0 00              CPX   #0
002BDEr 2  F0 13              BEQ   @bld_name_done
002BE0r 2  C8                 INY
002BE1r 2  D0 02              BNE   :+
002BE3r 2  E6 rr              INC   ptr_hi
002BE5r 2  DA           :     PHX
002BE6r 2  A6 rr              LDX   proc_rec_off
002BE8r 2  BD rr rr           LDA   proc_name_buf+1,X
002BEBr 2  FA                 PLX
002BECr 2  91 rr              STA   (ptr_lo),Y
002BEEr 2  E6 rr              INC   proc_rec_off
002BF0r 2  CA                 DEX
002BF1r 2  80 E9              BRA   @bld_name
002BF3r 2               @bld_name_done:
002BF3r 2               
002BF3r 2                     ; +3+NL: param_count
002BF3r 2  C8                 INY
002BF4r 2  D0 02              BNE   :+
002BF6r 2  E6 rr              INC   ptr_hi
002BF8r 2  A5 rr        :     LDA   proc_param_cnt
002BFAr 2  91 rr              STA   (ptr_lo),Y
002BFCr 2               
002BFCr 2                     ; Copy packed param data from proc_param_buf[1..proc_param_end-1]
002BFCr 2  AD rr rr           LDA   proc_param_end
002BFFr 2  C9 02              CMP   #2                    ; at least 1 = there are params
002C01r 2  90 14              BCC   @bld_params_done
002C03r 2  A2 01              LDX   #1                    ; source index (skip count byte)
002C05r 2               @bld_param:
002C05r 2  EC rr rr           CPX   proc_param_end
002C08r 2  B0 0D              BCS   @bld_params_done
002C0Ar 2  C8                 INY
002C0Br 2  D0 02              BNE   :+
002C0Dr 2  E6 rr              INC   ptr_hi
002C0Fr 2  BD rr rr     :     LDA   proc_param_buf,X
002C12r 2  91 rr              STA   (ptr_lo),Y
002C14r 2  E8                 INX
002C15r 2  80 EE              BRA   @bld_param
002C17r 2               @bld_params_done:
002C17r 2               
002C17r 2                     ; body_len_lo, body_len_hi
002C17r 2  C8                 INY
002C18r 2  D0 02              BNE   :+
002C1Ar 2  E6 rr              INC   ptr_hi
002C1Cr 2  A5 rr        :     LDA   proc_body_len_lo
002C1Er 2  91 rr              STA   (ptr_lo),Y
002C20r 2  C8                 INY
002C21r 2  D0 02              BNE   :+
002C23r 2  E6 rr              INC   ptr_hi
002C25r 2  A5 rr        :     LDA   proc_body_len_hi
002C27r 2  91 rr              STA   (ptr_lo),Y
002C29r 2               
002C29r 2                     ; Copy body text (proc_body_src points at the body region of the buffer)
002C29r 2  A5 rr              LDA   proc_body_len_lo
002C2Br 2  05 rr              ORA   proc_body_len_hi
002C2Dr 2  F0 3A              BEQ   @bld_body_done
002C2Fr 2               
002C2Fr 2  AD rr rr           LDA   proc_body_src_lo
002C32r 2  85 rr              STA   proc_ptr_lo
002C34r 2  AD rr rr           LDA   proc_body_src_hi
002C37r 2  85 rr              STA   proc_ptr_hi
002C39r 2                     ; 16-bit counter
002C39r 2  A5 rr              LDA   proc_body_len_lo
002C3Br 2  8D rr rr           STA   num_tmp_lo
002C3Er 2  A5 rr              LDA   proc_body_len_hi
002C40r 2  8D rr rr           STA   num_tmp_hi
002C43r 2               
002C43r 2               @bld_body:
002C43r 2  C8                 INY
002C44r 2  D0 02              BNE   :+
002C46r 2  E6 rr              INC   ptr_hi
002C48r 2  5A           :     PHY
002C49r 2  A0 00              LDY   #0
002C4Br 2  B1 rr              LDA   (proc_ptr_lo),Y
002C4Dr 2  7A                 PLY
002C4Er 2  91 rr              STA   (ptr_lo),Y
002C50r 2                     ; Advance source
002C50r 2  E6 rr              INC   proc_ptr_lo
002C52r 2  D0 02              BNE   :+
002C54r 2  E6 rr              INC   proc_ptr_hi
002C56r 2               :     ; Decrement counter
002C56r 2  AD rr rr           LDA   num_tmp_lo
002C59r 2  D0 03              BNE   @bld_dec_lo
002C5Br 2  CE rr rr           DEC   num_tmp_hi
002C5Er 2               @bld_dec_lo:
002C5Er 2  CE rr rr           DEC   num_tmp_lo
002C61r 2  AD rr rr           LDA   num_tmp_lo
002C64r 2  0D rr rr           ORA   num_tmp_hi
002C67r 2  D0 DA              BNE   @bld_body
002C69r 2               
002C69r 2               @bld_body_done:
002C69r 2                     ; Prepend to directory
002C69r 2  A5 rr              LDA   proc_entry_lo
002C6Br 2  85 rr              STA   proc_head_lo
002C6Dr 2  A5 rr              LDA   proc_entry_hi
002C6Fr 2  85 rr              STA   proc_head_hi
002C71r 2  60                 RTS
002C72r 2               
002C72r 2               ; ---------------------------------------------------------------------
002C72r 2               ; proc_lookup — search for a procedure by name
002C72r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
002C72r 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002C72r 2               ;           carry set = not found
002C72r 2               ; ---------------------------------------------------------------------
002C72r 2               proc_lookup:
002C72r 2  A5 rr              LDA   proc_head_lo
002C74r 2  85 rr              STA   proc_entry_lo
002C76r 2  A5 rr              LDA   proc_head_hi
002C78r 2  85 rr              STA   proc_entry_hi
002C7Ar 2               
002C7Ar 2               @walk:
002C7Ar 2  A5 rr              LDA   proc_entry_lo
002C7Cr 2  05 rr              ORA   proc_entry_hi
002C7Er 2  F0 0C              BEQ   @not_found
002C80r 2               
002C80r 2  20 rr rr           JSR   proc_names_equal
002C83r 2  B0 05              BCS   @found
002C85r 2               
002C85r 2                     ; Follow next pointer
002C85r 2  20 rr rr           JSR   proc_next
002C88r 2  80 F0              BRA   @walk
002C8Ar 2               
002C8Ar 2               @found:
002C8Ar 2  18                 CLC
002C8Br 2  60                 RTS
002C8Cr 2               @not_found:
002C8Cr 2  38                 SEC
002C8Dr 2  60                 RTS
002C8Er 2               
002C8Er 2               ; ---------------------------------------------------------------------
002C8Er 2               ; proc_next — advance proc_entry_lo/hi to the next record it links to.
002C8Er 2               ;   In/out: proc_entry_lo/hi.  Clobbers: A, X, Y, ptr_lo/hi.
002C8Er 2               ; ---------------------------------------------------------------------
002C8Er 2               proc_next:
002C8Er 2  A5 rr              LDA   proc_entry_lo
002C90r 2  85 rr              STA   ptr_lo
002C92r 2  A5 rr              LDA   proc_entry_hi
002C94r 2  85 rr              STA   ptr_hi
002C96r 2  A0 00              LDY   #0
002C98r 2  B1 rr              LDA   (ptr_lo),Y
002C9Ar 2  AA                 TAX
002C9Br 2  C8                 INY
002C9Cr 2  B1 rr              LDA   (ptr_lo),Y
002C9Er 2  85 rr              STA   proc_entry_hi
002CA0r 2  86 rr              STX   proc_entry_lo
002CA2r 2  60                 RTS
002CA3r 2               
002CA3r 2               ; ---------------------------------------------------------------------
002CA3r 2               ; proc_names_equal — compare token word vs record name
002CA3r 2               ;   Input: eval_cur_lo/hi = TOK_WORD, proc_entry_lo/hi = record
002CA3r 2               ;   Returns: carry set = equal, carry clear = not equal
002CA3r 2               ; ---------------------------------------------------------------------
002CA3r 2               proc_names_equal:
002CA3r 2                     ; Token name length
002CA3r 2  A5 rr              LDA   eval_cur_lo
002CA5r 2  85 rr              STA   ptr_lo
002CA7r 2  A5 rr              LDA   eval_cur_hi
002CA9r 2  85 rr              STA   ptr_hi
002CABr 2  A0 03              LDY   #TOK_PAYLOAD
002CADr 2  B1 rr              LDA   (ptr_lo),Y
002CAFr 2  85 rr              STA   proc_name_len         ; token name length
002CB1r 2               
002CB1r 2                     ; Record name length
002CB1r 2  A5 rr              LDA   proc_entry_lo
002CB3r 2  85 rr              STA   ptr_lo
002CB5r 2  A5 rr              LDA   proc_entry_hi
002CB7r 2  85 rr              STA   ptr_hi
002CB9r 2  A0 02              LDY   #2
002CBBr 2  B1 rr              LDA   (ptr_lo),Y
002CBDr 2               
002CBDr 2  C5 rr              CMP   proc_name_len
002CBFr 2  D0 37              BNE   @ne
002CC1r 2               
002CC1r 2                     ; Lengths match — compare chars
002CC1r 2  AA                 TAX                         ; X = length
002CC2r 2  F0 30              BEQ   @eq
002CC4r 2  A0 00              LDY   #0                    ; char index
002CC6r 2               @cmp:
002CC6r 2  DA                 PHX
002CC7r 2  5A                 PHY
002CC8r 2                     ; Token char at eval_cur + TOK_PAYLOAD + 1 + charIdx
002CC8r 2  A5 rr              LDA   eval_cur_lo
002CCAr 2  85 rr              STA   ptr_lo
002CCCr 2  A5 rr              LDA   eval_cur_hi
002CCEr 2  85 rr              STA   ptr_hi
002CD0r 2  98                 TYA
002CD1r 2  18                 CLC
002CD2r 2  69 04              ADC   #TOK_PAYLOAD+1
002CD4r 2  A8                 TAY
002CD5r 2  B1 rr              LDA   (ptr_lo),Y
002CD7r 2  85 rr              STA   proc_rec_off          ; temp: token char
002CD9r 2               
002CD9r 2                     ; Record char at proc_entry + 3 + charIdx
002CD9r 2  7A                 PLY
002CDAr 2  5A                 PHY
002CDBr 2  A5 rr              LDA   proc_entry_lo
002CDDr 2  85 rr              STA   ptr_lo
002CDFr 2  A5 rr              LDA   proc_entry_hi
002CE1r 2  85 rr              STA   ptr_hi
002CE3r 2  98                 TYA
002CE4r 2  18                 CLC
002CE5r 2  69 03              ADC   #3
002CE7r 2  A8                 TAY
002CE8r 2  B1 rr              LDA   (ptr_lo),Y
002CEAr 2               
002CEAr 2  C5 rr              CMP   proc_rec_off
002CECr 2  D0 08              BNE   @ne_pop
002CEEr 2  7A                 PLY
002CEFr 2  FA                 PLX
002CF0r 2  C8                 INY
002CF1r 2  CA                 DEX
002CF2r 2  D0 D2              BNE   @cmp
002CF4r 2               @eq:
002CF4r 2  38                 SEC
002CF5r 2  60                 RTS
002CF6r 2               @ne_pop:
002CF6r 2  7A                 PLY
002CF7r 2  FA                 PLX
002CF8r 2               @ne:
002CF8r 2  18                 CLC
002CF9r 2  60                 RTS
002CFAr 2               
002CFAr 2               ; ---------------------------------------------------------------------
002CFAr 2               ; proc_invoke — invoke a user-defined procedure
002CFAr 2               ;   Input: eval_cur_lo/hi = TOK_WORD token (the procedure name)
002CFAr 2               ;          proc_entry_lo/hi = matching procedure record
002CFAr 2               ;   On exit: JMPs to eval_loop or eval_body to continue.
002CFAr 2               ; ---------------------------------------------------------------------
002CFAr 2               proc_invoke:
002CFAr 2                     ; Save outer tokenizer and eval state on the hardware stack.
002CFAr 2                     ; We push: tok_head(2), tok_tail(2), eval_in_body(1),
002CFAr 2                     ;          proc_stopped(1) = 6 bytes.
002CFAr 2                     ; input_buf is saved to BSS (128 bytes too large for stack).
002CFAr 2  A5 rr              LDA   tok_head_lo
002CFCr 2  48                 PHA
002CFDr 2  A5 rr              LDA   tok_head_hi
002CFFr 2  48                 PHA
002D00r 2  A5 rr              LDA   tok_tail_lo
002D02r 2  48                 PHA
002D03r 2  A5 rr              LDA   tok_tail_hi
002D05r 2  48                 PHA
002D06r 2  A5 rr              LDA   eval_in_body
002D08r 2  48                 PHA
002D09r 2  A5 rr              LDA   proc_stopped
002D0Br 2  48                 PHA
002D0Cr 2               
002D0Cr 2                     ; Save input_buf to BSS save area
002D0Cr 2  A2 00              LDX   #0
002D0Er 2               @save_ib:
002D0Er 2  BD rr rr           LDA   input_buf,X
002D11r 2  9D rr rr           STA   save_input_buf,X
002D14r 2  E8                 INX
002D15r 2  E0 80              CPX   #128
002D17r 2  D0 F5              BNE   @save_ib
002D19r 2               
002D19r 2                     ; Advance eval_cur past the procedure name token
002D19r 2  20 rr rr           JSR   eval_advance
002D1Cr 2               
002D1Cr 2                     ; --- Bind parameters ---
002D1Cr 2                     ; Navigate to param_count in the record:
002D1Cr 2                     ;   offset = 3 + name_len
002D1Cr 2  A5 rr              LDA   proc_entry_lo
002D1Er 2  85 rr              STA   ptr_lo
002D20r 2  A5 rr              LDA   proc_entry_hi
002D22r 2  85 rr              STA   ptr_hi
002D24r 2  A0 02              LDY   #2
002D26r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002D28r 2  18                 CLC
002D29r 2  69 03              ADC   #3
002D2Br 2  A8                 TAY                         ; Y = offset to param_count
002D2Cr 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002D2Er 2  85 rr              STA   proc_param_cnt
002D30r 2  C8                 INY                         ; Y = offset to first param name
002D31r 2  84 rr              STY   proc_rec_off          ; save record offset
002D33r 2               
002D33r 2  A5 rr              LDA   proc_param_cnt
002D35r 2  F0 5C              BEQ   @bind_done
002D37r 2               
002D37r 2  A6 rr              LDX   proc_param_cnt
002D39r 2               @bind_loop:
002D39r 2  DA                 PHX                         ; save remaining param count
002D3Ar 2               
002D3Ar 2                     ; First: evaluate the next argument from the caller's token stream.
002D3Ar 2                     ; eval_cur still points into the caller's token list.
002D3Ar 2  20 rr rr           JSR   eval_expr
002D3Dr 2  90 03              BCC   @arg_ok
002D3Fr 2  4C rr rr           JMP   @bind_err
002D42r 2               @arg_ok:
002D42r 2               
002D42r 2                     ; eval_val now holds the argument value.
002D42r 2                     ; Push value onto stack (type + 3 value bytes = 4 bytes)
002D42r 2  A5 rr              LDA   eval_val_frac
002D44r 2  48                 PHA
002D45r 2  A5 rr              LDA   eval_val_lo
002D47r 2  48                 PHA
002D48r 2  A5 rr              LDA   eval_val_hi
002D4Ar 2  48                 PHA
002D4Br 2  A5 rr              LDA   eval_type
002D4Dr 2  48                 PHA
002D4Er 2               
002D4Er 2                     ; Build the param name as a length-prefixed string in param_name_tmp
002D4Er 2                     ; Read from record at proc_entry + proc_rec_off
002D4Er 2  A5 rr              LDA   proc_entry_lo
002D50r 2  85 rr              STA   ptr_lo
002D52r 2  A5 rr              LDA   proc_entry_hi
002D54r 2  85 rr              STA   ptr_hi
002D56r 2  A4 rr              LDY   proc_rec_off
002D58r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002D5Ar 2  8D rr rr           STA   param_name_tmp        ; length byte
002D5Dr 2  AA                 TAX                         ; X = char count
002D5Er 2  A9 00              LDA   #0
002D60r 2  85 rr              STA   proc_name_len         ; dest offset in param_name_tmp
002D62r 2               @bind_ch:
002D62r 2  E0 00              CPX   #0
002D64r 2  F0 0F              BEQ   @bind_ch_done
002D66r 2  C8                 INY
002D67r 2  B1 rr              LDA   (ptr_lo),Y
002D69r 2  DA                 PHX
002D6Ar 2  A6 rr              LDX   proc_name_len
002D6Cr 2  9D rr rr           STA   param_name_tmp+1,X
002D6Fr 2  E6 rr              INC   proc_name_len
002D71r 2  FA                 PLX
002D72r 2  CA                 DEX
002D73r 2  80 ED              BRA   @bind_ch
002D75r 2               @bind_ch_done:
002D75r 2                     ; Advance proc_rec_off past this param
002D75r 2  C8                 INY
002D76r 2  84 rr              STY   proc_rec_off
002D78r 2               
002D78r 2                     ; Pop value from stack back into eval_val
002D78r 2  68                 PLA
002D79r 2  85 rr              STA   eval_type
002D7Br 2  68                 PLA
002D7Cr 2  85 rr              STA   eval_val_hi
002D7Er 2  68                 PLA
002D7Fr 2  85 rr              STA   eval_val_lo
002D81r 2  68                 PLA
002D82r 2  85 rr              STA   eval_val_frac
002D84r 2               
002D84r 2                     ; Call var_set with ptr_lo/hi → param_name_tmp
002D84r 2  A9 rr              LDA   #<param_name_tmp
002D86r 2  85 rr              STA   ptr_lo
002D88r 2  A9 rr              LDA   #>param_name_tmp
002D8Ar 2  85 rr              STA   ptr_hi
002D8Cr 2  20 rr rr           JSR   var_set
002D8Fr 2               
002D8Fr 2  FA                 PLX                         ; restore remaining count
002D90r 2  CA                 DEX
002D91r 2  D0 A6              BNE   @bind_loop
002D93r 2               
002D93r 2               @bind_done:
002D93r 2                     ; Save heap pointer AFTER param binding so var_set allocations persist.
002D93r 2                     ; Body tokenization will reuse heap from this point each line.
002D93r 2  A5 rr              LDA   heap_ptr
002D95r 2  8D rr rr           STA   save_heap_ptr_lo
002D98r 2  A5 rr              LDA   heap_ptr+1
002D9Ar 2  8D rr rr           STA   save_heap_ptr_hi
002D9Dr 2               
002D9Dr 2                     ; Save eval_cur (resume point after all args consumed from caller)
002D9Dr 2  A5 rr              LDA   eval_cur_lo
002D9Fr 2  8D rr rr           STA   save_eval_cur_lo
002DA2r 2  A5 rr              LDA   eval_cur_hi
002DA4r 2  8D rr rr           STA   save_eval_cur_hi
002DA7r 2               
002DA7r 2                     ; --- Execute the body ---
002DA7r 2                     ; Navigate to body in the record:
002DA7r 2                     ;   proc_rec_off now points past all params.
002DA7r 2                     ;   Next 2 bytes = body_len, then body text.
002DA7r 2  A5 rr              LDA   proc_entry_lo
002DA9r 2  85 rr              STA   ptr_lo
002DABr 2  A5 rr              LDA   proc_entry_hi
002DADr 2  85 rr              STA   ptr_hi
002DAFr 2  A4 rr              LDY   proc_rec_off
002DB1r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_lo
002DB3r 2  85 rr              STA   proc_body_len_lo
002DB5r 2  C8                 INY
002DB6r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_hi
002DB8r 2  85 rr              STA   proc_body_len_hi
002DBAr 2  C8                 INY                         ; Y = offset to body text start
002DBBr 2  84 rr              STY   proc_rec_off
002DBDr 2               
002DBDr 2                     ; Compute absolute pointer to body text start
002DBDr 2  18                 CLC
002DBEr 2  A5 rr              LDA   proc_entry_lo
002DC0r 2  65 rr              ADC   proc_rec_off
002DC2r 2  85 rr              STA   proc_ptr_lo
002DC4r 2  A5 rr              LDA   proc_entry_hi
002DC6r 2  69 00              ADC   #0
002DC8r 2  85 rr              STA   proc_ptr_hi
002DCAr 2               
002DCAr 2                     ; Process body line by line: find each $0A, copy line to input_buf,
002DCAr 2                     ; tokenize, eval, repeat.
002DCAr 2                     ; proc_ptr = current position in body text
002DCAr 2                     ; proc_body_len = remaining bytes
002DCAr 2               
002DCAr 2                     ; Clear STOP/OUTPUT flag before executing body
002DCAr 2  64 rr              STZ   proc_stopped
002DCCr 2               
002DCCr 2               @exec_line:
002DCCr 2                     ; Any body text remaining?
002DCCr 2  A5 rr              LDA   proc_body_len_lo
002DCEr 2  05 rr              ORA   proc_body_len_hi
002DD0r 2  D0 03              BNE   @have_body
002DD2r 2  4C rr rr           JMP   @exec_done
002DD5r 2               @have_body:
002DD5r 2               
002DD5r 2                     ; Reset heap for this statement's tokens (reuse token heap each statement)
002DD5r 2  AD rr rr           LDA   save_heap_ptr_lo
002DD8r 2  85 rr              STA   heap_ptr
002DDAr 2  AD rr rr           LDA   save_heap_ptr_hi
002DDDr 2  85 rr              STA   heap_ptr+1
002DDFr 2               
002DDFr 2                     ; Accumulate physical lines into one logical statement: keep copying lines
002DDFr 2                     ; into input_buf until bracket/paren depth returns to 0, so a [ ... ] or
002DDFr 2                     ; ( ... ) that spans several lines is pieced together before we tokenize.
002DDFr 2  A2 00              LDX   #0                    ; input_buf index
002DE1r 2  9C rr rr           STZ   proc_brk_depth
002DE4r 2               @line_ch:
002DE4r 2  A5 rr              LDA   proc_body_len_lo
002DE6r 2  05 rr              ORA   proc_body_len_hi
002DE8r 2  F0 71              BEQ   @line_eol             ; no more body text -> end of last line
002DEAr 2               
002DEAr 2  A0 00              LDY   #0
002DECr 2  B1 rr              LDA   (proc_ptr_lo),Y      ; read body char
002DEEr 2  C9 0A              CMP   #$0A
002DF0r 2  F0 5B              BEQ   @line_nl
002DF2r 2  C9 3B              CMP   #';'                 ; comment -> skip rest of physical line
002DF4r 2  F0 37              BEQ   @line_comment
002DF6r 2               
002DF6r 2                     ; Store char in input_buf, tracking bracket/paren nesting depth.
002DF6r 2  9D rr rr           STA   input_buf,X
002DF9r 2  E8                 INX
002DFAr 2  C9 5B              CMP   #'['
002DFCr 2  F0 20              BEQ   @brk_inc
002DFEr 2  C9 28              CMP   #'('
002E00r 2  F0 1C              BEQ   @brk_inc
002E02r 2  C9 5D              CMP   #']'
002E04r 2  F0 1D              BEQ   @brk_dec
002E06r 2  C9 29              CMP   #')'
002E08r 2  F0 19              BEQ   @brk_dec
002E0Ar 2               @brk_done:
002E0Ar 2                     ; Advance body pointer
002E0Ar 2  E6 rr              INC   proc_ptr_lo
002E0Cr 2  D0 02              BNE   :+
002E0Er 2  E6 rr              INC   proc_ptr_hi
002E10r 2               :     ; Decrement remaining
002E10r 2  A5 rr              LDA   proc_body_len_lo
002E12r 2  D0 02              BNE   @ln_dec_lo
002E14r 2  C6 rr              DEC   proc_body_len_hi
002E16r 2               @ln_dec_lo:
002E16r 2  C6 rr              DEC   proc_body_len_lo
002E18r 2                     ; Guard against input_buf overflow (~120 chars per statement).
002E18r 2  E0 78              CPX   #120
002E1Ar 2  B0 3F              BCS   @line_eol
002E1Cr 2  80 C6              BRA   @line_ch
002E1Er 2               
002E1Er 2               @brk_inc:
002E1Er 2  EE rr rr           INC   proc_brk_depth
002E21r 2  80 E7              BRA   @brk_done
002E23r 2               @brk_dec:
002E23r 2  AD rr rr           LDA   proc_brk_depth
002E26r 2  F0 E2              BEQ   @brk_done             ; floor at 0
002E28r 2  CE rr rr           DEC   proc_brk_depth
002E2Br 2  80 DD              BRA   @brk_done
002E2Dr 2               
002E2Dr 2               @line_comment:
002E2Dr 2                     ; ';' begins a comment: advance past the rest of this physical line
002E2Dr 2                     ; without copying, so comment text (and any brackets in it) is ignored.
002E2Dr 2  A5 rr              LDA   proc_body_len_lo
002E2Fr 2  05 rr              ORA   proc_body_len_hi
002E31r 2  F0 28              BEQ   @line_eol             ; comment runs to end of body
002E33r 2  A0 00              LDY   #0
002E35r 2  B1 rr              LDA   (proc_ptr_lo),Y
002E37r 2  48                 PHA                         ; remember if this was the newline
002E38r 2  E6 rr              INC   proc_ptr_lo
002E3Ar 2  D0 02              BNE   :+
002E3Cr 2  E6 rr              INC   proc_ptr_hi
002E3Er 2  A5 rr        :     LDA   proc_body_len_lo
002E40r 2  D0 02              BNE   @cmt_dec
002E42r 2  C6 rr              DEC   proc_body_len_hi
002E44r 2               @cmt_dec:
002E44r 2  C6 rr              DEC   proc_body_len_lo
002E46r 2  68                 PLA
002E47r 2  C9 0A              CMP   #$0A
002E49r 2  D0 E2              BNE   @line_comment         ; keep skipping comment chars
002E4Br 2  80 0E              BRA   @line_eol             ; consumed the newline -> end of physical line
002E4Dr 2               
002E4Dr 2               @line_nl:
002E4Dr 2                     ; Skip the $0A
002E4Dr 2  E6 rr              INC   proc_ptr_lo
002E4Fr 2  D0 02              BNE   :+
002E51r 2  E6 rr              INC   proc_ptr_hi
002E53r 2  A5 rr        :     LDA   proc_body_len_lo
002E55r 2  D0 02              BNE   @ln2_dec_lo
002E57r 2  C6 rr              DEC   proc_body_len_hi
002E59r 2               @ln2_dec_lo:
002E59r 2  C6 rr              DEC   proc_body_len_lo
002E5Br 2                     ; fall through to end-of-physical-line decision
002E5Br 2               
002E5Br 2               @line_eol:
002E5Br 2                     ; End of a physical line. If brackets/parens are still open AND there is
002E5Br 2                     ; more body to read AND room in the buffer, append a separating space and
002E5Br 2                     ; keep accumulating; otherwise the statement is complete.
002E5Br 2  AD rr rr           LDA   proc_brk_depth
002E5Er 2  F0 13              BEQ   @line_end             ; balanced -> execute
002E60r 2  A5 rr              LDA   proc_body_len_lo
002E62r 2  05 rr              ORA   proc_body_len_hi
002E64r 2  F0 0D              BEQ   @line_end             ; no more lines -> execute (eval will report)
002E66r 2  E0 78              CPX   #120
002E68r 2  B0 09              BCS   @line_end             ; buffer full -> execute
002E6Ar 2  A9 20              LDA   #' '                  ; join lines with whitespace
002E6Cr 2  9D rr rr           STA   input_buf,X
002E6Fr 2  E8                 INX
002E70r 2  4C rr rr           JMP   @line_ch
002E73r 2               
002E73r 2               @line_end:
002E73r 2                     ; Null-terminate input_buf
002E73r 2  9E rr rr           STZ   input_buf,X
002E76r 2               
002E76r 2                     ; Tokenize this line
002E76r 2  20 rr rr           JSR   tokenize_line
002E79r 2               
002E79r 2                     ; Save body-loop state that recursive proc_invoke would clobber.
002E79r 2                     ; BSS save areas (save_heap_ptr, save_eval_cur) plus ZP body-loop
002E79r 2                     ; variables (proc_ptr, proc_body_len) all need protection.
002E79r 2  A5 rr              LDA   proc_ptr_lo
002E7Br 2  48                 PHA
002E7Cr 2  A5 rr              LDA   proc_ptr_hi
002E7Er 2  48                 PHA
002E7Fr 2  A5 rr              LDA   proc_body_len_lo
002E81r 2  48                 PHA
002E82r 2  A5 rr              LDA   proc_body_len_hi
002E84r 2  48                 PHA
002E85r 2  AD rr rr           LDA   save_heap_ptr_lo
002E88r 2  48                 PHA
002E89r 2  AD rr rr           LDA   save_heap_ptr_hi
002E8Cr 2  48                 PHA
002E8Dr 2  AD rr rr           LDA   save_eval_cur_lo
002E90r 2  48                 PHA
002E91r 2  AD rr rr           LDA   save_eval_cur_hi
002E94r 2  48                 PHA
002E95r 2               
002E95r 2                     ; Eval this line (full eval — not body mode)
002E95r 2  20 rr rr           JSR   eval_line
002E98r 2               
002E98r 2                     ; Restore body-loop state
002E98r 2  68                 PLA
002E99r 2  8D rr rr           STA   save_eval_cur_hi
002E9Cr 2  68                 PLA
002E9Dr 2  8D rr rr           STA   save_eval_cur_lo
002EA0r 2  68                 PLA
002EA1r 2  8D rr rr           STA   save_heap_ptr_hi
002EA4r 2  68                 PLA
002EA5r 2  8D rr rr           STA   save_heap_ptr_lo
002EA8r 2  68                 PLA
002EA9r 2  85 rr              STA   proc_body_len_hi
002EABr 2  68                 PLA
002EACr 2  85 rr              STA   proc_body_len_lo
002EAEr 2  68                 PLA
002EAFr 2  85 rr              STA   proc_ptr_hi
002EB1r 2  68                 PLA
002EB2r 2  85 rr              STA   proc_ptr_lo
002EB4r 2               
002EB4r 2                     ; Check if STOP or OUTPUT was called — stop processing lines
002EB4r 2  A5 rr              LDA   proc_stopped
002EB6r 2  D0 03              BNE   @exec_done
002EB8r 2               
002EB8r 2  4C rr rr           JMP   @exec_line
002EBBr 2               
002EBBr 2               @exec_done:
002EBBr 2                     ; Restore heap pointer (procedures stay, but per-line tokens freed)
002EBBr 2  AD rr rr           LDA   save_heap_ptr_lo
002EBEr 2  85 rr              STA   heap_ptr
002EC0r 2  AD rr rr           LDA   save_heap_ptr_hi
002EC3r 2  85 rr              STA   heap_ptr+1
002EC5r 2               
002EC5r 2                     ; Restore input_buf
002EC5r 2  A2 00              LDX   #0
002EC7r 2               @rest_ib:
002EC7r 2  BD rr rr           LDA   save_input_buf,X
002ECAr 2  9D rr rr           STA   input_buf,X
002ECDr 2  E8                 INX
002ECEr 2  E0 80              CPX   #128
002ED0r 2  D0 F5              BNE   @rest_ib
002ED2r 2               
002ED2r 2                     ; Restore eval_cur to the resume point in the caller's token stream
002ED2r 2  AD rr rr           LDA   save_eval_cur_lo
002ED5r 2  85 rr              STA   eval_cur_lo
002ED7r 2  AD rr rr           LDA   save_eval_cur_hi
002EDAr 2  85 rr              STA   eval_cur_hi
002EDCr 2               
002EDCr 2                     ; Restore outer state from stack.
002EDCr 2                     ; X returns this invocation's proc_stopped to the caller.
002EDCr 2                     ; Stack layout (top to bottom):
002EDCr 2                     ;   saved_proc_stopped, eval_in_body, tok_tail_hi, tok_tail_lo,
002EDCr 2                     ;   tok_head_hi, tok_head_lo
002EDCr 2  A6 rr              LDX   proc_stopped          ; X = this proc's exit state
002EDEr 2  68                 PLA                         ; pop saved outer proc_stopped
002EDFr 2  85 rr              STA   proc_stopped          ; restore outer proc_stopped
002EE1r 2  68                 PLA
002EE2r 2  85 rr              STA   eval_in_body
002EE4r 2  68                 PLA
002EE5r 2  85 rr              STA   tok_tail_hi
002EE7r 2  68                 PLA
002EE8r 2  85 rr              STA   tok_tail_lo
002EEAr 2  68                 PLA
002EEBr 2  85 rr              STA   tok_head_hi
002EEDr 2  68                 PLA
002EEEr 2  85 rr              STA   tok_head_lo
002EF0r 2               
002EF0r 2                     ; Return with X = exit status ($00=normal, $01=STOP, $02=OUTPUT)
002EF0r 2  60                 RTS
002EF1r 2               
002EF1r 2               @bind_err:
002EF1r 2  FA                 PLX                         ; discard remaining param count
002EF2r 2                     ; Print error
002EF2r 2  A2 00              LDX   #0
002EF4r 2               @be_lp:
002EF4r 2  BD rr rr           LDA   str_notenough,X
002EF7r 2  F0 06              BEQ   @be_done
002EF9r 2  8D 0E A0           STA   VGC_CHAROUT
002EFCr 2  E8                 INX
002EFDr 2  D0 F5              BNE   @be_lp
002EFFr 2               @be_done:
002EFFr 2  20 rr rr           JSR   eval_newline
002F02r 2                     ; Restore input_buf and stack, skip body execution
002F02r 2  A2 00              LDX   #0
002F04r 2               @be_rest_ib:
002F04r 2  BD rr rr           LDA   save_input_buf,X
002F07r 2  9D rr rr           STA   input_buf,X
002F0Ar 2  E8                 INX
002F0Br 2  E0 80              CPX   #128
002F0Dr 2  D0 F5              BNE   @be_rest_ib
002F0Fr 2                     ; Restore stack (6 bytes: proc_stopped, eval_in_body, tok_tail, tok_head)
002F0Fr 2  A2 00              LDX   #$00                  ; X = normal exit status
002F11r 2  68                 PLA                         ; saved proc_stopped
002F12r 2  85 rr              STA   proc_stopped
002F14r 2  68                 PLA
002F15r 2  85 rr              STA   eval_in_body
002F17r 2  68                 PLA
002F18r 2  85 rr              STA   tok_tail_hi
002F1Ar 2  68                 PLA
002F1Br 2  85 rr              STA   tok_tail_lo
002F1Dr 2  68                 PLA
002F1Er 2  85 rr              STA   tok_head_hi
002F20r 2  68                 PLA
002F21r 2  85 rr              STA   tok_head_lo
002F23r 2  60                 RTS
002F24r 2               
002F24r 2               ; ---------------------------------------------------------------------
002F24r 2               ; proc_find_by_name — search proc_head for a procedure by name string
002F24r 2               ;   Input: ptr_lo/hi = length-prefixed name string (e.g. from eval_val)
002F24r 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002F24r 2               ;           carry set = not found
002F24r 2               ;   Clobbers: A, X, Y, proc_entry, proc_name_len, proc_rec_off
002F24r 2               ; ---------------------------------------------------------------------
002F24r 2               proc_find_by_name:
002F24r 2                     ; Save search name pointer
002F24r 2  A5 rr              LDA   ptr_lo
002F26r 2  85 rr              STA   var_name_lo             ; reuse var scratch as search ptr
002F28r 2  A5 rr              LDA   ptr_hi
002F2Ar 2  85 rr              STA   var_name_hi
002F2Cr 2               
002F2Cr 2  A5 rr              LDA   proc_head_lo
002F2Er 2  85 rr              STA   proc_entry_lo
002F30r 2  A5 rr              LDA   proc_head_hi
002F32r 2  85 rr              STA   proc_entry_hi
002F34r 2               
002F34r 2               @walk:
002F34r 2  A5 rr              LDA   proc_entry_lo
002F36r 2  05 rr              ORA   proc_entry_hi
002F38r 2  F0 55              BEQ   @not_found
002F3Ar 2               
002F3Ar 2                     ; Compare name lengths
002F3Ar 2  A5 rr              LDA   var_name_lo
002F3Cr 2  85 rr              STA   ptr_lo
002F3Er 2  A5 rr              LDA   var_name_hi
002F40r 2  85 rr              STA   ptr_hi
002F42r 2  A0 00              LDY   #0
002F44r 2  B1 rr              LDA   (ptr_lo),Y             ; search name length
002F46r 2  85 rr              STA   proc_name_len
002F48r 2               
002F48r 2  A5 rr              LDA   proc_entry_lo
002F4Ar 2  85 rr              STA   ptr_lo
002F4Cr 2  A5 rr              LDA   proc_entry_hi
002F4Er 2  85 rr              STA   ptr_hi
002F50r 2  A0 02              LDY   #2
002F52r 2  B1 rr              LDA   (ptr_lo),Y             ; record name length
002F54r 2  C5 rr              CMP   proc_name_len
002F56r 2  D0 32              BNE   @next
002F58r 2               
002F58r 2                     ; Lengths match — compare chars
002F58r 2  AA                 TAX                           ; X = length
002F59r 2  F0 2C              BEQ   @found                  ; both zero = match
002F5Br 2  A0 00              LDY   #0
002F5Dr 2               @cmp:
002F5Dr 2  DA                 PHX
002F5Er 2  5A                 PHY
002F5Fr 2                     ; Search char
002F5Fr 2  A5 rr              LDA   var_name_lo
002F61r 2  85 rr              STA   ptr_lo
002F63r 2  A5 rr              LDA   var_name_hi
002F65r 2  85 rr              STA   ptr_hi
002F67r 2  C8                 INY                           ; +1 for length byte
002F68r 2  B1 rr              LDA   (ptr_lo),Y
002F6Ar 2  85 rr              STA   proc_rec_off            ; temp: search char
002F6Cr 2               
002F6Cr 2                     ; Record char
002F6Cr 2  7A                 PLY
002F6Dr 2  A5 rr              LDA   proc_entry_lo
002F6Fr 2  85 rr              STA   ptr_lo
002F71r 2  A5 rr              LDA   proc_entry_hi
002F73r 2  85 rr              STA   ptr_hi
002F75r 2  5A                 PHY
002F76r 2  98                 TYA
002F77r 2  18                 CLC
002F78r 2  69 03              ADC   #3                      ; record name starts at offset 3
002F7Ar 2  A8                 TAY
002F7Br 2  B1 rr              LDA   (ptr_lo),Y
002F7Dr 2  7A                 PLY
002F7Er 2  C5 rr              CMP   proc_rec_off
002F80r 2  D0 07              BNE   @ne_pop
002F82r 2  FA                 PLX
002F83r 2  C8                 INY
002F84r 2  CA                 DEX
002F85r 2  D0 D6              BNE   @cmp
002F87r 2               
002F87r 2               @found:
002F87r 2  18                 CLC
002F88r 2  60                 RTS
002F89r 2               
002F89r 2               @ne_pop:
002F89r 2  FA                 PLX
002F8Ar 2               @next:
002F8Ar 2                     ; Follow next pointer
002F8Ar 2  20 rr rr           JSR   proc_next
002F8Dr 2  80 A5              BRA   @walk
002F8Fr 2               
002F8Fr 2               @not_found:
002F8Fr 2  38                 SEC
002F90r 2  60                 RTS
002F91r 2               
002F91r 2               ; ---------------------------------------------------------------------
002F91r 2               ; do_pots — POTS: print all procedure names
002F91r 2               ;   Arity 0, no arguments.
002F91r 2               ; ---------------------------------------------------------------------
002F91r 2               do_pots:
002F91r 2  A5 rr              LDA   proc_head_lo
002F93r 2  85 rr              STA   proc_entry_lo
002F95r 2  A5 rr              LDA   proc_head_hi
002F97r 2  85 rr              STA   proc_entry_hi
002F99r 2               
002F99r 2               @walk:
002F99r 2  A5 rr              LDA   proc_entry_lo
002F9Br 2  05 rr              ORA   proc_entry_hi
002F9Dr 2  F0 24              BEQ   @done
002F9Fr 2               
002F9Fr 2                     ; Print name
002F9Fr 2  A5 rr              LDA   proc_entry_lo
002FA1r 2  85 rr              STA   ptr_lo
002FA3r 2  A5 rr              LDA   proc_entry_hi
002FA5r 2  85 rr              STA   ptr_hi
002FA7r 2  A0 02              LDY   #2
002FA9r 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002FABr 2  AA                 TAX
002FACr 2  F0 0B              BEQ   @skip_name
002FAEr 2  A0 03              LDY   #3
002FB0r 2               @pch:
002FB0r 2  B1 rr              LDA   (ptr_lo),Y
002FB2r 2  8D 0E A0           STA   VGC_CHAROUT
002FB5r 2  C8                 INY
002FB6r 2  CA                 DEX
002FB7r 2  D0 F7              BNE   @pch
002FB9r 2               @skip_name:
002FB9r 2  A9 20              LDA   #' '
002FBBr 2  8D 0E A0           STA   VGC_CHAROUT
002FBEr 2               
002FBEr 2                     ; Follow next
002FBEr 2  20 rr rr           JSR   proc_next
002FC1r 2  80 D6              BRA   @walk
002FC3r 2               
002FC3r 2               @done:
002FC3r 2  20 rr rr           JSR   eval_newline
002FC6r 2  4C rr rr           JMP   eval_continue
002FC9r 2               
002FC9r 2               ; ---------------------------------------------------------------------
002FC9r 2               ; do_po — PO "name: print procedure definition
002FC9r 2               ;   Arity 0 — evaluates its own argument
002FC9r 2               ; ---------------------------------------------------------------------
002FC9r 2               do_po:
002FC9r 2  20 rr rr           JSR   eval_expr
002FCCr 2  90 03              BCC   @po_type_ok
002FCEr 2  4C rr rr           JMP   @err
002FD1r 2               @po_type_ok:
002FD1r 2  A5 rr              LDA   eval_type
002FD3r 2  C9 01              CMP   #VAL_WORD
002FD5r 2  F0 03              BEQ   @po_word_ok
002FD7r 2  4C rr rr           JMP   @err
002FDAr 2               @po_word_ok:
002FDAr 2               
002FDAr 2                     ; Look up by name
002FDAr 2  A5 rr              LDA   eval_val_lo
002FDCr 2  85 rr              STA   ptr_lo
002FDEr 2  A5 rr              LDA   eval_val_hi
002FE0r 2  85 rr              STA   ptr_hi
002FE2r 2  20 rr rr           JSR   proc_find_by_name
002FE5r 2  90 03              BCC   @po_found
002FE7r 2  4C rr rr           JMP   @err_notfound
002FEAr 2               @po_found:
002FEAr 2               
002FEAr 2                     ; proc_entry_lo/hi = record
002FEAr 2                     ; Print "TO "
002FEAr 2  A9 54              LDA   #'T'
002FECr 2  8D 0E A0           STA   VGC_CHAROUT
002FEFr 2  A9 4F              LDA   #'O'
002FF1r 2  8D 0E A0           STA   VGC_CHAROUT
002FF4r 2  A9 20              LDA   #' '
002FF6r 2  8D 0E A0           STA   VGC_CHAROUT
002FF9r 2               
002FF9r 2                     ; Print name
002FF9r 2  A5 rr              LDA   proc_entry_lo
002FFBr 2  85 rr              STA   ptr_lo
002FFDr 2  A5 rr              LDA   proc_entry_hi
002FFFr 2  85 rr              STA   ptr_hi
003001r 2  A0 02              LDY   #2
003003r 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
003005r 2  AA                 TAX
003006r 2  85 rr              STA   proc_name_len
003008r 2  F0 0B              BEQ   @po_params
00300Ar 2  A0 03              LDY   #3
00300Cr 2               @po_name_ch:
00300Cr 2  B1 rr              LDA   (ptr_lo),Y
00300Er 2  8D 0E A0           STA   VGC_CHAROUT
003011r 2  C8                 INY
003012r 2  CA                 DEX
003013r 2  D0 F7              BNE   @po_name_ch
003015r 2               
003015r 2               @po_params:
003015r 2                     ; Y = 3 + name_len = offset to param_count
003015r 2  A5 rr              LDA   proc_name_len
003017r 2  18                 CLC
003018r 2  69 03              ADC   #3
00301Ar 2  A8                 TAY
00301Br 2  B1 rr              LDA   (ptr_lo),Y             ; param_count
00301Dr 2  85 rr              STA   proc_param_cnt
00301Fr 2  C8                 INY                           ; offset to first param
003020r 2  84 rr              STY   proc_rec_off
003022r 2               
003022r 2  A5 rr              LDA   proc_param_cnt
003024r 2  F0 2E              BEQ   @po_header_done
003026r 2               
003026r 2  A6 rr              LDX   proc_param_cnt
003028r 2               @po_param:
003028r 2                     ; Print " :"
003028r 2  A9 20              LDA   #' '
00302Ar 2  8D 0E A0           STA   VGC_CHAROUT
00302Dr 2  A9 3A              LDA   #':'
00302Fr 2  8D 0E A0           STA   VGC_CHAROUT
003032r 2               
003032r 2                     ; Read param name length
003032r 2  A5 rr              LDA   proc_entry_lo
003034r 2  85 rr              STA   ptr_lo
003036r 2  A5 rr              LDA   proc_entry_hi
003038r 2  85 rr              STA   ptr_hi
00303Ar 2  A4 rr              LDY   proc_rec_off
00303Cr 2  B1 rr              LDA   (ptr_lo),Y             ; param name length
00303Er 2  DA                 PHX
00303Fr 2  AA                 TAX                           ; X = chars to print
003040r 2  C8                 INY
003041r 2               @po_pch:
003041r 2  E0 00              CPX   #0
003043r 2  F0 09              BEQ   @po_param_done
003045r 2  B1 rr              LDA   (ptr_lo),Y
003047r 2  8D 0E A0           STA   VGC_CHAROUT
00304Ar 2  C8                 INY
00304Br 2  CA                 DEX
00304Cr 2  80 F3              BRA   @po_pch
00304Er 2               @po_param_done:
00304Er 2  84 rr              STY   proc_rec_off
003050r 2  FA                 PLX
003051r 2  CA                 DEX
003052r 2  D0 D4              BNE   @po_param
003054r 2               
003054r 2               @po_header_done:
003054r 2  20 rr rr           JSR   eval_newline
003057r 2               
003057r 2                     ; Read body_len
003057r 2  A5 rr              LDA   proc_entry_lo
003059r 2  85 rr              STA   ptr_lo
00305Br 2  A5 rr              LDA   proc_entry_hi
00305Dr 2  85 rr              STA   ptr_hi
00305Fr 2  A4 rr              LDY   proc_rec_off
003061r 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_lo
003063r 2  85 rr              STA   proc_body_len_lo
003065r 2  C8                 INY
003066r 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_hi
003068r 2  85 rr              STA   proc_body_len_hi
00306Ar 2  C8                 INY                           ; Y = offset to body text
00306Br 2               
00306Br 2                     ; Compute absolute pointer to body
00306Br 2  84 rr              STY   proc_rec_off
00306Dr 2  18                 CLC
00306Er 2  A5 rr              LDA   proc_entry_lo
003070r 2  65 rr              ADC   proc_rec_off
003072r 2  85 rr              STA   proc_ptr_lo
003074r 2  A5 rr              LDA   proc_entry_hi
003076r 2  69 00              ADC   #0
003078r 2  85 rr              STA   proc_ptr_hi
00307Ar 2               
00307Ar 2                     ; Print body text, converting $0A to CR+LF
00307Ar 2               @po_body:
00307Ar 2  A5 rr              LDA   proc_body_len_lo
00307Cr 2  05 rr              ORA   proc_body_len_hi
00307Er 2  F0 20              BEQ   @po_end
003080r 2               
003080r 2  A0 00              LDY   #0
003082r 2  B1 rr              LDA   (proc_ptr_lo),Y
003084r 2  C9 0A              CMP   #$0A
003086r 2  D0 05              BNE   @po_char
003088r 2  20 rr rr           JSR   eval_newline
00308Br 2  80 03              BRA   @po_advance
00308Dr 2               @po_char:
00308Dr 2  8D 0E A0           STA   VGC_CHAROUT
003090r 2               @po_advance:
003090r 2  E6 rr              INC   proc_ptr_lo
003092r 2  D0 02              BNE   :+
003094r 2  E6 rr              INC   proc_ptr_hi
003096r 2  A5 rr        :     LDA   proc_body_len_lo
003098r 2  D0 02              BNE   :+
00309Ar 2  C6 rr              DEC   proc_body_len_hi
00309Cr 2  C6 rr        :     DEC   proc_body_len_lo
00309Er 2  80 DA              BRA   @po_body
0030A0r 2               
0030A0r 2               @po_end:
0030A0r 2                     ; Print "END"
0030A0r 2  A9 45              LDA   #'E'
0030A2r 2  8D 0E A0           STA   VGC_CHAROUT
0030A5r 2  A9 4E              LDA   #'N'
0030A7r 2  8D 0E A0           STA   VGC_CHAROUT
0030AAr 2  A9 44              LDA   #'D'
0030ACr 2  8D 0E A0           STA   VGC_CHAROUT
0030AFr 2  20 rr rr           JSR   eval_newline
0030B2r 2  4C rr rr           JMP   eval_continue
0030B5r 2               
0030B5r 2               @err:
0030B5r 2  A2 rr              LDX   #<str_po_name
0030B7r 2  A0 rr              LDY   #>str_po_name
0030B9r 2  4C rr rr           JMP   err_nei
0030BCr 2               @err_notfound:
0030BCr 2  A2 rr              LDX   #<str_idk
0030BEr 2  A0 rr              LDY   #>str_idk
0030C0r 2  4C rr rr           JMP   list_print_err
0030C3r 2               
0030C3r 2               ; ---------------------------------------------------------------------
0030C3r 2               ; do_erase — ERASE "name: remove procedure from directory
0030C3r 2               ;   Arity 0 — evaluates its own argument
0030C3r 2               ; ---------------------------------------------------------------------
0030C3r 2               do_erase:
0030C3r 2  20 rr rr           JSR   eval_expr
0030C6r 2  90 03              BCC   @er_type_ok
0030C8r 2  4C rr rr           JMP   @err
0030CBr 2               @er_type_ok:
0030CBr 2  A5 rr              LDA   eval_type
0030CDr 2  C9 01              CMP   #VAL_WORD
0030CFr 2  F0 03              BEQ   @er_word_ok
0030D1r 2  4C rr rr           JMP   @err
0030D4r 2               @er_word_ok:
0030D4r 2               
0030D4r 2                     ; Save name pointer
0030D4r 2  A5 rr              LDA   eval_val_lo
0030D6r 2  85 rr              STA   var_name_lo
0030D8r 2  A5 rr              LDA   eval_val_hi
0030DAr 2  85 rr              STA   var_name_hi
0030DCr 2               
0030DCr 2                     ; Walk proc_head with prev tracking
0030DCr 2                     ; prev = address of "next" pointer to patch (starts as &proc_head)
0030DCr 2  A9 rr              LDA   #<proc_head_lo
0030DEr 2  85 rr              STA   proc_ptr_lo             ; prev_ptr_lo
0030E0r 2  A9 rr              LDA   #>proc_head_lo
0030E2r 2  85 rr              STA   proc_ptr_hi             ; prev_ptr_hi (ZP, so high byte = 0)
0030E4r 2               
0030E4r 2  A5 rr              LDA   proc_head_lo
0030E6r 2  85 rr              STA   proc_entry_lo
0030E8r 2  A5 rr              LDA   proc_head_hi
0030EAr 2  85 rr              STA   proc_entry_hi
0030ECr 2               
0030ECr 2               @walk:
0030ECr 2  A5 rr              LDA   proc_entry_lo
0030EEr 2  05 rr              ORA   proc_entry_hi
0030F0r 2  D0 03              BNE   @walk_ok
0030F2r 2  4C rr rr           JMP   @not_found
0030F5r 2               @walk_ok:
0030F5r 2               
0030F5r 2                     ; Compare name
0030F5r 2  A5 rr              LDA   var_name_lo
0030F7r 2  85 rr              STA   ptr_lo
0030F9r 2  A5 rr              LDA   var_name_hi
0030FBr 2  85 rr              STA   ptr_hi
0030FDr 2  A0 00              LDY   #0
0030FFr 2  B1 rr              LDA   (ptr_lo),Y             ; search name len
003101r 2  85 rr              STA   proc_name_len
003103r 2               
003103r 2  A5 rr              LDA   proc_entry_lo
003105r 2  85 rr              STA   ptr_lo
003107r 2  A5 rr              LDA   proc_entry_hi
003109r 2  85 rr              STA   ptr_hi
00310Br 2  A0 02              LDY   #2
00310Dr 2  B1 rr              LDA   (ptr_lo),Y             ; record name len
00310Fr 2  C5 rr              CMP   proc_name_len
003111r 2  D0 32              BNE   @erase_next
003113r 2               
003113r 2  AA                 TAX
003114r 2  F0 3C              BEQ   @erase_match            ; both empty = match
003116r 2  A0 00              LDY   #0
003118r 2               @ecmp:
003118r 2  DA                 PHX
003119r 2  5A                 PHY
00311Ar 2  A5 rr              LDA   var_name_lo
00311Cr 2  85 rr              STA   ptr_lo
00311Er 2  A5 rr              LDA   var_name_hi
003120r 2  85 rr              STA   ptr_hi
003122r 2  C8                 INY
003123r 2  B1 rr              LDA   (ptr_lo),Y             ; search char
003125r 2  85 rr              STA   proc_rec_off
003127r 2               
003127r 2  7A                 PLY
003128r 2  A5 rr              LDA   proc_entry_lo
00312Ar 2  85 rr              STA   ptr_lo
00312Cr 2  A5 rr              LDA   proc_entry_hi
00312Er 2  85 rr              STA   ptr_hi
003130r 2  5A                 PHY
003131r 2  98                 TYA
003132r 2  18                 CLC
003133r 2  69 03              ADC   #3
003135r 2  A8                 TAY
003136r 2  B1 rr              LDA   (ptr_lo),Y             ; record char
003138r 2  7A                 PLY
003139r 2  C5 rr              CMP   proc_rec_off
00313Br 2  D0 07              BNE   @ecmp_ne
00313Dr 2  FA                 PLX
00313Er 2  C8                 INY
00313Fr 2  CA                 DEX
003140r 2  D0 D6              BNE   @ecmp
003142r 2  80 0E              BRA   @erase_match
003144r 2               
003144r 2               @ecmp_ne:
003144r 2  FA                 PLX
003145r 2               
003145r 2               @erase_next:
003145r 2                     ; prev = &current->next (proc_entry + 0)
003145r 2  A5 rr              LDA   proc_entry_lo
003147r 2  85 rr              STA   proc_ptr_lo
003149r 2  A5 rr              LDA   proc_entry_hi
00314Br 2  85 rr              STA   proc_ptr_hi
00314Dr 2                     ; current = current->next
00314Dr 2  20 rr rr           JSR   proc_next
003150r 2  80 9A              BRA   @walk
003152r 2               
003152r 2               @erase_match:
003152r 2                     ; Unlink: prev->next = current->next  (read current->next once)
003152r 2  A5 rr              LDA   proc_entry_lo
003154r 2  85 rr              STA   ptr_lo
003156r 2  A5 rr              LDA   proc_entry_hi
003158r 2  85 rr              STA   ptr_hi
00315Ar 2  A0 00              LDY   #0
00315Cr 2  B1 rr              LDA   (ptr_lo),Y             ; next_lo -> X
00315Er 2  AA                 TAX
00315Fr 2  C8                 INY
003160r 2  B1 rr              LDA   (ptr_lo),Y             ; next_hi -> stack
003162r 2  48                 PHA
003163r 2  A5 rr              LDA   proc_ptr_lo            ; ptr = prev
003165r 2  85 rr              STA   ptr_lo
003167r 2  A5 rr              LDA   proc_ptr_hi
003169r 2  85 rr              STA   ptr_hi
00316Br 2  A0 00              LDY   #0
00316Dr 2  8A                 TXA
00316Er 2  91 rr              STA   (ptr_lo),Y             ; prev->next_lo = next_lo
003170r 2  C8                 INY
003171r 2  68                 PLA
003172r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_hi = next_hi
003174r 2               
003174r 2  4C rr rr           JMP   eval_continue
003177r 2               
003177r 2               @not_found:
003177r 2  A2 rr              LDX   #<str_idk
003179r 2  A0 rr              LDY   #>str_idk
00317Br 2  4C rr rr           JMP   list_print_err
00317Er 2               @err:
00317Er 2  A2 rr              LDX   #<str_erase_name
003180r 2  A0 rr              LDY   #>str_erase_name
003182r 2  4C rr rr           JMP   err_nei
003185r 2               
003185r 2               ; ---------------------------------------------------------------------
003185r 2               ; do_apply — APPLY "proc [args]: call procedure with args from list
003185r 2               ;   Arity 0 — evaluates its own arguments
003185r 2               ;   Strategy: build "name arg1 arg2 ..." in input_buf, tokenize+eval.
003185r 2               ; ---------------------------------------------------------------------
003185r 2               do_apply:
003185r 2                     ; Evaluate first arg: procedure name (quoted word)
003185r 2  20 rr rr           JSR   eval_expr
003188r 2  90 03              BCC   @ap_type_ok
00318Ar 2  4C rr rr           JMP   @err
00318Dr 2               @ap_type_ok:
00318Dr 2  A5 rr              LDA   eval_type
00318Fr 2  C9 01              CMP   #VAL_WORD
003191r 2  F0 03              BEQ   @ap_word_ok
003193r 2  4C rr rr           JMP   @err
003196r 2               @ap_word_ok:
003196r 2               
003196r 2                     ; Copy proc name to input_buf
003196r 2  A5 rr              LDA   eval_val_lo
003198r 2  85 rr              STA   ptr_lo
00319Ar 2  A5 rr              LDA   eval_val_hi
00319Cr 2  85 rr              STA   ptr_hi
00319Er 2  64 rr              STZ   z:buf_idx
0031A0r 2  A0 00              LDY   #0
0031A2r 2  B1 rr              LDA   (ptr_lo),Y             ; name length
0031A4r 2  AA                 TAX
0031A5r 2  F0 10              BEQ   @apply_args
0031A7r 2  C8                 INY
0031A8r 2               @apply_name:
0031A8r 2  B1 rr              LDA   (ptr_lo),Y
0031AAr 2  5A                 PHY
0031ABr 2  A4 rr              LDY   z:buf_idx
0031ADr 2  99 rr rr           STA   input_buf,Y
0031B0r 2  E6 rr              INC   z:buf_idx
0031B2r 2  7A                 PLY
0031B3r 2  C8                 INY
0031B4r 2  CA                 DEX
0031B5r 2  D0 F1              BNE   @apply_name
0031B7r 2               
0031B7r 2               @apply_args:
0031B7r 2                     ; Evaluate second arg: list of arguments
0031B7r 2  20 rr rr           JSR   eval_expr
0031BAr 2  B0 5B              BCS   @err
0031BCr 2  A5 rr              LDA   eval_type
0031BEr 2  C9 02              CMP   #VAL_LIST
0031C0r 2  D0 55              BNE   @err
0031C2r 2               
0031C2r 2                     ; Render list elements to input_buf (after name)
0031C2r 2                     ; eval_val_lo/hi = list head
0031C2r 2  A5 rr              LDA   eval_val_lo
0031C4r 2  05 rr              ORA   eval_val_hi
0031C6r 2  F0 11              BEQ   @apply_run              ; empty arg list, just run name
0031C8r 2               
0031C8r 2                     ; Use render_list_to_buf — it prepends space before elements
0031C8r 2                     ; but we need a space before the first arg too
0031C8r 2  A5 rr              LDA   z:buf_idx
0031CAr 2  C9 7E              CMP   #126
0031CCr 2  B0 0B              BCS   @apply_run
0031CEr 2  A8                 TAY
0031CFr 2  A9 20              LDA   #' '
0031D1r 2  99 rr rr           STA   input_buf,Y
0031D4r 2  E6 rr              INC   z:buf_idx
0031D6r 2               
0031D6r 2                     ; render_list_to_buf expects eval_val set
0031D6r 2  20 rr rr           JSR   render_list_to_buf
0031D9r 2               
0031D9r 2               @apply_run:
0031D9r 2                     ; Null-terminate
0031D9r 2  A6 rr              LDX   z:buf_idx
0031DBr 2  9E rr rr           STZ   input_buf,X
0031DEr 2               
0031DEr 2                     ; Save eval state and tokenize+eval (same pattern as do_run)
0031DEr 2  A5 rr              LDA   eval_cur_lo
0031E0r 2  48                 PHA
0031E1r 2  A5 rr              LDA   eval_cur_hi
0031E3r 2  48                 PHA
0031E4r 2  A5 rr              LDA   tok_head_lo
0031E6r 2  48                 PHA
0031E7r 2  A5 rr              LDA   tok_head_hi
0031E9r 2  48                 PHA
0031EAr 2  A5 rr              LDA   tok_tail_lo
0031ECr 2  48                 PHA
0031EDr 2  A5 rr              LDA   tok_tail_hi
0031EFr 2  48                 PHA
0031F0r 2  A5 rr              LDA   eval_in_body
0031F2r 2  48                 PHA
0031F3r 2  A5 rr              LDA   eval_reporter
0031F5r 2  48                 PHA
0031F6r 2               
0031F6r 2  20 rr rr           JSR   tokenize_line
0031F9r 2  20 rr rr           JSR   eval_line
0031FCr 2               
0031FCr 2  68                 PLA
0031FDr 2  85 rr              STA   eval_reporter
0031FFr 2  68                 PLA
003200r 2  85 rr              STA   eval_in_body
003202r 2  68                 PLA
003203r 2  85 rr              STA   tok_tail_hi
003205r 2  68                 PLA
003206r 2  85 rr              STA   tok_tail_lo
003208r 2  68                 PLA
003209r 2  85 rr              STA   tok_head_hi
00320Br 2  68                 PLA
00320Cr 2  85 rr              STA   tok_head_lo
00320Er 2  68                 PLA
00320Fr 2  85 rr              STA   eval_cur_hi
003211r 2  68                 PLA
003212r 2  85 rr              STA   eval_cur_lo
003214r 2               
003214r 2  4C rr rr           JMP   eval_continue
003217r 2               
003217r 2               @err:
003217r 2  A2 rr              LDX   #<str_apply_name
003219r 2  A0 rr              LDY   #>str_apply_name
00321Br 2  4C rr rr           JMP   err_nei
00321Er 2               
00321Er 2               ; =====================================================================
00321Er 2               ; RODATA — procedure strings
00321Er 2               ; =====================================================================
00321Er 2                     .segment "RODATA"
00061Er 2               
00061Er 2               
00061Er 2               
00061Er 2               
00061Er 2               ; Builtin name strings for workspace commands
00061Er 2               str_po_name:
00061Er 2  02 50 4F           .byte 2, "PO"
000621r 2               str_printout_name:
000621r 2  08 50 52 49        .byte 8, "PRINTOUT"
000625r 2  4E 54 4F 55  
000629r 2  54           
00062Ar 2               str_pots_name:
00062Ar 2  04 50 4F 54        .byte 4, "POTS"
00062Er 2  53           
00062Fr 2               str_printtitles_name:
00062Fr 2  0B 50 52 49        .byte 11, "PRINTTITLES"
000633r 2  4E 54 54 49  
000637r 2  54 4C 45 53  
00063Br 2               str_erase_name:
00063Br 2  05 45 52 41        .byte 5, "ERASE"
00063Fr 2  53 45        
000641r 2               str_apply_name:
000641r 2  05 41 50 50        .byte 5, "APPLY"
000645r 2  4C 59        
000647r 2               
000647r 1                     .include "gc.s"
000647r 2               ; gc.s — mark-sweep garbage collector for NovaLogo
000647r 2               ;
000647r 2               ; Allocation header (prepended by heap_alloc):
000647r 2               ;   +0: alloc_tag  (bit 7 = mark, bits 6-0 = type)
000647r 2               ;   +1: alloc_size (total size including header; 0 = use 16-bit size at +2/+3)
000647r 2               ;
000647r 2               ; Type constants (bits 6-0 of alloc_tag):
000647r 2               ATYPE_FREE   = $00
000647r 2               ATYPE_TOKEN  = $01
000647r 2               ATYPE_CONS   = $02
000647r 2               ATYPE_VAR    = $03
000647r 2               ATYPE_PROC   = $04
000647r 2               ATYPE_STRING = $05
000647r 2               
000647r 2               ; Header layout offsets (relative to allocation base, NOT payload)
000647r 2               GC_HDR_TAG   = 0
000647r 2               GC_HDR_SIZE  = 1
000647r 2               GC_HDR_BYTES = 2              ; overhead per allocation
000647r 2               
000647r 2               ; Mark bit
000647r 2               ALLOC_MARK_BIT = $80
000647r 2               
000647r 2               ; =====================================================================
000647r 2               ; ZEROPAGE segment — GC variables
000647r 2               ; =====================================================================
000647r 2                     .segment "ZEROPAGE"
000048r 2               
000048r 2  xx           gc_ptr_lo:    .res 1          ; GC walk pointer low
000049r 2  xx           gc_ptr_hi:    .res 1          ; GC walk pointer high
00004Ar 2  xx           gc_tmp_lo:    .res 1          ; GC temp low
00004Br 2  xx           gc_tmp_hi:    .res 1          ; GC temp high
00004Cr 2  xx           gc_mark_lo:   .res 1          ; node-to-mark pointer low
00004Dr 2  xx           gc_mark_hi:   .res 1          ; node-to-mark pointer high
00004Er 2               
00004Er 2               ; =====================================================================
00004Er 2               ; CODE segment — GC routines
00004Er 2               ; =====================================================================
00004Er 2                     .segment "CODE"
00321Er 2               
00321Er 2               ; ---------------------------------------------------------------------
00321Er 2               ; gc_collect — run a full mark-sweep garbage collection cycle
00321Er 2               ;   1. Clear all mark bits
00321Er 2               ;   2. Mark all reachable objects from roots
00321Er 2               ;   3. Sweep: coalesce all unmarked blocks and reset heap_ptr
00321Er 2               ;
00321Er 2               ;   Clobbers: A, X, Y, gc_ptr, gc_tmp, gc_mark, ptr_lo/hi, ptr2_lo/hi
00321Er 2               ; ---------------------------------------------------------------------
00321Er 2               gc_collect:
00321Er 2                     ; Phase 1: Clear all mark bits by walking the heap linearly
00321Er 2  A9 00              LDA   #<HEAP_START
003220r 2  85 rr              STA   gc_ptr_lo
003222r 2  A9 05              LDA   #>HEAP_START
003224r 2  85 rr              STA   gc_ptr_hi
003226r 2               
003226r 2               @clear_loop:
003226r 2                     ; Have we reached heap_ptr (end of allocated space)?
003226r 2  A5 rr              LDA   gc_ptr_hi
003228r 2  C5 rr              CMP   heap_ptr+1
00322Ar 2  90 08              BCC   @clear_one
00322Cr 2  D0 41              BNE   @clear_done
00322Er 2  A5 rr              LDA   gc_ptr_lo
003230r 2  C5 rr              CMP   heap_ptr
003232r 2  B0 3B              BCS   @clear_done
003234r 2               
003234r 2               @clear_one:
003234r 2                     ; Clear mark bit on this allocation
003234r 2  A5 rr              LDA   gc_ptr_lo
003236r 2  85 rr              STA   ptr_lo
003238r 2  A5 rr              LDA   gc_ptr_hi
00323Ar 2  85 rr              STA   ptr_hi
00323Cr 2  A0 00              LDY   #GC_HDR_TAG
00323Er 2  B1 rr              LDA   (ptr_lo),Y
003240r 2  29 7F              AND   #<~ALLOC_MARK_BIT    ; clear bit 7
003242r 2  91 rr              STA   (ptr_lo),Y
003244r 2               
003244r 2                     ; Advance by alloc_size
003244r 2  A0 01              LDY   #GC_HDR_SIZE
003246r 2  B1 rr              LDA   (ptr_lo),Y
003248r 2  F0 0B              BEQ   @clear_big           ; size=0 means 16-bit size at +2/+3
00324Ar 2  18                 CLC
00324Br 2  65 rr              ADC   gc_ptr_lo
00324Dr 2  85 rr              STA   gc_ptr_lo
00324Fr 2  90 D5              BCC   @clear_loop
003251r 2  E6 rr              INC   gc_ptr_hi
003253r 2  80 D1              BRA   @clear_loop
003255r 2               
003255r 2               @clear_big:
003255r 2                     ; 16-bit size at payload offset 0 and 1 (header +2 and +3)
003255r 2  A0 02              LDY   #GC_HDR_BYTES
003257r 2  B1 rr              LDA   (ptr_lo),Y
003259r 2  85 rr              STA   gc_tmp_lo
00325Br 2  C8                 INY
00325Cr 2  B1 rr              LDA   (ptr_lo),Y
00325Er 2  85 rr              STA   gc_tmp_hi
003260r 2  18                 CLC
003261r 2  A5 rr              LDA   gc_ptr_lo
003263r 2  65 rr              ADC   gc_tmp_lo
003265r 2  85 rr              STA   gc_ptr_lo
003267r 2  A5 rr              LDA   gc_ptr_hi
003269r 2  65 rr              ADC   gc_tmp_hi
00326Br 2  85 rr              STA   gc_ptr_hi
00326Dr 2  80 B7              BRA   @clear_loop
00326Fr 2               
00326Fr 2               @clear_done:
00326Fr 2               
00326Fr 2                     ; Phase 2: Mark all reachable objects
00326Fr 2                     ; Root 1: variable list (var_head)
00326Fr 2  20 rr rr           JSR   gc_mark_vars
003272r 2               
003272r 2                     ; Root 2: procedure list (proc_head)
003272r 2  20 rr rr           JSR   gc_mark_procs
003275r 2               
003275r 2                     ; Root 3: current token list (tok_head)
003275r 2  20 rr rr           JSR   gc_mark_token_list
003278r 2               
003278r 2                     ; Phase 3: Sweep — find the highest marked allocation,
003278r 2                     ; reset heap_ptr to just past it. This works because we
003278r 2                     ; use a bump allocator with no free list; all unmarked
003278r 2                     ; allocations between marked ones become wasted space,
003278r 2                     ; but in practice the permanent objects (vars, procs) are
003278r 2                     ; allocated early and the ephemeral ones (tokens, cons,
003278r 2                     ; strings) are allocated later and all unmarked — so
003278r 2                     ; heap_ptr shrinks back dramatically.
003278r 2                     ;
003278r 2                     ; Walk the heap forward; track the highest end-address
003278r 2                     ; of any marked allocation.
003278r 2  A9 00              LDA   #<HEAP_START
00327Ar 2  85 rr              STA   gc_ptr_lo
00327Cr 2  A9 05              LDA   #>HEAP_START
00327Er 2  85 rr              STA   gc_ptr_hi
003280r 2                     ; gc_tmp = highest marked end (start at HEAP_START = nothing marked)
003280r 2  A9 00              LDA   #<HEAP_START
003282r 2  85 rr              STA   gc_tmp_lo
003284r 2  A9 05              LDA   #>HEAP_START
003286r 2  85 rr              STA   gc_tmp_hi
003288r 2               
003288r 2               @sweep_loop:
003288r 2                     ; Reached end of allocated space?
003288r 2  A5 rr              LDA   gc_ptr_hi
00328Ar 2  C5 rr              CMP   heap_ptr+1
00328Cr 2  90 08              BCC   @sweep_one
00328Er 2  D0 49              BNE   @sweep_done
003290r 2  A5 rr              LDA   gc_ptr_lo
003292r 2  C5 rr              CMP   heap_ptr
003294r 2  B0 43              BCS   @sweep_done
003296r 2               
003296r 2               @sweep_one:
003296r 2  A5 rr              LDA   gc_ptr_lo
003298r 2  85 rr              STA   ptr_lo
00329Ar 2  A5 rr              LDA   gc_ptr_hi
00329Cr 2  85 rr              STA   ptr_hi
00329Er 2               
00329Er 2                     ; Get size of this allocation
00329Er 2  A0 01              LDY   #GC_HDR_SIZE
0032A0r 2  B1 rr              LDA   (ptr_lo),Y
0032A2r 2  F0 06              BEQ   @sweep_big
0032A4r 2  85 rr              STA   gc_mark_lo            ; use gc_mark_lo as temp for size
0032A6r 2  64 rr              STZ   gc_mark_hi
0032A8r 2  80 0B              BRA   @sweep_check_mark
0032AAr 2               
0032AAr 2               @sweep_big:
0032AAr 2  A0 02              LDY   #GC_HDR_BYTES
0032ACr 2  B1 rr              LDA   (ptr_lo),Y
0032AEr 2  85 rr              STA   gc_mark_lo
0032B0r 2  C8                 INY
0032B1r 2  B1 rr              LDA   (ptr_lo),Y
0032B3r 2  85 rr              STA   gc_mark_hi
0032B5r 2               
0032B5r 2               @sweep_check_mark:
0032B5r 2                     ; Is this allocation marked?
0032B5r 2  A0 00              LDY   #GC_HDR_TAG
0032B7r 2  B1 rr              LDA   (ptr_lo),Y
0032B9r 2  29 80              AND   #ALLOC_MARK_BIT
0032BBr 2  F0 0D              BEQ   @sweep_advance        ; not marked — skip
0032BDr 2               
0032BDr 2                     ; Marked — compute end address = gc_ptr + size
0032BDr 2  18                 CLC
0032BEr 2  A5 rr              LDA   gc_ptr_lo
0032C0r 2  65 rr              ADC   gc_mark_lo
0032C2r 2  85 rr              STA   gc_tmp_lo             ; update highest end
0032C4r 2  A5 rr              LDA   gc_ptr_hi
0032C6r 2  65 rr              ADC   gc_mark_hi
0032C8r 2  85 rr              STA   gc_tmp_hi
0032CAr 2               
0032CAr 2               @sweep_advance:
0032CAr 2                     ; Advance gc_ptr by size
0032CAr 2  18                 CLC
0032CBr 2  A5 rr              LDA   gc_ptr_lo
0032CDr 2  65 rr              ADC   gc_mark_lo
0032CFr 2  85 rr              STA   gc_ptr_lo
0032D1r 2  A5 rr              LDA   gc_ptr_hi
0032D3r 2  65 rr              ADC   gc_mark_hi
0032D5r 2  85 rr              STA   gc_ptr_hi
0032D7r 2  80 AF              BRA   @sweep_loop
0032D9r 2               
0032D9r 2               @sweep_done:
0032D9r 2                     ; Set heap_ptr to highest marked end
0032D9r 2  A5 rr              LDA   gc_tmp_lo
0032DBr 2  85 rr              STA   heap_ptr
0032DDr 2  A5 rr              LDA   gc_tmp_hi
0032DFr 2  85 rr              STA   heap_ptr+1
0032E1r 2  60                 RTS
0032E2r 2               
0032E2r 2               ; ---------------------------------------------------------------------
0032E2r 2               ; gc_mark_node — mark a single allocation given a payload pointer
0032E2r 2               ;   Input: gc_mark_lo/hi = pointer to payload (header is at -2)
0032E2r 2               ;   If pointer is $0000 or below HEAP_START, skip.
0032E2r 2               ;   Clobbers: A, Y (preserves gc_mark_lo/hi)
0032E2r 2               ; ---------------------------------------------------------------------
0032E2r 2               gc_mark_node:
0032E2r 2                     ; Null check
0032E2r 2  A5 rr              LDA   gc_mark_lo
0032E4r 2  05 rr              ORA   gc_mark_hi
0032E6r 2  F0 21              BEQ   @done
0032E8r 2               
0032E8r 2                     ; Compute header address = payload - 2
0032E8r 2  A5 rr              LDA   gc_mark_lo
0032EAr 2  38                 SEC
0032EBr 2  E9 02              SBC   #GC_HDR_BYTES
0032EDr 2  85 rr              STA   ptr_lo
0032EFr 2  A5 rr              LDA   gc_mark_hi
0032F1r 2  E9 00              SBC   #0
0032F3r 2  85 rr              STA   ptr_hi
0032F5r 2               
0032F5r 2                     ; Range check: must be >= HEAP_START
0032F5r 2  C9 05              CMP   #>HEAP_START
0032F7r 2  90 10              BCC   @done
0032F9r 2  D0 06              BNE   @in_range
0032FBr 2  A5 rr              LDA   ptr_lo
0032FDr 2  C9 00              CMP   #<HEAP_START
0032FFr 2  90 08              BCC   @done
003301r 2               @in_range:
003301r 2               
003301r 2                     ; Set mark bit
003301r 2  A0 00              LDY   #GC_HDR_TAG
003303r 2  B1 rr              LDA   (ptr_lo),Y
003305r 2  09 80              ORA   #ALLOC_MARK_BIT
003307r 2  91 rr              STA   (ptr_lo),Y
003309r 2               @done:
003309r 2  60                 RTS
00330Ar 2               
00330Ar 2               ; ---------------------------------------------------------------------
00330Ar 2               ; gc_mark_vars — walk the variable linked list and mark each entry
00330Ar 2               ;   Also marks any list values pointed to by variables.
00330Ar 2               ;   Clobbers: A, X, Y, gc_ptr, gc_mark, ptr_lo/hi, ptr2_lo/hi
00330Ar 2               ; ---------------------------------------------------------------------
00330Ar 2               gc_mark_vars:
00330Ar 2  A5 rr              LDA   var_head_lo
00330Cr 2  85 rr              STA   gc_ptr_lo
00330Er 2  A5 rr              LDA   var_head_hi
003310r 2  85 rr              STA   gc_ptr_hi
003312r 2               
003312r 2               @walk:
003312r 2  A5 rr              LDA   gc_ptr_lo
003314r 2  05 rr              ORA   gc_ptr_hi
003316r 2  D0 01              BNE   @have_var
003318r 2  60                 RTS
003319r 2               @have_var:
003319r 2               
003319r 2                     ; Mark this var entry
003319r 2  A5 rr              LDA   gc_ptr_lo
00331Br 2  85 rr              STA   gc_mark_lo
00331Dr 2  A5 rr              LDA   gc_ptr_hi
00331Fr 2  85 rr              STA   gc_mark_hi
003321r 2  20 rr rr           JSR   gc_mark_node
003324r 2               
003324r 2                     ; Read the variable's value — if it's a list, mark the list
003324r 2  A5 rr              LDA   gc_ptr_lo
003326r 2  85 rr              STA   ptr_lo
003328r 2  A5 rr              LDA   gc_ptr_hi
00332Ar 2  85 rr              STA   ptr_hi
00332Cr 2  A0 02              LDY   #VAR_NAME_LEN
00332Er 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
003330r 2  18                 CLC
003331r 2  69 03              ADC   #VAR_NAME             ; offset to value_type
003333r 2  A8                 TAY
003334r 2  B1 rr              LDA   (ptr_lo),Y           ; value_type
003336r 2  C9 02              CMP   #VAL_LIST
003338r 2  D0 23              BNE   @var_check_word
00333Ar 2                     ; It's a list — get the list head pointer and mark the list
00333Ar 2  C8                 INY
00333Br 2  B1 rr              LDA   (ptr_lo),Y           ; val_hi (actually car_hi)
00333Dr 2  85 rr              STA   gc_tmp_hi
00333Fr 2  C8                 INY
003340r 2  B1 rr              LDA   (ptr_lo),Y           ; val_lo
003342r 2  85 rr              STA   gc_tmp_lo
003344r 2                     ; Save gc_ptr across recursive mark
003344r 2  A5 rr              LDA   gc_ptr_lo
003346r 2  48                 PHA
003347r 2  A5 rr              LDA   gc_ptr_hi
003349r 2  48                 PHA
00334Ar 2  A5 rr              LDA   gc_tmp_lo
00334Cr 2  85 rr              STA   gc_mark_lo
00334Er 2  A5 rr              LDA   gc_tmp_hi
003350r 2  85 rr              STA   gc_mark_hi
003352r 2  20 rr rr           JSR   gc_mark_list
003355r 2  68                 PLA
003356r 2  85 rr              STA   gc_ptr_hi
003358r 2  68                 PLA
003359r 2  85 rr              STA   gc_ptr_lo
00335Br 2  80 25              BRA   @var_next
00335Dr 2               
00335Dr 2               @var_check_word:
00335Dr 2  C9 01              CMP   #VAL_WORD
00335Fr 2  D0 21              BNE   @var_next
003361r 2                     ; It's a word — mark the string allocation
003361r 2  C8                 INY
003362r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_hi for word
003364r 2  85 rr              STA   gc_tmp_hi
003366r 2  C8                 INY
003367r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_lo for word
003369r 2  85 rr              STA   gc_tmp_lo
00336Br 2  A5 rr              LDA   gc_ptr_lo
00336Dr 2  48                 PHA
00336Er 2  A5 rr              LDA   gc_ptr_hi
003370r 2  48                 PHA
003371r 2  A5 rr              LDA   gc_tmp_lo
003373r 2  85 rr              STA   gc_mark_lo
003375r 2  A5 rr              LDA   gc_tmp_hi
003377r 2  85 rr              STA   gc_mark_hi
003379r 2  20 rr rr           JSR   gc_mark_node
00337Cr 2  68                 PLA
00337Dr 2  85 rr              STA   gc_ptr_hi
00337Fr 2  68                 PLA
003380r 2  85 rr              STA   gc_ptr_lo
003382r 2               
003382r 2               @var_next:
003382r 2                     ; Follow next pointer
003382r 2  A5 rr              LDA   gc_ptr_lo
003384r 2  85 rr              STA   ptr_lo
003386r 2  A5 rr              LDA   gc_ptr_hi
003388r 2  85 rr              STA   ptr_hi
00338Ar 2  A0 00              LDY   #VAR_NEXT_LO
00338Cr 2  B1 rr              LDA   (ptr_lo),Y
00338Er 2  AA                 TAX
00338Fr 2  C8                 INY
003390r 2  B1 rr              LDA   (ptr_lo),Y
003392r 2  85 rr              STA   gc_ptr_hi
003394r 2  86 rr              STX   gc_ptr_lo
003396r 2  4C rr rr           JMP   @walk
003399r 2               
003399r 2               ; ---------------------------------------------------------------------
003399r 2               ; gc_mark_procs — walk the procedure list and mark each record
003399r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
003399r 2               ; ---------------------------------------------------------------------
003399r 2               gc_mark_procs:
003399r 2  A5 rr              LDA   proc_head_lo
00339Br 2  85 rr              STA   gc_ptr_lo
00339Dr 2  A5 rr              LDA   proc_head_hi
00339Fr 2  85 rr              STA   gc_ptr_hi
0033A1r 2               
0033A1r 2               @walk:
0033A1r 2  A5 rr              LDA   gc_ptr_lo
0033A3r 2  05 rr              ORA   gc_ptr_hi
0033A5r 2  F0 2B              BEQ   @done
0033A7r 2               
0033A7r 2                     ; Mark this procedure record.
0033A7r 2                     ; proc_entry points to record data (base+4); header is at base+0.
0033A7r 2                     ; Subtract 4 to get the header address for marking.
0033A7r 2  A5 rr              LDA   gc_ptr_lo
0033A9r 2  38                 SEC
0033AAr 2  E9 04              SBC   #4
0033ACr 2  85 rr              STA   ptr_lo
0033AEr 2  A5 rr              LDA   gc_ptr_hi
0033B0r 2  E9 00              SBC   #0
0033B2r 2  85 rr              STA   ptr_hi
0033B4r 2                     ; Set mark bit directly at the header
0033B4r 2  A0 00              LDY   #GC_HDR_TAG
0033B6r 2  B1 rr              LDA   (ptr_lo),Y
0033B8r 2  09 80              ORA   #ALLOC_MARK_BIT
0033BAr 2  91 rr              STA   (ptr_lo),Y
0033BCr 2               
0033BCr 2                     ; Follow next pointer (at record data offset 0)
0033BCr 2  A5 rr              LDA   gc_ptr_lo
0033BEr 2  85 rr              STA   ptr_lo
0033C0r 2  A5 rr              LDA   gc_ptr_hi
0033C2r 2  85 rr              STA   ptr_hi
0033C4r 2  A0 00              LDY   #0                    ; next_lo at offset 0
0033C6r 2  B1 rr              LDA   (ptr_lo),Y
0033C8r 2  AA                 TAX
0033C9r 2  C8                 INY
0033CAr 2  B1 rr              LDA   (ptr_lo),Y
0033CCr 2  85 rr              STA   gc_ptr_hi
0033CEr 2  86 rr              STX   gc_ptr_lo
0033D0r 2  80 CF              BRA   @walk
0033D2r 2               
0033D2r 2               @done:
0033D2r 2  60                 RTS
0033D3r 2               
0033D3r 2               ; ---------------------------------------------------------------------
0033D3r 2               ; gc_mark_token_list — walk tok_head linked list and mark each token
0033D3r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
0033D3r 2               ; ---------------------------------------------------------------------
0033D3r 2               gc_mark_token_list:
0033D3r 2  A5 rr              LDA   tok_head_lo
0033D5r 2  85 rr              STA   gc_ptr_lo
0033D7r 2  A5 rr              LDA   tok_head_hi
0033D9r 2  85 rr              STA   gc_ptr_hi
0033DBr 2               
0033DBr 2               @walk:
0033DBr 2  A5 rr              LDA   gc_ptr_lo
0033DDr 2  05 rr              ORA   gc_ptr_hi
0033DFr 2  F0 21              BEQ   @done
0033E1r 2               
0033E1r 2                     ; Mark this token
0033E1r 2  A5 rr              LDA   gc_ptr_lo
0033E3r 2  85 rr              STA   gc_mark_lo
0033E5r 2  A5 rr              LDA   gc_ptr_hi
0033E7r 2  85 rr              STA   gc_mark_hi
0033E9r 2  20 rr rr           JSR   gc_mark_node
0033ECr 2               
0033ECr 2                     ; Follow next pointer (at payload offsets TOK_NEXT_LO/HI)
0033ECr 2  A5 rr              LDA   gc_ptr_lo
0033EEr 2  85 rr              STA   ptr_lo
0033F0r 2  A5 rr              LDA   gc_ptr_hi
0033F2r 2  85 rr              STA   ptr_hi
0033F4r 2  A0 01              LDY   #TOK_NEXT_LO
0033F6r 2  B1 rr              LDA   (ptr_lo),Y
0033F8r 2  AA                 TAX
0033F9r 2  C8                 INY
0033FAr 2  B1 rr              LDA   (ptr_lo),Y
0033FCr 2  85 rr              STA   gc_ptr_hi
0033FEr 2  86 rr              STX   gc_ptr_lo
003400r 2  80 D9              BRA   @walk
003402r 2               
003402r 2               @done:
003402r 2  60                 RTS
003403r 2               
003403r 2               ; ---------------------------------------------------------------------
003403r 2               ; gc_mark_list — recursively mark a cons-pair list
003403r 2               ;   Input: gc_mark_lo/hi = head cons pair pointer (payload)
003403r 2               ;   Marks each cons cell, and recursively marks sublists and word strings.
003403r 2               ;   Clobbers: A, X, Y, gc_mark, gc_ptr, ptr_lo/hi
003403r 2               ; ---------------------------------------------------------------------
003403r 2               gc_mark_list:
003403r 2                     ; Use gc_ptr to walk the list, gc_mark for marking
003403r 2  A5 rr              LDA   gc_mark_lo
003405r 2  85 rr              STA   gc_ptr_lo
003407r 2  A5 rr              LDA   gc_mark_hi
003409r 2  85 rr              STA   gc_ptr_hi
00340Br 2               
00340Br 2               @walk:
00340Br 2  A5 rr              LDA   gc_ptr_lo
00340Dr 2  05 rr              ORA   gc_ptr_hi
00340Fr 2  F0 70              BEQ   @done
003411r 2               
003411r 2                     ; Mark this cons pair
003411r 2  A5 rr              LDA   gc_ptr_lo
003413r 2  85 rr              STA   gc_mark_lo
003415r 2  A5 rr              LDA   gc_ptr_hi
003417r 2  85 rr              STA   gc_mark_hi
003419r 2  20 rr rr           JSR   gc_mark_node
00341Cr 2               
00341Cr 2                     ; Check car_type: if list, recursively mark sublist
00341Cr 2                     ; if word, mark the string
00341Cr 2  A5 rr              LDA   gc_ptr_lo
00341Er 2  85 rr              STA   ptr_lo
003420r 2  A5 rr              LDA   gc_ptr_hi
003422r 2  85 rr              STA   ptr_hi
003424r 2  A0 01              LDY   #CONS_CAR_TYPE
003426r 2  B1 rr              LDA   (ptr_lo),Y
003428r 2  C9 02              CMP   #VAL_LIST
00342Ar 2  F0 23              BEQ   @car_list
00342Cr 2  C9 01              CMP   #VAL_WORD
00342Er 2  F0 02              BEQ   @car_word
003430r 2  80 38              BRA   @follow_cdr
003432r 2               
003432r 2               @car_word:
003432r 2                     ; Mark the word string allocation
003432r 2  A0 03              LDY   #CONS_CAR_LO
003434r 2  B1 rr              LDA   (ptr_lo),Y
003436r 2  85 rr              STA   gc_mark_lo
003438r 2  A0 02              LDY   #CONS_CAR_HI
00343Ar 2  B1 rr              LDA   (ptr_lo),Y
00343Cr 2  85 rr              STA   gc_mark_hi
00343Er 2                     ; Save gc_ptr across mark
00343Er 2  A5 rr              LDA   gc_ptr_lo
003440r 2  48                 PHA
003441r 2  A5 rr              LDA   gc_ptr_hi
003443r 2  48                 PHA
003444r 2  20 rr rr           JSR   gc_mark_node
003447r 2  68                 PLA
003448r 2  85 rr              STA   gc_ptr_hi
00344Ar 2  68                 PLA
00344Br 2  85 rr              STA   gc_ptr_lo
00344Dr 2  80 1B              BRA   @follow_cdr
00344Fr 2               
00344Fr 2               @car_list:
00344Fr 2                     ; Recursively mark the sublist
00344Fr 2  A0 03              LDY   #CONS_CAR_LO
003451r 2  B1 rr              LDA   (ptr_lo),Y
003453r 2  85 rr              STA   gc_mark_lo
003455r 2  A0 02              LDY   #CONS_CAR_HI
003457r 2  B1 rr              LDA   (ptr_lo),Y
003459r 2  85 rr              STA   gc_mark_hi
00345Br 2                     ; Save gc_ptr across recursive call
00345Br 2  A5 rr              LDA   gc_ptr_lo
00345Dr 2  48                 PHA
00345Er 2  A5 rr              LDA   gc_ptr_hi
003460r 2  48                 PHA
003461r 2  20 rr rr           JSR   gc_mark_list          ; recursive
003464r 2  68                 PLA
003465r 2  85 rr              STA   gc_ptr_hi
003467r 2  68                 PLA
003468r 2  85 rr              STA   gc_ptr_lo
00346Ar 2               
00346Ar 2               @follow_cdr:
00346Ar 2                     ; Follow cdr to next cons pair
00346Ar 2  A5 rr              LDA   gc_ptr_lo
00346Cr 2  85 rr              STA   ptr_lo
00346Er 2  A5 rr              LDA   gc_ptr_hi
003470r 2  85 rr              STA   ptr_hi
003472r 2  A0 05              LDY   #CONS_CDR_LO
003474r 2  B1 rr              LDA   (ptr_lo),Y
003476r 2  AA                 TAX
003477r 2  A0 06              LDY   #CONS_CDR_HI
003479r 2  B1 rr              LDA   (ptr_lo),Y
00347Br 2  85 rr              STA   gc_ptr_hi
00347Dr 2  86 rr              STX   gc_ptr_lo
00347Fr 2  80 8A              BRA   @walk
003481r 2               
003481r 2               @done:
003481r 2  60                 RTS
003482r 2               
003482r 1               
003482r 1               ; =====================================================================
003482r 1               ; ZEROPAGE segment — interpreter zero-page variables
003482r 1               ; =====================================================================
003482r 1                     .segment "ZEROPAGE"
00004Er 1               
00004Er 1  xx           buf_idx:      .res 1          ; current position in input_buf
00004Fr 1               
00004Fr 1               ; =====================================================================
00004Fr 1               ; BSS segment — runtime buffers
00004Fr 1               ; =====================================================================
00004Fr 1                     .segment "BSS"
000984r 1               
000984r 1  xx xx xx xx  input_buf:    .res 128        ; input line buffer
000988r 1  xx xx xx xx  
00098Cr 1  xx xx xx xx  
000A04r 1               
000A04r 1               ; =====================================================================
000A04r 1               ; CODE segment — cold start and main loop
000A04r 1               ; =====================================================================
000A04r 1                     .segment "CODE"
003482r 1               
003482r 1               cold_start:
003482r 1                     ; Copy extension ROM trampoline to RAM
003482r 1  A2 0D              LDX   #EXT_TRAMP_SIZE-1
003484r 1               @copy_tramp:
003484r 1  BD rr rr           LDA   ext_tramp_src,X
003487r 1  9D 70 02           STA   EXT_TRAMPOLINE,X
00348Ar 1  CA                 DEX
00348Br 1  10 F7              BPL   @copy_tramp
00348Dr 1               
00348Dr 1                     ; Tell the resident paged-library loader which ROM bank to restore after
00348Dr 1                     ; a module call returns (lib_call swaps back to LIB_HOME_BANK).
00348Dr 1  A9 05              LDA   #ROMSWAP_LOGO
00348Fr 1  8D 17 03           STA   LIB_HOME_BANK
003492r 1               
003492r 1                     ; At boot the runtime's own extension IS in bank 1 (loaded by NovaHost /
003492r 1                     ; the emulator). Seed LIB_RESIDENT=$FF so legacy ext commands take the cheap
003492r 1                     ; HIT path in ensure_ext_resident until a lib_call(MODULE) clobbers bank 1.
003492r 1  A9 FF              LDA   #LIB_RESIDENT_HOSTEXT
003494r 1  8D 18 03           STA   LIB_RESIDENT
003497r 1               
003497r 1                     ; Zero NovaLogo turtle/graphics state ($9F00..$9F1F) so each session starts
003497r 1                     ; in a known mode. The extension pins its turtle state here (extension.s
003497r 1                     ; TURTLE_STATE_BASE=$9F00); RAM is stale across soft-reboot on HW, and a
003497r 1                     ; stale graphics-mode/inited flag breaks auto-switch and re-init.
003497r 1  A2 1F              LDX   #$1F
003499r 1               @zero_turtle:
003499r 1  9E 00 9F           STZ   $9F00,X
00349Cr 1  CA                 DEX
00349Dr 1  10 FA              BPL   @zero_turtle
00349Fr 1               
00349Fr 1  20 rr rr           JSR   heap_init
0034A2r 1  20 rr rr           JSR   var_init
0034A5r 1  20 rr rr           JSR   proc_init
0034A8r 1  64 rr              STZ   catch_active
0034AAr 1  9C 0A A0           STZ   VGC_CURSEN
0034ADr 1  20 rr rr           JSR   print_banner
0034B0r 1  20 rr rr           JSR   print_prompt
0034B3r 1               
0034B3r 1               main_loop:
0034B3r 1  20 rr rr           JSR   read_line
0034B6r 1  9C 0A A0           STZ   VGC_CURSEN
0034B9r 1  20 rr rr           JSR   tokenize_line
0034BCr 1  20 rr rr           JSR   check_to_command
0034BFr 1  B0 03              BCS   @was_to               ; carry set = TO was handled
0034C1r 1  20 rr rr           JSR   eval_line
0034C4r 1               @was_to:
0034C4r 1                     ; Reclaim dead heap objects (tokens, list cells, etc.)
0034C4r 1  20 rr rr           JSR   gc_collect
0034C7r 1  20 rr rr           JSR   print_prompt
0034CAr 1  80 E7              BRA   main_loop
0034CCr 1               
0034CCr 1               ; ---------------------------------------------------------------------
0034CCr 1               ; check_to_command — if the first token is TO / EDIT / ED, handle it as a
0034CCr 1               ;   procedure-definition command (TO collects a new proc; EDIT/ED reopen an
0034CCr 1               ;   existing one in the editor).
0034CCr 1               ;   Output: carry set = handled, carry clear = not a definition command.
0034CCr 1               ;   Clobbers: A, Y, ptr_lo/hi, eval_cur
0034CCr 1               ; ---------------------------------------------------------------------
0034CCr 1               check_to_command:
0034CCr 1  A5 rr              LDA   tok_head_lo
0034CEr 1  05 rr              ORA   tok_head_hi
0034D0r 1  F0 5A              BEQ   @not_to
0034D2r 1               
0034D2r 1                     ; First token must be TOK_WORD
0034D2r 1  A5 rr              LDA   tok_head_lo
0034D4r 1  85 rr              STA   ptr_lo
0034D6r 1  A5 rr              LDA   tok_head_hi
0034D8r 1  85 rr              STA   ptr_hi
0034DAr 1  A0 00              LDY   #TOK_TAG
0034DCr 1  B1 rr              LDA   (ptr_lo),Y
0034DEr 1  C9 01              CMP   #TOK_WORD
0034E0r 1  D0 4A              BNE   @not_to
0034E2r 1               
0034E2r 1  A0 03              LDY   #TOK_PAYLOAD
0034E4r 1  B1 rr              LDA   (ptr_lo),Y           ; word length
0034E6r 1  C9 02              CMP   #2
0034E8r 1  F0 06              BEQ   @len2
0034EAr 1  C9 04              CMP   #4
0034ECr 1  F0 19              BEQ   @len4
0034EEr 1  80 3C              BRA   @not_to
0034F0r 1               
0034F0r 1               @len2:
0034F0r 1  A0 04              LDY   #TOK_PAYLOAD+1
0034F2r 1  B1 rr              LDA   (ptr_lo),Y
0034F4r 1  C9 54              CMP   #'T'
0034F6r 1  D0 34              BNE   @not_to
0034F8r 1  C8                 INY
0034F9r 1  B1 rr              LDA   (ptr_lo),Y
0034FBr 1  C9 4F              CMP   #'O'
0034FDr 1  D0 2D              BNE   @not_to
0034FFr 1                     ; "TO" — collect a new procedure
0034FFr 1  20 rr rr           JSR   @set_cur
003502r 1  20 rr rr           JSR   proc_collect
003505r 1  38                 SEC
003506r 1  60                 RTS
003507r 1               @len4:
003507r 1  A0 04              LDY   #TOK_PAYLOAD+1
003509r 1  B1 rr              LDA   (ptr_lo),Y
00350Br 1  C9 45              CMP   #'E'
00350Dr 1  D0 1D              BNE   @not_to
00350Fr 1  C8                 INY
003510r 1  B1 rr              LDA   (ptr_lo),Y
003512r 1  C9 44              CMP   #'D'
003514r 1  D0 16              BNE   @not_to
003516r 1  C8                 INY
003517r 1  B1 rr              LDA   (ptr_lo),Y
003519r 1  C9 49              CMP   #'I'
00351Br 1  D0 0F              BNE   @not_to
00351Dr 1  C8                 INY
00351Er 1  B1 rr              LDA   (ptr_lo),Y
003520r 1  C9 54              CMP   #'T'
003522r 1  D0 08              BNE   @not_to
003524r 1                     ; "EDIT" — edit
003524r 1  20 rr rr           JSR   @set_cur
003527r 1  20 rr rr           JSR   proc_edit
00352Ar 1  38                 SEC
00352Br 1  60                 RTS
00352Cr 1               
00352Cr 1               @not_to:
00352Cr 1  18                 CLC
00352Dr 1  60                 RTS
00352Er 1               
00352Er 1               @set_cur:
00352Er 1                     ; eval_cur = first token, then advance past it to the name token
00352Er 1  A5 rr              LDA   tok_head_lo
003530r 1  85 rr              STA   eval_cur_lo
003532r 1  A5 rr              LDA   tok_head_hi
003534r 1  85 rr              STA   eval_cur_hi
003536r 1  4C rr rr           JMP   eval_advance         ; ends with RTS
003539r 1               
003539r 1               ; ---------------------------------------------------------------------
003539r 1               ; read_line — read a line of input into input_buf, null-terminated
003539r 1               ;   On return: input_buf contains the line, buf_idx = length
003539r 1               ; ---------------------------------------------------------------------
003539r 1               read_line:
003539r 1  64 rr              STZ   buf_idx            ; reset buffer index to 0
00353Br 1  A9 01              LDA   #$01
00353Dr 1  8D 0A A0           STA   VGC_CURSEN
003540r 1               
003540r 1               @poll:
003540r 1  AD 0F A0           LDA   VGC_CHARIN         ; poll keyboard
003543r 1  F0 FB              BEQ   @poll              ; no key waiting — spin
003545r 1               
003545r 1                     ; --- handle CR ($0D) ---
003545r 1  C9 0D              CMP   #$0D
003547r 1  D0 39              BNE   @not_cr
003549r 1                     ; End of a typed line. If brackets/parens are still open, keep reading so
003549r 1                     ; a multi-line statement can be entered right at the prompt.
003549r 1  20 rr rr           JSR   line_bracket_depth
00354Cr 1  F0 24              BEQ   @cr_finish
00354Er 1  A6 rr              LDX   buf_idx
003550r 1  E0 78              CPX   #120
003552r 1  B0 1E              BCS   @cr_finish         ; buffer nearly full — stop accumulating
003554r 1  A9 0A              LDA   #$0A               ; newline separator (tokenizer treats it as space)
003556r 1  9D rr rr           STA   input_buf,X
003559r 1  E6 rr              INC   buf_idx
00355Br 1  A9 0D              LDA   #$0D
00355Dr 1  8D 0E A0           STA   VGC_CHAROUT
003560r 1  A9 0A              LDA   #$0A
003562r 1  8D 0E A0           STA   VGC_CHAROUT
003565r 1  A9 7E              LDA   #'~'               ; continuation prompt
003567r 1  8D 0E A0           STA   VGC_CHAROUT
00356Ar 1  A9 20              LDA   #' '
00356Cr 1  8D 0E A0           STA   VGC_CHAROUT
00356Fr 1  4C rr rr           JMP   @poll
003572r 1               @cr_finish:
003572r 1  A6 rr              LDX   buf_idx
003574r 1  9E rr rr           STZ   input_buf,X        ; null-terminate
003577r 1  A9 0D              LDA   #$0D
003579r 1  8D 0E A0           STA   VGC_CHAROUT        ; carriage return
00357Cr 1  A9 0A              LDA   #$0A
00357Er 1  8D 0E A0           STA   VGC_CHAROUT        ; line feed
003581r 1  60                 RTS
003582r 1               
003582r 1               @not_cr:
003582r 1                     ; --- handle backspace ($08, $14, $7F) ---
003582r 1  C9 08              CMP   #$08
003584r 1  F0 18              BEQ   @backspace
003586r 1  C9 14              CMP   #$14
003588r 1  F0 14              BEQ   @backspace
00358Ar 1  C9 7F              CMP   #$7F
00358Cr 1  F0 10              BEQ   @backspace
00358Er 1               
00358Er 1                     ; --- buffer full? ---
00358Er 1  A6 rr              LDX   buf_idx
003590r 1  E0 7F              CPX   #127
003592r 1  B0 AC              BCS   @poll              ; at capacity — ignore keystroke
003594r 1               
003594r 1                     ; --- store and echo printable character ---
003594r 1  9D rr rr           STA   input_buf,X        ; store in buffer
003597r 1  8D 0E A0           STA   VGC_CHAROUT        ; echo to screen
00359Ar 1  E6 rr              INC   buf_idx
00359Cr 1  80 A2              BRA   @poll
00359Er 1               
00359Er 1               @backspace:
00359Er 1  A6 rr              LDX   buf_idx
0035A0r 1  F0 9E              BEQ   @poll              ; nothing to delete — ignore
0035A2r 1  CA                 DEX
0035A3r 1  86 rr              STX   buf_idx
0035A5r 1  A9 08              LDA   #$08
0035A7r 1  8D 0E A0           STA   VGC_CHAROUT        ; move cursor left and erase
0035AAr 1  80 94              BRA   @poll
0035ACr 1               
0035ACr 1               ; ---------------------------------------------------------------------
0035ACr 1               ; line_bracket_depth — net count of unclosed '[' and '(' in input_buf[0..buf_idx),
0035ACr 1               ;   ignoring text inside ';' comments. Returns depth in A (Z set if balanced).
0035ACr 1               ;   Clobbers: A, X, Y.
0035ACr 1               ; ---------------------------------------------------------------------
0035ACr 1               line_bracket_depth:
0035ACr 1  A2 00              LDX   #0                 ; scan index
0035AEr 1  A0 00              LDY   #0                 ; depth
0035B0r 1               @bd_loop:
0035B0r 1  E4 rr              CPX   buf_idx
0035B2r 1  B0 32              BCS   @bd_done
0035B4r 1  BD rr rr           LDA   input_buf,X
0035B7r 1  C9 3B              CMP   #';'
0035B9r 1  F0 1D              BEQ   @bd_comment
0035BBr 1  C9 5B              CMP   #'['
0035BDr 1  F0 0F              BEQ   @bd_inc
0035BFr 1  C9 28              CMP   #'('
0035C1r 1  F0 0B              BEQ   @bd_inc
0035C3r 1  C9 5D              CMP   #']'
0035C5r 1  F0 0A              BEQ   @bd_dec
0035C7r 1  C9 29              CMP   #')'
0035C9r 1  F0 06              BEQ   @bd_dec
0035CBr 1               @bd_next:
0035CBr 1  E8                 INX
0035CCr 1  80 E2              BRA   @bd_loop
0035CEr 1               @bd_inc:
0035CEr 1  C8                 INY
0035CFr 1  80 FA              BRA   @bd_next
0035D1r 1               @bd_dec:
0035D1r 1  C0 00              CPY   #0
0035D3r 1  F0 F6              BEQ   @bd_next           ; floor at 0
0035D5r 1  88                 DEY
0035D6r 1  80 F3              BRA   @bd_next
0035D8r 1               @bd_comment:
0035D8r 1  E8                 INX                      ; skip ';' and everything up to a newline
0035D9r 1  E4 rr              CPX   buf_idx
0035DBr 1  B0 09              BCS   @bd_done
0035DDr 1  BD rr rr           LDA   input_buf,X
0035E0r 1  C9 0A              CMP   #$0A
0035E2r 1  D0 F4              BNE   @bd_comment
0035E4r 1  80 E5              BRA   @bd_next           ; resume scanning after the newline
0035E6r 1               @bd_done:
0035E6r 1  98                 TYA                      ; depth -> A, sets Z if zero
0035E7r 1  60                 RTS
0035E8r 1               
0035E8r 1               ; ---------------------------------------------------------------------
0035E8r 1               ; print_prompt — prints "? " to the screen
0035E8r 1               ; ---------------------------------------------------------------------
0035E8r 1               print_prompt:
0035E8r 1  20 rr rr           JSR   print_inl
0035EBr 1  3F 20 00           .byte "? ", 0
0035EEr 1  A9 01              LDA   #$01
0035F0r 1  8D 0A A0           STA   VGC_CURSEN
0035F3r 1  60                 RTS
0035F4r 1               
0035F4r 1               ; ---------------------------------------------------------------------
0035F4r 1               ; print_banner — prints title and current available heap bytes
0035F4r 1               ; ---------------------------------------------------------------------
0035F4r 1               print_banner:
0035F4r 1  20 rr rr           JSR   print_inl
0035F7r 1  4E 6F 76 61        .byte "Nova LOGO v1.0", $0D, $0A, 0
0035FBr 1  20 4C 4F 47  
0035FFr 1  4F 20 76 31  
003608r 1               
003608r 1  38                 SEC
003609r 1  A9 00              LDA   #<HEAP_END
00360Br 1  E5 rr              SBC   heap_ptr
00360Dr 1  85 rr              STA   eval_val_lo
00360Fr 1  A9 98              LDA   #>HEAP_END
003611r 1  E5 rr              SBC   heap_ptr+1
003613r 1  85 rr              STA   eval_val_hi
003615r 1  38                 SEC
003616r 1  A5 rr              LDA   eval_val_lo
003618r 1  E9 02              SBC   #GC_HDR_BYTES
00361Ar 1  85 rr              STA   eval_val_lo
00361Cr 1  A5 rr              LDA   eval_val_hi
00361Er 1  E9 00              SBC   #0
003620r 1  85 rr              STA   eval_val_hi
003622r 1  64 rr              STZ   eval_val_frac
003624r 1  20 rr rr           JSR   print_uint16
003627r 1               
003627r 1  20 rr rr           JSR   print_inl
00362Ar 1  20 42 59 54        .byte " BYTES FREE", $0D, $0A, $0D, $0A, 0
00362Er 1  45 53 20 46  
003632r 1  52 45 45 0D  
00363Ar 1  60                 RTS
00363Br 1               
00363Br 1               ; =====================================================================
00363Br 1               ; RODATA segment — string constants
00363Br 1               ; =====================================================================
00363Br 1                     .segment "RODATA"
000647r 1               
000647r 1               ; Extension ROM trampoline — copied to RAM at $0270 during cold_start.
000647r 1               ; Swaps to extension ROM, calls entry, swaps back to Logo ROM.
000647r 1               ext_tramp_src:
000647r 1  A9 04              .byte $A9, ROMSWAP_EXTENSION  ; LDA #ROMSWAP_EXTENSION
000649r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
00064Cr 1  20 00 C0           .byte $20, $00, $C0          ; JSR $C000
00064Fr 1  A9 05              .byte $A9, ROMSWAP_LOGO      ; LDA #ROMSWAP_LOGO
000651r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000654r 1  60                 .byte $60                     ; RTS
000655r 1               
000655r 1               ; =====================================================================
000655r 1               ; MONITOR segment — reset handler at $FFD7
000655r 1               ; =====================================================================
000655r 1                     .segment "MONITOR"
000000r 1                     .org  $FFD7
00FFD7  1               
00FFD7  1               RES_vec:
00FFD7  1  D8                 CLD                     ; clear decimal mode
00FFD8  1  A2 FF              LDX   #$FF              ; empty stack
00FFDA  1  9A                 TXS                     ; set the stack
00FFDB  1  4C rr rr           JMP   cold_start
00FFDE  1               
00FFDE  1               ; IRQ/NMI stubs
00FFDE  1               NMI_stub:
00FFDE  1  40                 RTI
00FFDF  1               
00FFDF  1               IRQ_stub:
00FFDF  1  40                 RTI
00FFE0  1               
00FFE0  1               ; =====================================================================
00FFE0  1               ; VECTORS segment — 6502 hardware vectors at $FFFA
00FFE0  1               ; =====================================================================
00FFE0  1                     .segment "VECTORS"
00FFE0  1                     .org  $FFFA
00FFFA  1               
00FFFA  1  DE FF              .word NMI_stub           ; $FFFA — NMI vector
00FFFC  1  D7 FF              .word RES_vec            ; $FFFC — RESET vector
00FFFE  1  DF FF              .word IRQ_stub           ; $FFFE — IRQ vector
00FFFE  1               
