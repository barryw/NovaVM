002FE5r 2  A0 00              LDY   #0
002FE7r 2               @cmp:
002FE7r 2  DA                 PHX
002FE8r 2  5A                 PHY
002FE9r 2                     ; Search char
002FE9r 2  A5 rr              LDA   var_name_lo
