0020E3r 2  A0 03              LDY   #CONS_CAR_LO
0020E5r 2  A5 rr              LDA   eval_val_lo
0020E7r 2  91 rr              STA   (ptr_lo),Y
0020E9r 2  A0 04              LDY   #CONS_CAR_FRAC
0020EBr 2  A5 rr              LDA   eval_val_frac
0020EDr 2  91 rr              STA   (ptr_lo),Y
0020EFr 2                     ; cdr = second cell
0020EFr 2  A0 05              LDY   #CONS_CDR_LO
0020F1r 2  A5 rr              LDA   list_tail_lo
0020F3r 2  91 rr              STA   (ptr_lo),Y
0020F5r 2  A0 06              LDY   #CONS_CDR_HI
0020F7r 2  A5 rr              LDA   list_tail_hi
0020F9r 2  91 rr              STA   (ptr_lo),Y
0020FBr 2               
0020FBr 2                     ; Return first cell as list head
0020FBr 2  A9 02              LDA   #VAL_LIST
0020FDr 2  85 rr              STA   eval_type
0020FFr 2  A5 rr              LDA   ptr_lo
002101r 2  85 rr              STA   eval_val_lo
002103r 2  A5 rr              LDA   ptr_hi
002105r 2  85 rr              STA   eval_val_hi
002107r 2  64 rr              STZ   eval_val_frac
002109r 2  4C rr rr           JMP   eval_continue
