0019C7r 2  48                 PHA
0019C8r 2  A0 03              LDY   #CONS_CAR_LO
0019CAr 2  B1 rr              LDA   (ptr_lo),Y
0019CCr 2  85 rr              STA   eval_val_lo
0019CEr 2  A0 02              LDY   #CONS_CAR_HI
0019D0r 2  B1 rr              LDA   (ptr_lo),Y
0019D2r 2  85 rr              STA   eval_val_hi
0019D4r 2  20 rr rr           JSR   print_list
0019D7r 2  68                 PLA
0019D8r 2  85 rr              STA   list_ptr_hi
0019DAr 2  68                 PLA
0019DBr 2  85 rr              STA   list_ptr_lo
0019DDr 2  FA                 PLX
0019DEr 2  80 2B              BRA   @pl_advance
0019E0r 2               
0019E0r 2               @pl_word:
0019E0r 2  DA                 PHX
0019E1r 2  A5 rr              LDA   list_ptr_lo
