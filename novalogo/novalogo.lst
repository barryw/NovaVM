0001FAr 2  C8                 INY
0001FBr 2  91 rr              STA   (ptr_lo),Y
0001FDr 2  68                 PLA
0001FEr 2  48                 PHA
0001FFr 2  A0 03              LDY   #TOK_PAYLOAD
000201r 2  91 rr              STA   (ptr_lo),Y
000203r 2  68                 PLA
000204r 2  AA                 TAX
000205r 2  A0 04              LDY   #TOK_PAYLOAD+1
000207r 2  9C rr rr           STZ   num_tmp_lo
00020Ar 2               @copy:
