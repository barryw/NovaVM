0013D4r 2               
0013D4r 2               ; ---------------------------------------------------------------------
0013D4r 2               ; alloc_one_char_word — allocate a 1-char word on heap from A
0013D4r 2               ;   Input: A = character byte
0013D4r 2               ;   Output: eval_type=VAL_WORD, eval_val=pointer to len+char
0013D4r 2               ;   Jumps to eval_continue
