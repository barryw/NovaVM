00218Cr 2  BA                 TSX
00218Dr 2  BD 04 01           LDA   $0104,X                 ; second type
002190r 2  A0 01              LDY   #CONS_CAR_TYPE
002192r 2  91 rr              STA   (ptr_lo),Y
002194r 2  BD 03 01           LDA   $0103,X                 ; second hi
002197r 2  A0 02              LDY   #CONS_CAR_HI
002199r 2  91 rr              STA   (ptr_lo),Y
00219Br 2  BD 02 01           LDA   $0102,X                 ; second lo
00219Er 2  A0 03              LDY   #CONS_CAR_LO
0021A0r 2  91 rr              STA   (ptr_lo),Y
0021A2r 2  BD 01 01           LDA   $0101,X                 ; second frac
0021A5r 2  A0 04              LDY   #CONS_CAR_FRAC
0021A7r 2  91 rr              STA   (ptr_lo),Y
