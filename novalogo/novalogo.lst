00229Cr 2  A2 rr              LDX   #<str_word_name
00229Er 2  A0 rr              LDY   #>str_word_name
0022A0r 2  4C rr rr           JMP   err_dl_this
0022A3r 2               @err_oom:
0022A3r 2               @err:
0022A3r 2  A2 rr              LDX   #<str_word_name
0022A5r 2  A0 rr              LDY   #>str_word_name
0022A7r 2  4C rr rr           JMP   err_nei
0022AAr 2               
0022AAr 2               ; ---------------------------------------------------------------------
0022AAr 2               ; do_run — RUN list: evaluate a list as Logo code
0022AAr 2               ;   Arity 0: evaluates its own argument
0022AAr 2               ;
0022AAr 2               ;   Strategy: convert list to text in input_buf, then save evaluator
0022AAr 2               ;   state, tokenize_line + eval_line, restore state.
0022AAr 2               ; ---------------------------------------------------------------------
0022AAr 2               do_run:
0022AAr 2  20 rr rr           JSR   eval_expr
0022ADr 2  90 03              BCC   :+
0022AFr 2  4C rr rr           JMP   @err
0022B2r 2               :
0022B2r 2  A5 rr              LDA   eval_type
0022B4r 2  C9 02              CMP   #VAL_LIST
0022B6r 2  D0 43              BNE   @err_type
0022B8r 2               
0022B8r 2                     ; Save eval_cur on stack (we'll resume here after RUN)
0022B8r 2  A5 rr              LDA   eval_cur_lo
0022BAr 2  48                 PHA
0022BBr 2  A5 rr              LDA   eval_cur_hi
0022BDr 2  48                 PHA
0022BEr 2               
0022BEr 2                     ; Render the list into input_buf as text
0022BEr 2                     ; eval_val_lo/hi = list head
0022BEr 2  64 rr              STZ   z:buf_idx               ; reset write position
0022C0r 2  20 rr rr           JSR   render_list_to_buf
0022C3r 2               
0022C3r 2                     ; Null-terminate input_buf
0022C3r 2  A6 rr              LDX   z:buf_idx
0022C5r 2  9E rr rr           STZ   input_buf,X
0022C8r 2               
0022C8r 2                     ; Save tokenizer and eval state (same pattern as proc_invoke)
0022C8r 2  A5 rr              LDA   tok_head_lo
0022CAr 2  48                 PHA
0022CBr 2  A5 rr              LDA   tok_head_hi
0022CDr 2  48                 PHA
0022CEr 2  A5 rr              LDA   tok_tail_lo
0022D0r 2  48                 PHA
0022D1r 2  A5 rr              LDA   tok_tail_hi
0022D3r 2  48                 PHA
0022D4r 2  A5 rr              LDA   eval_in_body
0022D6r 2  48                 PHA
0022D7r 2  A5 rr              LDA   eval_reporter
0022D9r 2  48                 PHA
0022DAr 2               
0022DAr 2                     ; Tokenize the reconstructed line
0022DAr 2  20 rr rr           JSR   tokenize_line
0022DDr 2               
0022DDr 2                     ; Evaluate it
0022DDr 2  20 rr rr           JSR   eval_line
0022E0r 2               
0022E0r 2                     ; Restore tokenizer/eval state
0022E0r 2  68                 PLA
0022E1r 2  85 rr              STA   eval_reporter
0022E3r 2  68                 PLA
0022E4r 2  85 rr              STA   eval_in_body
0022E6r 2  68                 PLA
0022E7r 2  85 rr              STA   tok_tail_hi
0022E9r 2  68                 PLA
0022EAr 2  85 rr              STA   tok_tail_lo
0022ECr 2  68                 PLA
0022EDr 2  85 rr              STA   tok_head_hi
0022EFr 2  68                 PLA
0022F0r 2  85 rr              STA   tok_head_lo
0022F2r 2               
0022F2r 2                     ; Restore eval_cur
0022F2r 2  68                 PLA
0022F3r 2  85 rr              STA   eval_cur_hi
0022F5r 2  68                 PLA
0022F6r 2  85 rr              STA   eval_cur_lo
0022F8r 2               
