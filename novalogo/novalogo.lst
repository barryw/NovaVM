002459r 2               ; ---------------------------------------------------------------------
002459r 2               ; render_number_to_buf — render eval_val as decimal into input_buf
002459r 2               ;   Entry: eval_val_hi/lo/frac = number value
002459r 2               ;          buf_idx = current write position
002459r 2               ;   Exit:  buf_idx updated
002459r 2               ;   Clobbers: A, X, Y, num_val, num_tmp, pn_buf
002459r 2               ; ---------------------------------------------------------------------
002459r 2               render_number_to_buf:
002459r 2                     ; Handle sign
002459r 2  A5 rr              LDA   eval_val_hi
00245Br 2  10 22              BPL   @rn_positive
00245Dr 2                     ; Write '-'
00245Dr 2  A4 rr              LDY   z:buf_idx
00245Fr 2  A9 2D              LDA   #'-'
002461r 2  99 rr rr           STA   input_buf,Y
002464r 2  E6 rr              INC   z:buf_idx
002466r 2                     ; Negate
002466r 2  A5 rr              LDA   eval_val_frac
002468r 2  49 FF              EOR   #$FF
00246Ar 2  18                 CLC
00246Br 2  69 01              ADC   #1
00246Dr 2  85 rr              STA   eval_val_frac
00246Fr 2  A5 rr              LDA   eval_val_lo
002471r 2  49 FF              EOR   #$FF
002473r 2  69 00              ADC   #0
002475r 2  85 rr              STA   eval_val_lo
002477r 2  A5 rr              LDA   eval_val_hi
002479r 2  49 FF              EOR   #$FF
00247Br 2  69 00              ADC   #0
00247Dr 2  85 rr              STA   eval_val_hi
00247Fr 2               
00247Fr 2               @rn_positive:
00247Fr 2                     ; Render integer part using power-of-10 subtraction
00247Fr 2  A5 rr              LDA   eval_val_lo
002481r 2  8D rr rr           STA   num_val_lo
002484r 2  A5 rr              LDA   eval_val_hi
002486r 2  8D rr rr           STA   num_val_hi
002489r 2               
002489r 2  A2 00              LDX   #0                     ; digit buffer index
00248Br 2  A0 00              LDY   #0                     ; power-of-10 index
00248Dr 2               @rn_div:
00248Dr 2  9C rr rr           STZ   num_tmp_lo
002490r 2               @rn_sub:
002490r 2  38                 SEC
002491r 2  AD rr rr           LDA   num_val_lo
002494r 2  F9 rr rr           SBC   pow10_lo,Y
002497r 2  48                 PHA
002498r 2  AD rr rr           LDA   num_val_hi
00249Br 2  F9 rr rr           SBC   pow10_hi,Y
00249Er 2  90 0C              BCC   @rn_sub_done
0024A0r 2  8D rr rr           STA   num_val_hi
0024A3r 2  68                 PLA
0024A4r 2  8D rr rr           STA   num_val_lo
0024A7r 2  EE rr rr           INC   num_tmp_lo
0024AAr 2  80 E4              BRA   @rn_sub
