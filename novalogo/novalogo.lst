0015F2r 2  85 rr              STA   eval_cur_lo
0015F4r 2  68                 PLA
0015F5r 2  85 rr              STA   tok_tail_hi
0015F7r 2  68                 PLA
0015F8r 2  85 rr              STA   tok_tail_lo
0015FAr 2  68                 PLA
0015FBr 2  85 rr              STA   tok_head_hi
0015FDr 2  68                 PLA
0015FEr 2  85 rr              STA   tok_head_lo
001600r 2  A2 rr              LDX   #<str_oom
001602r 2  A0 rr              LDY   #>str_oom
001604r 2  4C rr rr           JMP   list_print_err
001607r 2               
001607r 2               ; ---------------------------------------------------------------------
001607r 2               ; do_char — CHAR n: convert ASCII code to 1-char word
001607r 2               ;   Arity 0: evaluates its own argument
001607r 2               ; ---------------------------------------------------------------------
001607r 2               do_char:
001607r 2  20 rr rr           JSR   eval_expr
00160Ar 2  B0 09              BCS   @err
00160Cr 2                     ; Must be a number
00160Cr 2  A5 rr              LDA   eval_type
00160Er 2  D0 05              BNE   @err
001610r 2                     ; Low byte of number is the ASCII code
001610r 2  A5 rr              LDA   eval_val_lo
001612r 2  4C rr rr           JMP   alloc_one_char_word
001615r 2               @err:
001615r 2  A2 rr              LDX   #<str_char_err
001617r 2  A0 rr              LDY   #>str_char_err
001619r 2  4C rr rr           JMP   list_print_err
00161Cr 2               
00161Cr 2               ; ---------------------------------------------------------------------
00161Cr 2               ; do_ascii — ASCII word: return ASCII code of first character
00161Cr 2               ;   Arity 0: evaluates its own argument
00161Cr 2               ; ---------------------------------------------------------------------
00161Cr 2               do_ascii:
00161Cr 2  20 rr rr           JSR   eval_expr
00161Fr 2  B0 23              BCS   @err
001621r 2                     ; Must be a word
001621r 2  A5 rr              LDA   eval_type
001623r 2  C9 01              CMP   #VAL_WORD
001625r 2  D0 1D              BNE   @err_type
001627r 2                     ; eval_val_lo/hi points at length-prefixed string
001627r 2  A5 rr              LDA   eval_val_lo
001629r 2  85 rr              STA   ptr_lo
00162Br 2  A5 rr              LDA   eval_val_hi
00162Dr 2  85 rr              STA   ptr_hi
00162Fr 2  A0 00              LDY   #0
001631r 2  B1 rr              LDA   (ptr_lo),Y           ; length
001633r 2  F0 0F              BEQ   @err_empty            ; empty word
001635r 2  A0 01              LDY   #1
001637r 2  B1 rr              LDA   (ptr_lo),Y           ; first character
001639r 2  85 rr              STA   eval_val_lo
00163Br 2  64 rr              STZ   eval_val_hi
00163Dr 2  64 rr              STZ   eval_val_frac
00163Fr 2  64 rr              STZ   eval_type             ; VAL_NUMBER
001641r 2  4C rr rr           JMP   eval_continue
001644r 2               @err_type:
001644r 2               @err_empty:
001644r 2               @err:
001644r 2  A2 rr              LDX   #<str_ascii_err
001646r 2  A0 rr              LDY   #>str_ascii_err
001648r 2  4C rr rr           JMP   list_print_err
00164Br 2               
00164Br 2               ; =====================================================================
00164Br 2               ; Math functions and type predicates
00164Br 2               ; =====================================================================
00164Br 2               
00164Br 2               ; ---------------------------------------------------------------------
00164Br 2               ; return_number — set eval_val from eval_val_lo/hi, clear frac+type
00164Br 2               ;   Entry: eval_val_lo/hi already set
00164Br 2               ;   Jumps to eval_continue
00164Br 2               ; ---------------------------------------------------------------------
00164Br 2               return_number:
00164Br 2  64 rr              STZ   eval_val_frac
00164Dr 2  64 rr              STZ   eval_type
00164Fr 2  4C rr rr           JMP   eval_continue
001652r 2               
001652r 2               ; ---------------------------------------------------------------------
001652r 2               ; return_signed_byte — sign-extend A into eval_val as 16.8 number
001652r 2               ;   Entry: A = signed byte (-128..+127)
001652r 2               ;   Jumps to eval_continue
001652r 2               ; ---------------------------------------------------------------------
001652r 2               return_signed_byte:
001652r 2  85 rr              STA   eval_val_lo
001654r 2  10 04              BPL   @pos
001656r 2  A9 FF              LDA   #$FF
001658r 2  80 02              BRA   @set
00165Ar 2  A9 00        @pos: LDA   #$00
00165Cr 2  85 rr        @set: STA   eval_val_hi
00165Er 2  80 EB              BRA   return_number
001660r 2               
001660r 2               ; ---------------------------------------------------------------------
001660r 2               ; predicate_result — set eval_val to 1 (Z set) or 0 (Z clear)
001660r 2               ;   Entry: Z flag from CMP
001660r 2               ;   Jumps to eval_continue
001660r 2               ; ---------------------------------------------------------------------
001660r 2               predicate_result:
001660r 2  F0 04              BEQ   @true
001662r 2  64 rr              STZ   eval_val_lo
001664r 2  80 04              BRA   @done
001666r 2               @true:
001666r 2  A9 01              LDA   #1
001668r 2  85 rr              STA   eval_val_lo
00166Ar 2               @done:
00166Ar 2  64 rr              STZ   eval_val_hi
00166Cr 2  80 DD              BRA   return_number
00166Er 2               
00166Er 2               ; ---------------------------------------------------------------------
00166Er 2               ; degrees_to_u8 — convert eval_val (degrees 0-360) to u8 angle (0-255)
00166Er 2               ;   Uses MUL16 coprocessor: angle = degrees * 91 / 128
00166Er 2               ;   Actually: write degrees to MUL16 A, 91 to B, read RES1 (high byte)
00166Er 2               ;   Then shift right once (divide by 2) since 91/256=0.355, we want 91/128
00166Er 2               ;   Wait, let me recalculate: degrees * 91 >> 7
00166Er 2               ;   MUL16 gives degrees*91 in RES1:RES0. We want bits [14:7] of that.
00166Er 2               ;   RES1 is bits [15:8]. But we want >>7 which is RES1<<1 | RES0>>7.
00166Er 2               ;   Simpler: degrees * 182 / 256 = RES1 of (degrees * 182). Let's use 182.
00166Er 2               ;   Output: A = u8 angle
00166Er 2               ;   Clobbers: uses math coprocessor regs
00166Er 2               ; ---------------------------------------------------------------------
00166Er 2               degrees_to_u8:
00166Er 2  A5 rr              LDA   eval_val_lo
001670r 2  8D 20 BB           STA   MATH_MUL16_A_LO
001673r 2  A5 rr              LDA   eval_val_hi
001675r 2  8D 21 BB           STA   MATH_MUL16_A_HI
001678r 2  A9 B6              LDA   #182
00167Ar 2  8D 22 BB           STA   MATH_MUL16_B_LO
00167Dr 2  9C 23 BB           STZ   MATH_MUL16_B_HI       ; trigger multiply
001680r 2  AD 39 BB           LDA   MATH_RES1              ; high byte = degrees * 182 / 256
001683r 2  60                 RTS
001684r 2               
001684r 2               ; ---------------------------------------------------------------------
001684r 2               ; do_sin — SIN degrees: return sin as signed byte (-128..+127)
001684r 2               ; ---------------------------------------------------------------------
001684r 2               do_sin:
001684r 2  20 rr rr           JSR   eval_expr
001687r 2  B0 0C              BCS   @err
001689r 2  20 rr rr           JSR   degrees_to_u8
00168Cr 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
00168Fr 2  AD 38 BB           LDA   MATH_RES0              ; sin result (signed 1.7)
001692r 2  4C rr rr           JMP   return_signed_byte
001695r 2               @err:
001695r 2  38                 SEC
001696r 2  60                 RTS
001697r 2               
001697r 2               ; ---------------------------------------------------------------------
001697r 2               ; do_cos — COS degrees: return cos as signed byte (-128..+127)
001697r 2               ; ---------------------------------------------------------------------
001697r 2               do_cos:
001697r 2  20 rr rr           JSR   eval_expr
00169Ar 2  B0 0C              BCS   @err
00169Cr 2  20 rr rr           JSR   degrees_to_u8
00169Fr 2  8D 2E BB           STA   MATH_SINCOS_ANGLE
0016A2r 2  AD 39 BB           LDA   MATH_RES1              ; cos result (signed 1.7)
0016A5r 2  4C rr rr           JMP   return_signed_byte
0016A8r 2               @err:
0016A8r 2  38                 SEC
0016A9r 2  60                 RTS
0016AAr 2               
0016AAr 2               ; ---------------------------------------------------------------------
0016AAr 2               ; do_abs — ABS n: return absolute value
0016AAr 2               ; ---------------------------------------------------------------------
0016AAr 2               do_abs:
0016AAr 2  20 rr rr           JSR   eval_expr
0016ADr 2  B0 22              BCS   @err
0016AFr 2  A5 rr              LDA   eval_val_hi
0016B1r 2  10 19              BPL   @done                  ; already positive
0016B3r 2                     ; Negate 24-bit value
0016B3r 2  A5 rr              LDA   eval_val_frac
0016B5r 2  49 FF              EOR   #$FF
0016B7r 2  18                 CLC
0016B8r 2  69 01              ADC   #1
0016BAr 2  85 rr              STA   eval_val_frac
0016BCr 2  A5 rr              LDA   eval_val_lo
0016BEr 2  49 FF              EOR   #$FF
0016C0r 2  69 00              ADC   #0
0016C2r 2  85 rr              STA   eval_val_lo
0016C4r 2  A5 rr              LDA   eval_val_hi
0016C6r 2  49 FF              EOR   #$FF
0016C8r 2  69 00              ADC   #0
0016CAr 2  85 rr              STA   eval_val_hi
0016CCr 2               @done:
0016CCr 2  64 rr              STZ   eval_type
0016CEr 2  4C rr rr           JMP   eval_continue
0016D1r 2               @err:
0016D1r 2  38                 SEC
0016D2r 2  60                 RTS
0016D3r 2               
0016D3r 2               ; ---------------------------------------------------------------------
0016D3r 2               ; do_int — INT n: truncate fractional part
0016D3r 2               ; ---------------------------------------------------------------------
0016D3r 2               do_int:
0016D3r 2  20 rr rr           JSR   eval_expr
0016D6r 2  B0 07              BCS   @err
0016D8r 2  64 rr              STZ   eval_val_frac
0016DAr 2  64 rr              STZ   eval_type
0016DCr 2  4C rr rr           JMP   eval_continue
0016DFr 2               @err:
0016DFr 2  38                 SEC
0016E0r 2  60                 RTS
0016E1r 2               
0016E1r 2               ; ---------------------------------------------------------------------
0016E1r 2               ; do_round — ROUND n: round to nearest integer
0016E1r 2               ; ---------------------------------------------------------------------
0016E1r 2               do_round:
0016E1r 2  20 rr rr           JSR   eval_expr
0016E4r 2  B0 19              BCS   @err
0016E6r 2  A5 rr              LDA   eval_val_frac
0016E8r 2  C9 80              CMP   #128
0016EAr 2  90 0C              BCC   @trunc
0016ECr 2                     ; Round up: increment integer part
0016ECr 2  A5 rr              LDA   eval_val_hi
0016EEr 2  10 02              BPL   @pos_round
0016F0r 2                     ; Negative: actually round toward zero = truncate
0016F0r 2  80 06              BRA   @trunc
0016F2r 2               @pos_round:
0016F2r 2  E6 rr              INC   eval_val_lo
0016F4r 2  D0 02              BNE   @trunc
0016F6r 2  E6 rr              INC   eval_val_hi
0016F8r 2               @trunc:
0016F8r 2  64 rr              STZ   eval_val_frac
0016FAr 2  64 rr              STZ   eval_type
0016FCr 2  4C rr rr           JMP   eval_continue
0016FFr 2               @err:
0016FFr 2  38                 SEC
001700r 2  60                 RTS
001701r 2               
001701r 2               ; ---------------------------------------------------------------------
001701r 2               ; do_random — RANDOM n: return random number 0..n-1
001701r 2               ;   Uses math coprocessor RNG + MUL16 to scale
001701r 2               ; ---------------------------------------------------------------------
001701r 2               do_random:
001701r 2  20 rr rr           JSR   eval_expr
001704r 2  B0 1D              BCS   @err
001706r 2                     ; RNG byte * n / 256 gives 0..n-1
001706r 2  AD 37 BB           LDA   MATH_RNG
001709r 2  8D 20 BB           STA   MATH_MUL16_A_LO
00170Cr 2  9C 21 BB           STZ   MATH_MUL16_A_HI
00170Fr 2  A5 rr              LDA   eval_val_lo
001711r 2  8D 22 BB           STA   MATH_MUL16_B_LO
001714r 2  A5 rr              LDA   eval_val_hi
001716r 2  8D 23 BB           STA   MATH_MUL16_B_HI       ; trigger
001719r 2  AD 39 BB           LDA   MATH_RES1              ; high byte of (rng * n) = rng*n/256
00171Cr 2  85 rr              STA   eval_val_lo
00171Er 2  64 rr              STZ   eval_val_hi
001720r 2  4C rr rr           JMP   return_number
001723r 2               @err:
001723r 2  38                 SEC
001724r 2  60                 RTS
001725r 2               
001725r 2               ; ---------------------------------------------------------------------
001725r 2               ; do_sqrt — SQRT n: approximate sqrt via DIST_APPROX(n, 0)
001725r 2               ; ---------------------------------------------------------------------
001725r 2               do_sqrt:
001725r 2  20 rr rr           JSR   eval_expr
001728r 2  B0 1D              BCS   @err
00172Ar 2  A5 rr              LDA   eval_val_lo
00172Cr 2  8D 33 BB           STA   MATH_DIST_DX_LO
00172Fr 2  A5 rr              LDA   eval_val_hi
001731r 2  8D 34 BB           STA   MATH_DIST_DX_HI
001734r 2  9C 35 BB           STZ   MATH_DIST_DY_LO
001737r 2  9C 36 BB           STZ   MATH_DIST_DY_HI       ; trigger (write to DY_HI triggers)
00173Ar 2  AD 38 BB           LDA   MATH_RES0
00173Dr 2  85 rr              STA   eval_val_lo
00173Fr 2  AD 39 BB           LDA   MATH_RES1
001742r 2  85 rr              STA   eval_val_hi
001744r 2  4C rr rr           JMP   return_number
001747r 2               @err:
001747r 2  38                 SEC
001748r 2  60                 RTS
001749r 2               
001749r 2               ; ---------------------------------------------------------------------
001749r 2               ; do_remainder — REMAINDER a b: return a mod b via DIV coprocessor
001749r 2               ; ---------------------------------------------------------------------
001749r 2               do_remainder:
001749r 2  20 rr rr           JSR   eval_expr              ; first arg (a)
00174Cr 2  B0 49              BCS   @err
00174Er 2  A5 rr              LDA   eval_val_lo
001750r 2  48                 PHA
001751r 2  A5 rr              LDA   eval_val_hi
001753r 2  48                 PHA
001754r 2  20 rr rr           JSR   eval_expr              ; second arg (b)
001757r 2  B0 3C              BCS   @err_pop
001759r 2                     ; b in eval_val, a on stack
001759r 2                     ; Check divide by zero
001759r 2  A5 rr              LDA   eval_val_lo
00175Br 2  05 rr              ORA   eval_val_hi
00175Dr 2  F0 2D              BEQ   @zero_pop
00175Fr 2                     ; Set up 32÷16 division: dividend=a, divisor=b
00175Fr 2  68                 PLA
001760r 2  8D 29 BB           STA   MATH_DIV_N_1           ; a_hi
001763r 2  AA                 TAX                          ; save for sign-extend
001764r 2  68                 PLA
001765r 2  8D 28 BB           STA   MATH_DIV_N_LO          ; a_lo
001768r 2                     ; Sign-extend a
001768r 2  8A                 TXA
001769r 2  09 7F              ORA   #$7F
00176Br 2  30 02              BMI   @neg_a
00176Dr 2  A9 00              LDA   #$00
00176Fr 2               @neg_a:                            ; A=$FF if negative
00176Fr 2  8D 2A BB           STA   MATH_DIV_N_2
001772r 2  8D 2B BB           STA   MATH_DIV_N_HI
001775r 2  A5 rr              LDA   eval_val_lo
001777r 2  8D 2C BB           STA   MATH_DIV_D_LO
00177Ar 2  A5 rr              LDA   eval_val_hi
00177Cr 2  8D 2D BB           STA   MATH_DIV_D_HI          ; trigger
00177Fr 2                     ; Remainder is in RES2:RES3 (actually check what the copro returns)
00177Fr 2                     ; The math copro returns quotient in RES0:RES1, remainder in RES2:RES3
00177Fr 2  AD 3A BB           LDA   MATH_RES2
001782r 2  85 rr              STA   eval_val_lo
001784r 2  AD 3B BB           LDA   MATH_RES3
001787r 2  85 rr              STA   eval_val_hi
001789r 2  4C rr rr           JMP   return_number
00178Cr 2               @zero_pop:
00178Cr 2  68                 PLA
00178Dr 2  68                 PLA
00178Er 2  64 rr              STZ   eval_val_lo
001790r 2  64 rr              STZ   eval_val_hi
001792r 2  4C rr rr           JMP   return_number
001795r 2               @err_pop:
001795r 2  68                 PLA
001796r 2  68                 PLA
001797r 2               @err:
001797r 2  38                 SEC
001798r 2  60                 RTS
001799r 2               
001799r 2               ; ---------------------------------------------------------------------
001799r 2               ; do_not — NOT expr: return 1 if expr is 0, else 0
001799r 2               ; ---------------------------------------------------------------------
001799r 2               do_not:
001799r 2  20 rr rr           JSR   eval_expr
00179Cr 2  B0 13              BCS   @err
00179Er 2  A5 rr              LDA   eval_val_lo
0017A0r 2  05 rr              ORA   eval_val_hi
0017A2r 2                     ; If zero, set result to 1. If nonzero, set to 0.
0017A2r 2  D0 06              BNE   @false
0017A4r 2  A9 01              LDA   #1
0017A6r 2  85 rr              STA   eval_val_lo
0017A8r 2  80 02              BRA   @done
0017AAr 2               @false:
0017AAr 2  64 rr              STZ   eval_val_lo
0017ACr 2               @done:
0017ACr 2  64 rr              STZ   eval_val_hi
0017AEr 2  4C rr rr           JMP   return_number
0017B1r 2               @err:
0017B1r 2  38                 SEC
0017B2r 2  60                 RTS
0017B3r 2               
0017B3r 2               ; ---------------------------------------------------------------------
0017B3r 2               ; do_and — AND a b: return 1 if both nonzero, else 0
0017B3r 2               ; ---------------------------------------------------------------------
0017B3r 2               do_and:
0017B3r 2  20 rr rr           JSR   eval_expr
0017B6r 2  B0 1E              BCS   @err
0017B8r 2  A5 rr              LDA   eval_val_lo
0017BAr 2  05 rr              ORA   eval_val_hi
0017BCr 2  F0 11              BEQ   @false                 ; first arg is 0 → short-circuit
0017BEr 2  20 rr rr           JSR   eval_expr
0017C1r 2  B0 13              BCS   @err
0017C3r 2  A5 rr              LDA   eval_val_lo
0017C5r 2  05 rr              ORA   eval_val_hi
0017C7r 2  F0 06              BEQ   @false
0017C9r 2  A9 01              LDA   #1
0017CBr 2  85 rr              STA   eval_val_lo
0017CDr 2  80 02              BRA   @done
0017CFr 2               @false:
0017CFr 2  64 rr              STZ   eval_val_lo
0017D1r 2               @done:
0017D1r 2  64 rr              STZ   eval_val_hi
0017D3r 2  4C rr rr           JMP   return_number
0017D6r 2               @err:
0017D6r 2  38                 SEC
0017D7r 2  60                 RTS
0017D8r 2               
0017D8r 2               ; ---------------------------------------------------------------------
0017D8r 2               ; do_or — OR a b: return 1 if either nonzero, else 0
0017D8r 2               ; ---------------------------------------------------------------------
0017D8r 2               do_or:
0017D8r 2  20 rr rr           JSR   eval_expr
0017DBr 2  B0 1E              BCS   @err
0017DDr 2  A5 rr              LDA   eval_val_lo
0017DFr 2  05 rr              ORA   eval_val_hi
0017E1r 2  D0 0F              BNE   @true                  ; first arg nonzero → short-circuit
0017E3r 2  20 rr rr           JSR   eval_expr
0017E6r 2  B0 13              BCS   @err
0017E8r 2  A5 rr              LDA   eval_val_lo
0017EAr 2  05 rr              ORA   eval_val_hi
0017ECr 2  D0 04              BNE   @true
0017EEr 2  64 rr              STZ   eval_val_lo
0017F0r 2  80 04              BRA   @done
0017F2r 2               @true:
0017F2r 2  A9 01              LDA   #1
0017F4r 2  85 rr              STA   eval_val_lo
0017F6r 2               @done:
0017F6r 2  64 rr              STZ   eval_val_hi
0017F8r 2  4C rr rr           JMP   return_number
0017FBr 2               @err:
0017FBr 2  38                 SEC
0017FCr 2  60                 RTS
0017FDr 2               
0017FDr 2               ; ---------------------------------------------------------------------
0017FDr 2               ; Type predicates — NUMBER?, WORD?, LIST?
0017FDr 2               ; ---------------------------------------------------------------------
0017FDr 2               do_numberp:
0017FDr 2  20 rr rr           JSR   eval_expr
001800r 2  B0 07              BCS   @err
001802r 2  A5 rr              LDA   eval_type
001804r 2  C9 00              CMP   #VAL_NUMBER
001806r 2  4C rr rr           JMP   predicate_result
001809r 2               @err:
001809r 2  38                 SEC
00180Ar 2  60                 RTS
00180Br 2               
00180Br 2               do_wordp:
00180Br 2  20 rr rr           JSR   eval_expr
00180Er 2  B0 07              BCS   @err
001810r 2  A5 rr              LDA   eval_type
001812r 2  C9 01              CMP   #VAL_WORD
001814r 2  4C rr rr           JMP   predicate_result
001817r 2               @err:
001817r 2  38                 SEC
001818r 2  60                 RTS
001819r 2               
001819r 2               do_listp:
001819r 2  20 rr rr           JSR   eval_expr
00181Cr 2  B0 07              BCS   @err
00181Er 2  A5 rr              LDA   eval_type
001820r 2  C9 02              CMP   #VAL_LIST
001822r 2  4C rr rr           JMP   predicate_result
001825r 2               @err:
001825r 2  38                 SEC
001826r 2  60                 RTS
001827r 2               
001827r 2               ; =====================================================================
001827r 2               ; RODATA — builtin table and name strings
001827r 2               ; =====================================================================
001827r 2                     .segment "RODATA"
000328r 2               
000328r 2               str_oom:
000328r 2  4F 55 54 20        .byte "OUT OF MEMORY", 0
00032Cr 2  4F 46 20 4D  
000330r 2  45 4D 4F 52  
000336r 2               
000336r 2               str_char_err:
000336r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO CHAR", 0
00033Ar 2  45 4E 4F 55  
00033Er 2  47 48 20 49  
000350r 2               
000350r 2               str_ascii_err:
000350r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO ASCII", 0
000354r 2  45 4E 4F 55  
000358r 2  47 48 20 49  
00036Br 2               
00036Br 2               str_for_err:
00036Br 2  46 4F 52 20        .byte "FOR NEEDS [VAR START END]", 0
00036Fr 2  4E 45 45 44  
000373r 2  53 20 5B 56  
000385r 2               
000385r 2               str_for_bracket:
000385r 2  46 4F 52 20        .byte "FOR NEEDS [BODY]", 0
000389r 2  4E 45 45 44  
00038Dr 2  53 20 5B 42  
000396r 2               
000396r 2               str_while_bracket:
000396r 2  57 48 49 4C        .byte "WHILE/UNTIL NEEDS [COND] [BODY]", 0
00039Ar 2  45 2F 55 4E  
00039Er 2  54 49 4C 20  
0003B6r 2               
0003B6r 2               str_make_err:
0003B6r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO MAKE", 0
0003BAr 2  45 4E 4F 55  
0003BEr 2  47 48 20 49  
0003D0r 2               
0003D0r 2               str_repeat_err:
0003D0r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO REPEAT", 0
0003D4r 2  45 4E 4F 55  
0003D8r 2  47 48 20 49  
0003ECr 2               
0003ECr 2               str_repeat_bracket:
0003ECr 2  52 45 50 45        .byte "REPEAT NEEDS [ BODY ]", 0
0003F0r 2  41 54 20 4E  
0003F4r 2  45 45 44 53  
000402r 2               
000402r 2               str_if_err:
000402r 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO IF", 0
000406r 2  45 4E 4F 55  
00040Ar 2  47 48 20 49  
00041Ar 2               
00041Ar 2               str_if_bracket:
00041Ar 2  49 46 20 4E        .byte "IF NEEDS [ BODY ]", 0
00041Er 2  45 45 44 53  
000422r 2  20 5B 20 42  
00042Cr 2               
00042Cr 2               str_ifelse_err:
00042Cr 2  4E 4F 54 20        .byte "NOT ENOUGH INPUTS TO IFELSE", 0
000430r 2  45 4E 4F 55  
000434r 2  47 48 20 49  
000448r 2               
000448r 2               str_ifelse_bracket:
