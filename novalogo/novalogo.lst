00064Ar 2  F0 06              BEQ   @bee_done
00064Cr 2  8D 0E A0           STA   VGC_CHAROUT
00064Fr 2  E8                 INX
000650r 2  D0 F5              BNE   @bee_lp
000652r 2               @bee_done:
