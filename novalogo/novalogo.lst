0024ACr 2  68                 PLA
0024ADr 2  AD rr rr           LDA   num_tmp_lo
0024B0r 2  9D rr rr           STA   pn_buf,X
0024B3r 2  E8                 INX
0024B4r 2  C8                 INY
0024B5r 2  C0 05              CPY   #5
0024B7r 2  90 D4              BCC   @rn_div
0024B9r 2               
0024B9r 2                     ; Write digits suppressing leading zeros
0024B9r 2  A0 00              LDY   #0                     ; suppress flag
0024BBr 2  A2 00              LDX   #0
0024BDr 2               @rn_print:
0024BDr 2  BD rr rr           LDA   pn_buf,X
0024C0r 2  D0 04              BNE   @rn_nonzero
0024C2r 2  C0 00              CPY   #0
0024C4r 2  F0 0D              BEQ   @rn_skip
0024C6r 2               @rn_nonzero:
0024C6r 2  A0 01              LDY   #1
0024C8r 2  09 30              ORA   #'0'
0024CAr 2  DA                 PHX
0024CBr 2  A6 rr              LDX   z:buf_idx
0024CDr 2  9D rr rr           STA   input_buf,X
0024D0r 2  E6 rr              INC   z:buf_idx
0024D2r 2  FA                 PLX
0024D3r 2               @rn_skip:
0024D3r 2  E8                 INX
0024D4r 2  E0 04              CPX   #4
