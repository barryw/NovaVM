0023BCr 2  B1 rr              LDA   (ptr_lo),Y
0023BEr 2  85 rr              STA   eval_val_frac
0023C0r 2  20 rr rr           JSR   render_number_to_buf
0023C3r 2  68                 PLA
0023C4r 2  85 rr              STA   list_ptr_hi
0023C6r 2  68                 PLA
0023C7r 2  85 rr              STA   list_ptr_lo
0023C9r 2  FA                 PLX
0023CAr 2  80 72              BRA   @rl_advance
0023CCr 2               
0023CCr 2               @rl_word:
0023CCr 2  DA                 PHX
0023CDr 2  A5 rr              LDA   list_ptr_lo
0023CFr 2  48                 PHA
0023D0r 2  A5 rr              LDA   list_ptr_hi
0023D2r 2  48                 PHA
0023D3r 2                     ; Get word string pointer
0023D3r 2  A0 03              LDY   #CONS_CAR_LO
0023D5r 2  B1 rr              LDA   (ptr_lo),Y
0023D7r 2  85 rr              STA   ptr2_lo
0023D9r 2  A0 02              LDY   #CONS_CAR_HI
0023DBr 2  B1 rr              LDA   (ptr_lo),Y
0023DDr 2  85 rr              STA   ptr2_hi
0023DFr 2                     ; Copy word chars to buf
0023DFr 2  A0 00              LDY   #0
0023E1r 2  B1 rr              LDA   (ptr2_lo),Y            ; length
0023E3r 2  AA                 TAX
0023E4r 2  F0 16              BEQ   @rl_word_done
0023E6r 2  C8                 INY
0023E7r 2               @rl_wch:
0023E7r 2  A5 rr              LDA   z:buf_idx
0023E9r 2  C9 7E              CMP   #126
0023EBr 2  B0 0F              BCS   @rl_word_done
0023EDr 2  B1 rr              LDA   (ptr2_lo),Y
0023EFr 2  5A                 PHY
0023F0r 2  A4 rr              LDY   z:buf_idx
0023F2r 2  99 rr rr           STA   input_buf,Y
0023F5r 2  E6 rr              INC   z:buf_idx
0023F7r 2  7A                 PLY
0023F8r 2  C8                 INY
0023F9r 2  CA                 DEX
0023FAr 2  D0 EB              BNE   @rl_wch
0023FCr 2               @rl_word_done:
0023FCr 2  68                 PLA
0023FDr 2  85 rr              STA   list_ptr_hi
0023FFr 2  68                 PLA
002400r 2  85 rr              STA   list_ptr_lo
002402r 2  FA                 PLX
002403r 2  80 39              BRA   @rl_advance
002405r 2               
002405r 2               @rl_sublist:
002405r 2  DA                 PHX
002406r 2  A5 rr              LDA   list_ptr_lo
002408r 2  48                 PHA
002409r 2  A5 rr              LDA   list_ptr_hi
00240Br 2  48                 PHA
00240Cr 2                     ; Write '[' to buf
00240Cr 2  A5 rr              LDA   z:buf_idx
00240Er 2  C9 7E              CMP   #126
002410r 2  B0 25              BCS   @rl_sub_done
002412r 2  A8                 TAY
002413r 2  A9 5B              LDA   #'['
002415r 2  99 rr rr           STA   input_buf,Y
002418r 2  E6 rr              INC   z:buf_idx
00241Ar 2                     ; Get sublist pointer and recurse
00241Ar 2  A0 03              LDY   #CONS_CAR_LO
00241Cr 2  B1 rr              LDA   (ptr_lo),Y
00241Er 2  85 rr              STA   eval_val_lo
002420r 2  A0 02              LDY   #CONS_CAR_HI
002422r 2  B1 rr              LDA   (ptr_lo),Y
002424r 2  85 rr              STA   eval_val_hi
002426r 2  20 rr rr           JSR   render_list_to_buf
002429r 2                     ; Write ']' to buf
002429r 2  A5 rr              LDA   z:buf_idx
00242Br 2  C9 7E              CMP   #126
00242Dr 2  B0 08              BCS   @rl_sub_done
00242Fr 2  A8                 TAY
002430r 2  A9 5D              LDA   #']'
002432r 2  99 rr rr           STA   input_buf,Y
002435r 2  E6 rr              INC   z:buf_idx
002437r 2               @rl_sub_done:
002437r 2  68                 PLA
002438r 2  85 rr              STA   list_ptr_hi
00243Ar 2  68                 PLA
00243Br 2  85 rr              STA   list_ptr_lo
00243Dr 2  FA                 PLX
00243Er 2               
00243Er 2               @rl_advance:
00243Er 2                     ; Follow cdr
00243Er 2  A5 rr              LDA   list_ptr_lo
002440r 2  85 rr              STA   ptr_lo
002442r 2  A5 rr              LDA   list_ptr_hi
002444r 2  85 rr              STA   ptr_hi
002446r 2  A0 05              LDY   #CONS_CDR_LO
002448r 2  B1 rr              LDA   (ptr_lo),Y
00244Ar 2  AA                 TAX
00244Br 2  A0 06              LDY   #CONS_CDR_HI
00244Dr 2  B1 rr              LDA   (ptr_lo),Y
00244Fr 2  85 rr              STA   list_ptr_hi
002451r 2  86 rr              STX   list_ptr_lo
002453r 2  A2 01              LDX   #1                     ; always space after first element
002455r 2  4C rr rr           JMP   @rl_loop
