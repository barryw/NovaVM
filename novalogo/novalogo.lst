000E59r 2  A5 rr              LDA   eval_cur_lo
000E5Br 2  85 rr              STA   ptr_lo
000E5Dr 2  A5 rr              LDA   eval_cur_hi
000E5Fr 2  85 rr              STA   ptr_hi
000E61r 2  A0 00              LDY   #TOK_TAG
000E63r 2  B1 rr              LDA   (ptr_lo),Y
000E65r 2               
000E65r 2  C9 03              CMP   #TOK_LBRACKET
000E67r 2  D0 03              BNE   @not_lb
000E69r 2  E8                 INX
000E6Ar 2  80 07              BRA   @scan_next
000E6Cr 2               @not_lb:
000E6Cr 2  C9 04              CMP   #TOK_RBRACKET
000E6Er 2  D0 03              BNE   @scan_next
000E70r 2  CA                 DEX
000E71r 2  F0 07              BEQ   @found                 ; depth == 0 -> matched
000E73r 2               @scan_next:
000E73r 2  DA                 PHX
000E74r 2  20 rr rr           JSR   eval_advance
000E77r 2  FA                 PLX
000E78r 2  80 D9              BRA   @scan
000E7Ar 2               
000E7Ar 2               @found:
000E7Ar 2                     ; eval_cur is at the matching ]. Advance past it.
000E7Ar 2  20 rr rr           JSR   eval_advance
000E7Dr 2  18                 CLC
000E7Er 2  60                 RTS
000E7Fr 2               
000E7Fr 2               @err:
000E7Fr 2  38                 SEC
000E80r 2  60                 RTS
