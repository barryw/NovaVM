000F06r 2               ; ---------------------------------------------------------------------
000F06r 2               ; do_stop — STOP: exit current procedure immediately (no return value)
000F06r 2               ;   Arity 0, no arguments
000F06r 2               ; ---------------------------------------------------------------------
000F06r 2               do_stop:
