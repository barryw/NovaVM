000F1Cr 2  4C rr rr           JMP   eval_continue
000F1Fr 2               
000F1Fr 2               @err_bracket:
000F1Fr 2  A2 rr              LDX   #<str_if_bracket
000F21r 2  A0 rr              LDY   #>str_if_bracket
