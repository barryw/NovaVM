001040r 2  20 rr rr           JSR   eval_newline
001043r 2  4C rr rr           JMP   eval_continue
001046r 2               
001046r 2               ; ---------------------------------------------------------------------
001046r 2               ; do_throw — THROW "tag: unwind to matching CATCH
001046r 2               ;   Arity 0 — handles its own argument parsing
001046r 2               ;   1. Evaluate tag argument
001046r 2               ;   2. If catch is active and tags match: unwind via TXS
001046r 2               ;   3. If no match: print error
001046r 2               ; ---------------------------------------------------------------------
001046r 2               do_throw:
001046r 2                     ; Evaluate tag argument
001046r 2  20 rr rr           JSR   eval_expr
001049r 2  B0 70              BCS   @err_tag
00104Br 2               
00104Br 2                     ; Must be a word
00104Br 2  A5 rr              LDA   eval_type
00104Dr 2  C9 01              CMP   #VAL_WORD
00104Fr 2  D0 6A              BNE   @err_tag
001051r 2               
001051r 2                     ; Is a catch frame active?
001051r 2  A5 rr              LDA   catch_active
001053r 2  F0 3A              BEQ   @no_catch
001055r 2               
001055r 2                     ; Compare tags: eval_val_lo/hi vs catch_tag_lo/hi
001055r 2  A5 rr              LDA   eval_val_lo
001057r 2  85 rr              STA   ptr_lo
001059r 2  A5 rr              LDA   eval_val_hi
00105Br 2  85 rr              STA   ptr_hi
00105Dr 2  A5 rr              LDA   catch_tag_lo
00105Fr 2  85 rr              STA   ptr2_lo
001061r 2  A5 rr              LDA   catch_tag_hi
001063r 2  85 rr              STA   ptr2_hi
001065r 2  20 rr rr           JSR   catch_tags_equal
001068r 2  90 25              BCC   @no_catch
00106Ar 2               
00106Ar 2                     ; Match! Unwind stack to catch point.
00106Ar 2  A6 rr              LDX   catch_sp
00106Cr 2  9A                 TXS
00106Dr 2               
00106Dr 2                     ; Restore previous catch frame from the restored stack
00106Dr 2  68                 PLA
00106Er 2  85 rr              STA   catch_resume_hi
001070r 2  68                 PLA
001071r 2  85 rr              STA   catch_resume_lo
001073r 2  68                 PLA
001074r 2  85 rr              STA   catch_sp
001076r 2  68                 PLA
001077r 2  85 rr              STA   catch_tag_hi
001079r 2  68                 PLA
00107Ar 2  85 rr              STA   catch_tag_lo
00107Cr 2  68                 PLA
00107Dr 2  85 rr              STA   catch_active
00107Fr 2               
00107Fr 2                     ; Restore eval_in_body and discard saved tag pointer (3 bytes)
00107Fr 2  68                 PLA
