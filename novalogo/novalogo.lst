00320Fr 2               ; ---------------------------------------------------------------------
00320Fr 2               ; do_apply — APPLY "proc [args]: call procedure with args from list
00320Fr 2               ;   Arity 0 — evaluates its own arguments
00320Fr 2               ;   Strategy: build "name arg1 arg2 ..." in input_buf, tokenize+eval.
00320Fr 2               ; ---------------------------------------------------------------------
00320Fr 2               do_apply:
00320Fr 2                     ; Evaluate first arg: procedure name (quoted word)
00320Fr 2  20 rr rr           JSR   eval_expr
003212r 2  90 03              BCC   @ap_type_ok
003214r 2  4C rr rr           JMP   @err
003217r 2               @ap_type_ok:
003217r 2  A5 rr              LDA   eval_type
003219r 2  C9 01              CMP   #VAL_WORD
00321Br 2  F0 03              BEQ   @ap_word_ok
00321Dr 2  4C rr rr           JMP   @err
003220r 2               @ap_word_ok:
003220r 2               
003220r 2                     ; Copy proc name to input_buf
003220r 2  A5 rr              LDA   eval_val_lo
003222r 2  85 rr              STA   ptr_lo
003224r 2  A5 rr              LDA   eval_val_hi
003226r 2  85 rr              STA   ptr_hi
003228r 2  64 rr              STZ   z:buf_idx
00322Ar 2  A0 00              LDY   #0
00322Cr 2  B1 rr              LDA   (ptr_lo),Y             ; name length
00322Er 2  AA                 TAX
00322Fr 2  F0 10              BEQ   @apply_args
003231r 2  C8                 INY
003232r 2               @apply_name:
003232r 2  B1 rr              LDA   (ptr_lo),Y
003234r 2  5A                 PHY
003235r 2  A4 rr              LDY   z:buf_idx
003237r 2  99 rr rr           STA   input_buf,Y
00323Ar 2  E6 rr              INC   z:buf_idx
00323Cr 2  7A                 PLY
00323Dr 2  C8                 INY
00323Er 2  CA                 DEX
00323Fr 2  D0 F1              BNE   @apply_name
003241r 2               
003241r 2               @apply_args:
003241r 2                     ; Evaluate second arg: list of arguments
003241r 2  20 rr rr           JSR   eval_expr
003244r 2  B0 5B              BCS   @err
003246r 2  A5 rr              LDA   eval_type
003248r 2  C9 02              CMP   #VAL_LIST
00324Ar 2  D0 55              BNE   @err
00324Cr 2               
00324Cr 2                     ; Render list elements to input_buf (after name)
00324Cr 2                     ; eval_val_lo/hi = list head
00324Cr 2  A5 rr              LDA   eval_val_lo
00324Er 2  05 rr              ORA   eval_val_hi
003250r 2  F0 11              BEQ   @apply_run              ; empty arg list, just run name
003252r 2               
003252r 2                     ; Use render_list_to_buf — it prepends space before elements
003252r 2                     ; but we need a space before the first arg too
003252r 2  A5 rr              LDA   z:buf_idx
003254r 2  C9 7E              CMP   #126
003256r 2  B0 0B              BCS   @apply_run
003258r 2  A8                 TAY
003259r 2  A9 20              LDA   #' '
00325Br 2  99 rr rr           STA   input_buf,Y
00325Er 2  E6 rr              INC   z:buf_idx
003260r 2               
003260r 2                     ; render_list_to_buf expects eval_val set
003260r 2  20 rr rr           JSR   render_list_to_buf
003263r 2               
003263r 2               @apply_run:
003263r 2                     ; Null-terminate
003263r 2  A6 rr              LDX   z:buf_idx
003265r 2  9E rr rr           STZ   input_buf,X
003268r 2               
003268r 2                     ; Save eval state and tokenize+eval (same pattern as do_run)
003268r 2  A5 rr              LDA   eval_cur_lo
00326Ar 2  48                 PHA
00326Br 2  A5 rr              LDA   eval_cur_hi
00326Dr 2  48                 PHA
00326Er 2  A5 rr              LDA   tok_head_lo
003270r 2  48                 PHA
003271r 2  A5 rr              LDA   tok_head_hi
003273r 2  48                 PHA
003274r 2  A5 rr              LDA   tok_tail_lo
003276r 2  48                 PHA
003277r 2  A5 rr              LDA   tok_tail_hi
003279r 2  48                 PHA
00327Ar 2  A5 rr              LDA   eval_in_body
00327Cr 2  48                 PHA
00327Dr 2  A5 rr              LDA   eval_reporter
00327Fr 2  48                 PHA
003280r 2               
003280r 2  20 rr rr           JSR   tokenize_line
003283r 2  20 rr rr           JSR   eval_line
003286r 2               
003286r 2  68                 PLA
003287r 2  85 rr              STA   eval_reporter
003289r 2  68                 PLA
00328Ar 2  85 rr              STA   eval_in_body
00328Cr 2  68                 PLA
00328Dr 2  85 rr              STA   tok_tail_hi
00328Fr 2  68                 PLA
003290r 2  85 rr              STA   tok_tail_lo
003292r 2  68                 PLA
003293r 2  85 rr              STA   tok_head_hi
003295r 2  68                 PLA
003296r 2  85 rr              STA   tok_head_lo
003298r 2  68                 PLA
003299r 2  85 rr              STA   eval_cur_hi
00329Br 2  68                 PLA
00329Cr 2  85 rr              STA   eval_cur_lo
00329Er 2               
00329Er 2  4C rr rr           JMP   eval_continue
0032A1r 2               
0032A1r 2               @err:
0032A1r 2  A2 rr              LDX   #<str_apply_name
0032A3r 2  A0 rr              LDY   #>str_apply_name
0032A5r 2  4C rr rr           JMP   err_nei
0032A8r 2               
0032A8r 2               ; =====================================================================
0032A8r 2               ; RODATA — procedure strings
0032A8r 2               ; =====================================================================
0032A8r 2                     .segment "RODATA"
00061Er 2               
00061Er 2               
00061Er 2               
00061Er 2               
00061Er 2               ; Builtin name strings for workspace commands
00061Er 2               str_po_name:
00061Er 2  02 50 4F           .byte 2, "PO"
000621r 2               str_printout_name:
000621r 2  08 50 52 49        .byte 8, "PRINTOUT"
000625r 2  4E 54 4F 55  
000629r 2  54           
00062Ar 2               str_pots_name:
00062Ar 2  04 50 4F 54        .byte 4, "POTS"
00062Er 2  53           
00062Fr 2               str_printtitles_name:
00062Fr 2  0B 50 52 49        .byte 11, "PRINTTITLES"
000633r 2  4E 54 54 49  
000637r 2  54 4C 45 53  
00063Br 2               str_erase_name:
00063Br 2  05 45 52 41        .byte 5, "ERASE"
00063Fr 2  53 45        
000641r 2               str_apply_name:
000641r 2  05 41 50 50        .byte 5, "APPLY"
000645r 2  4C 59        
000647r 2               
000647r 1                     .include "gc.s"
000647r 2               ; gc.s — mark-sweep garbage collector for NovaLogo
000647r 2               ;
000647r 2               ; Allocation header (prepended by heap_alloc):
000647r 2               ;   +0: alloc_tag  (bit 7 = mark, bits 6-0 = type)
000647r 2               ;   +1: alloc_size (total size including header; 0 = use 16-bit size at +2/+3)
000647r 2               ;
000647r 2               ; Type constants (bits 6-0 of alloc_tag):
000647r 2               ATYPE_FREE   = $00
000647r 2               ATYPE_TOKEN  = $01
000647r 2               ATYPE_CONS   = $02
000647r 2               ATYPE_VAR    = $03
000647r 2               ATYPE_PROC   = $04
000647r 2               ATYPE_STRING = $05
000647r 2               
000647r 2               ; Header layout offsets (relative to allocation base, NOT payload)
000647r 2               GC_HDR_TAG   = 0
000647r 2               GC_HDR_SIZE  = 1
000647r 2               GC_HDR_BYTES = 2              ; overhead per allocation
000647r 2               
000647r 2               ; Mark bit
000647r 2               ALLOC_MARK_BIT = $80
000647r 2               
000647r 2               ; =====================================================================
000647r 2               ; ZEROPAGE segment — GC variables
000647r 2               ; =====================================================================
000647r 2                     .segment "ZEROPAGE"
000048r 2               
000048r 2  xx           gc_ptr_lo:    .res 1          ; GC walk pointer low
000049r 2  xx           gc_ptr_hi:    .res 1          ; GC walk pointer high
00004Ar 2  xx           gc_tmp_lo:    .res 1          ; GC temp low
00004Br 2  xx           gc_tmp_hi:    .res 1          ; GC temp high
00004Cr 2  xx           gc_mark_lo:   .res 1          ; node-to-mark pointer low
00004Dr 2  xx           gc_mark_hi:   .res 1          ; node-to-mark pointer high
00004Er 2               
00004Er 2               ; =====================================================================
00004Er 2               ; CODE segment — GC routines
00004Er 2               ; =====================================================================
00004Er 2                     .segment "CODE"
0032A8r 2               
0032A8r 2               ; ---------------------------------------------------------------------
0032A8r 2               ; gc_collect — run a full mark-sweep garbage collection cycle
0032A8r 2               ;   1. Clear all mark bits
0032A8r 2               ;   2. Mark all reachable objects from roots
0032A8r 2               ;   3. Sweep: coalesce all unmarked blocks and reset heap_ptr
0032A8r 2               ;
0032A8r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_tmp, gc_mark, ptr_lo/hi, ptr2_lo/hi
0032A8r 2               ; ---------------------------------------------------------------------
0032A8r 2               gc_collect:
0032A8r 2                     ; Phase 1: Clear all mark bits by walking the heap linearly
0032A8r 2  A9 00              LDA   #<HEAP_START
0032AAr 2  85 rr              STA   gc_ptr_lo
0032ACr 2  A9 05              LDA   #>HEAP_START
0032AEr 2  85 rr              STA   gc_ptr_hi
0032B0r 2               
0032B0r 2               @clear_loop:
0032B0r 2                     ; Have we reached heap_ptr (end of allocated space)?
0032B0r 2  A5 rr              LDA   gc_ptr_hi
0032B2r 2  C5 rr              CMP   heap_ptr+1
0032B4r 2  90 08              BCC   @clear_one
0032B6r 2  D0 41              BNE   @clear_done
0032B8r 2  A5 rr              LDA   gc_ptr_lo
0032BAr 2  C5 rr              CMP   heap_ptr
0032BCr 2  B0 3B              BCS   @clear_done
0032BEr 2               
0032BEr 2               @clear_one:
0032BEr 2                     ; Clear mark bit on this allocation
0032BEr 2  A5 rr              LDA   gc_ptr_lo
0032C0r 2  85 rr              STA   ptr_lo
0032C2r 2  A5 rr              LDA   gc_ptr_hi
0032C4r 2  85 rr              STA   ptr_hi
0032C6r 2  A0 00              LDY   #GC_HDR_TAG
0032C8r 2  B1 rr              LDA   (ptr_lo),Y
0032CAr 2  29 7F              AND   #<~ALLOC_MARK_BIT    ; clear bit 7
0032CCr 2  91 rr              STA   (ptr_lo),Y
0032CEr 2               
0032CEr 2                     ; Advance by alloc_size
0032CEr 2  A0 01              LDY   #GC_HDR_SIZE
0032D0r 2  B1 rr              LDA   (ptr_lo),Y
0032D2r 2  F0 0B              BEQ   @clear_big           ; size=0 means 16-bit size at +2/+3
0032D4r 2  18                 CLC
0032D5r 2  65 rr              ADC   gc_ptr_lo
0032D7r 2  85 rr              STA   gc_ptr_lo
0032D9r 2  90 D5              BCC   @clear_loop
0032DBr 2  E6 rr              INC   gc_ptr_hi
0032DDr 2  80 D1              BRA   @clear_loop
0032DFr 2               
0032DFr 2               @clear_big:
0032DFr 2                     ; 16-bit size at payload offset 0 and 1 (header +2 and +3)
0032DFr 2  A0 02              LDY   #GC_HDR_BYTES
0032E1r 2  B1 rr              LDA   (ptr_lo),Y
0032E3r 2  85 rr              STA   gc_tmp_lo
0032E5r 2  C8                 INY
0032E6r 2  B1 rr              LDA   (ptr_lo),Y
0032E8r 2  85 rr              STA   gc_tmp_hi
0032EAr 2  18                 CLC
0032EBr 2  A5 rr              LDA   gc_ptr_lo
0032EDr 2  65 rr              ADC   gc_tmp_lo
0032EFr 2  85 rr              STA   gc_ptr_lo
0032F1r 2  A5 rr              LDA   gc_ptr_hi
0032F3r 2  65 rr              ADC   gc_tmp_hi
0032F5r 2  85 rr              STA   gc_ptr_hi
0032F7r 2  80 B7              BRA   @clear_loop
0032F9r 2               
0032F9r 2               @clear_done:
0032F9r 2               
0032F9r 2                     ; Phase 2: Mark all reachable objects
0032F9r 2                     ; Root 1: variable list (var_head)
0032F9r 2  20 rr rr           JSR   gc_mark_vars
0032FCr 2               
0032FCr 2                     ; Root 2: procedure list (proc_head)
0032FCr 2  20 rr rr           JSR   gc_mark_procs
0032FFr 2               
0032FFr 2                     ; Root 3: current token list (tok_head)
0032FFr 2  20 rr rr           JSR   gc_mark_token_list
003302r 2               
003302r 2                     ; Phase 3: Sweep — find the highest marked allocation,
003302r 2                     ; reset heap_ptr to just past it. This works because we
003302r 2                     ; use a bump allocator with no free list; all unmarked
003302r 2                     ; allocations between marked ones become wasted space,
003302r 2                     ; but in practice the permanent objects (vars, procs) are
003302r 2                     ; allocated early and the ephemeral ones (tokens, cons,
003302r 2                     ; strings) are allocated later and all unmarked — so
003302r 2                     ; heap_ptr shrinks back dramatically.
003302r 2                     ;
003302r 2                     ; Walk the heap forward; track the highest end-address
003302r 2                     ; of any marked allocation.
003302r 2  A9 00              LDA   #<HEAP_START
003304r 2  85 rr              STA   gc_ptr_lo
003306r 2  A9 05              LDA   #>HEAP_START
003308r 2  85 rr              STA   gc_ptr_hi
00330Ar 2                     ; gc_tmp = highest marked end (start at HEAP_START = nothing marked)
00330Ar 2  A9 00              LDA   #<HEAP_START
00330Cr 2  85 rr              STA   gc_tmp_lo
00330Er 2  A9 05              LDA   #>HEAP_START
003310r 2  85 rr              STA   gc_tmp_hi
003312r 2               
003312r 2               @sweep_loop:
003312r 2                     ; Reached end of allocated space?
003312r 2  A5 rr              LDA   gc_ptr_hi
003314r 2  C5 rr              CMP   heap_ptr+1
003316r 2  90 08              BCC   @sweep_one
003318r 2  D0 49              BNE   @sweep_done
00331Ar 2  A5 rr              LDA   gc_ptr_lo
00331Cr 2  C5 rr              CMP   heap_ptr
00331Er 2  B0 43              BCS   @sweep_done
003320r 2               
003320r 2               @sweep_one:
003320r 2  A5 rr              LDA   gc_ptr_lo
003322r 2  85 rr              STA   ptr_lo
003324r 2  A5 rr              LDA   gc_ptr_hi
003326r 2  85 rr              STA   ptr_hi
003328r 2               
003328r 2                     ; Get size of this allocation
003328r 2  A0 01              LDY   #GC_HDR_SIZE
00332Ar 2  B1 rr              LDA   (ptr_lo),Y
00332Cr 2  F0 06              BEQ   @sweep_big
00332Er 2  85 rr              STA   gc_mark_lo            ; use gc_mark_lo as temp for size
003330r 2  64 rr              STZ   gc_mark_hi
003332r 2  80 0B              BRA   @sweep_check_mark
003334r 2               
003334r 2               @sweep_big:
003334r 2  A0 02              LDY   #GC_HDR_BYTES
003336r 2  B1 rr              LDA   (ptr_lo),Y
003338r 2  85 rr              STA   gc_mark_lo
00333Ar 2  C8                 INY
00333Br 2  B1 rr              LDA   (ptr_lo),Y
00333Dr 2  85 rr              STA   gc_mark_hi
00333Fr 2               
00333Fr 2               @sweep_check_mark:
00333Fr 2                     ; Is this allocation marked?
00333Fr 2  A0 00              LDY   #GC_HDR_TAG
003341r 2  B1 rr              LDA   (ptr_lo),Y
003343r 2  29 80              AND   #ALLOC_MARK_BIT
003345r 2  F0 0D              BEQ   @sweep_advance        ; not marked — skip
003347r 2               
003347r 2                     ; Marked — compute end address = gc_ptr + size
003347r 2  18                 CLC
003348r 2  A5 rr              LDA   gc_ptr_lo
00334Ar 2  65 rr              ADC   gc_mark_lo
00334Cr 2  85 rr              STA   gc_tmp_lo             ; update highest end
00334Er 2  A5 rr              LDA   gc_ptr_hi
003350r 2  65 rr              ADC   gc_mark_hi
003352r 2  85 rr              STA   gc_tmp_hi
003354r 2               
003354r 2               @sweep_advance:
003354r 2                     ; Advance gc_ptr by size
003354r 2  18                 CLC
003355r 2  A5 rr              LDA   gc_ptr_lo
003357r 2  65 rr              ADC   gc_mark_lo
003359r 2  85 rr              STA   gc_ptr_lo
00335Br 2  A5 rr              LDA   gc_ptr_hi
00335Dr 2  65 rr              ADC   gc_mark_hi
00335Fr 2  85 rr              STA   gc_ptr_hi
003361r 2  80 AF              BRA   @sweep_loop
003363r 2               
003363r 2               @sweep_done:
003363r 2                     ; Set heap_ptr to highest marked end
003363r 2  A5 rr              LDA   gc_tmp_lo
003365r 2  85 rr              STA   heap_ptr
003367r 2  A5 rr              LDA   gc_tmp_hi
003369r 2  85 rr              STA   heap_ptr+1
00336Br 2  60                 RTS
00336Cr 2               
00336Cr 2               ; ---------------------------------------------------------------------
00336Cr 2               ; gc_mark_node — mark a single allocation given a payload pointer
00336Cr 2               ;   Input: gc_mark_lo/hi = pointer to payload (header is at -2)
00336Cr 2               ;   If pointer is $0000 or below HEAP_START, skip.
00336Cr 2               ;   Clobbers: A, Y (preserves gc_mark_lo/hi)
00336Cr 2               ; ---------------------------------------------------------------------
00336Cr 2               gc_mark_node:
00336Cr 2                     ; Null check
00336Cr 2  A5 rr              LDA   gc_mark_lo
00336Er 2  05 rr              ORA   gc_mark_hi
003370r 2  F0 21              BEQ   @done
003372r 2               
003372r 2                     ; Compute header address = payload - 2
003372r 2  A5 rr              LDA   gc_mark_lo
003374r 2  38                 SEC
003375r 2  E9 02              SBC   #GC_HDR_BYTES
003377r 2  85 rr              STA   ptr_lo
003379r 2  A5 rr              LDA   gc_mark_hi
00337Br 2  E9 00              SBC   #0
00337Dr 2  85 rr              STA   ptr_hi
00337Fr 2               
00337Fr 2                     ; Range check: must be >= HEAP_START
00337Fr 2  C9 05              CMP   #>HEAP_START
003381r 2  90 10              BCC   @done
003383r 2  D0 06              BNE   @in_range
003385r 2  A5 rr              LDA   ptr_lo
003387r 2  C9 00              CMP   #<HEAP_START
003389r 2  90 08              BCC   @done
00338Br 2               @in_range:
00338Br 2               
00338Br 2                     ; Set mark bit
00338Br 2  A0 00              LDY   #GC_HDR_TAG
00338Dr 2  B1 rr              LDA   (ptr_lo),Y
00338Fr 2  09 80              ORA   #ALLOC_MARK_BIT
003391r 2  91 rr              STA   (ptr_lo),Y
003393r 2               @done:
003393r 2  60                 RTS
003394r 2               
003394r 2               ; ---------------------------------------------------------------------
003394r 2               ; gc_mark_vars — walk the variable linked list and mark each entry
003394r 2               ;   Also marks any list values pointed to by variables.
003394r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_mark, ptr_lo/hi, ptr2_lo/hi
003394r 2               ; ---------------------------------------------------------------------
003394r 2               gc_mark_vars:
003394r 2  A5 rr              LDA   var_head_lo
003396r 2  85 rr              STA   gc_ptr_lo
003398r 2  A5 rr              LDA   var_head_hi
00339Ar 2  85 rr              STA   gc_ptr_hi
00339Cr 2               
00339Cr 2               @walk:
00339Cr 2  A5 rr              LDA   gc_ptr_lo
00339Er 2  05 rr              ORA   gc_ptr_hi
0033A0r 2  D0 01              BNE   @have_var
0033A2r 2  60                 RTS
0033A3r 2               @have_var:
0033A3r 2               
0033A3r 2                     ; Mark this var entry
0033A3r 2  A5 rr              LDA   gc_ptr_lo
0033A5r 2  85 rr              STA   gc_mark_lo
0033A7r 2  A5 rr              LDA   gc_ptr_hi
0033A9r 2  85 rr              STA   gc_mark_hi
0033ABr 2  20 rr rr           JSR   gc_mark_node
0033AEr 2               
0033AEr 2                     ; Read the variable's value — if it's a list, mark the list
0033AEr 2  A5 rr              LDA   gc_ptr_lo
0033B0r 2  85 rr              STA   ptr_lo
0033B2r 2  A5 rr              LDA   gc_ptr_hi
0033B4r 2  85 rr              STA   ptr_hi
0033B6r 2  A0 02              LDY   #VAR_NAME_LEN
0033B8r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
0033BAr 2  18                 CLC
0033BBr 2  69 03              ADC   #VAR_NAME             ; offset to value_type
0033BDr 2  A8                 TAY
0033BEr 2  B1 rr              LDA   (ptr_lo),Y           ; value_type
0033C0r 2  C9 02              CMP   #VAL_LIST
0033C2r 2  D0 23              BNE   @var_check_word
0033C4r 2                     ; It's a list — get the list head pointer and mark the list
0033C4r 2  C8                 INY
0033C5r 2  B1 rr              LDA   (ptr_lo),Y           ; val_hi (actually car_hi)
0033C7r 2  85 rr              STA   gc_tmp_hi
0033C9r 2  C8                 INY
0033CAr 2  B1 rr              LDA   (ptr_lo),Y           ; val_lo
0033CCr 2  85 rr              STA   gc_tmp_lo
0033CEr 2                     ; Save gc_ptr across recursive mark
0033CEr 2  A5 rr              LDA   gc_ptr_lo
0033D0r 2  48                 PHA
0033D1r 2  A5 rr              LDA   gc_ptr_hi
0033D3r 2  48                 PHA
0033D4r 2  A5 rr              LDA   gc_tmp_lo
0033D6r 2  85 rr              STA   gc_mark_lo
0033D8r 2  A5 rr              LDA   gc_tmp_hi
0033DAr 2  85 rr              STA   gc_mark_hi
0033DCr 2  20 rr rr           JSR   gc_mark_list
0033DFr 2  68                 PLA
0033E0r 2  85 rr              STA   gc_ptr_hi
0033E2r 2  68                 PLA
0033E3r 2  85 rr              STA   gc_ptr_lo
0033E5r 2  80 25              BRA   @var_next
0033E7r 2               
0033E7r 2               @var_check_word:
0033E7r 2  C9 01              CMP   #VAL_WORD
0033E9r 2  D0 21              BNE   @var_next
0033EBr 2                     ; It's a word — mark the string allocation
0033EBr 2  C8                 INY
0033ECr 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_hi for word
0033EEr 2  85 rr              STA   gc_tmp_hi
0033F0r 2  C8                 INY
0033F1r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_lo for word
0033F3r 2  85 rr              STA   gc_tmp_lo
0033F5r 2  A5 rr              LDA   gc_ptr_lo
0033F7r 2  48                 PHA
0033F8r 2  A5 rr              LDA   gc_ptr_hi
0033FAr 2  48                 PHA
0033FBr 2  A5 rr              LDA   gc_tmp_lo
0033FDr 2  85 rr              STA   gc_mark_lo
0033FFr 2  A5 rr              LDA   gc_tmp_hi
003401r 2  85 rr              STA   gc_mark_hi
003403r 2  20 rr rr           JSR   gc_mark_node
003406r 2  68                 PLA
003407r 2  85 rr              STA   gc_ptr_hi
003409r 2  68                 PLA
00340Ar 2  85 rr              STA   gc_ptr_lo
00340Cr 2               
00340Cr 2               @var_next:
00340Cr 2                     ; Follow next pointer
00340Cr 2  A5 rr              LDA   gc_ptr_lo
00340Er 2  85 rr              STA   ptr_lo
003410r 2  A5 rr              LDA   gc_ptr_hi
003412r 2  85 rr              STA   ptr_hi
003414r 2  A0 00              LDY   #VAR_NEXT_LO
003416r 2  B1 rr              LDA   (ptr_lo),Y
003418r 2  AA                 TAX
003419r 2  C8                 INY
00341Ar 2  B1 rr              LDA   (ptr_lo),Y
00341Cr 2  85 rr              STA   gc_ptr_hi
00341Er 2  86 rr              STX   gc_ptr_lo
003420r 2  4C rr rr           JMP   @walk
003423r 2               
003423r 2               ; ---------------------------------------------------------------------
003423r 2               ; gc_mark_procs — walk the procedure list and mark each record
003423r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
003423r 2               ; ---------------------------------------------------------------------
003423r 2               gc_mark_procs:
003423r 2  A5 rr              LDA   proc_head_lo
003425r 2  85 rr              STA   gc_ptr_lo
003427r 2  A5 rr              LDA   proc_head_hi
003429r 2  85 rr              STA   gc_ptr_hi
00342Br 2               
00342Br 2               @walk:
00342Br 2  A5 rr              LDA   gc_ptr_lo
00342Dr 2  05 rr              ORA   gc_ptr_hi
00342Fr 2  F0 2B              BEQ   @done
003431r 2               
003431r 2                     ; Mark this procedure record.
003431r 2                     ; proc_entry points to record data (base+4); header is at base+0.
003431r 2                     ; Subtract 4 to get the header address for marking.
003431r 2  A5 rr              LDA   gc_ptr_lo
003433r 2  38                 SEC
003434r 2  E9 04              SBC   #4
003436r 2  85 rr              STA   ptr_lo
003438r 2  A5 rr              LDA   gc_ptr_hi
00343Ar 2  E9 00              SBC   #0
00343Cr 2  85 rr              STA   ptr_hi
00343Er 2                     ; Set mark bit directly at the header
00343Er 2  A0 00              LDY   #GC_HDR_TAG
003440r 2  B1 rr              LDA   (ptr_lo),Y
003442r 2  09 80              ORA   #ALLOC_MARK_BIT
003444r 2  91 rr              STA   (ptr_lo),Y
003446r 2               
003446r 2                     ; Follow next pointer (at record data offset 0)
003446r 2  A5 rr              LDA   gc_ptr_lo
003448r 2  85 rr              STA   ptr_lo
00344Ar 2  A5 rr              LDA   gc_ptr_hi
00344Cr 2  85 rr              STA   ptr_hi
00344Er 2  A0 00              LDY   #0                    ; next_lo at offset 0
003450r 2  B1 rr              LDA   (ptr_lo),Y
003452r 2  AA                 TAX
003453r 2  C8                 INY
003454r 2  B1 rr              LDA   (ptr_lo),Y
003456r 2  85 rr              STA   gc_ptr_hi
003458r 2  86 rr              STX   gc_ptr_lo
00345Ar 2  80 CF              BRA   @walk
00345Cr 2               
00345Cr 2               @done:
00345Cr 2  60                 RTS
00345Dr 2               
00345Dr 2               ; ---------------------------------------------------------------------
00345Dr 2               ; gc_mark_token_list — walk tok_head linked list and mark each token
00345Dr 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
00345Dr 2               ; ---------------------------------------------------------------------
00345Dr 2               gc_mark_token_list:
00345Dr 2  A5 rr              LDA   tok_head_lo
00345Fr 2  85 rr              STA   gc_ptr_lo
003461r 2  A5 rr              LDA   tok_head_hi
003463r 2  85 rr              STA   gc_ptr_hi
003465r 2               
003465r 2               @walk:
003465r 2  A5 rr              LDA   gc_ptr_lo
003467r 2  05 rr              ORA   gc_ptr_hi
003469r 2  F0 21              BEQ   @done
00346Br 2               
00346Br 2                     ; Mark this token
00346Br 2  A5 rr              LDA   gc_ptr_lo
00346Dr 2  85 rr              STA   gc_mark_lo
00346Fr 2  A5 rr              LDA   gc_ptr_hi
003471r 2  85 rr              STA   gc_mark_hi
003473r 2  20 rr rr           JSR   gc_mark_node
003476r 2               
003476r 2                     ; Follow next pointer (at payload offsets TOK_NEXT_LO/HI)
003476r 2  A5 rr              LDA   gc_ptr_lo
003478r 2  85 rr              STA   ptr_lo
00347Ar 2  A5 rr              LDA   gc_ptr_hi
00347Cr 2  85 rr              STA   ptr_hi
00347Er 2  A0 01              LDY   #TOK_NEXT_LO
003480r 2  B1 rr              LDA   (ptr_lo),Y
003482r 2  AA                 TAX
003483r 2  C8                 INY
003484r 2  B1 rr              LDA   (ptr_lo),Y
003486r 2  85 rr              STA   gc_ptr_hi
003488r 2  86 rr              STX   gc_ptr_lo
00348Ar 2  80 D9              BRA   @walk
00348Cr 2               
00348Cr 2               @done:
00348Cr 2  60                 RTS
00348Dr 2               
00348Dr 2               ; ---------------------------------------------------------------------
00348Dr 2               ; gc_mark_list — recursively mark a cons-pair list
00348Dr 2               ;   Input: gc_mark_lo/hi = head cons pair pointer (payload)
00348Dr 2               ;   Marks each cons cell, and recursively marks sublists and word strings.
00348Dr 2               ;   Clobbers: A, X, Y, gc_mark, gc_ptr, ptr_lo/hi
00348Dr 2               ; ---------------------------------------------------------------------
00348Dr 2               gc_mark_list:
00348Dr 2                     ; Use gc_ptr to walk the list, gc_mark for marking
00348Dr 2  A5 rr              LDA   gc_mark_lo
00348Fr 2  85 rr              STA   gc_ptr_lo
003491r 2  A5 rr              LDA   gc_mark_hi
003493r 2  85 rr              STA   gc_ptr_hi
003495r 2               
003495r 2               @walk:
003495r 2  A5 rr              LDA   gc_ptr_lo
003497r 2  05 rr              ORA   gc_ptr_hi
003499r 2  F0 70              BEQ   @done
00349Br 2               
00349Br 2                     ; Mark this cons pair
00349Br 2  A5 rr              LDA   gc_ptr_lo
00349Dr 2  85 rr              STA   gc_mark_lo
00349Fr 2  A5 rr              LDA   gc_ptr_hi
0034A1r 2  85 rr              STA   gc_mark_hi
0034A3r 2  20 rr rr           JSR   gc_mark_node
0034A6r 2               
0034A6r 2                     ; Check car_type: if list, recursively mark sublist
0034A6r 2                     ; if word, mark the string
0034A6r 2  A5 rr              LDA   gc_ptr_lo
0034A8r 2  85 rr              STA   ptr_lo
0034AAr 2  A5 rr              LDA   gc_ptr_hi
0034ACr 2  85 rr              STA   ptr_hi
0034AEr 2  A0 01              LDY   #CONS_CAR_TYPE
0034B0r 2  B1 rr              LDA   (ptr_lo),Y
0034B2r 2  C9 02              CMP   #VAL_LIST
0034B4r 2  F0 23              BEQ   @car_list
0034B6r 2  C9 01              CMP   #VAL_WORD
0034B8r 2  F0 02              BEQ   @car_word
0034BAr 2  80 38              BRA   @follow_cdr
0034BCr 2               
0034BCr 2               @car_word:
0034BCr 2                     ; Mark the word string allocation
0034BCr 2  A0 03              LDY   #CONS_CAR_LO
0034BEr 2  B1 rr              LDA   (ptr_lo),Y
0034C0r 2  85 rr              STA   gc_mark_lo
0034C2r 2  A0 02              LDY   #CONS_CAR_HI
0034C4r 2  B1 rr              LDA   (ptr_lo),Y
0034C6r 2  85 rr              STA   gc_mark_hi
0034C8r 2                     ; Save gc_ptr across mark
0034C8r 2  A5 rr              LDA   gc_ptr_lo
0034CAr 2  48                 PHA
0034CBr 2  A5 rr              LDA   gc_ptr_hi
0034CDr 2  48                 PHA
0034CEr 2  20 rr rr           JSR   gc_mark_node
0034D1r 2  68                 PLA
0034D2r 2  85 rr              STA   gc_ptr_hi
0034D4r 2  68                 PLA
0034D5r 2  85 rr              STA   gc_ptr_lo
0034D7r 2  80 1B              BRA   @follow_cdr
0034D9r 2               
0034D9r 2               @car_list:
0034D9r 2                     ; Recursively mark the sublist
0034D9r 2  A0 03              LDY   #CONS_CAR_LO
0034DBr 2  B1 rr              LDA   (ptr_lo),Y
0034DDr 2  85 rr              STA   gc_mark_lo
0034DFr 2  A0 02              LDY   #CONS_CAR_HI
0034E1r 2  B1 rr              LDA   (ptr_lo),Y
0034E3r 2  85 rr              STA   gc_mark_hi
0034E5r 2                     ; Save gc_ptr across recursive call
0034E5r 2  A5 rr              LDA   gc_ptr_lo
0034E7r 2  48                 PHA
0034E8r 2  A5 rr              LDA   gc_ptr_hi
0034EAr 2  48                 PHA
0034EBr 2  20 rr rr           JSR   gc_mark_list          ; recursive
0034EEr 2  68                 PLA
0034EFr 2  85 rr              STA   gc_ptr_hi
0034F1r 2  68                 PLA
0034F2r 2  85 rr              STA   gc_ptr_lo
0034F4r 2               
0034F4r 2               @follow_cdr:
0034F4r 2                     ; Follow cdr to next cons pair
0034F4r 2  A5 rr              LDA   gc_ptr_lo
0034F6r 2  85 rr              STA   ptr_lo
0034F8r 2  A5 rr              LDA   gc_ptr_hi
0034FAr 2  85 rr              STA   ptr_hi
0034FCr 2  A0 05              LDY   #CONS_CDR_LO
0034FEr 2  B1 rr              LDA   (ptr_lo),Y
003500r 2  AA                 TAX
003501r 2  A0 06              LDY   #CONS_CDR_HI
003503r 2  B1 rr              LDA   (ptr_lo),Y
003505r 2  85 rr              STA   gc_ptr_hi
003507r 2  86 rr              STX   gc_ptr_lo
003509r 2  80 8A              BRA   @walk
00350Br 2               
00350Br 2               @done:
00350Br 2  60                 RTS
00350Cr 2               
00350Cr 1               
00350Cr 1               ; =====================================================================
00350Cr 1               ; ZEROPAGE segment — interpreter zero-page variables
00350Cr 1               ; =====================================================================
00350Cr 1                     .segment "ZEROPAGE"
00004Er 1               
00004Er 1  xx           buf_idx:      .res 1          ; current position in input_buf
00004Fr 1               
00004Fr 1               ; =====================================================================
00004Fr 1               ; BSS segment — runtime buffers
00004Fr 1               ; =====================================================================
00004Fr 1                     .segment "BSS"
000984r 1               
000984r 1  xx xx xx xx  input_buf:    .res 128        ; input line buffer
000988r 1  xx xx xx xx  
00098Cr 1  xx xx xx xx  
000A04r 1               
000A04r 1               ; =====================================================================
000A04r 1               ; CODE segment — cold start and main loop
000A04r 1               ; =====================================================================
000A04r 1                     .segment "CODE"
00350Cr 1               
00350Cr 1               cold_start:
00350Cr 1                     ; Copy extension ROM trampoline to RAM
00350Cr 1  A2 0D              LDX   #EXT_TRAMP_SIZE-1
00350Er 1               @copy_tramp:
00350Er 1  BD rr rr           LDA   ext_tramp_src,X
003511r 1  9D 70 02           STA   EXT_TRAMPOLINE,X
003514r 1  CA                 DEX
003515r 1  10 F7              BPL   @copy_tramp
003517r 1               
003517r 1                     ; Tell the resident paged-library loader which ROM bank to restore after
003517r 1                     ; a module call returns (lib_call swaps back to LIB_HOME_BANK).
003517r 1  A9 05              LDA   #ROMSWAP_LOGO
003519r 1  8D 17 03           STA   LIB_HOME_BANK
00351Cr 1               
00351Cr 1                     ; At boot the runtime's own extension IS in bank 1 (loaded by NovaHost /
00351Cr 1                     ; the emulator). Seed LIB_RESIDENT=$FF so legacy ext commands take the cheap
00351Cr 1                     ; HIT path in ensure_ext_resident until a lib_call(MODULE) clobbers bank 1.
00351Cr 1  A9 FF              LDA   #LIB_RESIDENT_HOSTEXT
00351Er 1  8D 18 03           STA   LIB_RESIDENT
003521r 1               
003521r 1                     ; Zero NovaLogo turtle/graphics state ($9F00..$9F1F) so each session starts
003521r 1                     ; in a known mode. The extension pins its turtle state here (extension.s
003521r 1                     ; TURTLE_STATE_BASE=$9F00); RAM is stale across soft-reboot on HW, and a
003521r 1                     ; stale graphics-mode/inited flag breaks auto-switch and re-init.
003521r 1  A2 1F              LDX   #$1F
003523r 1               @zero_turtle:
003523r 1  9E 00 9F           STZ   $9F00,X
003526r 1  CA                 DEX
003527r 1  10 FA              BPL   @zero_turtle
003529r 1               
003529r 1  20 rr rr           JSR   heap_init
00352Cr 1  20 rr rr           JSR   var_init
00352Fr 1  20 rr rr           JSR   proc_init
003532r 1  64 rr              STZ   catch_active
003534r 1  9C 0A A0           STZ   VGC_CURSEN
003537r 1  20 rr rr           JSR   print_banner
00353Ar 1  20 rr rr           JSR   print_prompt
00353Dr 1               
00353Dr 1               main_loop:
00353Dr 1  20 rr rr           JSR   read_line
003540r 1  9C 0A A0           STZ   VGC_CURSEN
003543r 1  20 rr rr           JSR   tokenize_line
003546r 1  20 rr rr           JSR   check_to_command
003549r 1  B0 03              BCS   @was_to               ; carry set = TO was handled
00354Br 1  20 rr rr           JSR   eval_line
00354Er 1               @was_to:
00354Er 1                     ; Reclaim dead heap objects (tokens, list cells, etc.)
00354Er 1  20 rr rr           JSR   gc_collect
003551r 1  20 rr rr           JSR   print_prompt
003554r 1  80 E7              BRA   main_loop
003556r 1               
003556r 1               ; ---------------------------------------------------------------------
003556r 1               ; check_to_command — if the first token is TO / EDIT / ED, handle it as a
003556r 1               ;   procedure-definition command (TO collects a new proc; EDIT/ED reopen an
003556r 1               ;   existing one in the editor).
003556r 1               ;   Output: carry set = handled, carry clear = not a definition command.
003556r 1               ;   Clobbers: A, Y, ptr_lo/hi, eval_cur
003556r 1               ; ---------------------------------------------------------------------
003556r 1               check_to_command:
003556r 1  A5 rr              LDA   tok_head_lo
003558r 1  05 rr              ORA   tok_head_hi
00355Ar 1  F0 5A              BEQ   @not_to
00355Cr 1               
00355Cr 1                     ; First token must be TOK_WORD
00355Cr 1  A5 rr              LDA   tok_head_lo
00355Er 1  85 rr              STA   ptr_lo
003560r 1  A5 rr              LDA   tok_head_hi
003562r 1  85 rr              STA   ptr_hi
003564r 1  A0 00              LDY   #TOK_TAG
003566r 1  B1 rr              LDA   (ptr_lo),Y
003568r 1  C9 01              CMP   #TOK_WORD
00356Ar 1  D0 4A              BNE   @not_to
00356Cr 1               
00356Cr 1  A0 03              LDY   #TOK_PAYLOAD
00356Er 1  B1 rr              LDA   (ptr_lo),Y           ; word length
003570r 1  C9 02              CMP   #2
003572r 1  F0 06              BEQ   @len2
003574r 1  C9 04              CMP   #4
003576r 1  F0 19              BEQ   @len4
003578r 1  80 3C              BRA   @not_to
00357Ar 1               
00357Ar 1               @len2:
00357Ar 1  A0 04              LDY   #TOK_PAYLOAD+1
00357Cr 1  B1 rr              LDA   (ptr_lo),Y
00357Er 1  C9 54              CMP   #'T'
003580r 1  D0 34              BNE   @not_to
003582r 1  C8                 INY
003583r 1  B1 rr              LDA   (ptr_lo),Y
003585r 1  C9 4F              CMP   #'O'
003587r 1  D0 2D              BNE   @not_to
003589r 1                     ; "TO" — collect a new procedure
003589r 1  20 rr rr           JSR   @set_cur
00358Cr 1  20 rr rr           JSR   proc_collect
00358Fr 1  38                 SEC
003590r 1  60                 RTS
003591r 1               @len4:
003591r 1  A0 04              LDY   #TOK_PAYLOAD+1
003593r 1  B1 rr              LDA   (ptr_lo),Y
003595r 1  C9 45              CMP   #'E'
003597r 1  D0 1D              BNE   @not_to
003599r 1  C8                 INY
00359Ar 1  B1 rr              LDA   (ptr_lo),Y
00359Cr 1  C9 44              CMP   #'D'
00359Er 1  D0 16              BNE   @not_to
0035A0r 1  C8                 INY
0035A1r 1  B1 rr              LDA   (ptr_lo),Y
0035A3r 1  C9 49              CMP   #'I'
0035A5r 1  D0 0F              BNE   @not_to
0035A7r 1  C8                 INY
0035A8r 1  B1 rr              LDA   (ptr_lo),Y
0035AAr 1  C9 54              CMP   #'T'
0035ACr 1  D0 08              BNE   @not_to
0035AEr 1                     ; "EDIT" — edit
0035AEr 1  20 rr rr           JSR   @set_cur
0035B1r 1  20 rr rr           JSR   proc_edit
0035B4r 1  38                 SEC
0035B5r 1  60                 RTS
0035B6r 1               
0035B6r 1               @not_to:
0035B6r 1  18                 CLC
0035B7r 1  60                 RTS
0035B8r 1               
0035B8r 1               @set_cur:
0035B8r 1                     ; eval_cur = first token, then advance past it to the name token
0035B8r 1  A5 rr              LDA   tok_head_lo
0035BAr 1  85 rr              STA   eval_cur_lo
0035BCr 1  A5 rr              LDA   tok_head_hi
0035BEr 1  85 rr              STA   eval_cur_hi
0035C0r 1  4C rr rr           JMP   eval_advance         ; ends with RTS
0035C3r 1               
0035C3r 1               ; ---------------------------------------------------------------------
0035C3r 1               ; read_line — read a line of input into input_buf, null-terminated
0035C3r 1               ;   On return: input_buf contains the line, buf_idx = length
0035C3r 1               ; ---------------------------------------------------------------------
0035C3r 1               read_line:
0035C3r 1  64 rr              STZ   buf_idx            ; reset buffer index to 0
0035C5r 1  A9 01              LDA   #$01
0035C7r 1  8D 0A A0           STA   VGC_CURSEN
0035CAr 1               
0035CAr 1               @poll:
0035CAr 1  AD 0F A0           LDA   VGC_CHARIN         ; poll keyboard
0035CDr 1  F0 FB              BEQ   @poll              ; no key waiting — spin
0035CFr 1               
0035CFr 1                     ; --- handle CR ($0D) ---
0035CFr 1  C9 0D              CMP   #$0D
0035D1r 1  D0 39              BNE   @not_cr
0035D3r 1                     ; End of a typed line. If brackets/parens are still open, keep reading so
0035D3r 1                     ; a multi-line statement can be entered right at the prompt.
0035D3r 1  20 rr rr           JSR   line_bracket_depth
0035D6r 1  F0 24              BEQ   @cr_finish
0035D8r 1  A6 rr              LDX   buf_idx
0035DAr 1  E0 78              CPX   #120
0035DCr 1  B0 1E              BCS   @cr_finish         ; buffer nearly full — stop accumulating
0035DEr 1  A9 0A              LDA   #$0A               ; newline separator (tokenizer treats it as space)
0035E0r 1  9D rr rr           STA   input_buf,X
0035E3r 1  E6 rr              INC   buf_idx
0035E5r 1  A9 0D              LDA   #$0D
0035E7r 1  8D 0E A0           STA   VGC_CHAROUT
0035EAr 1  A9 0A              LDA   #$0A
0035ECr 1  8D 0E A0           STA   VGC_CHAROUT
0035EFr 1  A9 7E              LDA   #'~'               ; continuation prompt
0035F1r 1  8D 0E A0           STA   VGC_CHAROUT
0035F4r 1  A9 20              LDA   #' '
0035F6r 1  8D 0E A0           STA   VGC_CHAROUT
0035F9r 1  4C rr rr           JMP   @poll
0035FCr 1               @cr_finish:
0035FCr 1  A6 rr              LDX   buf_idx
0035FEr 1  9E rr rr           STZ   input_buf,X        ; null-terminate
003601r 1  A9 0D              LDA   #$0D
003603r 1  8D 0E A0           STA   VGC_CHAROUT        ; carriage return
003606r 1  A9 0A              LDA   #$0A
003608r 1  8D 0E A0           STA   VGC_CHAROUT        ; line feed
00360Br 1  60                 RTS
00360Cr 1               
00360Cr 1               @not_cr:
00360Cr 1                     ; --- handle backspace ($08, $14, $7F) ---
00360Cr 1  C9 08              CMP   #$08
00360Er 1  F0 18              BEQ   @backspace
003610r 1  C9 14              CMP   #$14
003612r 1  F0 14              BEQ   @backspace
003614r 1  C9 7F              CMP   #$7F
003616r 1  F0 10              BEQ   @backspace
003618r 1               
003618r 1                     ; --- buffer full? ---
003618r 1  A6 rr              LDX   buf_idx
00361Ar 1  E0 7F              CPX   #127
00361Cr 1  B0 AC              BCS   @poll              ; at capacity — ignore keystroke
00361Er 1               
00361Er 1                     ; --- store and echo printable character ---
00361Er 1  9D rr rr           STA   input_buf,X        ; store in buffer
003621r 1  8D 0E A0           STA   VGC_CHAROUT        ; echo to screen
003624r 1  E6 rr              INC   buf_idx
003626r 1  80 A2              BRA   @poll
003628r 1               
003628r 1               @backspace:
003628r 1  A6 rr              LDX   buf_idx
00362Ar 1  F0 9E              BEQ   @poll              ; nothing to delete — ignore
00362Cr 1  CA                 DEX
00362Dr 1  86 rr              STX   buf_idx
00362Fr 1  A9 08              LDA   #$08
003631r 1  8D 0E A0           STA   VGC_CHAROUT        ; move cursor left and erase
003634r 1  80 94              BRA   @poll
003636r 1               
003636r 1               ; ---------------------------------------------------------------------
003636r 1               ; line_bracket_depth — net count of unclosed '[' and '(' in input_buf[0..buf_idx),
003636r 1               ;   ignoring text inside ';' comments. Returns depth in A (Z set if balanced).
003636r 1               ;   Clobbers: A, X, Y.
003636r 1               ; ---------------------------------------------------------------------
003636r 1               line_bracket_depth:
003636r 1  A2 00              LDX   #0                 ; scan index
003638r 1  A0 00              LDY   #0                 ; depth
00363Ar 1               @bd_loop:
00363Ar 1  E4 rr              CPX   buf_idx
00363Cr 1  B0 32              BCS   @bd_done
00363Er 1  BD rr rr           LDA   input_buf,X
003641r 1  C9 3B              CMP   #';'
003643r 1  F0 1D              BEQ   @bd_comment
003645r 1  C9 5B              CMP   #'['
003647r 1  F0 0F              BEQ   @bd_inc
003649r 1  C9 28              CMP   #'('
00364Br 1  F0 0B              BEQ   @bd_inc
00364Dr 1  C9 5D              CMP   #']'
00364Fr 1  F0 0A              BEQ   @bd_dec
003651r 1  C9 29              CMP   #')'
003653r 1  F0 06              BEQ   @bd_dec
003655r 1               @bd_next:
003655r 1  E8                 INX
003656r 1  80 E2              BRA   @bd_loop
003658r 1               @bd_inc:
003658r 1  C8                 INY
003659r 1  80 FA              BRA   @bd_next
00365Br 1               @bd_dec:
00365Br 1  C0 00              CPY   #0
00365Dr 1  F0 F6              BEQ   @bd_next           ; floor at 0
00365Fr 1  88                 DEY
003660r 1  80 F3              BRA   @bd_next
003662r 1               @bd_comment:
003662r 1  E8                 INX                      ; skip ';' and everything up to a newline
003663r 1  E4 rr              CPX   buf_idx
003665r 1  B0 09              BCS   @bd_done
003667r 1  BD rr rr           LDA   input_buf,X
00366Ar 1  C9 0A              CMP   #$0A
00366Cr 1  D0 F4              BNE   @bd_comment
00366Er 1  80 E5              BRA   @bd_next           ; resume scanning after the newline
003670r 1               @bd_done:
003670r 1  98                 TYA                      ; depth -> A, sets Z if zero
003671r 1  60                 RTS
003672r 1               
003672r 1               ; ---------------------------------------------------------------------
003672r 1               ; print_prompt — prints "? " to the screen
003672r 1               ; ---------------------------------------------------------------------
003672r 1               print_prompt:
003672r 1  20 rr rr           JSR   print_inl
003675r 1  3F 20 00           .byte "? ", 0
003678r 1  A9 01              LDA   #$01
00367Ar 1  8D 0A A0           STA   VGC_CURSEN
00367Dr 1  60                 RTS
00367Er 1               
00367Er 1               ; ---------------------------------------------------------------------
00367Er 1               ; print_banner — prints title and current available heap bytes
00367Er 1               ; ---------------------------------------------------------------------
00367Er 1               print_banner:
00367Er 1  20 rr rr           JSR   print_inl
003681r 1  4E 6F 76 61        .byte "Nova LOGO v1.0", $0D, $0A, 0
003685r 1  20 4C 4F 47  
003689r 1  4F 20 76 31  
003692r 1               
003692r 1  38                 SEC
003693r 1  A9 00              LDA   #<HEAP_END
003695r 1  E5 rr              SBC   heap_ptr
003697r 1  85 rr              STA   eval_val_lo
003699r 1  A9 98              LDA   #>HEAP_END
00369Br 1  E5 rr              SBC   heap_ptr+1
00369Dr 1  85 rr              STA   eval_val_hi
00369Fr 1  38                 SEC
0036A0r 1  A5 rr              LDA   eval_val_lo
0036A2r 1  E9 02              SBC   #GC_HDR_BYTES
0036A4r 1  85 rr              STA   eval_val_lo
0036A6r 1  A5 rr              LDA   eval_val_hi
0036A8r 1  E9 00              SBC   #0
0036AAr 1  85 rr              STA   eval_val_hi
0036ACr 1  64 rr              STZ   eval_val_frac
0036AEr 1  20 rr rr           JSR   print_uint16
0036B1r 1               
0036B1r 1  20 rr rr           JSR   print_inl
0036B4r 1  20 42 59 54        .byte " BYTES FREE", $0D, $0A, $0D, $0A, 0
0036B8r 1  45 53 20 46  
0036BCr 1  52 45 45 0D  
0036C4r 1  60                 RTS
0036C5r 1               
0036C5r 1               ; =====================================================================
0036C5r 1               ; RODATA segment — string constants
0036C5r 1               ; =====================================================================
0036C5r 1                     .segment "RODATA"
000647r 1               
000647r 1               ; Extension ROM trampoline — copied to RAM at $0270 during cold_start.
000647r 1               ; Swaps to extension ROM, calls entry, swaps back to Logo ROM.
000647r 1               ext_tramp_src:
000647r 1  A9 04              .byte $A9, ROMSWAP_EXTENSION  ; LDA #ROMSWAP_EXTENSION
000649r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
00064Cr 1  20 00 C0           .byte $20, $00, $C0          ; JSR $C000
00064Fr 1  A9 05              .byte $A9, ROMSWAP_LOGO      ; LDA #ROMSWAP_LOGO
000651r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000654r 1  60                 .byte $60                     ; RTS
000655r 1               
000655r 1               ; =====================================================================
000655r 1               ; MONITOR segment — reset handler at $FFD7
000655r 1               ; =====================================================================
000655r 1                     .segment "MONITOR"
000000r 1                     .org  $FFD7
00FFD7  1               
00FFD7  1               RES_vec:
00FFD7  1  D8                 CLD                     ; clear decimal mode
00FFD8  1  A2 FF              LDX   #$FF              ; empty stack
00FFDA  1  9A                 TXS                     ; set the stack
00FFDB  1  4C rr rr           JMP   cold_start
00FFDE  1               
00FFDE  1               ; IRQ/NMI stubs
00FFDE  1               NMI_stub:
00FFDE  1  40                 RTI
00FFDF  1               
00FFDF  1               IRQ_stub:
00FFDF  1  40                 RTI
00FFE0  1               
00FFE0  1               ; =====================================================================
00FFE0  1               ; VECTORS segment — 6502 hardware vectors at $FFFA
00FFE0  1               ; =====================================================================
00FFE0  1                     .segment "VECTORS"
00FFE0  1                     .org  $FFFA
00FFFA  1               
00FFFA  1  DE FF              .word NMI_stub           ; $FFFA — NMI vector
00FFFC  1  D7 FF              .word RES_vec            ; $FFFC — RESET vector
00FFFE  1  DF FF              .word IRQ_stub           ; $FFFE — IRQ vector
00FFFE  1               
