00230Br 2               ; ---------------------------------------------------------------------
00230Br 2               ; do_word — WORD val1 val2: concatenate two words into one
00230Br 2               ;   Arity 0: evaluates its own arguments
00230Br 2               ; ---------------------------------------------------------------------
00230Br 2               do_word:
00230Br 2                     ; Evaluate first arg (must be a word)
00230Br 2  20 rr rr           JSR   eval_expr
00230Er 2  90 03              BCC   :+
002310r 2  4C rr rr           JMP   @err
002313r 2               :
002313r 2  A5 rr              LDA   eval_type
002315r 2  C9 01              CMP   #VAL_WORD
002317r 2  F0 03              BEQ   :+
002319r 2  4C rr rr           JMP   @err_type
00231Cr 2               :
00231Cr 2                     ; Save first word pointer
00231Cr 2  A5 rr              LDA   eval_val_lo
00231Er 2  48                 PHA
00231Fr 2  A5 rr              LDA   eval_val_hi
002321r 2  48                 PHA
002322r 2               
002322r 2                     ; Evaluate second arg (must be a word)
002322r 2  20 rr rr           JSR   eval_expr
002325r 2  90 05              BCC   :+
002327r 2  68                 PLA
002328r 2  68                 PLA
002329r 2  4C rr rr           JMP   @err
00232Cr 2               :
00232Cr 2  A5 rr              LDA   eval_type
00232Er 2  C9 01              CMP   #VAL_WORD
002330r 2  F0 03              BEQ   :+
002332r 2  4C rr rr           JMP   @err_type_pop2
002335r 2               :
002335r 2               
002335r 2                     ; eval_val = second word, stack has first word ptr
002335r 2                     ; Read lengths
002335r 2  A5 rr              LDA   eval_val_lo
002337r 2  85 rr              STA   ptr2_lo
002339r 2  A5 rr              LDA   eval_val_hi
00233Br 2  85 rr              STA   ptr2_hi
00233Dr 2  A0 00              LDY   #0
00233Fr 2  B1 rr              LDA   (ptr2_lo),Y            ; second word length
002341r 2  85 rr              STA   list_count_lo           ; save len2
002343r 2               
002343r 2                     ; Read first word length from stack
002343r 2  68                 PLA
002344r 2  85 rr              STA   list_head_hi            ; first word ptr hi
002346r 2  68                 PLA
002347r 2  85 rr              STA   list_head_lo            ; first word ptr lo
002349r 2  A5 rr              LDA   list_head_lo
00234Br 2  85 rr              STA   ptr_lo
00234Dr 2  A5 rr              LDA   list_head_hi
00234Fr 2  85 rr              STA   ptr_hi
002351r 2  A0 00              LDY   #0
002353r 2  B1 rr              LDA   (ptr_lo),Y             ; first word length
002355r 2  85 rr              STA   list_count_hi           ; save len1
002357r 2               
002357r 2                     ; Allocate new string: 1 (length byte) + len1 + len2
002357r 2  18                 CLC
002358r 2  65 rr              ADC   list_count_lo
00235Ar 2  1A                 INC                           ; +1 for length byte
00235Br 2  A2 05              LDX   #ATYPE_STRING
00235Dr 2  20 rr rr           JSR   heap_alloc
002360r 2  B0 6F              BCS   @err_oom
002362r 2               
002362r 2                     ; Write combined length
002362r 2  A5 rr              LDA   list_count_hi
002364r 2  18                 CLC
002365r 2  65 rr              ADC   list_count_lo
002367r 2  A0 00              LDY   #0
002369r 2  91 rr              STA   (ptr_lo),Y
00236Br 2               
00236Br 2                     ; Copy first word's chars
00236Br 2  A6 rr              LDX   list_count_hi           ; len1
00236Dr 2  F0 23              BEQ   @w_copy2
00236Fr 2  A5 rr              LDA   list_head_lo
002371r 2  85 rr              STA   ptr2_lo
002373r 2  A5 rr              LDA   list_head_hi
002375r 2  85 rr              STA   ptr2_hi
002377r 2  A0 01              LDY   #1                     ; dest offset in new string
002379r 2  9C rr rr           STZ   num_tmp_lo              ; source offset
00237Cr 2               @w_c1:
00237Cr 2  DA                 PHX
00237Dr 2  5A                 PHY
00237Er 2  AD rr rr           LDA   num_tmp_lo
002381r 2  1A                 INC                           ; skip length byte in source
002382r 2  A8                 TAY
002383r 2  B1 rr              LDA   (ptr2_lo),Y            ; source char
002385r 2  7A                 PLY
002386r 2  91 rr              STA   (ptr_lo),Y             ; dest char
002388r 2  C8                 INY
002389r 2  EE rr rr           INC   num_tmp_lo
00238Cr 2  FA                 PLX
00238Dr 2  CA                 DEX
00238Er 2  D0 EC              BNE   @w_c1
002390r 2               
002390r 2                     ; Y is already at the next dest offset
002390r 2  80 02              BRA   @w_copy2_start
002392r 2               
002392r 2               @w_copy2:
002392r 2  A0 01              LDY   #1                     ; start at offset 1 if len1 was 0
002394r 2               @w_copy2_start:
002394r 2                     ; Copy second word's chars
002394r 2  A6 rr              LDX   list_count_lo           ; len2
002396r 2  F0 1F              BEQ   @w_done
002398r 2  A5 rr              LDA   eval_val_lo
00239Ar 2  85 rr              STA   ptr2_lo
00239Cr 2  A5 rr              LDA   eval_val_hi
00239Er 2  85 rr              STA   ptr2_hi
0023A0r 2  9C rr rr           STZ   num_tmp_lo
0023A3r 2               @w_c2:
0023A3r 2  DA                 PHX
0023A4r 2  5A                 PHY
0023A5r 2  AD rr rr           LDA   num_tmp_lo
0023A8r 2  1A                 INC
0023A9r 2  A8                 TAY
0023AAr 2  B1 rr              LDA   (ptr2_lo),Y
0023ACr 2  7A                 PLY
0023ADr 2  91 rr              STA   (ptr_lo),Y
0023AFr 2  C8                 INY
0023B0r 2  EE rr rr           INC   num_tmp_lo
0023B3r 2  FA                 PLX
0023B4r 2  CA                 DEX
0023B5r 2  D0 EC              BNE   @w_c2
0023B7r 2               
0023B7r 2               @w_done:
0023B7r 2                     ; Return the new word
0023B7r 2  A9 01              LDA   #VAL_WORD
0023B9r 2  85 rr              STA   eval_type
0023BBr 2  A5 rr              LDA   ptr_lo
0023BDr 2  85 rr              STA   eval_val_lo
0023BFr 2  A5 rr              LDA   ptr_hi
0023C1r 2  85 rr              STA   eval_val_hi
0023C3r 2  64 rr              STZ   eval_val_frac
0023C5r 2  4C rr rr           JMP   eval_continue
0023C8r 2               
0023C8r 2               @err_type_pop2:
0023C8r 2  68                 PLA
0023C9r 2  68                 PLA
0023CAr 2               @err_type:
0023CAr 2  A2 rr              LDX   #<str_word_name
0023CCr 2  A0 rr              LDY   #>str_word_name
0023CEr 2  4C rr rr           JMP   err_dl_this
0023D1r 2               @err_oom:
0023D1r 2               @err:
0023D1r 2  A2 rr              LDX   #<str_word_name
0023D3r 2  A0 rr              LDY   #>str_word_name
0023D5r 2  4C rr rr           JMP   err_nei
0023D8r 2               
0023D8r 2               ; ---------------------------------------------------------------------
0023D8r 2               ; do_run — RUN list: evaluate a list as Logo code
0023D8r 2               ;   Arity 0: evaluates its own argument
0023D8r 2               ;
0023D8r 2               ;   Strategy: convert list to text in input_buf, then save evaluator
0023D8r 2               ;   state, tokenize_line + eval_line, restore state.
0023D8r 2               ; ---------------------------------------------------------------------
0023D8r 2               do_run:
0023D8r 2  20 rr rr           JSR   eval_expr
0023DBr 2  90 03              BCC   :+
0023DDr 2  4C rr rr           JMP   @err
0023E0r 2               :
0023E0r 2  A5 rr              LDA   eval_type
0023E2r 2  C9 02              CMP   #VAL_LIST
0023E4r 2  D0 43              BNE   @err_type
0023E6r 2               
0023E6r 2                     ; Save eval_cur on stack (we'll resume here after RUN)
0023E6r 2  A5 rr              LDA   eval_cur_lo
0023E8r 2  48                 PHA
0023E9r 2  A5 rr              LDA   eval_cur_hi
0023EBr 2  48                 PHA
0023ECr 2               
0023ECr 2                     ; Render the list into input_buf as text
0023ECr 2                     ; eval_val_lo/hi = list head
0023ECr 2  64 rr              STZ   z:buf_idx               ; reset write position
0023EEr 2  20 rr rr           JSR   render_list_to_buf
0023F1r 2               
0023F1r 2                     ; Null-terminate input_buf
0023F1r 2  A6 rr              LDX   z:buf_idx
0023F3r 2  9E rr rr           STZ   input_buf,X
0023F6r 2               
0023F6r 2                     ; Save tokenizer and eval state (same pattern as proc_invoke)
0023F6r 2  A5 rr              LDA   tok_head_lo
0023F8r 2  48                 PHA
0023F9r 2  A5 rr              LDA   tok_head_hi
0023FBr 2  48                 PHA
0023FCr 2  A5 rr              LDA   tok_tail_lo
0023FEr 2  48                 PHA
0023FFr 2  A5 rr              LDA   tok_tail_hi
002401r 2  48                 PHA
002402r 2  A5 rr              LDA   eval_in_body
002404r 2  48                 PHA
002405r 2  A5 rr              LDA   eval_reporter
002407r 2  48                 PHA
002408r 2               
002408r 2                     ; Tokenize the reconstructed line
002408r 2  20 rr rr           JSR   tokenize_line
00240Br 2               
00240Br 2                     ; Evaluate it
00240Br 2  20 rr rr           JSR   eval_line
00240Er 2               
00240Er 2                     ; Restore tokenizer/eval state
00240Er 2  68                 PLA
00240Fr 2  85 rr              STA   eval_reporter
002411r 2  68                 PLA
002412r 2  85 rr              STA   eval_in_body
002414r 2  68                 PLA
002415r 2  85 rr              STA   tok_tail_hi
002417r 2  68                 PLA
002418r 2  85 rr              STA   tok_tail_lo
00241Ar 2  68                 PLA
00241Br 2  85 rr              STA   tok_head_hi
00241Dr 2  68                 PLA
00241Er 2  85 rr              STA   tok_head_lo
002420r 2               
002420r 2                     ; Restore eval_cur
002420r 2  68                 PLA
002421r 2  85 rr              STA   eval_cur_hi
002423r 2  68                 PLA
002424r 2  85 rr              STA   eval_cur_lo
002426r 2               
002426r 2  4C rr rr           JMP   eval_continue
002429r 2               
002429r 2               @err_type:
002429r 2  A2 rr              LDX   #<str_run_name
00242Br 2  A0 rr              LDY   #>str_run_name
00242Dr 2  4C rr rr           JMP   err_needs_list
002430r 2               @err:
002430r 2  A2 rr              LDX   #<str_run_name
002432r 2  A0 rr              LDY   #>str_run_name
002434r 2  4C rr rr           JMP   err_nei
002437r 2               
002437r 2               ; ---------------------------------------------------------------------
002437r 2               ; render_list_to_buf — render list elements into input_buf as text
002437r 2               ;   Entry: eval_val_lo/hi = list head pointer
002437r 2               ;          buf_idx = current write position in input_buf
002437r 2               ;   Exit:  buf_idx updated
002437r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr, list_count
002437r 2               ; ---------------------------------------------------------------------
002437r 2               render_list_to_buf:
002437r 2  A5 rr              LDA   eval_val_lo
002439r 2  85 rr              STA   list_ptr_lo
00243Br 2  A5 rr              LDA   eval_val_hi
00243Dr 2  85 rr              STA   list_ptr_hi
00243Fr 2  A2 00              LDX   #0                     ; 0 = first element (no leading space)
002441r 2               
002441r 2               @rl_loop:
002441r 2  A5 rr              LDA   list_ptr_lo
002443r 2  05 rr              ORA   list_ptr_hi
002445r 2  D0 01              BNE   :+
002447r 2  60                 RTS                           ; end of list
002448r 2               :
002448r 2                     ; Add space before non-first elements
002448r 2  E0 00              CPX   #0
00244Ar 2  F0 0F              BEQ   @rl_no_space
00244Cr 2  A5 rr              LDA   z:buf_idx
00244Er 2  C9 7E              CMP   #126
002450r 2  90 01              BCC   :+
002452r 2  60                 RTS                           ; buffer full — truncate
002453r 2               :
002453r 2  A8                 TAY
002454r 2  A9 20              LDA   #' '
002456r 2  99 rr rr           STA   input_buf,Y
002459r 2  E6 rr              INC   z:buf_idx
00245Br 2               @rl_no_space:
00245Br 2  A2 01              LDX   #1                     ; subsequent elements get space
00245Dr 2               
00245Dr 2                     ; Read car type
00245Dr 2  A5 rr              LDA   list_ptr_lo
00245Fr 2  85 rr              STA   ptr_lo
002461r 2  A5 rr              LDA   list_ptr_hi
002463r 2  85 rr              STA   ptr_hi
002465r 2  A0 01              LDY   #CONS_CAR_TYPE
002467r 2  B1 rr              LDA   (ptr_lo),Y
002469r 2               
002469r 2  C9 02              CMP   #VAL_LIST
00246Br 2  F0 62              BEQ   @rl_sublist
00246Dr 2  C9 01              CMP   #VAL_WORD
00246Fr 2  F0 25              BEQ   @rl_word
002471r 2               
002471r 2                     ; Number: render to input_buf
002471r 2  DA                 PHX
002472r 2  A5 rr              LDA   list_ptr_lo
002474r 2  48                 PHA
002475r 2  A5 rr              LDA   list_ptr_hi
002477r 2  48                 PHA
002478r 2                     ; Load the number value
002478r 2  A0 02              LDY   #CONS_CAR_HI
00247Ar 2  B1 rr              LDA   (ptr_lo),Y
00247Cr 2  85 rr              STA   eval_val_hi
00247Er 2  A0 03              LDY   #CONS_CAR_LO
002480r 2  B1 rr              LDA   (ptr_lo),Y
002482r 2  85 rr              STA   eval_val_lo
002484r 2  A0 04              LDY   #CONS_CAR_FRAC
002486r 2  B1 rr              LDA   (ptr_lo),Y
002488r 2  85 rr              STA   eval_val_frac
00248Ar 2  20 rr rr           JSR   render_number_to_buf
00248Dr 2  68                 PLA
00248Er 2  85 rr              STA   list_ptr_hi
002490r 2  68                 PLA
002491r 2  85 rr              STA   list_ptr_lo
002493r 2  FA                 PLX
002494r 2  80 72              BRA   @rl_advance
002496r 2               
002496r 2               @rl_word:
002496r 2  DA                 PHX
002497r 2  A5 rr              LDA   list_ptr_lo
002499r 2  48                 PHA
00249Ar 2  A5 rr              LDA   list_ptr_hi
00249Cr 2  48                 PHA
00249Dr 2                     ; Get word string pointer
00249Dr 2  A0 03              LDY   #CONS_CAR_LO
00249Fr 2  B1 rr              LDA   (ptr_lo),Y
0024A1r 2  85 rr              STA   ptr2_lo
0024A3r 2  A0 02              LDY   #CONS_CAR_HI
0024A5r 2  B1 rr              LDA   (ptr_lo),Y
0024A7r 2  85 rr              STA   ptr2_hi
0024A9r 2                     ; Copy word chars to buf
0024A9r 2  A0 00              LDY   #0
0024ABr 2  B1 rr              LDA   (ptr2_lo),Y            ; length
0024ADr 2  AA                 TAX
0024AEr 2  F0 16              BEQ   @rl_word_done
0024B0r 2  C8                 INY
0024B1r 2               @rl_wch:
0024B1r 2  A5 rr              LDA   z:buf_idx
0024B3r 2  C9 7E              CMP   #126
0024B5r 2  B0 0F              BCS   @rl_word_done
0024B7r 2  B1 rr              LDA   (ptr2_lo),Y
0024B9r 2  5A                 PHY
0024BAr 2  A4 rr              LDY   z:buf_idx
0024BCr 2  99 rr rr           STA   input_buf,Y
0024BFr 2  E6 rr              INC   z:buf_idx
0024C1r 2  7A                 PLY
0024C2r 2  C8                 INY
0024C3r 2  CA                 DEX
0024C4r 2  D0 EB              BNE   @rl_wch
0024C6r 2               @rl_word_done:
0024C6r 2  68                 PLA
0024C7r 2  85 rr              STA   list_ptr_hi
0024C9r 2  68                 PLA
0024CAr 2  85 rr              STA   list_ptr_lo
0024CCr 2  FA                 PLX
0024CDr 2  80 39              BRA   @rl_advance
0024CFr 2               
0024CFr 2               @rl_sublist:
0024CFr 2  DA                 PHX
0024D0r 2  A5 rr              LDA   list_ptr_lo
0024D2r 2  48                 PHA
0024D3r 2  A5 rr              LDA   list_ptr_hi
0024D5r 2  48                 PHA
0024D6r 2                     ; Write '[' to buf
0024D6r 2  A5 rr              LDA   z:buf_idx
0024D8r 2  C9 7E              CMP   #126
0024DAr 2  B0 25              BCS   @rl_sub_done
0024DCr 2  A8                 TAY
0024DDr 2  A9 5B              LDA   #'['
0024DFr 2  99 rr rr           STA   input_buf,Y
0024E2r 2  E6 rr              INC   z:buf_idx
0024E4r 2                     ; Get sublist pointer and recurse
0024E4r 2  A0 03              LDY   #CONS_CAR_LO
0024E6r 2  B1 rr              LDA   (ptr_lo),Y
0024E8r 2  85 rr              STA   eval_val_lo
0024EAr 2  A0 02              LDY   #CONS_CAR_HI
0024ECr 2  B1 rr              LDA   (ptr_lo),Y
0024EEr 2  85 rr              STA   eval_val_hi
0024F0r 2  20 rr rr           JSR   render_list_to_buf
0024F3r 2                     ; Write ']' to buf
0024F3r 2  A5 rr              LDA   z:buf_idx
0024F5r 2  C9 7E              CMP   #126
0024F7r 2  B0 08              BCS   @rl_sub_done
0024F9r 2  A8                 TAY
0024FAr 2  A9 5D              LDA   #']'
0024FCr 2  99 rr rr           STA   input_buf,Y
0024FFr 2  E6 rr              INC   z:buf_idx
002501r 2               @rl_sub_done:
002501r 2  68                 PLA
002502r 2  85 rr              STA   list_ptr_hi
002504r 2  68                 PLA
002505r 2  85 rr              STA   list_ptr_lo
002507r 2  FA                 PLX
002508r 2               
002508r 2               @rl_advance:
002508r 2                     ; Follow cdr
002508r 2  A5 rr              LDA   list_ptr_lo
00250Ar 2  85 rr              STA   ptr_lo
00250Cr 2  A5 rr              LDA   list_ptr_hi
00250Er 2  85 rr              STA   ptr_hi
002510r 2  A0 05              LDY   #CONS_CDR_LO
002512r 2  B1 rr              LDA   (ptr_lo),Y
002514r 2  AA                 TAX
002515r 2  A0 06              LDY   #CONS_CDR_HI
002517r 2  B1 rr              LDA   (ptr_lo),Y
002519r 2  85 rr              STA   list_ptr_hi
00251Br 2  86 rr              STX   list_ptr_lo
00251Dr 2  A2 01              LDX   #1                     ; always space after first element
00251Fr 2  4C rr rr           JMP   @rl_loop
002522r 2               
002522r 2               @rl_trunc:
002522r 2  60                 RTS
002523r 2               
002523r 2               ; ---------------------------------------------------------------------
002523r 2               ; render_number_to_buf — render eval_val as decimal into input_buf
002523r 2               ;   Entry: eval_val_hi/lo/frac = number value
002523r 2               ;          buf_idx = current write position
002523r 2               ;   Exit:  buf_idx updated
002523r 2               ;   Clobbers: A, X, Y, num_val, num_tmp, pn_buf
002523r 2               ; ---------------------------------------------------------------------
002523r 2               render_number_to_buf:
002523r 2                     ; Handle sign
002523r 2  A5 rr              LDA   eval_val_hi
002525r 2  10 22              BPL   @rn_positive
002527r 2                     ; Write '-'
002527r 2  A4 rr              LDY   z:buf_idx
002529r 2  A9 2D              LDA   #'-'
00252Br 2  99 rr rr           STA   input_buf,Y
00252Er 2  E6 rr              INC   z:buf_idx
002530r 2                     ; Negate
002530r 2  A5 rr              LDA   eval_val_frac
002532r 2  49 FF              EOR   #$FF
002534r 2  18                 CLC
002535r 2  69 01              ADC   #1
002537r 2  85 rr              STA   eval_val_frac
002539r 2  A5 rr              LDA   eval_val_lo
00253Br 2  49 FF              EOR   #$FF
00253Dr 2  69 00              ADC   #0
00253Fr 2  85 rr              STA   eval_val_lo
002541r 2  A5 rr              LDA   eval_val_hi
002543r 2  49 FF              EOR   #$FF
002545r 2  69 00              ADC   #0
002547r 2  85 rr              STA   eval_val_hi
002549r 2               
002549r 2               @rn_positive:
002549r 2                     ; Render integer part using power-of-10 subtraction
002549r 2  A5 rr              LDA   eval_val_lo
00254Br 2  8D rr rr           STA   num_val_lo
00254Er 2  A5 rr              LDA   eval_val_hi
002550r 2  8D rr rr           STA   num_val_hi
002553r 2               
002553r 2  A2 00              LDX   #0                     ; digit buffer index
002555r 2  A0 00              LDY   #0                     ; power-of-10 index
002557r 2               @rn_div:
002557r 2  9C rr rr           STZ   num_tmp_lo
00255Ar 2               @rn_sub:
00255Ar 2  38                 SEC
00255Br 2  AD rr rr           LDA   num_val_lo
00255Er 2  F9 rr rr           SBC   pow10_lo,Y
002561r 2  48                 PHA
002562r 2  AD rr rr           LDA   num_val_hi
002565r 2  F9 rr rr           SBC   pow10_hi,Y
002568r 2  90 0C              BCC   @rn_sub_done
00256Ar 2  8D rr rr           STA   num_val_hi
00256Dr 2  68                 PLA
00256Er 2  8D rr rr           STA   num_val_lo
002571r 2  EE rr rr           INC   num_tmp_lo
002574r 2  80 E4              BRA   @rn_sub
002576r 2               @rn_sub_done:
002576r 2  68                 PLA
002577r 2  AD rr rr           LDA   num_tmp_lo
00257Ar 2  9D rr rr           STA   pn_buf,X
00257Dr 2  E8                 INX
00257Er 2  C8                 INY
00257Fr 2  C0 05              CPY   #5
002581r 2  90 D4              BCC   @rn_div
002583r 2               
002583r 2                     ; Write digits suppressing leading zeros
002583r 2  A0 00              LDY   #0                     ; suppress flag
002585r 2  A2 00              LDX   #0
002587r 2               @rn_print:
002587r 2  BD rr rr           LDA   pn_buf,X
00258Ar 2  D0 04              BNE   @rn_nonzero
00258Cr 2  C0 00              CPY   #0
00258Er 2  F0 0D              BEQ   @rn_skip
002590r 2               @rn_nonzero:
002590r 2  A0 01              LDY   #1
002592r 2  09 30              ORA   #'0'
002594r 2  DA                 PHX
002595r 2  A6 rr              LDX   z:buf_idx
002597r 2  9D rr rr           STA   input_buf,X
00259Ar 2  E6 rr              INC   z:buf_idx
00259Cr 2  FA                 PLX
00259Dr 2               @rn_skip:
00259Dr 2  E8                 INX
00259Er 2  E0 04              CPX   #4
0025A0r 2  90 E5              BCC   @rn_print
0025A2r 2                     ; Always write ones digit
0025A2r 2  AD rr rr           LDA   pn_buf+4
0025A5r 2  09 30              ORA   #'0'
0025A7r 2  A6 rr              LDX   z:buf_idx
0025A9r 2  9D rr rr           STA   input_buf,X
0025ACr 2  E6 rr              INC   z:buf_idx
0025AEr 2               
0025AEr 2                     ; Fractional part
0025AEr 2  A5 rr              LDA   eval_val_frac
0025B0r 2  D0 01              BNE   @rn_has_frac
0025B2r 2  60                 RTS
0025B3r 2               @rn_has_frac:
0025B3r 2                     ; Write '.'
0025B3r 2  A6 rr              LDX   z:buf_idx
0025B5r 2  A9 2E              LDA   #'.'
0025B7r 2  9D rr rr           STA   input_buf,X
0025BAr 2  E6 rr              INC   z:buf_idx
0025BCr 2                     ; First frac digit
0025BCr 2  A5 rr              LDA   eval_val_frac
0025BEr 2  8D rr rr           STA   num_tmp_lo
0025C1r 2  9C rr rr           STZ   num_tmp_hi
0025C4r 2  AD rr rr           LDA   num_tmp_lo
0025C7r 2  0A                 ASL
0025C8r 2  8D rr rr           STA   num_val_lo
0025CBr 2  AD rr rr           LDA   num_tmp_hi
0025CEr 2  2A                 ROL
0025CFr 2  8D rr rr           STA   num_val_hi
0025D2r 2  0E rr rr           ASL   num_val_lo
0025D5r 2  2E rr rr           ROL   num_val_hi
0025D8r 2  0E rr rr           ASL   num_val_lo
0025DBr 2  2E rr rr           ROL   num_val_hi
0025DEr 2  18                 CLC
0025DFr 2  AD rr rr           LDA   num_tmp_lo
0025E2r 2  0A                 ASL
0025E3r 2  6D rr rr           ADC   num_val_lo
0025E6r 2  8D rr rr           STA   num_val_lo
0025E9r 2  AD rr rr           LDA   num_tmp_hi
0025ECr 2  2A                 ROL
0025EDr 2  6D rr rr           ADC   num_val_hi
0025F0r 2  8D rr rr           STA   num_val_hi
0025F3r 2                     ; High byte = digit
0025F3r 2  AD rr rr           LDA   num_val_hi
0025F6r 2  09 30              ORA   #'0'
0025F8r 2  A6 rr              LDX   z:buf_idx
0025FAr 2  9D rr rr           STA   input_buf,X
0025FDr 2  E6 rr              INC   z:buf_idx
0025FFr 2                     ; Second frac digit
0025FFr 2  AD rr rr           LDA   num_val_lo
002602r 2  8D rr rr           STA   num_tmp_lo
002605r 2  9C rr rr           STZ   num_tmp_hi
002608r 2  AD rr rr           LDA   num_tmp_lo
00260Br 2  0A                 ASL
00260Cr 2  8D rr rr           STA   num_val_lo
00260Fr 2  AD rr rr           LDA   num_tmp_hi
002612r 2  2A                 ROL
002613r 2  8D rr rr           STA   num_val_hi
002616r 2  0E rr rr           ASL   num_val_lo
002619r 2  2E rr rr           ROL   num_val_hi
00261Cr 2  0E rr rr           ASL   num_val_lo
00261Fr 2  2E rr rr           ROL   num_val_hi
002622r 2  18                 CLC
002623r 2  AD rr rr           LDA   num_tmp_lo
002626r 2  0A                 ASL
002627r 2  6D rr rr           ADC   num_val_lo
00262Ar 2  8D rr rr           STA   num_val_lo
00262Dr 2  AD rr rr           LDA   num_tmp_hi
002630r 2  2A                 ROL
002631r 2  6D rr rr           ADC   num_val_hi
002634r 2  8D rr rr           STA   num_val_hi
002637r 2  AD rr rr           LDA   num_val_hi
00263Ar 2  F0 09              BEQ   @rn_done                ; skip trailing zero
00263Cr 2  09 30              ORA   #'0'
00263Er 2  A6 rr              LDX   z:buf_idx
002640r 2  9D rr rr           STA   input_buf,X
002643r 2  E6 rr              INC   z:buf_idx
002645r 2               @rn_done:
002645r 2  60                 RTS
002646r 2               
