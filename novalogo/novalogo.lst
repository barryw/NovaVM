00230Er 2               ; ---------------------------------------------------------------------
00230Er 2               ; do_run — RUN list: evaluate a list as Logo code
00230Er 2               ;   Arity 0: evaluates its own argument
00230Er 2               ;
00230Er 2               ;   Strategy: convert list to text in input_buf, then save evaluator
00230Er 2               ;   state, tokenize_line + eval_line, restore state.
00230Er 2               ; ---------------------------------------------------------------------
00230Er 2               do_run:
00230Er 2  20 rr rr           JSR   eval_expr
002311r 2  90 03              BCC   :+
002313r 2  4C rr rr           JMP   @err
002316r 2               :
002316r 2  A5 rr              LDA   eval_type
002318r 2  C9 02              CMP   #VAL_LIST
00231Ar 2  D0 43              BNE   @err_type
00231Cr 2               
00231Cr 2                     ; Save eval_cur on stack (we'll resume here after RUN)
00231Cr 2  A5 rr              LDA   eval_cur_lo
00231Er 2  48                 PHA
00231Fr 2  A5 rr              LDA   eval_cur_hi
002321r 2  48                 PHA
002322r 2               
002322r 2                     ; Render the list into input_buf as text
002322r 2                     ; eval_val_lo/hi = list head
002322r 2  64 rr              STZ   z:buf_idx               ; reset write position
002324r 2  20 rr rr           JSR   render_list_to_buf
002327r 2               
002327r 2                     ; Null-terminate input_buf
002327r 2  A6 rr              LDX   z:buf_idx
002329r 2  9E rr rr           STZ   input_buf,X
00232Cr 2               
00232Cr 2                     ; Save tokenizer and eval state (same pattern as proc_invoke)
00232Cr 2  A5 rr              LDA   tok_head_lo
00232Er 2  48                 PHA
00232Fr 2  A5 rr              LDA   tok_head_hi
002331r 2  48                 PHA
002332r 2  A5 rr              LDA   tok_tail_lo
002334r 2  48                 PHA
002335r 2  A5 rr              LDA   tok_tail_hi
002337r 2  48                 PHA
002338r 2  A5 rr              LDA   eval_in_body
00233Ar 2  48                 PHA
00233Br 2  A5 rr              LDA   eval_reporter
00233Dr 2  48                 PHA
00233Er 2               
00233Er 2                     ; Tokenize the reconstructed line
00233Er 2  20 rr rr           JSR   tokenize_line
002341r 2               
002341r 2                     ; Evaluate it
002341r 2  20 rr rr           JSR   eval_line
002344r 2               
002344r 2                     ; Restore tokenizer/eval state
002344r 2  68                 PLA
002345r 2  85 rr              STA   eval_reporter
002347r 2  68                 PLA
002348r 2  85 rr              STA   eval_in_body
00234Ar 2  68                 PLA
00234Br 2  85 rr              STA   tok_tail_hi
00234Dr 2  68                 PLA
00234Er 2  85 rr              STA   tok_tail_lo
002350r 2  68                 PLA
002351r 2  85 rr              STA   tok_head_hi
002353r 2  68                 PLA
002354r 2  85 rr              STA   tok_head_lo
002356r 2               
002356r 2                     ; Restore eval_cur
002356r 2  68                 PLA
002357r 2  85 rr              STA   eval_cur_hi
002359r 2  68                 PLA
00235Ar 2  85 rr              STA   eval_cur_lo
00235Cr 2               
00235Cr 2  4C rr rr           JMP   eval_continue
00235Fr 2               
00235Fr 2               @err_type:
00235Fr 2  A2 rr              LDX   #<str_run_type
002361r 2  A0 rr              LDY   #>str_run_type
002363r 2  4C rr rr           JMP   list_print_err
002366r 2               @err:
002366r 2  A2 rr              LDX   #<str_run_err
002368r 2  A0 rr              LDY   #>str_run_err
00236Ar 2  4C rr rr           JMP   list_print_err
