002D3Br 2                     ; Save body-loop state that recursive proc_invoke would clobber.
002D3Br 2                     ; BSS save areas (save_heap_ptr, save_eval_cur) plus ZP body-loop
002D3Br 2                     ; variables (proc_ptr, proc_body_len) all need protection.
002D3Br 2  A5 rr              LDA   proc_ptr_lo
002D3Dr 2  48                 PHA
002D3Er 2  A5 rr              LDA   proc_ptr_hi
002D40r 2  48                 PHA
002D41r 2  A5 rr              LDA   proc_body_len_lo
002D43r 2  48                 PHA
002D44r 2  A5 rr              LDA   proc_body_len_hi
002D46r 2  48                 PHA
002D47r 2  AD rr rr           LDA   save_heap_ptr_lo
002D4Ar 2  48                 PHA
002D4Br 2  AD rr rr           LDA   save_heap_ptr_hi
002D4Er 2  48                 PHA
002D4Fr 2  AD rr rr           LDA   save_eval_cur_lo
002D52r 2  48                 PHA
002D53r 2  AD rr rr           LDA   save_eval_cur_hi
002D56r 2  48                 PHA
002D57r 2               
002D57r 2                     ; Eval this line (full eval — not body mode)
002D57r 2  20 rr rr           JSR   eval_line
002D5Ar 2               
002D5Ar 2                     ; Restore body-loop state
002D5Ar 2  68                 PLA
002D5Br 2  8D rr rr           STA   save_eval_cur_hi
002D5Er 2  68                 PLA
002D5Fr 2  8D rr rr           STA   save_eval_cur_lo
002D62r 2  68                 PLA
002D63r 2  8D rr rr           STA   save_heap_ptr_hi
002D66r 2  68                 PLA
002D67r 2  8D rr rr           STA   save_heap_ptr_lo
002D6Ar 2  68                 PLA
002D6Br 2  85 rr              STA   proc_body_len_hi
002D6Dr 2  68                 PLA
002D6Er 2  85 rr              STA   proc_body_len_lo
002D70r 2  68                 PLA
002D71r 2  85 rr              STA   proc_ptr_hi
002D73r 2  68                 PLA
002D74r 2  85 rr              STA   proc_ptr_lo
