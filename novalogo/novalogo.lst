0005B9r 2               
0005B9r 1                     .include "lists.s"
0005B9r 2               ; lists.s — list data type, cons pairs, and list operations for NovaLogo
0005B9r 2               ;
0005B9r 2               ; Cons pair format on heap (7 bytes):
0005B9r 2               ;   +0: tag byte ($10 = CONS_PAIR)
0005B9r 2               ;   +1: car_type ($00=number, $01=word, $02=list)
0005B9r 2               ;   +2: car_hi
0005B9r 2               ;   +3: car_lo
0005B9r 2               ;   +4: car_frac (only meaningful for numbers)
0005B9r 2               ;   +5: cdr_lo (pointer to next cons pair, or $0000 for empty)
0005B9r 2               ;   +6: cdr_hi
0005B9r 2               
0005B9r 2               CONS_PAIR  = $10
0005B9r 2               CONS_SIZE  = 7
0005B9r 2               
0005B9r 2               ; Value type constants
0005B9r 2               .ifndef VAL_NUMBER
0005B9r 2               VAL_NUMBER = $00
0005B9r 2               .endif
0005B9r 2               .ifndef VAL_WORD
0005B9r 2               VAL_WORD   = $01
0005B9r 2               .endif
0005B9r 2               .ifndef VAL_LIST
0005B9r 2               VAL_LIST   = $02
0005B9r 2               .endif
0005B9r 2               
0005B9r 2               ; Cons pair field offsets
0005B9r 2               CONS_TAG      = 0
0005B9r 2               CONS_CAR_TYPE = 1
0005B9r 2               CONS_CAR_HI   = 2
0005B9r 2               CONS_CAR_LO   = 3
0005B9r 2               CONS_CAR_FRAC = 4
0005B9r 2               CONS_CDR_LO   = 5
0005B9r 2               CONS_CDR_HI   = 6
0005B9r 2               
0005B9r 2               ; =====================================================================
0005B9r 2               ; ZEROPAGE segment — list scratch variables
0005B9r 2               ; =====================================================================
0005B9r 2                     .segment "ZEROPAGE"
00002Fr 2               
00002Fr 2  xx           list_head_lo:   .res 1    ; head of list being built
000030r 2  xx           list_head_hi:   .res 1
000031r 2  xx           list_tail_lo:   .res 1    ; tail of list being built
000032r 2  xx           list_tail_hi:   .res 1
000033r 2  xx           list_ptr_lo:    .res 1    ; general list walk pointer
000034r 2  xx           list_ptr_hi:    .res 1
000035r 2  xx           list_count_lo:  .res 1    ; 16-bit counter for COUNT / ITEM
000036r 2  xx           list_count_hi:  .res 1
000037r 2               
000037r 2               ; =====================================================================
000037r 2               ; CODE segment — list building and operations
000037r 2               ; =====================================================================
000037r 2                     .segment "CODE"
0018FEr 2               
0018FEr 2               ; ---------------------------------------------------------------------
0018FEr 2               ; eval_list — build a list from tokens between [ and ]
0018FEr 2               ;   Entry: eval_cur points at the first token AFTER the [
0018FEr 2               ;   Exit:  eval_type = VAL_LIST, eval_val_lo/hi = head cons pair ptr
0018FEr 2               ;          eval_cur advanced past the matching ]
0018FEr 2               ;          Carry clear = success
0018FEr 2               ; ---------------------------------------------------------------------
0018FEr 2               eval_list:
0018FEr 2  64 rr              STZ   list_head_lo
001900r 2  64 rr              STZ   list_head_hi
001902r 2  64 rr              STZ   list_tail_lo
001904r 2  64 rr              STZ   list_tail_hi
001906r 2               
001906r 2               @next_element:
001906r 2  A5 rr              LDA   eval_cur_lo
001908r 2  05 rr              ORA   eval_cur_hi
00190Ar 2  D0 03              BNE   :+
00190Cr 2  4C rr rr           JMP   @err_no_bracket
00190Fr 2               :
00190Fr 2  A5 rr              LDA   eval_cur_lo
001911r 2  85 rr              STA   ptr_lo
001913r 2  A5 rr              LDA   eval_cur_hi
001915r 2  85 rr              STA   ptr_hi
001917r 2  A0 00              LDY   #TOK_TAG
001919r 2  B1 rr              LDA   (ptr_lo),Y
00191Br 2               
00191Br 2  C9 04              CMP   #TOK_RBRACKET
00191Dr 2  D0 03              BNE   :+
00191Fr 2  4C rr rr           JMP   @end_list
001922r 2               :
001922r 2  C9 02              CMP   #TOK_NUMBER
001924r 2  D0 03              BNE   :+
001926r 2  4C rr rr           JMP   @list_number
001929r 2  C9 01        :     CMP   #TOK_WORD
00192Br 2  F0 10              BEQ   @list_word_jmp
00192Dr 2  C9 06              CMP   #TOK_QUOTE
00192Fr 2  F0 0C              BEQ   @list_word_jmp
001931r 2  C9 03              CMP   #TOK_LBRACKET
001933r 2  D0 03              BNE   :+
001935r 2  4C rr rr           JMP   @list_sublist
001938r 2               :     ; Unknown token type in list — skip it
001938r 2  20 rr rr           JSR   eval_advance
00193Br 2  80 C9              BRA   @next_element
00193Dr 2               
00193Dr 2               @list_word_jmp:
00193Dr 2  4C rr rr           JMP   @list_word
001940r 2               
001940r 2               @list_number:
