001ECDr 2               
001ECDr 2               @mem_true:
001ECDr 2  68                 PLA
001ECEr 2  68                 PLA
001ECFr 2  68                 PLA
001ED0r 2  68                 PLA
001ED1r 2  A9 00              LDA   #VAL_NUMBER
001ED3r 2  85 rr              STA   eval_type
001ED5r 2  A9 01              LDA   #1
001ED7r 2  85 rr              STA   eval_val_lo
001ED9r 2  64 rr              STZ   eval_val_hi
