0021BFr 2               ; ---------------------------------------------------------------------
0021BFr 2               ; do_sentence — SENTENCE val1 val2: concatenate two values as flat list
0021BFr 2               ;   Non-list args are wrapped as single-element lists first.
0021BFr 2               ;   Arity 0: evaluates its own arguments
0021BFr 2               ; ---------------------------------------------------------------------
0021BFr 2               do_sentence:
0021BFr 2                     ; Evaluate first arg
0021BFr 2  20 rr rr           JSR   eval_expr
0021C2r 2  90 03              BCC   :+
0021C4r 2  4C rr rr           JMP   @err
0021C7r 2               :
0021C7r 2                     ; Save first value
0021C7r 2  A5 rr              LDA   eval_type
0021C9r 2  48                 PHA
0021CAr 2  A5 rr              LDA   eval_val_hi
0021CCr 2  48                 PHA
0021CDr 2  A5 rr              LDA   eval_val_lo
0021CFr 2  48                 PHA
0021D0r 2  A5 rr              LDA   eval_val_frac
0021D2r 2  48                 PHA
0021D3r 2               
0021D3r 2                     ; Evaluate second arg
0021D3r 2  20 rr rr           JSR   eval_expr
0021D6r 2  90 03              BCC   :+
0021D8r 2  4C rr rr           JMP   @err_pop4
0021DBr 2               :
0021DBr 2                     ; Save second value
0021DBr 2  A5 rr              LDA   eval_type
0021DDr 2  48                 PHA
0021DEr 2  A5 rr              LDA   eval_val_hi
0021E0r 2  48                 PHA
0021E1r 2  A5 rr              LDA   eval_val_lo
0021E3r 2  48                 PHA
0021E4r 2  A5 rr              LDA   eval_val_frac
0021E6r 2  48                 PHA
0021E7r 2               
0021E7r 2                     ; Process first arg: if not list, wrap in single-element list
0021E7r 2                     ; First value is at stack offset 4..7 (under second value)
0021E7r 2  BA                 TSX
0021E8r 2  BD 08 01           LDA   $0108,X                 ; first type
0021EBr 2  C9 02              CMP   #VAL_LIST
0021EDr 2  F0 4D              BEQ   @first_is_list
0021EFr 2               
0021EFr 2                     ; Wrap first value as single-element list
0021EFr 2  A9 07              LDA   #CONS_SIZE
0021F1r 2  A2 02              LDX   #ATYPE_CONS
0021F3r 2  20 rr rr           JSR   heap_alloc
0021F6r 2  90 03              BCC   :+
0021F8r 2  4C rr rr           JMP   @oom_pop8
0021FBr 2               :
0021FBr 2  A0 00              LDY   #CONS_TAG
0021FDr 2  A9 10              LDA   #CONS_PAIR
0021FFr 2  91 rr              STA   (ptr_lo),Y
002201r 2  BA                 TSX
002202r 2  BD 08 01           LDA   $0108,X                 ; first type
002205r 2  A0 01              LDY   #CONS_CAR_TYPE
002207r 2  91 rr              STA   (ptr_lo),Y
002209r 2  BD 07 01           LDA   $0107,X                 ; first hi
00220Cr 2  A0 02              LDY   #CONS_CAR_HI
00220Er 2  91 rr              STA   (ptr_lo),Y
002210r 2  BD 06 01           LDA   $0106,X                 ; first lo
002213r 2  A0 03              LDY   #CONS_CAR_LO
002215r 2  91 rr              STA   (ptr_lo),Y
002217r 2  BD 05 01           LDA   $0105,X                 ; first frac
00221Ar 2  A0 04              LDY   #CONS_CAR_FRAC
00221Cr 2  91 rr              STA   (ptr_lo),Y
00221Er 2  A0 05              LDY   #CONS_CDR_LO
002220r 2  A9 00              LDA   #0
002222r 2  91 rr              STA   (ptr_lo),Y
002224r 2  A0 06              LDY   #CONS_CDR_HI
002226r 2  91 rr              STA   (ptr_lo),Y
