000380r 2               
000380r 2               ; Powers of 10 table (16-bit): 10000, 1000, 100, 10, 1
000380r 2               pow10_lo:
000380r 2  10 E8 64 0A        .byte <10000, <1000, <100, <10, <1
000384r 2  01           
000385r 2               pow10_hi:
000385r 2  27 03 00 00        .byte >10000, >1000, >100, >10, >1
000389r 2  00           
00038Ar 2               
00038Ar 1                     .include "builtins.s"
00038Ar 2               ; builtins.s — built-in command table and handlers
00038Ar 2               
00038Ar 2               ; =====================================================================
00038Ar 2               ; CODE segment — builtin lookup and handlers
00038Ar 2               ; =====================================================================
00038Ar 2                     .segment "CODE"
000CF8r 2               
000CF8r 2               ; ---------------------------------------------------------------------
000CF8r 2               ; lookup_builtin — search builtin table for the current TOK_WORD
000CF8r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000CF8r 2               ;   Output: Carry clear = found, ptr2_lo/hi = handler addr, A = arity
000CF8r 2               ;           Carry set = not found
000CF8r 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000CF8r 2               ; ---------------------------------------------------------------------
000CF8r 2               lookup_builtin:
000CF8r 2                     ; Save table pointer in num_tmp_lo/hi
000CF8r 2  A9 rr              LDA   #<builtin_table
000CFAr 2  8D rr rr           STA   num_tmp_lo
000CFDr 2  A9 rr              LDA   #>builtin_table
000CFFr 2  8D rr rr           STA   num_tmp_hi
000D02r 2               
000D02r 2               @scan:
000D02r 2                     ; Read name pointer from table
000D02r 2  AD rr rr           LDA   num_tmp_lo
000D05r 2  85 rr              STA   ptr2_lo
000D07r 2  AD rr rr           LDA   num_tmp_hi
000D0Ar 2  85 rr              STA   ptr2_hi
000D0Cr 2  A0 00              LDY   #0
000D0Er 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000D10r 2  AA                 TAX
000D11r 2  C8                 INY
000D12r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000D14r 2  D0 06              BNE   @have_entry
000D16r 2  E0 00              CPX   #0
000D18r 2  D0 02              BNE   @have_entry
000D1Ar 2                     ; Null pointer — end of table
000D1Ar 2  38                 SEC
000D1Br 2  60                 RTS
000D1Cr 2               
000D1Cr 2               @have_entry:
000D1Cr 2                     ; X = name_ptr_lo, A = name_ptr_hi
000D1Cr 2                     ; Compare the table name against the token payload
000D1Cr 2                     ; Token payload: at eval_cur + TOK_PAYLOAD = length byte + chars
000D1Cr 2  85 rr              STA   ptr2_hi
000D1Er 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000D20r 2               
000D20r 2                     ; Get token payload pointer
000D20r 2  A5 rr              LDA   eval_cur_lo
000D22r 2  85 rr              STA   ptr_lo
000D24r 2  A5 rr              LDA   eval_cur_hi
000D26r 2  85 rr              STA   ptr_hi
000D28r 2               
000D28r 2                     ; Compare length bytes
000D28r 2  A0 00              LDY   #0
000D2Ar 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000D2Cr 2  A0 03              LDY   #TOK_PAYLOAD
000D2Er 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000D30r 2  D0 41              BNE   @next
000D32r 2               
000D32r 2                     ; Lengths match — compare chars
000D32r 2  AA                 TAX                       ; X = length
000D33r 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000D35r 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000D37r 2               @cmp_loop:
000D37r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000D39r 2  5A                 PHY
000D3Ar 2                     ; Compute token char offset: TOK_PAYLOAD + 1 + tok_sign
000D3Ar 2  A5 rr              LDA   tok_sign
000D3Cr 2  18                 CLC
000D3Dr 2  69 04              ADC   #TOK_PAYLOAD+1
000D3Fr 2  A8                 TAY
000D40r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000D42r 2  7A                 PLY
000D43r 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000D45r 2  D0 2C              BNE   @next
000D47r 2  C8                 INY
000D48r 2  E6 rr              INC   tok_sign
000D4Ar 2  CA                 DEX
000D4Br 2  D0 EA              BNE   @cmp_loop
000D4Dr 2               
000D4Dr 2                     ; Match found — read handler address and arity
000D4Dr 2                     ; Table entry: name_ptr(2) + handler_addr(2) + arity(1)
000D4Dr 2                     ; handler is at table_base + 2, arity at table_base + 4
000D4Dr 2  AD rr rr           LDA   num_tmp_lo
000D50r 2  85 rr              STA   ptr2_lo
000D52r 2  AD rr rr           LDA   num_tmp_hi
000D55r 2  85 rr              STA   ptr2_hi
000D57r 2  A0 02              LDY   #2
000D59r 2  B1 rr              LDA   (ptr2_lo),Y        ; handler low
000D5Br 2  AA                 TAX
000D5Cr 2  C8                 INY
000D5Dr 2  B1 rr              LDA   (ptr2_lo),Y        ; handler high
000D5Fr 2  85 rr              STA   ptr2_hi
000D61r 2  86 rr              STX   ptr2_lo             ; ptr2 = handler address (return value)
000D63r 2                     ; Read arity from the table (num_tmp = entry base)
000D63r 2  AD rr rr           LDA   num_tmp_lo
000D66r 2  85 rr              STA   ptr_lo
000D68r 2  AD rr rr           LDA   num_tmp_hi
000D6Br 2  85 rr              STA   ptr_hi
000D6Dr 2  A0 04              LDY   #4
000D6Fr 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000D71r 2  18                 CLC                       ; found
000D72r 2  60                 RTS
000D73r 2               
000D73r 2               @next:
000D73r 2  64 rr              STZ   tok_sign            ; reset comparison counter
000D75r 2                     ; Advance to next entry: +5 bytes (2 name + 2 handler + 1 arity)
000D75r 2  18                 CLC
000D76r 2  AD rr rr           LDA   num_tmp_lo
000D79r 2  69 05              ADC   #5
000D7Br 2  8D rr rr           STA   num_tmp_lo
000D7Er 2  90 03              BCC   @next2
000D80r 2  EE rr rr           INC   num_tmp_hi
000D83r 2               @next2:
000D83r 2  4C rr rr           JMP   @scan
000D86r 2               
000D86r 2               ; ---------------------------------------------------------------------
000D86r 2               ; do_print — PRINT <expr>: evaluate arg and print with newline
000D86r 2               ;   Entry: eval_val/eval_type already set with the argument
000D86r 2               ;   Must JMP to eval_continue when done
000D86r 2               ; ---------------------------------------------------------------------
000D86r 2               ; do_print / do_type share one body. PRINT appends a newline; TYPE does not.
000D86r 2               ; The newline flag is carried on the stack across the (balanced) print calls.
000D86r 2               do_print:
000D86r 2  A9 FF              LDA   #$FF                 ; PRINT: append trailing newline
000D88r 2  80 02              BRA   pt_common
000D8Ar 2               do_type:
000D8Ar 2  A9 00              LDA   #$00                 ; TYPE: no trailing newline
000D8Cr 2               pt_common:
000D8Cr 2  48                 PHA                        ; save newline flag
000D8Dr 2  A5 rr              LDA   eval_type
000D8Fr 2  C9 02              CMP   #VAL_LIST
000D91r 2  F0 09              BEQ   pt_list
000D93r 2  C9 01              CMP   #VAL_WORD
000D95r 2  F0 0A              BEQ   pt_word
000D97r 2               
000D97r 2                     ; Print number
000D97r 2  20 rr rr           JSR   print_number
000D9Ar 2  80 1C              BRA   pt_done
000D9Cr 2               
000D9Cr 2               pt_list:
000D9Cr 2  20 rr rr           JSR   print_list
000D9Fr 2  80 17              BRA   pt_done
000DA1r 2               
000DA1r 2               pt_word:
000DA1r 2                     ; Print quoted word — eval_val_lo/hi points at length+chars
000DA1r 2  A5 rr              LDA   eval_val_lo
000DA3r 2  85 rr              STA   ptr_lo
000DA5r 2  A5 rr              LDA   eval_val_hi
000DA7r 2  85 rr              STA   ptr_hi
000DA9r 2  A0 00              LDY   #0
000DABr 2  B1 rr              LDA   (ptr_lo),Y         ; length
000DADr 2  AA                 TAX
000DAEr 2  C8                 INY
000DAFr 2               pt_wch:
000DAFr 2  B1 rr              LDA   (ptr_lo),Y
000DB1r 2  8D 0E A0           STA   VGC_CHAROUT
000DB4r 2  C8                 INY
000DB5r 2  CA                 DEX
000DB6r 2  D0 F7              BNE   pt_wch
000DB8r 2               
000DB8r 2               pt_done:
000DB8r 2  68                 PLA                        ; restore newline flag
000DB9r 2  F0 03              BEQ   pt_no_nl
000DBBr 2  20 rr rr           JSR   eval_newline
000DBEr 2               pt_no_nl:
000DBEr 2  4C rr rr           JMP   eval_continue
000DC1r 2               
000DC1r 2               ; ---------------------------------------------------------------------
000DC1r 2               ; do_type — TYPE <expr>: like PRINT but no newline
000DC1r 2               ; ---------------------------------------------------------------------
000DC1r 2               ; ---------------------------------------------------------------------
000DC1r 2               ; do_make — MAKE "name value: store a variable
000DC1r 2               ;   Arity 0 — we do our own argument evaluation
000DC1r 2               ;   1. eval_expr → name (must be TOK_QUOTE → word type)
000DC1r 2               ;   2. save name pointer
000DC1r 2               ;   3. eval_expr → value
000DC1r 2               ;   4. var_set(saved name, current value)
000DC1r 2               ; ---------------------------------------------------------------------
000DC1r 2               do_make:
000DC1r 2                     ; Evaluate first argument: the name (a quoted word)
000DC1r 2  20 rr rr           JSR   eval_expr
000DC4r 2  B0 1F              BCS   @err
000DC6r 2               
000DC6r 2                     ; Must be a word (type $01)
000DC6r 2  A5 rr              LDA   eval_type
000DC8r 2  C9 01              CMP   #$01
000DCAr 2  D0 19              BNE   @err
000DCCr 2               
000DCCr 2                     ; Save the name pointer (points into token payload: len + chars)
000DCCr 2  A5 rr              LDA   eval_val_lo
000DCEr 2  48                 PHA
000DCFr 2  A5 rr              LDA   eval_val_hi
000DD1r 2  48                 PHA
000DD2r 2               
000DD2r 2                     ; Evaluate second argument: the value
000DD2r 2  20 rr rr           JSR   eval_expr
000DD5r 2  B0 0C              BCS   @err_pop
000DD7r 2               
000DD7r 2                     ; Set up ptr_lo/hi → saved name, eval_val holds value
000DD7r 2  68                 PLA
000DD8r 2  85 rr              STA   ptr_hi
000DDAr 2  68                 PLA
000DDBr 2  85 rr              STA   ptr_lo
000DDDr 2               
000DDDr 2  20 rr rr           JSR   var_set
000DE0r 2  4C rr rr           JMP   eval_continue
000DE3r 2               
000DE3r 2               @err_pop:
000DE3r 2  68                 PLA
000DE4r 2  68                 PLA
000DE5r 2               @err:
000DE5r 2                     ; Print error
000DE5r 2  A2 rr              LDX   #<str_make_name
000DE7r 2  A0 rr              LDY   #>str_make_name
000DE9r 2  4C rr rr           JMP   err_nei
000DECr 2               
000DECr 2               ; ---------------------------------------------------------------------
000DECr 2               ; do_repeat — REPEAT count [body]
000DECr 2               ;   Arity 0 — handles its own argument parsing
000DECr 2               ;   1. Evaluate count expression
000DECr 2               ;   2. Locate the bracketed body [...]
000DECr 2               ;   3. Execute the body count times
000DECr 2               ;   4. Resume after the closing ]
000DECr 2               ;
000DECr 2               ;   Nesting: saves/restores repeat state (body_start, body_resume,
000DECr 2               ;   repeat_count, eval_in_body) on the hardware stack so nested
000DECr 2               ;   REPEAT works correctly.
000DECr 2               ; ---------------------------------------------------------------------
000DECr 2               
000DECr 2                     .segment "ZEROPAGE"
000022r 2  xx           repeat_count_lo:  .res 1
000023r 2  xx           repeat_count_hi:  .res 1
000024r 2  xx           body_start_lo:    .res 1       ; first token after [
000025r 2  xx           body_start_hi:    .res 1
000026r 2  xx           body_resume_lo:   .res 1       ; token after ]
000027r 2  xx           body_resume_hi:   .res 1
000028r 2  xx           repcount:         .res 1       ; 1-based REPCOUNT within REPEAT loop
000029r 2  xx           for_cur_lo:       .res 1       ; FOR loop current value low
00002Ar 2  xx           for_cur_hi:       .res 1       ; FOR loop current value high
00002Br 2  xx           for_end_lo:       .res 1       ; FOR loop end value low
00002Cr 2  xx           for_end_hi:       .res 1       ; FOR loop end value high
00002Dr 2  xx           cond_start_lo:    .res 1       ; WHILE/UNTIL condition start low
00002Er 2  xx           cond_start_hi:    .res 1       ; WHILE/UNTIL condition start high
00002Fr 2               
00002Fr 2                     .segment "CODE"
000DECr 2               
000DECr 2               do_repeat:
000DECr 2                     ; --- Evaluate the count argument ---
000DECr 2  20 rr rr           JSR   eval_expr
000DEFr 2  90 03              BCC   @count_ok
000DF1r 2  4C rr rr           JMP   @err_args             ; carry set = no token
000DF4r 2               @count_ok:
000DF4r 2                     ; Count must be a number
000DF4r 2  A5 rr              LDA   eval_type
000DF6r 2  F0 03              BEQ   @type_ok
000DF8r 2  4C rr rr           JMP   @err_args
000DFBr 2               @type_ok:
000DFBr 2               
000DFBr 2                     ; --- Save outer repeat state for nesting ---
000DFBr 2  A5 rr              LDA   repcount
000DFDr 2  48                 PHA
000DFEr 2  A5 rr              LDA   repeat_count_lo
000E00r 2  48                 PHA
000E01r 2  A5 rr              LDA   repeat_count_hi
000E03r 2  48                 PHA
000E04r 2  A5 rr              LDA   body_start_lo
000E06r 2  48                 PHA
000E07r 2  A5 rr              LDA   body_start_hi
000E09r 2  48                 PHA
000E0Ar 2  A5 rr              LDA   body_resume_lo
000E0Cr 2  48                 PHA
000E0Dr 2  A5 rr              LDA   body_resume_hi
000E0Fr 2  48                 PHA
000E10r 2  A5 rr              LDA   eval_in_body
000E12r 2  48                 PHA
000E13r 2               
000E13r 2                     ; Store count (integer part only, clamped to 0 if negative)
000E13r 2  A5 rr              LDA   eval_val_hi
000E15r 2  30 08              BMI   @zero_count           ; negative = treat as 0
000E17r 2  85 rr              STA   repeat_count_hi
000E19r 2  A5 rr              LDA   eval_val_lo
000E1Br 2  85 rr              STA   repeat_count_lo
000E1Dr 2  80 04              BRA   @find_body
000E1Fr 2               
