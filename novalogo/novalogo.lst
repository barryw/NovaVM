002240r 2  C9 02              CMP   #VAL_LIST
002242r 2  F0 4D              BEQ   @second_is_list
002244r 2               
002244r 2                     ; Wrap second value
002244r 2  A9 07              LDA   #CONS_SIZE
002246r 2  A2 02              LDX   #ATYPE_CONS
002248r 2  20 rr rr           JSR   heap_alloc
00224Br 2  90 03              BCC   :+
