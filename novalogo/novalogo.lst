000E69r 2               ; ---------------------------------------------------------------------
000E69r 2               ; exec_body_block — execute a [...] body once
000E69r 2               ;   Entry: eval_cur must point at a TOK_LBRACKET token
000E69r 2               ;   Exit:  eval_cur points past the matching ], carry clear = ok
000E69r 2               ;          Carry set = bracket error
000E69r 2               ;   Saves/restores body_resume, eval_in_body for nesting.
000E69r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, body_start/resume, eval_in_body
000E69r 2               ; ---------------------------------------------------------------------
000E69r 2               exec_body_block:
000E69r 2                     ; Verify current token is [
000E69r 2  A5 rr              LDA   eval_cur_lo
000E6Br 2  05 rr              ORA   eval_cur_hi
000E6Dr 2  F0 7B              BEQ   @err
000E6Fr 2  A5 rr              LDA   eval_cur_lo
000E71r 2  85 rr              STA   ptr_lo
000E73r 2  A5 rr              LDA   eval_cur_hi
000E75r 2  85 rr              STA   ptr_hi
000E77r 2  A0 00              LDY   #TOK_TAG
000E79r 2  B1 rr              LDA   (ptr_lo),Y
000E7Br 2  C9 03              CMP   #TOK_LBRACKET
000E7Dr 2  D0 6B              BNE   @err
000E7Fr 2               
000E7Fr 2                     ; Advance past [
000E7Fr 2  20 rr rr           JSR   eval_advance
000E82r 2               
000E82r 2                     ; Save outer state for nesting
000E82r 2  A5 rr              LDA   body_resume_lo
000E84r 2  48                 PHA
000E85r 2  A5 rr              LDA   body_resume_hi
000E87r 2  48                 PHA
000E88r 2  A5 rr              LDA   eval_in_body
000E8Ar 2  48                 PHA
000E8Br 2               
000E8Br 2                     ; Save body start
000E8Br 2  A5 rr              LDA   eval_cur_lo
000E8Dr 2  48                 PHA
000E8Er 2  A5 rr              LDA   eval_cur_hi
000E90r 2  48                 PHA
000E91r 2               
000E91r 2                     ; Scan forward for matching ]
000E91r 2  A2 01              LDX   #1
000E93r 2               @scan:
000E93r 2  A5 rr              LDA   eval_cur_lo
000E95r 2  05 rr              ORA   eval_cur_hi
000E97r 2  F0 4C              BEQ   @err_pop5
000E99r 2  A5 rr              LDA   eval_cur_lo
000E9Br 2  85 rr              STA   ptr_lo
000E9Dr 2  A5 rr              LDA   eval_cur_hi
000E9Fr 2  85 rr              STA   ptr_hi
000EA1r 2  A0 00              LDY   #TOK_TAG
000EA3r 2  B1 rr              LDA   (ptr_lo),Y
000EA5r 2  C9 03              CMP   #TOK_LBRACKET
000EA7r 2  D0 03              BNE   @not_lb
000EA9r 2  E8                 INX
000EAAr 2  80 07              BRA   @scan_next
000EACr 2               @not_lb:
000EACr 2  C9 04              CMP   #TOK_RBRACKET
000EAEr 2  D0 03              BNE   @scan_next
000EB0r 2  CA                 DEX
000EB1r 2  F0 07              BEQ   @found
000EB3r 2               @scan_next:
000EB3r 2  DA                 PHX
000EB4r 2  20 rr rr           JSR   eval_advance
000EB7r 2  FA                 PLX
000EB8r 2  80 D9              BRA   @scan
000EBAr 2               
000EBAr 2               @found:
000EBAr 2                     ; Advance past ] for resume point
000EBAr 2  20 rr rr           JSR   eval_advance
000EBDr 2  A5 rr              LDA   eval_cur_lo
000EBFr 2  85 rr              STA   body_resume_lo
000EC1r 2  A5 rr              LDA   eval_cur_hi
000EC3r 2  85 rr              STA   body_resume_hi
000EC5r 2               
000EC5r 2                     ; Restore body start
000EC5r 2  68                 PLA
000EC6r 2  85 rr              STA   eval_cur_hi
000EC8r 2  68                 PLA
000EC9r 2  85 rr              STA   eval_cur_lo
000ECBr 2               
000ECBr 2                     ; Execute the body
000ECBr 2  A9 01              LDA   #$01
000ECDr 2  85 rr              STA   eval_in_body
000ECFr 2  20 rr rr           JSR   eval_body
000ED2r 2               
000ED2r 2                     ; Restore outer state
000ED2r 2  68                 PLA
000ED3r 2  85 rr              STA   eval_in_body
000ED5r 2  68                 PLA
000ED6r 2  85 rr              STA   body_resume_hi
000ED8r 2  68                 PLA
000ED9r 2  85 rr              STA   body_resume_lo
000EDBr 2               
000EDBr 2                     ; Set eval_cur past the ]
000EDBr 2  A5 rr              LDA   body_resume_lo
000EDDr 2  85 rr              STA   eval_cur_lo
000EDFr 2  A5 rr              LDA   body_resume_hi
000EE1r 2  85 rr              STA   eval_cur_hi
000EE3r 2  18                 CLC
000EE4r 2  60                 RTS
000EE5r 2               
000EE5r 2               @err_pop5:
000EE5r 2  68                 PLA
000EE6r 2  68                 PLA
000EE7r 2  68                 PLA
000EE8r 2  68                 PLA
000EE9r 2  68                 PLA
000EEAr 2               @err:
000EEAr 2  38                 SEC
000EEBr 2  60                 RTS
000EECr 2               
000EECr 2               ; ---------------------------------------------------------------------
000EECr 2               ; do_if — IF condition [body]
000EECr 2               ;   Arity 0 — handles its own argument parsing
000EECr 2               ; ---------------------------------------------------------------------
000EECr 2               do_if:
000EECr 2  20 rr rr           JSR   eval_expr
000EEFr 2  B0 1D              BCS   @err
000EF1r 2               
000EF1r 2                     ; Nonzero integer part = true
000EF1r 2  A5 rr              LDA   eval_val_lo
000EF3r 2  05 rr              ORA   eval_val_hi
000EF5r 2  D0 08              BNE   @true
000EF7r 2               
000EF7r 2                     ; False — skip the body
000EF7r 2  20 rr rr           JSR   skip_list_body
000EFAr 2  B0 0B              BCS   @err_bracket
000EFCr 2  4C rr rr           JMP   eval_continue
000EFFr 2               
000EFFr 2               @true:
000EFFr 2  20 rr rr           JSR   exec_body_block
000F02r 2  B0 03              BCS   @err_bracket
000F04r 2  4C rr rr           JMP   eval_continue
000F07r 2               
000F07r 2               @err_bracket:
000F07r 2  A2 rr              LDX   #<str_if_bracket
000F09r 2  A0 rr              LDY   #>str_if_bracket
000F0Br 2  4C rr rr           JMP   list_print_err
000F0Er 2               @err:
000F0Er 2  A2 rr              LDX   #<str_if_err
000F10r 2  A0 rr              LDY   #>str_if_err
000F12r 2  4C rr rr           JMP   list_print_err
000F15r 2               
000F15r 2               ; ---------------------------------------------------------------------
000F15r 2               ; do_ifelse — IFELSE condition [true-body] [false-body]
000F15r 2               ;   Arity 0 — handles its own argument parsing
000F15r 2               ; ---------------------------------------------------------------------
000F15r 2               do_ifelse:
000F15r 2  20 rr rr           JSR   eval_expr
000F18r 2  B0 27              BCS   @err
000F1Ar 2               
000F1Ar 2  A5 rr              LDA   eval_val_lo
000F1Cr 2  05 rr              ORA   eval_val_hi
000F1Er 2  D0 0D              BNE   @is_true
000F20r 2               
000F20r 2                     ; FALSE: skip first body, execute second
000F20r 2  20 rr rr           JSR   skip_list_body
000F23r 2  B0 15              BCS   @err_bracket
000F25r 2  20 rr rr           JSR   exec_body_block
000F28r 2  B0 10              BCS   @err_bracket
000F2Ar 2  4C rr rr           JMP   eval_continue
000F2Dr 2               
000F2Dr 2               @is_true:
000F2Dr 2                     ; TRUE: execute first body, skip second
000F2Dr 2  20 rr rr           JSR   exec_body_block
000F30r 2  B0 08              BCS   @err_bracket
000F32r 2  20 rr rr           JSR   skip_list_body
000F35r 2  B0 03              BCS   @err_bracket
000F37r 2  4C rr rr           JMP   eval_continue
000F3Ar 2               
000F3Ar 2               @err_bracket:
000F3Ar 2  A2 rr              LDX   #<str_ifelse_bracket
000F3Cr 2  A0 rr              LDY   #>str_ifelse_bracket
000F3Er 2  4C rr rr           JMP   list_print_err
000F41r 2               @err:
000F41r 2  A2 rr              LDX   #<str_ifelse_err
000F43r 2  A0 rr              LDY   #>str_ifelse_err
000F45r 2  4C rr rr           JMP   list_print_err
000F48r 2               
000F48r 2               ; ---------------------------------------------------------------------
000F48r 2               ; do_stop — STOP: exit current procedure immediately (no return value)
000F48r 2               ;   Arity 0, no arguments
000F48r 2               ; ---------------------------------------------------------------------
000F48r 2               do_stop:
000F48r 2  A9 01              LDA   #$01
000F4Ar 2  85 rr              STA   proc_stopped
000F4Cr 2  4C rr rr           JMP   eval_continue
000F4Fr 2               
000F4Fr 2               ; ---------------------------------------------------------------------
000F4Fr 2               ; do_output — OUTPUT expr: exit procedure with a return value
000F4Fr 2               ;   Arity 0 — handles its own argument evaluation
000F4Fr 2               ; ---------------------------------------------------------------------
000F4Fr 2               do_output:
000F4Fr 2  20 rr rr           JSR   eval_expr           ; evaluate the expression
000F52r 2  A9 02              LDA   #$02
000F54r 2  85 rr              STA   proc_stopped        ; signal OUTPUT
000F56r 2                     ; eval_type/eval_val holds the return value
000F56r 2  4C rr rr           JMP   eval_continue
000F59r 2               
000F59r 2               ; ---------------------------------------------------------------------
000F59r 2               ; do_catch — CATCH "tag [body]: execute body, catching errors/throws
000F59r 2               ;   Arity 0 — handles its own argument parsing
000F59r 2               ;   1. Evaluate tag argument (quoted word)
000F59r 2               ;   2. Save current catch frame (for nesting) on the 6502 stack
000F59r 2               ;   3. Set up new catch frame with tag and stack pointer
000F59r 2               ;   4. Execute the body
000F59r 2               ;   5. On normal completion: restore previous catch frame, continue
000F59r 2               ;   On THROW match: try_throw_error or do_throw restores SP from
000F59r 2               ;   catch frame, which unwinds back to step 5's stack context.
000F59r 2               ; ---------------------------------------------------------------------
000F59r 2               do_catch:
000F59r 2                     ; Evaluate tag argument (e.g., "ERROR)
000F59r 2  20 rr rr           JSR   eval_expr
000F5Cr 2  90 03              BCC   @tag_ok
000F5Er 2  4C rr rr           JMP   @err_tag
000F61r 2               @tag_ok:
000F61r 2               
000F61r 2                     ; Must be a word
000F61r 2  A5 rr              LDA   eval_type
000F63r 2  C9 01              CMP   #VAL_WORD
000F65r 2  F0 03              BEQ   @type_ok
000F67r 2  4C rr rr           JMP   @err_tag
000F6Ar 2               @type_ok:
000F6Ar 2               
000F6Ar 2                     ; Save tag pointer and eval_in_body temporarily (3 bytes)
000F6Ar 2  A5 rr              LDA   eval_val_lo
000F6Cr 2  48                 PHA
000F6Dr 2  A5 rr              LDA   eval_val_hi
000F6Fr 2  48                 PHA
000F70r 2  A5 rr              LDA   eval_in_body
000F72r 2  48                 PHA
000F73r 2               
000F73r 2                     ; Push previous catch frame onto the 6502 stack (6 bytes)
000F73r 2  A5 rr              LDA   catch_active
000F75r 2  48                 PHA
000F76r 2  A5 rr              LDA   catch_tag_lo
000F78r 2  48                 PHA
000F79r 2  A5 rr              LDA   catch_tag_hi
000F7Br 2  48                 PHA
000F7Cr 2  A5 rr              LDA   catch_sp
000F7Er 2  48                 PHA
000F7Fr 2  A5 rr              LDA   catch_resume_lo
000F81r 2  48                 PHA
000F82r 2  A5 rr              LDA   catch_resume_hi
000F84r 2  48                 PHA
000F85r 2               
000F85r 2                     ; Set up the tag pointer from saved values
000F85r 2                     ; Stack (top to bottom): prev_frame(6), eval_in_body, eval_val_hi, eval_val_lo
000F85r 2                     ; $0101+X = SP+1 = top. eval_in_body at SP+7, eval_val_hi at SP+8, eval_val_lo at SP+9
000F85r 2  BA                 TSX
000F86r 2  BD 08 01           LDA   $0108,X               ; eval_val_hi = tag ptr high
000F89r 2  85 rr              STA   catch_tag_hi
000F8Br 2  BD 09 01           LDA   $0109,X               ; eval_val_lo = tag ptr low
000F8Er 2  85 rr              STA   catch_tag_lo
000F90r 2               
000F90r 2                     ; Save stack pointer NOW — this is the unwind target.
000F90r 2                     ; When a THROW matches, TXS restores to this SP, and the
000F90r 2                     ; 6 PLA instructions below will pop the previous frame.
000F90r 2  BA                 TSX
000F91r 2  86 rr              STX   catch_sp
000F93r 2               
000F93r 2                     ; Activate the catch
000F93r 2  A9 01              LDA   #$01
000F95r 2  85 rr              STA   catch_active
000F97r 2               
000F97r 2                     ; We need to find the resume point PAST the body's ].
000F97r 2                     ; Scan ahead to find it, then come back and execute the body.
000F97r 2                     ; Save body start location first.
000F97r 2  A5 rr              LDA   eval_cur_lo
000F99r 2  48                 PHA                         ; save body-start lo
000F9Ar 2  A5 rr              LDA   eval_cur_hi
000F9Cr 2  48                 PHA                         ; save body-start hi
000F9Dr 2               
000F9Dr 2                     ; Scan past the body [...] to find resume point
000F9Dr 2  20 rr rr           JSR   skip_list_body
000FA0r 2  B0 31              BCS   @err_bracket_pop
000FA2r 2               
000FA2r 2                     ; eval_cur is now past the ]. Save as resume point.
000FA2r 2  A5 rr              LDA   eval_cur_lo
000FA4r 2  85 rr              STA   catch_resume_lo
000FA6r 2  A5 rr              LDA   eval_cur_hi
000FA8r 2  85 rr              STA   catch_resume_hi
000FAAr 2               
000FAAr 2                     ; Restore body start
000FAAr 2  68                 PLA
000FABr 2  85 rr              STA   eval_cur_hi
000FADr 2  68                 PLA
000FAEr 2  85 rr              STA   eval_cur_lo
000FB0r 2               
000FB0r 2                     ; Execute the body
000FB0r 2  20 rr rr           JSR   exec_body_block
000FB3r 2               
000FB3r 2                     ; Body completed normally — restore previous catch frame
000FB3r 2                     ; (Stack still has: prev_frame(6), tag_hi, tag_lo at the bottom)
000FB3r 2  68                 PLA
000FB4r 2  85 rr              STA   catch_resume_hi
000FB6r 2  68                 PLA
000FB7r 2  85 rr              STA   catch_resume_lo
000FB9r 2  68                 PLA
000FBAr 2  85 rr              STA   catch_sp
000FBCr 2  68                 PLA
000FBDr 2  85 rr              STA   catch_tag_hi
000FBFr 2  68                 PLA
000FC0r 2  85 rr              STA   catch_tag_lo
000FC2r 2  68                 PLA
000FC3r 2  85 rr              STA   catch_active
000FC5r 2               
000FC5r 2                     ; Discard saved eval_in_body + tag ptr (3 bytes)
000FC5r 2  68                 PLA                         ; eval_in_body
000FC6r 2  68                 PLA                         ; tag_hi
000FC7r 2  68                 PLA                         ; tag_lo
000FC8r 2               
000FC8r 2                     ; Set eval_cur past the body
000FC8r 2  A5 rr              LDA   catch_resume_lo
000FCAr 2  85 rr              STA   eval_cur_lo
000FCCr 2  A5 rr              LDA   catch_resume_hi
000FCEr 2  85 rr              STA   eval_cur_hi
000FD0r 2  4C rr rr           JMP   eval_continue
000FD3r 2               
000FD3r 2               @err_bracket_pop:
000FD3r 2                     ; Clean up: body-start was partially popped by skip_list_body error
000FD3r 2  68                 PLA                         ; body_start_hi
000FD4r 2  68                 PLA                         ; body_start_lo
000FD5r 2                     ; Restore previous catch frame
000FD5r 2  68                 PLA
000FD6r 2  85 rr              STA   catch_resume_hi
000FD8r 2  68                 PLA
000FD9r 2  85 rr              STA   catch_resume_lo
000FDBr 2  68                 PLA
000FDCr 2  85 rr              STA   catch_sp
000FDEr 2  68                 PLA
000FDFr 2  85 rr              STA   catch_tag_hi
000FE1r 2  68                 PLA
000FE2r 2  85 rr              STA   catch_tag_lo
000FE4r 2  68                 PLA
000FE5r 2  85 rr              STA   catch_active
000FE7r 2                     ; Discard saved eval_in_body + tag ptr (3 bytes)
000FE7r 2  68                 PLA
000FE8r 2  68                 PLA
000FE9r 2  68                 PLA
000FEAr 2                     ; Print bracket error
000FEAr 2  A2 rr              LDX   #<str_catch_bracket
000FECr 2  A0 rr              LDY   #>str_catch_bracket
000FEEr 2  4C rr rr           JMP   list_print_err
000FF1r 2               
000FF1r 2               @err_tag:
000FF1r 2  A2 rr              LDX   #<str_catch_err
000FF3r 2  A0 rr              LDY   #>str_catch_err
000FF5r 2  4C rr rr           JMP   list_print_err
000FF8r 2               
000FF8r 2               ; ---------------------------------------------------------------------
000FF8r 2               ; do_throw — THROW "tag: unwind to matching CATCH
000FF8r 2               ;   Arity 0 — handles its own argument parsing
000FF8r 2               ;   1. Evaluate tag argument
000FF8r 2               ;   2. If catch is active and tags match: unwind via TXS
000FF8r 2               ;   3. If no match: print error
000FF8r 2               ; ---------------------------------------------------------------------
000FF8r 2               do_throw:
000FF8r 2                     ; Evaluate tag argument
000FF8r 2  20 rr rr           JSR   eval_expr
000FFBr 2  B0 7C              BCS   @err_tag
000FFDr 2               
000FFDr 2                     ; Must be a word
000FFDr 2  A5 rr              LDA   eval_type
000FFFr 2  C9 01              CMP   #VAL_WORD
001001r 2  D0 76              BNE   @err_tag
001003r 2               
001003r 2                     ; Is a catch frame active?
001003r 2  A5 rr              LDA   catch_active
001005r 2  F0 3A              BEQ   @no_catch
001007r 2               
001007r 2                     ; Compare tags: eval_val_lo/hi vs catch_tag_lo/hi
001007r 2  A5 rr              LDA   eval_val_lo
001009r 2  85 rr              STA   ptr_lo
00100Br 2  A5 rr              LDA   eval_val_hi
00100Dr 2  85 rr              STA   ptr_hi
00100Fr 2  A5 rr              LDA   catch_tag_lo
001011r 2  85 rr              STA   ptr2_lo
001013r 2  A5 rr              LDA   catch_tag_hi
001015r 2  85 rr              STA   ptr2_hi
001017r 2  20 rr rr           JSR   catch_tags_equal
00101Ar 2  90 25              BCC   @no_catch
00101Cr 2               
00101Cr 2                     ; Match! Unwind stack to catch point.
00101Cr 2  A6 rr              LDX   catch_sp
00101Er 2  9A                 TXS
00101Fr 2               
00101Fr 2                     ; Restore previous catch frame from the restored stack
00101Fr 2  68                 PLA
001020r 2  85 rr              STA   catch_resume_hi
001022r 2  68                 PLA
001023r 2  85 rr              STA   catch_resume_lo
001025r 2  68                 PLA
001026r 2  85 rr              STA   catch_sp
001028r 2  68                 PLA
001029r 2  85 rr              STA   catch_tag_hi
00102Br 2  68                 PLA
00102Cr 2  85 rr              STA   catch_tag_lo
00102Er 2  68                 PLA
00102Fr 2  85 rr              STA   catch_active
001031r 2               
001031r 2                     ; Restore eval_in_body and discard saved tag pointer (3 bytes)
001031r 2  68                 PLA
001032r 2  85 rr              STA   eval_in_body
001034r 2  68                 PLA                         ; tag_hi
001035r 2  68                 PLA                         ; tag_lo
001036r 2               
001036r 2                     ; Set eval_cur to resume point (past the caught body)
001036r 2  A5 rr              LDA   catch_resume_lo
001038r 2  85 rr              STA   eval_cur_lo
00103Ar 2  A5 rr              LDA   catch_resume_hi
00103Cr 2  85 rr              STA   eval_cur_hi
00103Er 2               
00103Er 2  4C rr rr           JMP   eval_continue
001041r 2               
001041r 2               @no_catch:
001041r 2                     ; Print "CAN'T FIND CATCH TAG " + the tag
001041r 2  20 rr rr           JSR   print_inl
001044r 2  43 41 4E 27        .byte "CAN'T FIND CATCH TAG ", 0
001048r 2  54 20 46 49  
00104Cr 2  4E 44 20 43  
00105Ar 2               @nc_word:
00105Ar 2                     ; Print the tag word
00105Ar 2  A5 rr              LDA   eval_val_lo
00105Cr 2  85 rr              STA   ptr_lo
00105Er 2  A5 rr              LDA   eval_val_hi
001060r 2  85 rr              STA   ptr_hi
001062r 2  A0 00              LDY   #0
001064r 2  B1 rr              LDA   (ptr_lo),Y           ; length
001066r 2  AA                 TAX
001067r 2  F0 0A              BEQ   @nc_done
001069r 2  C8                 INY
00106Ar 2               @nc_ch:
00106Ar 2  B1 rr              LDA   (ptr_lo),Y
00106Cr 2  8D 0E A0           STA   VGC_CHAROUT
00106Fr 2  C8                 INY
001070r 2  CA                 DEX
001071r 2  D0 F7              BNE   @nc_ch
001073r 2               @nc_done:
001073r 2  20 rr rr           JSR   eval_newline
001076r 2  4C rr rr           JMP   eval_continue
