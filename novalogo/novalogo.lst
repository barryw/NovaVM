0030CDr 2  F0 09              BEQ   @po_param_done
0030CFr 2  B1 rr              LDA   (ptr_lo),Y
0030D1r 2  8D 0E A0           STA   VGC_CHAROUT
0030D4r 2  C8                 INY
0030D5r 2  CA                 DEX
0030D6r 2  80 F3              BRA   @po_pch
0030D8r 2               @po_param_done:
