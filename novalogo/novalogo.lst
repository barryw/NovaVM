0010C0r 2  85 rr              STA   for_end_hi
0010C2r 2               
0010C2r 2                     ; Current token should be ] closing the control list
0010C2r 2  A5 rr              LDA   eval_cur_lo
0010C4r 2  05 rr              ORA   eval_cur_hi
