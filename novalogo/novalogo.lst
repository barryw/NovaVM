0022CAr 2  86 rr              STX   list_ptr_lo
0022CCr 2  80 E1              BRA   @se_walk
0022CEr 2               
0022CEr 2               @se_found_last:
0022CEr 2                     ; Patch last cell's cdr to second list
0022CEr 2  A0 05              LDY   #CONS_CDR_LO
0022D0r 2  A5 rr              LDA   list_tail_lo
0022D2r 2  91 rr              STA   (ptr_lo),Y
0022D4r 2  A0 06              LDY   #CONS_CDR_HI
0022D6r 2  A5 rr              LDA   list_tail_hi
0022D8r 2  91 rr              STA   (ptr_lo),Y
0022DAr 2               
0022DAr 2                     ; Return first list head
0022DAr 2  A9 02              LDA   #VAL_LIST
0022DCr 2  85 rr              STA   eval_type
0022DEr 2  A5 rr              LDA   list_head_lo
0022E0r 2  85 rr              STA   eval_val_lo
0022E2r 2  A5 rr              LDA   list_head_hi
