001821r 2  A5 rr              LDA   eval_type
001823r 2  C9 00              CMP   #VAL_NUMBER
001825r 2  4C rr rr           JMP   predicate_result
001828r 2               @err:
001828r 2  38                 SEC
001829r 2  60                 RTS
00182Ar 2               
