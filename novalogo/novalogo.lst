00091Br 1                     .include "vars.s"
00091Br 2               ; vars.s — variable storage for NovaLogo (MAKE / :reference)
00091Br 2               ;
00091Br 2               ; Variables are stored as a linked list of heap entries.
00091Br 2               ; Entry layout:
00091Br 2               ;   +0: next_lo  (2 bytes — pointer to next entry, or $0000)
00091Br 2               ;   +1: next_hi
00091Br 2               ;   +2: name_len (1 byte)
00091Br 2               ;   +3: name chars (name_len bytes, uppercased)
00091Br 2               ;   +3+name_len: value_type (1 byte: $00=number, $01=word)
00091Br 2               ;   +4+name_len: val_hi  (or ptr_lo for word)
00091Br 2               ;   +5+name_len: val_lo  (or ptr_hi for word)
00091Br 2               ;   +6+name_len: val_frac (0 for word)
00091Br 2               ;   +7+name_len: pad     (0)
00091Br 2               ;
00091Br 2               ; Total entry size = 8 + name_len bytes.
00091Br 2               
00091Br 2               ; Entry field offsets (relative to entry base)
00091Br 2               VAR_NEXT_LO  = 0
00091Br 2               VAR_NEXT_HI  = 1
00091Br 2               VAR_NAME_LEN = 2
00091Br 2               VAR_NAME     = 3              ; first char of name
00091Br 2               
00091Br 2               ; =====================================================================
00091Br 2               ; ZEROPAGE segment — variable list head + scratch
00091Br 2               ; =====================================================================
00091Br 2                     .segment "ZEROPAGE"
000036r 2               
000036r 2  xx           var_head_lo:    .res 1        ; head of variable linked list
000037r 2  xx           var_head_hi:    .res 1
000038r 2  xx           var_entry_lo:   .res 1        ; current entry pointer (walk scratch)
000039r 2  xx           var_entry_hi:   .res 1
00003Ar 2  xx           var_name_lo:    .res 1        ; saved name pointer for set/get
00003Br 2  xx           var_name_hi:    .res 1
00003Cr 2               
00003Cr 2               ; =====================================================================
00003Cr 2               ; CODE segment — variable routines
00003Cr 2               ; =====================================================================
00003Cr 2                     .segment "CODE"
002567r 2               
002567r 2               ; ---------------------------------------------------------------------
002567r 2               ; var_init — initialize variable list to empty
002567r 2               ;   Called once at cold_start
002567r 2               ; ---------------------------------------------------------------------
002567r 2               var_init:
002567r 2  64 rr              STZ   var_head_lo
002569r 2  64 rr              STZ   var_head_hi
00256Br 2  60                 RTS
00256Cr 2               
00256Cr 2               ; ---------------------------------------------------------------------
00256Cr 2               ; var_set — store a value under a variable name
00256Cr 2               ;   Input: ptr_lo/hi → length-prefixed name string (in token node)
00256Cr 2               ;          eval_type, eval_val_hi/lo/frac = value to store
00256Cr 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, var_entry, var_name
00256Cr 2               ; ---------------------------------------------------------------------
00256Cr 2               var_set:
00256Cr 2                     ; Save name pointer — we need it after the walk
00256Cr 2  A5 rr              LDA   ptr_lo
00256Er 2  85 rr              STA   var_name_lo
002570r 2  A5 rr              LDA   ptr_hi
002572r 2  85 rr              STA   var_name_hi
002574r 2               
002574r 2                     ; Walk the list looking for an existing entry with this name
002574r 2  A5 rr              LDA   var_head_lo
002576r 2  85 rr              STA   var_entry_lo
002578r 2  A5 rr              LDA   var_head_hi
00257Ar 2  85 rr              STA   var_entry_hi
00257Cr 2               
00257Cr 2               @walk:
00257Cr 2                     ; End of list?
00257Cr 2  A5 rr              LDA   var_entry_lo
00257Er 2  05 rr              ORA   var_entry_hi
002580r 2  F0 44              BEQ   @not_found
002582r 2               
002582r 2                     ; Compare name in entry against var_name
002582r 2  20 rr rr           JSR   var_names_equal
002585r 2  B0 16              BCS   @found
002587r 2               
002587r 2                     ; Advance to next entry
002587r 2  A5 rr              LDA   var_entry_lo
002589r 2  85 rr              STA   ptr2_lo
00258Br 2  A5 rr              LDA   var_entry_hi
00258Dr 2  85 rr              STA   ptr2_hi
00258Fr 2  A0 00              LDY   #VAR_NEXT_LO
002591r 2  B1 rr              LDA   (ptr2_lo),Y
002593r 2  AA                 TAX
002594r 2  C8                 INY
002595r 2  B1 rr              LDA   (ptr2_lo),Y
002597r 2  85 rr              STA   var_entry_hi
002599r 2  86 rr              STX   var_entry_lo
00259Br 2  80 DF              BRA   @walk
00259Dr 2               
00259Dr 2               @found:
00259Dr 2                     ; Overwrite value in place
00259Dr 2                     ; Value starts at entry + 3 + name_len
00259Dr 2  A5 rr              LDA   var_entry_lo
00259Fr 2  85 rr              STA   ptr2_lo
0025A1r 2  A5 rr              LDA   var_entry_hi
0025A3r 2  85 rr              STA   ptr2_hi
0025A5r 2  A0 02              LDY   #VAR_NAME_LEN
0025A7r 2  B1 rr              LDA   (ptr2_lo),Y          ; name_len
0025A9r 2  18                 CLC
0025AAr 2  69 03              ADC   #VAR_NAME             ; A = 3 + name_len = offset to value_type
0025ACr 2  A8                 TAY
0025ADr 2  A5 rr              LDA   eval_type
0025AFr 2  91 rr              STA   (ptr2_lo),Y
0025B1r 2  C8                 INY
0025B2r 2  A5 rr              LDA   eval_val_hi
0025B4r 2  91 rr              STA   (ptr2_lo),Y
0025B6r 2  C8                 INY
0025B7r 2  A5 rr              LDA   eval_val_lo
0025B9r 2  91 rr              STA   (ptr2_lo),Y
0025BBr 2  C8                 INY
0025BCr 2  A5 rr              LDA   eval_val_frac
0025BEr 2  91 rr              STA   (ptr2_lo),Y
0025C0r 2  C8                 INY
0025C1r 2  A9 00              LDA   #0
0025C3r 2  91 rr              STA   (ptr2_lo),Y          ; pad
0025C5r 2  60                 RTS
0025C6r 2               
0025C6r 2               @not_found:
0025C6r 2                     ; Allocate a new entry: 8 + name_len bytes
0025C6r 2                     ; Read name_len from the name string
0025C6r 2  A5 rr              LDA   var_name_lo
0025C8r 2  85 rr              STA   ptr_lo
0025CAr 2  A5 rr              LDA   var_name_hi
0025CCr 2  85 rr              STA   ptr_hi
0025CEr 2  A0 00              LDY   #0
0025D0r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
0025D2r 2  48                 PHA                         ; save name_len
0025D3r 2  18                 CLC
0025D4r 2  69 08              ADC   #8                    ; total entry size
0025D6r 2  A2 03              LDX   #ATYPE_VAR
0025D8r 2  20 rr rr           JSR   heap_alloc
0025DBr 2  B0 62              BCS   @oom
0025DDr 2               
0025DDr 2                     ; ptr_lo/hi now points to new entry
0025DDr 2                     ; Set next → current head
0025DDr 2  A0 00              LDY   #VAR_NEXT_LO
0025DFr 2  A5 rr              LDA   var_head_lo
0025E1r 2  91 rr              STA   (ptr_lo),Y
0025E3r 2  C8                 INY
0025E4r 2  A5 rr              LDA   var_head_hi
0025E6r 2  91 rr              STA   (ptr_lo),Y
0025E8r 2               
0025E8r 2                     ; Copy name_len
0025E8r 2  68                 PLA                         ; A = name_len
0025E9r 2  48                 PHA                         ; keep it on stack
0025EAr 2  A0 02              LDY   #VAR_NAME_LEN
0025ECr 2  91 rr              STA   (ptr_lo),Y
0025EEr 2               
0025EEr 2                     ; Copy name chars (uppercased) from var_name source
0025EEr 2  68                 PLA                         ; A = name_len
0025EFr 2  AA                 TAX                         ; X = remaining chars
0025F0r 2  F0 2C              BEQ   @name_done            ; zero-length name (shouldn't happen)
0025F2r 2  A0 03              LDY   #VAR_NAME             ; dest offset in entry
0025F4r 2  9C rr rr           STZ   num_tmp_lo            ; source offset counter
0025F7r 2               
0025F7r 2               @copy_name:
0025F7r 2  DA                 PHX
0025F8r 2  5A                 PHY
0025F9r 2                     ; Read source char
0025F9r 2  A5 rr              LDA   var_name_lo
0025FBr 2  85 rr              STA   ptr2_lo
0025FDr 2  A5 rr              LDA   var_name_hi
0025FFr 2  85 rr              STA   ptr2_hi
002601r 2  AD rr rr           LDA   num_tmp_lo
002604r 2  1A                 INC                         ; skip length byte → offset = idx + 1
002605r 2  A8                 TAY
002606r 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
002608r 2                     ; Uppercase
002608r 2  C9 61              CMP   #'a'
00260Ar 2  90 07              BCC   @noup
00260Cr 2  C9 7B              CMP   #'z'+1
00260Er 2  B0 03              BCS   @noup
002610r 2  38                 SEC
002611r 2  E9 20              SBC   #$20
002613r 2               @noup:
002613r 2  7A                 PLY                         ; restore dest offset
002614r 2  91 rr              STA   (ptr_lo),Y           ; write to entry
002616r 2  C8                 INY
002617r 2  EE rr rr           INC   num_tmp_lo
00261Ar 2  FA                 PLX
00261Br 2  CA                 DEX
00261Cr 2  D0 D9              BNE   @copy_name
00261Er 2               
00261Er 2               @name_done:
00261Er 2                     ; Write value after name
00261Er 2                     ; Y is already at VAR_NAME + name_len = value_type offset
00261Er 2  A5 rr              LDA   eval_type
002620r 2  91 rr              STA   (ptr_lo),Y
002622r 2  C8                 INY
002623r 2  A5 rr              LDA   eval_val_hi
002625r 2  91 rr              STA   (ptr_lo),Y
002627r 2  C8                 INY
002628r 2  A5 rr              LDA   eval_val_lo
00262Ar 2  91 rr              STA   (ptr_lo),Y
00262Cr 2  C8                 INY
00262Dr 2  A5 rr              LDA   eval_val_frac
00262Fr 2  91 rr              STA   (ptr_lo),Y
002631r 2  C8                 INY
002632r 2  A9 00              LDA   #0
002634r 2  91 rr              STA   (ptr_lo),Y           ; pad
002636r 2               
002636r 2                     ; Prepend to list: head = new entry
002636r 2  A5 rr              LDA   ptr_lo
002638r 2  85 rr              STA   var_head_lo
00263Ar 2  A5 rr              LDA   ptr_hi
00263Cr 2  85 rr              STA   var_head_hi
00263Er 2  60                 RTS
00263Fr 2               
00263Fr 2               @oom:
00263Fr 2  68                 PLA                         ; discard saved name_len
002640r 2  60                 RTS
002641r 2               
002641r 2               ; ---------------------------------------------------------------------
002641r 2               ; var_get — look up a variable by name
002641r 2               ;   Input: ptr_lo/hi → length-prefixed name string
002641r 2               ;   Output: Carry clear = found, eval_type/eval_val set
002641r 2               ;           Carry set = not found
002641r 2               ;   Clobbers: A, X, Y, ptr2, var_entry, var_name
002641r 2               ; ---------------------------------------------------------------------
002641r 2               var_get:
002641r 2                     ; Save name pointer
002641r 2  A5 rr              LDA   ptr_lo
002643r 2  85 rr              STA   var_name_lo
002645r 2  A5 rr              LDA   ptr_hi
002647r 2  85 rr              STA   var_name_hi
002649r 2               
002649r 2                     ; Walk the list
002649r 2  A5 rr              LDA   var_head_lo
00264Br 2  85 rr              STA   var_entry_lo
00264Dr 2  A5 rr              LDA   var_head_hi
00264Fr 2  85 rr              STA   var_entry_hi
002651r 2               
002651r 2               @walk:
002651r 2  A5 rr              LDA   var_entry_lo
002653r 2  05 rr              ORA   var_entry_hi
002655r 2  F0 40              BEQ   @not_found
002657r 2               
002657r 2  20 rr rr           JSR   var_names_equal
00265Ar 2  B0 16              BCS   @found
00265Cr 2               
00265Cr 2                     ; Advance to next
00265Cr 2  A5 rr              LDA   var_entry_lo
00265Er 2  85 rr              STA   ptr2_lo
002660r 2  A5 rr              LDA   var_entry_hi
002662r 2  85 rr              STA   ptr2_hi
002664r 2  A0 00              LDY   #VAR_NEXT_LO
002666r 2  B1 rr              LDA   (ptr2_lo),Y
002668r 2  AA                 TAX
002669r 2  C8                 INY
00266Ar 2  B1 rr              LDA   (ptr2_lo),Y
00266Cr 2  85 rr              STA   var_entry_hi
00266Er 2  86 rr              STX   var_entry_lo
002670r 2  80 DF              BRA   @walk
002672r 2               
002672r 2               @found:
002672r 2                     ; Read value from entry + 3 + name_len
002672r 2  A5 rr              LDA   var_entry_lo
002674r 2  85 rr              STA   ptr2_lo
002676r 2  A5 rr              LDA   var_entry_hi
002678r 2  85 rr              STA   ptr2_hi
00267Ar 2  A0 02              LDY   #VAR_NAME_LEN
00267Cr 2  B1 rr              LDA   (ptr2_lo),Y
00267Er 2  18                 CLC
00267Fr 2  69 03              ADC   #VAR_NAME
002681r 2  A8                 TAY
002682r 2  B1 rr              LDA   (ptr2_lo),Y          ; value_type
002684r 2  85 rr              STA   eval_type
002686r 2  C8                 INY
002687r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_hi
002689r 2  85 rr              STA   eval_val_hi
00268Br 2  C8                 INY
00268Cr 2  B1 rr              LDA   (ptr2_lo),Y          ; val_lo
00268Er 2  85 rr              STA   eval_val_lo
002690r 2  C8                 INY
002691r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_frac
002693r 2  85 rr              STA   eval_val_frac
002695r 2  18                 CLC
002696r 2  60                 RTS
002697r 2               
002697r 2               @not_found:
002697r 2  38                 SEC
002698r 2  60                 RTS
002699r 2               
002699r 2               ; ---------------------------------------------------------------------
002699r 2               ; var_names_equal — compare name at var_name_lo/hi against entry at var_entry
002699r 2               ;   The name source is length-prefixed (from token / quote).
002699r 2               ;   The entry stores: name_len at +2, chars at +3 (already uppercased).
002699r 2               ;   The source name chars are uppercased during comparison.
002699r 2               ;   Returns: Carry set = equal, Carry clear = not equal
002699r 2               ;   Clobbers: A, X, Y, ptr2
002699r 2               ; ---------------------------------------------------------------------
002699r 2               var_names_equal:
002699r 2                     ; Read source name length
002699r 2  A5 rr              LDA   var_name_lo
00269Br 2  85 rr              STA   ptr2_lo
00269Dr 2  A5 rr              LDA   var_name_hi
00269Fr 2  85 rr              STA   ptr2_hi
0026A1r 2  A0 00              LDY   #0
0026A3r 2  B1 rr              LDA   (ptr2_lo),Y          ; source name_len
0026A5r 2  AA                 TAX                         ; X = source name_len
0026A6r 2               
0026A6r 2                     ; Read entry name length
0026A6r 2  A5 rr              LDA   var_entry_lo
0026A8r 2  85 rr              STA   ptr2_lo
0026AAr 2  A5 rr              LDA   var_entry_hi
0026ACr 2  85 rr              STA   ptr2_hi
0026AEr 2  A0 02              LDY   #VAR_NAME_LEN
0026B0r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry name_len
0026B2r 2               
0026B2r 2                     ; Compare lengths
0026B2r 2  8E rr rr           STX   num_tmp_lo            ; save source length
0026B5r 2  CD rr rr           CMP   num_tmp_lo
0026B8r 2  D0 43              BNE   @ne
0026BAr 2               
0026BAr 2                     ; Lengths match — compare chars
0026BAr 2  E0 00              CPX   #0
0026BCr 2  F0 3B              BEQ   @eq                   ; both zero-length — equal
0026BEr 2  A0 00              LDY   #0                    ; char index
0026C0r 2               
0026C0r 2               @cmp_loop:
0026C0r 2  DA                 PHX
0026C1r 2  5A                 PHY
0026C2r 2                     ; Read source char (var_name + 1 + Y)
0026C2r 2  A5 rr              LDA   var_name_lo
0026C4r 2  85 rr              STA   ptr2_lo
0026C6r 2  A5 rr              LDA   var_name_hi
0026C8r 2  85 rr              STA   ptr2_hi
0026CAr 2  98                 TYA
0026CBr 2  1A                 INC                         ; skip length byte
0026CCr 2  A8                 TAY
0026CDr 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
0026CFr 2                     ; Uppercase it
0026CFr 2  C9 61              CMP   #'a'
0026D1r 2  90 07              BCC   @noup
0026D3r 2  C9 7B              CMP   #'z'+1
0026D5r 2  B0 03              BCS   @noup
0026D7r 2  38                 SEC
0026D8r 2  E9 20              SBC   #$20
0026DAr 2               @noup:
0026DAr 2  8D rr rr           STA   num_tmp_hi            ; temp: uppercased source char
0026DDr 2               
0026DDr 2                     ; Read entry char (var_entry + VAR_NAME + Y)
0026DDr 2  7A                 PLY                         ; restore char index
0026DEr 2  5A                 PHY
0026DFr 2  A5 rr              LDA   var_entry_lo
0026E1r 2  85 rr              STA   ptr2_lo
0026E3r 2  A5 rr              LDA   var_entry_hi
0026E5r 2  85 rr              STA   ptr2_hi
0026E7r 2  98                 TYA
0026E8r 2  18                 CLC
0026E9r 2  69 03              ADC   #VAR_NAME
0026EBr 2  A8                 TAY
0026ECr 2  B1 rr              LDA   (ptr2_lo),Y          ; entry char (already uppercase)
0026EEr 2               
0026EEr 2  CD rr rr           CMP   num_tmp_hi
0026F1r 2                     ; 65C02: PLY/PLX clobber flags! Must branch BEFORE pulling.
0026F1r 2  D0 08              BNE   @ne_pull
0026F3r 2               
0026F3r 2  7A                 PLY
0026F4r 2  FA                 PLX
0026F5r 2  C8                 INY
0026F6r 2  CA                 DEX
0026F7r 2  D0 C7              BNE   @cmp_loop
0026F9r 2               
0026F9r 2               @eq:
0026F9r 2  38                 SEC                         ; equal
0026FAr 2  60                 RTS
0026FBr 2               
0026FBr 2               @ne_pull:
0026FBr 2  7A                 PLY                         ; clean up stack
0026FCr 2  FA                 PLX
0026FDr 2               @ne:
0026FDr 2  18                 CLC                         ; not equal
0026FEr 2  60                 RTS
0026FFr 2               
0026FFr 1                     .include "procedures.s"
0026FFr 2               ; procedures.s — user-defined procedure storage and invocation
0026FFr 2               ;
0026FFr 2               ; Procedure record layout (heap-allocated linked list):
0026FFr 2               ;   +0: next_lo
0026FFr 2               ;   +1: next_hi    (pointer to next procedure, or $0000)
0026FFr 2               ;   +2: name_len   (1 byte)
0026FFr 2               ;   +3..3+NL-1: name chars (uppercased)
0026FFr 2               ;   +3+NL: param_count (1 byte)
0026FFr 2               ;   For each param:
0026FFr 2               ;     1 byte: param_name_len
0026FFr 2               ;     N bytes: param_name chars (uppercased)
0026FFr 2               ;   After all params:
0026FFr 2               ;     2 bytes: body_len_lo, body_len_hi (16-bit)
0026FFr 2               ;     body_len bytes: body text (lines separated by $0A)
0026FFr 2               
0026FFr 2               ; =====================================================================
0026FFr 2               ; ZEROPAGE segment — procedure variables
0026FFr 2               ; =====================================================================
0026FFr 2                     .segment "ZEROPAGE"
00003Cr 2               
00003Cr 2  xx           proc_head_lo:     .res 1        ; head of procedure directory
00003Dr 2  xx           proc_head_hi:     .res 1
00003Er 2  xx           proc_entry_lo:    .res 1        ; current entry pointer (walk scratch)
00003Fr 2  xx           proc_entry_hi:    .res 1
000040r 2  xx           proc_ptr_lo:      .res 1        ; scratch pointer for proc operations
000041r 2  xx           proc_ptr_hi:      .res 1
000042r 2  xx           proc_body_len_lo: .res 1        ; body length during collection / invocation
000043r 2  xx           proc_body_len_hi: .res 1
000044r 2  xx           proc_param_cnt:   .res 1        ; param count during define / invoke
000045r 2  xx           proc_name_len:    .res 1        ; name length scratch
000046r 2  xx           proc_rec_off:     .res 1        ; offset into record during invoke
000047r 2               
000047r 2               ; =====================================================================
000047r 2               ; BSS segment — temporary buffers
000047r 2               ; =====================================================================
000047r 2                     .segment "BSS"
00000Fr 2               
00000Fr 2  xx xx xx xx  proc_body_buf:    .res 2048     ; editor text buffer: "TO ..\n<body>\nEND\n"
000013r 2  xx xx xx xx  
000017r 2  xx xx xx xx  
00080Fr 2  xx xx xx xx  proc_name_buf:    .res 32       ; procedure name: length-prefixed
000813r 2  xx xx xx xx  
000817r 2  xx xx xx xx  
00082Fr 2  xx xx xx xx  proc_param_buf:   .res 128      ; packed: count, [len,chars]... each param
000833r 2  xx xx xx xx  
000837r 2  xx xx xx xx  
0008AFr 2  xx           proc_param_end:   .res 1        ; write offset into proc_param_buf
0008B0r 2  xx xx xx xx  proc_editor_title:.res 36       ; "TO <name>" + NUL, passed to the shared editor
0008B4r 2  xx xx xx xx  
0008B8r 2  xx xx xx xx  
0008D4r 2  xx           proc_body_src_lo: .res 1        ; pointer to the body text proc_build_record copies
0008D5r 2  xx           proc_body_src_hi: .res 1
0008D6r 2  xx           proc_edit_cur_lo: .res 1        ; initial editor cursor offset (start of body line)
0008D7r 2  xx           proc_edit_cur_hi: .res 1
0008D8r 2  xx           proc_scan_off_lo: .res 1        ; 16-bit scan offset for body extraction
0008D9r 2  xx           proc_scan_off_hi: .res 1
0008DAr 2  xx           proc_brk_depth:   .res 1        ; bracket/paren nesting depth while accumulating a statement
0008DBr 2  xx           proc_tmp:         .res 1        ; scratch byte (EDIT record→buffer copy)
0008DCr 2               
0008DCr 2               ; Save area for eval state during procedure invocation
0008DCr 2  xx           save_eval_cur_lo: .res 1
0008DDr 2  xx           save_eval_cur_hi: .res 1
0008DEr 2  xx           save_tok_head_lo: .res 1
0008DFr 2  xx           save_tok_head_hi: .res 1
0008E0r 2  xx           save_tok_tail_lo: .res 1
0008E1r 2  xx           save_tok_tail_hi: .res 1
0008E2r 2  xx xx xx xx  save_input_buf:   .res 128      ; save outer input_buf during proc body exec
0008E6r 2  xx xx xx xx  
0008EAr 2  xx xx xx xx  
000962r 2  xx           save_heap_ptr_lo: .res 1        ; save heap for token re-use
000963r 2  xx           save_heap_ptr_hi: .res 1
000964r 2               
000964r 2               ; Param-binding scratch: length-prefixed name built here for var_set
000964r 2  xx xx xx xx  param_name_tmp:   .res 32
000968r 2  xx xx xx xx  
00096Cr 2  xx xx xx xx  
000984r 2               
000984r 2               ; =====================================================================
000984r 2               ; CODE segment — procedure routines
000984r 2               ; =====================================================================
000984r 2                     .segment "CODE"
0026FFr 2               
0026FFr 2               ; ---------------------------------------------------------------------
0026FFr 2               ; proc_init — initialize procedure directory to empty
0026FFr 2               ; ---------------------------------------------------------------------
0026FFr 2               proc_init:
0026FFr 2  64 rr              STZ   proc_head_lo
002701r 2  64 rr              STZ   proc_head_hi
002703r 2  64 rr              STZ   proc_stopped
002705r 2  60                 RTS
002706r 2               
002706r 2               ; ---------------------------------------------------------------------
002706r 2               ; proc_collect — enter TO/END multi-line collection mode
002706r 2               ;   Called from main_loop after detecting TO as first token.
002706r 2               ;   eval_cur_lo/hi has been advanced past the TO token.
002706r 2               ; ---------------------------------------------------------------------
002706r 2               proc_collect:
002706r 2                     ; Next token should be the procedure name (TOK_WORD)
002706r 2  A5 rr              LDA   eval_cur_lo
002708r 2  05 rr              ORA   eval_cur_hi
00270Ar 2  D0 03              BNE   @have_name
00270Cr 2  4C rr rr           JMP   @err_noname
00270Fr 2               @have_name:
00270Fr 2  A5 rr              LDA   eval_cur_lo
002711r 2  85 rr              STA   ptr_lo
002713r 2  A5 rr              LDA   eval_cur_hi
002715r 2  85 rr              STA   ptr_hi
002717r 2  A0 00              LDY   #TOK_TAG
002719r 2  B1 rr              LDA   (ptr_lo),Y
00271Br 2  C9 01              CMP   #TOK_WORD
00271Dr 2  F0 03              BEQ   @name_ok
00271Fr 2  4C rr rr           JMP   @err_noname
002722r 2               @name_ok:
002722r 2                     ; Copy procedure name to proc_name_buf (length-prefixed)
002722r 2  A0 03              LDY   #TOK_PAYLOAD
002724r 2  B1 rr              LDA   (ptr_lo),Y           ; name length
002726r 2  8D rr rr           STA   proc_name_buf
002729r 2  85 rr              STA   proc_name_len
00272Br 2  AA                 TAX                         ; X = char count
00272Cr 2  A0 04              LDY   #TOK_PAYLOAD+1
00272Er 2  A9 00              LDA   #0
002730r 2  85 rr              STA   proc_rec_off          ; dest index in name_buf
002732r 2               @copy_name:
002732r 2  E0 00              CPX   #0
002734r 2  F0 0F              BEQ   @name_copied
002736r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased by tokenizer
002738r 2  5A                 PHY
002739r 2  A4 rr              LDY   proc_rec_off
00273Br 2  99 rr rr           STA   proc_name_buf+1,Y
00273Er 2  E6 rr              INC   proc_rec_off
002740r 2  7A                 PLY
002741r 2  C8                 INY
002742r 2  CA                 DEX
002743r 2  80 ED              BRA   @copy_name
002745r 2               @name_copied:
002745r 2               
002745r 2                     ; Advance past the name token
002745r 2  20 rr rr           JSR   eval_advance
002748r 2               
002748r 2                     ; Parse parameter names (TOK_VARREF tokens: :SIZE :COLOR etc.)
002748r 2  64 rr              STZ   proc_param_cnt
00274Ar 2  A9 01              LDA   #1                    ; dest offset (skip count byte at [0])
00274Cr 2  8D rr rr           STA   proc_param_end
00274Fr 2               
00274Fr 2               @parse_params:
00274Fr 2  A5 rr              LDA   eval_cur_lo
002751r 2  05 rr              ORA   eval_cur_hi
002753r 2  F0 47              BEQ   @params_done
002755r 2  A5 rr              LDA   eval_cur_lo
002757r 2  85 rr              STA   ptr_lo
002759r 2  A5 rr              LDA   eval_cur_hi
00275Br 2  85 rr              STA   ptr_hi
00275Dr 2  A0 00              LDY   #TOK_TAG
00275Fr 2  B1 rr              LDA   (ptr_lo),Y
002761r 2  C9 05              CMP   #TOK_VARREF
002763r 2  D0 37              BNE   @params_done
002765r 2               
002765r 2  E6 rr              INC   proc_param_cnt
002767r 2  A0 03              LDY   #TOK_PAYLOAD
002769r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
00276Br 2  AE rr rr           LDX   proc_param_end
00276Er 2  9D rr rr           STA   proc_param_buf,X     ; store length
002771r 2  E8                 INX
002772r 2  A8                 TAY                         ; Y = char count to copy
002773r 2  64 rr              STZ   proc_rec_off          ; source char index
002775r 2               
002775r 2               @copy_param_ch:
002775r 2  C0 00              CPY   #0
002777r 2  F0 1B              BEQ   @param_ch_done
002779r 2                     ; Read source char from token
002779r 2  A5 rr              LDA   eval_cur_lo
00277Br 2  85 rr              STA   ptr_lo
00277Dr 2  A5 rr              LDA   eval_cur_hi
00277Fr 2  85 rr              STA   ptr_hi
002781r 2  5A                 PHY
002782r 2  A5 rr              LDA   proc_rec_off
002784r 2  18                 CLC
002785r 2  69 04              ADC   #TOK_PAYLOAD+1
002787r 2  A8                 TAY
002788r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased
00278Ar 2  7A                 PLY
00278Br 2                     ; Write to proc_param_buf
00278Br 2  9D rr rr           STA   proc_param_buf,X
00278Er 2  E8                 INX
00278Fr 2  E6 rr              INC   proc_rec_off
002791r 2  88                 DEY
002792r 2  80 E1              BRA   @copy_param_ch
002794r 2               @param_ch_done:
002794r 2  8E rr rr           STX   proc_param_end
002797r 2               
002797r 2  20 rr rr           JSR   eval_advance
00279Ar 2  80 B3              BRA   @parse_params
00279Cr 2               
00279Cr 2               @params_done:
00279Cr 2  A5 rr              LDA   proc_param_cnt
00279Er 2  8D rr rr           STA   proc_param_buf        ; count byte at [0]
0027A1r 2               
0027A1r 2                     ; Initialize body buffer
0027A1r 2  64 rr              STZ   proc_body_len_lo
0027A3r 2  64 rr              STZ   proc_body_len_hi
0027A5r 2               
0027A5r 2                     ; Open the shared EDITUI editor on an empty body buffer. Carry set means
0027A5r 2                     ; the user asked to save (Ctrl-S / "Save First") before exiting.
0027A5r 2  20 rr rr           JSR   proc_open_editor
0027A8r 2  B0 01              BCS   @body_done
0027AAr 2  60                 RTS
0027ABr 2               
0027ABr 2                     ; Print "NAME DEFINED\n"
0027ABr 2               @body_done:
0027ABr 2  20 rr rr           JSR   proc_print_defined
0027AEr 2  60                 RTS
0027AFr 2               
0027AFr 2               @err_noname:
0027AFr 2  20 rr rr           JSR   print_inl
0027B2r 2  54 4F 20 4E        .byte "TO NEEDS A NAME", 0
0027B6r 2  45 45 44 53  
0027BAr 2  20 41 20 4E  
0027C2r 2  20 rr rr           JSR   eval_newline
0027C5r 2  60                 RTS
0027C6r 2               
0027C6r 2               ; ---------------------------------------------------------------------
0027C6r 2               ; proc_print_defined — print "<name> DEFINED\n" (name from proc_name_buf).
0027C6r 2               ; ---------------------------------------------------------------------
0027C6r 2               proc_print_defined:
0027C6r 2  A6 rr              LDX   proc_name_len
0027C8r 2  A0 00              LDY   #0
0027CAr 2               @pn:
0027CAr 2  E0 00              CPX   #0
0027CCr 2  F0 0A              BEQ   @pd
0027CEr 2  B9 rr rr           LDA   proc_name_buf+1,Y
0027D1r 2  8D 0E A0           STA   VGC_CHAROUT
0027D4r 2  C8                 INY
0027D5r 2  CA                 DEX
0027D6r 2  80 F2              BRA   @pn
0027D8r 2               @pd:
0027D8r 2  20 rr rr           JSR   print_inl
0027DBr 2  20 44 45 46        .byte " DEFINED", 0
0027DFr 2  49 4E 45 44  
0027E3r 2  00           
0027E4r 2  20 rr rr           JSR   eval_newline
0027E7r 2  60                 RTS
0027E8r 2               
0027E8r 2               ; ---------------------------------------------------------------------
0027E8r 2               ; proc_build_header — write the "TO <name> :params" first line into
0027E8r 2               ;   proc_body_buf (no trailing newline). Built with 8-bit Y since the header
0027E8r 2               ;   is always < 256 bytes (name<=31, params<=127). Returns Y = header length.
0027E8r 2               ;   Inputs: proc_name_buf/proc_name_len, proc_param_buf/proc_param_end.
0027E8r 2               ; ---------------------------------------------------------------------
0027E8r 2               proc_build_header:
0027E8r 2  A0 00              LDY   #0
0027EAr 2  A9 54              LDA   #'T'
0027ECr 2  99 rr rr           STA   proc_body_buf,Y
0027EFr 2  C8                 INY
0027F0r 2  A9 4F              LDA   #'O'
0027F2r 2  99 rr rr           STA   proc_body_buf,Y
0027F5r 2  C8                 INY
0027F6r 2  A9 20              LDA   #' '
0027F8r 2  99 rr rr           STA   proc_body_buf,Y
0027FBr 2  C8                 INY
0027FCr 2  A2 00              LDX   #0                     ; name source index
0027FEr 2               @nm:
0027FEr 2  E4 rr              CPX   proc_name_len
002800r 2  B0 0A              BCS   @nm_done
002802r 2  BD rr rr           LDA   proc_name_buf+1,X
002805r 2  99 rr rr           STA   proc_body_buf,Y
002808r 2  C8                 INY
002809r 2  E8                 INX
00280Ar 2  80 F2              BRA   @nm
00280Cr 2               @nm_done:
00280Cr 2                     ; params: " :" + chars, walking proc_param_buf[1..proc_param_end)
00280Cr 2  A2 01              LDX   #1
00280Er 2               @pp:
00280Er 2  EC rr rr           CPX   proc_param_end
002811r 2  B0 22              BCS   @pp_done
002813r 2  A9 20              LDA   #' '
002815r 2  99 rr rr           STA   proc_body_buf,Y
002818r 2  C8                 INY
002819r 2  A9 3A              LDA   #':'
00281Br 2  99 rr rr           STA   proc_body_buf,Y
00281Er 2  C8                 INY
00281Fr 2  BD rr rr           LDA   proc_param_buf,X       ; this param's char count
002822r 2  85 rr              STA   proc_rec_off
002824r 2  E8                 INX
002825r 2               @ppc:
002825r 2  A5 rr              LDA   proc_rec_off
002827r 2  F0 E5              BEQ   @pp
002829r 2  BD rr rr           LDA   proc_param_buf,X
00282Cr 2  99 rr rr           STA   proc_body_buf,Y
00282Fr 2  C8                 INY
002830r 2  E8                 INX
002831r 2  C6 rr              DEC   proc_rec_off
002833r 2  80 F0              BRA   @ppc
002835r 2               @pp_done:
002835r 2  60                 RTS
002836r 2               
002836r 2               proc_open_editor:
002836r 2                     ; build "TO <name> :params" header, then append an empty body "  ".
002836r 2  20 rr rr           JSR   proc_build_header
002839r 2                     ; Y = line-1 length. The body line is line 1's '\n' + 2 indent spaces,
002839r 2                     ; so the cursor lands at offset (line1 + 3).
002839r 2  98                 TYA
00283Ar 2  18                 CLC
00283Br 2  69 03              ADC   #3
00283Dr 2  8D rr rr           STA   proc_edit_cur_lo
002840r 2  A9 00              LDA   #0
002842r 2  69 00              ADC   #0
002844r 2  8D rr rr           STA   proc_edit_cur_hi
002847r 2                     ; append "\n  \nEND\n"
002847r 2  A9 0A              LDA   #$0A
002849r 2  99 rr rr           STA   proc_body_buf,Y
00284Cr 2  C8                 INY
00284Dr 2  A9 20              LDA   #' '
00284Fr 2  99 rr rr           STA   proc_body_buf,Y
002852r 2  C8                 INY
002853r 2  99 rr rr           STA   proc_body_buf,Y
002856r 2  C8                 INY
002857r 2  A9 0A              LDA   #$0A
002859r 2  99 rr rr           STA   proc_body_buf,Y
00285Cr 2  C8                 INY
00285Dr 2  A9 45              LDA   #'E'
00285Fr 2  99 rr rr           STA   proc_body_buf,Y
002862r 2  C8                 INY
002863r 2  A9 4E              LDA   #'N'
002865r 2  99 rr rr           STA   proc_body_buf,Y
002868r 2  C8                 INY
002869r 2  A9 44              LDA   #'D'
00286Br 2  99 rr rr           STA   proc_body_buf,Y
00286Er 2  C8                 INY
00286Fr 2  A9 0A              LDA   #$0A
002871r 2  99 rr rr           STA   proc_body_buf,Y
002874r 2  C8                 INY
002875r 2  84 rr              STY   proc_body_len_lo
002877r 2  64 rr              STZ   proc_body_len_hi
002879r 2               
002879r 2               ; ---------------------------------------------------------------------
002879r 2               ; proc_edit_run — shared tail: build the editor title, hand proc_body_buf
002879r 2               ;   (with proc_body_len + proc_edit_cur already set) to the EDITUI editor, and
002879r 2               ;   on save extract the body + (re)build the procedure record.
002879r 2               ;   Returns: carry set = saved, carry clear = abandoned.
002879r 2               ; ---------------------------------------------------------------------
002879r 2               proc_edit_run:
002879r 2                     ; --- title "TO <name>" + NUL for the editor's title band ---
002879r 2  A9 54              LDA   #'T'
00287Br 2  8D rr rr           STA   proc_editor_title+0
00287Er 2  A9 4F              LDA   #'O'
002880r 2  8D rr rr           STA   proc_editor_title+1
002883r 2  A9 20              LDA   #' '
002885r 2  8D rr rr           STA   proc_editor_title+2
002888r 2  A2 00              LDX   #0
00288Ar 2  A0 03              LDY   #3
00288Cr 2               @tt:
00288Cr 2  E4 rr              CPX   proc_name_len
00288Er 2  B0 0A              BCS   @tt_done
002890r 2  BD rr rr           LDA   proc_name_buf+1,X
002893r 2  99 rr rr           STA   proc_editor_title,Y
002896r 2  E8                 INX
002897r 2  C8                 INY
002898r 2  80 F2              BRA   @tt
00289Ar 2               @tt_done:
00289Ar 2  A9 00              LDA   #0
00289Cr 2  99 rr rr           STA   proc_editor_title,Y
00289Fr 2               
00289Fr 2                     ; --- mailbox: ARG0=buf ARG1=len ARG2=cap ARG3=title; cursor in FRAC bytes
00289Fr 2  A9 rr              LDA   #<proc_body_buf
0028A1r 2  85 84              STA   EXT_ARG0_LO
0028A3r 2  A9 rr              LDA   #>proc_body_buf
0028A5r 2  85 83              STA   EXT_ARG0_HI
0028A7r 2  A5 rr              LDA   proc_body_len_lo
0028A9r 2  85 88              STA   EXT_ARG1_LO
0028ABr 2  A5 rr              LDA   proc_body_len_hi
0028ADr 2  85 87              STA   EXT_ARG1_HI
0028AFr 2  A9 00              LDA   #<2048
0028B1r 2  85 8C              STA   EXT_ARG2_LO
0028B3r 2  A9 08              LDA   #>2048
0028B5r 2  85 8B              STA   EXT_ARG2_HI
0028B7r 2  A9 rr              LDA   #<proc_editor_title
0028B9r 2  85 A1              STA   EXT_ARG3_LO
0028BBr 2  A9 rr              LDA   #>proc_editor_title
0028BDr 2  85 A0              STA   EXT_ARG3_HI
0028BFr 2  AD rr rr           LDA   proc_edit_cur_lo
0028C2r 2  85 8D              STA   EXT_ARG2_FRAC          ; initial cursor offset (see ext_iface.inc)
0028C4r 2  AD rr rr           LDA   proc_edit_cur_hi
0028C7r 2  85 A2              STA   EXT_ARG3_FRAC
0028C9r 2               
0028C9r 2  A9 4B              LDA   #EXT_CMD_EDIT
0028CBr 2  85 80              STA   EXT_CMD
0028CDr 2  20 70 02           JSR   EXT_TRAMPOLINE         ; swap to ext ROM, run editor, swap back
0028D0r 2               
0028D0r 2                     ; editor returns the final buffer length in ARG1
0028D0r 2  A5 88              LDA   EXT_ARG1_LO
0028D2r 2  85 rr              STA   proc_body_len_lo
0028D4r 2  A5 87              LDA   EXT_ARG1_HI
0028D6r 2  85 rr              STA   proc_body_len_hi
0028D8r 2               
0028D8r 2  A5 8F              LDA   EXT_RESULT_HI
0028DAr 2  F0 08              BEQ   @abandoned
0028DCr 2                     ; Strip line 1 + the END line -> proc_body_src/proc_body_len = body only.
0028DCr 2  20 rr rr           JSR   proc_extract_body
0028DFr 2  20 rr rr           JSR   proc_build_record
0028E2r 2  38                 SEC
0028E3r 2  60                 RTS
0028E4r 2               @abandoned:
0028E4r 2  18                 CLC
0028E5r 2  60                 RTS
0028E6r 2               
0028E6r 2               ; ---------------------------------------------------------------------
0028E6r 2               ; proc_buf_put — append A to proc_body_buf at ptr2, advancing ptr2 and the
0028E6r 2               ;   16-bit proc_body_len counter. Preserves A; clobbers Y.
0028E6r 2               ; ---------------------------------------------------------------------
0028E6r 2               proc_buf_put:
0028E6r 2  A0 00              LDY   #0
0028E8r 2  91 rr              STA   (ptr2_lo),Y
0028EAr 2  E6 rr              INC   ptr2_lo
0028ECr 2  D0 02              BNE   :+
0028EEr 2  E6 rr              INC   ptr2_hi
0028F0r 2  E6 rr        :     INC   proc_body_len_lo
0028F2r 2  D0 02              BNE   :+
0028F4r 2  E6 rr              INC   proc_body_len_hi
0028F6r 2  60           :     RTS
0028F7r 2               
0028F7r 2               ; ---------------------------------------------------------------------
0028F7r 2               ; proc_record_to_buffers — unpack the procedure record at proc_entry into the
0028F7r 2               ;   collect buffers so it can be edited and rebuilt:
0028F7r 2               ;     proc_name_buf/proc_name_len, proc_param_buf/proc_param_cnt/proc_param_end,
0028F7r 2               ;     and proc_body_src/proc_body_len = the record's body text (ptr + length).
0028F7r 2               ;   The name+param region is < 256 bytes so 8-bit Y indexing is safe there.
0028F7r 2               ; ---------------------------------------------------------------------
0028F7r 2               proc_record_to_buffers:
0028F7r 2  A5 rr              LDA   proc_entry_lo
0028F9r 2  85 rr              STA   ptr_lo
0028FBr 2  A5 rr              LDA   proc_entry_hi
0028FDr 2  85 rr              STA   ptr_hi
0028FFr 2                     ; --- name (record +2 = len, +3.. = chars) ---
0028FFr 2  A0 02              LDY   #2
002901r 2  B1 rr              LDA   (ptr_lo),Y
002903r 2  8D rr rr           STA   proc_name_buf
002906r 2  85 rr              STA   proc_name_len
002908r 2  C8                 INY                         ; Y=3 -> first name char
002909r 2  A2 00              LDX   #0
00290Br 2               @rb_nm:
00290Br 2  E4 rr              CPX   proc_name_len
00290Dr 2  B0 09              BCS   @rb_nm_done
00290Fr 2  B1 rr              LDA   (ptr_lo),Y
002911r 2  9D rr rr           STA   proc_name_buf+1,X
002914r 2  C8                 INY
002915r 2  E8                 INX
002916r 2  80 F3              BRA   @rb_nm
002918r 2               @rb_nm_done:
002918r 2                     ; --- param_count then packed params ---
002918r 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
00291Ar 2  85 rr              STA   proc_param_cnt
00291Cr 2  8D rr rr           STA   proc_param_buf        ; [0] = count
00291Fr 2  8D rr rr           STA   proc_tmp              ; remaining params
002922r 2  C8                 INY                         ; Y -> first param len
002923r 2  A2 01              LDX   #1                    ; dest index into proc_param_buf
002925r 2               @rb_param:
002925r 2  AD rr rr           LDA   proc_tmp
002928r 2  F0 1B              BEQ   @rb_params_done
00292Ar 2  CE rr rr           DEC   proc_tmp
00292Dr 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
00292Fr 2  9D rr rr           STA   proc_param_buf,X
002932r 2  85 rr              STA   proc_rec_off          ; char counter
002934r 2  C8                 INY
002935r 2  E8                 INX
002936r 2               @rb_pchars:
002936r 2  A5 rr              LDA   proc_rec_off
002938r 2  F0 EB              BEQ   @rb_param
00293Ar 2  C6 rr              DEC   proc_rec_off
00293Cr 2  B1 rr              LDA   (ptr_lo),Y
00293Er 2  9D rr rr           STA   proc_param_buf,X
002941r 2  C8                 INY
002942r 2  E8                 INX
002943r 2  80 F1              BRA   @rb_pchars
002945r 2               @rb_params_done:
002945r 2  8E rr rr           STX   proc_param_end
002948r 2                     ; Y -> body_len_lo within the record. Compute absolute pointer.
002948r 2  98                 TYA
002949r 2  18                 CLC
00294Ar 2  65 rr              ADC   proc_entry_lo
00294Cr 2  85 rr              STA   ptr_lo
00294Er 2  A5 rr              LDA   proc_entry_hi
002950r 2  69 00              ADC   #0
002952r 2  85 rr              STA   ptr_hi               ; ptr -> body_len_lo
002954r 2  A0 00              LDY   #0
002956r 2  B1 rr              LDA   (ptr_lo),Y
002958r 2  85 rr              STA   proc_body_len_lo     ; record body length
00295Ar 2  C8                 INY
00295Br 2  B1 rr              LDA   (ptr_lo),Y
00295Dr 2  85 rr              STA   proc_body_len_hi
00295Fr 2  18                 CLC                         ; body src = ptr + 2
002960r 2  A5 rr              LDA   ptr_lo
002962r 2  69 02              ADC   #2
002964r 2  8D rr rr           STA   proc_body_src_lo
002967r 2  A5 rr              LDA   ptr_hi
002969r 2  69 00              ADC   #0
00296Br 2  8D rr rr           STA   proc_body_src_hi
00296Er 2  60                 RTS
00296Fr 2               
00296Fr 2               ; ---------------------------------------------------------------------
00296Fr 2               ; proc_edit_reconstruct — build the full editable text "TO <name> :params\n
00296Fr 2               ;   <body>END\n" into proc_body_buf from the collect buffers + the record body
00296Fr 2               ;   (proc_body_src/proc_body_len set by proc_record_to_buffers). Sets
00296Fr 2               ;   proc_body_len = total buffer length and proc_edit_cur = start of the body.
00296Fr 2               ; ---------------------------------------------------------------------
00296Fr 2               proc_edit_reconstruct:
00296Fr 2                     ; Save the record body src/len before proc_body_len is repurposed.
00296Fr 2  AD rr rr           LDA   proc_body_src_lo
002972r 2  85 rr              STA   proc_ptr_lo
002974r 2  AD rr rr           LDA   proc_body_src_hi
002977r 2  85 rr              STA   proc_ptr_hi
002979r 2  A5 rr              LDA   proc_body_len_lo
00297Br 2  8D rr rr           STA   num_tmp_lo
00297Er 2  A5 rr              LDA   proc_body_len_hi
002980r 2  8D rr rr           STA   num_tmp_hi
002983r 2                     ; Header "TO name params" (8-bit), then a newline.
002983r 2  20 rr rr           JSR   proc_build_header     ; Y = header length
002986r 2  A9 0A              LDA   #$0A
002988r 2  99 rr rr           STA   proc_body_buf,Y
00298Br 2  C8                 INY                         ; Y = body-line start offset
00298Cr 2  8C rr rr           STY   proc_edit_cur_lo
00298Fr 2  9C rr rr           STZ   proc_edit_cur_hi
002992r 2  84 rr              STY   proc_body_len_lo
002994r 2  64 rr              STZ   proc_body_len_hi
002996r 2                     ; dest pointer ptr2 = proc_body_buf + Y
002996r 2  98                 TYA
002997r 2  18                 CLC
002998r 2  69 rr              ADC   #<proc_body_buf
00299Ar 2  85 rr              STA   ptr2_lo
00299Cr 2  A9 rr              LDA   #>proc_body_buf
00299Er 2  69 00              ADC   #0
0029A0r 2  85 rr              STA   ptr2_hi
0029A2r 2                     ; copy the record body (num_tmp bytes from proc_ptr)
0029A2r 2               @rc_body:
0029A2r 2  AD rr rr           LDA   num_tmp_lo
0029A5r 2  0D rr rr           ORA   num_tmp_hi
0029A8r 2  F0 1A              BEQ   @rc_body_done
0029AAr 2  A0 00              LDY   #0
0029ACr 2  B1 rr              LDA   (proc_ptr_lo),Y
0029AEr 2  20 rr rr           JSR   proc_buf_put
0029B1r 2  E6 rr              INC   proc_ptr_lo
0029B3r 2  D0 02              BNE   :+
0029B5r 2  E6 rr              INC   proc_ptr_hi
0029B7r 2  AD rr rr     :     LDA   num_tmp_lo
0029BAr 2  D0 03              BNE   @rc_dec
0029BCr 2  CE rr rr           DEC   num_tmp_hi
0029BFr 2               @rc_dec:
0029BFr 2  CE rr rr           DEC   num_tmp_lo
0029C2r 2  80 DE              BRA   @rc_body
0029C4r 2               @rc_body_done:
0029C4r 2                     ; append "END" + newline
0029C4r 2  A9 45              LDA   #'E'
0029C6r 2  20 rr rr           JSR   proc_buf_put
0029C9r 2  A9 4E              LDA   #'N'
0029CBr 2  20 rr rr           JSR   proc_buf_put
0029CEr 2  A9 44              LDA   #'D'
0029D0r 2  20 rr rr           JSR   proc_buf_put
0029D3r 2  A9 0A              LDA   #$0A
0029D5r 2  20 rr rr           JSR   proc_buf_put
0029D8r 2  60                 RTS
0029D9r 2               
0029D9r 2               ; ---------------------------------------------------------------------
0029D9r 2               ; proc_edit — handle "EDIT <name>" / "ED <name>". eval_cur is at the name
0029D9r 2               ;   token. If the procedure exists, reopen it in the editor pre-filled with its
0029D9r 2               ;   current definition; otherwise fall back to the TO collector (create it).
0029D9r 2               ; ---------------------------------------------------------------------
0029D9r 2               proc_edit:
0029D9r 2  A5 rr              LDA   eval_cur_lo
0029DBr 2  05 rr              ORA   eval_cur_hi
0029DDr 2  F0 14              BEQ   @to_collect
0029DFr 2  20 rr rr           JSR   proc_lookup
0029E2r 2  B0 0F              BCS   @to_collect          ; unknown -> create via the TO collector
0029E4r 2  20 rr rr           JSR   proc_record_to_buffers
0029E7r 2  20 rr rr           JSR   proc_edit_reconstruct
0029EAr 2  20 rr rr           JSR   proc_edit_run
0029EDr 2  90 03              BCC   @done                ; abandoned
0029EFr 2  20 rr rr           JSR   proc_print_defined
0029F2r 2               @done:
0029F2r 2  60                 RTS
0029F3r 2               @to_collect:
0029F3r 2  4C rr rr           JMP   proc_collect
0029F6r 2               
0029F6r 2               ; ---------------------------------------------------------------------
0029F6r 2               ; proc_extract_body — narrow proc_body_buf/proc_body_len down to just the body:
0029F6r 2               ;   everything after the first '\n' (line 1) up to (not including) the line that
0029F6r 2               ;   reads "END". Sets proc_body_src_lo/hi + proc_body_len_lo/hi.
0029F6r 2               ; ---------------------------------------------------------------------
0029F6r 2               proc_extract_body:
0029F6r 2  A9 rr              LDA   #<proc_body_buf
0029F8r 2  85 rr              STA   proc_ptr_lo
0029FAr 2  A9 rr              LDA   #>proc_body_buf
0029FCr 2  85 rr              STA   proc_ptr_hi
0029FEr 2  9C rr rr           STZ   proc_scan_off_lo
002A01r 2  9C rr rr           STZ   proc_scan_off_hi
002A04r 2               @find_nl:
002A04r 2  20 rr rr           JSR   proc_scan_at_end
002A07r 2  B0 4F              BCS   @whole                ; no newline -> whole buffer is the body
002A09r 2  A0 00              LDY   #0
002A0Br 2  B1 rr              LDA   (proc_ptr_lo),Y
002A0Dr 2  20 rr rr           JSR   proc_scan_advance
002A10r 2  C9 0A              CMP   #$0A
002A12r 2  D0 F0              BNE   @find_nl
002A14r 2                     ; body starts here
002A14r 2  A5 rr              LDA   proc_ptr_lo
002A16r 2  8D rr rr           STA   proc_body_src_lo
002A19r 2  A5 rr              LDA   proc_ptr_hi
002A1Br 2  8D rr rr           STA   proc_body_src_hi
002A1Er 2  AD rr rr           LDA   proc_scan_off_lo
002A21r 2  8D rr rr           STA   num_tmp_lo            ; body-start offset
002A24r 2  AD rr rr           LDA   proc_scan_off_hi
002A27r 2  8D rr rr           STA   num_tmp_hi
002A2Ar 2               @line:
002A2Ar 2  20 rr rr           JSR   proc_scan_at_end
002A2Dr 2  B0 17              BCS   @body_end             ; ran off the end -> body = rest
002A2Fr 2  20 rr rr           JSR   proc_line_is_end
002A32r 2  B0 12              BCS   @body_end             ; this line is "END" -> stop
002A34r 2               @skip:
002A34r 2  20 rr rr           JSR   proc_scan_at_end
002A37r 2  B0 0D              BCS   @body_end
002A39r 2  A0 00              LDY   #0
002A3Br 2  B1 rr              LDA   (proc_ptr_lo),Y
002A3Dr 2  20 rr rr           JSR   proc_scan_advance
002A40r 2  C9 0A              CMP   #$0A
002A42r 2  D0 F0              BNE   @skip
002A44r 2  80 E4              BRA   @line
002A46r 2               @body_end:
002A46r 2  38                 SEC
002A47r 2  AD rr rr           LDA   proc_scan_off_lo
002A4Ar 2  ED rr rr           SBC   num_tmp_lo
002A4Dr 2  85 rr              STA   proc_body_len_lo
002A4Fr 2  AD rr rr           LDA   proc_scan_off_hi
002A52r 2  ED rr rr           SBC   num_tmp_hi
002A55r 2  85 rr              STA   proc_body_len_hi
002A57r 2  60                 RTS
002A58r 2               @whole:
002A58r 2  A9 rr              LDA   #<proc_body_buf
002A5Ar 2  8D rr rr           STA   proc_body_src_lo
002A5Dr 2  A9 rr              LDA   #>proc_body_buf
002A5Fr 2  8D rr rr           STA   proc_body_src_hi
002A62r 2  60                 RTS
002A63r 2               
002A63r 2               ; carry set if proc_scan_off >= proc_body_len
002A63r 2               proc_scan_at_end:
002A63r 2  AD rr rr           LDA   proc_scan_off_lo
002A66r 2  C5 rr              CMP   proc_body_len_lo
002A68r 2  AD rr rr           LDA   proc_scan_off_hi
002A6Br 2  E5 rr              SBC   proc_body_len_hi
002A6Dr 2  60                 RTS
002A6Er 2               
002A6Er 2               ; advance the scan pointer + offset by one byte
002A6Er 2               proc_scan_advance:
002A6Er 2  E6 rr              INC   proc_ptr_lo
002A70r 2  D0 02              BNE   :+
002A72r 2  E6 rr              INC   proc_ptr_hi
002A74r 2  EE rr rr     :     INC   proc_scan_off_lo
002A77r 2  D0 03              BNE   :+
002A79r 2  EE rr rr           INC   proc_scan_off_hi
002A7Cr 2  60           :     RTS
002A7Dr 2               
002A7Dr 2               ; proc_line_is_end — carry set if the line at proc_ptr is exactly "END" followed
002A7Dr 2               ; by '\n' or end-of-buffer. Needs room for 3 chars (off+3 <= len). Non-destructive.
002A7Dr 2               proc_line_is_end:
002A7Dr 2                     ; proc_entry = proc_scan_off + 3
002A7Dr 2  18                 CLC
002A7Er 2  AD rr rr           LDA   proc_scan_off_lo
002A81r 2  69 03              ADC   #3
002A83r 2  85 rr              STA   proc_entry_lo
002A85r 2  AD rr rr           LDA   proc_scan_off_hi
002A88r 2  69 00              ADC   #0
002A8Ar 2  85 rr              STA   proc_entry_hi
002A8Cr 2                     ; need off+3 <= len, i.e. NOT (off+3 > len) == NOT (len < off+3)
002A8Cr 2  A5 rr              LDA   proc_body_len_lo
002A8Er 2  C5 rr              CMP   proc_entry_lo
002A90r 2  A5 rr              LDA   proc_body_len_hi
002A92r 2  E5 rr              SBC   proc_entry_hi
002A94r 2  90 2B              BCC   @no                   ; len < off+3 -> not enough room
002A96r 2  A0 00              LDY   #0
002A98r 2  B1 rr              LDA   (proc_ptr_lo),Y
002A9Ar 2  C9 45              CMP   #'E'
002A9Cr 2  D0 23              BNE   @no
002A9Er 2  C8                 INY
002A9Fr 2  B1 rr              LDA   (proc_ptr_lo),Y
002AA1r 2  C9 4E              CMP   #'N'
002AA3r 2  D0 1C              BNE   @no
002AA5r 2  C8                 INY
002AA6r 2  B1 rr              LDA   (proc_ptr_lo),Y
002AA8r 2  C9 44              CMP   #'D'
002AAAr 2  D0 15              BNE   @no
002AACr 2                     ; 4th byte: '\n', or off+3 == len (END at buffer end)
002AACr 2  A5 rr              LDA   proc_entry_lo
002AAEr 2  C5 rr              CMP   proc_body_len_lo
002AB0r 2  D0 06              BNE   @check_nl
002AB2r 2  A5 rr              LDA   proc_entry_hi
002AB4r 2  C5 rr              CMP   proc_body_len_hi
002AB6r 2  F0 07              BEQ   @yes                  ; off+3 == len
002AB8r 2               @check_nl:
002AB8r 2  C8                 INY
002AB9r 2  B1 rr              LDA   (proc_ptr_lo),Y
002ABBr 2  C9 0A              CMP   #$0A
002ABDr 2  D0 02              BNE   @no
002ABFr 2               @yes:
002ABFr 2  38                 SEC
002AC0r 2  60                 RTS
002AC1r 2               @no:
002AC1r 2  18                 CLC
002AC2r 2  60                 RTS
002AC3r 2               
002AC3r 2               ; ---------------------------------------------------------------------
002AC3r 2               ; heap_alloc_big — allocate for procedure records (16-bit payload)
002AC3r 2               ;   Input:  proc_ptr_lo/hi = record data size (16-bit)
002AC3r 2               ;   Output: proc_entry_lo/hi = pointer to record data (payload+2)
002AC3r 2               ;           Carry clear = success, Carry set = OOM
002AC3r 2               ;
002AC3r 2               ;   Layout: [GC_HDR_TAG, GC_HDR_SIZE=0, total_lo, total_hi, ...data...]
002AC3r 2               ;   GC header (2 bytes) + 16-bit size (2 bytes) + record data.
002AC3r 2               ;   Total allocation = record_data_size + 4.
002AC3r 2               ;   GC_HDR_SIZE = 0 tells GC to read 16-bit total from payload[0..1].
002AC3r 2               ;   proc_entry points to data (base+4).
002AC3r 2               ;
002AC3r 2               ;   Clobbers: A, Y, ptr_lo/hi
002AC3r 2               ; ---------------------------------------------------------------------
002AC3r 2               heap_alloc_big:
002AC3r 2                     ; Total allocation = data_size + 4 (2 hdr + 2 size field)
002AC3r 2  18                 CLC
002AC4r 2  A5 rr              LDA   proc_ptr_lo
002AC6r 2  69 04              ADC   #4
002AC8r 2  48                 PHA                        ; save total_lo
002AC9r 2  A5 rr              LDA   proc_ptr_hi
002ACBr 2  69 00              ADC   #0
002ACDr 2  48                 PHA                        ; save total_hi
002ACEr 2               
002ACEr 2                     ; Save current heap_ptr as base
002ACEr 2  A5 rr              LDA   heap_ptr
002AD0r 2  85 rr              STA   proc_entry_lo
002AD2r 2  A5 rr              LDA   heap_ptr+1
002AD4r 2  85 rr              STA   proc_entry_hi
002AD6r 2               
002AD6r 2                     ; Advance heap_ptr by total
002AD6r 2  BA                 TSX
002AD7r 2  18                 CLC
002AD8r 2  A5 rr              LDA   heap_ptr
002ADAr 2  7D 02 01           ADC   $0102,X              ; total_lo
002ADDr 2  85 rr              STA   heap_ptr
002ADFr 2  A5 rr              LDA   heap_ptr+1
002AE1r 2  7D 01 01           ADC   $0101,X              ; total_hi
002AE4r 2  85 rr              STA   heap_ptr+1
002AE6r 2               
002AE6r 2                     ; OOM check
002AE6r 2  C9 98              CMP   #>HEAP_END
002AE8r 2  90 16              BCC   @big_ok
002AEAr 2  D0 08              BNE   @big_oom
002AECr 2  A5 rr              LDA   heap_ptr
002AEEr 2  C9 00              CMP   #<HEAP_END
002AF0r 2  90 0E              BCC   @big_ok
002AF2r 2  F0 0C              BEQ   @big_ok
002AF4r 2               @big_oom:
002AF4r 2  A5 rr              LDA   proc_entry_lo
002AF6r 2  85 rr              STA   heap_ptr
002AF8r 2  A5 rr              LDA   proc_entry_hi
002AFAr 2  85 rr              STA   heap_ptr+1
002AFCr 2  68                 PLA
002AFDr 2  68                 PLA
002AFEr 2  38                 SEC
002AFFr 2  60                 RTS
002B00r 2               @big_ok:
002B00r 2                     ; Write header at base (proc_entry = base here)
002B00r 2  A5 rr              LDA   proc_entry_lo
002B02r 2  85 rr              STA   ptr_lo
002B04r 2  A5 rr              LDA   proc_entry_hi
002B06r 2  85 rr              STA   ptr_hi
002B08r 2               
002B08r 2  A0 00              LDY   #GC_HDR_TAG
002B0Ar 2  A9 04              LDA   #ATYPE_PROC
002B0Cr 2  91 rr              STA   (ptr_lo),Y
002B0Er 2               
002B0Er 2  A0 01              LDY   #GC_HDR_SIZE
002B10r 2  A9 00              LDA   #0                    ; 0 = 16-bit size at payload[0..1]
002B12r 2  91 rr              STA   (ptr_lo),Y
002B14r 2               
002B14r 2                     ; Write 16-bit total at payload offsets 0,1 (base+2, base+3)
002B14r 2  68                 PLA                        ; total_hi
002B15r 2  A0 03              LDY   #GC_HDR_BYTES+1       ; base+3
002B17r 2  91 rr              STA   (ptr_lo),Y
002B19r 2  68                 PLA                        ; total_lo
002B1Ar 2  A0 02              LDY   #GC_HDR_BYTES         ; base+2
002B1Cr 2  91 rr              STA   (ptr_lo),Y
002B1Er 2               
002B1Er 2                     ; Advance proc_entry to point past header+size field = base+4
002B1Er 2                     ; This is where the record data starts
002B1Er 2  18                 CLC
002B1Fr 2  A5 rr              LDA   proc_entry_lo
002B21r 2  69 04              ADC   #4
002B23r 2  85 rr              STA   proc_entry_lo
002B25r 2  A5 rr              LDA   proc_entry_hi
002B27r 2  69 00              ADC   #0
002B29r 2  85 rr              STA   proc_entry_hi
002B2Br 2               
002B2Br 2  18                 CLC
002B2Cr 2  60                 RTS
002B2Dr 2               
002B2Dr 2               ; ---------------------------------------------------------------------
002B2Dr 2               ; proc_build_record — allocate and populate a procedure heap record
002B2Dr 2               ;   Uses: proc_name_buf, proc_param_buf/proc_param_end,
002B2Dr 2               ;         proc_body_buf/proc_body_len
002B2Dr 2               ; ---------------------------------------------------------------------
002B2Dr 2               proc_build_record:
002B2Dr 2                     ; Calculate total record size
002B2Dr 2                     ; 2 (next) + 1 (name_len) + name_len
002B2Dr 2                     ; + 1 (param_count) + (proc_param_end - 1) param packed bytes
002B2Dr 2                     ; + 2 (body_len) + body_len
002B2Dr 2                     ;
002B2Dr 2                     ; We build the total in proc_ptr_lo:proc_ptr_hi (16-bit)
002B2Dr 2               
002B2Dr 2  A9 04              LDA   #4                    ; 2(next) + 1(name_len) + 1(param_count)
002B2Fr 2  18                 CLC
002B30r 2  6D rr rr           ADC   proc_name_buf         ; + name_len
002B33r 2  85 rr              STA   proc_ptr_lo
002B35r 2  A9 00              LDA   #0
002B37r 2  85 rr              STA   proc_ptr_hi
002B39r 2               
002B39r 2                     ; + param packed bytes (proc_param_end - 1)
002B39r 2  AD rr rr           LDA   proc_param_end
002B3Cr 2  38                 SEC
002B3Dr 2  E9 01              SBC   #1
002B3Fr 2  18                 CLC
002B40r 2  65 rr              ADC   proc_ptr_lo
002B42r 2  85 rr              STA   proc_ptr_lo
002B44r 2  90 02              BCC   :+
002B46r 2  E6 rr              INC   proc_ptr_hi
002B48r 2               :
002B48r 2                     ; + 2 (body_len field)
002B48r 2  18                 CLC
002B49r 2  A5 rr              LDA   proc_ptr_lo
002B4Br 2  69 02              ADC   #2
002B4Dr 2  85 rr              STA   proc_ptr_lo
002B4Fr 2  90 02              BCC   :+
002B51r 2  E6 rr              INC   proc_ptr_hi
002B53r 2               :
002B53r 2                     ; + body_len
002B53r 2  18                 CLC
002B54r 2  A5 rr              LDA   proc_ptr_lo
002B56r 2  65 rr              ADC   proc_body_len_lo
002B58r 2  85 rr              STA   proc_ptr_lo
002B5Ar 2  A5 rr              LDA   proc_ptr_hi
002B5Cr 2  65 rr              ADC   proc_body_len_hi
002B5Er 2  85 rr              STA   proc_ptr_hi
002B60r 2               
002B60r 2                     ; Allocate with GC header (16-bit size via heap_alloc_big)
002B60r 2                     ; proc_ptr_lo/hi = payload size
002B60r 2  20 rr rr           JSR   heap_alloc_big
002B63r 2  90 01              BCC   @ok
002B65r 2  60                 RTS                        ; OOM
002B66r 2               @ok:
002B66r 2                     ; Fill the record using (ptr_lo),Y indirect addressing
002B66r 2                     ; We track Y as the write offset. For records > 256 bytes
002B66r 2                     ; we bump ptr_hi when Y wraps.
002B66r 2  A5 rr              LDA   proc_entry_lo
002B68r 2  85 rr              STA   ptr_lo
002B6Ar 2  A5 rr              LDA   proc_entry_hi
002B6Cr 2  85 rr              STA   ptr_hi
002B6Er 2               
002B6Er 2                     ; +0,+1: next pointer = current proc_head
002B6Er 2  A0 00              LDY   #0
002B70r 2  A5 rr              LDA   proc_head_lo
002B72r 2  91 rr              STA   (ptr_lo),Y
002B74r 2  C8                 INY
002B75r 2  A5 rr              LDA   proc_head_hi
002B77r 2  91 rr              STA   (ptr_lo),Y
002B79r 2               
002B79r 2                     ; +2: name_len
002B79r 2  C8                 INY
002B7Ar 2  AD rr rr           LDA   proc_name_buf
002B7Dr 2  91 rr              STA   (ptr_lo),Y
002B7Fr 2               
002B7Fr 2                     ; +3..+3+NL-1: name chars
002B7Fr 2  AE rr rr           LDX   proc_name_buf         ; X = char count
002B82r 2  64 rr              STZ   proc_rec_off          ; source index
002B84r 2               @bld_name:
002B84r 2  E0 00              CPX   #0
002B86r 2  F0 13              BEQ   @bld_name_done
002B88r 2  C8                 INY
002B89r 2  D0 02              BNE   :+
002B8Br 2  E6 rr              INC   ptr_hi
002B8Dr 2  DA           :     PHX
002B8Er 2  A6 rr              LDX   proc_rec_off
002B90r 2  BD rr rr           LDA   proc_name_buf+1,X
002B93r 2  FA                 PLX
002B94r 2  91 rr              STA   (ptr_lo),Y
002B96r 2  E6 rr              INC   proc_rec_off
002B98r 2  CA                 DEX
002B99r 2  80 E9              BRA   @bld_name
002B9Br 2               @bld_name_done:
002B9Br 2               
002B9Br 2                     ; +3+NL: param_count
002B9Br 2  C8                 INY
002B9Cr 2  D0 02              BNE   :+
002B9Er 2  E6 rr              INC   ptr_hi
002BA0r 2  A5 rr        :     LDA   proc_param_cnt
002BA2r 2  91 rr              STA   (ptr_lo),Y
002BA4r 2               
002BA4r 2                     ; Copy packed param data from proc_param_buf[1..proc_param_end-1]
002BA4r 2  AD rr rr           LDA   proc_param_end
002BA7r 2  C9 02              CMP   #2                    ; at least 1 = there are params
002BA9r 2  90 14              BCC   @bld_params_done
002BABr 2  A2 01              LDX   #1                    ; source index (skip count byte)
002BADr 2               @bld_param:
002BADr 2  EC rr rr           CPX   proc_param_end
002BB0r 2  B0 0D              BCS   @bld_params_done
002BB2r 2  C8                 INY
002BB3r 2  D0 02              BNE   :+
002BB5r 2  E6 rr              INC   ptr_hi
002BB7r 2  BD rr rr     :     LDA   proc_param_buf,X
002BBAr 2  91 rr              STA   (ptr_lo),Y
002BBCr 2  E8                 INX
002BBDr 2  80 EE              BRA   @bld_param
002BBFr 2               @bld_params_done:
002BBFr 2               
002BBFr 2                     ; body_len_lo, body_len_hi
002BBFr 2  C8                 INY
002BC0r 2  D0 02              BNE   :+
002BC2r 2  E6 rr              INC   ptr_hi
002BC4r 2  A5 rr        :     LDA   proc_body_len_lo
002BC6r 2  91 rr              STA   (ptr_lo),Y
002BC8r 2  C8                 INY
002BC9r 2  D0 02              BNE   :+
002BCBr 2  E6 rr              INC   ptr_hi
002BCDr 2  A5 rr        :     LDA   proc_body_len_hi
002BCFr 2  91 rr              STA   (ptr_lo),Y
002BD1r 2               
002BD1r 2                     ; Copy body text (proc_body_src points at the body region of the buffer)
002BD1r 2  A5 rr              LDA   proc_body_len_lo
002BD3r 2  05 rr              ORA   proc_body_len_hi
002BD5r 2  F0 3A              BEQ   @bld_body_done
002BD7r 2               
002BD7r 2  AD rr rr           LDA   proc_body_src_lo
002BDAr 2  85 rr              STA   proc_ptr_lo
002BDCr 2  AD rr rr           LDA   proc_body_src_hi
002BDFr 2  85 rr              STA   proc_ptr_hi
002BE1r 2                     ; 16-bit counter
002BE1r 2  A5 rr              LDA   proc_body_len_lo
002BE3r 2  8D rr rr           STA   num_tmp_lo
002BE6r 2  A5 rr              LDA   proc_body_len_hi
002BE8r 2  8D rr rr           STA   num_tmp_hi
002BEBr 2               
002BEBr 2               @bld_body:
002BEBr 2  C8                 INY
002BECr 2  D0 02              BNE   :+
002BEEr 2  E6 rr              INC   ptr_hi
002BF0r 2  5A           :     PHY
002BF1r 2  A0 00              LDY   #0
002BF3r 2  B1 rr              LDA   (proc_ptr_lo),Y
002BF5r 2  7A                 PLY
002BF6r 2  91 rr              STA   (ptr_lo),Y
002BF8r 2                     ; Advance source
002BF8r 2  E6 rr              INC   proc_ptr_lo
002BFAr 2  D0 02              BNE   :+
002BFCr 2  E6 rr              INC   proc_ptr_hi
002BFEr 2               :     ; Decrement counter
002BFEr 2  AD rr rr           LDA   num_tmp_lo
002C01r 2  D0 03              BNE   @bld_dec_lo
002C03r 2  CE rr rr           DEC   num_tmp_hi
002C06r 2               @bld_dec_lo:
002C06r 2  CE rr rr           DEC   num_tmp_lo
002C09r 2  AD rr rr           LDA   num_tmp_lo
002C0Cr 2  0D rr rr           ORA   num_tmp_hi
002C0Fr 2  D0 DA              BNE   @bld_body
002C11r 2               
002C11r 2               @bld_body_done:
002C11r 2                     ; Prepend to directory
002C11r 2  A5 rr              LDA   proc_entry_lo
002C13r 2  85 rr              STA   proc_head_lo
002C15r 2  A5 rr              LDA   proc_entry_hi
002C17r 2  85 rr              STA   proc_head_hi
002C19r 2  60                 RTS
002C1Ar 2               
002C1Ar 2               ; ---------------------------------------------------------------------
002C1Ar 2               ; proc_lookup — search for a procedure by name
002C1Ar 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
002C1Ar 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002C1Ar 2               ;           carry set = not found
002C1Ar 2               ; ---------------------------------------------------------------------
002C1Ar 2               proc_lookup:
002C1Ar 2  A5 rr              LDA   proc_head_lo
002C1Cr 2  85 rr              STA   proc_entry_lo
002C1Er 2  A5 rr              LDA   proc_head_hi
002C20r 2  85 rr              STA   proc_entry_hi
002C22r 2               
002C22r 2               @walk:
002C22r 2  A5 rr              LDA   proc_entry_lo
002C24r 2  05 rr              ORA   proc_entry_hi
002C26r 2  F0 1D              BEQ   @not_found
002C28r 2               
002C28r 2  20 rr rr           JSR   proc_names_equal
002C2Br 2  B0 16              BCS   @found
002C2Dr 2               
002C2Dr 2                     ; Follow next pointer
002C2Dr 2  A5 rr              LDA   proc_entry_lo
002C2Fr 2  85 rr              STA   ptr_lo
002C31r 2  A5 rr              LDA   proc_entry_hi
002C33r 2  85 rr              STA   ptr_hi
002C35r 2  A0 00              LDY   #0
002C37r 2  B1 rr              LDA   (ptr_lo),Y
002C39r 2  AA                 TAX
002C3Ar 2  C8                 INY
002C3Br 2  B1 rr              LDA   (ptr_lo),Y
002C3Dr 2  85 rr              STA   proc_entry_hi
002C3Fr 2  86 rr              STX   proc_entry_lo
002C41r 2  80 DF              BRA   @walk
002C43r 2               
002C43r 2               @found:
002C43r 2  18                 CLC
002C44r 2  60                 RTS
002C45r 2               @not_found:
002C45r 2  38                 SEC
002C46r 2  60                 RTS
002C47r 2               
002C47r 2               ; ---------------------------------------------------------------------
002C47r 2               ; proc_names_equal — compare token word vs record name
002C47r 2               ;   Input: eval_cur_lo/hi = TOK_WORD, proc_entry_lo/hi = record
002C47r 2               ;   Returns: carry set = equal, carry clear = not equal
002C47r 2               ; ---------------------------------------------------------------------
002C47r 2               proc_names_equal:
002C47r 2                     ; Token name length
002C47r 2  A5 rr              LDA   eval_cur_lo
002C49r 2  85 rr              STA   ptr_lo
002C4Br 2  A5 rr              LDA   eval_cur_hi
002C4Dr 2  85 rr              STA   ptr_hi
002C4Fr 2  A0 03              LDY   #TOK_PAYLOAD
002C51r 2  B1 rr              LDA   (ptr_lo),Y
002C53r 2  85 rr              STA   proc_name_len         ; token name length
002C55r 2               
002C55r 2                     ; Record name length
002C55r 2  A5 rr              LDA   proc_entry_lo
002C57r 2  85 rr              STA   ptr_lo
002C59r 2  A5 rr              LDA   proc_entry_hi
002C5Br 2  85 rr              STA   ptr_hi
002C5Dr 2  A0 02              LDY   #2
002C5Fr 2  B1 rr              LDA   (ptr_lo),Y
002C61r 2               
002C61r 2  C5 rr              CMP   proc_name_len
002C63r 2  D0 37              BNE   @ne
002C65r 2               
002C65r 2                     ; Lengths match — compare chars
002C65r 2  AA                 TAX                         ; X = length
002C66r 2  F0 30              BEQ   @eq
002C68r 2  A0 00              LDY   #0                    ; char index
002C6Ar 2               @cmp:
002C6Ar 2  DA                 PHX
002C6Br 2  5A                 PHY
002C6Cr 2                     ; Token char at eval_cur + TOK_PAYLOAD + 1 + charIdx
002C6Cr 2  A5 rr              LDA   eval_cur_lo
002C6Er 2  85 rr              STA   ptr_lo
002C70r 2  A5 rr              LDA   eval_cur_hi
002C72r 2  85 rr              STA   ptr_hi
002C74r 2  98                 TYA
002C75r 2  18                 CLC
002C76r 2  69 04              ADC   #TOK_PAYLOAD+1
002C78r 2  A8                 TAY
002C79r 2  B1 rr              LDA   (ptr_lo),Y
002C7Br 2  85 rr              STA   proc_rec_off          ; temp: token char
002C7Dr 2               
002C7Dr 2                     ; Record char at proc_entry + 3 + charIdx
002C7Dr 2  7A                 PLY
002C7Er 2  5A                 PHY
002C7Fr 2  A5 rr              LDA   proc_entry_lo
002C81r 2  85 rr              STA   ptr_lo
002C83r 2  A5 rr              LDA   proc_entry_hi
002C85r 2  85 rr              STA   ptr_hi
002C87r 2  98                 TYA
002C88r 2  18                 CLC
002C89r 2  69 03              ADC   #3
002C8Br 2  A8                 TAY
002C8Cr 2  B1 rr              LDA   (ptr_lo),Y
002C8Er 2               
002C8Er 2  C5 rr              CMP   proc_rec_off
002C90r 2  D0 08              BNE   @ne_pop
002C92r 2  7A                 PLY
002C93r 2  FA                 PLX
002C94r 2  C8                 INY
002C95r 2  CA                 DEX
002C96r 2  D0 D2              BNE   @cmp
002C98r 2               @eq:
002C98r 2  38                 SEC
002C99r 2  60                 RTS
002C9Ar 2               @ne_pop:
002C9Ar 2  7A                 PLY
002C9Br 2  FA                 PLX
002C9Cr 2               @ne:
002C9Cr 2  18                 CLC
002C9Dr 2  60                 RTS
002C9Er 2               
002C9Er 2               ; ---------------------------------------------------------------------
002C9Er 2               ; proc_invoke — invoke a user-defined procedure
002C9Er 2               ;   Input: eval_cur_lo/hi = TOK_WORD token (the procedure name)
002C9Er 2               ;          proc_entry_lo/hi = matching procedure record
002C9Er 2               ;   On exit: JMPs to eval_loop or eval_body to continue.
002C9Er 2               ; ---------------------------------------------------------------------
002C9Er 2               proc_invoke:
002C9Er 2                     ; Save outer tokenizer and eval state on the hardware stack.
002C9Er 2                     ; We push: tok_head(2), tok_tail(2), eval_in_body(1),
002C9Er 2                     ;          proc_stopped(1) = 6 bytes.
002C9Er 2                     ; input_buf is saved to BSS (128 bytes too large for stack).
002C9Er 2  A5 rr              LDA   tok_head_lo
002CA0r 2  48                 PHA
002CA1r 2  A5 rr              LDA   tok_head_hi
002CA3r 2  48                 PHA
002CA4r 2  A5 rr              LDA   tok_tail_lo
002CA6r 2  48                 PHA
002CA7r 2  A5 rr              LDA   tok_tail_hi
002CA9r 2  48                 PHA
002CAAr 2  A5 rr              LDA   eval_in_body
002CACr 2  48                 PHA
002CADr 2  A5 rr              LDA   proc_stopped
002CAFr 2  48                 PHA
002CB0r 2               
002CB0r 2                     ; Save input_buf to BSS save area
002CB0r 2  A2 00              LDX   #0
002CB2r 2               @save_ib:
002CB2r 2  BD rr rr           LDA   input_buf,X
002CB5r 2  9D rr rr           STA   save_input_buf,X
002CB8r 2  E8                 INX
002CB9r 2  E0 80              CPX   #128
002CBBr 2  D0 F5              BNE   @save_ib
002CBDr 2               
002CBDr 2                     ; Advance eval_cur past the procedure name token
002CBDr 2  20 rr rr           JSR   eval_advance
002CC0r 2               
002CC0r 2                     ; --- Bind parameters ---
002CC0r 2                     ; Navigate to param_count in the record:
002CC0r 2                     ;   offset = 3 + name_len
002CC0r 2  A5 rr              LDA   proc_entry_lo
002CC2r 2  85 rr              STA   ptr_lo
002CC4r 2  A5 rr              LDA   proc_entry_hi
002CC6r 2  85 rr              STA   ptr_hi
002CC8r 2  A0 02              LDY   #2
002CCAr 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002CCCr 2  18                 CLC
002CCDr 2  69 03              ADC   #3
002CCFr 2  A8                 TAY                         ; Y = offset to param_count
002CD0r 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002CD2r 2  85 rr              STA   proc_param_cnt
002CD4r 2  C8                 INY                         ; Y = offset to first param name
002CD5r 2  84 rr              STY   proc_rec_off          ; save record offset
002CD7r 2               
002CD7r 2  A5 rr              LDA   proc_param_cnt
002CD9r 2  F0 5C              BEQ   @bind_done
002CDBr 2               
002CDBr 2  A6 rr              LDX   proc_param_cnt
002CDDr 2               @bind_loop:
002CDDr 2  DA                 PHX                         ; save remaining param count
002CDEr 2               
002CDEr 2                     ; First: evaluate the next argument from the caller's token stream.
002CDEr 2                     ; eval_cur still points into the caller's token list.
002CDEr 2  20 rr rr           JSR   eval_expr
002CE1r 2  90 03              BCC   @arg_ok
002CE3r 2  4C rr rr           JMP   @bind_err
