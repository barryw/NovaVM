00006Er 2                     ; --- Screen modes ---
00006Er 2  rr rr              .word str_ext_textscreen
000070r 2  00                 .byte MODULE_ID_NONE
000071r 2  1A                 .byte EXT_CMD_TS
000072r 2  00                 .byte 0
000073r 2  rr rr              .word str_ext_ts
000075r 2  00                 .byte MODULE_ID_NONE
000076r 2  1A                 .byte EXT_CMD_TS
000077r 2  00                 .byte 0
000078r 2  rr rr              .word str_ext_splitscreen
00007Ar 2  00                 .byte MODULE_ID_NONE
