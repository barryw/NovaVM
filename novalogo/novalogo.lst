0009C4r 2  04 4C 49 53        .byte 4, "LIST"
0009C8r 2  54           
0009C9r 2               str_sentence_name:
0009C9r 2  08 53 45 4E        .byte 8, "SENTENCE"
0009CDr 2  54 45 4E 43  
0009D1r 2  45           
0009D2r 2               str_se_name:
0009D2r 2  02 53 45           .byte 2, "SE"
0009D5r 2               str_word_name:
0009D5r 2  04 57 4F 52        .byte 4, "WORD"
0009D9r 2  44           
0009DAr 2               str_run_name:
0009DAr 2  03 52 55 4E        .byte 3, "RUN"
0009DEr 2               
0009DEr 1                     .include "vars.s"
0009DEr 2               ; vars.s — variable storage for NovaLogo (MAKE / :reference)
0009DEr 2               ;
0009DEr 2               ; Variables are stored as a linked list of heap entries.
0009DEr 2               ; Entry layout:
0009DEr 2               ;   +0: next_lo  (2 bytes — pointer to next entry, or $0000)
0009DEr 2               ;   +1: next_hi
0009DEr 2               ;   +2: name_len (1 byte)
0009DEr 2               ;   +3: name chars (name_len bytes, uppercased)
0009DEr 2               ;   +3+name_len: value_type (1 byte: $00=number, $01=word)
0009DEr 2               ;   +4+name_len: val_hi  (or ptr_lo for word)
0009DEr 2               ;   +5+name_len: val_lo  (or ptr_hi for word)
0009DEr 2               ;   +6+name_len: val_frac (0 for word)
0009DEr 2               ;   +7+name_len: pad     (0)
0009DEr 2               ;
0009DEr 2               ; Total entry size = 8 + name_len bytes.
0009DEr 2               
0009DEr 2               ; Entry field offsets (relative to entry base)
0009DEr 2               VAR_NEXT_LO  = 0
0009DEr 2               VAR_NEXT_HI  = 1
0009DEr 2               VAR_NAME_LEN = 2
0009DEr 2               VAR_NAME     = 3              ; first char of name
0009DEr 2               
0009DEr 2               ; =====================================================================
0009DEr 2               ; ZEROPAGE segment — variable list head + scratch
0009DEr 2               ; =====================================================================
0009DEr 2                     .segment "ZEROPAGE"
000036r 2               
000036r 2  xx           var_head_lo:    .res 1        ; head of variable linked list
000037r 2  xx           var_head_hi:    .res 1
000038r 2  xx           var_entry_lo:   .res 1        ; current entry pointer (walk scratch)
000039r 2  xx           var_entry_hi:   .res 1
00003Ar 2  xx           var_name_lo:    .res 1        ; saved name pointer for set/get
00003Br 2  xx           var_name_hi:    .res 1
00003Cr 2               
00003Cr 2               ; =====================================================================
00003Cr 2               ; CODE segment — variable routines
00003Cr 2               ; =====================================================================
00003Cr 2                     .segment "CODE"
0025A2r 2               
0025A2r 2               ; ---------------------------------------------------------------------
0025A2r 2               ; var_init — initialize variable list to empty
0025A2r 2               ;   Called once at cold_start
0025A2r 2               ; ---------------------------------------------------------------------
0025A2r 2               var_init:
0025A2r 2  64 rr              STZ   var_head_lo
0025A4r 2  64 rr              STZ   var_head_hi
0025A6r 2  60                 RTS
0025A7r 2               
0025A7r 2               ; ---------------------------------------------------------------------
0025A7r 2               ; var_set — store a value under a variable name
0025A7r 2               ;   Input: ptr_lo/hi → length-prefixed name string (in token node)
0025A7r 2               ;          eval_type, eval_val_hi/lo/frac = value to store
0025A7r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, var_entry, var_name
0025A7r 2               ; ---------------------------------------------------------------------
0025A7r 2               var_set:
0025A7r 2                     ; Save name pointer — we need it after the walk
0025A7r 2  A5 rr              LDA   ptr_lo
0025A9r 2  85 rr              STA   var_name_lo
0025ABr 2  A5 rr              LDA   ptr_hi
0025ADr 2  85 rr              STA   var_name_hi
0025AFr 2               
0025AFr 2                     ; Walk the list looking for an existing entry with this name
0025AFr 2  A5 rr              LDA   var_head_lo
0025B1r 2  85 rr              STA   var_entry_lo
0025B3r 2  A5 rr              LDA   var_head_hi
0025B5r 2  85 rr              STA   var_entry_hi
0025B7r 2               
0025B7r 2               @walk:
0025B7r 2                     ; End of list?
0025B7r 2  A5 rr              LDA   var_entry_lo
0025B9r 2  05 rr              ORA   var_entry_hi
0025BBr 2  F0 44              BEQ   @not_found
0025BDr 2               
0025BDr 2                     ; Compare name in entry against var_name
0025BDr 2  20 rr rr           JSR   var_names_equal
0025C0r 2  B0 16              BCS   @found
0025C2r 2               
0025C2r 2                     ; Advance to next entry
0025C2r 2  A5 rr              LDA   var_entry_lo
0025C4r 2  85 rr              STA   ptr2_lo
0025C6r 2  A5 rr              LDA   var_entry_hi
0025C8r 2  85 rr              STA   ptr2_hi
0025CAr 2  A0 00              LDY   #VAR_NEXT_LO
0025CCr 2  B1 rr              LDA   (ptr2_lo),Y
0025CEr 2  AA                 TAX
0025CFr 2  C8                 INY
0025D0r 2  B1 rr              LDA   (ptr2_lo),Y
0025D2r 2  85 rr              STA   var_entry_hi
0025D4r 2  86 rr              STX   var_entry_lo
0025D6r 2  80 DF              BRA   @walk
0025D8r 2               
0025D8r 2               @found:
0025D8r 2                     ; Overwrite value in place
0025D8r 2                     ; Value starts at entry + 3 + name_len
0025D8r 2  A5 rr              LDA   var_entry_lo
0025DAr 2  85 rr              STA   ptr2_lo
0025DCr 2  A5 rr              LDA   var_entry_hi
0025DEr 2  85 rr              STA   ptr2_hi
0025E0r 2  A0 02              LDY   #VAR_NAME_LEN
0025E2r 2  B1 rr              LDA   (ptr2_lo),Y          ; name_len
0025E4r 2  18                 CLC
0025E5r 2  69 03              ADC   #VAR_NAME             ; A = 3 + name_len = offset to value_type
0025E7r 2  A8                 TAY
0025E8r 2  A5 rr              LDA   eval_type
0025EAr 2  91 rr              STA   (ptr2_lo),Y
0025ECr 2  C8                 INY
0025EDr 2  A5 rr              LDA   eval_val_hi
0025EFr 2  91 rr              STA   (ptr2_lo),Y
0025F1r 2  C8                 INY
0025F2r 2  A5 rr              LDA   eval_val_lo
0025F4r 2  91 rr              STA   (ptr2_lo),Y
0025F6r 2  C8                 INY
0025F7r 2  A5 rr              LDA   eval_val_frac
0025F9r 2  91 rr              STA   (ptr2_lo),Y
0025FBr 2  C8                 INY
0025FCr 2  A9 00              LDA   #0
0025FEr 2  91 rr              STA   (ptr2_lo),Y          ; pad
002600r 2  60                 RTS
002601r 2               
002601r 2               @not_found:
002601r 2                     ; Allocate a new entry: 8 + name_len bytes
002601r 2                     ; Read name_len from the name string
002601r 2  A5 rr              LDA   var_name_lo
002603r 2  85 rr              STA   ptr_lo
002605r 2  A5 rr              LDA   var_name_hi
002607r 2  85 rr              STA   ptr_hi
002609r 2  A0 00              LDY   #0
00260Br 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
00260Dr 2  48                 PHA                         ; save name_len
00260Er 2  18                 CLC
00260Fr 2  69 08              ADC   #8                    ; total entry size
002611r 2  A2 03              LDX   #ATYPE_VAR
002613r 2  20 rr rr           JSR   heap_alloc
002616r 2  B0 62              BCS   @oom
002618r 2               
002618r 2                     ; ptr_lo/hi now points to new entry
002618r 2                     ; Set next → current head
002618r 2  A0 00              LDY   #VAR_NEXT_LO
00261Ar 2  A5 rr              LDA   var_head_lo
00261Cr 2  91 rr              STA   (ptr_lo),Y
00261Er 2  C8                 INY
00261Fr 2  A5 rr              LDA   var_head_hi
002621r 2  91 rr              STA   (ptr_lo),Y
002623r 2               
002623r 2                     ; Copy name_len
002623r 2  68                 PLA                         ; A = name_len
002624r 2  48                 PHA                         ; keep it on stack
002625r 2  A0 02              LDY   #VAR_NAME_LEN
002627r 2  91 rr              STA   (ptr_lo),Y
002629r 2               
002629r 2                     ; Copy name chars (uppercased) from var_name source
002629r 2  68                 PLA                         ; A = name_len
00262Ar 2  AA                 TAX                         ; X = remaining chars
00262Br 2  F0 2C              BEQ   @name_done            ; zero-length name (shouldn't happen)
00262Dr 2  A0 03              LDY   #VAR_NAME             ; dest offset in entry
00262Fr 2  9C rr rr           STZ   num_tmp_lo            ; source offset counter
002632r 2               
002632r 2               @copy_name:
002632r 2  DA                 PHX
002633r 2  5A                 PHY
002634r 2                     ; Read source char
002634r 2  A5 rr              LDA   var_name_lo
002636r 2  85 rr              STA   ptr2_lo
002638r 2  A5 rr              LDA   var_name_hi
00263Ar 2  85 rr              STA   ptr2_hi
00263Cr 2  AD rr rr           LDA   num_tmp_lo
00263Fr 2  1A                 INC                         ; skip length byte → offset = idx + 1
002640r 2  A8                 TAY
002641r 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
002643r 2                     ; Uppercase
002643r 2  C9 61              CMP   #'a'
002645r 2  90 07              BCC   @noup
002647r 2  C9 7B              CMP   #'z'+1
002649r 2  B0 03              BCS   @noup
00264Br 2  38                 SEC
00264Cr 2  E9 20              SBC   #$20
00264Er 2               @noup:
00264Er 2  7A                 PLY                         ; restore dest offset
00264Fr 2  91 rr              STA   (ptr_lo),Y           ; write to entry
002651r 2  C8                 INY
002652r 2  EE rr rr           INC   num_tmp_lo
002655r 2  FA                 PLX
002656r 2  CA                 DEX
002657r 2  D0 D9              BNE   @copy_name
002659r 2               
002659r 2               @name_done:
002659r 2                     ; Write value after name
002659r 2                     ; Y is already at VAR_NAME + name_len = value_type offset
002659r 2  A5 rr              LDA   eval_type
00265Br 2  91 rr              STA   (ptr_lo),Y
00265Dr 2  C8                 INY
00265Er 2  A5 rr              LDA   eval_val_hi
002660r 2  91 rr              STA   (ptr_lo),Y
002662r 2  C8                 INY
002663r 2  A5 rr              LDA   eval_val_lo
002665r 2  91 rr              STA   (ptr_lo),Y
002667r 2  C8                 INY
002668r 2  A5 rr              LDA   eval_val_frac
00266Ar 2  91 rr              STA   (ptr_lo),Y
00266Cr 2  C8                 INY
00266Dr 2  A9 00              LDA   #0
00266Fr 2  91 rr              STA   (ptr_lo),Y           ; pad
002671r 2               
002671r 2                     ; Prepend to list: head = new entry
002671r 2  A5 rr              LDA   ptr_lo
002673r 2  85 rr              STA   var_head_lo
002675r 2  A5 rr              LDA   ptr_hi
002677r 2  85 rr              STA   var_head_hi
002679r 2  60                 RTS
00267Ar 2               
00267Ar 2               @oom:
00267Ar 2  68                 PLA                         ; discard saved name_len
00267Br 2  60                 RTS
00267Cr 2               
00267Cr 2               ; ---------------------------------------------------------------------
00267Cr 2               ; var_get — look up a variable by name
00267Cr 2               ;   Input: ptr_lo/hi → length-prefixed name string
00267Cr 2               ;   Output: Carry clear = found, eval_type/eval_val set
00267Cr 2               ;           Carry set = not found
00267Cr 2               ;   Clobbers: A, X, Y, ptr2, var_entry, var_name
00267Cr 2               ; ---------------------------------------------------------------------
00267Cr 2               var_get:
00267Cr 2                     ; Save name pointer
00267Cr 2  A5 rr              LDA   ptr_lo
00267Er 2  85 rr              STA   var_name_lo
002680r 2  A5 rr              LDA   ptr_hi
002682r 2  85 rr              STA   var_name_hi
002684r 2               
002684r 2                     ; Walk the list
002684r 2  A5 rr              LDA   var_head_lo
002686r 2  85 rr              STA   var_entry_lo
002688r 2  A5 rr              LDA   var_head_hi
00268Ar 2  85 rr              STA   var_entry_hi
00268Cr 2               
00268Cr 2               @walk:
00268Cr 2  A5 rr              LDA   var_entry_lo
00268Er 2  05 rr              ORA   var_entry_hi
002690r 2  F0 40              BEQ   @not_found
002692r 2               
002692r 2  20 rr rr           JSR   var_names_equal
002695r 2  B0 16              BCS   @found
002697r 2               
002697r 2                     ; Advance to next
002697r 2  A5 rr              LDA   var_entry_lo
002699r 2  85 rr              STA   ptr2_lo
00269Br 2  A5 rr              LDA   var_entry_hi
00269Dr 2  85 rr              STA   ptr2_hi
00269Fr 2  A0 00              LDY   #VAR_NEXT_LO
0026A1r 2  B1 rr              LDA   (ptr2_lo),Y
0026A3r 2  AA                 TAX
0026A4r 2  C8                 INY
0026A5r 2  B1 rr              LDA   (ptr2_lo),Y
0026A7r 2  85 rr              STA   var_entry_hi
0026A9r 2  86 rr              STX   var_entry_lo
0026ABr 2  80 DF              BRA   @walk
0026ADr 2               
0026ADr 2               @found:
0026ADr 2                     ; Read value from entry + 3 + name_len
0026ADr 2  A5 rr              LDA   var_entry_lo
0026AFr 2  85 rr              STA   ptr2_lo
0026B1r 2  A5 rr              LDA   var_entry_hi
0026B3r 2  85 rr              STA   ptr2_hi
0026B5r 2  A0 02              LDY   #VAR_NAME_LEN
0026B7r 2  B1 rr              LDA   (ptr2_lo),Y
0026B9r 2  18                 CLC
0026BAr 2  69 03              ADC   #VAR_NAME
0026BCr 2  A8                 TAY
0026BDr 2  B1 rr              LDA   (ptr2_lo),Y          ; value_type
0026BFr 2  85 rr              STA   eval_type
0026C1r 2  C8                 INY
0026C2r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_hi
0026C4r 2  85 rr              STA   eval_val_hi
0026C6r 2  C8                 INY
0026C7r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_lo
0026C9r 2  85 rr              STA   eval_val_lo
0026CBr 2  C8                 INY
0026CCr 2  B1 rr              LDA   (ptr2_lo),Y          ; val_frac
0026CEr 2  85 rr              STA   eval_val_frac
0026D0r 2  18                 CLC
0026D1r 2  60                 RTS
0026D2r 2               
0026D2r 2               @not_found:
0026D2r 2  38                 SEC
0026D3r 2  60                 RTS
0026D4r 2               
0026D4r 2               ; ---------------------------------------------------------------------
0026D4r 2               ; var_names_equal — compare name at var_name_lo/hi against entry at var_entry
0026D4r 2               ;   The name source is length-prefixed (from token / quote).
0026D4r 2               ;   The entry stores: name_len at +2, chars at +3 (already uppercased).
0026D4r 2               ;   The source name chars are uppercased during comparison.
0026D4r 2               ;   Returns: Carry set = equal, Carry clear = not equal
0026D4r 2               ;   Clobbers: A, X, Y, ptr2
0026D4r 2               ; ---------------------------------------------------------------------
0026D4r 2               var_names_equal:
0026D4r 2                     ; Read source name length
0026D4r 2  A5 rr              LDA   var_name_lo
0026D6r 2  85 rr              STA   ptr2_lo
0026D8r 2  A5 rr              LDA   var_name_hi
0026DAr 2  85 rr              STA   ptr2_hi
0026DCr 2  A0 00              LDY   #0
0026DEr 2  B1 rr              LDA   (ptr2_lo),Y          ; source name_len
0026E0r 2  AA                 TAX                         ; X = source name_len
0026E1r 2               
0026E1r 2                     ; Read entry name length
0026E1r 2  A5 rr              LDA   var_entry_lo
0026E3r 2  85 rr              STA   ptr2_lo
0026E5r 2  A5 rr              LDA   var_entry_hi
0026E7r 2  85 rr              STA   ptr2_hi
0026E9r 2  A0 02              LDY   #VAR_NAME_LEN
0026EBr 2  B1 rr              LDA   (ptr2_lo),Y          ; entry name_len
0026EDr 2               
0026EDr 2                     ; Compare lengths
0026EDr 2  8E rr rr           STX   num_tmp_lo            ; save source length
0026F0r 2  CD rr rr           CMP   num_tmp_lo
0026F3r 2  D0 43              BNE   @ne
0026F5r 2               
0026F5r 2                     ; Lengths match — compare chars
0026F5r 2  E0 00              CPX   #0
0026F7r 2  F0 3B              BEQ   @eq                   ; both zero-length — equal
0026F9r 2  A0 00              LDY   #0                    ; char index
0026FBr 2               
0026FBr 2               @cmp_loop:
0026FBr 2  DA                 PHX
0026FCr 2  5A                 PHY
0026FDr 2                     ; Read source char (var_name + 1 + Y)
0026FDr 2  A5 rr              LDA   var_name_lo
0026FFr 2  85 rr              STA   ptr2_lo
002701r 2  A5 rr              LDA   var_name_hi
002703r 2  85 rr              STA   ptr2_hi
002705r 2  98                 TYA
002706r 2  1A                 INC                         ; skip length byte
002707r 2  A8                 TAY
002708r 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
00270Ar 2                     ; Uppercase it
00270Ar 2  C9 61              CMP   #'a'
00270Cr 2  90 07              BCC   @noup
00270Er 2  C9 7B              CMP   #'z'+1
002710r 2  B0 03              BCS   @noup
002712r 2  38                 SEC
002713r 2  E9 20              SBC   #$20
002715r 2               @noup:
002715r 2  8D rr rr           STA   num_tmp_hi            ; temp: uppercased source char
002718r 2               
002718r 2                     ; Read entry char (var_entry + VAR_NAME + Y)
002718r 2  7A                 PLY                         ; restore char index
002719r 2  5A                 PHY
00271Ar 2  A5 rr              LDA   var_entry_lo
00271Cr 2  85 rr              STA   ptr2_lo
00271Er 2  A5 rr              LDA   var_entry_hi
002720r 2  85 rr              STA   ptr2_hi
002722r 2  98                 TYA
002723r 2  18                 CLC
002724r 2  69 03              ADC   #VAR_NAME
002726r 2  A8                 TAY
002727r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry char (already uppercase)
002729r 2               
002729r 2  CD rr rr           CMP   num_tmp_hi
00272Cr 2                     ; 65C02: PLY/PLX clobber flags! Must branch BEFORE pulling.
00272Cr 2  D0 08              BNE   @ne_pull
00272Er 2               
00272Er 2  7A                 PLY
00272Fr 2  FA                 PLX
002730r 2  C8                 INY
002731r 2  CA                 DEX
002732r 2  D0 C7              BNE   @cmp_loop
002734r 2               
002734r 2               @eq:
002734r 2  38                 SEC                         ; equal
002735r 2  60                 RTS
002736r 2               
002736r 2               @ne_pull:
002736r 2  7A                 PLY                         ; clean up stack
002737r 2  FA                 PLX
002738r 2               @ne:
002738r 2  18                 CLC                         ; not equal
002739r 2  60                 RTS
00273Ar 2               
00273Ar 1                     .include "procedures.s"
00273Ar 2               ; procedures.s — user-defined procedure storage and invocation
00273Ar 2               ;
00273Ar 2               ; Procedure record layout (heap-allocated linked list):
00273Ar 2               ;   +0: next_lo
00273Ar 2               ;   +1: next_hi    (pointer to next procedure, or $0000)
00273Ar 2               ;   +2: name_len   (1 byte)
00273Ar 2               ;   +3..3+NL-1: name chars (uppercased)
00273Ar 2               ;   +3+NL: param_count (1 byte)
00273Ar 2               ;   For each param:
00273Ar 2               ;     1 byte: param_name_len
00273Ar 2               ;     N bytes: param_name chars (uppercased)
00273Ar 2               ;   After all params:
00273Ar 2               ;     2 bytes: body_len_lo, body_len_hi (16-bit)
00273Ar 2               ;     body_len bytes: body text (lines separated by $0A)
00273Ar 2               
00273Ar 2               ; =====================================================================
00273Ar 2               ; ZEROPAGE segment — procedure variables
00273Ar 2               ; =====================================================================
00273Ar 2                     .segment "ZEROPAGE"
00003Cr 2               
00003Cr 2  xx           proc_head_lo:     .res 1        ; head of procedure directory
00003Dr 2  xx           proc_head_hi:     .res 1
00003Er 2  xx           proc_entry_lo:    .res 1        ; current entry pointer (walk scratch)
00003Fr 2  xx           proc_entry_hi:    .res 1
000040r 2  xx           proc_ptr_lo:      .res 1        ; scratch pointer for proc operations
000041r 2  xx           proc_ptr_hi:      .res 1
000042r 2  xx           proc_body_len_lo: .res 1        ; body length during collection / invocation
000043r 2  xx           proc_body_len_hi: .res 1
000044r 2  xx           proc_param_cnt:   .res 1        ; param count during define / invoke
000045r 2  xx           proc_name_len:    .res 1        ; name length scratch
000046r 2  xx           proc_rec_off:     .res 1        ; offset into record during invoke
000047r 2               
000047r 2               ; =====================================================================
000047r 2               ; BSS segment — temporary buffers
000047r 2               ; =====================================================================
000047r 2                     .segment "BSS"
00000Fr 2               
00000Fr 2  xx xx xx xx  proc_body_buf:    .res 2048     ; editor text buffer: "TO ..\n<body>\nEND\n"
000013r 2  xx xx xx xx  
000017r 2  xx xx xx xx  
00080Fr 2  xx xx xx xx  proc_name_buf:    .res 32       ; procedure name: length-prefixed
000813r 2  xx xx xx xx  
000817r 2  xx xx xx xx  
00082Fr 2  xx xx xx xx  proc_param_buf:   .res 128      ; packed: count, [len,chars]... each param
000833r 2  xx xx xx xx  
000837r 2  xx xx xx xx  
0008AFr 2  xx           proc_param_end:   .res 1        ; write offset into proc_param_buf
0008B0r 2  xx xx xx xx  proc_editor_title:.res 36       ; "TO <name>" + NUL, passed to the shared editor
0008B4r 2  xx xx xx xx  
0008B8r 2  xx xx xx xx  
0008D4r 2  xx           proc_body_src_lo: .res 1        ; pointer to the body text proc_build_record copies
0008D5r 2  xx           proc_body_src_hi: .res 1
0008D6r 2  xx           proc_edit_cur_lo: .res 1        ; initial editor cursor offset (start of body line)
0008D7r 2  xx           proc_edit_cur_hi: .res 1
0008D8r 2  xx           proc_scan_off_lo: .res 1        ; 16-bit scan offset for body extraction
0008D9r 2  xx           proc_scan_off_hi: .res 1
0008DAr 2  xx           proc_brk_depth:   .res 1        ; bracket/paren nesting depth while accumulating a statement
0008DBr 2               
0008DBr 2               ; Save area for eval state during procedure invocation
0008DBr 2  xx           save_eval_cur_lo: .res 1
0008DCr 2  xx           save_eval_cur_hi: .res 1
0008DDr 2  xx           save_tok_head_lo: .res 1
0008DEr 2  xx           save_tok_head_hi: .res 1
0008DFr 2  xx           save_tok_tail_lo: .res 1
0008E0r 2  xx           save_tok_tail_hi: .res 1
0008E1r 2  xx xx xx xx  save_input_buf:   .res 128      ; save outer input_buf during proc body exec
0008E5r 2  xx xx xx xx  
0008E9r 2  xx xx xx xx  
000961r 2  xx           save_heap_ptr_lo: .res 1        ; save heap for token re-use
000962r 2  xx           save_heap_ptr_hi: .res 1
000963r 2               
000963r 2               ; Param-binding scratch: length-prefixed name built here for var_set
000963r 2  xx xx xx xx  param_name_tmp:   .res 32
000967r 2  xx xx xx xx  
00096Br 2  xx xx xx xx  
000983r 2               
000983r 2               ; =====================================================================
000983r 2               ; CODE segment — procedure routines
000983r 2               ; =====================================================================
000983r 2                     .segment "CODE"
00273Ar 2               
00273Ar 2               ; ---------------------------------------------------------------------
00273Ar 2               ; proc_init — initialize procedure directory to empty
00273Ar 2               ; ---------------------------------------------------------------------
00273Ar 2               proc_init:
00273Ar 2  64 rr              STZ   proc_head_lo
00273Cr 2  64 rr              STZ   proc_head_hi
00273Er 2  64 rr              STZ   proc_stopped
002740r 2  60                 RTS
002741r 2               
002741r 2               ; ---------------------------------------------------------------------
002741r 2               ; proc_collect — enter TO/END multi-line collection mode
002741r 2               ;   Called from main_loop after detecting TO as first token.
002741r 2               ;   eval_cur_lo/hi has been advanced past the TO token.
002741r 2               ; ---------------------------------------------------------------------
002741r 2               proc_collect:
002741r 2                     ; Next token should be the procedure name (TOK_WORD)
002741r 2  A5 rr              LDA   eval_cur_lo
002743r 2  05 rr              ORA   eval_cur_hi
002745r 2  D0 03              BNE   @have_name
002747r 2  4C rr rr           JMP   @err_noname
00274Ar 2               @have_name:
00274Ar 2  A5 rr              LDA   eval_cur_lo
00274Cr 2  85 rr              STA   ptr_lo
00274Er 2  A5 rr              LDA   eval_cur_hi
002750r 2  85 rr              STA   ptr_hi
002752r 2  A0 00              LDY   #TOK_TAG
002754r 2  B1 rr              LDA   (ptr_lo),Y
002756r 2  C9 01              CMP   #TOK_WORD
002758r 2  F0 03              BEQ   @name_ok
00275Ar 2  4C rr rr           JMP   @err_noname
00275Dr 2               @name_ok:
00275Dr 2                     ; Copy procedure name to proc_name_buf (length-prefixed)
00275Dr 2  A0 03              LDY   #TOK_PAYLOAD
00275Fr 2  B1 rr              LDA   (ptr_lo),Y           ; name length
002761r 2  8D rr rr           STA   proc_name_buf
002764r 2  85 rr              STA   proc_name_len
002766r 2  AA                 TAX                         ; X = char count
002767r 2  A0 04              LDY   #TOK_PAYLOAD+1
002769r 2  A9 00              LDA   #0
00276Br 2  85 rr              STA   proc_rec_off          ; dest index in name_buf
00276Dr 2               @copy_name:
00276Dr 2  E0 00              CPX   #0
00276Fr 2  F0 0F              BEQ   @name_copied
002771r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased by tokenizer
002773r 2  5A                 PHY
002774r 2  A4 rr              LDY   proc_rec_off
002776r 2  99 rr rr           STA   proc_name_buf+1,Y
002779r 2  E6 rr              INC   proc_rec_off
00277Br 2  7A                 PLY
00277Cr 2  C8                 INY
00277Dr 2  CA                 DEX
00277Er 2  80 ED              BRA   @copy_name
002780r 2               @name_copied:
002780r 2               
002780r 2                     ; Advance past the name token
002780r 2  20 rr rr           JSR   eval_advance
002783r 2               
002783r 2                     ; Parse parameter names (TOK_VARREF tokens: :SIZE :COLOR etc.)
002783r 2  64 rr              STZ   proc_param_cnt
002785r 2  A9 01              LDA   #1                    ; dest offset (skip count byte at [0])
002787r 2  8D rr rr           STA   proc_param_end
00278Ar 2               
00278Ar 2               @parse_params:
00278Ar 2  A5 rr              LDA   eval_cur_lo
00278Cr 2  05 rr              ORA   eval_cur_hi
00278Er 2  F0 47              BEQ   @params_done
002790r 2  A5 rr              LDA   eval_cur_lo
002792r 2  85 rr              STA   ptr_lo
002794r 2  A5 rr              LDA   eval_cur_hi
002796r 2  85 rr              STA   ptr_hi
002798r 2  A0 00              LDY   #TOK_TAG
00279Ar 2  B1 rr              LDA   (ptr_lo),Y
00279Cr 2  C9 05              CMP   #TOK_VARREF
00279Er 2  D0 37              BNE   @params_done
0027A0r 2               
0027A0r 2  E6 rr              INC   proc_param_cnt
0027A2r 2  A0 03              LDY   #TOK_PAYLOAD
0027A4r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
0027A6r 2  AE rr rr           LDX   proc_param_end
0027A9r 2  9D rr rr           STA   proc_param_buf,X     ; store length
0027ACr 2  E8                 INX
0027ADr 2  A8                 TAY                         ; Y = char count to copy
0027AEr 2  64 rr              STZ   proc_rec_off          ; source char index
0027B0r 2               
0027B0r 2               @copy_param_ch:
0027B0r 2  C0 00              CPY   #0
0027B2r 2  F0 1B              BEQ   @param_ch_done
0027B4r 2                     ; Read source char from token
0027B4r 2  A5 rr              LDA   eval_cur_lo
0027B6r 2  85 rr              STA   ptr_lo
0027B8r 2  A5 rr              LDA   eval_cur_hi
0027BAr 2  85 rr              STA   ptr_hi
0027BCr 2  5A                 PHY
0027BDr 2  A5 rr              LDA   proc_rec_off
0027BFr 2  18                 CLC
0027C0r 2  69 04              ADC   #TOK_PAYLOAD+1
0027C2r 2  A8                 TAY
0027C3r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased
0027C5r 2  7A                 PLY
0027C6r 2                     ; Write to proc_param_buf
0027C6r 2  9D rr rr           STA   proc_param_buf,X
0027C9r 2  E8                 INX
0027CAr 2  E6 rr              INC   proc_rec_off
0027CCr 2  88                 DEY
0027CDr 2  80 E1              BRA   @copy_param_ch
0027CFr 2               @param_ch_done:
0027CFr 2  8E rr rr           STX   proc_param_end
0027D2r 2               
0027D2r 2  20 rr rr           JSR   eval_advance
0027D5r 2  80 B3              BRA   @parse_params
0027D7r 2               
0027D7r 2               @params_done:
0027D7r 2  A5 rr              LDA   proc_param_cnt
0027D9r 2  8D rr rr           STA   proc_param_buf        ; count byte at [0]
0027DCr 2               
0027DCr 2                     ; Initialize body buffer
0027DCr 2  64 rr              STZ   proc_body_len_lo
0027DEr 2  64 rr              STZ   proc_body_len_hi
0027E0r 2               
0027E0r 2                     ; Open the shared EDITUI editor on an empty body buffer. Carry set means
0027E0r 2                     ; the user asked to save (Ctrl-S / "Save First") before exiting.
0027E0r 2  20 rr rr           JSR   proc_open_editor
0027E3r 2  B0 01              BCS   @body_done
0027E5r 2  60                 RTS
0027E6r 2               
0027E6r 2                     ; Print "NAME DEFINED\n"
0027E6r 2               @body_done:
0027E6r 2  A6 rr              LDX   proc_name_len
0027E8r 2  A0 00              LDY   #0
0027EAr 2               @print_name:
0027EAr 2  E0 00              CPX   #0
0027ECr 2  F0 0A              BEQ   @print_def
0027EEr 2  B9 rr rr           LDA   proc_name_buf+1,Y
0027F1r 2  8D 0E A0           STA   VGC_CHAROUT
0027F4r 2  C8                 INY
0027F5r 2  CA                 DEX
0027F6r 2  80 F2              BRA   @print_name
0027F8r 2               @print_def:
0027F8r 2  A2 00              LDX   #0
0027FAr 2               @pd_lp:
0027FAr 2  BD rr rr           LDA   str_defined,X
0027FDr 2  F0 06              BEQ   @pd_done
0027FFr 2  8D 0E A0           STA   VGC_CHAROUT
002802r 2  E8                 INX
002803r 2  D0 F5              BNE   @pd_lp
002805r 2               @pd_done:
002805r 2  20 rr rr           JSR   eval_newline
002808r 2  60                 RTS
002809r 2               
002809r 2               @err_noname:
002809r 2  A2 00              LDX   #0
00280Br 2               @en_lp:
00280Br 2  BD rr rr           LDA   str_to_needs_name,X
00280Er 2  F0 06              BEQ   @en_done
002810r 2  8D 0E A0           STA   VGC_CHAROUT
002813r 2  E8                 INX
002814r 2  D0 F5              BNE   @en_lp
002816r 2               @en_done:
002816r 2  20 rr rr           JSR   eval_newline
002819r 2  60                 RTS
00281Ar 2               
00281Ar 2               ; ---------------------------------------------------------------------
00281Ar 2               ; proc_open_editor — run the shared EDITUI editor on an empty body buffer.
00281Ar 2               ;   Builds the editor title "TO <name>", hands the buffer/cap/title to the
00281Ar 2               ;   extension's EXT_CMD_EDIT, then on return builds the procedure record from
00281Ar 2               ;   the edited body when the user asked to save.
00281Ar 2               ;   Inputs:  proc_name_buf / proc_name_len, proc_param_buf (already parsed)
00281Ar 2               ;   Returns: carry set = saved (record built), carry clear = abandoned
00281Ar 2               ; ---------------------------------------------------------------------
00281Ar 2               proc_open_editor:
00281Ar 2                     ; --- build the scaffold "TO <name> :params\n  \nEND\n" in proc_body_buf.
00281Ar 2                     ; Y is the 8-bit write index (the scaffold is always < 256 bytes: name<=31,
00281Ar 2                     ; params<=127, plus a dozen structure bytes).
00281Ar 2  A0 00              LDY   #0
00281Cr 2  A9 54              LDA   #'T'
00281Er 2  99 rr rr           STA   proc_body_buf,Y
002821r 2  C8                 INY
002822r 2  A9 4F              LDA   #'O'
002824r 2  99 rr rr           STA   proc_body_buf,Y
002827r 2  C8                 INY
002828r 2  A9 20              LDA   #' '
00282Ar 2  99 rr rr           STA   proc_body_buf,Y
00282Dr 2  C8                 INY
00282Er 2  A2 00              LDX   #0                     ; name source index
002830r 2               @nm:
002830r 2  E4 rr              CPX   proc_name_len
002832r 2  B0 0A              BCS   @nm_done
002834r 2  BD rr rr           LDA   proc_name_buf+1,X
002837r 2  99 rr rr           STA   proc_body_buf,Y
00283Ar 2  C8                 INY
00283Br 2  E8                 INX
00283Cr 2  80 F2              BRA   @nm
00283Er 2               @nm_done:
00283Er 2                     ; params: " :" + chars, walking proc_param_buf[1..proc_param_end)
00283Er 2  A2 01              LDX   #1
002840r 2               @pp:
002840r 2  EC rr rr           CPX   proc_param_end
002843r 2  B0 22              BCS   @pp_done
002845r 2  A9 20              LDA   #' '
002847r 2  99 rr rr           STA   proc_body_buf,Y
00284Ar 2  C8                 INY
00284Br 2  A9 3A              LDA   #':'
00284Dr 2  99 rr rr           STA   proc_body_buf,Y
002850r 2  C8                 INY
002851r 2  BD rr rr           LDA   proc_param_buf,X       ; this param's char count
002854r 2  85 rr              STA   proc_rec_off
002856r 2  E8                 INX
002857r 2               @ppc:
002857r 2  A5 rr              LDA   proc_rec_off
002859r 2  F0 E5              BEQ   @pp
00285Br 2  BD rr rr           LDA   proc_param_buf,X
00285Er 2  99 rr rr           STA   proc_body_buf,Y
002861r 2  C8                 INY
002862r 2  E8                 INX
002863r 2  C6 rr              DEC   proc_rec_off
002865r 2  80 F0              BRA   @ppc
002867r 2               @pp_done:
002867r 2                     ; Y = line-1 length. The body line is line 1's '\n' + 2 indent spaces,
002867r 2                     ; so the cursor lands at offset (line1 + 3).
002867r 2  98                 TYA
002868r 2  18                 CLC
002869r 2  69 03              ADC   #3
00286Br 2  8D rr rr           STA   proc_edit_cur_lo
00286Er 2  A9 00              LDA   #0
002870r 2  69 00              ADC   #0
002872r 2  8D rr rr           STA   proc_edit_cur_hi
002875r 2                     ; append "\n  \nEND\n"
002875r 2  A9 0A              LDA   #$0A
002877r 2  99 rr rr           STA   proc_body_buf,Y
00287Ar 2  C8                 INY
00287Br 2  A9 20              LDA   #' '
00287Dr 2  99 rr rr           STA   proc_body_buf,Y
002880r 2  C8                 INY
002881r 2  99 rr rr           STA   proc_body_buf,Y
002884r 2  C8                 INY
002885r 2  A9 0A              LDA   #$0A
002887r 2  99 rr rr           STA   proc_body_buf,Y
00288Ar 2  C8                 INY
00288Br 2  A9 45              LDA   #'E'
00288Dr 2  99 rr rr           STA   proc_body_buf,Y
002890r 2  C8                 INY
002891r 2  A9 4E              LDA   #'N'
002893r 2  99 rr rr           STA   proc_body_buf,Y
002896r 2  C8                 INY
002897r 2  A9 44              LDA   #'D'
002899r 2  99 rr rr           STA   proc_body_buf,Y
00289Cr 2  C8                 INY
00289Dr 2  A9 0A              LDA   #$0A
00289Fr 2  99 rr rr           STA   proc_body_buf,Y
0028A2r 2  C8                 INY
0028A3r 2  84 rr              STY   proc_body_len_lo
0028A5r 2  64 rr              STZ   proc_body_len_hi
0028A7r 2               
0028A7r 2                     ; --- title "TO <name>" + NUL for the editor's title band ---
0028A7r 2  A9 54              LDA   #'T'
0028A9r 2  8D rr rr           STA   proc_editor_title+0
0028ACr 2  A9 4F              LDA   #'O'
0028AEr 2  8D rr rr           STA   proc_editor_title+1
0028B1r 2  A9 20              LDA   #' '
0028B3r 2  8D rr rr           STA   proc_editor_title+2
0028B6r 2  A2 00              LDX   #0
0028B8r 2  A0 03              LDY   #3
0028BAr 2               @tt:
0028BAr 2  E4 rr              CPX   proc_name_len
0028BCr 2  B0 0A              BCS   @tt_done
0028BEr 2  BD rr rr           LDA   proc_name_buf+1,X
0028C1r 2  99 rr rr           STA   proc_editor_title,Y
0028C4r 2  E8                 INX
0028C5r 2  C8                 INY
0028C6r 2  80 F2              BRA   @tt
0028C8r 2               @tt_done:
0028C8r 2  A9 00              LDA   #0
0028CAr 2  99 rr rr           STA   proc_editor_title,Y
0028CDr 2               
0028CDr 2                     ; --- mailbox: ARG0=buf ARG1=len ARG2=cap ARG3=title; cursor in FRAC bytes
0028CDr 2  A9 rr              LDA   #<proc_body_buf
0028CFr 2  85 84              STA   EXT_ARG0_LO
0028D1r 2  A9 rr              LDA   #>proc_body_buf
0028D3r 2  85 83              STA   EXT_ARG0_HI
0028D5r 2  A5 rr              LDA   proc_body_len_lo
0028D7r 2  85 88              STA   EXT_ARG1_LO
0028D9r 2  A5 rr              LDA   proc_body_len_hi
0028DBr 2  85 87              STA   EXT_ARG1_HI
0028DDr 2  A9 00              LDA   #<2048
0028DFr 2  85 8C              STA   EXT_ARG2_LO
0028E1r 2  A9 08              LDA   #>2048
0028E3r 2  85 8B              STA   EXT_ARG2_HI
0028E5r 2  A9 rr              LDA   #<proc_editor_title
0028E7r 2  85 A1              STA   EXT_ARG3_LO
0028E9r 2  A9 rr              LDA   #>proc_editor_title
0028EBr 2  85 A0              STA   EXT_ARG3_HI
0028EDr 2  AD rr rr           LDA   proc_edit_cur_lo
0028F0r 2  85 8D              STA   EXT_ARG2_FRAC          ; initial cursor offset (see ext_iface.inc)
0028F2r 2  AD rr rr           LDA   proc_edit_cur_hi
0028F5r 2  85 A2              STA   EXT_ARG3_FRAC
0028F7r 2               
0028F7r 2  A9 4B              LDA   #EXT_CMD_EDIT
0028F9r 2  85 80              STA   EXT_CMD
0028FBr 2  20 70 02           JSR   EXT_TRAMPOLINE         ; swap to ext ROM, run editor, swap back
0028FEr 2               
0028FEr 2                     ; editor returns the final buffer length in ARG1
0028FEr 2  A5 88              LDA   EXT_ARG1_LO
002900r 2  85 rr              STA   proc_body_len_lo
002902r 2  A5 87              LDA   EXT_ARG1_HI
002904r 2  85 rr              STA   proc_body_len_hi
002906r 2               
002906r 2  A5 8F              LDA   EXT_RESULT_HI
002908r 2  F0 08              BEQ   @abandoned
00290Ar 2                     ; Strip line 1 + the END line -> proc_body_src/proc_body_len = body only.
00290Ar 2  20 rr rr           JSR   proc_extract_body
00290Dr 2  20 rr rr           JSR   proc_build_record
002910r 2  38                 SEC
002911r 2  60                 RTS
002912r 2               @abandoned:
002912r 2  18                 CLC
002913r 2  60                 RTS
002914r 2               
002914r 2               ; ---------------------------------------------------------------------
002914r 2               ; proc_extract_body — narrow proc_body_buf/proc_body_len down to just the body:
002914r 2               ;   everything after the first '\n' (line 1) up to (not including) the line that
002914r 2               ;   reads "END". Sets proc_body_src_lo/hi + proc_body_len_lo/hi.
002914r 2               ; ---------------------------------------------------------------------
002914r 2               proc_extract_body:
002914r 2  A9 rr              LDA   #<proc_body_buf
002916r 2  85 rr              STA   proc_ptr_lo
002918r 2  A9 rr              LDA   #>proc_body_buf
00291Ar 2  85 rr              STA   proc_ptr_hi
00291Cr 2  9C rr rr           STZ   proc_scan_off_lo
00291Fr 2  9C rr rr           STZ   proc_scan_off_hi
002922r 2               @find_nl:
002922r 2  20 rr rr           JSR   proc_scan_at_end
002925r 2  B0 4F              BCS   @whole                ; no newline -> whole buffer is the body
002927r 2  A0 00              LDY   #0
002929r 2  B1 rr              LDA   (proc_ptr_lo),Y
00292Br 2  20 rr rr           JSR   proc_scan_advance
00292Er 2  C9 0A              CMP   #$0A
002930r 2  D0 F0              BNE   @find_nl
002932r 2                     ; body starts here
002932r 2  A5 rr              LDA   proc_ptr_lo
002934r 2  8D rr rr           STA   proc_body_src_lo
002937r 2  A5 rr              LDA   proc_ptr_hi
002939r 2  8D rr rr           STA   proc_body_src_hi
00293Cr 2  AD rr rr           LDA   proc_scan_off_lo
00293Fr 2  8D rr rr           STA   num_tmp_lo            ; body-start offset
002942r 2  AD rr rr           LDA   proc_scan_off_hi
002945r 2  8D rr rr           STA   num_tmp_hi
002948r 2               @line:
002948r 2  20 rr rr           JSR   proc_scan_at_end
00294Br 2  B0 17              BCS   @body_end             ; ran off the end -> body = rest
00294Dr 2  20 rr rr           JSR   proc_line_is_end
002950r 2  B0 12              BCS   @body_end             ; this line is "END" -> stop
002952r 2               @skip:
002952r 2  20 rr rr           JSR   proc_scan_at_end
002955r 2  B0 0D              BCS   @body_end
002957r 2  A0 00              LDY   #0
002959r 2  B1 rr              LDA   (proc_ptr_lo),Y
00295Br 2  20 rr rr           JSR   proc_scan_advance
00295Er 2  C9 0A              CMP   #$0A
002960r 2  D0 F0              BNE   @skip
002962r 2  80 E4              BRA   @line
002964r 2               @body_end:
002964r 2  38                 SEC
002965r 2  AD rr rr           LDA   proc_scan_off_lo
002968r 2  ED rr rr           SBC   num_tmp_lo
00296Br 2  85 rr              STA   proc_body_len_lo
00296Dr 2  AD rr rr           LDA   proc_scan_off_hi
002970r 2  ED rr rr           SBC   num_tmp_hi
002973r 2  85 rr              STA   proc_body_len_hi
002975r 2  60                 RTS
002976r 2               @whole:
002976r 2  A9 rr              LDA   #<proc_body_buf
002978r 2  8D rr rr           STA   proc_body_src_lo
00297Br 2  A9 rr              LDA   #>proc_body_buf
00297Dr 2  8D rr rr           STA   proc_body_src_hi
002980r 2  60                 RTS
002981r 2               
002981r 2               ; carry set if proc_scan_off >= proc_body_len
002981r 2               proc_scan_at_end:
002981r 2  AD rr rr           LDA   proc_scan_off_lo
002984r 2  C5 rr              CMP   proc_body_len_lo
002986r 2  AD rr rr           LDA   proc_scan_off_hi
002989r 2  E5 rr              SBC   proc_body_len_hi
00298Br 2  60                 RTS
00298Cr 2               
00298Cr 2               ; advance the scan pointer + offset by one byte
00298Cr 2               proc_scan_advance:
00298Cr 2  E6 rr              INC   proc_ptr_lo
00298Er 2  D0 02              BNE   :+
002990r 2  E6 rr              INC   proc_ptr_hi
002992r 2  EE rr rr     :     INC   proc_scan_off_lo
002995r 2  D0 03              BNE   :+
002997r 2  EE rr rr           INC   proc_scan_off_hi
00299Ar 2  60           :     RTS
00299Br 2               
00299Br 2               ; proc_line_is_end — carry set if the line at proc_ptr is exactly "END" followed
00299Br 2               ; by '\n' or end-of-buffer. Needs room for 3 chars (off+3 <= len). Non-destructive.
00299Br 2               proc_line_is_end:
00299Br 2                     ; proc_entry = proc_scan_off + 3
00299Br 2  18                 CLC
00299Cr 2  AD rr rr           LDA   proc_scan_off_lo
00299Fr 2  69 03              ADC   #3
0029A1r 2  85 rr              STA   proc_entry_lo
0029A3r 2  AD rr rr           LDA   proc_scan_off_hi
0029A6r 2  69 00              ADC   #0
0029A8r 2  85 rr              STA   proc_entry_hi
0029AAr 2                     ; need off+3 <= len, i.e. NOT (off+3 > len) == NOT (len < off+3)
0029AAr 2  A5 rr              LDA   proc_body_len_lo
0029ACr 2  C5 rr              CMP   proc_entry_lo
0029AEr 2  A5 rr              LDA   proc_body_len_hi
0029B0r 2  E5 rr              SBC   proc_entry_hi
0029B2r 2  90 2B              BCC   @no                   ; len < off+3 -> not enough room
0029B4r 2  A0 00              LDY   #0
0029B6r 2  B1 rr              LDA   (proc_ptr_lo),Y
0029B8r 2  C9 45              CMP   #'E'
0029BAr 2  D0 23              BNE   @no
0029BCr 2  C8                 INY
0029BDr 2  B1 rr              LDA   (proc_ptr_lo),Y
0029BFr 2  C9 4E              CMP   #'N'
0029C1r 2  D0 1C              BNE   @no
0029C3r 2  C8                 INY
0029C4r 2  B1 rr              LDA   (proc_ptr_lo),Y
0029C6r 2  C9 44              CMP   #'D'
0029C8r 2  D0 15              BNE   @no
0029CAr 2                     ; 4th byte: '\n', or off+3 == len (END at buffer end)
0029CAr 2  A5 rr              LDA   proc_entry_lo
0029CCr 2  C5 rr              CMP   proc_body_len_lo
0029CEr 2  D0 06              BNE   @check_nl
0029D0r 2  A5 rr              LDA   proc_entry_hi
0029D2r 2  C5 rr              CMP   proc_body_len_hi
0029D4r 2  F0 07              BEQ   @yes                  ; off+3 == len
0029D6r 2               @check_nl:
0029D6r 2  C8                 INY
0029D7r 2  B1 rr              LDA   (proc_ptr_lo),Y
0029D9r 2  C9 0A              CMP   #$0A
0029DBr 2  D0 02              BNE   @no
0029DDr 2               @yes:
0029DDr 2  38                 SEC
0029DEr 2  60                 RTS
0029DFr 2               @no:
0029DFr 2  18                 CLC
0029E0r 2  60                 RTS
0029E1r 2               
0029E1r 2               ; ---------------------------------------------------------------------
0029E1r 2               ; heap_alloc_big — allocate for procedure records (16-bit payload)
0029E1r 2               ;   Input:  proc_ptr_lo/hi = record data size (16-bit)
0029E1r 2               ;   Output: proc_entry_lo/hi = pointer to record data (payload+2)
0029E1r 2               ;           Carry clear = success, Carry set = OOM
0029E1r 2               ;
0029E1r 2               ;   Layout: [GC_HDR_TAG, GC_HDR_SIZE=0, total_lo, total_hi, ...data...]
0029E1r 2               ;   GC header (2 bytes) + 16-bit size (2 bytes) + record data.
0029E1r 2               ;   Total allocation = record_data_size + 4.
0029E1r 2               ;   GC_HDR_SIZE = 0 tells GC to read 16-bit total from payload[0..1].
0029E1r 2               ;   proc_entry points to data (base+4).
0029E1r 2               ;
0029E1r 2               ;   Clobbers: A, Y, ptr_lo/hi
0029E1r 2               ; ---------------------------------------------------------------------
0029E1r 2               heap_alloc_big:
0029E1r 2                     ; Total allocation = data_size + 4 (2 hdr + 2 size field)
0029E1r 2  18                 CLC
0029E2r 2  A5 rr              LDA   proc_ptr_lo
0029E4r 2  69 04              ADC   #4
0029E6r 2  48                 PHA                        ; save total_lo
0029E7r 2  A5 rr              LDA   proc_ptr_hi
0029E9r 2  69 00              ADC   #0
0029EBr 2  48                 PHA                        ; save total_hi
0029ECr 2               
0029ECr 2                     ; Save current heap_ptr as base
0029ECr 2  A5 rr              LDA   heap_ptr
0029EEr 2  85 rr              STA   proc_entry_lo
0029F0r 2  A5 rr              LDA   heap_ptr+1
0029F2r 2  85 rr              STA   proc_entry_hi
0029F4r 2               
0029F4r 2                     ; Advance heap_ptr by total
0029F4r 2  BA                 TSX
0029F5r 2  18                 CLC
0029F6r 2  A5 rr              LDA   heap_ptr
0029F8r 2  7D 02 01           ADC   $0102,X              ; total_lo
0029FBr 2  85 rr              STA   heap_ptr
0029FDr 2  A5 rr              LDA   heap_ptr+1
0029FFr 2  7D 01 01           ADC   $0101,X              ; total_hi
002A02r 2  85 rr              STA   heap_ptr+1
002A04r 2               
002A04r 2                     ; OOM check
002A04r 2  C9 98              CMP   #>HEAP_END
002A06r 2  90 16              BCC   @big_ok
002A08r 2  D0 08              BNE   @big_oom
002A0Ar 2  A5 rr              LDA   heap_ptr
002A0Cr 2  C9 00              CMP   #<HEAP_END
002A0Er 2  90 0E              BCC   @big_ok
002A10r 2  F0 0C              BEQ   @big_ok
002A12r 2               @big_oom:
002A12r 2  A5 rr              LDA   proc_entry_lo
002A14r 2  85 rr              STA   heap_ptr
002A16r 2  A5 rr              LDA   proc_entry_hi
002A18r 2  85 rr              STA   heap_ptr+1
002A1Ar 2  68                 PLA
002A1Br 2  68                 PLA
002A1Cr 2  38                 SEC
002A1Dr 2  60                 RTS
002A1Er 2               @big_ok:
002A1Er 2                     ; Write header at base (proc_entry = base here)
002A1Er 2  A5 rr              LDA   proc_entry_lo
002A20r 2  85 rr              STA   ptr_lo
002A22r 2  A5 rr              LDA   proc_entry_hi
002A24r 2  85 rr              STA   ptr_hi
002A26r 2               
002A26r 2  A0 00              LDY   #GC_HDR_TAG
002A28r 2  A9 04              LDA   #ATYPE_PROC
002A2Ar 2  91 rr              STA   (ptr_lo),Y
002A2Cr 2               
002A2Cr 2  A0 01              LDY   #GC_HDR_SIZE
002A2Er 2  A9 00              LDA   #0                    ; 0 = 16-bit size at payload[0..1]
002A30r 2  91 rr              STA   (ptr_lo),Y
002A32r 2               
002A32r 2                     ; Write 16-bit total at payload offsets 0,1 (base+2, base+3)
002A32r 2  68                 PLA                        ; total_hi
002A33r 2  A0 03              LDY   #GC_HDR_BYTES+1       ; base+3
002A35r 2  91 rr              STA   (ptr_lo),Y
002A37r 2  68                 PLA                        ; total_lo
002A38r 2  A0 02              LDY   #GC_HDR_BYTES         ; base+2
002A3Ar 2  91 rr              STA   (ptr_lo),Y
002A3Cr 2               
002A3Cr 2                     ; Advance proc_entry to point past header+size field = base+4
002A3Cr 2                     ; This is where the record data starts
002A3Cr 2  18                 CLC
002A3Dr 2  A5 rr              LDA   proc_entry_lo
002A3Fr 2  69 04              ADC   #4
002A41r 2  85 rr              STA   proc_entry_lo
002A43r 2  A5 rr              LDA   proc_entry_hi
002A45r 2  69 00              ADC   #0
002A47r 2  85 rr              STA   proc_entry_hi
002A49r 2               
002A49r 2  18                 CLC
002A4Ar 2  60                 RTS
002A4Br 2               
002A4Br 2               ; ---------------------------------------------------------------------
002A4Br 2               ; proc_build_record — allocate and populate a procedure heap record
002A4Br 2               ;   Uses: proc_name_buf, proc_param_buf/proc_param_end,
002A4Br 2               ;         proc_body_buf/proc_body_len
002A4Br 2               ; ---------------------------------------------------------------------
002A4Br 2               proc_build_record:
002A4Br 2                     ; Calculate total record size
002A4Br 2                     ; 2 (next) + 1 (name_len) + name_len
002A4Br 2                     ; + 1 (param_count) + (proc_param_end - 1) param packed bytes
002A4Br 2                     ; + 2 (body_len) + body_len
002A4Br 2                     ;
002A4Br 2                     ; We build the total in proc_ptr_lo:proc_ptr_hi (16-bit)
002A4Br 2               
002A4Br 2  A9 04              LDA   #4                    ; 2(next) + 1(name_len) + 1(param_count)
002A4Dr 2  18                 CLC
002A4Er 2  6D rr rr           ADC   proc_name_buf         ; + name_len
002A51r 2  85 rr              STA   proc_ptr_lo
002A53r 2  A9 00              LDA   #0
002A55r 2  85 rr              STA   proc_ptr_hi
002A57r 2               
002A57r 2                     ; + param packed bytes (proc_param_end - 1)
002A57r 2  AD rr rr           LDA   proc_param_end
002A5Ar 2  38                 SEC
002A5Br 2  E9 01              SBC   #1
002A5Dr 2  18                 CLC
002A5Er 2  65 rr              ADC   proc_ptr_lo
002A60r 2  85 rr              STA   proc_ptr_lo
002A62r 2  90 02              BCC   :+
002A64r 2  E6 rr              INC   proc_ptr_hi
002A66r 2               :
002A66r 2                     ; + 2 (body_len field)
002A66r 2  18                 CLC
002A67r 2  A5 rr              LDA   proc_ptr_lo
002A69r 2  69 02              ADC   #2
002A6Br 2  85 rr              STA   proc_ptr_lo
002A6Dr 2  90 02              BCC   :+
002A6Fr 2  E6 rr              INC   proc_ptr_hi
002A71r 2               :
002A71r 2                     ; + body_len
002A71r 2  18                 CLC
002A72r 2  A5 rr              LDA   proc_ptr_lo
002A74r 2  65 rr              ADC   proc_body_len_lo
002A76r 2  85 rr              STA   proc_ptr_lo
002A78r 2  A5 rr              LDA   proc_ptr_hi
002A7Ar 2  65 rr              ADC   proc_body_len_hi
002A7Cr 2  85 rr              STA   proc_ptr_hi
002A7Er 2               
002A7Er 2                     ; Allocate with GC header (16-bit size via heap_alloc_big)
002A7Er 2                     ; proc_ptr_lo/hi = payload size
002A7Er 2  20 rr rr           JSR   heap_alloc_big
002A81r 2  90 01              BCC   @ok
002A83r 2  60                 RTS                        ; OOM
002A84r 2               @ok:
002A84r 2                     ; Fill the record using (ptr_lo),Y indirect addressing
002A84r 2                     ; We track Y as the write offset. For records > 256 bytes
002A84r 2                     ; we bump ptr_hi when Y wraps.
002A84r 2  A5 rr              LDA   proc_entry_lo
002A86r 2  85 rr              STA   ptr_lo
002A88r 2  A5 rr              LDA   proc_entry_hi
002A8Ar 2  85 rr              STA   ptr_hi
002A8Cr 2               
002A8Cr 2                     ; +0,+1: next pointer = current proc_head
002A8Cr 2  A0 00              LDY   #0
002A8Er 2  A5 rr              LDA   proc_head_lo
002A90r 2  91 rr              STA   (ptr_lo),Y
002A92r 2  C8                 INY
002A93r 2  A5 rr              LDA   proc_head_hi
002A95r 2  91 rr              STA   (ptr_lo),Y
002A97r 2               
002A97r 2                     ; +2: name_len
002A97r 2  C8                 INY
002A98r 2  AD rr rr           LDA   proc_name_buf
002A9Br 2  91 rr              STA   (ptr_lo),Y
002A9Dr 2               
002A9Dr 2                     ; +3..+3+NL-1: name chars
002A9Dr 2  AE rr rr           LDX   proc_name_buf         ; X = char count
002AA0r 2  64 rr              STZ   proc_rec_off          ; source index
002AA2r 2               @bld_name:
002AA2r 2  E0 00              CPX   #0
002AA4r 2  F0 13              BEQ   @bld_name_done
002AA6r 2  C8                 INY
002AA7r 2  D0 02              BNE   :+
002AA9r 2  E6 rr              INC   ptr_hi
002AABr 2  DA           :     PHX
002AACr 2  A6 rr              LDX   proc_rec_off
002AAEr 2  BD rr rr           LDA   proc_name_buf+1,X
002AB1r 2  FA                 PLX
002AB2r 2  91 rr              STA   (ptr_lo),Y
002AB4r 2  E6 rr              INC   proc_rec_off
002AB6r 2  CA                 DEX
002AB7r 2  80 E9              BRA   @bld_name
002AB9r 2               @bld_name_done:
002AB9r 2               
002AB9r 2                     ; +3+NL: param_count
002AB9r 2  C8                 INY
002ABAr 2  D0 02              BNE   :+
002ABCr 2  E6 rr              INC   ptr_hi
002ABEr 2  A5 rr        :     LDA   proc_param_cnt
002AC0r 2  91 rr              STA   (ptr_lo),Y
002AC2r 2               
002AC2r 2                     ; Copy packed param data from proc_param_buf[1..proc_param_end-1]
002AC2r 2  AD rr rr           LDA   proc_param_end
002AC5r 2  C9 02              CMP   #2                    ; at least 1 = there are params
002AC7r 2  90 14              BCC   @bld_params_done
002AC9r 2  A2 01              LDX   #1                    ; source index (skip count byte)
002ACBr 2               @bld_param:
002ACBr 2  EC rr rr           CPX   proc_param_end
002ACEr 2  B0 0D              BCS   @bld_params_done
002AD0r 2  C8                 INY
002AD1r 2  D0 02              BNE   :+
002AD3r 2  E6 rr              INC   ptr_hi
002AD5r 2  BD rr rr     :     LDA   proc_param_buf,X
002AD8r 2  91 rr              STA   (ptr_lo),Y
002ADAr 2  E8                 INX
002ADBr 2  80 EE              BRA   @bld_param
002ADDr 2               @bld_params_done:
002ADDr 2               
002ADDr 2                     ; body_len_lo, body_len_hi
002ADDr 2  C8                 INY
002ADEr 2  D0 02              BNE   :+
002AE0r 2  E6 rr              INC   ptr_hi
002AE2r 2  A5 rr        :     LDA   proc_body_len_lo
002AE4r 2  91 rr              STA   (ptr_lo),Y
002AE6r 2  C8                 INY
002AE7r 2  D0 02              BNE   :+
002AE9r 2  E6 rr              INC   ptr_hi
002AEBr 2  A5 rr        :     LDA   proc_body_len_hi
002AEDr 2  91 rr              STA   (ptr_lo),Y
002AEFr 2               
002AEFr 2                     ; Copy body text (proc_body_src points at the body region of the buffer)
002AEFr 2  A5 rr              LDA   proc_body_len_lo
002AF1r 2  05 rr              ORA   proc_body_len_hi
002AF3r 2  F0 3A              BEQ   @bld_body_done
002AF5r 2               
002AF5r 2  AD rr rr           LDA   proc_body_src_lo
002AF8r 2  85 rr              STA   proc_ptr_lo
002AFAr 2  AD rr rr           LDA   proc_body_src_hi
002AFDr 2  85 rr              STA   proc_ptr_hi
002AFFr 2                     ; 16-bit counter
002AFFr 2  A5 rr              LDA   proc_body_len_lo
002B01r 2  8D rr rr           STA   num_tmp_lo
002B04r 2  A5 rr              LDA   proc_body_len_hi
002B06r 2  8D rr rr           STA   num_tmp_hi
002B09r 2               
002B09r 2               @bld_body:
002B09r 2  C8                 INY
002B0Ar 2  D0 02              BNE   :+
002B0Cr 2  E6 rr              INC   ptr_hi
002B0Er 2  5A           :     PHY
002B0Fr 2  A0 00              LDY   #0
002B11r 2  B1 rr              LDA   (proc_ptr_lo),Y
002B13r 2  7A                 PLY
002B14r 2  91 rr              STA   (ptr_lo),Y
002B16r 2                     ; Advance source
002B16r 2  E6 rr              INC   proc_ptr_lo
002B18r 2  D0 02              BNE   :+
002B1Ar 2  E6 rr              INC   proc_ptr_hi
002B1Cr 2               :     ; Decrement counter
002B1Cr 2  AD rr rr           LDA   num_tmp_lo
002B1Fr 2  D0 03              BNE   @bld_dec_lo
002B21r 2  CE rr rr           DEC   num_tmp_hi
002B24r 2               @bld_dec_lo:
002B24r 2  CE rr rr           DEC   num_tmp_lo
002B27r 2  AD rr rr           LDA   num_tmp_lo
002B2Ar 2  0D rr rr           ORA   num_tmp_hi
002B2Dr 2  D0 DA              BNE   @bld_body
002B2Fr 2               
002B2Fr 2               @bld_body_done:
002B2Fr 2                     ; Prepend to directory
002B2Fr 2  A5 rr              LDA   proc_entry_lo
002B31r 2  85 rr              STA   proc_head_lo
002B33r 2  A5 rr              LDA   proc_entry_hi
002B35r 2  85 rr              STA   proc_head_hi
002B37r 2  60                 RTS
002B38r 2               
002B38r 2               ; ---------------------------------------------------------------------
002B38r 2               ; proc_lookup — search for a procedure by name
002B38r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
002B38r 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002B38r 2               ;           carry set = not found
002B38r 2               ; ---------------------------------------------------------------------
002B38r 2               proc_lookup:
002B38r 2  A5 rr              LDA   proc_head_lo
002B3Ar 2  85 rr              STA   proc_entry_lo
002B3Cr 2  A5 rr              LDA   proc_head_hi
002B3Er 2  85 rr              STA   proc_entry_hi
002B40r 2               
002B40r 2               @walk:
002B40r 2  A5 rr              LDA   proc_entry_lo
002B42r 2  05 rr              ORA   proc_entry_hi
002B44r 2  F0 1D              BEQ   @not_found
002B46r 2               
002B46r 2  20 rr rr           JSR   proc_names_equal
002B49r 2  B0 16              BCS   @found
002B4Br 2               
002B4Br 2                     ; Follow next pointer
002B4Br 2  A5 rr              LDA   proc_entry_lo
002B4Dr 2  85 rr              STA   ptr_lo
002B4Fr 2  A5 rr              LDA   proc_entry_hi
002B51r 2  85 rr              STA   ptr_hi
002B53r 2  A0 00              LDY   #0
002B55r 2  B1 rr              LDA   (ptr_lo),Y
002B57r 2  AA                 TAX
002B58r 2  C8                 INY
002B59r 2  B1 rr              LDA   (ptr_lo),Y
002B5Br 2  85 rr              STA   proc_entry_hi
002B5Dr 2  86 rr              STX   proc_entry_lo
002B5Fr 2  80 DF              BRA   @walk
002B61r 2               
002B61r 2               @found:
002B61r 2  18                 CLC
002B62r 2  60                 RTS
002B63r 2               @not_found:
002B63r 2  38                 SEC
002B64r 2  60                 RTS
002B65r 2               
002B65r 2               ; ---------------------------------------------------------------------
002B65r 2               ; proc_names_equal — compare token word vs record name
002B65r 2               ;   Input: eval_cur_lo/hi = TOK_WORD, proc_entry_lo/hi = record
002B65r 2               ;   Returns: carry set = equal, carry clear = not equal
002B65r 2               ; ---------------------------------------------------------------------
002B65r 2               proc_names_equal:
002B65r 2                     ; Token name length
002B65r 2  A5 rr              LDA   eval_cur_lo
002B67r 2  85 rr              STA   ptr_lo
002B69r 2  A5 rr              LDA   eval_cur_hi
002B6Br 2  85 rr              STA   ptr_hi
002B6Dr 2  A0 03              LDY   #TOK_PAYLOAD
002B6Fr 2  B1 rr              LDA   (ptr_lo),Y
002B71r 2  85 rr              STA   proc_name_len         ; token name length
002B73r 2               
002B73r 2                     ; Record name length
002B73r 2  A5 rr              LDA   proc_entry_lo
002B75r 2  85 rr              STA   ptr_lo
002B77r 2  A5 rr              LDA   proc_entry_hi
002B79r 2  85 rr              STA   ptr_hi
002B7Br 2  A0 02              LDY   #2
002B7Dr 2  B1 rr              LDA   (ptr_lo),Y
002B7Fr 2               
002B7Fr 2  C5 rr              CMP   proc_name_len
002B81r 2  D0 37              BNE   @ne
002B83r 2               
002B83r 2                     ; Lengths match — compare chars
002B83r 2  AA                 TAX                         ; X = length
002B84r 2  F0 30              BEQ   @eq
002B86r 2  A0 00              LDY   #0                    ; char index
002B88r 2               @cmp:
002B88r 2  DA                 PHX
002B89r 2  5A                 PHY
002B8Ar 2                     ; Token char at eval_cur + TOK_PAYLOAD + 1 + charIdx
002B8Ar 2  A5 rr              LDA   eval_cur_lo
002B8Cr 2  85 rr              STA   ptr_lo
002B8Er 2  A5 rr              LDA   eval_cur_hi
002B90r 2  85 rr              STA   ptr_hi
002B92r 2  98                 TYA
002B93r 2  18                 CLC
002B94r 2  69 04              ADC   #TOK_PAYLOAD+1
002B96r 2  A8                 TAY
002B97r 2  B1 rr              LDA   (ptr_lo),Y
002B99r 2  85 rr              STA   proc_rec_off          ; temp: token char
002B9Br 2               
002B9Br 2                     ; Record char at proc_entry + 3 + charIdx
002B9Br 2  7A                 PLY
002B9Cr 2  5A                 PHY
002B9Dr 2  A5 rr              LDA   proc_entry_lo
002B9Fr 2  85 rr              STA   ptr_lo
002BA1r 2  A5 rr              LDA   proc_entry_hi
002BA3r 2  85 rr              STA   ptr_hi
002BA5r 2  98                 TYA
002BA6r 2  18                 CLC
002BA7r 2  69 03              ADC   #3
002BA9r 2  A8                 TAY
002BAAr 2  B1 rr              LDA   (ptr_lo),Y
002BACr 2               
002BACr 2  C5 rr              CMP   proc_rec_off
002BAEr 2  D0 08              BNE   @ne_pop
002BB0r 2  7A                 PLY
002BB1r 2  FA                 PLX
002BB2r 2  C8                 INY
002BB3r 2  CA                 DEX
002BB4r 2  D0 D2              BNE   @cmp
002BB6r 2               @eq:
002BB6r 2  38                 SEC
002BB7r 2  60                 RTS
002BB8r 2               @ne_pop:
002BB8r 2  7A                 PLY
002BB9r 2  FA                 PLX
002BBAr 2               @ne:
002BBAr 2  18                 CLC
002BBBr 2  60                 RTS
002BBCr 2               
002BBCr 2               ; ---------------------------------------------------------------------
002BBCr 2               ; proc_invoke — invoke a user-defined procedure
002BBCr 2               ;   Input: eval_cur_lo/hi = TOK_WORD token (the procedure name)
002BBCr 2               ;          proc_entry_lo/hi = matching procedure record
002BBCr 2               ;   On exit: JMPs to eval_loop or eval_body to continue.
002BBCr 2               ; ---------------------------------------------------------------------
002BBCr 2               proc_invoke:
002BBCr 2                     ; Save outer tokenizer and eval state on the hardware stack.
002BBCr 2                     ; We push: tok_head(2), tok_tail(2), eval_in_body(1),
002BBCr 2                     ;          proc_stopped(1) = 6 bytes.
002BBCr 2                     ; input_buf is saved to BSS (128 bytes too large for stack).
002BBCr 2  A5 rr              LDA   tok_head_lo
002BBEr 2  48                 PHA
002BBFr 2  A5 rr              LDA   tok_head_hi
002BC1r 2  48                 PHA
002BC2r 2  A5 rr              LDA   tok_tail_lo
002BC4r 2  48                 PHA
002BC5r 2  A5 rr              LDA   tok_tail_hi
002BC7r 2  48                 PHA
002BC8r 2  A5 rr              LDA   eval_in_body
002BCAr 2  48                 PHA
002BCBr 2  A5 rr              LDA   proc_stopped
002BCDr 2  48                 PHA
002BCEr 2               
002BCEr 2                     ; Save input_buf to BSS save area
002BCEr 2  A2 00              LDX   #0
002BD0r 2               @save_ib:
002BD0r 2  BD rr rr           LDA   input_buf,X
002BD3r 2  9D rr rr           STA   save_input_buf,X
002BD6r 2  E8                 INX
002BD7r 2  E0 80              CPX   #128
002BD9r 2  D0 F5              BNE   @save_ib
002BDBr 2               
002BDBr 2                     ; Advance eval_cur past the procedure name token
002BDBr 2  20 rr rr           JSR   eval_advance
002BDEr 2               
002BDEr 2                     ; --- Bind parameters ---
002BDEr 2                     ; Navigate to param_count in the record:
002BDEr 2                     ;   offset = 3 + name_len
002BDEr 2  A5 rr              LDA   proc_entry_lo
002BE0r 2  85 rr              STA   ptr_lo
002BE2r 2  A5 rr              LDA   proc_entry_hi
002BE4r 2  85 rr              STA   ptr_hi
002BE6r 2  A0 02              LDY   #2
002BE8r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002BEAr 2  18                 CLC
002BEBr 2  69 03              ADC   #3
002BEDr 2  A8                 TAY                         ; Y = offset to param_count
002BEEr 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002BF0r 2  85 rr              STA   proc_param_cnt
002BF2r 2  C8                 INY                         ; Y = offset to first param name
002BF3r 2  84 rr              STY   proc_rec_off          ; save record offset
002BF5r 2               
002BF5r 2  A5 rr              LDA   proc_param_cnt
002BF7r 2  F0 5C              BEQ   @bind_done
002BF9r 2               
002BF9r 2  A6 rr              LDX   proc_param_cnt
002BFBr 2               @bind_loop:
002BFBr 2  DA                 PHX                         ; save remaining param count
002BFCr 2               
002BFCr 2                     ; First: evaluate the next argument from the caller's token stream.
002BFCr 2                     ; eval_cur still points into the caller's token list.
002BFCr 2  20 rr rr           JSR   eval_expr
002BFFr 2  90 03              BCC   @arg_ok
002C01r 2  4C rr rr           JMP   @bind_err
002C04r 2               @arg_ok:
002C04r 2               
002C04r 2                     ; eval_val now holds the argument value.
002C04r 2                     ; Push value onto stack (type + 3 value bytes = 4 bytes)
002C04r 2  A5 rr              LDA   eval_val_frac
002C06r 2  48                 PHA
002C07r 2  A5 rr              LDA   eval_val_lo
002C09r 2  48                 PHA
002C0Ar 2  A5 rr              LDA   eval_val_hi
002C0Cr 2  48                 PHA
002C0Dr 2  A5 rr              LDA   eval_type
002C0Fr 2  48                 PHA
002C10r 2               
002C10r 2                     ; Build the param name as a length-prefixed string in param_name_tmp
002C10r 2                     ; Read from record at proc_entry + proc_rec_off
002C10r 2  A5 rr              LDA   proc_entry_lo
002C12r 2  85 rr              STA   ptr_lo
002C14r 2  A5 rr              LDA   proc_entry_hi
002C16r 2  85 rr              STA   ptr_hi
002C18r 2  A4 rr              LDY   proc_rec_off
002C1Ar 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002C1Cr 2  8D rr rr           STA   param_name_tmp        ; length byte
002C1Fr 2  AA                 TAX                         ; X = char count
002C20r 2  A9 00              LDA   #0
002C22r 2  85 rr              STA   proc_name_len         ; dest offset in param_name_tmp
002C24r 2               @bind_ch:
002C24r 2  E0 00              CPX   #0
002C26r 2  F0 0F              BEQ   @bind_ch_done
002C28r 2  C8                 INY
002C29r 2  B1 rr              LDA   (ptr_lo),Y
002C2Br 2  DA                 PHX
002C2Cr 2  A6 rr              LDX   proc_name_len
002C2Er 2  9D rr rr           STA   param_name_tmp+1,X
002C31r 2  E6 rr              INC   proc_name_len
002C33r 2  FA                 PLX
002C34r 2  CA                 DEX
002C35r 2  80 ED              BRA   @bind_ch
002C37r 2               @bind_ch_done:
002C37r 2                     ; Advance proc_rec_off past this param
002C37r 2  C8                 INY
002C38r 2  84 rr              STY   proc_rec_off
002C3Ar 2               
002C3Ar 2                     ; Pop value from stack back into eval_val
002C3Ar 2  68                 PLA
002C3Br 2  85 rr              STA   eval_type
002C3Dr 2  68                 PLA
002C3Er 2  85 rr              STA   eval_val_hi
002C40r 2  68                 PLA
002C41r 2  85 rr              STA   eval_val_lo
002C43r 2  68                 PLA
002C44r 2  85 rr              STA   eval_val_frac
002C46r 2               
002C46r 2                     ; Call var_set with ptr_lo/hi → param_name_tmp
002C46r 2  A9 rr              LDA   #<param_name_tmp
002C48r 2  85 rr              STA   ptr_lo
002C4Ar 2  A9 rr              LDA   #>param_name_tmp
002C4Cr 2  85 rr              STA   ptr_hi
002C4Er 2  20 rr rr           JSR   var_set
002C51r 2               
002C51r 2  FA                 PLX                         ; restore remaining count
002C52r 2  CA                 DEX
002C53r 2  D0 A6              BNE   @bind_loop
002C55r 2               
002C55r 2               @bind_done:
002C55r 2                     ; Save heap pointer AFTER param binding so var_set allocations persist.
002C55r 2                     ; Body tokenization will reuse heap from this point each line.
002C55r 2  A5 rr              LDA   heap_ptr
002C57r 2  8D rr rr           STA   save_heap_ptr_lo
002C5Ar 2  A5 rr              LDA   heap_ptr+1
002C5Cr 2  8D rr rr           STA   save_heap_ptr_hi
002C5Fr 2               
002C5Fr 2                     ; Save eval_cur (resume point after all args consumed from caller)
002C5Fr 2  A5 rr              LDA   eval_cur_lo
002C61r 2  8D rr rr           STA   save_eval_cur_lo
002C64r 2  A5 rr              LDA   eval_cur_hi
002C66r 2  8D rr rr           STA   save_eval_cur_hi
002C69r 2               
002C69r 2                     ; --- Execute the body ---
002C69r 2                     ; Navigate to body in the record:
002C69r 2                     ;   proc_rec_off now points past all params.
002C69r 2                     ;   Next 2 bytes = body_len, then body text.
002C69r 2  A5 rr              LDA   proc_entry_lo
002C6Br 2  85 rr              STA   ptr_lo
002C6Dr 2  A5 rr              LDA   proc_entry_hi
002C6Fr 2  85 rr              STA   ptr_hi
002C71r 2  A4 rr              LDY   proc_rec_off
002C73r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_lo
002C75r 2  85 rr              STA   proc_body_len_lo
002C77r 2  C8                 INY
002C78r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_hi
002C7Ar 2  85 rr              STA   proc_body_len_hi
002C7Cr 2  C8                 INY                         ; Y = offset to body text start
002C7Dr 2  84 rr              STY   proc_rec_off
002C7Fr 2               
002C7Fr 2                     ; Compute absolute pointer to body text start
002C7Fr 2  18                 CLC
002C80r 2  A5 rr              LDA   proc_entry_lo
002C82r 2  65 rr              ADC   proc_rec_off
002C84r 2  85 rr              STA   proc_ptr_lo
002C86r 2  A5 rr              LDA   proc_entry_hi
002C88r 2  69 00              ADC   #0
002C8Ar 2  85 rr              STA   proc_ptr_hi
002C8Cr 2               
