002D9Er 2                     ; Restore outer state from stack.
002D9Er 2                     ; X returns this invocation's proc_stopped to the caller.
002D9Er 2                     ; Stack layout (top to bottom):
002D9Er 2                     ;   saved_proc_stopped, eval_in_body, tok_tail_hi, tok_tail_lo,
002D9Er 2                     ;   tok_head_hi, tok_head_lo
