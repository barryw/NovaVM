00141Er 2  80 D7              BRA   @rw_poll
001420r 2               
001420r 2               @rw_bs:
001420r 2  A6 rr              LDX   z:buf_idx
001422r 2  F0 D3              BEQ   @rw_poll
001424r 2  CA                 DEX
001425r 2  86 rr              STX   z:buf_idx
001427r 2  A9 08              LDA   #$08
001429r 2  8D 0E A0           STA   VGC_CHAROUT
00142Cr 2  80 C9              BRA   @rw_poll
00142Er 2               
00142Er 2               @rw_done:
00142Er 2                     ; Echo CR/LF
00142Er 2  48                 PHA
00142Fr 2  A9 0D              LDA   #$0D
001431r 2  8D 0E A0           STA   VGC_CHAROUT
001434r 2  A9 0A              LDA   #$0A
001436r 2  8D 0E A0           STA   VGC_CHAROUT
001439r 2  68                 PLA
00143Ar 2                     ; Allocate word: 1 (len) + buf_idx (chars)
00143Ar 2  A5 rr              LDA   z:buf_idx
00143Cr 2  1A                 INC                        ; +1 for length byte
00143Dr 2  A2 05              LDX   #ATYPE_STRING
00143Fr 2  20 rr rr           JSR   heap_alloc
001442r 2  B0 30              BCS   @rw_oom
001444r 2                     ; Write length
001444r 2  A5 rr              LDA   z:buf_idx
001446r 2  A0 00              LDY   #0
001448r 2  91 rr              STA   (ptr_lo),Y
00144Ar 2                     ; Copy chars
00144Ar 2  AA                 TAX
00144Br 2  F0 16              BEQ   @rw_set
00144Dr 2  A0 01              LDY   #1
00144Fr 2  9C rr rr           STZ   num_tmp_lo
001452r 2               @rw_copy:
001452r 2  5A                 PHY
001453r 2  AC rr rr           LDY   num_tmp_lo
001456r 2  B9 rr rr           LDA   input_buf,Y
001459r 2  7A                 PLY
00145Ar 2  91 rr              STA   (ptr_lo),Y
00145Cr 2  C8                 INY
