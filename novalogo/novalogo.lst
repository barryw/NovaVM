001363r 2                     ; --- Main loop ---
001363r 2               @wu_loop:
001363r 2  A5 rr              LDA   proc_stopped
001365r 2  D0 38              BNE   @wu_done
001367r 2               
001367r 2                     ; Evaluate condition: set eval_cur to cond_start, run body
001367r 2  A5 rr              LDA   cond_start_lo
001369r 2  85 rr              STA   eval_cur_lo
00136Br 2  A5 rr              LDA   cond_start_hi
00136Dr 2  85 rr              STA   eval_cur_hi
00136Fr 2  A9 01              LDA   #$01
001371r 2  85 rr              STA   eval_in_body
001373r 2               
001373r 2                     ; We need to evaluate an expression from the condition body.
001373r 2                     ; The condition block contains an expression, so use eval_expr.
001373r 2  20 rr rr           JSR   eval_expr
001376r 2  B0 27              BCS   @wu_done                ; eval error = stop
001378r 2               
001378r 2                     ; Check result: nonzero integer = true
001378r 2  A5 rr              LDA   eval_val_lo
00137Ar 2  05 rr              ORA   eval_val_hi
00137Cr 2                     ; Result in A: nonzero = true condition
00137Cr 2               
00137Cr 2                     ; Read mode from stack to decide behavior
00137Cr 2                     ; Mode is at the bottom of our saved state block.
00137Cr 2                     ; Stack layout (top-down): eval_in_body, cond_start_hi/lo,
00137Cr 2                     ;   body_resume_hi/lo, body_start_hi/lo, mode
00137Cr 2                     ; That's 8 bytes deep from current SP.
00137Cr 2  BA                 TSX
00137Dr 2  BC 08 01           LDY   $0108,X                 ; mode: 0=WHILE, 1=UNTIL
001380r 2               
001380r 2  C0 00              CPY   #0
001382r 2  D0 06              BNE   @wu_until_check
001384r 2               
001384r 2                     ; WHILE: if condition is false (zero), stop
001384r 2  C9 00              CMP   #0                      ; A still has lo|hi result
001386r 2  F0 17              BEQ   @wu_done
001388r 2  80 04              BRA   @wu_exec_body
00138Ar 2               
00138Ar 2               @wu_until_check:
00138Ar 2                     ; UNTIL: if condition is true (nonzero), stop
00138Ar 2  C9 00              CMP   #0
00138Cr 2  D0 11              BNE   @wu_done
