002358r 2               ; ---------------------------------------------------------------------
002358r 2               ; render_list_to_buf — render list elements into input_buf as text
002358r 2               ;   Entry: eval_val_lo/hi = list head pointer
002358r 2               ;          buf_idx = current write position in input_buf
002358r 2               ;   Exit:  buf_idx updated
002358r 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, list_ptr, list_count
002358r 2               ; ---------------------------------------------------------------------
002358r 2               render_list_to_buf:
002358r 2  A5 rr              LDA   eval_val_lo
00235Ar 2  85 rr              STA   list_ptr_lo
00235Cr 2  A5 rr              LDA   eval_val_hi
00235Er 2  85 rr              STA   list_ptr_hi
002360r 2  A2 00              LDX   #0                     ; 0 = first element (no leading space)
002362r 2               
002362r 2               @rl_loop:
002362r 2  A5 rr              LDA   list_ptr_lo
002364r 2  05 rr              ORA   list_ptr_hi
002366r 2  D0 01              BNE   :+
002368r 2  60                 RTS                           ; end of list
002369r 2               :
002369r 2                     ; Add space before non-first elements
002369r 2  E0 00              CPX   #0
00236Br 2  F0 0F              BEQ   @rl_no_space
00236Dr 2  A5 rr              LDA   z:buf_idx
00236Fr 2  C9 7E              CMP   #126
002371r 2  90 01              BCC   :+
002373r 2  60                 RTS                           ; buffer full — truncate
002374r 2               :
002374r 2  A8                 TAY
002375r 2  A9 20              LDA   #' '
002377r 2  99 rr rr           STA   input_buf,Y
00237Ar 2  E6 rr              INC   z:buf_idx
00237Cr 2               @rl_no_space:
00237Cr 2  A2 01              LDX   #1                     ; subsequent elements get space
00237Er 2               
00237Er 2                     ; Read car type
00237Er 2  A5 rr              LDA   list_ptr_lo
002380r 2  85 rr              STA   ptr_lo
002382r 2  A5 rr              LDA   list_ptr_hi
002384r 2  85 rr              STA   ptr_hi
002386r 2  A0 01              LDY   #CONS_CAR_TYPE
002388r 2  B1 rr              LDA   (ptr_lo),Y
00238Ar 2               
00238Ar 2  C9 02              CMP   #VAL_LIST
00238Cr 2  F0 62              BEQ   @rl_sublist
00238Er 2  C9 01              CMP   #VAL_WORD
002390r 2  F0 25              BEQ   @rl_word
002392r 2               
002392r 2                     ; Number: render to input_buf
002392r 2  DA                 PHX
002393r 2  A5 rr              LDA   list_ptr_lo
002395r 2  48                 PHA
002396r 2  A5 rr              LDA   list_ptr_hi
002398r 2  48                 PHA
002399r 2                     ; Load the number value
002399r 2  A0 02              LDY   #CONS_CAR_HI
00239Br 2  B1 rr              LDA   (ptr_lo),Y
00239Dr 2  85 rr              STA   eval_val_hi
00239Fr 2  A0 03              LDY   #CONS_CAR_LO
0023A1r 2  B1 rr              LDA   (ptr_lo),Y
0023A3r 2  85 rr              STA   eval_val_lo
0023A5r 2  A0 04              LDY   #CONS_CAR_FRAC
0023A7r 2  B1 rr              LDA   (ptr_lo),Y
0023A9r 2  85 rr              STA   eval_val_frac
0023ABr 2  20 rr rr           JSR   render_number_to_buf
0023AEr 2  68                 PLA
0023AFr 2  85 rr              STA   list_ptr_hi
0023B1r 2  68                 PLA
0023B2r 2  85 rr              STA   list_ptr_lo
0023B4r 2  FA                 PLX
0023B5r 2  80 72              BRA   @rl_advance
0023B7r 2               
0023B7r 2               @rl_word:
0023B7r 2  DA                 PHX
0023B8r 2  A5 rr              LDA   list_ptr_lo
0023BAr 2  48                 PHA
0023BBr 2  A5 rr              LDA   list_ptr_hi
0023BDr 2  48                 PHA
0023BEr 2                     ; Get word string pointer
0023BEr 2  A0 03              LDY   #CONS_CAR_LO
0023C0r 2  B1 rr              LDA   (ptr_lo),Y
0023C2r 2  85 rr              STA   ptr2_lo
0023C4r 2  A0 02              LDY   #CONS_CAR_HI
0023C6r 2  B1 rr              LDA   (ptr_lo),Y
0023C8r 2  85 rr              STA   ptr2_hi
0023CAr 2                     ; Copy word chars to buf
0023CAr 2  A0 00              LDY   #0
0023CCr 2  B1 rr              LDA   (ptr2_lo),Y            ; length
0023CEr 2  AA                 TAX
0023CFr 2  F0 16              BEQ   @rl_word_done
0023D1r 2  C8                 INY
0023D2r 2               @rl_wch:
0023D2r 2  A5 rr              LDA   z:buf_idx
0023D4r 2  C9 7E              CMP   #126
0023D6r 2  B0 0F              BCS   @rl_word_done
0023D8r 2  B1 rr              LDA   (ptr2_lo),Y
0023DAr 2  5A                 PHY
0023DBr 2  A4 rr              LDY   z:buf_idx
0023DDr 2  99 rr rr           STA   input_buf,Y
0023E0r 2  E6 rr              INC   z:buf_idx
0023E2r 2  7A                 PLY
0023E3r 2  C8                 INY
0023E4r 2  CA                 DEX
0023E5r 2  D0 EB              BNE   @rl_wch
0023E7r 2               @rl_word_done:
0023E7r 2  68                 PLA
0023E8r 2  85 rr              STA   list_ptr_hi
0023EAr 2  68                 PLA
0023EBr 2  85 rr              STA   list_ptr_lo
0023EDr 2  FA                 PLX
0023EEr 2  80 39              BRA   @rl_advance
0023F0r 2               
0023F0r 2               @rl_sublist:
0023F0r 2  DA                 PHX
0023F1r 2  A5 rr              LDA   list_ptr_lo
0023F3r 2  48                 PHA
0023F4r 2  A5 rr              LDA   list_ptr_hi
0023F6r 2  48                 PHA
0023F7r 2                     ; Write '[' to buf
0023F7r 2  A5 rr              LDA   z:buf_idx
0023F9r 2  C9 7E              CMP   #126
0023FBr 2  B0 25              BCS   @rl_sub_done
0023FDr 2  A8                 TAY
0023FEr 2  A9 5B              LDA   #'['
002400r 2  99 rr rr           STA   input_buf,Y
002403r 2  E6 rr              INC   z:buf_idx
002405r 2                     ; Get sublist pointer and recurse
002405r 2  A0 03              LDY   #CONS_CAR_LO
002407r 2  B1 rr              LDA   (ptr_lo),Y
002409r 2  85 rr              STA   eval_val_lo
00240Br 2  A0 02              LDY   #CONS_CAR_HI
00240Dr 2  B1 rr              LDA   (ptr_lo),Y
00240Fr 2  85 rr              STA   eval_val_hi
002411r 2  20 rr rr           JSR   render_list_to_buf
002414r 2                     ; Write ']' to buf
002414r 2  A5 rr              LDA   z:buf_idx
002416r 2  C9 7E              CMP   #126
002418r 2  B0 08              BCS   @rl_sub_done
00241Ar 2  A8                 TAY
00241Br 2  A9 5D              LDA   #']'
00241Dr 2  99 rr rr           STA   input_buf,Y
002420r 2  E6 rr              INC   z:buf_idx
002422r 2               @rl_sub_done:
002422r 2  68                 PLA
002423r 2  85 rr              STA   list_ptr_hi
002425r 2  68                 PLA
002426r 2  85 rr              STA   list_ptr_lo
002428r 2  FA                 PLX
002429r 2               
002429r 2               @rl_advance:
002429r 2                     ; Follow cdr
002429r 2  A5 rr              LDA   list_ptr_lo
00242Br 2  85 rr              STA   ptr_lo
00242Dr 2  A5 rr              LDA   list_ptr_hi
00242Fr 2  85 rr              STA   ptr_hi
002431r 2  A0 05              LDY   #CONS_CDR_LO
002433r 2  B1 rr              LDA   (ptr_lo),Y
002435r 2  AA                 TAX
002436r 2  A0 06              LDY   #CONS_CDR_HI
002438r 2  B1 rr              LDA   (ptr_lo),Y
00243Ar 2  85 rr              STA   list_ptr_hi
00243Cr 2  86 rr              STX   list_ptr_lo
00243Er 2  A2 01              LDX   #1                     ; always space after first element
002440r 2  4C rr rr           JMP   @rl_loop
002443r 2               
002443r 2               @rl_trunc:
002443r 2  60                 RTS
