002EC8r 2               ; ---------------------------------------------------------------------
002EC8r 2               ; proc_find_by_name — search proc_head for a procedure by name string
002EC8r 2               ;   Input: ptr_lo/hi = length-prefixed name string (e.g. from eval_val)
002EC8r 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002EC8r 2               ;           carry set = not found
002EC8r 2               ;   Clobbers: A, X, Y, proc_entry, proc_name_len, proc_rec_off
002EC8r 2               ; ---------------------------------------------------------------------
002EC8r 2               proc_find_by_name:
002EC8r 2                     ; Save search name pointer
