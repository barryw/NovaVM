002D9Ar 2                     ; Store char in input_buf, tracking bracket/paren nesting depth.
002D9Ar 2  9D rr rr           STA   input_buf,X
002D9Dr 2  E8                 INX
002D9Er 2  C9 5B              CMP   #'['
002DA0r 2  F0 20              BEQ   @brk_inc
002DA2r 2  C9 28              CMP   #'('
002DA4r 2  F0 1C              BEQ   @brk_inc
002DA6r 2  C9 5D              CMP   #']'
002DA8r 2  F0 1D              BEQ   @brk_dec
002DAAr 2  C9 29              CMP   #')'
002DACr 2  F0 19              BEQ   @brk_dec
002DAEr 2               @brk_done:
002DAEr 2                     ; Advance body pointer
002DAEr 2  E6 rr              INC   proc_ptr_lo
002DB0r 2  D0 02              BNE   :+
002DB2r 2  E6 rr              INC   proc_ptr_hi
002DB4r 2               :     ; Decrement remaining
002DB4r 2  A5 rr              LDA   proc_body_len_lo
002DB6r 2  D0 02              BNE   @ln_dec_lo
002DB8r 2  C6 rr              DEC   proc_body_len_hi
002DBAr 2               @ln_dec_lo:
002DBAr 2  C6 rr              DEC   proc_body_len_lo
