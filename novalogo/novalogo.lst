0020A5r 2                     ; Evaluate second arg
0020A5r 2  20 rr rr           JSR   eval_expr
0020A8r 2  90 03              BCC   :+
0020AAr 2  4C rr rr           JMP   @err_pop4
0020ADr 2               :
0020ADr 2                     ; Save second value
0020ADr 2  A5 rr              LDA   eval_type
0020AFr 2  48                 PHA
0020B0r 2  A5 rr              LDA   eval_val_hi
0020B2r 2  48                 PHA
0020B3r 2  A5 rr              LDA   eval_val_lo
0020B5r 2  48                 PHA
0020B6r 2  A5 rr              LDA   eval_val_frac
0020B8r 2  48                 PHA
0020B9r 2               
0020B9r 2                     ; Process first arg: if not list, wrap in single-element list
0020B9r 2                     ; First value is at stack offset 4..7 (under second value)
0020B9r 2  BA                 TSX
0020BAr 2  BD 08 01           LDA   $0108,X                 ; first type
0020BDr 2  C9 02              CMP   #VAL_LIST
0020BFr 2  F0 4D              BEQ   @first_is_list
0020C1r 2               
0020C1r 2                     ; Wrap first value as single-element list
0020C1r 2  A9 07              LDA   #CONS_SIZE
0020C3r 2  A2 02              LDX   #ATYPE_CONS
0020C5r 2  20 rr rr           JSR   heap_alloc
0020C8r 2  90 03              BCC   :+
0020CAr 2  4C rr rr           JMP   @oom_pop8
0020CDr 2               :
0020CDr 2  A0 00              LDY   #CONS_TAG
0020CFr 2  A9 10              LDA   #CONS_PAIR
0020D1r 2  91 rr              STA   (ptr_lo),Y
0020D3r 2  BA                 TSX
0020D4r 2  BD 08 01           LDA   $0108,X                 ; first type
0020D7r 2  A0 01              LDY   #CONS_CAR_TYPE
