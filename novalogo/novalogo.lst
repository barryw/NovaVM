000293r 2               ; ---------------------------------------------------------------------
000293r 2               ; tok_parse_number — parse decimal integer[.fraction] into TOK_NUMBER
000293r 2               ;   tok_src points at first digit or '-'
000293r 2               ;   Payload: 3 bytes = int_hi, int_lo, frac (16.8 fixed-point)
000293r 2               ; ---------------------------------------------------------------------
000293r 2               tok_parse_number:
000293r 2  9C rr rr           STZ   num_val_lo
000296r 2  9C rr rr           STZ   num_val_hi
000299r 2  64 rr              STZ   tok_sign              ; 0 = positive
00029Br 2  A6 rr              LDX   tok_src
00029Dr 2  BD rr rr           LDA   input_buf,X
0002A0r 2  C9 2D              CMP   #'-'
0002A2r 2  D0 06              BNE   @parse_int
0002A4r 2  A9 01              LDA   #1
0002A6r 2  85 rr              STA   tok_sign
0002A8r 2  E6 rr              INC   tok_src
0002AAr 2               
0002AAr 2                     ; Parse integer digits
0002AAr 2               @parse_int:
0002AAr 2  A6 rr              LDX   tok_src
0002ACr 2  BD rr rr           LDA   input_buf,X
0002AFr 2  C9 30              CMP   #'0'
0002B1r 2  90 54              BCC   @int_done
0002B3r 2  C9 3A              CMP   #'9'+1
0002B5r 2  B0 50              BCS   @int_done
0002B7r 2  38                 SEC
0002B8r 2  E9 30              SBC   #'0'                 ; A = digit 0..9
0002BAr 2  48                 PHA                        ; save digit
0002BBr 2               
0002BBr 2                     ; Multiply num_val by 10: (val << 3) + (val << 1)
0002BBr 2                     ; Compute val << 1
0002BBr 2  AD rr rr           LDA   num_val_lo
0002BEr 2  0A                 ASL
0002BFr 2  8D rr rr           STA   num_tmp_lo
0002C2r 2  AD rr rr           LDA   num_val_hi
0002C5r 2  2A                 ROL
0002C6r 2  8D rr rr           STA   num_tmp_hi           ; tmp = val * 2
0002C9r 2               
0002C9r 2                     ; Compute val << 3 = (val * 2) << 2
0002C9r 2  0E rr rr           ASL   num_tmp_lo
0002CCr 2  2E rr rr           ROL   num_tmp_hi
0002CFr 2  0E rr rr           ASL   num_tmp_lo
0002D2r 2  2E rr rr           ROL   num_tmp_hi           ; tmp = val * 8
0002D5r 2               
0002D5r 2                     ; val*10 = val*8 + val*2. Recompute val*2 into num_val first, with a
0002D5r 2                     ; proper 16-bit shift (ASL low, ROL high) so the carry out of the low
0002D5r 2                     ; byte reaches the high byte — then add val*8. (The previous version
0002D5r 2                     ; fused the shift and add and CLC'd away that carry, dropping 256 from
0002D5r 2                     ; any value whose low byte had bit 7 set, e.g. 4242 -> 3986.)
0002D5r 2  AD rr rr           LDA   num_val_lo
0002D8r 2  0A                 ASL
0002D9r 2  8D rr rr           STA   num_val_lo
0002DCr 2  AD rr rr           LDA   num_val_hi
0002DFr 2  2A                 ROL
0002E0r 2  8D rr rr           STA   num_val_hi           ; num_val = val * 2
0002E3r 2               
0002E3r 2  18                 CLC
0002E4r 2  AD rr rr           LDA   num_val_lo
0002E7r 2  6D rr rr           ADC   num_tmp_lo
0002EAr 2  8D rr rr           STA   num_val_lo
0002EDr 2  AD rr rr           LDA   num_val_hi
0002F0r 2  6D rr rr           ADC   num_tmp_hi
0002F3r 2  8D rr rr           STA   num_val_hi           ; num_val = val*2 + val*8 = val*10
0002F6r 2               
0002F6r 2                     ; Add digit
0002F6r 2  68                 PLA
0002F7r 2  18                 CLC
0002F8r 2  6D rr rr           ADC   num_val_lo
0002FBr 2  8D rr rr           STA   num_val_lo
0002FEr 2  90 03              BCC   @no_carry
000300r 2  EE rr rr           INC   num_val_hi
000303r 2               @no_carry:
000303r 2  E6 rr              INC   tok_src
000305r 2  80 A3              BRA   @parse_int
000307r 2               
000307r 2               @int_done:
000307r 2                     ; Parse fractional part
000307r 2  9C rr rr           STZ   num_tmp_lo           ; frac result
00030Ar 2  A6 rr              LDX   tok_src
00030Cr 2  BD rr rr           LDA   input_buf,X
00030Fr 2  C9 2E              CMP   #'.'
000311r 2  D0 67              BNE   @apply_sign
000313r 2  E6 rr              INC   tok_src
000315r 2               
000315r 2                     ; Parse up to 2 fractional digits
000315r 2  9C rr rr           STZ   num_tmp_hi           ; frac_raw accumulator
000318r 2  A0 00              LDY   #0                   ; digit count
00031Ar 2               @frac_loop:
00031Ar 2  C0 02              CPY   #2
00031Cr 2  B0 2E              BCS   @frac_skip
00031Er 2  A6 rr              LDX   tok_src
000320r 2  BD rr rr           LDA   input_buf,X
000323r 2  C9 30              CMP   #'0'
000325r 2  90 36              BCC   @frac_conv
000327r 2  C9 3A              CMP   #'9'+1
000329r 2  B0 32              BCS   @frac_conv
00032Br 2  38                 SEC
00032Cr 2  E9 30              SBC   #'0'
00032Er 2  48                 PHA
00032Fr 2                     ; frac_raw = frac_raw * 10 + digit
00032Fr 2  AD rr rr           LDA   num_tmp_hi
000332r 2  0A                 ASL
000333r 2  8D rr rr           STA   num_tmp_lo           ; *2
000336r 2  0A                 ASL
000337r 2  0A                 ASL                        ; A = val*8
000338r 2  18                 CLC
000339r 2  6D rr rr           ADC   num_tmp_lo           ; A = val*10
00033Cr 2  8D rr rr           STA   num_tmp_hi
00033Fr 2  68                 PLA
000340r 2  18                 CLC
000341r 2  6D rr rr           ADC   num_tmp_hi
000344r 2  8D rr rr           STA   num_tmp_hi
000347r 2  E6 rr              INC   tok_src
000349r 2  C8                 INY
00034Ar 2  80 CE              BRA   @frac_loop
00034Cr 2               
00034Cr 2               @frac_skip:
00034Cr 2                     ; skip remaining digits after '.'
00034Cr 2  A6 rr              LDX   tok_src
00034Er 2  BD rr rr           LDA   input_buf,X
000351r 2  C9 30              CMP   #'0'
000353r 2  90 08              BCC   @frac_conv
000355r 2  C9 3A              CMP   #'9'+1
000357r 2  B0 04              BCS   @frac_conv
000359r 2  E6 rr              INC   tok_src
00035Br 2  80 EF              BRA   @frac_skip
00035Dr 2               
00035Dr 2               @frac_conv:
00035Dr 2                     ; If only 1 digit, multiply by 10
00035Dr 2  C0 01              CPY   #1
00035Fr 2  D0 10              BNE   @frac_2d
000361r 2  AD rr rr           LDA   num_tmp_hi
000364r 2  0A                 ASL
000365r 2  8D rr rr           STA   num_tmp_lo
000368r 2  0A                 ASL
000369r 2  0A                 ASL
00036Ar 2  18                 CLC
00036Br 2  6D rr rr           ADC   num_tmp_lo
00036Er 2  8D rr rr           STA   num_tmp_hi
000371r 2               @frac_2d:
000371r 2                     ; Convert centesimal (0..99) → 8-bit fraction
000371r 2  AD rr rr           LDA   num_tmp_hi
000374r 2  20 rr rr           JSR   frac_to_byte
000377r 2  8D rr rr           STA   num_tmp_lo
00037Ar 2               
00037Ar 2               @apply_sign:
00037Ar 2                     ; Apply sign (negate 16.8 via two's complement if negative)
00037Ar 2  A5 rr              LDA   tok_sign
00037Cr 2  F0 1F              BEQ   @emit_num
00037Er 2                     ; Negate: complement and add 1 across all 3 bytes
00037Er 2  AD rr rr           LDA   num_tmp_lo           ; frac
000381r 2  49 FF              EOR   #$FF
000383r 2  18                 CLC
000384r 2  69 01              ADC   #1
000386r 2  8D rr rr           STA   num_tmp_lo
000389r 2  AD rr rr           LDA   num_val_lo
00038Cr 2  49 FF              EOR   #$FF
00038Er 2  69 00              ADC   #0
000390r 2  8D rr rr           STA   num_val_lo
000393r 2  AD rr rr           LDA   num_val_hi
000396r 2  49 FF              EOR   #$FF
000398r 2  69 00              ADC   #0
00039Ar 2  8D rr rr           STA   num_val_hi
00039Dr 2               
00039Dr 2               @emit_num:
00039Dr 2                     ; Allocate 6-byte node
00039Dr 2  A9 06              LDA   #6
00039Fr 2  A2 01              LDX   #ATYPE_TOKEN
0003A1r 2  20 rr rr           JSR   heap_alloc
0003A4r 2  B0 25              BCS   @oom
0003A6r 2  A0 00              LDY   #TOK_TAG
0003A8r 2  A9 02              LDA   #TOK_NUMBER
0003AAr 2  91 rr              STA   (ptr_lo),Y
0003ACr 2  A0 01              LDY   #TOK_NEXT_LO
0003AEr 2  A9 00              LDA   #0
0003B0r 2  91 rr              STA   (ptr_lo),Y
0003B2r 2  C8                 INY
0003B3r 2  91 rr              STA   (ptr_lo),Y
0003B5r 2                     ; Payload: [hi, lo, frac]
0003B5r 2  A0 03              LDY   #TOK_PAYLOAD
0003B7r 2  AD rr rr           LDA   num_val_hi
0003BAr 2  91 rr              STA   (ptr_lo),Y
0003BCr 2  C8                 INY
0003BDr 2  AD rr rr           LDA   num_val_lo
0003C0r 2  91 rr              STA   (ptr_lo),Y
0003C2r 2  C8                 INY
0003C3r 2  AD rr rr           LDA   num_tmp_lo
0003C6r 2  91 rr              STA   (ptr_lo),Y
0003C8r 2  4C rr rr           JMP   tok_append_node
0003CBr 2               @oom:
0003CBr 2  60                 RTS
0003CCr 2               
0003CCr 2               ; ---------------------------------------------------------------------
0003CCr 2               ; frac_to_byte — convert centesimal fraction (0..99) to 8-bit (0..252)
0003CCr 2               ;   Input: A = centesimal value (0..99)
0003CCr 2               ;   Output: A = 8-bit fractional byte
0003CCr 2               ;   Method: (A * 256) / 100 via 16÷8 long division
0003CCr 2               ;   Clobbers: X, Y
0003CCr 2               ; ---------------------------------------------------------------------
0003CCr 2               frac_to_byte:
0003CCr 2                     ; dividend = A:$00 (A*256), divisor = 100
0003CCr 2  8D rr rr           STA   num_tmp_hi
0003CFr 2  9C rr rr           STZ   num_tmp_lo
0003D2r 2  A2 00              LDX   #0                   ; remainder
0003D4r 2  A0 10              LDY   #16                  ; 16-bit division
0003D6r 2               @div:
0003D6r 2  0E rr rr           ASL   num_tmp_lo
0003D9r 2  2E rr rr           ROL   num_tmp_hi
0003DCr 2  8A                 TXA
0003DDr 2  2A                 ROL
0003DEr 2  AA                 TAX
0003DFr 2  E0 64              CPX   #100
0003E1r 2  90 08              BCC   @nosub
0003E3r 2  8A                 TXA
0003E4r 2  38                 SEC
0003E5r 2  E9 64              SBC   #100
0003E7r 2  AA                 TAX
0003E8r 2  EE rr rr           INC   num_tmp_lo
0003EBr 2               @nosub:
0003EBr 2  88                 DEY
0003ECr 2  D0 E8              BNE   @div
0003EEr 2  AD rr rr           LDA   num_tmp_lo           ; quotient low byte
0003F1r 2  60                 RTS
0003F2r 2               
0003F2r 2               ; ---------------------------------------------------------------------
0003F2r 2               ; tok_append_node — link ptr_lo/hi into the list, continue scanning
0003F2r 2               ; ---------------------------------------------------------------------
0003F2r 2               tok_append_node:
0003F2r 2  A5 rr              LDA   tok_head_lo
0003F4r 2  05 rr              ORA   tok_head_hi
0003F6r 2  D0 0F              BNE   @link
0003F8r 2                     ; Empty list: head = tail = new node
0003F8r 2  A5 rr              LDA   ptr_lo
0003FAr 2  85 rr              STA   tok_head_lo
0003FCr 2  85 rr              STA   tok_tail_lo
0003FEr 2  A5 rr              LDA   ptr_hi
000400r 2  85 rr              STA   tok_head_hi
000402r 2  85 rr              STA   tok_tail_hi
000404r 2  4C rr rr           JMP   tok_scan_next
000407r 2               @link:
000407r 2                     ; tail->next = new node
000407r 2  A5 rr              LDA   tok_tail_lo
000409r 2  85 rr              STA   ptr2_lo
00040Br 2  A5 rr              LDA   tok_tail_hi
00040Dr 2  85 rr              STA   ptr2_hi
00040Fr 2  A0 01              LDY   #TOK_NEXT_LO
000411r 2  A5 rr              LDA   ptr_lo
000413r 2  91 rr              STA   (ptr2_lo),Y
000415r 2  C8                 INY
000416r 2  A5 rr              LDA   ptr_hi
000418r 2  91 rr              STA   (ptr2_lo),Y
00041Ar 2                     ; tail = new node
00041Ar 2  A5 rr              LDA   ptr_lo
00041Cr 2  85 rr              STA   tok_tail_lo
00041Er 2  A5 rr              LDA   ptr_hi
000420r 2  85 rr              STA   tok_tail_hi
000422r 2  4C rr rr           JMP   tok_scan_next
000425r 2               
000425r 2               ; ---------------------------------------------------------------------
000425r 2               ; is_word_char — test if A is a valid word character
000425r 2               ;   Returns: carry set = word char, carry clear = delimiter
000425r 2               ;   Preserves: X
000425r 2               ; ---------------------------------------------------------------------
000425r 2               is_word_char:
000425r 2  C9 00              CMP   #0
000427r 2  F0 36              BEQ   @no
000429r 2  C9 20              CMP   #$20
00042Br 2  F0 32              BEQ   @no
00042Dr 2  C9 09              CMP   #$09
00042Fr 2  F0 2E              BEQ   @no
000431r 2  C9 5B              CMP   #'['
000433r 2  F0 2A              BEQ   @no
000435r 2  C9 5D              CMP   #']'
000437r 2  F0 26              BEQ   @no
000439r 2  C9 28              CMP   #'('
00043Br 2  F0 22              BEQ   @no
00043Dr 2  C9 29              CMP   #')'
00043Fr 2  F0 1E              BEQ   @no
000441r 2  C9 2B              CMP   #'+'
000443r 2  F0 1A              BEQ   @no
000445r 2  C9 2D              CMP   #'-'
000447r 2  F0 16              BEQ   @no
000449r 2  C9 2A              CMP   #'*'
00044Br 2  F0 12              BEQ   @no
00044Dr 2  C9 2F              CMP   #'/'
00044Fr 2  F0 0E              BEQ   @no
000451r 2  C9 3C              CMP   #'<'
000453r 2  F0 0A              BEQ   @no
000455r 2  C9 3E              CMP   #'>'
000457r 2  F0 06              BEQ   @no
000459r 2  C9 3D              CMP   #'='
00045Br 2  F0 02              BEQ   @no
00045Dr 2  38                 SEC
00045Er 2  60                 RTS
00045Fr 2               @no:
00045Fr 2  18                 CLC
000460r 2  60                 RTS
000461r 2               
000461r 2               
000461r 1                     .include "eval.s"
000461r 2               ; eval.s — evaluator: walk token list and dispatch commands
000461r 2               
000461r 2               ; =====================================================================
000461r 2               ; ZEROPAGE segment — evaluator variables
000461r 2               ; =====================================================================
000461r 2                     .segment "ZEROPAGE"
00000Cr 2               
00000Cr 2  xx           eval_type:      .res 1    ; result type: $00=number, $01=word
00000Dr 2  xx           eval_val_hi:    .res 1    ; number high byte or word ptr high
00000Er 2  xx           eval_val_lo:    .res 1    ; number low byte or word ptr low
00000Fr 2  xx           eval_val_frac:  .res 1    ; number fractional byte
000010r 2  xx           eval_cur_lo:    .res 1    ; current token pointer (low)
000011r 2  xx           eval_cur_hi:    .res 1    ; current token pointer (high)
000012r 2  xx           eval_left_hi:   .res 1    ; saved left operand high byte
000013r 2  xx           eval_left_lo:   .res 1    ; saved left operand low byte
000014r 2  xx           eval_left_frac: .res 1    ; saved left operand fractional byte
000015r 2  xx           eval_op:        .res 1    ; infix operator character
000016r 2  xx           handler_lo:     .res 1    ; saved handler address for JMP
000017r 2  xx           handler_hi:     .res 1
000018r 2  xx           eval_in_body:   .res 1    ; $00 = normal eval_loop, $01 = in body
000019r 2  xx           proc_stopped:   .res 1    ; $00 = running, $01 = STOP, $02 = OUTPUT
00001Ar 2  xx           eval_reporter:  .res 1    ; $00 = normal, $01 = reporter mode (return from eval_continue)
00001Br 2  xx           ext_mod_id:     .res 1    ; looked-up ext_cmd_table module_id (MODULE_ID_NONE=legacy path)
00001Cr 2               
00001Cr 2               ; --- Catch frame for CATCH/THROW error handling ---
00001Cr 2  xx           catch_active:   .res 1    ; $00 = no catch, $01 = catch active
00001Dr 2  xx           catch_tag_lo:   .res 1    ; pointer to tag word (length-prefixed)
00001Er 2  xx           catch_tag_hi:   .res 1
00001Fr 2  xx           catch_sp:       .res 1    ; saved 6502 stack pointer for unwinding
000020r 2  xx           catch_resume_lo: .res 1   ; eval_cur to resume at (past the body's ])
000021r 2  xx           catch_resume_hi: .res 1
000022r 2               
000022r 2               ; =====================================================================
000022r 2               ; BSS segment — scratch for number printing
000022r 2               ; =====================================================================
000022r 2                     .segment "BSS"
000007r 2               
000007r 2  xx xx xx xx  pn_buf:         .res 8    ; decimal digit buffer for print_number
00000Br 2  xx xx xx xx  
00000Fr 2               
00000Fr 2               ; =====================================================================
00000Fr 2               ; CODE segment — evaluator routines
00000Fr 2               ; =====================================================================
00000Fr 2                     .segment "CODE"
000461r 2               
000461r 2               ; ---------------------------------------------------------------------
000461r 2               ; eval_line — evaluate the token list built by tokenize_line
000461r 2               ;   Input:  tok_head_lo/hi = first token
000461r 2               ;   Output: commands executed, errors printed
000461r 2               ; ---------------------------------------------------------------------
000461r 2               eval_line:
000461r 2  64 rr              STZ   eval_in_body
000463r 2  64 rr              STZ   proc_stopped
000465r 2  64 rr              STZ   eval_reporter
000467r 2  A5 rr              LDA   tok_head_lo
000469r 2  85 rr              STA   eval_cur_lo
00046Br 2  A5 rr              LDA   tok_head_hi
00046Dr 2  85 rr              STA   eval_cur_hi
00046Fr 2               
00046Fr 2               eval_loop:
00046Fr 2                     ; Check if STOP/OUTPUT was signaled — bail out
00046Fr 2  A5 rr              LDA   proc_stopped
000471r 2  D0 1B              BNE   @bail_out
000473r 2               
000473r 2                     ; Check for end of list
000473r 2  A5 rr              LDA   eval_cur_lo
000475r 2  05 rr              ORA   eval_cur_hi
000477r 2  F0 15              BEQ   @bail_out
000479r 2               
000479r 2                     ; Read tag of current token
000479r 2  A5 rr              LDA   eval_cur_lo
00047Br 2  85 rr              STA   ptr_lo
00047Dr 2  A5 rr              LDA   eval_cur_hi
00047Fr 2  85 rr              STA   ptr_hi
000481r 2  A0 00              LDY   #TOK_TAG
000483r 2  B1 rr              LDA   (ptr_lo),Y
000485r 2               
000485r 2                     ; Dispatch based on tag
000485r 2  C9 01              CMP   #TOK_WORD
000487r 2  F0 06              BEQ   @do_command
000489r 2               
000489r 2                     ; Bare expression — skip it for now (could error)
000489r 2                     ; Advance to next token
000489r 2  20 rr rr           JSR   eval_advance
00048Cr 2  80 E1              BRA   eval_loop
00048Er 2               
00048Er 2               @bail_out:
00048Er 2  60                 RTS
00048Fr 2               
00048Fr 2               @do_command:
00048Fr 2                     ; Look up the word in the builtin table
00048Fr 2  20 rr rr           JSR   lookup_builtin
000492r 2  B0 31              BCS   @unknown
000494r 2               
000494r 2                     ; Found: handler addr is in ptr2_lo/hi, arity in A
000494r 2                     ; Save handler address — eval_expr may clobber ptr2
000494r 2  A6 rr              LDX   ptr2_lo
000496r 2  86 rr              STX   handler_lo
000498r 2  A6 rr              LDX   ptr2_hi
00049Ar 2  86 rr              STX   handler_hi
00049Cr 2                     ; Save arity across eval_advance (which clobbers X)
00049Cr 2  AA                 TAX
00049Dr 2  DA                 PHX
00049Er 2                     ; Advance past the command word token
00049Er 2  20 rr rr           JSR   eval_advance
0004A1r 2  FA                 PLX
0004A2r 2               
0004A2r 2                     ; Evaluate arguments (X = arity count)
0004A2r 2  E0 00              CPX   #0
0004A4r 2  F0 16              BEQ   @call_handler
0004A6r 2                     ; Save handler address — eval_expr may invoke proc_invoke which
0004A6r 2                     ; clobbers handler_lo/hi via inner eval_loop dispatch
0004A6r 2  A5 rr              LDA   handler_hi
0004A8r 2  48                 PHA
0004A9r 2  A5 rr              LDA   handler_lo
0004ABr 2  48                 PHA
0004ACr 2               @eval_args:
0004ACr 2  DA                 PHX                   ; save remaining arg count
0004ADr 2  20 rr rr           JSR   eval_expr
0004B0r 2  B0 0D              BCS   @arg_error
0004B2r 2  FA                 PLX
0004B3r 2  CA                 DEX
0004B4r 2  D0 F6              BNE   @eval_args
0004B6r 2                     ; Restore handler address
0004B6r 2  68                 PLA
0004B7r 2  85 rr              STA   handler_lo
0004B9r 2  68                 PLA
0004BAr 2  85 rr              STA   handler_hi
0004BCr 2               
0004BCr 2               @call_handler:
0004BCr 2                     ; Call the handler via indirect JMP
0004BCr 2  6C rr rr           JMP   (handler_lo)
0004BFr 2                     ; handlers must JMP back to eval_loop via eval_continue
0004BFr 2               
0004BFr 2               @arg_error:
0004BFr 2  FA                 PLX                   ; discard saved arity counter
0004C0r 2                     ; Discard saved handler address
0004C0r 2  68                 PLA
0004C1r 2  68                 PLA
0004C2r 2                     ; Print error and abort line
0004C2r 2  4C rr rr           JMP   err_notenough_throw
0004C5r 2               
0004C5r 2               @unknown:
0004C5r 2                     ; Try user-defined procedures before erroring
0004C5r 2  20 rr rr           JSR   proc_lookup
0004C8r 2  B0 06              BCS   @try_ext_cmd
0004CAr 2                     ; Found a procedure — invoke it (proc_stopped restored internally)
0004CAr 2  20 rr rr           JSR   proc_invoke
0004CDr 2  4C rr rr           JMP   eval_loop
0004D0r 2               
0004D0r 2               @try_ext_cmd:
0004D0r 2                     ; Try extension command table before giving up
0004D0r 2  20 rr rr           JSR   lookup_ext_cmd
0004D3r 2  B0 14              BCS   @truly_unknown
0004D5r 2                     ; Found: A = arity, ext_cmd set.
0004D5r 2                     ; Advance past the command word token.
0004D5r 2  AA                 TAX                       ; X = arity
0004D6r 2  DA                 PHX
0004D7r 2  20 rr rr           JSR   eval_advance
0004DAr 2  FA                 PLX
0004DBr 2                     ; Evaluate arguments and copy to ext_arg slots
0004DBr 2  20 rr rr           JSR   ext_eval_args
0004DEr 2  B0 06              BCS   @ext_arg_err
0004E0r 2                     ; Dispatch: legacy trampoline or paged-library lib_call (branches on
0004E0r 2                     ; ext_mod_id). Result left in eval_val.
0004E0r 2  20 rr rr           JSR   ext_invoke
0004E3r 2  4C rr rr           JMP   eval_continue
0004E6r 2               
0004E6r 2               @ext_arg_err:
0004E6r 2  4C rr rr           JMP   err_notenough_throw
0004E9r 2               
0004E9r 2               @truly_unknown:
0004E9r 2                     ; Print "I don't know how to " + the word
0004E9r 2  4C rr rr           JMP   err_idk_word
0004ECr 2               
0004ECr 2               @done:
0004ECr 2  60                 RTS
0004EDr 2               
0004EDr 2               ; ---------------------------------------------------------------------
0004EDr 2               ; eval_continue — handlers JMP here to resume the eval loop
0004EDr 2               ;   If eval_in_body != 0, resumes body execution instead
0004EDr 2               ; ---------------------------------------------------------------------
0004EDr 2               ; ---------------------------------------------------------------------
0004EDr 2               ; jmp_handler — trampoline for calling builtins from reporter position
0004EDr 2               ; ---------------------------------------------------------------------
0004EDr 2               jmp_handler:
0004EDr 2  6C rr rr           JMP   (handler_lo)
0004F0r 2               
0004F0r 2               eval_continue:
0004F0r 2                     ; If in reporter mode, return to eval_expr instead of looping
0004F0r 2  A5 rr              LDA   eval_reporter
0004F2r 2  D0 07              BNE   @reporter_return
0004F4r 2  A5 rr              LDA   eval_in_body
0004F6r 2  D0 07              BNE   eval_body
0004F8r 2  4C rr rr           JMP   eval_loop
0004FBr 2               
0004FBr 2               @reporter_return:
0004FBr 2  64 rr              STZ   eval_reporter
0004FDr 2  18                 CLC
0004FEr 2  60                 RTS
0004FFr 2               
0004FFr 2               ; ---------------------------------------------------------------------
0004FFr 2               ; eval_body — execute tokens within a body until TOK_RBRACKET at depth 0
0004FFr 2               ;   Entry: eval_cur is at the next token to execute inside the body
0004FFr 2               ;   Exit:  eval_cur points at the TOK_RBRACKET that ended the body
0004FFr 2               ;   eval_in_body must be $01 on entry
0004FFr 2               ; ---------------------------------------------------------------------
0004FFr 2               eval_body:
0004FFr 2                     ; Check if STOP/OUTPUT was signaled — bail out immediately
0004FFr 2  A5 rr              LDA   proc_stopped
000501r 2  D0 55              BNE   @done
000503r 2               
000503r 2                     ; Check for end of list (safety — malformed input)
000503r 2  A5 rr              LDA   eval_cur_lo
000505r 2  05 rr              ORA   eval_cur_hi
000507r 2  F0 4F              BEQ   @done
000509r 2               
000509r 2                     ; Read tag of current token
000509r 2  A5 rr              LDA   eval_cur_lo
00050Br 2  85 rr              STA   ptr_lo
00050Dr 2  A5 rr              LDA   eval_cur_hi
00050Fr 2  85 rr              STA   ptr_hi
000511r 2  A0 00              LDY   #TOK_TAG
000513r 2  B1 rr              LDA   (ptr_lo),Y
000515r 2               
000515r 2                     ; Hit the closing bracket? We're done with this body pass.
000515r 2  C9 04              CMP   #TOK_RBRACKET
000517r 2  F0 3F              BEQ   @done
000519r 2               
000519r 2                     ; Dispatch command words (same as eval_loop)
000519r 2  C9 01              CMP   #TOK_WORD
00051Br 2  F0 05              BEQ   @do_command
00051Dr 2               
00051Dr 2                     ; Skip non-word tokens (bare numbers, brackets inside expressions, etc.)
00051Dr 2  20 rr rr           JSR   eval_advance
000520r 2  80 DD              BRA   eval_body
000522r 2               
000522r 2               @do_command:
000522r 2                     ; Same dispatch as eval_loop — look up builtin, eval args, call handler
000522r 2  20 rr rr           JSR   lookup_builtin
000525r 2  B0 32              BCS   @unknown
000527r 2               
000527r 2  A6 rr              LDX   ptr2_lo
000529r 2  86 rr              STX   handler_lo
00052Br 2  A6 rr              LDX   ptr2_hi
00052Dr 2  86 rr              STX   handler_hi
00052Fr 2  AA                 TAX
000530r 2  DA                 PHX
000531r 2  20 rr rr           JSR   eval_advance
000534r 2  FA                 PLX
000535r 2               
000535r 2  E0 00              CPX   #0
000537r 2  F0 16              BEQ   @call_handler
000539r 2                     ; Save handler address — eval_expr may invoke proc_invoke
000539r 2  A5 rr              LDA   handler_hi
00053Br 2  48                 PHA
00053Cr 2  A5 rr              LDA   handler_lo
00053Er 2  48                 PHA
00053Fr 2               @eval_args:
00053Fr 2  DA                 PHX
000540r 2  20 rr rr           JSR   eval_expr
000543r 2  B0 0D              BCS   @arg_error
000545r 2  FA                 PLX
000546r 2  CA                 DEX
000547r 2  D0 F6              BNE   @eval_args
000549r 2                     ; Restore handler address
000549r 2  68                 PLA
00054Ar 2  85 rr              STA   handler_lo
00054Cr 2  68                 PLA
00054Dr 2  85 rr              STA   handler_hi
00054Fr 2               
00054Fr 2               @call_handler:
00054Fr 2  6C rr rr           JMP   (handler_lo)
000552r 2                     ; handler JMPs to eval_continue, which routes back here
000552r 2               
000552r 2               @arg_error:
000552r 2  FA                 PLX
000553r 2  68                 PLA
000554r 2  68                 PLA
000555r 2  4C rr rr           JMP   err_notenough_throw
000558r 2               
000558r 2               @done:
000558r 2  60                 RTS
000559r 2               
000559r 2               @unknown:
000559r 2                     ; Try user-defined procedures before erroring (inside body)
000559r 2  20 rr rr           JSR   proc_lookup
00055Cr 2  B0 06              BCS   @try_ext_cmd
00055Er 2  20 rr rr           JSR   proc_invoke
000561r 2  4C rr rr           JMP   eval_body
000564r 2               
000564r 2               @try_ext_cmd:
000564r 2                     ; Try extension command table before giving up (inside body)
000564r 2  20 rr rr           JSR   lookup_ext_cmd
000567r 2  B0 14              BCS   @truly_unknown
000569r 2  AA                 TAX
00056Ar 2  DA                 PHX
00056Br 2  20 rr rr           JSR   eval_advance
00056Er 2  FA                 PLX
00056Fr 2  20 rr rr           JSR   ext_eval_args
000572r 2  B0 06              BCS   @body_ext_err
000574r 2                     ; Dispatch: legacy trampoline or paged-library lib_call (branches on
000574r 2                     ; ext_mod_id). Result left in eval_val.
000574r 2  20 rr rr           JSR   ext_invoke
000577r 2  4C rr rr           JMP   eval_continue
00057Ar 2               
00057Ar 2               @body_ext_err:
00057Ar 2  4C rr rr           JMP   err_notenough_throw
00057Dr 2               
00057Dr 2               @truly_unknown:
00057Dr 2                     ; Print "I don't know how to " + the word (inside body)
00057Dr 2  4C rr rr           JMP   err_idk_word
000580r 2               
000580r 2               ; ---------------------------------------------------------------------
000580r 2               ; eval_advance — advance eval_cur to the next token in the list
000580r 2               ;   Reads next pointer from current token, stores in eval_cur
000580r 2               ; ---------------------------------------------------------------------
000580r 2               eval_advance:
000580r 2  A5 rr              LDA   eval_cur_lo
000582r 2  85 rr              STA   ptr_lo
000584r 2  A5 rr              LDA   eval_cur_hi
000586r 2  85 rr              STA   ptr_hi
000588r 2  A0 01              LDY   #TOK_NEXT_LO
00058Ar 2  B1 rr              LDA   (ptr_lo),Y
00058Cr 2  AA                 TAX
00058Dr 2  C8                 INY
00058Er 2  B1 rr              LDA   (ptr_lo),Y
000590r 2  85 rr              STA   eval_cur_hi
000592r 2  86 rr              STX   eval_cur_lo
000594r 2  60                 RTS
000595r 2               
000595r 2               ; ---------------------------------------------------------------------
000595r 2               ; eval_expr — evaluate one expression from the current token
000595r 2               ;   Output: eval_type, eval_val_hi/lo/frac set
000595r 2               ;           Carry clear = success, Carry set = error (no token)
000595r 2               ;   Advances eval_cur past the consumed token
000595r 2               ; ---------------------------------------------------------------------
000595r 2               eval_expr:
000595r 2                     ; Check for end of list
000595r 2  A5 rr              LDA   eval_cur_lo
000597r 2  05 rr              ORA   eval_cur_hi
000599r 2  D0 02              BNE   @have_token
00059Br 2  38                 SEC                       ; no more tokens
00059Cr 2  60                 RTS
00059Dr 2               
00059Dr 2               @have_token:
00059Dr 2  A5 rr              LDA   eval_cur_lo
00059Fr 2  85 rr              STA   ptr_lo
0005A1r 2  A5 rr              LDA   eval_cur_hi
0005A3r 2  85 rr              STA   ptr_hi
0005A5r 2  A0 00              LDY   #TOK_TAG
0005A7r 2  B1 rr              LDA   (ptr_lo),Y
0005A9r 2               
0005A9r 2  C9 02              CMP   #TOK_NUMBER
0005ABr 2  D0 03              BNE   :+
0005ADr 2  4C rr rr           JMP   @number
0005B0r 2  C9 06        :     CMP   #TOK_QUOTE
0005B2r 2  D0 03              BNE   :+
0005B4r 2  4C rr rr           JMP   @quote
0005B7r 2  C9 05        :     CMP   #TOK_VARREF
0005B9r 2  D0 03              BNE   :+
0005BBr 2  4C rr rr           JMP   @varref
0005BEr 2  C9 01        :     CMP   #TOK_WORD
0005C0r 2  F0 06              BEQ   @word_expr
0005C2r 2  C9 03              CMP   #TOK_LBRACKET
0005C4r 2  F0 19              BEQ   @list_literal
0005C6r 2                     ; Anything else is an error
0005C6r 2  38                 SEC
0005C7r 2  60                 RTS
0005C8r 2               
0005C8r 2               @word_expr:
0005C8r 2                     ; Could be a reporter procedure (returns a value via OUTPUT)
0005C8r 2  20 rr rr           JSR   proc_lookup
0005CBr 2  B0 19              BCS   @word_not_proc        ; not a procedure — try builtins
0005CDr 2                     ; It's a procedure — invoke it
0005CDr 2  20 rr rr           JSR   proc_invoke
0005D0r 2                     ; X = exit status: $02 = OUTPUT (eval_val has value), else no value
0005D0r 2  E0 02              CPX   #$02
0005D2r 2  F0 08              BEQ   @word_has_val
0005D4r 2                     ; No OUTPUT — set result to 0
0005D4r 2  64 rr              STZ   eval_val_hi
0005D6r 2  64 rr              STZ   eval_val_lo
0005D8r 2  64 rr              STZ   eval_val_frac
0005DAr 2  64 rr              STZ   eval_type
0005DCr 2               @word_has_val:
0005DCr 2  4C rr rr           JMP   eval_check_infix      ; allow DOUBLE 5 + 3 etc.
0005DFr 2               
0005DFr 2               @list_literal:
0005DFr 2                     ; Advance past the [
0005DFr 2  20 rr rr           JSR   eval_advance
0005E2r 2                     ; Build list from tokens until ]
0005E2r 2  20 rr rr           JSR   eval_list
0005E5r 2                     ; eval_type = VAL_LIST, eval_val = head pointer
0005E5r 2                     ; Carry already set/clear from eval_list
0005E5r 2  60                 RTS
0005E6r 2               
0005E6r 2               @word_not_proc:
0005E6r 2                     ; Not a user proc — try built-in reporter
0005E6r 2  20 rr rr           JSR   lookup_builtin
0005E9r 2  B0 37              BCS   @word_unknown
0005EBr 2                     ; Found: ptr2_lo/hi = handler addr, A = arity
0005EBr 2                     ; Save handler address
0005EBr 2  A6 rr              LDX   ptr2_lo
0005EDr 2  86 rr              STX   handler_lo
0005EFr 2  A6 rr              LDX   ptr2_hi
0005F1r 2  86 rr              STX   handler_hi
0005F3r 2  AA                 TAX                       ; X = arity
0005F4r 2  DA                 PHX                       ; save arity across eval_advance
0005F5r 2                     ; Advance past the command word
0005F5r 2  20 rr rr           JSR   eval_advance
0005F8r 2  FA                 PLX                       ; restore arity
0005F9r 2                     ; Evaluate arguments (X = arity count)
0005F9r 2  E0 00              CPX   #0
0005FBr 2  F0 16              BEQ   @call_reporter
0005FDr 2                     ; Save handler address — eval_expr may clobber it
0005FDr 2  A5 rr              LDA   handler_hi
0005FFr 2  48                 PHA
000600r 2  A5 rr              LDA   handler_lo
000602r 2  48                 PHA
000603r 2               @rpt_eval_args:
000603r 2  DA                 PHX
000604r 2  20 rr rr           JSR   eval_expr
000607r 2  B0 14              BCS   @rpt_arg_error
000609r 2  FA                 PLX
00060Ar 2  CA                 DEX
00060Br 2  D0 F6              BNE   @rpt_eval_args
00060Dr 2                     ; Restore handler address
00060Dr 2  68                 PLA
00060Er 2  85 rr              STA   handler_lo
000610r 2  68                 PLA
000611r 2  85 rr              STA   handler_hi
000613r 2               @call_reporter:
000613r 2                     ; Set reporter mode so eval_continue returns here instead of looping
000613r 2  A9 01              LDA   #$01
000615r 2  85 rr              STA   eval_reporter
000617r 2                     ; Call via JSR to trampoline — handler JMPs to eval_continue
000617r 2                     ; which sees eval_reporter and does CLC + RTS back here.
000617r 2  20 rr rr           JSR   jmp_handler
00061Ar 2                     ; eval_val now set by the handler
00061Ar 2  4C rr rr           JMP   eval_check_infix
00061Dr 2               
00061Dr 2               @rpt_arg_error:
00061Dr 2  FA                 PLX                       ; discard saved arity counter
00061Er 2  68                 PLA
00061Fr 2  68                 PLA                       ; discard saved handler address
000620r 2  38                 SEC
000621r 2  60                 RTS
000622r 2               
000622r 2               @word_unknown:
000622r 2                     ; Try extension command table as reporter
000622r 2  20 rr rr           JSR   lookup_ext_cmd
000625r 2  B0 12              BCS   @word_really_unknown
000627r 2                     ; Found: A = arity, EXT_CMD set
000627r 2  AA                 TAX
000628r 2  DA                 PHX
000629r 2  20 rr rr           JSR   eval_advance
00062Cr 2  FA                 PLX
00062Dr 2  20 rr rr           JSR   ext_eval_args
000630r 2  B0 07              BCS   @word_really_unknown
000632r 2                     ; Dispatch: legacy trampoline or paged-library lib_call (branches on
000632r 2                     ; ext_mod_id). Result left in eval_val.
000632r 2  20 rr rr           JSR   ext_invoke
000635r 2  18                 CLC
000636r 2  4C rr rr           JMP   eval_check_infix
000639r 2               
000639r 2               @word_really_unknown:
000639r 2  38                 SEC
00063Ar 2  60                 RTS
00063Br 2               
00063Br 2               @number:
00063Br 2                     ; Copy 3-byte payload to eval_val
00063Br 2  A0 03              LDY   #TOK_PAYLOAD
00063Dr 2  B1 rr              LDA   (ptr_lo),Y         ; int_hi
00063Fr 2  85 rr              STA   eval_val_hi
000641r 2  C8                 INY
000642r 2  B1 rr              LDA   (ptr_lo),Y         ; int_lo
000644r 2  85 rr              STA   eval_val_lo
000646r 2  C8                 INY
000647r 2  B1 rr              LDA   (ptr_lo),Y         ; frac
000649r 2  85 rr              STA   eval_val_frac
00064Br 2  64 rr              STZ   eval_type           ; $00 = number
00064Dr 2  20 rr rr           JSR   eval_advance
000650r 2  4C rr rr           JMP   eval_check_infix    ; check for infix operator
000653r 2               
000653r 2               @quote:
000653r 2                     ; Point eval_val at the payload (length byte + chars)
000653r 2                     ; Pointer = ptr_lo/hi + TOK_PAYLOAD
000653r 2  18                 CLC
000654r 2  A5 rr              LDA   ptr_lo
000656r 2  69 03              ADC   #TOK_PAYLOAD
000658r 2  85 rr              STA   eval_val_lo
00065Ar 2  A5 rr              LDA   ptr_hi
00065Cr 2  69 00              ADC   #0
00065Er 2  85 rr              STA   eval_val_hi
000660r 2  64 rr              STZ   eval_val_frac
000662r 2  A9 01              LDA   #$01
000664r 2  85 rr              STA   eval_type           ; $01 = word
000666r 2  20 rr rr           JSR   eval_advance
000669r 2  18                 CLC
00066Ar 2  60                 RTS
00066Br 2               
00066Br 2               @varref:
00066Br 2                     ; Variable reference — :NAME
00066Br 2                     ; Payload is length-prefixed name at token + TOK_PAYLOAD
00066Br 2  18                 CLC
00066Cr 2  A5 rr              LDA   ptr_lo
00066Er 2  69 03              ADC   #TOK_PAYLOAD
000670r 2  85 rr              STA   ptr_lo
000672r 2  A5 rr              LDA   ptr_hi
000674r 2  69 00              ADC   #0
000676r 2  85 rr              STA   ptr_hi
000678r 2  20 rr rr           JSR   var_get
00067Br 2  90 34              BCC   @var_ok
00067Dr 2               
00067Dr 2                     ; Not found — print "NAME has no value"
00067Dr 2                     ; ptr_lo/hi was clobbered by var_get, reload from eval_cur
00067Dr 2  A5 rr              LDA   eval_cur_lo
00067Fr 2  85 rr              STA   ptr_lo
000681r 2  A5 rr              LDA   eval_cur_hi
000683r 2  85 rr              STA   ptr_hi
000685r 2  A0 03              LDY   #TOK_PAYLOAD          ; length byte
000687r 2  B1 rr              LDA   (ptr_lo),Y
000689r 2  AA                 TAX                         ; X = name length
00068Ar 2  A0 04              LDY   #TOK_PAYLOAD+1
00068Cr 2               @vr_name:
00068Cr 2  B1 rr              LDA   (ptr_lo),Y
00068Er 2  8D 0E A0           STA   VGC_CHAROUT
000691r 2  C8                 INY
000692r 2  CA                 DEX
000693r 2  D0 F7              BNE   @vr_name
000695r 2  20 rr rr           JSR   print_inl
000698r 2  20 48 41 53        .byte " HAS NO VALUE", 0
00069Cr 2  20 4E 4F 20  
0006A0r 2  56 41 4C 55  
0006A6r 2  20 rr rr           JSR   eval_newline
0006A9r 2  20 rr rr           JSR   try_throw_error
0006ACr 2  20 rr rr           JSR   eval_advance
0006AFr 2  38                 SEC
0006B0r 2  60                 RTS
0006B1r 2               
0006B1r 2               @var_ok:
0006B1r 2                     ; eval_type and eval_val already set by var_get
0006B1r 2  20 rr rr           JSR   eval_advance
0006B4r 2  4C rr rr           JMP   eval_check_infix      ; allow :X + 5 etc.
0006B7r 2               
0006B7r 2               ; ---------------------------------------------------------------------
0006B7r 2               ; eval_newline — print CR+LF
0006B7r 2               ; ---------------------------------------------------------------------
0006B7r 2               eval_newline:
0006B7r 2  A9 0D              LDA   #$0D
0006B9r 2  8D 0E A0           STA   VGC_CHAROUT
0006BCr 2  A9 0A              LDA   #$0A
0006BEr 2  8D 0E A0           STA   VGC_CHAROUT
0006C1r 2  60                 RTS
0006C2r 2               
0006C2r 2               ; ---------------------------------------------------------------------
0006C2r 2               ; print_inl — print the null-terminated string that immediately follows the
0006C2r 2               ;   JSR in the instruction stream, then resume execution after the 0.
0006C2r 2               ;   Usage:  JSR print_inl
0006C2r 2               ;           .byte "TEXT", 0
0006C2r 2               ;   Clobbers: A, Y, ptr_lo, ptr_hi.
0006C2r 2               ; ---------------------------------------------------------------------
0006C2r 2               print_inl:
0006C2r 2  68                 PLA
0006C3r 2  85 rr              STA   ptr_lo
0006C5r 2  68                 PLA
0006C6r 2  85 rr              STA   ptr_hi          ; ptr = (return addr)-1 = (inline string addr)-1
0006C8r 2  A0 00              LDY   #0
0006CAr 2               @pi_lp:
0006CAr 2  C8                 INY
0006CBr 2  B1 rr              LDA   (ptr_lo),Y
0006CDr 2  F0 05              BEQ   @pi_done
0006CFr 2  8D 0E A0           STA   VGC_CHAROUT
0006D2r 2  80 F6              BRA   @pi_lp
0006D4r 2               @pi_done:
0006D4r 2  98                 TYA
0006D5r 2  18                 CLC
0006D6r 2  65 rr              ADC   ptr_lo
0006D8r 2  85 rr              STA   ptr_lo          ; ptr_lo = low(ptr+Y)
0006DAr 2  A5 rr              LDA   ptr_hi
0006DCr 2  69 00              ADC   #0              ; A = high(ptr+Y)
0006DEr 2  48                 PHA                   ; push high of (ptr+Y)
0006DFr 2  A5 rr              LDA   ptr_lo
0006E1r 2  48                 PHA                   ; push low
0006E2r 2  60                 RTS                   ; RTS jumps to (ptr+Y)+1 = byte after the 0
0006E3r 2               
0006E3r 2               ; =====================================================================
0006E3r 2               ; Message composer (4a) — no error string is stored whole. Every error
0006E3r 2               ; message is composed at print time from shared fragments + the command's
0006E3r 2               ; existing length-prefixed *_name string. Family helpers fall through into
0006E3r 2               ; list_print_err's shared newline+continue tail (err_nl_continue).
0006E3r 2               ; =====================================================================
0006E3r 2               
0006E3r 2               ; print_cstr_xy — print a null-terminated string.
0006E3r 2               ;   In: X/Y = lo/hi pointer.  Clobbers: A, Y, ptr_lo/hi.
0006E3r 2               print_cstr_xy:
0006E3r 2  86 rr              STX   ptr_lo
0006E5r 2  84 rr              STY   ptr_hi
0006E7r 2  A0 00              LDY   #0
0006E9r 2               @pc_lp:
0006E9r 2  B1 rr              LDA   (ptr_lo),Y
0006EBr 2  F0 06              BEQ   @pc_done
0006EDr 2  8D 0E A0           STA   VGC_CHAROUT
0006F0r 2  C8                 INY
0006F1r 2  D0 F6              BNE   @pc_lp
0006F3r 2               @pc_done:
0006F3r 2  60                 RTS
0006F4r 2               
0006F4r 2               ; print_name_xy — print a length-prefixed name ( .byte len,"TEXT" ).
0006F4r 2               ;   In: X/Y = lo/hi pointer.  Clobbers: A, X, Y, ptr_lo/hi.
0006F4r 2               print_name_xy:
0006F4r 2  86 rr              STX   ptr_lo
0006F6r 2  84 rr              STY   ptr_hi
0006F8r 2  A0 00              LDY   #0
0006FAr 2  B1 rr              LDA   (ptr_lo),Y      ; length
0006FCr 2  F0 0A              BEQ   @pn_done
0006FEr 2  AA                 TAX
0006FFr 2               @pn_lp:
0006FFr 2  C8                 INY
000700r 2  B1 rr              LDA   (ptr_lo),Y
000702r 2  8D 0E A0           STA   VGC_CHAROUT
000705r 2  CA                 DEX
000706r 2  D0 F7              BNE   @pn_lp
000708r 2               @pn_done:
000708r 2  60                 RTS
000709r 2               
000709r 2               ; --- family error helpers: enter with X/Y = command's *_name string ptr ---
000709r 2               
000709r 2               ; "NOT ENOUGH INPUTS TO <name>"  (reuses str_notenough so "NOT ENOUGH INPUTS"
000709r 2               ; is never stored twice)
000709r 2               err_nei:
000709r 2  8E rr rr           STX   num_tmp_lo            ; save name ptr across the fragment prints
00070Cr 2  8C rr rr           STY   num_tmp_hi
00070Fr 2  A2 rr              LDX   #<str_notenough
000711r 2  A0 rr              LDY   #>str_notenough
000713r 2  20 rr rr           JSR   print_cstr_xy         ; "NOT ENOUGH INPUTS"
000716r 2  A2 rr              LDX   #<frag_to
000718r 2  A0 rr              LDY   #>frag_to
00071Ar 2  20 rr rr           JSR   print_cstr_xy         ; " TO "
00071Dr 2  AE rr rr           LDX   num_tmp_lo
000720r 2  AC rr rr           LDY   num_tmp_hi
000723r 2  20 rr rr           JSR   print_name_xy         ; the command name
000726r 2  4C rr rr           JMP   err_nl_continue       ; newline + abandon line
000729r 2               
000729r 2               ; "<name> DOESN'T LIKE "  (note: trailing space, no value — matches the ROM)
000729r 2               err_doesnt_like:
000729r 2  20 rr rr           JSR   print_name_xy
00072Cr 2  A2 rr              LDX   #<frag_dl
00072Er 2  A0 rr              LDY   #>frag_dl
000730r 2  4C rr rr           JMP   list_print_err
000733r 2               
000733r 2               ; "<name> NEEDS A LIST"
000733r 2               err_needs_list:
000733r 2  20 rr rr           JSR   print_name_xy
000736r 2  A2 rr              LDX   #<frag_needs_list
000738r 2  A0 rr              LDY   #>frag_needs_list
00073Ar 2  4C rr rr           JMP   list_print_err
00073Dr 2               
00073Dr 2               ; "<name> INDEX OUT OF RANGE"
00073Dr 2               err_index_range:
00073Dr 2  20 rr rr           JSR   print_name_xy
000740r 2  A2 rr              LDX   #<frag_index_range
000742r 2  A0 rr              LDY   #>frag_index_range
000744r 2  4C rr rr           JMP   list_print_err
000747r 2               
000747r 2               ; "<name> DOESN'T LIKE [] AS INPUT"
000747r 2               err_dl_empty:
000747r 2  20 rr rr           JSR   print_name_xy
00074Ar 2  A2 rr              LDX   #<frag_dl
00074Cr 2  A0 rr              LDY   #>frag_dl
00074Er 2  20 rr rr           JSR   print_cstr_xy         ; " DOESN'T LIKE "
000751r 2  A2 rr              LDX   #<frag_as_input
000753r 2  A0 rr              LDY   #>frag_as_input
000755r 2  4C rr rr           JMP   list_print_err        ; "[] AS INPUT" + newline + continue
000758r 2               
000758r 2               ; "<name> DOESN'T LIKE THIS INPUT"
000758r 2               err_dl_this:
000758r 2  20 rr rr           JSR   print_name_xy
00075Br 2  A2 rr              LDX   #<frag_dl
00075Dr 2  A0 rr              LDY   #>frag_dl
00075Fr 2  20 rr rr           JSR   print_cstr_xy         ; " DOESN'T LIKE "
000762r 2  A2 rr              LDX   #<frag_this_input
000764r 2  A0 rr              LDY   #>frag_this_input
000766r 2  4C rr rr           JMP   list_print_err        ; "THIS INPUT" + newline + continue
000769r 2               
000769r 2               ; --- throw-tailed error helpers (arg/unknown paths inside eval_loop/eval_body;
000769r 2               ;     these are catchable, so they end in try_throw_error, NOT eval_continue) ---
000769r 2               
000769r 2               ; "NOT ENOUGH INPUTS" (generic, no command name) + throw-tail
000769r 2               err_notenough_throw:
000769r 2  A2 rr              LDX   #<str_notenough
00076Br 2  A0 rr              LDY   #>str_notenough
00076Dr 2  20 rr rr           JSR   print_cstr_xy
000770r 2  4C rr rr           JMP   err_throw
000773r 2               
000773r 2               ; "I DON'T KNOW HOW TO " + the current token's word + throw-tail
000773r 2               err_idk_word:
000773r 2  A2 rr              LDX   #<str_idk
000775r 2  A0 rr              LDY   #>str_idk
000777r 2  20 rr rr           JSR   print_cstr_xy
00077Ar 2  20 rr rr           JSR   print_token_word
00077Dr 2               err_throw:                        ; <- fall-through from err_idk_word
00077Dr 2  20 rr rr           JSR   eval_newline
000780r 2  20 rr rr           JSR   try_throw_error
000783r 2  60                 RTS
000784r 2               
000784r 2               ; print_token_word — print the length-prefixed word in the current token
000784r 2               ;   (eval_cur + TOK_PAYLOAD).  Clobbers A, X, Y, ptr_lo/hi.
000784r 2               print_token_word:
000784r 2  A5 rr              LDA   eval_cur_lo
000786r 2  85 rr              STA   ptr_lo
000788r 2  A5 rr              LDA   eval_cur_hi
00078Ar 2  85 rr              STA   ptr_hi
00078Cr 2  A0 03              LDY   #TOK_PAYLOAD          ; length byte
00078Er 2  B1 rr              LDA   (ptr_lo),Y
000790r 2  AA                 TAX
000791r 2  A0 04              LDY   #TOK_PAYLOAD+1        ; first char
000793r 2               @ptw_lp:
000793r 2  B1 rr              LDA   (ptr_lo),Y
000795r 2  8D 0E A0           STA   VGC_CHAROUT
000798r 2  C8                 INY
000799r 2  CA                 DEX
00079Ar 2  D0 F7              BNE   @ptw_lp
00079Cr 2  60                 RTS
00079Dr 2               
00079Dr 2               ; ---------------------------------------------------------------------
00079Dr 2               ; eval_check_infix — if next token is TOK_INFIX, evaluate binary op
00079Dr 2               ;   Entry: eval_val holds the left operand (primary value)
00079Dr 2               ;   Exit:  eval_val holds the result, carry clear = success
00079Dr 2               ; ---------------------------------------------------------------------
00079Dr 2               eval_check_infix:
00079Dr 2                     ; Is there a next token?
00079Dr 2  A5 rr              LDA   eval_cur_lo
00079Fr 2  05 rr              ORA   eval_cur_hi
0007A1r 2  F0 75              BEQ   @no_infix
0007A3r 2               
0007A3r 2                     ; Peek at the next token's tag
0007A3r 2  A5 rr              LDA   eval_cur_lo
0007A5r 2  85 rr              STA   ptr_lo
0007A7r 2  A5 rr              LDA   eval_cur_hi
0007A9r 2  85 rr              STA   ptr_hi
0007ABr 2  A0 00              LDY   #TOK_TAG
0007ADr 2  B1 rr              LDA   (ptr_lo),Y
0007AFr 2  C9 07              CMP   #TOK_INFIX
0007B1r 2  D0 65              BNE   @no_infix
0007B3r 2               
0007B3r 2                     ; Save the left operand to ZP scratch
0007B3r 2  A5 rr              LDA   eval_val_hi
0007B5r 2  85 rr              STA   eval_left_hi
0007B7r 2  A5 rr              LDA   eval_val_lo
0007B9r 2  85 rr              STA   eval_left_lo
0007BBr 2  A5 rr              LDA   eval_val_frac
0007BDr 2  85 rr              STA   eval_left_frac
0007BFr 2               
0007BFr 2                     ; Read operator character from payload
0007BFr 2  A0 03              LDY   #TOK_PAYLOAD
0007C1r 2  B1 rr              LDA   (ptr_lo),Y
0007C3r 2  85 rr              STA   eval_op
0007C5r 2               
0007C5r 2                     ; Advance past the infix token
0007C5r 2  20 rr rr           JSR   eval_advance
0007C8r 2               
0007C8r 2                     ; Push left operand and operator onto hardware stack so recursive
0007C8r 2                     ; proc_invoke calls (which may evaluate their own infix expressions)
0007C8r 2                     ; cannot clobber them.
0007C8r 2  A5 rr              LDA   eval_left_hi
0007CAr 2  48                 PHA
0007CBr 2  A5 rr              LDA   eval_left_lo
0007CDr 2  48                 PHA
0007CEr 2  A5 rr              LDA   eval_left_frac
0007D0r 2  48                 PHA
0007D1r 2  A5 rr              LDA   eval_op
0007D3r 2  48                 PHA
0007D4r 2               
0007D4r 2                     ; Evaluate the right operand (recursive call)
0007D4r 2  20 rr rr           JSR   eval_expr
0007D7r 2  B0 41              BCS   @err_rhs_pop
0007D9r 2               
0007D9r 2                     ; Restore left operand and operator from stack
0007D9r 2  68                 PLA
0007DAr 2  85 rr              STA   eval_op
0007DCr 2  68                 PLA
0007DDr 2  85 rr              STA   eval_left_frac
0007DFr 2  68                 PLA
0007E0r 2  85 rr              STA   eval_left_lo
0007E2r 2  68                 PLA
0007E3r 2  85 rr              STA   eval_left_hi
0007E5r 2               
0007E5r 2                     ; Dispatch based on operator character
0007E5r 2  A5 rr              LDA   eval_op
0007E7r 2  C9 2B              CMP   #'+'
0007E9r 2  F0 35              BEQ   @do_add
0007EBr 2  C9 2D              CMP   #'-'
0007EDr 2  F0 46              BEQ   @do_sub
0007EFr 2  C9 2A              CMP   #'*'
0007F1r 2  F0 57              BEQ   @do_mul
0007F3r 2  C9 2F              CMP   #'/'
0007F5r 2  F0 75              BEQ   @do_div
0007F7r 2  C9 3E              CMP   #'>'
0007F9r 2  D0 03              BNE   :+
0007FBr 2  4C rr rr           JMP   @do_gt
0007FEr 2  C9 3C        :     CMP   #'<'
000800r 2  D0 03              BNE   :+
000802r 2  4C rr rr           JMP   @do_lt
000805r 2  C9 3D        :     CMP   #'='
000807r 2  D0 03              BNE   :+
000809r 2  4C rr rr           JMP   @do_eq
00080Cr 2               :
00080Cr 2                     ; Unknown operator — return left value unchanged
00080Cr 2  A5 rr              LDA   eval_left_hi
00080Er 2  85 rr              STA   eval_val_hi
000810r 2  A5 rr              LDA   eval_left_lo
000812r 2  85 rr              STA   eval_val_lo
000814r 2  A5 rr              LDA   eval_left_frac
000816r 2  85 rr              STA   eval_val_frac
000818r 2               
000818r 2               @no_infix:
000818r 2  18                 CLC
000819r 2  60                 RTS
00081Ar 2               
00081Ar 2               @err_rhs_pop:
00081Ar 2                     ; Discard saved left operand + operator (4 bytes)
00081Ar 2  68                 PLA
00081Br 2  68                 PLA
00081Cr 2  68                 PLA
00081Dr 2  68                 PLA
00081Er 2               @err_rhs:
00081Er 2  38                 SEC
00081Fr 2  60                 RTS
000820r 2               
000820r 2                     ; ----- Addition: left + right (24-bit: frac, lo, hi) -----
000820r 2               @do_add:
000820r 2  18                 CLC
000821r 2  A5 rr              LDA   eval_left_frac
000823r 2  65 rr              ADC   eval_val_frac
000825r 2  85 rr              STA   eval_val_frac
000827r 2  A5 rr              LDA   eval_left_lo
000829r 2  65 rr              ADC   eval_val_lo
00082Br 2  85 rr              STA   eval_val_lo
00082Dr 2  A5 rr              LDA   eval_left_hi
00082Fr 2  65 rr              ADC   eval_val_hi
000831r 2  85 rr              STA   eval_val_hi
000833r 2  18                 CLC
000834r 2  60                 RTS
000835r 2               
000835r 2                     ; ----- Subtraction: left - right (24-bit) -----
000835r 2               @do_sub:
000835r 2  38                 SEC
000836r 2  A5 rr              LDA   eval_left_frac
000838r 2  E5 rr              SBC   eval_val_frac
00083Ar 2  85 rr              STA   eval_val_frac
00083Cr 2  A5 rr              LDA   eval_left_lo
00083Er 2  E5 rr              SBC   eval_val_lo
000840r 2  85 rr              STA   eval_val_lo
000842r 2  A5 rr              LDA   eval_left_hi
000844r 2  E5 rr              SBC   eval_val_hi
000846r 2  85 rr              STA   eval_val_hi
000848r 2  18                 CLC
000849r 2  60                 RTS
00084Ar 2               
00084Ar 2                     ; ----- Multiplication: left * right via coprocessor -----
00084Ar 2                     ; Integer-only for this pass (frac ignored)
00084Ar 2               @do_mul:
00084Ar 2  A5 rr              LDA   eval_left_lo
00084Cr 2  8D 20 BB           STA   MATH_MUL16_A_LO
00084Fr 2  A5 rr              LDA   eval_left_hi
000851r 2  8D 21 BB           STA   MATH_MUL16_A_HI
000854r 2  A5 rr              LDA   eval_val_lo
000856r 2  8D 22 BB           STA   MATH_MUL16_B_LO
000859r 2  A5 rr              LDA   eval_val_hi
00085Br 2  8D 23 BB           STA   MATH_MUL16_B_HI     ; write triggers multiply
00085Er 2  AD 38 BB           LDA   MATH_RES0
000861r 2  85 rr              STA   eval_val_lo
000863r 2  AD 39 BB           LDA   MATH_RES1
000866r 2  85 rr              STA   eval_val_hi
000868r 2  64 rr              STZ   eval_val_frac
00086Ar 2  18                 CLC
00086Br 2  60                 RTS
00086Cr 2               
00086Cr 2                     ; ----- Division: left / right via coprocessor -----
00086Cr 2                     ; Signed 32÷16: dividend = sign-extended left integer, divisor = right integer
00086Cr 2               @do_div:
00086Cr 2                     ; Check for divide by zero
00086Cr 2  A5 rr              LDA   eval_val_lo
00086Er 2  05 rr              ORA   eval_val_hi
000870r 2  D0 08              BNE   @div_ok
000872r 2                     ; Division by zero — return 0
000872r 2  64 rr              STZ   eval_val_frac
000874r 2  64 rr              STZ   eval_val_lo
000876r 2  64 rr              STZ   eval_val_hi
000878r 2  18                 CLC
000879r 2  60                 RTS
00087Ar 2               @div_ok:
00087Ar 2                     ; Write 32-bit dividend (sign-extend left integer to 32 bits)
00087Ar 2  A5 rr              LDA   eval_left_lo
00087Cr 2  8D 28 BB           STA   MATH_DIV_N_LO
00087Fr 2  A5 rr              LDA   eval_left_hi
000881r 2  8D 29 BB           STA   MATH_DIV_N_1
000884r 2                     ; Sign-extend high word
000884r 2  A5 rr              LDA   eval_left_hi
000886r 2  09 7F              ORA   #$7F                 ; set bits 0-6
000888r 2  30 04              BMI   @neg_ext             ; if bit 7 was set, A=$FF (negative)
00088Ar 2  A9 00              LDA   #$00                 ; positive: extend with $00
00088Cr 2  80 00              BRA   @write_ext
00088Er 2               @neg_ext:                        ; A is already $FF
00088Er 2               @write_ext:
00088Er 2  8D 2A BB           STA   MATH_DIV_N_2
000891r 2  8D 2B BB           STA   MATH_DIV_N_HI
000894r 2                     ; Write 16-bit divisor (right operand integer)
000894r 2  A5 rr              LDA   eval_val_lo
000896r 2  8D 2C BB           STA   MATH_DIV_D_LO
000899r 2  A5 rr              LDA   eval_val_hi
00089Br 2  8D 2D BB           STA   MATH_DIV_D_HI       ; write triggers divide
00089Er 2                     ; Read quotient from result
00089Er 2  AD 38 BB           LDA   MATH_RES0
0008A1r 2  85 rr              STA   eval_val_lo
0008A3r 2  AD 39 BB           LDA   MATH_RES1
0008A6r 2  85 rr              STA   eval_val_hi
0008A8r 2  64 rr              STZ   eval_val_frac
0008AAr 2  18                 CLC
0008ABr 2  60                 RTS
0008ACr 2               
0008ACr 2                     ; ----- Equality: left = right (all 3 bytes must match) -----
0008ACr 2               @do_eq:
0008ACr 2  A5 rr              LDA   eval_left_hi
0008AEr 2  C5 rr              CMP   eval_val_hi
0008B0r 2  D0 64              BNE   @set_false
0008B2r 2  A5 rr              LDA   eval_left_lo
0008B4r 2  C5 rr              CMP   eval_val_lo
0008B6r 2  D0 5E              BNE   @set_false
0008B8r 2  A5 rr              LDA   eval_left_frac
0008BAr 2  C5 rr              CMP   eval_val_frac
0008BCr 2  D0 58              BNE   @set_false
0008BEr 2  80 4A              BRA   @set_true
0008C0r 2               
0008C0r 2                     ; ----- Greater than: left > right (signed 24-bit) -----
0008C0r 2               @do_gt:
0008C0r 2                     ; Compare hi bytes (signed)
0008C0r 2  A5 rr              LDA   eval_left_hi
0008C2r 2  38                 SEC
0008C3r 2  E5 rr              SBC   eval_val_hi
0008C5r 2  50 02              BVC   @gt_sign_ok           ; no overflow — N flag valid
0008C7r 2  49 80              EOR   #$80                  ; overflow — invert N to get true sign
0008C9r 2               @gt_sign_ok:
0008C9r 2  30 4B              BMI   @set_false            ; left_hi < right_hi → false
0008CBr 2                     ; If the subtraction was nonzero and positive, left > right
0008CBr 2  A5 rr              LDA   eval_left_hi
0008CDr 2  C5 rr              CMP   eval_val_hi
0008CFr 2  D0 39              BNE   @set_true             ; hi bytes differ, and left > right
0008D1r 2                     ; Hi bytes equal — compare lo bytes (unsigned)
0008D1r 2  A5 rr              LDA   eval_left_lo
0008D3r 2  C5 rr              CMP   eval_val_lo
0008D5r 2  D0 0A              BNE   @gt_lo_diff
0008D7r 2                     ; Lo bytes equal — compare frac bytes (unsigned)
0008D7r 2  A5 rr              LDA   eval_left_frac
0008D9r 2  C5 rr              CMP   eval_val_frac
0008DBr 2  F0 39              BEQ   @set_false            ; all equal → not greater
0008DDr 2  B0 2B              BCS   @set_true
0008DFr 2  80 35              BRA   @set_false
0008E1r 2               @gt_lo_diff:
0008E1r 2  B0 27              BCS   @set_true
0008E3r 2  80 31              BRA   @set_false
0008E5r 2               
0008E5r 2                     ; ----- Less than: left < right (signed 24-bit) -----
0008E5r 2               @do_lt:
0008E5r 2                     ; Compare hi bytes (signed)
0008E5r 2  A5 rr              LDA   eval_left_hi
0008E7r 2  38                 SEC
0008E8r 2  E5 rr              SBC   eval_val_hi
0008EAr 2  50 02              BVC   @lt_sign_ok
0008ECr 2  49 80              EOR   #$80
0008EEr 2               @lt_sign_ok:
0008EEr 2  30 1A              BMI   @set_true             ; left_hi < right_hi → true
0008F0r 2  A5 rr              LDA   eval_left_hi
0008F2r 2  C5 rr              CMP   eval_val_hi
0008F4r 2  D0 20              BNE   @set_false            ; left_hi > right_hi → false
0008F6r 2                     ; Hi bytes equal — compare lo bytes (unsigned)
0008F6r 2  A5 rr              LDA   eval_left_lo
0008F8r 2  C5 rr              CMP   eval_val_lo
0008FAr 2  D0 0A              BNE   @lt_lo_diff
0008FCr 2                     ; Lo bytes equal — compare frac (unsigned)
0008FCr 2  A5 rr              LDA   eval_left_frac
0008FEr 2  C5 rr              CMP   eval_val_frac
000900r 2  F0 14              BEQ   @set_false            ; equal → not less
000902r 2  90 06              BCC   @set_true
000904r 2  80 10              BRA   @set_false
000906r 2               @lt_lo_diff:
000906r 2  90 02              BCC   @set_true
000908r 2  80 0C              BRA   @set_false
00090Ar 2               
00090Ar 2                     ; ----- Set result to TRUE (1) or FALSE (0) -----
00090Ar 2               @set_true:
00090Ar 2  64 rr              STZ   eval_val_hi
00090Cr 2  A9 01              LDA   #1
00090Er 2  85 rr              STA   eval_val_lo
000910r 2  64 rr              STZ   eval_val_frac
000912r 2  64 rr              STZ   eval_type
000914r 2  18                 CLC
000915r 2  60                 RTS
000916r 2               
000916r 2               @set_false:
000916r 2  64 rr              STZ   eval_val_hi
000918r 2  64 rr              STZ   eval_val_lo
00091Ar 2  64 rr              STZ   eval_val_frac
00091Cr 2  64 rr              STZ   eval_type
00091Er 2  18                 CLC
00091Fr 2  60                 RTS
000920r 2               
000920r 2               ; ---------------------------------------------------------------------
000920r 2               ; print_number — print eval_val as a signed decimal number
000920r 2               ;   Input: eval_val_hi/lo/frac (16.8 fixed-point, signed)
000920r 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
000920r 2               ; ---------------------------------------------------------------------
000920r 2               print_number:
000920r 2                     ; Check sign — if negative, print '-' and negate
000920r 2  A5 rr              LDA   eval_val_hi
000922r 2  10 1E              BPL   @positive
000924r 2                     ; Print minus sign
000924r 2  A9 2D              LDA   #'-'
000926r 2  8D 0E A0           STA   VGC_CHAROUT
000929r 2                     ; Negate 3-byte value (two's complement)
000929r 2  A5 rr              LDA   eval_val_frac
00092Br 2  49 FF              EOR   #$FF
00092Dr 2  18                 CLC
00092Er 2  69 01              ADC   #1
000930r 2  85 rr              STA   eval_val_frac
000932r 2  A5 rr              LDA   eval_val_lo
000934r 2  49 FF              EOR   #$FF
000936r 2  69 00              ADC   #0
000938r 2  85 rr              STA   eval_val_lo
00093Ar 2  A5 rr              LDA   eval_val_hi
00093Cr 2  49 FF              EOR   #$FF
00093Er 2  69 00              ADC   #0
000940r 2  85 rr              STA   eval_val_hi
000942r 2               
000942r 2               @positive:
000942r 2                     ; Print integer part (eval_val_hi:eval_val_lo as 16-bit unsigned)
000942r 2  20 rr rr           JSR   print_uint16
000945r 2               
000945r 2                     ; Print fractional part if non-zero
000945r 2  A5 rr              LDA   eval_val_frac
000947r 2  D0 01              BNE   @has_frac
000949r 2  60                 RTS
00094Ar 2               @has_frac:
00094Ar 2               
00094Ar 2                     ; Print decimal point
00094Ar 2  A9 2E              LDA   #'.'
00094Cr 2  8D 0E A0           STA   VGC_CHAROUT
00094Fr 2               
00094Fr 2                     ; Convert frac byte to decimal digits
00094Fr 2                     ; frac * 10 / 256 = first digit, repeat with remainder
00094Fr 2  A5 rr              LDA   eval_val_frac
000951r 2  8D rr rr           STA   num_tmp_lo
000954r 2  9C rr rr           STZ   num_tmp_hi
000957r 2               
000957r 2                     ; First digit: (frac * 10) >> 8
000957r 2                     ; frac * 10 = (frac * 8) + (frac * 2)
000957r 2  AD rr rr           LDA   num_tmp_lo
00095Ar 2  0A                 ASL
00095Br 2  8D rr rr           STA   num_val_lo          ; frac * 2
00095Er 2  AD rr rr           LDA   num_tmp_hi
000961r 2  2A                 ROL
000962r 2  8D rr rr           STA   num_val_hi
000965r 2               
000965r 2  0E rr rr           ASL   num_val_lo
000968r 2  2E rr rr           ROL   num_val_hi
00096Br 2  0E rr rr           ASL   num_val_lo
00096Er 2  2E rr rr           ROL   num_val_hi          ; frac * 8
000971r 2               
000971r 2  18                 CLC
000972r 2  AD rr rr           LDA   num_tmp_lo
000975r 2  0A                 ASL                       ; frac * 2 (low byte)
000976r 2  6D rr rr           ADC   num_val_lo
000979r 2  8D rr rr           STA   num_val_lo
00097Cr 2  AD rr rr           LDA   num_tmp_hi
00097Fr 2  2A                 ROL
000980r 2  6D rr rr           ADC   num_val_hi
000983r 2  8D rr rr           STA   num_val_hi          ; num_val = frac * 10
000986r 2               
000986r 2                     ; High byte = first decimal digit
000986r 2  AD rr rr           LDA   num_val_hi
000989r 2  09 30              ORA   #'0'
00098Br 2  8D 0E A0           STA   VGC_CHAROUT
00098Er 2               
00098Er 2                     ; Remainder = low byte → second digit
00098Er 2  AD rr rr           LDA   num_val_lo
000991r 2  8D rr rr           STA   num_tmp_lo
000994r 2  9C rr rr           STZ   num_tmp_hi
000997r 2               
000997r 2                     ; Second digit: (remainder * 10) >> 8
000997r 2  AD rr rr           LDA   num_tmp_lo
00099Ar 2  0A                 ASL
00099Br 2  8D rr rr           STA   num_val_lo
00099Er 2  AD rr rr           LDA   num_tmp_hi
0009A1r 2  2A                 ROL
0009A2r 2  8D rr rr           STA   num_val_hi
0009A5r 2               
0009A5r 2  0E rr rr           ASL   num_val_lo
0009A8r 2  2E rr rr           ROL   num_val_hi
0009ABr 2  0E rr rr           ASL   num_val_lo
0009AEr 2  2E rr rr           ROL   num_val_hi
0009B1r 2               
0009B1r 2  18                 CLC
0009B2r 2  AD rr rr           LDA   num_tmp_lo
0009B5r 2  0A                 ASL
0009B6r 2  6D rr rr           ADC   num_val_lo
0009B9r 2  8D rr rr           STA   num_val_lo
0009BCr 2  AD rr rr           LDA   num_tmp_hi
0009BFr 2  2A                 ROL
0009C0r 2  6D rr rr           ADC   num_val_hi
0009C3r 2  8D rr rr           STA   num_val_hi
0009C6r 2               
0009C6r 2                     ; High byte = second digit; skip if zero (trailing)
0009C6r 2  AD rr rr           LDA   num_val_hi
0009C9r 2  F0 05              BEQ   @done
0009CBr 2  09 30              ORA   #'0'
0009CDr 2  8D 0E A0           STA   VGC_CHAROUT
0009D0r 2               
0009D0r 2               @done:
0009D0r 2  60                 RTS
0009D1r 2               
0009D1r 2               ; ---------------------------------------------------------------------
0009D1r 2               ; print_uint16 — print eval_val_hi:eval_val_lo as unsigned decimal
0009D1r 2               ;   No leading zeros (except value 0 prints "0")
0009D1r 2               ;   Clobbers: A, X, Y, num_val_lo/hi, num_tmp_lo/hi
0009D1r 2               ; ---------------------------------------------------------------------
0009D1r 2               print_uint16:
0009D1r 2                     ; Copy to working regs
0009D1r 2  A5 rr              LDA   eval_val_lo
0009D3r 2  8D rr rr           STA   num_val_lo
0009D6r 2  A5 rr              LDA   eval_val_hi
0009D8r 2  8D rr rr           STA   num_val_hi
0009DBr 2               
0009DBr 2  A2 00              LDX   #0                  ; digit buffer index
0009DDr 2  A0 00              LDY   #0                  ; power-of-10 table index
0009DFr 2               
0009DFr 2               @div_loop:
0009DFr 2  9C rr rr           STZ   num_tmp_lo          ; digit counter for this power
0009E2r 2               @sub_loop:
0009E2r 2                     ; Subtract current power of 10
0009E2r 2  38                 SEC
0009E3r 2  AD rr rr           LDA   num_val_lo
0009E6r 2  F9 rr rr           SBC   pow10_lo,Y
0009E9r 2  48                 PHA
0009EAr 2  AD rr rr           LDA   num_val_hi
0009EDr 2  F9 rr rr           SBC   pow10_hi,Y
0009F0r 2  90 0C              BCC   @sub_done           ; underflow — done with this digit
0009F2r 2  8D rr rr           STA   num_val_hi
0009F5r 2  68                 PLA
0009F6r 2  8D rr rr           STA   num_val_lo
0009F9r 2  EE rr rr           INC   num_tmp_lo
0009FCr 2  80 E4              BRA   @sub_loop
0009FEr 2               @sub_done:
0009FEr 2  68                 PLA                       ; discard low byte from failed subtract
0009FFr 2  AD rr rr           LDA   num_tmp_lo
000A02r 2  9D rr rr           STA   pn_buf,X
000A05r 2  E8                 INX
000A06r 2  C8                 INY
000A07r 2  C0 05              CPY   #5                  ; 5 powers (10000,1000,100,10,1)
000A09r 2  90 D4              BCC   @div_loop
000A0Br 2               
000A0Br 2                     ; Print digits, suppressing leading zeros
000A0Br 2  A0 00              LDY   #0                  ; suppress flag (0=suppress)
000A0Dr 2  A2 00              LDX   #0
000A0Fr 2               @print_loop:
000A0Fr 2  BD rr rr           LDA   pn_buf,X
000A12r 2  D0 04              BNE   @nonzero
000A14r 2  C0 00              CPY   #0
000A16r 2  F0 07              BEQ   @maybe_skip        ; still suppressing
000A18r 2               @nonzero:
000A18r 2  A0 01              LDY   #1                  ; seen nonzero digit
000A1Ar 2  09 30              ORA   #'0'
000A1Cr 2  8D 0E A0           STA   VGC_CHAROUT
000A1Fr 2               @maybe_skip:
000A1Fr 2  E8                 INX
000A20r 2  E0 04              CPX   #4
000A22r 2  90 EB              BCC   @print_loop
000A24r 2                     ; Always print the last digit (ones place)
000A24r 2  AD rr rr           LDA   pn_buf+4
000A27r 2  09 30              ORA   #'0'
000A29r 2  8D 0E A0           STA   VGC_CHAROUT
000A2Cr 2  60                 RTS
000A2Dr 2               
000A2Dr 2               ; ---------------------------------------------------------------------
000A2Dr 2               ; try_throw_error — if a CATCH with tag "ERROR" is active, unwind to it
000A2Dr 2               ;   Called after error messages are printed. If no catch is active or
000A2Dr 2               ;   the tag doesn't match "ERROR", this is a no-op (returns normally).
000A2Dr 2               ;   If a match is found, this NEVER RETURNS — it unwinds the stack
000A2Dr 2               ;   via TXS and jumps to the catch resume point.
000A2Dr 2               ; ---------------------------------------------------------------------
000A2Dr 2               try_throw_error:
000A2Dr 2  A5 rr              LDA   catch_active
000A2Fr 2  F0 3A              BEQ   @no_catch
000A31r 2               
000A31r 2                     ; Compare catch_tag against "ERROR" (5 chars, uppercased)
000A31r 2  A5 rr              LDA   catch_tag_lo
000A33r 2  85 rr              STA   ptr2_lo
000A35r 2  A5 rr              LDA   catch_tag_hi
000A37r 2  85 rr              STA   ptr2_hi
000A39r 2  A9 rr              LDA   #<str_error_tag
000A3Br 2  85 rr              STA   ptr_lo
000A3Dr 2  A9 rr              LDA   #>str_error_tag
000A3Fr 2  85 rr              STA   ptr_hi
000A41r 2  20 rr rr           JSR   catch_tags_equal
000A44r 2  90 25              BCC   @no_catch
000A46r 2               
000A46r 2                     ; Match! Unwind stack to catch point and resume.
000A46r 2  A6 rr              LDX   catch_sp
000A48r 2  9A                 TXS
000A49r 2               
000A49r 2                     ; Restore previous catch frame from the restored stack
000A49r 2  68                 PLA
000A4Ar 2  85 rr              STA   catch_resume_hi
000A4Cr 2  68                 PLA
000A4Dr 2  85 rr              STA   catch_resume_lo
000A4Fr 2  68                 PLA
000A50r 2  85 rr              STA   catch_sp
000A52r 2  68                 PLA
000A53r 2  85 rr              STA   catch_tag_hi
000A55r 2  68                 PLA
000A56r 2  85 rr              STA   catch_tag_lo
000A58r 2  68                 PLA
000A59r 2  85 rr              STA   catch_active
000A5Br 2               
000A5Br 2                     ; Restore eval_in_body and discard saved tag pointer (3 bytes)
000A5Br 2  68                 PLA
000A5Cr 2  85 rr              STA   eval_in_body
000A5Er 2  68                 PLA                         ; tag_hi
000A5Fr 2  68                 PLA                         ; tag_lo
000A60r 2               
000A60r 2                     ; Set eval_cur to resume point (past the caught body)
000A60r 2  A5 rr              LDA   catch_resume_lo
000A62r 2  85 rr              STA   eval_cur_lo
000A64r 2  A5 rr              LDA   catch_resume_hi
000A66r 2  85 rr              STA   eval_cur_hi
000A68r 2               
000A68r 2  4C rr rr           JMP   eval_continue
000A6Br 2               
000A6Br 2               @no_catch:
000A6Br 2  60                 RTS
000A6Cr 2               
000A6Cr 2               ; ---------------------------------------------------------------------
000A6Cr 2               ; catch_tags_equal — compare two length-prefixed strings (case-insensitive)
000A6Cr 2               ;   Input: ptr_lo/hi = string A, ptr2_lo/hi = string B
000A6Cr 2               ;   Output: carry set = equal, carry clear = not equal
000A6Cr 2               ;   Clobbers: A, X, Y
000A6Cr 2               ; ---------------------------------------------------------------------
000A6Cr 2               catch_tags_equal:
000A6Cr 2  A0 00              LDY   #0
000A6Er 2  B1 rr              LDA   (ptr_lo),Y           ; length of A
000A70r 2  8D rr rr           STA   num_tmp_lo            ; temp: len A
000A73r 2  B1 rr              LDA   (ptr2_lo),Y          ; length of B
000A75r 2  CD rr rr           CMP   num_tmp_lo
000A78r 2  D0 2D              BNE   @ne
000A7Ar 2               
000A7Ar 2                     ; Lengths match — compare chars
000A7Ar 2  AA                 TAX                         ; X = length
000A7Br 2  F0 28              BEQ   @eq                   ; both zero = equal
000A7Dr 2  A0 01              LDY   #1
000A7Fr 2               @cmp:
000A7Fr 2  B1 rr              LDA   (ptr_lo),Y
000A81r 2                     ; Uppercase A char
000A81r 2  C9 61              CMP   #'a'
000A83r 2  90 07              BCC   @a_up
000A85r 2  C9 7B              CMP   #'z'+1
000A87r 2  B0 03              BCS   @a_up
000A89r 2  38                 SEC
000A8Ar 2  E9 20              SBC   #$20
000A8Cr 2               @a_up:
000A8Cr 2  8D rr rr           STA   num_tmp_lo            ; uppercased A char
000A8Fr 2               
000A8Fr 2  B1 rr              LDA   (ptr2_lo),Y
000A91r 2                     ; Uppercase B char
000A91r 2  C9 61              CMP   #'a'
000A93r 2  90 07              BCC   @b_up
000A95r 2  C9 7B              CMP   #'z'+1
000A97r 2  B0 03              BCS   @b_up
000A99r 2  38                 SEC
000A9Ar 2  E9 20              SBC   #$20
000A9Cr 2               @b_up:
000A9Cr 2  CD rr rr           CMP   num_tmp_lo
000A9Fr 2  D0 06              BNE   @ne
000AA1r 2  C8                 INY
000AA2r 2  CA                 DEX
000AA3r 2  D0 DA              BNE   @cmp
000AA5r 2               
000AA5r 2               @eq:
000AA5r 2  38                 SEC
000AA6r 2  60                 RTS
000AA7r 2               @ne:
000AA7r 2  18                 CLC
000AA8r 2  60                 RTS
000AA9r 2               
000AA9r 2               ; =====================================================================
000AA9r 2               ; RODATA — evaluator strings and tables
000AA9r 2               ; =====================================================================
000AA9r 2               ; ---------------------------------------------------------------------
000AA9r 2               ; lookup_ext_cmd — search ext_cmd_table for the current TOK_WORD
000AA9r 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000AA9r 2               ;   Output: Carry clear = found, A = arity, EXT_CMD set
000AA9r 2               ;           Carry set = not found
000AA9r 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000AA9r 2               ; ---------------------------------------------------------------------
000AA9r 2               lookup_ext_cmd:
000AA9r 2                     ; Save table pointer in num_tmp_lo/hi
000AA9r 2  A9 rr              LDA   #<ext_cmd_table
000AABr 2  8D rr rr           STA   num_tmp_lo
000AAEr 2  A9 rr              LDA   #>ext_cmd_table
000AB0r 2  8D rr rr           STA   num_tmp_hi
000AB3r 2               
000AB3r 2               @scan:
000AB3r 2                     ; Read name pointer from table
000AB3r 2  AD rr rr           LDA   num_tmp_lo
000AB6r 2  85 rr              STA   ptr2_lo
000AB8r 2  AD rr rr           LDA   num_tmp_hi
000ABBr 2  85 rr              STA   ptr2_hi
000ABDr 2  A0 00              LDY   #0
000ABFr 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000AC1r 2  AA                 TAX
000AC2r 2  C8                 INY
000AC3r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000AC5r 2  D0 06              BNE   @have_entry
000AC7r 2  E0 00              CPX   #0
000AC9r 2  D0 02              BNE   @have_entry
000ACBr 2                     ; Null pointer — end of table
000ACBr 2  38                 SEC
000ACCr 2  60                 RTS
000ACDr 2               
000ACDr 2               @have_entry:
000ACDr 2                     ; X = name_ptr_lo, A = name_ptr_hi
000ACDr 2  85 rr              STA   ptr2_hi
000ACFr 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000AD1r 2               
000AD1r 2                     ; Get token payload pointer
000AD1r 2  A5 rr              LDA   eval_cur_lo
000AD3r 2  85 rr              STA   ptr_lo
000AD5r 2  A5 rr              LDA   eval_cur_hi
000AD7r 2  85 rr              STA   ptr_hi
000AD9r 2               
000AD9r 2                     ; Compare length bytes
000AD9r 2  A0 00              LDY   #0
000ADBr 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000ADDr 2  A0 03              LDY   #TOK_PAYLOAD
000ADFr 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000AE1r 2  D0 35              BNE   @next
000AE3r 2               
000AE3r 2                     ; Lengths match — compare chars
000AE3r 2  AA                 TAX                       ; X = length
000AE4r 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000AE6r 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000AE8r 2               @cmp_loop:
000AE8r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000AEAr 2  5A                 PHY
000AEBr 2  A5 rr              LDA   tok_sign
000AEDr 2  18                 CLC
000AEEr 2  69 04              ADC   #TOK_PAYLOAD+1
000AF0r 2  A8                 TAY
000AF1r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000AF3r 2  7A                 PLY
000AF4r 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000AF6r 2  D0 20              BNE   @next
000AF8r 2  C8                 INY
000AF9r 2  E6 rr              INC   tok_sign
000AFBr 2  CA                 DEX
000AFCr 2  D0 EA              BNE   @cmp_loop
000AFEr 2               
000AFEr 2                     ; Match found — read module_id, fn_id and arity
000AFEr 2                     ; Table entry: name_ptr(2) + module_id(1) + fn_id(1) + arity(1)
000AFEr 2  AD rr rr           LDA   num_tmp_lo
000B01r 2  85 rr              STA   ptr_lo
000B03r 2  AD rr rr           LDA   num_tmp_hi
000B06r 2  85 rr              STA   ptr_hi
000B08r 2  A0 02              LDY   #2
000B0Ar 2  B1 rr              LDA   (ptr_lo),Y         ; module_id
000B0Cr 2  85 rr              STA   ext_mod_id
000B0Er 2  C8                 INY
000B0Fr 2  B1 rr              LDA   (ptr_lo),Y         ; fn_id (legacy EXT_CMD value)
000B11r 2  85 80              STA   EXT_CMD
000B13r 2  C8                 INY
000B14r 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000B16r 2  18                 CLC                       ; found
000B17r 2  60                 RTS
000B18r 2               
000B18r 2               @next:
000B18r 2  64 rr              STZ   tok_sign
000B1Ar 2                     ; Advance to next entry: +5 bytes (2 name + 1 module_id + 1 fn_id + 1 arity)
000B1Ar 2  18                 CLC
000B1Br 2  AD rr rr           LDA   num_tmp_lo
000B1Er 2  69 05              ADC   #5
000B20r 2  8D rr rr           STA   num_tmp_lo
000B23r 2  90 03              BCC   :+
000B25r 2  EE rr rr           INC   num_tmp_hi
000B28r 2               :
000B28r 2  4C rr rr           JMP   @scan
000B2Br 2               
000B2Br 2               ; ---------------------------------------------------------------------
000B2Br 2               ; ext_eval_args — evaluate X arguments and copy to EXT_ARG0..2 slots
000B2Br 2               ;   Input: X = argument count (0-3)
000B2Br 2               ;   Output: Carry clear = success, Carry set = error
000B2Br 2               ;           EXT_ARGC set, EXT_ARG0..2 populated
000B2Br 2               ;   Clobbers: A, X, Y
000B2Br 2               ; ---------------------------------------------------------------------
000B2Br 2               ext_eval_args:
000B2Br 2  86 81              STX   EXT_ARGC
000B2Dr 2  E0 00              CPX   #0
000B2Fr 2  F0 65              BEQ   @done
000B31r 2               
000B31r 2                     ; Evaluate arg 0
000B31r 2  DA                 PHX
000B32r 2  20 rr rr           JSR   eval_expr
000B35r 2  FA                 PLX
000B36r 2  B0 60              BCS   @err
000B38r 2  A5 rr              LDA   eval_type
000B3Ar 2  85 82              STA   EXT_ARG0_TYPE
000B3Cr 2  A5 rr              LDA   eval_val_hi
000B3Er 2  85 83              STA   EXT_ARG0_HI
000B40r 2  A5 rr              LDA   eval_val_lo
000B42r 2  85 84              STA   EXT_ARG0_LO
000B44r 2  A5 rr              LDA   eval_val_frac
000B46r 2  85 85              STA   EXT_ARG0_FRAC
000B48r 2  CA                 DEX
000B49r 2  F0 4B              BEQ   @done
000B4Br 2               
000B4Br 2                     ; Evaluate arg 1
000B4Br 2  DA                 PHX
000B4Cr 2  20 rr rr           JSR   eval_expr
000B4Fr 2  FA                 PLX
000B50r 2  B0 46              BCS   @err
000B52r 2  A5 rr              LDA   eval_type
000B54r 2  85 86              STA   EXT_ARG1_TYPE
000B56r 2  A5 rr              LDA   eval_val_hi
000B58r 2  85 87              STA   EXT_ARG1_HI
000B5Ar 2  A5 rr              LDA   eval_val_lo
000B5Cr 2  85 88              STA   EXT_ARG1_LO
000B5Er 2  A5 rr              LDA   eval_val_frac
000B60r 2  85 89              STA   EXT_ARG1_FRAC
000B62r 2  CA                 DEX
000B63r 2  F0 31              BEQ   @done
000B65r 2               
000B65r 2                     ; Evaluate arg 2
000B65r 2  DA                 PHX
000B66r 2  20 rr rr           JSR   eval_expr
000B69r 2  FA                 PLX
000B6Ar 2  B0 2C              BCS   @err
000B6Cr 2  A5 rr              LDA   eval_type
000B6Er 2  85 8A              STA   EXT_ARG2_TYPE
000B70r 2  A5 rr              LDA   eval_val_hi
000B72r 2  85 8B              STA   EXT_ARG2_HI
000B74r 2  A5 rr              LDA   eval_val_lo
000B76r 2  85 8C              STA   EXT_ARG2_LO
000B78r 2  A5 rr              LDA   eval_val_frac
000B7Ar 2  85 8D              STA   EXT_ARG2_FRAC
000B7Cr 2  CA                 DEX
000B7Dr 2  F0 17              BEQ   @done
000B7Fr 2               
000B7Fr 2                     ; Evaluate arg 3 (for LINE, RECT, FILL etc.)
000B7Fr 2  DA                 PHX
000B80r 2  20 rr rr           JSR   eval_expr
000B83r 2  FA                 PLX
000B84r 2  B0 12              BCS   @err
000B86r 2  A5 rr              LDA   eval_type
000B88r 2  85 9F              STA   EXT_ARG3_TYPE
000B8Ar 2  A5 rr              LDA   eval_val_hi
000B8Cr 2  85 A0              STA   EXT_ARG3_HI
000B8Er 2  A5 rr              LDA   eval_val_lo
000B90r 2  85 A1              STA   EXT_ARG3_LO
000B92r 2  A5 rr              LDA   eval_val_frac
000B94r 2  85 A2              STA   EXT_ARG3_FRAC
000B96r 2               
000B96r 2               @done:
000B96r 2  18                 CLC
000B97r 2  60                 RTS
000B98r 2               @err:
000B98r 2  38                 SEC
000B99r 2  60                 RTS
000B9Ar 2               
000B9Ar 2               ; ---------------------------------------------------------------------
000B9Ar 2               ; ext_invoke — dispatch the looked-up extension command and leave its
000B9Ar 2               ;   result in eval_type/eval_val_hi/eval_val_lo/eval_val_frac, then RTS.
000B9Ar 2               ;
000B9Ar 2               ;   Entry: args already evaluated (EXT_ARG0..3 + EXT_ARGC populated),
000B9Ar 2               ;          EXT_CMD = fn_id, ext_mod_id = module_id.
000B9Ar 2               ;
000B9Ar 2               ;   Branches on ext_mod_id:
000B9Ar 2               ;     MODULE_ID_NONE -> legacy RAM trampoline (JSR EXT_TRAMPOLINE).
000B9Ar 2               ;     non-zero       -> canonical paged-library lib_call mailbox.
000B9Ar 2               ;
000B9Ar 2               ;   NOTE: as of task 4c.1-2 every ext_cmd_table entry is MODULE_ID_NONE,
000B9Ar 2               ;   so the lib_call branch is dead-but-correct here; it is first executed
000B9Ar 2               ;   and verified end-to-end once 4c.1-3 flips the graphics entries to
000B9Ar 2               ;   MODULE_ID_GRAPHICS.
000B9Ar 2               ;
000B9Ar 2               ;   Clobbers: A, X, Y. May JMP err_idk_word on a lib error (no return).
000B9Ar 2               ; ---------------------------------------------------------------------
000B9Ar 2               ext_invoke:
000B9Ar 2  A5 rr              LDA   ext_mod_id
000B9Cr 2  D0 14              BNE   @lib_call             ; non-zero module id -> paged-library path
000B9Er 2               
000B9Er 2               ; --- Legacy path: RAM trampoline to extension ROM ---
000B9Er 2  20 70 02           JSR   EXT_TRAMPOLINE
000BA1r 2  A5 8E              LDA   EXT_RESULT_TYPE
000BA3r 2  85 rr              STA   eval_type
000BA5r 2  A5 8F              LDA   EXT_RESULT_HI
000BA7r 2  85 rr              STA   eval_val_hi
000BA9r 2  A5 90              LDA   EXT_RESULT_LO
000BABr 2  85 rr              STA   eval_val_lo
000BADr 2  A5 91              LDA   EXT_RESULT_FRAC
000BAFr 2  85 rr              STA   eval_val_frac
000BB1r 2  60                 RTS
000BB2r 2               
000BB2r 2               ; --- lib_call path: drive the canonical mailbox at $0300 ---
000BB2r 2               @lib_call:
000BB2r 2                     ; Convert EXT_ARGn (Logo 16.8: TYPE/HI/LO/FRAC) -> LIB_ARGn (32-bit LE).
000BB2r 2                     ; The GRAPHICS module reads each cell's low word as a signed s16, so map
000BB2r 2                     ; HI:LO into the cell low word, sign-extend into the high word, and DROP
000BB2r 2                     ; the fractional byte. Convert only n < EXT_ARGC cells.
000BB2r 2                     ;   LIB_ARGn+0 = EXT_ARGn_LO   LIB_ARGn+1 = EXT_ARGn_HI
000BB2r 2                     ;   LIB_ARGn+2 = LIB_ARGn+3 = $FF if EXT_ARGn_HI bit7 set else $00
000BB2r 2  A6 81              LDX   EXT_ARGC
000BB4r 2                     ; arg 0
000BB4r 2  E0 01              CPX   #1
000BB6r 2  90 58              BCC   @args_done
000BB8r 2  A5 84              LDA   EXT_ARG0_LO
000BBAr 2  8D 03 03           STA   LIB_ARG0+0
000BBDr 2  A5 83              LDA   EXT_ARG0_HI
000BBFr 2  8D 04 03           STA   LIB_ARG0+1            ; STA does not alter A; A still = HI byte
000BC2r 2  20 rr rr           JSR   @sign_of_a            ; A = $FF if HI bit7 set, else $00
000BC5r 2  8D 05 03           STA   LIB_ARG0+2
000BC8r 2  8D 06 03           STA   LIB_ARG0+3
000BCBr 2                     ; arg 1
000BCBr 2  E0 02              CPX   #2
000BCDr 2  90 41              BCC   @args_done
000BCFr 2  A5 88              LDA   EXT_ARG1_LO
000BD1r 2  8D 07 03           STA   LIB_ARG1+0
000BD4r 2  A5 87              LDA   EXT_ARG1_HI
000BD6r 2  8D 08 03           STA   LIB_ARG1+1
000BD9r 2  20 rr rr           JSR   @sign_of_a
000BDCr 2  8D 09 03           STA   LIB_ARG1+2
000BDFr 2  8D 0A 03           STA   LIB_ARG1+3
000BE2r 2                     ; arg 2
000BE2r 2  E0 03              CPX   #3
000BE4r 2  90 2A              BCC   @args_done
000BE6r 2  A5 8C              LDA   EXT_ARG2_LO
000BE8r 2  8D 0B 03           STA   LIB_ARG2+0
000BEBr 2  A5 8B              LDA   EXT_ARG2_HI
000BEDr 2  8D 0C 03           STA   LIB_ARG2+1
000BF0r 2  20 rr rr           JSR   @sign_of_a
000BF3r 2  8D 0D 03           STA   LIB_ARG2+2
000BF6r 2  8D 0E 03           STA   LIB_ARG2+3
000BF9r 2                     ; arg 3
000BF9r 2  E0 04              CPX   #4
000BFBr 2  90 13              BCC   @args_done
000BFDr 2  A5 A1              LDA   EXT_ARG3_LO
000BFFr 2  8D 0F 03           STA   LIB_ARG3+0
000C02r 2  A5 A0              LDA   EXT_ARG3_HI
000C04r 2  8D 10 03           STA   LIB_ARG3+1
000C07r 2  20 rr rr           JSR   @sign_of_a
000C0Ar 2  8D 11 03           STA   LIB_ARG3+2
000C0Dr 2  8D 12 03           STA   LIB_ARG3+3
000C10r 2               
000C10r 2               @args_done:
000C10r 2                     ; Populate module/function selectors and call the resident loader.
000C10r 2  A5 rr              LDA   ext_mod_id
000C12r 2  8D 00 03           STA   LIB_MOD_ID
000C15r 2  A5 80              LDA   EXT_CMD
000C17r 2  8D 01 03           STA   LIB_FN_ID
000C1Ar 2  20 20 03           JSR   LIB_LOADER_BAND       ; == JSR $0320 (resident lib_call)
000C1Dr 2               
000C1Dr 2                     ; A non-zero status aborts the line (unreachable until 4c.1-3).
000C1Dr 2  AD 02 03           LDA   LIB_STATUS
000C20r 2  D0 11              BNE   @lib_err
000C22r 2               
000C22r 2                     ; Copy LIB_RESULT low word into eval_val as a Logo integer.
000C22r 2  AD 13 03           LDA   LIB_RESULT+0
000C25r 2  85 rr              STA   eval_val_lo
000C27r 2  AD 14 03           LDA   LIB_RESULT+1
000C2Ar 2  85 rr              STA   eval_val_hi
000C2Cr 2  64 rr              STZ   eval_val_frac
000C2Er 2  A9 00              LDA   #VAL_NUMBER
000C30r 2  85 rr              STA   eval_type
000C32r 2  60                 RTS
000C33r 2               
000C33r 2               @lib_err:
000C33r 2  4C rr rr           JMP   err_idk_word
000C36r 2               
000C36r 2               ; @sign_of_a — sign-extend the s8 high byte in A to a full byte:
000C36r 2               ;   returns A = $FF if A bit7 was set, else A = $00. Preserves X/Y.
000C36r 2               @sign_of_a:
000C36r 2  29 80              AND   #$80                  ; isolate bit7
000C38r 2  F0 03              BEQ   @sign_zero
000C3Ar 2  A9 FF              LDA   #$FF
000C3Cr 2  60                 RTS
000C3Dr 2               @sign_zero:
000C3Dr 2  A9 00              LDA   #$00
000C3Fr 2  60                 RTS
000C40r 2               
000C40r 2                     .segment "RODATA"
000000r 2               
000000r 2               ; Extension command table: name_ptr(2) + module_id(1) + fn_id(1) + arity(1)
000000r 2               ; module_id is MODULE_ID_NONE for every entry (legacy RAM-trampoline path);
000000r 2               ; 4c.1-2 will set it per-command to route through the paged-library lib_call.
000000r 2               ; Terminated by $0000 sentinel.
000000r 2               ext_cmd_table:
000000r 2  rr rr              .word str_ext_test_name
000002r 2  00                 .byte MODULE_ID_NONE
000003r 2  01                 .byte EXT_CMD_TEST
000004r 2  01                 .byte 1                    ; arity: 1 argument
000005r 2  rr rr              .word str_ext_fd
000007r 2  00                 .byte MODULE_ID_NONE
000008r 2  10                 .byte EXT_CMD_FD
000009r 2  01                 .byte 1                    ; arity: 1 (distance)
00000Ar 2  rr rr              .word str_ext_forward
00000Cr 2  00                 .byte MODULE_ID_NONE
00000Dr 2  10                 .byte EXT_CMD_FD
00000Er 2  01                 .byte 1                    ; FORWARD alias
00000Fr 2  rr rr              .word str_ext_bk
000011r 2  00                 .byte MODULE_ID_NONE
000012r 2  11                 .byte EXT_CMD_BK
000013r 2  01                 .byte 1                    ; arity: 1 (distance)
000014r 2  rr rr              .word str_ext_back
000016r 2  00                 .byte MODULE_ID_NONE
000017r 2  11                 .byte EXT_CMD_BK
000018r 2  01                 .byte 1                    ; BACK alias
000019r 2  rr rr              .word str_ext_backward
00001Br 2  00                 .byte MODULE_ID_NONE
00001Cr 2  11                 .byte EXT_CMD_BK
00001Dr 2  01                 .byte 1                    ; BACKWARD alias
00001Er 2  rr rr              .word str_ext_rt
000020r 2  00                 .byte MODULE_ID_NONE
000021r 2  12                 .byte EXT_CMD_RT
000022r 2  01                 .byte 1                    ; arity: 1 (degrees)
000023r 2  rr rr              .word str_ext_right
000025r 2  00                 .byte MODULE_ID_NONE
000026r 2  12                 .byte EXT_CMD_RT
000027r 2  01                 .byte 1                    ; RIGHT alias
000028r 2  rr rr              .word str_ext_lt
00002Ar 2  00                 .byte MODULE_ID_NONE
00002Br 2  13                 .byte EXT_CMD_LT
00002Cr 2  01                 .byte 1                    ; arity: 1 (degrees)
00002Dr 2  rr rr              .word str_ext_left
00002Fr 2  00                 .byte MODULE_ID_NONE
000030r 2  13                 .byte EXT_CMD_LT
000031r 2  01                 .byte 1                    ; LEFT alias
000032r 2  rr rr              .word str_ext_cs
000034r 2  00                 .byte MODULE_ID_NONE
000035r 2  14                 .byte EXT_CMD_CS
000036r 2  00                 .byte 0                    ; arity: 0
000037r 2  rr rr              .word str_ext_clearscreen
000039r 2  00                 .byte MODULE_ID_NONE
00003Ar 2  14                 .byte EXT_CMD_CS
00003Br 2  00                 .byte 0                    ; CLEARSCREEN alias
00003Cr 2  rr rr              .word str_ext_draw
00003Er 2  00                 .byte MODULE_ID_NONE
00003Fr 2  14                 .byte EXT_CMD_CS
000040r 2  00                 .byte 0                    ; DRAW = CS alias
000041r 2  rr rr              .word str_ext_pu
000043r 2  00                 .byte MODULE_ID_NONE
000044r 2  15                 .byte EXT_CMD_PU
000045r 2  00                 .byte 0
000046r 2  rr rr              .word str_ext_penup
000048r 2  00                 .byte MODULE_ID_NONE
000049r 2  15                 .byte EXT_CMD_PU
00004Ar 2  00                 .byte 0                    ; PENUP alias
00004Br 2  rr rr              .word str_ext_pd
00004Dr 2  00                 .byte MODULE_ID_NONE
00004Er 2  16                 .byte EXT_CMD_PD
00004Fr 2  00                 .byte 0
000050r 2  rr rr              .word str_ext_pendown
000052r 2  00                 .byte MODULE_ID_NONE
000053r 2  16                 .byte EXT_CMD_PD
000054r 2  00                 .byte 0                    ; PENDOWN alias
000055r 2  rr rr              .word str_ext_st
000057r 2  00                 .byte MODULE_ID_NONE
000058r 2  17                 .byte EXT_CMD_ST
000059r 2  00                 .byte 0
00005Ar 2  rr rr              .word str_ext_showturtle
00005Cr 2  00                 .byte MODULE_ID_NONE
00005Dr 2  17                 .byte EXT_CMD_ST
00005Er 2  00                 .byte 0                    ; SHOWTURTLE alias
00005Fr 2  rr rr              .word str_ext_ht
000061r 2  00                 .byte MODULE_ID_NONE
000062r 2  18                 .byte EXT_CMD_HT
000063r 2  00                 .byte 0
000064r 2  rr rr              .word str_ext_hideturtle
000066r 2  00                 .byte MODULE_ID_NONE
