00211Br 2               ; ---------------------------------------------------------------------
00211Br 2               ; do_sentence — SENTENCE val1 val2: concatenate two values as flat list
00211Br 2               ;   Non-list args are wrapped as single-element lists first.
00211Br 2               ;   Arity 0: evaluates its own arguments
00211Br 2               ; ---------------------------------------------------------------------
00211Br 2               do_sentence:
00211Br 2                     ; Evaluate first arg
00211Br 2  20 rr rr           JSR   eval_expr
00211Er 2  90 03              BCC   :+
002120r 2  4C rr rr           JMP   @err
002123r 2               :
002123r 2                     ; Save first value
002123r 2  A5 rr              LDA   eval_type
002125r 2  48                 PHA
002126r 2  A5 rr              LDA   eval_val_hi
002128r 2  48                 PHA
002129r 2  A5 rr              LDA   eval_val_lo
00212Br 2  48                 PHA
00212Cr 2  A5 rr              LDA   eval_val_frac
00212Er 2  48                 PHA
00212Fr 2               
00212Fr 2                     ; Evaluate second arg
00212Fr 2  20 rr rr           JSR   eval_expr
002132r 2  90 03              BCC   :+
002134r 2  4C rr rr           JMP   @err_pop4
002137r 2               :
002137r 2                     ; Save second value
002137r 2  A5 rr              LDA   eval_type
002139r 2  48                 PHA
00213Ar 2  A5 rr              LDA   eval_val_hi
00213Cr 2  48                 PHA
00213Dr 2  A5 rr              LDA   eval_val_lo
00213Fr 2  48                 PHA
002140r 2  A5 rr              LDA   eval_val_frac
002142r 2  48                 PHA
002143r 2               
002143r 2                     ; Process first arg: if not list, wrap in single-element list
002143r 2                     ; First value is at stack offset 4..7 (under second value)
002143r 2  BA                 TSX
002144r 2  BD 08 01           LDA   $0108,X                 ; first type
002147r 2  C9 02              CMP   #VAL_LIST
002149r 2  F0 4D              BEQ   @first_is_list
00214Br 2               
00214Br 2                     ; Wrap first value as single-element list
00214Br 2  A9 07              LDA   #CONS_SIZE
00214Dr 2  A2 02              LDX   #ATYPE_CONS
00214Fr 2  20 rr rr           JSR   heap_alloc
002152r 2  90 03              BCC   :+
002154r 2  4C rr rr           JMP   @oom_pop8
002157r 2               :
002157r 2  A0 00              LDY   #CONS_TAG
002159r 2  A9 10              LDA   #CONS_PAIR
00215Br 2  91 rr              STA   (ptr_lo),Y
00215Dr 2  BA                 TSX
00215Er 2  BD 08 01           LDA   $0108,X                 ; first type
002161r 2  A0 01              LDY   #CONS_CAR_TYPE
002163r 2  91 rr              STA   (ptr_lo),Y
002165r 2  BD 07 01           LDA   $0107,X                 ; first hi
002168r 2  A0 02              LDY   #CONS_CAR_HI
00216Ar 2  91 rr              STA   (ptr_lo),Y
00216Cr 2  BD 06 01           LDA   $0106,X                 ; first lo
00216Fr 2  A0 03              LDY   #CONS_CAR_LO
002171r 2  91 rr              STA   (ptr_lo),Y
002173r 2  BD 05 01           LDA   $0105,X                 ; first frac
002176r 2  A0 04              LDY   #CONS_CAR_FRAC
002178r 2  91 rr              STA   (ptr_lo),Y
00217Ar 2  A0 05              LDY   #CONS_CDR_LO
00217Cr 2  A9 00              LDA   #0
00217Er 2  91 rr              STA   (ptr_lo),Y
002180r 2  A0 06              LDY   #CONS_CDR_HI
002182r 2  91 rr              STA   (ptr_lo),Y
002184r 2                     ; Update first value on stack to be VAL_LIST
002184r 2  A9 02              LDA   #VAL_LIST
002186r 2  9D 08 01           STA   $0108,X                 ; type = list
002189r 2  A5 rr              LDA   ptr_hi
00218Br 2  9D 07 01           STA   $0107,X                 ; hi = ptr_hi
00218Er 2  A5 rr              LDA   ptr_lo
002190r 2  9D 06 01           STA   $0106,X                 ; lo = ptr_lo
002193r 2  A9 00              LDA   #0
002195r 2  9D 05 01           STA   $0105,X                 ; frac = 0
002198r 2               
002198r 2               @first_is_list:
002198r 2                     ; Process second arg: if not list, wrap it
002198r 2  BA                 TSX
002199r 2  BD 04 01           LDA   $0104,X                 ; second type
00219Cr 2  C9 02              CMP   #VAL_LIST
00219Er 2  F0 4D              BEQ   @second_is_list
0021A0r 2               
0021A0r 2                     ; Wrap second value
0021A0r 2  A9 07              LDA   #CONS_SIZE
0021A2r 2  A2 02              LDX   #ATYPE_CONS
0021A4r 2  20 rr rr           JSR   heap_alloc
0021A7r 2  90 03              BCC   :+
0021A9r 2  4C rr rr           JMP   @oom_pop8
0021ACr 2               :
0021ACr 2  A0 00              LDY   #CONS_TAG
0021AEr 2  A9 10              LDA   #CONS_PAIR
0021B0r 2  91 rr              STA   (ptr_lo),Y
0021B2r 2  BA                 TSX
0021B3r 2  BD 04 01           LDA   $0104,X                 ; second type
0021B6r 2  A0 01              LDY   #CONS_CAR_TYPE
0021B8r 2  91 rr              STA   (ptr_lo),Y
0021BAr 2  BD 03 01           LDA   $0103,X                 ; second hi
0021BDr 2  A0 02              LDY   #CONS_CAR_HI
0021BFr 2  91 rr              STA   (ptr_lo),Y
0021C1r 2  BD 02 01           LDA   $0102,X                 ; second lo
0021C4r 2  A0 03              LDY   #CONS_CAR_LO
0021C6r 2  91 rr              STA   (ptr_lo),Y
0021C8r 2  BD 01 01           LDA   $0101,X                 ; second frac
0021CBr 2  A0 04              LDY   #CONS_CAR_FRAC
0021CDr 2  91 rr              STA   (ptr_lo),Y
0021CFr 2  A0 05              LDY   #CONS_CDR_LO
0021D1r 2  A9 00              LDA   #0
0021D3r 2  91 rr              STA   (ptr_lo),Y
0021D5r 2  A0 06              LDY   #CONS_CDR_HI
0021D7r 2  91 rr              STA   (ptr_lo),Y
0021D9r 2                     ; Update second value on stack
0021D9r 2  A9 02              LDA   #VAL_LIST
0021DBr 2  9D 04 01           STA   $0104,X
0021DEr 2  A5 rr              LDA   ptr_hi
0021E0r 2  9D 03 01           STA   $0103,X
0021E3r 2  A5 rr              LDA   ptr_lo
0021E5r 2  9D 02 01           STA   $0102,X
0021E8r 2  A9 00              LDA   #0
0021EAr 2  9D 01 01           STA   $0101,X
0021EDr 2               
0021EDr 2               @second_is_list:
0021EDr 2                     ; Pop second list pointer
0021EDr 2  68                 PLA                           ; frac (unused)
0021EEr 2  68                 PLA                           ; lo
0021EFr 2  85 rr              STA   list_tail_lo
0021F1r 2  68                 PLA                           ; hi
0021F2r 2  85 rr              STA   list_tail_hi
0021F4r 2  68                 PLA                           ; type (unused, known VAL_LIST)
0021F5r 2               
0021F5r 2                     ; Pop first list pointer
0021F5r 2  68                 PLA                           ; frac (unused)
0021F6r 2  68                 PLA                           ; lo
0021F7r 2  85 rr              STA   list_head_lo
0021F9r 2  68                 PLA                           ; hi
0021FAr 2  85 rr              STA   list_head_hi
0021FCr 2  68                 PLA                           ; type (unused)
0021FDr 2               
0021FDr 2                     ; If first list is empty, return second
0021FDr 2  A5 rr              LDA   list_head_lo
0021FFr 2  05 rr              ORA   list_head_hi
002201r 2  F0 44              BEQ   @se_return_second
002203r 2               
002203r 2                     ; Walk to end of first list, patch cdr to second
002203r 2  A5 rr              LDA   list_head_lo
002205r 2  85 rr              STA   list_ptr_lo
002207r 2  A5 rr              LDA   list_head_hi
002209r 2  85 rr              STA   list_ptr_hi
00220Br 2               @se_walk:
00220Br 2  A5 rr              LDA   list_ptr_lo
00220Dr 2  85 rr              STA   ptr_lo
00220Fr 2  A5 rr              LDA   list_ptr_hi
002211r 2  85 rr              STA   ptr_hi
002213r 2  A0 05              LDY   #CONS_CDR_LO
002215r 2  B1 rr              LDA   (ptr_lo),Y
002217r 2  AA                 TAX
002218r 2  A0 06              LDY   #CONS_CDR_HI
00221Ar 2  B1 rr              LDA   (ptr_lo),Y
00221Cr 2  09 00              ORA   #0
00221Er 2  D0 04              BNE   @se_next
002220r 2  E0 00              CPX   #0
002222r 2  F0 06              BEQ   @se_found_last
002224r 2               @se_next:
002224r 2  85 rr              STA   list_ptr_hi
002226r 2  86 rr              STX   list_ptr_lo
002228r 2  80 E1              BRA   @se_walk
00222Ar 2               
00222Ar 2               @se_found_last:
00222Ar 2                     ; Patch last cell's cdr to second list
00222Ar 2  A0 05              LDY   #CONS_CDR_LO
00222Cr 2  A5 rr              LDA   list_tail_lo
00222Er 2  91 rr              STA   (ptr_lo),Y
002230r 2  A0 06              LDY   #CONS_CDR_HI
002232r 2  A5 rr              LDA   list_tail_hi
002234r 2  91 rr              STA   (ptr_lo),Y
002236r 2               
002236r 2                     ; Return first list head
002236r 2  A9 02              LDA   #VAL_LIST
002238r 2  85 rr              STA   eval_type
00223Ar 2  A5 rr              LDA   list_head_lo
00223Cr 2  85 rr              STA   eval_val_lo
00223Er 2  A5 rr              LDA   list_head_hi
002240r 2  85 rr              STA   eval_val_hi
002242r 2  64 rr              STZ   eval_val_frac
002244r 2  4C rr rr           JMP   eval_continue
002247r 2               
002247r 2               @se_return_second:
002247r 2  A9 02              LDA   #VAL_LIST
002249r 2  85 rr              STA   eval_type
00224Br 2  A5 rr              LDA   list_tail_lo
00224Dr 2  85 rr              STA   eval_val_lo
00224Fr 2  A5 rr              LDA   list_tail_hi
002251r 2  85 rr              STA   eval_val_hi
002253r 2  64 rr              STZ   eval_val_frac
002255r 2  4C rr rr           JMP   eval_continue
