000380r 2               
000380r 2               ; Powers of 10 table (16-bit): 10000, 1000, 100, 10, 1
000380r 2               pow10_lo:
000380r 2  10 E8 64 0A        .byte <10000, <1000, <100, <10, <1
000384r 2  01           
000385r 2               pow10_hi:
000385r 2  27 03 00 00        .byte >10000, >1000, >100, >10, >1
000389r 2  00           
00038Ar 2               
00038Ar 1                     .include "builtins.s"
00038Ar 2               ; builtins.s — built-in command table and handlers
00038Ar 2               
00038Ar 2               ; =====================================================================
00038Ar 2               ; CODE segment — builtin lookup and handlers
00038Ar 2               ; =====================================================================
00038Ar 2                     .segment "CODE"
000BCAr 2               
000BCAr 2               ; ---------------------------------------------------------------------
000BCAr 2               ; lookup_builtin — search builtin table for the current TOK_WORD
000BCAr 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
000BCAr 2               ;   Output: Carry clear = found, ptr2_lo/hi = handler addr, A = arity
000BCAr 2               ;           Carry set = not found
000BCAr 2               ;   Clobbers: A, X, Y, num_tmp_lo/hi
000BCAr 2               ; ---------------------------------------------------------------------
000BCAr 2               lookup_builtin:
000BCAr 2                     ; Save table pointer in num_tmp_lo/hi
000BCAr 2  A9 rr              LDA   #<builtin_table
000BCCr 2  8D rr rr           STA   num_tmp_lo
000BCFr 2  A9 rr              LDA   #>builtin_table
000BD1r 2  8D rr rr           STA   num_tmp_hi
000BD4r 2               
000BD4r 2               @scan:
000BD4r 2                     ; Read name pointer from table
000BD4r 2  AD rr rr           LDA   num_tmp_lo
000BD7r 2  85 rr              STA   ptr2_lo
000BD9r 2  AD rr rr           LDA   num_tmp_hi
000BDCr 2  85 rr              STA   ptr2_hi
000BDEr 2  A0 00              LDY   #0
000BE0r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr low
000BE2r 2  AA                 TAX
000BE3r 2  C8                 INY
000BE4r 2  B1 rr              LDA   (ptr2_lo),Y        ; name_ptr high
000BE6r 2  D0 06              BNE   @have_entry
000BE8r 2  E0 00              CPX   #0
000BEAr 2  D0 02              BNE   @have_entry
000BECr 2                     ; Null pointer — end of table
000BECr 2  38                 SEC
000BEDr 2  60                 RTS
000BEEr 2               
000BEEr 2               @have_entry:
000BEEr 2                     ; X = name_ptr_lo, A = name_ptr_hi
000BEEr 2                     ; Compare the table name against the token payload
000BEEr 2                     ; Token payload: at eval_cur + TOK_PAYLOAD = length byte + chars
000BEEr 2  85 rr              STA   ptr2_hi
000BF0r 2  86 rr              STX   ptr2_lo             ; ptr2 now points to table name string
000BF2r 2               
000BF2r 2                     ; Get token payload pointer
000BF2r 2  A5 rr              LDA   eval_cur_lo
000BF4r 2  85 rr              STA   ptr_lo
000BF6r 2  A5 rr              LDA   eval_cur_hi
000BF8r 2  85 rr              STA   ptr_hi
000BFAr 2               
000BFAr 2                     ; Compare length bytes
000BFAr 2  A0 00              LDY   #0
000BFCr 2  B1 rr              LDA   (ptr2_lo),Y        ; table name length
000BFEr 2  A0 03              LDY   #TOK_PAYLOAD
000C00r 2  D1 rr              CMP   (ptr_lo),Y         ; token payload length
000C02r 2  D0 41              BNE   @next
000C04r 2               
000C04r 2                     ; Lengths match — compare chars
000C04r 2  AA                 TAX                       ; X = length
000C05r 2  A0 01              LDY   #1                  ; offset into table name string (after length)
000C07r 2  64 rr              STZ   tok_sign            ; reuse as token char offset counter
000C09r 2               @cmp_loop:
000C09r 2  B1 rr              LDA   (ptr2_lo),Y        ; table name char
000C0Br 2  5A                 PHY
000C0Cr 2                     ; Compute token char offset: TOK_PAYLOAD + 1 + tok_sign
000C0Cr 2  A5 rr              LDA   tok_sign
000C0Er 2  18                 CLC
000C0Fr 2  69 04              ADC   #TOK_PAYLOAD+1
000C11r 2  A8                 TAY
000C12r 2  B1 rr              LDA   (ptr_lo),Y         ; token char
000C14r 2  7A                 PLY
000C15r 2  D1 rr              CMP   (ptr2_lo),Y        ; compare
000C17r 2  D0 2C              BNE   @next
000C19r 2  C8                 INY
000C1Ar 2  E6 rr              INC   tok_sign
000C1Cr 2  CA                 DEX
000C1Dr 2  D0 EA              BNE   @cmp_loop
000C1Fr 2               
000C1Fr 2                     ; Match found — read handler address and arity
000C1Fr 2                     ; Table entry: name_ptr(2) + handler_addr(2) + arity(1)
000C1Fr 2                     ; handler is at table_base + 2, arity at table_base + 4
000C1Fr 2  AD rr rr           LDA   num_tmp_lo
000C22r 2  85 rr              STA   ptr2_lo
000C24r 2  AD rr rr           LDA   num_tmp_hi
000C27r 2  85 rr              STA   ptr2_hi
000C29r 2  A0 02              LDY   #2
000C2Br 2  B1 rr              LDA   (ptr2_lo),Y        ; handler low
000C2Dr 2  AA                 TAX
000C2Er 2  C8                 INY
000C2Fr 2  B1 rr              LDA   (ptr2_lo),Y        ; handler high
000C31r 2  85 rr              STA   ptr2_hi
000C33r 2  86 rr              STX   ptr2_lo             ; ptr2 = handler address (return value)
000C35r 2                     ; Read arity from the table (num_tmp = entry base)
000C35r 2  AD rr rr           LDA   num_tmp_lo
000C38r 2  85 rr              STA   ptr_lo
000C3Ar 2  AD rr rr           LDA   num_tmp_hi
000C3Dr 2  85 rr              STA   ptr_hi
000C3Fr 2  A0 04              LDY   #4
000C41r 2  B1 rr              LDA   (ptr_lo),Y         ; arity
000C43r 2  18                 CLC                       ; found
000C44r 2  60                 RTS
000C45r 2               
000C45r 2               @next:
000C45r 2  64 rr              STZ   tok_sign            ; reset comparison counter
000C47r 2                     ; Advance to next entry: +5 bytes (2 name + 2 handler + 1 arity)
000C47r 2  18                 CLC
000C48r 2  AD rr rr           LDA   num_tmp_lo
000C4Br 2  69 05              ADC   #5
000C4Dr 2  8D rr rr           STA   num_tmp_lo
000C50r 2  90 03              BCC   @next2
000C52r 2  EE rr rr           INC   num_tmp_hi
000C55r 2               @next2:
000C55r 2  4C rr rr           JMP   @scan
000C58r 2               
000C58r 2               ; ---------------------------------------------------------------------
000C58r 2               ; do_print — PRINT <expr>: evaluate arg and print with newline
000C58r 2               ;   Entry: eval_val/eval_type already set with the argument
000C58r 2               ;   Must JMP to eval_continue when done
000C58r 2               ; ---------------------------------------------------------------------
000C58r 2               ; do_print / do_type share one body. PRINT appends a newline; TYPE does not.
000C58r 2               ; The newline flag is carried on the stack across the (balanced) print calls.
000C58r 2               do_print:
000C58r 2  A9 FF              LDA   #$FF                 ; PRINT: append trailing newline
000C5Ar 2  80 02              BRA   pt_common
000C5Cr 2               do_type:
000C5Cr 2  A9 00              LDA   #$00                 ; TYPE: no trailing newline
000C5Er 2               pt_common:
000C5Er 2  48                 PHA                        ; save newline flag
000C5Fr 2  A5 rr              LDA   eval_type
000C61r 2  C9 02              CMP   #VAL_LIST
000C63r 2  F0 09              BEQ   pt_list
000C65r 2  C9 01              CMP   #VAL_WORD
000C67r 2  F0 0A              BEQ   pt_word
000C69r 2               
000C69r 2                     ; Print number
000C69r 2  20 rr rr           JSR   print_number
000C6Cr 2  80 1C              BRA   pt_done
000C6Er 2               
000C6Er 2               pt_list:
000C6Er 2  20 rr rr           JSR   print_list
000C71r 2  80 17              BRA   pt_done
000C73r 2               
000C73r 2               pt_word:
000C73r 2                     ; Print quoted word — eval_val_lo/hi points at length+chars
000C73r 2  A5 rr              LDA   eval_val_lo
000C75r 2  85 rr              STA   ptr_lo
000C77r 2  A5 rr              LDA   eval_val_hi
000C79r 2  85 rr              STA   ptr_hi
000C7Br 2  A0 00              LDY   #0
000C7Dr 2  B1 rr              LDA   (ptr_lo),Y         ; length
000C7Fr 2  AA                 TAX
000C80r 2  C8                 INY
000C81r 2               pt_wch:
000C81r 2  B1 rr              LDA   (ptr_lo),Y
000C83r 2  8D 0E A0           STA   VGC_CHAROUT
000C86r 2  C8                 INY
000C87r 2  CA                 DEX
000C88r 2  D0 F7              BNE   pt_wch
000C8Ar 2               
000C8Ar 2               pt_done:
000C8Ar 2  68                 PLA                        ; restore newline flag
000C8Br 2  F0 03              BEQ   pt_no_nl
000C8Dr 2  20 rr rr           JSR   eval_newline
000C90r 2               pt_no_nl:
000C90r 2  4C rr rr           JMP   eval_continue
000C93r 2               
000C93r 2               ; ---------------------------------------------------------------------
000C93r 2               ; do_type — TYPE <expr>: like PRINT but no newline
000C93r 2               ; ---------------------------------------------------------------------
000C93r 2               ; ---------------------------------------------------------------------
000C93r 2               ; do_make — MAKE "name value: store a variable
000C93r 2               ;   Arity 0 — we do our own argument evaluation
000C93r 2               ;   1. eval_expr → name (must be TOK_QUOTE → word type)
000C93r 2               ;   2. save name pointer
000C93r 2               ;   3. eval_expr → value
000C93r 2               ;   4. var_set(saved name, current value)
000C93r 2               ; ---------------------------------------------------------------------
000C93r 2               do_make:
000C93r 2                     ; Evaluate first argument: the name (a quoted word)
000C93r 2  20 rr rr           JSR   eval_expr
000C96r 2  B0 1F              BCS   @err
000C98r 2               
000C98r 2                     ; Must be a word (type $01)
000C98r 2  A5 rr              LDA   eval_type
000C9Ar 2  C9 01              CMP   #$01
000C9Cr 2  D0 19              BNE   @err
000C9Er 2               
000C9Er 2                     ; Save the name pointer (points into token payload: len + chars)
000C9Er 2  A5 rr              LDA   eval_val_lo
000CA0r 2  48                 PHA
000CA1r 2  A5 rr              LDA   eval_val_hi
000CA3r 2  48                 PHA
000CA4r 2               
000CA4r 2                     ; Evaluate second argument: the value
000CA4r 2  20 rr rr           JSR   eval_expr
000CA7r 2  B0 0C              BCS   @err_pop
000CA9r 2               
000CA9r 2                     ; Set up ptr_lo/hi → saved name, eval_val holds value
000CA9r 2  68                 PLA
000CAAr 2  85 rr              STA   ptr_hi
000CACr 2  68                 PLA
000CADr 2  85 rr              STA   ptr_lo
000CAFr 2               
000CAFr 2  20 rr rr           JSR   var_set
000CB2r 2  4C rr rr           JMP   eval_continue
000CB5r 2               
000CB5r 2               @err_pop:
000CB5r 2  68                 PLA
000CB6r 2  68                 PLA
000CB7r 2               @err:
000CB7r 2                     ; Print error
000CB7r 2  A2 rr              LDX   #<str_make_name
000CB9r 2  A0 rr              LDY   #>str_make_name
000CBBr 2  4C rr rr           JMP   err_nei
000CBEr 2               
000CBEr 2               ; ---------------------------------------------------------------------
000CBEr 2               ; do_repeat — REPEAT count [body]
000CBEr 2               ;   Arity 0 — handles its own argument parsing
000CBEr 2               ;   1. Evaluate count expression
000CBEr 2               ;   2. Locate the bracketed body [...]
000CBEr 2               ;   3. Execute the body count times
000CBEr 2               ;   4. Resume after the closing ]
000CBEr 2               ;
000CBEr 2               ;   Nesting: saves/restores repeat state (body_start, body_resume,
000CBEr 2               ;   repeat_count, eval_in_body) on the hardware stack so nested
000CBEr 2               ;   REPEAT works correctly.
000CBEr 2               ; ---------------------------------------------------------------------
000CBEr 2               
000CBEr 2                     .segment "ZEROPAGE"
000022r 2  xx           repeat_count_lo:  .res 1
000023r 2  xx           repeat_count_hi:  .res 1
000024r 2  xx           body_start_lo:    .res 1       ; first token after [
