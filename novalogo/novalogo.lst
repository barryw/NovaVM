001DE9r 2               @item_walk:
001DE9r 2  A5 rr              LDA   list_ptr_lo
001DEBr 2  05 rr              ORA   list_ptr_hi
001DEDr 2  F0 5B              BEQ   @err_range
001DEFr 2               
001DEFr 2                     ; Decrement index
001DEFr 2  A5 rr              LDA   list_count_lo
