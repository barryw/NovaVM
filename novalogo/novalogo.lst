00061Er 2               
00061Er 1                     .include "vars.s"
00061Er 2               ; vars.s — variable storage for NovaLogo (MAKE / :reference)
00061Er 2               ;
00061Er 2               ; Variables are stored as a linked list of heap entries.
00061Er 2               ; Entry layout:
00061Er 2               ;   +0: next_lo  (2 bytes — pointer to next entry, or $0000)
00061Er 2               ;   +1: next_hi
00061Er 2               ;   +2: name_len (1 byte)
00061Er 2               ;   +3: name chars (name_len bytes, uppercased)
00061Er 2               ;   +3+name_len: value_type (1 byte: $00=number, $01=word)
00061Er 2               ;   +4+name_len: val_hi  (or ptr_lo for word)
00061Er 2               ;   +5+name_len: val_lo  (or ptr_hi for word)
00061Er 2               ;   +6+name_len: val_frac (0 for word)
00061Er 2               ;   +7+name_len: pad     (0)
00061Er 2               ;
00061Er 2               ; Total entry size = 8 + name_len bytes.
00061Er 2               
00061Er 2               ; Entry field offsets (relative to entry base)
00061Er 2               VAR_NEXT_LO  = 0
00061Er 2               VAR_NEXT_HI  = 1
00061Er 2               VAR_NAME_LEN = 2
00061Er 2               VAR_NAME     = 3              ; first char of name
00061Er 2               
00061Er 2               ; =====================================================================
00061Er 2               ; ZEROPAGE segment — variable list head + scratch
00061Er 2               ; =====================================================================
00061Er 2                     .segment "ZEROPAGE"
000037r 2               
000037r 2  xx           var_head_lo:    .res 1        ; head of variable linked list
000038r 2  xx           var_head_hi:    .res 1
000039r 2  xx           var_entry_lo:   .res 1        ; current entry pointer (walk scratch)
00003Ar 2  xx           var_entry_hi:   .res 1
00003Br 2  xx           var_name_lo:    .res 1        ; saved name pointer for set/get
00003Cr 2  xx           var_name_hi:    .res 1
00003Dr 2               
00003Dr 2               ; =====================================================================
00003Dr 2               ; CODE segment — variable routines
00003Dr 2               ; =====================================================================
00003Dr 2                     .segment "CODE"
002518r 2               
002518r 2               ; ---------------------------------------------------------------------
002518r 2               ; var_init — initialize variable list to empty
002518r 2               ;   Called once at cold_start
002518r 2               ; ---------------------------------------------------------------------
002518r 2               var_init:
002518r 2  64 rr              STZ   var_head_lo
00251Ar 2  64 rr              STZ   var_head_hi
00251Cr 2  60                 RTS
00251Dr 2               
00251Dr 2               ; ---------------------------------------------------------------------
00251Dr 2               ; var_set — store a value under a variable name
00251Dr 2               ;   Input: ptr_lo/hi → length-prefixed name string (in token node)
00251Dr 2               ;          eval_type, eval_val_hi/lo/frac = value to store
00251Dr 2               ;   Clobbers: A, X, Y, ptr_lo/hi, ptr2_lo/hi, var_entry, var_name
00251Dr 2               ; ---------------------------------------------------------------------
00251Dr 2               var_set:
00251Dr 2                     ; Save name pointer — we need it after the walk
00251Dr 2  A5 rr              LDA   ptr_lo
00251Fr 2  85 rr              STA   var_name_lo
002521r 2  A5 rr              LDA   ptr_hi
002523r 2  85 rr              STA   var_name_hi
002525r 2               
002525r 2                     ; Walk the list looking for an existing entry with this name
002525r 2  A5 rr              LDA   var_head_lo
002527r 2  85 rr              STA   var_entry_lo
002529r 2  A5 rr              LDA   var_head_hi
00252Br 2  85 rr              STA   var_entry_hi
00252Dr 2               
00252Dr 2               @walk:
00252Dr 2                     ; End of list?
00252Dr 2  A5 rr              LDA   var_entry_lo
00252Fr 2  05 rr              ORA   var_entry_hi
002531r 2  F0 44              BEQ   @not_found
002533r 2               
002533r 2                     ; Compare name in entry against var_name
002533r 2  20 rr rr           JSR   var_names_equal
002536r 2  B0 16              BCS   @found
002538r 2               
002538r 2                     ; Advance to next entry
002538r 2  A5 rr              LDA   var_entry_lo
00253Ar 2  85 rr              STA   ptr2_lo
00253Cr 2  A5 rr              LDA   var_entry_hi
00253Er 2  85 rr              STA   ptr2_hi
002540r 2  A0 00              LDY   #VAR_NEXT_LO
002542r 2  B1 rr              LDA   (ptr2_lo),Y
002544r 2  AA                 TAX
002545r 2  C8                 INY
002546r 2  B1 rr              LDA   (ptr2_lo),Y
002548r 2  85 rr              STA   var_entry_hi
00254Ar 2  86 rr              STX   var_entry_lo
00254Cr 2  80 DF              BRA   @walk
00254Er 2               
00254Er 2               @found:
00254Er 2                     ; Overwrite value in place
00254Er 2                     ; Value starts at entry + 3 + name_len
00254Er 2  A5 rr              LDA   var_entry_lo
002550r 2  85 rr              STA   ptr2_lo
002552r 2  A5 rr              LDA   var_entry_hi
002554r 2  85 rr              STA   ptr2_hi
002556r 2  A0 02              LDY   #VAR_NAME_LEN
002558r 2  B1 rr              LDA   (ptr2_lo),Y          ; name_len
00255Ar 2  18                 CLC
00255Br 2  69 03              ADC   #VAR_NAME             ; A = 3 + name_len = offset to value_type
00255Dr 2  A8                 TAY
00255Er 2  A5 rr              LDA   eval_type
002560r 2  91 rr              STA   (ptr2_lo),Y
002562r 2  C8                 INY
002563r 2  A5 rr              LDA   eval_val_hi
002565r 2  91 rr              STA   (ptr2_lo),Y
002567r 2  C8                 INY
002568r 2  A5 rr              LDA   eval_val_lo
00256Ar 2  91 rr              STA   (ptr2_lo),Y
00256Cr 2  C8                 INY
00256Dr 2  A5 rr              LDA   eval_val_frac
00256Fr 2  91 rr              STA   (ptr2_lo),Y
002571r 2  C8                 INY
002572r 2  A9 00              LDA   #0
002574r 2  91 rr              STA   (ptr2_lo),Y          ; pad
002576r 2  60                 RTS
002577r 2               
002577r 2               @not_found:
002577r 2                     ; Allocate a new entry: 8 + name_len bytes
002577r 2                     ; Read name_len from the name string
002577r 2  A5 rr              LDA   var_name_lo
002579r 2  85 rr              STA   ptr_lo
00257Br 2  A5 rr              LDA   var_name_hi
00257Dr 2  85 rr              STA   ptr_hi
00257Fr 2  A0 00              LDY   #0
002581r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002583r 2  48                 PHA                         ; save name_len
002584r 2  18                 CLC
002585r 2  69 08              ADC   #8                    ; total entry size
002587r 2  A2 03              LDX   #ATYPE_VAR
002589r 2  20 rr rr           JSR   heap_alloc
00258Cr 2  B0 62              BCS   @oom
00258Er 2               
00258Er 2                     ; ptr_lo/hi now points to new entry
00258Er 2                     ; Set next → current head
00258Er 2  A0 00              LDY   #VAR_NEXT_LO
002590r 2  A5 rr              LDA   var_head_lo
002592r 2  91 rr              STA   (ptr_lo),Y
002594r 2  C8                 INY
002595r 2  A5 rr              LDA   var_head_hi
002597r 2  91 rr              STA   (ptr_lo),Y
002599r 2               
002599r 2                     ; Copy name_len
002599r 2  68                 PLA                         ; A = name_len
00259Ar 2  48                 PHA                         ; keep it on stack
00259Br 2  A0 02              LDY   #VAR_NAME_LEN
00259Dr 2  91 rr              STA   (ptr_lo),Y
00259Fr 2               
00259Fr 2                     ; Copy name chars (uppercased) from var_name source
00259Fr 2  68                 PLA                         ; A = name_len
0025A0r 2  AA                 TAX                         ; X = remaining chars
0025A1r 2  F0 2C              BEQ   @name_done            ; zero-length name (shouldn't happen)
0025A3r 2  A0 03              LDY   #VAR_NAME             ; dest offset in entry
0025A5r 2  9C rr rr           STZ   num_tmp_lo            ; source offset counter
0025A8r 2               
0025A8r 2               @copy_name:
0025A8r 2  DA                 PHX
0025A9r 2  5A                 PHY
0025AAr 2                     ; Read source char
0025AAr 2  A5 rr              LDA   var_name_lo
0025ACr 2  85 rr              STA   ptr2_lo
0025AEr 2  A5 rr              LDA   var_name_hi
0025B0r 2  85 rr              STA   ptr2_hi
0025B2r 2  AD rr rr           LDA   num_tmp_lo
0025B5r 2  1A                 INC                         ; skip length byte → offset = idx + 1
0025B6r 2  A8                 TAY
0025B7r 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
0025B9r 2                     ; Uppercase
0025B9r 2  C9 61              CMP   #'a'
0025BBr 2  90 07              BCC   @noup
0025BDr 2  C9 7B              CMP   #'z'+1
0025BFr 2  B0 03              BCS   @noup
0025C1r 2  38                 SEC
0025C2r 2  E9 20              SBC   #$20
0025C4r 2               @noup:
0025C4r 2  7A                 PLY                         ; restore dest offset
0025C5r 2  91 rr              STA   (ptr_lo),Y           ; write to entry
0025C7r 2  C8                 INY
0025C8r 2  EE rr rr           INC   num_tmp_lo
0025CBr 2  FA                 PLX
0025CCr 2  CA                 DEX
0025CDr 2  D0 D9              BNE   @copy_name
0025CFr 2               
0025CFr 2               @name_done:
0025CFr 2                     ; Write value after name
0025CFr 2                     ; Y is already at VAR_NAME + name_len = value_type offset
0025CFr 2  A5 rr              LDA   eval_type
0025D1r 2  91 rr              STA   (ptr_lo),Y
0025D3r 2  C8                 INY
0025D4r 2  A5 rr              LDA   eval_val_hi
0025D6r 2  91 rr              STA   (ptr_lo),Y
0025D8r 2  C8                 INY
0025D9r 2  A5 rr              LDA   eval_val_lo
0025DBr 2  91 rr              STA   (ptr_lo),Y
0025DDr 2  C8                 INY
0025DEr 2  A5 rr              LDA   eval_val_frac
0025E0r 2  91 rr              STA   (ptr_lo),Y
0025E2r 2  C8                 INY
0025E3r 2  A9 00              LDA   #0
0025E5r 2  91 rr              STA   (ptr_lo),Y           ; pad
0025E7r 2               
0025E7r 2                     ; Prepend to list: head = new entry
0025E7r 2  A5 rr              LDA   ptr_lo
0025E9r 2  85 rr              STA   var_head_lo
0025EBr 2  A5 rr              LDA   ptr_hi
0025EDr 2  85 rr              STA   var_head_hi
0025EFr 2  60                 RTS
0025F0r 2               
0025F0r 2               @oom:
0025F0r 2  68                 PLA                         ; discard saved name_len
0025F1r 2  60                 RTS
0025F2r 2               
0025F2r 2               ; ---------------------------------------------------------------------
0025F2r 2               ; var_get — look up a variable by name
0025F2r 2               ;   Input: ptr_lo/hi → length-prefixed name string
0025F2r 2               ;   Output: Carry clear = found, eval_type/eval_val set
0025F2r 2               ;           Carry set = not found
0025F2r 2               ;   Clobbers: A, X, Y, ptr2, var_entry, var_name
0025F2r 2               ; ---------------------------------------------------------------------
0025F2r 2               var_get:
0025F2r 2                     ; Save name pointer
0025F2r 2  A5 rr              LDA   ptr_lo
0025F4r 2  85 rr              STA   var_name_lo
0025F6r 2  A5 rr              LDA   ptr_hi
0025F8r 2  85 rr              STA   var_name_hi
0025FAr 2               
0025FAr 2                     ; Walk the list
0025FAr 2  A5 rr              LDA   var_head_lo
0025FCr 2  85 rr              STA   var_entry_lo
0025FEr 2  A5 rr              LDA   var_head_hi
002600r 2  85 rr              STA   var_entry_hi
002602r 2               
002602r 2               @walk:
002602r 2  A5 rr              LDA   var_entry_lo
002604r 2  05 rr              ORA   var_entry_hi
002606r 2  F0 40              BEQ   @not_found
002608r 2               
002608r 2  20 rr rr           JSR   var_names_equal
00260Br 2  B0 16              BCS   @found
00260Dr 2               
00260Dr 2                     ; Advance to next
00260Dr 2  A5 rr              LDA   var_entry_lo
00260Fr 2  85 rr              STA   ptr2_lo
002611r 2  A5 rr              LDA   var_entry_hi
002613r 2  85 rr              STA   ptr2_hi
002615r 2  A0 00              LDY   #VAR_NEXT_LO
002617r 2  B1 rr              LDA   (ptr2_lo),Y
002619r 2  AA                 TAX
00261Ar 2  C8                 INY
00261Br 2  B1 rr              LDA   (ptr2_lo),Y
00261Dr 2  85 rr              STA   var_entry_hi
00261Fr 2  86 rr              STX   var_entry_lo
002621r 2  80 DF              BRA   @walk
002623r 2               
002623r 2               @found:
002623r 2                     ; Read value from entry + 3 + name_len
002623r 2  A5 rr              LDA   var_entry_lo
002625r 2  85 rr              STA   ptr2_lo
002627r 2  A5 rr              LDA   var_entry_hi
002629r 2  85 rr              STA   ptr2_hi
00262Br 2  A0 02              LDY   #VAR_NAME_LEN
00262Dr 2  B1 rr              LDA   (ptr2_lo),Y
00262Fr 2  18                 CLC
002630r 2  69 03              ADC   #VAR_NAME
002632r 2  A8                 TAY
002633r 2  B1 rr              LDA   (ptr2_lo),Y          ; value_type
002635r 2  85 rr              STA   eval_type
002637r 2  C8                 INY
002638r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_hi
00263Ar 2  85 rr              STA   eval_val_hi
00263Cr 2  C8                 INY
00263Dr 2  B1 rr              LDA   (ptr2_lo),Y          ; val_lo
00263Fr 2  85 rr              STA   eval_val_lo
002641r 2  C8                 INY
002642r 2  B1 rr              LDA   (ptr2_lo),Y          ; val_frac
002644r 2  85 rr              STA   eval_val_frac
002646r 2  18                 CLC
002647r 2  60                 RTS
002648r 2               
002648r 2               @not_found:
002648r 2  38                 SEC
002649r 2  60                 RTS
00264Ar 2               
00264Ar 2               ; ---------------------------------------------------------------------
00264Ar 2               ; var_names_equal — compare name at var_name_lo/hi against entry at var_entry
00264Ar 2               ;   The name source is length-prefixed (from token / quote).
00264Ar 2               ;   The entry stores: name_len at +2, chars at +3 (already uppercased).
00264Ar 2               ;   The source name chars are uppercased during comparison.
00264Ar 2               ;   Returns: Carry set = equal, Carry clear = not equal
00264Ar 2               ;   Clobbers: A, X, Y, ptr2
00264Ar 2               ; ---------------------------------------------------------------------
00264Ar 2               var_names_equal:
00264Ar 2                     ; Read source name length
00264Ar 2  A5 rr              LDA   var_name_lo
00264Cr 2  85 rr              STA   ptr2_lo
00264Er 2  A5 rr              LDA   var_name_hi
002650r 2  85 rr              STA   ptr2_hi
002652r 2  A0 00              LDY   #0
002654r 2  B1 rr              LDA   (ptr2_lo),Y          ; source name_len
002656r 2  AA                 TAX                         ; X = source name_len
002657r 2               
002657r 2                     ; Read entry name length
002657r 2  A5 rr              LDA   var_entry_lo
002659r 2  85 rr              STA   ptr2_lo
00265Br 2  A5 rr              LDA   var_entry_hi
00265Dr 2  85 rr              STA   ptr2_hi
00265Fr 2  A0 02              LDY   #VAR_NAME_LEN
002661r 2  B1 rr              LDA   (ptr2_lo),Y          ; entry name_len
002663r 2               
002663r 2                     ; Compare lengths
002663r 2  8E rr rr           STX   num_tmp_lo            ; save source length
002666r 2  CD rr rr           CMP   num_tmp_lo
002669r 2  D0 43              BNE   @ne
00266Br 2               
00266Br 2                     ; Lengths match — compare chars
00266Br 2  E0 00              CPX   #0
00266Dr 2  F0 3B              BEQ   @eq                   ; both zero-length — equal
00266Fr 2  A0 00              LDY   #0                    ; char index
002671r 2               
002671r 2               @cmp_loop:
002671r 2  DA                 PHX
002672r 2  5A                 PHY
002673r 2                     ; Read source char (var_name + 1 + Y)
002673r 2  A5 rr              LDA   var_name_lo
002675r 2  85 rr              STA   ptr2_lo
002677r 2  A5 rr              LDA   var_name_hi
002679r 2  85 rr              STA   ptr2_hi
00267Br 2  98                 TYA
00267Cr 2  1A                 INC                         ; skip length byte
00267Dr 2  A8                 TAY
00267Er 2  B1 rr              LDA   (ptr2_lo),Y          ; source char
002680r 2                     ; Uppercase it
002680r 2  C9 61              CMP   #'a'
002682r 2  90 07              BCC   @noup
002684r 2  C9 7B              CMP   #'z'+1
002686r 2  B0 03              BCS   @noup
002688r 2  38                 SEC
002689r 2  E9 20              SBC   #$20
00268Br 2               @noup:
00268Br 2  8D rr rr           STA   num_tmp_hi            ; temp: uppercased source char
00268Er 2               
00268Er 2                     ; Read entry char (var_entry + VAR_NAME + Y)
00268Er 2  7A                 PLY                         ; restore char index
00268Fr 2  5A                 PHY
002690r 2  A5 rr              LDA   var_entry_lo
002692r 2  85 rr              STA   ptr2_lo
002694r 2  A5 rr              LDA   var_entry_hi
002696r 2  85 rr              STA   ptr2_hi
002698r 2  98                 TYA
002699r 2  18                 CLC
00269Ar 2  69 03              ADC   #VAR_NAME
00269Cr 2  A8                 TAY
00269Dr 2  B1 rr              LDA   (ptr2_lo),Y          ; entry char (already uppercase)
00269Fr 2               
00269Fr 2  CD rr rr           CMP   num_tmp_hi
0026A2r 2                     ; 65C02: PLY/PLX clobber flags! Must branch BEFORE pulling.
0026A2r 2  D0 08              BNE   @ne_pull
0026A4r 2               
0026A4r 2  7A                 PLY
0026A5r 2  FA                 PLX
0026A6r 2  C8                 INY
0026A7r 2  CA                 DEX
0026A8r 2  D0 C7              BNE   @cmp_loop
0026AAr 2               
0026AAr 2               @eq:
0026AAr 2  38                 SEC                         ; equal
0026ABr 2  60                 RTS
0026ACr 2               
0026ACr 2               @ne_pull:
0026ACr 2  7A                 PLY                         ; clean up stack
0026ADr 2  FA                 PLX
0026AEr 2               @ne:
0026AEr 2  18                 CLC                         ; not equal
0026AFr 2  60                 RTS
0026B0r 2               
0026B0r 1                     .include "procedures.s"
0026B0r 2               ; procedures.s — user-defined procedure storage and invocation
0026B0r 2               ;
0026B0r 2               ; Procedure record layout (heap-allocated linked list):
0026B0r 2               ;   +0: next_lo
0026B0r 2               ;   +1: next_hi    (pointer to next procedure, or $0000)
0026B0r 2               ;   +2: name_len   (1 byte)
0026B0r 2               ;   +3..3+NL-1: name chars (uppercased)
0026B0r 2               ;   +3+NL: param_count (1 byte)
0026B0r 2               ;   For each param:
0026B0r 2               ;     1 byte: param_name_len
0026B0r 2               ;     N bytes: param_name chars (uppercased)
0026B0r 2               ;   After all params:
0026B0r 2               ;     2 bytes: body_len_lo, body_len_hi (16-bit)
0026B0r 2               ;     body_len bytes: body text (lines separated by $0A)
0026B0r 2               
0026B0r 2               ; =====================================================================
0026B0r 2               ; ZEROPAGE segment — procedure variables
0026B0r 2               ; =====================================================================
0026B0r 2                     .segment "ZEROPAGE"
00003Dr 2               
00003Dr 2  xx           proc_head_lo:     .res 1        ; head of procedure directory
00003Er 2  xx           proc_head_hi:     .res 1
00003Fr 2  xx           proc_entry_lo:    .res 1        ; current entry pointer (walk scratch)
000040r 2  xx           proc_entry_hi:    .res 1
000041r 2  xx           proc_ptr_lo:      .res 1        ; scratch pointer for proc operations
000042r 2  xx           proc_ptr_hi:      .res 1
000043r 2  xx           proc_body_len_lo: .res 1        ; body length during collection / invocation
000044r 2  xx           proc_body_len_hi: .res 1
000045r 2  xx           proc_param_cnt:   .res 1        ; param count during define / invoke
000046r 2  xx           proc_name_len:    .res 1        ; name length scratch
000047r 2  xx           proc_rec_off:     .res 1        ; offset into record during invoke
000048r 2               
000048r 2               ; =====================================================================
000048r 2               ; BSS segment — temporary buffers
000048r 2               ; =====================================================================
000048r 2                     .segment "BSS"
00000Fr 2               
00000Fr 2  xx xx xx xx  proc_body_buf:    .res 2048     ; editor text buffer: "TO ..\n<body>\nEND\n"
000013r 2  xx xx xx xx  
000017r 2  xx xx xx xx  
00080Fr 2  xx xx xx xx  proc_name_buf:    .res 32       ; procedure name: length-prefixed
000813r 2  xx xx xx xx  
000817r 2  xx xx xx xx  
00082Fr 2  xx xx xx xx  proc_param_buf:   .res 128      ; packed: count, [len,chars]... each param
000833r 2  xx xx xx xx  
000837r 2  xx xx xx xx  
0008AFr 2  xx           proc_param_end:   .res 1        ; write offset into proc_param_buf
0008B0r 2  xx xx xx xx  proc_editor_title:.res 36       ; "TO <name>" + NUL, passed to the shared editor
0008B4r 2  xx xx xx xx  
0008B8r 2  xx xx xx xx  
0008D4r 2  xx           proc_body_src_lo: .res 1        ; pointer to the body text proc_build_record copies
0008D5r 2  xx           proc_body_src_hi: .res 1
0008D6r 2  xx           proc_edit_cur_lo: .res 1        ; initial editor cursor offset (start of body line)
0008D7r 2  xx           proc_edit_cur_hi: .res 1
0008D8r 2  xx           proc_scan_off_lo: .res 1        ; 16-bit scan offset for body extraction
0008D9r 2  xx           proc_scan_off_hi: .res 1
0008DAr 2  xx           proc_brk_depth:   .res 1        ; bracket/paren nesting depth while accumulating a statement
0008DBr 2  xx           proc_tmp:         .res 1        ; scratch byte (EDIT record→buffer copy)
0008DCr 2               
0008DCr 2               ; Save area for eval state during procedure invocation
0008DCr 2  xx           save_eval_cur_lo: .res 1
0008DDr 2  xx           save_eval_cur_hi: .res 1
0008DEr 2  xx           save_tok_head_lo: .res 1
0008DFr 2  xx           save_tok_head_hi: .res 1
0008E0r 2  xx           save_tok_tail_lo: .res 1
0008E1r 2  xx           save_tok_tail_hi: .res 1
0008E2r 2  xx xx xx xx  save_input_buf:   .res 128      ; save outer input_buf during proc body exec
0008E6r 2  xx xx xx xx  
0008EAr 2  xx xx xx xx  
000962r 2  xx           save_heap_ptr_lo: .res 1        ; save heap for token re-use
000963r 2  xx           save_heap_ptr_hi: .res 1
000964r 2               
000964r 2               ; Param-binding scratch: length-prefixed name built here for var_set
000964r 2  xx xx xx xx  param_name_tmp:   .res 32
000968r 2  xx xx xx xx  
00096Cr 2  xx xx xx xx  
000984r 2               
000984r 2               ; =====================================================================
000984r 2               ; CODE segment — procedure routines
000984r 2               ; =====================================================================
000984r 2                     .segment "CODE"
0026B0r 2               
0026B0r 2               ; ---------------------------------------------------------------------
0026B0r 2               ; proc_init — initialize procedure directory to empty
0026B0r 2               ; ---------------------------------------------------------------------
0026B0r 2               proc_init:
0026B0r 2  64 rr              STZ   proc_head_lo
0026B2r 2  64 rr              STZ   proc_head_hi
0026B4r 2  64 rr              STZ   proc_stopped
0026B6r 2  60                 RTS
0026B7r 2               
0026B7r 2               ; ---------------------------------------------------------------------
0026B7r 2               ; proc_collect — enter TO/END multi-line collection mode
0026B7r 2               ;   Called from main_loop after detecting TO as first token.
0026B7r 2               ;   eval_cur_lo/hi has been advanced past the TO token.
0026B7r 2               ; ---------------------------------------------------------------------
0026B7r 2               proc_collect:
0026B7r 2                     ; Next token should be the procedure name (TOK_WORD)
0026B7r 2  A5 rr              LDA   eval_cur_lo
0026B9r 2  05 rr              ORA   eval_cur_hi
0026BBr 2  D0 03              BNE   @have_name
0026BDr 2  4C rr rr           JMP   @err_noname
0026C0r 2               @have_name:
0026C0r 2  A5 rr              LDA   eval_cur_lo
0026C2r 2  85 rr              STA   ptr_lo
0026C4r 2  A5 rr              LDA   eval_cur_hi
0026C6r 2  85 rr              STA   ptr_hi
0026C8r 2  A0 00              LDY   #TOK_TAG
0026CAr 2  B1 rr              LDA   (ptr_lo),Y
0026CCr 2  C9 01              CMP   #TOK_WORD
0026CEr 2  F0 03              BEQ   @name_ok
0026D0r 2  4C rr rr           JMP   @err_noname
0026D3r 2               @name_ok:
0026D3r 2                     ; Copy procedure name to proc_name_buf (length-prefixed)
0026D3r 2  A0 03              LDY   #TOK_PAYLOAD
0026D5r 2  B1 rr              LDA   (ptr_lo),Y           ; name length
0026D7r 2  8D rr rr           STA   proc_name_buf
0026DAr 2  85 rr              STA   proc_name_len
0026DCr 2  AA                 TAX                         ; X = char count
0026DDr 2  A0 04              LDY   #TOK_PAYLOAD+1
0026DFr 2  A9 00              LDA   #0
0026E1r 2  85 rr              STA   proc_rec_off          ; dest index in name_buf
0026E3r 2               @copy_name:
0026E3r 2  E0 00              CPX   #0
0026E5r 2  F0 0F              BEQ   @name_copied
0026E7r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased by tokenizer
0026E9r 2  5A                 PHY
0026EAr 2  A4 rr              LDY   proc_rec_off
0026ECr 2  99 rr rr           STA   proc_name_buf+1,Y
0026EFr 2  E6 rr              INC   proc_rec_off
0026F1r 2  7A                 PLY
0026F2r 2  C8                 INY
0026F3r 2  CA                 DEX
0026F4r 2  80 ED              BRA   @copy_name
0026F6r 2               @name_copied:
0026F6r 2               
0026F6r 2                     ; Advance past the name token
0026F6r 2  20 rr rr           JSR   eval_advance
0026F9r 2               
0026F9r 2                     ; Parse parameter names (TOK_VARREF tokens: :SIZE :COLOR etc.)
0026F9r 2  64 rr              STZ   proc_param_cnt
0026FBr 2  A9 01              LDA   #1                    ; dest offset (skip count byte at [0])
0026FDr 2  8D rr rr           STA   proc_param_end
002700r 2               
002700r 2               @parse_params:
002700r 2  A5 rr              LDA   eval_cur_lo
002702r 2  05 rr              ORA   eval_cur_hi
002704r 2  F0 47              BEQ   @params_done
002706r 2  A5 rr              LDA   eval_cur_lo
002708r 2  85 rr              STA   ptr_lo
00270Ar 2  A5 rr              LDA   eval_cur_hi
00270Cr 2  85 rr              STA   ptr_hi
00270Er 2  A0 00              LDY   #TOK_TAG
002710r 2  B1 rr              LDA   (ptr_lo),Y
002712r 2  C9 05              CMP   #TOK_VARREF
002714r 2  D0 37              BNE   @params_done
002716r 2               
002716r 2  E6 rr              INC   proc_param_cnt
002718r 2  A0 03              LDY   #TOK_PAYLOAD
00271Ar 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
00271Cr 2  AE rr rr           LDX   proc_param_end
00271Fr 2  9D rr rr           STA   proc_param_buf,X     ; store length
002722r 2  E8                 INX
002723r 2  A8                 TAY                         ; Y = char count to copy
002724r 2  64 rr              STZ   proc_rec_off          ; source char index
002726r 2               
002726r 2               @copy_param_ch:
002726r 2  C0 00              CPY   #0
002728r 2  F0 1B              BEQ   @param_ch_done
00272Ar 2                     ; Read source char from token
00272Ar 2  A5 rr              LDA   eval_cur_lo
00272Cr 2  85 rr              STA   ptr_lo
00272Er 2  A5 rr              LDA   eval_cur_hi
002730r 2  85 rr              STA   ptr_hi
002732r 2  5A                 PHY
002733r 2  A5 rr              LDA   proc_rec_off
002735r 2  18                 CLC
002736r 2  69 04              ADC   #TOK_PAYLOAD+1
002738r 2  A8                 TAY
002739r 2  B1 rr              LDA   (ptr_lo),Y           ; already uppercased
00273Br 2  7A                 PLY
00273Cr 2                     ; Write to proc_param_buf
00273Cr 2  9D rr rr           STA   proc_param_buf,X
00273Fr 2  E8                 INX
002740r 2  E6 rr              INC   proc_rec_off
002742r 2  88                 DEY
002743r 2  80 E1              BRA   @copy_param_ch
002745r 2               @param_ch_done:
002745r 2  8E rr rr           STX   proc_param_end
002748r 2               
002748r 2  20 rr rr           JSR   eval_advance
00274Br 2  80 B3              BRA   @parse_params
00274Dr 2               
00274Dr 2               @params_done:
00274Dr 2  A5 rr              LDA   proc_param_cnt
00274Fr 2  8D rr rr           STA   proc_param_buf        ; count byte at [0]
002752r 2               
002752r 2                     ; Initialize body buffer
002752r 2  64 rr              STZ   proc_body_len_lo
002754r 2  64 rr              STZ   proc_body_len_hi
002756r 2               
002756r 2                     ; Open the shared EDITUI editor on an empty body buffer. Carry set means
002756r 2                     ; the user asked to save (Ctrl-S / "Save First") before exiting.
002756r 2  20 rr rr           JSR   proc_open_editor
002759r 2  B0 01              BCS   @body_done
00275Br 2  60                 RTS
00275Cr 2               
00275Cr 2                     ; Print "NAME DEFINED\n"
00275Cr 2               @body_done:
00275Cr 2  20 rr rr           JSR   proc_print_defined
00275Fr 2  60                 RTS
002760r 2               
002760r 2               @err_noname:
002760r 2  20 rr rr           JSR   print_inl
002763r 2  54 4F 20 4E        .byte "TO NEEDS A NAME", 0
002767r 2  45 45 44 53  
00276Br 2  20 41 20 4E  
002773r 2  20 rr rr           JSR   eval_newline
002776r 2  60                 RTS
002777r 2               
002777r 2               ; ---------------------------------------------------------------------
002777r 2               ; proc_print_defined — print "<name> DEFINED\n" (name from proc_name_buf).
002777r 2               ; ---------------------------------------------------------------------
002777r 2               proc_print_defined:
002777r 2  A6 rr              LDX   proc_name_len
002779r 2  A0 00              LDY   #0
00277Br 2               @pn:
00277Br 2  E0 00              CPX   #0
00277Dr 2  F0 0A              BEQ   @pd
00277Fr 2  B9 rr rr           LDA   proc_name_buf+1,Y
002782r 2  8D 0E A0           STA   VGC_CHAROUT
002785r 2  C8                 INY
002786r 2  CA                 DEX
002787r 2  80 F2              BRA   @pn
002789r 2               @pd:
002789r 2  20 rr rr           JSR   print_inl
00278Cr 2  20 44 45 46        .byte " DEFINED", 0
002790r 2  49 4E 45 44  
002794r 2  00           
002795r 2  20 rr rr           JSR   eval_newline
002798r 2  60                 RTS
002799r 2               
002799r 2               ; ---------------------------------------------------------------------
002799r 2               ; proc_build_header — write the "TO <name> :params" first line into
002799r 2               ;   proc_body_buf (no trailing newline). Built with 8-bit Y since the header
002799r 2               ;   is always < 256 bytes (name<=31, params<=127). Returns Y = header length.
002799r 2               ;   Inputs: proc_name_buf/proc_name_len, proc_param_buf/proc_param_end.
002799r 2               ; ---------------------------------------------------------------------
002799r 2               proc_build_header:
002799r 2  A0 00              LDY   #0
00279Br 2  A9 54              LDA   #'T'
00279Dr 2  99 rr rr           STA   proc_body_buf,Y
0027A0r 2  C8                 INY
0027A1r 2  A9 4F              LDA   #'O'
0027A3r 2  99 rr rr           STA   proc_body_buf,Y
0027A6r 2  C8                 INY
0027A7r 2  A9 20              LDA   #' '
0027A9r 2  99 rr rr           STA   proc_body_buf,Y
0027ACr 2  C8                 INY
0027ADr 2  A2 00              LDX   #0                     ; name source index
0027AFr 2               @nm:
0027AFr 2  E4 rr              CPX   proc_name_len
0027B1r 2  B0 0A              BCS   @nm_done
0027B3r 2  BD rr rr           LDA   proc_name_buf+1,X
0027B6r 2  99 rr rr           STA   proc_body_buf,Y
0027B9r 2  C8                 INY
0027BAr 2  E8                 INX
0027BBr 2  80 F2              BRA   @nm
0027BDr 2               @nm_done:
0027BDr 2                     ; params: " :" + chars, walking proc_param_buf[1..proc_param_end)
0027BDr 2  A2 01              LDX   #1
0027BFr 2               @pp:
0027BFr 2  EC rr rr           CPX   proc_param_end
0027C2r 2  B0 22              BCS   @pp_done
0027C4r 2  A9 20              LDA   #' '
0027C6r 2  99 rr rr           STA   proc_body_buf,Y
0027C9r 2  C8                 INY
0027CAr 2  A9 3A              LDA   #':'
0027CCr 2  99 rr rr           STA   proc_body_buf,Y
0027CFr 2  C8                 INY
0027D0r 2  BD rr rr           LDA   proc_param_buf,X       ; this param's char count
0027D3r 2  85 rr              STA   proc_rec_off
0027D5r 2  E8                 INX
0027D6r 2               @ppc:
0027D6r 2  A5 rr              LDA   proc_rec_off
0027D8r 2  F0 E5              BEQ   @pp
0027DAr 2  BD rr rr           LDA   proc_param_buf,X
0027DDr 2  99 rr rr           STA   proc_body_buf,Y
0027E0r 2  C8                 INY
0027E1r 2  E8                 INX
0027E2r 2  C6 rr              DEC   proc_rec_off
0027E4r 2  80 F0              BRA   @ppc
0027E6r 2               @pp_done:
0027E6r 2  60                 RTS
0027E7r 2               
0027E7r 2               proc_open_editor:
0027E7r 2                     ; build "TO <name> :params" header, then append an empty body "  ".
0027E7r 2  20 rr rr           JSR   proc_build_header
0027EAr 2                     ; Y = line-1 length. The body line is line 1's '\n' + 2 indent spaces,
0027EAr 2                     ; so the cursor lands at offset (line1 + 3).
0027EAr 2  98                 TYA
0027EBr 2  18                 CLC
0027ECr 2  69 03              ADC   #3
0027EEr 2  8D rr rr           STA   proc_edit_cur_lo
0027F1r 2  A9 00              LDA   #0
0027F3r 2  69 00              ADC   #0
0027F5r 2  8D rr rr           STA   proc_edit_cur_hi
0027F8r 2                     ; append "\n  \nEND\n"
0027F8r 2  A9 0A              LDA   #$0A
0027FAr 2  99 rr rr           STA   proc_body_buf,Y
0027FDr 2  C8                 INY
0027FEr 2  A9 20              LDA   #' '
002800r 2  99 rr rr           STA   proc_body_buf,Y
002803r 2  C8                 INY
002804r 2  99 rr rr           STA   proc_body_buf,Y
002807r 2  C8                 INY
002808r 2  A9 0A              LDA   #$0A
00280Ar 2  99 rr rr           STA   proc_body_buf,Y
00280Dr 2  C8                 INY
00280Er 2  A9 45              LDA   #'E'
002810r 2  99 rr rr           STA   proc_body_buf,Y
002813r 2  C8                 INY
002814r 2  A9 4E              LDA   #'N'
002816r 2  99 rr rr           STA   proc_body_buf,Y
002819r 2  C8                 INY
00281Ar 2  A9 44              LDA   #'D'
00281Cr 2  99 rr rr           STA   proc_body_buf,Y
00281Fr 2  C8                 INY
002820r 2  A9 0A              LDA   #$0A
002822r 2  99 rr rr           STA   proc_body_buf,Y
002825r 2  C8                 INY
002826r 2  84 rr              STY   proc_body_len_lo
002828r 2  64 rr              STZ   proc_body_len_hi
00282Ar 2               
00282Ar 2               ; ---------------------------------------------------------------------
00282Ar 2               ; proc_edit_run — shared tail: build the editor title, hand proc_body_buf
00282Ar 2               ;   (with proc_body_len + proc_edit_cur already set) to the EDITUI editor, and
00282Ar 2               ;   on save extract the body + (re)build the procedure record.
00282Ar 2               ;   Returns: carry set = saved, carry clear = abandoned.
00282Ar 2               ; ---------------------------------------------------------------------
00282Ar 2               proc_edit_run:
00282Ar 2                     ; --- title "TO <name>" + NUL for the editor's title band ---
00282Ar 2  A9 54              LDA   #'T'
00282Cr 2  8D rr rr           STA   proc_editor_title+0
00282Fr 2  A9 4F              LDA   #'O'
002831r 2  8D rr rr           STA   proc_editor_title+1
002834r 2  A9 20              LDA   #' '
002836r 2  8D rr rr           STA   proc_editor_title+2
002839r 2  A2 00              LDX   #0
00283Br 2  A0 03              LDY   #3
00283Dr 2               @tt:
00283Dr 2  E4 rr              CPX   proc_name_len
00283Fr 2  B0 0A              BCS   @tt_done
002841r 2  BD rr rr           LDA   proc_name_buf+1,X
002844r 2  99 rr rr           STA   proc_editor_title,Y
002847r 2  E8                 INX
002848r 2  C8                 INY
002849r 2  80 F2              BRA   @tt
00284Br 2               @tt_done:
00284Br 2  A9 00              LDA   #0
00284Dr 2  99 rr rr           STA   proc_editor_title,Y
002850r 2               
002850r 2                     ; --- mailbox: ARG0=buf ARG1=len ARG2=cap ARG3=title; cursor in FRAC bytes
002850r 2  A9 rr              LDA   #<proc_body_buf
002852r 2  85 84              STA   EXT_ARG0_LO
002854r 2  A9 rr              LDA   #>proc_body_buf
002856r 2  85 83              STA   EXT_ARG0_HI
002858r 2  A5 rr              LDA   proc_body_len_lo
00285Ar 2  85 88              STA   EXT_ARG1_LO
00285Cr 2  A5 rr              LDA   proc_body_len_hi
00285Er 2  85 87              STA   EXT_ARG1_HI
002860r 2  A9 00              LDA   #<2048
002862r 2  85 8C              STA   EXT_ARG2_LO
002864r 2  A9 08              LDA   #>2048
002866r 2  85 8B              STA   EXT_ARG2_HI
002868r 2  A9 rr              LDA   #<proc_editor_title
00286Ar 2  85 A1              STA   EXT_ARG3_LO
00286Cr 2  A9 rr              LDA   #>proc_editor_title
00286Er 2  85 A0              STA   EXT_ARG3_HI
002870r 2  AD rr rr           LDA   proc_edit_cur_lo
002873r 2  85 8D              STA   EXT_ARG2_FRAC          ; initial cursor offset (see ext_iface.inc)
002875r 2  AD rr rr           LDA   proc_edit_cur_hi
002878r 2  85 A2              STA   EXT_ARG3_FRAC
00287Ar 2               
00287Ar 2  A9 4B              LDA   #EXT_CMD_EDIT
00287Cr 2  85 80              STA   EXT_CMD
00287Er 2  20 70 02           JSR   EXT_TRAMPOLINE         ; swap to ext ROM, run editor, swap back
002881r 2               
002881r 2                     ; editor returns the final buffer length in ARG1
002881r 2  A5 88              LDA   EXT_ARG1_LO
002883r 2  85 rr              STA   proc_body_len_lo
002885r 2  A5 87              LDA   EXT_ARG1_HI
002887r 2  85 rr              STA   proc_body_len_hi
002889r 2               
002889r 2  A5 8F              LDA   EXT_RESULT_HI
00288Br 2  F0 08              BEQ   @abandoned
00288Dr 2                     ; Strip line 1 + the END line -> proc_body_src/proc_body_len = body only.
00288Dr 2  20 rr rr           JSR   proc_extract_body
002890r 2  20 rr rr           JSR   proc_build_record
002893r 2  38                 SEC
002894r 2  60                 RTS
002895r 2               @abandoned:
002895r 2  18                 CLC
002896r 2  60                 RTS
002897r 2               
002897r 2               ; ---------------------------------------------------------------------
002897r 2               ; proc_buf_put — append A to proc_body_buf at ptr2, advancing ptr2 and the
002897r 2               ;   16-bit proc_body_len counter. Preserves A; clobbers Y.
002897r 2               ; ---------------------------------------------------------------------
002897r 2               proc_buf_put:
002897r 2  A0 00              LDY   #0
002899r 2  91 rr              STA   (ptr2_lo),Y
00289Br 2  E6 rr              INC   ptr2_lo
00289Dr 2  D0 02              BNE   :+
00289Fr 2  E6 rr              INC   ptr2_hi
0028A1r 2  E6 rr        :     INC   proc_body_len_lo
0028A3r 2  D0 02              BNE   :+
0028A5r 2  E6 rr              INC   proc_body_len_hi
0028A7r 2  60           :     RTS
0028A8r 2               
0028A8r 2               ; ---------------------------------------------------------------------
0028A8r 2               ; proc_record_to_buffers — unpack the procedure record at proc_entry into the
0028A8r 2               ;   collect buffers so it can be edited and rebuilt:
0028A8r 2               ;     proc_name_buf/proc_name_len, proc_param_buf/proc_param_cnt/proc_param_end,
0028A8r 2               ;     and proc_body_src/proc_body_len = the record's body text (ptr + length).
0028A8r 2               ;   The name+param region is < 256 bytes so 8-bit Y indexing is safe there.
0028A8r 2               ; ---------------------------------------------------------------------
0028A8r 2               proc_record_to_buffers:
0028A8r 2  A5 rr              LDA   proc_entry_lo
0028AAr 2  85 rr              STA   ptr_lo
0028ACr 2  A5 rr              LDA   proc_entry_hi
0028AEr 2  85 rr              STA   ptr_hi
0028B0r 2                     ; --- name (record +2 = len, +3.. = chars) ---
0028B0r 2  A0 02              LDY   #2
0028B2r 2  B1 rr              LDA   (ptr_lo),Y
0028B4r 2  8D rr rr           STA   proc_name_buf
0028B7r 2  85 rr              STA   proc_name_len
0028B9r 2  C8                 INY                         ; Y=3 -> first name char
0028BAr 2  A2 00              LDX   #0
0028BCr 2               @rb_nm:
0028BCr 2  E4 rr              CPX   proc_name_len
0028BEr 2  B0 09              BCS   @rb_nm_done
0028C0r 2  B1 rr              LDA   (ptr_lo),Y
0028C2r 2  9D rr rr           STA   proc_name_buf+1,X
0028C5r 2  C8                 INY
0028C6r 2  E8                 INX
0028C7r 2  80 F3              BRA   @rb_nm
0028C9r 2               @rb_nm_done:
0028C9r 2                     ; --- param_count then packed params ---
0028C9r 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
0028CBr 2  85 rr              STA   proc_param_cnt
0028CDr 2  8D rr rr           STA   proc_param_buf        ; [0] = count
0028D0r 2  8D rr rr           STA   proc_tmp              ; remaining params
0028D3r 2  C8                 INY                         ; Y -> first param len
0028D4r 2  A2 01              LDX   #1                    ; dest index into proc_param_buf
0028D6r 2               @rb_param:
0028D6r 2  AD rr rr           LDA   proc_tmp
0028D9r 2  F0 1B              BEQ   @rb_params_done
0028DBr 2  CE rr rr           DEC   proc_tmp
0028DEr 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
0028E0r 2  9D rr rr           STA   proc_param_buf,X
0028E3r 2  85 rr              STA   proc_rec_off          ; char counter
0028E5r 2  C8                 INY
0028E6r 2  E8                 INX
0028E7r 2               @rb_pchars:
0028E7r 2  A5 rr              LDA   proc_rec_off
0028E9r 2  F0 EB              BEQ   @rb_param
0028EBr 2  C6 rr              DEC   proc_rec_off
0028EDr 2  B1 rr              LDA   (ptr_lo),Y
0028EFr 2  9D rr rr           STA   proc_param_buf,X
0028F2r 2  C8                 INY
0028F3r 2  E8                 INX
0028F4r 2  80 F1              BRA   @rb_pchars
0028F6r 2               @rb_params_done:
0028F6r 2  8E rr rr           STX   proc_param_end
0028F9r 2                     ; Y -> body_len_lo within the record. Compute absolute pointer.
0028F9r 2  98                 TYA
0028FAr 2  18                 CLC
0028FBr 2  65 rr              ADC   proc_entry_lo
0028FDr 2  85 rr              STA   ptr_lo
0028FFr 2  A5 rr              LDA   proc_entry_hi
002901r 2  69 00              ADC   #0
002903r 2  85 rr              STA   ptr_hi               ; ptr -> body_len_lo
002905r 2  A0 00              LDY   #0
002907r 2  B1 rr              LDA   (ptr_lo),Y
002909r 2  85 rr              STA   proc_body_len_lo     ; record body length
00290Br 2  C8                 INY
00290Cr 2  B1 rr              LDA   (ptr_lo),Y
00290Er 2  85 rr              STA   proc_body_len_hi
002910r 2  18                 CLC                         ; body src = ptr + 2
002911r 2  A5 rr              LDA   ptr_lo
002913r 2  69 02              ADC   #2
002915r 2  8D rr rr           STA   proc_body_src_lo
002918r 2  A5 rr              LDA   ptr_hi
00291Ar 2  69 00              ADC   #0
00291Cr 2  8D rr rr           STA   proc_body_src_hi
00291Fr 2  60                 RTS
002920r 2               
002920r 2               ; ---------------------------------------------------------------------
002920r 2               ; proc_edit_reconstruct — build the full editable text "TO <name> :params\n
002920r 2               ;   <body>END\n" into proc_body_buf from the collect buffers + the record body
002920r 2               ;   (proc_body_src/proc_body_len set by proc_record_to_buffers). Sets
002920r 2               ;   proc_body_len = total buffer length and proc_edit_cur = start of the body.
002920r 2               ; ---------------------------------------------------------------------
002920r 2               proc_edit_reconstruct:
002920r 2                     ; Save the record body src/len before proc_body_len is repurposed.
002920r 2  AD rr rr           LDA   proc_body_src_lo
002923r 2  85 rr              STA   proc_ptr_lo
002925r 2  AD rr rr           LDA   proc_body_src_hi
002928r 2  85 rr              STA   proc_ptr_hi
00292Ar 2  A5 rr              LDA   proc_body_len_lo
00292Cr 2  8D rr rr           STA   num_tmp_lo
00292Fr 2  A5 rr              LDA   proc_body_len_hi
002931r 2  8D rr rr           STA   num_tmp_hi
002934r 2                     ; Header "TO name params" (8-bit), then a newline.
002934r 2  20 rr rr           JSR   proc_build_header     ; Y = header length
002937r 2  A9 0A              LDA   #$0A
002939r 2  99 rr rr           STA   proc_body_buf,Y
00293Cr 2  C8                 INY                         ; Y = body-line start offset
00293Dr 2  8C rr rr           STY   proc_edit_cur_lo
002940r 2  9C rr rr           STZ   proc_edit_cur_hi
002943r 2  84 rr              STY   proc_body_len_lo
002945r 2  64 rr              STZ   proc_body_len_hi
002947r 2                     ; dest pointer ptr2 = proc_body_buf + Y
002947r 2  98                 TYA
002948r 2  18                 CLC
002949r 2  69 rr              ADC   #<proc_body_buf
00294Br 2  85 rr              STA   ptr2_lo
00294Dr 2  A9 rr              LDA   #>proc_body_buf
00294Fr 2  69 00              ADC   #0
002951r 2  85 rr              STA   ptr2_hi
002953r 2                     ; copy the record body (num_tmp bytes from proc_ptr)
002953r 2               @rc_body:
002953r 2  AD rr rr           LDA   num_tmp_lo
002956r 2  0D rr rr           ORA   num_tmp_hi
002959r 2  F0 1A              BEQ   @rc_body_done
00295Br 2  A0 00              LDY   #0
00295Dr 2  B1 rr              LDA   (proc_ptr_lo),Y
00295Fr 2  20 rr rr           JSR   proc_buf_put
002962r 2  E6 rr              INC   proc_ptr_lo
002964r 2  D0 02              BNE   :+
002966r 2  E6 rr              INC   proc_ptr_hi
002968r 2  AD rr rr     :     LDA   num_tmp_lo
00296Br 2  D0 03              BNE   @rc_dec
00296Dr 2  CE rr rr           DEC   num_tmp_hi
002970r 2               @rc_dec:
002970r 2  CE rr rr           DEC   num_tmp_lo
002973r 2  80 DE              BRA   @rc_body
002975r 2               @rc_body_done:
002975r 2                     ; append "END" + newline
002975r 2  A9 45              LDA   #'E'
002977r 2  20 rr rr           JSR   proc_buf_put
00297Ar 2  A9 4E              LDA   #'N'
00297Cr 2  20 rr rr           JSR   proc_buf_put
00297Fr 2  A9 44              LDA   #'D'
002981r 2  20 rr rr           JSR   proc_buf_put
002984r 2  A9 0A              LDA   #$0A
002986r 2  20 rr rr           JSR   proc_buf_put
002989r 2  60                 RTS
00298Ar 2               
00298Ar 2               ; ---------------------------------------------------------------------
00298Ar 2               ; proc_edit — handle "EDIT <name>" / "ED <name>". eval_cur is at the name
00298Ar 2               ;   token. If the procedure exists, reopen it in the editor pre-filled with its
00298Ar 2               ;   current definition; otherwise fall back to the TO collector (create it).
00298Ar 2               ; ---------------------------------------------------------------------
00298Ar 2               proc_edit:
00298Ar 2  A5 rr              LDA   eval_cur_lo
00298Cr 2  05 rr              ORA   eval_cur_hi
00298Er 2  F0 14              BEQ   @to_collect
002990r 2  20 rr rr           JSR   proc_lookup
002993r 2  B0 0F              BCS   @to_collect          ; unknown -> create via the TO collector
002995r 2  20 rr rr           JSR   proc_record_to_buffers
002998r 2  20 rr rr           JSR   proc_edit_reconstruct
00299Br 2  20 rr rr           JSR   proc_edit_run
00299Er 2  90 03              BCC   @done                ; abandoned
0029A0r 2  20 rr rr           JSR   proc_print_defined
0029A3r 2               @done:
0029A3r 2  60                 RTS
0029A4r 2               @to_collect:
0029A4r 2  4C rr rr           JMP   proc_collect
0029A7r 2               
0029A7r 2               ; ---------------------------------------------------------------------
0029A7r 2               ; proc_extract_body — narrow proc_body_buf/proc_body_len down to just the body:
0029A7r 2               ;   everything after the first '\n' (line 1) up to (not including) the line that
0029A7r 2               ;   reads "END". Sets proc_body_src_lo/hi + proc_body_len_lo/hi.
0029A7r 2               ; ---------------------------------------------------------------------
0029A7r 2               proc_extract_body:
0029A7r 2  A9 rr              LDA   #<proc_body_buf
0029A9r 2  85 rr              STA   proc_ptr_lo
0029ABr 2  A9 rr              LDA   #>proc_body_buf
0029ADr 2  85 rr              STA   proc_ptr_hi
0029AFr 2  9C rr rr           STZ   proc_scan_off_lo
0029B2r 2  9C rr rr           STZ   proc_scan_off_hi
0029B5r 2               @find_nl:
0029B5r 2  20 rr rr           JSR   proc_scan_at_end
0029B8r 2  B0 4F              BCS   @whole                ; no newline -> whole buffer is the body
0029BAr 2  A0 00              LDY   #0
0029BCr 2  B1 rr              LDA   (proc_ptr_lo),Y
0029BEr 2  20 rr rr           JSR   proc_scan_advance
0029C1r 2  C9 0A              CMP   #$0A
0029C3r 2  D0 F0              BNE   @find_nl
0029C5r 2                     ; body starts here
0029C5r 2  A5 rr              LDA   proc_ptr_lo
0029C7r 2  8D rr rr           STA   proc_body_src_lo
0029CAr 2  A5 rr              LDA   proc_ptr_hi
0029CCr 2  8D rr rr           STA   proc_body_src_hi
0029CFr 2  AD rr rr           LDA   proc_scan_off_lo
0029D2r 2  8D rr rr           STA   num_tmp_lo            ; body-start offset
0029D5r 2  AD rr rr           LDA   proc_scan_off_hi
0029D8r 2  8D rr rr           STA   num_tmp_hi
0029DBr 2               @line:
0029DBr 2  20 rr rr           JSR   proc_scan_at_end
0029DEr 2  B0 17              BCS   @body_end             ; ran off the end -> body = rest
0029E0r 2  20 rr rr           JSR   proc_line_is_end
0029E3r 2  B0 12              BCS   @body_end             ; this line is "END" -> stop
0029E5r 2               @skip:
0029E5r 2  20 rr rr           JSR   proc_scan_at_end
0029E8r 2  B0 0D              BCS   @body_end
0029EAr 2  A0 00              LDY   #0
0029ECr 2  B1 rr              LDA   (proc_ptr_lo),Y
0029EEr 2  20 rr rr           JSR   proc_scan_advance
0029F1r 2  C9 0A              CMP   #$0A
0029F3r 2  D0 F0              BNE   @skip
0029F5r 2  80 E4              BRA   @line
0029F7r 2               @body_end:
0029F7r 2  38                 SEC
0029F8r 2  AD rr rr           LDA   proc_scan_off_lo
0029FBr 2  ED rr rr           SBC   num_tmp_lo
0029FEr 2  85 rr              STA   proc_body_len_lo
002A00r 2  AD rr rr           LDA   proc_scan_off_hi
002A03r 2  ED rr rr           SBC   num_tmp_hi
002A06r 2  85 rr              STA   proc_body_len_hi
002A08r 2  60                 RTS
002A09r 2               @whole:
002A09r 2  A9 rr              LDA   #<proc_body_buf
002A0Br 2  8D rr rr           STA   proc_body_src_lo
002A0Er 2  A9 rr              LDA   #>proc_body_buf
002A10r 2  8D rr rr           STA   proc_body_src_hi
002A13r 2  60                 RTS
002A14r 2               
002A14r 2               ; carry set if proc_scan_off >= proc_body_len
002A14r 2               proc_scan_at_end:
002A14r 2  AD rr rr           LDA   proc_scan_off_lo
002A17r 2  C5 rr              CMP   proc_body_len_lo
002A19r 2  AD rr rr           LDA   proc_scan_off_hi
002A1Cr 2  E5 rr              SBC   proc_body_len_hi
002A1Er 2  60                 RTS
002A1Fr 2               
002A1Fr 2               ; advance the scan pointer + offset by one byte
002A1Fr 2               proc_scan_advance:
002A1Fr 2  E6 rr              INC   proc_ptr_lo
002A21r 2  D0 02              BNE   :+
002A23r 2  E6 rr              INC   proc_ptr_hi
002A25r 2  EE rr rr     :     INC   proc_scan_off_lo
002A28r 2  D0 03              BNE   :+
002A2Ar 2  EE rr rr           INC   proc_scan_off_hi
002A2Dr 2  60           :     RTS
002A2Er 2               
002A2Er 2               ; proc_line_is_end — carry set if the line at proc_ptr is exactly "END" followed
002A2Er 2               ; by '\n' or end-of-buffer. Needs room for 3 chars (off+3 <= len). Non-destructive.
002A2Er 2               proc_line_is_end:
002A2Er 2                     ; proc_entry = proc_scan_off + 3
002A2Er 2  18                 CLC
002A2Fr 2  AD rr rr           LDA   proc_scan_off_lo
002A32r 2  69 03              ADC   #3
002A34r 2  85 rr              STA   proc_entry_lo
002A36r 2  AD rr rr           LDA   proc_scan_off_hi
002A39r 2  69 00              ADC   #0
002A3Br 2  85 rr              STA   proc_entry_hi
002A3Dr 2                     ; need off+3 <= len, i.e. NOT (off+3 > len) == NOT (len < off+3)
002A3Dr 2  A5 rr              LDA   proc_body_len_lo
002A3Fr 2  C5 rr              CMP   proc_entry_lo
002A41r 2  A5 rr              LDA   proc_body_len_hi
002A43r 2  E5 rr              SBC   proc_entry_hi
002A45r 2  90 2B              BCC   @no                   ; len < off+3 -> not enough room
002A47r 2  A0 00              LDY   #0
002A49r 2  B1 rr              LDA   (proc_ptr_lo),Y
002A4Br 2  C9 45              CMP   #'E'
002A4Dr 2  D0 23              BNE   @no
002A4Fr 2  C8                 INY
002A50r 2  B1 rr              LDA   (proc_ptr_lo),Y
002A52r 2  C9 4E              CMP   #'N'
002A54r 2  D0 1C              BNE   @no
002A56r 2  C8                 INY
002A57r 2  B1 rr              LDA   (proc_ptr_lo),Y
002A59r 2  C9 44              CMP   #'D'
002A5Br 2  D0 15              BNE   @no
002A5Dr 2                     ; 4th byte: '\n', or off+3 == len (END at buffer end)
002A5Dr 2  A5 rr              LDA   proc_entry_lo
002A5Fr 2  C5 rr              CMP   proc_body_len_lo
002A61r 2  D0 06              BNE   @check_nl
002A63r 2  A5 rr              LDA   proc_entry_hi
002A65r 2  C5 rr              CMP   proc_body_len_hi
002A67r 2  F0 07              BEQ   @yes                  ; off+3 == len
002A69r 2               @check_nl:
002A69r 2  C8                 INY
002A6Ar 2  B1 rr              LDA   (proc_ptr_lo),Y
002A6Cr 2  C9 0A              CMP   #$0A
002A6Er 2  D0 02              BNE   @no
002A70r 2               @yes:
002A70r 2  38                 SEC
002A71r 2  60                 RTS
002A72r 2               @no:
002A72r 2  18                 CLC
002A73r 2  60                 RTS
002A74r 2               
002A74r 2               ; ---------------------------------------------------------------------
002A74r 2               ; heap_alloc_big — allocate for procedure records (16-bit payload)
002A74r 2               ;   Input:  proc_ptr_lo/hi = record data size (16-bit)
002A74r 2               ;   Output: proc_entry_lo/hi = pointer to record data (payload+2)
002A74r 2               ;           Carry clear = success, Carry set = OOM
002A74r 2               ;
002A74r 2               ;   Layout: [GC_HDR_TAG, GC_HDR_SIZE=0, total_lo, total_hi, ...data...]
002A74r 2               ;   GC header (2 bytes) + 16-bit size (2 bytes) + record data.
002A74r 2               ;   Total allocation = record_data_size + 4.
002A74r 2               ;   GC_HDR_SIZE = 0 tells GC to read 16-bit total from payload[0..1].
002A74r 2               ;   proc_entry points to data (base+4).
002A74r 2               ;
002A74r 2               ;   Clobbers: A, Y, ptr_lo/hi
002A74r 2               ; ---------------------------------------------------------------------
002A74r 2               heap_alloc_big:
002A74r 2                     ; Total allocation = data_size + 4 (2 hdr + 2 size field)
002A74r 2  18                 CLC
002A75r 2  A5 rr              LDA   proc_ptr_lo
002A77r 2  69 04              ADC   #4
002A79r 2  48                 PHA                        ; save total_lo
002A7Ar 2  A5 rr              LDA   proc_ptr_hi
002A7Cr 2  69 00              ADC   #0
002A7Er 2  48                 PHA                        ; save total_hi
002A7Fr 2               
002A7Fr 2                     ; Save current heap_ptr as base
002A7Fr 2  A5 rr              LDA   heap_ptr
002A81r 2  85 rr              STA   proc_entry_lo
002A83r 2  A5 rr              LDA   heap_ptr+1
002A85r 2  85 rr              STA   proc_entry_hi
002A87r 2               
002A87r 2                     ; Advance heap_ptr by total
002A87r 2  BA                 TSX
002A88r 2  18                 CLC
002A89r 2  A5 rr              LDA   heap_ptr
002A8Br 2  7D 02 01           ADC   $0102,X              ; total_lo
002A8Er 2  85 rr              STA   heap_ptr
002A90r 2  A5 rr              LDA   heap_ptr+1
002A92r 2  7D 01 01           ADC   $0101,X              ; total_hi
002A95r 2  85 rr              STA   heap_ptr+1
002A97r 2               
002A97r 2                     ; OOM check
002A97r 2  C9 98              CMP   #>HEAP_END
002A99r 2  90 16              BCC   @big_ok
002A9Br 2  D0 08              BNE   @big_oom
002A9Dr 2  A5 rr              LDA   heap_ptr
002A9Fr 2  C9 00              CMP   #<HEAP_END
002AA1r 2  90 0E              BCC   @big_ok
002AA3r 2  F0 0C              BEQ   @big_ok
002AA5r 2               @big_oom:
002AA5r 2  A5 rr              LDA   proc_entry_lo
002AA7r 2  85 rr              STA   heap_ptr
002AA9r 2  A5 rr              LDA   proc_entry_hi
002AABr 2  85 rr              STA   heap_ptr+1
002AADr 2  68                 PLA
002AAEr 2  68                 PLA
002AAFr 2  38                 SEC
002AB0r 2  60                 RTS
002AB1r 2               @big_ok:
002AB1r 2                     ; Write header at base (proc_entry = base here)
002AB1r 2  A5 rr              LDA   proc_entry_lo
002AB3r 2  85 rr              STA   ptr_lo
002AB5r 2  A5 rr              LDA   proc_entry_hi
002AB7r 2  85 rr              STA   ptr_hi
002AB9r 2               
002AB9r 2  A0 00              LDY   #GC_HDR_TAG
002ABBr 2  A9 04              LDA   #ATYPE_PROC
002ABDr 2  91 rr              STA   (ptr_lo),Y
002ABFr 2               
002ABFr 2  A0 01              LDY   #GC_HDR_SIZE
002AC1r 2  A9 00              LDA   #0                    ; 0 = 16-bit size at payload[0..1]
002AC3r 2  91 rr              STA   (ptr_lo),Y
002AC5r 2               
002AC5r 2                     ; Write 16-bit total at payload offsets 0,1 (base+2, base+3)
002AC5r 2  68                 PLA                        ; total_hi
002AC6r 2  A0 03              LDY   #GC_HDR_BYTES+1       ; base+3
002AC8r 2  91 rr              STA   (ptr_lo),Y
002ACAr 2  68                 PLA                        ; total_lo
002ACBr 2  A0 02              LDY   #GC_HDR_BYTES         ; base+2
002ACDr 2  91 rr              STA   (ptr_lo),Y
002ACFr 2               
002ACFr 2                     ; Advance proc_entry to point past header+size field = base+4
002ACFr 2                     ; This is where the record data starts
002ACFr 2  18                 CLC
002AD0r 2  A5 rr              LDA   proc_entry_lo
002AD2r 2  69 04              ADC   #4
002AD4r 2  85 rr              STA   proc_entry_lo
002AD6r 2  A5 rr              LDA   proc_entry_hi
002AD8r 2  69 00              ADC   #0
002ADAr 2  85 rr              STA   proc_entry_hi
002ADCr 2               
002ADCr 2  18                 CLC
002ADDr 2  60                 RTS
002ADEr 2               
002ADEr 2               ; ---------------------------------------------------------------------
002ADEr 2               ; proc_build_record — allocate and populate a procedure heap record
002ADEr 2               ;   Uses: proc_name_buf, proc_param_buf/proc_param_end,
002ADEr 2               ;         proc_body_buf/proc_body_len
002ADEr 2               ; ---------------------------------------------------------------------
002ADEr 2               proc_build_record:
002ADEr 2                     ; Calculate total record size
002ADEr 2                     ; 2 (next) + 1 (name_len) + name_len
002ADEr 2                     ; + 1 (param_count) + (proc_param_end - 1) param packed bytes
002ADEr 2                     ; + 2 (body_len) + body_len
002ADEr 2                     ;
002ADEr 2                     ; We build the total in proc_ptr_lo:proc_ptr_hi (16-bit)
002ADEr 2               
002ADEr 2  A9 04              LDA   #4                    ; 2(next) + 1(name_len) + 1(param_count)
002AE0r 2  18                 CLC
002AE1r 2  6D rr rr           ADC   proc_name_buf         ; + name_len
002AE4r 2  85 rr              STA   proc_ptr_lo
002AE6r 2  A9 00              LDA   #0
002AE8r 2  85 rr              STA   proc_ptr_hi
002AEAr 2               
002AEAr 2                     ; + param packed bytes (proc_param_end - 1)
002AEAr 2  AD rr rr           LDA   proc_param_end
002AEDr 2  38                 SEC
002AEEr 2  E9 01              SBC   #1
002AF0r 2  18                 CLC
002AF1r 2  65 rr              ADC   proc_ptr_lo
002AF3r 2  85 rr              STA   proc_ptr_lo
002AF5r 2  90 02              BCC   :+
002AF7r 2  E6 rr              INC   proc_ptr_hi
002AF9r 2               :
002AF9r 2                     ; + 2 (body_len field)
002AF9r 2  18                 CLC
002AFAr 2  A5 rr              LDA   proc_ptr_lo
002AFCr 2  69 02              ADC   #2
002AFEr 2  85 rr              STA   proc_ptr_lo
002B00r 2  90 02              BCC   :+
002B02r 2  E6 rr              INC   proc_ptr_hi
002B04r 2               :
002B04r 2                     ; + body_len
002B04r 2  18                 CLC
002B05r 2  A5 rr              LDA   proc_ptr_lo
002B07r 2  65 rr              ADC   proc_body_len_lo
002B09r 2  85 rr              STA   proc_ptr_lo
002B0Br 2  A5 rr              LDA   proc_ptr_hi
002B0Dr 2  65 rr              ADC   proc_body_len_hi
002B0Fr 2  85 rr              STA   proc_ptr_hi
002B11r 2               
002B11r 2                     ; Allocate with GC header (16-bit size via heap_alloc_big)
002B11r 2                     ; proc_ptr_lo/hi = payload size
002B11r 2  20 rr rr           JSR   heap_alloc_big
002B14r 2  90 01              BCC   @ok
002B16r 2  60                 RTS                        ; OOM
002B17r 2               @ok:
002B17r 2                     ; Fill the record using (ptr_lo),Y indirect addressing
002B17r 2                     ; We track Y as the write offset. For records > 256 bytes
002B17r 2                     ; we bump ptr_hi when Y wraps.
002B17r 2  A5 rr              LDA   proc_entry_lo
002B19r 2  85 rr              STA   ptr_lo
002B1Br 2  A5 rr              LDA   proc_entry_hi
002B1Dr 2  85 rr              STA   ptr_hi
002B1Fr 2               
002B1Fr 2                     ; +0,+1: next pointer = current proc_head
002B1Fr 2  A0 00              LDY   #0
002B21r 2  A5 rr              LDA   proc_head_lo
002B23r 2  91 rr              STA   (ptr_lo),Y
002B25r 2  C8                 INY
002B26r 2  A5 rr              LDA   proc_head_hi
002B28r 2  91 rr              STA   (ptr_lo),Y
002B2Ar 2               
002B2Ar 2                     ; +2: name_len
002B2Ar 2  C8                 INY
002B2Br 2  AD rr rr           LDA   proc_name_buf
002B2Er 2  91 rr              STA   (ptr_lo),Y
002B30r 2               
002B30r 2                     ; +3..+3+NL-1: name chars
002B30r 2  AE rr rr           LDX   proc_name_buf         ; X = char count
002B33r 2  64 rr              STZ   proc_rec_off          ; source index
002B35r 2               @bld_name:
002B35r 2  E0 00              CPX   #0
002B37r 2  F0 13              BEQ   @bld_name_done
002B39r 2  C8                 INY
002B3Ar 2  D0 02              BNE   :+
002B3Cr 2  E6 rr              INC   ptr_hi
002B3Er 2  DA           :     PHX
002B3Fr 2  A6 rr              LDX   proc_rec_off
002B41r 2  BD rr rr           LDA   proc_name_buf+1,X
002B44r 2  FA                 PLX
002B45r 2  91 rr              STA   (ptr_lo),Y
002B47r 2  E6 rr              INC   proc_rec_off
002B49r 2  CA                 DEX
002B4Ar 2  80 E9              BRA   @bld_name
002B4Cr 2               @bld_name_done:
002B4Cr 2               
002B4Cr 2                     ; +3+NL: param_count
002B4Cr 2  C8                 INY
002B4Dr 2  D0 02              BNE   :+
002B4Fr 2  E6 rr              INC   ptr_hi
002B51r 2  A5 rr        :     LDA   proc_param_cnt
002B53r 2  91 rr              STA   (ptr_lo),Y
002B55r 2               
002B55r 2                     ; Copy packed param data from proc_param_buf[1..proc_param_end-1]
002B55r 2  AD rr rr           LDA   proc_param_end
002B58r 2  C9 02              CMP   #2                    ; at least 1 = there are params
002B5Ar 2  90 14              BCC   @bld_params_done
002B5Cr 2  A2 01              LDX   #1                    ; source index (skip count byte)
002B5Er 2               @bld_param:
002B5Er 2  EC rr rr           CPX   proc_param_end
002B61r 2  B0 0D              BCS   @bld_params_done
002B63r 2  C8                 INY
002B64r 2  D0 02              BNE   :+
002B66r 2  E6 rr              INC   ptr_hi
002B68r 2  BD rr rr     :     LDA   proc_param_buf,X
002B6Br 2  91 rr              STA   (ptr_lo),Y
002B6Dr 2  E8                 INX
002B6Er 2  80 EE              BRA   @bld_param
002B70r 2               @bld_params_done:
002B70r 2               
002B70r 2                     ; body_len_lo, body_len_hi
002B70r 2  C8                 INY
002B71r 2  D0 02              BNE   :+
002B73r 2  E6 rr              INC   ptr_hi
002B75r 2  A5 rr        :     LDA   proc_body_len_lo
002B77r 2  91 rr              STA   (ptr_lo),Y
002B79r 2  C8                 INY
002B7Ar 2  D0 02              BNE   :+
002B7Cr 2  E6 rr              INC   ptr_hi
002B7Er 2  A5 rr        :     LDA   proc_body_len_hi
002B80r 2  91 rr              STA   (ptr_lo),Y
002B82r 2               
002B82r 2                     ; Copy body text (proc_body_src points at the body region of the buffer)
002B82r 2  A5 rr              LDA   proc_body_len_lo
002B84r 2  05 rr              ORA   proc_body_len_hi
002B86r 2  F0 3A              BEQ   @bld_body_done
002B88r 2               
002B88r 2  AD rr rr           LDA   proc_body_src_lo
002B8Br 2  85 rr              STA   proc_ptr_lo
002B8Dr 2  AD rr rr           LDA   proc_body_src_hi
002B90r 2  85 rr              STA   proc_ptr_hi
002B92r 2                     ; 16-bit counter
002B92r 2  A5 rr              LDA   proc_body_len_lo
002B94r 2  8D rr rr           STA   num_tmp_lo
002B97r 2  A5 rr              LDA   proc_body_len_hi
002B99r 2  8D rr rr           STA   num_tmp_hi
002B9Cr 2               
002B9Cr 2               @bld_body:
002B9Cr 2  C8                 INY
002B9Dr 2  D0 02              BNE   :+
002B9Fr 2  E6 rr              INC   ptr_hi
002BA1r 2  5A           :     PHY
002BA2r 2  A0 00              LDY   #0
002BA4r 2  B1 rr              LDA   (proc_ptr_lo),Y
002BA6r 2  7A                 PLY
002BA7r 2  91 rr              STA   (ptr_lo),Y
002BA9r 2                     ; Advance source
002BA9r 2  E6 rr              INC   proc_ptr_lo
002BABr 2  D0 02              BNE   :+
002BADr 2  E6 rr              INC   proc_ptr_hi
002BAFr 2               :     ; Decrement counter
002BAFr 2  AD rr rr           LDA   num_tmp_lo
002BB2r 2  D0 03              BNE   @bld_dec_lo
002BB4r 2  CE rr rr           DEC   num_tmp_hi
002BB7r 2               @bld_dec_lo:
002BB7r 2  CE rr rr           DEC   num_tmp_lo
002BBAr 2  AD rr rr           LDA   num_tmp_lo
002BBDr 2  0D rr rr           ORA   num_tmp_hi
002BC0r 2  D0 DA              BNE   @bld_body
002BC2r 2               
002BC2r 2               @bld_body_done:
002BC2r 2                     ; Prepend to directory
002BC2r 2  A5 rr              LDA   proc_entry_lo
002BC4r 2  85 rr              STA   proc_head_lo
002BC6r 2  A5 rr              LDA   proc_entry_hi
002BC8r 2  85 rr              STA   proc_head_hi
002BCAr 2  60                 RTS
002BCBr 2               
002BCBr 2               ; ---------------------------------------------------------------------
002BCBr 2               ; proc_lookup — search for a procedure by name
002BCBr 2               ;   Input: eval_cur_lo/hi points to a TOK_WORD token
002BCBr 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002BCBr 2               ;           carry set = not found
002BCBr 2               ; ---------------------------------------------------------------------
002BCBr 2               proc_lookup:
002BCBr 2  A5 rr              LDA   proc_head_lo
002BCDr 2  85 rr              STA   proc_entry_lo
002BCFr 2  A5 rr              LDA   proc_head_hi
002BD1r 2  85 rr              STA   proc_entry_hi
002BD3r 2               
002BD3r 2               @walk:
002BD3r 2  A5 rr              LDA   proc_entry_lo
002BD5r 2  05 rr              ORA   proc_entry_hi
002BD7r 2  F0 0C              BEQ   @not_found
002BD9r 2               
002BD9r 2  20 rr rr           JSR   proc_names_equal
002BDCr 2  B0 05              BCS   @found
002BDEr 2               
002BDEr 2                     ; Follow next pointer
002BDEr 2  20 rr rr           JSR   proc_next
002BE1r 2  80 F0              BRA   @walk
002BE3r 2               
002BE3r 2               @found:
002BE3r 2  18                 CLC
002BE4r 2  60                 RTS
002BE5r 2               @not_found:
002BE5r 2  38                 SEC
002BE6r 2  60                 RTS
002BE7r 2               
002BE7r 2               ; ---------------------------------------------------------------------
002BE7r 2               ; proc_next — advance proc_entry_lo/hi to the next record it links to.
002BE7r 2               ;   In/out: proc_entry_lo/hi.  Clobbers: A, X, Y, ptr_lo/hi.
002BE7r 2               ; ---------------------------------------------------------------------
002BE7r 2               proc_next:
002BE7r 2  A5 rr              LDA   proc_entry_lo
002BE9r 2  85 rr              STA   ptr_lo
002BEBr 2  A5 rr              LDA   proc_entry_hi
002BEDr 2  85 rr              STA   ptr_hi
002BEFr 2  A0 00              LDY   #0
002BF1r 2  B1 rr              LDA   (ptr_lo),Y
002BF3r 2  AA                 TAX
002BF4r 2  C8                 INY
002BF5r 2  B1 rr              LDA   (ptr_lo),Y
002BF7r 2  85 rr              STA   proc_entry_hi
002BF9r 2  86 rr              STX   proc_entry_lo
002BFBr 2  60                 RTS
002BFCr 2               
002BFCr 2               ; ---------------------------------------------------------------------
002BFCr 2               ; proc_names_equal — compare token word vs record name
002BFCr 2               ;   Input: eval_cur_lo/hi = TOK_WORD, proc_entry_lo/hi = record
002BFCr 2               ;   Returns: carry set = equal, carry clear = not equal
002BFCr 2               ; ---------------------------------------------------------------------
002BFCr 2               proc_names_equal:
002BFCr 2                     ; Token name length
002BFCr 2  A5 rr              LDA   eval_cur_lo
002BFEr 2  85 rr              STA   ptr_lo
002C00r 2  A5 rr              LDA   eval_cur_hi
002C02r 2  85 rr              STA   ptr_hi
002C04r 2  A0 03              LDY   #TOK_PAYLOAD
002C06r 2  B1 rr              LDA   (ptr_lo),Y
002C08r 2  85 rr              STA   proc_name_len         ; token name length
002C0Ar 2               
002C0Ar 2                     ; Record name length
002C0Ar 2  A5 rr              LDA   proc_entry_lo
002C0Cr 2  85 rr              STA   ptr_lo
002C0Er 2  A5 rr              LDA   proc_entry_hi
002C10r 2  85 rr              STA   ptr_hi
002C12r 2  A0 02              LDY   #2
002C14r 2  B1 rr              LDA   (ptr_lo),Y
002C16r 2               
002C16r 2  C5 rr              CMP   proc_name_len
002C18r 2  D0 37              BNE   @ne
002C1Ar 2               
002C1Ar 2                     ; Lengths match — compare chars
002C1Ar 2  AA                 TAX                         ; X = length
002C1Br 2  F0 30              BEQ   @eq
002C1Dr 2  A0 00              LDY   #0                    ; char index
002C1Fr 2               @cmp:
002C1Fr 2  DA                 PHX
002C20r 2  5A                 PHY
002C21r 2                     ; Token char at eval_cur + TOK_PAYLOAD + 1 + charIdx
002C21r 2  A5 rr              LDA   eval_cur_lo
002C23r 2  85 rr              STA   ptr_lo
002C25r 2  A5 rr              LDA   eval_cur_hi
002C27r 2  85 rr              STA   ptr_hi
002C29r 2  98                 TYA
002C2Ar 2  18                 CLC
002C2Br 2  69 04              ADC   #TOK_PAYLOAD+1
002C2Dr 2  A8                 TAY
002C2Er 2  B1 rr              LDA   (ptr_lo),Y
002C30r 2  85 rr              STA   proc_rec_off          ; temp: token char
002C32r 2               
002C32r 2                     ; Record char at proc_entry + 3 + charIdx
002C32r 2  7A                 PLY
002C33r 2  5A                 PHY
002C34r 2  A5 rr              LDA   proc_entry_lo
002C36r 2  85 rr              STA   ptr_lo
002C38r 2  A5 rr              LDA   proc_entry_hi
002C3Ar 2  85 rr              STA   ptr_hi
002C3Cr 2  98                 TYA
002C3Dr 2  18                 CLC
002C3Er 2  69 03              ADC   #3
002C40r 2  A8                 TAY
002C41r 2  B1 rr              LDA   (ptr_lo),Y
002C43r 2               
002C43r 2  C5 rr              CMP   proc_rec_off
002C45r 2  D0 08              BNE   @ne_pop
002C47r 2  7A                 PLY
002C48r 2  FA                 PLX
002C49r 2  C8                 INY
002C4Ar 2  CA                 DEX
002C4Br 2  D0 D2              BNE   @cmp
002C4Dr 2               @eq:
002C4Dr 2  38                 SEC
002C4Er 2  60                 RTS
002C4Fr 2               @ne_pop:
002C4Fr 2  7A                 PLY
002C50r 2  FA                 PLX
002C51r 2               @ne:
002C51r 2  18                 CLC
002C52r 2  60                 RTS
002C53r 2               
002C53r 2               ; ---------------------------------------------------------------------
002C53r 2               ; proc_invoke — invoke a user-defined procedure
002C53r 2               ;   Input: eval_cur_lo/hi = TOK_WORD token (the procedure name)
002C53r 2               ;          proc_entry_lo/hi = matching procedure record
002C53r 2               ;   On exit: JMPs to eval_loop or eval_body to continue.
002C53r 2               ; ---------------------------------------------------------------------
002C53r 2               proc_invoke:
002C53r 2                     ; Save outer tokenizer and eval state on the hardware stack.
002C53r 2                     ; We push: tok_head(2), tok_tail(2), eval_in_body(1),
002C53r 2                     ;          proc_stopped(1) = 6 bytes.
002C53r 2                     ; input_buf is saved to BSS (128 bytes too large for stack).
002C53r 2  A5 rr              LDA   tok_head_lo
002C55r 2  48                 PHA
002C56r 2  A5 rr              LDA   tok_head_hi
002C58r 2  48                 PHA
002C59r 2  A5 rr              LDA   tok_tail_lo
002C5Br 2  48                 PHA
002C5Cr 2  A5 rr              LDA   tok_tail_hi
002C5Er 2  48                 PHA
002C5Fr 2  A5 rr              LDA   eval_in_body
002C61r 2  48                 PHA
002C62r 2  A5 rr              LDA   proc_stopped
002C64r 2  48                 PHA
002C65r 2               
002C65r 2                     ; Save input_buf to BSS save area
002C65r 2  A2 00              LDX   #0
002C67r 2               @save_ib:
002C67r 2  BD rr rr           LDA   input_buf,X
002C6Ar 2  9D rr rr           STA   save_input_buf,X
002C6Dr 2  E8                 INX
002C6Er 2  E0 80              CPX   #128
002C70r 2  D0 F5              BNE   @save_ib
002C72r 2               
002C72r 2                     ; Advance eval_cur past the procedure name token
002C72r 2  20 rr rr           JSR   eval_advance
002C75r 2               
002C75r 2                     ; --- Bind parameters ---
002C75r 2                     ; Navigate to param_count in the record:
002C75r 2                     ;   offset = 3 + name_len
002C75r 2  A5 rr              LDA   proc_entry_lo
002C77r 2  85 rr              STA   ptr_lo
002C79r 2  A5 rr              LDA   proc_entry_hi
002C7Br 2  85 rr              STA   ptr_hi
002C7Dr 2  A0 02              LDY   #2
002C7Fr 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
002C81r 2  18                 CLC
002C82r 2  69 03              ADC   #3
002C84r 2  A8                 TAY                         ; Y = offset to param_count
002C85r 2  B1 rr              LDA   (ptr_lo),Y           ; param_count
002C87r 2  85 rr              STA   proc_param_cnt
002C89r 2  C8                 INY                         ; Y = offset to first param name
002C8Ar 2  84 rr              STY   proc_rec_off          ; save record offset
002C8Cr 2               
002C8Cr 2  A5 rr              LDA   proc_param_cnt
002C8Er 2  F0 5C              BEQ   @bind_done
002C90r 2               
002C90r 2  A6 rr              LDX   proc_param_cnt
002C92r 2               @bind_loop:
002C92r 2  DA                 PHX                         ; save remaining param count
002C93r 2               
002C93r 2                     ; First: evaluate the next argument from the caller's token stream.
002C93r 2                     ; eval_cur still points into the caller's token list.
002C93r 2  20 rr rr           JSR   eval_expr
002C96r 2  90 03              BCC   @arg_ok
002C98r 2  4C rr rr           JMP   @bind_err
002C9Br 2               @arg_ok:
002C9Br 2               
002C9Br 2                     ; eval_val now holds the argument value.
002C9Br 2                     ; Push value onto stack (type + 3 value bytes = 4 bytes)
002C9Br 2  A5 rr              LDA   eval_val_frac
002C9Dr 2  48                 PHA
002C9Er 2  A5 rr              LDA   eval_val_lo
002CA0r 2  48                 PHA
002CA1r 2  A5 rr              LDA   eval_val_hi
002CA3r 2  48                 PHA
002CA4r 2  A5 rr              LDA   eval_type
002CA6r 2  48                 PHA
002CA7r 2               
002CA7r 2                     ; Build the param name as a length-prefixed string in param_name_tmp
002CA7r 2                     ; Read from record at proc_entry + proc_rec_off
002CA7r 2  A5 rr              LDA   proc_entry_lo
002CA9r 2  85 rr              STA   ptr_lo
002CABr 2  A5 rr              LDA   proc_entry_hi
002CADr 2  85 rr              STA   ptr_hi
002CAFr 2  A4 rr              LDY   proc_rec_off
002CB1r 2  B1 rr              LDA   (ptr_lo),Y           ; param name length
002CB3r 2  8D rr rr           STA   param_name_tmp        ; length byte
002CB6r 2  AA                 TAX                         ; X = char count
002CB7r 2  A9 00              LDA   #0
002CB9r 2  85 rr              STA   proc_name_len         ; dest offset in param_name_tmp
002CBBr 2               @bind_ch:
002CBBr 2  E0 00              CPX   #0
002CBDr 2  F0 0F              BEQ   @bind_ch_done
002CBFr 2  C8                 INY
002CC0r 2  B1 rr              LDA   (ptr_lo),Y
002CC2r 2  DA                 PHX
002CC3r 2  A6 rr              LDX   proc_name_len
002CC5r 2  9D rr rr           STA   param_name_tmp+1,X
002CC8r 2  E6 rr              INC   proc_name_len
002CCAr 2  FA                 PLX
002CCBr 2  CA                 DEX
002CCCr 2  80 ED              BRA   @bind_ch
002CCEr 2               @bind_ch_done:
002CCEr 2                     ; Advance proc_rec_off past this param
002CCEr 2  C8                 INY
002CCFr 2  84 rr              STY   proc_rec_off
002CD1r 2               
002CD1r 2                     ; Pop value from stack back into eval_val
002CD1r 2  68                 PLA
002CD2r 2  85 rr              STA   eval_type
002CD4r 2  68                 PLA
002CD5r 2  85 rr              STA   eval_val_hi
002CD7r 2  68                 PLA
002CD8r 2  85 rr              STA   eval_val_lo
002CDAr 2  68                 PLA
002CDBr 2  85 rr              STA   eval_val_frac
002CDDr 2               
002CDDr 2                     ; Call var_set with ptr_lo/hi → param_name_tmp
002CDDr 2  A9 rr              LDA   #<param_name_tmp
002CDFr 2  85 rr              STA   ptr_lo
002CE1r 2  A9 rr              LDA   #>param_name_tmp
002CE3r 2  85 rr              STA   ptr_hi
002CE5r 2  20 rr rr           JSR   var_set
002CE8r 2               
002CE8r 2  FA                 PLX                         ; restore remaining count
002CE9r 2  CA                 DEX
002CEAr 2  D0 A6              BNE   @bind_loop
002CECr 2               
002CECr 2               @bind_done:
002CECr 2                     ; Save heap pointer AFTER param binding so var_set allocations persist.
002CECr 2                     ; Body tokenization will reuse heap from this point each line.
002CECr 2  A5 rr              LDA   heap_ptr
002CEEr 2  8D rr rr           STA   save_heap_ptr_lo
002CF1r 2  A5 rr              LDA   heap_ptr+1
002CF3r 2  8D rr rr           STA   save_heap_ptr_hi
002CF6r 2               
002CF6r 2                     ; Save eval_cur (resume point after all args consumed from caller)
002CF6r 2  A5 rr              LDA   eval_cur_lo
002CF8r 2  8D rr rr           STA   save_eval_cur_lo
002CFBr 2  A5 rr              LDA   eval_cur_hi
002CFDr 2  8D rr rr           STA   save_eval_cur_hi
002D00r 2               
002D00r 2                     ; --- Execute the body ---
002D00r 2                     ; Navigate to body in the record:
002D00r 2                     ;   proc_rec_off now points past all params.
002D00r 2                     ;   Next 2 bytes = body_len, then body text.
002D00r 2  A5 rr              LDA   proc_entry_lo
002D02r 2  85 rr              STA   ptr_lo
002D04r 2  A5 rr              LDA   proc_entry_hi
002D06r 2  85 rr              STA   ptr_hi
002D08r 2  A4 rr              LDY   proc_rec_off
002D0Ar 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_lo
002D0Cr 2  85 rr              STA   proc_body_len_lo
002D0Er 2  C8                 INY
002D0Fr 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_hi
002D11r 2  85 rr              STA   proc_body_len_hi
002D13r 2  C8                 INY                         ; Y = offset to body text start
002D14r 2  84 rr              STY   proc_rec_off
002D16r 2               
002D16r 2                     ; Compute absolute pointer to body text start
002D16r 2  18                 CLC
002D17r 2  A5 rr              LDA   proc_entry_lo
002D19r 2  65 rr              ADC   proc_rec_off
002D1Br 2  85 rr              STA   proc_ptr_lo
002D1Dr 2  A5 rr              LDA   proc_entry_hi
002D1Fr 2  69 00              ADC   #0
002D21r 2  85 rr              STA   proc_ptr_hi
002D23r 2               
002D23r 2                     ; Process body line by line: find each $0A, copy line to input_buf,
002D23r 2                     ; tokenize, eval, repeat.
002D23r 2                     ; proc_ptr = current position in body text
002D23r 2                     ; proc_body_len = remaining bytes
002D23r 2               
002D23r 2                     ; Clear STOP/OUTPUT flag before executing body
002D23r 2  64 rr              STZ   proc_stopped
002D25r 2               
002D25r 2               @exec_line:
002D25r 2                     ; Any body text remaining?
002D25r 2  A5 rr              LDA   proc_body_len_lo
002D27r 2  05 rr              ORA   proc_body_len_hi
002D29r 2  D0 03              BNE   @have_body
002D2Br 2  4C rr rr           JMP   @exec_done
002D2Er 2               @have_body:
002D2Er 2               
002D2Er 2                     ; Reset heap for this statement's tokens (reuse token heap each statement)
002D2Er 2  AD rr rr           LDA   save_heap_ptr_lo
002D31r 2  85 rr              STA   heap_ptr
002D33r 2  AD rr rr           LDA   save_heap_ptr_hi
002D36r 2  85 rr              STA   heap_ptr+1
002D38r 2               
002D38r 2                     ; Accumulate physical lines into one logical statement: keep copying lines
002D38r 2                     ; into input_buf until bracket/paren depth returns to 0, so a [ ... ] or
002D38r 2                     ; ( ... ) that spans several lines is pieced together before we tokenize.
002D38r 2  A2 00              LDX   #0                    ; input_buf index
002D3Ar 2  9C rr rr           STZ   proc_brk_depth
002D3Dr 2               @line_ch:
002D3Dr 2  A5 rr              LDA   proc_body_len_lo
002D3Fr 2  05 rr              ORA   proc_body_len_hi
002D41r 2  F0 71              BEQ   @line_eol             ; no more body text -> end of last line
002D43r 2               
002D43r 2  A0 00              LDY   #0
002D45r 2  B1 rr              LDA   (proc_ptr_lo),Y      ; read body char
002D47r 2  C9 0A              CMP   #$0A
002D49r 2  F0 5B              BEQ   @line_nl
002D4Br 2  C9 3B              CMP   #';'                 ; comment -> skip rest of physical line
002D4Dr 2  F0 37              BEQ   @line_comment
002D4Fr 2               
002D4Fr 2                     ; Store char in input_buf, tracking bracket/paren nesting depth.
002D4Fr 2  9D rr rr           STA   input_buf,X
002D52r 2  E8                 INX
002D53r 2  C9 5B              CMP   #'['
002D55r 2  F0 20              BEQ   @brk_inc
002D57r 2  C9 28              CMP   #'('
002D59r 2  F0 1C              BEQ   @brk_inc
002D5Br 2  C9 5D              CMP   #']'
002D5Dr 2  F0 1D              BEQ   @brk_dec
002D5Fr 2  C9 29              CMP   #')'
002D61r 2  F0 19              BEQ   @brk_dec
002D63r 2               @brk_done:
002D63r 2                     ; Advance body pointer
002D63r 2  E6 rr              INC   proc_ptr_lo
002D65r 2  D0 02              BNE   :+
002D67r 2  E6 rr              INC   proc_ptr_hi
002D69r 2               :     ; Decrement remaining
002D69r 2  A5 rr              LDA   proc_body_len_lo
002D6Br 2  D0 02              BNE   @ln_dec_lo
002D6Dr 2  C6 rr              DEC   proc_body_len_hi
002D6Fr 2               @ln_dec_lo:
002D6Fr 2  C6 rr              DEC   proc_body_len_lo
002D71r 2                     ; Guard against input_buf overflow (~120 chars per statement).
002D71r 2  E0 78              CPX   #120
002D73r 2  B0 3F              BCS   @line_eol
002D75r 2  80 C6              BRA   @line_ch
002D77r 2               
002D77r 2               @brk_inc:
002D77r 2  EE rr rr           INC   proc_brk_depth
002D7Ar 2  80 E7              BRA   @brk_done
002D7Cr 2               @brk_dec:
002D7Cr 2  AD rr rr           LDA   proc_brk_depth
002D7Fr 2  F0 E2              BEQ   @brk_done             ; floor at 0
002D81r 2  CE rr rr           DEC   proc_brk_depth
002D84r 2  80 DD              BRA   @brk_done
002D86r 2               
002D86r 2               @line_comment:
002D86r 2                     ; ';' begins a comment: advance past the rest of this physical line
002D86r 2                     ; without copying, so comment text (and any brackets in it) is ignored.
002D86r 2  A5 rr              LDA   proc_body_len_lo
002D88r 2  05 rr              ORA   proc_body_len_hi
002D8Ar 2  F0 28              BEQ   @line_eol             ; comment runs to end of body
002D8Cr 2  A0 00              LDY   #0
002D8Er 2  B1 rr              LDA   (proc_ptr_lo),Y
002D90r 2  48                 PHA                         ; remember if this was the newline
002D91r 2  E6 rr              INC   proc_ptr_lo
002D93r 2  D0 02              BNE   :+
002D95r 2  E6 rr              INC   proc_ptr_hi
002D97r 2  A5 rr        :     LDA   proc_body_len_lo
002D99r 2  D0 02              BNE   @cmt_dec
002D9Br 2  C6 rr              DEC   proc_body_len_hi
002D9Dr 2               @cmt_dec:
002D9Dr 2  C6 rr              DEC   proc_body_len_lo
002D9Fr 2  68                 PLA
002DA0r 2  C9 0A              CMP   #$0A
002DA2r 2  D0 E2              BNE   @line_comment         ; keep skipping comment chars
002DA4r 2  80 0E              BRA   @line_eol             ; consumed the newline -> end of physical line
002DA6r 2               
002DA6r 2               @line_nl:
002DA6r 2                     ; Skip the $0A
002DA6r 2  E6 rr              INC   proc_ptr_lo
002DA8r 2  D0 02              BNE   :+
002DAAr 2  E6 rr              INC   proc_ptr_hi
002DACr 2  A5 rr        :     LDA   proc_body_len_lo
002DAEr 2  D0 02              BNE   @ln2_dec_lo
002DB0r 2  C6 rr              DEC   proc_body_len_hi
002DB2r 2               @ln2_dec_lo:
002DB2r 2  C6 rr              DEC   proc_body_len_lo
002DB4r 2                     ; fall through to end-of-physical-line decision
002DB4r 2               
002DB4r 2               @line_eol:
002DB4r 2                     ; End of a physical line. If brackets/parens are still open AND there is
002DB4r 2                     ; more body to read AND room in the buffer, append a separating space and
002DB4r 2                     ; keep accumulating; otherwise the statement is complete.
002DB4r 2  AD rr rr           LDA   proc_brk_depth
002DB7r 2  F0 13              BEQ   @line_end             ; balanced -> execute
002DB9r 2  A5 rr              LDA   proc_body_len_lo
002DBBr 2  05 rr              ORA   proc_body_len_hi
002DBDr 2  F0 0D              BEQ   @line_end             ; no more lines -> execute (eval will report)
002DBFr 2  E0 78              CPX   #120
002DC1r 2  B0 09              BCS   @line_end             ; buffer full -> execute
002DC3r 2  A9 20              LDA   #' '                  ; join lines with whitespace
002DC5r 2  9D rr rr           STA   input_buf,X
002DC8r 2  E8                 INX
002DC9r 2  4C rr rr           JMP   @line_ch
002DCCr 2               
002DCCr 2               @line_end:
002DCCr 2                     ; Null-terminate input_buf
002DCCr 2  9E rr rr           STZ   input_buf,X
002DCFr 2               
002DCFr 2                     ; Tokenize this line
002DCFr 2  20 rr rr           JSR   tokenize_line
002DD2r 2               
002DD2r 2                     ; Save body-loop state that recursive proc_invoke would clobber.
002DD2r 2                     ; BSS save areas (save_heap_ptr, save_eval_cur) plus ZP body-loop
002DD2r 2                     ; variables (proc_ptr, proc_body_len) all need protection.
002DD2r 2  A5 rr              LDA   proc_ptr_lo
002DD4r 2  48                 PHA
002DD5r 2  A5 rr              LDA   proc_ptr_hi
002DD7r 2  48                 PHA
002DD8r 2  A5 rr              LDA   proc_body_len_lo
002DDAr 2  48                 PHA
002DDBr 2  A5 rr              LDA   proc_body_len_hi
002DDDr 2  48                 PHA
002DDEr 2  AD rr rr           LDA   save_heap_ptr_lo
002DE1r 2  48                 PHA
002DE2r 2  AD rr rr           LDA   save_heap_ptr_hi
002DE5r 2  48                 PHA
002DE6r 2  AD rr rr           LDA   save_eval_cur_lo
002DE9r 2  48                 PHA
002DEAr 2  AD rr rr           LDA   save_eval_cur_hi
002DEDr 2  48                 PHA
002DEEr 2               
002DEEr 2                     ; Eval this line (full eval — not body mode)
002DEEr 2  20 rr rr           JSR   eval_line
002DF1r 2               
002DF1r 2                     ; Restore body-loop state
002DF1r 2  68                 PLA
002DF2r 2  8D rr rr           STA   save_eval_cur_hi
002DF5r 2  68                 PLA
002DF6r 2  8D rr rr           STA   save_eval_cur_lo
002DF9r 2  68                 PLA
002DFAr 2  8D rr rr           STA   save_heap_ptr_hi
002DFDr 2  68                 PLA
002DFEr 2  8D rr rr           STA   save_heap_ptr_lo
002E01r 2  68                 PLA
002E02r 2  85 rr              STA   proc_body_len_hi
002E04r 2  68                 PLA
002E05r 2  85 rr              STA   proc_body_len_lo
002E07r 2  68                 PLA
002E08r 2  85 rr              STA   proc_ptr_hi
002E0Ar 2  68                 PLA
002E0Br 2  85 rr              STA   proc_ptr_lo
002E0Dr 2               
002E0Dr 2                     ; Check if STOP or OUTPUT was called — stop processing lines
002E0Dr 2  A5 rr              LDA   proc_stopped
002E0Fr 2  D0 03              BNE   @exec_done
002E11r 2               
002E11r 2  4C rr rr           JMP   @exec_line
002E14r 2               
002E14r 2               @exec_done:
002E14r 2                     ; Restore heap pointer (procedures stay, but per-line tokens freed)
002E14r 2  AD rr rr           LDA   save_heap_ptr_lo
002E17r 2  85 rr              STA   heap_ptr
002E19r 2  AD rr rr           LDA   save_heap_ptr_hi
002E1Cr 2  85 rr              STA   heap_ptr+1
002E1Er 2               
002E1Er 2                     ; Restore input_buf
002E1Er 2  A2 00              LDX   #0
002E20r 2               @rest_ib:
002E20r 2  BD rr rr           LDA   save_input_buf,X
002E23r 2  9D rr rr           STA   input_buf,X
002E26r 2  E8                 INX
002E27r 2  E0 80              CPX   #128
002E29r 2  D0 F5              BNE   @rest_ib
002E2Br 2               
002E2Br 2                     ; Restore eval_cur to the resume point in the caller's token stream
002E2Br 2  AD rr rr           LDA   save_eval_cur_lo
002E2Er 2  85 rr              STA   eval_cur_lo
002E30r 2  AD rr rr           LDA   save_eval_cur_hi
002E33r 2  85 rr              STA   eval_cur_hi
002E35r 2               
002E35r 2                     ; Restore outer state from stack.
002E35r 2                     ; X returns this invocation's proc_stopped to the caller.
002E35r 2                     ; Stack layout (top to bottom):
002E35r 2                     ;   saved_proc_stopped, eval_in_body, tok_tail_hi, tok_tail_lo,
002E35r 2                     ;   tok_head_hi, tok_head_lo
002E35r 2  A6 rr              LDX   proc_stopped          ; X = this proc's exit state
002E37r 2  68                 PLA                         ; pop saved outer proc_stopped
002E38r 2  85 rr              STA   proc_stopped          ; restore outer proc_stopped
002E3Ar 2  68                 PLA
002E3Br 2  85 rr              STA   eval_in_body
002E3Dr 2  68                 PLA
002E3Er 2  85 rr              STA   tok_tail_hi
002E40r 2  68                 PLA
002E41r 2  85 rr              STA   tok_tail_lo
002E43r 2  68                 PLA
002E44r 2  85 rr              STA   tok_head_hi
002E46r 2  68                 PLA
002E47r 2  85 rr              STA   tok_head_lo
002E49r 2               
002E49r 2                     ; Return with X = exit status ($00=normal, $01=STOP, $02=OUTPUT)
002E49r 2  60                 RTS
002E4Ar 2               
002E4Ar 2               @bind_err:
002E4Ar 2  FA                 PLX                         ; discard remaining param count
002E4Br 2                     ; Print error
002E4Br 2  A2 00              LDX   #0
002E4Dr 2               @be_lp:
002E4Dr 2  BD rr rr           LDA   str_notenough,X
002E50r 2  F0 06              BEQ   @be_done
002E52r 2  8D 0E A0           STA   VGC_CHAROUT
002E55r 2  E8                 INX
002E56r 2  D0 F5              BNE   @be_lp
002E58r 2               @be_done:
002E58r 2  20 rr rr           JSR   eval_newline
002E5Br 2                     ; Restore input_buf and stack, skip body execution
002E5Br 2  A2 00              LDX   #0
002E5Dr 2               @be_rest_ib:
002E5Dr 2  BD rr rr           LDA   save_input_buf,X
002E60r 2  9D rr rr           STA   input_buf,X
002E63r 2  E8                 INX
002E64r 2  E0 80              CPX   #128
002E66r 2  D0 F5              BNE   @be_rest_ib
002E68r 2                     ; Restore stack (6 bytes: proc_stopped, eval_in_body, tok_tail, tok_head)
002E68r 2  A2 00              LDX   #$00                  ; X = normal exit status
002E6Ar 2  68                 PLA                         ; saved proc_stopped
002E6Br 2  85 rr              STA   proc_stopped
002E6Dr 2  68                 PLA
002E6Er 2  85 rr              STA   eval_in_body
002E70r 2  68                 PLA
002E71r 2  85 rr              STA   tok_tail_hi
002E73r 2  68                 PLA
002E74r 2  85 rr              STA   tok_tail_lo
002E76r 2  68                 PLA
002E77r 2  85 rr              STA   tok_head_hi
002E79r 2  68                 PLA
002E7Ar 2  85 rr              STA   tok_head_lo
002E7Cr 2  60                 RTS
002E7Dr 2               
002E7Dr 2               ; ---------------------------------------------------------------------
002E7Dr 2               ; proc_find_by_name — search proc_head for a procedure by name string
002E7Dr 2               ;   Input: ptr_lo/hi = length-prefixed name string (e.g. from eval_val)
002E7Dr 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002E7Dr 2               ;           carry set = not found
002E7Dr 2               ;   Clobbers: A, X, Y, proc_entry, proc_name_len, proc_rec_off
002E7Dr 2               ; ---------------------------------------------------------------------
002E7Dr 2               proc_find_by_name:
002E7Dr 2                     ; Save search name pointer
002E7Dr 2  A5 rr              LDA   ptr_lo
002E7Fr 2  85 rr              STA   var_name_lo             ; reuse var scratch as search ptr
002E81r 2  A5 rr              LDA   ptr_hi
002E83r 2  85 rr              STA   var_name_hi
002E85r 2               
002E85r 2  A5 rr              LDA   proc_head_lo
002E87r 2  85 rr              STA   proc_entry_lo
002E89r 2  A5 rr              LDA   proc_head_hi
002E8Br 2  85 rr              STA   proc_entry_hi
002E8Dr 2               
002E8Dr 2               @walk:
002E8Dr 2  A5 rr              LDA   proc_entry_lo
002E8Fr 2  05 rr              ORA   proc_entry_hi
002E91r 2  F0 55              BEQ   @not_found
002E93r 2               
002E93r 2                     ; Compare name lengths
002E93r 2  A5 rr              LDA   var_name_lo
002E95r 2  85 rr              STA   ptr_lo
002E97r 2  A5 rr              LDA   var_name_hi
002E99r 2  85 rr              STA   ptr_hi
002E9Br 2  A0 00              LDY   #0
002E9Dr 2  B1 rr              LDA   (ptr_lo),Y             ; search name length
002E9Fr 2  85 rr              STA   proc_name_len
002EA1r 2               
002EA1r 2  A5 rr              LDA   proc_entry_lo
002EA3r 2  85 rr              STA   ptr_lo
002EA5r 2  A5 rr              LDA   proc_entry_hi
002EA7r 2  85 rr              STA   ptr_hi
002EA9r 2  A0 02              LDY   #2
002EABr 2  B1 rr              LDA   (ptr_lo),Y             ; record name length
002EADr 2  C5 rr              CMP   proc_name_len
002EAFr 2  D0 32              BNE   @next
002EB1r 2               
002EB1r 2                     ; Lengths match — compare chars
002EB1r 2  AA                 TAX                           ; X = length
002EB2r 2  F0 2C              BEQ   @found                  ; both zero = match
002EB4r 2  A0 00              LDY   #0
002EB6r 2               @cmp:
002EB6r 2  DA                 PHX
002EB7r 2  5A                 PHY
002EB8r 2                     ; Search char
002EB8r 2  A5 rr              LDA   var_name_lo
002EBAr 2  85 rr              STA   ptr_lo
002EBCr 2  A5 rr              LDA   var_name_hi
002EBEr 2  85 rr              STA   ptr_hi
002EC0r 2  C8                 INY                           ; +1 for length byte
002EC1r 2  B1 rr              LDA   (ptr_lo),Y
002EC3r 2  85 rr              STA   proc_rec_off            ; temp: search char
002EC5r 2               
002EC5r 2                     ; Record char
002EC5r 2  7A                 PLY
002EC6r 2  A5 rr              LDA   proc_entry_lo
002EC8r 2  85 rr              STA   ptr_lo
002ECAr 2  A5 rr              LDA   proc_entry_hi
002ECCr 2  85 rr              STA   ptr_hi
002ECEr 2  5A                 PHY
002ECFr 2  98                 TYA
002ED0r 2  18                 CLC
002ED1r 2  69 03              ADC   #3                      ; record name starts at offset 3
002ED3r 2  A8                 TAY
002ED4r 2  B1 rr              LDA   (ptr_lo),Y
002ED6r 2  7A                 PLY
002ED7r 2  C5 rr              CMP   proc_rec_off
002ED9r 2  D0 07              BNE   @ne_pop
002EDBr 2  FA                 PLX
002EDCr 2  C8                 INY
002EDDr 2  CA                 DEX
002EDEr 2  D0 D6              BNE   @cmp
002EE0r 2               
002EE0r 2               @found:
002EE0r 2  18                 CLC
002EE1r 2  60                 RTS
002EE2r 2               
002EE2r 2               @ne_pop:
002EE2r 2  FA                 PLX
002EE3r 2               @next:
002EE3r 2                     ; Follow next pointer
002EE3r 2  20 rr rr           JSR   proc_next
002EE6r 2  80 A5              BRA   @walk
002EE8r 2               
002EE8r 2               @not_found:
002EE8r 2  38                 SEC
002EE9r 2  60                 RTS
002EEAr 2               
002EEAr 2               ; ---------------------------------------------------------------------
002EEAr 2               ; do_pots — POTS: print all procedure names
002EEAr 2               ;   Arity 0, no arguments.
002EEAr 2               ; ---------------------------------------------------------------------
002EEAr 2               do_pots:
002EEAr 2  A5 rr              LDA   proc_head_lo
002EECr 2  85 rr              STA   proc_entry_lo
002EEEr 2  A5 rr              LDA   proc_head_hi
002EF0r 2  85 rr              STA   proc_entry_hi
002EF2r 2               
002EF2r 2               @walk:
002EF2r 2  A5 rr              LDA   proc_entry_lo
002EF4r 2  05 rr              ORA   proc_entry_hi
002EF6r 2  F0 24              BEQ   @done
002EF8r 2               
002EF8r 2                     ; Print name
002EF8r 2  A5 rr              LDA   proc_entry_lo
002EFAr 2  85 rr              STA   ptr_lo
002EFCr 2  A5 rr              LDA   proc_entry_hi
002EFEr 2  85 rr              STA   ptr_hi
002F00r 2  A0 02              LDY   #2
002F02r 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002F04r 2  AA                 TAX
002F05r 2  F0 0B              BEQ   @skip_name
002F07r 2  A0 03              LDY   #3
002F09r 2               @pch:
002F09r 2  B1 rr              LDA   (ptr_lo),Y
002F0Br 2  8D 0E A0           STA   VGC_CHAROUT
002F0Er 2  C8                 INY
002F0Fr 2  CA                 DEX
002F10r 2  D0 F7              BNE   @pch
002F12r 2               @skip_name:
002F12r 2  A9 20              LDA   #' '
002F14r 2  8D 0E A0           STA   VGC_CHAROUT
002F17r 2               
002F17r 2                     ; Follow next
002F17r 2  20 rr rr           JSR   proc_next
002F1Ar 2  80 D6              BRA   @walk
002F1Cr 2               
002F1Cr 2               @done:
002F1Cr 2  20 rr rr           JSR   eval_newline
002F1Fr 2  4C rr rr           JMP   eval_continue
002F22r 2               
002F22r 2               ; ---------------------------------------------------------------------
002F22r 2               ; do_po — PO "name: print procedure definition
002F22r 2               ;   Arity 0 — evaluates its own argument
002F22r 2               ; ---------------------------------------------------------------------
002F22r 2               do_po:
002F22r 2  20 rr rr           JSR   eval_expr
002F25r 2  90 03              BCC   @po_type_ok
002F27r 2  4C rr rr           JMP   @err
002F2Ar 2               @po_type_ok:
002F2Ar 2  A5 rr              LDA   eval_type
002F2Cr 2  C9 01              CMP   #VAL_WORD
002F2Er 2  F0 03              BEQ   @po_word_ok
002F30r 2  4C rr rr           JMP   @err
002F33r 2               @po_word_ok:
002F33r 2               
002F33r 2                     ; Look up by name
002F33r 2  A5 rr              LDA   eval_val_lo
002F35r 2  85 rr              STA   ptr_lo
002F37r 2  A5 rr              LDA   eval_val_hi
002F39r 2  85 rr              STA   ptr_hi
002F3Br 2  20 rr rr           JSR   proc_find_by_name
002F3Er 2  90 03              BCC   @po_found
002F40r 2  4C rr rr           JMP   @err_notfound
002F43r 2               @po_found:
002F43r 2               
002F43r 2                     ; proc_entry_lo/hi = record
002F43r 2                     ; Print "TO "
002F43r 2  A9 54              LDA   #'T'
002F45r 2  8D 0E A0           STA   VGC_CHAROUT
002F48r 2  A9 4F              LDA   #'O'
002F4Ar 2  8D 0E A0           STA   VGC_CHAROUT
002F4Dr 2  A9 20              LDA   #' '
002F4Fr 2  8D 0E A0           STA   VGC_CHAROUT
002F52r 2               
002F52r 2                     ; Print name
002F52r 2  A5 rr              LDA   proc_entry_lo
002F54r 2  85 rr              STA   ptr_lo
002F56r 2  A5 rr              LDA   proc_entry_hi
002F58r 2  85 rr              STA   ptr_hi
002F5Ar 2  A0 02              LDY   #2
002F5Cr 2  B1 rr              LDA   (ptr_lo),Y             ; name_len
002F5Er 2  AA                 TAX
002F5Fr 2  85 rr              STA   proc_name_len
002F61r 2  F0 0B              BEQ   @po_params
002F63r 2  A0 03              LDY   #3
002F65r 2               @po_name_ch:
002F65r 2  B1 rr              LDA   (ptr_lo),Y
002F67r 2  8D 0E A0           STA   VGC_CHAROUT
002F6Ar 2  C8                 INY
002F6Br 2  CA                 DEX
002F6Cr 2  D0 F7              BNE   @po_name_ch
002F6Er 2               
002F6Er 2               @po_params:
002F6Er 2                     ; Y = 3 + name_len = offset to param_count
002F6Er 2  A5 rr              LDA   proc_name_len
002F70r 2  18                 CLC
002F71r 2  69 03              ADC   #3
002F73r 2  A8                 TAY
002F74r 2  B1 rr              LDA   (ptr_lo),Y             ; param_count
002F76r 2  85 rr              STA   proc_param_cnt
002F78r 2  C8                 INY                           ; offset to first param
002F79r 2  84 rr              STY   proc_rec_off
002F7Br 2               
002F7Br 2  A5 rr              LDA   proc_param_cnt
002F7Dr 2  F0 2E              BEQ   @po_header_done
002F7Fr 2               
002F7Fr 2  A6 rr              LDX   proc_param_cnt
002F81r 2               @po_param:
002F81r 2                     ; Print " :"
002F81r 2  A9 20              LDA   #' '
002F83r 2  8D 0E A0           STA   VGC_CHAROUT
002F86r 2  A9 3A              LDA   #':'
002F88r 2  8D 0E A0           STA   VGC_CHAROUT
002F8Br 2               
002F8Br 2                     ; Read param name length
002F8Br 2  A5 rr              LDA   proc_entry_lo
002F8Dr 2  85 rr              STA   ptr_lo
002F8Fr 2  A5 rr              LDA   proc_entry_hi
002F91r 2  85 rr              STA   ptr_hi
002F93r 2  A4 rr              LDY   proc_rec_off
002F95r 2  B1 rr              LDA   (ptr_lo),Y             ; param name length
002F97r 2  DA                 PHX
002F98r 2  AA                 TAX                           ; X = chars to print
002F99r 2  C8                 INY
002F9Ar 2               @po_pch:
002F9Ar 2  E0 00              CPX   #0
002F9Cr 2  F0 09              BEQ   @po_param_done
002F9Er 2  B1 rr              LDA   (ptr_lo),Y
002FA0r 2  8D 0E A0           STA   VGC_CHAROUT
002FA3r 2  C8                 INY
002FA4r 2  CA                 DEX
002FA5r 2  80 F3              BRA   @po_pch
002FA7r 2               @po_param_done:
002FA7r 2  84 rr              STY   proc_rec_off
002FA9r 2  FA                 PLX
002FAAr 2  CA                 DEX
002FABr 2  D0 D4              BNE   @po_param
002FADr 2               
002FADr 2               @po_header_done:
002FADr 2  20 rr rr           JSR   eval_newline
002FB0r 2               
002FB0r 2                     ; Read body_len
002FB0r 2  A5 rr              LDA   proc_entry_lo
002FB2r 2  85 rr              STA   ptr_lo
002FB4r 2  A5 rr              LDA   proc_entry_hi
002FB6r 2  85 rr              STA   ptr_hi
002FB8r 2  A4 rr              LDY   proc_rec_off
002FBAr 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_lo
002FBCr 2  85 rr              STA   proc_body_len_lo
002FBEr 2  C8                 INY
002FBFr 2  B1 rr              LDA   (ptr_lo),Y             ; body_len_hi
002FC1r 2  85 rr              STA   proc_body_len_hi
002FC3r 2  C8                 INY                           ; Y = offset to body text
002FC4r 2               
002FC4r 2                     ; Compute absolute pointer to body
002FC4r 2  84 rr              STY   proc_rec_off
002FC6r 2  18                 CLC
002FC7r 2  A5 rr              LDA   proc_entry_lo
002FC9r 2  65 rr              ADC   proc_rec_off
002FCBr 2  85 rr              STA   proc_ptr_lo
002FCDr 2  A5 rr              LDA   proc_entry_hi
002FCFr 2  69 00              ADC   #0
002FD1r 2  85 rr              STA   proc_ptr_hi
002FD3r 2               
002FD3r 2                     ; Print body text, converting $0A to CR+LF
002FD3r 2               @po_body:
002FD3r 2  A5 rr              LDA   proc_body_len_lo
002FD5r 2  05 rr              ORA   proc_body_len_hi
002FD7r 2  F0 20              BEQ   @po_end
002FD9r 2               
002FD9r 2  A0 00              LDY   #0
002FDBr 2  B1 rr              LDA   (proc_ptr_lo),Y
002FDDr 2  C9 0A              CMP   #$0A
002FDFr 2  D0 05              BNE   @po_char
002FE1r 2  20 rr rr           JSR   eval_newline
002FE4r 2  80 03              BRA   @po_advance
002FE6r 2               @po_char:
002FE6r 2  8D 0E A0           STA   VGC_CHAROUT
002FE9r 2               @po_advance:
002FE9r 2  E6 rr              INC   proc_ptr_lo
002FEBr 2  D0 02              BNE   :+
002FEDr 2  E6 rr              INC   proc_ptr_hi
002FEFr 2  A5 rr        :     LDA   proc_body_len_lo
002FF1r 2  D0 02              BNE   :+
002FF3r 2  C6 rr              DEC   proc_body_len_hi
002FF5r 2  C6 rr        :     DEC   proc_body_len_lo
002FF7r 2  80 DA              BRA   @po_body
002FF9r 2               
002FF9r 2               @po_end:
002FF9r 2                     ; Print "END"
002FF9r 2  A9 45              LDA   #'E'
002FFBr 2  8D 0E A0           STA   VGC_CHAROUT
002FFEr 2  A9 4E              LDA   #'N'
003000r 2  8D 0E A0           STA   VGC_CHAROUT
003003r 2  A9 44              LDA   #'D'
003005r 2  8D 0E A0           STA   VGC_CHAROUT
003008r 2  20 rr rr           JSR   eval_newline
00300Br 2  4C rr rr           JMP   eval_continue
00300Er 2               
00300Er 2               @err:
00300Er 2  A2 rr              LDX   #<str_po_name
003010r 2  A0 rr              LDY   #>str_po_name
003012r 2  4C rr rr           JMP   err_nei
003015r 2               @err_notfound:
003015r 2  A2 rr              LDX   #<str_idk
003017r 2  A0 rr              LDY   #>str_idk
003019r 2  4C rr rr           JMP   list_print_err
00301Cr 2               
00301Cr 2               ; ---------------------------------------------------------------------
00301Cr 2               ; do_erase — ERASE "name: remove procedure from directory
00301Cr 2               ;   Arity 0 — evaluates its own argument
00301Cr 2               ; ---------------------------------------------------------------------
00301Cr 2               do_erase:
00301Cr 2  20 rr rr           JSR   eval_expr
00301Fr 2  90 03              BCC   @er_type_ok
003021r 2  4C rr rr           JMP   @err
003024r 2               @er_type_ok:
003024r 2  A5 rr              LDA   eval_type
003026r 2  C9 01              CMP   #VAL_WORD
003028r 2  F0 03              BEQ   @er_word_ok
00302Ar 2  4C rr rr           JMP   @err
00302Dr 2               @er_word_ok:
00302Dr 2               
00302Dr 2                     ; Save name pointer
00302Dr 2  A5 rr              LDA   eval_val_lo
00302Fr 2  85 rr              STA   var_name_lo
003031r 2  A5 rr              LDA   eval_val_hi
003033r 2  85 rr              STA   var_name_hi
003035r 2               
003035r 2                     ; Walk proc_head with prev tracking
003035r 2                     ; prev = address of "next" pointer to patch (starts as &proc_head)
003035r 2  A9 rr              LDA   #<proc_head_lo
003037r 2  85 rr              STA   proc_ptr_lo             ; prev_ptr_lo
003039r 2  A9 rr              LDA   #>proc_head_lo
00303Br 2  85 rr              STA   proc_ptr_hi             ; prev_ptr_hi (ZP, so high byte = 0)
00303Dr 2               
00303Dr 2  A5 rr              LDA   proc_head_lo
00303Fr 2  85 rr              STA   proc_entry_lo
003041r 2  A5 rr              LDA   proc_head_hi
003043r 2  85 rr              STA   proc_entry_hi
003045r 2               
003045r 2               @walk:
003045r 2  A5 rr              LDA   proc_entry_lo
003047r 2  05 rr              ORA   proc_entry_hi
003049r 2  D0 03              BNE   @walk_ok
00304Br 2  4C rr rr           JMP   @not_found
00304Er 2               @walk_ok:
00304Er 2               
00304Er 2                     ; Compare name
00304Er 2  A5 rr              LDA   var_name_lo
003050r 2  85 rr              STA   ptr_lo
003052r 2  A5 rr              LDA   var_name_hi
003054r 2  85 rr              STA   ptr_hi
003056r 2  A0 00              LDY   #0
003058r 2  B1 rr              LDA   (ptr_lo),Y             ; search name len
00305Ar 2  85 rr              STA   proc_name_len
00305Cr 2               
00305Cr 2  A5 rr              LDA   proc_entry_lo
00305Er 2  85 rr              STA   ptr_lo
003060r 2  A5 rr              LDA   proc_entry_hi
003062r 2  85 rr              STA   ptr_hi
003064r 2  A0 02              LDY   #2
003066r 2  B1 rr              LDA   (ptr_lo),Y             ; record name len
003068r 2  C5 rr              CMP   proc_name_len
00306Ar 2  D0 32              BNE   @erase_next
00306Cr 2               
00306Cr 2  AA                 TAX
00306Dr 2  F0 3C              BEQ   @erase_match            ; both empty = match
00306Fr 2  A0 00              LDY   #0
003071r 2               @ecmp:
003071r 2  DA                 PHX
003072r 2  5A                 PHY
003073r 2  A5 rr              LDA   var_name_lo
003075r 2  85 rr              STA   ptr_lo
003077r 2  A5 rr              LDA   var_name_hi
003079r 2  85 rr              STA   ptr_hi
00307Br 2  C8                 INY
00307Cr 2  B1 rr              LDA   (ptr_lo),Y             ; search char
00307Er 2  85 rr              STA   proc_rec_off
003080r 2               
003080r 2  7A                 PLY
003081r 2  A5 rr              LDA   proc_entry_lo
003083r 2  85 rr              STA   ptr_lo
003085r 2  A5 rr              LDA   proc_entry_hi
003087r 2  85 rr              STA   ptr_hi
003089r 2  5A                 PHY
00308Ar 2  98                 TYA
00308Br 2  18                 CLC
00308Cr 2  69 03              ADC   #3
00308Er 2  A8                 TAY
00308Fr 2  B1 rr              LDA   (ptr_lo),Y             ; record char
003091r 2  7A                 PLY
003092r 2  C5 rr              CMP   proc_rec_off
003094r 2  D0 07              BNE   @ecmp_ne
003096r 2  FA                 PLX
003097r 2  C8                 INY
003098r 2  CA                 DEX
003099r 2  D0 D6              BNE   @ecmp
00309Br 2  80 0E              BRA   @erase_match
00309Dr 2               
00309Dr 2               @ecmp_ne:
00309Dr 2  FA                 PLX
00309Er 2               
00309Er 2               @erase_next:
00309Er 2                     ; prev = &current->next (proc_entry + 0)
00309Er 2  A5 rr              LDA   proc_entry_lo
0030A0r 2  85 rr              STA   proc_ptr_lo
0030A2r 2  A5 rr              LDA   proc_entry_hi
0030A4r 2  85 rr              STA   proc_ptr_hi
0030A6r 2                     ; current = current->next
0030A6r 2  20 rr rr           JSR   proc_next
0030A9r 2  80 9A              BRA   @walk
0030ABr 2               
0030ABr 2               @erase_match:
0030ABr 2                     ; Unlink: prev->next = current->next  (read current->next once)
0030ABr 2  A5 rr              LDA   proc_entry_lo
0030ADr 2  85 rr              STA   ptr_lo
0030AFr 2  A5 rr              LDA   proc_entry_hi
0030B1r 2  85 rr              STA   ptr_hi
0030B3r 2  A0 00              LDY   #0
0030B5r 2  B1 rr              LDA   (ptr_lo),Y             ; next_lo -> X
0030B7r 2  AA                 TAX
0030B8r 2  C8                 INY
0030B9r 2  B1 rr              LDA   (ptr_lo),Y             ; next_hi -> stack
0030BBr 2  48                 PHA
0030BCr 2  A5 rr              LDA   proc_ptr_lo            ; ptr = prev
0030BEr 2  85 rr              STA   ptr_lo
0030C0r 2  A5 rr              LDA   proc_ptr_hi
0030C2r 2  85 rr              STA   ptr_hi
0030C4r 2  A0 00              LDY   #0
0030C6r 2  8A                 TXA
0030C7r 2  91 rr              STA   (ptr_lo),Y             ; prev->next_lo = next_lo
0030C9r 2  C8                 INY
0030CAr 2  68                 PLA
0030CBr 2  91 rr              STA   (ptr_lo),Y             ; prev->next_hi = next_hi
0030CDr 2               
0030CDr 2  4C rr rr           JMP   eval_continue
0030D0r 2               
0030D0r 2               @not_found:
0030D0r 2  A2 rr              LDX   #<str_idk
0030D2r 2  A0 rr              LDY   #>str_idk
0030D4r 2  4C rr rr           JMP   list_print_err
0030D7r 2               @err:
0030D7r 2  A2 rr              LDX   #<str_erase_name
0030D9r 2  A0 rr              LDY   #>str_erase_name
0030DBr 2  4C rr rr           JMP   err_nei
0030DEr 2               
0030DEr 2               ; ---------------------------------------------------------------------
0030DEr 2               ; do_apply — APPLY "proc [args]: call procedure with args from list
0030DEr 2               ;   Arity 0 — evaluates its own arguments
0030DEr 2               ;   Strategy: build "name arg1 arg2 ..." in input_buf, tokenize+eval.
0030DEr 2               ; ---------------------------------------------------------------------
0030DEr 2               do_apply:
0030DEr 2                     ; Evaluate first arg: procedure name (quoted word)
0030DEr 2  20 rr rr           JSR   eval_expr
0030E1r 2  90 03              BCC   @ap_type_ok
0030E3r 2  4C rr rr           JMP   @err
0030E6r 2               @ap_type_ok:
0030E6r 2  A5 rr              LDA   eval_type
0030E8r 2  C9 01              CMP   #VAL_WORD
0030EAr 2  F0 03              BEQ   @ap_word_ok
0030ECr 2  4C rr rr           JMP   @err
0030EFr 2               @ap_word_ok:
0030EFr 2               
0030EFr 2                     ; Copy proc name to input_buf
0030EFr 2  A5 rr              LDA   eval_val_lo
0030F1r 2  85 rr              STA   ptr_lo
0030F3r 2  A5 rr              LDA   eval_val_hi
0030F5r 2  85 rr              STA   ptr_hi
0030F7r 2  64 rr              STZ   z:buf_idx
0030F9r 2  A0 00              LDY   #0
0030FBr 2  B1 rr              LDA   (ptr_lo),Y             ; name length
0030FDr 2  AA                 TAX
0030FEr 2  F0 10              BEQ   @apply_args
003100r 2  C8                 INY
003101r 2               @apply_name:
003101r 2  B1 rr              LDA   (ptr_lo),Y
003103r 2  5A                 PHY
003104r 2  A4 rr              LDY   z:buf_idx
003106r 2  99 rr rr           STA   input_buf,Y
003109r 2  E6 rr              INC   z:buf_idx
00310Br 2  7A                 PLY
00310Cr 2  C8                 INY
00310Dr 2  CA                 DEX
00310Er 2  D0 F1              BNE   @apply_name
003110r 2               
003110r 2               @apply_args:
003110r 2                     ; Evaluate second arg: list of arguments
003110r 2  20 rr rr           JSR   eval_expr
003113r 2  B0 5B              BCS   @err
003115r 2  A5 rr              LDA   eval_type
003117r 2  C9 02              CMP   #VAL_LIST
003119r 2  D0 55              BNE   @err
00311Br 2               
00311Br 2                     ; Render list elements to input_buf (after name)
00311Br 2                     ; eval_val_lo/hi = list head
00311Br 2  A5 rr              LDA   eval_val_lo
00311Dr 2  05 rr              ORA   eval_val_hi
00311Fr 2  F0 11              BEQ   @apply_run              ; empty arg list, just run name
003121r 2               
003121r 2                     ; Use render_list_to_buf — it prepends space before elements
003121r 2                     ; but we need a space before the first arg too
003121r 2  A5 rr              LDA   z:buf_idx
003123r 2  C9 7E              CMP   #126
003125r 2  B0 0B              BCS   @apply_run
003127r 2  A8                 TAY
003128r 2  A9 20              LDA   #' '
00312Ar 2  99 rr rr           STA   input_buf,Y
00312Dr 2  E6 rr              INC   z:buf_idx
00312Fr 2               
00312Fr 2                     ; render_list_to_buf expects eval_val set
00312Fr 2  20 rr rr           JSR   render_list_to_buf
003132r 2               
003132r 2               @apply_run:
003132r 2                     ; Null-terminate
003132r 2  A6 rr              LDX   z:buf_idx
003134r 2  9E rr rr           STZ   input_buf,X
003137r 2               
003137r 2                     ; Save eval state and tokenize+eval (same pattern as do_run)
003137r 2  A5 rr              LDA   eval_cur_lo
003139r 2  48                 PHA
00313Ar 2  A5 rr              LDA   eval_cur_hi
00313Cr 2  48                 PHA
00313Dr 2  A5 rr              LDA   tok_head_lo
00313Fr 2  48                 PHA
003140r 2  A5 rr              LDA   tok_head_hi
003142r 2  48                 PHA
003143r 2  A5 rr              LDA   tok_tail_lo
003145r 2  48                 PHA
003146r 2  A5 rr              LDA   tok_tail_hi
003148r 2  48                 PHA
003149r 2  A5 rr              LDA   eval_in_body
00314Br 2  48                 PHA
00314Cr 2  A5 rr              LDA   eval_reporter
00314Er 2  48                 PHA
00314Fr 2               
00314Fr 2  20 rr rr           JSR   tokenize_line
003152r 2  20 rr rr           JSR   eval_line
003155r 2               
003155r 2  68                 PLA
003156r 2  85 rr              STA   eval_reporter
003158r 2  68                 PLA
003159r 2  85 rr              STA   eval_in_body
00315Br 2  68                 PLA
00315Cr 2  85 rr              STA   tok_tail_hi
00315Er 2  68                 PLA
00315Fr 2  85 rr              STA   tok_tail_lo
003161r 2  68                 PLA
003162r 2  85 rr              STA   tok_head_hi
003164r 2  68                 PLA
003165r 2  85 rr              STA   tok_head_lo
003167r 2  68                 PLA
003168r 2  85 rr              STA   eval_cur_hi
00316Ar 2  68                 PLA
00316Br 2  85 rr              STA   eval_cur_lo
00316Dr 2               
00316Dr 2  4C rr rr           JMP   eval_continue
003170r 2               
003170r 2               @err:
003170r 2  A2 rr              LDX   #<str_apply_name
003172r 2  A0 rr              LDY   #>str_apply_name
003174r 2  4C rr rr           JMP   err_nei
003177r 2               
003177r 2               ; =====================================================================
003177r 2               ; RODATA — procedure strings
003177r 2               ; =====================================================================
003177r 2                     .segment "RODATA"
00061Er 2               
00061Er 2               
00061Er 2               
00061Er 2               
00061Er 2               ; Builtin name strings for workspace commands
00061Er 2               str_po_name:
00061Er 2  02 50 4F           .byte 2, "PO"
000621r 2               str_printout_name:
000621r 2  08 50 52 49        .byte 8, "PRINTOUT"
000625r 2  4E 54 4F 55  
000629r 2  54           
00062Ar 2               str_pots_name:
00062Ar 2  04 50 4F 54        .byte 4, "POTS"
00062Er 2  53           
00062Fr 2               str_printtitles_name:
00062Fr 2  0B 50 52 49        .byte 11, "PRINTTITLES"
000633r 2  4E 54 54 49  
000637r 2  54 4C 45 53  
00063Br 2               str_erase_name:
00063Br 2  05 45 52 41        .byte 5, "ERASE"
00063Fr 2  53 45        
000641r 2               str_apply_name:
000641r 2  05 41 50 50        .byte 5, "APPLY"
000645r 2  4C 59        
000647r 2               
000647r 1                     .include "gc.s"
000647r 2               ; gc.s — mark-sweep garbage collector for NovaLogo
000647r 2               ;
000647r 2               ; Allocation header (prepended by heap_alloc):
000647r 2               ;   +0: alloc_tag  (bit 7 = mark, bits 6-0 = type)
000647r 2               ;   +1: alloc_size (total size including header; 0 = use 16-bit size at +2/+3)
000647r 2               ;
000647r 2               ; Type constants (bits 6-0 of alloc_tag):
000647r 2               ATYPE_FREE   = $00
000647r 2               ATYPE_TOKEN  = $01
000647r 2               ATYPE_CONS   = $02
000647r 2               ATYPE_VAR    = $03
000647r 2               ATYPE_PROC   = $04
000647r 2               ATYPE_STRING = $05
000647r 2               
000647r 2               ; Header layout offsets (relative to allocation base, NOT payload)
000647r 2               GC_HDR_TAG   = 0
000647r 2               GC_HDR_SIZE  = 1
000647r 2               GC_HDR_BYTES = 2              ; overhead per allocation
000647r 2               
000647r 2               ; Mark bit
000647r 2               ALLOC_MARK_BIT = $80
000647r 2               
000647r 2               ; =====================================================================
000647r 2               ; ZEROPAGE segment — GC variables
000647r 2               ; =====================================================================
000647r 2                     .segment "ZEROPAGE"
000048r 2               
000048r 2  xx           gc_ptr_lo:    .res 1          ; GC walk pointer low
000049r 2  xx           gc_ptr_hi:    .res 1          ; GC walk pointer high
00004Ar 2  xx           gc_tmp_lo:    .res 1          ; GC temp low
00004Br 2  xx           gc_tmp_hi:    .res 1          ; GC temp high
00004Cr 2  xx           gc_mark_lo:   .res 1          ; node-to-mark pointer low
00004Dr 2  xx           gc_mark_hi:   .res 1          ; node-to-mark pointer high
00004Er 2               
00004Er 2               ; =====================================================================
00004Er 2               ; CODE segment — GC routines
00004Er 2               ; =====================================================================
00004Er 2                     .segment "CODE"
003177r 2               
003177r 2               ; ---------------------------------------------------------------------
003177r 2               ; gc_collect — run a full mark-sweep garbage collection cycle
003177r 2               ;   1. Clear all mark bits
003177r 2               ;   2. Mark all reachable objects from roots
003177r 2               ;   3. Sweep: coalesce all unmarked blocks and reset heap_ptr
003177r 2               ;
003177r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_tmp, gc_mark, ptr_lo/hi, ptr2_lo/hi
003177r 2               ; ---------------------------------------------------------------------
003177r 2               gc_collect:
003177r 2                     ; Phase 1: Clear all mark bits by walking the heap linearly
003177r 2  A9 00              LDA   #<HEAP_START
003179r 2  85 rr              STA   gc_ptr_lo
00317Br 2  A9 05              LDA   #>HEAP_START
00317Dr 2  85 rr              STA   gc_ptr_hi
00317Fr 2               
00317Fr 2               @clear_loop:
00317Fr 2                     ; Have we reached heap_ptr (end of allocated space)?
00317Fr 2  A5 rr              LDA   gc_ptr_hi
003181r 2  C5 rr              CMP   heap_ptr+1
003183r 2  90 08              BCC   @clear_one
003185r 2  D0 41              BNE   @clear_done
003187r 2  A5 rr              LDA   gc_ptr_lo
003189r 2  C5 rr              CMP   heap_ptr
00318Br 2  B0 3B              BCS   @clear_done
00318Dr 2               
00318Dr 2               @clear_one:
00318Dr 2                     ; Clear mark bit on this allocation
00318Dr 2  A5 rr              LDA   gc_ptr_lo
00318Fr 2  85 rr              STA   ptr_lo
003191r 2  A5 rr              LDA   gc_ptr_hi
003193r 2  85 rr              STA   ptr_hi
003195r 2  A0 00              LDY   #GC_HDR_TAG
003197r 2  B1 rr              LDA   (ptr_lo),Y
003199r 2  29 7F              AND   #<~ALLOC_MARK_BIT    ; clear bit 7
00319Br 2  91 rr              STA   (ptr_lo),Y
00319Dr 2               
00319Dr 2                     ; Advance by alloc_size
00319Dr 2  A0 01              LDY   #GC_HDR_SIZE
00319Fr 2  B1 rr              LDA   (ptr_lo),Y
0031A1r 2  F0 0B              BEQ   @clear_big           ; size=0 means 16-bit size at +2/+3
0031A3r 2  18                 CLC
0031A4r 2  65 rr              ADC   gc_ptr_lo
0031A6r 2  85 rr              STA   gc_ptr_lo
0031A8r 2  90 D5              BCC   @clear_loop
0031AAr 2  E6 rr              INC   gc_ptr_hi
0031ACr 2  80 D1              BRA   @clear_loop
0031AEr 2               
0031AEr 2               @clear_big:
0031AEr 2                     ; 16-bit size at payload offset 0 and 1 (header +2 and +3)
0031AEr 2  A0 02              LDY   #GC_HDR_BYTES
0031B0r 2  B1 rr              LDA   (ptr_lo),Y
0031B2r 2  85 rr              STA   gc_tmp_lo
0031B4r 2  C8                 INY
0031B5r 2  B1 rr              LDA   (ptr_lo),Y
0031B7r 2  85 rr              STA   gc_tmp_hi
0031B9r 2  18                 CLC
0031BAr 2  A5 rr              LDA   gc_ptr_lo
0031BCr 2  65 rr              ADC   gc_tmp_lo
0031BEr 2  85 rr              STA   gc_ptr_lo
0031C0r 2  A5 rr              LDA   gc_ptr_hi
0031C2r 2  65 rr              ADC   gc_tmp_hi
0031C4r 2  85 rr              STA   gc_ptr_hi
0031C6r 2  80 B7              BRA   @clear_loop
0031C8r 2               
0031C8r 2               @clear_done:
0031C8r 2               
0031C8r 2                     ; Phase 2: Mark all reachable objects
0031C8r 2                     ; Root 1: variable list (var_head)
0031C8r 2  20 rr rr           JSR   gc_mark_vars
0031CBr 2               
0031CBr 2                     ; Root 2: procedure list (proc_head)
0031CBr 2  20 rr rr           JSR   gc_mark_procs
0031CEr 2               
0031CEr 2                     ; Root 3: current token list (tok_head)
0031CEr 2  20 rr rr           JSR   gc_mark_token_list
0031D1r 2               
0031D1r 2                     ; Phase 3: Sweep — find the highest marked allocation,
0031D1r 2                     ; reset heap_ptr to just past it. This works because we
0031D1r 2                     ; use a bump allocator with no free list; all unmarked
0031D1r 2                     ; allocations between marked ones become wasted space,
0031D1r 2                     ; but in practice the permanent objects (vars, procs) are
0031D1r 2                     ; allocated early and the ephemeral ones (tokens, cons,
0031D1r 2                     ; strings) are allocated later and all unmarked — so
0031D1r 2                     ; heap_ptr shrinks back dramatically.
0031D1r 2                     ;
0031D1r 2                     ; Walk the heap forward; track the highest end-address
0031D1r 2                     ; of any marked allocation.
0031D1r 2  A9 00              LDA   #<HEAP_START
0031D3r 2  85 rr              STA   gc_ptr_lo
0031D5r 2  A9 05              LDA   #>HEAP_START
0031D7r 2  85 rr              STA   gc_ptr_hi
0031D9r 2                     ; gc_tmp = highest marked end (start at HEAP_START = nothing marked)
0031D9r 2  A9 00              LDA   #<HEAP_START
0031DBr 2  85 rr              STA   gc_tmp_lo
0031DDr 2  A9 05              LDA   #>HEAP_START
0031DFr 2  85 rr              STA   gc_tmp_hi
0031E1r 2               
0031E1r 2               @sweep_loop:
0031E1r 2                     ; Reached end of allocated space?
0031E1r 2  A5 rr              LDA   gc_ptr_hi
0031E3r 2  C5 rr              CMP   heap_ptr+1
0031E5r 2  90 08              BCC   @sweep_one
0031E7r 2  D0 49              BNE   @sweep_done
0031E9r 2  A5 rr              LDA   gc_ptr_lo
0031EBr 2  C5 rr              CMP   heap_ptr
0031EDr 2  B0 43              BCS   @sweep_done
0031EFr 2               
0031EFr 2               @sweep_one:
0031EFr 2  A5 rr              LDA   gc_ptr_lo
0031F1r 2  85 rr              STA   ptr_lo
0031F3r 2  A5 rr              LDA   gc_ptr_hi
0031F5r 2  85 rr              STA   ptr_hi
0031F7r 2               
0031F7r 2                     ; Get size of this allocation
0031F7r 2  A0 01              LDY   #GC_HDR_SIZE
0031F9r 2  B1 rr              LDA   (ptr_lo),Y
0031FBr 2  F0 06              BEQ   @sweep_big
0031FDr 2  85 rr              STA   gc_mark_lo            ; use gc_mark_lo as temp for size
0031FFr 2  64 rr              STZ   gc_mark_hi
003201r 2  80 0B              BRA   @sweep_check_mark
003203r 2               
003203r 2               @sweep_big:
003203r 2  A0 02              LDY   #GC_HDR_BYTES
003205r 2  B1 rr              LDA   (ptr_lo),Y
003207r 2  85 rr              STA   gc_mark_lo
003209r 2  C8                 INY
00320Ar 2  B1 rr              LDA   (ptr_lo),Y
00320Cr 2  85 rr              STA   gc_mark_hi
00320Er 2               
00320Er 2               @sweep_check_mark:
00320Er 2                     ; Is this allocation marked?
00320Er 2  A0 00              LDY   #GC_HDR_TAG
003210r 2  B1 rr              LDA   (ptr_lo),Y
003212r 2  29 80              AND   #ALLOC_MARK_BIT
003214r 2  F0 0D              BEQ   @sweep_advance        ; not marked — skip
003216r 2               
003216r 2                     ; Marked — compute end address = gc_ptr + size
003216r 2  18                 CLC
003217r 2  A5 rr              LDA   gc_ptr_lo
003219r 2  65 rr              ADC   gc_mark_lo
00321Br 2  85 rr              STA   gc_tmp_lo             ; update highest end
00321Dr 2  A5 rr              LDA   gc_ptr_hi
00321Fr 2  65 rr              ADC   gc_mark_hi
003221r 2  85 rr              STA   gc_tmp_hi
003223r 2               
003223r 2               @sweep_advance:
003223r 2                     ; Advance gc_ptr by size
003223r 2  18                 CLC
003224r 2  A5 rr              LDA   gc_ptr_lo
003226r 2  65 rr              ADC   gc_mark_lo
003228r 2  85 rr              STA   gc_ptr_lo
00322Ar 2  A5 rr              LDA   gc_ptr_hi
00322Cr 2  65 rr              ADC   gc_mark_hi
00322Er 2  85 rr              STA   gc_ptr_hi
003230r 2  80 AF              BRA   @sweep_loop
003232r 2               
003232r 2               @sweep_done:
003232r 2                     ; Set heap_ptr to highest marked end
003232r 2  A5 rr              LDA   gc_tmp_lo
003234r 2  85 rr              STA   heap_ptr
003236r 2  A5 rr              LDA   gc_tmp_hi
003238r 2  85 rr              STA   heap_ptr+1
00323Ar 2  60                 RTS
00323Br 2               
00323Br 2               ; ---------------------------------------------------------------------
00323Br 2               ; gc_mark_node — mark a single allocation given a payload pointer
00323Br 2               ;   Input: gc_mark_lo/hi = pointer to payload (header is at -2)
00323Br 2               ;   If pointer is $0000 or below HEAP_START, skip.
00323Br 2               ;   Clobbers: A, Y (preserves gc_mark_lo/hi)
00323Br 2               ; ---------------------------------------------------------------------
00323Br 2               gc_mark_node:
00323Br 2                     ; Null check
00323Br 2  A5 rr              LDA   gc_mark_lo
00323Dr 2  05 rr              ORA   gc_mark_hi
00323Fr 2  F0 21              BEQ   @done
003241r 2               
003241r 2                     ; Compute header address = payload - 2
003241r 2  A5 rr              LDA   gc_mark_lo
003243r 2  38                 SEC
003244r 2  E9 02              SBC   #GC_HDR_BYTES
003246r 2  85 rr              STA   ptr_lo
003248r 2  A5 rr              LDA   gc_mark_hi
00324Ar 2  E9 00              SBC   #0
00324Cr 2  85 rr              STA   ptr_hi
00324Er 2               
00324Er 2                     ; Range check: must be >= HEAP_START
00324Er 2  C9 05              CMP   #>HEAP_START
003250r 2  90 10              BCC   @done
003252r 2  D0 06              BNE   @in_range
003254r 2  A5 rr              LDA   ptr_lo
003256r 2  C9 00              CMP   #<HEAP_START
003258r 2  90 08              BCC   @done
00325Ar 2               @in_range:
00325Ar 2               
00325Ar 2                     ; Set mark bit
00325Ar 2  A0 00              LDY   #GC_HDR_TAG
00325Cr 2  B1 rr              LDA   (ptr_lo),Y
00325Er 2  09 80              ORA   #ALLOC_MARK_BIT
003260r 2  91 rr              STA   (ptr_lo),Y
003262r 2               @done:
003262r 2  60                 RTS
003263r 2               
003263r 2               ; ---------------------------------------------------------------------
003263r 2               ; gc_mark_vars — walk the variable linked list and mark each entry
003263r 2               ;   Also marks any list values pointed to by variables.
003263r 2               ;   Clobbers: A, X, Y, gc_ptr, gc_mark, ptr_lo/hi, ptr2_lo/hi
003263r 2               ; ---------------------------------------------------------------------
003263r 2               gc_mark_vars:
003263r 2  A5 rr              LDA   var_head_lo
003265r 2  85 rr              STA   gc_ptr_lo
003267r 2  A5 rr              LDA   var_head_hi
003269r 2  85 rr              STA   gc_ptr_hi
00326Br 2               
00326Br 2               @walk:
00326Br 2  A5 rr              LDA   gc_ptr_lo
00326Dr 2  05 rr              ORA   gc_ptr_hi
00326Fr 2  D0 01              BNE   @have_var
003271r 2  60                 RTS
003272r 2               @have_var:
003272r 2               
003272r 2                     ; Mark this var entry
003272r 2  A5 rr              LDA   gc_ptr_lo
003274r 2  85 rr              STA   gc_mark_lo
003276r 2  A5 rr              LDA   gc_ptr_hi
003278r 2  85 rr              STA   gc_mark_hi
00327Ar 2  20 rr rr           JSR   gc_mark_node
00327Dr 2               
00327Dr 2                     ; Read the variable's value — if it's a list, mark the list
00327Dr 2  A5 rr              LDA   gc_ptr_lo
00327Fr 2  85 rr              STA   ptr_lo
003281r 2  A5 rr              LDA   gc_ptr_hi
003283r 2  85 rr              STA   ptr_hi
003285r 2  A0 02              LDY   #VAR_NAME_LEN
003287r 2  B1 rr              LDA   (ptr_lo),Y           ; name_len
003289r 2  18                 CLC
00328Ar 2  69 03              ADC   #VAR_NAME             ; offset to value_type
00328Cr 2  A8                 TAY
00328Dr 2  B1 rr              LDA   (ptr_lo),Y           ; value_type
00328Fr 2  C9 02              CMP   #VAL_LIST
003291r 2  D0 23              BNE   @var_check_word
003293r 2                     ; It's a list — get the list head pointer and mark the list
003293r 2  C8                 INY
003294r 2  B1 rr              LDA   (ptr_lo),Y           ; val_hi (actually car_hi)
003296r 2  85 rr              STA   gc_tmp_hi
003298r 2  C8                 INY
003299r 2  B1 rr              LDA   (ptr_lo),Y           ; val_lo
00329Br 2  85 rr              STA   gc_tmp_lo
00329Dr 2                     ; Save gc_ptr across recursive mark
00329Dr 2  A5 rr              LDA   gc_ptr_lo
00329Fr 2  48                 PHA
0032A0r 2  A5 rr              LDA   gc_ptr_hi
0032A2r 2  48                 PHA
0032A3r 2  A5 rr              LDA   gc_tmp_lo
0032A5r 2  85 rr              STA   gc_mark_lo
0032A7r 2  A5 rr              LDA   gc_tmp_hi
0032A9r 2  85 rr              STA   gc_mark_hi
0032ABr 2  20 rr rr           JSR   gc_mark_list
0032AEr 2  68                 PLA
0032AFr 2  85 rr              STA   gc_ptr_hi
0032B1r 2  68                 PLA
0032B2r 2  85 rr              STA   gc_ptr_lo
0032B4r 2  80 25              BRA   @var_next
0032B6r 2               
0032B6r 2               @var_check_word:
0032B6r 2  C9 01              CMP   #VAL_WORD
0032B8r 2  D0 21              BNE   @var_next
0032BAr 2                     ; It's a word — mark the string allocation
0032BAr 2  C8                 INY
0032BBr 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_hi for word
0032BDr 2  85 rr              STA   gc_tmp_hi
0032BFr 2  C8                 INY
0032C0r 2  B1 rr              LDA   (ptr_lo),Y           ; ptr_lo for word
0032C2r 2  85 rr              STA   gc_tmp_lo
0032C4r 2  A5 rr              LDA   gc_ptr_lo
0032C6r 2  48                 PHA
0032C7r 2  A5 rr              LDA   gc_ptr_hi
0032C9r 2  48                 PHA
0032CAr 2  A5 rr              LDA   gc_tmp_lo
0032CCr 2  85 rr              STA   gc_mark_lo
0032CEr 2  A5 rr              LDA   gc_tmp_hi
0032D0r 2  85 rr              STA   gc_mark_hi
0032D2r 2  20 rr rr           JSR   gc_mark_node
0032D5r 2  68                 PLA
0032D6r 2  85 rr              STA   gc_ptr_hi
0032D8r 2  68                 PLA
0032D9r 2  85 rr              STA   gc_ptr_lo
0032DBr 2               
0032DBr 2               @var_next:
0032DBr 2                     ; Follow next pointer
0032DBr 2  A5 rr              LDA   gc_ptr_lo
0032DDr 2  85 rr              STA   ptr_lo
0032DFr 2  A5 rr              LDA   gc_ptr_hi
0032E1r 2  85 rr              STA   ptr_hi
0032E3r 2  A0 00              LDY   #VAR_NEXT_LO
0032E5r 2  B1 rr              LDA   (ptr_lo),Y
0032E7r 2  AA                 TAX
0032E8r 2  C8                 INY
0032E9r 2  B1 rr              LDA   (ptr_lo),Y
0032EBr 2  85 rr              STA   gc_ptr_hi
0032EDr 2  86 rr              STX   gc_ptr_lo
0032EFr 2  4C rr rr           JMP   @walk
0032F2r 2               
0032F2r 2               ; ---------------------------------------------------------------------
0032F2r 2               ; gc_mark_procs — walk the procedure list and mark each record
0032F2r 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
0032F2r 2               ; ---------------------------------------------------------------------
0032F2r 2               gc_mark_procs:
0032F2r 2  A5 rr              LDA   proc_head_lo
0032F4r 2  85 rr              STA   gc_ptr_lo
0032F6r 2  A5 rr              LDA   proc_head_hi
0032F8r 2  85 rr              STA   gc_ptr_hi
0032FAr 2               
0032FAr 2               @walk:
0032FAr 2  A5 rr              LDA   gc_ptr_lo
0032FCr 2  05 rr              ORA   gc_ptr_hi
0032FEr 2  F0 2B              BEQ   @done
003300r 2               
003300r 2                     ; Mark this procedure record.
003300r 2                     ; proc_entry points to record data (base+4); header is at base+0.
003300r 2                     ; Subtract 4 to get the header address for marking.
003300r 2  A5 rr              LDA   gc_ptr_lo
003302r 2  38                 SEC
003303r 2  E9 04              SBC   #4
003305r 2  85 rr              STA   ptr_lo
003307r 2  A5 rr              LDA   gc_ptr_hi
003309r 2  E9 00              SBC   #0
00330Br 2  85 rr              STA   ptr_hi
00330Dr 2                     ; Set mark bit directly at the header
00330Dr 2  A0 00              LDY   #GC_HDR_TAG
00330Fr 2  B1 rr              LDA   (ptr_lo),Y
003311r 2  09 80              ORA   #ALLOC_MARK_BIT
003313r 2  91 rr              STA   (ptr_lo),Y
003315r 2               
003315r 2                     ; Follow next pointer (at record data offset 0)
003315r 2  A5 rr              LDA   gc_ptr_lo
003317r 2  85 rr              STA   ptr_lo
003319r 2  A5 rr              LDA   gc_ptr_hi
00331Br 2  85 rr              STA   ptr_hi
00331Dr 2  A0 00              LDY   #0                    ; next_lo at offset 0
00331Fr 2  B1 rr              LDA   (ptr_lo),Y
003321r 2  AA                 TAX
003322r 2  C8                 INY
003323r 2  B1 rr              LDA   (ptr_lo),Y
003325r 2  85 rr              STA   gc_ptr_hi
003327r 2  86 rr              STX   gc_ptr_lo
003329r 2  80 CF              BRA   @walk
00332Br 2               
00332Br 2               @done:
00332Br 2  60                 RTS
00332Cr 2               
00332Cr 2               ; ---------------------------------------------------------------------
00332Cr 2               ; gc_mark_token_list — walk tok_head linked list and mark each token
00332Cr 2               ;   Clobbers: A, Y, gc_ptr, gc_mark, ptr_lo/hi
00332Cr 2               ; ---------------------------------------------------------------------
00332Cr 2               gc_mark_token_list:
00332Cr 2  A5 rr              LDA   tok_head_lo
00332Er 2  85 rr              STA   gc_ptr_lo
003330r 2  A5 rr              LDA   tok_head_hi
003332r 2  85 rr              STA   gc_ptr_hi
003334r 2               
003334r 2               @walk:
003334r 2  A5 rr              LDA   gc_ptr_lo
003336r 2  05 rr              ORA   gc_ptr_hi
003338r 2  F0 21              BEQ   @done
00333Ar 2               
00333Ar 2                     ; Mark this token
00333Ar 2  A5 rr              LDA   gc_ptr_lo
00333Cr 2  85 rr              STA   gc_mark_lo
00333Er 2  A5 rr              LDA   gc_ptr_hi
003340r 2  85 rr              STA   gc_mark_hi
003342r 2  20 rr rr           JSR   gc_mark_node
003345r 2               
003345r 2                     ; Follow next pointer (at payload offsets TOK_NEXT_LO/HI)
003345r 2  A5 rr              LDA   gc_ptr_lo
003347r 2  85 rr              STA   ptr_lo
003349r 2  A5 rr              LDA   gc_ptr_hi
00334Br 2  85 rr              STA   ptr_hi
00334Dr 2  A0 01              LDY   #TOK_NEXT_LO
00334Fr 2  B1 rr              LDA   (ptr_lo),Y
003351r 2  AA                 TAX
003352r 2  C8                 INY
003353r 2  B1 rr              LDA   (ptr_lo),Y
003355r 2  85 rr              STA   gc_ptr_hi
003357r 2  86 rr              STX   gc_ptr_lo
003359r 2  80 D9              BRA   @walk
00335Br 2               
00335Br 2               @done:
00335Br 2  60                 RTS
00335Cr 2               
00335Cr 2               ; ---------------------------------------------------------------------
00335Cr 2               ; gc_mark_list — recursively mark a cons-pair list
00335Cr 2               ;   Input: gc_mark_lo/hi = head cons pair pointer (payload)
00335Cr 2               ;   Marks each cons cell, and recursively marks sublists and word strings.
00335Cr 2               ;   Clobbers: A, X, Y, gc_mark, gc_ptr, ptr_lo/hi
00335Cr 2               ; ---------------------------------------------------------------------
00335Cr 2               gc_mark_list:
00335Cr 2                     ; Use gc_ptr to walk the list, gc_mark for marking
00335Cr 2  A5 rr              LDA   gc_mark_lo
00335Er 2  85 rr              STA   gc_ptr_lo
003360r 2  A5 rr              LDA   gc_mark_hi
003362r 2  85 rr              STA   gc_ptr_hi
003364r 2               
003364r 2               @walk:
003364r 2  A5 rr              LDA   gc_ptr_lo
003366r 2  05 rr              ORA   gc_ptr_hi
003368r 2  F0 70              BEQ   @done
00336Ar 2               
00336Ar 2                     ; Mark this cons pair
00336Ar 2  A5 rr              LDA   gc_ptr_lo
00336Cr 2  85 rr              STA   gc_mark_lo
00336Er 2  A5 rr              LDA   gc_ptr_hi
003370r 2  85 rr              STA   gc_mark_hi
003372r 2  20 rr rr           JSR   gc_mark_node
003375r 2               
003375r 2                     ; Check car_type: if list, recursively mark sublist
003375r 2                     ; if word, mark the string
003375r 2  A5 rr              LDA   gc_ptr_lo
003377r 2  85 rr              STA   ptr_lo
003379r 2  A5 rr              LDA   gc_ptr_hi
00337Br 2  85 rr              STA   ptr_hi
00337Dr 2  A0 01              LDY   #CONS_CAR_TYPE
00337Fr 2  B1 rr              LDA   (ptr_lo),Y
003381r 2  C9 02              CMP   #VAL_LIST
003383r 2  F0 23              BEQ   @car_list
003385r 2  C9 01              CMP   #VAL_WORD
003387r 2  F0 02              BEQ   @car_word
003389r 2  80 38              BRA   @follow_cdr
00338Br 2               
00338Br 2               @car_word:
00338Br 2                     ; Mark the word string allocation
00338Br 2  A0 03              LDY   #CONS_CAR_LO
00338Dr 2  B1 rr              LDA   (ptr_lo),Y
00338Fr 2  85 rr              STA   gc_mark_lo
003391r 2  A0 02              LDY   #CONS_CAR_HI
003393r 2  B1 rr              LDA   (ptr_lo),Y
003395r 2  85 rr              STA   gc_mark_hi
003397r 2                     ; Save gc_ptr across mark
003397r 2  A5 rr              LDA   gc_ptr_lo
003399r 2  48                 PHA
00339Ar 2  A5 rr              LDA   gc_ptr_hi
00339Cr 2  48                 PHA
00339Dr 2  20 rr rr           JSR   gc_mark_node
0033A0r 2  68                 PLA
0033A1r 2  85 rr              STA   gc_ptr_hi
0033A3r 2  68                 PLA
0033A4r 2  85 rr              STA   gc_ptr_lo
0033A6r 2  80 1B              BRA   @follow_cdr
0033A8r 2               
0033A8r 2               @car_list:
0033A8r 2                     ; Recursively mark the sublist
0033A8r 2  A0 03              LDY   #CONS_CAR_LO
0033AAr 2  B1 rr              LDA   (ptr_lo),Y
0033ACr 2  85 rr              STA   gc_mark_lo
0033AEr 2  A0 02              LDY   #CONS_CAR_HI
0033B0r 2  B1 rr              LDA   (ptr_lo),Y
0033B2r 2  85 rr              STA   gc_mark_hi
0033B4r 2                     ; Save gc_ptr across recursive call
0033B4r 2  A5 rr              LDA   gc_ptr_lo
0033B6r 2  48                 PHA
0033B7r 2  A5 rr              LDA   gc_ptr_hi
0033B9r 2  48                 PHA
0033BAr 2  20 rr rr           JSR   gc_mark_list          ; recursive
0033BDr 2  68                 PLA
0033BEr 2  85 rr              STA   gc_ptr_hi
0033C0r 2  68                 PLA
0033C1r 2  85 rr              STA   gc_ptr_lo
0033C3r 2               
0033C3r 2               @follow_cdr:
0033C3r 2                     ; Follow cdr to next cons pair
0033C3r 2  A5 rr              LDA   gc_ptr_lo
0033C5r 2  85 rr              STA   ptr_lo
0033C7r 2  A5 rr              LDA   gc_ptr_hi
0033C9r 2  85 rr              STA   ptr_hi
0033CBr 2  A0 05              LDY   #CONS_CDR_LO
0033CDr 2  B1 rr              LDA   (ptr_lo),Y
0033CFr 2  AA                 TAX
0033D0r 2  A0 06              LDY   #CONS_CDR_HI
0033D2r 2  B1 rr              LDA   (ptr_lo),Y
0033D4r 2  85 rr              STA   gc_ptr_hi
0033D6r 2  86 rr              STX   gc_ptr_lo
0033D8r 2  80 8A              BRA   @walk
0033DAr 2               
0033DAr 2               @done:
0033DAr 2  60                 RTS
0033DBr 2               
0033DBr 1               
0033DBr 1               ; =====================================================================
0033DBr 1               ; ZEROPAGE segment — interpreter zero-page variables
0033DBr 1               ; =====================================================================
0033DBr 1                     .segment "ZEROPAGE"
00004Er 1               
00004Er 1  xx           buf_idx:      .res 1          ; current position in input_buf
00004Fr 1               
00004Fr 1               ; =====================================================================
00004Fr 1               ; BSS segment — runtime buffers
00004Fr 1               ; =====================================================================
00004Fr 1                     .segment "BSS"
000984r 1               
000984r 1  xx xx xx xx  input_buf:    .res 128        ; input line buffer
000988r 1  xx xx xx xx  
00098Cr 1  xx xx xx xx  
000A04r 1               
000A04r 1               ; =====================================================================
000A04r 1               ; CODE segment — cold start and main loop
000A04r 1               ; =====================================================================
000A04r 1                     .segment "CODE"
0033DBr 1               
0033DBr 1               cold_start:
0033DBr 1                     ; Copy extension ROM trampoline to RAM
0033DBr 1  A2 0D              LDX   #EXT_TRAMP_SIZE-1
0033DDr 1               @copy_tramp:
0033DDr 1  BD rr rr           LDA   ext_tramp_src,X
0033E0r 1  9D 70 02           STA   EXT_TRAMPOLINE,X
0033E3r 1  CA                 DEX
0033E4r 1  10 F7              BPL   @copy_tramp
0033E6r 1               
0033E6r 1                     ; Zero NovaLogo turtle/graphics state ($9F00..$9F1F) so each session starts
0033E6r 1                     ; in a known mode. The extension pins its turtle state here (extension.s
0033E6r 1                     ; TURTLE_STATE_BASE=$9F00); RAM is stale across soft-reboot on HW, and a
0033E6r 1                     ; stale graphics-mode/inited flag breaks auto-switch and re-init.
0033E6r 1  A2 1F              LDX   #$1F
0033E8r 1               @zero_turtle:
0033E8r 1  9E 00 9F           STZ   $9F00,X
0033EBr 1  CA                 DEX
0033ECr 1  10 FA              BPL   @zero_turtle
0033EEr 1               
0033EEr 1  20 rr rr           JSR   heap_init
0033F1r 1  20 rr rr           JSR   var_init
0033F4r 1  20 rr rr           JSR   proc_init
0033F7r 1  64 rr              STZ   catch_active
0033F9r 1  9C 0A A0           STZ   VGC_CURSEN
0033FCr 1  20 rr rr           JSR   print_banner
0033FFr 1  20 rr rr           JSR   print_prompt
003402r 1               
003402r 1               main_loop:
003402r 1  20 rr rr           JSR   read_line
003405r 1  9C 0A A0           STZ   VGC_CURSEN
003408r 1  20 rr rr           JSR   tokenize_line
00340Br 1  20 rr rr           JSR   check_to_command
00340Er 1  B0 03              BCS   @was_to               ; carry set = TO was handled
003410r 1  20 rr rr           JSR   eval_line
003413r 1               @was_to:
003413r 1                     ; Reclaim dead heap objects (tokens, list cells, etc.)
003413r 1  20 rr rr           JSR   gc_collect
003416r 1  20 rr rr           JSR   print_prompt
003419r 1  80 E7              BRA   main_loop
00341Br 1               
00341Br 1               ; ---------------------------------------------------------------------
00341Br 1               ; check_to_command — if the first token is TO / EDIT / ED, handle it as a
00341Br 1               ;   procedure-definition command (TO collects a new proc; EDIT/ED reopen an
00341Br 1               ;   existing one in the editor).
00341Br 1               ;   Output: carry set = handled, carry clear = not a definition command.
00341Br 1               ;   Clobbers: A, Y, ptr_lo/hi, eval_cur
00341Br 1               ; ---------------------------------------------------------------------
00341Br 1               check_to_command:
00341Br 1  A5 rr              LDA   tok_head_lo
00341Dr 1  05 rr              ORA   tok_head_hi
00341Fr 1  F0 5A              BEQ   @not_to
003421r 1               
003421r 1                     ; First token must be TOK_WORD
003421r 1  A5 rr              LDA   tok_head_lo
003423r 1  85 rr              STA   ptr_lo
003425r 1  A5 rr              LDA   tok_head_hi
003427r 1  85 rr              STA   ptr_hi
003429r 1  A0 00              LDY   #TOK_TAG
00342Br 1  B1 rr              LDA   (ptr_lo),Y
00342Dr 1  C9 01              CMP   #TOK_WORD
00342Fr 1  D0 4A              BNE   @not_to
003431r 1               
003431r 1  A0 03              LDY   #TOK_PAYLOAD
003433r 1  B1 rr              LDA   (ptr_lo),Y           ; word length
003435r 1  C9 02              CMP   #2
003437r 1  F0 06              BEQ   @len2
003439r 1  C9 04              CMP   #4
00343Br 1  F0 19              BEQ   @len4
00343Dr 1  80 3C              BRA   @not_to
00343Fr 1               
00343Fr 1               @len2:
00343Fr 1  A0 04              LDY   #TOK_PAYLOAD+1
003441r 1  B1 rr              LDA   (ptr_lo),Y
003443r 1  C9 54              CMP   #'T'
003445r 1  D0 34              BNE   @not_to
003447r 1  C8                 INY
003448r 1  B1 rr              LDA   (ptr_lo),Y
00344Ar 1  C9 4F              CMP   #'O'
00344Cr 1  D0 2D              BNE   @not_to
00344Er 1                     ; "TO" — collect a new procedure
00344Er 1  20 rr rr           JSR   @set_cur
003451r 1  20 rr rr           JSR   proc_collect
003454r 1  38                 SEC
003455r 1  60                 RTS
003456r 1               @len4:
003456r 1  A0 04              LDY   #TOK_PAYLOAD+1
003458r 1  B1 rr              LDA   (ptr_lo),Y
00345Ar 1  C9 45              CMP   #'E'
00345Cr 1  D0 1D              BNE   @not_to
00345Er 1  C8                 INY
00345Fr 1  B1 rr              LDA   (ptr_lo),Y
003461r 1  C9 44              CMP   #'D'
003463r 1  D0 16              BNE   @not_to
003465r 1  C8                 INY
003466r 1  B1 rr              LDA   (ptr_lo),Y
003468r 1  C9 49              CMP   #'I'
00346Ar 1  D0 0F              BNE   @not_to
00346Cr 1  C8                 INY
00346Dr 1  B1 rr              LDA   (ptr_lo),Y
00346Fr 1  C9 54              CMP   #'T'
003471r 1  D0 08              BNE   @not_to
003473r 1                     ; "EDIT" — edit
003473r 1  20 rr rr           JSR   @set_cur
003476r 1  20 rr rr           JSR   proc_edit
003479r 1  38                 SEC
00347Ar 1  60                 RTS
00347Br 1               
00347Br 1               @not_to:
00347Br 1  18                 CLC
00347Cr 1  60                 RTS
00347Dr 1               
00347Dr 1               @set_cur:
00347Dr 1                     ; eval_cur = first token, then advance past it to the name token
00347Dr 1  A5 rr              LDA   tok_head_lo
00347Fr 1  85 rr              STA   eval_cur_lo
003481r 1  A5 rr              LDA   tok_head_hi
003483r 1  85 rr              STA   eval_cur_hi
003485r 1  4C rr rr           JMP   eval_advance         ; ends with RTS
003488r 1               
003488r 1               ; ---------------------------------------------------------------------
003488r 1               ; read_line — read a line of input into input_buf, null-terminated
003488r 1               ;   On return: input_buf contains the line, buf_idx = length
003488r 1               ; ---------------------------------------------------------------------
003488r 1               read_line:
003488r 1  64 rr              STZ   buf_idx            ; reset buffer index to 0
00348Ar 1  A9 01              LDA   #$01
00348Cr 1  8D 0A A0           STA   VGC_CURSEN
00348Fr 1               
00348Fr 1               @poll:
00348Fr 1  AD 0F A0           LDA   VGC_CHARIN         ; poll keyboard
003492r 1  F0 FB              BEQ   @poll              ; no key waiting — spin
003494r 1               
003494r 1                     ; --- handle CR ($0D) ---
003494r 1  C9 0D              CMP   #$0D
003496r 1  D0 39              BNE   @not_cr
003498r 1                     ; End of a typed line. If brackets/parens are still open, keep reading so
003498r 1                     ; a multi-line statement can be entered right at the prompt.
003498r 1  20 rr rr           JSR   line_bracket_depth
00349Br 1  F0 24              BEQ   @cr_finish
00349Dr 1  A6 rr              LDX   buf_idx
00349Fr 1  E0 78              CPX   #120
0034A1r 1  B0 1E              BCS   @cr_finish         ; buffer nearly full — stop accumulating
0034A3r 1  A9 0A              LDA   #$0A               ; newline separator (tokenizer treats it as space)
0034A5r 1  9D rr rr           STA   input_buf,X
0034A8r 1  E6 rr              INC   buf_idx
0034AAr 1  A9 0D              LDA   #$0D
0034ACr 1  8D 0E A0           STA   VGC_CHAROUT
0034AFr 1  A9 0A              LDA   #$0A
0034B1r 1  8D 0E A0           STA   VGC_CHAROUT
0034B4r 1  A9 7E              LDA   #'~'               ; continuation prompt
0034B6r 1  8D 0E A0           STA   VGC_CHAROUT
0034B9r 1  A9 20              LDA   #' '
0034BBr 1  8D 0E A0           STA   VGC_CHAROUT
0034BEr 1  4C rr rr           JMP   @poll
0034C1r 1               @cr_finish:
0034C1r 1  A6 rr              LDX   buf_idx
0034C3r 1  9E rr rr           STZ   input_buf,X        ; null-terminate
0034C6r 1  A9 0D              LDA   #$0D
0034C8r 1  8D 0E A0           STA   VGC_CHAROUT        ; carriage return
0034CBr 1  A9 0A              LDA   #$0A
0034CDr 1  8D 0E A0           STA   VGC_CHAROUT        ; line feed
0034D0r 1  60                 RTS
0034D1r 1               
0034D1r 1               @not_cr:
0034D1r 1                     ; --- handle backspace ($08, $14, $7F) ---
0034D1r 1  C9 08              CMP   #$08
0034D3r 1  F0 18              BEQ   @backspace
0034D5r 1  C9 14              CMP   #$14
0034D7r 1  F0 14              BEQ   @backspace
0034D9r 1  C9 7F              CMP   #$7F
0034DBr 1  F0 10              BEQ   @backspace
0034DDr 1               
0034DDr 1                     ; --- buffer full? ---
0034DDr 1  A6 rr              LDX   buf_idx
0034DFr 1  E0 7F              CPX   #127
0034E1r 1  B0 AC              BCS   @poll              ; at capacity — ignore keystroke
0034E3r 1               
0034E3r 1                     ; --- store and echo printable character ---
0034E3r 1  9D rr rr           STA   input_buf,X        ; store in buffer
0034E6r 1  8D 0E A0           STA   VGC_CHAROUT        ; echo to screen
0034E9r 1  E6 rr              INC   buf_idx
0034EBr 1  80 A2              BRA   @poll
0034EDr 1               
0034EDr 1               @backspace:
0034EDr 1  A6 rr              LDX   buf_idx
0034EFr 1  F0 9E              BEQ   @poll              ; nothing to delete — ignore
0034F1r 1  CA                 DEX
0034F2r 1  86 rr              STX   buf_idx
0034F4r 1  A9 08              LDA   #$08
0034F6r 1  8D 0E A0           STA   VGC_CHAROUT        ; move cursor left and erase
0034F9r 1  80 94              BRA   @poll
0034FBr 1               
0034FBr 1               ; ---------------------------------------------------------------------
0034FBr 1               ; line_bracket_depth — net count of unclosed '[' and '(' in input_buf[0..buf_idx),
0034FBr 1               ;   ignoring text inside ';' comments. Returns depth in A (Z set if balanced).
0034FBr 1               ;   Clobbers: A, X, Y.
0034FBr 1               ; ---------------------------------------------------------------------
0034FBr 1               line_bracket_depth:
0034FBr 1  A2 00              LDX   #0                 ; scan index
0034FDr 1  A0 00              LDY   #0                 ; depth
0034FFr 1               @bd_loop:
0034FFr 1  E4 rr              CPX   buf_idx
003501r 1  B0 32              BCS   @bd_done
003503r 1  BD rr rr           LDA   input_buf,X
003506r 1  C9 3B              CMP   #';'
003508r 1  F0 1D              BEQ   @bd_comment
00350Ar 1  C9 5B              CMP   #'['
00350Cr 1  F0 0F              BEQ   @bd_inc
00350Er 1  C9 28              CMP   #'('
003510r 1  F0 0B              BEQ   @bd_inc
003512r 1  C9 5D              CMP   #']'
003514r 1  F0 0A              BEQ   @bd_dec
003516r 1  C9 29              CMP   #')'
003518r 1  F0 06              BEQ   @bd_dec
00351Ar 1               @bd_next:
00351Ar 1  E8                 INX
00351Br 1  80 E2              BRA   @bd_loop
00351Dr 1               @bd_inc:
00351Dr 1  C8                 INY
00351Er 1  80 FA              BRA   @bd_next
003520r 1               @bd_dec:
003520r 1  C0 00              CPY   #0
003522r 1  F0 F6              BEQ   @bd_next           ; floor at 0
003524r 1  88                 DEY
003525r 1  80 F3              BRA   @bd_next
003527r 1               @bd_comment:
003527r 1  E8                 INX                      ; skip ';' and everything up to a newline
003528r 1  E4 rr              CPX   buf_idx
00352Ar 1  B0 09              BCS   @bd_done
00352Cr 1  BD rr rr           LDA   input_buf,X
00352Fr 1  C9 0A              CMP   #$0A
003531r 1  D0 F4              BNE   @bd_comment
003533r 1  80 E5              BRA   @bd_next           ; resume scanning after the newline
003535r 1               @bd_done:
003535r 1  98                 TYA                      ; depth -> A, sets Z if zero
003536r 1  60                 RTS
003537r 1               
003537r 1               ; ---------------------------------------------------------------------
003537r 1               ; print_prompt — prints "? " to the screen
003537r 1               ; ---------------------------------------------------------------------
003537r 1               print_prompt:
003537r 1  20 rr rr           JSR   print_inl
00353Ar 1  3F 20 00           .byte "? ", 0
00353Dr 1  A9 01              LDA   #$01
00353Fr 1  8D 0A A0           STA   VGC_CURSEN
003542r 1  60                 RTS
003543r 1               
003543r 1               ; ---------------------------------------------------------------------
003543r 1               ; print_banner — prints title and current available heap bytes
003543r 1               ; ---------------------------------------------------------------------
003543r 1               print_banner:
003543r 1  20 rr rr           JSR   print_inl
003546r 1  4E 6F 76 61        .byte "Nova LOGO v1.0", $0D, $0A, 0
00354Ar 1  20 4C 4F 47  
00354Er 1  4F 20 76 31  
003557r 1               
003557r 1  38                 SEC
003558r 1  A9 00              LDA   #<HEAP_END
00355Ar 1  E5 rr              SBC   heap_ptr
00355Cr 1  85 rr              STA   eval_val_lo
00355Er 1  A9 98              LDA   #>HEAP_END
003560r 1  E5 rr              SBC   heap_ptr+1
003562r 1  85 rr              STA   eval_val_hi
003564r 1  38                 SEC
003565r 1  A5 rr              LDA   eval_val_lo
003567r 1  E9 02              SBC   #GC_HDR_BYTES
003569r 1  85 rr              STA   eval_val_lo
00356Br 1  A5 rr              LDA   eval_val_hi
00356Dr 1  E9 00              SBC   #0
00356Fr 1  85 rr              STA   eval_val_hi
003571r 1  64 rr              STZ   eval_val_frac
003573r 1  20 rr rr           JSR   print_uint16
003576r 1               
003576r 1  20 rr rr           JSR   print_inl
003579r 1  20 42 59 54        .byte " BYTES FREE", $0D, $0A, $0D, $0A, 0
00357Dr 1  45 53 20 46  
003581r 1  52 45 45 0D  
003589r 1  60                 RTS
00358Ar 1               
00358Ar 1               ; =====================================================================
00358Ar 1               ; RODATA segment — string constants
00358Ar 1               ; =====================================================================
00358Ar 1                     .segment "RODATA"
000647r 1               
000647r 1               ; Extension ROM trampoline — copied to RAM at $0270 during cold_start.
000647r 1               ; Swaps to extension ROM, calls entry, swaps back to Logo ROM.
000647r 1               ext_tramp_src:
000647r 1  A9 04              .byte $A9, ROMSWAP_EXTENSION  ; LDA #ROMSWAP_EXTENSION
000649r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
00064Cr 1  20 00 C0           .byte $20, $00, $C0          ; JSR $C000
00064Fr 1  A9 05              .byte $A9, ROMSWAP_LOGO      ; LDA #ROMSWAP_LOGO
000651r 1  8D 3F A0           .byte $8D, <REG_ROMSWAP, >REG_ROMSWAP  ; STA REG_ROMSWAP
000654r 1  60                 .byte $60                     ; RTS
000655r 1               
000655r 1               ; =====================================================================
000655r 1               ; MONITOR segment — reset handler at $FFD7
000655r 1               ; =====================================================================
000655r 1                     .segment "MONITOR"
000000r 1                     .org  $FFD7
00FFD7  1               
00FFD7  1               RES_vec:
