0021D4r 2  A5 rr              LDA   list_ptr_hi
0021D6r 2  85 rr              STA   ptr_hi
0021D8r 2  A0 05              LDY   #CONS_CDR_LO
0021DAr 2  B1 rr              LDA   (ptr_lo),Y
0021DCr 2  AA                 TAX
0021DDr 2  A0 06              LDY   #CONS_CDR_HI
0021DFr 2  B1 rr              LDA   (ptr_lo),Y
0021E1r 2  09 00              ORA   #0
0021E3r 2  D0 04              BNE   @se_next
0021E5r 2  E0 00              CPX   #0
0021E7r 2  F0 06              BEQ   @se_found_last
