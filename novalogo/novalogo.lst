0014D2r 2               @rl_have_tok:
0014D2r 2               
0014D2r 2  A5 rr              LDA   eval_cur_lo
0014D4r 2  85 rr              STA   ptr_lo
0014D6r 2  A5 rr              LDA   eval_cur_hi
0014D8r 2  85 rr              STA   ptr_hi
