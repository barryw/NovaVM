003014r 2  20 rr rr           JSR   proc_next
003017r 2  80 A5              BRA   @walk
003019r 2               
003019r 2               @not_found:
003019r 2  38                 SEC
00301Ar 2  60                 RTS
00301Br 2               
00301Br 2               ; ---------------------------------------------------------------------
00301Br 2               ; do_pots — POTS: print all procedure names
00301Br 2               ;   Arity 0, no arguments.
00301Br 2               ; ---------------------------------------------------------------------
00301Br 2               do_pots:
