001E43r 2               @err_args:
001E43r 2  A2 rr              LDX   #<str_item_name
001E45r 2  A0 rr              LDY   #>str_item_name
001E47r 2  4C rr rr           JMP   err_nei
001E4Ar 2               @err_range:
001E4Ar 2  A2 rr              LDX   #<str_item_name
001E4Cr 2  A0 rr              LDY   #>str_item_name
001E4Er 2  4C rr rr           JMP   err_index_range
