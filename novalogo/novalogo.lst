002DE6r 2               ; ---------------------------------------------------------------------
002DE6r 2               ; proc_find_by_name — search proc_head for a procedure by name string
002DE6r 2               ;   Input: ptr_lo/hi = length-prefixed name string (e.g. from eval_val)
002DE6r 2               ;   Output: carry clear = found, proc_entry_lo/hi = record
002DE6r 2               ;           carry set = not found
002DE6r 2               ;   Clobbers: A, X, Y, proc_entry, proc_name_len, proc_rec_off
002DE6r 2               ; ---------------------------------------------------------------------
002DE6r 2               proc_find_by_name:
002DE6r 2                     ; Save search name pointer
002DE6r 2  A5 rr              LDA   ptr_lo
002DE8r 2  85 rr              STA   var_name_lo             ; reuse var scratch as search ptr
002DEAr 2  A5 rr              LDA   ptr_hi
002DECr 2  85 rr              STA   var_name_hi
