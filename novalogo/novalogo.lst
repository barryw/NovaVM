002D82r 2  AD rr rr           LDA   save_heap_ptr_hi
002D85r 2  85 rr              STA   heap_ptr+1
002D87r 2               
002D87r 2                     ; Restore input_buf
002D87r 2  A2 00              LDX   #0
002D89r 2               @rest_ib:
002D89r 2  BD rr rr           LDA   save_input_buf,X
002D8Cr 2  9D rr rr           STA   input_buf,X
002D8Fr 2  E8                 INX
002D90r 2  E0 80              CPX   #128
002D92r 2  D0 F5              BNE   @rest_ib
002D94r 2               
002D94r 2                     ; Restore eval_cur to the resume point in the caller's token stream
002D94r 2  AD rr rr           LDA   save_eval_cur_lo
002D97r 2  85 rr              STA   eval_cur_lo
002D99r 2  AD rr rr           LDA   save_eval_cur_hi
002D9Cr 2  85 rr              STA   eval_cur_hi
