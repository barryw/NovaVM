00105Fr 2                     ; Push previous catch frame onto the 6502 stack (6 bytes)
00105Fr 2  A5 rr              LDA   catch_active
001061r 2  48                 PHA
001062r 2  A5 rr              LDA   catch_tag_lo
001064r 2  48                 PHA
001065r 2  A5 rr              LDA   catch_tag_hi
001067r 2  48                 PHA
001068r 2  A5 rr              LDA   catch_sp
00106Ar 2  48                 PHA
