002D4Dr 2  85 rr              STA   ptr_lo
002D4Fr 2  A5 rr              LDA   proc_entry_hi
002D51r 2  85 rr              STA   ptr_hi
002D53r 2  A4 rr              LDY   proc_rec_off
002D55r 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_lo
002D57r 2  85 rr              STA   proc_body_len_lo
002D59r 2  C8                 INY
002D5Ar 2  B1 rr              LDA   (ptr_lo),Y           ; body_len_hi
002D5Cr 2  85 rr              STA   proc_body_len_hi
