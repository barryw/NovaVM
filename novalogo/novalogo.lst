002E20r 2  A5 rr              LDA   proc_ptr_hi
002E22r 2  48                 PHA
002E23r 2  A5 rr              LDA   proc_body_len_lo
002E25r 2  48                 PHA
002E26r 2  A5 rr              LDA   proc_body_len_hi
002E28r 2  48                 PHA
002E29r 2  AD rr rr           LDA   save_heap_ptr_lo
002E2Cr 2  48                 PHA
002E2Dr 2  AD rr rr           LDA   save_heap_ptr_hi
002E30r 2  48                 PHA
002E31r 2  AD rr rr           LDA   save_eval_cur_lo
002E34r 2  48                 PHA
002E35r 2  AD rr rr           LDA   save_eval_cur_hi
002E38r 2  48                 PHA
