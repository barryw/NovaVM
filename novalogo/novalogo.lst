000237r 2               ; ---------------------------------------------------------------------
000237r 2               ; tok_scan_quote — scan TOK_QUOTE after '"'
000237r 2               ;   tok_src points at first char after '"'
000237r 2               ; ---------------------------------------------------------------------
000237r 2               tok_scan_quote:
000237r 2  A6 rr              LDX   tok_src
000239r 2  A0 00              LDY   #0
00023Br 2               @count:
00023Br 2  BD rr rr           LDA   input_buf,X
00023Er 2  20 rr rr           JSR   is_word_char
000241r 2  90 04              BCC   @counted
000243r 2  E8                 INX
000244r 2  C8                 INY
000245r 2  80 F4              BRA   @count
000247r 2               @counted:
000247r 2  98                 TYA
000248r 2  F0 48              BEQ   @empty
00024Ar 2  48                 PHA
00024Br 2  18                 CLC
00024Cr 2  69 04              ADC   #4
00024Er 2  A2 01              LDX   #ATYPE_TOKEN
000250r 2  20 rr rr           JSR   heap_alloc
000253r 2  B0 3C              BCS   @oom
000255r 2  A0 00              LDY   #TOK_TAG
000257r 2  A9 06              LDA   #TOK_QUOTE
000259r 2  91 rr              STA   (ptr_lo),Y
00025Br 2  A0 01              LDY   #TOK_NEXT_LO
00025Dr 2  A9 00              LDA   #0
00025Fr 2  91 rr              STA   (ptr_lo),Y
000261r 2  C8                 INY
000262r 2  91 rr              STA   (ptr_lo),Y
000264r 2  68                 PLA
000265r 2  48                 PHA
000266r 2  A0 03              LDY   #TOK_PAYLOAD
000268r 2  91 rr              STA   (ptr_lo),Y
00026Ar 2                     ; Copy characters — no uppercasing for quotes
00026Ar 2  68                 PLA
00026Br 2  AA                 TAX
00026Cr 2  A0 04              LDY   #TOK_PAYLOAD+1
00026Er 2  9C rr rr           STZ   num_tmp_lo
000271r 2               @copy:
000271r 2  DA                 PHX
000272r 2  AD rr rr           LDA   num_tmp_lo
000275r 2  18                 CLC
000276r 2  65 rr              ADC   tok_src
000278r 2  AA                 TAX
000279r 2  BD rr rr           LDA   input_buf,X
00027Cr 2  91 rr              STA   (ptr_lo),Y
00027Er 2  C8                 INY
00027Fr 2  EE rr rr           INC   num_tmp_lo
000282r 2  FA                 PLX
000283r 2  CA                 DEX
000284r 2  D0 EB              BNE   @copy
000286r 2  AD rr rr           LDA   num_tmp_lo
000289r 2  18                 CLC
00028Ar 2  65 rr              ADC   tok_src
