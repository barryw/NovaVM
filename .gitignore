e6502.FPGA/fpga/build/
e6502.FPGA/obj_dir/
e6502.FPGA/obj_dir_synth/
e6502.FPGA/e6502_sim
e6502.FPGA/e6502_sim_synth
e6502.FPGA/test/build/
e6502.FPGA/test/build-*/
e6502.FPGA/fpga/bit_backups/
e6502.FPGA/fpga/.claude/

# NovaHost host-side test binaries
e6502.ESP32/novahost/test/test_ndi
e6502.ESP32/novahost/test/test_midi_engine
e6502.ESP32/novahost/test/test_sid_vm
e6502.ESP32/novahost/test/*.dSYM/

# Python test caches
__pycache__/
*.py[cod]

# Local agent/editor state
.claude/scheduled_tasks.lock
.claude/settings.local.json
.tmp-home/

# macOS/Swift local build artifacts
.DS_Store
NovaDraw/.build/
NovaDraw/.swiftpm/
NovaDraw/**/xcuserdata/
NovaDraw/**/*.xcuserstate
NovaDraw/*.app/

# Example build outputs and local story files
examples/novaz/build/
examples/novaz/dist/
runtime/asm/build/
examples/novaz/projects/*/STORY.BIN
examples/novaz/projects/*/PICS.BLB
software/examples/novaz/build/
software/examples/novaz/dist/
software/examples/novaz/projects/*/STORY.BIN
software/examples/novaz/projects/*/PICS.BLB

# Copyrighted Infocom material must never be committed. The NovaZ collection
# images live under examples/novaz/dist/ (ignored above); these rules block the
# raw story files and game disk images repo-wide, wherever they land.
examples/novaz/dist/collection/
*.z3
*.z4
*.z5
*.z6
*.z7
*.z8
*.blb

# --- Build artifacts that should never be committed (added 2026-06-05 cleanup) ---
# cc65 / ld65 / assembler outputs. The .bin images ARE the tracked source of
# truth (ROMs, graphics.bin, libcall.bin, etc.), so *.bin is NOT ignored.
*.o
*.lst
*.map
*.lbl
# Reference disassembly listings shipped alongside the 6502 test ROMs are kept.
!e6502UnitTests/Resources/*.lst
# Packed self-documenting module artifact (the .bin image is tracked, .nmod is built).
*.nmod
# Static libraries / Verilator object trees.
*.a
e6502.FPGA/**/obj_copper/
e6502.FPGA/**/obj_dir*/
# .NET upgrade-assistant log.
*.clef
# Chrome DevTools / Playwright MCP scratch.
.playwright-mcp/
# Compiled NovaHost host-test binary (joins the explicit list above; *.dSYM/ ignored there).
e6502.ESP32/novahost/test/test_shelf_alloc
# Stray scratch screenshots in the repo root.
/*.png

# Git worktrees
.worktrees/

# --- Build-output binaries -------------------------------------------------
# Produced from source by the top-level `make binaries`; not tracked, so a deploy
# is always a matched set (no stale/mismatched artifacts). Genuine fixtures stay
# tracked: the e6502UnitTests CPU test suites, the cp437 font, *.nvg art, *.ndi
# disk images, and the asm test fixtures under tests/.
ehbasic/*.bin
novaforth/*.bin
novalogo/*.bin
modules/**/*.bin
modules/**/*.nmod
assembly/apps/**/*.bin
runtime/asm/*.bin
runtime/asm/build/
software/languages/*/*.bin
software/languages/*/*.BIN
software/modules/**/*.bin
software/modules/**/*.nmod
software/assembly/apps/**/*.bin
software/runtime/asm/*.bin
software/runtime/asm/build/
e6502.Avalonia/Resources/*.bin
e6502.Avalonia/Resources/*.BIN
!e6502.Avalonia/Resources/cp437.bin
!e6502.Avalonia/Resources/petscii_upper.bin
!e6502.Avalonia/Resources/petscii_lower.bin
e6502.CLI/Resources/*.bin
e6502.FPGA/rom/ehbasic.bin
e6502.FPGA/rom/extension.bin
e6502.Browser/wwwroot/rust/*.bin
website/emulator/rust/*.bin

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Arty Z7 FPGA/host build artifacts
e6502.FPGA/xsim.dir/
e6502.FPGA/xvlog.pb
e6502.FPGA/boards/arty_z7/linux/novavm/novavm
xsim.dir/
*.jou
*.wdb
webtalk*.log

# Arty sim + language-floppy build outputs
e6502.FPGA/boards/arty_z7/sim/*.out
e6502.FPGA/boards/arty_z7/sim/*.pb
e6502.FPGA/boards/arty_z7/sim/*.log
novaforth/*.o
novaforth/AUTOBOOT.bin
novalogo/*.o
novalogo/AUTOBOOT.bin
